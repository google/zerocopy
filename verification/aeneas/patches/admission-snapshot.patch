+/// Exact source owner selector; deliberately independent of Rust name/type spelling.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SourceOwnerSpan {
+    pub file: PathBuf,
+    pub beg: u32,
+    pub end: u32,
+}
+
+impl SourceOwnerSpan {
+    fn parse(value: &str) -> Result<Self, String> {
+        let parts = value.rsplitn(3, ':').collect_vec();
+        if parts.len() != 3 {
+            return Err("expected FILE:BEGIN_BYTE:END_BYTE".into());
+        }
+        let number = |s: &str| {
+            s.parse::<u32>()
+                .map_err(|_| "invalid coordinate".to_owned())
+        };
+        let file = PathBuf::from(parts[2]);
+        // No path aliases: admission can compare the requested owner list literally.
+        if file.as_os_str().is_empty()
+            || file.components().collect::<PathBuf>().as_os_str() != file.as_os_str()
+            || file
+                .components()
+                .any(|c| !matches!(c, std::path::Component::Normal(_)))
+        {
+            return Err("FILE must be a normalized crate-relative path".into());
+        }
+        let beg = number(parts[1])?;
+        let end = number(parts[0])?;
+        if beg >= end {
+            return Err("expected a nonempty, ordered byte span".into());
+        }
+        Ok(Self { file, beg, end })
+    }
+}
