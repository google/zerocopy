+    // Preserve executable effects before any Charon simplification. The consumer
+    // requires this snapshot, so a stock driver cannot silently skip admission.
+    // This is evidence for a downstream checker, not a rustc correctness proof.
+    if let Some(path) = std::env::var_os("CHARON_ADMISSION_SNAPSHOT") {
+        let snapshot = export::CrateData {
+            charon_version: export::CharonVersion(charon_lib::VERSION.to_owned()),
+            translated: ctx.translated.clone(),
+            has_errors: ctx.errors.borrow().error_count != 0,
+        };
+        snapshot.serialize_to_file(
+            std::path::Path::new(&path),
+            charon_lib::options::SerializationFormat::Json,
+        ).map_err(|()| CharonFailure::Serialize)?;
+    }
+
