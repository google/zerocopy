def util.bytewrite.suffix
  (src : Slice Std.U8) (dst : Slice Std.U8) :
  Result (Bool × (Slice Std.U8))
  := do
  let i := Slice.len dst
  let i1 := Slice.len src
  let o ← lift (Usize.checked_sub i i1)
  match o with
  | none => ok (false, dst)
  | some start =>
    let dst1 ← util.copy_unchecked_at src dst start
    ok (true, dst1)

