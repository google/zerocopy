def util.bytewrite.exact
  (src : Slice Std.U8) (dst : Slice Std.U8) :
  Result (Bool × (Slice Std.U8))
  := do
  let i := Slice.len dst
  let i1 := Slice.len src
  if i = i1
  then let dst1 ← util.copy_unchecked src dst
       ok (true, dst1)
  else ok (false, dst)

