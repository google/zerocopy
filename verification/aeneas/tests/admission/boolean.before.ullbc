o the same layout optimizations as\n    //     `T`.\n    //\n    // [2] Per https://doc.rust-lang.org/1.82.0/reference/items/unions.html#reading-and-writing-union-fields:\n    //\n    //     Effectively, writing to and then reading from a union with the C\n    //     representation is analogous to a transmute from the type used for\n    //     writing to the type used for reading.\n    unsafe { ManuallyDrop::into_inner(Transmute { src: ManuallyDrop::new(src) }.dst) }\n}","attr_info":{"attributes":[{"DocComment":" Unsafely transmutes the given `src` into a type `Dst`."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" The value `src` must be a valid instance of `Dst`."},{"Builtin":{"Inline":["Always",{"Untagged":{"data":{"file_id":15,"beg":{"line":343,"col":0},"end":{"line":343,"col":17}},"generated_from_span":null}}]}}],"inline":"Always","rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Src","variance":"Contravariant"},{"index":1,"name":"Dst","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"output":{"Untagged":{"TypeVar":{"Bound":[0,1]}}}},"src":"Normal","body":"Opaque"}],"global_decls":[],"trait_decls":[],"trait_impls":[]}}
