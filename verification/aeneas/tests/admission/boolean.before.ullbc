ng the helper's size\n        // assertion. The trusted interpretation checks this same condition\n        // before producing a bool; it cannot silently accept another byte.\n        Some(unsafe { super::transmute_unchecked(byte) })\n    } else {\n        None\n    }\n}","attr_info":{"attributes":[{"DocComment":" Converts precisely the two valid boolean encodings."},{"DocComment":""},{"DocComment":" ```aeneas"},{"DocComment":" spec checked_bool_spec"},{"DocComment":"   ensures(raw) r => r = if byte.val < 2 then some (decide (byte.val = 1)) else none"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"output":{"Untagged":{"Adt":{"id":14,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":"Bool"}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"src":"Normal","body":{"Unstructured":{"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":28,"col":0},"end":{"line":38,"col":1}},"generated_from_span":null}},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Untagged":{"data":{"file_id":18,"beg":{"line":28,"col":29},"end":{"line":28,"col":41}},"generated_from_span":null}},"ty":{"Untagged":{"Adt":{"id":14,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":"Bool"}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},"drop_flag_for":null},{"index":1,"name":"byte","span":{"Untagged":{"data":{"file_id":18,"beg":{"line":28,"col":16},"end":{"line":28,"col":20}},"generated_from_span":null}},"ty":{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}},"drop_flag_for":null},{"index":2,"name":null,"span":