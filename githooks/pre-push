set -eo pipefail
echo "Running pre-push git hook: $0"
# Forego redirecting stdout to /dev/null on check_fmt.sh because the output from
# `cargo fmt` is useful (and the good stuff is not delivered by stderr).
#
# Background all jobs and wait for them so they can run in parallel.
./ci/check_actions.sh                                  & ACTIONS_PID=$!
python3 -I -B ./ci/test_check_actions.py >/dev/null  & CHECK_ACTIONS_TEST_PID=$!
./ci/check_fmt.sh                                      & FMT_PID=$!
./ci/check_job_dependencies.sh      >/dev/null         & JOB_DEPS_PID=$!
python3 -I -B ./ci/check_skills.py  >/dev/null         & SKILLS_PID=$!
python3 -I -B ./ci/test_check_skills.py >/dev/null     & SKILLS_TEST_PID=$!
python3 -I -B ./ci/scripts/check_toolchains_sync.py >/dev/null & TOOLCHAINS_SYNC_PID=$!
python3 -I -B ./ci/test_check_toolchains_sync.py >/dev/null    & TOOLCHAINS_SYNC_TEST_PID=$!
python3 -I -B ./ci/test_cargo_home_guard.py >/dev/null         & CARGO_HOME_GUARD_TEST_PID=$!
python3 -I -B ./ci/test_script_timeouts.py >/dev/null          & SCRIPT_TIMEOUTS_TEST_PID=$!
python3 -I -B ./ci/test_check_todo_and_job_deps.py >/dev/null &
TODO_JOB_DEPS_TEST_PID=$!
./zerocopy/ci/check_all_toolchains_tested.sh >/dev/null & TOOLCHAINS_PID=$!
./zerocopy/ci/check_readme.sh                >/dev/null & README_PID=$!
./zerocopy/ci/check_stale_stderr.sh          >/dev/null & STALE_STDERR_PID=$!
./zerocopy/ci/check_versions.sh              >/dev/null & VERSIONS_PID=$!
./zerocopy/ci/check_msrv_is_minimal.sh       >/dev/null & MSRV_PID=$!

# `wait <pid>` exits with the same status code as the job it's waiting for.
# Since we `set -e` above, this will have the effect of causing the entire
# script to exit with a non-zero status code if any of these jobs does the same.
# Note that, while `wait` (with no PID argument) waits for all backgrounded
# jobs, it exits with code 0 even if one of the backgrounded jobs does not, so
# we can't use it here.
wait $ACTIONS_PID
wait $CHECK_ACTIONS_TEST_PID
wait $FMT_PID
wait $TOOLCHAINS_PID
wait $JOB_DEPS_PID
wait $SKILLS_PID
wait $SKILLS_TEST_PID
wait $TOOLCHAINS_SYNC_PID
wait $TOOLCHAINS_SYNC_TEST_PID
wait $CARGO_HOME_GUARD_TEST_PID
wait $SCRIPT_TIMEOUTS_TEST_PID
wait $TODO_JOB_DEPS_TEST_PID
wait $README_PID
wait $STALE_STDERR_PID
wait $VERSIONS_PID
wait $MSRV_PID

# Lint repository shell scripts (when `shellcheck` is installed) and verify
# that this hook calls all top-level scripts in `ci/` and `zerocopy/ci/*`.
./ci/scripts/check_shell_and_hooks.sh
