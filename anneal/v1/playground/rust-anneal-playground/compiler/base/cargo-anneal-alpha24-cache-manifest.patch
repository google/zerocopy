+fn sync_lean_root(tmp_lean_root: &Path, lean_root: &Path) -> Result<()> {
+    let start = std::time::Instant::now();
+    if !lean_root.exists() {
+        log::debug!("Renaming {} to {}", tmp_lean_root.display(), lean_root.display());
+        fs::rename(tmp_lean_root, lean_root)
