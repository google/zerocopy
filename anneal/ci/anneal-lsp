#!/usr/bin/env -S -u BASH_ENV -u ENV -u BASHOPTS -u SHELLOPTS -u CDPATH -u GLOBIGNORE -u IFS /bin/sh
''':'
unset -f "[" test echo 2>/dev/null || :
for _p in \
  /opt/anneal-nix/release-check-python/bin/python3 \
  /run/current-system/sw/bin/python3 \
  /usr/bin/python3 \
  /usr/local/bin/python3 \
  /opt/homebrew/bin/python3
do
  if [ -x "$_p" ]; then
    exec "$_p" -I -B "$0" "$@"
  fi
done
echo "anneal-lsp: no trusted python3 interpreter found" >&2
exit 1
