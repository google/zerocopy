{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:snapshot-review-contract:1",
  "$comment": "DRAFT / UNSEALED exact artifact and procedure contract for one independent snapshot-review hook.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "hook_id", "procedure_id", "procedure_version", "custody_requirement", "required_check_ids", "artifacts", "artifact_set_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "READY"},
    "hook_id": {"type": "string", "pattern": "^H-[A-Z][A-Z0-9-]*$"},
    "procedure_id": {"type": "string", "pattern": "^v5-snapshot-review/[a-z0-9-]+$"},
    "procedure_version": {"const": "v5-snapshot-review-v1"},
    "custody_requirement": {"const": "VERIFIED_PRIVATE_COPY_AND_END_REVERIFY"},
    "required_check_ids": {
      "const": ["EXACT-SNAPSHOT-BOUND", "REVIEW-CONTRACT-BOUND", "ARTIFACT-INVENTORY-CHECKED", "HOOK-SEMANTICS-CHECKED", "END-OF-REVIEW-REVERIFIED"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?![.][.]?(?:/|$))(?!.*(?:/[.][.]?)(?:/|$))(?!.*[\\u0000-\\u001f])(?!.*//)(?!.*[/]$).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
