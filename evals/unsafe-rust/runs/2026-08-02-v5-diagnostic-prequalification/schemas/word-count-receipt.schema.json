{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:draft:word-count-receipt:1",
  "$comment": "DRAFT / UNSEALED executable word-count receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "algorithm_id", "report_sha256", "word_count", "word_cap", "valid"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "COUNTED"},
    "algorithm_id": {"const": "unicode-whitespace-runs-python-v1"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "word_count": {"type": "integer", "minimum": 0},
    "word_cap": {"type": "integer", "minimum": 1},
    "valid": {"type": "boolean"}
  }
}
