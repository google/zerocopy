{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:draft:atom-manifest:1",
  "$comment": "DRAFT / UNSEALED schema design; not a frozen atom manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "mode", "atoms"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["DRAFT", "READY"]},
    "mode": {"enum": ["E", "V", "F", "P", "B", "L", "R", "Q"]},
    "atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "direct_criterion", "prerequisites", "authority_dependencies", "applicability"],
        "properties": {
          "id": {"type": "string", "pattern": "^[EVFPBLRQ][1-9][0-9]*$"},
          "direct_criterion": {"type": "string", "minLength": 1},
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[EVFPBLRQ][1-9][0-9]*$"}
          },
          "authority_dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "applicability": {"const": "REQUIRED"}
        }
      }
    }
  }
}
