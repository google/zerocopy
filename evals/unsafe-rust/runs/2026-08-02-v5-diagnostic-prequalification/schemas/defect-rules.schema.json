{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:draft:defect-rules:1",
  "$comment": "DRAFT / UNSEALED closed machine-readable hard-error/global-defect inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "common_hard_errors", "global_defects", "modes", "novel_findings"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["DRAFT", "READY"]},
    "common_hard_errors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/common"}},
    "global_defects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/global"}},
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["E", "V", "F", "P", "B", "L", "R", "Q"],
      "properties": {
        "E": {"$ref": "#/$defs/mode"}, "V": {"$ref": "#/$defs/mode"},
        "F": {"$ref": "#/$defs/mode"}, "P": {"$ref": "#/$defs/mode"},
        "B": {"$ref": "#/$defs/mode"}, "L": {"$ref": "#/$defs/mode"},
        "R": {"$ref": "#/$defs/mode"}, "Q": {"$ref": "#/$defs/mode"}
      }
    },
    "novel_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_pattern", "routing"],
      "properties": {
        "id_pattern": {"const": "^s[12]-N[1-9][0-9]*$"},
        "routing": {"const": "MANDATORY_ADJUDICATION"}
      }
    }
  },
  "$defs": {
    "common": {"type": "object", "additionalProperties": false, "required": ["id", "criterion"], "properties": {"id": {"type": "string", "pattern": "^GH[1-9][0-9]*$"}, "criterion": {"type": "string", "minLength": 1}}},
    "global": {"type": "object", "additionalProperties": false, "required": ["id", "criterion"], "properties": {"id": {"type": "string", "pattern": "^GD[1-9][0-9]*$"}, "criterion": {"type": "string", "minLength": 1}}},
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_errors"],
      "properties": {
        "hard_errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "criterion"],
            "properties": {
              "id": {"type": "string", "pattern": "^[EVFPBLRQ]H[1-9][0-9]*$"},
              "criterion": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
