{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:draft:aggregation-stage-manifest:1",
  "$comment": "DRAFT / UNSEALED immutable aggregation-stage manifest. protocol.py additionally requires canonical sorted records, exact stage file/directory inventory, authoritative cumulative envelope bindings, and an exact six-stage digest chain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "algorithm", "stage_id", "static_lock_sha256", "coordinator_actor_id", "prerequisite_stage_sha256", "attempt_envelopes", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "COMPLETE"},
    "algorithm": {"const": "V5_AGGREGATION_STAGE_MANIFEST_V1"},
    "stage_id": {"$ref": "#/$defs/stage_id"},
    "static_lock_sha256": {"$ref": "#/$defs/digest"},
    "coordinator_actor_id": {"$ref": "#/$defs/actor_id"},
    "prerequisite_stage_sha256": {"$ref": "#/$defs/optional_digest"},
    "attempt_envelopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/attempt_binding"}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file_record"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stage_id": {"const": "01-report-products"}}, "required": ["stage_id"]},
      "then": {"properties": {"prerequisite_stage_sha256": {"type": "null"}, "attempt_envelopes": {"minItems": 120, "maxItems": 120}}},
      "else": {"properties": {"prerequisite_stage_sha256": {"$ref": "#/$defs/digest"}}}
    },
    {
      "if": {"properties": {"stage_id": {"const": "02-scorer-products"}}, "required": ["stage_id"]},
      "then": {"properties": {"attempt_envelopes": {"minItems": 136, "maxItems": 136}}}
    },
    {
      "if": {"properties": {"stage_id": {"const": "03-consistency-products"}}, "required": ["stage_id"]},
      "then": {"properties": {"attempt_envelopes": {"minItems": 152, "maxItems": 152}}}
    },
    {
      "if": {"properties": {"stage_id": {"const": "04-score-products"}}, "required": ["stage_id"]},
      "then": {"properties": {"attempt_envelopes": {"minItems": 152, "maxItems": 160}}}
    },
    {
      "if": {"properties": {"stage_id": {"const": "05-materiality-products"}}, "required": ["stage_id"]},
      "then": {"properties": {"attempt_envelopes": {"minItems": 154, "maxItems": 162}}}
    },
    {
      "if": {"properties": {"stage_id": {"const": "final"}}, "required": ["stage_id"]},
      "then": {"properties": {"attempt_envelopes": {"minItems": 154, "maxItems": 163}}}
    }
  ],
  "$defs": {
    "stage_id": {"enum": ["01-report-products", "02-scorer-products", "03-consistency-products", "04-score-products", "05-materiality-products", "final"]},
    "actor_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{15,127}$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "relative_file": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f])(?!\\s)(?!.*\\s$)(?!.*\\/$).+$", "not": {"const": "stage-manifest.json"}},
    "attempt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "envelope_sha256"],
      "properties": {
        "assignment_id": {"$ref": "#/$defs/safe_id"},
        "envelope_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_file"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
