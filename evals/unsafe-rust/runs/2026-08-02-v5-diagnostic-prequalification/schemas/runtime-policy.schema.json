{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:runtime-policy:5",
  "$comment": "DRAFT source schema; validates both the DRAFT source policy and its exact READY promotion, including the staged production aggregation and workspace-custody contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "static_manifest_path", "static_lock_path", "review_snapshot_manifest_path", "review_snapshot_descriptor_path", "mutable_root", "state_root", "static_manifest_exclusions", "runtime_carve_out", "draft_runtime_policy", "post_lock_state_policy", "coordinator_claim_policy", "evaluator_input_policy", "aggregation_stage_policy", "successful_attempt_count_policy", "terminal_outcome_policy", "agent_io_root_policy", "agent_input_leaf", "agent_output_leaf", "agent_visible_path_forbidden_terms", "symlink_policy", "seal_copy_policy", "output_capture_hard_byte_limit", "output_capture_hard_entry_limit", "output_capture_hard_path_byte_limit", "output_capture_overflow_policy", "evidence_policy", "fresh_attempt_root_policy", "seal_workspace_policy", "same_uid_agent_tcb_policy", "frozen_input_policy", "snapshot_policy", "bundle_kind_policy", "static_manifest_algorithm", "path_domain", "metadata_policy", "synthetic_test_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["DRAFT", "READY"]},
    "static_manifest_path": {"const": "STATIC-MANIFEST.sha256"},
    "static_lock_path": {"const": "STATIC-LOCK.json"},
    "review_snapshot_manifest_path": {"const": "REVIEW-SNAPSHOT.manifest"},
    "review_snapshot_descriptor_path": {"const": "REVIEW-SNAPSHOT.json"},
    "mutable_root": {"const": "runtime"},
    "state_root": {"const": "runtime/state"},
    "static_manifest_exclusions": {"const": ["runtime/state/**"]},
    "runtime_carve_out": {"const": "EXACT_RUNTIME_STATE_SUBTREE_ONLY"},
    "draft_runtime_policy": {"const": "FORBIDDEN_UNTIL_VALID_LOCK_AND_STATIC_MANIFEST"},
    "post_lock_state_policy": {"const": "ONLY_COORDINATOR_STATE_AND_CONTENT_ADDRESSED_ENVELOPES"},
    "coordinator_claim_policy": {"const": "IMMUTABLE_STATIC_LOCK_BOUND_CLAIM_BEFORE_ANY_SEMANTIC_LEASE"},
    "evaluator_input_policy": {"const": "ASSIGNMENT_ONLY_FROM_COMMITTED_IMMUTABLE_PREDECESSOR_STAGE"},
    "aggregation_stage_policy": {"const": "SIX_ATOMIC_NOREPLACE_IMMUTABLE_MANIFEST_BOUND_PREFIX_STAGES"},
    "successful_attempt_count_policy": {"const": "EXACTLY_154_TO_163_SEALED_ATTEMPTS"},
    "terminal_outcome_policy": {"const": "FINAL_SUCCESS_OR_AUTHENTICATED_TERMINAL_ERROR_MUTUALLY_EXCLUSIVE"},
    "agent_io_root_policy": {"const": "FRESH_EXTERNAL_NEUTRAL_TMP_RANDOM_OPAQUE_ROOT"},
    "agent_input_leaf": {"const": "input"},
    "agent_output_leaf": {"const": "output"},
    "agent_visible_path_forbidden_terms": {"const": ["evals", "runtime", "condition", "package", "skill", "v5", "v4", "no_skill"]},
    "symlink_policy": {"const": "FORBIDDEN"},
    "seal_copy_policy": {"const": "HASH_AND_COPY_EXTERNAL_OUTPUT_INTO_IN_TREE_CANONICAL_STATE"},
    "output_capture_hard_byte_limit": {"const": 4194304},
    "output_capture_hard_entry_limit": {"const": 4096},
    "output_capture_hard_path_byte_limit": {"const": 262144},
    "output_capture_overflow_policy": {"const": "SPEC_OVERAGES_CAPTURED_UNTIL_HARD_LIMIT_HARD_OVERFLOW_AUTHENTICATED_UNAVAILABLE"},
    "evidence_policy": {"const": "POST_LOCK_COMMITTED_RUNTIME_STATE_REQUIRED_AT_INTEGRATION"},
    "fresh_attempt_root_policy": {"const": "EXCLUSIVE_CREATE_ON_LEASE"},
    "seal_workspace_policy": {"const": "EXACT_LEASE_BOUND_INPUT_OUTPUT_TREE_REVALIDATED_UNDER_LOCK_AT_SEAL"},
    "same_uid_agent_tcb_policy": {"const": "OS_ENFORCED_READ_ONLY_INPUT_OR_SEPARATE_OWNERSHIP_REQUIRED_FOR_TRANSIENT_MUTATION_THREAT"},
    "frozen_input_policy": {"const": "NO_MUTATION_AFTER_LOCK"},
    "snapshot_policy": {"const": "REVIEW_EXACT_STAGED_PAYLOAD_BEFORE_FINALIZATION"},
    "bundle_kind_policy": {"const": "LOCK_AND_STATUS_MUST_MATCH_CALLER_EXPECTED_KIND"},
    "static_manifest_algorithm": {"const": "V5_DOMAIN_FRAMED_TREE_V1"},
    "path_domain": {"const": "PORTABLE_ASCII_RELATIVE_PATH_V1"},
    "metadata_policy": {"const": "STATIC_FILES_0444_STATIC_DIRS_0555_RUNTIME_STATE_0700"},
    "synthetic_test_policy": {"const": "PRIVATE_PATH_CAN_ONLY_MINT_SYNTHETIC_TEST_ONLY"}
  }
}
