{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:integration-receipt:2",
  "$comment": "DRAFT / UNSEALED structural schema; integrate.py and protocol.py additionally enforce exact hook identities, keyed checks, and artifact digest maps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "phase", "hook_id", "receipt_kind", "actor", "input_digests", "output_digests", "result"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["PASS", "SYNTHETIC-TEST-ONLY"]},
    "phase": {"enum": ["SNAPSHOT_REVIEW", "RUNTIME_COLLECTION", "POSTRUN_AGGREGATE"]},
    "hook_id": {"type": "string", "pattern": "^H-[A-Z][A-Z0-9-]*$"},
    "receipt_kind": {"enum": ["INDEPENDENT_SNAPSHOT_REVIEW", "RUNTIME_VALIDATION", "POSTRUN_VALIDATION"]},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role", "implementation", "version"],
      "properties": {
        "identity": {"type": "string", "minLength": 2},
        "role": {"type": "string", "minLength": 2},
        "implementation": {"type": "string", "minLength": 2},
        "version": {"type": "string", "minLength": 2}
      }
    },
    "reviewer_runtime": {"$ref": "#/$defs/reviewer_runtime"},
    "input_digests": {"$ref": "#/$defs/digest_map"},
    "output_digests": {"$ref": "#/$defs/digest_map"},
    "work_product": {"$ref": "#/$defs/work_product"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "checks"],
      "properties": {
        "summary": {"type": "string", "minLength": 20},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "evidence"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
              "status": {"const": "PASS"},
              "evidence": {"type": "string", "minLength": 20}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "work_product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "narrative", "narrative_sha256", "coverage"],
      "properties": {
        "algorithm": {"const": "V5_REVIEW_WORK_PRODUCT_V1"},
        "narrative": {"type": "string", "minLength": 100},
        "narrative_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "subject", "decision", "rationale"],
            "properties": {
              "id": {"type": "string", "minLength": 2},
              "subject": {"type": "string", "minLength": 1},
              "decision": {"const": "PASS"},
              "rationale": {"type": "string", "minLength": 40}
            }
          }
        }
      }
    },
    "reviewer_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm", "python_implementation", "python_version", "python_cache_tag", "openssl_version", "platform_system", "platform_release", "platform_machine"],
      "properties": {
        "schema_version": {"const": 1},
        "algorithm": {"const": "V5_REVIEWER_RUNTIME_ATTESTATION_V1"},
        "python_implementation": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "python_cache_tag": {"type": "string", "minLength": 1},
        "openssl_version": {"type": "string", "minLength": 1},
        "platform_system": {"type": "string", "minLength": 1},
        "platform_release": {"type": "string", "minLength": 1},
        "platform_machine": {"type": "string", "minLength": 1}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "phase": {"const": "SNAPSHOT_REVIEW"},
        "receipt_kind": {"const": "INDEPENDENT_SNAPSHOT_REVIEW"},
        "actor": {
          "properties": {"role": {"const": "INDEPENDENT_REVIEWER"}}
        }
      },
      "required": ["reviewer_runtime", "work_product"]
    },
    {
      "properties": {
        "phase": {"const": "RUNTIME_COLLECTION"},
        "receipt_kind": {"const": "RUNTIME_VALIDATION"}
      },
      "not": {"anyOf": [{"required": ["reviewer_runtime"]}, {"required": ["work_product"]}]}
    },
    {
      "properties": {
        "phase": {"const": "POSTRUN_AGGREGATE"},
        "receipt_kind": {"const": "POSTRUN_VALIDATION"}
      },
      "not": {"anyOf": [{"required": ["reviewer_runtime"]}, {"required": ["work_product"]}]}
    }
  ]
}
