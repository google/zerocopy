{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:draft:report-secret-inventory:1",
  "$comment": "DRAFT / UNSEALED evaluator-only finite nominal-secret token inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "builder_id", "tokens", "protected_target_values"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "READY"},
    "builder_id": {"const": "v5-report-secret-inventory-v1"},
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "value", "provenance", "match_kind"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 12},
          "provenance": {"type": "string", "minLength": 1},
          "match_kind": {"enum": ["EXACT_ABSOLUTE_PATH", "EXACT_HEX_DIGEST", "EXACT_UUID_OR_RUNTIME_ID", "EXACT_MULTIWORD_TREATMENT_PHRASE"]}
        }
      }
    },
    "protected_target_values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
