{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:source-review-contract:1",
  "$comment": "Exact procedure, artifact, and evidence contract for one independent reviewed-source decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "review_kind", "procedure_id", "procedure_version", "procedure_path", "procedure_sha256", "receipt_schema_path", "receipt_schema_sha256", "reviewer_tool_set_algorithm", "reviewer_tools", "reviewer_tool_set_sha256", "reviewer_runtime_attestation_algorithm", "custody_requirement", "required_check_ids", "coverage_items", "coverage_set_algorithm", "coverage_set_sha256", "artifacts", "artifact_set_sha256", "evidence_bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "READY"},
    "review_kind": {"enum": ["INDEPENDENT_ORACLE", "COHERENCE"]},
    "procedure_id": {"type": "string", "pattern": "^v5-source-review/[a-z0-9-]+$"},
    "procedure_version": {"const": "v5-source-review-v1"},
    "procedure_path": {"enum": ["source-review-procedures/oracle.md", "source-review-procedures/coherence.md"]},
    "procedure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_schema_path": {"const": "source-review-procedures/source-review-receipt.schema.json"},
    "receipt_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_tool_set_algorithm": {"const": "V5_REVIEWER_TOOL_SET_V1"},
    "reviewer_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?![.][.]?(?:/|$))(?!.*(?:/[.][.]?)(?:/|$))(?!.*[\\u0000-\\u001f])(?!.*//)(?!.*[/]$).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "reviewer_tool_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_runtime_attestation_algorithm": {"const": "V5_REVIEWER_RUNTIME_ATTESTATION_V1"},
    "custody_requirement": {"const": "VERIFIED_PRIVATE_COPY_AND_END_REVERIFY"},
    "required_check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"}
    },
    "coverage_items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject"],
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "subject": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage_set_algorithm": {"const": "V5_REVIEW_COVERAGE_SET_V1"},
    "coverage_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?![.][.]?(?:/|$))(?!.*(?:/[.][.]?)(?:/|$))(?!.*[\\u0000-\\u001f])(?!.*//)(?!.*[/]$).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_quotation_evidence_algorithm", "exact_quotation_evidence_sha256", "reviewed_source_transition_algorithm", "reviewed_static_set_algorithm", "reviewed_static_set_sha256", "theorem_input_set_sha256"],
      "properties": {
        "exact_quotation_evidence_algorithm": {"const": "V5_EXACT_QUOTATION_EVIDENCE_V1"},
        "exact_quotation_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewed_source_transition_algorithm": {"const": "V5_REVIEWED_SOURCE_TRANSITION_V1"},
        "reviewed_static_set_algorithm": {"const": "V5_REVIEWED_STATIC_RECORD_SET_V1"},
        "reviewed_static_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "theorem_input_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
