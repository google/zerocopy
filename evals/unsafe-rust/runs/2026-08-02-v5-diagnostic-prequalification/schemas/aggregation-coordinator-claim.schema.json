{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zerocopy:v5-diagnostic:draft:aggregation-coordinator-claim:1",
  "$comment": "DRAFT / UNSEALED immutable production coordinator claim. protocol.py additionally binds the digest to the verified static lock and excludes every authenticated source/snapshot reviewer identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "coordinator_actor_id", "static_lock_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "CLAIMED"},
    "coordinator_actor_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{15,127}$"},
    "static_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
