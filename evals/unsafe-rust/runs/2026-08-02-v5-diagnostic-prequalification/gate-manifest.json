      "predicate": {"kind": "boolean_true", "input": "comparison"},
      "on_missing": "ERROR",
      "on_error": "ERROR"
    },
    {
      "id": "D-COHERENCE",
      "version": 1,
      "mandatory_root": true,
      "description": "The candidate package and maintainer rationale pass subtractive/coherence review.",
      "prerequisites": ["D-STATIC-INTEGRITY"],
      "inputs": [{"id": "coherence", "type": "boolean", "source": {"kind": "context", "path": "review.coherence_pass"}}],
