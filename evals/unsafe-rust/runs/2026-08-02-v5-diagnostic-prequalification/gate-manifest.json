      "inputs": [{"id": "global_defect_count", "type": "integer", "source": {"kind": "context", "path": "scores.global_defect_count"}}],
      "predicate": {"kind": "integer_equals", "input": "global_defect_count", "value": 0},
      "on_missing": "ERROR",
      "on_error": "ERROR"
    },
    {
      "id": "D-NO-MATERIAL-FINDING",
      "version": 1,
