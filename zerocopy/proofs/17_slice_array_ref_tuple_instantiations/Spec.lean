prelude
import Trusted.MirSemantics

namespace Spec

open Trusted.MirAst Trusted.MirSemantics

/-!
# Slice, Array, Reference, and Tuple Instantiations

Specifies 25 monomorphizations of generic items in unmodified `zerocopy/src/`,
selected with `scope.instantiations`:

- `<[T; N] as KnownLayout>::pointer_to_metadata` (generated by
  `impl_known_layout!` in `util/macros.rs` as
  `fn pointer_to_metadata(_ptr: *mut Self) -> () {}`) at `[u8; 0]`, `[u8; 4]`,
  `[u32; 0]`, and `[u32; 4]`. Each takes a raw pointer to an array, which only
  Profile v2 (`MirTy.array`) lowers, so the whole program is Profile v2.
- The `only_derive_is_allowed_to_implement_this_trait` sealing markers (empty
  bodies) of the generic trait impls for `[T]` (`Immutable`, `TryFromBytes`,
  `FromZeros`, `FromBytes`, `IntoBytes`, and `Unaligned`) at `T = u8`; for
  `&T` and `&mut T` (`KnownLayout` and `Immutable`), `NonNull<T>`
  (`Immutable`), and `Option<&mut T>` (`TryFromBytes` and `FromZeros`) at
  `T = u8`; and for the tuples `(A,)` and `(A, B)` (`Immutable`,
  `TryFromBytes`, `FromZeros`, and `FromBytes`) at `(u8,)` and `(u8, u32)`.

Each body is pinned to its identity and proved to be a safe function that,
on every valid entry, returns `()` with caller memory unchanged as its only
terminal behavior.
-/

/-- All 25 bodies are safe functions, so `BodyVerifiedV2` never consults the
safety precondition. -/
def safetyPre (_identity : String) (_q : Query) : Prop := True

/-- On entry `q`, body `defId` is well-formed, returns exactly `out`, and has
no other terminal behavior. -/
def returnsExactly (p : Program) (defId : DefId) (q : Query)
    (out : TerminalOut) : Prop :=
  BehaviorV2 (entryProgForBody p defId) q out ∧
  SatisfiesPostV2 (entryProgForBody p defId) q (fun o => o = out)

/-- Body `defId` is the safe function `identity`, and on every valid entry it
returns `()` with caller memory unchanged. -/
def unitBodyPost (p : Program) (defId : DefId) (identity : String) : Prop :=
  match Trusted.MirSemantics.getElem? p.bodies defId with
  | none => False
  | some body =>
    body.identity = identity ∧ body.isUnsafe = false ∧
    ∀ q : Query, ValidEntryArgsV2 body q →
      returnsExactly p defId q (.returned ⟨.unit, q.callerMem⟩)

/-- Identity of the `only_derive_is_allowed_to_implement_this_trait` sealing
marker of the trait impl whose path, up to its closing `>`, is `implPath`. -/
def markerId (implPath : String) : String :=
  stringAppend (stringAppend "rust-path-v1::" implPath)
    ">::only_derive_is_allowed_to_implement_this_trait"

/-- Identity of `<arrayTy as KnownLayout>::pointer_to_metadata`. -/
def arrayPtrMetaId (arrayTy : String) : String :=
  stringAppend (stringAppend "rust-path-v1::_::<impl KnownLayout for " arrayTy)
    ">::pointer_to_metadata"

/-- The identities of bodies `0` through `24`, in capture order. -/
def bodyIds : List String :=
  [markerId "_::<impl KnownLayout for &mut u8",
   markerId "_::<impl KnownLayout for &u8",
   arrayPtrMetaId "[u32; 0]",
   arrayPtrMetaId "[u32; 4]",
   arrayPtrMetaId "[u8; 0]",
   arrayPtrMetaId "[u8; 4]",
   markerId "impls::_::<impl FromBytes for [u8]",
   markerId "impls::_::<impl FromZeros for [u8]",
   markerId "impls::_::<impl FromZeros for core::option::Option<&mut u8>",
   markerId "impls::_::<impl Immutable for &mut u8",
   markerId "impls::_::<impl Immutable for &u8",
   markerId "impls::_::<impl Immutable for [u8]",
   markerId "impls::_::<impl Immutable for core::ptr::non_null::NonNull<u8>",
   markerId "impls::_::<impl IntoBytes for [u8]",
   markerId "impls::_::<impl TryFromBytes for [u8]",
   markerId "impls::_::<impl TryFromBytes for core::option::Option<&mut u8>",
   markerId "impls::_::<impl Unaligned for [u8]",
   markerId "impls::tuples::_::<impl FromBytes for (u8, u32)",
   markerId "impls::tuples::_::<impl FromBytes for (u8,)",
   markerId "impls::tuples::_::<impl FromZeros for (u8, u32)",
   markerId "impls::tuples::_::<impl FromZeros for (u8,)",
   markerId "impls::tuples::_::<impl Immutable for (u8, u32)",
   markerId "impls::tuples::_::<impl Immutable for (u8,)",
   markerId "impls::tuples::_::<impl TryFromBytes for (u8, u32)",
   markerId "impls::tuples::_::<impl TryFromBytes for (u8,)"]

/-- Bodies `defId, defId + 1, ...` are the safe functions `ids`, each returning
`()` with caller memory unchanged on every valid entry. -/
def unitBodyPosts (p : Program) : DefId → List String → Prop
  | _, [] => True
  | defId, identity :: rest =>
    unitBodyPost p defId identity ∧ unitBodyPosts p (defId + 1) rest

def property (p : Program) : Prop :=
  unitBodyPosts p 0 bodyIds

def specs : SpecsV2 := ⟨safetyPre, property⟩

end Spec
