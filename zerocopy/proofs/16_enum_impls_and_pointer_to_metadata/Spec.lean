prelude
import Trusted.MirSemantics

namespace Spec

open Trusted.MirAst Trusted.MirSemantics

/-- All 19 bodies are safe functions, so `BodyVerifiedV2` never consults the
safety precondition. -/
def safetyPre (_identity : String) (_q : Query) : Prop := True

/-- `byteorder::Order` (`byteorder.rs`): a fieldless enum with variants
`BigEndian` and `LittleEndian`, whose discriminants `0` and `1` equal their
variant indices, stored as a one-byte tag. -/
def orderEnumTy : EnumTy :=
  { id := 3703498689, discrWidth := .isize, discrSigned := true,
    tagRepr := .scalar .i8 false, discriminants := [0, 1] }

/-- `layout::CastType` (`layout.rs`): a fieldless enum with variants `Prefix`
and `Suffix`, whose discriminants `0` and `1` equal their variant indices,
stored as a one-byte tag. -/
def castTypeEnumTy : EnumTy :=
  { id := 939859399, discrWidth := .isize, discrSigned := true,
    tagRepr := .scalar .i8 false, discriminants := [0, 1] }

/-- The value of type `.enum ety` that the reference argument `v` points to in
the entry memory of `q`, or `none` if `v` is not a pointer with provenance or
its pointee does not load as a valid value. -/
noncomputable def derefEntry (q : Query) (ety : EnumTy) (v : Val) :
    Option Val :=
  match v with
  | .ptr p =>
    match p.allocId with
    | some aid =>
      match loadIndirectV2 (entryMemoryWithCaller q.callerMem) (.enum ety)
          ⟨aid, p.offsetBytes.toNat⟩ with
      | .ok r => r
      | .error _ => none
    | none => none
  | _ => none

/-- On entry `q`, body `defId` is well-formed, returns exactly `out`, and has
no other terminal behavior. -/
def returnsExactly (p : Program) (defId : DefId) (q : Query)
    (out : TerminalOut) : Prop :=
  BehaviorV2 (entryProgForBody p defId) q out ∧
  SatisfiesPostV2 (entryProgForBody p defId) q (fun o => o = out)

/-- Body `defId` is the safe function `identity`, and on every valid entry it
returns `()` with caller memory unchanged. -/
def unitBodyPost (p : Program) (defId : DefId) (identity : String) : Prop :=
  match Trusted.MirSemantics.getElem? p.bodies defId with
  | none => False
  | some body =>
    body.identity = identity ∧ body.isUnsafe = false ∧
    ∀ q : Query, ValidEntryArgsV2 body q →
      returnsExactly p defId q (.returned ⟨.unit, q.callerMem⟩)

/-- Body `defId` is the safe `Clone::clone` method `identity` of the fieldless
enum `ety`: on every valid entry `(&self)` it returns exactly the `ety` value
that `self` points to, with caller memory unchanged. -/
def cloneBodyPost (p : Program) (defId : DefId) (identity : String)
    (ety : EnumTy) : Prop :=
  match Trusted.MirSemantics.getElem? p.bodies defId with
  | none => False
  | some body =>
    body.identity = identity ∧ body.isUnsafe = false ∧
    ∀ q : Query, ValidEntryArgsV2 body q →
      match q.args with
      | [self] =>
        ∃ v : Val, derefEntry q ety self = some v ∧
          returnsExactly p defId q (.returned ⟨v, q.callerMem⟩)
      | _ => False

/-- Body `defId` is the safe `PartialEq::eq` method `identity` of the fieldless
enum `ety` whose discriminants are its variant indices: on every valid entry
`(&self, &other)`, including aliased references, both pointees are variants of
`ety`, and the body returns whether they are the same variant, with caller
memory unchanged. -/
def eqBodyPost (p : Program) (defId : DefId) (identity : String)
    (ety : EnumTy) : Prop :=
  match Trusted.MirSemantics.getElem? p.bodies defId with
  | none => False
  | some body =>
    body.identity = identity ∧ body.isUnsafe = false ∧
    ∀ q : Query, ValidEntryArgsV2 body q →
      match q.args with
      | [self, other] =>
        ∃ i j : Nat,
          derefEntry q ety self = some (.enumVal ety i) ∧
          derefEntry q ety other = some (.enumVal ety j) ∧
          returnsExactly p defId q
            (.returned ⟨.bool (Nat.beq i j), q.callerMem⟩)
      | _ => False

def orderCloneId : String :=
  "rust-path-v1::<byteorder::Order as core::clone::Clone>::clone"

def orderAssertEqId : String :=
  "rust-path-v1::<byteorder::Order as core::cmp::Eq>::assert_fields_are_eq"

def orderEqId : String :=
  "rust-path-v1::<byteorder::Order as core::cmp::PartialEq>::eq"

def castTypeCloneId : String :=
  "rust-path-v1::<layout::CastType as core::clone::Clone>::clone"

/-- Identity of `<T as KnownLayout>::pointer_to_metadata` for the primitive or
unit type named `tyName`, generated by `impl_known_layout!`
(`util/macros.rs`) as `fn pointer_to_metadata(_ptr: *mut Self) -> () {}`. -/
def ptrMetaId (tyName : String) : String :=
  stringAppend (stringAppend "rust-path-v1::_::<impl KnownLayout for " tyName)
    ">::pointer_to_metadata"

/-- The 15 types whose `pointer_to_metadata` methods are bodies `4` through
`18`, in capture order. -/
def ptrMetaTypes : List String :=
  ["()", "u8", "i8", "u16", "i16", "u32", "i32", "u64", "i64", "u128", "i128",
   "usize", "isize", "bool", "char"]

/-- Bodies `defId, defId + 1, ...` are the `pointer_to_metadata` methods for
`tys`, each returning `()` (the `()` pointer metadata of a sized type) for
every `*mut Self` argument. -/
def ptrMetaPosts (p : Program) : DefId → List String → Prop
  | _, [] => True
  | defId, ty :: rest =>
    unitBodyPost p defId (ptrMetaId ty) ∧ ptrMetaPosts p (defId + 1) rest

def property (p : Program) : Prop :=
  cloneBodyPost p 0 orderCloneId orderEnumTy ∧
  unitBodyPost p 1 orderAssertEqId ∧
  eqBodyPost p 2 orderEqId orderEnumTy ∧
  cloneBodyPost p 3 castTypeCloneId castTypeEnumTy ∧
  ptrMetaPosts p 4 ptrMetaTypes

def specs : SpecsV2 := ⟨safetyPre, property⟩

end Spec
