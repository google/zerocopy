bench_ref_type_from_bytes_with_elems_dynamic_size:
	mov rax, rdi
	movabs rdi, 4611686018427387902
	cmp rcx, rdi
	jae .LBB5_2
	test sil, 1
	jne .LBB5_2
	lea rdi, [2*rcx + 4]
	cmp rdx, rdi
	jne .LBB5_2
	mov qword ptr [rax], rsi
	mov qword ptr [rax + 8], rdx
	mov qword ptr [rax + 16], rcx
	ret
.LBB5_2:
	mov qword ptr [rax], 0
	ret
