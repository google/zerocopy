bench_ref_type_from_bytes_with_elems_dynamic_padding:
	mov rax, rdi
	movabs rdi, 3074457345618258599
	cmp rcx, rdi
	jae .LBB5_2
	test sil, 3
	jne .LBB5_2
	lea rdi, [rcx + 2*rcx]
	or rdi, 3
	add rdi, 9
	cmp rdx, rdi
	jne .LBB5_2
	mov qword ptr [rax], rsi
	mov qword ptr [rax + 8], rdx
	mov qword ptr [rax + 16], rcx
