bench_ref_type_from_bytes_with_elems_dynamic_padding:
	mov rcx, rdx
	mov rdx, rsi
	movabs rsi, 6148914691236517201
	cmp rcx, rsi
	ja .LBB5_3
	lea rcx, [rcx + 2*rcx]
	or rcx, 3
	add rcx, 9
	cmp rdx, rcx
	jne .LBB5_3
	mov rax, rdi
	cmp rdx, 12
	setae cl
	mov esi, edx
	or esi, eax
	test sil, 3
	sete sil
	test sil, cl
	jne .LBB5_4
