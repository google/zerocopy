bench_ref_from_suffix_with_elems_dynamic_padding:
	movabs rcx, 3074457345618258598
	cmp rdx, rcx
	ja .LBB5_3
	mov rax, rdi
	lea rcx, [rdx + 2*rdx]
	add rcx, 4
	movabs rdi, 9223372036854775804
	and rdi, rcx
	add rdi, 8
	lea ecx, [rsi + rax]
	test cl, 3
	setne cl
	sub rsi, rdi
	setb dil
	or dil, cl
	je .LBB5_4
.LBB5_3:
	xor eax, eax
	ret
.LBB5_4:
	add rax, rsi
	ret
