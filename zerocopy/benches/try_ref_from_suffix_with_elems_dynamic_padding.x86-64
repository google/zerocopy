bench_try_ref_from_suffix_with_elems_dynamic_padding:
	movabs rax, 3074457345618258598
	cmp rdx, rax
	ja .LBB5_3
	lea rax, [rdx + 2*rdx]
	add rax, 4
	movabs rcx, 9223372036854775804
	and rcx, rax
	add rcx, 8
	lea eax, [rsi + rdi]
	test al, 3
	setne al
	sub rsi, rcx
	setb cl
	or cl, al
	je .LBB5_4
.LBB5_3:
	xor eax, eax
	ret
.LBB5_4:
	lea rcx, [rdi + rsi]
	xor eax, eax
	cmp word ptr [rdi + rsi], -16192
	cmove rax, rcx
	ret
