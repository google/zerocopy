bench_ref_from_suffix_dynamic_padding:
	lea eax, [rsi + rdi]
	test al, 3
	jne .LBB5_1
	movabs rax, 9223372036854775804
	and rax, rsi
	cmp rax, 9
	jae .LBB5_3
.LBB5_1:
	xor edi, edi
	mov rax, rdi
	ret
.LBB5_3:
	add rax, -9
	movabs rcx, -6148914691236517205
	mul rcx
	shr rdx
	and esi, 3
	add rdi, rsi
	mov rax, rdi
	ret
