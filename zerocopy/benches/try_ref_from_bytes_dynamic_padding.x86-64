bench_try_ref_from_bytes_dynamic_padding:
	cmp rsi, 12
	setae al
	mov ecx, esi
	or ecx, edi
	test cl, 3
	sete cl
	and cl, al
	cmp cl, 1
	je .LBB5_2
	xor eax, eax
	ret
.LBB5_2:
	mov rax, rsi
	or rax, 3
	add rax, -12
	movabs rcx, -6148914691236517205
	mul rcx
	shr rdx
	movzx ecx, word ptr [rdi]
	xor eax, eax
	cmp ecx, 49344
	cmovne rdx, rsi
	cmove rax, rdi
	ret
