bench_try_ref_from_bytes_dynamic_padding:
	movabs rax, 9223372036854775804
	and rax, rsi
	cmp rax, 9
	setae al
	mov ecx, esi
	or ecx, edi
	test cl, 3
	sete cl
	and cl, al
	cmp cl, 1
	jne .LBB5_1
	add rsi, -9
	movabs rcx, -6148914691236517205
	mov rax, rsi
	mul rcx
	shr rdx
	xor eax, eax
	cmp word ptr [rdi], -16192
	cmove rax, rdi
	ret
.LBB5_1:
	xor eax, eax
	ret
