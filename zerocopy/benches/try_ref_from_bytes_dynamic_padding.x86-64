bench_try_ref_from_bytes_dynamic_padding:
	test dil, 3
	jne .LBB5_1
	test sil, 3
	setne al
	cmp rsi, 9
	setb cl
	or cl, al
	je .LBB5_3
.LBB5_1:
	xor eax, eax
	ret
.LBB5_3:
	add rsi, -9
	movabs rcx, -6148914691236517205
	mov rax, rsi
	mul rcx
	shr rdx
	xor eax, eax
	cmp word ptr [rdi], -16192
	cmove rax, rdi
	ret
