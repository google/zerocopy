bench_ref_type_from_prefix_with_elems_dynamic_size:
	mov rax, rdi
	lea rcx, [rdx + rdx]
	test rdx, rdx
	sets dl
	cmp rcx, -5
	setae dil
	or dil, dl
	mov edx, 1
	je .LBB5_2
	xor eax, eax
	ret
.LBB5_2:
	add rcx, 4
	cmp rcx, rsi
	jbe .LBB5_4
	xor eax, eax
	ret
.LBB5_4:
	xor edx, edx
	test al, 1
	cmovne rcx, rdx
	cmovne rax, rdx
	mov rdx, rcx
	ret
