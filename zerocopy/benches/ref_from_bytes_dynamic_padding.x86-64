bench_ref_from_bytes_dynamic_padding:
	test dil, 3
	jne .LBB5_1
	movabs rax, 9223372036854775804
	and rax, rsi
	cmp rax, 9
	setb al
	test sil, 3
	setne cl
	or cl, al
	jne .LBB5_1
	add rsi, -9
	movabs rcx, -6148914691236517205
	mov rax, rsi
	mul rcx
	shr rdx
	mov rax, rdi
	ret
.LBB5_1:
	xor edi, edi
	mov rax, rdi
	ret
