bench_ref_from_bytes_with_elems_dynamic_padding:
	movabs rax, 3074457345618258598
	cmp rdx, rax
	seta cl
	mov rax, rdi
	test al, 3
	setne dil
	or dil, cl
	jne .LBB5_2
	lea rcx, [rdx + 2*rdx]
	add rcx, 4
	movabs rdi, 9223372036854775804
	and rdi, rcx
	add rdi, 8
	cmp rsi, rdi
	je .LBB5_3
.LBB5_2:
	xor eax, eax
	mov rdx, rsi
.LBB5_3:
	ret
