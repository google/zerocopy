	mov qword ptr [rsp + 8], rax
	mov qword ptr [rsp + 16], rdx
	lea rdi, [rip + .Lanon.HASH.7]
	lea rcx, [rip + .Lanon.HASH.1]
	lea r8, [rip + .Lanon.HASH.9]
