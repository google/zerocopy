gions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":17,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["Fn",0]},{"Ident":["{vtable}",0]}],"span":{"data":{"file_id":15,"beg":{"line":76,"col":0},"end":{"line":76,"col":52}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Args"},{"index":1,"name":"Ty0"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"VTableTy":{"dyn_predicate":{"binder":{"params":{"regions":[],"types":[{"index":0,"name":"_dyn"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"Dyn","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":280},{"Deduplicated":1984},{"Deduplicated":1990}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":280},"Erased"]}],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":279},"kind":"Dyn"}},"field_map":[],"supertrait_map":[null]}},"kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":18,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["borrow",0]},{"Ident":["Cow",0]}],"span":{"data":{"file_id":18,"beg":{"line":169,"col":0},"end":{"line":169,"col":32}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A clone-on-write smart pointer."},{"DocComment":""},{"DocComment":" The type `Cow` is a smart pointer providing clone-on-write functionality: it"},{"DocComment":" can enclose and provide immutable access to borrowed data, and clone the"},{"DocComment":" data lazily when mutation or ownership is required. The type is designed to"},{"DocComment":" work with general borrowed data via the `Borrow` trait."},{"DocComment":""},{"DocComment":" `Cow` implements `Deref`, which means that you can call"},{"DocComment":" non-mutating methods directly on the data it encloses. If mutation"},{"DocComment":" is desired, `to_mut` will obtain a mutable reference to an owned"},{"DocComment":" value, cloning if necessary."},{"DocComment":""},{"DocComment":" If you need reference-counting pointers, note that"},{"DocComment":" [`Rc::make_mut`][crate::rc::Rc::make_mut] and"},{"DocComment":" [`Arc::make_mut`][crate::sync::Arc::make_mut] can provide clone-on-write"},{"DocComment":" functionality as well."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::borrow::Cow;"},{"DocComment":""},{"DocComment":" fn abs_all(input: &mut Cow<'_, [i32]>) {"},{"DocComment":"     for i in 0..input.len() {"},{"DocComment":"         let v = input[i];"},{"DocComment":"         if v < 0 {"},{"DocComment":"             // Clones into a vector if not already owned."},{"DocComment":"             input.to_mut()[i] = -v;"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // No clone occurs because `input` doesn't need to be mutated."},{"DocComment":" let slice = [0, 1, 2];"},{"DocComment":" let mut input = Cow::from(&slice[..]);"},{"DocComment":" abs_all(&mut input);"},{"DocComment":""},{"DocComment":" // Clone occurs because `input` needs to be mutated."},{"DocComment":" let slice = [-1, 0, 1];"},{"DocComment":" let mut input = Cow::from(&slice[..]);"},{"DocComment":" abs_all(&mut input);"},{"DocComment":""},{"DocComment":" // No clone occurs because `input` is already owned."},{"DocComment":" let mut input = Cow::from(vec![-1, 0, 1]);"},{"DocComment":" abs_all(&mut input);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Another example showing how to keep `Cow` in a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::borrow::Cow;"},{"DocComment":""},{"DocComment":" struct Items<'a, X> where [X]: ToOwned<Owned = Vec<X>> {"},{"DocComment":"     values: Cow<'a, [X]>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<'a, X: Clone + 'a> Items<'a, X> where [X]: ToOwned<Owned = Vec<X>> {"},{"DocComment":"     fn new(v: Cow<'a, [X]>) -> Self {"},{"DocComment":"         Items { values: v }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Creates a container from borrowed values of a slice"},{"DocComment":" let readonly = [1, 2];"},{"DocComment":" let borrowed = Items::new((&readonly[..]).into());"},{"DocComment":" match borrowed {"},{"DocComment":"     Items { values: Cow::Borrowed(b) } => println!(\"borrowed {b:?}\"),"},{"DocComment":"     _ => panic!(\"expect borrowed value\"),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut clone_on_write = borrowed;"},{"DocComment":" // Mutates the data from slice into owned vec and pushes a new value on top"},{"DocComment":" clone_on_write.values.to_mut().push(3);"},{"DocComment":" println!(\"clone_on_write = {:?}\", clone_on_write.values);"},{"DocComment":""},{"DocComment":" // The data was mutated. Let's check it out."},{"DocComment":" match clone_on_write {"},{"DocComment":"     Items { values: Cow::Owned(_) } => println!(\"clone_on_write contains owned data\"),"},{"DocComment":"     _ => panic!(\"expect owned data\"),"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Cow"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Shared"}],"types":[{"index":0,"name":"B"},{"index":1,"name":"Clause0_Owned"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":1984},{"Var":{"Free":0}}]},{"regions":[],"skip_binder":[{"Deduplicated":1984},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":18,"beg":{"line":175,"col":4},"end":{"line":175,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Borrowed data."}],"inline":null,"rename":null,"public":true},"name":"Borrowed","fields":[{"span":{"data":{"file_id":18,"beg":{"line":175,"col":59},"end":{"line":175,"col":64}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"HashConsedValue":[1991,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":1984},"Shared"]}]}}],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":18,"beg":{"line":179,"col":4},"end":{"line":179,"col":9}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Owned data."}],"inline":null,"rename":null,"public":true},"name":"Owned","fields":[{"span":{"data":{"file_id":18,"beg":{"line":179,"col":56},"end":{"line":179,"col":77}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":1990}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":19,"item_meta":{"name":[{"Ident":["test",0]},{"Ident":["types",0]},{"Ident":["NamePadding",0]}],"span":{"data":{"file_id":1,"beg":{"line":31,"col":0},"end":{"line":31,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_