(
(assume a0 (and (<= 0 (! (select source 0) :named @p_1)) (< @p_1 256)))
(assume a1 (and (<= 0 (! (select source 1) :named @p_2)) (< @p_2 256)))
(assume a2 (and (<= 0 (! (select current 0) :named @p_3)) (< @p_3 256)))
(assume a3 (and (<= 0 (! (select current 1) :named @p_4)) (< @p_4 256)))
(assume a4 (and (<= 0 replacement) (< replacement 256)))
(assume a5 (or (= changed 0) (= changed 1)))
(assume a6 (or (= framed 0) (= framed 1)))
(assume a7 (select write_authority changed))
(assume a8 (not (= changed framed)))
(assume a9 (! (not (! (= (select (store source changed replacement) changed) replacement) :named @p_5)) :named @p_6))
(step t0 (cl (not (! (= @p_6 false) :named @p_7)) (not @p_6) false) :rule equiv_pos2)
(step t1 (cl @p_5) :rule rare_rewrite :args ("array-read-over-write" source changed replacement))
(step t2 (cl (! (= replacement replacement) :named @p_9)) :rule refl)
(step t3 (cl (= @p_5 @p_9)) :rule cong :premises (t1 t2))
(step t4 (cl (= @p_9 true)) :rule rare_rewrite :args ("eq-refl" replacement))
(step t5 (cl (= @p_5 true)) :rule trans :premises (t3 t4))
(step t6 (cl (= @p_6 (! (not true) :named @p_8))) :rule cong :premises (t5))
(step t7 (cl (= @p_8 false)) :rule evaluate)
(step t8 (cl @p_7) :rule trans :premises (t6 t7))
(step t9 (cl false) :rule resolution :premises (t0 t8 a9))
(step t10 (cl (not false)) :rule false)
(step t11 (cl) :rule resolution :premises (t9 t10))
)
