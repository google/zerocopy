import ToyRelax.Unwind.Model

/-!
# Results: unwind-table correctness, the generated table, and checker soundness
-/

namespace Toy.Unwind

/-! ### Agreement between abstract and concrete states -/

/-- The abstract state `A` describes the concrete state `s` reached from the
entry state `s0`. -/
def Agrees (s0 : MState) (A : AState) (s : MState) : Prop :=
  s.sp = s0.sp - A.d ∧
  (∀ r q, A.regs r = .entry q → s.regs r = s0.regs q) ∧
  (∀ k q, A.slot k = .entry q → s.mem (s0.sp - k) = s0.regs q)

theorem agrees_init (s0 : MState) : Agrees s0 AState.init s0 := by
  refine ⟨by simp [AState.init], ?_, ?_⟩
  · intro r q h
    simp only [AState.init, AVal.entry.injEq] at h
    rw [h]
  · intro k q h
    simp [AState.init] at h

theorem agrees_execOp {s0 : MState} {A : AState} {s : MState} (o : Op) (h : Agrees s0 A s) :
    Agrees s0 (absOp o A) (execOp o s) := by
  obtain ⟨hsp, hregs, hslot⟩ := h
  cases o with
  | push r =>
    refine ⟨by simp only [execOp, absOp]; omega, ?_, ?_⟩
    · intro r' q h'
      exact hregs r' q h'
    · intro k q h'
      simp only [absOp, upd] at h'
      simp only [execOp, upd]
      by_cases hk : k = A.d + 1
      · rw [ite_eq_left hk] at h'
        rw [ite_eq_left (by omega)]
        exact hregs r q h'
      · rw [ite_eq_right hk] at h'
        rw [ite_eq_right (by omega)]
        exact hslot k q h'
  | subSp n =>
    refine ⟨by simp only [execOp, absOp]; omega, hregs, hslot⟩
  | saveAt r off =>
    refine ⟨by simp only [execOp, absOp]; omega, hregs, ?_⟩
    intro k q h'
    simp only [absOp, upd] at h'
    simp only [execOp, upd]
    by_cases hk : k = A.d - off
    · rw [ite_eq_left hk] at h'
      rw [ite_eq_left (by omega)]
      exact hregs r q h'
    · rw [ite_eq_right hk] at h'
      rw [ite_eq_right (by omega)]
      exact hslot k q h'
  | pop r =>
    refine ⟨by simp only [execOp, absOp]; omega, ?_, hslot⟩
    intro r' q h'
    simp only [absOp, upd] at h'
    simp only [execOp, upd]
    by_cases hr : r' = r
    · rw [ite_eq_left hr] at h'
      rw [ite_eq_left hr]
      have := hslot A.d q h'
      rw [hsp]
      exact this
    · rw [ite_eq_right hr] at h'
      rw [ite_eq_right hr]
      exact hregs r' q h'
  | addSp n =>
    refine ⟨by simp only [execOp, absOp]; omega, hregs, hslot⟩
  | setReg r v =>
    refine ⟨hsp, ?_, hslot⟩
    intro r' q h'
    simp only [absOp, upd] at h'
    simp only [execOp, upd]
    by_cases hr : r' = r
    · rw [ite_eq_left hr] at h'
      cases h'
    · rw [ite_eq_right hr] at h'
      rw [ite_eq_right hr]
      exact hregs r' q h'

theorem agrees_run {s0 : MState} : ∀ (os : List Op) (A : AState) (s : MState),
    Agrees s0 A s → Agrees s0 (absRun os A) (run os s)
  | [], _, _, h => h
  | o :: os, _, _, h => agrees_run os _ _ (agrees_execOp o h)

/-! ## Result 7a: checker soundness -/

/-- **Result 7a (checker soundness).**  If the abstract-interpretation checker
accepts a table for a body and a caller-visible register set, the table is
correct in the sense of `TableCorrect`. -/
theorem checkTable_sound {body : List Op} {cs : List Nat} {tbl : Table}
    (h : checkTable body cs tbl = true) : TableCorrect body cs tbl := by
  intro s0 i hi
  have hrow : checkRow (absRun (body.take i) AState.init) cs (tbl i) = true := by
    unfold checkTable at h
    rw [List.all_eq_true] at h
    exact h i (List.mem_range.mpr (by omega))
  have hag := agrees_run (body.take i) _ _ (agrees_init s0)
  unfold checkRow at hrow
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at hrow
  obtain ⟨hcfa, hrules⟩ := hrow
  obtain ⟨hsp, hregs, hslot⟩ := hag
  refine ⟨by rw [hsp, hcfa]; omega, ?_⟩
  intro r hr
  have hok := hrules r hr
  unfold recoverReg
  cases hrule : (tbl i).rule r with
  | savedAt off =>
    rw [hrule] at hok
    simp only [ruleOk, beq_iff_eq] at hok
    have := hslot off r hok
    simp only [Option.some.injEq]
    rw [hsp, hcfa]
    rw [show s0.sp - (absRun (List.take i body) AState.init).d +
        (absRun (List.take i body) AState.init).d - off = s0.sp - off by omega]
    exact this
  | sameValue =>
    rw [hrule] at hok
    simp only [ruleOk, beq_iff_eq] at hok
    simp only [Option.some.injEq]
    exact hregs r r hok
  | undefined =>
    rw [hrule] at hok
    simp [ruleOk] at hok

/-! ## Result 6a: the table generated by abstract interpretation is correct -/

/-- **Result 6a (generated table correct).**  If the abstract interpretation
finds, at every code offset, every caller-visible register either unchanged
or in a stack slot (that is, the generated table assigns no caller-visible
register the rule `undefined`), then the generated table is correct. -/
theorem genTable_correct_of_no_undefined {body : List Op} {cs : List Nat}
    (h : ∀ i, i ≤ body.length → ∀ r ∈ cs, (genTable body i).rule r ≠ .undefined) :
    TableCorrect body cs (genTable body) := by
  apply checkTable_sound
  unfold checkTable
  rw [List.all_eq_true]
  intro i hi
  have hi' : i ≤ body.length := by
    rw [List.mem_range] at hi
    omega
  have hne := h i hi'
  unfold checkRow
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true]
  refine ⟨rfl, ?_⟩
  intro r hr
  have hner := hne r hr
  simp only [genTable] at hner ⊢
  generalize absRun (List.take i body) AState.init = A at hner ⊢
  unfold genRule at hner ⊢
  by_cases hsame : A.regs r = .entry r
  · simp [hsame, ruleOk]
  · simp only [hsame, ↓reduceIte] at hner ⊢
    cases hfind : A.written.find? (fun k => A.slot k == .entry r) with
    | none =>
      rw [hfind] at hner
      exact absurd rfl hner
    | some k =>
      have := List.find?_some hfind
      simpa [ruleOk] using this

end Toy.Unwind
