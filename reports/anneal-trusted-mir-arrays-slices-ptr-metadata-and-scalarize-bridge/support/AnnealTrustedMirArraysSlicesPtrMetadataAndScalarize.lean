              | some slots' => rw [hSet] at h; exact stepStmtNext_preserves_defId f cm slots' h
  | arrayLivenessCheck arrLocal =>
    rw [evalArrSliceStmt_arrayLivenessCheck] at h
    cases hD : Trusted.MirSemantics.getElem? body.locals arrLocal with
    | none => rw [hD] at h; cases h
    | some d =>
      cases d with
      | base _ => rw [hD] at h; cases h
      | sliceView _ => rw [hD] at h; cases h
      | array _ _ =>
        cases hS : Trusted.MirSemantics.getElem? f.locals arrLocal with
        | none => rw [hD, hS] at h; cases h
        | some sl =>
          cases sl with
          | baseSlot _ => rw [hD, hS] at h; cases h
          | arrDead => rw [hD, hS] at h; cases h
          | sliceDead => rw [hD, hS] at h; cases h
          | liveSlice _ => rw [hD, hS] at h; cases h
          | liveArray _ => rw [hD, hS] at h; exact stepStmtNext_preserves_defId f cm f.locals h
  | readArrayConst dst arr idx isMove =>
    dsimp [evalArrSliceStmt] at h
    cases hDD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hDD] at h; cases h
    | some d1 =>
      cases d1 with
      | array _ _ => rw [hDD] at h; cases h
      | sliceView _ => rw [hDD] at h; cases h
      | base dstTy =>
        cases hDA : Trusted.MirSemantics.getElem? body.locals arr with
        | none => rw [hDD, hDA] at h; cases h
        | some d2 =>
          cases d2 with
          | base _ => rw [hDD, hDA] at h; cases h
          | sliceView _ => rw [hDD, hDA] at h; cases h
          | array elemTy len =>
            cases hS : Trusted.MirSemantics.getElem? f.locals arr with
            | none => rw [hDD, hDA, hS] at h; cases h
            | some sl =>
              cases sl with
              | baseSlot _ => rw [hDD, hDA, hS] at h; cases h
              | sliceDead => rw [hDD, hDA, hS] at h; cases h
              | liveSlice _ => rw [hDD, hDA, hS] at h; cases h
              | arrDead =>
                rw [hDD, hDA, hS] at h; dsimp at h
                cases hBT : MirTy.beq dstTy elemTy <;> (rw [hBT] at h; cases h)
              | liveArray elems =>
                rw [hDD, hDA, hS] at h; dsimp at h
                cases hTy : !(MirTy.beq dstTy elemTy) with
                | true => rw [hTy] at h; cases h
                | false =>
                  rw [hTy] at h; dsimp at h
                  cases hLt : !Nat.blt idx len with
                  | true => rw [hLt] at h; cases h
                  | false =>
                    rw [hLt] at h; dsimp at h
                    cases hEl : Trusted.MirSemantics.getElem? elems idx with
                    | none => rw [hEl] at h; cases h
                    | some ov =>
                      cases ov with
                      | none => rw [hEl] at h; cases h
                      | some v =>
                        rw [hEl] at h; dsimp at h
                        cases hIM : isMove with
                        | false =>
                          rw [hIM] at h; dsimp at h
                          cases hWr : writeArrSliceBasePlace f.locals dst dstTy v with
                          | error _ => rw [hWr] at h; cases h
                          | ok slots' => rw [hWr] at h; exact stepStmtNext_preserves_defId f cm slots' h
                        | true =>
                          rw [hIM] at h; dsimp at h
                          cases hSE1 : setElem? elems idx (initElemOptVal elemTy) with
                          | none => rw [hSE1] at h; cases h
                          | some elems' =>
                            rw [hSE1] at h; dsimp at h
                            cases hSE2 : setElem? f.locals arr (.liveArray elems') with
                            | none => rw [hSE2] at h; cases h
