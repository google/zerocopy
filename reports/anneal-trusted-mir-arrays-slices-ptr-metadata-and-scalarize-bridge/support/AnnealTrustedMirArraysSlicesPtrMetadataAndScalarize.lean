  bodies := [{
    argumentCount := 1
    locals := [
      .base (.int .i32 false),    -- _0: return u32
      .base usizeTy,              -- _1: arg idx: usize
      .array (.int .i32 false) 4, -- _2: [10, 20, 30, 40]
      .sliceView (.int .i32 false), -- _3: &[u32]
      .base usizeTy               -- _4: len = slice.len()
