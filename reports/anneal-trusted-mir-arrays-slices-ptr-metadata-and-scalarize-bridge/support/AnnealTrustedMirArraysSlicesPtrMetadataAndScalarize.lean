private theorem lowerStmtForSlices_unsize (decls : List ArrSliceLocalDecl) (entries : List SliceBackingEntry)
    (base sLoc arrLoc : Nat) :
    lowerStmtForSlices decls entries base (.unsizeArrayToSlice sLoc arrLoc) =
      match findSliceEntry entries sLoc, Trusted.MirSemantics.getElem? decls arrLoc with
      | some (k, _), some (.array _ len) =>
        let off := base + 4 * k
        [.arrayLivenessCheck arrLoc, mkLivenessCheckStmt off,
          mkAssignUse (off + 1) (usizeConst 1),
          mkAssignUse (off + 2) (usizeConst 0),
          mkAssignUse (off + 3) (usizeConst len)]
      | _, _ => [.baseStmt .unsupported] := rfl

private theorem lowerStmtForSlices_sliceFromRawParts (decls : List ArrSliceLocalDecl)
    (entries : List SliceBackingEntry) (base sLoc : Nat) (lenOp : Operand) :
    lowerStmtForSlices decls entries base (.sliceFromRawParts sLoc lenOp) =
      let scrIdx := base + 4 * entries.length + 3
      match findSliceEntry entries sLoc with
      | some (k, _) =>
        let off := base + 4 * k
        [mkAssignUse scrIdx lenOp, mkLivenessCheckStmt off,
          mkAssignUse (off + 1) (usizeConst 0),
          mkAssignUse (off + 2) (usizeConst 0),
          mkAssignUse (off + 3) (.move { localId := scrIdx })]
      | none => [.baseStmt .unsupported] := rfl

private theorem lowerStmtForSlices_subslice (decls : List ArrSliceLocalDecl)
    (entries : List SliceBackingEntry) (base dstS srcS fromIdx toIdx : Nat) (fromEnd : Bool) :
    lowerStmtForSlices decls entries base (.subslice dstS srcS fromIdx toIdx fromEnd) =
      let scrBase := base + 4 * entries.length
      let scrTag := scrBase
      let scrA := scrBase + 1
      let scrB := scrBase + 2
      let scrIdx := scrBase + 3
      match findSliceEntry entries dstS, findSliceEntry entries srcS with
      | some (kD, _), some (kS, _) =>
        let offD := base + 4 * kD
        let offS := base + 4 * kS
        let readSrc := [mkLivenessCheckStmt offS, mkAssignUse scrTag (.copy { localId := offS + 1 })]
        let boundsStmts :=
          if (!fromEnd) = true then
            if (!fromIdx.ble toIdx) = true then [mkImmediateUbStmt scrA]
            else
              [mkSubUncheckedUsize scrA (.copy { localId := offS + 3 }) (usizeConst toIdx),
                mkAddUncheckedUsize scrIdx (.copy { localId := offS + 2 }) (usizeConst fromIdx),
                mkAssignUse scrB (usizeConst (toIdx - fromIdx))]
          else
            if (!(fromIdx + toIdx).blt maxUsize) = true then [mkImmediateUbStmt scrA]
            else
              [mkSubUncheckedUsize scrB (.copy { localId := offS + 3 }) (usizeConst (fromIdx + toIdx)),
                mkAddUncheckedUsize scrIdx (.copy { localId := offS + 2 }) (usizeConst fromIdx)]
        let writeDst :=
          [mkLivenessCheckStmt offD, mkAssignUse (offD + 1) (.move { localId := scrTag }),
            mkAssignUse (offD + 2) (.move { localId := scrIdx }),
            mkAssignUse (offD + 3) (.move { localId := scrB })]
        readSrc ++ boundsStmts ++ writeDst
      | _, _ => [.baseStmt .unsupported] := rfl

private theorem lowerStmtForSlices_ptrMetadata (decls : List ArrSliceLocalDecl)
    (entries : List SliceBackingEntry) (base dst sLoc : Nat) :
    lowerStmtForSlices decls entries base (.ptrMetadata dst sLoc) =
      let scrTag := base + 4 * entries.length
      match findSliceEntry entries sLoc with
      | some (k, _) =>
        let off := base + 4 * k
        [mkLivenessCheckStmt off, mkAssignUse scrTag (.copy { localId := off + 1 }),
          mkAssignUse dst (.copy { localId := off + 3 })]
      | none => [.baseStmt .unsupported] := rfl

private theorem lowerStmtForSlices_any_storageMarker_iff
    (decls : List ArrSliceLocalDecl) (entries : List SliceBackingEntry)
    (base tgtId : Nat) (stmt : ArrSliceStmt) :
    (lowerStmtForSlices decls entries base stmt).any (arrSliceStmtHasStorageMarker tgtId) = true ↔
      (∃ id, arrSliceStmtHasStorageMarker id stmt = true ∧
        match findSliceEntry entries id with
        | some (k, _) => base + 4 * k ≤ tgtId ∧ tgtId < base + 4 * k + 4
        | none => id = tgtId) := by
  cases stmt with
  | baseStmt s =>
    cases s with
    | storageLive id =>
      change ((match findSliceEntry entries id with
          | some (k, _) => mkStorageLiveRange (base + 4 * k) 4
          | none => [.baseStmt (.storageLive id)]).any (arrSliceStmtHasStorageMarker tgtId)) = true ↔ _
      cases hf : findSliceEntry entries id with
      | some p =>
        cases p with
        | mk k optArr =>
          rw [arrSliceStmtHasStorageMarker_mkStorageLiveRange_iff]
          constructor
          · intro hRange
            exact ⟨id, nat_beq_true rfl, by rw [hf]; exact hRange⟩
          · intro hEx
            cases hEx with | intro id' hId' =>
            have hEq : id = id' := nat_beq_eq _ _ hId'.1
            have hMatch := hId'.2
            rw [← hEq, hf] at hMatch
            exact hMatch
      | none =>
        constructor
        · intro hAny
          have h0 : Nat.beq id tgtId = true := by
            change (Nat.beq id tgtId || false) = true at hAny
            cases (bool_or_eq_true _ _).mp hAny with
            | inl ha => exact ha
            | inr hb => cases hb
          exact ⟨id, nat_beq_true rfl, by rw [hf]; exact nat_beq_eq _ _ h0⟩
        · intro hEx
          cases hEx with | intro id' hId' =>
          have hEq : id = id' := nat_beq_eq _ _ hId'.1
          have hMatch := hId'.2
          rw [← hEq, hf] at hMatch
          change (Nat.beq id tgtId || false) = true
          apply (bool_or_eq_true _ _).mpr
          left
          exact nat_beq_true hMatch
    | storageDead id =>
      change ((match findSliceEntry entries id with
          | some (k, _) => mkStorageDeadRange (base + 4 * k) 4
          | none => [.baseStmt (.storageDead id)]).any (arrSliceStmtHasStorageMarker tgtId)) = true ↔ _
      cases hf : findSliceEntry entries id with
      | some p =>
        cases p with
        | mk k optArr =>
          rw [arrSliceStmtHasStorageMarker_mkStorageDeadRange_iff]
          constructor
          · intro hRange
            exact ⟨id, nat_beq_true rfl, by rw [hf]; exact hRange⟩
          · intro hEx
            cases hEx with | intro id' hId' =>
            have hEq : id = id' := nat_beq_eq _ _ hId'.1
            have hMatch := hId'.2
            rw [← hEq, hf] at hMatch
            exact hMatch
      | none =>
        constructor
        · intro hAny
          have h0 : Nat.beq id tgtId = true := by
            change (Nat.beq id tgtId || false) = true at hAny
            cases (bool_or_eq_true _ _).mp hAny with
            | inl ha => exact ha
            | inr hb => cases hb
          exact ⟨id, nat_beq_true rfl, by rw [hf]; exact nat_beq_eq _ _ h0⟩
        · intro hEx
          cases hEx with | intro id' hId' =>
          have hEq : id = id' := nat_beq_eq _ _ hId'.1
          have hMatch := hId'.2
          rw [← hEq, hf] at hMatch
          change (Nat.beq id tgtId || false) = true
          apply (bool_or_eq_true _ _).mpr
          left
          exact nat_beq_true hMatch
    | nop =>
      constructor
      · intro h; cases h
      · intro h; cases h with | intro _ hw => cases hw.1
    | unsupported =>
      constructor
      · intro h; cases h
      · intro h; cases h with | intro _ hw => cases hw.1
    | assign _ _ =>
      constructor
      · intro h; cases h
      · intro h; cases h with | intro _ hw => cases hw.1
  | aggregateArray _ _ =>
    constructor
    · intro h; cases h
    · intro h; cases h with | intro _ hw => cases hw.1
  | repeatArray _ _ =>
    constructor
    · intro h; cases h
    · intro h; cases h with | intro _ hw => cases hw.1
  | arrayLivenessCheck _ =>
    constructor
    · intro h; cases h
    · intro h; cases h with | intro _ hw => cases hw.1
  | readArrayConst _ _ _ _ =>
    constructor
    · intro h; cases h
    · intro h; cases h with | intro _ hw => cases hw.1
  | writeArrayConst _ _ _ =>
    constructor
    · intro h; cases h
    · intro h; cases h with | intro _ hw => cases hw.1
  | unsizeArrayToSlice sLoc arrLoc =>
    rw [lowerStmtForSlices_unsize]
    cases hf : findSliceEntry entries sLoc with
    | none =>
      constructor
      · intro h; cases h
      · intro h; cases h with | intro _ hw => cases hw.1
    | some p =>
      cases ha : Trusted.MirSemantics.getElem? decls arrLoc with
      | none =>
        constructor
        · intro h; cases h
        · intro h; cases h with | intro _ hw => cases hw.1
      | some d =>
        cases d with
        | base _ =>
          constructor
          · intro h; cases h
          · intro h; cases h with | intro _ hw => cases hw.1
        | sliceView _ =>
          constructor
          · intro h; cases h
          · intro h; cases h with | intro _ hw => cases hw.1
        | array _ len =>
          constructor
          · intro h
            change (arrSliceStmtHasStorageMarker tgtId (.arrayLivenessCheck arrLoc) ||
              (arrSliceStmtHasStorageMarker tgtId (mkLivenessCheckStmt (base + 4 * p.1)) ||
              (arrSliceStmtHasStorageMarker tgtId (mkAssignUse (base + 4 * p.1 + 1) (usizeConst 1)) ||
              (arrSliceStmtHasStorageMarker tgtId (mkAssignUse (base + 4 * p.1 + 2) (usizeConst 0)) ||
              (arrSliceStmtHasStorageMarker tgtId (mkAssignUse (base + 4 * p.1 + 3) (usizeConst len)) || false))))) = true at h
            rw [arrSliceStmtHasStorageMarker_arrayLivenessCheck,
                arrSliceStmtHasStorageMarker_mkLivenessCheckStmt,
                arrSliceStmtHasStorageMarker_mkAssignUse,
                arrSliceStmtHasStorageMarker_mkAssignUse,
                arrSliceStmtHasStorageMarker_mkAssignUse] at h
            cases h
          · intro h; cases h with | intro _ hw => cases hw.1
  | sliceFromRawParts sLoc lenOp =>
    rw [lowerStmtForSlices_sliceFromRawParts]
    cases hf : findSliceEntry entries sLoc with
    | none =>
      constructor
      · intro h; cases h
      · intro h; cases h with | intro _ hw => cases hw.1
    | some p =>
      constructor
      · intro h
        change (arrSliceStmtHasStorageMarker tgtId (mkAssignUse (base + 4 * entries.length + 3) lenOp) ||
          (arrSliceStmtHasStorageMarker tgtId (mkLivenessCheckStmt (base + 4 * p.1)) ||
          (arrSliceStmtHasStorageMarker tgtId (mkAssignUse (base + 4 * p.1 + 1) (usizeConst 0)) ||
          (arrSliceStmtHasStorageMarker tgtId (mkAssignUse (base + 4 * p.1 + 2) (usizeConst 0)) ||
          (arrSliceStmtHasStorageMarker tgtId (mkAssignUse (base + 4 * p.1 + 3) (.move { localId := base + 4 * entries.length + 3 })) || false))))) = true at h
        rw [arrSliceStmtHasStorageMarker_mkAssignUse,
            arrSliceStmtHasStorageMarker_mkLivenessCheckStmt,
            arrSliceStmtHasStorageMarker_mkAssignUse,
            arrSliceStmtHasStorageMarker_mkAssignUse,
            arrSliceStmtHasStorageMarker_mkAssignUse] at h
        cases h
      · intro h; cases h with | intro _ hw => cases hw.1
  | subslice dstS srcS fromIdx toIdx fromEnd =>
    rw [lowerStmtForSlices_subslice]
    cases hf1 : findSliceEntry entries dstS with
    | none =>
      constructor
      · intro h; cases h
      · intro h; cases h with | intro _ hw => cases hw.1
    | some pD =>
      cases hf2 : findSliceEntry entries srcS with
      | none =>
        constructor
        · intro h; cases h
        · intro h; cases h with | intro _ hw => cases hw.1
      | some pS =>
        constructor
        · intro h
          rw [list_any_append, list_any_append] at h
          have hRead : ([mkLivenessCheckStmt (base + 4 * pS.1),
              mkAssignUse (base + 4 * entries.length) (.copy { localId := base + 4 * pS.1 + 1 })].any
              (arrSliceStmtHasStorageMarker tgtId)) = false := by
            change (arrSliceStmtHasStorageMarker tgtId (mkLivenessCheckStmt _) ||
              (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) || false)) = false
            rw [arrSliceStmtHasStorageMarker_mkLivenessCheckStmt, arrSliceStmtHasStorageMarker_mkAssignUse]
            rfl
          have hWrite : ([mkLivenessCheckStmt (base + 4 * pD.1),
              mkAssignUse (base + 4 * pD.1 + 1) (.move { localId := base + 4 * entries.length }),
              mkAssignUse (base + 4 * pD.1 + 2) (.move { localId := base + 4 * entries.length + 3 }),
              mkAssignUse (base + 4 * pD.1 + 3) (.move { localId := base + 4 * entries.length + 2 })].any
              (arrSliceStmtHasStorageMarker tgtId)) = false := by
            change (arrSliceStmtHasStorageMarker tgtId (mkLivenessCheckStmt _) ||
              (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) ||
              (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) ||
              (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) || false)))) = false
            rw [arrSliceStmtHasStorageMarker_mkLivenessCheckStmt,
                arrSliceStmtHasStorageMarker_mkAssignUse,
                arrSliceStmtHasStorageMarker_mkAssignUse,
                arrSliceStmtHasStorageMarker_mkAssignUse]
            rfl
          have hBounds : ((if (!fromEnd) = true then
              if (!fromIdx.ble toIdx) = true then [mkImmediateUbStmt (base + 4 * entries.length + 1)]
              else [mkSubUncheckedUsize (base + 4 * entries.length + 1) (.copy { localId := base + 4 * pS.1 + 3 }) (usizeConst toIdx),
                mkAddUncheckedUsize (base + 4 * entries.length + 3) (.copy { localId := base + 4 * pS.1 + 2 }) (usizeConst fromIdx),
                mkAssignUse (base + 4 * entries.length + 2) (usizeConst (toIdx - fromIdx))]
            else
              if (!(fromIdx + toIdx).blt maxUsize) = true then [mkImmediateUbStmt (base + 4 * entries.length + 1)]
              else [mkSubUncheckedUsize (base + 4 * entries.length + 2) (.copy { localId := base + 4 * pS.1 + 3 }) (usizeConst (fromIdx + toIdx)),
                mkAddUncheckedUsize (base + 4 * entries.length + 3) (.copy { localId := base + 4 * pS.1 + 2 }) (usizeConst fromIdx)]).any
              (arrSliceStmtHasStorageMarker tgtId)) = false := by
            cases (!fromEnd)
            · cases (!(fromIdx + toIdx).blt maxUsize)
              · change (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) ||
                  (arrSliceStmtHasStorageMarker tgtId (mkAddUncheckedUsize _ _ _) || false)) = false
                rw [arrSliceStmtHasStorageMarker_mkSubUncheckedUsize, arrSliceStmtHasStorageMarker_mkAddUncheckedUsize]
                rfl
              · change (arrSliceStmtHasStorageMarker tgtId (mkImmediateUbStmt _) || false) = false
                rw [arrSliceStmtHasStorageMarker_mkImmediateUbStmt]
                rfl
            · cases (!fromIdx.ble toIdx)
              · change (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) ||
                  (arrSliceStmtHasStorageMarker tgtId (mkAddUncheckedUsize _ _ _) ||
                  (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) || false))) = false
                rw [arrSliceStmtHasStorageMarker_mkSubUncheckedUsize,
                    arrSliceStmtHasStorageMarker_mkAddUncheckedUsize,
                    arrSliceStmtHasStorageMarker_mkAssignUse]
                rfl
              · change (arrSliceStmtHasStorageMarker tgtId (mkImmediateUbStmt _) || false) = false
                rw [arrSliceStmtHasStorageMarker_mkImmediateUbStmt]
                rfl
          rw [hRead, hWrite, hBounds] at h
          cases h
        · intro h; cases h with | intro _ hw => cases hw.1
  | ptrMetadata dst sLoc =>
    rw [lowerStmtForSlices_ptrMetadata]
    cases hf : findSliceEntry entries sLoc with
    | none =>
      constructor
      · intro h; cases h
      · intro h; cases h with | intro _ hw => cases hw.1
    | some p =>
      constructor
      · intro h
        change (arrSliceStmtHasStorageMarker tgtId (mkLivenessCheckStmt (base + 4 * p.1)) ||
          (arrSliceStmtHasStorageMarker tgtId (mkAssignUse (base + 4 * entries.length) (.copy { localId := base + 4 * p.1 + 1 })) ||
          (arrSliceStmtHasStorageMarker tgtId (mkAssignUse dst (.copy { localId := base + 4 * p.1 + 3 })) || false))) = true at h
        rw [arrSliceStmtHasStorageMarker_mkLivenessCheckStmt,
            arrSliceStmtHasStorageMarker_mkAssignUse,
            arrSliceStmtHasStorageMarker_mkAssignUse] at h
        cases h
      · intro h; cases h with | intro _ hw => cases hw.1

private theorem lowerTermForSlices_boundsCheckSlice (entries : List SliceBackingEntry) (base sLoc : LocalId)
    (idxOp : Operand) (inBoundsBb panicBb : BasicBlockId) :
    lowerTermForSlices entries base (.boundsCheckSlice sLoc idxOp inBoundsBb panicBb) =
      let scrBase := base + 4 * entries.length
      let scrTag := scrBase
      let scrIdx := scrBase + 3
      let scrCond := scrBase + 4
      match findSliceEntry entries sLoc with
      | some (k, _) =>
        let off := base + 4 * k
        ([mkLivenessCheckStmt off, mkAssignUse scrTag (.copy { localId := off + 1 }),
            mkAssignUse scrIdx idxOp,
            mkLtUsize scrCond (.move { localId := scrIdx }) (.copy { localId := off + 3 })],
          ArrSliceTerm.baseTerm (.switchInt (.move { localId := scrCond })
            { branches := [(BitVec.ofNat 128 1, inBoundsBb)], otherwise := panicBb }))
      | none => ([], ArrSliceTerm.baseTerm .unsupported) := rfl

private theorem lowerTermForSlices_readSliceElem (entries : List SliceBackingEntry)
    (base dst sLoc : LocalId) (idxOp : Operand) (nextBb : BasicBlockId) :
    lowerTermForSlices entries base (.readSliceElem dst sLoc idxOp nextBb) =
      let scrBase := base + 4 * entries.length
      let scrTag := scrBase
      let scrA := scrBase + 1
      let scrB := scrBase + 2
      let scrIdx := scrBase + 3
      match findSliceEntry entries sLoc with
      | some (k, optArr) =>
        let off := base + 4 * k
        let pre :=
          [mkLivenessCheckStmt off, mkAssignUse scrTag (.copy { localId := off + 1 }),
            mkAssignUse scrIdx idxOp,
            mkSubUncheckedUsize scrA (.copy { localId := off + 3 }) (usizeConst 1),
            mkSubUncheckedUsize scrB (.move { localId := scrA }) (.copy { localId := scrIdx }),
            mkSubUncheckedUsize scrB (.move { localId := scrTag }) (usizeConst 1)]
        match optArr with
        | some arrLoc =>
          (pre ++ [mkAddUncheckedUsize scrIdx (.copy { localId := off + 2 }) (.copy { localId := scrIdx })],
            ArrSliceTerm.readArrayElem dst arrLoc (.move { localId := scrIdx }) nextBb)
        | none => (pre, ArrSliceTerm.baseTerm .unreachable)
      | none => ([], ArrSliceTerm.baseTerm .unsupported) := rfl

private theorem lowerTermForSlices_readSliceConst (entries : List SliceBackingEntry)
    (base dst sLoc offset minLen : Nat) (fromEnd : Bool) (nextBb : BasicBlockId) :
    lowerTermForSlices entries base (.readSliceConst dst sLoc offset minLen fromEnd nextBb) =
      let scrBase := base + 4 * entries.length
      let scrTag := scrBase
      let scrA := scrBase + 1
      let scrB := scrBase + 2
      let scrIdx := scrBase + 3
      match findSliceEntry entries sLoc with
      | some (k, optArr) =>
        let off := base + 4 * k
        let preHead :=
          [mkLivenessCheckStmt off, mkAssignUse scrTag (.copy { localId := off + 1 }),
            mkSubUncheckedUsize scrA (.copy { localId := off + 3 }) (usizeConst minLen)]
        let relStmts :=
          if (!fromEnd) = true then
            [mkSubUncheckedUsize scrA (.copy { localId := off + 3 }) (usizeConst 1),
              mkSubUncheckedUsize scrB (.move { localId := scrA }) (usizeConst offset),
              mkAssignUse scrIdx (usizeConst offset)]
          else
            if offset.beq 0 = true then [mkImmediateUbStmt scrA]
            else [mkSubUncheckedUsize scrIdx (.copy { localId := off + 3 }) (usizeConst offset)]
        let tagChk := [mkSubUncheckedUsize scrB (.move { localId := scrTag }) (usizeConst 1)]
        match optArr with
        | some arrLoc =>
          (preHead ++ relStmts ++ tagChk ++
              [mkAddUncheckedUsize scrIdx (.copy { localId := off + 2 }) (.copy { localId := scrIdx })],
            ArrSliceTerm.readArrayElem dst arrLoc (.move { localId := scrIdx }) nextBb)
        | none => (preHead ++ relStmts ++ tagChk, ArrSliceTerm.baseTerm .unreachable)
      | none => ([], ArrSliceTerm.baseTerm .unsupported) := rfl

private theorem lowerTermForSlices_any_storageMarker_false
    (entries : List SliceBackingEntry) (base tgtId : Nat) (term : ArrSliceTerm) :
    (lowerTermForSlices entries base term).1.any (arrSliceStmtHasStorageMarker tgtId) = false := by
  cases term with
  | baseTerm k => cases k <;> rfl
  | sliceLenCall _ _ _ => rfl
  | boundsCheckArray _ _ _ _ => rfl
  | readArrayElem _ _ _ _ => rfl
  | writeArrayElem _ _ _ _ => rfl
  | boundsCheckSlice sLoc idxOp inBoundsBb panicBb =>
    rw [lowerTermForSlices_boundsCheckSlice]
    cases hf : findSliceEntry entries sLoc with
    | none => rfl
    | some p =>
      cases p with
      | mk k optArr =>
        change (arrSliceStmtHasStorageMarker tgtId (mkLivenessCheckStmt _) ||
          (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) ||
          (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) ||
          (arrSliceStmtHasStorageMarker tgtId (mkLtUsize _ _ _) || false)))) = false
        rw [arrSliceStmtHasStorageMarker_mkLivenessCheckStmt,
            arrSliceStmtHasStorageMarker_mkAssignUse,
            arrSliceStmtHasStorageMarker_mkAssignUse,
            arrSliceStmtHasStorageMarker_mkLtUsize]
        rfl
  | readSliceElem dst sLoc idxOp nextBb =>
    rw [lowerTermForSlices_readSliceElem]
    cases hf : findSliceEntry entries sLoc with
    | none => rfl
    | some p =>
      cases p with
      | mk k optArr =>
        have hPre : ([mkLivenessCheckStmt (base + 4 * k),
            mkAssignUse (base + 4 * entries.length) (.copy { localId := base + 4 * k + 1 }),
            mkAssignUse (base + 4 * entries.length + 3) idxOp,
            mkSubUncheckedUsize (base + 4 * entries.length + 1) (.copy { localId := base + 4 * k + 3 }) (usizeConst 1),
            mkSubUncheckedUsize (base + 4 * entries.length + 2) (.move { localId := base + 4 * entries.length + 1 }) (.copy { localId := base + 4 * entries.length + 3 }),
            mkSubUncheckedUsize (base + 4 * entries.length + 2) (.move { localId := base + 4 * entries.length }) (usizeConst 1)].any
            (arrSliceStmtHasStorageMarker tgtId)) = false := by
          change (arrSliceStmtHasStorageMarker tgtId (mkLivenessCheckStmt _) ||
            (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) ||
            (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) ||
            (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) ||
            (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) ||
            (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) || false)))))) = false
          rw [arrSliceStmtHasStorageMarker_mkLivenessCheckStmt,
              arrSliceStmtHasStorageMarker_mkAssignUse,
              arrSliceStmtHasStorageMarker_mkAssignUse,
              arrSliceStmtHasStorageMarker_mkSubUncheckedUsize,
              arrSliceStmtHasStorageMarker_mkSubUncheckedUsize,
              arrSliceStmtHasStorageMarker_mkSubUncheckedUsize]
          rfl
        cases optArr with
        | none => exact hPre
        | some arrLoc =>
          change (List.any ([mkLivenessCheckStmt (base + 4 * k),
              mkAssignUse (base + 4 * entries.length) (.copy { localId := base + 4 * k + 1 }),
              mkAssignUse (base + 4 * entries.length + 3) idxOp,
              mkSubUncheckedUsize (base + 4 * entries.length + 1) (.copy { localId := base + 4 * k + 3 }) (usizeConst 1),
              mkSubUncheckedUsize (base + 4 * entries.length + 2) (.move { localId := base + 4 * entries.length + 1 }) (.copy { localId := base + 4 * entries.length + 3 }),
              mkSubUncheckedUsize (base + 4 * entries.length + 2) (.move { localId := base + 4 * entries.length }) (usizeConst 1)] ++
              [mkAddUncheckedUsize (base + 4 * entries.length + 3) (.copy { localId := base + 4 * k + 2 }) (.copy { localId := base + 4 * entries.length + 3 })])
              (arrSliceStmtHasStorageMarker tgtId)) = false
          rw [list_any_append, hPre]
          change (false || (arrSliceStmtHasStorageMarker tgtId (mkAddUncheckedUsize _ _ _) || false)) = false
          rw [arrSliceStmtHasStorageMarker_mkAddUncheckedUsize]
          rfl
  | readSliceConst dst sLoc offset minLen fromEnd nextBb =>
    rw [lowerTermForSlices_readSliceConst]
    cases hf : findSliceEntry entries sLoc with
    | none => rfl
    | some p =>
      cases p with
      | mk k optArr =>
        let preHead :=
          [mkLivenessCheckStmt (base + 4 * k),
            mkAssignUse (base + 4 * entries.length) (.copy { localId := base + 4 * k + 1 }),
            mkSubUncheckedUsize (base + 4 * entries.length + 1) (.copy { localId := base + 4 * k + 3 }) (usizeConst minLen)]
        let relStmts :=
          if (!fromEnd) = true then
            [mkSubUncheckedUsize (base + 4 * entries.length + 1) (.copy { localId := base + 4 * k + 3 }) (usizeConst 1),
              mkSubUncheckedUsize (base + 4 * entries.length + 2) (.move { localId := base + 4 * entries.length + 1 }) (usizeConst offset),
              mkAssignUse (base + 4 * entries.length + 3) (usizeConst offset)]
          else
            if offset.beq 0 = true then [mkImmediateUbStmt (base + 4 * entries.length + 1)]
            else [mkSubUncheckedUsize (base + 4 * entries.length + 3) (.copy { localId := base + 4 * k + 3 }) (usizeConst offset)]
        let tagChk := [mkSubUncheckedUsize (base + 4 * entries.length + 2) (.move { localId := base + 4 * entries.length }) (usizeConst 1)]
        have hHead : preHead.any (arrSliceStmtHasStorageMarker tgtId) = false := by
          change (arrSliceStmtHasStorageMarker tgtId (mkLivenessCheckStmt _) ||
            (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) ||
            (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) || false))) = false
          rw [arrSliceStmtHasStorageMarker_mkLivenessCheckStmt,
              arrSliceStmtHasStorageMarker_mkAssignUse,
              arrSliceStmtHasStorageMarker_mkSubUncheckedUsize]
          rfl
        have hRel : List.any relStmts (arrSliceStmtHasStorageMarker tgtId) = false := by
          change List.any (if (!fromEnd) = true then
              [mkSubUncheckedUsize (base + 4 * entries.length + 1) (.copy { localId := base + 4 * k + 3 }) (usizeConst 1),
                mkSubUncheckedUsize (base + 4 * entries.length + 2) (.move { localId := base + 4 * entries.length + 1 }) (usizeConst offset),
                mkAssignUse (base + 4 * entries.length + 3) (usizeConst offset)]
            else
              if offset.beq 0 = true then [mkImmediateUbStmt (base + 4 * entries.length + 1)]
              else [mkSubUncheckedUsize (base + 4 * entries.length + 3) (.copy { localId := base + 4 * k + 3 }) (usizeConst offset)])
              (arrSliceStmtHasStorageMarker tgtId) = false
          cases (!fromEnd)
          · cases offset.beq 0
            · change (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) || false) = false
              rw [arrSliceStmtHasStorageMarker_mkSubUncheckedUsize]; rfl
            · change (arrSliceStmtHasStorageMarker tgtId (mkImmediateUbStmt _) || false) = false
              rw [arrSliceStmtHasStorageMarker_mkImmediateUbStmt]; rfl
          · change (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) ||
              (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) ||
              (arrSliceStmtHasStorageMarker tgtId (mkAssignUse _ _) || false))) = false
            rw [arrSliceStmtHasStorageMarker_mkSubUncheckedUsize,
                arrSliceStmtHasStorageMarker_mkSubUncheckedUsize,
                arrSliceStmtHasStorageMarker_mkAssignUse]
            rfl
        have hTag : tagChk.any (arrSliceStmtHasStorageMarker tgtId) = false := by
          change (arrSliceStmtHasStorageMarker tgtId (mkSubUncheckedUsize _ _ _) || false) = false
          rw [arrSliceStmtHasStorageMarker_mkSubUncheckedUsize]; rfl
        cases optArr with
        | none =>
          change List.any (preHead ++ relStmts ++ tagChk) (arrSliceStmtHasStorageMarker tgtId) = false
          rw [list_any_append, list_any_append, hHead, hRel, hTag]
          rfl
        | some arrLoc =>
          change List.any (preHead ++ relStmts ++ tagChk ++
              [mkAddUncheckedUsize (base + 4 * entries.length + 3) (.copy { localId := base + 4 * k + 2 }) (.copy { localId := base + 4 * entries.length + 3 })])
              (arrSliceStmtHasStorageMarker tgtId) = false
          rw [list_any_append, list_any_append, list_any_append, hHead, hRel, hTag]
          change ((false || false) || false || (arrSliceStmtHasStorageMarker tgtId (mkAddUncheckedUsize _ _ _) || false)) = false
          rw [arrSliceStmtHasStorageMarker_mkAddUncheckedUsize]
          rfl

private theorem arrSliceStorageAnnotationsInBounds_bodyTgt {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) :
    arrSliceStorageAnnotationsInBounds pack.bodyTgt = true := by
  change pack.bodyTgt.basicBlocks.all (fun bb =>
    bb.statements.all (fun stmt =>
      match stmt with
      | .baseStmt (.storageLive id) => Nat.blt id pack.bodyTgt.locals.length
      | .baseStmt (.storageDead id) => Nat.blt id pack.bodyTgt.locals.length
      | _ => true)) = true
  apply (list_all_iff_getElem? _ _).mpr
  intro bi bbTgt hGetBb
  rw [pack.hBodyTgt] at hGetBb
  change Trusted.MirSemantics.getElem? (List.map (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) pack.bodySrc.basicBlocks) bi = some bbTgt at hGetBb
  rw [getElem?_map] at hGetBb
  cases hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bi with
  | none => rw [hBbSrc] at hGetBb; cases hGetBb
  | some bbSrc =>
    rw [hBbSrc] at hGetBb
    injection hGetBb with hbbEq
    rw [← hbbEq]
    have hStorAll := (list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hStor bi bbSrc hBbSrc
    apply (list_all_iff_getElem? _ _).mpr
    intro si stmtTgt hGetSt
    have hNo : ∀ tgtId, arrSliceStmtHasStorageMarker tgtId stmtTgt = true →
        Nat.blt tgtId pack.bodyTgt.locals.length = true := by
      intro tgtId hMark
      have hAny : (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc).statements.any
          (arrSliceStmtHasStorageMarker tgtId) = true := by
        apply (list_any_iff_getElem? _ _).mpr
        exact ⟨si, stmtTgt, hGetSt, hMark⟩
      change (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) bbSrc.statements ++
          (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1).any
          (arrSliceStmtHasStorageMarker tgtId) = true at hAny
      rw [list_any_append, lowerTermForSlices_any_storageMarker_false] at hAny
      have hFlatAny : (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) bbSrc.statements).any
          (arrSliceStmtHasStorageMarker tgtId) = true := by
        cases (bool_or_eq_true _ _).mp hAny with
        | inl hL => exact hL
        | inr hR => cases hR
      have hFlatEx := (listFlatMap_any_iff _ _ _).mp hFlatAny
      cases hFlatEx with | intro j hj =>
      cases hj with | intro stmtSrc hStmtPair =>
      have hjGet := hStmtPair.1
      have hStmtAny := hStmtPair.2
      have hSrcStBound := (list_all_iff_getElem? _ bbSrc.statements).mp hStorAll j stmtSrc hjGet
      have hMarkEx :=
        (lowerStmtForSlices_any_storageMarker_iff pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length tgtId stmtSrc).mp hStmtAny
      cases hMarkEx with | intro id hId =>
      have hSrcMark := hId.1
      have hMatch := hId.2
      have hIdLtSrc : id < pack.bodySrc.locals.length := by
        cases stmtSrc with
        | baseStmt s =>
          cases s with
          | storageLive id' =>
            have hEq : id' = id := nat_beq_eq _ _ hSrcMark
            rw [← hEq]; exact nat_blt_lt hSrcStBound
          | storageDead id' =>
            have hEq : id' = id := nat_beq_eq _ _ hSrcMark
            rw [← hEq]; exact nat_blt_lt hSrcStBound
          | nop => cases hSrcMark
          | unsupported => cases hSrcMark
          | assign _ _ => cases hSrcMark
        | aggregateArray _ _ => cases hSrcMark
        | repeatArray _ _ => cases hSrcMark
        | arrayLivenessCheck _ => cases hSrcMark
        | readArrayConst _ _ _ _ => cases hSrcMark
        | writeArrayConst _ _ _ => cases hSrcMark
        | unsizeArrayToSlice _ _ => cases hSrcMark
        | sliceFromRawParts _ _ => cases hSrcMark
        | subslice _ _ _ _ _ => cases hSrcMark
        | ptrMetadata _ _ => cases hSrcMark
      rw [bodyTgt_locals_length pack]
      cases hf : findSliceEntry plan.entries id with
      | none =>
        rw [hf] at hMatch
        rw [← hMatch, Nat.blt_eq]
        exact Nat.lt_of_lt_of_le hIdLtSrc (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
      | some p =>
        rw [hf] at hMatch
        have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hf).1
        rw [Nat.blt_eq]
        have h4 : 4 * (p.1 + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hkLt
        rw [Nat.mul_succ] at h4
        have hltComp : tgtId < pack.bodySrc.locals.length + 4 * plan.entries.length :=
          Nat.lt_of_lt_of_le hMatch.2 (Nat.add_le_add_left h4 _)
        exact Nat.lt_of_lt_of_le hltComp (Nat.le_add_right _ 5)
    cases stmtTgt with
    | baseStmt s =>
      cases s with
      | storageLive id => exact hNo id (nat_beq_true rfl)
      | storageDead id => exact hNo id (nat_beq_true rfl)
      | nop => rfl
      | unsupported => rfl
      | assign _ _ => rfl
    | aggregateArray _ _ => rfl
    | repeatArray _ _ => rfl
    | arrayLivenessCheck _ => rfl
    | readArrayConst _ _ _ _ => rfl
    | writeArrayConst _ _ _ => rfl
    | unsizeArrayToSlice _ _ => rfl
    | sliceFromRawParts _ _ => rfl
    | subslice _ _ _ _ _ => rfl
    | ptrMetadata _ _ => rfl

private theorem arrSliceHasStorageAnnotation_bodyTgt_iff
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) (tgtId : LocalId) :
    arrSliceHasStorageAnnotation pack.bodyTgt tgtId = true ↔
      ∃ id, arrSliceHasStorageAnnotation pack.bodySrc id = true ∧
        match findSliceEntry plan.entries id with
        | some (k, _) =>
          pack.bodySrc.locals.length + 4 * k ≤ tgtId ∧
            tgtId < pack.bodySrc.locals.length + 4 * k + 4
        | none => id = tgtId := by
  change pack.bodyTgt.basicBlocks.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker tgtId)) = true ↔ _
  rw [list_any_iff_getElem?]
  constructor
  · intro hBbEx
    cases hBbEx with | intro bi hBi =>
    cases hBi with | intro bbTgt hBbTgt =>
    have hGetBb := hBbTgt.1
    have hBbAny := hBbTgt.2
    rw [pack.hBodyTgt] at hGetBb
    change Trusted.MirSemantics.getElem? (List.map (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) pack.bodySrc.basicBlocks) bi = some bbTgt at hGetBb
    rw [getElem?_map] at hGetBb
    cases hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bi with
    | none => rw [hBbSrc] at hGetBb; cases hGetBb
    | some bbSrc =>
      rw [hBbSrc] at hGetBb
      injection hGetBb with hbbEq
      rw [← hbbEq] at hBbAny
      change (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) bbSrc.statements ++
          (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1).any
          (arrSliceStmtHasStorageMarker tgtId) = true at hBbAny
      rw [list_any_append, lowerTermForSlices_any_storageMarker_false] at hBbAny
      have hFlatAny : (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) bbSrc.statements).any
          (arrSliceStmtHasStorageMarker tgtId) = true := by
        cases (bool_or_eq_true _ _).mp hBbAny with
        | inl hL => exact hL
        | inr hR => cases hR
      have hFlatEx := (listFlatMap_any_iff _ _ _).mp hFlatAny
      cases hFlatEx with | intro si hSi =>
      cases hSi with | intro stmtSrc hStmtPair =>
      have hStGet := hStmtPair.1
      have hStmtAny := hStmtPair.2
      have hMarkEx :=
        (lowerStmtForSlices_any_storageMarker_iff pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length tgtId stmtSrc).mp hStmtAny
      cases hMarkEx with | intro id hId =>
      refine ⟨id, ?_, hId.2⟩
      change pack.bodySrc.basicBlocks.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker id)) = true
      apply (list_any_iff_getElem? _ _).mpr
      refine ⟨bi, bbSrc, hBbSrc, ?_⟩
      apply (list_any_iff_getElem? _ _).mpr
      exact ⟨si, stmtSrc, hStGet, hId.1⟩
  · intro hEx
    cases hEx with | intro id hId =>
    have hSrcAnnot := hId.1
    have hMatch := hId.2
    change pack.bodySrc.basicBlocks.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker id)) = true at hSrcAnnot
    have hSrcEx := (list_any_iff_getElem? _ _).mp hSrcAnnot
    cases hSrcEx with | intro bi hBi =>
    cases hBi with | intro bbSrc hBbPair =>
    have hBbSrc := hBbPair.1
    have hBbAny := hBbPair.2
    have hStEx := (list_any_iff_getElem? _ _).mp hBbAny
    cases hStEx with | intro si hSi =>
    cases hSi with | intro stmtSrc hStPair =>
    have hStGet := hStPair.1
    have hSrcMark := hStPair.2
    have hStmtAny : (lowerStmtForSlices pack.bodySrc.locals plan.entries
        pack.bodySrc.locals.length stmtSrc).any (arrSliceStmtHasStorageMarker tgtId) = true :=
      (lowerStmtForSlices_any_storageMarker_iff pack.bodySrc.locals plan.entries
        pack.bodySrc.locals.length tgtId stmtSrc).mpr ⟨id, hSrcMark, hMatch⟩
    have hFlatAny : (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) bbSrc.statements).any
        (arrSliceStmtHasStorageMarker tgtId) = true :=
      (listFlatMap_any_iff _ _ _).mpr ⟨si, stmtSrc, hStGet, hStmtAny⟩
    refine ⟨bi, lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc, ?_, ?_⟩
    · rw [pack.hBodyTgt]
      change Trusted.MirSemantics.getElem? (List.map (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) pack.bodySrc.basicBlocks) bi = _
      rw [getElem?_map, hBbSrc]
    · change (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) bbSrc.statements ++
          (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1).any
          (arrSliceStmtHasStorageMarker tgtId) = true
      rw [list_any_append]
      apply (bool_or_eq_true _ _).mpr
      exact Or.inl hFlatAny

private theorem arrSliceHasStorageAnnotation_bodyTgt_nonSlice
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {i : LocalId}
    (hi : i < pack.bodySrc.locals.length)
    (hNone : findSliceEntry plan.entries i = none) :
    arrSliceHasStorageAnnotation pack.bodyTgt i =
      arrSliceHasStorageAnnotation pack.bodySrc i := by
  cases hTgt : arrSliceHasStorageAnnotation pack.bodyTgt i
  · cases hSrc : arrSliceHasStorageAnnotation pack.bodySrc i
    · rfl
    · have hTrue := (arrSliceHasStorageAnnotation_bodyTgt_iff pack i).mpr
        ⟨i, hSrc, by rw [hNone]⟩
      rw [hTgt] at hTrue
      cases hTrue
  · have hEx := (arrSliceHasStorageAnnotation_bodyTgt_iff pack i).mp hTgt
    cases hEx with | intro id hId =>
    have hSrcAnnot := hId.1
    have hMatch := hId.2
    cases hf : findSliceEntry plan.entries id with
    | some p =>
      rw [hf] at hMatch
      have hGe : pack.bodySrc.locals.length ≤ i :=
        Nat.le_trans (Nat.le_add_right _ _) hMatch.1
      exact False.elim (Nat.not_lt_of_ge hGe hi)
    | none =>
      rw [hf] at hMatch
      rw [← hMatch, hSrcAnnot]

private theorem arrSliceHasStorageAnnotation_bodyTgt_comp
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {sLoc k r : Nat}
    (hFind : findSliceEntry plan.entries sLoc = some (k, optArr)) (hr : r < 4) :
    arrSliceHasStorageAnnotation pack.bodyTgt (pack.bodySrc.locals.length + 4 * k + r) =
      arrSliceHasStorageAnnotation pack.bodySrc sLoc := by
  have hBoundId : ∀ id, arrSliceHasStorageAnnotation pack.bodySrc id = true →
      id < pack.bodySrc.locals.length := by
    intro id hAnnot
    change pack.bodySrc.basicBlocks.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker id)) = true at hAnnot
    have hBbEx := (list_any_iff_getElem? _ _).mp hAnnot
    cases hBbEx with | intro bi hBi =>
    cases hBi with | intro bb hBbPair =>
    have hBb := hBbPair.1
    have hStEx := (list_any_iff_getElem? _ _).mp hBbPair.2
    cases hStEx with | intro si hSi =>
    cases hSi with | intro stmt hStPair =>
    have hSt := hStPair.1
    have hMark := hStPair.2
    have hStorAll := (list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hStor bi bb hBb
    have hStB := (list_all_iff_getElem? _ bb.statements).mp hStorAll si stmt hSt
    cases stmt with
    | baseStmt s =>
      cases s with
      | storageLive id' =>
        have hEq : id' = id := nat_beq_eq _ _ hMark
        rw [← hEq]; exact nat_blt_lt hStB
      | storageDead id' =>
        have hEq : id' = id := nat_beq_eq _ _ hMark
        rw [← hEq]; exact nat_blt_lt hStB
      | nop => cases hMark
      | unsupported => cases hMark
      | assign _ _ => cases hMark
    | aggregateArray _ _ => cases hMark
    | repeatArray _ _ => cases hMark
    | arrayLivenessCheck _ => cases hMark
    | readArrayConst _ _ _ _ => cases hMark
    | writeArrayConst _ _ _ => cases hMark
    | unsizeArrayToSlice _ _ => cases hMark
    | sliceFromRawParts _ _ => cases hMark
    | subslice _ _ _ _ _ => cases hMark
    | ptrMetadata _ _ => cases hMark
  cases hTgt : arrSliceHasStorageAnnotation pack.bodyTgt (pack.bodySrc.locals.length + 4 * k + r)
  · cases hSrc : arrSliceHasStorageAnnotation pack.bodySrc sLoc
    · rfl
    · have hMatch : pack.bodySrc.locals.length + 4 * k ≤ pack.bodySrc.locals.length + 4 * k + r ∧
          pack.bodySrc.locals.length + 4 * k + r < pack.bodySrc.locals.length + 4 * k + 4 :=
        ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hr _⟩
      have hTrue := (arrSliceHasStorageAnnotation_bodyTgt_iff pack (pack.bodySrc.locals.length + 4 * k + r)).mpr
        ⟨sLoc, hSrc, by rw [hFind]; exact hMatch⟩
      rw [hTgt] at hTrue
      cases hTrue
  · have hEx := (arrSliceHasStorageAnnotation_bodyTgt_iff pack (pack.bodySrc.locals.length + 4 * k + r)).mp hTgt
    cases hEx with | intro id hId =>
    have hSrcAnnot := hId.1
    have hMatch := hId.2
    cases hf : findSliceEntry plan.entries id with
    | none =>
      rw [hf] at hMatch
      have hIdLt := hBoundId id hSrcAnnot
      rw [hMatch] at hIdLt
      have hGe : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 4 * k + r :=
        Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      exact False.elim (Nat.not_lt_of_ge hGe hIdLt)
    | some p =>
      rw [hf] at hMatch
      let r' := (pack.bodySrc.locals.length + 4 * k + r) - (pack.bodySrc.locals.length + 4 * p.1)
      have hr'Lt : r' < 4 := by
        have hSub : pack.bodySrc.locals.length + 4 * p.1 + r' =
            pack.bodySrc.locals.length + 4 * k + r := s_nat_add_sub_cancel_prime hMatch.1
        have hlt : pack.bodySrc.locals.length + 4 * p.1 + r' <
            pack.bodySrc.locals.length + 4 * p.1 + 4 := by
          rw [hSub]; exact hMatch.2
        exact s_nat_lt_of_add_lt_add_left hlt
      have hSum : pack.bodySrc.locals.length + 4 * p.1 + r' =
          pack.bodySrc.locals.length + 4 * k + r := s_nat_add_sub_cancel_prime hMatch.1
      rw [Nat.add_assoc pack.bodySrc.locals.length (4 * p.1) r',
          Nat.add_assoc pack.bodySrc.locals.length (4 * k) r] at hSum
      have hFour := Nat.add_left_cancel hSum
      have hInj := nat_four_mul_add_inj hr'Lt hr hFour
      rw [← hInj.1] at hFind
      have hFInj := findSliceEntry_inj pack.hLoop hf hFind
      rw [← hFInj.1, hSrcAnnot]

private theorem arrSliceHasStorageAnnotation_bodyTgt_scratch
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {r : Nat} :
    arrSliceHasStorageAnnotation pack.bodyTgt
      (pack.bodySrc.locals.length + 4 * plan.entries.length + r) = false := by
  have hBoundId : ∀ id, arrSliceHasStorageAnnotation pack.bodySrc id = true →
      id < pack.bodySrc.locals.length := by
    intro id hAnnot
    change pack.bodySrc.basicBlocks.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker id)) = true at hAnnot
    have hBbEx := (list_any_iff_getElem? _ _).mp hAnnot
    cases hBbEx with | intro bi hBi =>
    cases hBi with | intro bb hBbPair =>
    have hBb := hBbPair.1
    have hStEx := (list_any_iff_getElem? _ _).mp hBbPair.2
    cases hStEx with | intro si hSi =>
    cases hSi with | intro stmt hStPair =>
    have hSt := hStPair.1
    have hMark := hStPair.2
    have hStorAll := (list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hStor bi bb hBb
    have hStB := (list_all_iff_getElem? _ bb.statements).mp hStorAll si stmt hSt
    cases stmt with
    | baseStmt s =>
      cases s with
      | storageLive id' =>
        have hEq : id' = id := nat_beq_eq _ _ hMark
        rw [← hEq]; exact nat_blt_lt hStB
      | storageDead id' =>
        have hEq : id' = id := nat_beq_eq _ _ hMark
        rw [← hEq]; exact nat_blt_lt hStB
      | nop => cases hMark
      | unsupported => cases hMark
      | assign _ _ => cases hMark
    | aggregateArray _ _ => cases hMark
    | repeatArray _ _ => cases hMark
    | arrayLivenessCheck _ => cases hMark
    | readArrayConst _ _ _ _ => cases hMark
    | writeArrayConst _ _ _ => cases hMark
    | unsizeArrayToSlice _ _ => cases hMark
    | sliceFromRawParts _ _ => cases hMark
    | subslice _ _ _ _ _ => cases hMark
    | ptrMetadata _ _ => cases hMark
  cases hTgt : arrSliceHasStorageAnnotation pack.bodyTgt
      (pack.bodySrc.locals.length + 4 * plan.entries.length + r)
  · rfl
  · have hEx :=
      (arrSliceHasStorageAnnotation_bodyTgt_iff pack (pack.bodySrc.locals.length + 4 * plan.entries.length + r)).mp hTgt
    cases hEx with | intro id hId =>
    have hSrcAnnot := hId.1
    have hMatch := hId.2
    cases hf : findSliceEntry plan.entries id with
    | none =>
      rw [hf] at hMatch
      have hIdLt := hBoundId id hSrcAnnot
      rw [hMatch] at hIdLt
      have hGe : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
        Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      exact False.elim (Nat.not_lt_of_ge hGe hIdLt)
    | some p =>
      rw [hf] at hMatch
      have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hf).1
      have h4 : 4 * (p.1 + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hkLt
      rw [Nat.mul_succ] at h4
      have hGe : pack.bodySrc.locals.length + 4 * p.1 + 4 ≤
          pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
        Nat.le_trans (Nat.add_le_add_left h4 _) (Nat.le_add_right _ r)
      exact False.elim (Nat.not_lt_of_ge hGe hMatch.2)

