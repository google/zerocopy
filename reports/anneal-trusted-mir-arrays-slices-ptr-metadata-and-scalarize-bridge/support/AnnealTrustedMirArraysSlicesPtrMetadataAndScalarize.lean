  | none => progCe4LoweredLen

theorem ce4_lower_slice_len_and_gvn_fold_ptr_metadata :
    checkLowerSliceLenCalls 0 0 progCe4Src progCe4LoweredLen = true ∧
    checkGvnFoldPtrMetadata 0 0 0 1 progCe4LoweredLen progCe4Folded = true ∧
