private theorem arrSc_evalArrSliceBaseRvalue_prefix {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPref : arrSc_PrefixMatch pack slots₁ slots₂)
    (dstTy : MirTy) (rval : Rvalue)
    (hRval : rvalueUsesOnlyBase pack.bodySrc.locals rval = true) :
    (∃ k : FaultKind,
      evalArrSliceBaseRvalue pack.bodySrc.locals slots₁ dstTy rval = .error k ∧
      evalArrSliceBaseRvalue pack.bodyTgt.locals slots₂ dstTy rval = .error k) ∨
    (∃ (v : Val) (slots₁' slots₂' : List ArrSliceSlot),
      evalArrSliceBaseRvalue pack.bodySrc.locals slots₁ dstTy rval = .ok (v, slots₁') ∧
      evalArrSliceBaseRvalue pack.bodyTgt.locals slots₂ dstTy rval = .ok (v, slots₂') ∧
      arrSc_PrefixMatch pack slots₁' slots₂' ∧
      slots₂'.length = slots₂.length ∧
      (∀ j : Nat, pack.bodySrc.locals.length ≤ j →
        Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) ∧
      Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₁ plan.arrLocal ∧
      Trusted.MirSemantics.getElem? slots₂' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₂ plan.arrLocal) := by
  cases rval with
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported =>
    exact Or.inl ⟨.unsupported, rfl, rfl⟩
  | use op =>
    unfold rvalueUsesOnlyBase at hRval
    cases arrSc_evalArrSliceBaseOperandToSlot_prefix pack hPref op hRval with
    | inl hErr =>
      left
      refine ⟨.unsupported, ?_, ?_⟩
      · dsimp [evalArrSliceBaseRvalue]; rw [hErr.1]
      · dsimp [evalArrSliceBaseRvalue]; rw [hErr.2]
    | inr hRest =>
      cases hRest with
      | inl hErr =>
        left
        refine ⟨.undefined, ?_, ?_⟩
        · dsimp [evalArrSliceBaseRvalue]; rw [hErr.1]
        · dsimp [evalArrSliceBaseRvalue]; rw [hErr.2]
      | inr hOk =>
        cases hOk with
        | intro ty h1 => cases h1 with
        | intro optVal h2 => cases h2 with
        | intro slots₁' h3 => cases h3 with
        | intro slots₂' hAll =>
          dsimp [evalArrSliceBaseRvalue]
          rw [hAll.1, hAll.2.1]
          dsimp
          cases !(MirTy.beq ty dstTy) with
          | true => exact Or.inl ⟨.unsupported, rfl, rfl⟩
          | false =>
            dsimp
            cases optVal with
            | none => exact Or.inl ⟨.undefined, rfl, rfl⟩
            | some v => exact Or.inr ⟨v, slots₁', slots₂', rfl, rfl, hAll.2.2⟩
  | unaryOp uop op =>
    unfold rvalueUsesOnlyBase at hRval
    cases arrSc_evalArrSlicePrimitiveOperand_prefix pack hPref op hRval with
    | inl hErr =>
      cases hErr with
      | intro k hk =>
        left
        refine ⟨k, ?_, ?_⟩
        · dsimp [evalArrSliceBaseRvalue]; rw [hk.1]
        · dsimp [evalArrSliceBaseRvalue]; rw [hk.2]
    | inr hOk =>
      cases hOk with
      | intro v h1 => cases h1 with
      | intro slots₁' h2 => cases h2 with
      | intro slots₂' hAll =>
        dsimp [evalArrSliceBaseRvalue]
        rw [hAll.1, hAll.2.1]
        dsimp
        cases evalUnOp uop v with
        | error k => exact Or.inl ⟨k, rfl, rfl⟩
        | ok res => exact Or.inr ⟨res, slots₁', slots₂', rfl, rfl, hAll.2.2⟩
  | binaryOp bop lhs rhs =>
    unfold rvalueUsesOnlyBase at hRval
    have hOps := (bool_and_eq_true _ _).mp hRval
    cases arrSc_evalArrSlicePrimitiveOperand_prefix pack hPref lhs hOps.1 with
    | inl hErr =>
      cases hErr with
      | intro k hk =>
        left
        refine ⟨k, ?_, ?_⟩
        · dsimp [evalArrSliceBaseRvalue]; rw [hk.1]
        · dsimp [evalArrSliceBaseRvalue]; rw [hk.2]
    | inr hOkL =>
      cases hOkL with
      | intro lVal h1 => cases h1 with
      | intro slots₁Mid h2 => cases h2 with
      | intro slots₂Mid hAllL =>
        cases arrSc_evalArrSlicePrimitiveOperand_prefix pack hAllL.2.2.1 rhs hOps.2 with
        | inl hErrR =>
          cases hErrR with
          | intro k hk =>
            left
            refine ⟨k, ?_, ?_⟩
            · dsimp [evalArrSliceBaseRvalue]; rw [hAllL.1]; dsimp; rw [hk.1]
            · dsimp [evalArrSliceBaseRvalue]; rw [hAllL.2.1]; dsimp; rw [hk.2]
        | inr hOkR =>
          cases hOkR with
          | intro rVal h3 => cases h3 with
          | intro slots₁End h4 => cases h4 with
          | intro slots₂End hAllR =>
            dsimp [evalArrSliceBaseRvalue]
            rw [hAllL.1, hAllL.2.1]
            dsimp
            rw [hAllR.1, hAllR.2.1]
            dsimp
            cases evalBinOp bop lVal rVal with
            | error k => exact Or.inl ⟨k, rfl, rfl⟩
            | ok res =>
              refine Or.inr ⟨res, slots₁End, slots₂End, rfl, rfl, hAllR.2.2.1, ?_, ?_, ?_, ?_⟩
              · rw [hAllR.2.2.2.1, hAllL.2.2.2.1]
              · intro j hj
                rw [hAllR.2.2.2.2.1 j hj, hAllL.2.2.2.2.1 j hj]
              · rw [hAllR.2.2.2.2.2.1, hAllL.2.2.2.2.2.1]
              · rw [hAllR.2.2.2.2.2.2, hAllL.2.2.2.2.2.2]
  | discriminant place =>
    unfold rvalueUsesOnlyBase at hRval
    have hPAnd := (bool_and_eq_true _ _).mp hRval
    have hProj : (!place.projection.isEmpty) = false := by
      rw [hPAnd.1]
      rfl
    cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals place.localId with
    | none =>
      rw [hDecl] at hPAnd
      cases hPAnd.2
    | some d =>
      rw [hDecl] at hPAnd
      cases d with
      | array _ _ | sliceView _ => cases hPAnd.2
      | base ty =>
        have hLt : place.localId < pack.bodySrc.locals.length :=
          getElem?_some_lt pack.bodySrc.locals place.localId (.base ty) hDecl
        have hNe : place.localId ≠ plan.arrLocal := fun hEq => by
          rw [hEq, pack.hArrDecl] at hDecl
          cases hDecl
        have hDecl₂ := arrSc_getElem?_bodyTgt_locals_lt pack hLt hNe
        rw [hDecl] at hDecl₂
        have hSlEq := hPref.2 place.localId hLt hNe
        dsimp [evalArrSliceBaseRvalue]
        rw [hProj]
        dsimp
        rw [hDecl, hDecl₂, ← hSlEq]
        cases ty with
        | bool | int _ _ | unit | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported =>
          exact Or.inl ⟨.unsupported, rfl, rfl⟩
        | enum ety =>
          cases hSl : Trusted.MirSemantics.getElem? slots₂ place.localId with
          | none => exact Or.inl ⟨.unsupported, rfl, rfl⟩
          | some sl =>
            cases sl with
            | arrDead | liveArray _ | sliceDead | liveSlice _ =>
              exact Or.inl ⟨.unsupported, rfl, rfl⟩
            | baseSlot bs =>
              dsimp
              cases hAdm : !enumAdmitted ety with
              | true => exact Or.inl ⟨.unsupported, rfl, rfl⟩
              | false =>
                dsimp
                cases ety.tagRepr with
                | zeroSized =>
                  cases bs with
                  | dead => exact Or.inl ⟨.undefined, rfl, rfl⟩
                  | live optV =>
                    cases optV with
                    | none =>
                      cases Trusted.MirSemantics.getElem? ety.discriminants 0 with
                      | none => exact Or.inl ⟨.unsupported, rfl, rfl⟩
                      | some disc =>
                        exact Or.inr ⟨.scalar ⟨ety.discrWidth, ety.discrSigned,
                          truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩,
                          slots₁, slots₂, rfl, rfl, hPref, rfl, fun _ _ => rfl, rfl, rfl⟩
                    | some v =>
                      cases v with
                      | enumVal ety' idx =>
                        dsimp
                        cases EnumTy.beq ety ety' && Nat.beq idx 0 with
                        | false => exact Or.inl ⟨.unsupported, rfl, rfl⟩
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? ety.discriminants 0 with
                          | none => exact Or.inl ⟨.unsupported, rfl, rfl⟩
                          | some disc =>
                            exact Or.inr ⟨.scalar ⟨ety.discrWidth, ety.discrSigned,
                              truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩,
                              slots₁, slots₂, rfl, rfl, hPref, rfl, fun _ _ => rfl, rfl, rfl⟩
                      | bool _ | scalar _ | unit | ptr _ | tuple _ | bytes _ =>
                        exact Or.inl ⟨.unsupported, rfl, rfl⟩
                | scalar _ _ =>
                  cases bs with
                  | dead => exact Or.inl ⟨.undefined, rfl, rfl⟩
                  | live optV =>
                    cases optV with
                    | none => exact Or.inl ⟨.undefined, rfl, rfl⟩
                    | some v =>
                      cases v with
                      | enumVal ety' idx =>
                        dsimp
                        cases EnumTy.beq ety ety' && Nat.blt idx ety.discriminants.length with
                        | false => exact Or.inl ⟨.unsupported, rfl, rfl⟩
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? ety.discriminants idx with
                          | none => exact Or.inl ⟨.unsupported, rfl, rfl⟩
                          | some disc =>
                            exact Or.inr ⟨.scalar ⟨ety.discrWidth, ety.discrSigned,
                              truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩,
                              slots₁, slots₂, rfl, rfl, hPref, rfl, fun _ _ => rfl, rfl, rfl⟩
                      | bool _ | scalar _ | unit | ptr _ | tuple _ | bytes _ =>
                        exact Or.inl ⟨.unsupported, rfl, rfl⟩

private theorem arrSc_writeArrSliceBasePlace_prefix {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPref : arrSc_PrefixMatch pack slots₁ slots₂)
    (dstLocal : LocalId) (hLt : dstLocal < pack.bodySrc.locals.length)
    (hNe : dstLocal ≠ plan.arrLocal) (dstTy : MirTy) (val : Val) :
    (∃ k : FaultKind,
      writeArrSliceBasePlace slots₁ dstLocal dstTy val = .error k ∧
      writeArrSliceBasePlace slots₂ dstLocal dstTy val = .error k) ∨
    (∃ slots₁' slots₂' : List ArrSliceSlot,
      writeArrSliceBasePlace slots₁ dstLocal dstTy val = .ok slots₁' ∧
      writeArrSliceBasePlace slots₂ dstLocal dstTy val = .ok slots₂' ∧
      arrSc_PrefixMatch pack slots₁' slots₂' ∧
      slots₂'.length = slots₂.length ∧
      (∀ j : Nat, pack.bodySrc.locals.length ≤ j →
        Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) ∧
      Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₁ plan.arrLocal ∧
      Trusted.MirSemantics.getElem? slots₂' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₂ plan.arrLocal) := by
  unfold writeArrSliceBasePlace
  cases hChk : !checkVal val dstTy with
  | true => exact Or.inl ⟨.unsupported, rfl, rfl⟩
  | false =>
    dsimp
    have hSlEq := hPref.2 dstLocal hLt hNe
    rw [← hSlEq]
    cases hSl : Trusted.MirSemantics.getElem? slots₂ dstLocal with
    | none => exact Or.inl ⟨.unsupported, rfl, rfl⟩
    | some sl =>
      cases sl with
      | arrDead | liveArray _ | sliceDead | liveSlice _ => exact Or.inl ⟨.unsupported, rfl, rfl⟩
      | baseSlot bs =>
        cases bs with
        | dead => exact Or.inl ⟨.undefined, rfl, rfl⟩
        | live _ =>
          have hLt₁ : dstLocal < slots₁.length := by rw [hPref.1]; exact hLt
          have hLt₂ : dstLocal < slots₂.length :=
            getElem?_some_lt slots₂ dstLocal (.baseSlot (.live _)) hSl
          cases hSet₁ : setElem? slots₁ dstLocal (.baseSlot (.live (some val))) with
          | none =>
            cases lt_setElem?_some slots₁ dstLocal (.baseSlot (.live (some val))) hLt₁ with
            | intro _ hS => rw [hS] at hSet₁; cases hSet₁
          | some slots₁' =>
            cases hSet₂ : setElem? slots₂ dstLocal (.baseSlot (.live (some val))) with
            | none =>
              cases lt_setElem?_some slots₂ dstLocal (.baseSlot (.live (some val))) hLt₂ with
              | intro _ hS => rw [hS] at hSet₂; cases hSet₂
            | some slots₂' =>
              refine Or.inr ⟨slots₁', slots₂', rfl, rfl, ?_, ?_, ?_, ?_, ?_⟩
              · constructor
                · rw [setElem?_length slots₁ dstLocal (.baseSlot (.live (some val))) slots₁' hSet₁,
                    hPref.1]
                · intro i hi hNeArr
                  cases s4a_arrSc_nat_eq_or_ne i dstLocal with
                  | inl hEq =>
                    rw [hEq,
                      getElem?_setElem?_self slots₂ dstLocal (.baseSlot (.live (some val))) slots₂' hSet₂,
                      getElem?_setElem?_self slots₁ dstLocal (.baseSlot (.live (some val))) slots₁' hSet₁]
                  | inr hEq =>
                    rw [getElem?_setElem?_ne slots₂ dstLocal i (.baseSlot (.live (some val))) slots₂'
                          (fun h => hEq h.symm) hSet₂,
                      getElem?_setElem?_ne slots₁ dstLocal i (.baseSlot (.live (some val))) slots₁'
                          (fun h => hEq h.symm) hSet₁]
                    exact hPref.2 i hi hNeArr
              · exact setElem?_length slots₂ dstLocal (.baseSlot (.live (some val))) slots₂' hSet₂
              · intro j hj
                have hNeJ : dstLocal ≠ j := fun hEq =>
                  nat_lt_irrefl dstLocal (Nat.lt_of_lt_of_le hLt (by rw [hEq]; exact hj))
                exact getElem?_setElem?_ne slots₂ dstLocal j (.baseSlot (.live (some val))) slots₂'
                  hNeJ hSet₂
              · exact getElem?_setElem?_ne slots₁ dstLocal plan.arrLocal
                  (.baseSlot (.live (some val))) slots₁' hNe hSet₁
              · exact getElem?_setElem?_ne slots₂ dstLocal plan.arrLocal
                  (.baseSlot (.live (some val))) slots₂' hNe hSet₂

private theorem arrSc_localMatch_lift_prefix {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    (hMatch : arrSc_LocalMatch pack slots₁ slots₂)
    (hPref' : arrSc_PrefixMatch pack slots₁' slots₂')
    (hLen : slots₂'.length = slots₂.length)
    (hGe : ∀ j : Nat, pack.bodySrc.locals.length ≤ j →
      Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j)
    (hArr₁ : Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
      Trusted.MirSemantics.getElem? slots₁ plan.arrLocal) :
    arrSc_LocalMatch pack slots₁' slots₂' := by
  refine ⟨hPref', ?_, ?_, ?_⟩
  · rw [hLen]
    exact hMatch.2.1
  · cases hMatch.2.2.1 with
    | intro arrSl hArr =>
      refine ⟨arrSl, ?_, ?_⟩
      · rw [hArr₁]; exact hArr.1
      · cases arrSl with
        | baseSlot _ | sliceDead | liveSlice _ => exact False.elim hArr.2
        | arrDead =>
          exact ⟨by rw [hGe pack.bodySrc.locals.length (nat_le_refl _)]; exact hArr.2.1,
            fun j hj => by
              rw [hGe (pack.bodySrc.locals.length + 1 + j)
                (Nat.le_trans (Nat.le_add_right _ 1) (Nat.le_add_right _ j))]
              exact hArr.2.2 j hj⟩
        | liveArray elems =>
          refine ⟨hArr.2.1,
            by rw [hGe pack.bodySrc.locals.length (nat_le_refl _)]; exact hArr.2.2.1,
            fun j hj => ?_⟩
          cases hArr.2.2.2 j hj with
          | intro optV hOpt =>
            exact ⟨optV, hOpt.1, by
              rw [hGe (pack.bodySrc.locals.length + 1 + j)
                (Nat.le_trans (Nat.le_add_right _ 1) (Nat.le_add_right _ j))]
              exact hOpt.2⟩
  · intro r hr
    rw [hGe (pack.bodySrc.locals.length + 1 + pack.len + r)
      (Nat.le_trans (Nat.le_add_right _ (1 + pack.len)) (by
        rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
        exact Nat.le_add_right _ r))]
    exact hMatch.2.2.2 r hr

private theorem arrSc_localMatch_set_scr {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂' : List ArrSliceSlot}
    (hMatch : arrSc_LocalMatch pack slots₁ slots₂)
    {r : Nat} (_hr : r < 4 + pack.len) {optV : Option Val}
    (hSet : setElem? slots₂ (pack.bodySrc.locals.length + 1 + pack.len + r)
      (.baseSlot (.live optV)) = some slots₂') :
    arrSc_LocalMatch pack slots₁ slots₂' := by
  let idx := pack.bodySrc.locals.length + 1 + pack.len + r
  have hNeIdx : ∀ i : Nat, i < pack.bodySrc.locals.length + 1 + pack.len → idx ≠ i :=
    fun i hi hEq =>
      nat_lt_irrefl idx (Nat.lt_of_lt_of_le (by rw [hEq]; exact hi) (Nat.le_add_right _ r))
  refine ⟨?_, ?_, ?_, ?_⟩
  · refine ⟨hMatch.1.1, fun i hi hNe => ?_⟩
    have hNeI : idx ≠ i := hNeIdx i (Nat.lt_of_lt_of_le hi (by
      rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
      exact Nat.le_add_right _ _))
    rw [getElem?_setElem?_ne slots₂ idx i (.baseSlot (.live optV)) slots₂' hNeI hSet]
    exact hMatch.1.2 i hi hNe
  · rw [setElem?_length slots₂ idx (.baseSlot (.live optV)) slots₂' hSet]
    exact hMatch.2.1
  · cases hMatch.2.2.1 with
    | intro arrSl hArr =>
      refine ⟨arrSl, hArr.1, ?_⟩
      cases arrSl with
      | baseSlot _ | sliceDead | liveSlice _ => exact False.elim hArr.2
      | arrDead =>
        have hPos : 0 < 1 + pack.len := by
          rw [Nat.add_comm 1 pack.len]; exact Nat.zero_lt_succ pack.len
        have hNeBase : idx ≠ pack.bodySrc.locals.length :=
          hNeIdx pack.bodySrc.locals.length (by
            rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
            exact Nat.lt_add_of_pos_right hPos)
        refine ⟨by rw [getElem?_setElem?_ne slots₂ idx _ (.baseSlot (.live optV)) slots₂' hNeBase hSet]; exact hArr.2.1,
          fun j hj => ?_⟩
        have hNeElem : idx ≠ pack.bodySrc.locals.length + 1 + j := by
          apply hNeIdx
          rw [Nat.add_assoc pack.bodySrc.locals.length 1 j,
            Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
          exact Nat.add_lt_add_left (Nat.add_lt_add_left hj 1) _
        rw [getElem?_setElem?_ne slots₂ idx _ (.baseSlot (.live optV)) slots₂' hNeElem hSet]
        exact hArr.2.2 j hj
      | liveArray elems =>
        have hPos : 0 < 1 + pack.len := by
          rw [Nat.add_comm 1 pack.len]; exact Nat.zero_lt_succ pack.len
        have hNeBase : idx ≠ pack.bodySrc.locals.length :=
          hNeIdx pack.bodySrc.locals.length (by
            rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
            exact Nat.lt_add_of_pos_right hPos)
        refine ⟨hArr.2.1,
          by rw [getElem?_setElem?_ne slots₂ idx _ (.baseSlot (.live optV)) slots₂' hNeBase hSet]; exact hArr.2.2.1,
          fun j hj => ?_⟩
        have hNeElem : idx ≠ pack.bodySrc.locals.length + 1 + j := by
          apply hNeIdx
          rw [Nat.add_assoc pack.bodySrc.locals.length 1 j,
            Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
          exact Nat.add_lt_add_left (Nat.add_lt_add_left hj 1) _
        cases hArr.2.2.2 j hj with
        | intro ov hOv =>
          exact ⟨ov, hOv.1,
            by rw [getElem?_setElem?_ne slots₂ idx _ (.baseSlot (.live optV)) slots₂' hNeElem hSet]; exact hOv.2⟩
  · intro q hq
    cases s4a_arrSc_nat_eq_or_ne q r with
    | inl hEq =>
      rw [hEq]
      exact ⟨optV, getElem?_setElem?_self slots₂ idx (.baseSlot (.live optV)) slots₂' hSet⟩
    | inr hEq =>
      have hNeQ : idx ≠ pack.bodySrc.locals.length + 1 + pack.len + q := fun h =>
        hEq (Nat.add_left_cancel h.symm)
      rw [getElem?_setElem?_ne slots₂ idx _ (.baseSlot (.live optV)) slots₂' hNeQ hSet]
      exact hMatch.2.2.2 q hq

private theorem arrSc_isSupportedArrSliceLocalDecl_base (argCount i : Nat) (ty : MirTy)
    (hTy : isSupportedScalarOrUnitTy ty = true) :
    isSupportedArrSliceLocalDecl argCount i (.base ty) = true := hTy

private theorem arrSc_allArrSliceLocalsSupported_iff (argCount : Nat) :
    ∀ (baseIdx : Nat) (decls : List ArrSliceLocalDecl),
      allArrSliceLocalsSupported argCount baseIdx decls = true ↔
        ∀ (i : Nat) (d : ArrSliceLocalDecl),
          Trusted.MirSemantics.getElem? decls i = some d →
          isSupportedArrSliceLocalDecl argCount (baseIdx + i) d = true
  | _, [] => by
    constructor
    · intro _ i d hd
      cases hd
    · intro _
      rfl
  | baseIdx, d :: rest => by
    dsimp [allArrSliceLocalsSupported]
    rw [bool_and_eq_true, arrSc_allArrSliceLocalsSupported_iff argCount (baseIdx + 1) rest]
    constructor
    · intro h i x hx
      cases i with
      | zero =>
        have hEq : d = x := Option.some.inj hx
        rw [← hEq, Nat.add_zero]
        exact h.1
      | succ j =>
        have hAdd : baseIdx + 1 + j = baseIdx + (j + 1) := by
          rw [Nat.add_assoc, Nat.add_comm 1 j]
        rw [← hAdd]
        exact h.2 j x hx
    · intro h
      constructor
      · have h0 := h 0 d rfl
        rw [Nat.add_zero] at h0
        exact h0
      · intro j x hx
        have hS := h (j + 1) x hx
        have hAdd : baseIdx + 1 + j = baseIdx + (j + 1) := by
          rw [Nat.add_assoc, Nat.add_comm 1 j]
        rw [← hAdd] at hS
        exact hS

private theorem arrSc_scr_decl_supported {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (r : Nat) (d : ArrSliceLocalDecl)
    (hd : Trusted.MirSemantics.getElem?
        ([ArrSliceLocalDecl.base usizeTy, ArrSliceLocalDecl.base usizeTy,
          ArrSliceLocalDecl.base MirTy.bool, ArrSliceLocalDecl.base pack.elemTy] ++
          listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)) r = some d) :
    isSupportedArrSliceLocalDecl pack.bodySrc.argumentCount
      (pack.bodySrc.locals.length + 1 + pack.len + r) d = true := by
  cases r with
  | zero =>
    have hEq : ArrSliceLocalDecl.base usizeTy = d := Option.some.inj hd
    rw [← hEq]; rfl
  | succ r1 =>
    cases r1 with
    | zero =>
      have hEq : ArrSliceLocalDecl.base usizeTy = d := Option.some.inj hd
      rw [← hEq]; rfl
    | succ r2 =>
      cases r2 with
      | zero =>
        have hEq : ArrSliceLocalDecl.base .bool = d := Option.some.inj hd
        rw [← hEq]; rfl
      | succ r3 =>
        cases r3 with
        | zero =>
          have hEq : ArrSliceLocalDecl.base pack.elemTy = d := Option.some.inj hd
          rw [← hEq]; exact pack.hElemSupp
        | succ j =>
          have hRep : Trusted.MirSemantics.getElem?
              (listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)) j = some d := by
            have hLen4 : ([ArrSliceLocalDecl.base usizeTy, .base usizeTy,
                .base .bool, .base pack.elemTy] : List ArrSliceLocalDecl).length = 4 := rfl
            have hq' : Trusted.MirSemantics.getElem?
                ([ArrSliceLocalDecl.base usizeTy, .base usizeTy, .base .bool, .base pack.elemTy] ++
                  listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy))
                (4 + j) = some d := by
              rw [Nat.add_comm 4 j]
              exact hd
            rw [← hLen4, getElem?_append_right] at hq'
            exact hq'
          have hj : j < pack.len := by
            have hj' := getElem?_some_lt
              (listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)) j d hRep
            rw [list_length_replicate] at hj'
            exact hj'
          rw [getElem?_replicate pack.len j (ArrSliceLocalDecl.base pack.elemTy) hj] at hRep
          have hEq : ArrSliceLocalDecl.base pack.elemTy = d := Option.some.inj hRep
          rw [← hEq]; exact pack.hElemSupp

private theorem arrSc_allArrSliceLocalsSupported_bodyTgt_iff {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    allArrSliceLocalsSupported pack.bodyTgt.argumentCount 0 pack.bodyTgt.locals = true ↔
      allArrSliceLocalsSupported pack.bodySrc.argumentCount 0 pack.bodySrc.locals = true := by
  have hArgEq := congrArg ArrSliceBody.argumentCount pack.hBodyTgt
  rw [hArgEq, arrSc_allArrSliceLocalsSupported_iff, arrSc_allArrSliceLocalsSupported_iff]
  constructor
  · intro h i d hd
    rw [Nat.zero_add]
    cases s4a_arrSc_nat_eq_or_ne i plan.arrLocal with
    | inl hArr =>
      rw [hArr] at hd
      rw [pack.hArrDecl] at hd
      have hEq : ArrSliceLocalDecl.array pack.elemTy pack.len = d := Option.some.inj hd
      rw [← hEq, hArr]
      dsimp [isSupportedArrSliceLocalDecl]
      rw [lt_nat_blt pack.hArgLt, pack.hElemSupp, le_nat_ble pack.hLenLe]
      rfl
    | inr hArr =>
      have hLt : i < pack.bodySrc.locals.length :=
        getElem?_some_lt pack.bodySrc.locals i d hd
      have hd2 := arrSc_getElem?_bodyTgt_locals_lt pack hLt hArr
      rw [hd] at hd2
      have hRes := h i d hd2
      rw [Nat.zero_add] at hRes
      exact hRes
  · intro h i d hd
    rw [Nat.zero_add]
    cases Nat.lt_or_ge i pack.bodySrc.locals.length with
    | inl hLt =>
      cases s4a_arrSc_nat_eq_or_ne i plan.arrLocal with
      | inl hArr =>
        rw [hArr, arrSc_getElem?_bodyTgt_locals_arrLocal pack] at hd
        have hEq : ArrSliceLocalDecl.base .unit = d := Option.some.inj hd
        rw [← hEq]
        rfl
      | inr hArr =>
        rw [arrSc_getElem?_bodyTgt_locals_lt pack hLt hArr] at hd
        have hRes := h i d hd
        rw [Nat.zero_add] at hRes
        exact hRes
    | inr hGe =>
      have hSub : i < pack.bodyTgt.locals.length :=
        getElem?_some_lt pack.bodyTgt.locals i d hd
      rw [arrSc_bodyTgt_locals_length pack] at hSub
      let k := i - pack.bodySrc.locals.length
      have hkEq : pack.bodySrc.locals.length + k = i := Nat.add_sub_of_le hGe
      cases hK : k with
      | zero =>
        rw [hK, Nat.add_zero] at hkEq
        rw [← hkEq, arrSc_getElem?_bodyTgt_locals_liveLoc pack] at hd
        have hEq : ArrSliceLocalDecl.base .unit = d := Option.some.inj hd
        rw [← hEq]
        rfl
      | succ k' =>
        rw [hK] at hkEq
        cases Nat.lt_or_ge k' pack.len with
        | inl hkLen =>
          have hEq' : pack.bodySrc.locals.length + 1 + k' = i := by
            rw [Nat.add_assoc, Nat.add_comm 1 k']; exact hkEq
          rw [← hEq', arrSc_getElem?_bodyTgt_locals_elem pack hkLen] at hd
          have hEq : ArrSliceLocalDecl.base pack.elemTy = d := Option.some.inj hd
          rw [← hEq]
          exact pack.hElemSupp
        | inr hGeLen =>
          let r := k' - pack.len
          have hrEq : pack.len + r = k' := Nat.add_sub_of_le hGeLen
          have hrLt : r < 4 + pack.len := by
            have hSubR : pack.bodySrc.locals.length + (k' + 1) <
                pack.bodySrc.locals.length + (1 + pack.len + (4 + pack.len)) := by
              rw [hkEq, ← Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) (4 + pack.len),
                ← Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
              exact hSub
            have hkLt : k' + 1 < 1 + pack.len + (4 + pack.len) :=
              s_nat_lt_of_add_lt_add_left hSubR
            have hkLt' : k' + 1 < (pack.len + (4 + pack.len)) + 1 := by
              rw [Nat.add_comm (pack.len + (4 + pack.len)) 1,
                ← Nat.add_assoc 1 pack.len (4 + pack.len)]
              exact hkLt
            have hkLt2 : pack.len + r < pack.len + (4 + pack.len) := by
              rw [hrEq]
              exact Nat.lt_of_succ_lt_succ hkLt'
            exact s_nat_lt_of_add_lt_add_left hkLt2
          have hEq'' : pack.bodySrc.locals.length + 1 + pack.len + r = i := by
            rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
              Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) r,
              Nat.add_assoc 1 pack.len r, hrEq, Nat.add_comm 1 k']
            exact hkEq
          rw [← hEq'', arrSc_getElem?_bodyTgt_locals_scr pack hrLt] at hd
          rw [← hEq'']
          exact arrSc_scr_decl_supported pack r d hd

private theorem arrSc_arrSliceParamBaseTys_bodyTgt {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    arrSliceParamBaseTys? pack.bodyTgt = arrSliceParamBaseTys? pack.bodySrc := by
  unfold arrSliceParamBaseTys?
  have hTakeEq :
      (pack.bodyTgt.locals.drop 1).take pack.bodyTgt.argumentCount =
        (pack.bodySrc.locals.drop 1).take pack.bodySrc.argumentCount := by
    have hArg := congrArg ArrSliceBody.argumentCount pack.hBodyTgt
    rw [hArg]
    have hLen1 : pack.bodySrc.argumentCount ≤ (pack.bodySrc.locals.drop 1).length := by
      rw [arrSc_list_length_drop]
      have hSum : pack.bodySrc.argumentCount + 1 ≤ pack.bodySrc.locals.length :=
        Nat.le_trans pack.hArgLt (Nat.le_of_lt pack.hLocLt)
      exact Nat.le_sub_of_add_le hSum
    have hLen2 : pack.bodySrc.argumentCount ≤ (pack.bodyTgt.locals.drop 1).length := by
      rw [arrSc_list_length_drop, arrSc_bodyTgt_locals_length pack]
      have hSum : pack.bodySrc.argumentCount + 1 ≤ pack.bodySrc.locals.length :=
        Nat.le_trans pack.hArgLt (Nat.le_of_lt pack.hLocLt)
      have hSum2 : pack.bodySrc.argumentCount + 1 ≤
          pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) :=
        Nat.le_trans hSum (Nat.le_trans (Nat.le_add_right _ _)
          (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)))
      exact Nat.le_sub_of_add_le hSum2
    have hEqAt : ∀ (xs ys : List ArrSliceLocalDecl) (n : Nat),
        xs.length = n → ys.length = n →
        (∀ i : Nat, i < n → Trusted.MirSemantics.getElem? xs i = Trusted.MirSemantics.getElem? ys i) →
        xs = ys := by
      intro xs
      induction xs with
      | nil =>
        intro ys n hx hy _
        cases ys with
        | nil => rfl
        | cons _ _ => rw [← hx] at hy; cases hy
      | cons x xt ih =>
        intro ys n hx hy hGet
        cases ys with
        | nil => rw [← hy] at hx; cases hx
        | cons y yt =>
          cases n with
          | zero => cases hx
          | succ m =>
            have h0 := hGet 0 (Nat.zero_lt_succ m)
            have hXy : x = y := Option.some.inj h0
            rw [hXy]
            exact congrArg (List.cons y)
              (ih yt m (Nat.succ.inj hx) (Nat.succ.inj hy)
                (fun i hi => hGet (i + 1) (Nat.succ_lt_succ hi)))
    refine hEqAt _ _ pack.bodySrc.argumentCount
      (arrSc_list_length_take_of_le (pack.bodyTgt.locals.drop 1) pack.bodySrc.argumentCount hLen2)
      (arrSc_list_length_take_of_le (pack.bodySrc.locals.drop 1) pack.bodySrc.argumentCount hLen1) ?_
    intro i hi
    rw [arrSc_getElem?_take_lt _ _ i hi, arrSc_getElem?_take_lt _ _ i hi,
      arrSc_getElem?_drop, arrSc_getElem?_drop]
    have hLt : 1 + i < pack.bodySrc.locals.length := by
      have hSum : 1 + i ≤ pack.bodySrc.argumentCount := by
        rw [Nat.add_comm]; exact hi
      exact Nat.lt_of_le_of_lt hSum (Nat.lt_trans pack.hArgLt pack.hLocLt)
    have hNe : 1 + i ≠ plan.arrLocal := fun hEq => by
      have hSum : 1 + i ≤ pack.bodySrc.argumentCount := by
        rw [Nat.add_comm]; exact hi
      rw [hEq] at hSum
      exact nat_lt_irrefl pack.bodySrc.argumentCount (Nat.lt_of_lt_of_le pack.hArgLt hSum)
    exact arrSc_getElem?_bodyTgt_locals_lt pack hLt hNe
  rw [hTakeEq]

private noncomputable def arrSc_initSlotAt (body : ArrSliceBody) (args : List Val)
    (idx : Nat) (decl : ArrSliceLocalDecl) : ArrSliceSlot :=
  if Nat.beq idx 0 then
    liveUninitArrSliceSlot decl
  else if Nat.ble idx body.argumentCount then
    match Trusted.MirSemantics.getElem? args (idx - 1) with
    | some v => .baseSlot (.live (some v))
    | none => .baseSlot .dead
  else if arrSliceHasStorageAnnotation body idx then
    deadArrSliceSlot decl
  else
    liveUninitArrSliceSlot decl

private theorem arrSc_initArrSliceLocalsLoop_length (body : ArrSliceBody) (args : List Val) :
    ∀ (baseIdx : Nat) (decls : List ArrSliceLocalDecl),
      (initArrSliceLocalsLoop body args baseIdx decls).length = decls.length
  | _, [] => rfl
  | baseIdx, _ :: rest =>
    congrArg Nat.succ (arrSc_initArrSliceLocalsLoop_length body args (baseIdx + 1) rest)

private theorem arrSc_getElem?_initArrSliceLocalsLoop (body : ArrSliceBody) (args : List Val) :
    ∀ (decls : List ArrSliceLocalDecl) (baseIdx i : Nat) (decl : ArrSliceLocalDecl),
      Trusted.MirSemantics.getElem? decls i = some decl →
      Trusted.MirSemantics.getElem? (initArrSliceLocalsLoop body args baseIdx decls) i =
        some (arrSc_initSlotAt body args (baseIdx + i) decl)
  | [], _, _, _, h => by cases h
  | d :: _, baseIdx, 0, decl, h => by
    have hEq : d = decl := Option.some.inj h
    rw [← hEq, Nat.add_zero]
    rfl
  | _ :: rest, baseIdx, i + 1, decl, h => by
    have ih := arrSc_getElem?_initArrSliceLocalsLoop body args rest (baseIdx + 1) i decl h
    rw [Nat.add_assoc, Nat.add_comm 1 i, ← Nat.add_assoc] at ih
    exact ih

private theorem arrSc_bodyTgt_isEmpty_false {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pack.bodyTgt.basicBlocks.isEmpty = false := by
  have hBbs := congrArg ArrSliceBody.basicBlocks pack.hBodyTgt
  rw [hBbs]
  dsimp
  have hLen1 : (lowerBlocksForArrayLoop plan.arrLocal pack.bodySrc.locals.length
      pack.len pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).1.length =
      pack.bodySrc.basicBlocks.length :=
    arrSc_lowerBlocksForArrayLoop_length _ _ _ _ _
  have hNE : pack.bodySrc.basicBlocks.isEmpty = false := pack.hNonEmpty
  have hNeNil : (lowerBlocksForArrayLoop plan.arrLocal pack.bodySrc.locals.length
      pack.len pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).1 ≠ [] := by
    intro hNil
    rw [hNil] at hLen1
    cases hB : pack.bodySrc.basicBlocks with
    | nil => rw [hB] at hNE; cases hNE
    | cons _ _ => rw [hB] at hLen1; cases hLen1
  cases hL : (lowerBlocksForArrayLoop plan.arrLocal pack.bodySrc.locals.length
      pack.len pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).1 with
  | nil => exact False.elim (hNeNil hL)
  | cons _ _ => rfl

private theorem arrSc_bodyTgt_argLt_locals {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    Nat.blt pack.bodyTgt.argumentCount pack.bodyTgt.locals.length = true := by
  have hArg := congrArg ArrSliceBody.argumentCount pack.hBodyTgt
  dsimp at hArg
  rw [hArg, arrSc_bodyTgt_locals_length pack]
  have hPos : 0 < 1 + pack.len := by
    rw [Nat.add_comm 1 pack.len]; exact Nat.zero_lt_succ pack.len
  exact lt_nat_blt (Nat.lt_trans (Nat.lt_trans pack.hArgLt pack.hLocLt)
    (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right hPos)
      (by
        rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
        exact Nat.le_add_right _ _)))

private theorem arrSc_initStateArrSlice_err_iff {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (q : Query) (k : FaultKind) :
    initStateArrSlice pSrc q = .error k ↔ initStateArrSlice pTgt q = .error k := by
  unfold initStateArrSlice
  rw [arrSc_pTgt_pointerWidthBits pack, arrSc_pTgt_mirProfileVersion pack]
  cases !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
  | true => exact Iff.rfl
  | false =>
    cases !q.callerMem.allocations.isEmpty with
    | true => exact Iff.rfl
    | false =>
      dsimp
      cases s4a_arrSc_nat_eq_or_ne pSrc.entryDefId plan.defId with
      | inl hDef =>
        rw [arrSc_pTgt_entryDefId pack, hDef, pack.hBodySrc, arrSc_getElem?_pTgt_bodies_eq pack]
        dsimp
        have hArgSrc : Nat.blt pack.bodySrc.argumentCount pack.bodySrc.locals.length = true :=
          lt_nat_blt (Nat.lt_trans pack.hArgLt pack.hLocLt)
        rw [pack.hNonEmpty, arrSc_bodyTgt_isEmpty_false pack]
        dsimp
        rw [hArgSrc, arrSc_bodyTgt_argLt_locals pack]
        dsimp
        rw [pack.hStorage, arrSc_arrSliceStorageAnnotationsInBounds_bodyTgt pack]
        dsimp
        cases hSupp₁ : allArrSliceLocalsSupported pack.bodySrc.argumentCount 0 pack.bodySrc.locals with
        | false =>
          have hSupp₂ : allArrSliceLocalsSupported pack.bodyTgt.argumentCount 0 pack.bodyTgt.locals = false := by
            cases hS2 : allArrSliceLocalsSupported pack.bodyTgt.argumentCount 0 pack.bodyTgt.locals with
            | false => rfl
            | true =>
              have hT := (arrSc_allArrSliceLocalsSupported_bodyTgt_iff pack).mp hS2
              rw [hSupp₁] at hT
              cases hT
          rw [hSupp₂]
          exact Iff.rfl
        | true =>
          have hSupp₂ : allArrSliceLocalsSupported pack.bodyTgt.argumentCount 0 pack.bodyTgt.locals = true :=
            (arrSc_allArrSliceLocalsSupported_bodyTgt_iff pack).mpr hSupp₁
          rw [hSupp₂]
          dsimp
          rw [arrSc_arrSliceParamBaseTys_bodyTgt pack]
          cases arrSliceParamBaseTys? pack.bodySrc with
          | none => exact Iff.rfl
          | some paramTys =>
            dsimp
            cases !checkArgsMatch q.args paramTys with
            | true => exact Iff.rfl
            | false =>
              constructor
              · intro h; cases h
              · intro h; cases h
      | inr hDef =>
        rw [arrSc_pTgt_entryDefId pack, arrSc_getElem?_pTgt_bodies_ne pack hDef]

private theorem arrSc_beq_add_one_false (a b : Nat) : Nat.beq (a + 1 + b) 0 = false := by
  cases b <;> rfl

private theorem arrSc_ble_false_of_lt {a b : Nat} (h : a < b) : Nat.ble b a = false := by
  cases hB : Nat.ble b a with
  | false => rfl
  | true => exact False.elim (nat_lt_irrefl a (Nat.lt_of_lt_of_le h (nat_ble_le hB)))

private theorem arrSc_initStateArrSlice_ok_rel {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (q : Query) (s₁ : ArrSliceState) (hInit : initStateArrSlice pSrc q = .ok s₁) :
    ∃ s₂ : ArrSliceState, initStateArrSlice pTgt q = .ok s₂ ∧ arrSc_StateRel pack s₁ s₂ := by
  cases s4a_arrSc_nat_eq_or_ne pSrc.entryDefId plan.defId with
  | inl hDef =>
    unfold initStateArrSlice at hInit
    unfold initStateArrSlice
    rw [arrSc_pTgt_pointerWidthBits pack, arrSc_pTgt_mirProfileVersion pack,
      arrSc_pTgt_entryDefId pack]
    cases hMeta : !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
    | true => rw [hMeta] at hInit; cases hInit
    | false =>
      rw [hMeta] at hInit
      cases hMem : !q.callerMem.allocations.isEmpty with
      | true => rw [hMem] at hInit; cases hInit
      | false =>
        rw [hMem, hDef, pack.hBodySrc] at hInit
        rw [hDef, arrSc_getElem?_pTgt_bodies_eq pack]
        dsimp at hInit
        dsimp
        have hArg := congrArg ArrSliceBody.argumentCount pack.hBodyTgt
        dsimp at hArg
        have hArgSrc : Nat.blt pack.bodySrc.argumentCount pack.bodySrc.locals.length = true :=
          lt_nat_blt (Nat.lt_trans pack.hArgLt pack.hLocLt)
        rw [pack.hNonEmpty, hArgSrc, pack.hStorage] at hInit
        rw [arrSc_bodyTgt_isEmpty_false pack, arrSc_bodyTgt_argLt_locals pack,
          arrSc_arrSliceStorageAnnotationsInBounds_bodyTgt pack]
        dsimp at hInit
        dsimp
        cases hSupp₁ : allArrSliceLocalsSupported pack.bodySrc.argumentCount 0 pack.bodySrc.locals with
        | false => rw [hSupp₁] at hInit; cases hInit
        | true =>
          rw [hSupp₁] at hInit
          rw [(arrSc_allArrSliceLocalsSupported_bodyTgt_iff pack).mpr hSupp₁]
          dsimp at hInit
          dsimp
          rw [arrSc_arrSliceParamBaseTys_bodyTgt pack]
          cases hParam : arrSliceParamBaseTys? pack.bodySrc with
          | none => rw [hParam] at hInit; cases hInit
          | some paramTys =>
            rw [hParam] at hInit
            dsimp at hInit
            dsimp
            cases hChk : !checkArgsMatch q.args paramTys with
            | true => rw [hChk] at hInit; cases hInit
            | false =>
              rw [hChk] at hInit
              dsimp at hInit
              dsimp
              let f₂ : ArrSliceFrame := {
                defId := plan.defId
                blockIdx := 0
                stmtIdx := 0
                locals := initArrSliceLocalsLoop pack.bodyTgt q.args 0 pack.bodyTgt.locals
              }
              let s₂ : ArrSliceState := { frames := [f₂], callerMem := q.callerMem }
              refine ⟨s₂, rfl, ?_⟩
              let f₁ : ArrSliceFrame := {
                defId := plan.defId
                blockIdx := 0
                stmtIdx := 0
                locals := initArrSliceLocalsLoop pack.bodySrc q.args 0 pack.bodySrc.locals
              }
              have hS1 : ({ frames := [f₁], callerMem := q.callerMem } : ArrSliceState) = s₁ :=
                Except.ok.inj hInit
              rw [← hS1]
              dsimp [arrSc_StateRel]
              refine ⟨rfl, Or.inl ⟨rfl, rfl, rfl, ?_, ?_⟩⟩
              · refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_⟩
                · exact arrSc_initArrSliceLocalsLoop_length _ _ _ _
                · intro i hi hNe
                  have hd1 := getElem?_lt_some pack.bodySrc.locals i hi
                  cases hd1 with
                  | intro d hd =>
                    have hd2 := arrSc_getElem?_bodyTgt_locals_lt pack hi hNe
                    rw [hd] at hd2
                    rw [arrSc_getElem?_initArrSliceLocalsLoop _ _ _ 0 i d hd2,
                      arrSc_getElem?_initArrSliceLocalsLoop _ _ _ 0 i d hd]
                    dsimp [arrSc_initSlotAt]
                    rw [Nat.zero_add, hArg, arrSc_arrSliceHasStorageAnnotation_bodyTgt_prefix pack hi hNe]
                · rw [arrSc_initArrSliceLocalsLoop_length]
                · have hArrInit := arrSc_getElem?_initArrSliceLocalsLoop pack.bodySrc q.args
                    pack.bodySrc.locals 0 plan.arrLocal (.array pack.elemTy pack.len) pack.hArrDecl
                  rw [Nat.zero_add] at hArrInit
                  refine ⟨_, hArrInit, ?_⟩
                  dsimp [arrSc_initSlotAt]
                  have hNe0 : Nat.beq plan.arrLocal 0 = false :=
                    nat_beq_false (fun h => by
                      have hArgLt := pack.hArgLt
                      rw [h] at hArgLt
                      cases hArgLt)
                  have hNle : Nat.ble plan.arrLocal pack.bodySrc.argumentCount = false :=
                    arrSc_ble_false_of_lt pack.hArgLt
                  rw [hNe0, hNle]
                  dsimp
                  have hZeroLive := arrSc_getElem?_initArrSliceLocalsLoop pack.bodyTgt q.args
                    pack.bodyTgt.locals 0 pack.bodySrc.locals.length (.base .unit)
                    (arrSc_getElem?_bodyTgt_locals_liveLoc pack)
                  rw [Nat.zero_add] at hZeroLive
                  have hLiveNe0 : Nat.beq pack.bodySrc.locals.length 0 = false :=
                    nat_beq_false (fun h => by
                      have hPos := Nat.lt_trans pack.hArgLt pack.hLocLt
                      rw [h] at hPos
                      cases hPos)
                  have hLiveNle : Nat.ble pack.bodySrc.locals.length pack.bodyTgt.argumentCount = false := by
                    rw [hArg]
                    exact arrSc_ble_false_of_lt (Nat.lt_trans pack.hArgLt pack.hLocLt)
                  cases hSt : arrSliceHasStorageAnnotation pack.bodySrc plan.arrLocal with
                  | true =>
                    dsimp [deadArrSliceSlot]
                    constructor
                    · rw [hZeroLive]
                      dsimp [arrSc_initSlotAt]
                      rw [hLiveNe0, hLiveNle, arrSc_arrSliceHasStorageAnnotation_bodyTgt_liveLoc pack, hSt]
                      rfl
                    · intro j hj
                      have hEl := arrSc_getElem?_initArrSliceLocalsLoop pack.bodyTgt q.args
                        pack.bodyTgt.locals 0 (pack.bodySrc.locals.length + 1 + j)
                        (.base pack.elemTy) (arrSc_getElem?_bodyTgt_locals_elem pack hj)
                      rw [Nat.zero_add] at hEl
                      have hElNe0 : Nat.beq (pack.bodySrc.locals.length + 1 + j) 0 = false :=
                        arrSc_beq_add_one_false pack.bodySrc.locals.length j
                      have hElNle : Nat.ble (pack.bodySrc.locals.length + 1 + j) pack.bodyTgt.argumentCount = false := by
                        rw [hArg]
                        have hLt := Nat.lt_trans pack.hArgLt pack.hLocLt
                        have hLe2 : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 1 + j := by
                          rw [Nat.add_assoc]; exact Nat.le_add_right _ _
                        exact arrSc_ble_false_of_lt (Nat.lt_of_lt_of_le hLt hLe2)
                      rw [hEl]
                      dsimp [arrSc_initSlotAt]
                      rw [hElNe0, hElNle, arrSc_arrSliceHasStorageAnnotation_bodyTgt_elem pack hj, hSt]
                      rfl
                  | false =>
                    dsimp [liveUninitArrSliceSlot]
                    refine ⟨list_length_replicate _ _, ?_, ?_⟩
                    · rw [hZeroLive]
                      dsimp [arrSc_initSlotAt]
                      rw [hLiveNe0, hLiveNle, arrSc_arrSliceHasStorageAnnotation_bodyTgt_liveLoc pack, hSt]
                      rfl
                    · intro j hj
                      have hEl := arrSc_getElem?_initArrSliceLocalsLoop pack.bodyTgt q.args
                        pack.bodyTgt.locals 0 (pack.bodySrc.locals.length + 1 + j)
                        (.base pack.elemTy) (arrSc_getElem?_bodyTgt_locals_elem pack hj)
                      rw [Nat.zero_add] at hEl
                      have hElNe0 : Nat.beq (pack.bodySrc.locals.length + 1 + j) 0 = false :=
                        arrSc_beq_add_one_false pack.bodySrc.locals.length j
                      have hElNle : Nat.ble (pack.bodySrc.locals.length + 1 + j) pack.bodyTgt.argumentCount = false := by
                        rw [hArg]
                        have hLt := Nat.lt_trans pack.hArgLt pack.hLocLt
                        have hLe2 : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 1 + j := by
                          rw [Nat.add_assoc]; exact Nat.le_add_right _ _
                        exact arrSc_ble_false_of_lt (Nat.lt_of_lt_of_le hLt hLe2)
                      rw [hEl]
                      dsimp [arrSc_initSlotAt]
                      rw [hElNe0, hElNle, arrSc_arrSliceHasStorageAnnotation_bodyTgt_elem pack hj, hSt]
                      dsimp
                      rw [arrSc_liveUninitArrSliceSlot_base_eq pack.elemTy]
                      exact ⟨initElemOptVal pack.elemTy,
                        getElem?_replicate pack.len j (initElemOptVal pack.elemTy) hj, rfl⟩
                · intro r hr
                  have hScrDecl := arrSc_getElem?_bodyTgt_locals_scr pack hr
                  have hDeclBox : ∃ ty : MirTy,
                      Trusted.MirSemantics.getElem? pack.bodyTgt.locals
                        (pack.bodySrc.locals.length + 1 + pack.len + r) = some (.base ty) := by
                    cases r with
                    | zero => exact ⟨usizeTy, hScrDecl⟩
                    | succ r1 =>
                      cases r1 with
                      | zero => exact ⟨usizeTy, hScrDecl⟩
                      | succ r2 =>
                        cases r2 with
                        | zero => exact ⟨.bool, hScrDecl⟩
                        | succ r3 =>
                          cases r3 with
                          | zero => exact ⟨pack.elemTy, hScrDecl⟩
                          | succ j =>
                            have hj : j < pack.len := by
                              have h4 : j + 4 < pack.len + 4 := by
                                rw [Nat.add_comm pack.len 4]
                                exact hr
                              exact s_nat_lt_of_add_lt_add_right h4
                            have h4j : pack.bodySrc.locals.length + 1 + pack.len + (j + 4) =
                                pack.bodySrc.locals.length + 1 + pack.len + 4 + j := by
                              rw [Nat.add_comm j 4,
                                Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 j]
                            rw [h4j]
                            exact ⟨pack.elemTy, arrSc_getElem?_bodyTgt_locals_opScr pack hj⟩
                  cases hDeclBox with
                  | intro ty hTy =>
                    have hScrInit := arrSc_getElem?_initArrSliceLocalsLoop pack.bodyTgt q.args
                      pack.bodyTgt.locals 0 (pack.bodySrc.locals.length + 1 + pack.len + r)
                      (.base ty) hTy
                    rw [Nat.zero_add] at hScrInit
                    have hScrNe0 : Nat.beq (pack.bodySrc.locals.length + 1 + pack.len + r) 0 = false := by
                      rw [Nat.add_assoc (pack.bodySrc.locals.length + 1) pack.len r]
                      exact arrSc_beq_add_one_false pack.bodySrc.locals.length (pack.len + r)
                    have hScrNle : Nat.ble (pack.bodySrc.locals.length + 1 + pack.len + r)
                        pack.bodyTgt.argumentCount = false := by
                      rw [hArg]
                      have hLt := Nat.lt_trans pack.hArgLt pack.hLocLt
                      have hLe2 : pack.bodySrc.locals.length ≤
                          pack.bodySrc.locals.length + 1 + pack.len + r := by
                        rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
                          Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) r]
                        exact Nat.le_add_right _ _
                      exact arrSc_ble_false_of_lt (Nat.lt_of_lt_of_le hLt hLe2)
                    rw [hScrInit]
                    dsimp [arrSc_initSlotAt]
                    rw [hScrNe0, hScrNle, arrSc_arrSliceHasStorageAnnotation_bodyTgt_scr pack r]
                    dsimp
                    rw [arrSc_liveUninitArrSliceSlot_base_eq ty]
                    exact ⟨initElemOptVal ty, rfl⟩
              · cases Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks 0 with
                | none => exact True.intro
                | some _ => exact ⟨Nat.zero_le _, rfl⟩
  | inr hDef =>
    have hEq : initStateArrSlice pTgt q = initStateArrSlice pSrc q := by
      unfold initStateArrSlice
      rw [arrSc_pTgt_pointerWidthBits pack, arrSc_pTgt_mirProfileVersion pack,
        arrSc_pTgt_entryDefId pack, arrSc_getElem?_pTgt_bodies_ne pack hDef]
    rw [hEq, hInit]
    refine ⟨s₁, rfl, ?_⟩
    unfold initStateArrSlice at hInit
    cases hMeta : !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
    | true => rw [hMeta] at hInit; cases hInit
    | false =>
      rw [hMeta] at hInit
      cases hMem : !q.callerMem.allocations.isEmpty with
      | true => rw [hMem] at hInit; cases hInit
      | false =>
        rw [hMem] at hInit
        dsimp at hInit
        cases hB : Trusted.MirSemantics.getElem? pSrc.bodies pSrc.entryDefId with
        | none => rw [hB] at hInit; cases hInit
        | some body =>
          rw [hB] at hInit
          dsimp at hInit
          cases hEmpty : body.basicBlocks.isEmpty with
          | true => rw [hEmpty] at hInit; cases hInit
          | false =>
            rw [hEmpty] at hInit
            cases hArg : Nat.blt body.argumentCount body.locals.length with
            | false => rw [hArg] at hInit; cases hInit
            | true =>
              rw [hArg] at hInit
              cases hSt : arrSliceStorageAnnotationsInBounds body with
              | false => rw [hSt] at hInit; cases hInit
              | true =>
                rw [hSt] at hInit
                cases hSupp : allArrSliceLocalsSupported body.argumentCount 0 body.locals with
                | false => rw [hSupp] at hInit; cases hInit
                | true =>
                  rw [hSupp] at hInit
                  dsimp at hInit
                  cases hParam : arrSliceParamBaseTys? body with
                  | none => rw [hParam] at hInit; cases hInit
                  | some paramTys =>
                    rw [hParam] at hInit
                    dsimp at hInit
                    cases hChk : !checkArgsMatch q.args paramTys with
                    | true => rw [hChk] at hInit; cases hInit
                    | false =>
                      rw [hChk] at hInit
                      dsimp at hInit
                      have hS1 := (Except.ok.inj hInit).symm
                      rw [hS1]
                      exact ⟨rfl, Or.inr ⟨hDef, rfl⟩⟩

