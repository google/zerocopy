-- Section 7A: Block Lowering, Bounds Extraction, and Preservation Helpers
-- ============================================================================

private theorem list_take_drop_eq {α : Type} (xs : List α) (n : Nat) :
    xs.take n ++ xs.drop n = xs := by
  induction xs generalizing n with
  | nil =>
    cases n <;> rfl
  | cons a tl ih =>
    cases n with
    | zero => rfl
    | succ n' =>
      change a :: (tl.take n' ++ tl.drop n') = a :: tl
      rw [ih n']

private theorem list_drop_eq_cons_of_getElem? {α : Type} {xs : List α} {i : Nat} {x : α}
    (h : Trusted.MirSemantics.getElem? xs i = some x) :
    xs.drop i = x :: xs.drop (i + 1) := by
  induction xs generalizing i with
  | nil => cases h
  | cons a tl ih =>
    cases i with
    | zero =>
      cases h
      rfl
    | succ i' =>
      rw [getElem?_cons_succ] at h
      exact ih h

private theorem listFlatMap_split_at_strong {α β : Type} (f : α → List β) {xs : List α}
    {i : Nat} {x : α} (h : Trusted.MirSemantics.getElem? xs i = some x) :
    listFlatMap f xs =
      (listFlatMap f (xs.take i) ++ f x) ++ listFlatMap f (xs.drop (i + 1)) := by
  have hSplit : xs = (xs.take i ++ [x]) ++ xs.drop (i + 1) := by
    rw [← list_take_succ_of_getElem? h, list_take_drop_eq]
  have hStep := congrArg (listFlatMap f) hSplit
  rw [listFlatMap_append, listFlatMap_append, listFlatMap_singleton] at hStep
  exact hStep

private theorem list_append_assoc_eq {α : Type} (xs ys zs : List α) :
    (xs ++ ys) ++ zs = xs ++ (ys ++ zs) := by
  induction xs with
  | nil => rfl
  | cons a tl ih =>
    change a :: ((tl ++ ys) ++ zs) = a :: (tl ++ (ys ++ zs))
    rw [ih]

private theorem lowerBlock_getElem?_stmt
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bbSrc : ArrSliceBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bbSrc)
    {i : Nat} {stmt : ArrSliceStmt}
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements i = some stmt) :
    let bbTgt := lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc
    let off := (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
      (bbSrc.statements.take i)).length
    let gen := lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length stmt
    Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt ∧
    (∀ j, j < gen.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
        Trusted.MirSemantics.getElem? gen j) ∧
    off + gen.length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (i + 1))).length := by
  have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx =
      some (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc) := by
    rw [pack.hBodyTgt]
    change Trusted.MirSemantics.getElem?
      (List.map (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        pack.bodySrc.basicBlocks) bbIdx = _
    rw [getElem?_map, hBb]
  refine ⟨hBbTgt, ?_, ?_⟩
  · intro j hj
    let f := lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
    have hFlat := listFlatMap_split_at_strong f hStmt
    change Trusted.MirSemantics.getElem?
      (listFlatMap f bbSrc.statements ++ (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1)
      ((listFlatMap f (bbSrc.statements.take i)).length + j) = _
    rw [hFlat, list_append_assoc_eq]
    exact getElem?_append_middle_add (listFlatMap f (bbSrc.statements.take i)) (f stmt)
      (listFlatMap f (bbSrc.statements.drop (i + 1)) ++
        (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1)
      j hj
  · rw [listFlatMap_take_split _ hStmt, list_append_length]

private theorem lowerBlock_getElem?_termPre
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bbSrc : ArrSliceBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bbSrc) :
    let bbTgt := lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc
    let off := (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
      (bbSrc.statements.take bbSrc.statements.length)).length
    let termPair := lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator
    Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt ∧
    bbTgt.terminator = termPair.2 ∧
    bbTgt.cleanup = bbSrc.cleanup ∧
    (∀ j, j < termPair.1.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
        Trusted.MirSemantics.getElem? termPair.1 j) ∧
    off + termPair.1.length = bbTgt.statements.length := by
  have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx =
      some (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc) := by
    rw [pack.hBodyTgt]
    change Trusted.MirSemantics.getElem?
      (List.map (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        pack.bodySrc.basicBlocks) bbIdx = _
    rw [getElem?_map, hBb]
  refine ⟨hBbTgt, rfl, rfl, ?_, ?_⟩
  · intro j _hj
    change Trusted.MirSemantics.getElem?
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) bbSrc.statements ++
        (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1)
      ((listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take bbSrc.statements.length)).length + j) = _
    rw [list_take_all]
    exact getElem?_append_right _ _ j
  · change (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take bbSrc.statements.length)).length +
        (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1.length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length) bbSrc.statements ++
        (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1).length
    rw [list_take_all, list_append_length]

private theorem pack_bb_props
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bb : ArrSliceBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb) :
    (∀ i stmt, Trusted.MirSemantics.getElem? bb.statements i = some stmt →
      arrSliceStmtLocalsInBounds pack.bodySrc.locals.length stmt = true ∧
      checkStmtForSlices pack.bodySrc.locals plan.entries stmt = true ∧
      match stmt with
      | .baseStmt (.storageLive id) => id < pack.bodySrc.locals.length
      | .baseStmt (.storageDead id) => id < pack.bodySrc.locals.length
      | _ => True) ∧
    arrSliceTermLocalsInBounds pack.bodySrc.locals.length bb.terminator = true ∧
    checkTermForSlices pack.bodySrc.locals plan.entries bb.terminator = true := by
  have hLocAll := (list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hLocs bbIdx bb hBb
  have hLocPair := (bool_and_eq_true _ _).mp hLocAll
  have hChkAll := (list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hCheckAll bbIdx bb hBb
  have hChkPair := (bool_and_eq_true _ _).mp hChkAll
  have hStorAll := (list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hStor bbIdx bb hBb
  refine ⟨?_, hLocPair.2, hChkPair.2⟩
  intro i stmt hStmt
  have hL := (list_all_iff_getElem? _ bb.statements).mp hLocPair.1 i stmt hStmt
  have hC := (list_all_iff_getElem? _ bb.statements).mp hChkPair.1 i stmt hStmt
  have hS := (list_all_iff_getElem? _ bb.statements).mp hStorAll i stmt hStmt
  refine ⟨hL, hC, ?_⟩
  cases stmt with
  | baseStmt s =>
    cases s with
    | storageLive id => exact nat_blt_lt hS
    | storageDead id => exact nat_blt_lt hS
    | nop => exact True.intro
    | unsupported => exact True.intro
    | assign _ _ => exact True.intro
  | aggregateArray _ _ => exact True.intro
  | repeatArray _ _ => exact True.intro
  | arrayLivenessCheck _ => exact True.intro
  | readArrayConst _ _ _ _ => exact True.intro
  | writeArrayConst _ _ _ => exact True.intro
  | unsizeArrayToSlice _ _ => exact True.intro
  | sliceFromRawParts _ _ => exact True.intro
  | subslice _ _ _ _ _ => exact True.intro
  | ptrMetadata _ _ => exact True.intro

private theorem evalArrSliceBaseOperandToSlot_preserves_nonBase
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot) (op : Operand)
    (ty : MirTy) (optVal : Option Val) (slots' : List ArrSliceSlot)
    (hEval : evalArrSliceBaseOperandToSlot decls slots op = Except.ok (ty, optVal, slots')) :
    slots'.length = slots.length ∧
    ∀ i, (∀ baseTy, Trusted.MirSemantics.getElem? decls i ≠ some (.base baseTy)) →
      Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i := by
  cases op with
  | copy p =>
    rw [evalArrSliceBaseOperandToSlot_copy] at hEval
    cases hEmpty : (!p.projection.isEmpty) with
    | true => rw [hEmpty] at hEval; cases hEval
    | false =>
      rw [hEmpty] at hEval
      dsimp at hEval
      cases hD : Trusted.MirSemantics.getElem? decls p.localId with
      | none => rw [hD] at hEval; cases hEval
      | some d =>
        rw [hD] at hEval
        cases d with
        | array _ _ => cases hEval
        | sliceView _ => cases hEval
        | base bTy =>
          cases hS : Trusted.MirSemantics.getElem? slots p.localId with
          | none => rw [hS] at hEval; cases hEval
          | some sl =>
            rw [hS] at hEval
            cases sl with
            | arrDead => cases hEval
            | liveArray _ => cases hEval
            | sliceDead => cases hEval
            | liveSlice _ => cases hEval
            | baseSlot bsl =>
              cases bsl with
              | dead => cases hEval
              | live ov =>
                injection hEval with hP
                injection hP with _ hP2
                injection hP2 with _ hSls
                rw [← hSls]
                exact ⟨rfl, fun _ _ => rfl⟩
  | move p =>
    rw [evalArrSliceBaseOperandToSlot_move] at hEval
    cases hEmpty : (!p.projection.isEmpty) with
    | true => rw [hEmpty] at hEval; cases hEval
    | false =>
      rw [hEmpty] at hEval
      dsimp at hEval
      cases hD : Trusted.MirSemantics.getElem? decls p.localId with
      | none => rw [hD] at hEval; cases hEval
      | some d =>
        rw [hD] at hEval
        cases d with
        | array _ _ => cases hEval
        | sliceView _ => cases hEval
        | base bTy =>
          cases hS : Trusted.MirSemantics.getElem? slots p.localId with
          | none => rw [hS] at hEval; cases hEval
          | some sl =>
            rw [hS] at hEval
            cases sl with
            | arrDead => cases hEval
            | liveArray _ => cases hEval
            | sliceDead => cases hEval
            | liveSlice _ => cases hEval
            | baseSlot bsl =>
              cases bsl with
              | dead => cases hEval
              | live ov =>
                dsimp at hEval
                cases hSet : setElem? slots p.localId (.baseSlot (liveUninitSlot bTy)) with
                | none => rw [hSet] at hEval; cases hEval
                | some slotsMid =>
                  rw [hSet] at hEval
                  injection hEval with hP
                  injection hP with _ hP2
                  injection hP2 with _ hSls
                  rw [← hSls]
                  refine ⟨setElem?_length slots p.localId _ slotsMid hSet, ?_⟩
                  intro i hi
                  have hNe : p.localId ≠ i := by
                    intro hEq
                    rw [hEq] at hD
                    exact hi bTy hD
                  exact getElem?_setElem?_ne slots p.localId i _ slotsMid hNe hSet
  | constant c =>
    rw [evalArrSliceBaseOperandToSlot_const] at hEval
    cases hC : evalConstLit c.ty c.lit with
    | error k => rw [hC] at hEval; cases hEval
    | ok v =>
      rw [hC] at hEval
      injection hEval with hP
      injection hP with _ hP2
      injection hP2 with _ hSls
      rw [← hSls]
      exact ⟨rfl, fun _ _ => rfl⟩

private theorem evalArrSliceTypedOperand_preserves_nonBase
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (expectedTy : MirTy) (op : Operand) (v : Val) (slots' : List ArrSliceSlot)
    (hEval : evalArrSliceTypedOperand decls slots expectedTy op = Except.ok (v, slots')) :
    slots'.length = slots.length ∧
    ∀ i, (∀ baseTy, Trusted.MirSemantics.getElem? decls i ≠ some (.base baseTy)) →
      Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i := by
  cases hB : evalArrSliceBaseOperandToSlot decls slots op with
  | error k =>
    rw [evalArrSliceTypedOperand_err _ _ _ _ _ hB] at hEval
    cases hEval
  | ok p =>
    cases p with | mk srcTy p2 =>
    cases p2 with | mk optVal slotsMid =>
    rw [evalArrSliceTypedOperand_ok _ _ _ _ _ _ _ hB] at hEval
    cases hNeq : (!srcTy.beq expectedTy) with
    | true => rw [hNeq] at hEval; cases hEval
    | false =>
      rw [hNeq] at hEval
      dsimp at hEval
      cases optVal with
      | none => cases hEval
      | some v0 =>
        dsimp at hEval
        cases hChk : checkVal v0 expectedTy with
        | false => rw [hChk] at hEval; cases hEval
        | true =>
          rw [hChk] at hEval
          injection hEval with hP
          injection hP with _ hSls
          rw [← hSls]
          exact evalArrSliceBaseOperandToSlot_preserves_nonBase decls slots op srcTy (some v0) slotsMid hB

private theorem evalUsizeOperand_preserves_nonBase
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (op : Operand) (n : Nat) (slots' : List ArrSliceSlot)
    (hEval : evalUsizeOperand decls slots op = Except.ok (n, slots')) :
    slots'.length = slots.length ∧
    ∀ i, (∀ baseTy, Trusted.MirSemantics.getElem? decls i ≠ some (.base baseTy)) →
      Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i := by
  cases hT : evalArrSliceTypedOperand decls slots usizeTy op with
  | error k =>
    rw [evalUsizeOperand_err _ _ _ _ hT] at hEval
    cases hEval
  | ok p =>
    cases p with | mk v slotsMid =>
    rw [evalUsizeOperand_ok _ _ _ _ _ hT] at hEval
    cases v with
    | scalar sv =>
      dsimp [evalUsizeOfVal] at hEval
      injection hEval with hP
      injection hP with _ hSls
      rw [← hSls]
      exact evalArrSliceTypedOperand_preserves_nonBase decls slots usizeTy op (.scalar sv) slotsMid hT
    | bool _ => cases hEval
    | unit => cases hEval
    | enumVal _ _ => cases hEval
    | ptr _ => cases hEval
    | tuple _ => cases hEval
    | bytes _ => cases hEval

private theorem evalArrSlicePrimitiveOperand_preserves_nonBase
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (op : Operand) (v : Val) (slots' : List ArrSliceSlot)
    (hEval : evalArrSlicePrimitiveOperand decls slots op = Except.ok (v, slots')) :
    slots'.length = slots.length ∧
    ∀ i, (∀ baseTy, Trusted.MirSemantics.getElem? decls i ≠ some (.base baseTy)) →
      Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i := by
  cases hB : evalArrSliceBaseOperandToSlot decls slots op with
  | error k =>
    rw [evalArrSlicePrimitiveOperand_err _ _ _ _ hB] at hEval
    cases hEval
  | ok p =>
    cases p with | mk ty p2 =>
    cases p2 with | mk optVal slotsMid =>
    rw [evalArrSlicePrimitiveOperand_ok _ _ _ _ _ _ hB] at hEval
    cases hPrim : (!isPrimitiveReadableTy ty) with
    | true => rw [hPrim] at hEval; cases hEval
    | false =>
      rw [hPrim] at hEval
      dsimp at hEval
      cases optVal with
      | none => cases hEval
      | some v0 =>
        injection hEval with hP
        injection hP with _ hSls
        rw [← hSls]
        exact evalArrSliceBaseOperandToSlot_preserves_nonBase decls slots op ty (some v0) slotsMid hB

private theorem evalArrSliceTypedOps_preserves_nonBase
    (decls : List ArrSliceLocalDecl) (expectedTy : MirTy)
    (ops : List Operand) (slots : List ArrSliceSlot) (vs : List Val) (slots' : List ArrSliceSlot)
    (hEval : evalArrSliceTypedOps decls expectedTy slots ops = Except.ok (vs, slots')) :
    slots'.length = slots.length ∧
    ∀ i, (∀ baseTy, Trusted.MirSemantics.getElem? decls i ≠ some (.base baseTy)) →
      Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i := by
  induction ops generalizing slots vs with
  | nil =>
    injection hEval with hP
    injection hP with _ hSls
    rw [← hSls]
    exact ⟨rfl, fun _ _ => rfl⟩
  | cons op rest ih =>
    rw [evalArrSliceTypedOps_cons] at hEval
    cases hOp : evalArrSliceTypedOperand decls slots expectedTy op with
    | error k => rw [hOp] at hEval; cases hEval
    | ok p =>
      cases p with | mk v slotsMid =>
      rw [hOp] at hEval
      dsimp at hEval
      cases hTail : evalArrSliceTypedOps decls expectedTy slotsMid rest with
      | error k => rw [hTail] at hEval; cases hEval
      | ok q =>
        cases q with | mk vsTail slotsEnd =>
        rw [hTail] at hEval
        injection hEval with hP
        injection hP with _ hSls
        cases hSls
        have h1 := evalArrSliceTypedOperand_preserves_nonBase decls slots expectedTy op v slotsMid hOp
        have h2 := ih slotsMid vsTail hTail
        refine ⟨by rw [h2.1, h1.1], ?_⟩
        intro i hi
        rw [h2.2 i hi, h1.2 i hi]

private theorem evalArrSliceBaseRvalue_preserves_nonBase
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (dstTy : MirTy) (rval : Rvalue) (v : Val) (slots' : List ArrSliceSlot)
    (hEval : evalArrSliceBaseRvalue decls slots dstTy rval = Except.ok (v, slots')) :
    slots'.length = slots.length ∧
    ∀ i, (∀ baseTy, Trusted.MirSemantics.getElem? decls i ≠ some (.base baseTy)) →
      Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i := by
  cases rval with
  | use op =>
    rw [evalArrSliceBaseRvalue_use] at hEval
    cases hB : evalArrSliceBaseOperandToSlot decls slots op with
    | error k => rw [hB] at hEval; cases hEval
    | ok p =>
      cases p with | mk srcTy p2 =>
      cases p2 with | mk optVal slotsMid =>
      rw [hB] at hEval
      dsimp at hEval
      cases hNeq : (!srcTy.beq dstTy) with
      | true => rw [hNeq] at hEval; cases hEval
      | false =>
        rw [hNeq] at hEval
        dsimp at hEval
        cases optVal with
        | none => cases hEval
        | some v0 =>
          injection hEval with hP
          injection hP with _ hSls
          rw [← hSls]
          exact evalArrSliceBaseOperandToSlot_preserves_nonBase decls slots op srcTy (some v0) slotsMid hB
  | unaryOp uop op =>
    rw [evalArrSliceBaseRvalue_unaryOp] at hEval
    cases hP : evalArrSlicePrimitiveOperand decls slots op with
    | error k => rw [hP] at hEval; cases hEval
    | ok p =>
      cases p with | mk v0 slotsMid =>
      rw [hP] at hEval
      dsimp at hEval
      cases hUn : evalUnOp uop v0 with
      | error k => rw [hUn] at hEval; cases hEval
      | ok res =>
        rw [hUn] at hEval
        injection hEval with hP2
        injection hP2 with _ hSls
        rw [← hSls]
        exact evalArrSlicePrimitiveOperand_preserves_nonBase decls slots op v0 slotsMid hP
  | binaryOp bop lOp rOp =>
    rw [evalArrSliceBaseRvalue_binaryOp] at hEval
    cases hL : evalArrSlicePrimitiveOperand decls slots lOp with
    | error k => rw [hL] at hEval; cases hEval
    | ok pL =>
      cases pL with | mk lVal slotsMid =>
      rw [hL] at hEval
      dsimp at hEval
      cases hR : evalArrSlicePrimitiveOperand decls slotsMid rOp with
      | error k => rw [hR] at hEval; cases hEval
      | ok pR =>
        cases pR with | mk rVal slotsEnd =>
        rw [hR] at hEval
        dsimp at hEval
        cases hBin : evalBinOp bop lVal rVal with
        | error k => rw [hBin] at hEval; cases hEval
        | ok res =>
          rw [hBin] at hEval
          injection hEval with hP2
          injection hP2 with _ hSls
          rw [← hSls]
          have h1 := evalArrSlicePrimitiveOperand_preserves_nonBase decls slots lOp lVal slotsMid hL
          have h2 := evalArrSlicePrimitiveOperand_preserves_nonBase decls slotsMid rOp rVal slotsEnd hR
          refine ⟨by rw [h2.1, h1.1], ?_⟩
          intro i hi
          rw [h2.2 i hi, h1.2 i hi]
  | discriminant place =>
    cases hEmpty : place.projection.isEmpty with
    | false =>
      change (if (!place.projection.isEmpty) = true then Except.error FaultKind.unsupported else _) = _ at hEval
      rw [hEmpty] at hEval
      cases hEval
    | true =>
      rw [evalArrSliceBaseRvalue_discriminant_eq decls slots dstTy place hEmpty] at hEval
      cases hD : evalDiscrAtSlot (Trusted.MirSemantics.getElem? decls place.localId)
          (Trusted.MirSemantics.getElem? slots place.localId) with
      | error k => rw [hD] at hEval; cases hEval
      | ok v0 =>
        rw [hD] at hEval
        injection hEval with hP
        injection hP with _ hSls
        rw [← hSls]
        exact ⟨rfl, fun _ _ => rfl⟩
  | ref _ _ => cases hEval
  | addressOf _ _ => cases hEval
  | aggregateTuple _ => cases hEval
  | unsupported => cases hEval

private theorem s3c_writeArrSliceBasePlace_preserves_ne
    (slots : List ArrSliceSlot) (dst : LocalId) (dstTy : MirTy) (val : Val) (slots' : List ArrSliceSlot)
    (hWrite : writeArrSliceBasePlace slots dst dstTy val = Except.ok slots') :
    slots'.length = slots.length ∧
    ∀ i, i ≠ dst → Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i := by
  rw [writeArrSliceBasePlace_eq] at hWrite
  cases hChk : (!checkVal val dstTy) with
  | true => rw [hChk] at hWrite; cases hWrite
  | false =>
    rw [hChk] at hWrite
    dsimp at hWrite
    cases hGet : Trusted.MirSemantics.getElem? slots dst with
    | none => rw [hGet] at hWrite; cases hWrite
    | some sl =>
      rw [hGet] at hWrite
      cases sl with
      | arrDead => cases hWrite
      | liveArray _ => cases hWrite
      | sliceDead => cases hWrite
      | liveSlice _ => cases hWrite
      | baseSlot bsl =>
        cases bsl with
        | dead => cases hWrite
        | live ov =>
          cases hSet : setElem? slots dst (.baseSlot (.live (some val))) with
          | none => rw [hSet] at hWrite; cases hWrite
          | some s' =>
            rw [hSet] at hWrite
            injection hWrite with hEq
            rw [← hEq]
            exact ⟨setElem?_length slots dst _ s' hSet, fun i hi => getElem?_setElem?_ne slots dst i _ s' (Ne.symm hi) hSet⟩

private theorem sliceCompRel_of_ext_eq {base k : Nat} {optArr : Option LocalId} {sl : ArrSliceSlot}
    {slots₂ slots₂' : List ArrSliceSlot}
    (hRel : SliceCompRel base slots₂ k optArr sl)
    (hEq : ∀ r, r < 4 →
      Trusted.MirSemantics.getElem? slots₂' (base + 4 * k + r) =
        Trusted.MirSemantics.getElem? slots₂ (base + 4 * k + r)) :
    SliceCompRel base slots₂' k optArr sl := by
  have e0 := hEq 0 (by decide)
  rw [Nat.add_zero] at e0
  have e1 := hEq 1 (by decide)
  have e2 := hEq 2 (by decide)
  have e3 := hEq 3 (by decide)
  cases sl with
  | sliceDead =>
    dsimp [SliceCompRel] at hRel
    dsimp [SliceCompRel]
    rw [e0, e1, e2, e3]
    exact hRel
  | liveSlice opt =>
    cases opt with
    | none =>
      dsimp [SliceCompRel] at hRel
      dsimp [SliceCompRel]
      rw [e0, e1, e2, e3]
      exact hRel
    | some sv =>
      dsimp [SliceCompRel] at hRel
      dsimp [SliceCompRel]
      rw [e0, e1, e2, e3]
      exact hRel
  | baseSlot _ => exact hRel
  | arrDead => exact hRel
  | liveArray _ => exact hRel

private theorem sliceLocalMatch_of_baseUpdate
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    (hLM : SliceLocalMatch pack slots₁ slots₂)
    (hPre' : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂')
    (hLen₂' : slots₂'.length = slots₂.length)
    (hSlice₁ : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
      Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? slots₁ sLoc)
    (hExt₂ : ∀ j, pack.bodySrc.locals.length ≤ j →
      Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) :
    SliceLocalMatch pack slots₁' slots₂' := by
  refine ⟨hPre', by rw [hLen₂', hLM.2.1], ?_, ?_⟩
  · intro sLoc k optArr hFind
    have hOld := hLM.2.2.1 sLoc k optArr hFind
    cases hOld with | intro sl₁ hSl =>
    refine ⟨sl₁, by rw [hSlice₁ sLoc k optArr hFind]; exact hSl.1, ?_⟩
    apply sliceCompRel_of_ext_eq hSl.2
    intro r _
    exact hExt₂ (pack.bodySrc.locals.length + 4 * k + r) (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
  · intro r hr
    rw [hExt₂ (pack.bodySrc.locals.length + 4 * plan.entries.length + r)
      (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))]
    exact hLM.2.2.2 r hr

private theorem sliceLocalMatch_set_comp
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    (hLM : SliceLocalMatch pack slots₁ slots₂)
    {sLoc k : Nat} {optArr : Option LocalId} {slNew : ArrSliceSlot}
    (hFind : findSliceEntry plan.entries sLoc = some (k, optArr))
    (hSet₁ : setElem? slots₁ sLoc slNew = some slots₁')
    (hLen₂' : slots₂'.length = slots₂.length)
    (hPres₂ : ∀ j, j < pack.bodySrc.locals.length → findSliceEntry plan.entries j = none →
      Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j)
    (hPresOtherComp : ∀ k' r', k' ≠ k → r' < 4 →
      Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * k' + r') =
        Trusted.MirSemantics.getElem? slots₂ (pack.bodySrc.locals.length + 4 * k' + r'))
    (hPresScr : ∀ r, r < 5 →
      ∃ ov, Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length + r) =
        some (.baseSlot (.live ov)))
    (hNewRel : SliceCompRel pack.bodySrc.locals.length slots₂' k optArr slNew) :
    SliceLocalMatch pack slots₁' slots₂' := by
  have hPre' : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' := by
    refine ⟨by rw [setElem?_length slots₁ sLoc slNew slots₁' hSet₁]; exact hLM.1.1, ?_⟩
    intro i hi hNone
    have hNe : sLoc ≠ i := by
      intro hEq
      rw [← hEq, hFind] at hNone
      cases hNone
    rw [hPres₂ i hi hNone, getElem?_setElem?_ne slots₁ sLoc i slNew slots₁' hNe hSet₁]
    exact hLM.1.2 i hi hNone
  refine ⟨hPre', by rw [hLen₂', hLM.2.1], ?_, hPresScr⟩
  intro sLoc' k' optArr' hFind'
  cases Nat.decEq sLoc' sLoc with
  | isTrue hEq =>
    rw [hEq] at hFind'
    rw [hFind] at hFind'
    injection hFind' with hPair
    injection hPair with hkEq hoEq
    rw [← hkEq, ← hoEq, hEq]
    refine ⟨slNew, getElem?_setElem?_self slots₁ sLoc slNew slots₁' hSet₁, hNewRel⟩
  | isFalse hNe =>
    have hkNe : k' ≠ k := by
      intro hkEq
      rw [hkEq] at hFind'
      have hInj := findSliceEntry_inj pack.hLoop hFind' hFind
      exact hNe hInj.1
    have hOld := hLM.2.2.1 sLoc' k' optArr' hFind'
    cases hOld with | intro sl₁ hSl =>
    refine ⟨sl₁, by rw [getElem?_setElem?_ne slots₁ sLoc sLoc' slNew slots₁' (Ne.symm hNe) hSet₁]; exact hSl.1, ?_⟩
    exact sliceCompRel_of_ext_eq hSl.2 (fun r hr => hPresOtherComp k' r hkNe hr)

private theorem sliceLocalMatch_set_comp_live0
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂' : List ArrSliceSlot}
    (hLM : SliceLocalMatch pack slots₁ slots₂)
    {sLoc k : Nat} {optArr : Option LocalId} {optSv : Option SliceViewVal}
    (hFind : findSliceEntry plan.entries sLoc = some (k, optArr))
    (hSlot₁ : Trusted.MirSemantics.getElem? slots₁ sLoc = some (.liveSlice optSv))
    (hSet₂ : setElem? slots₂ (pack.bodySrc.locals.length + 4 * k) (.baseSlot (.live (some .unit))) = some slots₂') :
    SliceLocalMatch pack slots₁ slots₂' := by
  have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
  refine ⟨⟨hLM.1.1, ?_⟩, by rw [setElem?_length _ _ _ _ hSet₂, hLM.2.1], ?_, ?_⟩
  · intro i hi hNone
    have hNe : pack.bodySrc.locals.length + 4 * k ≠ i :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le hi (Nat.le_add_right _ _))
    rw [getElem?_setElem?_ne _ _ _ _ _ hNe hSet₂]
    exact hLM.1.2 i hi hNone
  · intro sLoc' k' optArr' hFind'
    have hOld := hLM.2.2.1 sLoc' k' optArr' hFind'
    cases hOld with | intro sl₁ hSl =>
    refine ⟨sl₁, hSl.1, ?_⟩
    cases Nat.decEq sLoc' sLoc with
    | isTrue hEq =>
      rw [hEq] at hFind' hSl
      rw [hFind] at hFind'
      injection hFind' with hP
      injection hP with hkEq hoEq
      rw [← hkEq, ← hoEq]
      rw [hSlot₁] at hSl
      have hOldRel := hSl.2
      injection hSl.1 with hslEq
      rw [← hslEq, ← hkEq, ← hoEq] at hOldRel
      rw [← hslEq]
      have hNe1 : pack.bodySrc.locals.length + 4 * k ≠ pack.bodySrc.locals.length + 4 * k + 1 :=
        Nat.ne_of_lt (Nat.lt_succ_self _)
      have hNe2 : pack.bodySrc.locals.length + 4 * k ≠ pack.bodySrc.locals.length + 4 * k + 2 :=
        Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_succ _))
      have hNe3 : pack.bodySrc.locals.length + 4 * k ≠ pack.bodySrc.locals.length + 4 * k + 3 :=
        Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_trans (Nat.le_succ _) (Nat.le_succ _)))
      have e0 := getElem?_setElem?_self slots₂ (pack.bodySrc.locals.length + 4 * k)
        (.baseSlot (.live (some .unit))) slots₂' hSet₂
      have e1 := getElem?_setElem?_ne slots₂ (pack.bodySrc.locals.length + 4 * k)
        (pack.bodySrc.locals.length + 4 * k + 1) (.baseSlot (.live (some .unit))) slots₂' hNe1 hSet₂
      have e2 := getElem?_setElem?_ne slots₂ (pack.bodySrc.locals.length + 4 * k)
        (pack.bodySrc.locals.length + 4 * k + 2) (.baseSlot (.live (some .unit))) slots₂' hNe2 hSet₂
      have e3 := getElem?_setElem?_ne slots₂ (pack.bodySrc.locals.length + 4 * k)
        (pack.bodySrc.locals.length + 4 * k + 3) (.baseSlot (.live (some .unit))) slots₂' hNe3 hSet₂
      cases optSv with
      | none =>
        dsimp [SliceCompRel] at hOldRel
        dsimp [SliceCompRel]
        rw [e1, e2, e3]
        exact ⟨⟨some .unit, e0⟩, hOldRel.2.1, hOldRel.2.2.1, hOldRel.2.2.2⟩
      | some sv =>
        dsimp [SliceCompRel] at hOldRel
        dsimp [SliceCompRel]
        rw [e1, e2, e3]
        exact ⟨hOldRel.1, hOldRel.2.1, ⟨some .unit, e0⟩, hOldRel.2.2.2.1, hOldRel.2.2.2.2.1, hOldRel.2.2.2.2.2⟩
    | isFalse hNe =>
      have hkNe : k' ≠ k := by
        intro hkEq
        rw [hkEq] at hFind'
        exact hNe (findSliceEntry_inj pack.hLoop hFind' hFind).1
      apply sliceCompRel_of_ext_eq hSl.2
      intro r hr
      have hNeIdx : pack.bodySrc.locals.length + 4 * k ≠ pack.bodySrc.locals.length + 4 * k' + r := by
        intro hEq
        have hSum : pack.bodySrc.locals.length + (4 * k + 0) =
            pack.bodySrc.locals.length + (4 * k' + r) := by
          rw [Nat.add_zero, ← Nat.add_assoc]; exact hEq
        have hFour := nat_four_mul_add_inj (by decide) hr (Nat.add_left_cancel hSum)
        exact hkNe hFour.1.symm
      exact getElem?_setElem?_ne slots₂ _ _ _ slots₂' hNeIdx hSet₂
  · intro r hr
    have h4 : 4 * k < 4 * plan.entries.length := by
      have hk4 : 4 * (k + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hkLt
      rw [Nat.mul_succ] at hk4
      exact Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (by decide)) hk4
    have hNe : pack.bodySrc.locals.length + 4 * k ≠
        pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left h4 _) (Nat.le_add_right _ _))
    rw [getElem?_setElem?_ne slots₂ _ _ _ slots₂' hNe hSet₂]
    exact hLM.2.2.2 r hr

private theorem sliceLocalMatch_set_scratch
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂' : List ArrSliceSlot}
    (hLM : SliceLocalMatch pack slots₁ slots₂)
    {r₀ : Nat} (_hr₀ : r₀ < 5) (ov : Option Val)
    (hSet₂ : setElem? slots₂ (pack.bodySrc.locals.length + 4 * plan.entries.length + r₀)
      (.baseSlot (.live ov)) = some slots₂') :
    SliceLocalMatch pack slots₁ slots₂' := by
  let scr := pack.bodySrc.locals.length + 4 * plan.entries.length + r₀
  refine ⟨⟨hLM.1.1, ?_⟩, by rw [setElem?_length _ _ _ _ hSet₂, hLM.2.1], ?_, ?_⟩
  · intro i hi hNone
    have hNe : scr ≠ i := Nat.ne_of_gt (Nat.lt_of_lt_of_le hi (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)))
    rw [getElem?_setElem?_ne _ _ _ _ _ hNe hSet₂]
    exact hLM.1.2 i hi hNone
  · intro sLoc k optArr hFind
    have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
    have hOld := hLM.2.2.1 sLoc k optArr hFind
    cases hOld with | intro sl₁ hSl =>
    refine ⟨sl₁, hSl.1, ?_⟩
    apply sliceCompRel_of_ext_eq hSl.2
    intro r hr
    have hkr : 4 * k + r < 4 * plan.entries.length := by
      have hk4 : 4 * (k + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hkLt
      rw [Nat.mul_succ] at hk4
      exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hr (4 * k)) hk4
    have hNe : scr ≠ pack.bodySrc.locals.length + 4 * k + r := by
      apply Nat.ne_of_gt
      rw [Nat.add_assoc pack.bodySrc.locals.length (4 * k) r]
      exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hkr _) (Nat.le_add_right _ _)
    exact getElem?_setElem?_ne slots₂ _ _ _ slots₂' hNe hSet₂
  · intro r hr
    cases Nat.decEq r r₀ with
    | isTrue hEq =>
      rw [hEq]
      exact ⟨ov, getElem?_setElem?_self slots₂ _ _ slots₂' hSet₂⟩
    | isFalse hNe =>
      have hIdxNe : scr ≠ pack.bodySrc.locals.length + 4 * plan.entries.length + r := by
        intro hEq
        exact hNe (Nat.add_left_cancel hEq).symm
      rw [getElem?_setElem?_ne slots₂ _ _ _ slots₂' hIdxNe hSet₂]
      exact hLM.2.2.2 r hr

private theorem findSliceEntry_zero_none
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) :
    0 < pack.bodySrc.locals.length ∧ findSliceEntry plan.entries 0 = none := by
  refine ⟨Nat.lt_of_le_of_lt (Nat.zero_le _) pack.hArgLt, ?_⟩
  cases hFind : findSliceEntry plan.entries 0 with
  | none => rfl
  | some p =>
    have hV := findSliceEntry_some_lt_and_valid pack.hLoop hFind
    cases hV.2 with | intro e hE =>
    have hPos : 0 < e.sliceLocal := Nat.lt_of_le_of_lt (Nat.zero_le _) hE.2.2.2.2.1
    rw [hE.2.1] at hPos
    exact False.elim (Nat.lt_irrefl 0 hPos)

