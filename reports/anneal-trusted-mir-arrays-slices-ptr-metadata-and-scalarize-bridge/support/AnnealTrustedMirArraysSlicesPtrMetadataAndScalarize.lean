                              rw [← hRead.2.2.1.1]; exact getElem?_none_le slots₁R dst hSlDst)))
                        | some slDst =>
                          cases slDst with
                          | arrDead | liveArray _ | sliceDead | liveSlice _ =>
                            have hStepErr : evalStepArrSlice pTgt 0 { frames := [fMid], callerMem := cm } =
                                .fault .unsupported := by
                              rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt fMid cm bbTgt _
                                hBodyTgt hBbTgt hGet1]
                              dsimp [mkAssignUse, evalArrSliceStmt]
                              rw [hDeclDst₂]; dsimp
                              dsimp [evalArrSliceBaseRvalue]
                              have hBase : evalArrSliceBaseOperandToSlot pack.bodyTgt.locals slots₂Mid op =
                                  .ok (pack.elemTy, some v, slots₂R) := hRead.2.1
                              rw [hBase]; dsimp
                              have hMir : (!MirTy.beq pack.elemTy pack.elemTy) = false := by
                                rw [mirTy_beq_refl]; rfl
                              rw [hMir]; dsimp
                              unfold writeArrSliceBasePlace
                              rw [hChk]; dsimp; rw [hSlDstEq, hSlDst]
                            refine ⟨?_, ?_, ?_⟩
                            · intro _ h; rw [hEvSrc, hSrcRed] at h
                              unfold writeArrSliceBasePlace at h
                              rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h; cases h
                            · intro _ h; rw [hEvSrc, hSrcRed] at h
                              unfold writeArrSliceBasePlace at h
                              rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h; cases h
                            · intro k h; rw [hEvSrc, hSrcRed] at h
                              unfold writeArrSliceBasePlace at h
                              rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h
                              have hEqK := StepResult.fault.inj h; rw [← hEqK]
                              exact arrSc_reachesArrSlice_of_reach_step_fault
                                (arrSc_reachesNArrSlice_one_step hLiveStep.2) hStepErr
                          | baseSlot bs =>
                            cases bs with
                            | dead =>
                              have hStepErr : evalStepArrSlice pTgt 0 { frames := [fMid], callerMem := cm } =
                                  .fault .undefined := by
                                rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt fMid cm bbTgt _
                                  hBodyTgt hBbTgt hGet1]
                                dsimp [mkAssignUse, evalArrSliceStmt]
                                rw [hDeclDst₂]; dsimp
                                dsimp [evalArrSliceBaseRvalue]
                                rw [hRead.2.1]; dsimp
                                have hMir : (!MirTy.beq pack.elemTy pack.elemTy) = false := by
                                  rw [mirTy_beq_refl]; rfl
                                rw [hMir]; dsimp
                                unfold writeArrSliceBasePlace
                                rw [hChk]; dsimp; rw [hSlDstEq, hSlDst]
                              refine ⟨?_, ?_, ?_⟩
                              · intro _ h; rw [hEvSrc, hSrcRed] at h
                                unfold writeArrSliceBasePlace at h
                                rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h; cases h
                              · intro _ h; rw [hEvSrc, hSrcRed] at h
                                unfold writeArrSliceBasePlace at h
                                rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h; cases h
                              · intro k h; rw [hEvSrc, hSrcRed] at h
                                unfold writeArrSliceBasePlace at h
                                rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h
                                have hEqK := StepResult.fault.inj h; rw [← hEqK]
                                exact arrSc_reachesArrSlice_of_reach_step_fault
                                  (arrSc_reachesNArrSlice_one_step hLiveStep.2) hStepErr
                            | live ovDst =>
                              have hSlDst₂ : Trusted.MirSemantics.getElem? slots₂R dst =
                                  some (.baseSlot (.live ovDst)) := by
                                rw [hSlDstEq, hSlDst]
                              have hLt1 : dst < slots₁R.length := by rw [hRead.2.2.1.1]; exact hLtDst
                              have hLt2 : dst < slots₂R.length :=
                                getElem?_some_lt slots₂R dst _ hSlDst₂
                              cases hSet₁ : setElem? slots₁R dst (.baseSlot (.live (some v))) with
                              | none =>
                                cases lt_setElem?_some slots₁R dst _ hLt1 with
                                | intro _ hh => rw [hh] at hSet₁; cases hSet₁
                              | some slots₁' =>
                                cases hSet₂ : setElem? slots₂R dst (.baseSlot (.live (some v))) with
                                | none =>
                                  cases lt_setElem?_some slots₂R dst _ hLt2 with
                                  | intro _ hh => rw [hh] at hSet₂; cases hSet₂
                                | some slots₂' =>
                                  have hStep1 := arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt bbTgt fMid cm
                                    dst pack.elemTy op v slots₂R slots₂'
                                    hBodyTgt hBbTgt hGet1 hDeclDst₂ hOkOp ovDst hSlDst₂ hSet₂
                                  let fStep1 : ArrSliceFrame :=
                                    { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂' }
                                  have hStep1' : evalStepArrSlice pTgt 0 { frames := [fMid], callerMem := cm } =
                                      .step { frames := [fStep1], callerMem := cm } := by
                                    rw [hStep1]; rfl
                                  let fEnd : ArrSliceFrame :=
                                    { f₂ with
                                      stmtIdx := f₂.stmtIdx + (lowerStmtForArray plan.arrLocal
                                        pack.bodySrc.locals.length pack.len (.readArrayConst dst a idx isMove)).length
                                      locals := slots₂' }
                                  have hReach : ReachesNArrSlice pTgt 2 { frames := [f₂], callerMem := cm }
                                      { frames := [fEnd], callerMem := cm } := by
                                    change ReachesNArrSlice pTgt 2 { frames := [f₂], callerMem := cm }
                                      { frames := [{ f₂ with
                                        stmtIdx := f₂.stmtIdx + (lowerStmtForArray plan.arrLocal
                                          pack.bodySrc.locals.length pack.len (.readArrayConst dst a idx isMove)).length
                                        locals := slots₂' }], callerMem := cm }
                                    rw [hGen]
                                    exact arrSc_reachesNArrSlice_succ_head hLiveStep.2
                                      (arrSc_reachesNArrSlice_one_step hStep1')
                                  have hLM' := s4b_arrSc_localMatch_set_prefix_other pack hRead.2.2 hLtDst hNeDst hSet₁ hSet₂
                                  refine ⟨?_, ?_, ?_⟩
                                  · intro s₁' h; rw [hEvSrc, hSrcRed] at h
                                    unfold writeArrSliceBasePlace at h
                                    rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h; dsimp at h
                                    rw [hSet₁] at h
                                    have hsEq := StepResult.step.inj h; rw [← hsEq]
                                    have hLenNext' : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal
                                        pack.bodySrc.locals.length pack.len (.readArrayConst dst a idx isMove)).length =
                                        (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
                                          (bbSrc.statements.take (f₁.stmtIdx + 1))).length := by
                                      rw [hGen]; exact hLenNext
                                    exact arrSc_reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hLeNext hLenNext'
                                      hReach hLM'
                                  · intro _ h; rw [hEvSrc, hSrcRed] at h
                                    unfold writeArrSliceBasePlace at h
                                    rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h; dsimp at h
                                    rw [hSet₁] at h; cases h
                                  · intro _ h; rw [hEvSrc, hSrcRed] at h
                                    unfold writeArrSliceBasePlace at h
                                    rw [hChkDst] at h; dsimp at h; rw [hSlDst] at h; dsimp at h
                                    rw [hSet₁] at h; cases h

private theorem arrSc_sim_stmt_writeArrayConst
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (a : LocalId) (idx : Nat) (rval : Rvalue)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.writeArrayConst a idx rval))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.writeArrayConst a idx rval) = true)
    (hChk : checkStmtForArray pack.bodySrc.locals plan.arrLocal pack.elemTy pack.len (.writeArrayConst a idx rval) = true)
    (hGetGen : ∀ j : Nat, j < (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.writeArrayConst a idx rval)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.writeArrayConst a idx rval)) j)
    (hLenNext : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.writeArrayConst a idx rval)).length =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  have hBndAnd := (bool_and_eq_true _ _).mp hBnd
  have hLtA : a < pack.bodySrc.locals.length := nat_blt_lt hBndAnd.1
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    getElem?_some_lt bbSrc.statements f₁.stmtIdx _ hStmtSrc
  have hChkRval : rvalueUsesOnlyBase pack.bodySrc.locals rval = true := hChk
  cases s4b_arrSc_nat_eq_or_ne a plan.arrLocal with
  | inr hNeArr =>
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.writeArrayConst a idx rval) =
        [.writeArrayConst a idx rval] := by
      dsimp [lowerStmtForArray]; rw [nat_beq_false hNeArr]; rfl
    rw [hGen] at hGetGen hLenNext
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.writeArrayConst a idx rval) := by
      have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
    have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtA hNeArr
    refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
      hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
    · intro s₁' h
      dsimp [evalArrSliceStmt] at h
      cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
      | none => rw [hDecl] at h; cases h
      | some d =>
        rw [hDecl] at hDeclEq; rw [hDecl] at h
        cases d with
        | base _ | sliceView _ => cases h
        | array elemTy' len' =>
          dsimp at h
          cases arrSc_evalArrSliceBaseRvalue_prefix pack hLM.1 elemTy' rval hChkRval with
          | inl hErrR =>
            cases hErrR with
            | intro _ hk => rw [hk.1] at h; cases h
          | inr hOkR =>
            cases hOkR with
            | intro v h1 => cases h1 with
            | intro slots₁Mid h2 => cases h2 with
            | intro slots₂Mid hR =>
              rw [hR.1] at h; dsimp at h
              cases hChkV : !checkVal v elemTy' with
              | true => rw [hChkV] at h; cases h
              | false =>
                rw [hChkV] at h; dsimp at h
                have hSlMidEq := hR.2.2.1.2 a hLtA hNeArr
                cases hArrSl : Trusted.MirSemantics.getElem? slots₁Mid a with
                | none => rw [hArrSl] at h; cases h
                | some slA =>
                  rw [hArrSl] at h
                  cases slA with
                  | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
                  | liveArray elems =>
                    dsimp at h
                    cases hIn : !Nat.blt idx len' with
                    | true => rw [hIn] at h; cases h
                    | false =>
                      rw [hIn] at h; dsimp at h
                      cases hSetEl : setElem? elems idx (some v) with
                      | none => rw [hSetEl] at h; cases h
                      | some elems' =>
                        rw [hSetEl] at h; dsimp at h
                        have hLt1 : a < slots₁Mid.length := by rw [hR.2.2.1.1]; exact hLtA
                        have hLt2 : a < slots₂Mid.length := by
                          rw [hR.2.2.2.1, hLM.2.1]
                          exact Nat.lt_of_lt_of_le hLtA (s4b_arrSc_le_bodyTgt_locals pack)
                        cases hS1 : setElem? slots₁Mid a (.liveArray elems') with
                        | none =>
                          cases lt_setElem?_some slots₁Mid a (.liveArray elems') hLt1 with
                          | intro _ hh => rw [hh] at hS1; cases hS1
                        | some slots₁' =>
                          cases hS2 : setElem? slots₂Mid a (.liveArray elems') with
                          | none =>
                            cases lt_setElem?_some slots₂Mid a (.liveArray elems') hLt2 with
                            | intro _ hh => rw [hh] at hS2; cases hS2
                          | some slots₂' =>
                            rw [hS1] at h
                            have hsEq := StepResult.step.inj h
                            have hLMMid := arrSc_localMatch_lift_prefix pack hLM hR.2.2.1 hR.2.2.2.1
                              hR.2.2.2.2.1 hR.2.2.2.2.2.1
                            have hLM' := s4b_arrSc_localMatch_set_prefix_other pack hLMMid hLtA hNeArr hS1 hS2
                            refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                            dsimp [evalArrSliceStmt]
                            rw [hDeclEq]; dsimp; rw [hR.2.1]; dsimp; rw [hChkV]; dsimp
                            rw [hSlMidEq, hArrSl]; dsimp; rw [hIn]; dsimp; rw [hSetEl]; dsimp; rw [hS2]
    · intro out h
      dsimp [evalArrSliceStmt] at h
      cases hDA : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
      | none => rw [hDA] at h; cases h
      | some d =>
        rw [hDA] at h
        cases d with
        | base _ | sliceView _ => cases h
        | array elemTy' len' =>
          dsimp at h
          cases hER : evalArrSliceBaseRvalue pack.bodySrc.locals f₁.locals elemTy' rval with
          | error _ => rw [hER] at h; cases h
          | ok res =>
            rw [hER] at h; dsimp at h
            cases hChk : !checkVal res.1 elemTy' with
            | true => rw [hChk] at h; cases h
            | false =>
              rw [hChk] at h; dsimp at h
              cases hGA : Trusted.MirSemantics.getElem? res.2 a with
              | none => rw [hGA] at h; cases h
              | some slA =>
                rw [hGA] at h
                cases slA with
                | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
                | liveArray elems =>
                  dsimp at h
                  cases hBlt : !Nat.blt idx len' with
                  | true => rw [hBlt] at h; cases h
                  | false =>
                    rw [hBlt] at h; dsimp at h
                    cases hSE : setElem? elems idx (some res.1) with
                    | none => rw [hSE] at h; cases h
                    | some elems' =>
                      rw [hSE] at h; dsimp at h
                      cases hSA : setElem? res.2 a (.liveArray elems') with
                      | none => rw [hSA] at h; cases h
                      | some _ => rw [hSA] at h; cases h
    · intro k h
      dsimp [evalArrSliceStmt] at h; dsimp [evalArrSliceStmt]
      rw [hDeclEq]
      cases hDA : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
      | none => rw [hDA] at h; exact h
      | some d =>
        rw [hDA] at h
        cases d with
        | base _ | sliceView _ => exact h
        | array elemTy' len' =>
          dsimp at h; dsimp
          cases arrSc_evalArrSliceBaseRvalue_prefix pack hLM.1 elemTy' rval hChkRval with
          | inl hErrR =>
            cases hErrR with
            | intro _ hk => rw [hk.1] at h; rw [hk.2]; exact h
          | inr hOkR =>
            cases hOkR with
            | intro v h1 => cases h1 with
            | intro slots₁Mid h2 => cases h2 with
            | intro slots₂Mid hR =>
              rw [hR.1] at h; rw [hR.2.1]; dsimp at h; dsimp
              cases hChkV : !checkVal v elemTy' with
              | true => rw [hChkV] at h; exact h
              | false =>
                rw [hChkV] at h; dsimp at h; dsimp
                have hSlMidEq := hR.2.2.1.2 a hLtA hNeArr
                rw [hSlMidEq]
                cases hSA : Trusted.MirSemantics.getElem? slots₁Mid a with
                | none => rw [hSA] at h; exact h
                | some slA =>
                  rw [hSA] at h
                  cases slA with
                  | baseSlot _ | arrDead | sliceDead | liveSlice _ => exact h
                  | liveArray elems =>
                    dsimp at h; dsimp
                    cases hIn : !Nat.blt idx len' with
                    | true => rw [hIn] at h; exact h
                    | false =>
                      rw [hIn] at h; dsimp at h; dsimp
                      cases hSetEl : setElem? elems idx (some v) with
                      | none => rw [hSetEl] at h; exact h
                      | some elems' =>
                        rw [hSetEl] at h; dsimp at h; dsimp
                        have hLt1 : a < slots₁Mid.length := by rw [hR.2.2.1.1]; exact hLtA
                        cases hS1 : setElem? slots₁Mid a (.liveArray elems') with
                        | some _ => rw [hS1] at h; cases h
                        | none =>
                          cases lt_setElem?_some slots₁Mid a _ hLt1 with
                          | intro _ hh => rw [hh] at hS1; cases hS1
  | inl hEqArr =>
    let scrBase := pack.bodySrc.locals.length + 1 + pack.len
    let faultScr := scrBase
    let valScr := scrBase + 3
    let evalRval : ArrSliceStmt := .baseStmt (.assign { localId := valScr, projection := [] } rval)
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.writeArrayConst a idx rval) =
        if Nat.blt idx pack.len then
          [evalRval, mkLivenessCheckStmt pack.bodySrc.locals.length,
           mkAssignUse (pack.bodySrc.locals.length + 1 + idx) (.move { localId := valScr, projection := [] })]
        else
          [evalRval, mkLivenessCheckStmt pack.bodySrc.locals.length, mkImmediateUbStmt faultScr] := by
      dsimp [lowerStmtForArray]; rw [nat_beq_true hEqArr]; rfl
    have hGenLen3 : (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
        (.writeArrayConst a idx rval)).length = 3 := by
      rw [hGen]; cases Nat.blt idx pack.len <;> rfl
    have hGet0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some evalRval := by
      have h0 := hGetGen 0 (by rw [hGenLen3]; exact Nat.zero_lt_succ 2)
      rw [Nat.add_zero, hGen] at h0
      cases hBlt : Nat.blt idx pack.len with
      | true => rw [hBlt] at h0; exact h0
      | false => rw [hBlt] at h0; exact h0
    have hGet1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
        some (mkLivenessCheckStmt pack.bodySrc.locals.length) := by
      have h1 := hGetGen 1 (by rw [hGenLen3]; exact Nat.lt_succ_of_lt (Nat.lt_succ_self 1))
      rw [hGen] at h1
      cases hBlt : Nat.blt idx pack.len with
      | true => rw [hBlt] at h1; exact h1
      | false => rw [hBlt] at h1; exact h1
    have hDeclVal := arrSc_getElem?_bodyTgt_locals_valScr pack
    have hDeclLive := arrSc_getElem?_bodyTgt_locals_liveLoc pack
    have hDeclFault := arrSc_getElem?_bodyTgt_locals_faultScr pack
    have hEvSrc := arrSc_evalStepArrSlice_at_stmt pSrc pack.bodySrc f₁ cm bbSrc _ hBodySrc hBbSrc hStmtSrc
    cases arrSc_evalArrSliceBaseRvalue_prefix pack hLM.1 pack.elemTy rval hChkRval with
    | inl hErrR =>
      cases hErrR with
      | intro kErr hkErr =>
        have hStepErr : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } = .fault kErr := by
          rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt f₂ cm bbTgt _ hBodyTgt hBbTgt hGet0]
          dsimp [evalRval, evalArrSliceStmt]
          rw [hDeclVal]; dsimp; rw [hkErr.2]
        refine ⟨?_, ?_, ?_⟩
        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
          rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hkErr.1] at h; cases h
        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
          rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hkErr.1] at h; cases h
        · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
          rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hkErr.1] at h
          have hEqK := StepResult.fault.inj h; rw [← hEqK]
          exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
            (stepArrSlice_iff_evalStep pTgt { frames := [f₂], callerMem := cm } (.fault _)).mpr hStepErr⟩
    | inr hOkR =>
      cases hOkR with
      | intro v h1 => cases h1 with
      | intro slots₁Mid h2 => cases h2 with
      | intro slots₂Mid hR =>
        cases hChkV : checkVal v pack.elemTy with
        | false =>
          have hStepErr : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
              .fault .unsupported := by
            rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt f₂ cm bbTgt _ hBodyTgt hBbTgt hGet0]
            dsimp [evalRval, evalArrSliceStmt]
            rw [hDeclVal]; dsimp; rw [hR.2.1]; dsimp
            unfold writeArrSliceBasePlace
            have hNot : (!checkVal v pack.elemTy) = true := by rw [hChkV]; rfl
            rw [hNot]; rfl
          have hNot : (!checkVal v pack.elemTy) = true := by rw [hChkV]; rfl
          refine ⟨?_, ?_, ?_⟩
          · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
            rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
            rw [hNot] at h; cases h
          · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
            rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
            rw [hNot] at h; cases h
          · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
            rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
            rw [hNot] at h
            have hEqK := StepResult.fault.inj h; rw [← hEqK]
            exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
            (stepArrSlice_iff_evalStep pTgt { frames := [f₂], callerMem := cm } (.fault _)).mpr hStepErr⟩
        | true =>
          have hNot : (!checkVal v pack.elemTy) = false := by rw [hChkV]; rfl
          have hR3 : (3 : Nat) < 4 + pack.len :=
            Nat.lt_of_lt_of_le (Nat.lt_succ_self 3) (Nat.le_add_right 4 pack.len)
          have hValLiveBox : ∃ ov : Option Val,
              Trusted.MirSemantics.getElem? slots₂Mid valScr = some (.baseSlot (.live ov)) := by
            rw [hR.2.2.2.2.1 valScr (by
              change pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 1 + pack.len + 3
              rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
                Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) 3]
              exact Nat.le_add_right _ _)]
            exact hLM.2.2.2 3 hR3
          cases hValLiveBox with
          | intro ovVal hValLive =>
            have hLtVal : valScr < slots₂Mid.length :=
              getElem?_some_lt slots₂Mid valScr _ hValLive
            cases hSetVal : setElem? slots₂Mid valScr (.baseSlot (.live (some v))) with
            | none =>
              cases lt_setElem?_some slots₂Mid valScr _ hLtVal with
              | intro _ hh => rw [hh] at hSetVal; cases hSetVal
            | some slots₂AfterVal =>
              let fVal : ArrSliceFrame :=
                { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂AfterVal }
              have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
                  .step { frames := [fVal], callerMem := cm } := by
                rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt f₂ cm bbTgt _ hBodyTgt hBbTgt hGet0]
                dsimp [evalRval, evalArrSliceStmt]
                rw [hDeclVal]; dsimp; rw [hR.2.1]; dsimp
                unfold writeArrSliceBasePlace
                rw [hNot]; dsimp; rw [hValLive]; dsimp; rw [hSetVal]; rfl
              have hLMMid := arrSc_localMatch_lift_prefix pack hLM hR.2.2.1 hR.2.2.2.1
                hR.2.2.2.2.1 hR.2.2.2.2.2.1
              have hLMVal := arrSc_localMatch_set_scr pack hLMMid hR3 hSetVal
              cases hLMVal.2.2.1 with
              | intro arrSl hArrSl =>
                cases arrSl with
                | baseSlot _ | sliceDead | liveSlice _ => exact False.elim hArrSl.2
                | arrDead =>
                  have hDead := arrSc_step_mkLivenessCheckStmt_dead pTgt pack.bodyTgt bbTgt fVal cm
                    pack.bodySrc.locals.length hBodyTgt hBbTgt hGet1 hDeclLive hArrSl.2.1
                  refine ⟨?_, ?_, ?_⟩
                  · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                    rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                    rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h; cases h
                  · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                    rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                    rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h; cases h
                  · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                    rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                    rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h
                    have hEqK := StepResult.fault.inj h; rw [← hEqK]
                    exact arrSc_reachesArrSlice_of_reach_step_fault
                      (arrSc_reachesNArrSlice_one_step hStep0) hDead
                | liveArray elems =>
                  cases arrSc_step_mkLivenessCheckStmt_live pTgt pack.bodyTgt bbTgt fVal cm
                      pack.bodySrc.locals.length (some .unit) hBodyTgt hBbTgt hGet1 hDeclLive hArrSl.2.2.1 with
                  | intro slots₂Live hLiveStep =>
                    let fLive : ArrSliceFrame :=
                      { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂Live }
                    have hStep1 : evalStepArrSlice pTgt 0 { frames := [fVal], callerMem := cm } =
                        .step { frames := [fLive], callerMem := cm } := by
                      rw [hLiveStep.2]; rfl
                    have hLivePres := s4b_arrSc_localMatch_set_liveLoc_unit pack hLMVal hLiveStep.1
                    have hLMLive : arrSc_LocalMatch pack slots₁Mid slots₂Live := by
                      refine ⟨⟨hLMVal.1.1, fun i hi hNe => ?_⟩, ?_, ?_, ?_⟩
                      · rw [hLivePres.1 i hi]; exact hLMVal.1.2 i hi hNe
                      · rw [hLivePres.2.2.2, hLMVal.2.1]
                      · refine ⟨.liveArray elems, hArrSl.1, hArrSl.2.1, ?_, fun j hj => ?_⟩
                        · exact getElem?_setElem?_self slots₂AfterVal pack.bodySrc.locals.length
                            (.baseSlot (.live (some .unit))) slots₂Live hLiveStep.1
                        · rw [hLivePres.2.1 j hj]; exact hArrSl.2.2.2 j hj
                      · intro r hr; rw [hLivePres.2.2.1 r hr]; exact hLMVal.2.2.2 r hr
                    have hReachMid : ReachesNArrSlice pTgt 2 { frames := [f₂], callerMem := cm }
                        { frames := [fLive], callerMem := cm } :=
                      arrSc_reachesNArrSlice_succ_head hStep0 (arrSc_reachesNArrSlice_one_step hStep1)
                    cases hIn : Nat.blt idx pack.len with
                    | false =>
                      have hNotIn : (!Nat.blt idx pack.len) = true := by rw [hIn]; rfl
                      have hGet2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
                          some (mkImmediateUbStmt faultScr) := by
                        have h2 := hGetGen 2 (by rw [hGenLen3]; exact Nat.lt_succ_self 2)
                        rw [hGen, hIn] at h2; exact h2
                      have hUb := arrSc_step_mkImmediateUbStmt pTgt pack.bodyTgt bbTgt fLive cm
                        faultScr hBodyTgt hBbTgt hGet2 hDeclFault
                      refine ⟨?_, ?_, ?_⟩
                      · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                        rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                        rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h; dsimp at h
                        rw [hNotIn] at h; cases h
                      · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                        rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                        rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h; dsimp at h
                        rw [hNotIn] at h; cases h
                      · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                        rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                        rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h; dsimp at h
                        rw [hNotIn] at h
                        have hEqK := StepResult.fault.inj h; rw [← hEqK]
                        exact arrSc_reachesArrSlice_of_reach_step_fault hReachMid hUb
                    | true =>
                      have hNotIn : (!Nat.blt idx pack.len) = false := by rw [hIn]; rfl
                      have hIdxLt : idx < pack.len := nat_blt_lt hIn
                      let elLoc := pack.bodySrc.locals.length + 1 + idx
                      have hGet2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
                          some (mkAssignUse elLoc (.move { localId := valScr, projection := [] })) := by
                        have h2 := hGetGen 2 (by rw [hGenLen3]; exact Nat.lt_succ_self 2)
                        rw [hGen, hIn] at h2; exact h2
                      have hDeclEl := arrSc_getElem?_bodyTgt_locals_elem pack hIdxLt
                      have hValScrLive : Trusted.MirSemantics.getElem? slots₂Live valScr =
                          some (.baseSlot (.live (some v))) := by
                        rw [hLivePres.2.2.1 3 hR3]
                        exact getElem?_setElem?_self slots₂Mid valScr _ slots₂AfterVal hSetVal
                      have hLtValLive : valScr < slots₂Live.length :=
                        getElem?_some_lt slots₂Live valScr _ hValScrLive
                      cases hMoveVal : setElem? slots₂Live valScr (.baseSlot (liveUninitSlot pack.elemTy)) with
                      | none =>
                        cases lt_setElem?_some slots₂Live valScr _ hLtValLive with
                        | intro _ hh => rw [hh] at hMoveVal; cases hMoveVal
                      | some slots₂AfterMove =>
                        have hNeValEl : valScr ≠ elLoc := fun h => by
                          have hLt : elLoc < pack.bodySrc.locals.length + 1 + pack.len :=
                            Nat.add_lt_add_left hIdxLt _
                          have hLe : pack.bodySrc.locals.length + 1 + pack.len ≤ valScr := Nat.le_add_right _ 3
                          rw [← h] at hLt
                          exact nat_lt_irrefl _ (Nat.lt_of_lt_of_le hLt hLe)
                        cases hArrSl.2.2.2 idx hIdxLt with
                        | intro ovEl hOvEl =>
                          have hElLive : Trusted.MirSemantics.getElem? slots₂Live elLoc =
                              some (.baseSlot (.live ovEl)) := by
                            rw [hLivePres.2.1 idx hIdxLt]; exact hOvEl.2
                          have hElLive2 : Trusted.MirSemantics.getElem? slots₂AfterMove elLoc =
                              some (.baseSlot (.live ovEl)) := by
                            rw [getElem?_setElem?_ne slots₂Live valScr elLoc _ slots₂AfterMove hNeValEl hMoveVal]
                            exact hElLive
                          have hLtEl2 : elLoc < slots₂AfterMove.length :=
                            getElem?_some_lt slots₂AfterMove elLoc _ hElLive2
                          cases hSetEl2 : setElem? slots₂AfterMove elLoc (.baseSlot (.live (some v))) with
                          | none =>
                            cases lt_setElem?_some slots₂AfterMove elLoc _ hLtEl2 with
                            | intro _ hh => rw [hh] at hSetEl2; cases hSetEl2
                          | some slots₂' =>
                            have hOkOp : evalArrSliceTypedOperand pack.bodyTgt.locals slots₂Live pack.elemTy
                                (.move { localId := valScr, projection := [] }) = .ok (v, slots₂AfterMove) := by
                              dsimp [evalArrSliceTypedOperand, evalArrSliceBaseOperandToSlot]
                              rw [hDeclVal, hValScrLive]; dsimp; rw [hMoveVal]; dsimp
                              have hMir : (!MirTy.beq pack.elemTy pack.elemTy) = false := by
                                rw [mirTy_beq_refl]; rfl
                              rw [hMir]; dsimp; rw [hChkV]; rfl
                            have hStep2 := arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt bbTgt fLive cm
                              elLoc pack.elemTy _ v slots₂AfterMove slots₂'
                              hBodyTgt hBbTgt hGet2 hDeclEl hOkOp ovEl hElLive2 hSetEl2
                            let fStep2 : ArrSliceFrame :=
                              { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂' }
                            have hStep2' : evalStepArrSlice pTgt 0 { frames := [fLive], callerMem := cm } =
                                .step { frames := [fStep2], callerMem := cm } := by
                              rw [hStep2]; rfl
                            let fEnd : ArrSliceFrame :=
                              { f₂ with
                                stmtIdx := f₂.stmtIdx + (lowerStmtForArray plan.arrLocal
                                  pack.bodySrc.locals.length pack.len (.writeArrayConst a idx rval)).length
                                locals := slots₂' }
                            have hReach : ReachesNArrSlice pTgt 3 { frames := [f₂], callerMem := cm }
                                { frames := [fEnd], callerMem := cm } := by
                              change ReachesNArrSlice pTgt 3 { frames := [f₂], callerMem := cm }
                                { frames := [{ f₂ with
                                  stmtIdx := f₂.stmtIdx + (lowerStmtForArray plan.arrLocal
                                    pack.bodySrc.locals.length pack.len (.writeArrayConst a idx rval)).length
                                  locals := slots₂' }], callerMem := cm }
                              rw [hGenLen3]
                              exact reachesNArrSlice_trans hReachMid (arrSc_reachesNArrSlice_one_step hStep2')
                            have hLtElSrc : idx < elems.length := by rw [hArrSl.2.1]; exact hIdxLt
                            cases hSetElSrc : setElem? elems idx (some v) with
                            | none =>
                              cases lt_setElem?_some elems idx (some v) hLtElSrc with
                              | intro _ hh => rw [hh] at hSetElSrc; cases hSetElSrc
                            | some elems' =>
                              have hLtArr1 : plan.arrLocal < slots₁Mid.length := by
                                rw [hLMLive.1.1]; exact pack.hLocLt
                              cases hS1 : setElem? slots₁Mid plan.arrLocal (.liveArray elems') with
                              | none =>
                                cases lt_setElem?_some slots₁Mid plan.arrLocal _ hLtArr1 with
                                | intro _ hh => rw [hh] at hS1; cases hS1
                              | some slots₁' =>
                                have hMoveVal' : setElem? slots₂Live (pack.bodySrc.locals.length + 1 + pack.len + 3)
                                    (.baseSlot (.live (initElemOptVal pack.elemTy))) = some slots₂AfterMove := by
                                  rw [← arrSc_liveUninitSlot_eq pack.elemTy]; exact hMoveVal
                                have hLMMove := arrSc_localMatch_set_scr pack hLMLive hR3 hMoveVal'
                                have hCompMove : arrSc_CompRel pack.bodySrc.locals.length pack.len slots₂AfterMove
                                    (.liveArray elems) := by
                                  refine ⟨hArrSl.2.1, ?_, fun j hj => ?_⟩
                                  · have hNeB : valScr ≠ pack.bodySrc.locals.length := fun h => by
                                      have hLtB : pack.bodySrc.locals.length < valScr := by
                                        change pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + pack.len + 3
                                        rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
                                          Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) 3]
                                        exact arrSc_lt_add_one_add_add pack.bodySrc.locals.length pack.len 3
                                      rw [h] at hLtB; exact nat_lt_irrefl _ hLtB
                                    rw [getElem?_setElem?_ne slots₂Live valScr pack.bodySrc.locals.length _ slots₂AfterMove hNeB hMoveVal]
                                    exact getElem?_setElem?_self slots₂AfterVal pack.bodySrc.locals.length _ slots₂Live hLiveStep.1
                                  · have hNeJ : valScr ≠ pack.bodySrc.locals.length + 1 + j := fun h => by
                                      have hLtJ : pack.bodySrc.locals.length + 1 + j < pack.bodySrc.locals.length + 1 + pack.len :=
                                        Nat.add_lt_add_left hj _
                                      have hLeJ : pack.bodySrc.locals.length + 1 + pack.len ≤ valScr := Nat.le_add_right _ 3
                                      rw [← h] at hLtJ; exact nat_lt_irrefl _ (Nat.lt_of_lt_of_le hLtJ hLeJ)
                                    rw [getElem?_setElem?_ne slots₂Live valScr _ _ slots₂AfterMove hNeJ hMoveVal,
                                      hLivePres.2.1 j hj]
                                    exact hArrSl.2.2.2 j hj
                                have hComp' := s4b_arrSc_compRel_liveArray_setElem hCompMove hIdxLt hSetElSrc hSetEl2
                                have hLM' := s4b_arrSc_localMatch_set_arrElem pack hLMMove hS1 hIdxLt hSetEl2 hComp'
                                  (Or.inr rfl)
                                refine ⟨?_, ?_, ?_⟩
                                · intro s₁' h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                                  rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                                  rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h; dsimp at h
                                  rw [hNotIn] at h; dsimp at h; rw [hSetElSrc] at h; dsimp at h; rw [hS1] at h
                                  have hsEq := StepResult.step.inj h; rw [← hsEq]
                                  exact arrSc_reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hLeNext hLenNext
                                    hReach hLM'
                                · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                                  rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                                  rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h; dsimp at h
                                  rw [hNotIn] at h; dsimp at h; rw [hSetElSrc] at h; dsimp at h; rw [hS1] at h; cases h
                                · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
                                  rw [hEqArr, pack.hArrDecl] at h; dsimp at h; rw [hR.1] at h; dsimp at h
                                  rw [hNot] at h; dsimp at h; rw [hArrSl.1] at h; dsimp at h
                                  rw [hNotIn] at h; dsimp at h; rw [hSetElSrc] at h; dsimp at h; rw [hS1] at h; cases h

private theorem arrSc_stmt_step_sim
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory} {stmt : ArrSliceStmt}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmt)
    (hLen₂ : f₂.stmtIdx = (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
      (bbSrc.statements.take f₁.stmtIdx)).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  have hL := arrSc_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hL with
  | intro extraStart hSpec =>
    let base := pack.bodySrc.locals.length
    let termRes := lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator
    let bbTgt : ArrSliceBlock := {
      bbSrc with
      statements := listFlatMap (lowerStmtForArray plan.arrLocal base pack.len) bbSrc.statements ++ termRes.1
      terminator := termRes.2.1
    }
    have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
      rw [hBbEq]; exact hSpec.2.1
    have hGetGen : ∀ j : Nat, j < (lowerStmtForArray plan.arrLocal base pack.len stmt).length →
        Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
          Trusted.MirSemantics.getElem? (lowerStmtForArray plan.arrLocal base pack.len stmt) j := by
      intro j hj; rw [hLen₂]; exact hSpec.2.2.1 j hj
    have hLenNext : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal base pack.len stmt).length =
        (listFlatMap (lowerStmtForArray plan.arrLocal base pack.len)
          (bbSrc.statements.take (f₁.stmtIdx + 1))).length := by
      rw [hLen₂]; exact hSpec.2.2.2.1
    have hBnd := arrSc_bodySrc_stmt_localsInBounds pack hBbSrc hStmtSrc
    have hChk := arrSc_bodySrc_stmt_check pack hBbSrc hStmtSrc
    cases stmt with
    | baseStmt bs =>
      cases bs with
      | nop =>
        have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (.baseStmt .nop) := by
          have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
        exact arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
          hBodySrc hBodyTgt hBbTgt hGetTgt
          ⟨(fun s₁' h => by
            dsimp [evalArrSliceStmt] at h
            have hsEq := StepResult.step.inj h
            exact ⟨f₁.locals, f₂.locals, hsEq.symm, rfl, hLM⟩),
           (fun _ h => by cases h),
           (fun _ h => by cases h)⟩
      | unsupported =>
        have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (.baseStmt .unsupported) := by
          have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
        exact arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
          hBodySrc hBodyTgt hBbTgt hGetTgt
          ⟨(fun _ h => by cases h), (fun _ h => by cases h), (fun _ h => h)⟩
      | storageLive id =>
        exact arrSc_sim_stmt_storageLive pack id hBodySrc hBodyTgt hSame hSame₂ hBbEq
          hBbSrc hBbTgt hStmtSrc hBnd hGetGen hLenNext hLM
      | storageDead id =>
        exact arrSc_sim_stmt_storageDead pack id hBodySrc hBodyTgt hSame hSame₂ hBbEq
          hBbSrc hBbTgt hStmtSrc hBnd hGetGen hLenNext hLM
      | assign dst rval =>
        have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
            some (.baseStmt (.assign dst rval)) := by
          have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
        exact arrSc_sim_stmt_assign pack dst rval hBodySrc hBodyTgt hSame hSame₂ hBbEq
          hBbSrc hBbTgt hStmtSrc hBnd hChk hGetTgt hLenNext hLM
    | aggregateArray a ops =>
      exact arrSc_sim_stmt_aggregateArray pack a ops hBodySrc hBodyTgt hSame hSame₂ hBbEq
        hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
    | repeatArray a op =>
      exact arrSc_sim_stmt_repeatArray pack a op hBodySrc hBodyTgt hSame hSame₂ hBbEq
        hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
    | arrayLivenessCheck a =>
      exact arrSc_sim_stmt_arrayLivenessCheck pack a hBodySrc hBodyTgt hSame hSame₂ hBbEq
        hBbSrc hBbTgt hStmtSrc hBnd hGetGen hLenNext hLM
    | readArrayConst dst a idx isMove =>
      exact arrSc_sim_stmt_readArrayConst pack dst a idx isMove hBodySrc hBodyTgt hSame hSame₂ hBbEq
        hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
    | writeArrayConst a idx rval =>
      exact arrSc_sim_stmt_writeArrayConst pack a idx rval hBodySrc hBodyTgt hSame hSame₂ hBbEq
        hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
    | unsizeArrayToSlice sLoc a =>
      have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
          some (.unsizeArrayToSlice sLoc a) := by
        have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
      have hBndAnd := (bool_and_eq_true _ _).mp hBnd
      have hLtS := nat_blt_lt hBndAnd.1
      have hNoSlSrc : ∀ d : ArrSliceLocalDecl,
          Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some d →
          ∀ t, d ≠ .sliceView t := fun _ hd => arrSc_noSliceView_bodySrc pack hd
      have hNoSlTgt : ∀ d : ArrSliceLocalDecl,
          Trusted.MirSemantics.getElem? pack.bodyTgt.locals sLoc = some d →
          ∀ t, d ≠ .sliceView t := fun _ hd => arrSc_noSliceView_bodyTgt pack hd
      refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
        hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
      · intro _ h
        dsimp [evalArrSliceStmt] at h
        cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc with
        | none => rw [hD] at h; cases h
        | some d =>
          rw [hD] at h
          cases d with
          | base _ | array _ _ => cases h
          | sliceView t => exact False.elim (hNoSlSrc _ hD t rfl)
      · intro _ h
        dsimp [evalArrSliceStmt] at h
