private theorem evalStepArrSlice_at_stmt (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory) (stmt : ArrSliceStmt)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some stmt) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      evalArrSliceStmt body frame cm stmt := by
  change (match Trusted.MirSemantics.getElem? p.bodies frame.defId with
    | none => StepResult.fault FaultKind.unsupported
    | some body' =>
      match Trusted.MirSemantics.getElem? body'.basicBlocks frame.blockIdx with
      | none => StepResult.fault FaultKind.unsupported
      | some bb' =>
        match Trusted.MirSemantics.getElem? bb'.statements frame.stmtIdx with
        | some s => evalArrSliceStmt body' frame cm s
        | none =>
          if frame.stmtIdx.beq bb'.statements.length = true then evalArrSliceTerm body' bb' frame cm
          else StepResult.fault FaultKind.unsupported) = _
  rw [hBody]
  dsimp
  rw [hBb]
  dsimp
  rw [hStmt]

private theorem evalStepArrSlice_at_term (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hIdx : frame.stmtIdx = bb.statements.length) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      evalArrSliceTerm body bb frame cm := by
  change (match Trusted.MirSemantics.getElem? p.bodies frame.defId with
    | none => StepResult.fault FaultKind.unsupported
    | some body' =>
      match Trusted.MirSemantics.getElem? body'.basicBlocks frame.blockIdx with
      | none => StepResult.fault FaultKind.unsupported
      | some bb' =>
        match Trusted.MirSemantics.getElem? bb'.statements frame.stmtIdx with
        | some s => evalArrSliceStmt body' frame cm s
        | none =>
          if frame.stmtIdx.beq bb'.statements.length = true then evalArrSliceTerm body' bb' frame cm
          else StepResult.fault FaultKind.unsupported) = _
  have hNone : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = none := by
    cases hGet : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
    | none => rfl
    | some s =>
      have hlt := getElem?_some_lt bb.statements frame.stmtIdx s hGet
      rw [hIdx] at hlt
      exact False.elim (Nat.lt_irrefl _ hlt)
  have hBeq : frame.stmtIdx.beq bb.statements.length = true := nat_beq_true hIdx
  rw [hBody]
  dsimp
  rw [hBb]
  dsimp
  rw [hNone, hBeq]
  rfl

private theorem evalStepArrSlice_oob (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hOob : bb.statements.length < frame.stmtIdx) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      StepResult.fault FaultKind.unsupported := by
  change (match Trusted.MirSemantics.getElem? p.bodies frame.defId with
    | none => StepResult.fault FaultKind.unsupported
    | some body' =>
      match Trusted.MirSemantics.getElem? body'.basicBlocks frame.blockIdx with
      | none => StepResult.fault FaultKind.unsupported
      | some bb' =>
        match Trusted.MirSemantics.getElem? bb'.statements frame.stmtIdx with
        | some s => evalArrSliceStmt body' frame cm s
        | none =>
          if frame.stmtIdx.beq bb'.statements.length = true then evalArrSliceTerm body' bb' frame cm
          else StepResult.fault FaultKind.unsupported) = _
  have hNone : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = none := by
    cases hGet : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
    | none => rfl
    | some s =>
      have hlt := getElem?_some_lt bb.statements frame.stmtIdx s hGet
      exact False.elim (Nat.lt_asymm hlt hOob)
  have hBeq : frame.stmtIdx.beq bb.statements.length = false := by
    cases hb : frame.stmtIdx.beq bb.statements.length with
    | false => rfl
    | true =>
      have hEq := nat_beq_eq _ _ hb
      rw [hEq] at hOob
      exact False.elim (Nat.lt_irrefl _ hOob)
  rw [hBody]
  dsimp
  rw [hBb]
  dsimp
  rw [hNone, hBeq]
  rfl

private theorem evalArrSliceStmt_assign (body : ArrSliceBody) (frame : ArrSliceFrame)
    (cm : CallerMemory) (dst : LocalId) (rval : Rvalue) :
    evalArrSliceStmt body frame cm (.baseStmt (.assign { localId := dst } rval)) =
      match Trusted.MirSemantics.getElem? body.locals dst with
      | some (.base dstTy) =>
        match evalArrSliceBaseRvalue body.locals frame.locals dstTy rval with
        | Except.error k => StepResult.fault k
        | Except.ok (val, slotsAfterRval) =>
          match writeArrSliceBasePlace slotsAfterRval dst dstTy val with
          | Except.error k => StepResult.fault k
          | Except.ok slots' => stepStmtNext frame cm slots'
      | _ => StepResult.fault FaultKind.unsupported := rfl

private theorem evalArrSliceStmt_arrayLivenessCheck (body : ArrSliceBody) (frame : ArrSliceFrame)
    (cm : CallerMemory) (arrLocal : LocalId) :
    evalArrSliceStmt body frame cm (.arrayLivenessCheck arrLocal) =
      match Trusted.MirSemantics.getElem? body.locals arrLocal,
          Trusted.MirSemantics.getElem? frame.locals arrLocal with
      | some (.array _ _), some (.liveArray _) => stepStmtNext frame cm frame.locals
      | some (.array _ _), some .arrDead => StepResult.fault FaultKind.undefined
      | _, _ => StepResult.fault FaultKind.unsupported := rfl

private theorem reachesNArrSlice_one_step {p : ArrSliceProgram} {s s' : ArrSliceState}
    (h : evalStepArrSlice p 0 s = StepResult.step s') :
    ReachesNArrSlice p 1 s s' :=
  ReachesNArrSlice.succ ((stepArrSlice_iff_evalStep p s (StepResult.step s')).mpr h)
    (ReachesNArrSlice.zero s')

private theorem reachesArrSlice_of_reach_fault {p : ArrSliceProgram} {n : Nat}
    {s₀ s₁ : ArrSliceState} {k : FaultKind}
    (hReach : ReachesNArrSlice p n s₀ s₁)
    (hFault : evalStepArrSlice p 0 s₁ = StepResult.fault k) :
    ∃ s', ReachesArrSlice p s₀ s' ∧ StepArrSlice p s' (StepResult.fault k) :=
  ⟨s₁, reachesArrSlice_of_reachesNArrSlice hReach,
    (stepArrSlice_iff_evalStep p s₁ (StepResult.fault k)).mpr hFault⟩

private theorem reachesArrSlice_of_reach_done {p : ArrSliceProgram} {n : Nat}
    {s₀ s₁ : ArrSliceState} {out : TerminalOut}
    (hReach : ReachesNArrSlice p n s₀ s₁)
    (hDone : evalStepArrSlice p 0 s₁ = StepResult.done out) :
    ∃ s', ReachesArrSlice p s₀ s' ∧ StepArrSlice p s' (StepResult.done out) :=
  ⟨s₁, reachesArrSlice_of_reachesNArrSlice hReach,
    (stepArrSlice_iff_evalStep p s₁ (StepResult.done out)).mpr hDone⟩

private theorem step_mkLivenessCheckStmt_dead (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory) (off : LocalId)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (mkLivenessCheckStmt off))
    (hDecl : Trusted.MirSemantics.getElem? body.locals off = some (.base .unit))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals off = some (.baseSlot .dead)) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      StepResult.fault FaultKind.undefined := by
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt]
  change evalArrSliceStmt body frame cm (.baseStmt (.assign { localId := off } _)) = _
  rw [evalArrSliceStmt_assign, hDecl]
  change (match writeArrSliceBasePlace frame.locals off .unit .unit with
    | .error k => StepResult.fault k
    | .ok slots' => stepStmtNext frame cm slots') = _
  rw [writeArrSliceBasePlace_eq, hSlot]
  rfl

private theorem step_mkLivenessCheckStmt_live (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory) (off : LocalId)
    (ov : Option Val)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (mkLivenessCheckStmt off))
    (hDecl : Trusted.MirSemantics.getElem? body.locals off = some (.base .unit))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals off = some (.baseSlot (.live ov))) :
    ∃ slots',
      setElem? frame.locals off (.baseSlot (.live (some .unit))) = some slots' ∧
      evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
        stepStmtNext frame cm slots' := by
  have hLt := getElem?_some_lt frame.locals off (.baseSlot (.live ov)) hSlot
  have hEx := lt_setElem?_some frame.locals off (.baseSlot (.live (some .unit))) hLt
  cases hEx with | intro slots' hSet =>
  refine ⟨slots', hSet, ?_⟩
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt]
  change evalArrSliceStmt body frame cm (.baseStmt (.assign { localId := off } _)) = _
  rw [evalArrSliceStmt_assign, hDecl]
  change (match writeArrSliceBasePlace frame.locals off .unit .unit with
    | .error k => StepResult.fault k
    | .ok slots'' => stepStmtNext frame cm slots'') = _
  rw [writeArrSliceBasePlace_eq, hSlot, hSet]
  rfl

private theorem step_mkImmediateUbStmt (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory) (scr : LocalId)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (mkImmediateUbStmt scr))
    (hDecl : Trusted.MirSemantics.getElem? body.locals scr = some (.base usizeTy)) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      StepResult.fault FaultKind.undefined := by
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt]
  change evalArrSliceStmt body frame cm (.baseStmt (.assign { localId := scr } _)) = _
  rw [evalArrSliceStmt_assign, hDecl]
  dsimp
  have h0 : 0 < maxUsize := by rw [maxUsize_eq]; decide
  have h1 : 1 < maxUsize := by rw [maxUsize_eq]; decide
  have h01 : 0 < 1 := Nat.zero_lt_one
  have hEval0 : evalConstLit usizeTy (.scalar (BitVec.ofNat 128 0)) =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 0))) :=
    evalConstLit_usizeConst_of_lt_maxUsize 0 h0
  have hEval1 : evalConstLit usizeTy (.scalar (BitVec.ofNat 128 1)) =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 1))) :=
    evalConstLit_usizeConst_of_lt_maxUsize 1 h1
  have hUb : evalBinOp .subUnchecked
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 0)))
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 1))) = .error .undefined :=
    evalBinOp_usize_subUnchecked_ub 0 1 h0 h1 h01
  change (match evalArrSliceBaseRvalue body.locals frame.locals usizeTy
      (.binaryOp .subUnchecked (usizeConst 0) (usizeConst 1)) with
    | .error k => StepResult.fault k
    | .ok (val, slotsAfter) =>
      match writeArrSliceBasePlace slotsAfter scr usizeTy val with
      | .error k => StepResult.fault k
      | .ok slots'' => stepStmtNext frame cm slots'') = _
  rw [evalArrSliceBaseRvalue_binaryOp]
  have hP0 : evalArrSlicePrimitiveOperand body.locals frame.locals (usizeConst 0) =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 0)), frame.locals) := by
    have hB0 : evalArrSliceBaseOperandToSlot body.locals frame.locals (usizeConst 0) =
        .ok (usizeTy, some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 0))), frame.locals) := by
      rw [evalArrSliceBaseOperandToSlot_usizeConst, hEval0]
    rw [evalArrSlicePrimitiveOperand_ok _ _ _ _ _ _ hB0]
    rfl
  have hP1 : evalArrSlicePrimitiveOperand body.locals frame.locals (usizeConst 1) =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 1)), frame.locals) := by
    have hB1 : evalArrSliceBaseOperandToSlot body.locals frame.locals (usizeConst 1) =
        .ok (usizeTy, some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 1))), frame.locals) := by
      rw [evalArrSliceBaseOperandToSlot_usizeConst, hEval1]
    rw [evalArrSlicePrimitiveOperand_ok _ _ _ _ _ _ hB1]
    rfl
  rw [hP0]
  dsimp
  rw [hP1]
  dsimp
  rw [hUb]

private theorem evalArrSlicePrimitiveOperand_copy_usize (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (loc : LocalId) (n : Nat)
    (hDecl : Trusted.MirSemantics.getElem? decls loc = some (.base usizeTy))
    (hSlot : Trusted.MirSemantics.getElem? slots loc =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))))))) :
    evalArrSlicePrimitiveOperand decls slots (.copy { localId := loc }) =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)), slots) := by
  have hB : evalArrSliceBaseOperandToSlot decls slots (.copy { localId := loc }) =
      .ok (usizeTy, some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))), slots) := by
    rw [evalArrSliceBaseOperandToSlot_copy]
    change (if (!List.isEmpty ([] : List ProjectionElem)) = true then Except.error FaultKind.unsupported
      else match Trusted.MirSemantics.getElem? decls loc, Trusted.MirSemantics.getElem? slots loc with
        | some (.base ty), some (.baseSlot (.live optVal)) => Except.ok (ty, optVal, slots)
        | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
        | _, _ => Except.error FaultKind.unsupported) = _
    rw [hDecl, hSlot]
    rfl
  rw [evalArrSlicePrimitiveOperand_ok _ _ _ _ _ _ hB]
  rfl

private theorem evalArrSlicePrimitiveOperand_move_usize (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (loc : LocalId) (n : Nat)
    (hDecl : Trusted.MirSemantics.getElem? decls loc = some (.base usizeTy))
    (hSlot : Trusted.MirSemantics.getElem? slots loc =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))))))) :
    ∃ slots',
      setElem? slots loc (.baseSlot (.live none)) = some slots' ∧
      evalArrSlicePrimitiveOperand decls slots (.move { localId := loc }) =
        .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)), slots') := by
  have hLt := getElem?_some_lt slots loc _ hSlot
  have hEx := lt_setElem?_some slots loc (.baseSlot (.live none)) hLt
  cases hEx with | intro slots' hSet =>
  refine ⟨slots', hSet, ?_⟩
  have hB : evalArrSliceBaseOperandToSlot decls slots (.move { localId := loc }) =
      .ok (usizeTy, some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))), slots') := by
    rw [evalArrSliceBaseOperandToSlot_move]
    change (if (!List.isEmpty ([] : List ProjectionElem)) = true then Except.error FaultKind.unsupported
      else match Trusted.MirSemantics.getElem? decls loc, Trusted.MirSemantics.getElem? slots loc with
        | some (.base ty), some (.baseSlot (.live optVal)) =>
          match setElem? slots loc (.baseSlot (liveUninitSlot ty)) with
          | some slots'' => Except.ok (ty, optVal, slots'')
          | none => Except.error FaultKind.unsupported
        | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
        | _, _ => Except.error FaultKind.unsupported) = _
    rw [hDecl, hSlot]
    change (match setElem? slots loc (.baseSlot (.live none)) with
      | some slots'' => Except.ok (usizeTy, some (Val.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))), slots'')
      | none => Except.error FaultKind.unsupported) = _
    rw [hSet]
  rw [evalArrSlicePrimitiveOperand_ok _ _ _ _ _ _ hB]
  rfl

private theorem evalArrSlicePrimitiveOperand_const_usize (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (n : Nat) (hn : n < maxUsize) :
    evalArrSlicePrimitiveOperand decls slots (usizeConst n) =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)), slots) := by
  have hB : evalArrSliceBaseOperandToSlot decls slots (usizeConst n) =
      .ok (usizeTy, some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))), slots) := by
    rw [evalArrSliceBaseOperandToSlot_usizeConst, evalConstLit_usizeConst_of_lt_maxUsize n hn]
  rw [evalArrSlicePrimitiveOperand_ok _ _ _ _ _ _ hB]
  rfl

private theorem step_mkAssignUse_const_usize (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (dst : LocalId) (n : Nat) (ov : Option Val) (hn : n < maxUsize)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (mkAssignUse dst (usizeConst n)))
    (hDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base usizeTy))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals dst = some (.baseSlot (.live ov))) :
    ∃ slots',
      setElem? frame.locals dst (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))))) = some slots' ∧
      evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
        stepStmtNext frame cm slots' := by
  have hLt := getElem?_some_lt frame.locals dst _ hSlot
  let val : Val := .scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))
  have hEx := lt_setElem?_some frame.locals dst (.baseSlot (.live (some val))) hLt
  cases hEx with | intro slots' hSet =>
  refine ⟨slots', hSet, ?_⟩
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt]
  change evalArrSliceStmt body frame cm (.baseStmt (.assign { localId := dst } (.use (usizeConst n)))) = _
  rw [evalArrSliceStmt_assign, hDecl]
  dsimp
  have hB : evalArrSliceBaseOperandToSlot body.locals frame.locals (usizeConst n) =
      .ok (usizeTy, some val, frame.locals) := by
    rw [evalArrSliceBaseOperandToSlot_usizeConst, evalConstLit_usizeConst_of_lt_maxUsize n hn]
  rw [evalArrSliceBaseRvalue_use_ok _ _ _ _ _ _ _ hB]
  change (match writeArrSliceBasePlace frame.locals dst usizeTy val with
    | .error k => StepResult.fault k
    | .ok slots'' => stepStmtNext frame cm slots'') = _
  rw [writeArrSliceBasePlace_eq]
  have hChk : (!checkVal val usizeTy) = false := by
    rw [checkVal_usize_of_lt_maxUsize n hn]
    rfl
  rw [hChk, hSlot, hSet]
  rfl

private theorem step_mkAssignUse_copy_base_uninit (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (dst src : LocalId) (dstTy srcTy : MirTy)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (mkAssignUse dst (.copy { localId := src })))
    (hDstDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base dstTy))
    (hSrcDecl : Trusted.MirSemantics.getElem? body.locals src = some (.base srcTy))
    (hTy : srcTy = dstTy)
    (hSrcSlot : Trusted.MirSemantics.getElem? frame.locals src = some (.baseSlot (.live none))) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      StepResult.fault FaultKind.undefined := by
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt]
  change evalArrSliceStmt body frame cm (.baseStmt (.assign { localId := dst } (.use (.copy { localId := src })))) = _
  rw [evalArrSliceStmt_assign, hDstDecl]
  dsimp
  have hB : evalArrSliceBaseOperandToSlot body.locals frame.locals (.copy { localId := src }) =
      .ok (srcTy, none, frame.locals) := by
    rw [evalArrSliceBaseOperandToSlot_copy]
    change (if (!List.isEmpty ([] : List ProjectionElem)) = true then Except.error FaultKind.unsupported
      else match Trusted.MirSemantics.getElem? body.locals src, Trusted.MirSemantics.getElem? frame.locals src with
        | some (.base ty), some (.baseSlot (.live optVal)) => Except.ok (ty, optVal, frame.locals)
        | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
        | _, _ => Except.error FaultKind.unsupported) = _
    rw [hSrcDecl, hSrcSlot]
    rfl
  rw [evalArrSliceBaseRvalue_use_ok _ _ _ _ _ _ _ hB, hTy]
  have hBeq : (!dstTy.beq dstTy) = false := by rw [mirTy_beq_refl dstTy]; rfl
  rw [hBeq]
  rfl

private theorem step_mkAssignUse_copy_base_val (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (dst src : LocalId) (dstTy srcTy : MirTy) (v : Val)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (mkAssignUse dst (.copy { localId := src })))
    (hDstDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base dstTy))
    (hSrcDecl : Trusted.MirSemantics.getElem? body.locals src = some (.base srcTy))
    (hTy : srcTy = dstTy)
    (hSrcSlot : Trusted.MirSemantics.getElem? frame.locals src = some (.baseSlot (.live (some v)))) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      match writeArrSliceBasePlace frame.locals dst dstTy v with
      | .error k => StepResult.fault k
      | .ok slots' => stepStmtNext frame cm slots' := by
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt]
  change evalArrSliceStmt body frame cm (.baseStmt (.assign { localId := dst } (.use (.copy { localId := src })))) = _
  rw [evalArrSliceStmt_assign, hDstDecl]
  dsimp
  have hB : evalArrSliceBaseOperandToSlot body.locals frame.locals (.copy { localId := src }) =
      .ok (srcTy, some v, frame.locals) := by
    rw [evalArrSliceBaseOperandToSlot_copy]
    change (if (!List.isEmpty ([] : List ProjectionElem)) = true then Except.error FaultKind.unsupported
      else match Trusted.MirSemantics.getElem? body.locals src, Trusted.MirSemantics.getElem? frame.locals src with
        | some (.base ty), some (.baseSlot (.live optVal)) => Except.ok (ty, optVal, frame.locals)
        | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
        | _, _ => Except.error FaultKind.unsupported) = _
    rw [hSrcDecl, hSrcSlot]
    rfl
  rw [evalArrSliceBaseRvalue_use_ok _ _ _ _ _ _ _ hB, hTy]
  have hBeq : (!dstTy.beq dstTy) = false := by rw [mirTy_beq_refl dstTy]; rfl
  rw [hBeq]
  rfl

private theorem step_mkAssignUse_move_usize (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (dst src : LocalId) (n : Nat) (ov : Option Val) (hn : n < maxUsize) (hne : src ≠ dst)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (mkAssignUse dst (.move { localId := src })))
    (hDstDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base usizeTy))
    (hSrcDecl : Trusted.MirSemantics.getElem? body.locals src = some (.base usizeTy))
    (hSrcSlot : Trusted.MirSemantics.getElem? frame.locals src =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))))))
    (hDstSlot : Trusted.MirSemantics.getElem? frame.locals dst = some (.baseSlot (.live ov))) :
    ∃ slots₁ slots₂,
      setElem? frame.locals src (.baseSlot (.live none)) = some slots₁ ∧
      setElem? slots₁ dst (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))))) = some slots₂ ∧
      evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
        stepStmtNext frame cm slots₂ := by
  let val : Val := .scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))
  have hLt1 := getElem?_some_lt frame.locals src _ hSrcSlot
  have hEx1 := lt_setElem?_some frame.locals src (.baseSlot (.live none)) hLt1
  cases hEx1 with | intro slots₁ hSet₁ =>
  have hDstSlot₁ : Trusted.MirSemantics.getElem? slots₁ dst = some (.baseSlot (.live ov)) := by
    rw [getElem?_setElem?_ne frame.locals src dst _ slots₁ hne hSet₁]
    exact hDstSlot
  have hLt2 := getElem?_some_lt slots₁ dst _ hDstSlot₁
  have hEx2 := lt_setElem?_some slots₁ dst (.baseSlot (.live (some val))) hLt2
  cases hEx2 with | intro slots₂ hSet₂ =>
  refine ⟨slots₁, slots₂, hSet₁, hSet₂, ?_⟩
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt]
  change evalArrSliceStmt body frame cm (.baseStmt (.assign { localId := dst } (.use (.move { localId := src })))) = _
  rw [evalArrSliceStmt_assign, hDstDecl]
  dsimp
  have hB : evalArrSliceBaseOperandToSlot body.locals frame.locals (.move { localId := src }) =
      .ok (usizeTy, some val, slots₁) := by
    rw [evalArrSliceBaseOperandToSlot_move]
    change (if (!List.isEmpty ([] : List ProjectionElem)) = true then Except.error FaultKind.unsupported
      else match Trusted.MirSemantics.getElem? body.locals src, Trusted.MirSemantics.getElem? frame.locals src with
        | some (.base ty), some (.baseSlot (.live optVal)) =>
          match setElem? frame.locals src (.baseSlot (liveUninitSlot ty)) with
          | some s' => Except.ok (ty, optVal, s')
          | none => Except.error FaultKind.unsupported
        | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
        | _, _ => Except.error FaultKind.unsupported) = _
    rw [hSrcDecl, hSrcSlot]
    change (match setElem? frame.locals src (.baseSlot (.live none)) with
      | some s' => Except.ok (usizeTy, some val, s')
      | none => Except.error FaultKind.unsupported) = _
    rw [hSet₁]
  rw [evalArrSliceBaseRvalue_use_ok _ _ _ _ _ _ _ hB]
  change (match writeArrSliceBasePlace slots₁ dst usizeTy val with
    | .error k => StepResult.fault k
    | .ok slots'' => stepStmtNext frame cm slots'') = _
  rw [writeArrSliceBasePlace_eq]
  have hChk : (!checkVal val usizeTy) = false := by
    rw [checkVal_usize_of_lt_maxUsize n hn]
    rfl
  rw [hChk, hDstSlot₁, hSet₂]
  rfl

private theorem step_mkAssignUse_usizeOp
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (slots₁ : List ArrSliceSlot) (scrIdx : LocalId) (op : Operand) (ov : Option Val)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies frame₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks frame₂.blockIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements frame₂.stmtIdx = some (mkAssignUse scrIdx op))
    (hPre : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁ frame₂.locals)
    (hLen₂ : pack.bodySrc.locals.length ≤ frame₂.locals.length)
    (hOp : operandUsesOnlyBase pack.bodySrc.locals op = true)
    (hScrGe : pack.bodySrc.locals.length ≤ scrIdx)
    (hScrDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrIdx = some (.base usizeTy))
    (hScrSlot : Trusted.MirSemantics.getElem? frame₂.locals scrIdx = some (.baseSlot (.live ov))) :
    (∀ k, evalUsizeOperand pack.bodySrc.locals slots₁ op = .error k →
      evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } = StepResult.fault k) ∧
    (∀ n slots₁',
      evalUsizeOperand pack.bodySrc.locals slots₁ op = .ok (n, slots₁') →
        n < maxUsize ∧
        ∃ slots₂',
          evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } = stepStmtNext frame₂ cm slots₂' ∧
          PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' ∧
          slots₂'.length = frame₂.locals.length ∧
          Trusted.MirSemantics.getElem? slots₂' scrIdx =
            some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))))) ∧
          ∀ j, pack.bodySrc.locals.length ≤ j → j ≠ scrIdx →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? frame₂.locals j) := by
  have hBase := evalArrSliceBaseOperandToSlot_prefix pack hPre hLen₂ hOp
  rw [evalStepArrSlice_at_stmt pTgt pack.bodyTgt bbTgt frame₂ cm _ hBodyTgt hBbTgt hStmt]
  have hAssignEq : evalArrSliceStmt pack.bodyTgt frame₂ cm (mkAssignUse scrIdx op) =
      match evalArrSliceBaseRvalue pack.bodyTgt.locals frame₂.locals usizeTy (.use op) with
      | .error k => StepResult.fault k
      | .ok (val, slotsAfterRval) =>
        match writeArrSliceBasePlace slotsAfterRval scrIdx usizeTy val with
        | .error k => StepResult.fault k
        | .ok slots' => stepStmtNext frame₂ cm slots' := by
    change evalArrSliceStmt pack.bodyTgt frame₂ cm (.baseStmt (.assign { localId := scrIdx } (.use op))) = _
    rw [evalArrSliceStmt_assign, hScrDecl]
  rw [hAssignEq]
  cases hRes1 : evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op with
  | error err =>
    have hRes2 := hBase.1 err hRes1
    have hU1 := evalUsizeOperand_err _ _ _ _ (evalArrSliceTypedOperand_err _ _ _ _ _ hRes1)
    rw [hU1, evalArrSliceBaseRvalue_use_err _ _ _ _ _ hRes2]
    dsimp
    constructor
    · intro k hk; injection hk with hErr; rw [← hErr]
    · intro n s1' hOk; cases hOk
  | ok p =>
    cases p with | mk srcTy p2 =>
    cases p2 with | mk optVal slots₁' =>
    have hOk2 := hBase.2 srcTy optVal slots₁' hRes1
    cases hOk2 with | intro slots₂Mid hS2Mid =>
    have hT1 := evalArrSliceTypedOperand_ok pack.bodySrc.locals slots₁ usizeTy op srcTy optVal slots₁' hRes1
    have hRv2 := evalArrSliceBaseRvalue_use_ok pack.bodyTgt.locals frame₂.locals usizeTy op srcTy optVal slots₂Mid hS2Mid.1
    rw [hRv2]
    cases hNeq : (!srcTy.beq usizeTy) with
    | true =>
      rw [hNeq] at hT1
      dsimp at hT1
      dsimp
      have hU1 := evalUsizeOperand_err _ _ _ _ hT1
      rw [hU1]
      constructor
      · intro k hk; injection hk with hErr; rw [← hErr]
      · intro n s1' hOk; cases hOk
    | false =>
      rw [hNeq] at hT1
      dsimp at hT1
      dsimp
      cases optVal with
      | none =>
        dsimp at hT1
        dsimp
        have hU1 := evalUsizeOperand_err _ _ _ _ hT1
        rw [hU1]
        constructor
        · intro k hk; injection hk with hErr; rw [← hErr]
        · intro n s1' hOk; cases hOk
      | some v =>
        dsimp at hT1
        dsimp
        cases hChk : checkVal v usizeTy with
        | false =>
          rw [hChk] at hT1
          dsimp at hT1
          have hU1 := evalUsizeOperand_err _ _ _ _ hT1
          rw [hU1, writeArrSliceBasePlace_eq]
          have hNegChk : (!checkVal v usizeTy) = true := by rw [hChk]; rfl
          rw [hNegChk]
          dsimp
          constructor
          · intro k hk; injection hk with hErr; rw [← hErr]
          · intro n s1' hOk; cases hOk
        | true =>
          rw [hChk] at hT1
          dsimp at hT1
          have hVal := (checkVal_usize_iff v).mp hChk
          cases hVal with | intro sv hSv =>
          have hLtMax := scalarVal_wf_isize_lt_maxUsize sv hSv.2.1 hSv.2.2.1
          have hSvEq : v = .scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv.bits.toNat)) := by
            rw [hSv.1]
            cases sv with
            | mk w s b =>
              have hw : w = IntWidth.isize := hSv.2.2.1
              have hs : s = false := hSv.2.2.2
              have hb : b = BitVec.ofNat 128 b.toNat := (bitVec_ofNat_toNat b).symm
              rw [hw, hs]
              exact congrArg Val.scalar (congrArg (ScalarVal.mk IntWidth.isize false) hb)
          have hU1 := evalUsizeOperand_ok pack.bodySrc.locals slots₁ op v slots₁' hT1
          rw [hSv.1] at hU1
          dsimp [evalUsizeOfVal] at hU1
          have hScrMid : Trusted.MirSemantics.getElem? slots₂Mid scrIdx = some (.baseSlot (.live ov)) := by
            rw [hS2Mid.2.2.2 scrIdx hScrGe]
            exact hScrSlot
          have hLtScr := getElem?_some_lt slots₂Mid scrIdx _ hScrMid
          have hExFin := lt_setElem?_some slots₂Mid scrIdx (.baseSlot (.live (some v))) hLtScr
          cases hExFin with | intro slots₂Fin hSetFin =>
          have hPM := prefixSlotsMatch_set_ext hS2Mid.2.1 hScrGe (.baseSlot (.live (some v))) hSetFin
          rw [hU1]
          constructor
          · intro k hk; cases hk
          · intro n s1' hOk
            injection hOk with hP
            injection hP with hn hsl
            rw [← hn, ← hsl]
            refine ⟨hLtMax, slots₂Fin, ?_, hPM.1, ?_, ?_, ?_⟩
            · rw [writeArrSliceBasePlace_eq]
              have hNegChk : (!checkVal v usizeTy) = false := by rw [hChk]; rfl
              rw [hNegChk]
              dsimp
              rw [hScrMid, hSetFin]
            · rw [hPM.2, hS2Mid.2.2.1]
            · rw [getElem?_setElem?_self slots₂Mid scrIdx (.baseSlot (.live (some v))) slots₂Fin hSetFin, hSvEq]
            · intro j hj hne
              rw [getElem?_setElem?_ne slots₂Mid scrIdx j (.baseSlot (.live (some v))) slots₂Fin (Ne.symm hne) hSetFin]
              exact hS2Mid.2.2.2 j hj

private theorem step_mkBinOp_usize (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (bop : BinOp) (dst : LocalId) (lhs rhs : Operand) (dstTy : MirTy)
    (a b : Nat) (slots₁ slots₂ : List ArrSliceSlot)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx =
      some (.baseStmt (.assign { localId := dst } (.binaryOp bop lhs rhs))))
    (hDstDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base dstTy))
    (hLhs : evalArrSlicePrimitiveOperand body.locals frame.locals lhs =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)), slots₁))
    (hRhs : evalArrSlicePrimitiveOperand body.locals slots₁ rhs =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b)), slots₂)) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      match evalBinOp bop
          (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
          (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) with
      | .error k => StepResult.fault k
      | .ok res =>
        match writeArrSliceBasePlace slots₂ dst dstTy res with
        | .error k => StepResult.fault k
        | .ok slots' => stepStmtNext frame cm slots' := by
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt]
  rw [evalArrSliceStmt_assign, hDstDecl]
  dsimp
  rw [evalArrSliceBaseRvalue_binaryOp, hLhs]
  dsimp
  rw [hRhs]
  dsimp
  cases evalBinOp bop
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) <;> rfl

private theorem exec_mkStorageLiveRange_aux (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (defId : DefId) (bbIdx baseIdx start count : Nat) (cm : CallerMemory)
    (slots : List ArrSliceSlot)
    (hBody : Trusted.MirSemantics.getElem? p.bodies defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx = some bb)
    (hStmts : ∀ j, j < count →
      Trusted.MirSemantics.getElem? bb.statements (baseIdx + j) =
        some (.baseStmt (.storageLive (start + j))))
    (hDecls : ∀ j, j < count →
      ∃ ty, Trusted.MirSemantics.getElem? body.locals (start + j) = some (.base ty))
    (hBounds : ∀ j, j < count → start + j < slots.length) :
    ∃ slots',
      ReachesNArrSlice p count
        { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx, locals := slots }], callerMem := cm }
        { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx + count, locals := slots' }], callerMem := cm } ∧
      slots'.length = slots.length ∧
      (∀ i, i < start →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ i, start + count ≤ i →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ j, j < count → ∀ ty,
        Trusted.MirSemantics.getElem? body.locals (start + j) = some (.base ty) →
        Trusted.MirSemantics.getElem? slots' (start + j) = some (.baseSlot (liveUninitSlot ty))) := by
  induction count generalizing baseIdx start slots with
  | zero =>
    refine ⟨slots, ReachesNArrSlice.zero _, rfl, fun _ _ => rfl, fun _ _ => rfl, fun j hj => False.elim (Nat.not_lt_zero _ hj)⟩
  | succ count' ih =>
    have hD0 := hDecls 0 (Nat.zero_lt_succ count')
    rw [Nat.add_zero] at hD0
    cases hD0 with | intro ty0 hTy0 =>
    have hB0 := hBounds 0 (Nat.zero_lt_succ count')
    rw [Nat.add_zero] at hB0
    have hEx1 := lt_setElem?_some slots start (.baseSlot (liveUninitSlot ty0)) hB0
    cases hEx1 with | intro slots1 hSet1 =>
    have hSt0 := hStmts 0 (Nat.zero_lt_succ count')
    rw [Nat.add_zero, Nat.add_zero] at hSt0
    have hStep0 : evalStepArrSlice p 0
        { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx, locals := slots }], callerMem := cm } =
        .step { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx + 1, locals := slots1 }], callerMem := cm } := by
      rw [evalStepArrSlice_at_stmt p body bb _ cm _ hBody hBb hSt0]
      change (match Trusted.MirSemantics.getElem? body.locals start with
        | none => StepResult.fault FaultKind.unsupported
        | some decl =>
          match setElem? slots start (liveUninitArrSliceSlot decl) with
          | some s' => stepStmtNext { defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx, locals := slots } cm s'
          | none => StepResult.fault FaultKind.unsupported) = _
      rw [hTy0]
      change (match setElem? slots start (.baseSlot (liveUninitSlot ty0)) with
        | some s' => stepStmtNext _ cm s'
        | none => StepResult.fault FaultKind.unsupported) = _
      rw [hSet1]
      rfl
    have hStmts' : ∀ j, j < count' →
        Trusted.MirSemantics.getElem? bb.statements ((baseIdx + 1) + j) =
          some (.baseStmt (.storageLive ((start + 1) + j))) := by
      intro j hj
      rw [Nat.add_assoc, Nat.add_comm 1 j, ← Nat.add_assoc]
      rw [Nat.add_assoc start 1 j, Nat.add_comm 1 j, ← Nat.add_assoc]
      exact hStmts (j + 1) (Nat.succ_lt_succ hj)
    have hDecls' : ∀ j, j < count' →
        ∃ ty, Trusted.MirSemantics.getElem? body.locals ((start + 1) + j) = some (.base ty) := by
      intro j hj
      rw [Nat.add_assoc, Nat.add_comm 1 j, ← Nat.add_assoc]
      exact hDecls (j + 1) (Nat.succ_lt_succ hj)
    have hBounds' : ∀ j, j < count' → (start + 1) + j < slots1.length := by
      intro j hj
      rw [setElem?_length slots start _ slots1 hSet1, Nat.add_assoc, Nat.add_comm 1 j, ← Nat.add_assoc]
      exact hBounds (j + 1) (Nat.succ_lt_succ hj)
    have hIH := ih (baseIdx + 1) (start + 1) slots1 hStmts' hDecls' hBounds'
    cases hIH with | intro slotsFin hRest =>
    refine ⟨slotsFin, ?_, ?_, ?_, ?_, ?_⟩
    · have hReach1 := reachesNArrSlice_one_step hStep0
      have hComb := reachesNArrSlice_trans hReach1 hRest.1
      rw [Nat.add_comm 1 count', Nat.add_assoc baseIdx 1 count', Nat.add_comm 1 count'] at hComb
      exact hComb
    · rw [hRest.2.1, setElem?_length slots start _ slots1 hSet1]
    · intro i hi
      rw [hRest.2.2.1 i (Nat.lt_trans hi (Nat.lt_succ_self start))]
      exact getElem?_setElem?_ne slots start i _ slots1 (Nat.ne_of_gt hi) hSet1
    · intro i hi
      have hi' : (start + 1) + count' ≤ i := by
        rw [Nat.add_assoc, Nat.add_comm 1 count', ← Nat.add_assoc]
        exact hi
      rw [hRest.2.2.2.1 i hi']
      have hNe : start ≠ i := Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count')) hi)
      exact getElem?_setElem?_ne slots start i _ slots1 hNe hSet1
    · intro j hj ty hGetTy
      cases j with
      | zero =>
        rw [Nat.add_zero] at hGetTy
        rw [Nat.add_zero]
        rw [hTy0] at hGetTy
        injection hGetTy with hTyEq
        injection hTyEq with hTyEq2
        rw [← hTyEq2, hRest.2.2.1 start (Nat.lt_succ_self start),
            getElem?_setElem?_self slots start _ slots1 hSet1]
      | succ j' =>
        have hj' : j' < count' := Nat.lt_of_succ_lt_succ hj
        rw [Nat.add_comm j' 1, ← Nat.add_assoc] at hGetTy
        rw [Nat.add_comm j' 1, ← Nat.add_assoc]
        exact hRest.2.2.2.2 j' hj' ty hGetTy

private theorem exec_mkStorageDeadRange_aux (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (defId : DefId) (bbIdx baseIdx start count : Nat) (cm : CallerMemory)
    (slots : List ArrSliceSlot) (hPos : 0 < start)
    (hBody : Trusted.MirSemantics.getElem? p.bodies defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx = some bb)
    (hStmts : ∀ j, j < count →
      Trusted.MirSemantics.getElem? bb.statements (baseIdx + j) =
        some (.baseStmt (.storageDead (start + j))))
    (hDecls : ∀ j, j < count →
      ∃ ty, Trusted.MirSemantics.getElem? body.locals (start + j) = some (.base ty))
    (hBounds : ∀ j, j < count → start + j < slots.length) :
    ∃ slots',
      ReachesNArrSlice p count
        { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx, locals := slots }], callerMem := cm }
        { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx + count, locals := slots' }], callerMem := cm } ∧
      slots'.length = slots.length ∧
      (∀ i, i < start →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ i, start + count ≤ i →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ j, j < count →
        Trusted.MirSemantics.getElem? slots' (start + j) = some (.baseSlot .dead)) := by
  induction count generalizing baseIdx start slots with
  | zero =>
    refine ⟨slots, ReachesNArrSlice.zero _, rfl, fun _ _ => rfl, fun _ _ => rfl, fun j hj => False.elim (Nat.not_lt_zero _ hj)⟩
  | succ count' ih =>
    have hD0 := hDecls 0 (Nat.zero_lt_succ count')
    rw [Nat.add_zero] at hD0
    cases hD0 with | intro ty0 hTy0 =>
    have hB0 := hBounds 0 (Nat.zero_lt_succ count')
    rw [Nat.add_zero] at hB0
    have hEx1 := lt_setElem?_some slots start (.baseSlot .dead) hB0
    cases hEx1 with | intro slots1 hSet1 =>
    have hSt0 := hStmts 0 (Nat.zero_lt_succ count')
    rw [Nat.add_zero, Nat.add_zero] at hSt0
    have hNotZero : Nat.beq start 0 = false := by
      cases hb : Nat.beq start 0 with
      | false => rfl
      | true =>
        have hz := nat_beq_eq _ _ hb
        rw [hz] at hPos
        cases Nat.not_lt_zero _ hPos
    have hStep0 : evalStepArrSlice p 0
        { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx, locals := slots }], callerMem := cm } =
        .step { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx + 1, locals := slots1 }], callerMem := cm } := by
      rw [evalStepArrSlice_at_stmt p body bb _ cm _ hBody hBb hSt0]
      change (if Nat.beq start 0 = true then StepResult.fault FaultKind.unsupported
        else
          let deadSlot := match Trusted.MirSemantics.getElem? body.locals start with
            | some decl => deadArrSliceSlot decl
            | none => ArrSliceSlot.baseSlot LocalSlot.dead
          match setElem? slots start deadSlot with
          | some s' => stepStmtNext { defId := defId, blockIdx := bbIdx, stmtIdx := baseIdx, locals := slots } cm s'
          | none => StepResult.fault FaultKind.unsupported) = _
      rw [hNotZero, hTy0]
      change (match setElem? slots start (.baseSlot .dead) with
        | some s' => stepStmtNext _ cm s'
        | none => StepResult.fault FaultKind.unsupported) = _
      rw [hSet1]
      rfl
    have hStmts' : ∀ j, j < count' →
        Trusted.MirSemantics.getElem? bb.statements ((baseIdx + 1) + j) =
          some (.baseStmt (.storageDead ((start + 1) + j))) := by
      intro j hj
      rw [Nat.add_assoc, Nat.add_comm 1 j, ← Nat.add_assoc]
      rw [Nat.add_assoc start 1 j, Nat.add_comm 1 j, ← Nat.add_assoc]
      exact hStmts (j + 1) (Nat.succ_lt_succ hj)
    have hDecls' : ∀ j, j < count' →
        ∃ ty, Trusted.MirSemantics.getElem? body.locals ((start + 1) + j) = some (.base ty) := by
      intro j hj
      rw [Nat.add_assoc, Nat.add_comm 1 j, ← Nat.add_assoc]
      exact hDecls (j + 1) (Nat.succ_lt_succ hj)
    have hBounds' : ∀ j, j < count' → (start + 1) + j < slots1.length := by
      intro j hj
      rw [setElem?_length slots start _ slots1 hSet1, Nat.add_assoc, Nat.add_comm 1 j, ← Nat.add_assoc]
      exact hBounds (j + 1) (Nat.succ_lt_succ hj)
    have hIH := ih (baseIdx + 1) (start + 1) slots1 (Nat.lt_trans hPos (Nat.lt_succ_self start)) hStmts' hDecls' hBounds'
    cases hIH with | intro slotsFin hRest =>
    refine ⟨slotsFin, ?_, ?_, ?_, ?_, ?_⟩
    · have hReach1 := reachesNArrSlice_one_step hStep0
      have hComb := reachesNArrSlice_trans hReach1 hRest.1
      rw [Nat.add_comm 1 count', Nat.add_assoc baseIdx 1 count', Nat.add_comm 1 count'] at hComb
      exact hComb
    · rw [hRest.2.1, setElem?_length slots start _ slots1 hSet1]
    · intro i hi
      rw [hRest.2.2.1 i (Nat.lt_trans hi (Nat.lt_succ_self start))]
      exact getElem?_setElem?_ne slots start i _ slots1 (Nat.ne_of_gt hi) hSet1
    · intro i hi
      have hi' : (start + 1) + count' ≤ i := by
        rw [Nat.add_assoc, Nat.add_comm 1 count', ← Nat.add_assoc]
        exact hi
      rw [hRest.2.2.2.1 i hi']
      have hNe : start ≠ i := Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count')) hi)
      exact getElem?_setElem?_ne slots start i _ slots1 hNe hSet1
    · intro j hj
      cases j with
      | zero =>
        rw [Nat.add_zero]
        rw [hRest.2.2.1 start (Nat.lt_succ_self start),
            getElem?_setElem?_self slots start _ slots1 hSet1]
      | succ j' =>
        have hj' : j' < count' := Nat.lt_of_succ_lt_succ hj
        rw [Nat.add_comm j' 1, ← Nat.add_assoc]
        exact hRest.2.2.2.2 j' hj'

