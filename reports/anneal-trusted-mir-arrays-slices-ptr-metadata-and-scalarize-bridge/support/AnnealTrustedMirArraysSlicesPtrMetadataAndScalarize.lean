private theorem sliceLocalMatch_set_base
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    (hLM : SliceLocalMatch pack slots₁ slots₂)
    {dst : LocalId} {slNew : ArrSliceSlot}
    (hDstLt : dst < pack.bodySrc.locals.length)
    (hNotSlice : findSliceEntry plan.entries dst = none)
    (hSet₁ : setElem? slots₁ dst slNew = some slots₁')
    (hSet₂ : setElem? slots₂ dst slNew = some slots₂') :
    SliceLocalMatch pack slots₁' slots₂' := by
  have hPre' : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' := by
    refine ⟨by rw [setElem?_length slots₁ dst slNew slots₁' hSet₁]; exact hLM.1.1, ?_⟩
    intro i hi hNone
    cases Nat.decEq i dst with
    | isTrue hEq =>
      rw [hEq, getElem?_setElem?_self slots₂ dst slNew slots₂' hSet₂,
          getElem?_setElem?_self slots₁ dst slNew slots₁' hSet₁]
    | isFalse hNe =>
      rw [getElem?_setElem?_ne slots₂ dst i slNew slots₂' (Ne.symm hNe) hSet₂,
          getElem?_setElem?_ne slots₁ dst i slNew slots₁' (Ne.symm hNe) hSet₁]
      exact hLM.1.2 i hi hNone
  refine ⟨hPre', by rw [setElem?_length slots₂ dst slNew slots₂' hSet₂, hLM.2.1], ?_, ?_⟩
  · intro sLoc k optArr hFind
    have hNe : dst ≠ sLoc := by
      intro hEq; rw [hEq, hFind] at hNotSlice; cases hNotSlice
    have hOld := hLM.2.2.1 sLoc k optArr hFind
    cases hOld with | intro sl₁ hSl =>
    refine ⟨sl₁, by rw [getElem?_setElem?_ne slots₁ dst sLoc slNew slots₁' hNe hSet₁]; exact hSl.1, ?_⟩
    apply sliceCompRel_of_ext_eq hSl.2
    intro r _
    have hNeComp : dst ≠ pack.bodySrc.locals.length + 4 * k + r :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le hDstLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)))
    exact getElem?_setElem?_ne slots₂ dst _ slNew slots₂' hNeComp hSet₂
  · intro r hr
    have hNeScr : dst ≠ pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le hDstLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)))
    rw [getElem?_setElem?_ne slots₂ dst _ slNew slots₂' hNeScr hSet₂]
    exact hLM.2.2.2 r hr


-- ============================================================================
-- Section 7C: Statement Simulation (`stmt_step_sim`)
-- ============================================================================

private noncomputable def FwdStmtSim
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (f₁ f₂ : ArrSliceFrame) (cm : CallerMemory) : Prop :=
  (∀ s₁', evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .step s₁' →
    ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ SliceStateRel pack s₁' s₂') ∧
  (∀ out, evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .done out →
    ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.done out)) ∧
  (∀ k, evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .fault k →
    ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.fault k))

private theorem reachesPlus_stmt_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {slots₁' slots₂' : List ArrSliceSlot} {stmt : ArrSliceStmt} {n : Nat}
    (hSame : f₁.defId = plan.defId)
    (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmt)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
      pack.bodySrc.locals.length stmt).length =
        (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length) (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hReach : ReachesNArrSlice pTgt (n + 1) { frames := [f₂], callerMem := cm }
      { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
        pack.bodySrc.locals.length stmt).length, locals := slots₂' }], callerMem := cm })
    (hLM' : SliceLocalMatch pack slots₁' slots₂') :
    ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧
      SliceStateRel pack { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], callerMem := cm } s₂' := by
  let off' := f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length stmt).length
  let s₂' : ArrSliceState := { frames := [{ f₂ with stmtIdx := off', locals := slots₂' }], callerMem := cm }
  refine ⟨s₂', ⟨n, hReach⟩, rfl, Or.inl ⟨hSame, hSame₂, hBbEq, hLM', ?_⟩⟩
  rw [hBb]
  exact ⟨getElem?_some_lt bbSrc.statements f₁.stmtIdx stmt hStmt, hLen₂⟩

private theorem comp_range_disjoint_k {base k k' r' : Nat} (hne : k' ≠ k) (hr' : r' < 4) :
    base + 4 * k' + r' < base + 4 * k ∨ base + 4 * k + 4 ≤ base + 4 * k' + r' := by
  cases Nat.decLt k' k with
  | isTrue hlt =>
    apply Or.inl
    have hk4 : 4 * (k' + 1) ≤ 4 * k := Nat.mul_le_mul_left 4 hlt
    rw [Nat.mul_succ] at hk4
    have h4 : 4 * k' + r' < 4 * k := Nat.lt_of_lt_of_le (Nat.add_lt_add_left hr' _) hk4
    rw [Nat.add_assoc base (4 * k') r']
    exact Nat.add_lt_add_left h4 base
  | isFalse hnot =>
    apply Or.inr
    have hgt : k < k' := Nat.lt_of_le_of_ne (Nat.le_of_not_lt hnot) (Ne.symm hne)
    have hk4 : 4 * (k + 1) ≤ 4 * k' := Nat.mul_le_mul_left 4 hgt
    rw [Nat.mul_succ] at hk4
    exact Nat.le_trans (Nat.add_le_add_left hk4 base) (Nat.le_add_right _ r')

private theorem comp_range_le_scr {base k K r : Nat} (hk : k < K) :
    base + 4 * k + 4 ≤ base + 4 * K + r := by
  have hk4 : 4 * (k + 1) ≤ 4 * K := Nat.mul_le_mul_left 4 hk
  rw [Nat.mul_succ] at hk4
  exact Nat.le_trans (Nat.add_le_add_left hk4 base) (Nat.le_add_right _ r)

private theorem bodyTgt_decl_nonSlice_lt
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {i : LocalId}
    (hi : i < pack.bodySrc.locals.length)
    (hNot : ∀ sTy, Trusted.MirSemantics.getElem? pack.bodySrc.locals i ≠ some (.sliceView sTy)) :
    findSliceEntry plan.entries i = none ∧
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals i =
      Trusted.MirSemantics.getElem? pack.bodySrc.locals i := by
  have hNone := findSliceEntry_none_of_not_sliceView pack.hLoop hNot
  exact ⟨hNone, getElem?_bodyTgt_nonSlice pack hi hNone⟩

private theorem bodyTgt_not_array_of_src_not_array
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {i : LocalId}
    (hi : i < pack.bodySrc.locals.length)
    (hNot : ∀ elemTy len, Trusted.MirSemantics.getElem? pack.bodySrc.locals i ≠ some (.array elemTy len)) :
    ∀ elemTy len, Trusted.MirSemantics.getElem? pack.bodyTgt.locals i ≠ some (.array elemTy len) := by
  intro elemTy len hGet
  cases hSrc : Trusted.MirSemantics.getElem? pack.bodySrc.locals i with
  | none =>
    exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hSrc) hi)
  | some d =>
    cases d with
    | array e l => exact False.elim (hNot e l hSrc)
    | base ty =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hi (fun sTy h => by rw [hSrc] at h; cases h)
      rw [hNS.2, hSrc] at hGet
      cases hGet
    | sliceView sTy =>
      rw [getElem?_bodyTgt_locals_lt pack hi, getElem?_tombstoneSliceDecls, hSrc] at hGet
      cases hGet

private theorem sliceCompRel_live_fields {base k : Nat} {slots₂ : List ArrSliceSlot}
    {optArr : Option LocalId} {optSv : Option SliceViewVal}
    (hRel : SliceCompRel base slots₂ k optArr (.liveSlice optSv)) :
    (∃ ov1, Trusted.MirSemantics.getElem? slots₂ (base + 4 * k + 1) = some (.baseSlot (.live ov1))) ∧
    (∃ ov2, Trusted.MirSemantics.getElem? slots₂ (base + 4 * k + 2) = some (.baseSlot (.live ov2))) ∧
    (∃ ov3, Trusted.MirSemantics.getElem? slots₂ (base + 4 * k + 3) = some (.baseSlot (.live ov3))) := by
  cases optSv with
  | none =>
    dsimp [SliceCompRel] at hRel
    exact ⟨⟨none, hRel.2.1⟩, hRel.2.2.1, hRel.2.2.2⟩
  | some sv =>
    dsimp [SliceCompRel] at hRel
    exact ⟨⟨_, hRel.2.2.2.1⟩, ⟨_, hRel.2.2.2.2.1⟩, ⟨_, hRel.2.2.2.2.2⟩⟩

private theorem evalArrSliceStmt_nop (body : ArrSliceBody) (frame : ArrSliceFrame) (cm : CallerMemory) :
    evalArrSliceStmt body frame cm (.baseStmt .nop) = stepStmtNext frame cm frame.locals := rfl

private theorem evalArrSliceStmt_unsupported (body : ArrSliceBody) (frame : ArrSliceFrame) (cm : CallerMemory) :
    evalArrSliceStmt body frame cm (.baseStmt .unsupported) = StepResult.fault FaultKind.unsupported := rfl

private theorem evalArrSliceStmt_storageLive (body : ArrSliceBody) (frame : ArrSliceFrame)
    (cm : CallerMemory) (id : LocalId) :
    evalArrSliceStmt body frame cm (.baseStmt (.storageLive id)) =
      match Trusted.MirSemantics.getElem? body.locals id with
      | none => .fault .unsupported
      | some decl =>
        match setElem? frame.locals id (liveUninitArrSliceSlot decl) with
        | some slots' => stepStmtNext frame cm slots'
        | none => .fault .unsupported := rfl

private theorem evalArrSliceStmt_storageDead (body : ArrSliceBody) (frame : ArrSliceFrame)
    (cm : CallerMemory) (id : LocalId) :
    evalArrSliceStmt body frame cm (.baseStmt (.storageDead id)) =
      if Nat.beq id 0 then .fault .unsupported
      else
        let deadSlot := match Trusted.MirSemantics.getElem? body.locals id with
          | some decl => deadArrSliceSlot decl
          | none => .baseSlot .dead
        match setElem? frame.locals id deadSlot with
        | some slots' => stepStmtNext frame cm slots'
        | none => .fault .unsupported := rfl

private theorem sim_stmt_one_same
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory} {stmt : ArrSliceStmt}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmt)
    (hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length stmt = [stmt])
    (hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some stmt)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
      pack.bodySrc.locals.length stmt).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries
        pack.bodySrc.locals.length) (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (_hLM : SliceLocalMatch pack f₁.locals f₂.locals)
    (hEvalSim :
      (∀ s₁', evalArrSliceStmt pack.bodySrc f₁ cm stmt = .step s₁' →
        ∃ slots₁' slots₂',
          s₁' = { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], callerMem := cm } ∧
          evalArrSliceStmt pack.bodyTgt f₂ cm stmt = stepStmtNext f₂ cm slots₂' ∧
          SliceLocalMatch pack slots₁' slots₂') ∧
      (∀ out, evalArrSliceStmt pack.bodySrc f₁ cm stmt = .done out → False) ∧
      (∀ k, evalArrSliceStmt pack.bodySrc f₁ cm stmt = .fault k →
        evalArrSliceStmt pack.bodyTgt f₂ cm stmt = .fault k)) :
    FwdStmtSim pack f₁ f₂ cm := by
  have hS1 := evalStepArrSlice_at_stmt pSrc pack.bodySrc bbSrc f₁ cm stmt hBodySrc hBbSrc hStmtSrc
  have hS2 := evalStepArrSlice_at_stmt pTgt pack.bodyTgt bbTgt f₂ cm stmt hBodyTgt hBbTgt hGetTgt
  dsimp [FwdStmtSim]
  rw [hS1]
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    have hEx := hEvalSim.1 s₁' hStep
    cases hEx with | intro slots₁' hRest =>
    cases hRest with | intro slots₂' hRest2 =>
    rw [hRest2.1]
    have hReach1 : ReachesNArrSlice pTgt 1 { frames := [f₂], callerMem := cm }
        { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + ([stmt] : List ArrSliceStmt).length, locals := slots₂' }], callerMem := cm } := by
      apply reachesNArrSlice_one_step
      rw [hS2]
      exact hRest2.2.1
    rw [← hGen] at hReach1
    exact reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLen₂ hReach1 hRest2.2.2
  · intro out hDone; exact False.elim (hEvalSim.2.1 out hDone)
  · intro k hFault
    exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
      (stepArrSlice_iff_evalStep pTgt { frames := [f₂], callerMem := cm } (.fault k)).mpr
        (by rw [hS2]; exact hEvalSim.2.2 k hFault)⟩

private theorem sim_stmt_storageLive
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory} {id : LocalId}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.storageLive id)))
    (hIdLt : id < pack.bodySrc.locals.length)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.storageLive id))).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.baseStmt (.storageLive id))) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.storageLive id))).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  cases hFind : findSliceEntry plan.entries id with
  | none =>
    have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.storageLive id)) = [.baseStmt (.storageLive id)] := by
      dsimp [lowerStmtForSlices]
      rw [hFind]
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.baseStmt (.storageLive id)) := by
      have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl)
      rw [Nat.add_zero, hGen] at h0
      exact h0
    apply sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLen₂ hLM
    have hExD := getElem?_lt_some pack.bodySrc.locals id hIdLt
    cases hExD with | intro d hD =>
    have hDTgt := getElem?_bodyTgt_nonSlice pack hIdLt hFind
    rw [hD] at hDTgt
    have hLt1 : id < f₁.locals.length := by rw [hLM.1.1]; exact hIdLt
    have hEx1 := lt_setElem?_some f₁.locals id (liveUninitArrSliceSlot d) hLt1
    cases hEx1 with | intro slots₁' hSet₁ =>
    have hLt2 : id < f₂.locals.length := by
      rw [hLM.2.1, bodyTgt_locals_length pack]
      exact Nat.lt_of_lt_of_le hIdLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
    have hEx2 := lt_setElem?_some f₂.locals id (liveUninitArrSliceSlot d) hLt2
    cases hEx2 with | intro slots₂' hSet₂ =>
    have hPM := prefixSlotsMatch_set_base hLM.1 hIdLt (liveUninitArrSliceSlot d) hSet₁ hSet₂
    have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
        Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc := by
      intro sLoc k optArr hF
      have hNe : id ≠ sLoc := by
        intro hEq; rw [hEq, hF] at hFind; cases hFind
      exact getElem?_setElem?_ne f₁.locals id sLoc _ slots₁' hNe hSet₁
    have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hPM.1 hPM.2.1 hSl₁Pres hPM.2.2
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      rw [evalArrSliceStmt_storageLive, hD] at hStep
      dsimp at hStep
      rw [hSet₁] at hStep
      injection hStep with hsEq
      refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
      rw [evalArrSliceStmt_storageLive, hDTgt]
      dsimp
      rw [hSet₂]
    · intro out hDone
      rw [evalArrSliceStmt_storageLive, hD] at hDone
      dsimp at hDone
      rw [hSet₁] at hDone
      cases hDone
    · intro k hFault
      rw [evalArrSliceStmt_storageLive, hD] at hFault
      dsimp at hFault
      rw [hSet₁] at hFault
      cases hFault
  | some p =>
    cases p with | mk k optArr =>
    have hValid := findSliceEntry_some_lt_and_valid pack.hLoop hFind
    have hk := hValid.1
    cases hValid.2 with | intro e hE =>
    cases hE.2.2.2.2.2 with | intro sTy hs =>
    have hSrcDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals id = some (.sliceView sTy) := by
      rw [← hE.2.1]; exact hs.1
    have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.storageLive id)) = mkStorageLiveRange (pack.bodySrc.locals.length + 4 * k) 4 := by
      dsimp [lowerStmtForSlices]
      rw [hFind]
    have hLen4 : (mkStorageLiveRange (pack.bodySrc.locals.length + 4 * k) 4).length = 4 := rfl
    have hLt1 : id < f₁.locals.length := by rw [hLM.1.1]; exact hIdLt
    have hEx1 := lt_setElem?_some f₁.locals id (.liveSlice none) hLt1
    cases hEx1 with | intro slots₁' hSet₁ =>
    have hStmts : ∀ j, j < 4 →
        Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
          some (.baseStmt (.storageLive (pack.bodySrc.locals.length + 4 * k + j))) := by
      intro j hj
      have hG := hGetGen j (by rw [hGen, hLen4]; exact hj)
      rw [hGen] at hG
      cases j with
      | zero => exact hG
      | succ j1 =>
        cases j1 with
        | zero => exact hG
        | succ j2 =>
          cases j2 with
          | zero => exact hG
          | succ j3 =>
            cases j3 with
            | zero => exact hG
            | succ _ =>
              exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hj)))))
    have hDecls : ∀ j, j < 4 →
        ∃ ty, Trusted.MirSemantics.getElem? pack.bodyTgt.locals (pack.bodySrc.locals.length + 4 * k + j) = some (.base ty) := by
      intro j hj
      have hD := getElem?_bodyTgt_locals_comp pack hk hj
      cases j with
      | zero => exact ⟨.unit, hD⟩
      | succ j1 =>
        cases j1 with
        | zero => exact ⟨usizeTy, hD⟩
        | succ j2 =>
          cases j2 with
          | zero => exact ⟨usizeTy, hD⟩
          | succ _ => exact ⟨usizeTy, hD⟩
    have hBounds : ∀ j, j < 4 → pack.bodySrc.locals.length + 4 * k + j < f₂.locals.length := by
      intro j hj
      rw [hLM.2.1, bodyTgt_locals_length pack]
      have hk4 : 4 * (k + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hk
      rw [Nat.mul_succ] at hk4
      have hkr : 4 * k + j < 4 * plan.entries.length :=
        Nat.lt_of_lt_of_le (Nat.add_lt_add_left hj (4 * k)) hk4
      rw [Nat.add_assoc pack.bodySrc.locals.length (4 * k) j]
      exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hkr _) (Nat.le_add_right _ _)
    have hExec := exec_mkStorageLiveRange_aux pTgt pack.bodyTgt bbTgt f₂.defId f₂.blockIdx
      f₂.stmtIdx (pack.bodySrc.locals.length + 4 * k) 4 cm f₂.locals hBodyTgt hBbTgt hStmts hDecls hBounds
    cases hExec with | intro slots₂' hRest =>
    have hLM' : SliceLocalMatch pack slots₁' slots₂' := by
      apply sliceLocalMatch_set_comp pack hLM hFind hSet₁ hRest.2.1
      · intro j hj _
        exact hRest.2.2.1 j (Nat.lt_of_lt_of_le hj (Nat.le_add_right _ _))
      · intro k' r' hne hr'
        cases comp_range_disjoint_k (base := pack.bodySrc.locals.length) hne hr' with
        | inl hlt => exact hRest.2.2.1 _ hlt
        | inr hge => exact hRest.2.2.2.1 _ hge
      · intro r hr
        have hGe := comp_range_le_scr (base := pack.bodySrc.locals.length) (r := r) hk
        rw [hRest.2.2.2.1 _ hGe]
        exact hLM.2.2.2 r hr
      · dsimp [SliceCompRel]
        have h0 := hRest.2.2.2.2 0 (by decide) _ (getElem?_bodyTgt_locals_comp pack hk (r := 0) (by decide))
        rw [Nat.add_zero] at h0
        have h1 := hRest.2.2.2.2 1 (by decide) _ (getElem?_bodyTgt_locals_comp pack hk (r := 1) (by decide))
        have h2 := hRest.2.2.2.2 2 (by decide) _ (getElem?_bodyTgt_locals_comp pack hk (r := 2) (by decide))
        have h3 := hRest.2.2.2.2 3 (by decide) _ (getElem?_bodyTgt_locals_comp pack hk (r := 3) (by decide))
        exact ⟨⟨some .unit, h0⟩, h1, ⟨none, h2⟩, ⟨none, h3⟩⟩
    have hS1 := evalStepArrSlice_at_stmt pSrc pack.bodySrc bbSrc f₁ cm _ hBodySrc hBbSrc hStmtSrc
    dsimp [FwdStmtSim]
    rw [hS1, evalArrSliceStmt_storageLive, hSrcDecl]
    dsimp
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      change (match setElem? f₁.locals id (.liveSlice none) with | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported) = .step s₁' at hStep
      rw [hSet₁] at hStep
      injection hStep with hsEq
      rw [← hsEq]
      have hLen4' : (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
          (.baseStmt (.storageLive id))).length = 4 := by
        rw [hGen]; exact hLen4
      have hReach' : ReachesNArrSlice pTgt (3 + 1) { frames := [f₂], callerMem := cm }
          { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
              pack.bodySrc.locals.length (.baseStmt (.storageLive id))).length, locals := slots₂' }], callerMem := cm } := by
        rw [hLen4']; exact hRest.1
      exact reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLen₂ hReach' hLM'
    · intro out hDone
      change (match setElem? f₁.locals id (.liveSlice none) with | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported) = .done out at hDone
      rw [hSet₁] at hDone
      cases hDone
    · intro kFault hFault
      change (match setElem? f₁.locals id (.liveSlice none) with | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported) = .fault kFault at hFault
      rw [hSet₁] at hFault
      cases hFault

private theorem sim_stmt_storageDead
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory} {id : LocalId}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.storageDead id)))
    (hIdLt : id < pack.bodySrc.locals.length)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.storageDead id))).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.baseStmt (.storageDead id))) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.storageDead id))).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  cases hFind : findSliceEntry plan.entries id with
  | none =>
    have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.storageDead id)) = [.baseStmt (.storageDead id)] := by
      dsimp [lowerStmtForSlices]
      rw [hFind]
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.baseStmt (.storageDead id)) := by
      have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl)
      rw [Nat.add_zero, hGen] at h0
      exact h0
    apply sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLen₂ hLM
    cases hZero : Nat.beq id 0 with
    | true =>
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep; rw [evalArrSliceStmt_storageDead, hZero] at hStep; cases hStep
      · intro out hDone; rw [evalArrSliceStmt_storageDead, hZero] at hDone; cases hDone
      · intro k hFault
        rw [evalArrSliceStmt_storageDead, hZero] at hFault
        rw [evalArrSliceStmt_storageDead, hZero]
        exact hFault
    | false =>
      have hExD := getElem?_lt_some pack.bodySrc.locals id hIdLt
      cases hExD with | intro d hD =>
      have hDTgt := getElem?_bodyTgt_nonSlice pack hIdLt hFind
      rw [hD] at hDTgt
      have hLt1 : id < f₁.locals.length := by rw [hLM.1.1]; exact hIdLt
      have hEx1 := lt_setElem?_some f₁.locals id (deadArrSliceSlot d) hLt1
      cases hEx1 with | intro slots₁' hSet₁ =>
      have hLt2 : id < f₂.locals.length := by
        rw [hLM.2.1, bodyTgt_locals_length pack]
        exact Nat.lt_of_lt_of_le hIdLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
      have hEx2 := lt_setElem?_some f₂.locals id (deadArrSliceSlot d) hLt2
      cases hEx2 with | intro slots₂' hSet₂ =>
      have hPM := prefixSlotsMatch_set_base hLM.1 hIdLt (deadArrSliceSlot d) hSet₁ hSet₂
      have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
          Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc := by
        intro sLoc k optArr hF
        have hNe : id ≠ sLoc := by
          intro hEq; rw [hEq, hF] at hFind; cases hFind
        exact getElem?_setElem?_ne f₁.locals id sLoc _ slots₁' hNe hSet₁
      have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hPM.1 hPM.2.1 hSl₁Pres hPM.2.2
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep
        rw [evalArrSliceStmt_storageDead, hZero] at hStep
        dsimp at hStep
        rw [hD] at hStep
        dsimp at hStep
        rw [hSet₁] at hStep
        injection hStep with hsEq
        refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
        rw [evalArrSliceStmt_storageDead, hZero]
        dsimp
        rw [hDTgt]
        dsimp
        rw [hSet₂]
      · intro out hDone
        rw [evalArrSliceStmt_storageDead, hZero] at hDone
        dsimp at hDone
        rw [hD] at hDone
        dsimp at hDone
        rw [hSet₁] at hDone
        cases hDone
      · intro k hFault
        rw [evalArrSliceStmt_storageDead, hZero] at hFault
        dsimp at hFault
        rw [hD] at hFault
        dsimp at hFault
        rw [hSet₁] at hFault
        cases hFault
  | some p =>
    cases p with | mk k optArr =>
    have hValid := findSliceEntry_some_lt_and_valid pack.hLoop hFind
    have hk := hValid.1
    cases hValid.2 with | intro e hE =>
    have hArgLtId : pack.bodySrc.argumentCount < id := by rw [← hE.2.1]; exact hE.2.2.2.2.1
    have hIdPos : 0 < id := Nat.lt_of_le_of_lt (Nat.zero_le _) hArgLtId
    have hNotZeroId : Nat.beq id 0 = false := nat_beq_false (Nat.ne_of_gt hIdPos)
    cases hE.2.2.2.2.2 with | intro sTy hs =>
    have hSrcDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals id = some (.sliceView sTy) := by
      rw [← hE.2.1]; exact hs.1
    have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.storageDead id)) = mkStorageDeadRange (pack.bodySrc.locals.length + 4 * k) 4 := by
      dsimp [lowerStmtForSlices]
      rw [hFind]
    have hLen4 : (mkStorageDeadRange (pack.bodySrc.locals.length + 4 * k) 4).length = 4 := rfl
    have hLt1 : id < f₁.locals.length := by rw [hLM.1.1]; exact hIdLt
    have hEx1 := lt_setElem?_some f₁.locals id .sliceDead hLt1
    cases hEx1 with | intro slots₁' hSet₁ =>
    have hStmts : ∀ j, j < 4 →
        Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
          some (.baseStmt (.storageDead (pack.bodySrc.locals.length + 4 * k + j))) := by
      intro j hj
      have hG := hGetGen j (by rw [hGen, hLen4]; exact hj)
      rw [hGen] at hG
      cases j with
      | zero => exact hG
      | succ j1 =>
        cases j1 with
        | zero => exact hG
        | succ j2 =>
          cases j2 with
          | zero => exact hG
          | succ j3 =>
            cases j3 with
            | zero => exact hG
            | succ _ =>
              exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hj)))))
    have hDecls : ∀ j, j < 4 →
        ∃ ty, Trusted.MirSemantics.getElem? pack.bodyTgt.locals (pack.bodySrc.locals.length + 4 * k + j) = some (.base ty) := by
      intro j hj
      have hD := getElem?_bodyTgt_locals_comp pack hk hj
      cases j with
      | zero => exact ⟨.unit, hD⟩
      | succ j1 =>
        cases j1 with
        | zero => exact ⟨usizeTy, hD⟩
        | succ j2 =>
          cases j2 with
          | zero => exact ⟨usizeTy, hD⟩
          | succ _ => exact ⟨usizeTy, hD⟩
    have hBounds : ∀ j, j < 4 → pack.bodySrc.locals.length + 4 * k + j < f₂.locals.length := by
      intro j hj
      rw [hLM.2.1, bodyTgt_locals_length pack]
      have hk4 : 4 * (k + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hk
      rw [Nat.mul_succ] at hk4
      have hkr : 4 * k + j < 4 * plan.entries.length :=
        Nat.lt_of_lt_of_le (Nat.add_lt_add_left hj (4 * k)) hk4
      rw [Nat.add_assoc pack.bodySrc.locals.length (4 * k) j]
      exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hkr _) (Nat.le_add_right _ _)
    have hPosOff : 0 < pack.bodySrc.locals.length + 4 * k :=
      Nat.lt_of_le_of_lt (Nat.zero_le _) (Nat.lt_of_lt_of_le pack.hArgLt (Nat.le_add_right _ _))
    have hExec := exec_mkStorageDeadRange_aux pTgt pack.bodyTgt bbTgt f₂.defId f₂.blockIdx
      f₂.stmtIdx (pack.bodySrc.locals.length + 4 * k) 4 cm f₂.locals hPosOff hBodyTgt hBbTgt hStmts hDecls hBounds
    cases hExec with | intro slots₂' hRest =>
    have hLM' : SliceLocalMatch pack slots₁' slots₂' := by
      apply sliceLocalMatch_set_comp pack hLM hFind hSet₁ hRest.2.1
      · intro j hj _
        exact hRest.2.2.1 j (Nat.lt_of_lt_of_le hj (Nat.le_add_right _ _))
      · intro k' r' hne hr'
        cases comp_range_disjoint_k (base := pack.bodySrc.locals.length) hne hr' with
        | inl hlt => exact hRest.2.2.1 _ hlt
        | inr hge => exact hRest.2.2.2.1 _ hge
      · intro r hr
        have hGe := comp_range_le_scr (base := pack.bodySrc.locals.length) (r := r) hk
        rw [hRest.2.2.2.1 _ hGe]
        exact hLM.2.2.2 r hr
      · dsimp [SliceCompRel]
        have h0 := hRest.2.2.2.2 0 (by decide); rw [Nat.add_zero] at h0
        have h1 := hRest.2.2.2.2 1 (by decide)
        have h2 := hRest.2.2.2.2 2 (by decide)
        have h3 := hRest.2.2.2.2 3 (by decide)
        exact ⟨h0, h1, h2, h3⟩
    have hS1 := evalStepArrSlice_at_stmt pSrc pack.bodySrc bbSrc f₁ cm _ hBodySrc hBbSrc hStmtSrc
    dsimp [FwdStmtSim]
    rw [hS1, evalArrSliceStmt_storageDead, hNotZeroId]
    dsimp
    rw [hSrcDecl]
    dsimp
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      change (match setElem? f₁.locals id .sliceDead with | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported) = .step s₁' at hStep
      rw [hSet₁] at hStep
      injection hStep with hsEq
      rw [← hsEq]
      have hLen4' : (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
          (.baseStmt (.storageDead id))).length = 4 := by
        rw [hGen]; exact hLen4
      have hReach' : ReachesNArrSlice pTgt (3 + 1) { frames := [f₂], callerMem := cm }
          { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
              pack.bodySrc.locals.length (.baseStmt (.storageDead id))).length, locals := slots₂' }], callerMem := cm } := by
        rw [hLen4']; exact hRest.1
      exact reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLen₂ hReach' hLM'
    · intro out hDone
      change (match setElem? f₁.locals id .sliceDead with | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported) = .done out at hDone
      rw [hSet₁] at hDone; cases hDone
    · intro kFault hFault
      change (match setElem? f₁.locals id .sliceDead with | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported) = .fault kFault at hFault
      rw [hSet₁] at hFault; cases hFault

private theorem sim_stmt_assign
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {dst : Place} {rval : Rvalue}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.assign dst rval)))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.baseStmt (.assign dst rval)) = true)
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.baseStmt (.assign dst rval)) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.assign dst rval))).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.baseStmt (.assign dst rval))) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.baseStmt (.assign dst rval))).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
      (.baseStmt (.assign dst rval)) = [.baseStmt (.assign dst rval)] := rfl
  have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (.baseStmt (.assign dst rval)) := by
    have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl)
    rw [Nat.add_zero, hGen] at h0; exact h0
  apply sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLen₂ hLM
  have evalEq : ∀ body frame, evalArrSliceStmt body frame cm (.baseStmt (.assign dst rval)) =
      if (!dst.projection.isEmpty) = true then StepResult.fault FaultKind.unsupported
      else match Trusted.MirSemantics.getElem? body.locals dst.localId with
        | some (.base dstTy) =>
          match evalArrSliceBaseRvalue body.locals frame.locals dstTy rval with
          | Except.error k => StepResult.fault k
          | Except.ok (val, slotsAfterRval) =>
            match writeArrSliceBasePlace slotsAfterRval dst.localId dstTy val with
            | Except.error k => StepResult.fault k
            | Except.ok slots' => stepStmtNext frame cm slots'
        | _ => StepResult.fault FaultKind.unsupported := fun _ _ => rfl
  cases hEmpty : (!dst.projection.isEmpty) with
  | true =>
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep; rw [evalEq, hEmpty] at hStep; cases hStep
    · intro out hDone; rw [evalEq, hEmpty] at hDone; cases hDone
    · intro k hFault
      rw [evalEq, hEmpty] at hFault; rw [evalEq, hEmpty]; exact hFault
  | false =>
    change (if (!dst.projection.isEmpty) = true then true else _) = true at hChk
    rw [hEmpty] at hChk
    dsimp at hChk
    change (Nat.blt dst.localId pack.bodySrc.locals.length && _) = true at hBnd
    have hDstLt : dst.localId < pack.bodySrc.locals.length :=
      nat_blt_lt ((bool_and_eq_true _ _).mp hBnd).1
    cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst.localId with
    | none =>
      exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hD) hDstLt)
    | some decl =>
      cases decl with
      | sliceView sTy =>
        rw [hD] at hChk
        cases hChk
      | array aTy len =>
        have hNS := bodyTgt_decl_nonSlice_lt pack hDstLt (fun sTy h => by rw [hD] at h; cases h)
        have hDTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst.localId = some (.array aTy len) := by
          rw [hNS.2, hD]
        refine ⟨?_, ?_, ?_⟩
        · intro s₁' hStep; rw [evalEq, hEmpty] at hStep; dsimp at hStep; rw [hD] at hStep; cases hStep
        · intro out hDone; rw [evalEq, hEmpty] at hDone; dsimp at hDone; rw [hD] at hDone; cases hDone
        · intro k hFault
          rw [evalEq, hEmpty] at hFault; dsimp at hFault; rw [hD] at hFault
          rw [evalEq, hEmpty]; dsimp; rw [hDTgt]
          exact hFault
      | base dstTy =>
        rw [hD] at hChk
        have hNS := bodyTgt_decl_nonSlice_lt pack hDstLt (fun sTy h => by rw [hD] at h; cases h)
        have hDTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst.localId = some (.base dstTy) := by
          rw [hNS.2, hD]
        have hLen₂' : pack.bodySrc.locals.length ≤ f₂.locals.length := by
          rw [hLM.2.1, bodyTgt_locals_length pack]
          exact Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
        have hRv := evalArrSliceBaseRvalue_prefix pack hLM.1 hLen₂' dstTy hChk
        cases hR1 : evalArrSliceBaseRvalue pack.bodySrc.locals f₁.locals dstTy rval with
        | error err =>
          have hR2 := hRv.1 err hR1
          refine ⟨?_, ?_, ?_⟩
          · intro s₁' hStep
            rw [evalEq, hEmpty] at hStep; dsimp at hStep; rw [hD] at hStep; dsimp at hStep; rw [hR1] at hStep; cases hStep
          · intro out hDone
            rw [evalEq, hEmpty] at hDone; dsimp at hDone; rw [hD] at hDone; dsimp at hDone; rw [hR1] at hDone; cases hDone
          · intro k hFault
            rw [evalEq, hEmpty] at hFault; dsimp at hFault; rw [hD] at hFault; dsimp at hFault; rw [hR1] at hFault
            rw [evalEq, hEmpty]; dsimp; rw [hDTgt]; dsimp; rw [hR2]
            exact hFault
        | ok p =>
          cases p with | mk val slots₁Mid =>
          have hOk2 := hRv.2 val slots₁Mid hR1
          cases hOk2 with | intro slots₂Mid hS2Mid =>
          have hWr := writeArrSliceBasePlace_prefix hS2Mid.2.1 hDstLt hNS.1 dstTy val
          cases hW1 : writeArrSliceBasePlace slots₁Mid dst.localId dstTy val with
          | error err =>
            have hW2 := hWr.1 err hW1
            refine ⟨?_, ?_, ?_⟩
            · intro s₁' hStep
              rw [evalEq, hEmpty] at hStep; dsimp at hStep; rw [hD] at hStep; dsimp at hStep; rw [hR1] at hStep; dsimp at hStep; rw [hW1] at hStep; cases hStep
            · intro out hDone
              rw [evalEq, hEmpty] at hDone; dsimp at hDone; rw [hD] at hDone; dsimp at hDone; rw [hR1] at hDone; dsimp at hDone; rw [hW1] at hDone; cases hDone
            · intro k hFault
              rw [evalEq, hEmpty] at hFault; dsimp at hFault; rw [hD] at hFault; dsimp at hFault; rw [hR1] at hFault; dsimp at hFault; rw [hW1] at hFault
              rw [evalEq, hEmpty]; dsimp; rw [hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hW2]
              exact hFault
          | ok slots₁' =>
            have hW2Ex := hWr.2 slots₁' hW1
            cases hW2Ex with | intro slots₂' hS2' =>
            have hPresRv := evalArrSliceBaseRvalue_preserves_nonBase pack.bodySrc.locals f₁.locals dstTy rval val slots₁Mid hR1
            have hPresWr := s3c_writeArrSliceBasePlace_preserves_ne slots₁Mid dst.localId dstTy val slots₁' hW1
            have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
                Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc := by
              intro sLoc k optArr hF
              have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
              cases hV.2 with | intro e hE =>
              cases hE.2.2.2.2.2 with | intro sTy hs =>
              have hSLocDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                rw [← hE.2.1]; exact hs.1
              have hNeDst : sLoc ≠ dst.localId := by
                intro hEq; rw [hEq, hD] at hSLocDecl; cases hSLocDecl
              rw [hPresWr.2 sLoc hNeDst]
              exact hPresRv.2 sLoc (fun bTy hB => by rw [hSLocDecl] at hB; cases hB)
            have hExt₂ : ∀ j, pack.bodySrc.locals.length ≤ j →
                Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? f₂.locals j := by
              intro j hj
              rw [hS2'.2.2.2 j hj, hS2Mid.2.2.2 j hj]
            have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hS2'.2.1 (by rw [hS2'.2.2.1, hS2Mid.2.2.1]) hSl₁Pres hExt₂
            refine ⟨?_, ?_, ?_⟩
            · intro s₁' hStep
              rw [evalEq, hEmpty] at hStep; dsimp at hStep; rw [hD] at hStep; dsimp at hStep; rw [hR1] at hStep; dsimp at hStep; rw [hW1] at hStep
              injection hStep with hsEq
              refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
              rw [evalEq, hEmpty]; dsimp; rw [hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hS2'.1]
            · intro out hDone
              rw [evalEq, hEmpty] at hDone; dsimp at hDone; rw [hD] at hDone; dsimp at hDone; rw [hR1] at hDone; dsimp at hDone; rw [hW1] at hDone; cases hDone
            · intro k hFault
              rw [evalEq, hEmpty] at hFault; dsimp at hFault; rw [hD] at hFault; dsimp at hFault; rw [hR1] at hFault; dsimp at hFault; rw [hW1] at hFault; cases hFault

private theorem sim_stmt_aggregateArray
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {arrLocal : LocalId} {ops : List Operand}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.aggregateArray arrLocal ops))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.aggregateArray arrLocal ops) = true)
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.aggregateArray arrLocal ops) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.aggregateArray arrLocal ops)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.aggregateArray arrLocal ops)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.aggregateArray arrLocal ops)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
      (.aggregateArray arrLocal ops) = [.aggregateArray arrLocal ops] := rfl
  have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (.aggregateArray arrLocal ops) := by
    have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl)
    rw [Nat.add_zero, hGen] at h0; exact h0
  apply sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLen₂ hLM
  have evalEq : ∀ body frame, evalArrSliceStmt body frame cm (.aggregateArray arrLocal ops) =
      match Trusted.MirSemantics.getElem? body.locals arrLocal with
      | some (.array elemTy len) =>
        if (!ops.length.beq len) = true then .fault .unsupported
        else match evalArrSliceTypedOps body.locals elemTy frame.locals ops with
          | .error k => .fault k
          | .ok (vals, slotsAfterOps) =>
            match Trusted.MirSemantics.getElem? slotsAfterOps arrLocal with
            | some .arrDead => .fault .undefined
            | some (.liveArray _) =>
              match setElem? slotsAfterOps arrLocal (.liveArray (vals.map some)) with
              | some slots' => stepStmtNext frame cm slots'
              | none => .fault .unsupported
            | _ => .fault .unsupported
      | _ => .fault .unsupported := fun _ _ => rfl
  change (Nat.blt arrLocal pack.bodySrc.locals.length && _) = true at hBnd
  have hArrLt : arrLocal < pack.bodySrc.locals.length := nat_blt_lt ((bool_and_eq_true _ _).mp hBnd).1
  cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
  | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hD) hArrLt)
  | some decl =>
    cases decl with
    | base _ =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hD] at h; cases h)
      refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; cases h),
        fun out h => (by rw [evalEq, hD] at h; cases h),
        fun k h => by rw [evalEq, hD] at h; rw [evalEq, hNS.2, hD]; exact h⟩
    | sliceView _ =>
      have hTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.base .unit) := by
        rw [getElem?_bodyTgt_locals_lt pack hArrLt, getElem?_tombstoneSliceDecls, hD]; rfl
      refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; cases h),
        fun out h => (by rw [evalEq, hD] at h; cases h),
        fun k h => by rw [evalEq, hD] at h; rw [evalEq, hTgt]; exact h⟩
    | array elemTy len =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hD] at h; cases h)
      have hDTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.array elemTy len) := by
        rw [hNS.2, hD]
      cases hLenEq : (!ops.length.beq len) with
      | true =>
        refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq] at h; cases h),
          fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq] at h; cases h),
          fun k h => by
            rw [evalEq, hD] at h; dsimp at h; rw [hLenEq] at h
            rw [evalEq, hDTgt]; dsimp; rw [hLenEq]; exact h⟩
      | false =>
        have hLen₂' : pack.bodySrc.locals.length ≤ f₂.locals.length := by
          rw [hLM.2.1, bodyTgt_locals_length pack]
          exact Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
        change ops.all (operandUsesOnlyBase pack.bodySrc.locals) = true at hChk
        have hOps := evalArrSliceTypedOps_prefix pack elemTy ops hChk hLM.1 hLen₂'
        cases hT1 : evalArrSliceTypedOps pack.bodySrc.locals elemTy f₁.locals ops with
        | error err =>
          have hT2 := hOps.1 err hT1
          refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; cases h),
            fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; cases h),
            fun k h => by
              rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h
              rw [evalEq, hDTgt]; dsimp; rw [hLenEq, hT2]; exact h⟩
        | ok p =>
          cases p with | mk vals slots₁Mid =>
          have hOk2 := hOps.2 vals slots₁Mid hT1
          cases hOk2 with | intro slots₂Mid hS2Mid =>
          have hSlotEq : Trusted.MirSemantics.getElem? slots₂Mid arrLocal =
              Trusted.MirSemantics.getElem? slots₁Mid arrLocal := hS2Mid.2.1.2 arrLocal hArrLt hNS.1
          cases hArrSl : Trusted.MirSemantics.getElem? slots₁Mid arrLocal with
          | none =>
            exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hArrSl) (by rw [hS2Mid.2.1.1]; exact hArrLt))
          | some arrSl =>
            cases arrSl with
            | baseSlot _ =>
              refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun k h => by
                  rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h
                  rw [evalEq, hDTgt]; dsimp; rw [hLenEq, hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
            | sliceDead =>
              refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun k h => by
                  rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h
                  rw [evalEq, hDTgt]; dsimp; rw [hLenEq, hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
            | liveSlice _ =>
              refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun k h => by
                  rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h
                  rw [evalEq, hDTgt]; dsimp; rw [hLenEq, hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
            | arrDead =>
              refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun k h => by
                  rw [evalEq, hD] at h; dsimp at h; rw [hLenEq, hT1] at h; dsimp at h; rw [hArrSl] at h
                  rw [evalEq, hDTgt]; dsimp; rw [hLenEq, hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
            | liveArray _ =>
              have hLt1 := getElem?_some_lt slots₁Mid arrLocal _ hArrSl
              have hEx1 := lt_setElem?_some slots₁Mid arrLocal (.liveArray (vals.map some)) hLt1
              cases hEx1 with | intro slots₁' hSet₁ =>
              have hLt2 : arrLocal < slots₂Mid.length :=
                getElem?_some_lt slots₂Mid arrLocal _ (by rw [hSlotEq, hArrSl])
              have hEx2 := lt_setElem?_some slots₂Mid arrLocal (.liveArray (vals.map some)) hLt2
              cases hEx2 with | intro slots₂' hSet₂ =>
              have hPM := prefixSlotsMatch_set_base hS2Mid.2.1 hArrLt (.liveArray (vals.map some)) hSet₁ hSet₂
              have hPresOps := evalArrSliceTypedOps_preserves_nonBase pack.bodySrc.locals elemTy ops f₁.locals vals slots₁Mid hT1
              have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
                  Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc := by
                intro sLoc k optArr hF
                have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
                cases hV.2 with | intro e hE =>
                cases hE.2.2.2.2.2 with | intro sTy hs =>
                have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                  rw [← hE.2.1]; exact hs.1
                have hNe : arrLocal ≠ sLoc := by intro hEq; rw [hEq, hSD] at hD; cases hD
                rw [getElem?_setElem?_ne slots₁Mid arrLocal sLoc _ slots₁' hNe hSet₁]
                exact hPresOps.2 sLoc (fun bTy hB => by rw [hSD] at hB; cases hB)
              have hExt₂ : ∀ j, pack.bodySrc.locals.length ≤ j →
                  Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? f₂.locals j := by
                intro j hj
                rw [hPM.2.2 j hj, hS2Mid.2.2.2 j hj]
              have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hPM.1 (by rw [hPM.2.1, hS2Mid.2.2.1]) hSl₁Pres hExt₂
              refine ⟨?_, ?_, ?_⟩
              · intro s₁' hStep
                rw [evalEq, hD] at hStep; dsimp at hStep; rw [hLenEq, hT1] at hStep; dsimp at hStep; rw [hArrSl] at hStep; dsimp at hStep; rw [hSet₁] at hStep
                injection hStep with hsEq
                refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                rw [evalEq, hDTgt]; dsimp; rw [hLenEq, hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; dsimp; rw [hSet₂]
              · intro out hDone
                rw [evalEq, hD] at hDone; dsimp at hDone; rw [hLenEq, hT1] at hDone; dsimp at hDone; rw [hArrSl] at hDone; dsimp at hDone; rw [hSet₁] at hDone; cases hDone
              · intro k hFault
                rw [evalEq, hD] at hFault; dsimp at hFault; rw [hLenEq, hT1] at hFault; dsimp at hFault; rw [hArrSl] at hFault; dsimp at hFault; rw [hSet₁] at hFault; cases hFault

private theorem sim_stmt_repeatArray
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {arrLocal : LocalId} {op : Operand}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.repeatArray arrLocal op))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.repeatArray arrLocal op) = true)
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.repeatArray arrLocal op) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.repeatArray arrLocal op)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.repeatArray arrLocal op)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.repeatArray arrLocal op)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
      (.repeatArray arrLocal op) = [.repeatArray arrLocal op] := rfl
  have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (.repeatArray arrLocal op) := by
    have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl)
    rw [Nat.add_zero, hGen] at h0; exact h0
  apply sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLen₂ hLM
  have evalEq : ∀ body frame, evalArrSliceStmt body frame cm (.repeatArray arrLocal op) =
      match Trusted.MirSemantics.getElem? body.locals arrLocal with
      | some (.array elemTy len) =>
        match evalArrSliceTypedOperand body.locals frame.locals elemTy op with
        | .error k => .fault k
        | .ok (v, slotsAfterOp) =>
          match Trusted.MirSemantics.getElem? slotsAfterOp arrLocal with
          | some .arrDead => .fault .undefined
          | some (.liveArray _) =>
            match setElem? slotsAfterOp arrLocal (.liveArray (listReplicate len (some v))) with
            | some slots' => stepStmtNext frame cm slots'
            | none => .fault .unsupported
          | _ => .fault .unsupported
      | _ => .fault .unsupported := fun _ _ => rfl
  change (Nat.blt arrLocal pack.bodySrc.locals.length && _) = true at hBnd
  have hArrLt : arrLocal < pack.bodySrc.locals.length := nat_blt_lt ((bool_and_eq_true _ _).mp hBnd).1
  cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
  | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hD) hArrLt)
  | some decl =>
    cases decl with
    | base _ =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hD] at h; cases h)
      refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; cases h),
        fun out h => (by rw [evalEq, hD] at h; cases h),
        fun k h => by rw [evalEq, hD] at h; rw [evalEq, hNS.2, hD]; exact h⟩
    | sliceView _ =>
      have hTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.base .unit) := by
        rw [getElem?_bodyTgt_locals_lt pack hArrLt, getElem?_tombstoneSliceDecls, hD]; rfl
      refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; cases h),
        fun out h => (by rw [evalEq, hD] at h; cases h),
        fun k h => by rw [evalEq, hD] at h; rw [evalEq, hTgt]; exact h⟩
    | array elemTy len =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hD] at h; cases h)
      have hDTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.array elemTy len) := by
        rw [hNS.2, hD]
      have hLen₂' : pack.bodySrc.locals.length ≤ f₂.locals.length := by
        rw [hLM.2.1, bodyTgt_locals_length pack]
        exact Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      change operandUsesOnlyBase pack.bodySrc.locals op = true at hChk
      have hOp := evalArrSliceTypedOperand_prefix pack hLM.1 hLen₂' elemTy hChk
      cases hT1 : evalArrSliceTypedOperand pack.bodySrc.locals f₁.locals elemTy op with
      | error err =>
        have hT2 := hOp.1 err hT1
        refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; cases h),
          fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; cases h),
          fun k h => by
            rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h
            rw [evalEq, hDTgt]; dsimp; rw [hT2]; exact h⟩
      | ok p =>
        cases p with | mk v slots₁Mid =>
        have hOk2 := hOp.2 v slots₁Mid hT1
        cases hOk2 with | intro slots₂Mid hS2Mid =>
        have hSlotEq : Trusted.MirSemantics.getElem? slots₂Mid arrLocal =
            Trusted.MirSemantics.getElem? slots₁Mid arrLocal := hS2Mid.2.1.2 arrLocal hArrLt hNS.1
        cases hArrSl : Trusted.MirSemantics.getElem? slots₁Mid arrLocal with
        | none =>
          exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hArrSl) (by rw [hS2Mid.2.1.1]; exact hArrLt))
        | some arrSl =>
          cases arrSl with
          | baseSlot _ =>
            refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
              fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
              fun k h => by
                rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h
                rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
          | sliceDead =>
            refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
              fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
              fun k h => by
                rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h
                rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
          | liveSlice _ =>
            refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
              fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
              fun k h => by
                rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h
                rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
          | arrDead =>
            refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
              fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
              fun k h => by
                rw [evalEq, hD] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h
                rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
          | liveArray _ =>
            have hLt1 := getElem?_some_lt slots₁Mid arrLocal _ hArrSl
            have hEx1 := lt_setElem?_some slots₁Mid arrLocal (.liveArray (listReplicate len (some v))) hLt1
            cases hEx1 with | intro slots₁' hSet₁ =>
            have hLt2 : arrLocal < slots₂Mid.length :=
              getElem?_some_lt slots₂Mid arrLocal _ (by rw [hSlotEq, hArrSl])
            have hEx2 := lt_setElem?_some slots₂Mid arrLocal (.liveArray (listReplicate len (some v))) hLt2
            cases hEx2 with | intro slots₂' hSet₂ =>
            have hPM := prefixSlotsMatch_set_base hS2Mid.2.1 hArrLt (.liveArray (listReplicate len (some v))) hSet₁ hSet₂
            have hPresOp := evalArrSliceTypedOperand_preserves_nonBase pack.bodySrc.locals f₁.locals elemTy op v slots₁Mid hT1
            have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
                Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc := by
              intro sLoc k optArr hF
              have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
              cases hV.2 with | intro e hE =>
              cases hE.2.2.2.2.2 with | intro sTy hs =>
              have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                rw [← hE.2.1]; exact hs.1
              have hNe : arrLocal ≠ sLoc := by intro hEq; rw [hEq, hSD] at hD; cases hD
              rw [getElem?_setElem?_ne slots₁Mid arrLocal sLoc _ slots₁' hNe hSet₁]
              exact hPresOp.2 sLoc (fun bTy hB => by rw [hSD] at hB; cases hB)
            have hExt₂ : ∀ j, pack.bodySrc.locals.length ≤ j →
                Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? f₂.locals j := by
              intro j hj
              rw [hPM.2.2 j hj, hS2Mid.2.2.2 j hj]
            have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hPM.1 (by rw [hPM.2.1, hS2Mid.2.2.1]) hSl₁Pres hExt₂
            refine ⟨?_, ?_, ?_⟩
            · intro s₁' hStep
              rw [evalEq, hD] at hStep; dsimp at hStep; rw [hT1] at hStep; dsimp at hStep; rw [hArrSl] at hStep; dsimp at hStep; rw [hSet₁] at hStep
              injection hStep with hsEq
              refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
              rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hSlotEq, hArrSl]; dsimp; rw [hSet₂]
            · intro out hDone
              rw [evalEq, hD] at hDone; dsimp at hDone; rw [hT1] at hDone; dsimp at hDone; rw [hArrSl] at hDone; dsimp at hDone; rw [hSet₁] at hDone; cases hDone
            · intro k hFault
              rw [evalEq, hD] at hFault; dsimp at hFault; rw [hT1] at hFault; dsimp at hFault; rw [hArrSl] at hFault; dsimp at hFault; rw [hSet₁] at hFault; cases hFault

private theorem sim_stmt_arrayLivenessCheck
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {arrLocal : LocalId}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.arrayLivenessCheck arrLocal))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.arrayLivenessCheck arrLocal) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.arrayLivenessCheck arrLocal)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.arrayLivenessCheck arrLocal)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.arrayLivenessCheck arrLocal)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
      (.arrayLivenessCheck arrLocal) = [.arrayLivenessCheck arrLocal] := rfl
  have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (.arrayLivenessCheck arrLocal) := by
    have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl)
    rw [Nat.add_zero, hGen] at h0; exact h0
  apply sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLen₂ hLM
  have hArrLt : arrLocal < pack.bodySrc.locals.length := nat_blt_lt hBnd
  cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
  | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hD) hArrLt)
  | some decl =>
    cases decl with
    | base _ =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hD] at h; cases h)
      refine ⟨fun s₁' h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD] at h; cases h),
        fun out h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD] at h; cases h),
        fun k h => by
          rw [evalArrSliceStmt_arrayLivenessCheck, hD] at h
          rw [evalArrSliceStmt_arrayLivenessCheck, hNS.2, hD]; exact h⟩
    | sliceView _ =>
      have hTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.base .unit) := by
        rw [getElem?_bodyTgt_locals_lt pack hArrLt, getElem?_tombstoneSliceDecls, hD]; rfl
      refine ⟨fun s₁' h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD] at h; cases h),
        fun out h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD] at h; cases h),
        fun k h => by
          rw [evalArrSliceStmt_arrayLivenessCheck, hD] at h
          rw [evalArrSliceStmt_arrayLivenessCheck, hTgt]; exact h⟩
    | array elemTy len =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hD] at h; cases h)
      have hDTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.array elemTy len) := by
        rw [hNS.2, hD]
      have hSlotEq : Trusted.MirSemantics.getElem? f₂.locals arrLocal =
          Trusted.MirSemantics.getElem? f₁.locals arrLocal := hLM.1.2 arrLocal hArrLt hNS.1
      cases hSl : Trusted.MirSemantics.getElem? f₁.locals arrLocal with
      | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hSl) (by rw [hLM.1.1]; exact hArrLt))
      | some sl =>
        cases sl with
        | liveArray _ =>
          refine ⟨?_, ?_, ?_⟩
          · intro s₁' hStep
            rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at hStep
            injection hStep with hsEq
            refine ⟨f₁.locals, f₂.locals, hsEq.symm, ?_, hLM⟩
            rw [evalArrSliceStmt_arrayLivenessCheck, hDTgt, hSlotEq, hSl]
          · intro out hDone; rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at hDone; cases hDone
          · intro k hFault; rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at hFault; cases hFault
        | arrDead =>
          refine ⟨fun s₁' h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h; cases h),
            fun out h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h; cases h),
            fun k h => by
              rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h
              rw [evalArrSliceStmt_arrayLivenessCheck, hDTgt, hSlotEq, hSl]; exact h⟩
        | baseSlot _ =>
          refine ⟨fun s₁' h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h; cases h),
            fun out h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h; cases h),
            fun k h => by
              rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h
              rw [evalArrSliceStmt_arrayLivenessCheck, hDTgt, hSlotEq, hSl]; exact h⟩
        | sliceDead =>
          refine ⟨fun s₁' h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h; cases h),
            fun out h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h; cases h),
            fun k h => by
              rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h
              rw [evalArrSliceStmt_arrayLivenessCheck, hDTgt, hSlotEq, hSl]; exact h⟩
        | liveSlice _ =>
          refine ⟨fun s₁' h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h; cases h),
            fun out h => (by rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h; cases h),
            fun k h => by
              rw [evalArrSliceStmt_arrayLivenessCheck, hD, hSl] at h
              rw [evalArrSliceStmt_arrayLivenessCheck, hDTgt, hSlotEq, hSl]; exact h⟩

private theorem sim_stmt_readArrayConst
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {dst arrLocal : LocalId} {idx : Nat} {isMove : Bool}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx =
      some (.readArrayConst dst arrLocal idx isMove))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.readArrayConst dst arrLocal idx isMove) = true)
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.readArrayConst dst arrLocal idx isMove) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.readArrayConst dst arrLocal idx isMove)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.readArrayConst dst arrLocal idx isMove)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.readArrayConst dst arrLocal idx isMove)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
      (.readArrayConst dst arrLocal idx isMove) = [.readArrayConst dst arrLocal idx isMove] := rfl
  have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (.readArrayConst dst arrLocal idx isMove) := by
    have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl)
    rw [Nat.add_zero, hGen] at h0; exact h0
  apply sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLen₂ hLM
  have evalEq : ∀ body frame, evalArrSliceStmt body frame cm (.readArrayConst dst arrLocal idx isMove) =
      match Trusted.MirSemantics.getElem? body.locals dst,
          Trusted.MirSemantics.getElem? body.locals arrLocal,
          Trusted.MirSemantics.getElem? frame.locals arrLocal with
      | some (.base dstTy), some (.array elemTy len), some (.liveArray elems) =>
        if !(MirTy.beq dstTy elemTy) then .fault .unsupported
        else if !Nat.blt idx len then .fault .undefined
        else match Trusted.MirSemantics.getElem? elems idx with
          | some (some v) =>
            let slotsAfterRead? :=
              if isMove then
                match setElem? elems idx (initElemOptVal elemTy) with
                | some elems' => setElem? frame.locals arrLocal (.liveArray elems')
                | none => none
              else some frame.locals
            match slotsAfterRead? with
            | none => .fault .unsupported
            | some slotsAfterRead =>
              match writeArrSliceBasePlace slotsAfterRead dst dstTy v with
              | .error k => .fault k
              | .ok slots' => stepStmtNext frame cm slots'
          | some none => .fault .undefined
          | none => .fault .unsupported
      | some (.base dstTy), some (.array elemTy _), some .arrDead =>
        if MirTy.beq dstTy elemTy then .fault .undefined else .fault .unsupported
      | _, _, _ => .fault .unsupported := fun _ _ => rfl
  have hBndPair := (bool_and_eq_true _ _).mp hBnd
  have hDstLt : dst < pack.bodySrc.locals.length := nat_blt_lt hBndPair.1
  have hArrLt : arrLocal < pack.bodySrc.locals.length := nat_blt_lt hBndPair.2
  have hDstNotSlice : ∀ sTy, Trusted.MirSemantics.getElem? pack.bodySrc.locals dst ≠ some (.sliceView sTy) := by
    intro sTy hS
    change (match Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with | some (.sliceView _) => false | _ => true) = true at hChk
    rw [hS] at hChk
    cases hChk
  have hDstNS := bodyTgt_decl_nonSlice_lt pack hDstLt hDstNotSlice
  cases hDDst : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with
  | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hDDst) hDstLt)
  | some declDst =>
    have hDTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some declDst := by rw [hDstNS.2, hDDst]
    cases declDst with
    | sliceView sTy => exact False.elim (hDstNotSlice sTy hDDst)
    | array _ _ =>
      refine ⟨fun s₁' h => (by rw [evalEq, hDDst] at h; cases h),
        fun out h => (by rw [evalEq, hDDst] at h; cases h),
        fun k h => by rw [evalEq, hDDst] at h; rw [evalEq, hDTgt]; exact h⟩
    | base dstTy =>
      cases hDArr : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
      | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hDArr) hArrLt)
      | some declArr =>
        cases declArr with
        | base _ =>
          have hArrNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hDArr] at h; cases h)
          refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr] at h; cases h),
            fun out h => (by rw [evalEq, hDDst, hDArr] at h; cases h),
            fun k h => by rw [evalEq, hDDst, hDArr] at h; rw [evalEq, hDTgt, hArrNS.2, hDArr]; exact h⟩
        | sliceView _ =>
          have hATgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.base .unit) := by
            rw [getElem?_bodyTgt_locals_lt pack hArrLt, getElem?_tombstoneSliceDecls, hDArr]; rfl
          refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr] at h; cases h),
            fun out h => (by rw [evalEq, hDDst, hDArr] at h; cases h),
            fun k h => by rw [evalEq, hDDst, hDArr] at h; rw [evalEq, hDTgt, hATgt]; exact h⟩
        | array elemTy len =>
          have hArrNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hDArr] at h; cases h)
          have hATgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.array elemTy len) := by
            rw [hArrNS.2, hDArr]
          have hSlotEq : Trusted.MirSemantics.getElem? f₂.locals arrLocal =
              Trusted.MirSemantics.getElem? f₁.locals arrLocal := hLM.1.2 arrLocal hArrLt hArrNS.1
          cases hSl : Trusted.MirSemantics.getElem? f₁.locals arrLocal with
          | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hSl) (by rw [hLM.1.1]; exact hArrLt))
          | some arrSl =>
            cases arrSl with
            | baseSlot _ =>
              refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; cases h),
                fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; cases h),
                fun k h => by rw [evalEq, hDDst, hDArr, hSl] at h; rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; exact h⟩
            | sliceDead =>
              refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; cases h),
                fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; cases h),
                fun k h => by rw [evalEq, hDDst, hDArr, hSl] at h; rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; exact h⟩
            | liveSlice _ =>
              refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; cases h),
                fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; cases h),
                fun k h => by rw [evalEq, hDDst, hDArr, hSl] at h; rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; exact h⟩
            | arrDead =>
              refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; cases hBT : MirTy.beq dstTy elemTy <;> (rw [hBT] at h; cases h)),
                fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; cases hBT : MirTy.beq dstTy elemTy <;> (rw [hBT] at h; cases h)),
                fun k h => by rw [evalEq, hDDst, hDArr, hSl] at h; rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; exact h⟩
            | liveArray elems =>
              cases hTyNe : (!dstTy.beq elemTy) with
              | true =>
                refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun k h => by
                    rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h
                    rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe]; exact h⟩
              | false =>
                cases hIdxLt : (!idx.blt len) with
                | true =>
                  refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; cases h),
                    fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; cases h),
                    fun k h => by
                      rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h
                      rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; exact h⟩
                | false =>
                  cases hElem : Trusted.MirSemantics.getElem? elems idx with
                  | none =>
                    refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h; cases h),
                      fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h; cases h),
                      fun k h => by
                        rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h
                        rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; dsimp; rw [hElem]; exact h⟩
                  | some ov =>
                    cases ov with
                    | none =>
                      refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h; cases h),
                        fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h; cases h),
                        fun k h => by
                          rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h
                          rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; dsimp; rw [hElem]; exact h⟩
                    | some v =>
                      have hAfterRead : ∃ slots₁Mid slots₂Mid,
                          (if isMove then match setElem? elems idx (initElemOptVal elemTy) with
                            | some elems' => setElem? f₁.locals arrLocal (.liveArray elems') | none => none else some f₁.locals) = some slots₁Mid ∧
                          (if isMove then match setElem? elems idx (initElemOptVal elemTy) with
                            | some elems' => setElem? f₂.locals arrLocal (.liveArray elems') | none => none else some f₂.locals) = some slots₂Mid ∧
                          PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁Mid slots₂Mid ∧
                          slots₂Mid.length = f₂.locals.length ∧
                          (∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
                            Trusted.MirSemantics.getElem? slots₁Mid sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc) ∧
                          (∀ j, pack.bodySrc.locals.length ≤ j →
                            Trusted.MirSemantics.getElem? slots₂Mid j = Trusted.MirSemantics.getElem? f₂.locals j) := by
                        cases isMove with
                        | false => exact ⟨f₁.locals, f₂.locals, rfl, rfl, hLM.1, rfl, fun _ _ _ _ => rfl, fun _ _ => rfl⟩
                        | true =>
                          have hElLt := getElem?_some_lt elems idx _ hElem
                          have hExEl := lt_setElem?_some elems idx (initElemOptVal elemTy) hElLt
                          cases hExEl with | intro elems' hSetEl =>
                          have hLtA1 := getElem?_some_lt f₁.locals arrLocal _ hSl
                          have hExA1 := lt_setElem?_some f₁.locals arrLocal (.liveArray elems') hLtA1
                          cases hExA1 with | intro slots₁Mid hSetA1 =>
                          have hLtA2 := getElem?_some_lt f₂.locals arrLocal _ (by rw [hSlotEq, hSl])
                          have hExA2 := lt_setElem?_some f₂.locals arrLocal (.liveArray elems') hLtA2
                          cases hExA2 with | intro slots₂Mid hSetA2 =>
                          have hPM := prefixSlotsMatch_set_base hLM.1 hArrLt (.liveArray elems') hSetA1 hSetA2
                          refine ⟨slots₁Mid, slots₂Mid, ?_, ?_, hPM.1, hPM.2.1, ?_, hPM.2.2⟩
                          · dsimp; rw [hSetEl]; exact hSetA1
                          · dsimp; rw [hSetEl]; exact hSetA2
                          · intro sLoc k optArr hF
                            have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
                            cases hV.2 with | intro e hE =>
                            cases hE.2.2.2.2.2 with | intro sTy hs =>
                            have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                              rw [← hE.2.1]; exact hs.1
                            have hNe : arrLocal ≠ sLoc := by intro hEq; rw [hEq, hSD] at hDArr; cases hDArr
                            exact getElem?_setElem?_ne f₁.locals arrLocal sLoc _ slots₁Mid hNe hSetA1
                      cases hAfterRead with | intro slots₁Mid hAR1 =>
                      cases hAR1 with | intro slots₂Mid hAR2 =>
                      have hWr := writeArrSliceBasePlace_prefix hAR2.2.2.1 hDstLt hDstNS.1 dstTy v
                      cases hW1 : writeArrSliceBasePlace slots₁Mid dst dstTy v with
                      | error err =>
                        have hW2 := hWr.1 err hW1
                        refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h; dsimp at h; rw [hAR2.1] at h; dsimp at h; rw [hW1] at h; cases h),
                          fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h; dsimp at h; rw [hAR2.1] at h; dsimp at h; rw [hW1] at h; cases h),
                          fun k h => by
                            rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hElem] at h; dsimp at h; rw [hAR2.1] at h; dsimp at h; rw [hW1] at h
                            rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; dsimp; rw [hElem]; dsimp; rw [hAR2.2.1]; dsimp; rw [hW2]; exact h⟩
                      | ok slots₁' =>
                        have hW2Ex := hWr.2 slots₁' hW1
                        cases hW2Ex with | intro slots₂' hS2' =>
                        have hPresWr := s3c_writeArrSliceBasePlace_preserves_ne slots₁Mid dst dstTy v slots₁' hW1
                        have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
                            Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc := by
                          intro sLoc k optArr hF
                          have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
                          cases hV.2 with | intro e hE =>
                          cases hE.2.2.2.2.2 with | intro sTy hs =>
                          have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                            rw [← hE.2.1]; exact hs.1
                          have hNe : sLoc ≠ dst := by intro hEq; rw [hEq, hDDst] at hSD; cases hSD
                          rw [hPresWr.2 sLoc hNe]
                          exact hAR2.2.2.2.2.1 sLoc k optArr hF
                        have hExt₂ : ∀ j, pack.bodySrc.locals.length ≤ j →
                            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? f₂.locals j := by
                          intro j hj
                          rw [hS2'.2.2.2 j hj, hAR2.2.2.2.2.2 j hj]
                        have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hS2'.2.1 (by rw [hS2'.2.2.1, hAR2.2.2.2.1]) hSl₁Pres hExt₂
                        refine ⟨?_, ?_, ?_⟩
                        · intro s₁' hStep
                          rw [evalEq, hDDst, hDArr, hSl] at hStep; dsimp at hStep; rw [hTyNe, hIdxLt] at hStep; dsimp at hStep
                          rw [hElem] at hStep; dsimp at hStep; rw [hAR2.1] at hStep; dsimp at hStep; rw [hW1] at hStep
                          injection hStep with hsEq
                          refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                          rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; dsimp
                          rw [hElem]; dsimp; rw [hAR2.2.1]; dsimp; rw [hS2'.1]
                        · intro out hDone
                          rw [evalEq, hDDst, hDArr, hSl] at hDone; dsimp at hDone; rw [hTyNe, hIdxLt] at hDone; dsimp at hDone
                          rw [hElem] at hDone; dsimp at hDone; rw [hAR2.1] at hDone; dsimp at hDone; rw [hW1] at hDone; cases hDone
                        · intro k hFault
                          rw [evalEq, hDDst, hDArr, hSl] at hFault; dsimp at hFault; rw [hTyNe, hIdxLt] at hFault; dsimp at hFault
                          rw [hElem] at hFault; dsimp at hFault; rw [hAR2.1] at hFault; dsimp at hFault; rw [hW1] at hFault; cases hFault

private theorem sim_stmt_writeArrayConst
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {arrLocal : LocalId} {idx : Nat} {rval : Rvalue}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.writeArrayConst arrLocal idx rval))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.writeArrayConst arrLocal idx rval) = true)
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.writeArrayConst arrLocal idx rval) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.writeArrayConst arrLocal idx rval)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.writeArrayConst arrLocal idx rval)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.writeArrayConst arrLocal idx rval)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
      (.writeArrayConst arrLocal idx rval) = [.writeArrayConst arrLocal idx rval] := rfl
  have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (.writeArrayConst arrLocal idx rval) := by
    have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl)
    rw [Nat.add_zero, hGen] at h0; exact h0
  apply sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLen₂ hLM
  have evalEq : ∀ body frame, evalArrSliceStmt body frame cm (.writeArrayConst arrLocal idx rval) =
      match Trusted.MirSemantics.getElem? body.locals arrLocal with
      | some (.array elemTy len) =>
        match evalArrSliceBaseRvalue body.locals frame.locals elemTy rval with
        | .error k => .fault k
        | .ok (v, slotsAfterRval) =>
          if !checkVal v elemTy then .fault .unsupported
          else match Trusted.MirSemantics.getElem? slotsAfterRval arrLocal with
            | some .arrDead => .fault .undefined
            | some (.liveArray elems) =>
              if !Nat.blt idx len then .fault .undefined
              else match setElem? elems idx (some v) with
                | none => .fault .unsupported
                | some elems' =>
                  match setElem? slotsAfterRval arrLocal (.liveArray elems') with
                  | some slots' => stepStmtNext frame cm slots'
                  | none => .fault .unsupported
            | _ => .fault .unsupported
      | _ => .fault .unsupported := fun _ _ => rfl
  change (Nat.blt arrLocal pack.bodySrc.locals.length && _) = true at hBnd
  have hArrLt : arrLocal < pack.bodySrc.locals.length := nat_blt_lt ((bool_and_eq_true _ _).mp hBnd).1
  cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
  | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hD) hArrLt)
  | some decl =>
    cases decl with
    | base _ =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hD] at h; cases h)
      refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; cases h),
        fun out h => (by rw [evalEq, hD] at h; cases h),
        fun k h => by rw [evalEq, hD] at h; rw [evalEq, hNS.2, hD]; exact h⟩
    | sliceView _ =>
      have hTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.base .unit) := by
        rw [getElem?_bodyTgt_locals_lt pack hArrLt, getElem?_tombstoneSliceDecls, hD]; rfl
      refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; cases h),
        fun out h => (by rw [evalEq, hD] at h; cases h),
        fun k h => by rw [evalEq, hD] at h; rw [evalEq, hTgt]; exact h⟩
    | array elemTy len =>
      have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hD] at h; cases h)
      have hDTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.array elemTy len) := by
        rw [hNS.2, hD]
      have hLen₂' : pack.bodySrc.locals.length ≤ f₂.locals.length := by
        rw [hLM.2.1, bodyTgt_locals_length pack]
        exact Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      change rvalueUsesOnlyBase pack.bodySrc.locals rval = true at hChk
      have hRv := evalArrSliceBaseRvalue_prefix pack hLM.1 hLen₂' elemTy hChk
      cases hR1 : evalArrSliceBaseRvalue pack.bodySrc.locals f₁.locals elemTy rval with
      | error err =>
        have hR2 := hRv.1 err hR1
        refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; cases h),
          fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; cases h),
          fun k h => by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; rw [evalEq, hDTgt]; dsimp; rw [hR2]; exact h⟩
      | ok p =>
        cases p with | mk v slots₁Mid =>
        have hOk2 := hRv.2 v slots₁Mid hR1
        cases hOk2 with | intro slots₂Mid hS2Mid =>
        cases hVChk : (!checkVal v elemTy) with
        | true =>
          refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; cases h),
            fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; cases h),
            fun k h => by
              rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h
              rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hVChk]; exact h⟩
        | false =>
          have hSlotEq : Trusted.MirSemantics.getElem? slots₂Mid arrLocal =
              Trusted.MirSemantics.getElem? slots₁Mid arrLocal := hS2Mid.2.1.2 arrLocal hArrLt hNS.1
          cases hArrSl : Trusted.MirSemantics.getElem? slots₁Mid arrLocal with
          | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hArrSl) (by rw [hS2Mid.2.1.1]; exact hArrLt))
          | some arrSl =>
            cases arrSl with
            | baseSlot _ =>
              refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun k h => by
                  rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h
                  rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hVChk]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
            | sliceDead =>
              refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun k h => by
                  rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h
                  rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hVChk]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
            | liveSlice _ =>
              refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun k h => by
                  rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h
                  rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hVChk]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
            | arrDead =>
              refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; cases h),
                fun k h => by
                  rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h
                  rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hVChk]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
            | liveArray elems =>
              cases hIdxLt : (!idx.blt len) with
              | true =>
                refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; cases h),
                  fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; cases h),
                  fun k h => by
                    rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h
                    rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hVChk]; dsimp; rw [hSlotEq, hArrSl]; dsimp; rw [hIdxLt]; exact h⟩
              | false =>
                cases hSetEl : setElem? elems idx (some v) with
                | none =>
                  refine ⟨fun s₁' h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; dsimp at h; rw [hSetEl] at h; cases h),
                    fun out h => (by rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; dsimp at h; rw [hSetEl] at h; cases h),
                    fun k h => by
                      rw [evalEq, hD] at h; dsimp at h; rw [hR1] at h; dsimp at h; rw [hVChk] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; dsimp at h; rw [hSetEl] at h
                      rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hVChk]; dsimp; rw [hSlotEq, hArrSl]; dsimp; rw [hIdxLt]; dsimp; rw [hSetEl]; exact h⟩
                | some elems' =>
                  have hLt1 := getElem?_some_lt slots₁Mid arrLocal _ hArrSl
                  have hEx1 := lt_setElem?_some slots₁Mid arrLocal (.liveArray elems') hLt1
                  cases hEx1 with | intro slots₁' hSet₁ =>
                  have hLt2 := getElem?_some_lt slots₂Mid arrLocal _ (by rw [hSlotEq, hArrSl])
                  have hEx2 := lt_setElem?_some slots₂Mid arrLocal (.liveArray elems') hLt2
                  cases hEx2 with | intro slots₂' hSet₂ =>
                  have hPM := prefixSlotsMatch_set_base hS2Mid.2.1 hArrLt (.liveArray elems') hSet₁ hSet₂
                  have hPresRv := evalArrSliceBaseRvalue_preserves_nonBase pack.bodySrc.locals f₁.locals elemTy rval v slots₁Mid hR1
                  have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
                      Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc := by
                    intro sLoc k optArr hF
                    have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
                    cases hV.2 with | intro e hE =>
                    cases hE.2.2.2.2.2 with | intro sTy hs =>
                    have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                      rw [← hE.2.1]; exact hs.1
                    have hNe : arrLocal ≠ sLoc := by intro hEq; rw [hEq, hSD] at hD; cases hD
                    rw [getElem?_setElem?_ne slots₁Mid arrLocal sLoc _ slots₁' hNe hSet₁]
                    exact hPresRv.2 sLoc (fun bTy hB => by rw [hSD] at hB; cases hB)
                  have hExt₂ : ∀ j, pack.bodySrc.locals.length ≤ j →
                      Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? f₂.locals j := by
                    intro j hj
                    rw [hPM.2.2 j hj, hS2Mid.2.2.2 j hj]
                  have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hPM.1 (by rw [hPM.2.1, hS2Mid.2.2.1]) hSl₁Pres hExt₂
                  refine ⟨?_, ?_, ?_⟩
                  · intro s₁' hStep
                    rw [evalEq, hD] at hStep; dsimp at hStep; rw [hR1] at hStep; dsimp at hStep; rw [hVChk] at hStep; dsimp at hStep; rw [hArrSl] at hStep; dsimp at hStep; rw [hIdxLt] at hStep; dsimp at hStep; rw [hSetEl] at hStep; dsimp at hStep; rw [hSet₁] at hStep
                    injection hStep with hsEq
                    refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                    rw [evalEq, hDTgt]; dsimp; rw [hS2Mid.1]; dsimp; rw [hVChk]; dsimp; rw [hSlotEq, hArrSl]; dsimp; rw [hIdxLt]; dsimp; rw [hSetEl]; dsimp; rw [hSet₂]
                  · intro out hDone
                    rw [evalEq, hD] at hDone; dsimp at hDone; rw [hR1] at hDone; dsimp at hDone; rw [hVChk] at hDone; dsimp at hDone; rw [hArrSl] at hDone; dsimp at hDone; rw [hIdxLt] at hDone; dsimp at hDone; rw [hSetEl] at hDone; dsimp at hDone; rw [hSet₁] at hDone; cases hDone
                  · intro k hFault
                    rw [evalEq, hD] at hFault; dsimp at hFault; rw [hR1] at hFault; dsimp at hFault; rw [hVChk] at hFault; dsimp at hFault; rw [hArrSl] at hFault; dsimp at hFault; rw [hIdxLt] at hFault; dsimp at hFault; rw [hSetEl] at hFault; dsimp at hFault; rw [hSet₁] at hFault; cases hFault

private theorem sliceLocalMatch_set_comp_vals
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂_2 slots₁' slots₂' : List ArrSliceSlot}
    (hLM : SliceLocalMatch pack slots₁ slots₂_2)
    {sLoc k : Nat} {optArr : Option LocalId} {sv : SliceViewVal}
    (hFind : findSliceEntry plan.entries sLoc = some (k, optArr))
    (hSet₁ : setElem? slots₁ sLoc (.liveSlice (some sv)) = some slots₁')
    (hLen₂' : slots₂'.length = slots₂_2.length)
    (hOff0 : ∃ ov, Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * k) =
      some (.baseSlot (.live ov)))
    (hOff1 : Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * k + 1) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false
        (BitVec.ofNat 128 (backingTag sv.backing))))))))
    (hOff2 : Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * k + 2) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false
        (BitVec.ofNat 128 sv.start)))))))
    (hOff3 : Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * k + 3) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false
        (BitVec.ofNat 128 sv.len)))))))
    (hBoundSv : sv.start + sv.len < maxUsize)
    (hBackSv : sv.backing = .dangling ∨ ∃ arrLoc, optArr = some arrLoc ∧ sv.backing = .arrayLocal arrLoc)
    (hPresNonSlice : ∀ j, j < pack.bodySrc.locals.length + 4 * plan.entries.length →
      j ≠ pack.bodySrc.locals.length + 4 * k + 1 →
      j ≠ pack.bodySrc.locals.length + 4 * k + 2 →
      j ≠ pack.bodySrc.locals.length + 4 * k + 3 →
      Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂_2 j)
    (hPresScr : ∀ r, r < 5 →
      ∃ ov, Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length + r) =
        some (.baseSlot (.live ov))) :
    SliceLocalMatch pack slots₁' slots₂' := by
  let off := pack.bodySrc.locals.length + 4 * k
  have hPre' : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' := by
    refine ⟨by rw [setElem?_length slots₁ sLoc _ slots₁' hSet₁]; exact hLM.1.1, ?_⟩
    intro i hi hNone
    have hNe : sLoc ≠ i := by intro hEq; rw [← hEq, hFind] at hNone; cases hNone
    have hiLt : i < pack.bodySrc.locals.length + 4 * plan.entries.length := Nat.lt_of_lt_of_le hi (Nat.le_add_right _ _)
    have hn1 : i ≠ off + 1 := Nat.ne_of_lt (Nat.lt_of_lt_of_le hi (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_succ _)))
    have hn2 : i ≠ off + 2 := Nat.ne_of_lt (Nat.lt_of_lt_of_le hi (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_trans (Nat.le_succ _) (Nat.le_succ _))))
    have hn3 : i ≠ off + 3 := Nat.ne_of_lt (Nat.lt_of_lt_of_le hi (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_trans (Nat.le_succ _) (Nat.le_trans (Nat.le_succ _) (Nat.le_succ _)))))
    rw [hPresNonSlice i hiLt hn1 hn2 hn3, getElem?_setElem?_ne slots₁ sLoc i _ slots₁' hNe hSet₁]
    exact hLM.1.2 i hi hNone
  refine ⟨hPre', by rw [hLen₂', hLM.2.1], ?_, hPresScr⟩
  intro sLoc' k' optArr' hFind'
  cases Nat.decEq sLoc' sLoc with
  | isTrue hEq =>
    rw [hEq] at hFind'
    rw [hFind] at hFind'
    injection hFind' with hP
    injection hP with hkEq hoEq
    rw [← hkEq, ← hoEq, hEq]
    refine ⟨.liveSlice (some sv), getElem?_setElem?_self slots₁ sLoc _ slots₁' hSet₁, ?_⟩
    dsimp [SliceCompRel]
    exact ⟨hBoundSv, hBackSv, hOff0, hOff1, hOff2, hOff3⟩
  | isFalse hNe =>
    have hk'Lt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind').1
    have hkNe : k' ≠ k := by
      intro hkEq; rw [hkEq] at hFind'; exact hNe (findSliceEntry_inj pack.hLoop hFind' hFind).1
    have hOld := hLM.2.2.1 sLoc' k' optArr' hFind'
    cases hOld with | intro sl₁ hSl =>
    refine ⟨sl₁, by rw [getElem?_setElem?_ne slots₁ sLoc sLoc' _ slots₁' (Ne.symm hNe) hSet₁]; exact hSl.1, ?_⟩
    apply sliceCompRel_of_ext_eq hSl.2
    intro r' hr'
    have hkr' : 4 * k' + r' < 4 * plan.entries.length := by
      have hk4 : 4 * (k' + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hk'Lt
      rw [Nat.mul_succ] at hk4
      exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hr' (4 * k')) hk4
    have hLt : pack.bodySrc.locals.length + 4 * k' + r' <
        pack.bodySrc.locals.length + 4 * plan.entries.length := by
      rw [Nat.add_assoc pack.bodySrc.locals.length (4 * k') r']
      exact Nat.add_lt_add_left hkr' _
    have hn1 : pack.bodySrc.locals.length + 4 * k' + r' ≠ off + 1 := by
      intro hEq
      cases comp_range_disjoint_k (base := pack.bodySrc.locals.length) hkNe hr' with
      | inl hlt => rw [hEq] at hlt; exact False.elim (Nat.not_lt_of_ge (Nat.le_succ off) hlt)
      | inr hge => rw [hEq] at hge; exact False.elim (Nat.not_lt_of_ge hge (Nat.add_lt_add_left (by decide : 1 < 4) off))
    have hn2 : pack.bodySrc.locals.length + 4 * k' + r' ≠ off + 2 := by
      intro hEq
      cases comp_range_disjoint_k (base := pack.bodySrc.locals.length) hkNe hr' with
      | inl hlt => rw [hEq] at hlt; exact False.elim (Nat.not_lt_of_ge (Nat.le_trans (Nat.le_succ _) (Nat.le_succ _)) hlt)
      | inr hge => rw [hEq] at hge; exact False.elim (Nat.not_lt_of_ge hge (Nat.add_lt_add_left (by decide : 2 < 4) off))
    have hn3 : pack.bodySrc.locals.length + 4 * k' + r' ≠ off + 3 := by
      intro hEq
      cases comp_range_disjoint_k (base := pack.bodySrc.locals.length) hkNe hr' with
      | inl hlt => rw [hEq] at hlt; exact False.elim (Nat.not_lt_of_ge (Nat.le_trans (Nat.le_succ _) (Nat.le_trans (Nat.le_succ _) (Nat.le_succ _))) hlt)
      | inr hge => rw [hEq] at hge; exact False.elim (Nat.not_lt_of_ge hge (Nat.lt_succ_self _))
    exact hPresNonSlice _ hLt hn1 hn2 hn3

private theorem sim_stmt_unsizeArrayToSlice
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {sLoc arrLocal : LocalId}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.unsizeArrayToSlice sLoc arrLocal))
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.unsizeArrayToSlice sLoc arrLocal) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.unsizeArrayToSlice sLoc arrLocal)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.unsizeArrayToSlice sLoc arrLocal)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.unsizeArrayToSlice sLoc arrLocal)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  change (match findSliceEntry plan.entries sLoc, Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc,
      Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
    | some (_, some bArr), some (.sliceView sTy), some (.array aTy len) =>
      Nat.beq bArr arrLocal && MirTy.beq sTy aTy && Nat.ble len 64
    | _, _, _ => false) = true at hChk
  cases hFind : findSliceEntry plan.entries sLoc with
  | none => rw [hFind] at hChk; cases hChk
  | some p =>
    cases p with | mk k optArr =>
    rw [hFind] at hChk
    cases optArr with
    | none => cases hChk
    | some bArr =>
      cases hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc with
      | none => rw [hSD] at hChk; cases hChk
      | some dS =>
        rw [hSD] at hChk
        cases dS with
        | base _ => cases hChk
        | array _ _ => cases hChk
        | sliceView sTy =>
          cases hAD : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
          | none => rw [hAD] at hChk; cases hChk
          | some dA =>
            rw [hAD] at hChk
            cases dA with
            | base _ => cases hChk
            | sliceView _ => cases hChk
            | array aTy len =>
              have hC1 := (bool_and_eq_true _ _).mp hChk
              have hC2 := (bool_and_eq_true _ _).mp hC1.1
              have hbArrEq : bArr = arrLocal := nat_beq_eq _ _ hC2.1
              have hTyEq : sTy = aTy := mirTy_beq_eq _ _ hC2.2
              have hLenLe : len ≤ 64 := nat_ble_le hC1.2
              have hLenLtMax : len < maxUsize := by
                rw [maxUsize_eq]
                exact Nat.lt_of_le_of_lt hLenLe (by decide)
              have h0LtMax : 0 < maxUsize := by rw [maxUsize_eq]; decide
              have h1LtMax : 1 < maxUsize := by rw [maxUsize_eq]; decide
              have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
              have hSLocLt : sLoc < pack.bodySrc.locals.length := getElem?_some_lt _ _ _ hSD
              have hArrLt : arrLocal < pack.bodySrc.locals.length := getElem?_some_lt _ _ _ hAD
              have hArrNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy' h => by rw [hAD] at h; cases h)
              have hArrDeclTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal =
                  some (.array aTy len) := by rw [hArrNS.2, hAD]
              let off := pack.bodySrc.locals.length + 4 * k
              have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
                  (.unsizeArrayToSlice sLoc arrLocal) =
                  [ .arrayLivenessCheck arrLocal, mkLivenessCheckStmt off,
                    mkAssignUse (off + 1) (usizeConst 1), mkAssignUse (off + 2) (usizeConst 0),
                    mkAssignUse (off + 3) (usizeConst len) ] := by
                change (match findSliceEntry plan.entries sLoc, Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
                  | some (_, _), some (.array _ _) => _ | _, _ => _) = _
                rw [hFind, hAD]
              have hG0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (.arrayLivenessCheck arrLocal) := by
                have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl); rw [Nat.add_zero, hGen] at h0; exact h0
              have hG1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) = some (mkLivenessCheckStmt off) := by
                have h1 := hGetGen 1 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h1; exact h1
              have hG2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) = some (mkAssignUse (off + 1) (usizeConst 1)) := by
                have h2 := hGetGen 2 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h2; exact h2
              have hG3 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 3) = some (mkAssignUse (off + 2) (usizeConst 0)) := by
                have h3 := hGetGen 3 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h3; exact h3
              have hG4 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 4) = some (mkAssignUse (off + 3) (usizeConst len)) := by
                have h4 := hGetGen 4 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h4; exact h4
              have hS1 : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
                  (match Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc,
                      Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal,
                      Trusted.MirSemantics.getElem? f₁.locals arrLocal,
                      Trusted.MirSemantics.getElem? f₁.locals sLoc with
                    | some (.sliceView sTy'), some (.array aTy' len'), arrSl, sliceSl =>
                      if (!sTy'.beq aTy') = true then .fault .unsupported
                      else match arrSl with
                        | some .arrDead => .fault .undefined
                        | some (.liveArray _) =>
                          match sliceSl with
                          | some .sliceDead => .fault .undefined
                          | some (.liveSlice _) =>
                            match setElem? f₁.locals sLoc (.liveSlice (some { backing := .arrayLocal arrLocal, start := 0, len := len' })) with
                            | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported
                          | _ => .fault .unsupported
                        | _ => .fault .unsupported
                    | _, _, _, _ => .fault .unsupported) :=
                evalStepArrSlice_at_stmt pSrc pack.bodySrc bbSrc f₁ cm _ hBodySrc hBbSrc hStmtSrc
              dsimp [FwdStmtSim]
              rw [hS1]
              have hBeqFalse : (!sTy.beq aTy) = false := by rw [hTyEq, mirTy_beq_refl aTy]; rfl
              have hSlotArrEq : Trusted.MirSemantics.getElem? f₂.locals arrLocal =
                  Trusted.MirSemantics.getElem? f₁.locals arrLocal := hLM.1.2 arrLocal hArrLt hArrNS.1
              have hExSlS := hLM.2.2.1 sLoc k (some bArr) hFind
              cases hExSlS with | intro slS hSlS =>
              cases hArrSl : Trusted.MirSemantics.getElem? f₁.locals arrLocal with
              | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hArrSl) (by rw [hLM.1.1]; exact hArrLt))
              | some arrSl =>
                cases arrSl with
                | baseSlot _ =>
                  have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } = .fault .unsupported := by
                    rw [evalStepArrSlice_at_stmt pTgt pack.bodyTgt bbTgt f₂ cm _ hBodyTgt hBbTgt hG0,
                        evalArrSliceStmt_arrayLivenessCheck, hArrDeclTgt, hSlotArrEq, hArrSl]
                  refine ⟨fun s₁' h => (by rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                    fun out h => (by rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                    fun kFault h => by
                      rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h
                      exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
                        (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hF2]; exact h)⟩⟩
                | sliceDead =>
                  have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } = .fault .unsupported := by
                    rw [evalStepArrSlice_at_stmt pTgt pack.bodyTgt bbTgt f₂ cm _ hBodyTgt hBbTgt hG0,
                        evalArrSliceStmt_arrayLivenessCheck, hArrDeclTgt, hSlotArrEq, hArrSl]
                  refine ⟨fun s₁' h => (by rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                    fun out h => (by rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                    fun kFault h => by
                      rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h
                      exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
                        (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hF2]; exact h)⟩⟩
                | liveSlice _ =>
                  have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } = .fault .unsupported := by
                    rw [evalStepArrSlice_at_stmt pTgt pack.bodyTgt bbTgt f₂ cm _ hBodyTgt hBbTgt hG0,
                        evalArrSliceStmt_arrayLivenessCheck, hArrDeclTgt, hSlotArrEq, hArrSl]
                  refine ⟨fun s₁' h => (by rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                    fun out h => (by rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                    fun kFault h => by
                      rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h
                      exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
                        (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hF2]; exact h)⟩⟩
                | arrDead =>
                  have hF2 := step_arrayLivenessCheck_dead pTgt pack.bodyTgt bbTgt f₂ cm arrLocal aTy len
                    hBodyTgt hBbTgt hG0 hArrDeclTgt (by rw [hSlotArrEq, hArrSl])
                  refine ⟨fun s₁' h => (by rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                    fun out h => (by rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                    fun kFault h => by
                      rw [hSD, hAD] at h; dsimp at h; rw [hBeqFalse] at h
                      exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
                        (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hF2]; exact h)⟩⟩
                | liveArray elems =>
                  have hStep0 := step_arrayLivenessCheck_live pTgt pack.bodyTgt bbTgt f₂ cm arrLocal aTy len elems
                    hBodyTgt hBbTgt hG0 hArrDeclTgt (by rw [hSlotArrEq, hArrSl])
                  have hReach0 : ReachesNArrSlice pTgt 1 { frames := [f₂], callerMem := cm }
                      { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := f₂.locals }], callerMem := cm } :=
                    reachesNArrSlice_one_step hStep0
                  let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := f₂.locals }
                  have hLive := step_mkLivenessCheckStmt_from_rel pack bbTgt f₂_1 cm f₁.locals
                    hBodyTgt hBbTgt hG1 hLM hFind hSlS.1
                  cases hSlS_eq : slS with
                  | baseSlot _ =>
                    have hFalse := hSlS.2; rw [hSlS_eq] at hFalse; cases hFalse
                  | arrDead =>
                    have hFalse := hSlS.2; rw [hSlS_eq] at hFalse; cases hFalse
                  | liveArray _ =>
                    have hFalse := hSlS.2; rw [hSlS_eq] at hFalse; cases hFalse
                  | sliceDead =>
                    have hF1 := hLive.1 hSlS_eq
                    refine ⟨fun s₁' h => (by rw [hSD, hAD, hSlS.1, hSlS_eq] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                      fun out h => (by rw [hSD, hAD, hSlS.1, hSlS_eq] at h; dsimp at h; rw [hBeqFalse] at h; cases h),
                      fun kFault h => by
                        rw [hSD, hAD, hSlS.1, hSlS_eq] at h; dsimp at h; rw [hBeqFalse] at h
                        injection h with hkEq; rw [← hkEq]
                        exact reachesArrSlice_of_reach_fault hReach0 hF1⟩
                  | liveSlice optSv =>
                    let sv : SliceViewVal := { backing := .arrayLocal arrLocal, start := 0, len := len }
                    have hEx1 := lt_setElem?_some f₁.locals sLoc (.liveSlice (some sv)) (by rw [hLM.1.1]; exact hSLocLt)
                    cases hEx1 with | intro slots₁' hSet₁ =>
                    have hStep1Ex := hLive.2 optSv hSlS_eq
                    cases hStep1Ex with | intro slots₂_2 hS2Pair =>
                    have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS2Pair.1)
                    let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
                    have hExSl2 := hS2Pair.2.2.2.1 sLoc k (some bArr) hFind
                    cases hExSl2 with | intro slS2 hSlS2 =>
                    have hEqSl2 : slS2 = .liveSlice optSv := by
                      have hS : some slS2 = some (.liveSlice optSv) := by rw [← hSlS2.1, hSlS.1, hSlS_eq]
                      injection hS
                    rw [hEqSl2] at hSlS2
                    have hFields := sliceCompRel_live_fields hSlS2.2
                    have hOv1 := hFields.1; cases hOv1 with | intro ov1 hOv1 =>
                    have hDecl1 := getElem?_bodyTgt_locals_comp pack hkLt (r := 1) (by decide)
                    have hStep2Ex := step_mkAssignUse_const_usize pTgt pack.bodyTgt bbTgt f₂_2 cm (off + 1) 1 ov1 h1LtMax
                      hBodyTgt hBbTgt hG2 hDecl1 hOv1
                    cases hStep2Ex with | intro slots₂_3 hS3 =>
                    have hReach2 := reachesNArrSlice_trans hReach1 (reachesNArrSlice_one_step hS3.2)
                    let f₂_3 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂_3 }
                    have hOv2 := hFields.2.1; cases hOv2 with | intro ov2 hOv2 =>
                    have hOv2' : Trusted.MirSemantics.getElem? slots₂_3 (off + 2) = some (.baseSlot (.live ov2)) := by
                      rw [getElem?_setElem?_ne slots₂_2 (off + 1) (off + 2) _ slots₂_3
                        (fun h => by cases Nat.add_left_cancel h) hS3.1]; exact hOv2
                    have hDecl2 := getElem?_bodyTgt_locals_comp pack hkLt (r := 2) (by decide)
                    have hStep3Ex := step_mkAssignUse_const_usize pTgt pack.bodyTgt bbTgt f₂_3 cm (off + 2) 0 ov2 h0LtMax
                      hBodyTgt hBbTgt hG3 hDecl2 hOv2'
                    cases hStep3Ex with | intro slots₂_4 hS4 =>
                    have hReach3 := reachesNArrSlice_trans hReach2 (reachesNArrSlice_one_step hS4.2)
                    let f₂_4 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 4, locals := slots₂_4 }
                    have hOv3 := hFields.2.2; cases hOv3 with | intro ov3 hOv3 =>
                    have hOv3' : Trusted.MirSemantics.getElem? slots₂_4 (off + 3) = some (.baseSlot (.live ov3)) := by
                      rw [getElem?_setElem?_ne slots₂_3 (off + 2) (off + 3) _ slots₂_4
                        (fun h => by cases Nat.add_left_cancel h) hS4.1]
                      rw [getElem?_setElem?_ne slots₂_2 (off + 1) (off + 3) _ slots₂_3
                        (fun h => by cases Nat.add_left_cancel h) hS3.1]
                      exact hOv3
                    have hDecl3 := getElem?_bodyTgt_locals_comp pack hkLt (r := 3) (by decide)
                    have hStep4Ex := step_mkAssignUse_const_usize pTgt pack.bodyTgt bbTgt f₂_4 cm (off + 3) len ov3 hLenLtMax
                      hBodyTgt hBbTgt hG4 hDecl3 hOv3'
                    cases hStep4Ex with | intro slots₂' hS5 =>
                    have hReach4 := reachesNArrSlice_trans hReach3 (reachesNArrSlice_one_step hS5.2)
                    have hLen₂' : slots₂'.length = slots₂_2.length := by
                      rw [setElem?_length _ _ _ _ hS5.1, setElem?_length _ _ _ _ hS4.1, setElem?_length _ _ _ _ hS3.1]
                    have hPresEq : ∀ j, j ≠ off + 1 → j ≠ off + 2 → j ≠ off + 3 →
                        Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂_2 j := by
                      intro j hn1 hn2 hn3
                      rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn3) hS5.1,
                          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn2) hS4.1,
                          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn1) hS3.1]
                    have hOff0_2 : ∃ ov, Trusted.MirSemantics.getElem? slots₂_2 off = some (.baseSlot (.live ov)) := by
                      cases optSv with
                      | none => exact hSlS2.2.1
                      | some _ => exact hSlS2.2.2.2.1
                    have hOff0 : ∃ ov, Trusted.MirSemantics.getElem? slots₂' off = some (.baseSlot (.live ov)) := by
                      cases hOff0_2 with | intro ov hOv =>
                      refine ⟨ov, ?_⟩
                      rw [hPresEq off (Nat.ne_of_lt (Nat.lt_succ_self off))
                        (Nat.ne_of_lt (Nat.lt_add_of_pos_right (by decide : 0 < 2)))
                        (Nat.ne_of_lt (Nat.lt_add_of_pos_right (by decide : 0 < 3)))]
                      exact hOv
                    have hOff1 : Trusted.MirSemantics.getElem? slots₂' (off + 1) =
                        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) := by
                      rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => by cases Nat.add_left_cancel h) hS5.1,
                          getElem?_setElem?_ne _ _ _ _ _ (fun h => by cases Nat.add_left_cancel h) hS4.1,
                          getElem?_setElem?_self slots₂_2 (off + 1) _ slots₂_3 hS3.1]
                      rfl
                    have hOff2 : Trusted.MirSemantics.getElem? slots₂' (off + 2) =
                        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv.start)))))) := by
                      rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => by cases Nat.add_left_cancel h) hS5.1,
                          getElem?_setElem?_self slots₂_3 (off + 2) _ slots₂_4 hS4.1]
                    have hOff3 : Trusted.MirSemantics.getElem? slots₂' (off + 3) =
                        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv.len)))))) :=
                      getElem?_setElem?_self slots₂_4 (off + 3) _ slots₂' hS5.1
                    have hPresScr : ∀ r, r < 5 →
                        ∃ ov, Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length + r) =
                          some (.baseSlot (.live ov)) := by
                      intro r hr
                      have hGe := comp_range_le_scr (base := pack.bodySrc.locals.length) (r := r) hkLt
                      have hn1 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ off + 1 :=
                        Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 1 < 4) off) hGe)
                      have hn2 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ off + 2 :=
                        Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 2 < 4) off) hGe)
                      have hn3 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ off + 3 :=
                        Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) hGe)
                      rw [hPresEq _ hn1 hn2 hn3]
                      exact hS2Pair.2.2.2.2 r hr
                    have hBoundSv : sv.start + sv.len < maxUsize := by rw [Nat.zero_add]; exact hLenLtMax
                    have hBackSv : sv.backing = .dangling ∨ ∃ arrLoc', some bArr = some arrLoc' ∧ sv.backing = .arrayLocal arrLoc' :=
                      Or.inr ⟨bArr, rfl, by rw [hbArrEq]⟩
                    have hLM' := sliceLocalMatch_set_comp_vals pack hS2Pair.2 hFind hSet₁ hLen₂'
                      hOff0 hOff1 hOff2 hOff3 hBoundSv hBackSv (fun j _ hn1 hn2 hn3 => hPresEq j hn1 hn2 hn3) hPresScr
                    refine ⟨?_, ?_, ?_⟩
                    · intro s₁' hStep
                      rw [hSD, hAD, hSlS.1, hSlS_eq] at hStep; dsimp at hStep
                      rw [hBeqFalse] at hStep; dsimp at hStep; rw [hSet₁] at hStep
                      injection hStep with hsEq; rw [← hsEq]
                      have hLen5 : (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
                          (.unsizeArrayToSlice sLoc arrLocal)).length = 5 := by rw [hGen]; rfl
                      have hReach5 : ReachesNArrSlice pTgt (4 + 1) { frames := [f₂], callerMem := cm }
                          { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
                              pack.bodySrc.locals.length (.unsizeArrayToSlice sLoc arrLocal)).length, locals := slots₂' }], callerMem := cm } := by
                        rw [hLen5]; exact hReach4
                      exact reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLen₂ hReach5 hLM'
                    · intro out hDone
                      rw [hSD, hAD, hSlS.1, hSlS_eq] at hDone; dsimp at hDone
                      rw [hBeqFalse] at hDone; dsimp at hDone; rw [hSet₁] at hDone; cases hDone
                    · intro kFault hFault
                      rw [hSD, hAD, hSlS.1, hSlS_eq] at hFault; dsimp at hFault
                      rw [hBeqFalse] at hFault; dsimp at hFault; rw [hSet₁] at hFault; cases hFault

private theorem sim_stmt_sliceFromRawParts
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {sLoc : LocalId} {lenOp : Operand}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.sliceFromRawParts sLoc lenOp))
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.sliceFromRawParts sLoc lenOp) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.sliceFromRawParts sLoc lenOp)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.sliceFromRawParts sLoc lenOp)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.sliceFromRawParts sLoc lenOp)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  change (match findSliceEntry plan.entries sLoc with | some _ => operandUsesOnlyBase pack.bodySrc.locals lenOp | none => false) = true at hChk
  cases hFind : findSliceEntry plan.entries sLoc with
  | none => rw [hFind] at hChk; cases hChk
  | some p =>
    cases p with | mk k optArr =>
    rw [hFind] at hChk
    have hVal := findSliceEntry_some_lt_and_valid pack.hLoop hFind
    have hkLt := hVal.1
    cases hVal.2 with | intro e hE =>
    cases hE.2.2.2.2.2 with | intro sTy hs =>
    have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
      rw [← hE.2.1]; exact hs.1
    have hSLocLt : sLoc < pack.bodySrc.locals.length := getElem?_some_lt _ _ _ hSD
    let scrIdx := pack.bodySrc.locals.length + 4 * plan.entries.length + 3
    let off := pack.bodySrc.locals.length + 4 * k
    have h0LtMax : 0 < maxUsize := by rw [maxUsize_eq]; decide
    have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.sliceFromRawParts sLoc lenOp) =
        [ mkAssignUse scrIdx lenOp, mkLivenessCheckStmt off,
          mkAssignUse (off + 1) (usizeConst 0), mkAssignUse (off + 2) (usizeConst 0),
          mkAssignUse (off + 3) (.move { localId := scrIdx, projection := [] }) ] := by
      dsimp [lowerStmtForSlices]
      rw [hFind]
    have hG0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (mkAssignUse scrIdx lenOp) := by
      have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl); rw [Nat.add_zero, hGen] at h0; exact h0
    have hG1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) = some (mkLivenessCheckStmt off) := by
      have h1 := hGetGen 1 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h1; exact h1
    have hG2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) = some (mkAssignUse (off + 1) (usizeConst 0)) := by
      have h2 := hGetGen 2 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h2; exact h2
    have hG3 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 3) = some (mkAssignUse (off + 2) (usizeConst 0)) := by
      have h3 := hGetGen 3 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h3; exact h3
    have hG4 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 4) =
        some (mkAssignUse (off + 3) (.move { localId := scrIdx, projection := [] })) := by
      have h4 := hGetGen 4 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h4; exact h4
    have hScrGe : pack.bodySrc.locals.length ≤ scrIdx :=
      Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
    have hScrDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrIdx = some (.base usizeTy) :=
      getElem?_bodyTgt_locals_scratch pack (r := 3) (by decide)
    have hScrOv := hLM.2.2.2 3 (by decide)
    cases hScrOv with | intro ovScr hOvScr =>
    have hLen₂' : pack.bodySrc.locals.length ≤ f₂.locals.length := by
      rw [hLM.2.1, bodyTgt_locals_length pack]
      exact Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
    have hStep0 := step_mkAssignUse_usizeOp pack bbTgt f₂ cm f₁.locals scrIdx lenOp ovScr
      hBodyTgt hBbTgt hG0 hLM.1 hLen₂' hChk hScrGe hScrDecl hOvScr
    have hS1 : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
        (match Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc with
          | some (.sliceView _) =>
            match evalUsizeOperand pack.bodySrc.locals f₁.locals lenOp with
            | .error k => .fault k
            | .ok (len, slotsAfterLen) =>
              match Trusted.MirSemantics.getElem? slotsAfterLen sLoc with
              | some .sliceDead => .fault .undefined
              | some (.liveSlice _) =>
                match setElem? slotsAfterLen sLoc (.liveSlice (some { backing := .dangling, start := 0, len := len })) with
                | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported
              | _ => .fault .unsupported
          | _ => .fault .unsupported) :=
      evalStepArrSlice_at_stmt pSrc pack.bodySrc bbSrc f₁ cm _ hBodySrc hBbSrc hStmtSrc
    dsimp [FwdStmtSim]
    rw [hS1]
    cases hU : evalUsizeOperand pack.bodySrc.locals f₁.locals lenOp with
    | error err =>
      have hF0 := hStep0.1 err hU
      refine ⟨fun s₁' h => (by rw [hSD] at h; cases h),
        fun out h => (by rw [hSD] at h; cases h),
        fun kFault h => by
          rw [hSD] at h
          exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
            (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hF0]; exact h)⟩⟩
    | ok pLen =>
      cases pLen with | mk len slots₁Mid =>
      have hOk0 := hStep0.2 len slots₁Mid hU
      have hLenLtMax : len < maxUsize := hOk0.1
      cases hOk0.2 with | intro slots₂_1 hS1Pair =>
      have hReach0 := reachesNArrSlice_one_step hS1Pair.1
      have hPres1 := evalUsizeOperand_preserves_nonBase pack.bodySrc.locals f₁.locals lenOp len slots₁Mid hU
      have hSl₁Pres : ∀ sLoc' k' optArr', findSliceEntry plan.entries sLoc' = some (k', optArr') →
          Trusted.MirSemantics.getElem? slots₁Mid sLoc' = Trusted.MirSemantics.getElem? f₁.locals sLoc' := by
        intro sLoc' k' optArr' hF'
        have hV' := findSliceEntry_some_lt_and_valid pack.hLoop hF'
        cases hV'.2 with | intro e' hE' =>
        cases hE'.2.2.2.2.2 with | intro sTy' hs' =>
        exact hPres1.2 sLoc' (fun bTy hB => by rw [← hE'.2.1] at hB; rw [hs'.1] at hB; cases hB)
      have hLM1 : SliceLocalMatch pack slots₁Mid slots₂_1 := by
        refine ⟨hS1Pair.2.1, by rw [hS1Pair.2.2.1, hLM.2.1], ?_, ?_⟩
        · intro sLoc' k' optArr' hF'
          have hOld := hLM.2.2.1 sLoc' k' optArr' hF'
          cases hOld with | intro sl' hSl' =>
          refine ⟨sl', by rw [hSl₁Pres sLoc' k' optArr' hF']; exact hSl'.1, ?_⟩
          apply sliceCompRel_of_ext_eq hSl'.2
          intro r' hr'
          have hk'Lt := (findSliceEntry_some_lt_and_valid pack.hLoop hF').1
          have hGe : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 4 * k' + r' :=
            Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
          have hNe : pack.bodySrc.locals.length + 4 * k' + r' ≠ scrIdx := by
            have h4 : 4 * k' + r' < 4 * plan.entries.length := by
              have hk4 : 4 * (k' + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hk'Lt
              rw [Nat.mul_succ] at hk4
              exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hr' _) hk4
            apply Nat.ne_of_lt
            rw [Nat.add_assoc pack.bodySrc.locals.length (4 * k') r']
            exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left h4 _) (Nat.le_add_right _ _)
          exact hS1Pair.2.2.2.2 _ hGe hNe
        · intro r hr
          cases Nat.decEq r 3 with
          | isTrue hr3 =>
            rw [hr3]
            exact ⟨_, hS1Pair.2.2.2.1⟩
          | isFalse hrNe =>
            have hGe : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
              Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
            have hNe : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ scrIdx := by
              intro hEq; exact hrNe (Nat.add_left_cancel hEq)
            rw [hS1Pair.2.2.2.2 _ hGe hNe]
            exact hLM.2.2.2 r hr
      let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂_1 }
      have hExSl1 := hLM1.2.2.1 sLoc k optArr hFind
      cases hExSl1 with | intro slS hSlS =>
      have hLive := step_mkLivenessCheckStmt_from_rel pack bbTgt f₂_1 cm slots₁Mid
        hBodyTgt hBbTgt hG1 hLM1 hFind hSlS.1
      cases hSlS_eq : slS with
      | baseSlot _ => have hF := hSlS.2; rw [hSlS_eq] at hF; cases hF
      | arrDead => have hF := hSlS.2; rw [hSlS_eq] at hF; cases hF
      | liveArray _ => have hF := hSlS.2; rw [hSlS_eq] at hF; cases hF
      | sliceDead =>
        have hF1 := hLive.1 hSlS_eq
        refine ⟨fun s₁' h => (by rw [hSD] at h; dsimp at h; rw [hSlS.1, hSlS_eq] at h; cases h),
          fun out h => (by rw [hSD] at h; dsimp at h; rw [hSlS.1, hSlS_eq] at h; cases h),
          fun kFault h => by
            rw [hSD] at h; dsimp at h; rw [hSlS.1, hSlS_eq] at h
            injection h with hkEq; rw [← hkEq]
            exact reachesArrSlice_of_reach_fault hReach0 hF1⟩
      | liveSlice optSv =>
        let sv : SliceViewVal := { backing := .dangling, start := 0, len := len }
        have hExSet1 := lt_setElem?_some slots₁Mid sLoc (.liveSlice (some sv)) (by rw [hLM1.1.1]; exact hSLocLt)
        cases hExSet1 with | intro slots₁' hSet₁ =>
        have hStep1Ex := step_mkLivenessCheckStmt_live_pres pack bbTgt f₂_1 cm slots₁Mid
          hBodyTgt hBbTgt hG1 hLM1 hFind (by rw [hSlS.1, hSlS_eq])
        cases hStep1Ex with | intro slots₂_2 hS2Pair =>
        have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS2Pair.2.1)
        let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
        have hExSl2 := hS2Pair.2.2.2.2.1 sLoc k optArr hFind
        cases hExSl2 with | intro slS2 hSlS2 =>
        have hEqSl2 : slS2 = .liveSlice optSv := by
          have hS : some slS2 = some (.liveSlice optSv) := by rw [← hSlS2.1, hSlS.1, hSlS_eq]
          injection hS
        rw [hEqSl2] at hSlS2
        have hFields := sliceCompRel_live_fields hSlS2.2
        have hOv1 := hFields.1; cases hOv1 with | intro ov1 hOv1 =>
        have hDecl1 := getElem?_bodyTgt_locals_comp pack hkLt (r := 1) (by decide)
        have hStep2Ex := step_mkAssignUse_const_usize pTgt pack.bodyTgt bbTgt f₂_2 cm (off + 1) 0 ov1 h0LtMax
          hBodyTgt hBbTgt hG2 hDecl1 hOv1
        cases hStep2Ex with | intro slots₂_3 hS3 =>
        have hReach2 := reachesNArrSlice_trans hReach1 (reachesNArrSlice_one_step hS3.2)
        let f₂_3 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂_3 }
        have hOv2 := hFields.2.1; cases hOv2 with | intro ov2 hOv2 =>
        have hOv2' : Trusted.MirSemantics.getElem? slots₂_3 (off + 2) = some (.baseSlot (.live ov2)) := by
          rw [getElem?_setElem?_ne slots₂_2 (off + 1) (off + 2) _ slots₂_3
            (fun h => by cases Nat.add_left_cancel h) hS3.1]; exact hOv2
        have hDecl2 := getElem?_bodyTgt_locals_comp pack hkLt (r := 2) (by decide)
        have hStep3Ex := step_mkAssignUse_const_usize pTgt pack.bodyTgt bbTgt f₂_3 cm (off + 2) 0 ov2 h0LtMax
          hBodyTgt hBbTgt hG3 hDecl2 hOv2'
        cases hStep3Ex with | intro slots₂_4 hS4 =>
        have hReach3 := reachesNArrSlice_trans hReach2 (reachesNArrSlice_one_step hS4.2)
        let f₂_4 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 4, locals := slots₂_4 }
        have hOv3 := hFields.2.2; cases hOv3 with | intro ov3 hOv3 =>
        have hOv3' : Trusted.MirSemantics.getElem? slots₂_4 (off + 3) = some (.baseSlot (.live ov3)) := by
          rw [getElem?_setElem?_ne slots₂_3 (off + 2) (off + 3) _ slots₂_4 (fun h => by cases Nat.add_left_cancel h) hS4.1]
          rw [getElem?_setElem?_ne slots₂_2 (off + 1) (off + 3) _ slots₂_3 (fun h => by cases Nat.add_left_cancel h) hS3.1]
          exact hOv3
        have hScr3Ne1 : scrIdx ≠ off + 1 := Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 1 < 4) off) (comp_range_le_scr hkLt))
        have hScr3Ne2 : scrIdx ≠ off + 2 := Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 2 < 4) off) (comp_range_le_scr hkLt))
        have hOffNeScr : off ≠ scrIdx := Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (by decide)) (comp_range_le_scr hkLt))
        have hScrVal4 : Trusted.MirSemantics.getElem? slots₂_4 scrIdx =
            some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 len)))))) := by
          rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hScr3Ne2) hS4.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hScr3Ne1) hS3.1,
              getElem?_setElem?_ne _ _ _ _ _ hOffNeScr hS2Pair.1]
          exact hS1Pair.2.2.2.1
        have hStep4Ex := step_move_scr_to_comp pack bbTgt f₂_4 cm k 3 3 hkLt (by decide) (by decide)
          len hLenLtMax hBodyTgt hBbTgt hG4 hScrVal4 ⟨ov3, hOv3'⟩ (by decide)
        cases hStep4Ex with | intro slots₂_4m hM =>
        cases hM with | intro slots₂' hS5 =>
        have hReach4 := reachesNArrSlice_trans hReach3 (reachesNArrSlice_one_step hS5.2.2)
        have hLen₂' : slots₂'.length = slots₂_2.length := by
          rw [setElem?_length _ _ _ _ hS5.2.1, setElem?_length _ _ _ _ hS5.1,
              setElem?_length _ _ _ _ hS4.1, setElem?_length _ _ _ _ hS3.1]
        have hScrNe3 : scrIdx ≠ off + 3 :=
          Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (comp_range_le_scr hkLt))
        have hOff0NeScr : off ≠ scrIdx := hOffNeScr
        have hOff0Ne3 : off ≠ off + 3 :=
          Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_trans (Nat.le_succ _) (Nat.le_succ _)))
        have hOff0Ne2 : off ≠ off + 2 := Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_succ _))
        have hOff0Ne1 : off ≠ off + 1 := Nat.ne_of_lt (Nat.lt_succ_self _)
        have hOff1Ne3 : off + 1 ≠ off + 3 :=
          Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_succ _))
        have hOff1Ne2 : off + 1 ≠ off + 2 := Nat.ne_of_lt (Nat.lt_succ_self _)
        have hOff2Ne3 : off + 2 ≠ off + 3 := Nat.ne_of_lt (Nat.lt_succ_self _)
        have hOff0 : ∃ ov, Trusted.MirSemantics.getElem? slots₂' off = some (.baseSlot (.live ov)) := by
          refine ⟨some .unit, ?_⟩
          rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff0Ne3) hS5.2.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff0NeScr) hS5.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff0Ne2) hS4.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff0Ne1) hS3.1]
          exact getElem?_setElem?_self _ _ _ _ hS2Pair.1
        have hOff1 : Trusted.MirSemantics.getElem? slots₂' (off + 1) =
            some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 0)))))) := by
          rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff1Ne3) hS5.2.1,
              getElem?_setElem?_ne _ _ _ _ _ hScr3Ne1 hS5.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff1Ne2) hS4.1]
          exact getElem?_setElem?_self _ _ _ _ hS3.1
        have hOff2 : Trusted.MirSemantics.getElem? slots₂' (off + 2) =
            some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 0)))))) := by
          rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff2Ne3) hS5.2.1,
              getElem?_setElem?_ne _ _ _ _ _ hScr3Ne2 hS5.1]
          exact getElem?_setElem?_self _ _ _ _ hS4.1
        have hOff3 : Trusted.MirSemantics.getElem? slots₂' (off + 3) =
            some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 len)))))) :=
          getElem?_setElem?_self _ _ _ _ hS5.2.1
        have hPresNonSlice : ∀ j, j < pack.bodySrc.locals.length + 4 * plan.entries.length →
            j ≠ off + 1 → j ≠ off + 2 → j ≠ off + 3 →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂_2 j := by
          intro j hj hnj1 hnj2 hnj3
          have hnjScr : j ≠ scrIdx :=
            Nat.ne_of_lt (Nat.lt_of_lt_of_le hj (Nat.le_add_right _ _))
          rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnj3) hS5.2.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnjScr) hS5.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnj2) hS4.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnj1) hS3.1]
        have hPresScr : ∀ r, r < 5 →
            ∃ ov, Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length + r) =
              some (.baseSlot (.live ov)) := by
          intro r hr
          cases Nat.decEq r 3 with
          | isTrue hr3 =>
            rw [hr3]
            refine ⟨none, ?_⟩
            rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hScrNe3) hS5.2.1]
            exact getElem?_setElem?_self _ _ _ _ hS5.1
          | isFalse hrNe =>
            have hGe : pack.bodySrc.locals.length + 4 * k + 4 ≤ pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
              comp_range_le_scr hkLt
            have hn3 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ off + 3 :=
              Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) hGe)
            have hnScr : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ scrIdx := by
              intro hEq; exact hrNe (Nat.add_left_cancel hEq)
            have hn2 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ off + 2 :=
              Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_succ _)) hGe)
            have hn1 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ off + 1 :=
              Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_trans (Nat.le_succ _) (Nat.le_succ _))) hGe)
            rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn3) hS5.2.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnScr) hS5.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn2) hS4.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn1) hS3.1]
            exact hS2Pair.2.2.2.2.2 r hr
        have hBoundSv : sv.start + sv.len < maxUsize := by rw [Nat.zero_add]; exact hLenLtMax
        have hLM' := sliceLocalMatch_set_comp_vals pack hS2Pair.2.2 hFind hSet₁ hLen₂'
          hOff0 hOff1 hOff2 hOff3 hBoundSv (Or.inl rfl) hPresNonSlice hPresScr
        refine ⟨?_, ?_, ?_⟩
        · intro s₁' hStep
          rw [hSD] at hStep; dsimp at hStep; rw [hSlS.1, hSlS_eq] at hStep
          dsimp at hStep; rw [hSet₁] at hStep
          injection hStep with hsEq; rw [← hsEq]
          have hLen5 : (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
              (.sliceFromRawParts sLoc lenOp)).length = 5 := by rw [hGen]; rfl
          have hReach5 : ReachesNArrSlice pTgt (4 + 1) { frames := [f₂], callerMem := cm }
              { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
                  pack.bodySrc.locals.length (.sliceFromRawParts sLoc lenOp)).length, locals := slots₂' }], callerMem := cm } := by
            rw [hLen5]; exact hReach4
          exact reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLen₂ hReach5 hLM'
        · intro out hDone
          rw [hSD] at hDone; dsimp at hDone; rw [hSlS.1, hSlS_eq] at hDone; dsimp at hDone; rw [hSet₁] at hDone; cases hDone
        · intro kFault hFault
          rw [hSD] at hFault; dsimp at hFault; rw [hSlS.1, hSlS_eq] at hFault; dsimp at hFault; rw [hSet₁] at hFault; cases hFault

private theorem exec_subslice_writeDst
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (f₂ : ArrSliceFrame) (cm : CallerMemory)
    (slots₁ : List ArrSliceSlot)
    {dstS : LocalId} {kD : Nat} {bDst : Option LocalId} {slDst : ArrSliceSlot}
    (sv' : SliceViewVal)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hFindD : findSliceEntry plan.entries dstS = some (kD, bDst))
    (hSlotD₁ : Trusted.MirSemantics.getElem? slots₁ dstS = some slDst)
    (hG0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (mkLivenessCheckStmt (pack.bodySrc.locals.length + 4 * kD)))
    (hG1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
      some (mkAssignUse (pack.bodySrc.locals.length + 4 * kD + 1)
        (.move { localId := pack.bodySrc.locals.length + 4 * plan.entries.length, projection := [] })))
    (hG2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
      some (mkAssignUse (pack.bodySrc.locals.length + 4 * kD + 2)
        (.move { localId := pack.bodySrc.locals.length + 4 * plan.entries.length + 3, projection := [] })))
    (hG3 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 3) =
      some (mkAssignUse (pack.bodySrc.locals.length + 4 * kD + 3)
        (.move { localId := pack.bodySrc.locals.length + 4 * plan.entries.length + 2, projection := [] })))
    (hLM : SliceLocalMatch pack slots₁ f₂.locals)
    (hTagVal : Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv'.backing))))))))
    (hIdxVal : Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + 3) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv'.start)))))))
    (hLenVal : Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + 2) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv'.len)))))))
    (hBoundSv : sv'.start + sv'.len < maxUsize)
    (hBackSv : sv'.backing = .dangling ∨ ∃ arrLoc, bDst = some arrLoc ∧ sv'.backing = .arrayLocal arrLoc) :
    (slDst = .sliceDead →
      evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
        StepResult.fault FaultKind.undefined) ∧
    (∀ optDst, slDst = .liveSlice optDst →
      ∃ slots₁' slots₂',
        setElem? slots₁ dstS (.liveSlice (some sv')) = some slots₁' ∧
        ReachesNArrSlice pTgt 4 { frames := [f₂], callerMem := cm }
          { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 4, locals := slots₂' }], callerMem := cm } ∧
        SliceLocalMatch pack slots₁' slots₂') := by
  have hkDLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFindD).1
  have hDstSLt : dstS < pack.bodySrc.locals.length := by
    have hV := findSliceEntry_some_lt_and_valid pack.hLoop hFindD
    cases hV.2 with | intro e hE =>
    cases hE.2.2.2.2.2 with | intro _ hs =>
    rw [← hE.2.1]; exact getElem?_some_lt _ _ _ hs.1
  let offD := pack.bodySrc.locals.length + 4 * kD
  let scrTag := pack.bodySrc.locals.length + 4 * plan.entries.length
  let scrB := pack.bodySrc.locals.length + 4 * plan.entries.length + 2
  let scrIdx := pack.bodySrc.locals.length + 4 * plan.entries.length + 3
  have hLive := step_mkLivenessCheckStmt_from_rel pack bbTgt f₂ cm slots₁ hBodyTgt hBbTgt hG0 hLM hFindD hSlotD₁
  constructor
  · intro hDead; exact hLive.1 hDead
  · intro optDst hLiveEq
    have hEx1 := lt_setElem?_some slots₁ dstS (.liveSlice (some sv')) (by rw [hLM.1.1]; exact hDstSLt)
    cases hEx1 with | intro slots₁' hSet₁ =>
    have hStep0Ex := step_mkLivenessCheckStmt_live_pres pack bbTgt f₂ cm slots₁ hBodyTgt hBbTgt hG0 hLM hFindD (by rw [hSlotD₁, hLiveEq])
    cases hStep0Ex with | intro slots₂_1 hS0 =>
    have hReach0 := reachesNArrSlice_one_step hS0.2.1
    let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂_1 }
    have hExSl := hS0.2.2.2.2.1 dstS kD bDst hFindD
    cases hExSl with | intro sl' hSl' =>
    have hEqSl' : sl' = .liveSlice optDst := by
      have hS : some sl' = some (.liveSlice optDst) := by rw [← hSl'.1, hSlotD₁, hLiveEq]
      injection hS
    rw [hEqSl'] at hSl'
    have hFields := sliceCompRel_live_fields hSl'.2
    have hOv1 := hFields.1; cases hOv1 with | intro ov1 hOv1 =>
    have hOv2 := hFields.2.1; cases hOv2 with | intro ov2 hOv2 =>
    have hOv3 := hFields.2.2; cases hOv3 with | intro ov3 hOv3 =>
    have hScrTagGe : offD + 4 ≤ scrTag := by
      have h := comp_range_le_scr (base := pack.bodySrc.locals.length) (r := 0) hkDLt
      rw [Nat.add_zero] at h; exact h
    have hOffNeTag : offD ≠ scrTag :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (by decide)) hScrTagGe)
    have hOffNeB : offD ≠ scrB :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (by decide : 0 < 4)) (comp_range_le_scr hkDLt))
    have hOffNeIdx : offD ≠ scrIdx :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (by decide : 0 < 4)) (comp_range_le_scr hkDLt))
    have hTag1 : Trusted.MirSemantics.getElem? slots₂_1 scrTag =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv'.backing))))))) := by
      rw [getElem?_setElem?_ne _ _ _ _ _ hOffNeTag hS0.1]; exact hTagVal
    have hTagLtMax : backingTag sv'.backing < maxUsize := by
      have hMax := maxUsize_eq
      cases sv'.backing with
      | dangling => rw [hMax]; change 0 < Nat.pow 2 64; decide
      | arrayLocal _ => rw [hMax]; change 1 < Nat.pow 2 64; decide
    have hStartLtMax : sv'.start < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_right _ _) hBoundSv
    have hLenLtMax : sv'.len < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left _ _) hBoundSv
    have hG1' : Trusted.MirSemantics.getElem? bbTgt.statements f₂_1.stmtIdx =
        some (mkAssignUse (offD + 1) (.move { localId := scrTag + 0, projection := [] })) := by
      rw [Nat.add_zero]; exact hG1
    have hTag1' : Trusted.MirSemantics.getElem? f₂_1.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + 0) =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv'.backing))))))) := by
      rw [Nat.add_zero]; exact hTag1
    have hStep1Ex := step_move_scr_to_comp pack bbTgt f₂_1 cm kD 1 0 hkDLt (by decide) (by decide)
      (backingTag sv'.backing) hTagLtMax hBodyTgt hBbTgt hG1' hTag1' ⟨ov1, hOv1⟩ (by decide)
    cases hStep1Ex with | intro slots₂_1m hM1 =>
    cases hM1 with | intro slots₂_2 hS1 =>
    have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS1.2.2)
    let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
    have hTagNeD1 : scrTag ≠ offD + 1 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 1 < 4) offD) hScrTagGe)
    have hIdxNeD1 : scrIdx ≠ offD + 1 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 1 < 4) offD) (comp_range_le_scr hkDLt))
    have hBNeD1 : scrB ≠ offD + 1 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 1 < 4) offD) (comp_range_le_scr hkDLt))
    have hTagNeIdx : scrTag ≠ scrIdx := by
      intro hEq; have hZ : 0 = 3 := by
        have hEq' : pack.bodySrc.locals.length + 4 * plan.entries.length + 0 = scrIdx := by rw [Nat.add_zero]; exact hEq
        exact Nat.add_left_cancel hEq'
      cases hZ
    have hTagNeB : scrTag ≠ scrB := by
      intro hEq; have hZ : 0 = 2 := by
        have hEq' : pack.bodySrc.locals.length + 4 * plan.entries.length + 0 = scrB := by rw [Nat.add_zero]; exact hEq
        exact Nat.add_left_cancel hEq'
      cases hZ
    have hIdxNeB : scrIdx ≠ scrB := by
      intro hEq; have hZ : 3 = 2 := Nat.add_left_cancel hEq; cases hZ
    have hTagNeD2 : scrTag ≠ offD + 2 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 2 < 4) offD) hScrTagGe)
    have hIdxNeD2 : scrIdx ≠ offD + 2 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 2 < 4) offD) (comp_range_le_scr hkDLt))
    have hBNeD2 : scrB ≠ offD + 2 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 2 < 4) offD) (comp_range_le_scr hkDLt))
    have hTagNeD3 : scrTag ≠ offD + 3 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 3 < 4) offD) hScrTagGe)
    have hIdxNeD3 : scrIdx ≠ offD + 3 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (comp_range_le_scr hkDLt))
    have hBNeD3 : scrB ≠ offD + 3 :=
      Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (comp_range_le_scr hkDLt))
    have hD1NeD2 : offD + 1 ≠ offD + 2 := Nat.ne_of_lt (Nat.lt_succ_self _)
    have hD1NeD3 : offD + 1 ≠ offD + 3 := Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_succ _))
    have hD2NeD3 : offD + 2 ≠ offD + 3 := Nat.ne_of_lt (Nat.lt_succ_self _)
    have hOv2' : Trusted.MirSemantics.getElem? slots₂_2 (offD + 2) = some (.baseSlot (.live ov2)) := by
      rw [getElem?_setElem?_ne _ _ _ _ _ hD1NeD2 hS1.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hTagNeD2 (by rw [Nat.add_zero] at hS1; exact hS1.1)]
      exact hOv2
    have hIdx2 : Trusted.MirSemantics.getElem? slots₂_2 scrIdx =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv'.start)))))) := by
      rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hIdxNeD1) hS1.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hTagNeIdx (by rw [Nat.add_zero] at hS1; exact hS1.1),
          getElem?_setElem?_ne _ _ _ _ _ hOffNeIdx hS0.1]
      exact hIdxVal
    have hStep2Ex := step_move_scr_to_comp pack bbTgt f₂_2 cm kD 2 3 hkDLt (by decide) (by decide)
      sv'.start hStartLtMax hBodyTgt hBbTgt hG2 hIdx2 ⟨ov2, hOv2'⟩ (by decide)
    cases hStep2Ex with | intro slots₂_2m hM2 =>
    cases hM2 with | intro slots₂_3 hS2 =>
    have hReach2 := reachesNArrSlice_trans hReach1 (reachesNArrSlice_one_step hS2.2.2)
    let f₂_3 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂_3 }
    have hOv3' : Trusted.MirSemantics.getElem? slots₂_3 (offD + 3) = some (.baseSlot (.live ov3)) := by
      rw [getElem?_setElem?_ne _ _ _ _ _ hD2NeD3 hS2.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hIdxNeD3 hS2.1,
          getElem?_setElem?_ne _ _ _ _ _ hD1NeD3 hS1.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hTagNeD3 (by rw [Nat.add_zero] at hS1; exact hS1.1)]
      exact hOv3
    have hB3 : Trusted.MirSemantics.getElem? slots₂_3 scrB =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv'.len)))))) := by
      rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hBNeD2) hS2.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hIdxNeB hS2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hBNeD1) hS1.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hTagNeB (by rw [Nat.add_zero] at hS1; exact hS1.1),
          getElem?_setElem?_ne _ _ _ _ _ hOffNeB hS0.1]
      exact hLenVal
    have hStep3Ex := step_move_scr_to_comp pack bbTgt f₂_3 cm kD 3 2 hkDLt (by decide) (by decide)
      sv'.len hLenLtMax hBodyTgt hBbTgt hG3 hB3 ⟨ov3, hOv3'⟩ (by decide)
    cases hStep3Ex with | intro slots₂_3m hM3 =>
    cases hM3 with | intro slots₂_4 hS3 =>
    have hReach3 := reachesNArrSlice_trans hReach2 (reachesNArrSlice_one_step hS3.2.2)
    have hLen₂' : slots₂_4.length = slots₂_1.length := by
      rw [setElem?_length _ _ _ _ hS3.2.1, setElem?_length _ _ _ _ hS3.1,
          setElem?_length _ _ _ _ hS2.2.1, setElem?_length _ _ _ _ hS2.1,
          setElem?_length _ _ _ _ hS1.2.1, setElem?_length _ _ _ _ hS1.1]
    have hOff0NeD1 : offD ≠ offD + 1 := Nat.ne_of_lt (Nat.lt_succ_self _)
    have hOff0NeD2 : offD ≠ offD + 2 := Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_succ _))
    have hOff0NeD3 : offD ≠ offD + 3 := Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_trans (Nat.le_succ _) (Nat.le_succ _)))
    have hOff0 : ∃ ov, Trusted.MirSemantics.getElem? slots₂_4 offD = some (.baseSlot (.live ov)) := by
      refine ⟨some .unit, ?_⟩
      rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff0NeD3) hS3.2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOffNeB) hS3.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff0NeD2) hS2.2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOffNeIdx) hS2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOff0NeD1) hS1.2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hOffNeTag) (by rw [Nat.add_zero] at hS1; exact hS1.1)]
      exact getElem?_setElem?_self _ _ _ _ hS0.1
    have hOff1 : Trusted.MirSemantics.getElem? slots₂_4 (offD + 1) =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv'.backing))))))) := by
      rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hD1NeD3) hS3.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hBNeD1 hS3.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hD1NeD2) hS2.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hIdxNeD1 hS2.1]
      exact getElem?_setElem?_self _ _ _ _ hS1.2.1
    have hOff2 : Trusted.MirSemantics.getElem? slots₂_4 (offD + 2) =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv'.start)))))) := by
      rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hD2NeD3) hS3.2.1,
          getElem?_setElem?_ne _ _ _ _ _ hBNeD2 hS3.1]
      exact getElem?_setElem?_self _ _ _ _ hS2.2.1
    have hOff3 : Trusted.MirSemantics.getElem? slots₂_4 (offD + 3) =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv'.len)))))) :=
      getElem?_setElem?_self _ _ _ _ hS3.2.1
    have hPresNonSlice : ∀ j, j < pack.bodySrc.locals.length + 4 * plan.entries.length →
        j ≠ offD + 1 → j ≠ offD + 2 → j ≠ offD + 3 →
        Trusted.MirSemantics.getElem? slots₂_4 j = Trusted.MirSemantics.getElem? slots₂_1 j := by
      intro j hj hnj1 hnj2 hnj3
      have hnjTag : j ≠ scrTag := Nat.ne_of_lt hj
      have hnjB : j ≠ scrB := Nat.ne_of_lt (Nat.lt_of_lt_of_le hj (Nat.le_add_right _ _))
      have hnjIdx : j ≠ scrIdx := Nat.ne_of_lt (Nat.lt_of_lt_of_le hj (Nat.le_add_right _ _))
      rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnj3) hS3.2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnjB) hS3.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnj2) hS2.2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnjIdx) hS2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnj1) hS1.2.1,
          getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnjTag) (by rw [Nat.add_zero] at hS1; exact hS1.1)]
    have hPresScr : ∀ r, r < 5 →
        ∃ ov, Trusted.MirSemantics.getElem? slots₂_4 (pack.bodySrc.locals.length + 4 * plan.entries.length + r) =
          some (.baseSlot (.live ov)) := by
      intro r hr
      have hGe : pack.bodySrc.locals.length + 4 * kD + 4 ≤ pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
        comp_range_le_scr hkDLt
      have hn3 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ offD + 3 :=
        Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) hGe)
      have hn2 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ offD + 2 :=
        Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 2 < 4) offD) hGe)
      have hn1 : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ offD + 1 :=
        Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 1 < 4) offD) hGe)
      cases Nat.decEq r 2 with
      | isTrue hr2 =>
        rw [hr2]; refine ⟨none, ?_⟩
        rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hBNeD3) hS3.2.1]
        exact getElem?_setElem?_self _ _ _ _ hS3.1
      | isFalse hrNe2 =>
        have hnB : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ scrB := by
          intro hEq; exact hrNe2 (Nat.add_left_cancel hEq)
        cases Nat.decEq r 3 with
        | isTrue hr3 =>
          rw [hr3]; refine ⟨none, ?_⟩
          rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hIdxNeD3) hS3.2.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hIdxNeB) hS3.1,
              getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hIdxNeD2) hS2.2.1]
          exact getElem?_setElem?_self _ _ _ _ hS2.1
        | isFalse hrNe3 =>
          have hnIdx : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ scrIdx := by
            intro hEq; exact hrNe3 (Nat.add_left_cancel hEq)
          cases Nat.decEq r 0 with
          | isTrue hr0 =>
            rw [hr0]; refine ⟨none, ?_⟩
            rw [Nat.add_zero, getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeD3) hS3.2.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeB) hS3.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeD2) hS2.2.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeIdx) hS2.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeD1) hS1.2.1]
            exact getElem?_setElem?_self _ _ _ _ (by rw [Nat.add_zero] at hS1; exact hS1.1)
          | isFalse hrNe0 =>
            have hnTag : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ scrTag := by
              intro hEq; have hEq' : pack.bodySrc.locals.length + 4 * plan.entries.length + r = pack.bodySrc.locals.length + 4 * plan.entries.length + 0 := by rw [Nat.add_zero]; exact hEq
              exact hrNe0 (Nat.add_left_cancel hEq')
            rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn3) hS3.2.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnB) hS3.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn2) hS2.2.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnIdx) hS2.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hn1) hS1.2.1,
                getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hnTag) (by rw [Nat.add_zero] at hS1; exact hS1.1)]
            exact hS0.2.2.2.2.2 r hr
    have hLM' := sliceLocalMatch_set_comp_vals pack hS0.2.2 hFindD hSet₁ hLen₂'
      hOff0 hOff1 hOff2 hOff3 hBoundSv hBackSv hPresNonSlice hPresScr
    exact ⟨slots₁', slots₂_4, hSet₁, hReach3, hLM'⟩

private theorem sim_stmt_subslice
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {dstS srcS : LocalId} {fromIdx toIdx : Nat} {fromEnd : Bool}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.subslice dstS srcS fromIdx toIdx fromEnd))
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.subslice dstS srcS fromIdx toIdx fromEnd) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.subslice dstS srcS fromIdx toIdx fromEnd)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.subslice dstS srcS fromIdx toIdx fromEnd)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.subslice dstS srcS fromIdx toIdx fromEnd)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  change (Nat.blt fromIdx maxUsize && Nat.blt toIdx maxUsize &&
      match findSliceEntry plan.entries dstS, findSliceEntry plan.entries srcS,
          Trusted.MirSemantics.getElem? pack.bodySrc.locals dstS,
          Trusted.MirSemantics.getElem? pack.bodySrc.locals srcS with
      | some (_, bDst), some (_, bSrc), some (.sliceView dTy), some (.sliceView sTy) =>
        MirTy.beq dTy sTy && (match bSrc with | none => true | some aSrc => optNatEq bDst (some aSrc))
      | _, _, _, _ => false) = true at hChk
  have hC0 := (bool_and_eq_true _ _).mp hChk
  have hBounds := (bool_and_eq_true _ _).mp hC0.1
  have hFromLtMax : fromIdx < maxUsize := nat_blt_lt hBounds.1
  have hToLtMax : toIdx < maxUsize := nat_blt_lt hBounds.2
  have hRest := hC0.2
  cases hFindD : findSliceEntry plan.entries dstS with
  | none => rw [hFindD] at hRest; cases hRest
  | some pD =>
    cases pD with | mk kD bDst =>
    cases hFindS : findSliceEntry plan.entries srcS with
    | none => rw [hFindD, hFindS] at hRest; cases hRest
    | some pS =>
      cases pS with | mk kS bSrc =>
      cases hDeclD : Trusted.MirSemantics.getElem? pack.bodySrc.locals dstS with
      | none => rw [hFindD, hFindS, hDeclD] at hRest; cases hRest
      | some dD =>
        cases dD with
        | base _ => rw [hFindD, hFindS, hDeclD] at hRest; cases hRest
        | array _ _ => rw [hFindD, hFindS, hDeclD] at hRest; cases hRest
        | sliceView dTy =>
          cases hDeclS : Trusted.MirSemantics.getElem? pack.bodySrc.locals srcS with
          | none => rw [hFindD, hFindS, hDeclD, hDeclS] at hRest; cases hRest
          | some dS =>
            cases dS with
            | base _ => rw [hFindD, hFindS, hDeclD, hDeclS] at hRest; cases hRest
            | array _ _ => rw [hFindD, hFindS, hDeclD, hDeclS] at hRest; cases hRest
            | sliceView sTy =>
              rw [hFindD, hFindS, hDeclD, hDeclS] at hRest
              dsimp at hRest
              have hC1 := (bool_and_eq_true _ _).mp hRest
              have hTyEq : dTy = sTy := mirTy_beq_eq _ _ hC1.1
              have hBackCompat := hC1.2
              have hHkSLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFindS).1
              let base := pack.bodySrc.locals.length
              let scrTag := base + 4 * plan.entries.length
              let scrA := scrTag + 1
              let scrB := scrTag + 2
              let scrIdx := scrTag + 3
              let offD := base + 4 * kD
              let offS := base + 4 * kS
              have hS1 : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
                  (match Trusted.MirSemantics.getElem? pack.bodySrc.locals dstS,
                      Trusted.MirSemantics.getElem? pack.bodySrc.locals srcS,
                      Trusted.MirSemantics.getElem? f₁.locals srcS with
                    | some (.sliceView dTy'), some (.sliceView sTy'), some srcSl =>
                      if !(MirTy.beq dTy' sTy') || !Nat.blt fromIdx maxUsize || !Nat.blt toIdx maxUsize then
                        .fault .unsupported
                      else match srcSl with
                        | .sliceDead | .liveSlice none => .fault .undefined
                        | .liveSlice (some sv) =>
                          match evalSubsliceVal sv fromIdx toIdx fromEnd with
                          | .error k => .fault k
                          | .ok sv' =>
                            match Trusted.MirSemantics.getElem? f₁.locals dstS with
                            | some .sliceDead => .fault .undefined
                            | some (.liveSlice _) =>
                              match setElem? f₁.locals dstS (.liveSlice (some sv')) with
                              | some slots' => stepStmtNext f₁ cm slots' | none => .fault .unsupported
                            | _ => .fault .unsupported
                        | _ => .fault .unsupported
                    | _, _, _ => .fault .unsupported) :=
                evalStepArrSlice_at_stmt pSrc pack.bodySrc bbSrc f₁ cm _ hBodySrc hBbSrc hStmtSrc
              dsimp [FwdStmtSim]
              rw [hS1]
              have hNoUnsup : (!(MirTy.beq dTy sTy) || !Nat.blt fromIdx maxUsize || !Nat.blt toIdx maxUsize) = false := by
                rw [hTyEq, mirTy_beq_refl sTy, hBounds.1, hBounds.2]; rfl
              have hExSlS := hLM.2.2.1 srcS kS bSrc hFindS
              cases hExSlS with | intro slS hSlS =>
              have hExSlD := hLM.2.2.1 dstS kD bDst hFindD
              cases hExSlD with | intro slD hSlD =>
              have hGenEq : lowerStmtForSlices pack.bodySrc.locals plan.entries base
                  (.subslice dstS srcS fromIdx toIdx fromEnd) =
                  ([mkLivenessCheckStmt offS, mkAssignUse scrTag (.copy { localId := offS + 1, projection := [] })] ++
                    (if !fromEnd then
                      if !Nat.ble fromIdx toIdx then [mkImmediateUbStmt scrA]
                      else [ mkSubUncheckedUsize scrA (.copy { localId := offS + 3, projection := [] }) (usizeConst toIdx),
                             mkAddUncheckedUsize scrIdx (.copy { localId := offS + 2, projection := [] }) (usizeConst fromIdx),
                             mkAssignUse scrB (usizeConst (toIdx - fromIdx)) ]
                    else
                      if !Nat.blt (fromIdx + toIdx) maxUsize then [mkImmediateUbStmt scrA]
                      else [ mkSubUncheckedUsize scrB (.copy { localId := offS + 3, projection := [] }) (usizeConst (fromIdx + toIdx)),
                             mkAddUncheckedUsize scrIdx (.copy { localId := offS + 2, projection := [] }) (usizeConst fromIdx) ]) ++
                    [ mkLivenessCheckStmt offD,
                      mkAssignUse (offD + 1) (.move { localId := scrTag, projection := [] }),
                      mkAssignUse (offD + 2) (.move { localId := scrIdx, projection := [] }),
                      mkAssignUse (offD + 3) (.move { localId := scrB, projection := [] }) ]) := by
                dsimp [lowerStmtForSlices]
                rw [hFindD, hFindS]
              have hG0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (mkLivenessCheckStmt offS) := by
                have h0 := hGetGen 0 (by rw [hGenEq]; cases fromEnd with | false => (dsimp; cases Nat.ble fromIdx toIdx <;> exact nat_blt_lt rfl) | true => (dsimp; cases Nat.blt (fromIdx + toIdx) maxUsize <;> exact nat_blt_lt rfl))
                rw [Nat.add_zero, hGenEq] at h0; exact h0
              have hG1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
                  some (mkAssignUse scrTag (.copy { localId := offS + 1, projection := [] })) := by
                have h1 := hGetGen 1 (by rw [hGenEq]; cases fromEnd with | false => (dsimp; cases Nat.ble fromIdx toIdx <;> exact nat_blt_lt rfl) | true => (dsimp; cases Nat.blt (fromIdx + toIdx) maxUsize <;> exact nat_blt_lt rfl))
                rw [hGenEq] at h1; exact h1
              have hLive0 := step_mkLivenessCheckStmt_from_rel pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFindS hSlS.1
              cases hSlSEq : slS with
              | baseSlot _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
              | arrDead => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
              | liveArray _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
              | sliceDead =>
                have hF0 := hLive0.1 hSlSEq
                refine ⟨fun s₁' h => (by rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                  fun out h => (by rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                  fun kFault h => by
                    rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                    injection h with hkEq; rw [← hkEq]
                    exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
                      (stepArrSlice_iff_evalStep _ _ _).mpr hF0⟩⟩
              | liveSlice optSv =>
                have hStep0Ex := step_mkLivenessCheckStmt_live_pres pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFindS (by rw [hSlS.1, hSlSEq])
                cases hStep0Ex with | intro slots₂_1 hS0 =>
                have hReach0 := reachesNArrSlice_one_step hS0.2.1
                let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂_1 }
                have hExSl1 := hS0.2.2.2.2.1 srcS kS bSrc hFindS
                cases hExSl1 with | intro slS1 hSlS1 =>
                have hEqSl1 : slS1 = .liveSlice optSv := by
                  have hS : some slS1 = some (.liveSlice optSv) := by rw [← hSlS1.1, hSlS.1, hSlSEq]
                  injection hS
                rw [hEqSl1] at hSlS1
                cases optSv with
                | none =>
                  have hRT := step_readTag_from_rel pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFindS hSlS1.1
                  have hF1 := hRT.1 rfl
                  refine ⟨fun s₁' h => (by rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                    fun out h => (by rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                    fun kFault h => by
                      rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                      injection h with hkEq; rw [← hkEq]
                      exact reachesArrSlice_of_reach_fault hReach0 hF1⟩
                | some sv =>
                  have hCompS := hSlS1.2
                  dsimp [SliceCompRel] at hCompS
                  have hBoundSv : sv.start + sv.len < maxUsize := hCompS.1
                  have hSvLenLtMax : sv.len < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left _ _) hBoundSv
                  have hSvStartLtMax : sv.start < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_right _ _) hBoundSv
                  have hNotOob : (!Nat.blt (sv.start + sv.len) maxUsize) = false := by
                    rw [lt_nat_blt hBoundSv]; rfl
                  have hStep1Ex := step_readTag_from_rel_set pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFindS hSlS1.1
                  cases hStep1Ex with | intro slots₂_2 hS1 =>
                  have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS1.2.1)
                  let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
                  have hExSl2 := hS1.2.2.2.2.1 srcS kS bSrc hFindS
                  cases hExSl2 with | intro slS2 hSlS2 =>
                  have hEqSl2 : slS2 = .liveSlice (some sv) := by
                    have hS : some slS2 = some (.liveSlice (some sv)) := by rw [← hSlS2.1, hSlS.1, hSlSEq]
                    injection hS
                  rw [hEqSl2] at hSlS2
                  have hComp2 := hSlS2.2
                  dsimp [SliceCompRel] at hComp2
                  have hDeclOff2 : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (offS + 2) = some (.base usizeTy) :=
                    getElem?_bodyTgt_locals_comp pack hHkSLt (r := 2) (by decide)
                  have hDeclOff3 : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (offS + 3) = some (.base usizeTy) :=
                    getElem?_bodyTgt_locals_comp pack hHkSLt (r := 3) (by decide)
                  have hBackCompat' : sv.backing = .dangling ∨ ∃ arrLoc, bDst = some arrLoc ∧ sv.backing = .arrayLocal arrLoc := by
                    cases hCompS.2.1 with
                    | inl hD => exact Or.inl hD
                    | inr hExA =>
                      cases hExA with | intro aSrc hAS =>
                      rw [hAS.1] at hBackCompat
                      exact Or.inr ⟨aSrc, optNatEq_eq _ _ hBackCompat, hAS.2⟩
                  cases hFE : fromEnd with
                  | false =>
                    cases hBLE : Nat.ble fromIdx toIdx with
                    | false =>
                      have hG2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
                          some (mkImmediateUbStmt scrA) := by
                        have h2 := hGetGen 2 (by rw [hGenEq, hFE, hBLE]; exact nat_blt_lt rfl)
                        rw [hGenEq, hFE, hBLE] at h2; exact h2
                      have hF2 := step_mkImmediateUbStmt_from_rel pack bbTgt f₂_2 cm 1 (by decide) hBodyTgt hBbTgt hG2
                      refine ⟨fun s₁' h => (by rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp [evalSubsliceVal] at h; rw [hNotOob] at h; dsimp at h; rw [hBLE] at h; cases h),
