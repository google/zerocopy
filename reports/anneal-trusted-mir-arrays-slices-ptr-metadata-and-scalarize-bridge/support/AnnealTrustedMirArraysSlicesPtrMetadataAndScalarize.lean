      cases p with | mk idx slots₁Mid =>
      have hOk2 := hU.2 idx slots₁Mid hU1
      cases hOk2 with | intro slots₂Mid hS2Mid =>
      have hPresU := evalUsizeOperand_preserves_nonBase pack.bodySrc.locals f₁.locals idxOp idx slots₁Mid hU1
      have hLM' := sliceLocalMatch_of_usizeOp_step pack hLM hS2Mid.2.1 (by rw [hS2Mid.2.2.1]) hPresU
        (fun j hj _ => hS2Mid.2.2.2 j hj)
        (by cases hLM.2.2.2 0 (by decide) with | intro ov hOv => exact ⟨ov, by rw [hS2Mid.2.2.2 _ (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))]; exact hOv⟩)
        ⟨0, by decide, by rw [Nat.add_zero]⟩
      have hRA := evalReadArrayAtIdx_prefix pack f₁ f₂ cm idx nextBb hLM' hDstLt hArrLt hDstNotSlice
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep
        rw [evalEq, hTermSrc] at hStep; dsimp at hStep; rw [hU1] at hStep; dsimp at hStep
        have hEx := hRA.1 s₁' hStep
        cases hEx with | intro slots₁' hR =>
        cases hR with | intro slots₂' hR2 =>
        refine ⟨nextBb, slots₁', slots₂', hR2.1, ?_, hR2.2.2⟩
        rw [evalEq, hTermSame]; dsimp; rw [hS2Mid.1]; dsimp; exact hR2.2.1
      · intro out hDone
        rw [evalEq, hTermSrc] at hDone; dsimp at hDone; rw [hU1] at hDone; dsimp at hDone
        exact False.elim (hRA.2.1 out hDone)
      · intro k hFault
        rw [evalEq, hTermSrc] at hFault; dsimp at hFault; rw [hU1] at hFault; dsimp at hFault
        rw [evalEq, hTermSame]; dsimp; rw [hS2Mid.1]; dsimp; exact hRA.2.2 k hFault
  | writeArrayElem arrLocal idxOp valOp nextBb =>
    have hPreNil : (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1 = [] := by
      rw [hTermSrc]; rfl
    have hIdx₂ : f₂.stmtIdx =
        (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc).statements.length := by
      rw [← hLenPre, hPreNil]; rfl
    have hTermSame : (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc).terminator =
        .writeArrayElem arrLocal idxOp valOp nextBb := by
      rw [hTermTgt, hTermSrc]; rfl
    apply sim_term_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbSrc hBbTgt hIdx₁ hIdx₂
    have evalEq : ∀ body bb frame, evalArrSliceTerm body bb frame cm =
        match bb.terminator with
        | .writeArrayElem arrLoc iO vO nb =>
          match Trusted.MirSemantics.getElem? body.locals arrLoc with
          | some (.array elemTy len) =>
            match evalUsizeOperand body.locals frame.locals iO with
            | .error k => .fault k
            | .ok (idx, slotsAfterIdx) =>
              match evalArrSliceTypedOperand body.locals slotsAfterIdx elemTy vO with
              | .error k => .fault k
              | .ok (v, slotsAfterVal) =>
                match Trusted.MirSemantics.getElem? slotsAfterVal arrLoc with
                | some .arrDead => .fault .undefined
                | some (.liveArray elems) =>
                  if !Nat.blt idx len then .fault .undefined
                  else match setElem? elems idx (some v) with
                    | none => .fault .unsupported
                    | some elems' =>
                      match setElem? slotsAfterVal arrLoc (.liveArray elems') with
                      | some slots' => jumpArrSliceBlock frame cm slots' nb
                      | none => .fault .unsupported
                | _ => .fault .unsupported
          | _ => .fault .unsupported
        | _ => evalArrSliceTerm body bb frame cm := by
      intro body bb frame
      cases hT : bb.terminator with
      | writeArrayElem => (dsimp [evalArrSliceTerm]; rw [hT]) <;> rfl
      | _ => rfl
    rw [hTermSrc] at hBnd hChk
    have hC0 := (bool_and_eq_true _ _).mp hChk
    have hB0 := (bool_and_eq_true _ _).mp hBnd
    have hB1 := (bool_and_eq_true _ _).mp hB0.1
    have hArrLt : arrLocal < pack.bodySrc.locals.length := nat_blt_lt hB1.1
    cases hAD : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
    | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hAD) hArrLt)
    | some dArr =>
      cases dArr with
      | base _ =>
        have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hAD] at h; cases h)
        refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD] at h; cases h),
          fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD] at h; cases h),
          fun k h => by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD] at h; rw [evalEq, hTermSame]; dsimp; rw [hNS.2, hAD]; exact h⟩
      | sliceView _ =>
        have hATgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.base .unit) := by
          rw [getElem?_bodyTgt_locals_lt pack hArrLt, getElem?_tombstoneSliceDecls, hAD]; rfl
        refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD] at h; cases h),
          fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD] at h; cases h),
          fun k h => by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD] at h; rw [evalEq, hTermSame]; dsimp; rw [hATgt]; exact h⟩
      | array elemTy len =>
        have hNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hAD] at h; cases h)
        have hATgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.array elemTy len) := by
          rw [hNS.2, hAD]
        have hLen₂' : pack.bodySrc.locals.length ≤ f₂.locals.length := by
          rw [hLM.2.1, bodyTgt_locals_length pack]
          exact Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
        have hU := evalUsizeOperand_prefix pack hLM.1 hLen₂' hC0.1
        cases hU1 : evalUsizeOperand pack.bodySrc.locals f₁.locals idxOp with
        | error err =>
          have hU2 := hU.1 err hU1
          refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; cases h),
            fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; cases h),
            fun k h => by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; rw [evalEq, hTermSame]; dsimp; rw [hATgt, hU2]; exact h⟩
        | ok p =>
          cases p with | mk idx slots₁Mid =>
          have hOk2 := hU.2 idx slots₁Mid hU1
          cases hOk2 with | intro slots₂Mid hS2Mid =>
          have hLenMid : pack.bodySrc.locals.length ≤ slots₂Mid.length := by rw [hS2Mid.2.2.1]; exact hLen₂'
          have hT := evalArrSliceTypedOperand_prefix pack hS2Mid.2.1 hLenMid elemTy hC0.2
          cases hT1 : evalArrSliceTypedOperand pack.bodySrc.locals slots₁Mid elemTy valOp with
          | error err =>
            have hT2 := hT.1 err hT1
            refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; cases h),
              fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; cases h),
              fun k h => by
                rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h
                rw [evalEq, hTermSame]; dsimp; rw [hATgt, hS2Mid.1]; dsimp; rw [hT2]; exact h⟩
          | ok q =>
            cases q with | mk v slots₁Val =>
            have hOkVal := hT.2 v slots₁Val hT1
            cases hOkVal with | intro slots₂Val hS2Val =>
            have hSlotEq : Trusted.MirSemantics.getElem? slots₂Val arrLocal =
                Trusted.MirSemantics.getElem? slots₁Val arrLocal := hS2Val.2.1.2 arrLocal hArrLt hNS.1
            cases hArrSl : Trusted.MirSemantics.getElem? slots₁Val arrLocal with
            | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hArrSl) (by rw [hS2Val.2.1.1]; exact hArrLt))
            | some arrSl =>
              cases arrSl with
              | baseSlot _ =>
                refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                  fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                  fun k h => by
                    rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h
                    rw [evalEq, hTermSame]; dsimp; rw [hATgt, hS2Mid.1]; dsimp; rw [hS2Val.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
              | sliceDead =>
                refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                  fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                  fun k h => by
                    rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h
                    rw [evalEq, hTermSame]; dsimp; rw [hATgt, hS2Mid.1]; dsimp; rw [hS2Val.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
              | liveSlice _ =>
                refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                  fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                  fun k h => by
                    rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h
                    rw [evalEq, hTermSame]; dsimp; rw [hATgt, hS2Mid.1]; dsimp; rw [hS2Val.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
              | arrDead =>
                refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                  fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; cases h),
                  fun k h => by
                    rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h
                    rw [evalEq, hTermSame]; dsimp; rw [hATgt, hS2Mid.1]; dsimp; rw [hS2Val.1]; dsimp; rw [hSlotEq, hArrSl]; exact h⟩
              | liveArray elems =>
                cases hIdxLt : (!idx.blt len) with
                | true =>
                  refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; cases h),
                    fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; cases h),
                    fun k h => by
                      rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h
                      rw [evalEq, hTermSame]; dsimp; rw [hATgt, hS2Mid.1]; dsimp; rw [hS2Val.1]; dsimp; rw [hSlotEq, hArrSl]; dsimp; rw [hIdxLt]; exact h⟩
                | false =>
                  cases hSetEl : setElem? elems idx (some v) with
                  | none =>
                    refine ⟨fun s₁' h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; dsimp at h; rw [hSetEl] at h; cases h),
                      fun out h => (by rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; dsimp at h; rw [hSetEl] at h; cases h),
                      fun k h => by
                        rw [evalEq, hTermSrc] at h; dsimp at h; rw [hAD, hU1] at h; dsimp at h; rw [hT1] at h; dsimp at h; rw [hArrSl] at h; dsimp at h; rw [hIdxLt] at h; dsimp at h; rw [hSetEl] at h
                        rw [evalEq, hTermSame]; dsimp; rw [hATgt, hS2Mid.1]; dsimp; rw [hS2Val.1]; dsimp; rw [hSlotEq, hArrSl]; dsimp; rw [hIdxLt]; dsimp; rw [hSetEl]; exact h⟩
                  | some elems' =>
                    have hLt1 := getElem?_some_lt slots₁Val arrLocal _ hArrSl
                    have hEx1 := lt_setElem?_some slots₁Val arrLocal (.liveArray elems') hLt1
                    cases hEx1 with | intro slots₁' hSet₁ =>
                    have hLt2 := getElem?_some_lt slots₂Val arrLocal _ (by rw [hSlotEq, hArrSl])
                    have hEx2 := lt_setElem?_some slots₂Val arrLocal (.liveArray elems') hLt2
                    cases hEx2 with | intro slots₂' hSet₂ =>
                    have hPM := prefixSlotsMatch_set_base hS2Val.2.1 hArrLt (.liveArray elems') hSet₁ hSet₂
                    have hPresU := evalUsizeOperand_preserves_nonBase pack.bodySrc.locals f₁.locals idxOp idx slots₁Mid hU1
                    have hPresT := evalArrSliceTypedOperand_preserves_nonBase pack.bodySrc.locals slots₁Mid elemTy valOp v slots₁Val hT1
                    have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
                        Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? f₁.locals sLoc := by
                      intro sLoc k optArr hF
                      have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
                      cases hV.2 with | intro e hE =>
                      cases hE.2.2.2.2.2 with | intro sTy hs =>
                      have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                        rw [← hE.2.1]; exact hs.1
                      have hNe : arrLocal ≠ sLoc := by intro hEq; rw [hEq, hSD] at hAD; cases hAD
                      rw [getElem?_setElem?_ne slots₁Val arrLocal sLoc _ slots₁' hNe hSet₁,
                          hPresT.2 sLoc (fun bTy hB => by rw [hSD] at hB; cases hB),
                          hPresU.2 sLoc (fun bTy hB => by rw [hSD] at hB; cases hB)]
                    have hExt₂ : ∀ j, pack.bodySrc.locals.length ≤ j →
                        Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? f₂.locals j := by
                      intro j hj
                      rw [hPM.2.2 j hj, hS2Val.2.2.2 j hj, hS2Mid.2.2.2 j hj]
                    have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hPM.1 (by rw [hPM.2.1, hS2Val.2.2.1, hS2Mid.2.2.1]) hSl₁Pres hExt₂
                    refine ⟨?_, ?_, ?_⟩
                    · intro s₁' hStep
                      rw [evalEq, hTermSrc] at hStep; dsimp at hStep; rw [hAD, hU1] at hStep; dsimp at hStep; rw [hT1] at hStep; dsimp at hStep
                      rw [hArrSl] at hStep; dsimp at hStep; rw [hIdxLt] at hStep; dsimp at hStep; rw [hSetEl] at hStep; dsimp at hStep; rw [hSet₁] at hStep
                      injection hStep with hsEq
                      refine ⟨nextBb, slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                      rw [evalEq, hTermSame]; dsimp; rw [hATgt, hS2Mid.1]; dsimp; rw [hS2Val.1]; dsimp; rw [hSlotEq, hArrSl]; dsimp; rw [hIdxLt]; dsimp; rw [hSetEl]; dsimp; rw [hSet₂]
                    · intro out hDone
                      rw [evalEq, hTermSrc] at hDone; dsimp at hDone; rw [hAD, hU1] at hDone; dsimp at hDone; rw [hT1] at hDone; dsimp at hDone
                      rw [hArrSl] at hDone; dsimp at hDone; rw [hIdxLt] at hDone; dsimp at hDone; rw [hSetEl] at hDone; dsimp at hDone; rw [hSet₁] at hDone; cases hDone
                    · intro k hFault
                      rw [evalEq, hTermSrc] at hFault; dsimp at hFault; rw [hAD, hU1] at hFault; dsimp at hFault; rw [hT1] at hFault; dsimp at hFault
                      rw [hArrSl] at hFault; dsimp at hFault; rw [hIdxLt] at hFault; dsimp at hFault; rw [hSetEl] at hFault; dsimp at hFault; rw [hSet₁] at hFault; cases hFault

-- ============================================================================
-- Section 7E: Full Simulation (`scalarize_step_sim`) and Soundness
-- ============================================================================

private theorem stepStmtNext_preserves_defId (f : ArrSliceFrame) (cm : CallerMemory)
    (slots' : List ArrSliceSlot) {s' : ArrSliceState}
    (h : stepStmtNext f cm slots' = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId := by
  injection h with hs
  rw [← hs]
  exact ⟨_, rfl, rfl⟩

private theorem jumpArrSliceBlock_preserves_defId (f : ArrSliceFrame) (cm : CallerMemory)
    (slots' : List ArrSliceSlot) (target : BasicBlockId) {s' : ArrSliceState}
    (h : jumpArrSliceBlock f cm slots' target = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId := by
  injection h with hs
  rw [← hs]
  exact ⟨_, rfl, rfl⟩

private theorem evalReadArrayAtIdx_preserves_defId (body : ArrSliceBody) (f : ArrSliceFrame)
    (cm : CallerMemory) (slots : List ArrSliceSlot) (dst arr : LocalId)
    (effIdx : Nat) (nextBb : BasicBlockId) {s' : ArrSliceState}
    (h : evalReadArrayAtIdx body f cm slots dst arr effIdx nextBb = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId := by
  change (match Trusted.MirSemantics.getElem? body.locals dst,
      Trusted.MirSemantics.getElem? body.locals arr,
      Trusted.MirSemantics.getElem? slots arr with
    | some (.base dstTy), some (.array elemTy len), some arrSl =>
      if !(MirTy.beq dstTy elemTy) then StepResult.fault FaultKind.unsupported
      else match arrSl with
        | .arrDead => StepResult.fault FaultKind.undefined
        | .liveArray elems =>
          if !Nat.blt effIdx len then StepResult.fault FaultKind.undefined
          else match Trusted.MirSemantics.getElem? elems effIdx with
            | some (some v) =>
              match writeArrSliceBasePlace slots dst dstTy v with
              | .error k => StepResult.fault k
              | .ok slots' => jumpArrSliceBlock f cm slots' nextBb
            | some none => StepResult.fault FaultKind.undefined
            | none => StepResult.fault FaultKind.unsupported
        | _ => StepResult.fault FaultKind.unsupported
    | _, _, _ => StepResult.fault FaultKind.unsupported) = .step s' at h
  cases hD : Trusted.MirSemantics.getElem? body.locals dst with
  | none => rw [hD] at h; cases h
  | some d1 =>
    cases d1 with
    | array _ _ => rw [hD] at h; cases h
    | sliceView _ => rw [hD] at h; cases h
    | base dstTy =>
      cases hA : Trusted.MirSemantics.getElem? body.locals arr with
      | none => rw [hD, hA] at h; cases h
      | some d2 =>
        cases d2 with
        | base _ => rw [hD, hA] at h; cases h
        | sliceView _ => rw [hD, hA] at h; cases h
        | array elemTy len =>
          cases hS : Trusted.MirSemantics.getElem? slots arr with
          | none => rw [hD, hA, hS] at h; cases h
          | some sl =>
            rw [hD, hA, hS] at h; dsimp at h
            cases hTy : !(MirTy.beq dstTy elemTy) with
            | true => rw [hTy] at h; cases h
            | false =>
              rw [hTy] at h; dsimp at h
              cases sl with
              | baseSlot _ => cases h
              | arrDead => cases h
              | sliceDead => cases h
              | liveSlice _ => cases h
              | liveArray elems =>
                cases hLt : !Nat.blt effIdx len with
                | true => rw [hLt] at h; cases h
                | false =>
                  rw [hLt] at h; dsimp at h
                  cases hEl : Trusted.MirSemantics.getElem? elems effIdx with
                  | none => rw [hEl] at h; cases h
                  | some ov =>
                    cases ov with
                    | none => rw [hEl] at h; cases h
                    | some v =>
                      rw [hEl] at h; dsimp at h
                      cases hWr : writeArrSliceBasePlace slots dst dstTy v with
                      | error _ => rw [hWr] at h; cases h
                      | ok slots' =>
                        rw [hWr] at h
                        exact jumpArrSliceBlock_preserves_defId f cm slots' nextBb h

private theorem evalArrSliceStmt_preserves_defId (body : ArrSliceBody) (f : ArrSliceFrame)
    (cm : CallerMemory) (stmt : ArrSliceStmt) {s' : ArrSliceState}
    (h : evalArrSliceStmt body f cm stmt = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId := by
  cases stmt with
  | baseStmt s =>
    cases s with
    | nop => exact stepStmtNext_preserves_defId f cm f.locals h
    | unsupported => cases h
    | storageLive id =>
      change (match Trusted.MirSemantics.getElem? body.locals id with
        | none => StepResult.fault FaultKind.unsupported
        | some decl =>
          match setElem? f.locals id (liveUninitArrSliceSlot decl) with
          | some slots' => stepStmtNext f cm slots' | none => StepResult.fault FaultKind.unsupported) = .step s' at h
      cases hD : Trusted.MirSemantics.getElem? body.locals id with
      | none => rw [hD] at h; cases h
      | some decl =>
        rw [hD] at h; dsimp at h
        cases hS : setElem? f.locals id (liveUninitArrSliceSlot decl) with
        | none => rw [hS] at h; cases h
        | some slots' => rw [hS] at h; exact stepStmtNext_preserves_defId f cm slots' h
    | storageDead id =>
      change (if Nat.beq id 0 then StepResult.fault FaultKind.unsupported
        else match setElem? f.locals id (match Trusted.MirSemantics.getElem? body.locals id with
          | some decl => deadArrSliceSlot decl | none => .baseSlot .dead) with
          | some slots' => stepStmtNext f cm slots' | none => StepResult.fault FaultKind.unsupported) = .step s' at h
      cases hZ : Nat.beq id 0 with
      | true => rw [hZ] at h; cases h
      | false =>
        rw [hZ] at h; dsimp at h
        cases hS : setElem? f.locals id _ with
        | none => rw [hS] at h; cases h
        | some slots' => rw [hS] at h; exact stepStmtNext_preserves_defId f cm slots' h
    | assign dst rval =>
      change (if !dst.projection.isEmpty then StepResult.fault FaultKind.unsupported
        else match Trusted.MirSemantics.getElem? body.locals dst.localId with
          | some (.base dstTy) =>
            match evalArrSliceBaseRvalue body.locals f.locals dstTy rval with
            | .error k => StepResult.fault k
            | .ok (val, slotsAfter) =>
              match writeArrSliceBasePlace slotsAfter dst.localId dstTy val with
              | .error k => StepResult.fault k
              | .ok slots' => stepStmtNext f cm slots'
          | _ => StepResult.fault FaultKind.unsupported) = .step s' at h
      cases hE : (!dst.projection.isEmpty) with
      | true => rw [hE] at h; cases h
      | false =>
        rw [hE] at h; dsimp at h
        cases hD : Trusted.MirSemantics.getElem? body.locals dst.localId with
        | none => rw [hD] at h; cases h
        | some d =>
          cases d with
          | array _ _ => rw [hD] at h; cases h
          | sliceView _ => rw [hD] at h; cases h
          | base dstTy =>
            rw [hD] at h; dsimp at h
            cases hRv : evalArrSliceBaseRvalue body.locals f.locals dstTy rval with
            | error _ => rw [hRv] at h; cases h
            | ok p =>
              rw [hRv] at h; dsimp at h
              cases hWr : writeArrSliceBasePlace p.2 dst.localId dstTy p.1 with
              | error _ => rw [hWr] at h; cases h
              | ok slots' => rw [hWr] at h; exact stepStmtNext_preserves_defId f cm slots' h
  | aggregateArray arrLocal ops =>
    dsimp [evalArrSliceStmt] at h
    cases hD : Trusted.MirSemantics.getElem? body.locals arrLocal with
    | none => rw [hD] at h; cases h
    | some d =>
      cases d with
      | base _ => rw [hD] at h; cases h
      | sliceView _ => rw [hD] at h; cases h
      | array elemTy len =>
        rw [hD] at h; dsimp at h
        cases hL : (!Nat.beq ops.length len) with
        | true => rw [hL] at h; cases h
        | false =>
          rw [hL] at h; dsimp at h
          cases hOps : evalArrSliceTypedOps body.locals elemTy f.locals ops with
          | error _ => rw [hOps] at h; cases h
          | ok p =>
            rw [hOps] at h; dsimp at h
            cases hSl : Trusted.MirSemantics.getElem? p.2 arrLocal with
            | none => rw [hSl] at h; cases h
            | some sl =>
              cases sl with
              | baseSlot _ => rw [hSl] at h; cases h
              | arrDead => rw [hSl] at h; cases h
              | sliceDead => rw [hSl] at h; cases h
              | liveSlice _ => rw [hSl] at h; cases h
              | liveArray _ =>
                rw [hSl] at h; dsimp at h
                cases hSet : setElem? p.2 arrLocal (.liveArray (p.1.map some)) with
                | none => rw [hSet] at h; cases h
                | some slots' => rw [hSet] at h; exact stepStmtNext_preserves_defId f cm slots' h
  | repeatArray arrLocal op =>
    dsimp [evalArrSliceStmt] at h
