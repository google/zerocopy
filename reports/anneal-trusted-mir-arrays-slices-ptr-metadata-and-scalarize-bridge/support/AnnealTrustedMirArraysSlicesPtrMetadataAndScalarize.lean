      { statements := []
        terminator := .readSliceElem 0 3 (.copy { localId := 1, projection := [] }) 4 },
      { statements := [mkAssignUse 0 (u32Const 999)]
        terminator := .baseTerm .return_ },
      { statements := [], terminator := .baseTerm .return_ }
