private theorem fullSemanticEquivArrSlice_of_fwd_stutter_sim
    (p₁ p₂ : ArrSliceProgram)
    (R : ArrSliceState → ArrSliceState → Prop)
    (μ : ArrSliceState → Nat)
    (hInitErr₁ : ∀ (q : Query) (k : FaultKind),
      initStateArrSlice p₁ q = .error k → initStateArrSlice p₂ q = .error k)
    (hInitErr₂ : ∀ (q : Query) (k : FaultKind),
      initStateArrSlice p₂ q = .error k → initStateArrSlice p₁ q = .error k)
    (hInitOk : ∀ (q : Query) (s₁ : ArrSliceState),
      initStateArrSlice p₁ q = .ok s₁ →
      ∃ s₂ : ArrSliceState, initStateArrSlice p₂ q = .ok s₂ ∧ R s₁ s₂)
    (hStep : ∀ (s₁ s₂ : ArrSliceState), R s₁ s₂ →
      (∀ s₁' : ArrSliceState, evalStepArrSlice p₁ 0 s₁ = .step s₁' →
        (R s₁' s₂ ∧ μ s₁' < μ s₁) ∨
        (∃ s₂' : ArrSliceState, ReachesPlusArrSlice p₂ s₂ s₂' ∧ R s₁' s₂')) ∧
      (∀ out : TerminalOut, evalStepArrSlice p₁ 0 s₁ = .done out →
        ∃ s₂' : ArrSliceState,
          ReachesArrSlice p₂ s₂ s₂' ∧ StepArrSlice p₂ s₂' (.done out)) ∧
      (∀ k : FaultKind, evalStepArrSlice p₁ 0 s₁ = .fault k →
        ∃ s₂' : ArrSliceState,
          ReachesArrSlice p₂ s₂ s₂' ∧ StepArrSlice p₂ s₂' (.fault k))) :
    FullSemanticEquivArrSlice p₁ p₂ := by
  refine fullSemanticEquivArrSlice_of_outcomes p₁ p₂ ?_ ?_
  · intro q out
    constructor
    · intro hBeh
      unfold BehaviorArrSlice ReachesResultArrSlice at hBeh
      unfold BehaviorArrSlice ReachesResultArrSlice
      cases hI₁ : initStateArrSlice p₁ q with
      | error k =>
        rw [hI₁] at hBeh
        cases hBeh
      | ok s₁₀ =>
        rw [hI₁] at hBeh
        cases hInitOk q s₁₀ hI₁ with
        | intro s₂₀ hs₂₀ =>
          rw [hs₂₀.1]
          cases hBeh with
          | intro s₁' hs₁' =>
            cases fwd_stutter_reaches_arrSlice hStep hs₁'.1 hs₂₀.2 with
            | intro s₂Mid hs₂Mid =>
              have hDoneEval := (stepArrSlice_iff_evalStep p₁ s₁' (.done out)).mp hs₁'.2
              cases (hStep s₁' s₂Mid hs₂Mid.2).2.1 out hDoneEval with
              | intro s₂End hs₂End =>
                exact ⟨s₂End, reachesArrSlice_trans hs₂Mid.1 hs₂End.1, hs₂End.2⟩
    · intro hBeh
      unfold BehaviorArrSlice ReachesResultArrSlice at hBeh
      unfold BehaviorArrSlice ReachesResultArrSlice
      cases hI₂ : initStateArrSlice p₂ q with
      | error k =>
        rw [hI₂] at hBeh
        cases hBeh
      | ok s₂₀ =>
        rw [hI₂] at hBeh
        cases hI₁ : initStateArrSlice p₁ q with
        | error k =>
          have hErr := hInitErr₁ q k hI₁
          rw [hErr] at hI₂
          cases hI₂
        | ok s₁₀ =>
          cases hInitOk q s₁₀ hI₁ with
          | intro s₂₀' hs₂₀' =>
            have hEq := hs₂₀'.1
            rw [hI₂] at hEq
            cases hEq
            cases hBeh with
            | intro s₂' hs₂' =>
              cases reachesNArrSlice_of_reachesArrSlice hs₂'.1 with
              | intro n hn =>
                exact bwd_stutter_done_aux hStep n (μ s₁₀) n s₁₀ s₂₀ s₂' out
                  (Nat.le_refl n) (Nat.le_refl (μ s₁₀)) hs₂₀'.2 hn hs₂'.2
  · intro q k
    constructor
    · intro hF
      unfold ReachesResultArrSlice at hF
      unfold ReachesResultArrSlice
      cases hI₁ : initStateArrSlice p₁ q with
      | error k₁ =>
        rw [hI₁] at hF
        cases hF
        rw [hInitErr₁ q k hI₁]
      | ok s₁₀ =>
        rw [hI₁] at hF
        cases hInitOk q s₁₀ hI₁ with
        | intro s₂₀ hs₂₀ =>
          rw [hs₂₀.1]
          cases hF with
          | intro s₁' hs₁' =>
            cases fwd_stutter_reaches_arrSlice hStep hs₁'.1 hs₂₀.2 with
            | intro s₂Mid hs₂Mid =>
              have hFaultEval := (stepArrSlice_iff_evalStep p₁ s₁' (.fault k)).mp hs₁'.2
