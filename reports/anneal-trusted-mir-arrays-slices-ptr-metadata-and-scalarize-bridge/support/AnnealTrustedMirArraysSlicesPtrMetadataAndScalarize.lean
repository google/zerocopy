noncomputable def progCe3MetaMir : Program :=
  lowerOrEmpty [.sliceScalarize ⟨0, [⟨1, none⟩]⟩] progCe3DanglingMeta

noncomputable def progCe3DerefMir : Program :=
  lowerOrEmpty [.sliceScalarize ⟨0, [⟨1, none⟩]⟩] progCe3DanglingDeref

theorem ce3_dangling_slice_metadata_ok_and_deref_ub_in_trusted_mir :
    checkArrSliceToTrustedMir [.sliceScalarize ⟨0, [⟨1, none⟩]⟩] progCe3DanglingMeta progCe3MetaMir = true ∧
    ReachesResult progCe3MetaMir emptyQuery
      (.done (.returned ⟨.scalar ⟨.isize, false, BitVec.ofNat 128 100⟩, ⟨[]⟩⟩)) ∧
    checkArrSliceToTrustedMir [.sliceScalarize ⟨0, [⟨1, none⟩]⟩] progCe3DanglingDeref progCe3DerefMir = true ∧
    ReachesResultArrSlice progCe3DanglingDeref emptyQuery (.fault .undefined) ∧
    ReachesResult progCe3DerefMir emptyQuery (.fault .undefined) :=
  ⟨rfl,
