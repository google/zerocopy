private theorem arrSc_map_some_getElem? {α : Type} :
    ∀ (xs : List α) (j : Nat) (x : α),
      Trusted.MirSemantics.getElem? xs j = some x →
      Trusted.MirSemantics.getElem? (xs.map some) j = some (some x)
  | [], _, _, h => by cases h
  | a :: _, 0, x, h => by
    have hEq := Option.some.inj h
    rw [hEq]
    rfl
  | _ :: tl, j + 1, x, h => arrSc_map_some_getElem? tl j x h

private theorem arrSc_mkStorageLiveRange_length :
    ∀ (s c : Nat), (mkStorageLiveRange s c).length = c
  | _, 0 => rfl
  | s, c + 1 => congrArg Nat.succ (arrSc_mkStorageLiveRange_length (s + 1) c)

private theorem arrSc_mkStorageDeadRange_length :
    ∀ (s c : Nat), (mkStorageDeadRange s c).length = c
  | _, 0 => rfl
  | s, c + 1 => congrArg Nat.succ (arrSc_mkStorageDeadRange_length (s + 1) c)

private theorem arrSc_list_take_lt_getElem? {α : Type} {xs : List α} {i : Nat} {x : α}
    (h : Trusted.MirSemantics.getElem? xs i = some x) : i < xs.length :=
  getElem?_some_lt xs i x h

private theorem s4b_arrSc_localMatch_set_liveLoc_unit
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂' : List ArrSliceSlot}
    (_hLM : arrSc_LocalMatch pack slots₁ slots₂)
    (hSet : setElem? slots₂ pack.bodySrc.locals.length (.baseSlot (.live (some .unit))) = some slots₂') :
    (∀ i : Nat, i < pack.bodySrc.locals.length →
      Trusted.MirSemantics.getElem? slots₂' i = Trusted.MirSemantics.getElem? slots₂ i) ∧
    (∀ j : Nat, j < pack.len →
      Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 1 + j) =
        Trusted.MirSemantics.getElem? slots₂ (pack.bodySrc.locals.length + 1 + j)) ∧
    (∀ r : Nat, r < 4 + pack.len →
      Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 1 + pack.len + r) =
        Trusted.MirSemantics.getElem? slots₂ (pack.bodySrc.locals.length + 1 + pack.len + r)) ∧
    slots₂'.length = slots₂.length := by
  refine ⟨?_, ?_, ?_, setElem?_length slots₂ pack.bodySrc.locals.length _ slots₂' hSet⟩
  · intro i hi
    have hNe : pack.bodySrc.locals.length ≠ i := fun h => by
      rw [h] at hi; exact nat_lt_irrefl i hi
    exact getElem?_setElem?_ne slots₂ pack.bodySrc.locals.length i _ slots₂' hNe hSet
  · intro j _
    have hNe : pack.bodySrc.locals.length ≠ pack.bodySrc.locals.length + 1 + j := fun h => by
      have hLt : pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + j := by
        rw [Nat.add_assoc]; exact arrSc_lt_add_one_add pack.bodySrc.locals.length j
      rw [← h] at hLt
      exact nat_lt_irrefl _ hLt
    exact getElem?_setElem?_ne slots₂ pack.bodySrc.locals.length _ _ slots₂' hNe hSet
  · intro r _
    have hNe : pack.bodySrc.locals.length ≠ pack.bodySrc.locals.length + 1 + pack.len + r := fun h => by
      have hLt : pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + pack.len + r := by
        rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
          Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) r]
        exact arrSc_lt_add_one_add_add pack.bodySrc.locals.length pack.len r
      rw [← h] at hLt
      exact nat_lt_irrefl _ hLt
    exact getElem?_setElem?_ne slots₂ pack.bodySrc.locals.length _ _ slots₂' hNe hSet

private theorem arrSc_sim_stmt_storageLive
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (id : LocalId)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.storageLive id)))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.baseStmt (.storageLive id)) = true)
    (hGetGen : ∀ j : Nat, j < (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageLive id))).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageLive id))) j)
    (hLenNext : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageLive id))).length =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  have hLtId : id < pack.bodySrc.locals.length := nat_blt_lt hBnd
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    getElem?_some_lt bbSrc.statements f₁.stmtIdx _ hStmtSrc
  have hBodyP : Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt := by
    rw [← hSame₂]; exact hBodyTgt
  cases s4b_arrSc_nat_eq_or_ne id plan.arrLocal with
  | inr hNeArr =>
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageLive id)) =
        [.baseStmt (.storageLive id)] := by
      dsimp [lowerStmtForArray]
      rw [nat_beq_false hNeArr]
      rfl
    rw [hGen] at hGetGen hLenNext
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.baseStmt (.storageLive id)) := by
      have h0 := hGetGen 0 (Nat.zero_lt_succ 0)
      rw [Nat.add_zero] at h0
      exact h0
    have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtId hNeArr
    cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals id with
    | none =>
      exact False.elim (nat_lt_irrefl id
        (Nat.lt_of_lt_of_le hLtId (getElem?_none_le pack.bodySrc.locals id hDecl)))
    | some decl =>
      rw [hDecl] at hDeclEq
      have hLtSl₁ : id < f₁.locals.length := by rw [hLM.1.1]; exact hLtId
      have hLtSl₂ : id < f₂.locals.length := by
        rw [hLM.2.1]; exact Nat.lt_of_lt_of_le hLtId (s4b_arrSc_le_bodyTgt_locals pack)
      cases hSet₁ : setElem? f₁.locals id (liveUninitArrSliceSlot decl) with
      | none =>
        cases lt_setElem?_some f₁.locals id (liveUninitArrSliceSlot decl) hLtSl₁ with
        | intro _ hS => rw [hS] at hSet₁; cases hSet₁
      | some slots₁' =>
        cases hSet₂ : setElem? f₂.locals id (liveUninitArrSliceSlot decl) with
        | none =>
          cases lt_setElem?_some f₂.locals id (liveUninitArrSliceSlot decl) hLtSl₂ with
          | intro _ hS => rw [hS] at hSet₂; cases hSet₂
        | some slots₂' =>
          have hLM' := s4b_arrSc_localMatch_set_prefix_other pack hLM hLtId hNeArr hSet₁ hSet₂
          refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
            hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
          · intro s₁' h
            dsimp [evalArrSliceStmt] at h
            rw [hDecl] at h; dsimp at h; rw [hSet₁] at h
            have hsEq := StepResult.step.inj h
            refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
            dsimp [evalArrSliceStmt]
            rw [hDeclEq]; dsimp; rw [hSet₂]
          · intro out h
            dsimp [evalArrSliceStmt] at h; rw [hDecl] at h; dsimp at h; rw [hSet₁] at h; cases h
          · intro k h
            dsimp [evalArrSliceStmt] at h; rw [hDecl] at h; dsimp at h; rw [hSet₁] at h; cases h
  | inl hEqArr =>
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageLive id)) =
        mkStorageLiveRange pack.bodySrc.locals.length (1 + pack.len) := by
      dsimp [lowerStmtForArray]
      rw [nat_beq_true hEqArr]
      rfl
    rw [hGen] at hGetGen hLenNext
    have hGenLen : (mkStorageLiveRange pack.bodySrc.locals.length (1 + pack.len)).length = 1 + pack.len :=
      arrSc_mkStorageLiveRange_length pack.bodySrc.locals.length (1 + pack.len)
    have hPos : 0 < 1 + pack.len := by
      rw [Nat.add_comm 1 pack.len]; exact Nat.zero_lt_succ pack.len
    have hGet0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.baseStmt (.storageLive pack.bodySrc.locals.length)) := by
      have h0 := hGetGen 0 (by rw [hGenLen]; exact hPos)
      rw [Nat.add_zero, arrSc_getElem?_mkStorageLiveRange pack.bodySrc.locals.length (1 + pack.len) 0 hPos,
        Nat.add_zero] at h0
      exact h0
    have hDeclLive := arrSc_getElem?_bodyTgt_locals_liveLoc pack
    have hLtLive : pack.bodySrc.locals.length < f₂.locals.length := by
      rw [hLM.2.1, arrSc_bodyTgt_locals_length pack]
      rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
        Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) (4 + pack.len)]
      exact Nat.lt_add_of_pos_right (Nat.lt_of_lt_of_le hPos (Nat.le_add_right _ _))
    cases hSetBase : setElem? f₂.locals pack.bodySrc.locals.length (liveUninitArrSliceSlot (.base .unit)) with
    | none =>
      cases lt_setElem?_some f₂.locals pack.bodySrc.locals.length _ hLtLive with
      | intro _ hS => rw [hS] at hSetBase; cases hSetBase
    | some slotsMid =>
      have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slotsMid }], callerMem := cm } := by
        rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt f₂ cm bbTgt _ hBodyTgt hBbTgt hGet0]
        dsimp [evalArrSliceStmt]
        rw [hDeclLive]; dsimp; rw [hSetBase]; rfl
      let fMid : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slotsMid }
      have hLenMid : pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ fMid.locals.length := by
        change pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ slotsMid.length
        rw [setElem?_length f₂.locals pack.bodySrc.locals.length _ slotsMid hSetBase,
          hLM.2.1, arrSc_bodyTgt_locals_length pack]
        exact nat_le_refl _
      have hStmtsTail : ∀ k : Nat, k < pack.len →
          Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1 + k) =
            some (.baseStmt (.storageLive (pack.bodySrc.locals.length + 1 + (0 + k)))) := by
        intro k hk
        have hk1 : k + 1 < 1 + pack.len := by
          rw [Nat.add_comm 1 pack.len]; exact Nat.succ_lt_succ hk
        have hG := hGetGen (k + 1) (by rw [hGenLen]; exact hk1)
        have hEq1 : f₂.stmtIdx + (k + 1) = f₂.stmtIdx + 1 + k := by
          rw [Nat.add_comm k 1, ← Nat.add_assoc]
        rw [hEq1, arrSc_getElem?_mkStorageLiveRange pack.bodySrc.locals.length (1 + pack.len) (k + 1) hk1] at hG
        have hEq2 : pack.bodySrc.locals.length + (k + 1) = pack.bodySrc.locals.length + 1 + (0 + k) := by
          rw [Nat.zero_add, Nat.add_comm k 1, ← Nat.add_assoc]
        rw [← hEq2]
        exact hG
      cases arrSc_exec_mkStorageLiveRange_elems pack f₂.blockIdx bbTgt cm hBodyP hBbTgt
          pack.len (f₂.stmtIdx + 1) 0 fMid hSame₂ rfl rfl (by rw [Nat.zero_add]; exact nat_le_refl _)
          hLenMid hStmtsTail with
      | intro slots₂' hRest =>
        have hIdxEq : f₂.stmtIdx + 1 + pack.len =
            f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
              (.baseStmt (.storageLive id))).length := by
          rw [hGen, hGenLen, Nat.add_assoc f₂.stmtIdx 1 pack.len, Nat.add_comm 1 pack.len]
        let fEnd : ArrSliceFrame :=
          { f₂ with
            stmtIdx := f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
              (.baseStmt (.storageLive id))).length
            locals := slots₂' }
        have hReach : ReachesNArrSlice pTgt (pack.len + 1) { frames := [f₂], callerMem := cm }
            { frames := [fEnd], callerMem := cm } := by
          change ReachesNArrSlice pTgt (pack.len + 1) { frames := [f₂], callerMem := cm }
            { frames := [{ f₂ with
              stmtIdx := f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
                (.baseStmt (.storageLive id))).length
              locals := slots₂' }], callerMem := cm }
          rw [← hIdxEq]
          exact arrSc_reachesNArrSlice_succ_head hStep0 hRest.1
        have hEvSrc := arrSc_evalStepArrSlice_at_stmt pSrc pack.bodySrc f₁ cm bbSrc _ hBodySrc hBbSrc hStmtSrc
        refine ⟨?_, ?_, ?_⟩
        · intro s₁' hStep
          rw [hEvSrc] at hStep
          dsimp [evalArrSliceStmt] at hStep
          rw [hEqArr, pack.hArrDecl] at hStep
          dsimp at hStep
          have hLtArr : plan.arrLocal < f₁.locals.length := by rw [hLM.1.1]; exact pack.hLocLt
          let newElems := listReplicate pack.len (initElemOptVal pack.elemTy)
          cases hSet₁ : setElem? f₁.locals plan.arrLocal (.liveArray newElems) with
          | none =>
            cases lt_setElem?_some f₁.locals plan.arrLocal (.liveArray newElems) hLtArr with
            | intro _ hS => rw [hS] at hSet₁; cases hSet₁
          | some slots₁' =>
            have hSetEq : setElem? f₁.locals plan.arrLocal
                (liveUninitArrSliceSlot (.array pack.elemTy pack.len)) = some slots₁' := hSet₁
            rw [hSetEq] at hStep
            have hsEq := StepResult.step.inj hStep
            rw [← hsEq]
            have hBasePres := s4b_arrSc_localMatch_set_liveLoc_unit pack hLM hSetBase
            have hLM' : arrSc_LocalMatch pack slots₁' slots₂' := by
              refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_⟩
              · rw [setElem?_length f₁.locals plan.arrLocal _ slots₁' hSet₁, hLM.1.1]
              · intro i hi hNe
                have hLt1 : i < pack.bodySrc.locals.length + 1 + 0 :=
                  Nat.lt_trans hi (Nat.lt_succ_self _)
                rw [hRest.2.2.1 i hLt1, hBasePres.1 i hi, hLM.1.2 i hi hNe,
                  getElem?_setElem?_ne f₁.locals plan.arrLocal i _ slots₁' (fun h => hNe h.symm) hSet₁]
              · rw [hRest.2.1]
                change slotsMid.length = pack.bodyTgt.locals.length
                rw [hBasePres.2.2.2, hLM.2.1]
              · refine ⟨.liveArray newElems,
                  getElem?_setElem?_self f₁.locals plan.arrLocal (.liveArray newElems) slots₁' hSet₁,
                  ?_, ?_, ?_⟩
                · exact list_length_replicate pack.len _
                · have hLt1 : pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + 0 :=
                    Nat.lt_succ_self _
                  rw [hRest.2.2.1 pack.bodySrc.locals.length hLt1,
                    getElem?_setElem?_self f₂.locals pack.bodySrc.locals.length _ slotsMid hSetBase]
                  rfl
                · intro j hj
                  refine ⟨initElemOptVal pack.elemTy,
                    getElem?_replicate pack.len j (initElemOptVal pack.elemTy) hj, ?_⟩
                  have hJ := hRest.2.2.2.1 j hj
                  rw [Nat.zero_add] at hJ
                  exact hJ
              · intro r hr
                have hGe : pack.bodySrc.locals.length + 1 + (0 + pack.len) ≤
                    pack.bodySrc.locals.length + 1 + pack.len + r := by
                  rw [Nat.zero_add]; exact Nat.le_add_right _ r
                rw [hRest.2.2.2.2 _ hGe, hBasePres.2.2.1 r hr]
                exact hLM.2.2.2 r hr
            have hLenNext' : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
                (.baseStmt (.storageLive id))).length =
                (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
                  (bbSrc.statements.take (f₁.stmtIdx + 1))).length := by
              rw [hGen]
              exact hLenNext
            exact arrSc_reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hLeNext hLenNext' hReach hLM'
        · intro out hDone
          rw [hEvSrc] at hDone
          dsimp [evalArrSliceStmt] at hDone
          rw [hEqArr, pack.hArrDecl] at hDone; dsimp at hDone
          cases hSD : setElem? f₁.locals plan.arrLocal (liveUninitArrSliceSlot (.array pack.elemTy pack.len)) with
          | none => rw [hSD] at hDone; cases hDone
          | some _ => rw [hSD] at hDone; cases hDone
        · intro k hFault
          rw [hEvSrc] at hFault
          dsimp [evalArrSliceStmt] at hFault
          rw [hEqArr, pack.hArrDecl] at hFault; dsimp at hFault
          have hLtArr : plan.arrLocal < f₁.locals.length := by rw [hLM.1.1]; exact pack.hLocLt
          cases hSet₁ : setElem? f₁.locals plan.arrLocal (liveUninitArrSliceSlot (.array pack.elemTy pack.len)) with
          | none =>
            cases lt_setElem?_some f₁.locals plan.arrLocal _ hLtArr with
            | intro _ hS => rw [hS] at hSet₁; cases hSet₁
          | some _ => rw [hSet₁] at hFault; cases hFault

private theorem arrSc_sim_stmt_storageDead
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (id : LocalId)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.storageDead id)))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.baseStmt (.storageDead id)) = true)
    (hGetGen : ∀ j : Nat, j < (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageDead id))).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageDead id))) j)
    (hLenNext : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageDead id))).length =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  have hLtId : id < pack.bodySrc.locals.length := nat_blt_lt hBnd
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    getElem?_some_lt bbSrc.statements f₁.stmtIdx _ hStmtSrc
  have hBodyP : Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt := by
    rw [← hSame₂]; exact hBodyTgt
  cases s4b_arrSc_nat_eq_or_ne id plan.arrLocal with
  | inr hNeArr =>
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageDead id)) =
        [.baseStmt (.storageDead id)] := by
      dsimp [lowerStmtForArray]; rw [nat_beq_false hNeArr]; rfl
    rw [hGen] at hGetGen hLenNext
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.baseStmt (.storageDead id)) := by
      have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
    cases hId0 : Nat.beq id 0 with
    | true =>
      refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
        hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
      · intro _ h; dsimp [evalArrSliceStmt] at h; rw [hId0] at h; cases h
      · intro _ h; dsimp [evalArrSliceStmt] at h; rw [hId0] at h; cases h
      · intro k h
        dsimp [evalArrSliceStmt] at h; rw [hId0] at h
        dsimp [evalArrSliceStmt]; rw [hId0]; exact h
    | false =>
      have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtId hNeArr
      cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals id with
      | none =>
        exact False.elim (nat_lt_irrefl id
          (Nat.lt_of_lt_of_le hLtId (getElem?_none_le pack.bodySrc.locals id hDecl)))
      | some decl =>
        rw [hDecl] at hDeclEq
        have hLtSl₁ : id < f₁.locals.length := by rw [hLM.1.1]; exact hLtId
        have hLtSl₂ : id < f₂.locals.length := by
          rw [hLM.2.1]; exact Nat.lt_of_lt_of_le hLtId (s4b_arrSc_le_bodyTgt_locals pack)
        cases hSet₁ : setElem? f₁.locals id (deadArrSliceSlot decl) with
        | none =>
          cases lt_setElem?_some f₁.locals id (deadArrSliceSlot decl) hLtSl₁ with
          | intro _ hS => rw [hS] at hSet₁; cases hSet₁
        | some slots₁' =>
          cases hSet₂ : setElem? f₂.locals id (deadArrSliceSlot decl) with
          | none =>
            cases lt_setElem?_some f₂.locals id (deadArrSliceSlot decl) hLtSl₂ with
            | intro _ hS => rw [hS] at hSet₂; cases hSet₂
          | some slots₂' =>
            have hLM' := s4b_arrSc_localMatch_set_prefix_other pack hLM hLtId hNeArr hSet₁ hSet₂
            refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
              hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
            · intro s₁' h
              dsimp [evalArrSliceStmt] at h
              rw [hId0] at h; dsimp at h; rw [hDecl] at h; dsimp at h; rw [hSet₁] at h
              have hsEq := StepResult.step.inj h
              refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
              dsimp [evalArrSliceStmt]
              rw [hId0]; dsimp; rw [hDeclEq]; dsimp; rw [hSet₂]
            · intro out h
              dsimp [evalArrSliceStmt] at h; rw [hId0] at h; dsimp at h; rw [hDecl] at h; dsimp at h; rw [hSet₁] at h; cases h
            · intro k h
              dsimp [evalArrSliceStmt] at h; rw [hId0] at h; dsimp at h; rw [hDecl] at h; dsimp at h; rw [hSet₁] at h; cases h
  | inl hEqArr =>
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.baseStmt (.storageDead id)) =
        mkStorageDeadRange pack.bodySrc.locals.length (1 + pack.len) := by
      dsimp [lowerStmtForArray]; rw [nat_beq_true hEqArr]; rfl
    rw [hGen] at hGetGen hLenNext
    have hGenLen : (mkStorageDeadRange pack.bodySrc.locals.length (1 + pack.len)).length = 1 + pack.len :=
      arrSc_mkStorageDeadRange_length pack.bodySrc.locals.length (1 + pack.len)
    have hPos : 0 < 1 + pack.len := by
      rw [Nat.add_comm 1 pack.len]; exact Nat.zero_lt_succ pack.len
    have hGet0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.baseStmt (.storageDead pack.bodySrc.locals.length)) := by
      have h0 := hGetGen 0 (by rw [hGenLen]; exact hPos)
      rw [Nat.add_zero, arrSc_getElem?_mkStorageDeadRange pack.bodySrc.locals.length (1 + pack.len) 0 hPos,
        Nat.add_zero] at h0
      exact h0
    have hBaseNe0 : Nat.beq pack.bodySrc.locals.length 0 = false :=
      nat_beq_false (fun h => by
        have hPosB := Nat.lt_trans pack.hArgLt pack.hLocLt
        rw [h] at hPosB; cases hPosB)
    have hIdNe0 : Nat.beq plan.arrLocal 0 = false :=
      nat_beq_false (fun h => by
        have hArgLt := pack.hArgLt
        rw [h] at hArgLt; cases hArgLt)
    have hDeclLive := arrSc_getElem?_bodyTgt_locals_liveLoc pack
    have hLtLive : pack.bodySrc.locals.length < f₂.locals.length := by
      rw [hLM.2.1, arrSc_bodyTgt_locals_length pack]
      rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
        Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) (4 + pack.len)]
      exact Nat.lt_add_of_pos_right (Nat.lt_of_lt_of_le hPos (Nat.le_add_right _ _))
    cases hSetBase : setElem? f₂.locals pack.bodySrc.locals.length (deadArrSliceSlot (.base .unit)) with
    | none =>
      cases lt_setElem?_some f₂.locals pack.bodySrc.locals.length _ hLtLive with
      | intro _ hS => rw [hS] at hSetBase; cases hSetBase
    | some slotsMid =>
      have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slotsMid }], callerMem := cm } := by
        rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt f₂ cm bbTgt _ hBodyTgt hBbTgt hGet0]
        dsimp [evalArrSliceStmt]
        rw [hBaseNe0]; dsimp; rw [hDeclLive]; dsimp; rw [hSetBase]; rfl
      let fMid : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slotsMid }
      have hLenMid : pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ fMid.locals.length := by
        change pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ slotsMid.length
        rw [setElem?_length f₂.locals pack.bodySrc.locals.length _ slotsMid hSetBase,
          hLM.2.1, arrSc_bodyTgt_locals_length pack]
        exact nat_le_refl _
      have hStmtsTail : ∀ k : Nat, k < pack.len →
          Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1 + k) =
            some (.baseStmt (.storageDead (pack.bodySrc.locals.length + 1 + (0 + k)))) := by
        intro k hk
        have hk1 : k + 1 < 1 + pack.len := by
          rw [Nat.add_comm 1 pack.len]; exact Nat.succ_lt_succ hk
        have hG := hGetGen (k + 1) (by rw [hGenLen]; exact hk1)
        have hEq1 : f₂.stmtIdx + (k + 1) = f₂.stmtIdx + 1 + k := by
          rw [Nat.add_comm k 1, ← Nat.add_assoc]
        rw [hEq1, arrSc_getElem?_mkStorageDeadRange pack.bodySrc.locals.length (1 + pack.len) (k + 1) hk1] at hG
        have hEq2 : pack.bodySrc.locals.length + (k + 1) = pack.bodySrc.locals.length + 1 + (0 + k) := by
          rw [Nat.zero_add, Nat.add_comm k 1, ← Nat.add_assoc]
        rw [← hEq2]
        exact hG
      cases arrSc_exec_mkStorageDeadRange_elems pack f₂.blockIdx bbTgt cm hBodyP hBbTgt
          pack.len (f₂.stmtIdx + 1) 0 fMid hSame₂ rfl rfl (by rw [Nat.zero_add]; exact nat_le_refl _)
          hLenMid hStmtsTail with
      | intro slots₂' hRest =>
        have hIdxEq : f₂.stmtIdx + 1 + pack.len =
            f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
              (.baseStmt (.storageDead id))).length := by
          rw [hGen, hGenLen, Nat.add_assoc f₂.stmtIdx 1 pack.len, Nat.add_comm 1 pack.len]
        let fEnd : ArrSliceFrame :=
          { f₂ with
            stmtIdx := f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
              (.baseStmt (.storageDead id))).length
            locals := slots₂' }
        have hReach : ReachesNArrSlice pTgt (pack.len + 1) { frames := [f₂], callerMem := cm }
            { frames := [fEnd], callerMem := cm } := by
          change ReachesNArrSlice pTgt (pack.len + 1) { frames := [f₂], callerMem := cm }
            { frames := [{ f₂ with
              stmtIdx := f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
                (.baseStmt (.storageDead id))).length
              locals := slots₂' }], callerMem := cm }
          rw [← hIdxEq]
          exact arrSc_reachesNArrSlice_succ_head hStep0 hRest.1
        have hEvSrc := arrSc_evalStepArrSlice_at_stmt pSrc pack.bodySrc f₁ cm bbSrc _ hBodySrc hBbSrc hStmtSrc
        refine ⟨?_, ?_, ?_⟩
        · intro s₁' hStep
          rw [hEvSrc] at hStep
          dsimp [evalArrSliceStmt] at hStep
          rw [hEqArr, hIdNe0] at hStep; dsimp at hStep
          rw [pack.hArrDecl] at hStep; dsimp at hStep
          have hLtArr : plan.arrLocal < f₁.locals.length := by rw [hLM.1.1]; exact pack.hLocLt
          cases hSet₁ : setElem? f₁.locals plan.arrLocal (deadArrSliceSlot (.array pack.elemTy pack.len)) with
          | none =>
            cases lt_setElem?_some f₁.locals plan.arrLocal _ hLtArr with
            | intro _ hS => rw [hS] at hSet₁; cases hSet₁
          | some slots₁' =>
            rw [hSet₁] at hStep
            have hsEq := StepResult.step.inj hStep
            rw [← hsEq]
            have hBasePres : (∀ i : Nat, i < pack.bodySrc.locals.length →
                  Trusted.MirSemantics.getElem? slotsMid i = Trusted.MirSemantics.getElem? f₂.locals i) ∧
                (∀ r : Nat, r < 4 + pack.len →
                  Trusted.MirSemantics.getElem? slotsMid (pack.bodySrc.locals.length + 1 + pack.len + r) =
                    Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 1 + pack.len + r)) ∧
                slotsMid.length = f₂.locals.length := by
              refine ⟨?_, ?_, setElem?_length f₂.locals pack.bodySrc.locals.length _ slotsMid hSetBase⟩
              · intro i hi
                have hNe : pack.bodySrc.locals.length ≠ i := fun h => by
                  rw [h] at hi; exact nat_lt_irrefl i hi
                exact getElem?_setElem?_ne f₂.locals pack.bodySrc.locals.length i _ slotsMid hNe hSetBase
              · intro r _
                have hNe : pack.bodySrc.locals.length ≠ pack.bodySrc.locals.length + 1 + pack.len + r := fun h => by
                  have hLt : pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + pack.len + r := by
                    rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
                      Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) r]
                    exact arrSc_lt_add_one_add_add pack.bodySrc.locals.length pack.len r
                  rw [← h] at hLt
                  exact nat_lt_irrefl _ hLt
                exact getElem?_setElem?_ne f₂.locals pack.bodySrc.locals.length _ _ slotsMid hNe hSetBase
            have hLM' : arrSc_LocalMatch pack slots₁' slots₂' := by
              refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_⟩
              · rw [setElem?_length f₁.locals plan.arrLocal _ slots₁' hSet₁, hLM.1.1]
              · intro i hi hNe
                have hLt1 : i < pack.bodySrc.locals.length + 1 + 0 := Nat.lt_trans hi (Nat.lt_succ_self _)
                rw [hRest.2.2.1 i hLt1, hBasePres.1 i hi, hLM.1.2 i hi hNe,
                  getElem?_setElem?_ne f₁.locals plan.arrLocal i _ slots₁' (fun h => hNe h.symm) hSet₁]
              · rw [hRest.2.1]
                change slotsMid.length = pack.bodyTgt.locals.length
                rw [hBasePres.2.2, hLM.2.1]
              · refine ⟨.arrDead,
                  getElem?_setElem?_self f₁.locals plan.arrLocal .arrDead slots₁' hSet₁,
                  ?_, ?_⟩
                · have hLt1 : pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + 0 :=
                    Nat.lt_succ_self _
                  rw [hRest.2.2.1 pack.bodySrc.locals.length hLt1,
                    getElem?_setElem?_self f₂.locals pack.bodySrc.locals.length _ slotsMid hSetBase]
                  rfl
                · intro j hj
                  have hJ := hRest.2.2.2.1 j hj
                  rw [Nat.zero_add] at hJ
                  exact hJ
              · intro r hr
                have hGe : pack.bodySrc.locals.length + 1 + (0 + pack.len) ≤
                    pack.bodySrc.locals.length + 1 + pack.len + r := by
                  rw [Nat.zero_add]; exact Nat.le_add_right _ r
                rw [hRest.2.2.2.2 _ hGe, hBasePres.2.1 r hr]
                exact hLM.2.2.2 r hr
            have hLenNext' : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
                (.baseStmt (.storageDead id))).length =
                (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
                  (bbSrc.statements.take (f₁.stmtIdx + 1))).length := by
              rw [hGen]; exact hLenNext
            exact arrSc_reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hLeNext hLenNext' hReach hLM'
        · intro out hDone
          rw [hEvSrc] at hDone
          dsimp [evalArrSliceStmt] at hDone
          rw [hEqArr, hIdNe0] at hDone; dsimp at hDone
          rw [pack.hArrDecl] at hDone; dsimp at hDone
          cases hSD : setElem? f₁.locals plan.arrLocal (deadArrSliceSlot (.array pack.elemTy pack.len)) with
          | none => rw [hSD] at hDone; cases hDone
          | some _ => rw [hSD] at hDone; cases hDone
        · intro k hFault
          rw [hEvSrc] at hFault
          dsimp [evalArrSliceStmt] at hFault
          rw [hEqArr, hIdNe0] at hFault; dsimp at hFault
          rw [pack.hArrDecl] at hFault; dsimp at hFault
          have hLtArr : plan.arrLocal < f₁.locals.length := by rw [hLM.1.1]; exact pack.hLocLt
          cases hSet₁ : setElem? f₁.locals plan.arrLocal (deadArrSliceSlot (.array pack.elemTy pack.len)) with
          | none =>
            cases lt_setElem?_some f₁.locals plan.arrLocal _ hLtArr with
            | intro _ hS => rw [hS] at hSet₁; cases hSet₁
          | some _ => rw [hSet₁] at hFault; cases hFault

private theorem arrSc_sim_stmt_assign
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (dst : Place) (rval : Rvalue)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.assign dst rval)))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.baseStmt (.assign dst rval)) = true)
    (hChk : checkStmtForArray pack.bodySrc.locals plan.arrLocal pack.elemTy pack.len (.baseStmt (.assign dst rval)) = true)
    (hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (.baseStmt (.assign dst rval)))
    (hLenNext : f₂.stmtIdx + 1 =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
    hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
  · intro s₁' h
    cases hProj : !dst.projection.isEmpty with
    | true =>
      dsimp [evalArrSliceStmt] at h; rw [hProj] at h; cases h
    | false =>
      dsimp [checkStmtForArray] at hChk
      rw [hProj] at hChk
      dsimp at hChk
      have hAndC := (bool_and_eq_true _ _).mp hChk
      have hNeDst : dst.localId ≠ plan.arrLocal := fun hEq => by
        have hT := nat_beq_true hEq; rw [hT] at hAndC; cases hAndC.1
      have hBndAnd := (bool_and_eq_true _ _).mp hBnd
      have hLtDst : dst.localId < pack.bodySrc.locals.length := nat_blt_lt hBndAnd.1
      have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtDst hNeDst
      dsimp [evalArrSliceStmt] at h
      rw [hProj] at h; dsimp at h
      cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst.localId with
      | none => rw [hDecl] at h; cases h
      | some d =>
        rw [hDecl] at hDeclEq
        rw [hDecl] at h
        cases d with
        | array _ _ | sliceView _ => cases h
        | base dstTy =>
          dsimp at h
          cases arrSc_evalArrSliceBaseRvalue_prefix pack hLM.1 dstTy rval hAndC.2 with
          | inl hErrR =>
            cases hErrR with
            | intro _ hk => rw [hk.1] at h; cases h
          | inr hOkR =>
            cases hOkR with
            | intro v h1 => cases h1 with
            | intro slots₁Mid h2 => cases h2 with
            | intro slots₂Mid hR =>
              rw [hR.1] at h; dsimp at h
              cases arrSc_writeArrSliceBasePlace_prefix pack hR.2.2.1 dst.localId hLtDst hNeDst dstTy v with
              | inl hErrW =>
                cases hErrW with
                | intro _ hk => rw [hk.1] at h; cases h
              | inr hOkW =>
                cases hOkW with
                | intro slots₁' h3 => cases h3 with
                | intro slots₂' hW =>
                  rw [hW.1] at h
                  have hsEq := StepResult.step.inj h
                  have hGe : ∀ j : Nat, pack.bodySrc.locals.length ≤ j →
                      Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? f₂.locals j := by
                    intro j hj
                    rw [hW.2.2.2.2.1 j hj, hR.2.2.2.2.1 j hj]
                  have hArr : Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
                      Trusted.MirSemantics.getElem? f₁.locals plan.arrLocal := by
                    rw [hW.2.2.2.2.2.1, hR.2.2.2.2.2.1]
                  have hLen' : slots₂'.length = f₂.locals.length := by
                    rw [hW.2.2.2.1, hR.2.2.2.1]
                  have hLM' := arrSc_localMatch_lift_prefix pack hLM hW.2.2.1 hLen' hGe hArr
                  refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                  dsimp [evalArrSliceStmt]
                  rw [hProj]; dsimp; rw [hDeclEq]; dsimp; rw [hR.2.1]; dsimp; rw [hW.2.1]
  · intro out h
    cases hProj : !dst.projection.isEmpty with
    | true => dsimp [evalArrSliceStmt] at h; rw [hProj] at h; cases h
    | false =>
      dsimp [evalArrSliceStmt] at h; rw [hProj] at h; dsimp at h
      cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst.localId with
      | none => rw [hDecl] at h; cases h
      | some d =>
        rw [hDecl] at h
        cases d with
        | array _ _ | sliceView _ => cases h
        | base dstTy =>
          dsimp at h
          cases hER : evalArrSliceBaseRvalue pack.bodySrc.locals f₁.locals dstTy rval with
          | error _ => rw [hER] at h; cases h
          | ok res =>
            rw [hER] at h; dsimp at h
            cases hEW : writeArrSliceBasePlace res.2 dst.localId dstTy res.1 with
            | error _ => rw [hEW] at h; cases h
            | ok _ => rw [hEW] at h; cases h
  · intro k h
    cases hProj : !dst.projection.isEmpty with
    | true =>
      dsimp [evalArrSliceStmt] at h; rw [hProj] at h
      dsimp [evalArrSliceStmt]; rw [hProj]; exact h
    | false =>
      dsimp [checkStmtForArray] at hChk
      rw [hProj] at hChk; dsimp at hChk
      have hAndC := (bool_and_eq_true _ _).mp hChk
      have hNeDst : dst.localId ≠ plan.arrLocal := fun hEq => by
        have hT := nat_beq_true hEq; rw [hT] at hAndC; cases hAndC.1
      have hBndAnd := (bool_and_eq_true _ _).mp hBnd
      have hLtDst : dst.localId < pack.bodySrc.locals.length := nat_blt_lt hBndAnd.1
      have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtDst hNeDst
      dsimp [evalArrSliceStmt] at h; rw [hProj] at h; dsimp at h
      dsimp [evalArrSliceStmt]; rw [hProj]; dsimp
      cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst.localId with
      | none =>
        rw [hDecl] at h; rw [hDecl] at hDeclEq; rw [hDeclEq]; exact h
      | some d =>
        rw [hDecl] at hDeclEq
        rw [hDeclEq]
        rw [hDecl] at h
        cases d with
        | array _ _ | sliceView _ => exact h
        | base dstTy =>
          dsimp only at h
          dsimp only
          cases arrSc_evalArrSliceBaseRvalue_prefix pack hLM.1 dstTy rval hAndC.2 with
          | inl hErrR =>
            cases hErrR with
            | intro kR hkR => rw [hkR.1] at h; rw [hkR.2]; exact h
          | inr hOkR =>
            cases hOkR with
            | intro v h1 => cases h1 with
            | intro slots₁Mid h2 => cases h2 with
            | intro slots₂Mid hR =>
              rw [hR.1] at h; rw [hR.2.1]; dsimp at h; dsimp
              cases arrSc_writeArrSliceBasePlace_prefix pack hR.2.2.1 dst.localId hLtDst hNeDst dstTy v with
              | inl hErrW =>
                cases hErrW with
                | intro kW hkW => rw [hkW.1] at h; rw [hkW.2]; exact h
              | inr hOkW =>
                cases hOkW with
                | intro _ h3 => cases h3 with
                | intro _ hW => rw [hW.1] at h; cases h

private theorem arrSc_sim_stmt_aggregateArray
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (a : LocalId) (ops : List Operand)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.aggregateArray a ops))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.aggregateArray a ops) = true)
    (hChk : checkStmtForArray pack.bodySrc.locals plan.arrLocal pack.elemTy pack.len (.aggregateArray a ops) = true)
    (hGetGen : ∀ j : Nat, j < (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.aggregateArray a ops)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.aggregateArray a ops)) j)
    (hLenNext : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.aggregateArray a ops)).length =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  have hBndAnd := (bool_and_eq_true _ _).mp hBnd
  have hLtA : a < pack.bodySrc.locals.length := nat_blt_lt hBndAnd.1
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    getElem?_some_lt bbSrc.statements f₁.stmtIdx _ hStmtSrc
  have hBodyP : Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt := by
    rw [← hSame₂]; exact hBodyTgt
  cases s4b_arrSc_nat_eq_or_ne a plan.arrLocal with
  | inr hNeArr =>
    dsimp [checkStmtForArray] at hChk
    rw [nat_beq_false hNeArr] at hChk
    dsimp at hChk
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.aggregateArray a ops) =
        [.aggregateArray a ops] := by
      dsimp [lowerStmtForArray]; rw [nat_beq_false hNeArr]; rfl
    rw [hGen] at hGetGen hLenNext
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.aggregateArray a ops) := by
      have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
    have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtA hNeArr
    refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
      hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
    · intro s₁' h
      dsimp [evalArrSliceStmt] at h
      cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
      | none => rw [hDecl] at h; cases h
      | some d =>
        rw [hDecl] at hDeclEq; rw [hDecl] at h
        cases d with
        | base _ | sliceView _ => cases h
        | array elemTy' len' =>
          dsimp at h
          cases hLenEq : !Nat.beq ops.length len' with
          | true => rw [hLenEq] at h; cases h
          | false =>
            rw [hLenEq] at h; dsimp at h
            cases arrSc_evalArrSliceTypedOps_prefix pack elemTy' ops f₁.locals f₂.locals hLM.1 hChk with
            | inl hErrO =>
              cases hErrO with
              | intro _ hk => rw [hk.1] at h; cases h
            | inr hOkO =>
              cases hOkO with
              | intro vals h1 => cases h1 with
              | intro slots₁Mid h2 => cases h2 with
              | intro slots₂Mid hO =>
                rw [hO.1] at h; dsimp at h
                have hSlMidEq := hO.2.2.2.2.1.2 a hLtA hNeArr
                cases hArrSl : Trusted.MirSemantics.getElem? slots₁Mid a with
                | none => rw [hArrSl] at h; cases h
                | some slA =>
                  rw [hArrSl] at h
                  cases slA with
                  | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
                  | liveArray _ =>
                    dsimp at h
                    have hLtSl₁ : a < slots₁Mid.length := by rw [hO.2.2.2.2.1.1]; exact hLtA
                    have hLtSl₂ : a < slots₂Mid.length := by
                      rw [hO.2.2.2.2.2.1, hLM.2.1]
                      exact Nat.lt_of_lt_of_le hLtA (s4b_arrSc_le_bodyTgt_locals pack)
                    cases hSet₁ : setElem? slots₁Mid a (.liveArray (vals.map some)) with
                    | none =>
                      cases lt_setElem?_some slots₁Mid a (.liveArray (vals.map some)) hLtSl₁ with
                      | intro _ hS => rw [hS] at hSet₁; cases hSet₁
                    | some slots₁' =>
                      cases hSet₂ : setElem? slots₂Mid a (.liveArray (vals.map some)) with
                      | none =>
                        cases lt_setElem?_some slots₂Mid a (.liveArray (vals.map some)) hLtSl₂ with
                        | intro _ hS => rw [hS] at hSet₂; cases hSet₂
                      | some slots₂' =>
                        rw [hSet₁] at h
                        have hsEq := StepResult.step.inj h
                        have hLMMid := arrSc_localMatch_lift_prefix pack hLM hO.2.2.2.2.1 hO.2.2.2.2.2.1
                          hO.2.2.2.2.2.2.1 hO.2.2.2.2.2.2.2.1
                        have hLM' := s4b_arrSc_localMatch_set_prefix_other pack hLMMid hLtA hNeArr hSet₁ hSet₂
                        refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                        dsimp [evalArrSliceStmt]
                        rw [hDeclEq]; dsimp; rw [hLenEq]; dsimp; rw [hO.2.1]; dsimp
                        rw [hSlMidEq, hArrSl]; dsimp; rw [hSet₂]
    · intro out h
      dsimp [evalArrSliceStmt] at h
      cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
      | none => rw [hDecl] at h; cases h
      | some d =>
        rw [hDecl] at h
        cases d with
        | base _ | sliceView _ => cases h
        | array elemTy' len' =>
          dsimp at h
          cases hLenEq : !Nat.beq ops.length len' with
          | true => rw [hLenEq] at h; cases h
          | false =>
            rw [hLenEq] at h; dsimp at h
            cases hEO : evalArrSliceTypedOps pack.bodySrc.locals elemTy' f₁.locals ops with
            | error _ => rw [hEO] at h; cases h
            | ok res =>
              rw [hEO] at h; dsimp at h
              cases hGA : Trusted.MirSemantics.getElem? res.2 a with
              | none => rw [hGA] at h; cases h
              | some slA =>
                rw [hGA] at h
                cases slA with
                | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
                | liveArray _ =>
                  dsimp at h
                  cases hSetD : setElem? res.2 a (.liveArray (res.1.map some)) with
                  | none => rw [hSetD] at h; cases h
                  | some _ => rw [hSetD] at h; cases h
    · intro k h
      dsimp [evalArrSliceStmt] at h
