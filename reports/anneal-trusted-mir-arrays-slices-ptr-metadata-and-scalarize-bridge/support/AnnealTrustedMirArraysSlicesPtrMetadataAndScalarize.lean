private theorem step_mkLivenessCheckStmt_from_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (slots₁ : List ArrSliceSlot) {sLoc k : Nat} {optArr : Option LocalId} {sl₁ : ArrSliceSlot}
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies frame₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks frame₂.blockIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements frame₂.stmtIdx =
      some (mkLivenessCheckStmt (pack.bodySrc.locals.length + 4 * k)))
    (hLM : SliceLocalMatch pack slots₁ frame₂.locals)
    (hFind : findSliceEntry plan.entries sLoc = some (k, optArr))
    (hSlot₁ : Trusted.MirSemantics.getElem? slots₁ sLoc = some sl₁) :
    (sl₁ = .sliceDead →
      evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
        StepResult.fault FaultKind.undefined) ∧
    (∀ optSv, sl₁ = .liveSlice optSv →
      ∃ slots₂',
        evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
          stepStmtNext frame₂ cm slots₂' ∧
        SliceLocalMatch pack slots₁ slots₂') := by
  have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
  have hDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (pack.bodySrc.locals.length + 4 * k) =
      some (.base .unit) := by
    have hG := getElem?_bodyTgt_locals_comp pack hkLt (r := 0) (by decide)
    rw [Nat.add_zero] at hG
    exact hG
  have hEx := hLM.2.2.1 sLoc k optArr hFind
  cases hEx with | intro sl₁' hSl =>
  have hEqSl : sl₁' = sl₁ := by
    have hS : some sl₁' = some sl₁ := by rw [← hSl.1, hSlot₁]
    injection hS
  rw [hEqSl] at hSl
  have hComp := hSl.2
  constructor
  · intro hDead
    rw [hDead] at hComp
    dsimp [SliceCompRel] at hComp
    exact step_mkLivenessCheckStmt_dead pTgt pack.bodyTgt bbTgt frame₂ cm _
      hBodyTgt hBbTgt hStmt hDecl hComp.1
  · intro optSv hLive
    rw [hLive] at hComp
    have hExOv : ∃ ov, Trusted.MirSemantics.getElem? frame₂.locals (pack.bodySrc.locals.length + 4 * k) =
        some (.baseSlot (.live ov)) := by
      cases optSv with
      | none => exact hComp.1
      | some _ => exact hComp.2.2.1
    cases hExOv with | intro ov hOv =>
    have hStep := step_mkLivenessCheckStmt_live pTgt pack.bodyTgt bbTgt frame₂ cm _ ov
      hBodyTgt hBbTgt hStmt hDecl hOv
    cases hStep with | intro slots₂' hStepPair =>
    have hLM' := sliceLocalMatch_set_comp_live0 pack hLM hFind (by rw [hSlot₁, hLive]) hStepPair.1
    exact ⟨slots₂', hStepPair.2, hLM'⟩

private theorem step_readTag_from_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (slots₁ : List ArrSliceSlot) {sLoc k : Nat} {optArr : Option LocalId} {sl₁ : ArrSliceSlot}
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies frame₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks frame₂.blockIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements frame₂.stmtIdx =
      some (mkAssignUse (pack.bodySrc.locals.length + 4 * plan.entries.length)
        (.copy { localId := pack.bodySrc.locals.length + 4 * k + 1, projection := [] })))
    (hLM : SliceLocalMatch pack slots₁ frame₂.locals)
    (hFind : findSliceEntry plan.entries sLoc = some (k, optArr))
    (hSlot₁ : Trusted.MirSemantics.getElem? slots₁ sLoc = some sl₁) :
    (sl₁ = .liveSlice none →
      evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
        StepResult.fault FaultKind.undefined) ∧
    (∀ sv, sl₁ = .liveSlice (some sv) →
      ∃ slots₂',
        evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
          stepStmtNext frame₂ cm slots₂' ∧
        SliceLocalMatch pack slots₁ slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length) =
          some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false
            (BitVec.ofNat 128 (backingTag sv.backing)))))))) := by
  have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
  let scrTag := pack.bodySrc.locals.length + 4 * plan.entries.length
  let srcTag := pack.bodySrc.locals.length + 4 * k + 1
  have hScrDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrTag = some (.base usizeTy) := by
    have hD := getElem?_bodyTgt_locals_scratch pack (r := 0) (by decide)
    rw [Nat.add_zero] at hD
    exact hD
  have hSrcDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals srcTag = some (.base usizeTy) :=
    getElem?_bodyTgt_locals_comp pack hkLt (r := 1) (by decide)
  have hEx := hLM.2.2.1 sLoc k optArr hFind
  cases hEx with | intro sl₁' hSl =>
  have hEqSl : sl₁' = sl₁ := by
    have hS : some sl₁' = some sl₁ := by rw [← hSl.1, hSlot₁]
    injection hS
  rw [hEqSl] at hSl
  have hComp := hSl.2
  constructor
  · intro hNone
    rw [hNone] at hComp
    dsimp [SliceCompRel] at hComp
    exact step_mkAssignUse_copy_base_uninit pTgt pack.bodyTgt bbTgt frame₂ cm scrTag srcTag
      usizeTy usizeTy hBodyTgt hBbTgt hStmt hScrDecl hSrcDecl rfl hComp.2.1
  · intro sv hSome
    rw [hSome] at hComp
    dsimp [SliceCompRel] at hComp
    have hStep := step_mkAssignUse_copy_base_val pTgt pack.bodyTgt bbTgt frame₂ cm scrTag srcTag
      usizeTy usizeTy (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))
      hBodyTgt hBbTgt hStmt hScrDecl hSrcDecl rfl hComp.2.2.2.1
    have hTagLt : backingTag sv.backing < maxUsize := by
      have hMax := maxUsize_eq
      cases sv.backing with
      | dangling => rw [hMax]; change 0 < Nat.pow 2 64; decide
      | arrayLocal _ => rw [hMax]; change 1 < Nat.pow 2 64; decide
    have hChk : (!checkVal (.scalar (ScalarVal.mk IntWidth.isize false
        (BitVec.ofNat 128 (backingTag sv.backing)))) usizeTy) = false := by
      rw [checkVal_usize_of_lt_maxUsize _ hTagLt]
      rfl
    have hScrSlot := hLM.2.2.2 0 (by decide)
    rw [Nat.add_zero] at hScrSlot
    cases hScrSlot with | intro ov hOv =>
    have hLt := getElem?_some_lt frame₂.locals scrTag _ hOv
    have hExSet := lt_setElem?_some frame₂.locals scrTag
      (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) hLt
    cases hExSet with | intro slots₂' hSet₂ =>
    rw [writeArrSliceBasePlace_eq, hChk, hOv, hSet₂] at hStep
    have hSetZero : setElem? frame₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + 0)
        (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) =
        some slots₂' := by
      rw [Nat.add_zero]; exact hSet₂
    have hLM' := sliceLocalMatch_set_scratch pack hLM (r₀ := 0) (by decide)
      (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))) hSetZero
    have hGetTag := getElem?_setElem?_self frame₂.locals scrTag _ slots₂' hSet₂
    exact ⟨slots₂', hStep, hLM', hGetTag⟩

private theorem step_copy_usize_to_scratch
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (slots₁ : List ArrSliceSlot) (rDst : Nat) (hrDst : rDst < 4)
    (src : LocalId) (n : Nat) (hn : n < maxUsize)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies frame₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks frame₂.blockIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements frame₂.stmtIdx =
      some (mkAssignUse (pack.bodySrc.locals.length + 4 * plan.entries.length + rDst)
        (.copy { localId := src, projection := [] })))
    (hLM : SliceLocalMatch pack slots₁ frame₂.locals)
    (hSrcDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals src = some (.base usizeTy))
    (hSrcSlot : Trusted.MirSemantics.getElem? frame₂.locals src =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))))))) :
    ∃ slots₂',
      evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
        stepStmtNext frame₂ cm slots₂' ∧
      SliceLocalMatch pack slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length + rDst) =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))))) := by
  let dst := pack.bodySrc.locals.length + 4 * plan.entries.length + rDst
  have hrLt5 : rDst < 5 := Nat.lt_trans hrDst (by decide)
  have hNe4 : Nat.beq rDst 4 = false := by
    cases rDst with
    | zero => rfl
    | succ r1 =>
      cases r1 with
      | zero => rfl
      | succ r2 =>
        cases r2 with
        | zero => rfl
        | succ r3 =>
          cases r3 with
          | zero => rfl
          | succ r4 => exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hrDst)))))
  have hDstDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some (.base usizeTy) := by
    have hD := getElem?_bodyTgt_locals_scratch pack hrLt5
    rw [hNe4] at hD
    exact hD
  have hStep := step_mkAssignUse_copy_base_val pTgt pack.bodyTgt bbTgt frame₂ cm dst src
    usizeTy usizeTy (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))
    hBodyTgt hBbTgt hStmt hDstDecl hSrcDecl rfl hSrcSlot
  have hChk : (!checkVal (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n))) usizeTy) = false := by
    rw [checkVal_usize_of_lt_maxUsize n hn]; rfl
  have hDstSlot := hLM.2.2.2 rDst hrLt5
  cases hDstSlot with | intro ov hOv =>
  have hLt := getElem?_some_lt frame₂.locals dst _ hOv
  have hExSet := lt_setElem?_some frame₂.locals dst
    (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))))) hLt
  cases hExSet with | intro slots₂' hSet₂ =>
  rw [writeArrSliceBasePlace_eq, hChk, hOv, hSet₂] at hStep
  have hLM' := sliceLocalMatch_set_scratch pack hLM hrLt5
    (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))) hSet₂
  exact ⟨slots₂', hStep, hLM', getElem?_setElem?_self frame₂.locals dst _ slots₂' hSet₂⟩

private theorem step_const_usize_to_scratch
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
