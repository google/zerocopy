    have hLt := getElem?_some_lt frame₂.locals dst _ hOv
    have hExSet := lt_setElem?_some frame₂.locals dst
      (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b))))))) hLt
    cases hExSet with | intro slots₂' hSet₂ =>
    rw [writeArrSliceBasePlace_eq, hChk, hOv, hSet₂] at hBin
    have hLM' := sliceLocalMatch_set_scratch pack hLM hrLt5
      (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b))))) hSet₂
    exact ⟨slots₂', hBin, hLM', getElem?_setElem?_self frame₂.locals dst _ slots₂' hSet₂⟩

private theorem step_subUnchecked_move_from_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
