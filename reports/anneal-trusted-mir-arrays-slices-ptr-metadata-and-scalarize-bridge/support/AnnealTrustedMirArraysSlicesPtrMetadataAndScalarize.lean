  | readArrayConst d₁ a₁ i₁ m₁ =>
    cases b with
    | readArrayConst d₂ a₂ i₂ m₂ =>
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      have h3 := (bool_and_eq_true _ _).mp h2.1
      rw [nat_beq_eq d₁ d₂ h3.1, nat_beq_eq a₁ a₂ h3.2,
