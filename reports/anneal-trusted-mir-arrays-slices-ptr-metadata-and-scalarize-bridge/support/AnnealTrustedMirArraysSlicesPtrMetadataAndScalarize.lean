    | _ => cases h

private theorem arrSliceStmtEq_refl (a : ArrSliceStmt) : arrSliceStmtEq a a = true := by
  cases a with
  | baseStmt s => exact stmtEq_refl s
  | aggregateArray a os =>
    change (Nat.beq a a && listRel operandEq os os) = true
    rw [nat_beq_refl a, listRel_refl operandEq_refl os]
    rfl
  | repeatArray a o =>
    change (Nat.beq a a && operandEq o o) = true
    rw [nat_beq_refl a, operandEq_refl o]
    rfl
  | arrayLivenessCheck a => exact nat_beq_refl a
  | readArrayConst d a i m =>
    change (((Nat.beq d d && Nat.beq a a) && Nat.beq i i) && boolEq m m) = true
    rw [nat_beq_refl d, nat_beq_refl a, nat_beq_refl i, boolEq_refl m]
    rfl
  | writeArrayConst a i r =>
    change ((Nat.beq a a && Nat.beq i i) && rvalueEq r r) = true
    rw [nat_beq_refl a, nat_beq_refl i, rvalueEq_refl r]
    rfl
  | unsizeArrayToSlice s a =>
    change (Nat.beq s s && Nat.beq a a) = true
    rw [nat_beq_refl s, nat_beq_refl a]
    rfl
  | sliceFromRawParts s o =>
    change (Nat.beq s s && operandEq o o) = true
    rw [nat_beq_refl s, operandEq_refl o]
    rfl
  | subslice d s f t e =>
    change ((((Nat.beq d d && Nat.beq s s) && Nat.beq f f) && Nat.beq t t) && boolEq e e) = true
    rw [nat_beq_refl d, nat_beq_refl s, nat_beq_refl f, nat_beq_refl t, boolEq_refl e]
    rfl
  | ptrMetadata d s =>
    change (Nat.beq d d && Nat.beq s s) = true
    rw [nat_beq_refl d, nat_beq_refl s]
    rfl

