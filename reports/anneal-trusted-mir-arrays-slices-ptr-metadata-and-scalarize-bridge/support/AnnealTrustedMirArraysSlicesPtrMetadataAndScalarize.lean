/-! ## Basic Boolean, Nat, Option, and BitVec Helpers -/

private theorem bool_and_eq_true (a b : Bool) : (a && b) = true ↔ a = true ∧ b = true := by
  cases a <;> cases b <;> simp

private theorem bool_and_eq_false (a b : Bool) : (a && b) = false ↔ a = false ∨ b = false := by
  cases a <;> cases b <;> simp

private theorem bool_or_eq_true (a b : Bool) : (a || b) = true ↔ a = true ∨ b = true := by
  cases a <;> cases b <;> simp

private theorem bool_or_eq_false (a b : Bool) : (a || b) = false ↔ a = false ∧ b = false := by
  cases a <;> cases b <;> simp

private theorem bool_not_eq_true (a : Bool) : (!a) = true ↔ a = false := by
  cases a <;> simp

private theorem bool_not_eq_false (a : Bool) : (!a) = false ↔ a = true := by
  cases a <;> simp

private theorem boolEq_eq (a b : Bool) (h : boolEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem boolEq_refl (a : Bool) : boolEq a a = true := by
  cases a <;> rfl

private theorem bool_beq_eq (a b : Bool) (h : (a == b) = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem bool_beq_refl (a : Bool) : (a == a) = true := by
  cases a <;> rfl

private theorem optNatEq_eq (a b : Option Nat) (h : optNatEq a b = true) : a = b := by
  cases a with
  | none =>
    cases b with
    | none => rfl
    | some _ => cases h
  | some x =>
    cases b with
    | none => cases h
    | some y =>
      have hxy : x = y := Nat.eq_of_beq_eq_true h
      rw [hxy]

private theorem optNatEq_refl (a : Option Nat) : optNatEq a a = true := by
  cases a with
  | none => rfl
  | some x => exact Nat.beq_refl x

private theorem nat_beq_eq (a b : Nat) (h : Nat.beq a b = true) : a = b :=
  Nat.eq_of_beq_eq_true h

private theorem nat_beq_refl (a : Nat) : Nat.beq a a = true :=
  Nat.beq_refl a

private theorem nat_beq_true {a b : Nat} (h : a = b) : Nat.beq a b = true := by
  rw [h]
  exact Nat.beq_refl b

private theorem nat_beq_false {a b : Nat} (h : a ≠ b) : Nat.beq a b = false := by
  cases hEq : Nat.beq a b with
  | false => rfl
  | true =>
    have hab : a = b := Nat.eq_of_beq_eq_true hEq
    exact False.elim (h hab)

private theorem nat_beq_comm (a b : Nat) : Nat.beq a b = Nat.beq b a := by
  cases h1 : Nat.beq a b with
  | true =>
    have hab : a = b := Nat.eq_of_beq_eq_true h1
    rw [hab, Nat.beq_refl]
  | false =>
    cases h2 : Nat.beq b a with
    | false => rfl
    | true =>
      have hba : b = a := Nat.eq_of_beq_eq_true h2
      rw [hba, Nat.beq_refl] at h1
      cases h1

private theorem nat_blt_lt {a b : Nat} (h : Nat.blt a b = true) : a < b :=
  Nat.le_of_ble_eq_true h

private theorem lt_nat_blt {a b : Nat} (h : a < b) : Nat.blt a b = true :=
  Nat.ble_eq_true_of_le h

private theorem nat_blt_false_le {a b : Nat} (h : Nat.blt a b = false) : b ≤ a := by
  cases Nat.lt_or_ge a b with
  | inl hLt =>
    have hT := lt_nat_blt hLt
    rw [hT] at h
    cases h
  | inr hGe => exact hGe

private theorem nat_ble_le {a b : Nat} (h : Nat.ble a b = true) : a ≤ b :=
  Nat.le_of_ble_eq_true h

private theorem le_nat_ble {a b : Nat} (h : a ≤ b) : Nat.ble a b = true :=
  Nat.ble_eq_true_of_le h

private theorem nat_ble_false_lt {a b : Nat} (h : Nat.ble a b = false) : b < a := by
  cases Nat.lt_or_ge b a with
  | inl hLt => exact hLt
  | inr hGe =>
    have hT := le_nat_ble hGe
    rw [hT] at h
    cases h

private theorem nat_lt_irrefl (a : Nat) : ¬ (a < a) :=
  Nat.lt_irrefl a

private theorem nat_lt_trans {a b c : Nat} (h1 : a < b) (h2 : b < c) : a < c :=
  Nat.lt_trans h1 h2

private theorem nat_le_refl (a : Nat) : a ≤ a :=
  Nat.le_refl a

private theorem nat_le_trans {a b c : Nat} (h1 : a ≤ b) (h2 : b ≤ c) : a ≤ c :=
  Nat.le_trans h1 h2

private theorem nat_le_antisymm {a b : Nat} (h1 : a ≤ b) (h2 : b ≤ a) : a = b :=
  Nat.le_antisymm h1 h2

private theorem nat_add_lt_of_lt_left {a b c : Nat} (h : a + b < c) : a < c :=
  Nat.lt_of_le_of_lt (Nat.le_add_right a b) h

private theorem nat_add_lt_of_lt_right {a b c : Nat} (h : a + b < c) : b < c :=
  Nat.lt_of_le_of_lt (Nat.le_add_left b a) h

private theorem nat_pow_two_pos : ∀ n : Nat, 0 < Nat.pow 2 n
  | 0 => Nat.zero_lt_succ 0
  | n + 1 => by
    change 0 < Nat.pow 2 n * 2
    rw [Nat.mul_two]
    exact Nat.lt_trans (nat_pow_two_pos n) (Nat.lt_add_of_pos_right (nat_pow_two_pos n))

private theorem nat_pow_two_succ_gt (n : Nat) : Nat.pow 2 n < Nat.pow 2 (n + 1) := by
  change Nat.pow 2 n < Nat.pow 2 n * 2
  rw [Nat.mul_two]
  exact Nat.lt_add_of_pos_right (nat_pow_two_pos n)

private theorem nat_pow_two_add_succ_gt (m : Nat) :
    ∀ k : Nat, Nat.pow 2 m < Nat.pow 2 (m + (k + 1))
  | 0 => nat_pow_two_succ_gt m
  | k + 1 =>
    Nat.lt_trans (nat_pow_two_add_succ_gt m k) (nat_pow_two_succ_gt (m + (k + 1)))

private theorem nat_pow_two_mono_lt (m n : Nat) (h : m < n) : Nat.pow 2 m < Nat.pow 2 n := by
  have hDiff : 0 < n - m := Nat.sub_pos_of_lt h
  have hDecomp : m + ((n - m - 1) + 1) = n := by
    rw [Nat.sub_add_cancel hDiff, Nat.add_sub_of_le (Nat.le_of_lt h)]
  rw [← hDecomp]
  exact nat_pow_two_add_succ_gt m (n - m - 1)

private theorem nat_pow_two_64_lt_128 : Nat.pow 2 64 < Nat.pow 2 128 :=
  nat_pow_two_add_succ_gt 64 63

private theorem maxUsize_lt_pow128 : maxUsize < Nat.pow 2 128 :=
  nat_pow_two_64_lt_128

private theorem bitVec_beq_eq {n : Nat} (a b : BitVec n) (h : (a == b) = true) : a = b :=
  eq_of_beq h

private theorem bitVec_beq_refl {n : Nat} (a : BitVec n) : (a == a) = true :=
  beq_self_eq_true a

private theorem bitVec_ofNat_toNat_eq_mod (m n : Nat) :
    (BitVec.ofNat m n).toNat = Nat.mod n (Nat.pow 2 m) := rfl

private theorem bitVec_ofNat_toNat_of_lt {n m : Nat} (h : n < Nat.pow 2 m) :
    (BitVec.ofNat m n).toNat = n := by
  rw [bitVec_ofNat_toNat_eq_mod m n]
  exact Nat.mod_eq_of_lt h

private theorem truncateBits_isize_of_lt_maxUsize (n : Nat) (h : n < maxUsize) :
    truncateBits .isize (BitVec.ofNat 128 n) = BitVec.ofNat 128 n := by
  have h128 : n < Nat.pow 2 128 := Nat.lt_trans h maxUsize_lt_pow128
  unfold truncateBits bvExtractLsb bvExtractLsb' bvZeroExtend
  dsimp [IntWidth.bitWidth, IntWidth.byteSize]
  rw [bitVec_ofNat_toNat_of_lt h128]
  change BitVec.ofNat 128 (BitVec.ofNat 64 n).toNat = BitVec.ofNat 128 n
  rw [bitVec_ofNat_toNat_of_lt h]

private theorem checkVal_usize_of_lt_maxUsize (n : Nat) (h : n < maxUsize) :
    checkVal (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩) usizeTy = true := by
  unfold checkVal Val.ty? ScalarVal.wf
  dsimp [usizeTy]
  rw [truncateBits_isize_of_lt_maxUsize n h]
  rw [bitVec_beq_refl (BitVec.ofNat 128 n)]
  rfl

private theorem evalConstLit_usizeConst_of_lt_maxUsize (n : Nat) (h : n < maxUsize) :
    evalConstLit usizeTy (.scalar (BitVec.ofNat 128 n)) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩) := by
  unfold evalConstLit
  dsimp [usizeTy]
  rw [truncateBits_isize_of_lt_maxUsize n h]
  have hb : (BitVec.ofNat 128 n != BitVec.ofNat 128 n) = false := by
    have hr := bitVec_beq_refl (BitVec.ofNat 128 n)
    change (!(BitVec.ofNat 128 n == BitVec.ofNat 128 n)) = false
    rw [hr]
    rfl
  rw [hb]
  rfl

private theorem evalUsizeOperand_usizeConst_of_lt_maxUsize
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (n : Nat) (h : n < maxUsize) :
    evalUsizeOperand decls slots (usizeConst n) = .ok (n, slots) := by
  unfold evalUsizeOperand evalArrSliceTypedOperand evalArrSliceBaseOperandToSlot
  dsimp [usizeConst]
  rw [evalConstLit_usizeConst_of_lt_maxUsize n h]
  have hCheck : checkVal (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩) usizeTy = true :=
    checkVal_usize_of_lt_maxUsize n h
  change
    (match
      if (!MirTy.beq usizeTy usizeTy) = true then
        Except.error FaultKind.unsupported
      else if checkVal (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩) usizeTy = true then
        Except.ok (Val.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩, slots)
      else
        Except.error FaultKind.unsupported with
    | Except.error k => Except.error k
    | Except.ok (Val.scalar sv, slots') => Except.ok (sv.bits.toNat, slots')
    | Except.ok (_, _) => Except.error FaultKind.unsupported) = Except.ok (n, slots)
  have hMir : (!MirTy.beq usizeTy usizeTy) = false := rfl
  rw [hMir]
  dsimp
  rw [hCheck]
  dsimp
  have h128 : n < Nat.pow 2 128 := Nat.lt_trans h maxUsize_lt_pow128
  rw [bitVec_ofNat_toNat_of_lt h128]

/-! ## String and AST Structural Equality Reflection -/

private theorem list_beq_eq {α : Type} [BEq α]
    (hElem : ∀ x y : α, (x == y) = true → x = y) :
    ∀ xs ys : List α, List.beq xs ys = true → xs = ys
  | [], [], _ => rfl
  | [], _ :: _, h => by cases h
  | _ :: _, [], h => by cases h
  | x :: xs, y :: ys, h => by
    have hAnd := (bool_and_eq_true (x == y) (List.beq xs ys)).mp h
    have hx : x = y := hElem x y hAnd.1
    have hxs : xs = ys := list_beq_eq hElem xs ys hAnd.2
    rw [hx, hxs]

private theorem list_beq_refl {α : Type} [BEq α]
    (hElem : ∀ x : α, (x == x) = true) :
    ∀ xs : List α, List.beq xs xs = true
  | [] => rfl
  | x :: xs => by
    change ((x == x) && List.beq xs xs) = true
    rw [hElem x, list_beq_refl hElem xs]
    rfl

private theorem uint8_beq_eq (a b : UInt8) (h : (a == b) = true) : a = b :=
  eq_of_beq h

private theorem uint8_beq_refl (a : UInt8) : (a == a) = true :=
  beq_self_eq_true a

private theorem stringBeq_eq (a b : String) (h : stringBeq a b = true) : a = b := by
  unfold stringBeq at h
  have hList : a.toByteArray.data.toList = b.toByteArray.data.toList :=
    list_beq_eq uint8_beq_eq a.toByteArray.data.toList b.toByteArray.data.toList h
  cases a with
  | ofByteArray ba1 p1 =>
    cases b with
    | ofByteArray ba2 p2 =>
      cases ba1 with
      | mk d1 =>
        cases ba2 with
        | mk d2 =>
          cases d1 with
          | mk l1 =>
            cases d2 with
            | mk l2 =>
              dsimp at hList
              subst hList
              rfl

private theorem stringBeq_refl (a : String) : stringBeq a a = true := by
  unfold stringBeq
  exact list_beq_refl uint8_beq_refl a.toByteArray.data.toList

private theorem intWidth_beq_eq (a b : IntWidth) (h : IntWidth.beq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem intWidth_beq_refl (a : IntWidth) : IntWidth.beq a a = true := by
  cases a <;> rfl

private theorem mutability_beq_eq (a b : Mutability) (h : Mutability.beq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem mutability_beq_refl (a : Mutability) : Mutability.beq a a = true := by
  cases a <;> rfl

private theorem natListBeq_eq : ∀ xs ys : List Nat, natListBeq xs ys = true → xs = ys
  | [], [], _ => rfl
  | [], _ :: _, h => by cases h
  | _ :: _, [], h => by cases h
  | x :: xs, y :: ys, h => by
    have hAnd := (bool_and_eq_true (Nat.beq x y) (natListBeq xs ys)).mp h
    have hx : x = y := nat_beq_eq x y hAnd.1
    have hxs : xs = ys := natListBeq_eq xs ys hAnd.2
    rw [hx, hxs]

private theorem natListBeq_refl : ∀ xs : List Nat, natListBeq xs xs = true
  | [] => rfl
  | x :: xs => by
    change (Nat.beq x x && natListBeq xs xs) = true
    rw [nat_beq_refl x, natListBeq_refl xs]
    rfl

private theorem enumTagRepr_beq_eq (a b : EnumTagRepr)
    (h : EnumTagRepr.beq a b = true) : a = b := by
  cases a with
  | zeroSized =>
    cases b with
    | zeroSized => rfl
    | scalar _ _ => cases h
  | scalar w₁ s₁ =>
    cases b with
    | zeroSized => cases h
    | scalar w₂ s₂ =>
      have hAnd := (bool_and_eq_true (IntWidth.beq w₁ w₂) (s₁ == s₂)).mp h
      have hw := intWidth_beq_eq w₁ w₂ hAnd.1
      have hs := bool_beq_eq s₁ s₂ hAnd.2
      rw [hw, hs]

private theorem enumTagRepr_beq_refl (a : EnumTagRepr) : EnumTagRepr.beq a a = true := by
  cases a with
  | zeroSized => rfl
  | scalar w s =>
    change (IntWidth.beq w w && (s == s)) = true
    rw [intWidth_beq_refl w, bool_beq_refl s]
    rfl

private theorem enumTy_beq_eq (a b : EnumTy) (h : EnumTy.beq a b = true) : a = b := by
  cases a with
  | mk id₁ dw₁ ds₁ tr₁ dsL₁ =>
    cases b with
    | mk id₂ dw₂ ds₂ tr₂ dsL₂ =>
      change ((((Nat.beq id₁ id₂ && IntWidth.beq dw₁ dw₂) && (ds₁ == ds₂)) &&
        EnumTagRepr.beq tr₁ tr₂) && natListBeq dsL₁ dsL₂) = true at h
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      have h3 := (bool_and_eq_true _ _).mp h2.1
      have h4 := (bool_and_eq_true _ _).mp h3.1
      have hid := nat_beq_eq id₁ id₂ h4.1
      have hdw := intWidth_beq_eq dw₁ dw₂ h4.2
      have hds := bool_beq_eq ds₁ ds₂ h3.2
      have htr := enumTagRepr_beq_eq tr₁ tr₂ h2.2
      have hdl := natListBeq_eq dsL₁ dsL₂ h1.2
      rw [hid, hdw, hds, htr, hdl]

private theorem enumTy_beq_refl (a : EnumTy) : EnumTy.beq a a = true := by
  cases a with
  | mk id dw ds tr dsL =>
    change ((((Nat.beq id id && IntWidth.beq dw dw) && (ds == ds)) &&
      EnumTagRepr.beq tr tr) && natListBeq dsL dsL) = true
    rw [nat_beq_refl id, intWidth_beq_refl dw, bool_beq_refl ds,
      enumTagRepr_beq_refl tr, natListBeq_refl dsL]
    rfl

mutual
  private theorem mirTy_beq_eq : ∀ t₁ t₂ : MirTy, MirTy.beq t₁ t₂ = true → t₁ = t₂
    | .bool, .bool, _ => rfl
    | .int w₁ s₁, .int w₂ s₂, h => by
      have hAnd := (bool_and_eq_true (IntWidth.beq w₁ w₂) (s₁ == s₂)).mp h
      rw [intWidth_beq_eq w₁ w₂ hAnd.1, bool_beq_eq s₁ s₂ hAnd.2]
    | .unit, .unit, _ => rfl
    | .never, .never, _ => rfl
    | .enum ety₁, .enum ety₂, h => by
      rw [enumTy_beq_eq ety₁ ety₂ h]
    | .tuple fs₁, .tuple fs₂, h => by
      have hFs := mirTy_beqList_eq fs₁ fs₂ h
      rw [hFs]
    | .ref m₁ p₁, .ref m₂ p₂, h => by
      have hAnd := (bool_and_eq_true (Mutability.beq m₁ m₂) (MirTy.beq p₁ p₂)).mp h
      rw [mutability_beq_eq m₁ m₂ hAnd.1, mirTy_beq_eq p₁ p₂ hAnd.2]
    | .rawPtr m₁ p₁, .rawPtr m₂ p₂, h => by
      have hAnd := (bool_and_eq_true (Mutability.beq m₁ m₂) (MirTy.beq p₁ p₂)).mp h
      rw [mutability_beq_eq m₁ m₂ hAnd.1, mirTy_beq_eq p₁ p₂ hAnd.2]
    | .unsupported, .unsupported, _ => rfl
    | .bool, .int _ _, h | .bool, .unit, h | .bool, .never, h
    | .bool, .enum _, h | .bool, .tuple _, h | .bool, .ref _ _, h
    | .bool, .rawPtr _ _, h | .bool, .unsupported, h => by cases h
    | .int _ _, .bool, h | .int _ _, .unit, h | .int _ _, .never, h
    | .int _ _, .enum _, h | .int _ _, .tuple _, h | .int _ _, .ref _ _, h
    | .int _ _, .rawPtr _ _, h | .int _ _, .unsupported, h => by cases h
    | .unit, .bool, h | .unit, .int _ _, h | .unit, .never, h
    | .unit, .enum _, h | .unit, .tuple _, h | .unit, .ref _ _, h
    | .unit, .rawPtr _ _, h | .unit, .unsupported, h => by cases h
    | .never, .bool, h | .never, .int _ _, h | .never, .unit, h
    | .never, .enum _, h | .never, .tuple _, h | .never, .ref _ _, h
    | .never, .rawPtr _ _, h | .never, .unsupported, h => by cases h
    | .enum _, .bool, h | .enum _, .int _ _, h | .enum _, .unit, h
    | .enum _, .never, h | .enum _, .tuple _, h | .enum _, .ref _ _, h
    | .enum _, .rawPtr _ _, h | .enum _, .unsupported, h => by cases h
    | .tuple _, .bool, h | .tuple _, .int _ _, h | .tuple _, .unit, h
    | .tuple _, .never, h | .tuple _, .enum _, h | .tuple _, .ref _ _, h
    | .tuple _, .rawPtr _ _, h | .tuple _, .unsupported, h => by cases h
    | .ref _ _, .bool, h | .ref _ _, .int _ _, h | .ref _ _, .unit, h
    | .ref _ _, .never, h | .ref _ _, .enum _, h | .ref _ _, .tuple _, h
    | .ref _ _, .rawPtr _ _, h | .ref _ _, .unsupported, h => by cases h
    | .rawPtr _ _, .bool, h | .rawPtr _ _, .int _ _, h | .rawPtr _ _, .unit, h
    | .rawPtr _ _, .never, h | .rawPtr _ _, .enum _, h | .rawPtr _ _, .tuple _, h
    | .rawPtr _ _, .ref _ _, h | .rawPtr _ _, .unsupported, h => by cases h
    | .unsupported, .bool, h | .unsupported, .int _ _, h | .unsupported, .unit, h
    | .unsupported, .never, h | .unsupported, .enum _, h | .unsupported, .tuple _, h
    | .unsupported, .ref _ _, h | .unsupported, .rawPtr _ _, h => by cases h

  private theorem mirTy_beqList_eq : ∀ fs₁ fs₂ : List MirTy, MirTy.beqList fs₁ fs₂ = true → fs₁ = fs₂
    | [], [], _ => rfl
    | [], _ :: _, h => by cases h
    | _ :: _, [], h => by cases h
    | x :: xs, y :: ys, h => by
      have hAnd := (bool_and_eq_true (MirTy.beq x y) (MirTy.beqList xs ys)).mp h
      rw [mirTy_beq_eq x y hAnd.1, mirTy_beqList_eq xs ys hAnd.2]
end

mutual
  private theorem mirTy_beq_refl : ∀ t : MirTy, MirTy.beq t t = true
    | .bool => rfl
    | .int w s => by
      change (IntWidth.beq w w && (s == s)) = true
      rw [intWidth_beq_refl w, bool_beq_refl s]
      rfl
    | .unit => rfl
    | .never => rfl
    | .enum ety => enumTy_beq_refl ety
    | .tuple fs => mirTy_beqList_refl fs
    | .ref m p => by
      change (Mutability.beq m m && MirTy.beq p p) = true
      rw [mutability_beq_refl m, mirTy_beq_refl p]
      rfl
    | .rawPtr m p => by
      change (Mutability.beq m m && MirTy.beq p p) = true
      rw [mutability_beq_refl m, mirTy_beq_refl p]
      rfl
    | .unsupported => rfl

  private theorem mirTy_beqList_refl : ∀ fs : List MirTy, MirTy.beqList fs fs = true
    | [] => rfl
    | x :: xs => by
      change (MirTy.beq x x && MirTy.beqList xs xs) = true
      rw [mirTy_beq_refl x, mirTy_beqList_refl xs]
      rfl
end

/-! ## `listRel`, List Lookup, Update, Map, Take/Drop, Replicate, FlatMap -/

private theorem listRel_eq_of_eq {α : Type} {r : α → α → Bool}
    (hElem : ∀ x y : α, r x y = true → x = y) :
    ∀ xs ys : List α, listRel r xs ys = true → xs = ys
  | [], [], _ => rfl
  | [], _ :: _, h => by cases h
  | _ :: _, [], h => by cases h
  | x :: xs, y :: ys, h => by
    have hAnd := (bool_and_eq_true (r x y) (listRel r xs ys)).mp h
    rw [hElem x y hAnd.1, listRel_eq_of_eq hElem xs ys hAnd.2]

private theorem listRel_refl {α : Type} {r : α → α → Bool}
    (hElem : ∀ x : α, r x x = true) :
    ∀ xs : List α, listRel r xs xs = true
  | [] => rfl
  | x :: xs => by
    change (r x x && listRel r xs xs) = true
    rw [hElem x, listRel_refl hElem xs]
    rfl

private theorem listRel_length {α β : Type} {r : α → β → Bool} :
    ∀ xs : List α, ∀ ys : List β, listRel r xs ys = true → xs.length = ys.length
  | [], [], _ => rfl
  | [], _ :: _, h => by cases h
  | _ :: _, [], h => by cases h
  | _ :: xs, _ :: ys, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    exact congrArg Nat.succ (listRel_length xs ys hAnd.2)

private theorem listRel_getElem? {α β : Type} {r : α → β → Bool} :
    ∀ xs : List α, ∀ ys : List β, listRel r xs ys = true →
      ∀ (i : Nat) (x : α), Trusted.MirSemantics.getElem? xs i = some x →
        ∃ y : β, Trusted.MirSemantics.getElem? ys i = some y ∧ r x y = true
  | [], _, _, _, _, hGet => by cases hGet
  | _ :: _, [], hRel, _, _, _ => by cases hRel
  | x :: xs, y :: ys, hRel, 0, x', hGet => by
    have hAnd := (bool_and_eq_true (r x y) (listRel r xs ys)).mp hRel
    cases hGet
    exact ⟨y, rfl, hAnd.1⟩
  | _ :: xs, _ :: ys, hRel, i + 1, x', hGet => by
    have hAnd := (bool_and_eq_true _ (listRel r xs ys)).mp hRel
    exact listRel_getElem? xs ys hAnd.2 i x' hGet

private theorem listRel_iff_forall {α β : Type} (r : α → β → Bool) :
    ∀ xs : List α, ∀ ys : List β,
      listRel r xs ys = true ↔
        xs.length = ys.length ∧
          ∀ (i : Nat) (x : α) (y : β),
            Trusted.MirSemantics.getElem? xs i = some x →
            Trusted.MirSemantics.getElem? ys i = some y →
            r x y = true := by
  intro xs
  induction xs with
  | nil =>
    intro ys
    cases ys with
    | nil =>
      constructor
      · intro _
        exact ⟨rfl, fun _ _ _ h _ => by cases h⟩
      · intro _
        rfl
    | cons _ _ =>
      constructor
      · intro h
        cases h
      · intro h
        cases h.1
  | cons x xs ih =>
    intro ys
    cases ys with
    | nil =>
      constructor
      · intro h
        cases h
      · intro h
        cases h.1
    | cons y ys =>
      constructor
      · intro h
        have hAnd := (bool_and_eq_true (r x y) (listRel r xs ys)).mp h
        have hIh := (ih ys).mp hAnd.2
        refine ⟨congrArg Nat.succ hIh.1, ?_⟩
        intro i a b hA hB
        cases i with
        | zero =>
          cases hA
          cases hB
          exact hAnd.1
        | succ j =>
          exact hIh.2 j a b hA hB
      · intro h
        have hLen : xs.length = ys.length := Nat.succ.inj h.1
        have hTail : ∀ (i : Nat) (a : α) (b : β),
            Trusted.MirSemantics.getElem? xs i = some a →
            Trusted.MirSemantics.getElem? ys i = some b →
            r a b = true := by
          intro i a b hA hB
          exact h.2 (i + 1) a b hA hB
        have hSub := (ih ys).mpr ⟨hLen, hTail⟩
        have hHead : r x y = true := h.2 0 x y rfl rfl
        change (r x y && listRel r xs ys) = true
        rw [hHead, hSub]
        rfl

private theorem listRel_append {α β : Type} {r : α → β → Bool} :
    ∀ (xs₁ xs₂ : List α) (ys₁ ys₂ : List β),
      listRel r xs₁ ys₁ = true → listRel r xs₂ ys₂ = true →
      listRel r (xs₁ ++ xs₂) (ys₁ ++ ys₂) = true
  | [], _, [], _, _, h2 => h2
  | [], _, _ :: _, _, h1, _ => by cases h1
  | _ :: _, _, [], _, h1, _ => by cases h1
  | x :: xs₁, xs₂, y :: ys₁, ys₂, h1, h2 => by
    have hAnd := (bool_and_eq_true (r x y) (listRel r xs₁ ys₁)).mp h1
    change (r x y && listRel r (xs₁ ++ xs₂) (ys₁ ++ ys₂)) = true
    rw [hAnd.1, listRel_append xs₁ xs₂ ys₁ ys₂ hAnd.2 h2]
    rfl

private theorem listRel_map_left {α β γ : Type} (r : β → γ → Bool) (f : α → β) :
    ∀ (xs : List α) (ys : List γ),
      listRel r (xs.map f) ys = listRel (fun a c => r (f a) c) xs ys
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by
    change (r (f x) y && listRel r (xs.map f) ys) =
      (r (f x) y && listRel (fun a c => r (f a) c) xs ys)
    rw [listRel_map_left r f xs ys]

private theorem listRel_map_right {α β γ : Type} (r : α → γ → Bool) (f : β → γ) :
    ∀ (xs : List α) (ys : List β),
      listRel r xs (ys.map f) = listRel (fun a b => r a (f b)) xs ys
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by
    change (r x (f y) && listRel r xs (ys.map f)) =
      (r x (f y) && listRel (fun a b => r a (f b)) xs ys)
    rw [listRel_map_right r f xs ys]

private theorem projElemEq_eq (a b : ProjectionElem) (h : projElemEq a b = true) : a = b := by
  cases a with
  | deref =>
    cases b <;> first | rfl | cases h
  | field i₁ t₁ =>
    cases b with
    | field i₂ t₂ =>
      have hAnd := (bool_and_eq_true (Nat.beq i₁ i₂) (MirTy.beq t₁ t₂)).mp h
      rw [nat_beq_eq i₁ i₂ hAnd.1, mirTy_beq_eq t₁ t₂ hAnd.2]
    | _ => cases h
  | unsupported =>
    cases b <;> first | rfl | cases h

private theorem projElemEq_refl (a : ProjectionElem) : projElemEq a a = true := by
  cases a with
  | deref => rfl
  | field i t =>
    change (Nat.beq i i && MirTy.beq t t) = true
    rw [nat_beq_refl i, mirTy_beq_refl t]
    rfl
  | unsupported => rfl

private theorem placeEq_eq (a b : Place) (h : placeEq a b = true) : a = b := by
  cases a with
  | mk l₁ p₁ =>
    cases b with
    | mk l₂ p₂ =>
      have hAnd := (bool_and_eq_true (Nat.beq l₁ l₂) (listRel projElemEq p₁ p₂)).mp h
      rw [nat_beq_eq l₁ l₂ hAnd.1, listRel_eq_of_eq projElemEq_eq p₁ p₂ hAnd.2]

private theorem placeEq_refl (a : Place) : placeEq a a = true := by
  cases a with
  | mk l p =>
    change (Nat.beq l l && listRel projElemEq p p) = true
    rw [nat_beq_refl l, listRel_refl projElemEq_refl p]
    rfl

private theorem constLitEq_eq (a b : ConstLit) (h : constLitEq a b = true) : a = b := by
  cases a with
  | scalar b₁ =>
    cases b with
    | scalar b₂ => rw [bitVec_beq_eq b₁ b₂ h]
    | zeroSized => cases h
  | zeroSized =>
    cases b with
    | scalar _ => cases h
    | zeroSized => rfl

private theorem constLitEq_refl (a : ConstLit) : constLitEq a a = true := by
  cases a with
  | scalar b => exact bitVec_beq_refl b
  | zeroSized => rfl

private theorem constOpEq_eq (a b : ConstOperand) (h : constOpEq a b = true) : a = b := by
  cases a with
  | mk t₁ l₁ =>
    cases b with
    | mk t₂ l₂ =>
      have hAnd := (bool_and_eq_true (MirTy.beq t₁ t₂) (constLitEq l₁ l₂)).mp h
      rw [mirTy_beq_eq t₁ t₂ hAnd.1, constLitEq_eq l₁ l₂ hAnd.2]

private theorem constOpEq_refl (a : ConstOperand) : constOpEq a a = true := by
  cases a with
  | mk t l =>
    change (MirTy.beq t t && constLitEq l l) = true
    rw [mirTy_beq_refl t, constLitEq_refl l]
    rfl

private theorem binOpEq_eq (a b : BinOp) (h : binOpEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem binOpEq_refl (a : BinOp) : binOpEq a a = true := by
  cases a <;> rfl

private theorem unOpEq_eq (a b : UnOp) (h : unOpEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem unOpEq_refl (a : UnOp) : unOpEq a a = true := by
  cases a <;> rfl

private theorem operandEq_eq (a b : Operand) (h : operandEq a b = true) : a = b := by
  cases a with
  | copy p₁ =>
    cases b with
    | copy p₂ => rw [placeEq_eq p₁ p₂ h]
    | _ => cases h
  | move p₁ =>
    cases b with
    | move p₂ => rw [placeEq_eq p₁ p₂ h]
    | _ => cases h
  | constant c₁ =>
    cases b with
    | constant c₂ => rw [constOpEq_eq c₁ c₂ h]
    | _ => cases h

private theorem operandEq_refl (a : Operand) : operandEq a a = true := by
  cases a with
  | copy p => exact placeEq_refl p
  | move p => exact placeEq_refl p
  | constant c => exact constOpEq_refl c

private theorem rvalueEq_eq (a b : Rvalue) (h : rvalueEq a b = true) : a = b := by
  cases a with
  | use o₁ =>
    cases b with
    | use o₂ => rw [operandEq_eq o₁ o₂ h]
    | _ => cases h
  | binaryOp op₁ l₁ r₁ =>
    cases b with
    | binaryOp op₂ l₂ r₂ =>
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      rw [binOpEq_eq op₁ op₂ h2.1, operandEq_eq l₁ l₂ h2.2, operandEq_eq r₁ r₂ h1.2]
    | _ => cases h
  | unaryOp op₁ o₁ =>
    cases b with
    | unaryOp op₂ o₂ =>
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [unOpEq_eq op₁ op₂ hAnd.1, operandEq_eq o₁ o₂ hAnd.2]
    | _ => cases h
  | discriminant p₁ =>
    cases b with
    | discriminant p₂ => rw [placeEq_eq p₁ p₂ h]
    | _ => cases h
  | ref m₁ p₁ =>
    cases b with
    | ref m₂ p₂ =>
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [mutability_beq_eq m₁ m₂ hAnd.1, placeEq_eq p₁ p₂ hAnd.2]
    | _ => cases h
  | addressOf m₁ p₁ =>
    cases b with
    | addressOf m₂ p₂ =>
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [mutability_beq_eq m₁ m₂ hAnd.1, placeEq_eq p₁ p₂ hAnd.2]
    | _ => cases h
  | aggregateTuple fs₁ =>
    cases b with
    | aggregateTuple fs₂ => rw [listRel_eq_of_eq operandEq_eq fs₁ fs₂ h]
    | _ => cases h
  | unsupported =>
    cases b with
    | unsupported => rfl
    | _ => cases h

private theorem rvalueEq_refl (a : Rvalue) : rvalueEq a a = true := by
  cases a with
  | use o => exact operandEq_refl o
  | binaryOp op l r =>
    change ((binOpEq op op && operandEq l l) && operandEq r r) = true
    rw [binOpEq_refl op, operandEq_refl l, operandEq_refl r]
    rfl
  | unaryOp op o =>
    change (unOpEq op op && operandEq o o) = true
    rw [unOpEq_refl op, operandEq_refl o]
    rfl
  | discriminant p => exact placeEq_refl p
  | ref m p =>
    change (Mutability.beq m m && placeEq p p) = true
    rw [mutability_beq_refl m, placeEq_refl p]
    rfl
  | addressOf m p =>
    change (Mutability.beq m m && placeEq p p) = true
    rw [mutability_beq_refl m, placeEq_refl p]
    rfl
  | aggregateTuple fs => exact listRel_refl operandEq_refl fs
  | unsupported => rfl

private theorem stmtEq_eq (a b : StatementKind) (h : stmtEq a b = true) : a = b := by
  cases a with
  | assign d₁ r₁ =>
    cases b with
    | assign d₂ r₂ =>
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [placeEq_eq d₁ d₂ hAnd.1, rvalueEq_eq r₁ r₂ hAnd.2]
    | _ => cases h
  | storageLive l₁ =>
    cases b with
    | storageLive l₂ => rw [nat_beq_eq l₁ l₂ h]
    | _ => cases h
  | storageDead l₁ =>
    cases b with
    | storageDead l₂ => rw [nat_beq_eq l₁ l₂ h]
    | _ => cases h
  | nop =>
    cases b <;> first | rfl | cases h
  | unsupported =>
    cases b <;> first | rfl | cases h

private theorem stmtEq_refl (a : StatementKind) : stmtEq a a = true := by
  cases a with
  | assign d r =>
    change (placeEq d d && rvalueEq r r) = true
    rw [placeEq_refl d, rvalueEq_refl r]
    rfl
  | storageLive l => exact nat_beq_refl l
  | storageDead l => exact nat_beq_refl l
  | nop => rfl
  | unsupported => rfl

private theorem branchPairEq_eq (a b : BitVec 128 × BasicBlockId)
    (h : ((a.1 == b.1) && Nat.beq a.2 b.2) = true) : a = b := by
  cases a with
  | mk x₁ y₁ =>
    cases b with
    | mk x₂ y₂ =>
      have hAnd := (bool_and_eq_true (x₁ == x₂) (Nat.beq y₁ y₂)).mp h
      rw [bitVec_beq_eq x₁ x₂ hAnd.1, nat_beq_eq y₁ y₂ hAnd.2]

private theorem branchPairEq_refl (a : BitVec 128 × BasicBlockId) :
    ((a.1 == a.1) && Nat.beq a.2 a.2) = true := by
  rw [bitVec_beq_refl a.1, nat_beq_refl a.2]
  rfl

private theorem switchTargetsEq_eq (a b : SwitchTargets)
    (h : switchTargetsEq a b = true) : a = b := by
  cases a with
  | mk br₁ ot₁ =>
    cases b with
    | mk br₂ ot₂ =>
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [nat_beq_eq ot₁ ot₂ hAnd.1, listRel_eq_of_eq branchPairEq_eq br₁ br₂ hAnd.2]

private theorem switchTargetsEq_refl (a : SwitchTargets) : switchTargetsEq a a = true := by
  cases a with
  | mk br ot =>
    unfold switchTargetsEq
    dsimp
    rw [nat_beq_refl ot, listRel_refl branchPairEq_refl br]
    rfl

private theorem unwindActionEq_eq (a b : UnwindAction)
    (h : unwindActionEq a b = true) : a = b := by
  cases a with
  | continue_ => cases b <;> first | rfl | cases h
  | unreachable => cases b <;> first | rfl | cases h
  | terminate => cases b <;> first | rfl | cases h
  | cleanup b₁ =>
    cases b with
    | cleanup b₂ => rw [nat_beq_eq b₁ b₂ h]
    | _ => cases h

private theorem unwindActionEq_refl (a : UnwindAction) : unwindActionEq a a = true := by
  cases a with
  | continue_ | unreachable | terminate => rfl
  | cleanup b => exact nat_beq_refl b

private theorem assertKindEq_eq (a b : AssertKind) (h : assertKindEq a b = true) : a = b := by
  cases a with
  | overflow op₁ =>
    cases b with
    | overflow op₂ => rw [binOpEq_eq op₁ op₂ h]
    | _ => cases h
  | overflowNeg => cases b <;> first | rfl | cases h
  | divByZero => cases b <;> first | rfl | cases h
  | remByZero => cases b <;> first | rfl | cases h
  | boundsCheck => cases b <;> first | rfl | cases h
  | misalignedPtrDeref => cases b <;> first | rfl | cases h
  | nullPtrDeref => cases b <;> first | rfl | cases h
  | unsupported => cases b <;> first | rfl | cases h

private theorem assertKindEq_refl (a : AssertKind) : assertKindEq a a = true := by
  cases a with
  | overflow op => exact binOpEq_refl op
  | overflowNeg | divByZero | remByZero | boundsCheck
  | misalignedPtrDeref | nullPtrDeref | unsupported => rfl

private theorem optBasicBlockIdEq_eq (a b : Option BasicBlockId)
    (h : (match a, b with
          | none, none => true
          | some x, some y => Nat.beq x y
          | _, _ => false) = true) : a = b := by
  cases a with
  | none =>
    cases b with
    | none => rfl
    | some _ => cases h
  | some x =>
    cases b with
    | none => cases h
    | some y => rw [nat_beq_eq x y h]

private theorem optBasicBlockIdEq_refl (a : Option BasicBlockId) :
    (match a, a with
     | none, none => true
     | some x, some y => Nat.beq x y
     | _, _ => false) = true := by
  cases a with
  | none => rfl
  | some x => exact nat_beq_refl x

private theorem terminatorEq_eq (a b : TerminatorKind)
    (h : terminatorEq a b = true) : a = b := by
  cases a with
  | goto t₁ =>
    cases b with
    | goto t₂ => rw [nat_beq_eq t₁ t₂ h]
    | _ => cases h
  | switchInt d₁ ts₁ =>
    cases b with
    | switchInt d₂ ts₂ =>
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [operandEq_eq d₁ d₂ hAnd.1, switchTargetsEq_eq ts₁ ts₂ hAnd.2]
    | _ => cases h
  | return_ => cases b <;> first | rfl | cases h
  | unreachable => cases b <;> first | rfl | cases h
  | unwindResume => cases b <;> first | rfl | cases h
  | assert c₁ e₁ m₁ t₁ u₁ =>
    cases b with
    | assert c₂ e₂ m₂ t₂ u₂ =>
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      have h3 := (bool_and_eq_true _ _).mp h2.1
      have h4 := (bool_and_eq_true _ _).mp h3.1
      rw [operandEq_eq c₁ c₂ h4.1, boolEq_eq e₁ e₂ h4.2,
        assertKindEq_eq m₁ m₂ h3.2, nat_beq_eq t₁ t₂ h2.2,
        unwindActionEq_eq u₁ u₂ h1.2]
    | _ => cases h
  | call f₁ a₁ d₁ t₁ u₁ =>
    cases b with
    | call f₂ a₂ d₂ t₂ u₂ =>
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      have h3 := (bool_and_eq_true _ _).mp h2.1
      have h4 := (bool_and_eq_true _ _).mp h3.1
      rw [nat_beq_eq f₁ f₂ h4.1, listRel_eq_of_eq operandEq_eq a₁ a₂ h4.2,
        placeEq_eq d₁ d₂ h3.2, optBasicBlockIdEq_eq t₁ t₂ h2.2,
        unwindActionEq_eq u₁ u₂ h1.2]
    | _ => cases h
  | unsupported => cases b <;> first | rfl | cases h

private theorem terminatorEq_refl (a : TerminatorKind) : terminatorEq a a = true := by
  cases a with
  | goto t => exact nat_beq_refl t
  | switchInt d ts =>
    change (operandEq d d && switchTargetsEq ts ts) = true
    rw [operandEq_refl d, switchTargetsEq_refl ts]
    rfl
  | return_ | unreachable | unwindResume | unsupported => rfl
  | assert c e m t u =>
    change ((((operandEq c c && boolEq e e) && assertKindEq m m) && Nat.beq t t) &&
      unwindActionEq u u) = true
    rw [operandEq_refl c, boolEq_refl e, assertKindEq_refl m, nat_beq_refl t,
      unwindActionEq_refl u]
    rfl
  | call f a d t u =>
    change ((((Nat.beq f f && listRel operandEq a a) && placeEq d d) &&
      (match t, t with
       | none, none => true
       | some x, some y => Nat.beq x y
       | _, _ => false)) && unwindActionEq u u) = true
    rw [nat_beq_refl f, listRel_refl operandEq_refl a, placeEq_refl d,
      optBasicBlockIdEq_refl t, unwindActionEq_refl u]
    rfl

private theorem scopeEq_eq (a b : VerificationScope) (h : scopeEq a b = true) : a = b := by
