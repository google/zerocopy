private noncomputable def arrSc_ReachableInv {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (s₁ : ArrSliceState) : Prop :=
  match s₁.frames with
  | [f₁] =>
    f₁.defId = plan.defId →
    ∃ bb : ArrSliceBlock,
      Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bb
  | _ => False

private theorem arrSc_scalarize_step_sim
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {s₁ s₂ : ArrSliceState}
    (hRel : arrSc_StateRel pack s₁ s₂)
    (hInv : arrSc_ReachableInv pack s₁) :
    (∀ s₁' : ArrSliceState, evalStepArrSlice pSrc 0 s₁ = .step s₁' →
      ((arrSc_StateRel pack s₁' s₂ ∧ arrSc_ReachableInv pack s₁') ∧ (0 : Nat) < 0) ∨
      (∃ s₂' : ArrSliceState, ReachesPlusArrSlice pTgt s₂ s₂' ∧
        arrSc_StateRel pack s₁' s₂' ∧ arrSc_ReachableInv pack s₁')) ∧
    (∀ out : TerminalOut, evalStepArrSlice pSrc 0 s₁ = .done out →
      ∃ s₂' : ArrSliceState, ReachesArrSlice pTgt s₂ s₂' ∧ StepArrSlice pTgt s₂' (.done out)) ∧
    (∀ k : FaultKind, evalStepArrSlice pSrc 0 s₁ = .fault k →
      ∃ s₂' : ArrSliceState, ReachesArrSlice pTgt s₂ s₂' ∧ StepArrSlice pTgt s₂' (.fault k)) := by
  cases s₁ with | mk fs₁ cm₁ =>
  cases s₂ with | mk fs₂ cm₂ =>
  have hCm : cm₂ = cm₁ := hRel.1
  rw [hCm]
  have hFsRel := hRel.2
  dsimp at hFsRel
  cases fs₁ with
  | nil => cases hFsRel
  | cons f₁ tl₁ =>
    cases tl₁ with
    | cons _ _ => cases hFsRel
    | nil =>
      cases fs₂ with
      | nil => cases hFsRel
      | cons f₂ tl₂ =>
        cases tl₂ with
        | cons _ _ => cases hFsRel
        | nil =>
          dsimp [arrSc_ReachableInv] at hInv
          cases hFsRel with
          | inr hNe =>
            have hDefNe : f₁.defId ≠ plan.defId := hNe.1
            have hFEq : f₂ = f₁ := hNe.2
            rw [hFEq]
            have hEvalEq : evalStepArrSlice pTgt 0 { frames := [f₁], callerMem := cm₁ } =
                evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm₁ } := by
              change (match Trusted.MirSemantics.getElem? pTgt.bodies f₁.defId with
                  | none => StepResult.fault FaultKind.unsupported
                  | some body =>
                    match Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
                    | none => StepResult.fault FaultKind.unsupported
                    | some bb =>
                      match Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
                      | some stmt => evalArrSliceStmt body f₁ cm₁ stmt
                      | none =>
                        if Nat.beq f₁.stmtIdx bb.statements.length then
                          evalArrSliceTerm body bb f₁ cm₁
                        else
                          StepResult.fault FaultKind.unsupported) =
                (match Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId with
                  | none => StepResult.fault FaultKind.unsupported
                  | some body =>
                    match Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
                    | none => StepResult.fault FaultKind.unsupported
                    | some bb =>
                      match Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
                      | some stmt => evalArrSliceStmt body f₁ cm₁ stmt
                      | none =>
                        if Nat.beq f₁.stmtIdx bb.statements.length then
                          evalArrSliceTerm body bb f₁ cm₁
                        else
                          StepResult.fault FaultKind.unsupported)
              rw [arrSc_getElem?_pTgt_bodies_ne pack hDefNe]
            refine ⟨?_, ?_, ?_⟩
            · intro s₁' hStep
              right
              have hStepTgt : evalStepArrSlice pTgt 0 { frames := [f₁], callerMem := cm₁ } = .step s₁' := by
                rw [hEvalEq]; exact hStep
              cases arrSc_evalStepArrSlice_preserves_defId pSrc f₁ cm₁ hStep with
              | intro f₁' hF1' =>
                have hS1' : s₁' = { frames := [f₁'], callerMem := s₁'.callerMem } := by
                  cases s₁' with | mk fs1' cm1' =>
                  dsimp at hF1'; rw [hF1'.1]
                refine ⟨s₁', ⟨0, arrSc_reachesNArrSlice_one_step hStepTgt⟩, ⟨rfl, ?_⟩, ?_⟩
                · rw [hS1']; dsimp
                  exact Or.inr ⟨by rw [hF1'.2]; exact hDefNe, rfl⟩
                · rw [hS1']; dsimp [arrSc_ReachableInv]
                  intro hBad
                  rw [hF1'.2] at hBad
                  exact False.elim (hDefNe hBad)
            · intro out hDone
              exact arrSc_reachesArrSlice_of_reach_done (ReachesNArrSlice.zero _)
                (by rw [hEvalEq]; exact hDone)
            · intro k hFault
              exact arrSc_reachesArrSlice_of_reach_fault (ReachesNArrSlice.zero _)
                (by rw [hEvalEq]; exact hFault)
          | inl hSamePack =>
            have hSame := hSamePack.1
            have hSame₂ := hSamePack.2.1
            have hBbEq := hSamePack.2.2.1
            have hLM := hSamePack.2.2.2.1
            have hBlockInfo := hSamePack.2.2.2.2
            have hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc := by
              rw [hSame]; exact pack.hBodySrc
            have hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt := by
              rw [hSame₂]; exact arrSc_getElem?_pTgt_bodies_eq pack
            cases hInv hSame with
            | intro bbSrc hBbSrc =>
              rw [hBbSrc] at hBlockInfo
              have hStmtLe := hBlockInfo.1
              have hLen₂ := hBlockInfo.2
              cases Nat.decLt f₁.stmtIdx bbSrc.statements.length with
              | isTrue hLt =>
                cases getElem?_lt_some bbSrc.statements f₁.stmtIdx hLt with
                | intro stmt hStmtSrc =>
                  have hSim := arrSc_stmt_step_sim (cm := cm₁) pack hBodySrc hBodyTgt hSame hSame₂ hBbEq
                    hBbSrc hStmtSrc hLen₂ hLM
                  refine ⟨fun s₁' h => Or.inr ?_, hSim.2.1, hSim.2.2⟩
                  cases hSim.1 s₁' h with
                  | intro s₂' hs₂' =>
                    refine ⟨s₂', hs₂'.1, hs₂'.2, ?_⟩
                    have hStepStmt : evalArrSliceStmt pack.bodySrc f₁ cm₁ stmt = .step s₁' := by
                      rw [arrSc_evalStepArrSlice_at_stmt pSrc pack.bodySrc f₁ cm₁ bbSrc stmt
                        hBodySrc hBbSrc hStmtSrc] at h
                      exact h
                    cases arrSc_evalArrSliceStmt_preserves pack.bodySrc f₁ cm₁ stmt hStepStmt with
                    | intro fs₁' hFs1' =>
                      cases s₁' with | mk fs1' cm1' =>
                      dsimp at hFs1'
                      rw [hFs1'.1]
                      dsimp [arrSc_ReachableInv]
                      intro _
                      rw [hFs1'.2.2]
                      exact ⟨bbSrc, hBbSrc⟩
              | isFalse hNotLt =>
                have hIdx₁ : f₁.stmtIdx = bbSrc.statements.length :=
                  Nat.le_antisymm hStmtLe (Nat.le_of_not_lt hNotLt)
                have hSim := arrSc_term_step_sim (cm := cm₁) pack hBodySrc hBodyTgt hSame hSame₂ hBbEq
                  hBbSrc hIdx₁ hLen₂ hLM
                refine ⟨fun s₁' h => Or.inr ?_, hSim.2.1, hSim.2.2⟩
                cases hSim.1 s₁' h with
                | intro s₂' hs₂' =>
                  refine ⟨s₂', hs₂'.1, hs₂'.2, ?_⟩
                  have hStepTerm : evalArrSliceTerm pack.bodySrc bbSrc f₁ cm₁ = .step s₁' := by
                    rw [arrSc_evalStepArrSlice_at_term pSrc pack.bodySrc f₁ cm₁ bbSrc
                      hBodySrc hBbSrc hIdx₁] at h
                    exact h
                  cases arrSc_evalArrSliceTerm_preserves pack.bodySrc bbSrc f₁ cm₁ hStepTerm with
                  | intro fs₁' hFs1' =>
                    cases s₁' with | mk fs1' cm1' =>
                    dsimp at hFs1'
                    rw [hFs1'.1]
                    dsimp [arrSc_ReachableInv]
                    intro _
                    have hLtTgt := hFs1'.2.2 (arrSc_bodySrc_term_targetsInBounds pack hBbSrc)
                    exact getElem?_lt_some pack.bodySrc.basicBlocks fs₁'.blockIdx hLtTgt

private theorem applyArrayScalarize_sound (plan : ArrayScalarizePlan)
    (pSrc pTgt : ArrSliceProgram) :
    applyArrayScalarize plan pSrc = some pTgt →
    FullSemanticEquivArrSlice pSrc pTgt := by
  intro hApp
  let pack := arrSc_applyArrayScalarize_unpack plan pSrc pTgt hApp
  refine fullSemanticEquivArrSlice_of_fwd_stutter_sim pSrc pTgt
    (fun s₁ s₂ => arrSc_StateRel pack s₁ s₂ ∧ arrSc_ReachableInv pack s₁) (fun _ => 0)
    (fun q k => (arrSc_initStateArrSlice_err_iff pack q k).1)
    (fun q k => (arrSc_initStateArrSlice_err_iff pack q k).2)
    ?_
    (fun s₁ s₂ hPair => arrSc_scalarize_step_sim pack hPair.1 hPair.2)
  intro q s₁ hInit
  cases arrSc_initStateArrSlice_ok_rel pack q s₁ hInit with
  | intro s₂ hs₂ =>
    refine ⟨s₂, hs₂.1, hs₂.2, ?_⟩
    unfold initStateArrSlice at hInit
    cases hMeta : !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
    | true => rw [hMeta] at hInit; cases hInit
    | false =>
      rw [hMeta] at hInit
      cases hMem : !q.callerMem.allocations.isEmpty with
      | true => rw [hMem] at hInit; cases hInit
      | false =>
        rw [hMem] at hInit; dsimp at hInit
        cases hB : Trusted.MirSemantics.getElem? pSrc.bodies pSrc.entryDefId with
        | none => rw [hB] at hInit; cases hInit
        | some body =>
          rw [hB] at hInit; dsimp at hInit
          cases hEmpty : body.basicBlocks.isEmpty with
          | true => rw [hEmpty] at hInit; cases hInit
          | false =>
            rw [hEmpty] at hInit; dsimp at hInit
            cases hArg : !Nat.blt body.argumentCount body.locals.length with
            | true => rw [hArg] at hInit; cases hInit
            | false =>
              rw [hArg] at hInit; dsimp at hInit
              cases hSt : !arrSliceStorageAnnotationsInBounds body with
              | true => rw [hSt] at hInit; cases hInit
              | false =>
                rw [hSt] at hInit; dsimp at hInit
                cases hSup : !allArrSliceLocalsSupported body.argumentCount 0 body.locals with
                | true => rw [hSup] at hInit; cases hInit
                | false =>
                  rw [hSup] at hInit; dsimp at hInit
                  cases hParam : arrSliceParamBaseTys? body with
                  | none => rw [hParam] at hInit; cases hInit
                  | some paramTys =>
                    rw [hParam] at hInit; dsimp at hInit
                    cases hChkA : !checkArgsMatch q.args paramTys with
                    | true => rw [hChkA] at hInit; cases hInit
                    | false =>
                      rw [hChkA] at hInit
                      have hEqS1 := Except.ok.inj hInit
                      rw [← hEqS1]
                      dsimp [arrSc_ReachableInv]
                      intro _
                      have hPos : 0 < pack.bodySrc.basicBlocks.length := by
                        cases hL : pack.bodySrc.basicBlocks with
                        | nil =>
                          have hEm := pack.hNonEmpty
                          rw [hL] at hEm
                          cases hEm
                        | cons _ _ => exact Nat.zero_lt_succ _
                      exact getElem?_lt_some pack.bodySrc.basicBlocks 0 hPos

