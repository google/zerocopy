                              | error _ => rw [hWr] at h; cases h
                              | ok slots' => rw [hWr] at h; exact stepStmtNext_preserves_defId f cm slots' h
  | writeArrayConst arrLocal idx rval =>
    change (match Trusted.MirSemantics.getElem? body.locals arrLocal with
      | some (.array elemTy len) =>
        match evalArrSliceBaseRvalue body.locals f.locals elemTy rval with
        | .error k => StepResult.fault k
        | .ok (v, slotsAfter) =>
          if !checkVal v elemTy then StepResult.fault FaultKind.unsupported
          else match Trusted.MirSemantics.getElem? slotsAfter arrLocal with
            | some .arrDead => StepResult.fault FaultKind.undefined
            | some (.liveArray elems) =>
