-- ============================================================================
-- Section 1: Pure Nat, Bool, and List helpers for SliceScalarize
-- ============================================================================

private theorem list_append_nil {α : Type} (xs : List α) :
    xs ++ [] = xs := by
  induction xs with
  | nil => rfl
  | cons a tl ih =>
    change a :: (tl ++ []) = a :: tl
    rw [ih]

private theorem listFlatMap_nil {α β : Type} (f : α → List β) :
    listFlatMap f [] = [] := by
  rfl

private theorem listFlatMap_cons {α β : Type} (f : α → List β) (x : α) (xs : List α) :
    listFlatMap f (x :: xs) = f x ++ listFlatMap f xs := by
  rfl

private theorem listFlatMap_singleton {α β : Type} (f : α → List β) (x : α) :
    listFlatMap f [x] = f x := by
  rw [listFlatMap_cons, listFlatMap_nil, list_append_nil]

private theorem getElem?_cons_zero {α : Type} (a : α) (tl : List α) :
    Trusted.MirSemantics.getElem? (a :: tl) 0 = some a := by
  rfl

private theorem getElem?_cons_succ {α : Type} (a : α) (tl : List α) (i : Nat) :
    Trusted.MirSemantics.getElem? (a :: tl) (i + 1) = Trusted.MirSemantics.getElem? tl i := by
  rfl

private theorem list_take_succ_of_getElem? {α : Type} {xs : List α} {i : Nat} {x : α}
    (h : Trusted.MirSemantics.getElem? xs i = some x) :
    xs.take (i + 1) = xs.take i ++ [x] := by
  induction xs generalizing i with
  | nil =>
    cases h
  | cons a tl ih =>
    cases i with
    | zero =>
      cases h
      rfl
    | succ i' =>
      rw [getElem?_cons_succ] at h
      have htl := ih h
      change a :: tl.take (i' + 1) = a :: (tl.take i' ++ [x])
      rw [htl]

private theorem listFlatMap_take_split {α β : Type} (f : α → List β) {xs : List α}
    {i : Nat} {x : α} (h : Trusted.MirSemantics.getElem? xs i = some x) :
    listFlatMap f (xs.take (i + 1)) = listFlatMap f (xs.take i) ++ f x := by
  rw [list_take_succ_of_getElem? h, listFlatMap_append, listFlatMap_singleton]

private theorem list_take_all {α : Type} (xs : List α) :
    xs.take xs.length = xs := by
  induction xs with
  | nil => rfl
  | cons a tl ih =>
    change a :: tl.take tl.length = a :: tl
    rw [ih]

private theorem list_drop_zero {α : Type} (xs : List α) :
    xs.drop 0 = xs := by
  rfl

private theorem list_drop_succ_cons {α : Type} (a : α) (tl : List α) (n : Nat) :
    (a :: tl).drop (n + 1) = tl.drop n := by
  rfl

private theorem list_length_drop {α : Type} (xs : List α) (n : Nat) :
    (xs.drop n).length = xs.length - n := by
  induction xs generalizing n with
  | nil =>
    cases n with
    | zero => rfl
    | succ n' =>
      change 0 = 0 - (n' + 1)
      exact (Nat.zero_sub _).symm
  | cons a tl ih =>
    cases n with
    | zero =>
      rw [list_drop_zero, Nat.sub_zero]
    | succ n' =>
      rw [list_drop_succ_cons, ih n']
      exact (Nat.succ_sub_succ_eq_sub tl.length n').symm

private theorem s3a_getElem?_drop {α : Type} (xs : List α) (n i : Nat) :
    Trusted.MirSemantics.getElem? (xs.drop n) i = Trusted.MirSemantics.getElem? xs (n + i) := by
  induction xs generalizing n i with
  | nil =>
    cases n <;> rfl
  | cons a tl ih =>
    cases n with
    | zero =>
      rw [list_drop_zero, Nat.zero_add]
    | succ n' =>
      rw [list_drop_succ_cons, ih n' i, Nat.succ_add, ← Nat.add_succ]
      rfl

private theorem getElem?_take_lt {α : Type} (xs : List α) (n i : Nat) (h : i < n) :
    Trusted.MirSemantics.getElem? (xs.take n) i = Trusted.MirSemantics.getElem? xs i := by
  induction xs generalizing n i with
  | nil =>
    cases n <;> rfl
  | cons a tl ih =>
    cases n with
    | zero => cases Nat.not_lt_zero _ h
    | succ n' =>
      cases i with
      | zero => rfl
      | succ i' =>
        have h' : i' < n' := Nat.lt_of_succ_lt_succ h
        change Trusted.MirSemantics.getElem? (tl.take n') i' = Trusted.MirSemantics.getElem? tl i'
        exact ih n' i' h'

private theorem list_take_append_left {α : Type} (xs ys : List α) (n : Nat)
    (h : n ≤ xs.length) :
    (xs ++ ys).take n = xs.take n := by
  induction xs generalizing n with
  | nil =>
    cases h
    rfl
  | cons a tl ih =>
    cases n with
    | zero => rfl
    | succ n' =>
      change a :: (tl ++ ys).take n' = a :: tl.take n'
      rw [ih n' (Nat.le_of_succ_le_succ h)]

private theorem getElem?_append_middle {α : Type} (xs : List α) (x : α) (ys : List α) :
    Trusted.MirSemantics.getElem? (xs ++ (x :: ys)) xs.length = some x := by
  have hge := getElem?_append_right xs (x :: ys) 0
  rw [Nat.add_zero] at hge
  rw [hge]
  rfl

private theorem getElem?_append_middle_add {α : Type} (xs ys zs : List α) (k : Nat)
    (hk : k < ys.length) :
    Trusted.MirSemantics.getElem? (xs ++ ys ++ zs) (xs.length + k) =
      Trusted.MirSemantics.getElem? ys k := by
  have h1 : xs.length + k < (xs ++ ys).length := by
    rw [list_append_length]
    exact Nat.add_lt_add_left hk xs.length
  have hl := getElem?_append_left (xs ++ ys) zs (xs.length + k) h1
  have hr := getElem?_append_right xs ys k
  rw [hl, hr]

private theorem setElem?_append_middle {α : Type} (xs ys zs : List α) (k : Nat) (v : α)
    (hk : k < ys.length) :
    setElem? (xs ++ ys ++ zs) (xs.length + k) v =
      match setElem? (xs ++ ys) (xs.length + k) v with
      | some p => some (p ++ zs)
      | none => none := by
  have h1 : xs.length + k < (xs ++ ys).length := by
    rw [list_append_length]
    exact Nat.add_lt_add_left hk xs.length
  exact setElem?_append_left (xs ++ ys) zs (xs.length + k) v h1

private theorem list_length_take_le {α : Type} (xs : List α) (n : Nat) :
    (xs.take n).length ≤ n := by
  induction xs generalizing n with
  | nil =>
    cases n <;> exact Nat.zero_le _
  | cons a tl ih =>
    cases n with
    | zero => exact Nat.le_refl 0
    | succ n' =>
      exact Nat.succ_le_succ (ih n')

private theorem list_length_take_of_le {α : Type} {xs : List α} {n : Nat}
    (hn : n ≤ xs.length) :
    (xs.take n).length = n := by
  induction xs generalizing n with
  | nil =>
    cases hn
    rfl
  | cons a tl ih =>
    cases n with
    | zero => rfl
    | succ n' =>
      change Nat.succ (tl.take n').length = Nat.succ n'
      exact congrArg Nat.succ (ih (Nat.le_of_succ_le_succ hn))

private theorem list_any_cons {α : Type} (p : α → Bool) (a : α) (tl : List α) :
    (a :: tl).any p = (p a || tl.any p) := by
  rfl

private theorem list_any_iff_getElem? {α : Type} (p : α → Bool) (xs : List α) :
    xs.any p = true ↔ ∃ i x, Trusted.MirSemantics.getElem? xs i = some x ∧ p x = true := by
  induction xs with
  | nil =>
    constructor
    · intro h; cases h
    · intro h
      cases h with | intro i hi =>
      cases hi with | intro x hx =>
      cases hx.1
  | cons a tl ih =>
    rw [list_any_cons, bool_or_eq_true]
    constructor
    · intro h
      cases h with
      | inl ha => exact ⟨0, a, rfl, ha⟩
      | inr htl =>
        have hih := ih.mp htl
        cases hih with | intro i hi =>
        cases hi with | intro x hx =>
        exact ⟨i + 1, x, hx.1, hx.2⟩
    · intro h
      cases h with | intro i hi =>
      cases hi with | intro x hx =>
      have hg := hx.1
      have hp := hx.2
      cases i with
      | zero =>
        cases hg
        exact Or.inl hp
      | succ i' =>
        rw [getElem?_cons_succ] at hg
        exact Or.inr (ih.mpr ⟨i', x, hg, hp⟩)

private theorem listFlatMap_any_iff {α β : Type} (f : α → List β) (p : β → Bool) (xs : List α) :
    (listFlatMap f xs).any p = true ↔
      ∃ i a, Trusted.MirSemantics.getElem? xs i = some a ∧ (f a).any p = true := by
  induction xs with
  | nil =>
    constructor
    · intro h; cases h
    · intro h
      cases h with | intro i hi =>
      cases hi with | intro x hx =>
      cases hx.1
  | cons a tl ih =>
    rw [listFlatMap_cons, list_any_append, bool_or_eq_true]
    constructor
    · intro h
      cases h with
      | inl ha => exact ⟨0, a, rfl, ha⟩
      | inr htl =>
        have hih := ih.mp htl
        cases hih with | intro i hi =>
        cases hi with | intro x hx =>
        exact ⟨i + 1, x, hx.1, hx.2⟩
    · intro h
      cases h with | intro i hi =>
      cases hi with | intro x hx =>
      have hg := hx.1
      have hp := hx.2
      cases i with
      | zero =>
        cases hg
        exact Or.inl hp
      | succ i' =>
        rw [getElem?_cons_succ] at hg
        exact Or.inr (ih.mpr ⟨i', x, hg, hp⟩)

private theorem nat_four_mul_add_inj {k₁ r₁ k₂ r₂ : Nat} (hr₁ : r₁ < 4) (hr₂ : r₂ < 4)
    (h : 4 * k₁ + r₁ = 4 * k₂ + r₂) :
    k₁ = k₂ ∧ r₁ = r₂ := by
  induction k₁ generalizing k₂ with
  | zero =>
    cases k₂ with
    | zero =>
      rw [Nat.mul_zero, Nat.zero_add, Nat.zero_add] at h
      exact ⟨rfl, h⟩
    | succ k₂' =>
      rw [Nat.mul_zero, Nat.zero_add, Nat.mul_succ] at h
      have h4 : 4 ≤ 4 * k₂' + 4 := Nat.le_add_left 4 (4 * k₂')
      have hle : 4 ≤ 4 * k₂' + 4 + r₂ := Nat.le_trans h4 (Nat.le_add_right _ r₂)
      rw [← h] at hle
      exact False.elim (Nat.not_lt_of_ge hle hr₁)
  | succ k₁' ih =>
    cases k₂ with
    | zero =>
      rw [Nat.mul_zero, Nat.zero_add, Nat.mul_succ] at h
      have h4 : 4 ≤ 4 * k₁' + 4 := Nat.le_add_left 4 (4 * k₁')
      have hle : 4 ≤ 4 * k₁' + 4 + r₁ := Nat.le_trans h4 (Nat.le_add_right _ r₁)
      rw [h] at hle
      exact False.elim (Nat.not_lt_of_ge hle hr₂)
    | succ k₂' =>
      rw [Nat.mul_succ, Nat.mul_succ] at h
      have hshift : 4 * k₁' + r₁ + 4 = 4 * k₂' + r₂ + 4 := by
        rw [Nat.add_assoc, Nat.add_comm r₁ 4, ← Nat.add_assoc]
        rw [Nat.add_assoc (4 * k₂'), Nat.add_comm r₂ 4, ← Nat.add_assoc]
        exact h
      have hcut : 4 * k₁' + r₁ = 4 * k₂' + r₂ := Nat.add_right_cancel hshift
      have hrec := ih hcut
      rw [hrec.1]
      exact ⟨rfl, hrec.2⟩

