  have hLhs := evalArrSlicePrimitiveOperand_copy_usize pack.bodyTgt.locals frame₂.locals src a hSrcDecl hSrcSlot
  have hRhs := evalArrSlicePrimitiveOperand_const_usize pack.bodyTgt.locals frame₂.locals b hb
  have hBin := step_mkBinOp_usize pTgt pack.bodyTgt bbTgt frame₂ cm .subUnchecked dst
    (.copy { localId := src, projection := [] }) (usizeConst b) usizeTy a b frame₂.locals frame₂.locals
    hBodyTgt hBbTgt hStmt hDstDecl hLhs hRhs
  constructor
  · intro hab
    rw [hBin, evalBinOp_usize_subUnchecked_ub a b ha hb hab]
  · intro hba
    have hSubLt : a - b < maxUsize := Nat.lt_of_le_of_lt (Nat.sub_le a b) ha
