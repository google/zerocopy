private theorem s4c_arrSc_nat_eq_or_ne (a b : Nat) : a = b ∨ a ≠ b := by
  cases h : Nat.beq a b with
  | true => exact Or.inl (nat_beq_eq a b h)
  | false => exact Or.inr (fun hEq => by rw [hEq, nat_beq_refl] at h; cases h)

private theorem s4c_arrSc_le_bodyTgt_locals {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pack.bodySrc.locals.length ≤ pack.bodyTgt.locals.length := by
  rw [arrSc_bodyTgt_locals_length pack]
  exact Nat.le_trans (Nat.le_add_right pack.bodySrc.locals.length 1)
    (Nat.le_trans (Nat.le_add_right _ pack.len) (Nat.le_add_right _ (4 + pack.len)))

private theorem arrSc_zero_lt_locals {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    0 < pack.bodySrc.locals.length :=
  Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.zero_le _) pack.hArgLt) pack.hLocLt

private theorem arrSc_zero_ne_arrLocal {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    0 ≠ plan.arrLocal := by
  intro h
  have hArg := pack.hArgLt
  rw [← h] at hArg
  cases hArg

private theorem arrSc_len_lt_maxUsize {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pack.len < maxUsize := by
  have h1 : pack.len ≤ 64 := pack.hLenLe
  have h2 : 64 < Nat.pow 2 64 := by decide
  rw [arrSc_maxUsize_eq]
  exact Nat.lt_of_le_of_lt h1 h2

private theorem arrSc_scalarVal_eq_ofNat (sv : ScalarVal)
    (hw : sv.width = .isize) (hs : sv.signed = false) (hwf : sv.wf = true) :
    sv = ⟨.isize, false, BitVec.ofNat 128 sv.bits.toNat⟩ := by
  have hLt := arrSc_scalarVal_wf_isize_lt_maxUsize sv hw hwf
  have hwf' : (truncateBits sv.width sv.bits == sv.bits) = true := hwf
  rw [hw] at hwf'
  have hEq : truncateBits .isize sv.bits = sv.bits := bitVec_beq_eq _ _ hwf'
  have hMod : (BitVec.ofNat 64 sv.bits.toNat).toNat = sv.bits.toNat := by
    rw [bitVec_ofNat_toNat_eq_mod 64 sv.bits.toNat, ← arrSc_maxUsize_eq]
    exact Nat.mod_eq_of_lt hLt
  have hBv : BitVec.ofNat 128 sv.bits.toNat = truncateBits .isize sv.bits := by
    change BitVec.ofNat 128 sv.bits.toNat =
      BitVec.ofNat 128 (BitVec.ofNat 64 sv.bits.toNat).toNat
    rw [hMod]
  rw [hEq] at hBv
  cases sv with
  | mk w s bits =>
    dsimp at hw hs hBv
    rw [hw, hs, hBv]

private theorem s4c_arrSc_localMatch_set_liveLoc_unit {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂Live : List ArrSliceSlot}
    (hLM : arrSc_LocalMatch pack slots₁ slots₂)
    (hLive : Trusted.MirSemantics.getElem? slots₂ pack.bodySrc.locals.length =
      some (.baseSlot (.live (some .unit))))
    (hSet : setElem? slots₂ pack.bodySrc.locals.length (.baseSlot (.live (some .unit))) =
      some slots₂Live) :
    arrSc_LocalMatch pack slots₁ slots₂Live := by
  have hGe : ∀ j : Nat, pack.bodySrc.locals.length ≤ j →
      Trusted.MirSemantics.getElem? slots₂Live j = Trusted.MirSemantics.getElem? slots₂ j := by
    intro j hj
    cases s4c_arrSc_nat_eq_or_ne j pack.bodySrc.locals.length with
    | inl hEq =>
      rw [hEq,
        getElem?_setElem?_self slots₂ pack.bodySrc.locals.length (.baseSlot (.live (some .unit)))
          slots₂Live hSet,
        hLive]
    | inr hNe =>
      exact getElem?_setElem?_ne slots₂ pack.bodySrc.locals.length j
        (.baseSlot (.live (some .unit))) slots₂Live (fun h => hNe h.symm) hSet
  have hPref : arrSc_PrefixMatch pack slots₁ slots₂Live := by
    refine ⟨hLM.1.1, fun i hi hNeArr => ?_⟩
    have hNeL : pack.bodySrc.locals.length ≠ i := fun h => by
      rw [h] at hi; exact nat_lt_irrefl i hi
    rw [getElem?_setElem?_ne slots₂ pack.bodySrc.locals.length i
      (.baseSlot (.live (some .unit))) slots₂Live hNeL hSet]
    exact hLM.1.2 i hi hNeArr
  exact arrSc_localMatch_lift_prefix pack hLM hPref
    (setElem?_length slots₂ pack.bodySrc.locals.length _ slots₂Live hSet) hGe rfl

private theorem s4c_arrSc_localMatch_set_prefix_other {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    (hLM : arrSc_LocalMatch pack slots₁ slots₂)
    {a : LocalId} (hLtA : a < pack.bodySrc.locals.length) (hNe : a ≠ plan.arrLocal)
    {sl : ArrSliceSlot}
    (hS1 : setElem? slots₁ a sl = some slots₁')
    (hS2 : setElem? slots₂ a sl = some slots₂') :
    arrSc_LocalMatch pack slots₁' slots₂' := by
  have hPref' : arrSc_PrefixMatch pack slots₁' slots₂' := by
    refine ⟨?_, fun i hi hNeArr => ?_⟩
    · rw [setElem?_length slots₁ a sl slots₁' hS1, hLM.1.1]
    · cases s4c_arrSc_nat_eq_or_ne i a with
      | inl hEq =>
        rw [hEq, getElem?_setElem?_self slots₂ a sl slots₂' hS2,
          getElem?_setElem?_self slots₁ a sl slots₁' hS1]
      | inr hNeI =>
        rw [getElem?_setElem?_ne slots₂ a i sl slots₂' (fun h => hNeI h.symm) hS2,
          getElem?_setElem?_ne slots₁ a i sl slots₁' (fun h => hNeI h.symm) hS1]
        exact hLM.1.2 i hi hNeArr
  have hGe : ∀ j : Nat, pack.bodySrc.locals.length ≤ j →
      Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j := by
    intro j hj
    have hNeJ : a ≠ j := fun hEq =>
      nat_lt_irrefl a (Nat.lt_of_lt_of_le hLtA (by rw [hEq]; exact hj))
    exact getElem?_setElem?_ne slots₂ a j sl slots₂' hNeJ hS2
  exact arrSc_localMatch_lift_prefix pack hLM hPref'
    (setElem?_length slots₂ a sl slots₂' hS2) hGe
    (getElem?_setElem?_ne slots₁ a plan.arrLocal sl slots₁' hNe hS1)

private theorem s4c_arrSc_compRel_liveArray_setElem {base len idx : Nat}
    {elems elems' : List (Option Val)} {slots₂ slots₂' : List ArrSliceSlot}
    {v : Val}
    (hComp : arrSc_CompRel base len slots₂ (.liveArray elems))
    (_hIdx : idx < len)
    (hSetElems : setElem? elems idx (some v) = some elems')
    (hSetSlots : setElem? slots₂ (base + 1 + idx) (.baseSlot (.live (some v))) = some slots₂') :
    arrSc_CompRel base len slots₂' (.liveArray elems') := by
  refine ⟨?_, ?_, fun j hj => ?_⟩
  · rw [setElem?_length elems idx (some v) elems' hSetElems, hComp.1]
  · have hNe : base + 1 + idx ≠ base := fun h => by
      have hLt : base < base + 1 + idx := by
        rw [Nat.add_assoc base 1 idx, Nat.add_comm 1 idx]
        exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ idx)
      rw [h] at hLt
      exact nat_lt_irrefl base hLt
    rw [getElem?_setElem?_ne slots₂ (base + 1 + idx) base _ slots₂' hNe hSetSlots]
    exact hComp.2.1
  · cases s4c_arrSc_nat_eq_or_ne j idx with
    | inl hEq =>
      rw [hEq]
      refine ⟨some v, getElem?_setElem?_self elems idx (some v) elems' hSetElems,
        getElem?_setElem?_self slots₂ (base + 1 + idx) (.baseSlot (.live (some v))) slots₂' hSetSlots⟩
    | inr hNeJ =>
      have hNeSlot : base + 1 + idx ≠ base + 1 + j := fun h =>
        hNeJ (Nat.add_left_cancel h).symm
      rw [getElem?_setElem?_ne elems idx j (some v) elems' (fun h => hNeJ h.symm) hSetElems,
        getElem?_setElem?_ne slots₂ (base + 1 + idx) (base + 1 + j) _ slots₂' hNeSlot hSetSlots]
      exact hComp.2.2 j hj

private theorem s4c_arrSc_localMatch_set_arrElem {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    {elems' : List (Option Val)} {idx : Nat} {sIdx : ArrSliceSlot}
    (hLM : arrSc_LocalMatch pack slots₁ slots₂)
    (hSet1 : setElem? slots₁ plan.arrLocal (.liveArray elems') = some slots₁')
    (hIdx : idx < pack.len)
    (hSet2 : setElem? slots₂ (pack.bodySrc.locals.length + 1 + idx) sIdx = some slots₂')
    (hComp : arrSc_CompRel pack.bodySrc.locals.length pack.len slots₂' (.liveArray elems')) :
    arrSc_LocalMatch pack slots₁' slots₂' := by
  let elLoc := pack.bodySrc.locals.length + 1 + idx
  have hGt : pack.bodySrc.locals.length < elLoc := by
    change pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + idx
    rw [Nat.add_assoc pack.bodySrc.locals.length 1 idx, Nat.add_comm 1 idx]
    exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ idx)
  have hLtScr : elLoc < pack.bodySrc.locals.length + 1 + pack.len :=
    Nat.add_lt_add_left hIdx (pack.bodySrc.locals.length + 1)
  refine ⟨⟨?_, fun i hi hNeArr => ?_⟩, ?_, ?_, fun r hr => ?_⟩
  · rw [setElem?_length slots₁ plan.arrLocal _ slots₁' hSet1, hLM.1.1]
  · have hNeEl : elLoc ≠ i := fun h =>
      nat_lt_irrefl i (Nat.lt_trans hi (by rw [← h]; exact hGt))
    rw [getElem?_setElem?_ne slots₂ elLoc i sIdx slots₂' hNeEl hSet2,
      getElem?_setElem?_ne slots₁ plan.arrLocal i (.liveArray elems') slots₁' (fun h => hNeArr h.symm) hSet1]
    exact hLM.1.2 i hi hNeArr
  · rw [setElem?_length slots₂ elLoc sIdx slots₂' hSet2, hLM.2.1]
  · exact ⟨.liveArray elems',
      getElem?_setElem?_self slots₁ plan.arrLocal (.liveArray elems') slots₁' hSet1, hComp⟩
  · have hNeR : elLoc ≠ pack.bodySrc.locals.length + 1 + pack.len + r := fun h => by
      have hLe : pack.bodySrc.locals.length + 1 + pack.len ≤ elLoc := by
        rw [h]; exact Nat.le_add_right _ r
      exact nat_lt_irrefl elLoc (Nat.lt_of_lt_of_le hLtScr hLe)
    rw [getElem?_setElem?_ne slots₂ elLoc _ sIdx slots₂' hNeR hSet2]
    exact hLM.2.2.2 r hr

