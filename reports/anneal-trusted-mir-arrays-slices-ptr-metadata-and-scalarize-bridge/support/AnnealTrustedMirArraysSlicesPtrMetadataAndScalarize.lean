private theorem arrSc_getElem?_none_of_le {α : Type} :
    ∀ (xs : List α) (i : Nat),
      xs.length ≤ i → Trusted.MirSemantics.getElem? xs i = none
  | [], _, _ => rfl
  | _ :: _, 0, h => nomatch h
  | _ :: xs, i + 1, h => arrSc_getElem?_none_of_le xs i (Nat.le_of_succ_le_succ h)

private theorem arrSc_evalStepArrSlice_at_stmt (p : ArrSliceProgram) (body : ArrSliceBody)
    (frame : ArrSliceFrame) (callerMem : CallerMemory) (bb : ArrSliceBlock)
    (stmt : ArrSliceStmt)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some stmt) :
    evalStepArrSlice p 0 { frames := [frame], callerMem } =
      evalArrSliceStmt body frame callerMem stmt := by
  dsimp [evalStepArrSlice]
  rw [hBody]
  dsimp
  rw [hBb]
  dsimp
  rw [hStmt]

private theorem arrSc_evalStepArrSlice_at_term (p : ArrSliceProgram) (body : ArrSliceBody)
    (frame : ArrSliceFrame) (callerMem : CallerMemory) (bb : ArrSliceBlock)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hEq : frame.stmtIdx = bb.statements.length) :
    evalStepArrSlice p 0 { frames := [frame], callerMem } =
      evalArrSliceTerm body bb frame callerMem := by
  dsimp [evalStepArrSlice]
  rw [hBody]
  dsimp
  rw [hBb]
  dsimp
  have hNone : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = none :=
    arrSc_getElem?_none_of_le bb.statements frame.stmtIdx (by rw [hEq]; exact nat_le_refl _)
  rw [hNone]
  dsimp
  rw [nat_beq_true hEq]
  rfl

private theorem arrSc_evalStepArrSlice_oob (p : ArrSliceProgram) (body : ArrSliceBody)
    (frame : ArrSliceFrame) (callerMem : CallerMemory) (bb : ArrSliceBlock)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hGt : bb.statements.length < frame.stmtIdx) :
    evalStepArrSlice p 0 { frames := [frame], callerMem } = .fault .unsupported := by
  dsimp [evalStepArrSlice]
  rw [hBody]
  dsimp
  rw [hBb]
  dsimp
  have hNone : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = none :=
    arrSc_getElem?_none_of_le bb.statements frame.stmtIdx (Nat.le_of_lt hGt)
  have hNe : Nat.beq frame.stmtIdx bb.statements.length = false :=
    nat_beq_false (fun hEq => by rw [hEq] at hGt; exact nat_lt_irrefl _ hGt)
  rw [hNone]
  dsimp
  rw [hNe]
  rfl

private theorem arrSc_reachesNArrSlice_one_step {p : ArrSliceProgram} {s s' : ArrSliceState}
    (h : evalStepArrSlice p 0 s = .step s') :
    ReachesNArrSlice p 1 s s' :=
  ReachesNArrSlice.succ ((stepArrSlice_iff_evalStep p s (.step s')).mpr h)
    (ReachesNArrSlice.zero s')

private theorem arrSc_reachesArrSlice_of_reach_fault {p : ArrSliceProgram} {n : Nat}
    {s₁ s₂ : ArrSliceState} {k : FaultKind}
    (hR : ReachesNArrSlice p n s₁ s₂) (hF : evalStepArrSlice p 0 s₂ = .fault k) :
    ∃ s' : ArrSliceState, ReachesArrSlice p s₁ s' ∧ StepArrSlice p s' (.fault k) :=
  ⟨s₂, reachesArrSlice_of_reachesNArrSlice hR, (stepArrSlice_iff_evalStep p s₂ (.fault k)).mpr hF⟩

private theorem arrSc_reachesArrSlice_of_reach_done {p : ArrSliceProgram} {n : Nat}
    {s₁ s₂ : ArrSliceState} {out : TerminalOut}
    (hR : ReachesNArrSlice p n s₁ s₂) (hD : evalStepArrSlice p 0 s₂ = .done out) :
    ∃ s' : ArrSliceState, ReachesArrSlice p s₁ s' ∧ StepArrSlice p s' (.done out) :=
  ⟨s₂, reachesArrSlice_of_reachesNArrSlice hR, (stepArrSlice_iff_evalStep p s₂ (.done out)).mpr hD⟩

private theorem arrSc_step_mkLivenessCheckStmt_dead (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (callerMem : CallerMemory)
    (liveLoc : LocalId)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx =
      some (mkLivenessCheckStmt liveLoc))
    (hDecl : Trusted.MirSemantics.getElem? body.locals liveLoc = some (.base .unit))
    (hDead : Trusted.MirSemantics.getElem? frame.locals liveLoc = some (.baseSlot .dead)) :
    evalStepArrSlice p 0 { frames := [frame], callerMem } = .fault .undefined := by
  rw [arrSc_evalStepArrSlice_at_stmt p body frame callerMem bb _ hBody hBb hStmt]
  dsimp [mkLivenessCheckStmt, evalArrSliceStmt]
  rw [hDecl]
  dsimp
  have hEval : evalArrSliceBaseRvalue body.locals frame.locals .unit
      (.use (.constant { ty := .unit, lit := .zeroSized })) = .ok (.unit, frame.locals) := rfl
  rw [hEval]
  dsimp
  unfold writeArrSliceBasePlace
  have hChk : (!checkVal Val.unit MirTy.unit) = false := rfl
  rw [hChk]
  dsimp
  rw [hDead]

private theorem arrSc_step_mkLivenessCheckStmt_live (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (callerMem : CallerMemory)
    (liveLoc : LocalId) (ov : Option Val)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx =
      some (mkLivenessCheckStmt liveLoc))
    (hDecl : Trusted.MirSemantics.getElem? body.locals liveLoc = some (.base .unit))
    (hLive : Trusted.MirSemantics.getElem? frame.locals liveLoc = some (.baseSlot (.live ov))) :
    ∃ slots' : List ArrSliceSlot,
      setElem? frame.locals liveLoc (.baseSlot (.live (some .unit))) = some slots' ∧
      evalStepArrSlice p 0 { frames := [frame], callerMem } =
        stepStmtNext frame callerMem slots' := by
  have hLtSl := getElem?_some_lt frame.locals liveLoc (.baseSlot (.live ov)) hLive
  cases hSet : setElem? frame.locals liveLoc (.baseSlot (.live (some .unit))) with
  | none =>
    cases lt_setElem?_some frame.locals liveLoc (.baseSlot (.live (some .unit))) hLtSl with
    | intro _ hS => rw [hS] at hSet; cases hSet
  | some slots' =>
    refine ⟨slots', rfl, ?_⟩
    rw [arrSc_evalStepArrSlice_at_stmt p body frame callerMem bb _ hBody hBb hStmt]
    dsimp [mkLivenessCheckStmt, evalArrSliceStmt]
    rw [hDecl]
    dsimp
    have hEval : evalArrSliceBaseRvalue body.locals frame.locals .unit
        (.use (.constant { ty := .unit, lit := .zeroSized })) = .ok (.unit, frame.locals) := rfl
    rw [hEval]
    dsimp
    unfold writeArrSliceBasePlace
    have hChk : (!checkVal Val.unit MirTy.unit) = false := rfl
    rw [hChk]
    dsimp
    rw [hLive]
    dsimp
    rw [hSet]

private theorem arrSc_step_mkImmediateUbStmt (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (callerMem : CallerMemory)
    (scrUsize : LocalId)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx =
      some (mkImmediateUbStmt scrUsize))
    (hDecl : Trusted.MirSemantics.getElem? body.locals scrUsize = some (.base usizeTy)) :
    evalStepArrSlice p 0 { frames := [frame], callerMem } = .fault .undefined := by
  rw [arrSc_evalStepArrSlice_at_stmt p body frame callerMem bb _ hBody hBb hStmt]
  dsimp [mkImmediateUbStmt, evalArrSliceStmt]
  rw [hDecl]
  dsimp
  dsimp [evalArrSliceBaseRvalue]
  have hOp0 : evalArrSlicePrimitiveOperand body.locals frame.locals (usizeConst 0) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 0⟩, frame.locals) := by
    dsimp [evalArrSlicePrimitiveOperand, evalArrSliceBaseOperandToSlot, usizeConst]
    rw [evalConstLit_usizeConst_of_lt_maxUsize 0 (nat_pow_two_pos 64)]
    rfl
  have hOp1 : evalArrSlicePrimitiveOperand body.locals frame.locals (usizeConst 1) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 1⟩, frame.locals) := by
    dsimp [evalArrSlicePrimitiveOperand, evalArrSliceBaseOperandToSlot, usizeConst]
    have h1 : 1 < maxUsize := by
      rw [arrSc_maxUsize_eq]
      exact s_nat_one_lt_pow (by intro h; cases h) (Nat.le_refl 2)
    rw [evalConstLit_usizeConst_of_lt_maxUsize 1 h1]
    rfl
  rw [hOp0]
  dsimp only
  rw [hOp1]
  dsimp only
  rw [arrSc_evalBinOp_usize_subUnchecked_zero_one]

private theorem arrSc_step_mkAssignUse_typedOp_err (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (callerMem : CallerMemory)
    (dst : LocalId) (expectedTy : MirTy) (op : Operand) (k : FaultKind)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx =
      some (mkAssignUse dst op))
    (hDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base expectedTy))
    (hErr : evalArrSliceTypedOperand body.locals frame.locals expectedTy op = .error k) :
    evalStepArrSlice p 0 { frames := [frame], callerMem } = .fault k := by
  rw [arrSc_evalStepArrSlice_at_stmt p body frame callerMem bb _ hBody hBb hStmt]
  dsimp [mkAssignUse, evalArrSliceStmt]
  rw [hDecl]
  dsimp
  dsimp [evalArrSliceTypedOperand] at hErr
  cases hBase : evalArrSliceBaseOperandToSlot body.locals frame.locals op with
  | error k' =>
    rw [hBase] at hErr
    have hEqK : k' = k := Except.error.inj hErr
    rw [← hEqK]
    dsimp [evalArrSliceBaseRvalue]
    rw [hBase]
  | ok res =>
    rw [hBase] at hErr
    cases res with
    | mk srcTy rest => cases rest with
    | mk optVal slots' =>
      dsimp at hErr
      dsimp [evalArrSliceBaseRvalue]
      rw [hBase]
      dsimp
      cases hBeq : !MirTy.beq srcTy expectedTy with
      | true =>
        rw [hBeq] at hErr
        have hEqK : FaultKind.unsupported = k := Except.error.inj hErr
        rw [← hEqK]
        rfl
      | false =>
        rw [hBeq] at hErr
        dsimp at hErr
        dsimp
        cases optVal with
        | none =>
          have hEqK : FaultKind.undefined = k := Except.error.inj hErr
          rw [← hEqK]
        | some v =>
          dsimp at hErr
          dsimp
          cases hChk : checkVal v expectedTy with
          | true => rw [hChk] at hErr; cases hErr
          | false =>
            rw [hChk] at hErr
            have hEqK : FaultKind.unsupported = k := Except.error.inj hErr
            rw [← hEqK]
            unfold writeArrSliceBasePlace
            have hNotChk : (!checkVal v expectedTy) = true := by rw [hChk]; rfl
            rw [hNotChk]
            rfl

private theorem arrSc_step_mkAssignUse_typedOp_ok (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (callerMem : CallerMemory)
    (dst : LocalId) (expectedTy : MirTy) (op : Operand)
    (v : Val) (slots' slots'' : List ArrSliceSlot)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx =
      some (mkAssignUse dst op))
    (hDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base expectedTy))
    (hOk : evalArrSliceTypedOperand body.locals frame.locals expectedTy op = .ok (v, slots'))
    (ovDst : Option Val)
    (hLiveDst : Trusted.MirSemantics.getElem? slots' dst = some (.baseSlot (.live ovDst)))
    (hSet : setElem? slots' dst (.baseSlot (.live (some v))) = some slots'') :
    evalStepArrSlice p 0 { frames := [frame], callerMem } =
      stepStmtNext frame callerMem slots'' := by
  rw [arrSc_evalStepArrSlice_at_stmt p body frame callerMem bb _ hBody hBb hStmt]
  dsimp [mkAssignUse, evalArrSliceStmt]
  rw [hDecl]
  dsimp
  dsimp [evalArrSliceTypedOperand] at hOk
  cases hBase : evalArrSliceBaseOperandToSlot body.locals frame.locals op with
  | error _ => rw [hBase] at hOk; cases hOk
  | ok res =>
    rw [hBase] at hOk
    cases res with
    | mk srcTy rest => cases rest with
    | mk optVal slotsMid =>
      dsimp at hOk
      cases hBeq : !MirTy.beq srcTy expectedTy with
      | true => rw [hBeq] at hOk; cases hOk
      | false =>
        rw [hBeq] at hOk
        dsimp at hOk
        cases optVal with
        | none => cases hOk
        | some v' =>
          dsimp at hOk
          cases hChk : checkVal v' expectedTy with
          | false => rw [hChk] at hOk; cases hOk
          | true =>
            rw [hChk] at hOk
            have hPair := Option.some.inj (congrArg Except.toOption hOk)
            have hVEq : v' = v := congrArg Prod.fst hPair
            have hSlEq : slotsMid = slots' := congrArg Prod.snd hPair
            dsimp [evalArrSliceBaseRvalue]
            rw [hBase]
            dsimp
            rw [hBeq]
            dsimp
            rw [hVEq, hSlEq]
            unfold writeArrSliceBasePlace
            have hNotChk : (!checkVal v expectedTy) = false := by
              rw [← hVEq, hChk]; rfl
            rw [hNotChk]
            dsimp
            rw [hLiveDst]
            dsimp
            rw [hSet]

private theorem arrSc_step_mkLtUsize_move_const (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (callerMem : CallerMemory)
    (condScr idxScr : LocalId) (idx len : Nat)
    (hNe : condScr ≠ idxScr)
    (hIdx : idx < maxUsize) (hLen : len < maxUsize)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx =
      some (mkLtUsize condScr (.move { localId := idxScr, projection := [] }) (usizeConst len)))
    (hDeclCond : Trusted.MirSemantics.getElem? body.locals condScr = some (.base .bool))
    (hDeclIdx : Trusted.MirSemantics.getElem? body.locals idxScr = some (.base usizeTy))
    (hLiveIdx : Trusted.MirSemantics.getElem? frame.locals idxScr =
      some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 idx⟩)))))
    (ovCond : Option Val)
    (hLiveCond : Trusted.MirSemantics.getElem? frame.locals condScr = some (.baseSlot (.live ovCond))) :
    ∃ slotsAfterMove slots' : List ArrSliceSlot,
      setElem? frame.locals idxScr (.baseSlot (liveUninitSlot usizeTy)) = some slotsAfterMove ∧
      setElem? slotsAfterMove condScr (.baseSlot (.live (some (.bool (Nat.blt idx len))))) =
        some slots' ∧
      evalStepArrSlice p 0 { frames := [frame], callerMem } =
        stepStmtNext frame callerMem slots' := by
  have hLtIdx := getElem?_some_lt frame.locals idxScr _ hLiveIdx
  have hLtCond := getElem?_some_lt frame.locals condScr _ hLiveCond
  cases hSetMove : setElem? frame.locals idxScr (.baseSlot (liveUninitSlot usizeTy)) with
  | none =>
    cases lt_setElem?_some frame.locals idxScr (.baseSlot (liveUninitSlot usizeTy)) hLtIdx with
    | intro _ hS => rw [hS] at hSetMove; cases hSetMove
  | some slotsAfterMove =>
    have hLiveCond2 : Trusted.MirSemantics.getElem? slotsAfterMove condScr =
        some (.baseSlot (.live ovCond)) := by
      rw [getElem?_setElem?_ne frame.locals idxScr condScr _ slotsAfterMove hNe.symm hSetMove]
      exact hLiveCond
    have hLtCond2 : condScr < slotsAfterMove.length := by
      rw [setElem?_length frame.locals idxScr _ slotsAfterMove hSetMove]; exact hLtCond
    cases hSetCond : setElem? slotsAfterMove condScr
        (.baseSlot (.live (some (.bool (Nat.blt idx len))))) with
    | none =>
      cases lt_setElem?_some slotsAfterMove condScr
          (.baseSlot (.live (some (.bool (Nat.blt idx len))))) hLtCond2 with
      | intro _ hS => rw [hS] at hSetCond; cases hSetCond
    | some slots' =>
      refine ⟨slotsAfterMove, slots', rfl, hSetCond, ?_⟩
      rw [arrSc_evalStepArrSlice_at_stmt p body frame callerMem bb _ hBody hBb hStmt]
      dsimp [mkLtUsize, evalArrSliceStmt]
      rw [hDeclCond]
      dsimp
      dsimp [evalArrSliceBaseRvalue]
      have hPrimIdx : evalArrSlicePrimitiveOperand body.locals frame.locals
          (.move { localId := idxScr, projection := [] }) =
          .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 idx⟩, slotsAfterMove) := by
        dsimp [evalArrSlicePrimitiveOperand, evalArrSliceBaseOperandToSlot]
        rw [hDeclIdx, hLiveIdx]
        dsimp
        rw [hSetMove]
        rfl
      have hPrimLen : evalArrSlicePrimitiveOperand body.locals slotsAfterMove (usizeConst len) =
          .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 len⟩, slotsAfterMove) := by
        dsimp [evalArrSlicePrimitiveOperand, evalArrSliceBaseOperandToSlot, usizeConst]
        rw [evalConstLit_usizeConst_of_lt_maxUsize len hLen]
        rfl
      rw [hPrimIdx]
      dsimp only
      rw [hPrimLen]
      dsimp only
      rw [arrSc_evalBinOp_usize_lt idx len hIdx hLen]
      dsimp
      unfold writeArrSliceBasePlace
      have hChk : (!checkVal (.bool (Nat.blt idx len)) .bool) = false := rfl
      rw [hChk]
      dsimp
      rw [hLiveCond2]
      dsimp
      rw [hSetCond]

