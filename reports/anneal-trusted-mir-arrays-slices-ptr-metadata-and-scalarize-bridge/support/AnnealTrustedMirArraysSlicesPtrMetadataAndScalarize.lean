-- Section 8B: `evalStepArrSlice` Target-In-Bounds & `defId` Preservation
-- ============================================================================

private theorem arrSc_evalSwitchBranches_in_bounds (w : IntWidth) (bv : BitVec 128)
    (numBbs otherwise : Nat) (hOth : Nat.blt otherwise numBbs = true) :
    ∀ (branches : List (BitVec 128 × BasicBlockId)),
      branches.all (fun br => Nat.blt br.2 numBbs) = true →
      ∀ target : BasicBlockId,
        evalSwitchBranches w bv otherwise branches = .ok target →
        target < numBbs
  | [], _, target, h => by
    cases Except.ok.inj h
    exact nat_blt_lt hOth
  | (val, tgt) :: rest, hAll, target, h => by
    have hAnd := (bool_and_eq_true (Nat.blt tgt numBbs)
      (rest.all (fun br => Nat.blt br.2 numBbs))).mp hAll
    dsimp [evalSwitchBranches] at h
    cases hNe : truncateBits w val != val with
    | true => rw [hNe] at h; cases h
    | false =>
      rw [hNe] at h; dsimp at h
      cases hEq : truncateBits w bv == truncateBits w val with
      | true =>
        rw [hEq] at h
        cases Except.ok.inj h
        exact nat_blt_lt hAnd.1
      | false =>
        rw [hEq] at h
        exact arrSc_evalSwitchBranches_in_bounds w bv numBbs otherwise hOth rest hAnd.2 target h

private theorem arrSc_evalBoolSwitchBranches_in_bounds (discr : Bool)
    (numBbs otherwise : Nat) (hOth : Nat.blt otherwise numBbs = true) :
    ∀ (branches : List (BitVec 128 × BasicBlockId)),
      branches.all (fun br => Nat.blt br.2 numBbs) = true →
      ∀ target : BasicBlockId,
        evalBoolSwitchBranches discr otherwise branches = .ok target →
        target < numBbs
  | [], _, target, h => by
    cases Except.ok.inj h
    exact nat_blt_lt hOth
  | (caseBits, tgt) :: rest, hAll, target, h => by
    have hAnd := (bool_and_eq_true (Nat.blt tgt numBbs)
      (rest.all (fun br => Nat.blt br.2 numBbs))).mp hAll
    dsimp [evalBoolSwitchBranches] at h
    cases hLit : evalConstLit .bool (.scalar caseBits) with
    | error _ => rw [hLit] at h; cases h
    | ok v =>
      rw [hLit] at h
      cases v with
      | scalar _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => cases h
      | bool b =>
        cases b with
        | false =>
          dsimp at h
          cases discr with
          | false =>
            dsimp at h; cases Except.ok.inj h; exact nat_blt_lt hAnd.1
          | true =>
            dsimp at h
            exact arrSc_evalBoolSwitchBranches_in_bounds true numBbs otherwise hOth rest hAnd.2 target h
        | true =>
          dsimp at h
          cases discr with
          | true =>
            dsimp at h; cases Except.ok.inj h; exact nat_blt_lt hAnd.1
          | false =>
            dsimp at h
            exact arrSc_evalBoolSwitchBranches_in_bounds false numBbs otherwise hOth rest hAnd.2 target h

private theorem arrSc_stepStmtNext_preserves (f : ArrSliceFrame) (cm : CallerMemory)
    (slots : List ArrSliceSlot) {s' : ArrSliceState}
    (h : stepStmtNext f cm slots = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId ∧ f'.blockIdx = f.blockIdx := by
  have hEq := StepResult.step.inj h
  rw [← hEq]
  exact ⟨{ f with stmtIdx := f.stmtIdx + 1, locals := slots }, rfl, rfl, rfl⟩

private theorem arrSc_jumpArrSliceBlock_preserves (f : ArrSliceFrame) (cm : CallerMemory)
    (slots : List ArrSliceSlot) (target : BasicBlockId) {s' : ArrSliceState}
    (h : jumpArrSliceBlock f cm slots target = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId ∧ f'.blockIdx = target := by
  have hEq := StepResult.step.inj h
  rw [← hEq]
  exact ⟨{ f with blockIdx := target, stmtIdx := 0, locals := slots }, rfl, rfl, rfl⟩

private theorem arrSc_evalReadArrayAtIdx_preserves (body : ArrSliceBody)
    (f : ArrSliceFrame) (cm : CallerMemory) (slots : List ArrSliceSlot)
    (dstLocal arrLocal : LocalId) (effIdx : Nat) (nextBb : BasicBlockId)
    {s' : ArrSliceState}
    (h : evalReadArrayAtIdx body f cm slots dstLocal arrLocal effIdx nextBb = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId ∧ f'.blockIdx = nextBb := by
  dsimp [evalReadArrayAtIdx] at h
  cases hD : Trusted.MirSemantics.getElem? body.locals dstLocal with
  | none => rw [hD] at h; cases h
  | some dDst =>
    rw [hD] at h
    cases dDst with
    | array _ _ | sliceView _ => cases h
    | base dstTy =>
      cases hA : Trusted.MirSemantics.getElem? body.locals arrLocal with
      | none => rw [hA] at h; cases h
      | some dArr =>
        rw [hA] at h
        cases dArr with
        | base _ | sliceView _ => cases h
        | array elemTy len =>
          cases hS : Trusted.MirSemantics.getElem? slots arrLocal with
          | none => rw [hS] at h; cases h
          | some arrSl =>
            rw [hS] at h; dsimp at h
            cases hTy : !(MirTy.beq dstTy elemTy) with
            | true => rw [hTy] at h; cases h
            | false =>
              rw [hTy] at h; dsimp at h
              cases arrSl with
              | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
              | liveArray elems =>
                cases hIn : !Nat.blt effIdx len with
                | true => rw [hIn] at h; cases h
                | false =>
                  rw [hIn] at h; dsimp at h
                  cases hEl : Trusted.MirSemantics.getElem? elems effIdx with
                  | none => rw [hEl] at h; cases h
                  | some ov =>
                    rw [hEl] at h
                    cases ov with
                    | none => cases h
                    | some v =>
                      dsimp at h
                      cases hW : writeArrSliceBasePlace slots dstLocal dstTy v with
                      | error _ => rw [hW] at h; cases h
                      | ok slots' =>
                        rw [hW] at h
                        exact arrSc_jumpArrSliceBlock_preserves f cm slots' nextBb h

private theorem arrSc_evalArrSliceStmt_preserves (body : ArrSliceBody)
    (f : ArrSliceFrame) (cm : CallerMemory) (stmt : ArrSliceStmt) {s' : ArrSliceState}
    (h : evalArrSliceStmt body f cm stmt = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId ∧ f'.blockIdx = f.blockIdx := by
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop => exact arrSc_stepStmtNext_preserves f cm f.locals h
    | unsupported => cases h
    | storageLive id =>
      dsimp [evalArrSliceStmt] at h
      cases hD : Trusted.MirSemantics.getElem? body.locals id with
      | none => rw [hD] at h; cases h
      | some decl =>
        rw [hD] at h; dsimp at h
        cases hS : setElem? f.locals id (liveUninitArrSliceSlot decl) with
        | none => rw [hS] at h; cases h
        | some slots' => rw [hS] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
    | storageDead id =>
      dsimp [evalArrSliceStmt] at h
      cases hZ : Nat.beq id 0 with
      | true => rw [hZ] at h; cases h
      | false =>
        rw [hZ] at h; dsimp at h
        cases hS : setElem? f.locals id _ with
        | none => rw [hS] at h; cases h
        | some slots' => rw [hS] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
    | assign dst rval =>
      dsimp [evalArrSliceStmt] at h
      cases hP : !dst.projection.isEmpty with
      | true => rw [hP] at h; cases h
      | false =>
        rw [hP] at h; dsimp at h
        cases hD : Trusted.MirSemantics.getElem? body.locals dst.localId with
        | none => rw [hD] at h; cases h
        | some decl =>
          rw [hD] at h
          cases decl with
          | array _ _ | sliceView _ => cases h
          | base dstTy =>
            dsimp at h
            cases hR : evalArrSliceBaseRvalue body.locals f.locals dstTy rval with
            | error _ => rw [hR] at h; cases h
            | ok p =>
              rw [hR] at h; dsimp at h
              cases hW : writeArrSliceBasePlace p.2 dst.localId dstTy p.1 with
              | error _ => rw [hW] at h; cases h
              | ok slots' => rw [hW] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
  | aggregateArray a ops =>
    dsimp [evalArrSliceStmt] at h
    cases hD : Trusted.MirSemantics.getElem? body.locals a with
    | none => rw [hD] at h; cases h
    | some decl =>
      rw [hD] at h
      cases decl with
      | base _ | sliceView _ => cases h
      | array elemTy len =>
        dsimp at h
        cases hE : !Nat.beq ops.length len with
        | true => rw [hE] at h; cases h
        | false =>
          rw [hE] at h; dsimp at h
          cases hOps : evalArrSliceTypedOps body.locals elemTy f.locals ops with
          | error _ => rw [hOps] at h; cases h
          | ok p =>
            rw [hOps] at h; dsimp at h
            cases hS : Trusted.MirSemantics.getElem? p.2 a with
            | none => rw [hS] at h; cases h
            | some sl =>
              rw [hS] at h
              cases sl with
              | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
              | liveArray _ =>
                cases hSet : setElem? p.2 a (.liveArray (p.1.map some)) with
                | none => rw [hSet] at h; cases h
                | some slots' => rw [hSet] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
  | repeatArray a op =>
    dsimp [evalArrSliceStmt] at h
    cases hD : Trusted.MirSemantics.getElem? body.locals a with
    | none => rw [hD] at h; cases h
    | some decl =>
      rw [hD] at h
      cases decl with
      | base _ | sliceView _ => cases h
      | array elemTy len =>
        dsimp at h
        cases hOp : evalArrSliceTypedOperand body.locals f.locals elemTy op with
        | error _ => rw [hOp] at h; cases h
        | ok p =>
          rw [hOp] at h; dsimp at h
          cases hS : Trusted.MirSemantics.getElem? p.2 a with
          | none => rw [hS] at h; cases h
          | some sl =>
            rw [hS] at h
            cases sl with
            | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
            | liveArray _ =>
              cases hSet : setElem? p.2 a (.liveArray (listReplicate len (some p.1))) with
              | none => rw [hSet] at h; cases h
              | some slots' => rw [hSet] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
  | arrayLivenessCheck a =>
    dsimp [evalArrSliceStmt] at h
    cases hD : Trusted.MirSemantics.getElem? body.locals a with
    | none => rw [hD] at h; cases h
    | some decl =>
      rw [hD] at h
      cases decl with
      | base _ | sliceView _ => cases h
      | array _ _ =>
        cases hS : Trusted.MirSemantics.getElem? f.locals a with
        | none => rw [hS] at h; cases h
        | some sl =>
          rw [hS] at h
          cases sl with
          | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
          | liveArray _ => exact arrSc_stepStmtNext_preserves f cm f.locals h
  | readArrayConst dst a idx isMove =>
    dsimp [evalArrSliceStmt] at h
    cases hDD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hDD] at h; cases h
    | some dDst =>
      rw [hDD] at h
      cases dDst with
      | array _ _ | sliceView _ => cases h
      | base dstTy =>
        cases hDA : Trusted.MirSemantics.getElem? body.locals a with
        | none => rw [hDA] at h; cases h
        | some dA =>
          rw [hDA] at h
          cases dA with
          | base _ | sliceView _ => cases h
          | array elemTy len =>
            cases hSA : Trusted.MirSemantics.getElem? f.locals a with
            | none => rw [hSA] at h; cases h
            | some slA =>
              rw [hSA] at h
              cases slA with
              | baseSlot _ | sliceDead | liveSlice _ => cases h
              | arrDead =>
                dsimp at h
                cases hTy : MirTy.beq dstTy elemTy with
                | true => rw [hTy] at h; cases h
                | false => rw [hTy] at h; cases h
              | liveArray elems =>
                dsimp at h
                cases hTy : !MirTy.beq dstTy elemTy with
                | true => rw [hTy] at h; cases h
                | false =>
                  rw [hTy] at h; dsimp at h
                  cases hIn : !Nat.blt idx len with
                  | true => rw [hIn] at h; cases h
                  | false =>
                    rw [hIn] at h; dsimp at h
                    cases hEl : Trusted.MirSemantics.getElem? elems idx with
                    | none => rw [hEl] at h; cases h
                    | some ov =>
                      rw [hEl] at h
                      cases ov with
                      | none => cases h
                      | some v =>
                        dsimp at h
                        cases hMv : isMove with
                        | false =>
                          rw [hMv] at h; dsimp at h
                          cases hW : writeArrSliceBasePlace f.locals dst dstTy v with
                          | error _ => rw [hW] at h; cases h
                          | ok slots' => rw [hW] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
                        | true =>
                          rw [hMv] at h; dsimp at h
                          cases hSE : setElem? elems idx (initElemOptVal elemTy) with
                          | none => rw [hSE] at h; cases h
                          | some elems' =>
                            rw [hSE] at h; dsimp at h
                            cases hS1 : setElem? f.locals a (.liveArray elems') with
                            | none => rw [hS1] at h; cases h
                            | some slots₁R =>
                              rw [hS1] at h; dsimp at h
                              cases hW : writeArrSliceBasePlace slots₁R dst dstTy v with
                              | error _ => rw [hW] at h; cases h
                              | ok slots' => rw [hW] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
  | writeArrayConst a idx rval =>
    dsimp [evalArrSliceStmt] at h
    cases hDA : Trusted.MirSemantics.getElem? body.locals a with
    | none => rw [hDA] at h; cases h
    | some dA =>
      rw [hDA] at h
      cases dA with
      | base _ | sliceView _ => cases h
      | array elemTy len =>
        dsimp at h
        cases hR : evalArrSliceBaseRvalue body.locals f.locals elemTy rval with
        | error _ => rw [hR] at h; cases h
        | ok p =>
          rw [hR] at h; dsimp at h
          cases hChk : !checkVal p.1 elemTy with
          | true => rw [hChk] at h; cases h
          | false =>
            rw [hChk] at h; dsimp at h
            cases hSA : Trusted.MirSemantics.getElem? p.2 a with
            | none => rw [hSA] at h; cases h
            | some slA =>
              rw [hSA] at h
              cases slA with
              | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
              | liveArray elems =>
                dsimp at h
                cases hIn : !Nat.blt idx len with
                | true => rw [hIn] at h; cases h
                | false =>
                  rw [hIn] at h; dsimp at h
                  cases hSE : setElem? elems idx (some p.1) with
                  | none => rw [hSE] at h; cases h
                  | some elems' =>
                    rw [hSE] at h; dsimp at h
                    cases hSet : setElem? p.2 a (.liveArray elems') with
                    | none => rw [hSet] at h; cases h
                    | some slots' => rw [hSet] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
  | unsizeArrayToSlice sLoc a =>
    dsimp [evalArrSliceStmt] at h
    cases hDS : Trusted.MirSemantics.getElem? body.locals sLoc with
    | none => rw [hDS] at h; cases h
    | some dS =>
      rw [hDS] at h
      cases dS with
      | base _ | array _ _ => cases h
      | sliceView sElemTy =>
        cases hDA : Trusted.MirSemantics.getElem? body.locals a with
        | none => rw [hDA] at h; cases h
        | some dA =>
          rw [hDA] at h
          cases dA with
          | base _ | sliceView _ => cases h
          | array aElemTy aLen =>
            dsimp at h
            cases hTy : !MirTy.beq sElemTy aElemTy with
            | true => rw [hTy] at h; cases h
            | false =>
              rw [hTy] at h; dsimp at h
              cases hSA : Trusted.MirSemantics.getElem? f.locals a with
              | none => rw [hSA] at h; cases h
              | some slA =>
                rw [hSA] at h
                cases slA with
                | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
                | liveArray _ =>
                  cases hSS : Trusted.MirSemantics.getElem? f.locals sLoc with
                  | none => rw [hSS] at h; cases h
                  | some slS =>
                    rw [hSS] at h
                    cases slS with
                    | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
                    | liveSlice _ =>
                      cases hSet : setElem? f.locals sLoc _ with
                      | none => rw [hSet] at h; cases h
                      | some slots' => rw [hSet] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
  | sliceFromRawParts sLoc lenOp =>
    dsimp [evalArrSliceStmt] at h
    cases hDS : Trusted.MirSemantics.getElem? body.locals sLoc with
    | none => rw [hDS] at h; cases h
    | some dS =>
      rw [hDS] at h
      cases dS with
      | base _ | array _ _ => cases h
      | sliceView _ =>
        cases hLen : evalUsizeOperand body.locals f.locals lenOp with
        | error _ => rw [hLen] at h; cases h
        | ok p =>
          rw [hLen] at h; dsimp at h
          cases hSS : Trusted.MirSemantics.getElem? p.2 sLoc with
          | none => rw [hSS] at h; cases h
          | some slS =>
            rw [hSS] at h
            cases slS with
            | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
            | liveSlice _ =>
              cases hSet : setElem? p.2 sLoc _ with
              | none => rw [hSet] at h; cases h
              | some slots' => rw [hSet] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
  | subslice dstS srcS fromIdx toIdx fromEnd =>
    dsimp [evalArrSliceStmt] at h
    cases hDD : Trusted.MirSemantics.getElem? body.locals dstS with
    | none => rw [hDD] at h; cases h
    | some dD =>
      rw [hDD] at h
      cases dD with
      | base _ | array _ _ => cases h
      | sliceView dstTy =>
        cases hDS : Trusted.MirSemantics.getElem? body.locals srcS with
        | none => rw [hDS] at h; cases h
        | some dS =>
          rw [hDS] at h
          cases dS with
          | base _ | array _ _ => cases h
          | sliceView srcTy =>
            cases hSS : Trusted.MirSemantics.getElem? f.locals srcS with
            | none => rw [hSS] at h; cases h
            | some slS =>
              rw [hSS] at h; dsimp at h
              cases hCond : (!(MirTy.beq dstTy srcTy) || !Nat.blt fromIdx maxUsize || !Nat.blt toIdx maxUsize) with
              | true => rw [hCond] at h; cases h
              | false =>
                rw [hCond] at h; dsimp at h
                cases slS with
                | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hSub : evalSubsliceVal sv fromIdx toIdx fromEnd with
                    | error _ => rw [hSub] at h; cases h
                    | ok sv' =>
                      rw [hSub] at h; dsimp at h
                      cases hSD : Trusted.MirSemantics.getElem? f.locals dstS with
                      | none => rw [hSD] at h; cases h
                      | some slD =>
                        rw [hSD] at h
                        cases slD with
                        | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
                        | liveSlice _ =>
                          cases hSet : setElem? f.locals dstS (.liveSlice (some sv')) with
                          | none => rw [hSet] at h; cases h
                          | some slots' => rw [hSet] at h; exact arrSc_stepStmtNext_preserves f cm slots' h
  | ptrMetadata dst sLoc =>
    dsimp [evalArrSliceStmt] at h
    cases hDD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hDD] at h; cases h
    | some dD =>
      rw [hDD] at h
      cases dD with
      | array _ _ | sliceView _ => cases h
      | base dstTy =>
        cases hDS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hDS] at h; cases h
        | some dS =>
          rw [hDS] at h
          cases dS with
          | base _ | array _ _ => cases h
          | sliceView _ =>
            cases hSS : Trusted.MirSemantics.getElem? f.locals sLoc with
            | none => rw [hSS] at h; cases h
            | some slS =>
              rw [hSS] at h; dsimp at h
              cases hTy : !(MirTy.beq dstTy usizeTy) with
              | true => rw [hTy] at h; cases h
              | false =>
                rw [hTy] at h; dsimp at h
                cases slS with
                | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hW : writeArrSliceBasePlace f.locals dst dstTy
                        (.scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩) with
                    | error _ => rw [hW] at h; cases h
                    | ok slots' => rw [hW] at h; exact arrSc_stepStmtNext_preserves f cm slots' h

private theorem arrSc_evalArrSliceTerm_preserves (body : ArrSliceBody)
    (bb : ArrSliceBlock) (f : ArrSliceFrame) (cm : CallerMemory) {s' : ArrSliceState}
    (h : evalArrSliceTerm body bb f cm = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId ∧
      (arrSliceTermTargetsInBounds body.basicBlocks.length bb.terminator = true →
        f'.blockIdx < body.basicBlocks.length) := by
  dsimp [evalArrSliceTerm] at h
  cases hT : bb.terminator with
  | baseTerm bt =>
    rw [hT] at h
    cases bt with
    | goto target =>
      dsimp at h
      cases arrSc_jumpArrSliceBlock_preserves f cm f.locals target h with
      | intro f' hf' =>
        refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
        rw [hf'.2.2]
        exact nat_blt_lt hB
    | return_ =>
      dsimp at h
      cases hCl : bb.cleanup with
      | true => rw [hCl] at h; cases h
      | false =>
        rw [hCl] at h; dsimp at h
        cases hS0 : Trusted.MirSemantics.getElem? f.locals 0 with
        | none => rw [hS0] at h; cases h
        | some sl =>
          rw [hS0] at h
          cases sl with
          | arrDead | liveArray _ | sliceDead | liveSlice _ => cases h
          | baseSlot b =>
            cases b with
            | dead => cases h
            | live ov => cases ov <;> cases h
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      dsimp at h; cases h
    | switchInt discr targets =>
      dsimp at h
      cases hP : evalArrSlicePrimitiveOperand body.locals f.locals discr with
      | error _ => rw [hP] at h; cases h
      | ok p =>
        rw [hP] at h; dsimp at h
        cases hV : p.1 with
        | ptr _ | tuple _ | enumVal _ _ | bytes _ | unit => rw [hV] at h; cases h
        | scalar sv =>
          rw [hV] at h; dsimp at h
          cases hSw : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
          | error _ => rw [hSw] at h; cases h
          | ok target =>
            rw [hSw] at h
            cases arrSc_jumpArrSliceBlock_preserves f cm p.2 target h with
            | intro f' hf' =>
              refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
              have hAnd := (bool_and_eq_true _ _).mp hB
              rw [hf'.2.2]
              exact arrSc_evalSwitchBranches_in_bounds sv.width sv.bits body.basicBlocks.length
                targets.otherwise hAnd.1 targets.branches hAnd.2 target hSw
        | bool b =>
          rw [hV] at h; dsimp at h
          cases hSw : evalBoolSwitchBranches b targets.otherwise targets.branches with
          | error _ => rw [hSw] at h; cases h
          | ok target =>
            rw [hSw] at h
            cases arrSc_jumpArrSliceBlock_preserves f cm p.2 target h with
            | intro f' hf' =>
              refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
              have hAnd := (bool_and_eq_true _ _).mp hB
              rw [hf'.2.2]
              exact arrSc_evalBoolSwitchBranches_in_bounds b body.basicBlocks.length
                targets.otherwise hAnd.1 targets.branches hAnd.2 target hSw
  | sliceLenCall dst sLoc target =>
    rw [hT] at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at h; cases h
    | some d1 =>
      rw [hD] at h
      cases d1 with
      | array _ _ | sliceView _ => cases h
      | base dstTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hS] at h; cases h
        | some d2 =>
          rw [hS] at h
          cases d2 with
          | base _ | array _ _ => cases h
          | sliceView _ =>
            cases hSl : Trusted.MirSemantics.getElem? f.locals sLoc with
            | none => rw [hSl] at h; cases h
            | some sliceSl =>
              rw [hSl] at h; dsimp at h
              cases hTy : !(MirTy.beq dstTy usizeTy) with
              | true => rw [hTy] at h; cases h
              | false =>
                rw [hTy] at h; dsimp at h
                cases sliceSl with
                | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hW : writeArrSliceBasePlace f.locals dst dstTy
                        (.scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩) with
                    | error _ => rw [hW] at h; cases h
                    | ok slots' =>
                      rw [hW] at h
                      cases arrSc_jumpArrSliceBlock_preserves f cm slots' target h with
                      | intro f' hf' =>
                        refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
                        rw [hf'.2.2]; exact nat_blt_lt hB
  | boundsCheckArray arrLocal idxOp inBb pBb =>
    rw [hT] at h; dsimp at h
    cases hA : Trusted.MirSemantics.getElem? body.locals arrLocal with
    | none => rw [hA] at h; cases h
    | some d =>
      rw [hA] at h
      cases d with
      | base _ | sliceView _ => cases h
      | array _ len =>
        cases hS : Trusted.MirSemantics.getElem? f.locals arrLocal with
        | none => rw [hS] at h; cases h
        | some sl =>
          rw [hS] at h
          cases sl with
          | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
          | liveArray _ =>
            dsimp at h
            cases hU : evalUsizeOperand body.locals f.locals idxOp with
            | error _ => rw [hU] at h; cases h
            | ok p =>
              rw [hU] at h
              cases arrSc_jumpArrSliceBlock_preserves f cm p.2
                  (if Nat.blt p.1 len then inBb else pBb) h with
              | intro f' hf' =>
                refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
                have hAnd := (bool_and_eq_true _ _).mp hB
                rw [hf'.2.2]
                cases Nat.blt p.1 len with
                | true => exact nat_blt_lt hAnd.1
                | false => exact nat_blt_lt hAnd.2
  | boundsCheckSlice sLoc idxOp inBb pBb =>
    rw [hT] at h; dsimp at h
    cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
    | none => rw [hS] at h; cases h
    | some d =>
      rw [hS] at h
      cases d with
      | base _ | array _ _ => cases h
      | sliceView _ =>
        cases hSl : Trusted.MirSemantics.getElem? f.locals sLoc with
        | none => rw [hSl] at h; cases h
        | some sl =>
          rw [hSl] at h
          cases sl with
          | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
          | liveSlice osv =>
            cases osv with
            | none => cases h
            | some sv =>
              dsimp at h
              cases hU : evalUsizeOperand body.locals f.locals idxOp with
              | error _ => rw [hU] at h; cases h
              | ok p =>
                rw [hU] at h
                cases arrSc_jumpArrSliceBlock_preserves f cm p.2
                    (if Nat.blt p.1 sv.len then inBb else pBb) h with
                | intro f' hf' =>
                  refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
                  have hAnd := (bool_and_eq_true _ _).mp hB
                  rw [hf'.2.2]
                  cases Nat.blt p.1 sv.len with
                  | true => exact nat_blt_lt hAnd.1
                  | false => exact nat_blt_lt hAnd.2
  | readArrayElem dst arrLocal idxOp nextBb =>
    rw [hT] at h; dsimp at h
    cases hU : evalUsizeOperand body.locals f.locals idxOp with
    | error _ => rw [hU] at h; cases h
    | ok p =>
      rw [hU] at h
      cases arrSc_evalReadArrayAtIdx_preserves body f cm p.2 dst arrLocal p.1 nextBb h with
      | intro f' hf' =>
        refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
        rw [hf'.2.2]; exact nat_blt_lt hB
  | writeArrayElem arrLocal idxOp valOp nextBb =>
    rw [hT] at h; dsimp at h
    cases hA : Trusted.MirSemantics.getElem? body.locals arrLocal with
    | none => rw [hA] at h; cases h
    | some d =>
      rw [hA] at h
      cases d with
      | base _ | sliceView _ => cases h
      | array elemTy len =>
        cases hU : evalUsizeOperand body.locals f.locals idxOp with
        | error _ => rw [hU] at h; cases h
        | ok p =>
          rw [hU] at h; dsimp at h
          cases hT2 : evalArrSliceTypedOperand body.locals p.2 elemTy valOp with
          | error _ => rw [hT2] at h; cases h
          | ok q =>
            rw [hT2] at h; dsimp at h
            cases hSl : Trusted.MirSemantics.getElem? q.2 arrLocal with
            | none => rw [hSl] at h; cases h
            | some sl =>
              rw [hSl] at h
              cases sl with
              | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
              | liveArray elems =>
                dsimp at h
                cases hLt : !Nat.blt p.1 len with
                | true => rw [hLt] at h; cases h
                | false =>
                  rw [hLt] at h; dsimp at h
                  cases hEl : setElem? elems p.1 (some q.1) with
                  | none => rw [hEl] at h; cases h
                  | some elems' =>
                    rw [hEl] at h; dsimp at h
                    cases hSet : setElem? q.2 arrLocal (.liveArray elems') with
                    | none => rw [hSet] at h; cases h
                    | some slots' =>
                      rw [hSet] at h
                      cases arrSc_jumpArrSliceBlock_preserves f cm slots' nextBb h with
                      | intro f' hf' =>
                        refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
                        rw [hf'.2.2]; exact nat_blt_lt hB
  | readSliceElem dst sLoc idxOp nextBb =>
    rw [hT] at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at h; cases h
    | some d1 =>
      rw [hD] at h
      cases d1 with
      | array _ _ | sliceView _ => cases h
      | base dstTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hS] at h; cases h
        | some d2 =>
          rw [hS] at h
          cases d2 with
          | base _ | array _ _ => cases h
          | sliceView elemTy =>
            cases hSl : Trusted.MirSemantics.getElem? f.locals sLoc with
            | none => rw [hSl] at h; cases h
            | some sliceSl =>
              rw [hSl] at h; dsimp at h
              cases hTy : !(MirTy.beq dstTy elemTy) with
              | true => rw [hTy] at h; cases h
              | false =>
                rw [hTy] at h; dsimp at h
                cases sliceSl with
                | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hU : evalUsizeOperand body.locals f.locals idxOp with
                    | error _ => rw [hU] at h; cases h
                    | ok p =>
                      rw [hU] at h; dsimp at h
                      cases hLt : !Nat.blt p.1 sv.len with
                      | true => rw [hLt] at h; cases h
                      | false =>
                        rw [hLt] at h; dsimp at h
                        cases hBk : sv.backing with
                        | dangling => rw [hBk] at h; cases h
                        | arrayLocal arrLocal =>
                          rw [hBk] at h; dsimp at h
                          cases hOob : !Nat.blt (sv.start + p.1) maxUsize with
                          | true => rw [hOob] at h; cases h
                          | false =>
                            rw [hOob] at h; dsimp at h
                            cases arrSc_evalReadArrayAtIdx_preserves body f cm p.2 dst arrLocal
                                (sv.start + p.1) nextBb h with
                            | intro f' hf' =>
                              refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
                              rw [hf'.2.2]; exact nat_blt_lt hB
  | readSliceConst dst sLoc offset minLen fromEnd nextBb =>
    rw [hT] at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at h; cases h
    | some d1 =>
      rw [hD] at h
      cases d1 with
      | array _ _ | sliceView _ => cases h
      | base dstTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hS] at h; cases h
        | some d2 =>
          rw [hS] at h
          cases d2 with
          | base _ | array _ _ => cases h
          | sliceView elemTy =>
            cases hSl : Trusted.MirSemantics.getElem? f.locals sLoc with
            | none => rw [hSl] at h; cases h
            | some sliceSl =>
              rw [hSl] at h; dsimp at h
              cases hCond : (!(MirTy.beq dstTy elemTy) || !Nat.blt offset maxUsize || !Nat.blt minLen maxUsize) with
              | true => rw [hCond] at h; cases h
              | false =>
                rw [hCond] at h; dsimp at h
                cases sliceSl with
                | baseSlot _ | arrDead | liveArray _ | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hRel : evalSliceConstRelIdx sv.len offset minLen fromEnd with
                    | error _ => rw [hRel] at h; cases h
                    | ok relIdx =>
                      rw [hRel] at h; dsimp at h
                      cases hBk : sv.backing with
                      | dangling => rw [hBk] at h; cases h
                      | arrayLocal arrLocal =>
                        rw [hBk] at h; dsimp at h
                        cases hOob : !Nat.blt (sv.start + relIdx) maxUsize with
                        | true => rw [hOob] at h; cases h
                        | false =>
                          rw [hOob] at h; dsimp at h
                          cases arrSc_evalReadArrayAtIdx_preserves body f cm f.locals dst arrLocal
                              (sv.start + relIdx) nextBb h with
                          | intro f' hf' =>
                            refine ⟨f', hf'.1, hf'.2.1, fun hB => ?_⟩
                            rw [hf'.2.2]; exact nat_blt_lt hB

private theorem arrSc_evalStepArrSlice_preserves_defId (p : ArrSliceProgram) (f : ArrSliceFrame)
    (cm : CallerMemory) {s' : ArrSliceState}
    (h : evalStepArrSlice p 0 { frames := [f], callerMem := cm } = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId := by
  dsimp [evalStepArrSlice] at h
  cases hB : Trusted.MirSemantics.getElem? p.bodies f.defId with
  | none => rw [hB] at h; cases h
  | some body =>
    rw [hB] at h; dsimp at h
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
    | none => rw [hBb] at h; cases h
    | some bb =>
      rw [hBb] at h; dsimp at h
      cases hSt : Trusted.MirSemantics.getElem? bb.statements f.stmtIdx with
      | some stmt =>
        rw [hSt] at h
        cases arrSc_evalArrSliceStmt_preserves body f cm stmt h with
        | intro f' hf' => exact ⟨f', hf'.1, hf'.2.1⟩
      | none =>
        rw [hSt] at h; dsimp at h
        cases hEq : Nat.beq f.stmtIdx bb.statements.length with
        | false => rw [hEq] at h; cases h
        | true =>
          rw [hEq] at h
          cases arrSc_evalArrSliceTerm_preserves body bb f cm h with
          | intro f' hf' => exact ⟨f', hf'.1, hf'.2.1⟩

