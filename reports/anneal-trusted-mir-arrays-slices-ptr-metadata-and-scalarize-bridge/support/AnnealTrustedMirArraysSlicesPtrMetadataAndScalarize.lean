    dsimp
    rw [nat_beq_refl ac, listRel_refl arrSliceLocalDeclEq_refl loc,
      listRel_refl arrSliceBlockEq_refl bbs, boolEq_refl iu, stringBeq_refl id]
    rfl

private theorem arrSliceProgramEq_eq (a b : ArrSliceProgram)
    (h : arrSliceProgramEq a b = true) : a = b := by
  cases a with
  | mk bs₁ ed₁ pw₁ pv₁ sc₁ =>
    cases b with
    | mk bs₂ ed₂ pw₂ pv₂ sc₂ =>
      unfold arrSliceProgramEq at h
      dsimp at h
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      have h3 := (bool_and_eq_true _ _).mp h2.1
      have h4 := (bool_and_eq_true _ _).mp h3.1
      rw [listRel_eq_of_eq arrSliceBodyEq_eq bs₁ bs₂ h4.1, nat_beq_eq ed₁ ed₂ h4.2,
        nat_beq_eq pw₁ pw₂ h3.2, nat_beq_eq pv₁ pv₂ h2.2,
        scopeEq_eq sc₁ sc₂ h1.2]

private theorem arrSliceProgramEq_refl (a : ArrSliceProgram) :
    arrSliceProgramEq a a = true := by
  cases a with
  | mk bs ed pw pv sc =>
    unfold arrSliceProgramEq
    dsimp
    rw [listRel_refl arrSliceBodyEq_refl bs, nat_beq_refl ed, nat_beq_refl pw,
      nat_beq_refl pv, scopeEq_refl sc]
    rfl

/-! ## `getElem?`, `setElem?`, `List.map`, `List.take`, `List.drop`, `listReplicate`, `listFlatMap`, `listMapOption` -/

private theorem list_length_map {α β : Type} (f : α → β) :
    ∀ xs : List α, (xs.map f).length = xs.length
  | [] => rfl
  | _ :: xs => congrArg Nat.succ (list_length_map f xs)

private theorem list_append_length {α : Type} :
    ∀ xs ys : List α, (xs ++ ys).length = xs.length + ys.length
  | [], _ => by rw [List.nil_append, List.length_nil, Nat.zero_add]
  | _ :: xs, ys => by
    rw [List.cons_append, List.length_cons, List.length_cons,
      list_append_length xs ys, Nat.succ_add]

private theorem list_length_replicate {α : Type} :
    ∀ (n : Nat) (x : α), (listReplicate n x).length = n
  | 0, _ => rfl
  | n + 1, x => congrArg Nat.succ (list_length_replicate n x)

private theorem getElem?_map {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat),
      Trusted.MirSemantics.getElem? (xs.map f) i =
        match Trusted.MirSemantics.getElem? xs i with
        | none => none
        | some x => some (f x)
  | [], _ => rfl
  | _ :: _, 0 => rfl
  | _ :: xs, i + 1 => getElem?_map f xs i

private theorem setElem?_map {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat) (v : α),
      setElem? (xs.map f) i (f v) =
        match setElem? xs i v with
        | none => none
        | some xs' => some (xs'.map f)
  | [], _, _ => rfl
  | _ :: _, 0, _ => rfl
  | x :: xs, i + 1, v => by
    change
      (match setElem? (xs.map f) i (f v) with
       | some ys' => some (f x :: ys')
       | none => none) =
      (match
        (match setElem? xs i v with
         | some xs' => some (x :: xs')
         | none => none) with
       | none => none
       | some zs => some (zs.map f))
    rw [setElem?_map f xs i v]
    cases setElem? xs i v <;> rfl

private theorem setElem?_length {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs' : List α),
      setElem? xs i v = some xs' → xs'.length = xs.length
  | [], _, _, _, h => by cases h
  | _ :: xs, 0, v, _, h => by
    cases h
    rfl
  | _ :: xs, i + 1, v, xs', h => by
    cases hSub : setElem? xs i v with
    | none =>
      change (match setElem? xs i v with | some ys => some (_ :: ys) | none => none) = some xs' at h
      rw [hSub] at h
      cases h
    | some ys =>
      change (match setElem? xs i v with | some zs => some (_ :: zs) | none => none) = some xs' at h
      rw [hSub] at h
      cases h
      exact congrArg Nat.succ (setElem?_length xs i v ys hSub)

private theorem getElem?_setElem?_self {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs' : List α),
      setElem? xs i v = some xs' → Trusted.MirSemantics.getElem? xs' i = some v
  | [], _, _, _, h => by cases h
  | _ :: _, 0, _, _, h => by
    cases h
    rfl
  | _ :: xs, i + 1, v, xs', h => by
    cases hSub : setElem? xs i v with
    | none =>
      change (match setElem? xs i v with | some ys => some (_ :: ys) | none => none) = some xs' at h
      rw [hSub] at h
      cases h
    | some ys =>
      change (match setElem? xs i v with | some zs => some (_ :: zs) | none => none) = some xs' at h
      rw [hSub] at h
      cases h
      exact getElem?_setElem?_self xs i v ys hSub

private theorem getElem?_setElem?_ne {α : Type} :
    ∀ (xs : List α) (i j : Nat) (v : α) (xs' : List α),
      i ≠ j → setElem? xs i v = some xs' →
      Trusted.MirSemantics.getElem? xs' j = Trusted.MirSemantics.getElem? xs j
  | [], _, _, _, _, _, h => by cases h
  | _ :: _, 0, 0, _, _, hNe, _ => False.elim (hNe rfl)
  | _ :: _, 0, _ + 1, _, _, _, h => by
    cases h
    rfl
  | _ :: xs, i + 1, 0, v, xs', _, h => by
    cases hSub : setElem? xs i v with
    | none =>
      change (match setElem? xs i v with | some ys => some (_ :: ys) | none => none) = some xs' at h
      rw [hSub] at h
      cases h
    | some ys =>
      change (match setElem? xs i v with | some zs => some (_ :: zs) | none => none) = some xs' at h
      rw [hSub] at h
      cases h
      rfl
  | _ :: xs, i + 1, j + 1, v, xs', hNe, h => by
    have hNe' : i ≠ j := fun hEq => hNe (congrArg Nat.succ hEq)
    cases hSub : setElem? xs i v with
    | none =>
      change (match setElem? xs i v with | some ys => some (_ :: ys) | none => none) = some xs' at h
      rw [hSub] at h
      cases h
    | some ys =>
      change (match setElem? xs i v with | some zs => some (_ :: zs) | none => none) = some xs' at h
      rw [hSub] at h
      cases h
      exact getElem?_setElem?_ne xs i j v ys hNe' hSub

private theorem getElem?_lt_some {α : Type} :
    ∀ (xs : List α) (i : Nat),
      i < xs.length → ∃ x : α, Trusted.MirSemantics.getElem? xs i = some x
  | [], _, h => nomatch h
  | x :: _, 0, _ => ⟨x, rfl⟩
  | _ :: xs, i + 1, h => getElem?_lt_some xs i (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_some_lt {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α),
      Trusted.MirSemantics.getElem? xs i = some x → i < xs.length
  | [], _, _, h => by cases h
  | _ :: _, 0, _, _ => Nat.zero_lt_succ _
  | _ :: xs, i + 1, x, h => Nat.succ_lt_succ (getElem?_some_lt xs i x h)

private theorem getElem?_none_le {α : Type} :
    ∀ (xs : List α) (i : Nat),
      Trusted.MirSemantics.getElem? xs i = none → xs.length ≤ i
  | [], _, _ => Nat.zero_le _
  | _ :: _, 0, h => by cases h
  | _ :: xs, i + 1, h => Nat.succ_le_succ (getElem?_none_le xs i h)

private theorem lt_setElem?_some {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α),
      i < xs.length → ∃ xs' : List α, setElem? xs i v = some xs'
  | [], _, _, h => nomatch h
  | _ :: xs, 0, v, _ => ⟨v :: xs, rfl⟩
  | x :: xs, i + 1, v, h => by
    have hSub := lt_setElem?_some xs i v (Nat.lt_of_succ_lt_succ h)
    cases hSub with
    | intro ys hYs =>
      refine ⟨x :: ys, ?_⟩
      change (match setElem? xs i v with | some zs => some (x :: zs) | none => none) = some (x :: ys)
      rw [hYs]

private theorem getElem?_replicate {α : Type} :
    ∀ (n i : Nat) (x : α),
      i < n → Trusted.MirSemantics.getElem? (listReplicate n x) i = some x
  | 0, _, _, h => nomatch h
  | _ + 1, 0, _, _ => rfl
  | n + 1, i + 1, x, h => getElem?_replicate n i x (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_append_left {α : Type} :
    ∀ (xs ys : List α) (i : Nat),
      i < xs.length →
      Trusted.MirSemantics.getElem? (xs ++ ys) i = Trusted.MirSemantics.getElem? xs i
  | [], _, _, h => nomatch h
  | _ :: _, _, 0, _ => rfl
  | _ :: xs, ys, i + 1, h =>
    getElem?_append_left xs ys i (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_append_right {α : Type} :
    ∀ (xs ys : List α) (i : Nat),
      Trusted.MirSemantics.getElem? (xs ++ ys) (xs.length + i) =
        Trusted.MirSemantics.getElem? ys i
  | [], ys, i => by
    rw [List.nil_append, List.length_nil, Nat.zero_add]
  | _ :: xs, ys, i => by
    rw [List.cons_append, List.length_cons, Nat.succ_add]
    exact getElem?_append_right xs ys i

private theorem setElem?_append_left {α : Type} :
    ∀ (xs ys : List α) (i : Nat) (v : α),
      i < xs.length →
      setElem? (xs ++ ys) i v =
        match setElem? xs i v with
        | some xs' => some (xs' ++ ys)
        | none => none
  | [], _, _, _, h => nomatch h
  | _ :: _, _, 0, _, _ => rfl
  | x :: xs, ys, i + 1, v, h => by
    have hLt := Nat.lt_of_succ_lt_succ h
    change
      (match setElem? (xs ++ ys) i v with
       | some zs => some (x :: zs)
       | none => none) =
      (match
        (match setElem? xs i v with
         | some xs' => some (x :: xs')
         | none => none) with
       | some xs' => some (xs' ++ ys)
       | none => none)
    rw [setElem?_append_left xs ys i v hLt]
    cases setElem? xs i v <;> rfl

private theorem setElem?_append_right {α : Type} :
    ∀ (xs ys : List α) (i : Nat) (v : α),
      setElem? (xs ++ ys) (xs.length + i) v =
        match setElem? ys i v with
        | some ys' => some (xs ++ ys')
        | none => none
  | [], ys, i, v => by
    rw [List.nil_append, List.length_nil, Nat.zero_add]
    cases setElem? ys i v <;> rfl
  | x :: xs, ys, i, v => by
    rw [List.cons_append, List.length_cons, Nat.succ_add]
    change
      (match setElem? (xs ++ ys) (xs.length + i) v with
       | some zs => some (x :: zs)
       | none => none) =
      (match setElem? ys i v with
       | some ys' => some ((x :: xs) ++ ys')
       | none => none)
    rw [setElem?_append_right xs ys i v]
    cases setElem? ys i v <;> rfl

private theorem list_drop_map {α β : Type} (f : α → β) :
    ∀ (n : Nat) (xs : List α), (xs.map f).drop n = (xs.drop n).map f
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | n + 1, _ :: xs => list_drop_map f n xs

private theorem list_take_map {α β : Type} (f : α → β) :
    ∀ (n : Nat) (xs : List α), (xs.map f).take n = (xs.take n).map f
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | n + 1, x :: xs => congrArg (List.cons (f x)) (list_take_map f n xs)

private theorem list_map_append {α β : Type} (f : α → β) :
    ∀ xs ys : List α, (xs ++ ys).map f = xs.map f ++ ys.map f
  | [], _ => rfl
  | _ :: xs, ys => congrArg (List.cons _) (list_map_append f xs ys)

private theorem list_map_comp {α β γ : Type} (f : β → γ) (g : α → β) :
    ∀ xs : List α, (xs.map g).map f = xs.map (fun x => f (g x))
  | [] => rfl
  | _ :: xs => congrArg (List.cons _) (list_map_comp f g xs)

private theorem list_map_id {α : Type} (f : α → α) (h : ∀ x : α, f x = x) :
    ∀ xs : List α, xs.map f = xs
  | [] => rfl
  | x :: xs => by
    change f x :: xs.map f = x :: xs
    rw [h x, list_map_id f h xs]

private theorem listFlatMap_append {α β : Type} (f : α → List β) :
    ∀ xs ys : List α, listFlatMap f (xs ++ ys) = listFlatMap f xs ++ listFlatMap f ys
  | [], _ => rfl
  | x :: xs, ys => by
    change f x ++ listFlatMap f (xs ++ ys) = (f x ++ listFlatMap f xs) ++ listFlatMap f ys
    rw [listFlatMap_append f xs ys, List.append_assoc]

private theorem listMapOption_map {α β γ : Type} (f : β → Option γ) (g : α → β) :
    ∀ xs : List α, listMapOption f (xs.map g) = listMapOption (fun a => f (g a)) xs
  | [] => rfl
  | x :: xs => by
    change
      (match f (g x), listMapOption f (xs.map g) with
       | some y, some ys => some (y :: ys)
       | _, _ => none) =
      (match f (g x), listMapOption (fun a => f (g a)) xs with
       | some y, some ys => some (y :: ys)
       | _, _ => none)
    rw [listMapOption_map f g xs]

private theorem listMapOption_some_length {α β : Type} {f : α → Option β} :
    ∀ {xs : List α} {ys : List β},
      listMapOption f xs = some ys → ys.length = xs.length
  | [], ys, h => by
    cases h
    rfl
  | x :: xs, ys, h => by
    cases hx : f x with
    | none =>
      change (match f x, listMapOption f xs with | some y, some zs => some (y :: zs) | _, _ => none) = some ys at h
      rw [hx] at h
      cases h
    | some y =>
      cases hxs : listMapOption f xs with
      | none =>
        change (match f x, listMapOption f xs with | some w, some zs => some (w :: zs) | _, _ => none) = some ys at h
        rw [hx, hxs] at h
        cases h
      | some zs =>
        change (match f x, listMapOption f xs with | some w, some ws => some (w :: ws) | _, _ => none) = some ys at h
        rw [hx, hxs] at h
        cases h
        exact congrArg Nat.succ (listMapOption_some_length hxs)

private theorem listMapOption_some_getElem? {α β : Type} {f : α → Option β} :
    ∀ {xs : List α} {ys : List β},
      listMapOption f xs = some ys →
      ∀ (i : Nat) (x : α), Trusted.MirSemantics.getElem? xs i = some x →
        ∃ y : β, f x = some y ∧ Trusted.MirSemantics.getElem? ys i = some y
  | [], _, _, _, _, hGet => by cases hGet
  | x :: xs, ys, hMap, i, x', hGet => by
    cases hx : f x with
    | none =>
      change (match f x, listMapOption f xs with | some y, some zs => some (y :: zs) | _, _ => none) = some ys at hMap
      rw [hx] at hMap
      cases hMap
    | some y =>
      cases hxs : listMapOption f xs with
      | none =>
        change (match f x, listMapOption f xs with | some w, some zs => some (w :: zs) | _, _ => none) = some ys at hMap
        rw [hx, hxs] at hMap
        cases hMap
      | some zs =>
        change (match f x, listMapOption f xs with | some w, some ws => some (w :: ws) | _, _ => none) = some ys at hMap
        rw [hx, hxs] at hMap
        cases hMap
        cases i with
        | zero =>
          cases hGet
          exact ⟨y, hx, rfl⟩
        | succ j =>
          exact listMapOption_some_getElem? hxs j x' hGet

private theorem listMapOption_eq_some_iff {α β : Type} (f : α → Option β) :
    ∀ (xs : List α) (ys : List β),
      listMapOption f xs = some ys ↔
        xs.length = ys.length ∧
          ∀ (i : Nat) (x : α) (y : β),
            Trusted.MirSemantics.getElem? xs i = some x →
            Trusted.MirSemantics.getElem? ys i = some y →
            f x = some y := by
  intro xs
  induction xs with
  | nil =>
    intro ys
    cases ys with
    | nil => exact ⟨fun _ => ⟨rfl, fun _ _ _ h _ => by cases h⟩, fun _ => rfl⟩
    | cons _ _ =>
      constructor
      · intro h
        cases h
      · intro h
        cases h.1
  | cons x xs ih =>
    intro ys
    cases ys with
    | nil =>
      constructor
      · intro h
        change (match f x, listMapOption f xs with
                | some w, some zs => some (w :: zs)
                | _, _ => none) = some [] at h
        cases hx : f x with
        | none =>
          rw [hx] at h
          cases h
        | some w =>
          cases hxs : listMapOption f xs with
          | none =>
            rw [hx, hxs] at h
            cases h
          | some zs =>
            rw [hx, hxs] at h
            cases h
      · intro h
        cases h.1
    | cons y ys =>
      constructor
      · intro h
        cases hx : f x with
        | none =>
          change (match f x, listMapOption f xs with | some w, some zs => some (w :: zs) | _, _ => none) = some (y :: ys) at h
          rw [hx] at h
          cases h
        | some w =>
          cases hxs : listMapOption f xs with
          | none =>
            change (match f x, listMapOption f xs with | some z, some zs => some (z :: zs) | _, _ => none) = some (y :: ys) at h
            rw [hx, hxs] at h
            cases h
          | some zs =>
            change (match f x, listMapOption f xs with | some z, some ws => some (z :: ws) | _, _ => none) = some (y :: ys) at h
            rw [hx, hxs] at h
            cases h
            have hIh := (ih ys).mp hxs
            refine ⟨congrArg Nat.succ hIh.1, ?_⟩
            intro i a b hA hB
            cases i with
            | zero =>
              cases hA
              cases hB
              exact hx
            | succ j => exact hIh.2 j a b hA hB
      · intro h
        have hHead : f x = some y := h.2 0 x y rfl rfl
        have hTailLen : xs.length = ys.length := Nat.succ.inj h.1
        have hTail : listMapOption f xs = some ys :=
          (ih ys).mpr ⟨hTailLen, fun j a b hA hB => h.2 (j + 1) a b hA hB⟩
        change (match f x, listMapOption f xs with | some w, some zs => some (w :: zs) | _, _ => none) = some (y :: ys)
        rw [hHead, hTail]

private theorem list_all_iff_getElem? {α : Type} (p : α → Bool) :
    ∀ xs : List α,
      xs.all p = true ↔
        ∀ (i : Nat) (x : α), Trusted.MirSemantics.getElem? xs i = some x → p x = true
  | [] => by
    constructor
    · intro _ _ _ h
      cases h
    · intro _
      rfl
  | x :: xs => by
    constructor
    · intro h i a hGet
      have hAnd := (bool_and_eq_true (p x) (xs.all p)).mp h
      cases i with
      | zero =>
        cases hGet
        exact hAnd.1
      | succ j =>
        exact (list_all_iff_getElem? p xs).mp hAnd.2 j a hGet
    · intro h
      have hHead : p x = true := h 0 x rfl
      have hTail : xs.all p = true :=
        (list_all_iff_getElem? p xs).mpr (fun j a hGet => h (j + 1) a hGet)
      change (p x && xs.all p) = true
      rw [hHead, hTail]
      rfl

private theorem list_all_map {α β : Type} (p : β → Bool) (f : α → β) :
    ∀ xs : List α, (xs.map f).all p = xs.all (fun x => p (f x))
  | [] => rfl
  | x :: xs => by
    change (p (f x) && (xs.map f).all p) = (p (f x) && xs.all (fun y => p (f y)))
    rw [list_all_map p f xs]

private theorem list_all_append {α : Type} (p : α → Bool) :
    ∀ xs ys : List α, (xs ++ ys).all p = (xs.all p && ys.all p)
  | [], ys => by
    change ys.all p = (true && ys.all p)
    cases ys.all p <;> rfl
  | x :: xs, ys => by
    change (p x && (xs ++ ys).all p) = ((p x && xs.all p) && ys.all p)
    rw [list_all_append p xs ys]
    cases p x <;> cases xs.all p <;> cases ys.all p <;> rfl

private theorem list_any_map {α β : Type} (p : β → Bool) (f : α → β) :
    ∀ xs : List α, (xs.map f).any p = xs.any (fun x => p (f x))
  | [] => rfl
  | x :: xs => by
    change (p (f x) || (xs.map f).any p) = (p (f x) || xs.any (fun y => p (f y)))
    rw [list_any_map p f xs]

private theorem list_any_append {α : Type} (p : α → Bool) :
    ∀ xs ys : List α, (xs ++ ys).any p = (xs.any p || ys.any p)
  | [], ys => by
    change ys.any p = (false || ys.any p)
    cases ys.any p <;> rfl
  | x :: xs, ys => by
    change (p x || (xs ++ ys).any p) = ((p x || xs.any p) || ys.any p)
    rw [list_any_append p xs ys]
    cases p x <;> cases xs.any p <;> cases ys.any p <;> rfl

private theorem list_any_eq_false_iff {α : Type} (p : α → Bool) :
    ∀ xs : List α,
      xs.any p = false ↔
        ∀ (i : Nat) (x : α), Trusted.MirSemantics.getElem? xs i = some x → p x = false
  | [] => by
    constructor
    · intro _ _ _ h
      cases h
    · intro _
      rfl
  | x :: xs => by
    constructor
    · intro h i a hGet
      have hOr := (bool_or_eq_false (p x) (xs.any p)).mp h
      cases i with
      | zero =>
        cases hGet
        exact hOr.1
      | succ j =>
        exact (list_any_eq_false_iff p xs).mp hOr.2 j a hGet
    · intro h
      have hHead : p x = false := h 0 x rfl
      have hTail : xs.any p = false :=
        (list_any_eq_false_iff p xs).mpr (fun j a hGet => h (j + 1) a hGet)
      change (p x || xs.any p) = false
      rw [hHead, hTail]
      rfl

/-! ## Determinism, `ReachesN`, Divergence, and Simulation Equivalences -/

private theorem stepArrSlice_iff_evalStep (p : ArrSliceProgram) (s : ArrSliceState)
    (res : StepResult ArrSliceState TerminalOut) :
    StepArrSlice p s res ↔ evalStepArrSlice p 0 s = res := by
  constructor
  · intro h
    cases h with
    | intro c hc =>
      have hc0 : c = 0 := hc.1
      rw [hc0] at hc
      exact hc.2
  · intro h
    exact ⟨0, rfl, h⟩

private theorem evalStepArrSlice_det {p : ArrSliceProgram} {s : ArrSliceState}
    {r₁ r₂ : StepResult ArrSliceState TerminalOut}
    (h₁ : StepArrSlice p s r₁) (h₂ : StepArrSlice p s r₂) : r₁ = r₂ := by
  have e₁ := (stepArrSlice_iff_evalStep p s r₁).mp h₁
  have e₂ := (stepArrSlice_iff_evalStep p s r₂).mp h₂
  rw [← e₁, e₂]

private theorem stepBase_iff_evalStep (p : Program) (s : State)
    (res : StepResult State TerminalOut) :
    Step p s res ↔ evalStep p 0 s = res := by
  constructor
  · intro h
    cases h with
    | intro c hc =>
      have hc0 : c = 0 := hc.1
      rw [hc0] at hc
      exact hc.2
  · intro h
    exact ⟨0, rfl, h⟩

private theorem evalStep_det {p : Program} {s : State}
    {r₁ r₂ : StepResult State TerminalOut}
    (h₁ : Step p s r₁) (h₂ : Step p s r₂) : r₁ = r₂ := by
  have e₁ := (stepBase_iff_evalStep p s r₁).mp h₁
  have e₂ := (stepBase_iff_evalStep p s r₂).mp h₂
  rw [← e₁, e₂]

private inductive ReachesNArrSlice (p : ArrSliceProgram) :
    Nat → ArrSliceState → ArrSliceState → Prop where
  | zero (s : ArrSliceState) : ReachesNArrSlice p 0 s s
  | succ {n : Nat} {s₁ s₂ s₃ : ArrSliceState} :
      StepArrSlice p s₁ (.step s₂) →
      ReachesNArrSlice p n s₂ s₃ →
      ReachesNArrSlice p (n + 1) s₁ s₃

private noncomputable def ReachesPlusArrSlice (p : ArrSliceProgram)
    (s₁ s₂ : ArrSliceState) : Prop :=
  ∃ n : Nat, ReachesNArrSlice p (n + 1) s₁ s₂

private theorem reachesNArrSlice_trans {p : ArrSliceProgram} :
    ∀ {n m : Nat} {s₁ s₂ s₃ : ArrSliceState},
      ReachesNArrSlice p n s₁ s₂ →
      ReachesNArrSlice p m s₂ s₃ →
      ReachesNArrSlice p (n + m) s₁ s₃
  | 0, m, _, _, _, .zero _, h₂ => by
    rw [Nat.zero_add]
    exact h₂
  | n + 1, m, _, _, _, .succ hStep hRest, h₂ => by
    rw [Nat.succ_add]
    exact .succ hStep (reachesNArrSlice_trans hRest h₂)

private theorem reachesNArrSlice_split_add {p : ArrSliceProgram} :
    ∀ {n m : Nat} {s₁ s₃ : ArrSliceState},
      ReachesNArrSlice p (n + m) s₁ s₃ →
      ∃ s₂ : ArrSliceState,
        ReachesNArrSlice p n s₁ s₂ ∧ ReachesNArrSlice p m s₂ s₃
  | 0, m, s₁, s₃, h => by
    rw [Nat.zero_add] at h
    exact ⟨s₁, .zero s₁, h⟩
  | n + 1, m, s₁, s₃, h => by
    rw [Nat.succ_add] at h
    cases h with
    | succ hStep hRest =>
      have hMid := reachesNArrSlice_split_add hRest
      cases hMid with
      | intro s₂ hs =>
        exact ⟨s₂, .succ hStep hs.1, hs.2⟩

private theorem reachesNArrSlice_det {p : ArrSliceProgram} :
    ∀ {n : Nat} {s s₁ s₂ : ArrSliceState},
      ReachesNArrSlice p n s s₁ → ReachesNArrSlice p n s s₂ → s₁ = s₂
  | 0, _, _, _, .zero _, .zero _ => rfl
  | _ + 1, _, _, _, .succ h₁ r₁, .succ h₂ r₂ => by
    have hEq := evalStepArrSlice_det h₁ h₂
    cases hEq
    exact reachesNArrSlice_det r₁ r₂

private theorem c_reachesArrSlice_head {p : ArrSliceProgram} {s₁ s₂ s₃ : ArrSliceState}
    (hStep : StepArrSlice p s₁ (.step s₂))
    (hReach : ReachesArrSlice p s₂ s₃) :
    ReachesArrSlice p s₁ s₃ := by
  induction hReach with
  | refl => exact ReachesArrSlice.tail (ReachesArrSlice.refl s₁) hStep
  | tail _ hTail ih => exact ReachesArrSlice.tail ih hTail

private theorem reachesArrSlice_trans {p : ArrSliceProgram} {s₁ s₂ s₃ : ArrSliceState}
    (h₁ : ReachesArrSlice p s₁ s₂) (h₂ : ReachesArrSlice p s₂ s₃) :
    ReachesArrSlice p s₁ s₃ := by
  induction h₂ with
  | refl => exact h₁
  | tail _ hTail ih => exact ReachesArrSlice.tail ih hTail

private theorem reachesArrSlice_of_reachesNArrSlice {p : ArrSliceProgram} :
    ∀ {n : Nat} {s₁ s₂ : ArrSliceState},
      ReachesNArrSlice p n s₁ s₂ → ReachesArrSlice p s₁ s₂
  | 0, s₁, _, .zero _ => ReachesArrSlice.refl s₁
  | _ + 1, _, _, .succ hStep hRest =>
    c_reachesArrSlice_head hStep (reachesArrSlice_of_reachesNArrSlice hRest)

private theorem reachesArrSlice_of_reachesPlusArrSlice {p : ArrSliceProgram}
    {s₁ s₂ : ArrSliceState} (h : ReachesPlusArrSlice p s₁ s₂) :
    ReachesArrSlice p s₁ s₂ := by
  cases h with
  | intro _ hn => exact reachesArrSlice_of_reachesNArrSlice hn

private theorem reachesNArrSlice_of_reachesArrSlice {p : ArrSliceProgram}
    {s₁ s₂ : ArrSliceState} (h : ReachesArrSlice p s₁ s₂) :
    ∃ n : Nat, ReachesNArrSlice p n s₁ s₂ := by
  induction h with
  | refl => exact ⟨0, .zero s₁⟩
  | tail _ hTail ih =>
    cases ih with
    | intro n hn =>
      exact ⟨n + 1, reachesNArrSlice_trans hn (.succ hTail (.zero _))⟩

private theorem reachesNArrSlice_iff_stepChainFromArrSlice (p : ArrSliceProgram) :
    ∀ (n : Nat) (s₁ s₂ : ArrSliceState),
      ReachesNArrSlice p n s₁ s₂ ↔ stepChainFromArrSlice p n s₁ = some s₂
  | 0, s₁, s₂ => by
    constructor
    · intro h
      cases h
      rfl
    · intro h
      cases h
      exact .zero s₁
  | n + 1, s₁, s₂ => by
    constructor
    · intro h
      cases h with
      | succ hStep hRest =>
        have hEval := (stepArrSlice_iff_evalStep p s₁ (.step _)).mp hStep
        change (match evalStepArrSlice p 0 s₁ with
                | .step s' => stepChainFromArrSlice p n s'
                | _ => none) = some s₂
        rw [hEval]
        exact (reachesNArrSlice_iff_stepChainFromArrSlice p n _ s₂).mp hRest
    · intro h
      change (match evalStepArrSlice p 0 s₁ with
              | .step s' => stepChainFromArrSlice p n s'
              | _ => none) = some s₂ at h
      cases hEval : evalStepArrSlice p 0 s₁ with
      | step s' =>
        rw [hEval] at h
        have hStep : StepArrSlice p s₁ (.step s') :=
          (stepArrSlice_iff_evalStep p s₁ (.step s')).mpr hEval
        have hRest := (reachesNArrSlice_iff_stepChainFromArrSlice p n s' s₂).mpr h
        exact .succ hStep hRest
      | done _ =>
        rw [hEval] at h
        cases h
      | fault _ =>
        rw [hEval] at h
        cases h

private theorem stepChainFromArrSlice_succ_right (p : ArrSliceProgram) :
    ∀ (n : Nat) (s sₙ : ArrSliceState),
      stepChainFromArrSlice p n s = some sₙ →
      stepChainFromArrSlice p (n + 1) s =
        match evalStepArrSlice p 0 sₙ with
        | .step sₙ' => some sₙ'
        | _ => none
  | 0, s, sₙ, h => by
    cases h
    change (match evalStepArrSlice p 0 s with
            | .step s' => stepChainFromArrSlice p 0 s'
            | _ => none) =
           (match evalStepArrSlice p 0 s with
            | .step sₙ' => some sₙ'
            | _ => none)
    cases evalStepArrSlice p 0 s <;> rfl
  | n + 1, s, sₙ, h => by
    change (match evalStepArrSlice p 0 s with
            | .step s' => stepChainFromArrSlice p n s'
            | _ => none) = some sₙ at h
    cases hEval : evalStepArrSlice p 0 s with
    | step s' =>
      rw [hEval] at h
      change (match evalStepArrSlice p 0 s with
              | .step t => stepChainFromArrSlice p (n + 1) t
              | _ => none) = _
      rw [hEval]
      exact stepChainFromArrSlice_succ_right p n s' sₙ h
    | done _ =>
      rw [hEval] at h
      cases h
    | fault _ =>
      rw [hEval] at h
      cases h

private theorem reachesNArrSlice_terminal_bound {p : ArrSliceProgram}
    {n m : Nat} {s a b : ArrSliceState}
    (hA : ReachesNArrSlice p n s a)
    (hTerm : ¬ (∃ s' : ArrSliceState, StepArrSlice p a (.step s')))
    (hB : ReachesNArrSlice p m s b) :
    m ≤ n ∧ ReachesNArrSlice p (n - m) b a := by
  cases Nat.lt_or_ge n m with
  | inr hLe =>
    have hSum : n = m + (n - m) := (Nat.add_sub_of_le hLe).symm
    have hA' : ReachesNArrSlice p (m + (n - m)) s a := by
      rw [← hSum]
      exact hA
    have hSplit := reachesNArrSlice_split_add hA'
    cases hSplit with
    | intro c hc =>
      have hcEq : c = b := reachesNArrSlice_det hc.1 hB
      rw [hcEq] at hc
      exact ⟨hLe, hc.2⟩
  | inl hLt =>
    have hDiffPos : 0 < m - n := Nat.sub_pos_of_lt hLt
    have hDecomp : m - n = (m - n - 1) + 1 := (Nat.sub_add_cancel hDiffPos).symm
    have hSum : m = n + (m - n) := (Nat.add_sub_of_le (Nat.le_of_lt hLt)).symm
    have hB' : ReachesNArrSlice p (n + (m - n)) s b := by
      rw [← hSum]
      exact hB
    have hSplit := reachesNArrSlice_split_add hB'
    cases hSplit with
    | intro c hc =>
      have hcEq : c = a := reachesNArrSlice_det hc.1 hA
      have hStepList : ReachesNArrSlice p ((m - n - 1) + 1) a b := by
        rw [← hDecomp, ← hcEq]
        exact hc.2
      cases hStepList with
      | succ hStep _ => exact False.elim (hTerm ⟨_, hStep⟩)

private theorem wellFormedArrSlice_iff_no_fault (p : ArrSliceProgram) (q : Query) :
    WellFormedArrSlice p q ↔ ∀ k : FaultKind, ¬ ReachesResultArrSlice p q (.fault k) := by
  constructor
  · intro h
    exact h.2
  · intro hNoFault
    refine ⟨?_, hNoFault⟩
    cases hInit : initStateArrSlice p q with
    | error k =>
      have hF : ReachesResultArrSlice p q (.fault k) := by
        unfold ReachesResultArrSlice
        rw [hInit]
      exact False.elim (hNoFault k hF)
    | ok s₀ =>
      exact ⟨s₀, rfl, fun _ _ => ⟨0, rfl⟩⟩

private theorem divergesArrSlice_iff_no_terminal_or_fault (p : ArrSliceProgram) (q : Query) :
    DivergesArrSlice p q ↔
      (∃ s₀ : ArrSliceState, initStateArrSlice p q = .ok s₀) ∧
      (∀ out : TerminalOut, ¬ BehaviorArrSlice p q out) ∧
      (∀ k : FaultKind, ¬ ReachesResultArrSlice p q (.fault k)) := by
  constructor
  · intro hDiv
    cases hDiv with
    | intro s₀ hs₀ =>
      refine ⟨⟨s₀, hs₀.1⟩, ?_, ?_⟩
      · intro out hBeh
        unfold BehaviorArrSlice ReachesResultArrSlice at hBeh
        rw [hs₀.1] at hBeh
        cases hBeh with
        | intro sEnd hsEnd =>
          have hn := reachesNArrSlice_of_reachesArrSlice hsEnd.1
          cases hn with
          | intro n hnReach =>
            have hChain : stepChainFromArrSlice p n s₀ = some sEnd :=
              (reachesNArrSlice_iff_stepChainFromArrSlice p n s₀ sEnd).mp hnReach
            have hNext := stepChainFromArrSlice_succ_right p n s₀ sEnd hChain
            have hStepEnd := (stepArrSlice_iff_evalStep p sEnd (.done out)).mp hsEnd.2
            rw [hStepEnd] at hNext
            cases hs₀.2 (n + 1) with
            | intro sₙ₁ hsₙ₁ =>
              rw [hsₙ₁] at hNext
              cases hNext
      · intro k hFault
        unfold ReachesResultArrSlice at hFault
        rw [hs₀.1] at hFault
        cases hFault with
        | intro sEnd hsEnd =>
          have hn := reachesNArrSlice_of_reachesArrSlice hsEnd.1
          cases hn with
          | intro n hnReach =>
            have hChain : stepChainFromArrSlice p n s₀ = some sEnd :=
              (reachesNArrSlice_iff_stepChainFromArrSlice p n s₀ sEnd).mp hnReach
            have hNext := stepChainFromArrSlice_succ_right p n s₀ sEnd hChain
            have hStepEnd := (stepArrSlice_iff_evalStep p sEnd (.fault k)).mp hsEnd.2
            rw [hStepEnd] at hNext
            cases hs₀.2 (n + 1) with
            | intro sₙ₁ hsₙ₁ =>
              rw [hsₙ₁] at hNext
              cases hNext
  · intro hCond
    cases hCond.1 with
    | intro s₀ hInit =>
      refine ⟨s₀, hInit, ?_⟩
      intro n
      induction n with
      | zero => exact ⟨s₀, rfl⟩
      | succ k ih =>
        cases ih with
        | intro sₖ hsₖ =>
          have hNext := stepChainFromArrSlice_succ_right p k s₀ sₖ hsₖ
          have hReach : ReachesArrSlice p s₀ sₖ :=
            reachesArrSlice_of_reachesNArrSlice
              ((reachesNArrSlice_iff_stepChainFromArrSlice p k s₀ sₖ).mpr hsₖ)
          cases hEval : evalStepArrSlice p 0 sₖ with
          | step sₖ' =>
            rw [hEval] at hNext
            exact ⟨sₖ', hNext⟩
          | done out =>
            have hBeh : BehaviorArrSlice p q out := by
              unfold BehaviorArrSlice ReachesResultArrSlice
              rw [hInit]
              exact ⟨sₖ, hReach, (stepArrSlice_iff_evalStep p sₖ (.done out)).mpr hEval⟩
            exact False.elim (hCond.2.1 out hBeh)
          | fault fk =>
            have hF : ReachesResultArrSlice p q (.fault fk) := by
              unfold ReachesResultArrSlice
              rw [hInit]
              exact ⟨sₖ, hReach, (stepArrSlice_iff_evalStep p sₖ (.fault fk)).mpr hEval⟩
            exact False.elim (hCond.2.2 fk hF)

/-! ### Base Program Step Chains & Equivalence Characterizations -/

private inductive ReachesNBase (p : Program) : Nat → State → State → Prop where
  | zero (s : State) : ReachesNBase p 0 s s
  | succ {n : Nat} {s₁ s₂ s₃ : State} :
      Step p s₁ (.step s₂) →
      ReachesNBase p n s₂ s₃ →
      ReachesNBase p (n + 1) s₁ s₃

private noncomputable def stepChainFromBase (p : Program) : Nat → State → Option State
  | 0, s => some s
  | n + 1, s =>
    match evalStep p 0 s with
    | .step s' => stepChainFromBase p n s'
    | _ => none

private noncomputable def stepChainExecBase (p : Program) (n : Nat) (s : State) : State :=
  match stepChainFromBase p n s with
  | some s' => s'
  | none => s

private theorem reachesNBase_trans {p : Program} :
    ∀ {n m : Nat} {s₁ s₂ s₃ : State},
      ReachesNBase p n s₁ s₂ → ReachesNBase p m s₂ s₃ → ReachesNBase p (n + m) s₁ s₃
  | 0, _, _, _, _, .zero _, h₂ => by
    rw [Nat.zero_add]
    exact h₂
  | _ + 1, _, _, _, _, .succ hStep hRest, h₂ => by
    rw [Nat.succ_add]
    exact .succ hStep (reachesNBase_trans hRest h₂)

private theorem c_reachesBase_head {p : Program} {s₁ s₂ s₃ : State}
    (hStep : Step p s₁ (.step s₂)) (hReach : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction hReach with
  | refl => exact Reaches.tail (Reaches.refl s₁) hStep
  | tail _ hTail ih => exact Reaches.tail ih hTail

private theorem reachesBase_of_reachesNBase {p : Program} :
    ∀ {n : Nat} {s₁ s₂ : State}, ReachesNBase p n s₁ s₂ → Reaches p s₁ s₂
  | 0, s₁, _, .zero _ => Reaches.refl s₁
  | _ + 1, _, _, .succ hStep hRest =>
    c_reachesBase_head hStep (reachesBase_of_reachesNBase hRest)

private theorem reachesNBase_of_reachesBase {p : Program} {s₁ s₂ : State}
    (h : Reaches p s₁ s₂) : ∃ n : Nat, ReachesNBase p n s₁ s₂ := by
  induction h with
  | refl => exact ⟨0, .zero s₁⟩
  | tail _ hTail ih =>
    cases ih with
    | intro n hn => exact ⟨n + 1, reachesNBase_trans hn (.succ hTail (.zero _))⟩

private theorem reachesNBase_iff_stepChainFromBase (p : Program) :
    ∀ (n : Nat) (s₁ s₂ : State),
      ReachesNBase p n s₁ s₂ ↔ stepChainFromBase p n s₁ = some s₂
  | 0, s₁, s₂ => by
    constructor
    · intro h
      cases h
      rfl
    · intro h
      cases h
      exact .zero s₁
  | n + 1, s₁, s₂ => by
    constructor
    · intro h
      cases h with
      | succ hStep hRest =>
        have hEval := (stepBase_iff_evalStep p s₁ (.step _)).mp hStep
        change (match evalStep p 0 s₁ with
                | .step s' => stepChainFromBase p n s'
                | _ => none) = some s₂
        rw [hEval]
        exact (reachesNBase_iff_stepChainFromBase p n _ s₂).mp hRest
    · intro h
      change (match evalStep p 0 s₁ with
              | .step s' => stepChainFromBase p n s'
              | _ => none) = some s₂ at h
      cases hEval : evalStep p 0 s₁ with
      | step s' =>
        rw [hEval] at h
        exact .succ ((stepBase_iff_evalStep p s₁ (.step s')).mpr hEval)
          ((reachesNBase_iff_stepChainFromBase p n s' s₂).mpr h)
      | done _ =>
        rw [hEval] at h
        cases h
      | fault _ =>
        rw [hEval] at h
        cases h

private theorem stepChainFromBase_succ_right (p : Program) :
    ∀ (n : Nat) (s sₙ : State),
      stepChainFromBase p n s = some sₙ →
      stepChainFromBase p (n + 1) s =
        match evalStep p 0 sₙ with
        | .step sₙ' => some sₙ'
        | _ => none
  | 0, s, sₙ, h => by
    cases h
    change (match evalStep p 0 s with
            | .step s' => stepChainFromBase p 0 s'
            | _ => none) =
           (match evalStep p 0 s with
            | .step sₙ' => some sₙ'
            | _ => none)
    cases evalStep p 0 s <;> rfl
  | n + 1, s, sₙ, h => by
    change (match evalStep p 0 s with
            | .step s' => stepChainFromBase p n s'
            | _ => none) = some sₙ at h
    cases hEval : evalStep p 0 s with
    | step s' =>
      rw [hEval] at h
      change (match evalStep p 0 s with
              | .step t => stepChainFromBase p (n + 1) t
              | _ => none) = _
      rw [hEval]
      exact stepChainFromBase_succ_right p n s' sₙ h
    | done _ =>
      rw [hEval] at h
      cases h
    | fault _ =>
      rw [hEval] at h
      cases h

private theorem stepChainFromBase_of_trace (p : Program) (trace : Nat → State)
    (hTrace : ∀ k : Nat, Step p (trace k) (.step (trace (k + 1)))) :
    ∀ (n k : Nat), stepChainFromBase p n (trace k) = some (trace (k + n))
  | 0, k => by
    rw [Nat.add_zero]
    rfl
  | n + 1, k => by
    have hEval := (stepBase_iff_evalStep p (trace k) (.step (trace (k + 1)))).mp (hTrace k)
    change (match evalStep p 0 (trace k) with
            | .step s' => stepChainFromBase p n s'
            | _ => none) = some (trace (k + (n + 1)))
    rw [hEval]
    have hShift : k + (n + 1) = (k + 1) + n := by
      rw [Nat.add_assoc, Nat.add_comm 1 n]
    rw [hShift]
    exact stepChainFromBase_of_trace p trace hTrace n (k + 1)

private theorem divergesBase_iff_stepChain (p : Program) (q : Query) :
    Diverges p q ↔
      ∃ s₀ : State, initState p q = .ok s₀ ∧
        ∀ n : Nat, ∃ sₙ : State, stepChainFromBase p n s₀ = some sₙ := by
  constructor
  · intro hDiv
    cases hDiv with
    | intro s₀ hs₀ =>
      cases hs₀.2 with
      | intro trace hTr =>
        refine ⟨s₀, hs₀.1, ?_⟩
        intro n
        have hC := stepChainFromBase_of_trace p trace hTr.2 n 0
        rw [hTr.1, Nat.zero_add] at hC
        exact ⟨trace n, hC⟩
  · intro hChain
    cases hChain with
    | intro s₀ hs₀ =>
      refine ⟨s₀, hs₀.1, (fun k => stepChainExecBase p k s₀), rfl, ?_⟩
      intro n
      cases hs₀.2 n with
      | intro sₙ hsₙ =>
        cases hs₀.2 (n + 1) with
        | intro sₙ₁ hsₙ₁ =>
          have hNext := stepChainFromBase_succ_right p n s₀ sₙ hsₙ
          rw [hsₙ₁] at hNext
          cases hEval : evalStep p 0 sₙ with
          | step t =>
            rw [hEval] at hNext
            cases hNext
            have hExN : stepChainExecBase p n s₀ = sₙ := by
              unfold stepChainExecBase
              rw [hsₙ]
            have hExN1 : stepChainExecBase p (n + 1) s₀ = sₙ₁ := by
              unfold stepChainExecBase
              rw [hsₙ₁]
            dsimp
            rw [hExN, hExN1]
            exact (stepBase_iff_evalStep p sₙ (.step sₙ₁)).mpr hEval
          | done _ =>
            rw [hEval] at hNext
            cases hNext
          | fault _ =>
            rw [hEval] at hNext
            cases hNext

private theorem wellFormedBase_iff_no_fault (p : Program) (q : Query) :
    WellFormed p q ↔ ∀ k : FaultKind, ¬ ReachesResult p q (.fault k) := by
  constructor
  · intro h
    exact h.2
  · intro hNoFault
    refine ⟨?_, hNoFault⟩
    cases hInit : initState p q with
    | error k =>
      have hF : ReachesResult p q (.fault k) := by
        unfold ReachesResult
        rw [hInit]
      exact False.elim (hNoFault k hF)
    | ok s₀ =>
      exact ⟨s₀, rfl, fun _ _ => ⟨0, rfl⟩⟩

private theorem divergesBase_iff_no_terminal_or_fault (p : Program) (q : Query) :
    Diverges p q ↔
      (∃ s₀ : State, initState p q = .ok s₀) ∧
      (∀ out : TerminalOut, ¬ Behavior p q out) ∧
      (∀ k : FaultKind, ¬ ReachesResult p q (.fault k)) := by
  rw [divergesBase_iff_stepChain]
  constructor
  · intro hDiv
    cases hDiv with
    | intro s₀ hs₀ =>
      refine ⟨⟨s₀, hs₀.1⟩, ?_, ?_⟩
      · intro out hBeh
        unfold Behavior ReachesResult at hBeh
        rw [hs₀.1] at hBeh
        cases hBeh with
        | intro sEnd hsEnd =>
          cases reachesNBase_of_reachesBase hsEnd.1 with
          | intro n hnReach =>
            have hChain := (reachesNBase_iff_stepChainFromBase p n s₀ sEnd).mp hnReach
            have hNext := stepChainFromBase_succ_right p n s₀ sEnd hChain
            have hStepEnd := (stepBase_iff_evalStep p sEnd (.done out)).mp hsEnd.2
            rw [hStepEnd] at hNext
            cases hs₀.2 (n + 1) with
            | intro sₙ₁ hsₙ₁ =>
              rw [hsₙ₁] at hNext
              cases hNext
      · intro k hFault
        unfold ReachesResult at hFault
        rw [hs₀.1] at hFault
        cases hFault with
        | intro sEnd hsEnd =>
          cases reachesNBase_of_reachesBase hsEnd.1 with
          | intro n hnReach =>
            have hChain := (reachesNBase_iff_stepChainFromBase p n s₀ sEnd).mp hnReach
            have hNext := stepChainFromBase_succ_right p n s₀ sEnd hChain
            have hStepEnd := (stepBase_iff_evalStep p sEnd (.fault k)).mp hsEnd.2
            rw [hStepEnd] at hNext
            cases hs₀.2 (n + 1) with
            | intro sₙ₁ hsₙ₁ =>
              rw [hsₙ₁] at hNext
              cases hNext
  · intro hCond
    cases hCond.1 with
    | intro s₀ hInit =>
      refine ⟨s₀, hInit, ?_⟩
      intro n
      induction n with
      | zero => exact ⟨s₀, rfl⟩
      | succ k ih =>
        cases ih with
        | intro sₖ hsₖ =>
          have hNext := stepChainFromBase_succ_right p k s₀ sₖ hsₖ
          have hReach : Reaches p s₀ sₖ :=
            reachesBase_of_reachesNBase
              ((reachesNBase_iff_stepChainFromBase p k s₀ sₖ).mpr hsₖ)
          cases hEval : evalStep p 0 sₖ with
          | step sₖ' =>
            rw [hEval] at hNext
            exact ⟨sₖ', hNext⟩
          | done out =>
            have hBeh : Behavior p q out := by
              unfold Behavior ReachesResult
              rw [hInit]
              exact ⟨sₖ, hReach, (stepBase_iff_evalStep p sₖ (.done out)).mpr hEval⟩
            exact False.elim (hCond.2.1 out hBeh)
          | fault fk =>
            have hF : ReachesResult p q (.fault fk) := by
              unfold ReachesResult
              rw [hInit]
              exact ⟨sₖ, hReach, (stepBase_iff_evalStep p sₖ (.fault fk)).mpr hEval⟩
            exact False.elim (hCond.2.2 fk hF)

/-! ### Top-Level Semantic Equivalence Combinators -/

private theorem fullSemanticEquivArrSlice_of_outcomes
    (p₁ p₂ : ArrSliceProgram)
    (hBeh : ∀ (q : Query) (out : TerminalOut),
      BehaviorArrSlice p₁ q out ↔ BehaviorArrSlice p₂ q out)
    (hFault : ∀ (q : Query) (k : FaultKind),
      ReachesResultArrSlice p₁ q (.fault k) ↔ ReachesResultArrSlice p₂ q (.fault k)) :
    FullSemanticEquivArrSlice p₁ p₂ := by
  have hWf : ∀ q : Query, WellFormedArrSlice p₁ q ↔ WellFormedArrSlice p₂ q := by
    intro q
    rw [wellFormedArrSlice_iff_no_fault p₁ q, wellFormedArrSlice_iff_no_fault p₂ q]
    constructor
    · intro h k hk
      exact h k ((hFault q k).mpr hk)
    · intro h k hk
      exact h k ((hFault q k).mp hk)
  have hDiv : ∀ q : Query, DivergesArrSlice p₁ q ↔ DivergesArrSlice p₂ q := by
    intro q
    rw [divergesArrSlice_iff_no_terminal_or_fault p₁ q,
      divergesArrSlice_iff_no_terminal_or_fault p₂ q]
    constructor
    · intro h
      have hNoFault₂ : ∀ k : FaultKind, ¬ ReachesResultArrSlice p₂ q (.fault k) :=
        fun k hk => h.2.2 k ((hFault q k).mpr hk)
      have hInit₂ : ∃ s₂ : ArrSliceState, initStateArrSlice p₂ q = .ok s₂ := by
        cases hI : initStateArrSlice p₂ q with
        | ok s₂ => exact ⟨s₂, rfl⟩
        | error k =>
          have hF : ReachesResultArrSlice p₂ q (.fault k) := by
            unfold ReachesResultArrSlice
            rw [hI]
          exact False.elim (hNoFault₂ k hF)
      exact ⟨hInit₂, fun out hB => h.2.1 out ((hBeh q out).mpr hB), hNoFault₂⟩
    · intro h
      have hNoFault₁ : ∀ k : FaultKind, ¬ ReachesResultArrSlice p₁ q (.fault k) :=
        fun k hk => h.2.2 k ((hFault q k).mp hk)
      have hInit₁ : ∃ s₁ : ArrSliceState, initStateArrSlice p₁ q = .ok s₁ := by
        cases hI : initStateArrSlice p₁ q with
        | ok s₁ => exact ⟨s₁, rfl⟩
        | error k =>
          have hF : ReachesResultArrSlice p₁ q (.fault k) := by
            unfold ReachesResultArrSlice
            rw [hI]
          exact False.elim (hNoFault₁ k hF)
      exact ⟨hInit₁, fun out hB => h.2.1 out ((hBeh q out).mp hB), hNoFault₁⟩
  have hPost : ∀ (q : Query) (post : TerminalOut → Prop),
      SatisfiesPostArrSlice p₁ q post ↔ SatisfiesPostArrSlice p₂ q post := by
    intro q post
    unfold SatisfiesPostArrSlice
    constructor
    · intro h
      exact ⟨(hWf q).mp h.1, fun out hb => h.2 out ((hBeh q out).mpr hb)⟩
    · intro h
      exact ⟨(hWf q).mpr h.1, fun out hb => h.2 out ((hBeh q out).mp hb)⟩
  exact ⟨hWf, hBeh, hFault, hDiv, hPost⟩

private theorem fullSemanticEquivBase_of_outcomes
    (p₁ p₂ : Program)
    (hBeh : ∀ (q : Query) (out : TerminalOut),
      Behavior p₁ q out ↔ Behavior p₂ q out)
    (hFault : ∀ (q : Query) (k : FaultKind),
      ReachesResult p₁ q (.fault k) ↔ ReachesResult p₂ q (.fault k)) :
    FullSemanticEquivBase p₁ p₂ := by
  have hWf : ∀ q : Query, WellFormed p₁ q ↔ WellFormed p₂ q := by
    intro q
    rw [wellFormedBase_iff_no_fault p₁ q, wellFormedBase_iff_no_fault p₂ q]
    constructor
    · intro h k hk
      exact h k ((hFault q k).mpr hk)
    · intro h k hk
      exact h k ((hFault q k).mp hk)
  have hDiv : ∀ q : Query, Diverges p₁ q ↔ Diverges p₂ q := by
    intro q
    rw [divergesBase_iff_no_terminal_or_fault p₁ q,
      divergesBase_iff_no_terminal_or_fault p₂ q]
    constructor
    · intro h
      have hNoFault₂ : ∀ k : FaultKind, ¬ ReachesResult p₂ q (.fault k) :=
        fun k hk => h.2.2 k ((hFault q k).mpr hk)
      have hInit₂ : ∃ s₂ : State, initState p₂ q = .ok s₂ := by
        cases hI : initState p₂ q with
        | ok s₂ => exact ⟨s₂, rfl⟩
        | error k =>
          have hF : ReachesResult p₂ q (.fault k) := by
            unfold ReachesResult
            rw [hI]
          exact False.elim (hNoFault₂ k hF)
      exact ⟨hInit₂, fun out hB => h.2.1 out ((hBeh q out).mpr hB), hNoFault₂⟩
    · intro h
      have hNoFault₁ : ∀ k : FaultKind, ¬ ReachesResult p₁ q (.fault k) :=
        fun k hk => h.2.2 k ((hFault q k).mp hk)
      have hInit₁ : ∃ s₁ : State, initState p₁ q = .ok s₁ := by
        cases hI : initState p₁ q with
        | ok s₁ => exact ⟨s₁, rfl⟩
        | error k =>
          have hF : ReachesResult p₁ q (.fault k) := by
            unfold ReachesResult
            rw [hI]
          exact False.elim (hNoFault₁ k hF)
      exact ⟨hInit₁, fun out hB => h.2.1 out ((hBeh q out).mp hB), hNoFault₁⟩
  have hPost : ∀ (q : Query) (post : TerminalOut → Prop),
      SatisfiesPost p₁ q post ↔ SatisfiesPost p₂ q post := by
    intro q post
    unfold SatisfiesPost
    constructor
    · intro h
      exact ⟨(hWf q).mp h.1, fun out hb => h.2 out ((hBeh q out).mpr hb)⟩
    · intro h
      exact ⟨(hWf q).mpr h.1, fun out hb => h.2 out ((hBeh q out).mp hb)⟩
  exact ⟨hWf, hBeh, hFault, hDiv, hPost⟩

private theorem equivArrSliceToBase_of_outcomes
    (p₁ : ArrSliceProgram) (p₂ : Program)
    (hBeh : ∀ (q : Query) (out : TerminalOut),
      BehaviorArrSlice p₁ q out ↔ Behavior p₂ q out)
    (hFault : ∀ (q : Query) (k : FaultKind),
      ReachesResultArrSlice p₁ q (.fault k) ↔ ReachesResult p₂ q (.fault k)) :
    ∀ q : Query,
      (WellFormedArrSlice p₁ q ↔ WellFormed p₂ q) ∧
      (∀ out : TerminalOut, BehaviorArrSlice p₁ q out ↔ Behavior p₂ q out) ∧
      (∀ k : FaultKind,
        ReachesResultArrSlice p₁ q (.fault k) ↔ ReachesResult p₂ q (.fault k)) ∧
      (DivergesArrSlice p₁ q ↔ Diverges p₂ q) ∧
      (∀ post : TerminalOut → Prop,
        SatisfiesPostArrSlice p₁ q post ↔ SatisfiesPost p₂ q post) := by
  intro q
  have hWf : WellFormedArrSlice p₁ q ↔ WellFormed p₂ q := by
    rw [wellFormedArrSlice_iff_no_fault p₁ q, wellFormedBase_iff_no_fault p₂ q]
    constructor
    · intro h k hk
      exact h k ((hFault q k).mpr hk)
    · intro h k hk
      exact h k ((hFault q k).mp hk)
  have hDiv : DivergesArrSlice p₁ q ↔ Diverges p₂ q := by
    rw [divergesArrSlice_iff_no_terminal_or_fault p₁ q,
      divergesBase_iff_no_terminal_or_fault p₂ q]
    constructor
    · intro h
      have hNoFault₂ : ∀ k : FaultKind, ¬ ReachesResult p₂ q (.fault k) :=
        fun k hk => h.2.2 k ((hFault q k).mpr hk)
      have hInit₂ : ∃ s₂ : State, initState p₂ q = .ok s₂ := by
        cases hI : initState p₂ q with
        | ok s₂ => exact ⟨s₂, rfl⟩
        | error k =>
          have hF : ReachesResult p₂ q (.fault k) := by
            unfold ReachesResult
            rw [hI]
          exact False.elim (hNoFault₂ k hF)
      exact ⟨hInit₂, fun out hB => h.2.1 out ((hBeh q out).mpr hB), hNoFault₂⟩
    · intro h
      have hNoFault₁ : ∀ k : FaultKind, ¬ ReachesResultArrSlice p₁ q (.fault k) :=
        fun k hk => h.2.2 k ((hFault q k).mp hk)
      have hInit₁ : ∃ s₁ : ArrSliceState, initStateArrSlice p₁ q = .ok s₁ := by
        cases hI : initStateArrSlice p₁ q with
        | ok s₁ => exact ⟨s₁, rfl⟩
        | error k =>
          have hF : ReachesResultArrSlice p₁ q (.fault k) := by
            unfold ReachesResultArrSlice
            rw [hI]
          exact False.elim (hNoFault₁ k hF)
      exact ⟨hInit₁, fun out hB => h.2.1 out ((hBeh q out).mp hB), hNoFault₁⟩
  have hPost : ∀ post : TerminalOut → Prop,
      SatisfiesPostArrSlice p₁ q post ↔ SatisfiesPost p₂ q post := by
    intro post
    unfold SatisfiesPostArrSlice SatisfiesPost
    constructor
    · intro h
      exact ⟨hWf.mp h.1, fun out hb => h.2 out ((hBeh q out).mpr hb)⟩
    · intro h
      exact ⟨hWf.mpr h.1, fun out hb => h.2 out ((hBeh q out).mp hb)⟩
  exact ⟨hWf, hBeh q, hFault q, hDiv, hPost⟩

private theorem fullSemanticEquivArrSlice_refl (p : ArrSliceProgram) :
    FullSemanticEquivArrSlice p p :=
  fullSemanticEquivArrSlice_of_outcomes p p (fun _ _ => Iff.rfl) (fun _ _ => Iff.rfl)

private theorem fullSemanticEquivArrSlice_symm {p₁ p₂ : ArrSliceProgram}
    (h : FullSemanticEquivArrSlice p₁ p₂) :
    FullSemanticEquivArrSlice p₂ p₁ :=
  fullSemanticEquivArrSlice_of_outcomes p₂ p₁
    (fun q out => (h.2.1 q out).symm)
    (fun q k => (h.2.2.1 q k).symm)

private theorem fullSemanticEquivArrSlice_trans {p₁ p₂ p₃ : ArrSliceProgram}
    (h₁₂ : FullSemanticEquivArrSlice p₁ p₂)
    (h₂₃ : FullSemanticEquivArrSlice p₂ p₃) :
    FullSemanticEquivArrSlice p₁ p₃ :=
  fullSemanticEquivArrSlice_of_outcomes p₁ p₃
    (fun q out => Iff.trans (h₁₂.2.1 q out) (h₂₃.2.1 q out))
    (fun q k => Iff.trans (h₁₂.2.2.1 q k) (h₂₃.2.2.1 q k))

private theorem fwd_stutter_reaches_arrSlice
    {p₁ p₂ : ArrSliceProgram}
    {R : ArrSliceState → ArrSliceState → Prop}
    {μ : ArrSliceState → Nat}
    (hStep : ∀ (s₁ s₂ : ArrSliceState), R s₁ s₂ →
      (∀ s₁' : ArrSliceState, evalStepArrSlice p₁ 0 s₁ = .step s₁' →
        (R s₁' s₂ ∧ μ s₁' < μ s₁) ∨
        (∃ s₂' : ArrSliceState, ReachesPlusArrSlice p₂ s₂ s₂' ∧ R s₁' s₂')) ∧
      (∀ out : TerminalOut, evalStepArrSlice p₁ 0 s₁ = .done out →
        ∃ s₂' : ArrSliceState,
          ReachesArrSlice p₂ s₂ s₂' ∧ StepArrSlice p₂ s₂' (.done out)) ∧
      (∀ k : FaultKind, evalStepArrSlice p₁ 0 s₁ = .fault k →
        ∃ s₂' : ArrSliceState,
          ReachesArrSlice p₂ s₂ s₂' ∧ StepArrSlice p₂ s₂' (.fault k)))
    {s₁ s₁' : ArrSliceState} (hReach : ReachesArrSlice p₁ s₁ s₁') :
    ∀ {s₂ : ArrSliceState}, R s₁ s₂ →
      ∃ s₂' : ArrSliceState, ReachesArrSlice p₂ s₂ s₂' ∧ R s₁' s₂' := by
  induction hReach with
  | refl =>
    intro s₂ hR
    exact ⟨s₂, ReachesArrSlice.refl s₂, hR⟩
  | tail _ hTail ih =>
    intro s₂ hR
    cases ih hR with
    | intro s₂Mid hs₂Mid =>
      have hEval := (stepArrSlice_iff_evalStep p₁ _ (.step _)).mp hTail
      cases (hStep _ s₂Mid hs₂Mid.2).1 _ hEval with
      | inl hStutter =>
        exact ⟨s₂Mid, hs₂Mid.1, hStutter.1⟩
      | inr hProg =>
        cases hProg with
        | intro s₂' hs₂' =>
          exact ⟨s₂', reachesArrSlice_trans hs₂Mid.1
            (reachesArrSlice_of_reachesPlusArrSlice hs₂'.1), hs₂'.2⟩

private theorem arrives_terminal_det_done {p : ArrSliceProgram}
    {s s₁ s₂ : ArrSliceState} {out₁ out₂ : TerminalOut}
    (h₁ : ReachesArrSlice p s s₁) (hs₁ : StepArrSlice p s₁ (.done out₁))
    (h₂ : ReachesArrSlice p s s₂) (hs₂ : StepArrSlice p s₂ (.done out₂)) :
    out₁ = out₂ := by
  cases reachesNArrSlice_of_reachesArrSlice h₁ with
  | intro n₁ hn₁ =>
    cases reachesNArrSlice_of_reachesArrSlice h₂ with
    | intro n₂ hn₂ =>
      have hTerm₁ : ¬ (∃ t : ArrSliceState, StepArrSlice p s₁ (.step t)) := by
        intro h
        cases h with
        | intro t ht =>
          have hEq := evalStepArrSlice_det hs₁ ht
          cases hEq
      have hTerm₂ : ¬ (∃ t : ArrSliceState, StepArrSlice p s₂ (.step t)) := by
        intro h
        cases h with
        | intro t ht =>
          have hEq := evalStepArrSlice_det hs₂ ht
          cases hEq
      have b₁ := reachesNArrSlice_terminal_bound hn₁ hTerm₁ hn₂
      have b₂ := reachesNArrSlice_terminal_bound hn₂ hTerm₂ hn₁
      have hEqLen : n₁ = n₂ := nat_le_antisymm b₂.1 b₁.1
      rw [hEqLen] at hn₁
      have hSEq : s₁ = s₂ := reachesNArrSlice_det hn₁ hn₂
      rw [hSEq] at hs₁
      have hResEq := evalStepArrSlice_det hs₁ hs₂
      cases hResEq
      rfl

private theorem arrives_terminal_det_fault {p : ArrSliceProgram}
    {s s₁ s₂ : ArrSliceState} {k₁ k₂ : FaultKind}
    (h₁ : ReachesArrSlice p s s₁) (hs₁ : StepArrSlice p s₁ (.fault k₁))
    (h₂ : ReachesArrSlice p s s₂) (hs₂ : StepArrSlice p s₂ (.fault k₂)) :
    k₁ = k₂ := by
  cases reachesNArrSlice_of_reachesArrSlice h₁ with
  | intro n₁ hn₁ =>
    cases reachesNArrSlice_of_reachesArrSlice h₂ with
    | intro n₂ hn₂ =>
      have hTerm₁ : ¬ (∃ t : ArrSliceState, StepArrSlice p s₁ (.step t)) := by
        intro h
        cases h with
        | intro t ht =>
          have hEq := evalStepArrSlice_det hs₁ ht
          cases hEq
      have hTerm₂ : ¬ (∃ t : ArrSliceState, StepArrSlice p s₂ (.step t)) := by
        intro h
        cases h with
        | intro t ht =>
          have hEq := evalStepArrSlice_det hs₂ ht
          cases hEq
      have b₁ := reachesNArrSlice_terminal_bound hn₁ hTerm₁ hn₂
      have b₂ := reachesNArrSlice_terminal_bound hn₂ hTerm₂ hn₁
      have hEqLen : n₁ = n₂ := nat_le_antisymm b₂.1 b₁.1
      rw [hEqLen] at hn₁
      have hSEq : s₁ = s₂ := reachesNArrSlice_det hn₁ hn₂
      rw [hSEq] at hs₁
      have hResEq := evalStepArrSlice_det hs₁ hs₂
      cases hResEq
      rfl

private theorem arrives_done_ne_fault {p : ArrSliceProgram}
    {s s₁ s₂ : ArrSliceState} {out : TerminalOut} {k : FaultKind}
    (h₁ : ReachesArrSlice p s s₁) (hs₁ : StepArrSlice p s₁ (.done out))
    (h₂ : ReachesArrSlice p s s₂) (hs₂ : StepArrSlice p s₂ (.fault k)) :
    False := by
  cases reachesNArrSlice_of_reachesArrSlice h₁ with
  | intro n₁ hn₁ =>
    cases reachesNArrSlice_of_reachesArrSlice h₂ with
    | intro n₂ hn₂ =>
      have hTerm₁ : ¬ (∃ t : ArrSliceState, StepArrSlice p s₁ (.step t)) := by
        intro h
        cases h with
        | intro t ht =>
          have hEq := evalStepArrSlice_det hs₁ ht
          cases hEq
      have hTerm₂ : ¬ (∃ t : ArrSliceState, StepArrSlice p s₂ (.step t)) := by
        intro h
        cases h with
        | intro t ht =>
          have hEq := evalStepArrSlice_det hs₂ ht
          cases hEq
      have b₁ := reachesNArrSlice_terminal_bound hn₁ hTerm₁ hn₂
      have b₂ := reachesNArrSlice_terminal_bound hn₂ hTerm₂ hn₁
      have hEqLen : n₁ = n₂ := nat_le_antisymm b₂.1 b₁.1
      rw [hEqLen] at hn₁
      have hSEq : s₁ = s₂ := reachesNArrSlice_det hn₁ hn₂
      rw [hSEq] at hs₁
      have hResEq := evalStepArrSlice_det hs₁ hs₂
      cases hResEq

private theorem bwd_stutter_done_aux
    {p₁ p₂ : ArrSliceProgram}
    {R : ArrSliceState → ArrSliceState → Prop}
    {μ : ArrSliceState → Nat}
    (hStep : ∀ (s₁ s₂ : ArrSliceState), R s₁ s₂ →
      (∀ s₁' : ArrSliceState, evalStepArrSlice p₁ 0 s₁ = .step s₁' →
        (R s₁' s₂ ∧ μ s₁' < μ s₁) ∨
        (∃ s₂' : ArrSliceState, ReachesPlusArrSlice p₂ s₂ s₂' ∧ R s₁' s₂')) ∧
      (∀ out : TerminalOut, evalStepArrSlice p₁ 0 s₁ = .done out →
        ∃ s₂' : ArrSliceState,
          ReachesArrSlice p₂ s₂ s₂' ∧ StepArrSlice p₂ s₂' (.done out)) ∧
      (∀ k : FaultKind, evalStepArrSlice p₁ 0 s₁ = .fault k →
        ∃ s₂' : ArrSliceState,
          ReachesArrSlice p₂ s₂ s₂' ∧ StepArrSlice p₂ s₂' (.fault k))) :
    ∀ (nBound mBound n : Nat) (s₁ s₂ s₂' : ArrSliceState) (out : TerminalOut),
      n ≤ nBound → μ s₁ ≤ mBound → R s₁ s₂ →
      ReachesNArrSlice p₂ n s₂ s₂' → StepArrSlice p₂ s₂' (.done out) →
      ∃ s₁' : ArrSliceState, ReachesArrSlice p₁ s₁ s₁' ∧ StepArrSlice p₁ s₁' (.done out) := by
  intro nBound
  induction nBound with
  | zero =>
    intro mBound
    induction mBound with
    | zero =>
      intro n s₁ s₂ s₂' out hN hM hR hReach hDone
      cases hEval : evalStepArrSlice p₁ 0 s₁ with
      | done out₁ =>
        have hFwd := (hStep s₁ s₂ hR).2.1 out₁ hEval
        cases hFwd with
        | intro s₂'' hs₂'' =>
          have hOutEq := arrives_terminal_det_done hs₂''.1 hs₂''.2
            (reachesArrSlice_of_reachesNArrSlice hReach) hDone
          rw [hOutEq] at hEval
          exact ⟨s₁, ReachesArrSlice.refl s₁,
            (stepArrSlice_iff_evalStep p₁ s₁ (.done out)).mpr hEval⟩
      | fault k₁ =>
        have hFwd := (hStep s₁ s₂ hR).2.2 k₁ hEval
        cases hFwd with
        | intro s₂'' hs₂'' =>
          exact False.elim (arrives_done_ne_fault
            (reachesArrSlice_of_reachesNArrSlice hReach) hDone hs₂''.1 hs₂''.2)
      | step s₁' =>
        cases (hStep s₁ s₂ hR).1 s₁' hEval with
        | inl hStutter =>
          exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_lt_of_le hStutter.2 hM))
        | inr hProg =>
          cases hProg with
          | intro s₂Mid hs₂Mid =>
            cases hs₂Mid.1 with
            | intro k hk =>
              have hTerm : ¬ (∃ t : ArrSliceState, StepArrSlice p₂ s₂' (.step t)) := by
                intro ht
                cases ht with
                | intro t hStepT =>
                  have hEq := evalStepArrSlice_det hDone hStepT
                  cases hEq
              have hB := reachesNArrSlice_terminal_bound hReach hTerm hk
              have hLt0 : k + 1 ≤ 0 := Nat.le_trans hB.1 hN
              exact False.elim (Nat.not_lt_zero k (Nat.lt_of_succ_le hLt0))
    | succ mB ihM =>
      intro n s₁ s₂ s₂' out hN hM hR hReach hDone
      cases hEval : evalStepArrSlice p₁ 0 s₁ with
      | done out₁ =>
        have hFwd := (hStep s₁ s₂ hR).2.1 out₁ hEval
        cases hFwd with
        | intro s₂'' hs₂'' =>
          have hOutEq := arrives_terminal_det_done hs₂''.1 hs₂''.2
            (reachesArrSlice_of_reachesNArrSlice hReach) hDone
          rw [hOutEq] at hEval
          exact ⟨s₁, ReachesArrSlice.refl s₁,
            (stepArrSlice_iff_evalStep p₁ s₁ (.done out)).mpr hEval⟩
      | fault k₁ =>
        have hFwd := (hStep s₁ s₂ hR).2.2 k₁ hEval
        cases hFwd with
        | intro s₂'' hs₂'' =>
          exact False.elim (arrives_done_ne_fault
            (reachesArrSlice_of_reachesNArrSlice hReach) hDone hs₂''.1 hs₂''.2)
      | step s₁' =>
        cases (hStep s₁ s₂ hR).1 s₁' hEval with
        | inl hStutter =>
