  have hExSet := lt_setElem?_some frame₂.locals scrTag
    (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) hLt
  cases hExSet with | intro slots₂' hSet₂ =>
  rw [writeArrSliceBasePlace_eq, hChk, hOv, hSet₂] at hStep
  have hSetZero : setElem? frame₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + 0)
