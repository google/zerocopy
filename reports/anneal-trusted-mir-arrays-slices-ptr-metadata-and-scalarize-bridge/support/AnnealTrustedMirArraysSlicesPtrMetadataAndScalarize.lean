    (hInitErr₁ : ∀ (q : Query) (k : FaultKind),
      initStateArrSlice p₁ q = .error k → initStateArrSlice p₂ q = .error k)
    (hInitErr₂ : ∀ (q : Query) (k : FaultKind),
      initStateArrSlice p₂ q = .error k → initStateArrSlice p₁ q = .error k)
    (hInitOk : ∀ (q : Query) (s₁ : ArrSliceState),
      initStateArrSlice p₁ q = .ok s₁ →
      ∃ s₂ : ArrSliceState, initStateArrSlice p₂ q = .ok s₂ ∧ R s₁ s₂)
    (hStep : ∀ (s₁ s₂ : ArrSliceState), R s₁ s₂ →
      (∀ s₁' : ArrSliceState, evalStepArrSlice p₁ 0 s₁ = .step s₁' →
        ∃ s₂' : ArrSliceState, evalStepArrSlice p₂ 0 s₂ = .step s₂' ∧ R s₁' s₂') ∧
      (∀ out : TerminalOut, evalStepArrSlice p₁ 0 s₁ = .done out →
        evalStepArrSlice p₂ 0 s₂ = .done out) ∧
      (∀ k : FaultKind, evalStepArrSlice p₁ 0 s₁ = .fault k →
        evalStepArrSlice p₂ 0 s₂ = .fault k)) :
    FullSemanticEquivArrSlice p₁ p₂ := by
  refine fullSemanticEquivArrSlice_of_fwd_stutter_sim p₁ p₂ R (fun _ => 0)
    hInitErr₁ hInitErr₂ hInitOk ?_
  intro s₁ s₂ hR
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hS₁
    cases (hStep s₁ s₂ hR).1 s₁' hS₁ with
    | intro s₂' hs₂' =>
      refine Or.inr ⟨s₂', ⟨0, .succ ?_ (.zero s₂')⟩, hs₂'.2⟩
      exact (stepArrSlice_iff_evalStep p₂ s₂ (.step s₂')).mpr hs₂'.1
  · intro out hD₁
    refine ⟨s₂, ReachesArrSlice.refl s₂, ?_⟩
    exact (stepArrSlice_iff_evalStep p₂ s₂ (.done out)).mpr ((hStep s₁ s₂ hR).2.1 out hD₁)
  · intro k hF₁
    refine ⟨s₂, ReachesArrSlice.refl s₂, ?_⟩
    exact (stepArrSlice_iff_evalStep p₂ s₂ (.fault k)).mpr ((hStep s₁ s₂ hR).2.2 k hF₁)

