                        have hLenVal4 : Trusted.MirSemantics.getElem? slots₂_4 scrB =
                            some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.len - (fromIdx + toIdx)))))))) := by
                          rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hBNeIdx) hS3.1]
                          exact getElem?_setElem?_self _ _ _ _ hS2.1
                        have hIdxVal4 : Trusted.MirSemantics.getElem? slots₂_4 scrIdx =
                            some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.start + fromIdx))))))) :=
                          getElem?_setElem?_self _ _ _ _ hS3.1
                        let sv' : SliceViewVal := { backing := sv.backing, start := sv.start + fromIdx, len := sv.len - (fromIdx + toIdx) }
                        have hBoundSv' : sv'.start + sv'.len < maxUsize := by
                          have hLeLen : fromIdx + (sv.len - (fromIdx + toIdx)) ≤ sv.len := by
                            have h1 : fromIdx + (sv.len - (fromIdx + toIdx)) ≤ (fromIdx + toIdx) + (sv.len - (fromIdx + toIdx)) :=
                              Nat.add_le_add_right (Nat.le_add_right _ _) _
                            rw [s_nat_add_sub_cancel_prime hSumLeLen] at h1
                            exact h1
                          change (sv.start + fromIdx) + (sv.len - (fromIdx + toIdx)) < maxUsize
                          rw [Nat.add_assoc]
                          exact Nat.lt_of_le_of_lt (Nat.add_le_add_left hLeLen _) hBoundSv
                        have hWD := exec_subslice_writeDst pack bbTgt f₂_4 cm f₁.locals sv'
                          hBodyTgt hBbTgt hFindD hSlD.1 hG4 hG5 hG6 hG7 hS3.2.2 hTagVal4 hIdxVal4 hLenVal4 hBoundSv' hBackCompat'
                        cases hSlDEq : slD with
                        | baseSlot _ => have hF := hSlD.2; rw [hSlDEq] at hF; cases hF
                        | arrDead => have hF := hSlD.2; rw [hSlDEq] at hF; cases hF
                        | liveArray _ => have hF := hSlD.2; rw [hSlDEq] at hF; cases hF
                        | sliceDead =>
                          have hF4 := hWD.1 hSlDEq
                          refine ⟨fun s₁' h => (by rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp [evalSubsliceVal] at h; rw [hNotOob] at h; dsimp at h; rw [hBleTrue] at h; dsimp at h; rw [hSlD.1, hSlDEq] at h; cases h),
                            fun out h => (by rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp [evalSubsliceVal] at h; rw [hNotOob] at h; dsimp at h; rw [hBleTrue] at h; dsimp at h; rw [hSlD.1, hSlDEq] at h; cases h),
                            fun kFault h => by
                              rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                              dsimp [evalSubsliceVal] at h; rw [hNotOob] at h; dsimp at h; rw [hBleTrue] at h; dsimp at h; rw [hSlD.1, hSlDEq] at h
                              injection h with hkEq; rw [← hkEq]
                              exact reachesArrSlice_of_reach_fault hReach3 hF4⟩
                        | liveSlice optDst =>
                          have hWDEx := hWD.2 optDst hSlDEq
                          cases hWDEx with | intro slots₁' hWR =>
                          cases hWR with | intro slots₂' hWRest =>
                          have hReach8 := reachesNArrSlice_trans hReach3 hWRest.2.1
                          refine ⟨?_, ?_, ?_⟩
                          · intro s₁' hStep
                            rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at hStep; dsimp at hStep; rw [hNoUnsup] at hStep
                            dsimp [evalSubsliceVal] at hStep; rw [hNotOob] at hStep; dsimp at hStep; rw [hBleTrue] at hStep
                            dsimp at hStep; rw [hSlD.1, hSlDEq] at hStep; dsimp at hStep; rw [hWRest.1] at hStep
                            injection hStep with hsEq; rw [← hsEq]
                            have hLen8 : (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
                                (.subslice dstS srcS fromIdx toIdx fromEnd)).length = 8 := by
                              dsimp [base] at hGenEq; rw [hGenEq, hFE, hSumLt]; rfl
                            have hReach8' : ReachesNArrSlice pTgt (7 + 1) { frames := [f₂], callerMem := cm }
                                { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
                                    pack.bodySrc.locals.length (.subslice dstS srcS fromIdx toIdx fromEnd)).length, locals := slots₂' }], callerMem := cm } := by
                              rw [hLen8]; exact hReach8
                            exact reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLen₂ hReach8' hWRest.2.2
                          · intro out hDone
                            rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at hDone; dsimp at hDone; rw [hNoUnsup] at hDone
                            dsimp [evalSubsliceVal] at hDone; rw [hNotOob] at hDone; dsimp at hDone; rw [hBleTrue] at hDone
                            dsimp at hDone; rw [hSlD.1, hSlDEq] at hDone; dsimp at hDone; rw [hWRest.1] at hDone; cases hDone
                          · intro kFault hFault
                            rw [hDeclD, hDeclS, hSlS.1, hSlSEq] at hFault; dsimp at hFault; rw [hNoUnsup] at hFault
                            dsimp [evalSubsliceVal] at hFault; rw [hNotOob] at hFault; dsimp at hFault; rw [hBleTrue] at hFault
                            dsimp at hFault; rw [hSlD.1, hSlDEq] at hFault; dsimp at hFault; rw [hWRest.1] at hFault; cases hFault

private theorem sim_stmt_ptrMetadata
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {dst sLoc : LocalId}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.ptrMetadata dst sLoc))
    (hChk : checkStmtForSlices pack.bodySrc.locals plan.entries (.ptrMetadata dst sLoc) = true)
    (hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.ptrMetadata dst sLoc)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForSlices pack.bodySrc.locals plan.entries
          pack.bodySrc.locals.length (.ptrMetadata dst sLoc)) j)
    (hLen₂ : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length
        (.ptrMetadata dst sLoc)).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  change (match findSliceEntry plan.entries sLoc, Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with
    | some _, some (.base dstTy) => MirTy.beq dstTy usizeTy
    | _, _ => false) = true at hChk
  cases hFind : findSliceEntry plan.entries sLoc with
  | none => rw [hFind] at hChk; cases hChk
  | some p =>
    cases p with | mk k optArr =>
    cases hDstDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with
    | none => rw [hFind, hDstDecl] at hChk; cases hChk
    | some dDst =>
      cases dDst with
      | array _ _ => rw [hFind, hDstDecl] at hChk; cases hChk
      | sliceView _ => rw [hFind, hDstDecl] at hChk; cases hChk
      | base dstTy =>
        rw [hFind, hDstDecl] at hChk
        have hTyEq : dstTy = usizeTy := mirTy_beq_eq _ _ hChk
        rw [hTyEq] at hDstDecl
        have hVal := findSliceEntry_some_lt_and_valid pack.hLoop hFind
        have hkLt := hVal.1
        cases hVal.2 with | intro e hE =>
        cases hE.2.2.2.2.2 with | intro sTy hs =>
        have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
          rw [← hE.2.1]; exact hs.1
        have hDstLt : dst < pack.bodySrc.locals.length := getElem?_some_lt _ _ _ hDstDecl
        have hDstNS := bodyTgt_decl_nonSlice_lt pack hDstLt (fun sTy' h => by rw [hDstDecl] at h; cases h)
        have hDstDeclTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some (.base usizeTy) := by
          rw [hDstNS.2, hDstDecl]
        let base := pack.bodySrc.locals.length
        let off := base + 4 * k
        let scrTag := base + 4 * plan.entries.length
        have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries base (.ptrMetadata dst sLoc) =
            [ mkLivenessCheckStmt off,
              mkAssignUse scrTag (.copy { localId := off + 1, projection := [] }),
              mkAssignUse dst (.copy { localId := off + 3, projection := [] }) ] := by
          dsimp [lowerStmtForSlices]
          rw [hFind]
        have hG0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (mkLivenessCheckStmt off) := by
          have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl); rw [Nat.add_zero, hGen] at h0; exact h0
        have hG1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
            some (mkAssignUse scrTag (.copy { localId := off + 1, projection := [] })) := by
          have h1 := hGetGen 1 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h1; exact h1
        have hG2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
            some (mkAssignUse dst (.copy { localId := off + 3, projection := [] })) := by
          have h2 := hGetGen 2 (by rw [hGen]; exact nat_blt_lt rfl); rw [hGen] at h2; exact h2
        have hS1 : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
            (match Trusted.MirSemantics.getElem? pack.bodySrc.locals dst,
                Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc,
                Trusted.MirSemantics.getElem? f₁.locals sLoc with
              | some (.base dstTy'), some (.sliceView _), some sliceSl =>
                if !(MirTy.beq dstTy' usizeTy) then .fault .unsupported
                else match sliceSl with
                  | .sliceDead | .liveSlice none => .fault .undefined
                  | .liveSlice (some sv) =>
                    let lenVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩
                    match writeArrSliceBasePlace f₁.locals dst dstTy' lenVal with
                    | .error k => .fault k
                    | .ok slots' => stepStmtNext f₁ cm slots'
                  | _ => .fault .unsupported
              | _, _, _ => .fault .unsupported) :=
          evalStepArrSlice_at_stmt pSrc pack.bodySrc bbSrc f₁ cm _ hBodySrc hBbSrc hStmtSrc
        dsimp [FwdStmtSim]
        rw [hS1]
        have hNoUnsup : (!(MirTy.beq usizeTy usizeTy)) = false := by rw [mirTy_beq_refl usizeTy]; rfl
        have hExSl := hLM.2.2.1 sLoc k optArr hFind
        cases hExSl with | intro slS hSlS =>
        have hLive0 := step_mkLivenessCheckStmt_from_rel pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFind hSlS.1
        cases hSlSEq : slS with
        | baseSlot _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
        | arrDead => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
        | liveArray _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
        | sliceDead =>
          have hF0 := hLive0.1 hSlSEq
          refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
            fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
            fun kFault h => by
              rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
              injection h with hkEq; rw [← hkEq]
              exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
                (stepArrSlice_iff_evalStep _ _ _).mpr hF0⟩⟩
        | liveSlice optSv =>
          have hStep0Ex := step_mkLivenessCheckStmt_live_pres pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFind (by rw [hSlS.1, hSlSEq])
          cases hStep0Ex with | intro slots₂_1 hS0 =>
          have hReach0 := reachesNArrSlice_one_step hS0.2.1
          let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂_1 }
          have hExSl1 := hS0.2.2.2.2.1 sLoc k optArr hFind
          cases hExSl1 with | intro slS1 hSlS1 =>
          have hEqSl1 : slS1 = .liveSlice optSv := by
            have hS : some slS1 = some (.liveSlice optSv) := by rw [← hSlS1.1, hSlS.1, hSlSEq]
            injection hS
          rw [hEqSl1] at hSlS1
          cases optSv with
          | none =>
            have hRT := step_readTag_from_rel pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFind hSlS1.1
            have hF1 := hRT.1 rfl
            refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
              fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
              fun kFault h => by
                rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                injection h with hkEq; rw [← hkEq]
                exact reachesArrSlice_of_reach_fault hReach0 hF1⟩
          | some sv =>
            have hStep1Ex := step_readTag_from_rel_set pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFind hSlS1.1
            cases hStep1Ex with | intro slots₂_2 hS1 =>
            have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS1.2.1)
            let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
            have hExSl2 := hS1.2.2.2.2.1 sLoc k optArr hFind
            cases hExSl2 with | intro slS2 hSlS2 =>
            have hEqSl2 : slS2 = .liveSlice (some sv) := by
              have hS : some slS2 = some (.liveSlice (some sv)) := by rw [← hSlS2.1, hSlS.1, hSlSEq]
              injection hS
            rw [hEqSl2] at hSlS2
            have hComp2 := hSlS2.2; dsimp [SliceCompRel] at hComp2
            have hDeclOff3 : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (off + 3) = some (.base usizeTy) :=
              getElem?_bodyTgt_locals_comp pack hkLt (r := 3) (by decide)
            have hStep2 := step_mkAssignUse_copy_base_val pTgt pack.bodyTgt bbTgt f₂_2 cm dst (off + 3)
              usizeTy usizeTy (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 sv.len)))
              hBodyTgt hBbTgt hG2 hDstDeclTgt hDeclOff3 rfl hComp2.2.2.2.2.2
            have hLenLtMax : sv.len < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left _ _) hComp2.1
            let lenVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩
            have hChkVal : (!checkVal lenVal usizeTy) = false := by
              rw [checkVal_usize_of_lt_maxUsize _ hLenLtMax]; rfl
            have hDstEq : Trusted.MirSemantics.getElem? slots₂_2 dst = Trusted.MirSemantics.getElem? f₁.locals dst :=
              hS1.2.2.1.2 dst hDstLt hDstNS.1
            cases hDstSlot : Trusted.MirSemantics.getElem? f₁.locals dst with
            | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hDstSlot) (by rw [hS1.2.2.1.1]; exact hDstLt))
            | some dSlot =>
              cases dSlot with
              | baseSlot bsl =>
                cases bsl with
                | dead =>
                  have hW1 : writeArrSliceBasePlace f₁.locals dst usizeTy lenVal = .error .undefined := by
                    rw [writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstSlot]
                  have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂_2], callerMem := cm } = .fault .undefined := by
                    rw [hStep2, writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstEq, hDstSlot]
                  refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                    fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                    fun kFault h => by
                      rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h
                      injection h with hkEq; rw [← hkEq]
                      exact reachesArrSlice_of_reach_fault hReach1 hF2⟩
                | live _ =>
                  have hLt1 : dst < f₁.locals.length := getElem?_some_lt _ _ _ hDstSlot
                  have hLt2 : dst < slots₂_2.length := by rw [setElem?_length _ _ _ _ hS1.1, setElem?_length _ _ _ _ hS0.1, hLM.2.1, bodyTgt_locals_length pack]; exact Nat.lt_of_lt_of_le hDstLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
                  have hEx1 := lt_setElem?_some f₁.locals dst (.baseSlot (.live (some lenVal))) hLt1
                  have hEx2 := lt_setElem?_some slots₂_2 dst (.baseSlot (.live (some lenVal))) hLt2
                  cases hEx1 with | intro slots₁' hSet₁ =>
                  cases hEx2 with | intro slots₂' hSet₂ =>
                  have hW1 : writeArrSliceBasePlace f₁.locals dst usizeTy lenVal = .ok slots₁' := by
                    rw [writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstSlot, hSet₁]
                  have hW2 : evalStepArrSlice pTgt 0 { frames := [f₂_2], callerMem := cm } = stepStmtNext f₂_2 cm slots₂' := by
                    rw [hStep2, writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstEq, hDstSlot, hSet₂]
                  have hReach2 := reachesNArrSlice_trans hReach1 (reachesNArrSlice_one_step hW2)
                  have hLM' := sliceLocalMatch_set_base pack hS1.2.2 hDstLt hDstNS.1 hSet₁ hSet₂
                  refine ⟨?_, ?_, ?_⟩
                  · intro s₁' hStep
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at hStep; dsimp at hStep; rw [hNoUnsup] at hStep
                    dsimp at hStep; rw [hW1] at hStep; injection hStep with hsEq; rw [← hsEq]
                    have hLen3 : (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length (.ptrMetadata dst sLoc)).length = 3 := by
                      dsimp [base] at hGen; rw [hGen]; rfl
                    have hReach3 : ReachesNArrSlice pTgt (2 + 1) { frames := [f₂], callerMem := cm }
                        { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries
                            pack.bodySrc.locals.length (.ptrMetadata dst sLoc)).length, locals := slots₂' }], callerMem := cm } := by
                      rw [hLen3]; exact hReach2
                    exact reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLen₂ hReach3 hLM'
                  · intro out hDone
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at hDone; dsimp at hDone; rw [hNoUnsup] at hDone
                    dsimp at hDone; rw [hW1] at hDone; cases hDone
                  · intro kFault hFault
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at hFault; dsimp at hFault; rw [hNoUnsup] at hFault
                    dsimp at hFault; rw [hW1] at hFault; cases hFault
              | arrDead =>
                have hW1 : writeArrSliceBasePlace f₁.locals dst usizeTy lenVal = .error .unsupported := by
                  rw [writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstSlot]
                have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂_2], callerMem := cm } = .fault .unsupported := by
                  rw [hStep2, writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstEq, hDstSlot]
                refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                  fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                  fun kFault h => by
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h
                    injection h with hkEq; rw [← hkEq]; exact reachesArrSlice_of_reach_fault hReach1 hF2⟩
              | liveArray _ =>
                have hW1 : writeArrSliceBasePlace f₁.locals dst usizeTy lenVal = .error .unsupported := by
                  rw [writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstSlot]
                have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂_2], callerMem := cm } = .fault .unsupported := by
                  rw [hStep2, writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstEq, hDstSlot]
                refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                  fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                  fun kFault h => by
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h
                    injection h with hkEq; rw [← hkEq]; exact reachesArrSlice_of_reach_fault hReach1 hF2⟩
              | sliceDead =>
                have hW1 : writeArrSliceBasePlace f₁.locals dst usizeTy lenVal = .error .unsupported := by
                  rw [writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstSlot]
                have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂_2], callerMem := cm } = .fault .unsupported := by
                  rw [hStep2, writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstEq, hDstSlot]
                refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                  fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                  fun kFault h => by
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h
                    injection h with hkEq; rw [← hkEq]; exact reachesArrSlice_of_reach_fault hReach1 hF2⟩
              | liveSlice _ =>
                have hW1 : writeArrSliceBasePlace f₁.locals dst usizeTy lenVal = .error .unsupported := by
                  rw [writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstSlot]
                have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂_2], callerMem := cm } = .fault .unsupported := by
                  rw [hStep2, writeArrSliceBasePlace_eq, hChkVal]; dsimp; rw [hDstEq, hDstSlot]
                refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                  fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h; cases h),
                  fun kFault h => by
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hW1] at h
                    injection h with hkEq; rw [← hkEq]; exact reachesArrSlice_of_reach_fault hReach1 hF2⟩

private theorem stmt_step_sim
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory} {stmt : ArrSliceStmt}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId) (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmt)
    (hLen₂ : f₂.stmtIdx = (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries
      pack.bodySrc.locals.length) (bbSrc.statements.take f₁.stmtIdx)).length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdStmtSim pack f₁ f₂ cm := by
  have hL := lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx =
      some (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc) := by
    rw [hBbEq]; exact hL.1
  have hGetGen : ∀ j, j < (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length stmt).length →
      Trusted.MirSemantics.getElem?
        (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc).statements
        (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem?
          (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length stmt) j := by
    intro j hj; rw [hLen₂]; exact hL.2.1 j hj
  have hLenNext : f₂.stmtIdx + (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length stmt).length =
      (listFlatMap (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length := by
    rw [hLen₂]; exact hL.2.2
  have hProps := (pack_bb_props pack hBbSrc).1 f₁.stmtIdx stmt hStmtSrc
  have hBnd := hProps.1
  have hChk := hProps.2.1
  have hStor := hProps.2.2
  cases stmt with
  | baseStmt s =>
    cases s with
    | nop =>
      have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length (.baseStmt .nop) = [.baseStmt .nop] := rfl
      have hGetTgt : Trusted.MirSemantics.getElem?
          (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc).statements f₂.stmtIdx =
          some (.baseStmt .nop) := by
        have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl); rw [Nat.add_zero, hGen] at h0; exact h0
      exact sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLenNext hLM
        ⟨fun s₁' h => by rw [evalArrSliceStmt_nop] at h; injection h with hsEq; exact ⟨f₁.locals, f₂.locals, hsEq.symm, evalArrSliceStmt_nop _ _ _, hLM⟩,
         fun out h => (by rw [evalArrSliceStmt_nop] at h; cases h),
         fun k h => by rw [evalArrSliceStmt_nop] at h; cases h⟩
    | unsupported =>
      have hGen : lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length (.baseStmt .unsupported) = [.baseStmt .unsupported] := rfl
      have hGetTgt : Trusted.MirSemantics.getElem?
          (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length bbSrc).statements f₂.stmtIdx =
          some (.baseStmt .unsupported) := by
        have h0 := hGetGen 0 (by rw [hGen]; exact nat_blt_lt rfl); rw [Nat.add_zero, hGen] at h0; exact h0
      exact sim_stmt_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hGen hGetTgt hLenNext hLM
        ⟨fun s₁' h => (by rw [evalArrSliceStmt_unsupported] at h; cases h),
         fun out h => (by rw [evalArrSliceStmt_unsupported] at h; cases h),
         fun k h => by rw [evalArrSliceStmt_unsupported] at h; rw [evalArrSliceStmt_unsupported]; exact h⟩
    | storageLive id =>
      exact sim_stmt_storageLive pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hStor hGetGen hLenNext hLM
    | storageDead id =>
      exact sim_stmt_storageDead pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hStor hGetGen hLenNext hLM
    | assign dst rval =>
      exact sim_stmt_assign pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
  | aggregateArray arrLocal ops =>
    exact sim_stmt_aggregateArray pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
  | repeatArray arrLocal op =>
    exact sim_stmt_repeatArray pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
  | arrayLivenessCheck arrLocal =>
    exact sim_stmt_arrayLivenessCheck pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hBnd hGetGen hLenNext hLM
  | readArrayConst dst arrLocal idx isMove =>
    exact sim_stmt_readArrayConst pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
  | writeArrayConst arrLocal idx rval =>
    exact sim_stmt_writeArrayConst pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hBnd hChk hGetGen hLenNext hLM
  | unsizeArrayToSlice sLoc arrLocal =>
    exact sim_stmt_unsizeArrayToSlice pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hChk hGetGen hLenNext hLM
  | sliceFromRawParts sLoc lenOp =>
    exact sim_stmt_sliceFromRawParts pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hChk hGetGen hLenNext hLM
  | subslice dstS srcS fromIdx toIdx fromEnd =>
    exact sim_stmt_subslice pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hChk hGetGen hLenNext hLM
  | ptrMetadata dst sLoc =>
    exact sim_stmt_ptrMetadata pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hBbTgt hStmtSrc hChk hGetGen hLenNext hLM

