      ∃ slots₂',
        evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
          stepStmtNext frame₂ cm slots₂' ∧
        SliceLocalMatch pack slots₁ slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length + rDst) =
          some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b)))))))) := by
  let dst := pack.bodySrc.locals.length + 4 * plan.entries.length + rDst
  let src := pack.bodySrc.locals.length + 4 * plan.entries.length + rSrc
  have hrDst5 : rDst < 5 := Nat.lt_trans hrDst (by decide)
  have hrSrc5 : rSrc < 5 := Nat.lt_trans hrSrc (by decide)
  have hNe4D : Nat.beq rDst 4 = false := by
    cases rDst with
    | zero => rfl
    | succ r1 => cases r1 with | zero => rfl | succ r2 => cases r2 with | zero => rfl | succ r3 => cases r3 with | zero => rfl | succ _ => exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hrDst)))))
  have hNe4S : Nat.beq rSrc 4 = false := by
    cases rSrc with
    | zero => rfl
    | succ r1 => cases r1 with | zero => rfl | succ r2 => cases r2 with | zero => rfl | succ r3 => cases r3 with | zero => rfl | succ _ => exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hrSrc)))))
  have hDstDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some (.base usizeTy) := by
    have hD := getElem?_bodyTgt_locals_scratch pack hrDst5; rw [hNe4D] at hD; exact hD
  have hSrcDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals src = some (.base usizeTy) := by
    have hD := getElem?_bodyTgt_locals_scratch pack hrSrc5; rw [hNe4S] at hD; exact hD
  have hExLhs := evalArrSlicePrimitiveOperand_move_usize pack.bodyTgt.locals frame₂.locals src a hSrcDecl hSrcSlot
  cases hExLhs with | intro slotsMid hLhs =>
  have hLM1 := sliceLocalMatch_set_scratch pack hLM hrSrc5 none hLhs.1
  have hRhsEval := hRhs slotsMid hLhs.1
  have hBin := step_mkBinOp_usize pTgt pack.bodyTgt bbTgt frame₂ cm .subUnchecked dst
    (.move { localId := src, projection := [] }) rhs usizeTy a b slotsMid slotsMid
    hBodyTgt hBbTgt hStmt hDstDecl hLhs.2 hRhsEval
  constructor
  · intro hab
    rw [hBin, evalBinOp_usize_subUnchecked_ub a b ha hb hab]
  · intro hba
    have hSubLt : a - b < maxUsize := Nat.lt_of_le_of_lt (Nat.sub_le a b) ha
    rw [evalBinOp_usize_subUnchecked_ok a b ha hb hba] at hBin
    dsimp at hBin
    have hChk : (!checkVal (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b)))) usizeTy) = false := by
      rw [checkVal_usize_of_lt_maxUsize (a - b) hSubLt]; rfl
    have hDstSlot := hLM1.2.2.2 rDst hrDst5
    cases hDstSlot with | intro ov hOv =>
    have hLt := getElem?_some_lt slotsMid dst _ hOv
    have hExSet := lt_setElem?_some slotsMid dst
      (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b))))))) hLt
    cases hExSet with | intro slots₂' hSet₂ =>
    rw [writeArrSliceBasePlace_eq, hChk, hOv, hSet₂] at hBin
    have hLM2 := sliceLocalMatch_set_scratch pack hLM1 hrDst5
      (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b))))) hSet₂
    exact ⟨slots₂', hBin, hLM2, getElem?_setElem?_self slotsMid dst _ slots₂' hSet₂⟩

private theorem step_addUnchecked_copy_from_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (slots₁ : List ArrSliceSlot) (rDst : Nat) (hrDst : rDst < 4)
    (src : LocalId) (a : Nat)
    (rhs : Operand) (b : Nat) (hab : a + b < maxUsize)
