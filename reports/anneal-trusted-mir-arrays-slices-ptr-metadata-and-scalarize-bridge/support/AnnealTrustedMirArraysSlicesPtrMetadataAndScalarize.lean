      have h2 := (bool_and_eq_true _ _).mp h1.1
      have h3 := (bool_and_eq_true _ _).mp h2.1
      have h4 := (bool_and_eq_true _ _).mp h3.1
      rw [nat_beq_eq d₁ d₂ h4.1, nat_beq_eq s₁ s₂ h4.2,
        nat_beq_eq f₁ f₂ h3.2, nat_beq_eq t₁ t₂ h2.2,
