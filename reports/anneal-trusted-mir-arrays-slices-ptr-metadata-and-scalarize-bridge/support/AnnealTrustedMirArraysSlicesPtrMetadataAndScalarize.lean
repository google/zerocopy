      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))))))
    (hRhs : ∀ slotsMid,
      setElem? frame₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + rSrc)
        (.baseSlot (.live none)) = some slotsMid →
