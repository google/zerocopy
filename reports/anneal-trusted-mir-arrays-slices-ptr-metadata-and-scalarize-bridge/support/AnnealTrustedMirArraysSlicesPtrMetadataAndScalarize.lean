            match writeArrSliceBasePlace f.locals dst dstTy (.scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩) with
            | .error k => StepResult.fault k | .ok slots' => stepStmtNext f cm slots'
          | _ => StepResult.fault FaultKind.unsupported
      | _, _, _ => StepResult.fault FaultKind.unsupported) = .step s' at h
    cases hDD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hDD] at h; cases h
    | some d1 =>
      cases d1 with
      | array _ _ => rw [hDD] at h; cases h
      | sliceView _ => rw [hDD] at h; cases h
      | base dstTy =>
        cases hDS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hDD, hDS] at h; cases h
        | some d2 =>
          cases d2 with
          | base _ => rw [hDD, hDS] at h; cases h
          | array _ _ => rw [hDD, hDS] at h; cases h
          | sliceView _ =>
            cases hS : Trusted.MirSemantics.getElem? f.locals sLoc with
            | none => rw [hDD, hDS, hS] at h; cases h
            | some sliceSl =>
              rw [hDD, hDS, hS] at h; dsimp at h
              cases hTy : !(MirTy.beq dstTy usizeTy) with
