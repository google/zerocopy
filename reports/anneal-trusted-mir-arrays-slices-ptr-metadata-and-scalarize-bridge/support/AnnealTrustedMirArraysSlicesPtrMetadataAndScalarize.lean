private theorem fin_mk_eq {n v₁ v₂ : Nat} {h₁ : v₁ < n} {h₂ : v₂ < n} (h : v₁ = v₂) :
    Fin.mk v₁ h₁ = Fin.mk v₂ h₂ := by
  cases h
  rfl

private theorem bitVec_ofNat_toNat {w : Nat} (bv : BitVec w) :
    BitVec.ofNat w bv.toNat = bv := by
  cases bv with
  | ofFin tf =>
    cases tf with
    | mk v hlt =>
      apply congrArg BitVec.ofFin
      exact fin_mk_eq (Nat.mod_eq_of_lt hlt)

private theorem findSliceEntry_none_of_not_sliceView
    {decls : List ArrSliceLocalDecl} {argCount : Nat} {entries : List SliceBackingEntry}
    (hLoop : checkSliceBackingEntriesLoop decls argCount 0 decls entries = true)
    {i : LocalId}
    (hNot : ∀ sTy, Trusted.MirSemantics.getElem? decls i ≠ some (.sliceView sTy)) :
    findSliceEntry entries i = none := by
  cases hf : findSliceEntry entries i with
  | none => rfl
  | some p =>
    have hV := findSliceEntry_some_lt_and_valid hLoop hf
    cases hV.2 with | intro e hE =>
    cases hE.2.2.2.2.2 with | intro sTy hs =>
    have hGet : Trusted.MirSemantics.getElem? decls i = some (.sliceView sTy) := by
      rw [← hE.2.1]
      exact hs.1
    exact False.elim (hNot sTy hGet)

private theorem getElem?_bodyTgt_nonSlice {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {i : LocalId}
    (hi : i < pack.bodySrc.locals.length)
    (hNone : findSliceEntry plan.entries i = none) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals i =
      Trusted.MirSemantics.getElem? pack.bodySrc.locals i := by
  rw [getElem?_bodyTgt_locals_lt pack hi, getElem?_tombstoneSliceDecls]
  cases hGet : Trusted.MirSemantics.getElem? pack.bodySrc.locals i with
  | none => rfl
  | some d =>
    cases d with
    | base _ => rfl
    | array _ _ => rfl
    | sliceView sTy =>
      exact False.elim (findSliceEntry_none_implies_not_sliceView pack.hLoop hNone sTy hGet)

private noncomputable def PrefixSlotsMatch (decls : List ArrSliceLocalDecl)
    (entries : List SliceBackingEntry) (slots₁ slots₂ : List ArrSliceSlot) : Prop :=
  slots₁.length = decls.length ∧
    ∀ i, i < decls.length → findSliceEntry entries i = none →
      Trusted.MirSemantics.getElem? slots₂ i = Trusted.MirSemantics.getElem? slots₁ i

private theorem prefixSlotsMatch_set_base {decls : List ArrSliceLocalDecl}
    {entries : List SliceBackingEntry} {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch decls entries slots₁ slots₂)
    {dst : LocalId} (hDst : dst < decls.length) (sl : ArrSliceSlot)
    (hSet₁ : setElem? slots₁ dst sl = some slots₁')
    (hSet₂ : setElem? slots₂ dst sl = some slots₂') :
    PrefixSlotsMatch decls entries slots₁' slots₂' ∧
      slots₂'.length = slots₂.length ∧
      ∀ j, decls.length ≤ j →
        Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j := by
  refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
  · rw [setElem?_length slots₁ dst sl slots₁' hSet₁]
    exact hPre.1
  · intro i hi hNone
    cases Nat.decEq dst i with
    | isTrue hEq =>
      rw [← hEq]
      rw [getElem?_setElem?_self slots₂ dst sl slots₂' hSet₂,
          getElem?_setElem?_self slots₁ dst sl slots₁' hSet₁]
    | isFalse hNe =>
      rw [getElem?_setElem?_ne slots₂ dst i sl slots₂' hNe hSet₂,
          getElem?_setElem?_ne slots₁ dst i sl slots₁' hNe hSet₁]
      exact hPre.2 i hi hNone
  · exact setElem?_length slots₂ dst sl slots₂' hSet₂
  · intro j hj
    have hNe : dst ≠ j := Nat.ne_of_lt (Nat.lt_of_lt_of_le hDst hj)
    exact getElem?_setElem?_ne slots₂ dst j sl slots₂' hNe hSet₂

private theorem prefixSlotsMatch_set_ext {decls : List ArrSliceLocalDecl}
    {entries : List SliceBackingEntry} {slots₁ slots₂ slots₂' : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch decls entries slots₁ slots₂)
    {loc : LocalId} (hGe : decls.length ≤ loc) (sl : ArrSliceSlot)
    (hSet₂ : setElem? slots₂ loc sl = some slots₂') :
    PrefixSlotsMatch decls entries slots₁ slots₂' ∧
      slots₂'.length = slots₂.length := by
  refine ⟨⟨hPre.1, ?_⟩, setElem?_length slots₂ loc sl slots₂' hSet₂⟩
  intro i hi hNone
  have hNe : loc ≠ i := Nat.ne_of_gt (Nat.lt_of_lt_of_le hi hGe)
  rw [getElem?_setElem?_ne slots₂ loc i sl slots₂' hNe hSet₂]
  exact hPre.2 i hi hNone

private theorem operandUsesOnlyBase_base_local {decls : List ArrSliceLocalDecl}
    {entries : List SliceBackingEntry} {argCount : Nat}
    (hLoop : checkSliceBackingEntriesLoop decls argCount 0 decls entries = true)
    {p : Place} {ty : MirTy}
    (hGet : Trusted.MirSemantics.getElem? decls p.localId = some (.base ty)) :
    p.localId < decls.length ∧ findSliceEntry entries p.localId = none := by
  refine ⟨getElem?_some_lt decls p.localId (.base ty) hGet, ?_⟩
  apply findSliceEntry_none_of_not_sliceView hLoop
  intro sTy hS
  rw [hGet] at hS
  cases hS

-- Equation and reduction lemmas for base evaluators
private theorem evalArrSliceBaseOperandToSlot_copy (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (place : Place) :
    evalArrSliceBaseOperandToSlot decls slots (.copy place) =
      if (!place.projection.isEmpty) = true then Except.error FaultKind.unsupported
      else
        match Trusted.MirSemantics.getElem? decls place.localId,
            Trusted.MirSemantics.getElem? slots place.localId with
        | some (.base ty), some (.baseSlot (.live optVal)) => Except.ok (ty, optVal, slots)
        | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
        | _, _ => Except.error FaultKind.unsupported := rfl

private theorem evalArrSliceBaseOperandToSlot_move (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (place : Place) :
    evalArrSliceBaseOperandToSlot decls slots (.move place) =
      if (!place.projection.isEmpty) = true then Except.error FaultKind.unsupported
      else
        match Trusted.MirSemantics.getElem? decls place.localId,
            Trusted.MirSemantics.getElem? slots place.localId with
        | some (.base ty), some (.baseSlot (.live optVal)) =>
          match setElem? slots place.localId (.baseSlot (liveUninitSlot ty)) with
          | some slots' => Except.ok (ty, optVal, slots')
          | none => Except.error FaultKind.unsupported
        | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
        | _, _ => Except.error FaultKind.unsupported := rfl

private theorem evalArrSliceBaseOperandToSlot_const (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (c : ConstOperand) :
    evalArrSliceBaseOperandToSlot decls slots (.constant c) =
      match evalConstLit c.ty c.lit with
      | Except.ok v => Except.ok (c.ty, some v, slots)
      | Except.error k => Except.error k := rfl

private theorem evalArrSliceBaseOperandToSlot_usizeConst (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (n : Nat) :
    evalArrSliceBaseOperandToSlot decls slots (usizeConst n) =
      match evalConstLit usizeTy (.scalar (BitVec.ofNat 128 n)) with
      | Except.ok v => Except.ok (usizeTy, some v, slots)
      | Except.error k => Except.error k := rfl

private theorem evalArrSliceTypedOperand_err (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (expectedTy : MirTy) (opnd : Operand) (k : FaultKind)
    (h : evalArrSliceBaseOperandToSlot decls slots opnd = Except.error k) :
    evalArrSliceTypedOperand decls slots expectedTy opnd = Except.error k := by
  change (match evalArrSliceBaseOperandToSlot decls slots opnd with
    | Except.error k' => Except.error k'
    | Except.ok (srcTy, optVal, slots') =>
      if (!srcTy.beq expectedTy) = true then Except.error FaultKind.unsupported
      else match optVal with
        | some v => if checkVal v expectedTy = true then Except.ok (v, slots') else Except.error FaultKind.unsupported
        | none => Except.error FaultKind.undefined) = _
  rw [h]

private theorem evalArrSliceTypedOperand_ok (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (expectedTy : MirTy) (opnd : Operand)
    (srcTy : MirTy) (optVal : Option Val) (slots' : List ArrSliceSlot)
    (h : evalArrSliceBaseOperandToSlot decls slots opnd = Except.ok (srcTy, optVal, slots')) :
    evalArrSliceTypedOperand decls slots expectedTy opnd =
      if (!srcTy.beq expectedTy) = true then Except.error FaultKind.unsupported
      else match optVal with
        | some v => if checkVal v expectedTy = true then Except.ok (v, slots') else Except.error FaultKind.unsupported
        | none => Except.error FaultKind.undefined := by
  change (match evalArrSliceBaseOperandToSlot decls slots opnd with
    | Except.error k' => Except.error k'
    | Except.ok (srcTy, optVal, slots') =>
      if (!srcTy.beq expectedTy) = true then Except.error FaultKind.unsupported
      else match optVal with
        | some v => if checkVal v expectedTy = true then Except.ok (v, slots') else Except.error FaultKind.unsupported
        | none => Except.error FaultKind.undefined) = _
  rw [h]

private theorem evalUsizeOperand_eq (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (opnd : Operand) :
    evalUsizeOperand decls slots opnd =
      match evalArrSliceTypedOperand decls slots usizeTy opnd with
      | Except.error k' => Except.error k'
      | Except.ok (Val.scalar sv, slots') => Except.ok (sv.bits.toNat, slots')
      | Except.ok (_, _) => Except.error FaultKind.unsupported := rfl

private theorem evalUsizeOperand_err (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (opnd : Operand) (k : FaultKind)
    (h : evalArrSliceTypedOperand decls slots usizeTy opnd = Except.error k) :
    evalUsizeOperand decls slots opnd = Except.error k := by
  rw [evalUsizeOperand_eq, h]

private noncomputable def evalUsizeOfVal (v : Val) (slots' : List ArrSliceSlot) :
    Except FaultKind (Nat × List ArrSliceSlot) :=
  match v with
  | .scalar sv => Except.ok (sv.bits.toNat, slots')
  | _ => Except.error FaultKind.unsupported

private theorem evalUsizeOperand_ok (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (opnd : Operand) (v : Val) (slots' : List ArrSliceSlot)
    (h : evalArrSliceTypedOperand decls slots usizeTy opnd = Except.ok (v, slots')) :
    evalUsizeOperand decls slots opnd = evalUsizeOfVal v slots' := by
  rw [evalUsizeOperand_eq, h]
  cases v <;> rfl

private theorem evalArrSlicePrimitiveOperand_err (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (opnd : Operand) (k : FaultKind)
    (h : evalArrSliceBaseOperandToSlot decls slots opnd = Except.error k) :
    evalArrSlicePrimitiveOperand decls slots opnd = Except.error k := by
  change (match evalArrSliceBaseOperandToSlot decls slots opnd with
    | Except.error k' => Except.error k'
    | Except.ok (ty, optVal, slots') =>
      if (!isPrimitiveReadableTy ty) = true then Except.error FaultKind.unsupported
      else match optVal with
        | some v => Except.ok (v, slots')
        | none => Except.error FaultKind.undefined) = _
  rw [h]

private theorem evalArrSlicePrimitiveOperand_ok (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (opnd : Operand)
    (ty : MirTy) (optVal : Option Val) (slots' : List ArrSliceSlot)
    (h : evalArrSliceBaseOperandToSlot decls slots opnd = Except.ok (ty, optVal, slots')) :
    evalArrSlicePrimitiveOperand decls slots opnd =
      if (!isPrimitiveReadableTy ty) = true then Except.error FaultKind.unsupported
      else match optVal with
        | some v => Except.ok (v, slots')
        | none => Except.error FaultKind.undefined := by
  change (match evalArrSliceBaseOperandToSlot decls slots opnd with
    | Except.error k' => Except.error k'
    | Except.ok (ty, optVal, slots') =>
      if (!isPrimitiveReadableTy ty) = true then Except.error FaultKind.unsupported
      else match optVal with
        | some v => Except.ok (v, slots')
        | none => Except.error FaultKind.undefined) = _
  rw [h]

private theorem evalArrSliceBaseRvalue_use (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (dstTy : MirTy) (opnd : Operand) :
    evalArrSliceBaseRvalue decls slots dstTy (.use opnd) =
      match evalArrSliceBaseOperandToSlot decls slots opnd with
      | Except.error k => Except.error k
      | Except.ok (srcTy, optVal, slots₁) =>
        if (!srcTy.beq dstTy) = true then Except.error FaultKind.unsupported
        else match optVal with
          | some v => Except.ok (v, slots₁)
          | none => Except.error FaultKind.undefined := rfl

private theorem evalArrSliceBaseRvalue_use_err (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (dstTy : MirTy) (opnd : Operand) (k : FaultKind)
    (h : evalArrSliceBaseOperandToSlot decls slots opnd = Except.error k) :
    evalArrSliceBaseRvalue decls slots dstTy (.use opnd) = Except.error k := by
  rw [evalArrSliceBaseRvalue_use, h]

private theorem evalArrSliceBaseRvalue_use_ok (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (dstTy : MirTy) (opnd : Operand)
    (srcTy : MirTy) (optVal : Option Val) (slots₁ : List ArrSliceSlot)
    (h : evalArrSliceBaseOperandToSlot decls slots opnd = Except.ok (srcTy, optVal, slots₁)) :
    evalArrSliceBaseRvalue decls slots dstTy (.use opnd) =
      if (!srcTy.beq dstTy) = true then Except.error FaultKind.unsupported
      else match optVal with
        | some v => Except.ok (v, slots₁)
        | none => Except.error FaultKind.undefined := by
  rw [evalArrSliceBaseRvalue_use, h]

private theorem evalArrSliceBaseRvalue_unaryOp (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (dstTy : MirTy) (op : UnOp) (opnd : Operand) :
    evalArrSliceBaseRvalue decls slots dstTy (.unaryOp op opnd) =
      match evalArrSlicePrimitiveOperand decls slots opnd with
      | Except.error k => Except.error k
      | Except.ok (v, slots₁) =>
        match evalUnOp op v with
        | Except.error k => Except.error k
        | Except.ok res => Except.ok (res, slots₁) := rfl

private theorem evalArrSliceBaseRvalue_binaryOp (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (dstTy : MirTy) (op : BinOp) (lhs rhs : Operand) :
    evalArrSliceBaseRvalue decls slots dstTy (.binaryOp op lhs rhs) =
      match evalArrSlicePrimitiveOperand decls slots lhs with
      | Except.error k => Except.error k
      | Except.ok (lVal, slots₁) =>
        match evalArrSlicePrimitiveOperand decls slots₁ rhs with
        | Except.error k => Except.error k
        | Except.ok (rVal, slots₂) =>
          match evalBinOp op lVal rVal with
          | Except.error k => Except.error k
          | Except.ok res => Except.ok (res, slots₂) := rfl

private theorem writeArrSliceBasePlace_eq (slots : List ArrSliceSlot)
    (dstLocalId : LocalId) (dstTy : MirTy) (val : Val) :
    writeArrSliceBasePlace slots dstLocalId dstTy val =
      if (!checkVal val dstTy) = true then Except.error FaultKind.unsupported
      else match Trusted.MirSemantics.getElem? slots dstLocalId with
        | none => Except.error FaultKind.unsupported
        | some (.baseSlot .dead) => Except.error FaultKind.undefined
        | some (.baseSlot (.live _)) =>
          match setElem? slots dstLocalId (.baseSlot (.live (some val))) with
          | some slots' => Except.ok slots'
          | none => Except.error FaultKind.unsupported
        | some _ => Except.error FaultKind.unsupported := rfl

private theorem evalArrSliceBaseOperandToSlot_prefix
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁ slots₂)
    (hLen₂ : pack.bodySrc.locals.length ≤ slots₂.length)
    {op : Operand} (hOp : operandUsesOnlyBase pack.bodySrc.locals op = true) :
    (∀ k, evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op = .error k →
      evalArrSliceBaseOperandToSlot pack.bodyTgt.locals slots₂ op = .error k) ∧
    (∀ ty optVal slots₁',
      evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op = .ok (ty, optVal, slots₁') →
        ∃ slots₂',
          evalArrSliceBaseOperandToSlot pack.bodyTgt.locals slots₂ op = .ok (ty, optVal, slots₂') ∧
          PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' ∧
          slots₂'.length = slots₂.length ∧
          ∀ j, pack.bodySrc.locals.length ≤ j →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) := by
  cases op with
  | constant c =>
    rw [evalArrSliceBaseOperandToSlot_const, evalArrSliceBaseOperandToSlot_const]
    cases evalConstLit c.ty c.lit with
    | error err =>
      constructor
      · intro k hk; exact hk
      · intro ty optVal s1' hOk; cases hOk
    | ok v =>
      constructor
      · intro k hk; cases hk
      · intro ty optVal s1' hOk
        injection hOk with hT
        injection hT with hTy hT2
        injection hT2 with hOpt hSl
        rw [← hTy, ← hOpt, ← hSl]
        exact ⟨slots₂, rfl, hPre, rfl, fun _ _ => rfl⟩
  | copy place =>
    change (place.projection.isEmpty &&
        match Trusted.MirSemantics.getElem? pack.bodySrc.locals place.localId with
        | some (.base _) => true
        | _ => false) = true at hOp
    have hAnd := (bool_and_eq_true _ _).mp hOp
    have hNegProj : (!place.projection.isEmpty) = false := by rw [hAnd.1]; rfl
    cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals place.localId with
    | none => rw [hDecl] at hAnd; cases hAnd.2
    | some d =>
      rw [hDecl] at hAnd
      cases d with
      | array _ _ => cases hAnd.2
      | sliceView _ => cases hAnd.2
      | base ty =>
        have hInfo := operandUsesOnlyBase_base_local pack.hLoop hDecl
        have hTgtDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals place.localId = some (.base ty) := by
          rw [getElem?_bodyTgt_nonSlice pack hInfo.1 hInfo.2, hDecl]
        have hSlotEq : Trusted.MirSemantics.getElem? slots₂ place.localId =
            Trusted.MirSemantics.getElem? slots₁ place.localId := hPre.2 place.localId hInfo.1 hInfo.2
        rw [evalArrSliceBaseOperandToSlot_copy, evalArrSliceBaseOperandToSlot_copy]
        rw [hNegProj, hDecl, hTgtDecl, hSlotEq]
        cases hS1 : Trusted.MirSemantics.getElem? slots₁ place.localId with
        | none =>
          constructor
          · intro k hk; exact hk
          · intro rTy rOpt rSl hOk; cases hOk
        | some sl =>
          cases sl with
          | arrDead =>
            constructor
            · intro k hk; exact hk
            · intro rTy rOpt rSl hOk; cases hOk
          | liveArray _ =>
            constructor
            · intro k hk; exact hk
            · intro rTy rOpt rSl hOk; cases hOk
          | sliceDead =>
            constructor
            · intro k hk; exact hk
            · intro rTy rOpt rSl hOk; cases hOk
          | liveSlice _ =>
            constructor
            · intro k hk; exact hk
            · intro rTy rOpt rSl hOk; cases hOk
          | baseSlot bsl =>
            cases bsl with
            | dead =>
              constructor
              · intro k hk; exact hk
              · intro rTy rOpt rSl hOk; cases hOk
            | live ov =>
              constructor
              · intro k hk; cases hk
              · intro rTy rOpt rSl hOk
                injection hOk with hP
                injection hP with hTyEq hP2
                injection hP2 with hOvEq hSlEq
                rw [← hTyEq, ← hOvEq, ← hSlEq]
                exact ⟨slots₂, rfl, hPre, rfl, fun _ _ => rfl⟩
  | move place =>
    change (place.projection.isEmpty &&
        match Trusted.MirSemantics.getElem? pack.bodySrc.locals place.localId with
        | some (.base _) => true
        | _ => false) = true at hOp
    have hAnd := (bool_and_eq_true _ _).mp hOp
    have hNegProj : (!place.projection.isEmpty) = false := by rw [hAnd.1]; rfl
    cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals place.localId with
    | none => rw [hDecl] at hAnd; cases hAnd.2
    | some d =>
      rw [hDecl] at hAnd
      cases d with
      | array _ _ => cases hAnd.2
      | sliceView _ => cases hAnd.2
      | base ty =>
        have hInfo := operandUsesOnlyBase_base_local pack.hLoop hDecl
        have hTgtDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals place.localId = some (.base ty) := by
          rw [getElem?_bodyTgt_nonSlice pack hInfo.1 hInfo.2, hDecl]
        have hSlotEq : Trusted.MirSemantics.getElem? slots₂ place.localId =
            Trusted.MirSemantics.getElem? slots₁ place.localId := hPre.2 place.localId hInfo.1 hInfo.2
        have hLt1 : place.localId < slots₁.length := by rw [hPre.1]; exact hInfo.1
        have hLt2 : place.localId < slots₂.length := Nat.lt_of_lt_of_le hInfo.1 hLen₂
        have hEx1 := lt_setElem?_some slots₁ place.localId (.baseSlot (liveUninitSlot ty)) hLt1
        have hEx2 := lt_setElem?_some slots₂ place.localId (.baseSlot (liveUninitSlot ty)) hLt2
        cases hEx1 with | intro slots₁Next hSet₁ =>
        cases hEx2 with | intro slots₂Next hSet₂ =>
        rw [evalArrSliceBaseOperandToSlot_move, evalArrSliceBaseOperandToSlot_move]
        rw [hNegProj, hDecl, hTgtDecl, hSlotEq]
        cases hS1 : Trusted.MirSemantics.getElem? slots₁ place.localId with
        | none =>
          constructor
          · intro k hk; exact hk
          · intro rTy rOpt rSl hOk; cases hOk
        | some sl =>
          cases sl with
          | arrDead =>
            constructor
            · intro k hk; exact hk
            · intro rTy rOpt rSl hOk; cases hOk
          | liveArray _ =>
            constructor
            · intro k hk; exact hk
            · intro rTy rOpt rSl hOk; cases hOk
          | sliceDead =>
            constructor
            · intro k hk; exact hk
            · intro rTy rOpt rSl hOk; cases hOk
          | liveSlice _ =>
            constructor
            · intro k hk; exact hk
            · intro rTy rOpt rSl hOk; cases hOk
          | baseSlot bsl =>
            cases bsl with
            | dead =>
              constructor
              · intro k hk; exact hk
              · intro rTy rOpt rSl hOk; cases hOk
            | live ov =>
              have hStepS1 : (if false = true then Except.error FaultKind.unsupported
                  else match some (ArrSliceLocalDecl.base ty), some (ArrSliceSlot.baseSlot (LocalSlot.live ov)) with
                    | some (.base ty'), some (.baseSlot (.live optVal)) =>
                      match setElem? slots₁ place.localId (.baseSlot (liveUninitSlot ty')) with
                      | some slots' => Except.ok (ty', optVal, slots')
                      | none => Except.error FaultKind.unsupported
                    | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
                    | _, _ => Except.error FaultKind.unsupported) =
                  Except.ok (ty, ov, slots₁Next) := by
                change (match setElem? slots₁ place.localId (.baseSlot (liveUninitSlot ty)) with
                  | some slots' => Except.ok (ty, ov, slots')
                  | none => Except.error FaultKind.unsupported) = _
                rw [hSet₁]
              have hStepS2 : (if false = true then Except.error FaultKind.unsupported
                  else match some (ArrSliceLocalDecl.base ty), some (ArrSliceSlot.baseSlot (LocalSlot.live ov)) with
                    | some (.base ty'), some (.baseSlot (.live optVal)) =>
                      match setElem? slots₂ place.localId (.baseSlot (liveUninitSlot ty')) with
                      | some slots' => Except.ok (ty', optVal, slots')
                      | none => Except.error FaultKind.unsupported
                    | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
                    | _, _ => Except.error FaultKind.unsupported) =
                  Except.ok (ty, ov, slots₂Next) := by
                change (match setElem? slots₂ place.localId (.baseSlot (liveUninitSlot ty)) with
                  | some slots' => Except.ok (ty, ov, slots')
                  | none => Except.error FaultKind.unsupported) = _
                rw [hSet₂]
              rw [hStepS1, hStepS2]
              constructor
              · intro k hk; cases hk
              · intro rTy rOpt rSl hOk
                injection hOk with hP
                injection hP with hTyEq hP2
                injection hP2 with hOvEq hSlEq
                have hPM := prefixSlotsMatch_set_base hPre hInfo.1 (.baseSlot (liveUninitSlot ty)) hSet₁ hSet₂
                rw [← hTyEq, ← hOvEq, ← hSlEq]
                exact ⟨slots₂Next, rfl, hPM.1, hPM.2.1, hPM.2.2⟩

private theorem evalArrSliceTypedOperand_prefix
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁ slots₂)
    (hLen₂ : pack.bodySrc.locals.length ≤ slots₂.length)
    (expectedTy : MirTy) {op : Operand} (hOp : operandUsesOnlyBase pack.bodySrc.locals op = true) :
    (∀ k, evalArrSliceTypedOperand pack.bodySrc.locals slots₁ expectedTy op = .error k →
      evalArrSliceTypedOperand pack.bodyTgt.locals slots₂ expectedTy op = .error k) ∧
    (∀ v slots₁',
      evalArrSliceTypedOperand pack.bodySrc.locals slots₁ expectedTy op = .ok (v, slots₁') →
        ∃ slots₂',
          evalArrSliceTypedOperand pack.bodyTgt.locals slots₂ expectedTy op = .ok (v, slots₂') ∧
          PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' ∧
          slots₂'.length = slots₂.length ∧
          ∀ j, pack.bodySrc.locals.length ≤ j →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) := by
  have hBase := evalArrSliceBaseOperandToSlot_prefix pack hPre hLen₂ hOp
  cases hRes1 : evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op with
  | error err =>
    have hRes2 := hBase.1 err hRes1
    constructor
    · intro k hk
      rw [evalArrSliceTypedOperand_err _ _ _ _ _ hRes1] at hk
      rw [evalArrSliceTypedOperand_err _ _ _ _ _ hRes2]
      exact hk
    · intro v s1' hOk
      rw [evalArrSliceTypedOperand_err _ _ _ _ _ hRes1] at hOk
      cases hOk
  | ok p =>
    cases p with | mk srcTy p2 =>
    cases p2 with | mk optVal slots₁' =>
    have hOk2 := hBase.2 srcTy optVal slots₁' hRes1
    cases hOk2 with | intro slots₂' hS2 =>
    have hT1 := evalArrSliceTypedOperand_ok pack.bodySrc.locals slots₁ expectedTy op srcTy optVal slots₁' hRes1
    have hT2 := evalArrSliceTypedOperand_ok pack.bodyTgt.locals slots₂ expectedTy op srcTy optVal slots₂' hS2.1
    rw [hT1, hT2]
    cases hNeq : (!srcTy.beq expectedTy) with
    | true =>
      dsimp
      constructor
      · intro k hk; exact hk
      · intro v s1' hOk; cases hOk
    | false =>
      dsimp
      cases optVal with
      | none =>
        constructor
        · intro k hk; exact hk
        · intro v s1' hOk; cases hOk
      | some v0 =>
        dsimp
        cases hChk : checkVal v0 expectedTy with
        | false =>
          dsimp
          constructor
          · intro k hk; exact hk
          · intro v s1' hOk; cases hOk
        | true =>
          dsimp
          constructor
          · intro k hk; cases hk
          · intro v s1' hOk
            injection hOk with hPair
            injection hPair with hv hsl
            rw [← hv, ← hsl]
            exact ⟨slots₂', rfl, hS2.2.1, hS2.2.2.1, hS2.2.2.2⟩

private theorem evalUsizeOperand_prefix
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁ slots₂)
    (hLen₂ : pack.bodySrc.locals.length ≤ slots₂.length)
    {op : Operand} (hOp : operandUsesOnlyBase pack.bodySrc.locals op = true) :
    (∀ k, evalUsizeOperand pack.bodySrc.locals slots₁ op = .error k →
      evalUsizeOperand pack.bodyTgt.locals slots₂ op = .error k) ∧
    (∀ n slots₁',
      evalUsizeOperand pack.bodySrc.locals slots₁ op = .ok (n, slots₁') →
        ∃ slots₂',
          evalUsizeOperand pack.bodyTgt.locals slots₂ op = .ok (n, slots₂') ∧
          PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' ∧
          slots₂'.length = slots₂.length ∧
          ∀ j, pack.bodySrc.locals.length ≤ j →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) := by
  have hTyped := evalArrSliceTypedOperand_prefix pack hPre hLen₂ usizeTy hOp
  cases hRes1 : evalArrSliceTypedOperand pack.bodySrc.locals slots₁ usizeTy op with
  | error err =>
    have hRes2 := hTyped.1 err hRes1
    constructor
    · intro k hk
      rw [evalUsizeOperand_err _ _ _ _ hRes1] at hk
      rw [evalUsizeOperand_err _ _ _ _ hRes2]
      exact hk
    · intro n s1' hOk
      rw [evalUsizeOperand_err _ _ _ _ hRes1] at hOk
      cases hOk
  | ok p =>
    cases p with | mk v slots₁' =>
    have hOk2 := hTyped.2 v slots₁' hRes1
    cases hOk2 with | intro slots₂' hS2 =>
    have hU1 := evalUsizeOperand_ok pack.bodySrc.locals slots₁ op v slots₁' hRes1
    have hU2 := evalUsizeOperand_ok pack.bodyTgt.locals slots₂ op v slots₂' hS2.1
    rw [hU1, hU2]
    cases v with
    | scalar sv =>
      dsimp [evalUsizeOfVal]
      constructor
      · intro k hk; cases hk
      · intro n s1' hOk
        injection hOk with hPair
        injection hPair with hn hsl
        rw [← hn, ← hsl]
        exact ⟨slots₂', rfl, hS2.2.1, hS2.2.2.1, hS2.2.2.2⟩
    | bool _ => dsimp [evalUsizeOfVal]; constructor <;> (intro a; first | (intro h; exact h) | (intro _ h; cases h))
    | unit => dsimp [evalUsizeOfVal]; constructor <;> (intro a; first | (intro h; exact h) | (intro _ h; cases h))
    | enumVal _ _ => dsimp [evalUsizeOfVal]; constructor <;> (intro a; first | (intro h; exact h) | (intro _ h; cases h))
    | ptr _ => dsimp [evalUsizeOfVal]; constructor <;> (intro a; first | (intro h; exact h) | (intro _ h; cases h))
    | tuple _ => dsimp [evalUsizeOfVal]; constructor <;> (intro a; first | (intro h; exact h) | (intro _ h; cases h))
    | bytes _ => dsimp [evalUsizeOfVal]; constructor <;> (intro a; first | (intro h; exact h) | (intro _ h; cases h))

private theorem evalArrSlicePrimitiveOperand_prefix
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁ slots₂)
    (hLen₂ : pack.bodySrc.locals.length ≤ slots₂.length)
    {op : Operand} (hOp : operandUsesOnlyBase pack.bodySrc.locals op = true) :
    (∀ k, evalArrSlicePrimitiveOperand pack.bodySrc.locals slots₁ op = .error k →
      evalArrSlicePrimitiveOperand pack.bodyTgt.locals slots₂ op = .error k) ∧
    (∀ v slots₁',
      evalArrSlicePrimitiveOperand pack.bodySrc.locals slots₁ op = .ok (v, slots₁') →
        ∃ slots₂',
          evalArrSlicePrimitiveOperand pack.bodyTgt.locals slots₂ op = .ok (v, slots₂') ∧
          PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' ∧
          slots₂'.length = slots₂.length ∧
          ∀ j, pack.bodySrc.locals.length ≤ j →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) := by
  have hBase := evalArrSliceBaseOperandToSlot_prefix pack hPre hLen₂ hOp
  cases hRes1 : evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op with
  | error err =>
    have hRes2 := hBase.1 err hRes1
    constructor
    · intro k hk
      rw [evalArrSlicePrimitiveOperand_err _ _ _ _ hRes1] at hk
      rw [evalArrSlicePrimitiveOperand_err _ _ _ _ hRes2]
      exact hk
    · intro v s1' hOk
      rw [evalArrSlicePrimitiveOperand_err _ _ _ _ hRes1] at hOk
      cases hOk
  | ok p =>
    cases p with | mk ty p2 =>
    cases p2 with | mk optVal slots₁' =>
    have hOk2 := hBase.2 ty optVal slots₁' hRes1
    cases hOk2 with | intro slots₂' hS2 =>
    have hP1 := evalArrSlicePrimitiveOperand_ok pack.bodySrc.locals slots₁ op ty optVal slots₁' hRes1
    have hP2 := evalArrSlicePrimitiveOperand_ok pack.bodyTgt.locals slots₂ op ty optVal slots₂' hS2.1
    rw [hP1, hP2]
    cases hPrim : (!isPrimitiveReadableTy ty) with
    | true =>
      constructor
      · intro k hk; exact hk
      · intro v s1' hOk; cases hOk
    | false =>
      cases optVal with
      | none =>
        constructor
        · intro k hk; exact hk
        · intro v s1' hOk; cases hOk
      | some v0 =>
        constructor
        · intro k hk; cases hk
        · intro v s1' hOk
          injection hOk with hPair
          injection hPair with hv hsl
          rw [← hv, ← hsl]
          exact ⟨slots₂', rfl, hS2.2.1, hS2.2.2.1, hS2.2.2.2⟩

private theorem evalArrSliceTypedOps_cons (decls : List ArrSliceLocalDecl) (ty : MirTy)
    (slots : List ArrSliceSlot) (op : Operand) (rest : List Operand) :
    evalArrSliceTypedOps decls ty slots (op :: rest) =
      match evalArrSliceTypedOperand decls slots ty op with
      | .error k => .error k
      | .ok (v, slots₁) =>
        match evalArrSliceTypedOps decls ty slots₁ rest with
        | .error k => .error k
        | .ok (vs, slots₂) => .ok (v :: vs, slots₂) := by
  rfl

private theorem evalArrSliceTypedOps_prefix
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (expectedTy : MirTy) (ops : List Operand)
    (hOps : ops.all (operandUsesOnlyBase pack.bodySrc.locals) = true)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁ slots₂)
    (hLen₂ : pack.bodySrc.locals.length ≤ slots₂.length) :
    (∀ k, evalArrSliceTypedOps pack.bodySrc.locals expectedTy slots₁ ops = .error k →
      evalArrSliceTypedOps pack.bodyTgt.locals expectedTy slots₂ ops = .error k) ∧
    (∀ vs slots₁',
      evalArrSliceTypedOps pack.bodySrc.locals expectedTy slots₁ ops = .ok (vs, slots₁') →
        ∃ slots₂',
          evalArrSliceTypedOps pack.bodyTgt.locals expectedTy slots₂ ops = .ok (vs, slots₂') ∧
          PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' ∧
          slots₂'.length = slots₂.length ∧
          ∀ j, pack.bodySrc.locals.length ≤ j →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) := by
  induction ops generalizing slots₁ slots₂ with
  | nil =>
    constructor
    · intro k hk; cases hk
    · intro vs s1' hOk
      injection hOk with hP
      injection hP with hvs hsl
      rw [← hvs, ← hsl]
      exact ⟨slots₂, rfl, hPre, rfl, fun _ _ => rfl⟩
  | cons op rest ih =>
    have hAnd : operandUsesOnlyBase pack.bodySrc.locals op = true ∧
        rest.all (operandUsesOnlyBase pack.bodySrc.locals) = true :=
      (bool_and_eq_true _ _).mp hOps
    have hOp := evalArrSliceTypedOperand_prefix pack hPre hLen₂ expectedTy hAnd.1
    cases hRes1 : evalArrSliceTypedOperand pack.bodySrc.locals slots₁ expectedTy op with
    | error err =>
      have hRes2 := hOp.1 err hRes1
      constructor
      · intro k hk
        rw [evalArrSliceTypedOps_cons, hRes1] at hk
        rw [evalArrSliceTypedOps_cons, hRes2]
        exact hk
      · intro vs s1' hOk
        rw [evalArrSliceTypedOps_cons, hRes1] at hOk
        cases hOk
    | ok p =>
      cases p with | mk v slots₁Mid =>
      have hOkMid := hOp.2 v slots₁Mid hRes1
      cases hOkMid with | intro slots₂Mid hS2Mid =>
      have hLenMid : pack.bodySrc.locals.length ≤ slots₂Mid.length := by
        rw [hS2Mid.2.2.1]; exact hLen₂
      have hIH := ih hAnd.2 hS2Mid.2.1 hLenMid
      cases hTail1 : evalArrSliceTypedOps pack.bodySrc.locals expectedTy slots₁Mid rest with
      | error err =>
        have hTail2 := hIH.1 err hTail1
        constructor
        · intro k hk
          rw [evalArrSliceTypedOps_cons, hRes1] at hk
          dsimp at hk
          rw [hTail1] at hk
          rw [evalArrSliceTypedOps_cons, hS2Mid.1]
          dsimp
          rw [hTail2]
          exact hk
        · intro vs s1' hOk
          rw [evalArrSliceTypedOps_cons, hRes1] at hOk
          dsimp at hOk
          rw [hTail1] at hOk
          dsimp at hOk
          cases hOk
      | ok q =>
        cases q with | mk vs slots₁End =>
        have hOkEnd := hIH.2 vs slots₁End hTail1
        cases hOkEnd with | intro slots₂End hS2End =>
        constructor
        · intro k hk
          rw [evalArrSliceTypedOps_cons, hRes1] at hk
          dsimp at hk
          rw [hTail1] at hk
          dsimp at hk
          cases hk
        · intro vs' s1' hOk
          rw [evalArrSliceTypedOps_cons, hRes1] at hOk
          dsimp at hOk
          rw [hTail1] at hOk
          dsimp at hOk
          injection hOk with hP
          injection hP with hvs hsl
          rw [← hvs, ← hsl]
          refine ⟨slots₂End, ?_, hS2End.2.1, ?_, ?_⟩
          · rw [evalArrSliceTypedOps_cons, hS2Mid.1]
            dsimp
            rw [hS2End.1]
          · rw [hS2End.2.2.1, hS2Mid.2.2.1]
          · intro j hj
            rw [hS2End.2.2.2 j hj, hS2Mid.2.2.2 j hj]

private noncomputable def evalDiscrAtSlot (decl? : Option ArrSliceLocalDecl)
    (slot? : Option ArrSliceSlot) : Except FaultKind Val :=
  match decl?, slot? with
  | some (.base (.enum ety)), some (.baseSlot slot) =>
    if (!enumAdmitted ety) = true then Except.error FaultKind.unsupported
    else match ety.tagRepr, slot with
      | _, .dead => Except.error FaultKind.undefined
      | .zeroSized, .live none =>
        match Trusted.MirSemantics.getElem? ety.discriminants 0 with
        | some disc => Except.ok (.scalar (ScalarVal.mk ety.discrWidth ety.discrSigned
            (truncateBits ety.discrWidth (BitVec.ofNat 128 disc))))
        | none => Except.error FaultKind.unsupported
      | .zeroSized, .live (some (.enumVal ety' v)) =>
        if (ety.beq ety' && v.beq 0) = true then
          match Trusted.MirSemantics.getElem? ety.discriminants 0 with
          | some disc => Except.ok (.scalar (ScalarVal.mk ety.discrWidth ety.discrSigned
              (truncateBits ety.discrWidth (BitVec.ofNat 128 disc))))
          | none => Except.error FaultKind.unsupported
        else Except.error FaultKind.unsupported
      | .zeroSized, .live (some _) => Except.error FaultKind.unsupported
      | .scalar _ _, .live none => Except.error FaultKind.undefined
      | .scalar _ _, .live (some (.enumVal ety' v)) =>
        if (ety.beq ety' && v.blt ety.discriminants.length) = true then
          match Trusted.MirSemantics.getElem? ety.discriminants v with
          | some disc => Except.ok (.scalar (ScalarVal.mk ety.discrWidth ety.discrSigned
              (truncateBits ety.discrWidth (BitVec.ofNat 128 disc))))
          | none => Except.error FaultKind.unsupported
        else Except.error FaultKind.unsupported
      | .scalar _ _, .live (some _) => Except.error FaultKind.unsupported
  | _, _ => Except.error FaultKind.unsupported

private theorem evalArrSliceBaseRvalue_discriminant_eq
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (dstTy : MirTy) (place : Place)
    (hProj : place.projection.isEmpty = true) :
    evalArrSliceBaseRvalue decls slots dstTy (.discriminant place) =
      match evalDiscrAtSlot (Trusted.MirSemantics.getElem? decls place.localId)
          (Trusted.MirSemantics.getElem? slots place.localId) with
      | Except.error k => Except.error k
      | Except.ok v => Except.ok (v, slots) := by
  have hNeg : (!place.projection.isEmpty) = false := by rw [hProj]; rfl
  change (if (!place.projection.isEmpty) = true then Except.error FaultKind.unsupported
    else match Trusted.MirSemantics.getElem? decls place.localId,
        Trusted.MirSemantics.getElem? slots place.localId with
      | some (.base (.enum ety)), some (.baseSlot slot) =>
        if (!enumAdmitted ety) = true then Except.error FaultKind.unsupported
        else match ety.tagRepr, slot with
          | _, .dead => Except.error FaultKind.undefined
          | .zeroSized, .live none =>
            match Trusted.MirSemantics.getElem? ety.discriminants 0 with
            | some disc => Except.ok (Val.scalar (ScalarVal.mk ety.discrWidth ety.discrSigned
                (truncateBits ety.discrWidth (BitVec.ofNat 128 disc))), slots)
            | none => Except.error FaultKind.unsupported
          | .zeroSized, .live (some (.enumVal ety' v)) =>
            if (ety.beq ety' && v.beq 0) = true then
              match Trusted.MirSemantics.getElem? ety.discriminants 0 with
              | some disc => Except.ok (Val.scalar (ScalarVal.mk ety.discrWidth ety.discrSigned
                  (truncateBits ety.discrWidth (BitVec.ofNat 128 disc))), slots)
              | none => Except.error FaultKind.unsupported
            else Except.error FaultKind.unsupported
          | .zeroSized, .live (some _) => Except.error FaultKind.unsupported
          | .scalar _ _, .live none => Except.error FaultKind.undefined
          | .scalar _ _, .live (some (.enumVal ety' v)) =>
            if (ety.beq ety' && v.blt ety.discriminants.length) = true then
              match Trusted.MirSemantics.getElem? ety.discriminants v with
              | some disc => Except.ok (Val.scalar (ScalarVal.mk ety.discrWidth ety.discrSigned
                  (truncateBits ety.discrWidth (BitVec.ofNat 128 disc))), slots)
              | none => Except.error FaultKind.unsupported
            else Except.error FaultKind.unsupported
          | .scalar _ _, .live (some _) => Except.error FaultKind.unsupported
      | _, _ => Except.error FaultKind.unsupported) = _
  rw [hNeg]
  change _ = match evalDiscrAtSlot (Trusted.MirSemantics.getElem? decls place.localId)
      (Trusted.MirSemantics.getElem? slots place.localId) with
    | Except.error k => Except.error k
    | Except.ok v => Except.ok (v, slots)
  cases Trusted.MirSemantics.getElem? decls place.localId with
  | none => rfl
  | some d =>
    cases d with
    | array _ _ => rfl
    | sliceView _ => rfl
    | base ty =>
      cases ty with
      | bool => rfl
      | int _ _ => rfl
      | unit => rfl
      | never => rfl
      | tuple _ => rfl
      | ref _ _ => rfl
      | rawPtr _ _ => rfl
      | unsupported => rfl
      | enum ety =>
        cases Trusted.MirSemantics.getElem? slots place.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | arrDead => rfl
          | liveArray _ => rfl
          | sliceDead => rfl
          | liveSlice _ => rfl
          | baseSlot bsl =>
            dsimp
            dsimp [evalDiscrAtSlot]
            cases (!enumAdmitted ety) with
            | true => rfl
            | false =>
              dsimp
              cases ety.tagRepr with
              | zeroSized =>
                cases bsl with
                | dead => rfl
                | live ov =>
                  cases ov with
                  | none =>
                    cases Trusted.MirSemantics.getElem? ety.discriminants 0 <;> rfl
                  | some v0 =>
                    cases v0 with
                    | scalar _ => rfl
                    | ptr _ => rfl
                    | bool _ => rfl
                    | unit => rfl
                    | tuple _ => rfl
                    | bytes _ => rfl
                    | enumVal ety' idx' =>
                      dsimp
                      cases (ety.beq ety' && idx'.beq 0) with
                      | false => rfl
                      | true =>
                        dsimp
                        cases Trusted.MirSemantics.getElem? ety.discriminants 0 <;> rfl
              | scalar _ _ =>
                cases bsl with
                | dead => rfl
                | live ov =>
                  cases ov with
                  | none => rfl
                  | some v0 =>
                    cases v0 with
                    | scalar _ => rfl
                    | ptr _ => rfl
                    | bool _ => rfl
                    | unit => rfl
                    | tuple _ => rfl
                    | bytes _ => rfl
                    | enumVal ety' idx' =>
                      dsimp
                      cases (ety.beq ety' && idx'.blt ety.discriminants.length) with
                      | false => rfl
                      | true =>
                        dsimp
                        cases Trusted.MirSemantics.getElem? ety.discriminants idx' <;> rfl

private theorem evalArrSliceBaseRvalue_prefix
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁ slots₂)
    (hLen₂ : pack.bodySrc.locals.length ≤ slots₂.length)
    (dstTy : MirTy) {rval : Rvalue} (hRv : rvalueUsesOnlyBase pack.bodySrc.locals rval = true) :
    (∀ k, evalArrSliceBaseRvalue pack.bodySrc.locals slots₁ dstTy rval = .error k →
      evalArrSliceBaseRvalue pack.bodyTgt.locals slots₂ dstTy rval = .error k) ∧
    (∀ v slots₁',
      evalArrSliceBaseRvalue pack.bodySrc.locals slots₁ dstTy rval = .ok (v, slots₁') →
        ∃ slots₂',
          evalArrSliceBaseRvalue pack.bodyTgt.locals slots₂ dstTy rval = .ok (v, slots₂') ∧
          PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁' slots₂' ∧
          slots₂'.length = slots₂.length ∧
          ∀ j, pack.bodySrc.locals.length ≤ j →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) := by
  cases rval with
  | use op =>
    change operandUsesOnlyBase pack.bodySrc.locals op = true at hRv
    have hBase := evalArrSliceBaseOperandToSlot_prefix pack hPre hLen₂ hRv
    cases hRes1 : evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op with
    | error err =>
      have hRes2 := hBase.1 err hRes1
      constructor
      · intro k hk
        rw [evalArrSliceBaseRvalue_use_err _ _ _ _ _ hRes1] at hk
        rw [evalArrSliceBaseRvalue_use_err _ _ _ _ _ hRes2]
        exact hk
      · intro v s1' hOk
        rw [evalArrSliceBaseRvalue_use_err _ _ _ _ _ hRes1] at hOk
        cases hOk
    | ok p =>
      cases p with | mk srcTy p2 =>
      cases p2 with | mk optVal slots₁' =>
      have hOk2 := hBase.2 srcTy optVal slots₁' hRes1
      cases hOk2 with | intro slots₂' hS2 =>
      rw [evalArrSliceBaseRvalue_use_ok _ _ _ _ _ _ _ hRes1,
          evalArrSliceBaseRvalue_use_ok _ _ _ _ _ _ _ hS2.1]
      cases hNeq : (!srcTy.beq dstTy) with
      | true =>
        constructor
        · intro k hk; exact hk
        · intro v s1' hOk; cases hOk
      | false =>
        cases optVal with
        | none =>
          constructor
          · intro k hk; exact hk
          · intro v s1' hOk; cases hOk
        | some v0 =>
          constructor
          · intro k hk; cases hk
          · intro v s1' hOk
            injection hOk with hP
            injection hP with hv hsl
            rw [← hv, ← hsl]
            exact ⟨slots₂', rfl, hS2.2.1, hS2.2.2.1, hS2.2.2.2⟩
  | unaryOp uop op =>
    change operandUsesOnlyBase pack.bodySrc.locals op = true at hRv
    have hP := evalArrSlicePrimitiveOperand_prefix pack hPre hLen₂ hRv
    rw [evalArrSliceBaseRvalue_unaryOp, evalArrSliceBaseRvalue_unaryOp]
    cases hRes1 : evalArrSlicePrimitiveOperand pack.bodySrc.locals slots₁ op with
    | error err =>
      have hRes2 := hP.1 err hRes1
      constructor
      · intro k hk; rw [hRes2]; exact hk
      · intro v s1' hOk; cases hOk
    | ok p =>
      cases p with | mk v slots₁' =>
      have hOk2 := hP.2 v slots₁' hRes1
      cases hOk2 with | intro slots₂' hS2 =>
      rw [hS2.1]
      dsimp
      cases hUn : evalUnOp uop v with
      | error err =>
        dsimp
        constructor
        · intro k hk; exact hk
        · intro res s1' hOk; cases hOk
      | ok res =>
        dsimp
        constructor
        · intro k hk; cases hk
        · intro res' s1' hOk
          injection hOk with hPair
          injection hPair with hres hsl
          rw [← hres, ← hsl]
          exact ⟨slots₂', rfl, hS2.2.1, hS2.2.2.1, hS2.2.2.2⟩
  | binaryOp bop lOp rOp =>
    change (operandUsesOnlyBase pack.bodySrc.locals lOp && operandUsesOnlyBase pack.bodySrc.locals rOp) = true at hRv
    have hAnd := (bool_and_eq_true _ _).mp hRv
    have hL := evalArrSlicePrimitiveOperand_prefix pack hPre hLen₂ hAnd.1
    rw [evalArrSliceBaseRvalue_binaryOp, evalArrSliceBaseRvalue_binaryOp]
    cases hL1 : evalArrSlicePrimitiveOperand pack.bodySrc.locals slots₁ lOp with
    | error err =>
      have hL2 := hL.1 err hL1
      dsimp
      constructor
      · intro k hk; rw [hL2]; exact hk
      · intro v s1' hOk; cases hOk
    | ok pL =>
      cases pL with | mk lVal slots₁Mid =>
      have hOkMid := hL.2 lVal slots₁Mid hL1
      cases hOkMid with | intro slots₂Mid hS2Mid =>
      rw [hS2Mid.1]
      dsimp
      have hLenMid : pack.bodySrc.locals.length ≤ slots₂Mid.length := by
        rw [hS2Mid.2.2.1]; exact hLen₂
      have hR := evalArrSlicePrimitiveOperand_prefix pack hS2Mid.2.1 hLenMid hAnd.2
      cases hR1 : evalArrSlicePrimitiveOperand pack.bodySrc.locals slots₁Mid rOp with
      | error err =>
        have hR2 := hR.1 err hR1
        dsimp
        constructor
        · intro k hk; rw [hR2]; exact hk
        · intro v s1' hOk; cases hOk
      | ok pR =>
        cases pR with | mk rVal slots₁End =>
        have hOkEnd := hR.2 rVal slots₁End hR1
        cases hOkEnd with | intro slots₂End hS2End =>
        rw [hS2End.1]
        dsimp
        cases hBin : evalBinOp bop lVal rVal with
        | error err =>
          dsimp
          constructor
          · intro k hk; exact hk
          · intro v s1' hOk; cases hOk
        | ok res =>
          dsimp
          constructor
          · intro k hk; cases hk
          · intro res' s1' hOk
            injection hOk with hPair
            injection hPair with hres hsl
            rw [← hres, ← hsl]
            refine ⟨slots₂End, rfl, hS2End.2.1, ?_, ?_⟩
            · rw [hS2End.2.2.1, hS2Mid.2.2.1]
            · intro j hj; rw [hS2End.2.2.2 j hj, hS2Mid.2.2.2 j hj]
  | discriminant place =>
    change (place.projection.isEmpty &&
        match Trusted.MirSemantics.getElem? pack.bodySrc.locals place.localId with
        | some (.base _) => true
        | _ => false) = true at hRv
    have hAnd := (bool_and_eq_true _ _).mp hRv
    have hProj := hAnd.1
    cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals place.localId with
    | none => rw [hDecl] at hAnd; cases hAnd.2
    | some d =>
      rw [hDecl] at hAnd
      cases d with
      | array _ _ => cases hAnd.2
      | sliceView _ => cases hAnd.2
      | base pTy =>
        have hInfo := operandUsesOnlyBase_base_local pack.hLoop hDecl
        have hTgtDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals place.localId = some (.base pTy) := by
          rw [getElem?_bodyTgt_nonSlice pack hInfo.1 hInfo.2, hDecl]
        have hSlotEq : Trusted.MirSemantics.getElem? slots₂ place.localId =
            Trusted.MirSemantics.getElem? slots₁ place.localId := hPre.2 place.localId hInfo.1 hInfo.2
        rw [evalArrSliceBaseRvalue_discriminant_eq _ _ _ _ hProj,
            evalArrSliceBaseRvalue_discriminant_eq _ _ _ _ hProj]
        rw [hDecl, hTgtDecl, hSlotEq]
        cases evalDiscrAtSlot (some (.base pTy)) (Trusted.MirSemantics.getElem? slots₁ place.localId) with
        | error err =>
          constructor
          · intro k hk; exact hk
          · intro v s1' hOk; cases hOk
        | ok res =>
          constructor
          · intro k hk; cases hk
          · intro v' s1'' hOk
            injection hOk with hP
            injection hP with hvEq hsEq
            rw [← hvEq, ← hsEq]
            exact ⟨slots₂, rfl, hPre, rfl, fun _ _ => rfl⟩
  | ref _ _ =>
    constructor
    · intro k hk; exact hk
    · intro v s1' hOk; cases hOk
  | addressOf _ _ =>
    constructor
    · intro k hk; exact hk
    · intro v s1' hOk; cases hOk
  | aggregateTuple _ =>
    constructor
    · intro k hk; exact hk
    · intro v s1' hOk; cases hOk
  | unsupported =>
    constructor
    · intro k hk; exact hk
    · intro v s1' hOk; cases hOk

private theorem writeArrSliceBasePlace_prefix
    {decls : List ArrSliceLocalDecl} {entries : List SliceBackingEntry}
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPre : PrefixSlotsMatch decls entries slots₁ slots₂)
    {dst : LocalId} (hDst : dst < decls.length) (hNone : findSliceEntry entries dst = none)
    (dstTy : MirTy) (val : Val) :
    (∀ k, writeArrSliceBasePlace slots₁ dst dstTy val = .error k →
      writeArrSliceBasePlace slots₂ dst dstTy val = .error k) ∧
    (∀ slots₁',
      writeArrSliceBasePlace slots₁ dst dstTy val = .ok slots₁' →
        ∃ slots₂',
          writeArrSliceBasePlace slots₂ dst dstTy val = .ok slots₂' ∧
          PrefixSlotsMatch decls entries slots₁' slots₂' ∧
          slots₂'.length = slots₂.length ∧
          ∀ j, decls.length ≤ j →
            Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) := by
  have hSlotEq : Trusted.MirSemantics.getElem? slots₂ dst =
      Trusted.MirSemantics.getElem? slots₁ dst := hPre.2 dst hDst hNone
  rw [writeArrSliceBasePlace_eq, writeArrSliceBasePlace_eq, hSlotEq]
  cases hChk : (!checkVal val dstTy) with
  | true =>
    dsimp
    constructor
    · intro k hk; exact hk
    · intro s1' hOk; cases hOk
  | false =>
    dsimp
    cases hS1 : Trusted.MirSemantics.getElem? slots₁ dst with
    | none =>
      exact False.elim (Nat.not_lt_of_ge (getElem?_none_le slots₁ dst hS1) (by rw [hPre.1]; exact hDst))
    | some sl =>
      cases sl with
      | arrDead =>
        constructor
        · intro k hk; exact hk
        · intro s1' hOk; cases hOk
      | liveArray _ =>
        constructor
        · intro k hk; exact hk
        · intro s1' hOk; cases hOk
      | sliceDead =>
        constructor
        · intro k hk; exact hk
        · intro s1' hOk; cases hOk
      | liveSlice _ =>
        constructor
        · intro k hk; exact hk
        · intro s1' hOk; cases hOk
      | baseSlot bsl =>
        cases bsl with
        | dead =>
          constructor
          · intro k hk; exact hk
          · intro s1' hOk; cases hOk
        | live ov =>
          dsimp
          have hLt1 : dst < slots₁.length := by rw [hPre.1]; exact hDst
          have hEx1 := lt_setElem?_some slots₁ dst (.baseSlot (.live (some val))) hLt1
          cases hEx1 with | intro slots₁' hSet₁ =>
          have hLt2 : dst < slots₂.length := by
            have hSome2 : Trusted.MirSemantics.getElem? slots₂ dst = some (.baseSlot (.live ov)) := by
              rw [hSlotEq, hS1]
            exact getElem?_some_lt slots₂ dst _ hSome2
          have hEx2 := lt_setElem?_some slots₂ dst (.baseSlot (.live (some val))) hLt2
          cases hEx2 with | intro slots₂' hSet₂ =>
          have hPM := prefixSlotsMatch_set_base hPre hDst (.baseSlot (.live (some val))) hSet₁ hSet₂
          constructor
          · intro k hk; rw [hSet₁] at hk; cases hk
          · intro s1' hOk
            rw [hSet₁] at hOk
            injection hOk with hsEq
            rw [← hsEq]
            refine ⟨slots₂', ?_, hPM.1, hPM.2.1, hPM.2.2⟩
            rw [hSet₂]

