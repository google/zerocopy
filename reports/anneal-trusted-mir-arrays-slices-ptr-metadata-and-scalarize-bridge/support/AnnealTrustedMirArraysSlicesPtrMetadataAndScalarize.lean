/-! ## Part III, Theorem 1: Exact Conservative Extension Over Unmodified `Trusted.MirSemantics` -/

private theorem evalArrSliceBaseOperandToSlot_map_base
    (tys : List MirTy) (slots : List LocalSlot) (opnd : Operand) :
    evalArrSliceBaseOperandToSlot
        (tys.map ArrSliceLocalDecl.base) (slots.map ArrSliceSlot.baseSlot) opnd =
      match evalOperandToSlot tys slots opnd with
      | .error k => .error k
      | .ok (ty, optVal, slots') => .ok (ty, optVal, slots'.map ArrSliceSlot.baseSlot) := by
  cases opnd with
  | copy place =>
    unfold evalArrSliceBaseOperandToSlot evalOperandToSlot
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases Trusted.MirSemantics.getElem? slots place.localId with
        | none => rfl
        | some sl => cases sl <;> rfl
  | move place =>
    unfold evalArrSliceBaseOperandToSlot evalOperandToSlot
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases Trusted.MirSemantics.getElem? slots place.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | live optVal =>
            dsimp [liveUninitArrSliceSlot]
            rw [setElem?_map ArrSliceSlot.baseSlot slots place.localId (liveUninitSlot ty)]
            cases setElem? slots place.localId (liveUninitSlot ty) <;> rfl
  | constant c =>
    unfold evalArrSliceBaseOperandToSlot evalOperandToSlot
    dsimp
    cases evalConstLit c.ty c.lit <;> rfl

private theorem evalArrSlicePrimitiveOperand_map_base
    (tys : List MirTy) (slots : List LocalSlot) (opnd : Operand) :
    evalArrSlicePrimitiveOperand
        (tys.map ArrSliceLocalDecl.base) (slots.map ArrSliceSlot.baseSlot) opnd =
      match evalPrimitiveOperand tys slots opnd with
      | .error k => .error k
      | .ok (v, slots') => .ok (v, slots'.map ArrSliceSlot.baseSlot) := by
  unfold evalArrSlicePrimitiveOperand evalPrimitiveOperand
  rw [evalArrSliceBaseOperandToSlot_map_base]
  cases evalOperandToSlot tys slots opnd with
  | error _ => rfl
  | ok res =>
    cases res with
    | mk ty rest =>
      cases rest with
      | mk optVal slots' =>
        dsimp
        cases isPrimitiveReadableTy ty with
        | false => rfl
        | true => cases optVal <;> rfl

private theorem evalArrSliceBaseRvalue_map_base
    (tys : List MirTy) (slots : List LocalSlot) (dstTy : MirTy) (rv : Rvalue) :
    evalArrSliceBaseRvalue
        (tys.map ArrSliceLocalDecl.base) (slots.map ArrSliceSlot.baseSlot) dstTy rv =
      match evalRvalue tys slots dstTy rv with
      | .error k => .error k
      | .ok (v, slots') => .ok (v, slots'.map ArrSliceSlot.baseSlot) := by
  cases rv with
  | use opnd =>
    unfold evalArrSliceBaseRvalue evalRvalue
    dsimp
    rw [evalArrSliceBaseOperandToSlot_map_base]
    cases evalOperandToSlot tys slots opnd with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk srcTy rest =>
        cases rest with
        | mk optVal slots₁ =>
          dsimp
          cases MirTy.beq srcTy dstTy with
          | false => rfl
          | true => cases optVal <;> rfl
  | binaryOp op lhs rhs =>
    unfold evalArrSliceBaseRvalue evalRvalue
    dsimp
    rw [evalArrSlicePrimitiveOperand_map_base]
    cases evalPrimitiveOperand tys slots lhs with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk lVal slots₁ =>
        dsimp
        rw [evalArrSlicePrimitiveOperand_map_base]
        cases evalPrimitiveOperand tys slots₁ rhs with
        | error _ => rfl
        | ok p2 =>
          cases p2 with
          | mk rVal slots₂ =>
            dsimp
            cases evalBinOp op lVal rVal <;> rfl
  | unaryOp op opnd =>
    unfold evalArrSliceBaseRvalue evalRvalue
    dsimp
    rw [evalArrSlicePrimitiveOperand_map_base]
    cases evalPrimitiveOperand tys slots opnd with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk v slots₁ =>
        dsimp
        cases evalUnOp op v <;> rfl
  | discriminant place =>
    unfold evalArrSliceBaseRvalue evalRvalue
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases ty with
        | bool | int _ _ | unit | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported => rfl
        | enum ety =>
          cases Trusted.MirSemantics.getElem? slots place.localId with
          | none => rfl
          | some slot =>
            dsimp
            cases enumAdmitted ety with
            | false => rfl
            | true =>
              dsimp
              cases ety with
              | mk eid edw eds etr ediscs =>
                dsimp
                cases etr with
                | zeroSized =>
                  cases slot with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none =>
                      dsimp
                      cases Trusted.MirSemantics.getElem? ediscs 0 <;> rfl
                    | some val =>
                      cases val with
                      | bool _ | scalar _ | unit | ptr _ | tuple _ | bytes _ => rfl
                      | enumVal ety' v =>
                        dsimp
                        cases (EnumTy.beq ⟨eid, edw, eds, .zeroSized, ediscs⟩ ety' && Nat.beq v 0) with
                        | false => rfl
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? ediscs 0 <;> rfl
                | scalar tw ts =>
                  cases slot with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none => rfl
                    | some val =>
                      cases val with
                      | bool _ | scalar _ | unit | ptr _ | tuple _ | bytes _ => rfl
                      | enumVal ety' v =>
                        dsimp
                        cases (EnumTy.beq ⟨eid, edw, eds, .scalar tw ts, ediscs⟩ ety' &&
                            Nat.blt v ediscs.length) with
                        | false => rfl
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? ediscs v <;> rfl
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported => rfl

private theorem writeArrSliceBasePlace_map_base (slots : List LocalSlot)
    (dstLocalId : LocalId) (dstTy : MirTy) (val : Val) :
    writeArrSliceBasePlace (slots.map ArrSliceSlot.baseSlot) dstLocalId dstTy val =
      match writePlace slots dstLocalId dstTy val with
      | .error k => .error k
      | .ok slots' => .ok (slots'.map ArrSliceSlot.baseSlot) := by
  unfold writeArrSliceBasePlace writePlace
  cases checkVal val dstTy with
  | false => rfl
  | true =>
    dsimp
    rw [getElem?_map]
    cases Trusted.MirSemantics.getElem? slots dstLocalId with
    | none => rfl
    | some sl =>
      cases sl with
      | dead => rfl
      | live _ =>
        dsimp
        rw [setElem?_map ArrSliceSlot.baseSlot slots dstLocalId (.live (some val))]
        cases setElem? slots dstLocalId (.live (some val)) <;> rfl

private theorem evalArrSliceStmt_embedBase (body : Body) (frame : FrameState)
    (callerMem : CallerMemory) (stmt : StatementKind) :
    evalArrSliceStmt (embedBaseBody body) (embedArrSliceFrame frame) callerMem
        (.baseStmt stmt) =
      liftStepResultArrSlice (evalStatement body frame callerMem stmt) := by
  cases stmt with
  | nop => rfl
  | unsupported => rfl
  | storageLive localId =>
    unfold evalArrSliceStmt evalStatement embedBaseBody embedArrSliceFrame
    dsimp
    rw [getElem?_map]
    cases Trusted.MirSemantics.getElem? body.locals localId with
    | none => rfl
    | some localTy =>
      dsimp [liveUninitArrSliceSlot, stepStmtNext, liftStepResultArrSlice,
        embedArrSliceState, embedArrSliceFrame]
      rw [setElem?_map ArrSliceSlot.baseSlot frame.locals localId (liveUninitSlot localTy)]
      cases setElem? frame.locals localId (liveUninitSlot localTy) <;> rfl
  | storageDead localId =>
    unfold evalArrSliceStmt evalStatement embedBaseBody embedArrSliceFrame
    dsimp
    cases Nat.beq localId 0 with
    | true => rfl
    | false =>
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? body.locals localId with
      | none =>
        dsimp [stepStmtNext, liftStepResultArrSlice, embedArrSliceState, embedArrSliceFrame]
        rw [setElem?_map ArrSliceSlot.baseSlot frame.locals localId .dead]
        cases setElem? frame.locals localId .dead <;> rfl
      | some _ =>
        dsimp [deadArrSliceSlot, stepStmtNext, liftStepResultArrSlice,
          embedArrSliceState, embedArrSliceFrame]
        rw [setElem?_map ArrSliceSlot.baseSlot frame.locals localId .dead]
        cases setElem? frame.locals localId .dead <;> rfl
  | assign dst rvalue =>
    unfold evalArrSliceStmt evalStatement embedBaseBody embedArrSliceFrame
    dsimp
    cases dst.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? body.locals dst.localId with
      | none => rfl
      | some dstTy =>
        dsimp
        rw [evalArrSliceBaseRvalue_map_base]
        cases evalRvalue body.locals frame.locals dstTy rvalue with
        | error _ => rfl
        | ok p1 =>
          cases p1 with
          | mk val localsAfterRval =>
            dsimp
            rw [writeArrSliceBasePlace_map_base]
            cases writePlace localsAfterRval dst.localId dstTy val <;> rfl

private theorem evalArrSliceTerm_embedBase (body : Body) (bb : BasicBlock)
    (frame : FrameState) (callerMem : CallerMemory) :
    evalArrSliceTerm (embedBaseBody body) (embedBaseBlock bb)
        (embedArrSliceFrame frame) callerMem =
      liftStepResultArrSlice (evalTerminator body bb frame callerMem) := by
  unfold evalArrSliceTerm evalTerminator embedBaseBody embedBaseBlock embedArrSliceFrame
  dsimp
  cases bb.terminator with
  | goto _ => rfl
  | return_ =>
    dsimp
    cases bb.cleanup with
    | true => rfl
    | false =>
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? frame.locals 0 with
      | none => rfl
      | some sl =>
        cases sl with
        | dead => rfl
        | live ov => cases ov <;> rfl
  | unreachable => rfl
  | switchInt discr targets =>
    dsimp
    rw [evalArrSlicePrimitiveOperand_map_base]
    cases evalPrimitiveOperand body.locals frame.locals discr with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk discrVal localsAfterDiscr =>
        dsimp
        cases discrVal with
        | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => rfl
        | scalar sv =>
          dsimp
          cases evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches <;> rfl
        | bool b =>
          dsimp
          cases evalBoolSwitchBranches b targets.otherwise targets.branches <;> rfl
  | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported => rfl

private theorem evalStepArrSlice_embedBaseProgram (p : Program) (c : Choice) (s : State) :
    evalStepArrSlice (embedBaseProgram p) c (embedArrSliceState s) =
      liftStepResultArrSlice (evalStep p c s) := by
  cases s with
  | mk frames callerMem =>
    cases frames with
    | nil => rfl
    | cons frame rest =>
      cases rest with
      | cons _ _ => rfl
      | nil =>
        unfold evalStepArrSlice evalStep embedBaseProgram embedArrSliceState
        dsimp [List.map, embedArrSliceFrame]
        rw [getElem?_map]
        cases Trusted.MirSemantics.getElem? p.bodies frame.defId with
        | none => rfl
        | some body =>
          dsimp
          unfold embedBaseBody
          dsimp
          rw [getElem?_map]
          cases Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
          | none => rfl
          | some bb =>
            dsimp
            unfold embedBaseBlock
            dsimp
            rw [getElem?_map]
            cases Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
            | some st =>
              dsimp
              exact evalArrSliceStmt_embedBase body frame callerMem st
            | none =>
              dsimp
              rw [list_length_map ArrSliceStmt.baseStmt bb.statements]
              cases Nat.beq frame.stmtIdx bb.statements.length with
              | false => rfl
              | true =>
                dsimp
                exact evalArrSliceTerm_embedBase body bb frame callerMem

private theorem arrSliceStorageAnnotationsInBounds_embedBaseBody (body : Body) :
    arrSliceStorageAnnotationsInBounds (embedBaseBody body) =
      storageAnnotationsInBounds body := by
  unfold arrSliceStorageAnnotationsInBounds storageAnnotationsInBounds embedBaseBody
  dsimp
  rw [list_length_map ArrSliceLocalDecl.base body.locals]
  rw [list_all_map]
  refine congrArg (List.all body.basicBlocks) (funext ?_)
  intro bb
  unfold embedBaseBlock
  dsimp
  rw [list_all_map]
  refine congrArg (List.all bb.statements) (funext ?_)
  intro st
  cases st <;> rfl

private theorem allArrSliceLocalsSupported_map_base (argCount : Nat) :
    ∀ (idx : Nat) (tys : List MirTy),
      allArrSliceLocalsSupported argCount idx (tys.map ArrSliceLocalDecl.base) =
        tys.all isSupportedScalarOrUnitTy
  | _, [] => rfl
  | idx, ty :: tys => by
    change
      (isSupportedArrSliceLocalDecl argCount idx (.base ty) &&
        allArrSliceLocalsSupported argCount (idx + 1) (tys.map ArrSliceLocalDecl.base)) =
      (isSupportedScalarOrUnitTy ty && tys.all isSupportedScalarOrUnitTy)
    rw [allArrSliceLocalsSupported_map_base argCount (idx + 1) tys]
    rfl

private theorem listMapOption_some_id :
    ∀ xs : List MirTy, listMapOption (fun ty : MirTy => some ty) xs = some xs
  | [] => rfl
  | x :: xs => by
    dsimp [listMapOption]
    rw [listMapOption_some_id xs]

private theorem arrSliceParamBaseTys?_embedBaseBody (body : Body) :
    arrSliceParamBaseTys? (embedBaseBody body) =
      some ((body.locals.drop 1).take body.argumentCount) := by
  unfold arrSliceParamBaseTys? embedBaseBody
  dsimp
  rw [list_drop_map, list_take_map, listMapOption_map]
  exact listMapOption_some_id ((body.locals.drop 1).take body.argumentCount)

private theorem arrSliceHasStorageAnnotation_embedBaseBody (body : Body)
    (localId : LocalId) :
    arrSliceHasStorageAnnotation (embedBaseBody body) localId =
      hasStorageAnnotation body localId := by
  unfold arrSliceHasStorageAnnotation hasStorageAnnotation embedBaseBody
  dsimp
  rw [list_any_map]
  have hElem :
      (fun x : BasicBlock =>
        (embedBaseBlock x).statements.any (arrSliceStmtHasStorageMarker localId)) =
      (fun bb : BasicBlock => bb.statements.any (stmtHasStorageMarker localId)) := by
    funext bb
    unfold embedBaseBlock
    dsimp
    rw [list_any_map]
    rfl
  rw [hElem]

private theorem initArrSliceLocalsLoop_embedBaseBody (body : Body) (args : List Val) :
    ∀ (idx : Nat) (tys : List MirTy),
      initArrSliceLocalsLoop (embedBaseBody body) args idx (tys.map ArrSliceLocalDecl.base) =
        (initLocalsLoop body args idx tys).map ArrSliceSlot.baseSlot
  | _, [] => rfl
  | idx, ty :: rest => by
    change
      (if Nat.beq idx 0 then
         liveUninitArrSliceSlot (.base ty)
       else if Nat.ble idx (embedBaseBody body).argumentCount then
         match Trusted.MirSemantics.getElem? args (idx - 1) with
         | some v => .baseSlot (.live (some v))
         | none => .baseSlot .dead
       else if arrSliceHasStorageAnnotation (embedBaseBody body) idx then
         deadArrSliceSlot (.base ty)
       else
         liveUninitArrSliceSlot (.base ty)) ::
        initArrSliceLocalsLoop (embedBaseBody body) args (idx + 1)
          (rest.map ArrSliceLocalDecl.base) =
      ArrSliceSlot.baseSlot
        (if Nat.beq idx 0 then
           liveUninitSlot ty
         else if Nat.ble idx body.argumentCount then
           match Trusted.MirSemantics.getElem? args (idx - 1) with
           | some v => .live (some v)
           | none => .dead
         else if hasStorageAnnotation body idx then
           .dead
         else
           liveUninitSlot ty) ::
        (initLocalsLoop body args (idx + 1) rest).map ArrSliceSlot.baseSlot
    rw [initArrSliceLocalsLoop_embedBaseBody body args (idx + 1) rest]
    rw [arrSliceHasStorageAnnotation_embedBaseBody body idx]
    have hArg : (embedBaseBody body).argumentCount = body.argumentCount := rfl
    rw [hArg]
    cases Nat.beq idx 0 with
    | true => rfl
    | false =>
      dsimp
      cases Nat.ble idx body.argumentCount with
      | true =>
        dsimp
        cases Trusted.MirSemantics.getElem? args (idx - 1) <;> rfl
      | false =>
        dsimp
        cases hasStorageAnnotation body idx <;> rfl

private theorem initStateArrSlice_embedBaseProgram (p : Program) (q : Query) :
    initStateArrSlice (embedBaseProgram p) q =
      match initState p q with
      | .error k => .error k
      | .ok s₀ => .ok (embedArrSliceState s₀) := by
  unfold initStateArrSlice initState embedBaseProgram
  dsimp
  cases (!Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1) with
  | true => rfl
  | false =>
    dsimp
    cases q.callerMem.allocations.isEmpty with
    | false => rfl
    | true =>
      dsimp [List.all]
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
      | none => rfl
      | some body =>
        dsimp
        have hBbsEmpty : (embedBaseBody body).basicBlocks.isEmpty = body.basicBlocks.isEmpty := by
          unfold embedBaseBody
          cases body.basicBlocks <;> rfl
        have hLocLen : (embedBaseBody body).locals.length = body.locals.length := by
          unfold embedBaseBody
          exact list_length_map ArrSliceLocalDecl.base body.locals
        have hSup :
            allArrSliceLocalsSupported (embedBaseBody body).argumentCount 0 (embedBaseBody body).locals =
              body.locals.all isSupportedScalarOrUnitTy := by
          unfold embedBaseBody
          exact allArrSliceLocalsSupported_map_base body.argumentCount 0 body.locals
        rw [hBbsEmpty, hLocLen, arrSliceStorageAnnotationsInBounds_embedBaseBody,
          hSup, arrSliceParamBaseTys?_embedBaseBody]
        have hArgEq : (embedBaseBody body).argumentCount = body.argumentCount := rfl
        rw [hArgEq]
        cases body.basicBlocks.isEmpty with
        | true => rfl
        | false =>
          dsimp
          cases Nat.blt body.argumentCount body.locals.length with
          | false => rfl
          | true =>
            dsimp
            cases storageAnnotationsInBounds body with
            | false => rfl
            | true =>
              dsimp
              cases body.locals.all isSupportedScalarOrUnitTy with
              | false => rfl
              | true =>
                dsimp
                cases checkArgsMatch q.args ((body.locals.drop 1).take body.argumentCount) with
                | false => rfl
                | true =>
                  dsimp
                  have hLoop :
                      initArrSliceLocalsLoop (embedBaseBody body) q.args 0
                          (embedBaseBody body).locals =
                        (initLocalsLoop body q.args 0 body.locals).map ArrSliceSlot.baseSlot := by
                    unfold embedBaseBody
                    exact initArrSliceLocalsLoop_embedBaseBody body q.args 0 body.locals
                  rw [hLoop]
                  rfl

private theorem stepArrSlice_embedBase_fwd (p : Program) {s₁ s₂ : State}
    (h : Step p s₁ (.step s₂)) :
    StepArrSlice (embedBaseProgram p) (embedArrSliceState s₁)
      (.step (embedArrSliceState s₂)) := by
  have hEval := (stepBase_iff_evalStep p s₁ (.step s₂)).mp h
  have hEmbed := evalStepArrSlice_embedBaseProgram p 0 s₁
  rw [hEval] at hEmbed
  exact (stepArrSlice_iff_evalStep (embedBaseProgram p) (embedArrSliceState s₁)
    (.step (embedArrSliceState s₂))).mpr hEmbed

private theorem reachesArrSlice_embedBase_fwd (p : Program) {s₁ s₂ : State}
    (h : Reaches p s₁ s₂) :
    ReachesArrSlice (embedBaseProgram p) (embedArrSliceState s₁)
      (embedArrSliceState s₂) := by
  induction h with
  | refl => exact ReachesArrSlice.refl (embedArrSliceState s₁)
  | tail _ hTail ih => exact ReachesArrSlice.tail ih (stepArrSlice_embedBase_fwd p hTail)

private theorem reachesArrSlice_embedBase_bwd_aux (p : Program)
    {e₁ e₂ : ArrSliceState}
    (hReach : ReachesArrSlice (embedBaseProgram p) e₁ e₂) :
    ∀ s₁ : State, e₁ = embedArrSliceState s₁ →
      ∃ s₂ : State, e₂ = embedArrSliceState s₂ ∧ Reaches p s₁ s₂ := by
  induction hReach with
  | refl =>
    intro s₁ hEq
    exact ⟨s₁, hEq, Reaches.refl s₁⟩
  | tail _ hTail ih =>
    intro s₁ hEq
    cases ih s₁ hEq with
    | intro s₂ hs₂ =>
      have hEvalArr := (stepArrSlice_iff_evalStep (embedBaseProgram p) _ (.step _)).mp hTail
      rw [hs₂.1, evalStepArrSlice_embedBaseProgram p 0 s₂] at hEvalArr
      cases hBase : evalStep p 0 s₂ with
      | step s₃ =>
        rw [hBase] at hEvalArr
        cases hEvalArr
        exact ⟨s₃, rfl, Reaches.tail hs₂.2 ((stepBase_iff_evalStep p s₂ (.step s₃)).mpr hBase)⟩
      | done _ =>
        rw [hBase] at hEvalArr
        cases hEvalArr
      | fault _ =>
        rw [hBase] at hEvalArr
        cases hEvalArr

private theorem reachesArrSlice_embedBase_bwd (p : Program) {s₁ : State} {e₂ : ArrSliceState}
    (hReach : ReachesArrSlice (embedBaseProgram p) (embedArrSliceState s₁) e₂) :
    ∃ s₂ : State, e₂ = embedArrSliceState s₂ ∧ Reaches p s₁ s₂ :=
  reachesArrSlice_embedBase_bwd_aux p hReach s₁ rfl

private theorem arrSlice_conservative_extension_exact_slice1
    (p : Program) :
    (∀ (c : Choice) (s : State),
      evalStepArrSlice (embedBaseProgram p) c (embedArrSliceState s) =
        liftStepResultArrSlice (evalStep p c s)) ∧
    (∀ q : Query,
      (WellFormedArrSlice (embedBaseProgram p) q ↔ WellFormed p q) ∧
      (∀ out : TerminalOut,
        BehaviorArrSlice (embedBaseProgram p) q out ↔ Behavior p q out) ∧
      (∀ k : FaultKind,
        ReachesResultArrSlice (embedBaseProgram p) q (.fault k) ↔
          ReachesResult p q (.fault k)) ∧
      (DivergesArrSlice (embedBaseProgram p) q ↔ Diverges p q) ∧
      (∀ post : TerminalOut → Prop,
        SatisfiesPostArrSlice (embedBaseProgram p) q post ↔
          SatisfiesPost p q post)) := by
  refine ⟨fun c s => evalStepArrSlice_embedBaseProgram p c s, ?_⟩
  refine equivArrSliceToBase_of_outcomes (embedBaseProgram p) p ?_ ?_
  · intro q out
    unfold BehaviorArrSlice ReachesResultArrSlice Behavior ReachesResult
    rw [initStateArrSlice_embedBaseProgram p q]
    cases initState p q with
    | error _ =>
      dsimp
      constructor <;> (intro h; cases h)
    | ok s₀ =>
      constructor
      · intro h
        cases h with
        | intro e₂ he₂ =>
          cases reachesArrSlice_embedBase_bwd p he₂.1 with
          | intro s₂ hs₂ =>
            have hEvalArr := (stepArrSlice_iff_evalStep (embedBaseProgram p) e₂ (.done out)).mp he₂.2
            rw [hs₂.1, evalStepArrSlice_embedBaseProgram p 0 s₂] at hEvalArr
            cases hBase : evalStep p 0 s₂ with
            | step _ =>
              rw [hBase] at hEvalArr
              cases hEvalArr
            | done out' =>
              rw [hBase] at hEvalArr
              cases hEvalArr
              exact ⟨s₂, hs₂.2, (stepBase_iff_evalStep p s₂ (.done out)).mpr hBase⟩
            | fault _ =>
              rw [hBase] at hEvalArr
              cases hEvalArr
      · intro h
        cases h with
        | intro s₂ hs₂ =>
          have hStep := (stepBase_iff_evalStep p s₂ (.done out)).mp hs₂.2
          have hEmbed := evalStepArrSlice_embedBaseProgram p 0 s₂
          rw [hStep] at hEmbed
          exact ⟨embedArrSliceState s₂, reachesArrSlice_embedBase_fwd p hs₂.1,
            (stepArrSlice_iff_evalStep (embedBaseProgram p) (embedArrSliceState s₂) (.done out)).mpr hEmbed⟩
  · intro q k
    unfold ReachesResultArrSlice ReachesResult
    rw [initStateArrSlice_embedBaseProgram p q]
    cases initState p q with
    | error _ =>
      dsimp
      constructor <;> (intro h; cases h; rfl)
    | ok s₀ =>
      constructor
      · intro h
        cases h with
        | intro e₂ he₂ =>
          cases reachesArrSlice_embedBase_bwd p he₂.1 with
          | intro s₂ hs₂ =>
            have hEvalArr := (stepArrSlice_iff_evalStep (embedBaseProgram p) e₂ (.fault k)).mp he₂.2
            rw [hs₂.1, evalStepArrSlice_embedBaseProgram p 0 s₂] at hEvalArr
            cases hBase : evalStep p 0 s₂ with
            | step _ =>
              rw [hBase] at hEvalArr
              cases hEvalArr
            | done _ =>
              rw [hBase] at hEvalArr
              cases hEvalArr
            | fault fk' =>
              rw [hBase] at hEvalArr
              cases hEvalArr
              exact ⟨s₂, hs₂.2, (stepBase_iff_evalStep p s₂ (.fault k)).mpr hBase⟩
      · intro h
        cases h with
        | intro s₂ hs₂ =>
          have hStep := (stepBase_iff_evalStep p s₂ (.fault k)).mp hs₂.2
          have hEmbed := evalStepArrSlice_embedBaseProgram p 0 s₂
          rw [hStep] at hEmbed
          exact ⟨embedArrSliceState s₂, reachesArrSlice_embedBase_fwd p hs₂.1,
            (stepArrSlice_iff_evalStep (embedBaseProgram p) (embedArrSliceState s₂) (.fault k)).mpr hEmbed⟩

/-! ## Part III, Theorem 3: Dangling Slice Metadata, Deref UB, Bounds-Check Precedence, and Subslice Composition -/

private theorem danglingSlice_metadata_valid_deref_ub_and_boundsCheck_precedes_deref_slice1 :
    (∀ (body : ArrSliceBody) (frame : ArrSliceFrame) (cm : CallerMemory)
        (dst sLoc : LocalId) (elemTy : MirTy) (len : Nat) (optOld : Option Val),
      Nat.blt len maxUsize = true →
      Trusted.MirSemantics.getElem? body.locals dst = some (.base usizeTy) →
      Trusted.MirSemantics.getElem? body.locals sLoc = some (.sliceView elemTy) →
      Trusted.MirSemantics.getElem? frame.locals sLoc =
        some (.liveSlice (some { backing := .dangling, start := 0, len := len })) →
      Trusted.MirSemantics.getElem? frame.locals dst = some (.baseSlot (.live optOld)) →
      ∃ slots' : List ArrSliceSlot,
        evalArrSliceStmt body frame cm (.ptrMetadata dst sLoc) =
          stepStmtNext frame cm slots' ∧
        Trusted.MirSemantics.getElem? slots' dst =
          some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 len⟩))))) ∧
    (∀ (body : ArrSliceBody) (bb : ArrSliceBlock) (frame : ArrSliceFrame)
        (cm : CallerMemory) (dst sLoc : LocalId) (elemTy : MirTy)
        (start len idx : Nat) (nextBb : BasicBlockId),
      Nat.blt idx maxUsize = true →
      Trusted.MirSemantics.getElem? body.locals dst = some (.base elemTy) →
      Trusted.MirSemantics.getElem? body.locals sLoc = some (.sliceView elemTy) →
      Trusted.MirSemantics.getElem? frame.locals sLoc =
        some (.liveSlice (some { backing := .dangling, start := start, len := len })) →
      bb.terminator = .readSliceElem dst sLoc (usizeConst idx) nextBb →
      evalArrSliceTerm body bb frame cm = .fault .undefined) ∧
    (∀ (body : ArrSliceBody) (bb : ArrSliceBlock) (frame : ArrSliceFrame)
        (cm : CallerMemory) (sLoc : LocalId) (elemTy : MirTy)
        (sv : SliceViewVal) (idx : Nat) (inBoundsBb panicBb : BasicBlockId),
      Nat.blt idx maxUsize = true →
      Trusted.MirSemantics.getElem? body.locals sLoc = some (.sliceView elemTy) →
      Trusted.MirSemantics.getElem? frame.locals sLoc =
        some (.liveSlice (some sv)) →
      bb.terminator = .boundsCheckSlice sLoc (usizeConst idx) inBoundsBb panicBb →
      evalArrSliceTerm body bb frame cm =
        jumpArrSliceBlock frame cm frame.locals
          (if Nat.blt idx sv.len then inBoundsBb else panicBb)) ∧
    (∀ (sv : SliceViewVal) (f₁ t₁ f₂ t₂ : Nat),
      Nat.blt (sv.start + sv.len) maxUsize = true →
      f₁ ≤ t₁ → t₁ ≤ sv.len → f₂ ≤ t₂ → t₂ ≤ t₁ - f₁ →
      ∃ sv₁ sv₂ : SliceViewVal,
        evalSubsliceVal sv f₁ t₁ false = .ok sv₁ ∧
        evalSubsliceVal sv₁ f₂ t₂ false = .ok sv₂ ∧
        evalSubsliceVal sv (f₁ + f₂) (f₁ + t₂) false = .ok sv₂ ∧
        sv₂.backing = sv.backing ∧
        sv₂.start + sv₂.len < maxUsize) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro body frame cm dst sLoc elemTy len optOld hLen hDstDecl hSLocDecl hSLocVal hDstVal
    have hLenLt : len < maxUsize := nat_blt_lt hLen
    have hCheck := checkVal_usize_of_lt_maxUsize len hLenLt
    have hDstLt : dst < frame.locals.length := getElem?_some_lt _ _ _ hDstVal
    cases lt_setElem?_some frame.locals dst
        (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 len⟩)))) hDstLt with
    | intro slots' hSet =>
      refine ⟨slots', ?_, getElem?_setElem?_self _ _ _ _ hSet⟩
      unfold evalArrSliceStmt
      dsimp
      rw [hDstDecl, hSLocDecl, hSLocVal]
      dsimp
      have hTyEq : (!MirTy.beq usizeTy usizeTy) = false := rfl
      rw [hTyEq]
      dsimp
      unfold writeArrSliceBasePlace
      change
        (match
          if (!checkVal (.scalar ⟨.isize, false, BitVec.ofNat 128 len⟩) usizeTy) = true then
            Except.error FaultKind.unsupported
          else
            match Trusted.MirSemantics.getElem? frame.locals dst with
            | none => Except.error FaultKind.unsupported
            | some (.baseSlot .dead) => Except.error FaultKind.undefined
            | some (.baseSlot (.live _)) =>
              match setElem? frame.locals dst
                  (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 len⟩)))) with
              | some slots' => Except.ok slots'
              | none => Except.error FaultKind.unsupported
            | some _ => Except.error FaultKind.unsupported with
        | Except.error k => StepResult.fault k
        | Except.ok s' => stepStmtNext frame cm s') = stepStmtNext frame cm slots'
      rw [hCheck, hDstVal, hSet]
      rfl
  · intro body bb frame cm dst sLoc elemTy start len idx nextBb hIdx hDstDecl hSLocDecl hSLocVal hTerm
    have hIdxLt : idx < maxUsize := nat_blt_lt hIdx
    unfold evalArrSliceTerm
    rw [hTerm]
    dsimp
    rw [hDstDecl, hSLocDecl, hSLocVal]
    dsimp
    have hRefl := mirTy_beq_refl elemTy
    have hNotEq : (!MirTy.beq elemTy elemTy) = false := by
      rw [hRefl]
      rfl
    change
      (if (!MirTy.beq elemTy elemTy) = true then
        StepResult.fault FaultKind.unsupported
      else
        match evalUsizeOperand body.locals frame.locals (usizeConst idx) with
        | .error k => .fault k
        | .ok (idxVal, _) =>
          if (!Nat.blt idxVal len) = true then .fault .undefined
          else .fault .undefined) = .fault .undefined
    rw [hNotEq]
    dsimp
    rw [evalUsizeOperand_usizeConst_of_lt_maxUsize body.locals frame.locals idx hIdxLt]
    dsimp
    cases Nat.blt idx len <;> rfl
  · intro body bb frame cm sLoc elemTy sv idx inBoundsBb panicBb hIdx hSLocDecl hSLocVal hTerm
    have hIdxLt : idx < maxUsize := nat_blt_lt hIdx
    unfold evalArrSliceTerm
    rw [hTerm]
    dsimp
    rw [hSLocDecl, hSLocVal]
    dsimp
    rw [evalUsizeOperand_usizeConst_of_lt_maxUsize body.locals frame.locals idx hIdxLt]
  · intro sv f₁ t₁ f₂ t₂ hBound h1 h2 h3 h4
    have hBoundLt : sv.start + sv.len < maxUsize := nat_blt_lt hBound
    let sv₁ : SliceViewVal := {
      backing := sv.backing
      start := sv.start + f₁
      len := t₁ - f₁
    }
    let sv₂ : SliceViewVal := {
      backing := sv.backing
      start := (sv.start + f₁) + f₂
      len := t₂ - f₂
    }
    have hSv1Sum : sv₁.start + sv₁.len = sv.start + t₁ := by
      dsimp [sv₁]
      rw [Nat.add_assoc, Nat.add_sub_of_le h1]
    have hSv1Le : sv₁.start + sv₁.len ≤ sv.start + sv.len := by
      rw [hSv1Sum]
      exact Nat.add_le_add_left h2 sv.start
    have hSv1Lt : sv₁.start + sv₁.len < maxUsize :=
      Nat.lt_of_le_of_lt hSv1Le hBoundLt
    have hSv1Bound : Nat.blt (sv₁.start + sv₁.len) maxUsize = true :=
      lt_nat_blt hSv1Lt
    have hF12Le : f₁ + f₂ ≤ f₁ + t₂ := Nat.add_le_add_left h3 f₁
    have hT12Le : f₁ + t₂ ≤ sv.len := by
      have hStep1 : f₁ + t₂ ≤ f₁ + (t₁ - f₁) := Nat.add_le_add_left h4 f₁
      rw [Nat.add_sub_of_le h1] at hStep1
      exact Nat.le_trans hStep1 h2
    have hSv2Sum : sv₂.start + sv₂.len = sv.start + (f₁ + t₂) := by
      dsimp [sv₂]
      rw [Nat.add_assoc (sv.start + f₁) f₂ (t₂ - f₂), Nat.add_sub_of_le h3, Nat.add_assoc]
    have hSv2Le : sv₂.start + sv₂.len ≤ sv.start + sv.len := by
      rw [hSv2Sum]
      exact Nat.add_le_add_left hT12Le sv.start
    have hSv2Lt : sv₂.start + sv₂.len < maxUsize :=
      Nat.lt_of_le_of_lt hSv2Le hBoundLt
    refine ⟨sv₁, sv₂, ?_, ?_, ?_, rfl, hSv2Lt⟩
    · unfold evalSubsliceVal
      rw [hBound]
      dsimp
      rw [le_nat_ble h1, le_nat_ble h2]
      rfl
    · unfold evalSubsliceVal
      rw [hSv1Bound]
      dsimp
      rw [le_nat_ble h3, le_nat_ble h4]
      rfl
    · unfold evalSubsliceVal
      rw [hBound]
      dsimp
      rw [le_nat_ble hF12Le, le_nat_ble hT12Le]
      dsimp [sv₂]
      rw [Nat.add_assoc sv.start f₁ f₂, Nat.add_sub_add_left f₁ t₂ f₂]

