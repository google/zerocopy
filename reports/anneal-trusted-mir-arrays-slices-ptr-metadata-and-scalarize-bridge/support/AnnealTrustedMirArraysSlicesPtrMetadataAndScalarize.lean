                          · intro r hr
                            have hGe : pack.bodySrc.locals.length + 1 + (0 + pack.len) ≤
                                pack.bodySrc.locals.length + 1 + pack.len + r := by
                              rw [Nat.zero_add]; exact Nat.le_add_right _ r
                            rw [hCopy.2.2.2.2 _ hGe]
                            change ∃ ov, Trusted.MirSemantics.getElem? slots₂Live _ = some (.baseSlot (.live ov))
                            rw [hLivePres.2.2.1 r hr]
                            exact hLMVal.2.2.2 r hr
                        have hLenNext' : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
                            (.repeatArray a op)).length =
                            (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
                              (bbSrc.statements.take (f₁.stmtIdx + 1))).length := by
                          rw [hGen]; exact hLenNext
                        exact arrSc_reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hLeNext hLenNext'
                          hReachFull hLM'
                    · intro out hDone
                      rw [hEvSrc] at hDone
                      dsimp [evalArrSliceStmt] at hDone
                      rw [hEqArr, pack.hArrDecl] at hDone; dsimp at hDone
                      rw [hOp.1] at hDone; dsimp at hDone
                      rw [hArrSl.1] at hDone; dsimp at hDone
                      cases hSD : setElem? slots₁Mid plan.arrLocal (.liveArray (listReplicate pack.len (some v))) with
                      | none => rw [hSD] at hDone; cases hDone
                      | some _ => rw [hSD] at hDone; cases hDone
                    · intro k hFault
                      rw [hEvSrc] at hFault
                      dsimp [evalArrSliceStmt] at hFault
                      rw [hEqArr, pack.hArrDecl] at hFault; dsimp at hFault
                      rw [hOp.1] at hFault; dsimp at hFault
                      rw [hArrSl.1] at hFault; dsimp at hFault
                      have hLtArr : plan.arrLocal < slots₁Mid.length := by
                        rw [hLMVal.1.1]; exact pack.hLocLt
                      cases hSet₁ : setElem? slots₁Mid plan.arrLocal (.liveArray (listReplicate pack.len (some v))) with
                      | some _ => rw [hSet₁] at hFault; cases hFault
                      | none =>
                        cases lt_setElem?_some slots₁Mid plan.arrLocal _ hLtArr with
                        | intro _ hS => rw [hS] at hSet₁; cases hSet₁

private theorem arrSc_sim_stmt_arrayLivenessCheck
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (a : LocalId)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.arrayLivenessCheck a))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.arrayLivenessCheck a) = true)
    (hGetGen : ∀ j : Nat, j < (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.arrayLivenessCheck a)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.arrayLivenessCheck a)) j)
    (hLenNext : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.arrayLivenessCheck a)).length =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  have hLtA : a < pack.bodySrc.locals.length := nat_blt_lt hBnd
  cases s4b_arrSc_nat_eq_or_ne a plan.arrLocal with
  | inr hNeArr =>
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.arrayLivenessCheck a) =
        [.arrayLivenessCheck a] := by
      dsimp [lowerStmtForArray]; rw [nat_beq_false hNeArr]; rfl
    rw [hGen] at hGetGen hLenNext
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.arrayLivenessCheck a) := by
      have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
    have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtA hNeArr
    have hSlEq := hLM.1.2 a hLtA hNeArr
    refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
      hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
    · intro s₁' h
      dsimp [evalArrSliceStmt] at h
      cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
      | none => rw [hDecl] at h; cases h
      | some d =>
        rw [hDecl] at hDeclEq; rw [hDecl] at h
        cases d with
        | base _ | sliceView _ => cases h
        | array _ _ =>
          cases hSl : Trusted.MirSemantics.getElem? f₁.locals a with
          | none => rw [hSl] at h; cases h
          | some sl =>
            rw [hSl] at h
            cases sl with
            | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
            | liveArray _ =>
              have hsEq := StepResult.step.inj h
              refine ⟨f₁.locals, f₂.locals, hsEq.symm, ?_, hLM⟩
              dsimp [evalArrSliceStmt]
              rw [hDeclEq, hSlEq, hSl]
    · intro out h
      dsimp [evalArrSliceStmt] at h
      cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
      | none => rw [hD] at h; cases h
      | some d =>
        rw [hD] at h
        cases d with
        | base _ | sliceView _ => cases h
        | array _ _ =>
          cases hSl : Trusted.MirSemantics.getElem? f₁.locals a with
          | none => rw [hSl] at h; cases h
          | some sl =>
            rw [hSl] at h
            cases sl with
            | baseSlot _ | arrDead | sliceDead | liveSlice _ => cases h
            | liveArray _ => cases h
    · intro k h
      dsimp [evalArrSliceStmt] at h; dsimp [evalArrSliceStmt]
      rw [hDeclEq, hSlEq]
      cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
      | none => rw [hD] at h; exact h
      | some d =>
        rw [hD] at h
        cases d with
        | base _ | sliceView _ => exact h
        | array _ _ =>
          cases hSl : Trusted.MirSemantics.getElem? f₁.locals a with
          | none => rw [hSl] at h; exact h
          | some sl =>
            rw [hSl] at h
            cases sl with
            | baseSlot _ | arrDead | sliceDead | liveSlice _ => exact h
            | liveArray _ => cases h
  | inl hEqArr =>
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.arrayLivenessCheck a) =
        [mkLivenessCheckStmt pack.bodySrc.locals.length] := by
      dsimp [lowerStmtForArray]; rw [nat_beq_true hEqArr]; rfl
    rw [hGen] at hGetGen hLenNext
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (mkLivenessCheckStmt pack.bodySrc.locals.length) := by
      have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
    have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
      getElem?_some_lt bbSrc.statements f₁.stmtIdx _ hStmtSrc
    have hEvSrc := arrSc_evalStepArrSlice_at_stmt pSrc pack.bodySrc f₁ cm bbSrc _ hBodySrc hBbSrc hStmtSrc
    have hDeclLive := arrSc_getElem?_bodyTgt_locals_liveLoc pack
    cases hLM.2.2.1 with
    | intro arrSl hArrSl =>
      cases arrSl with
      | baseSlot _ | sliceDead | liveSlice _ => exact False.elim hArrSl.2
      | arrDead =>
        have hDead := arrSc_step_mkLivenessCheckStmt_dead pTgt pack.bodyTgt bbTgt f₂ cm
          pack.bodySrc.locals.length hBodyTgt hBbTgt hGetTgt hDeclLive hArrSl.2.1
        refine ⟨?_, ?_, ?_⟩
        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
          rw [hEqArr, pack.hArrDecl, hArrSl.1] at h; cases h
        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
          rw [hEqArr, pack.hArrDecl, hArrSl.1] at h; cases h
        · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
          rw [hEqArr, pack.hArrDecl, hArrSl.1] at h
          have hEqK := StepResult.fault.inj h; rw [← hEqK]
          exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
            (stepArrSlice_iff_evalStep pTgt { frames := [f₂], callerMem := cm } (.fault _)).mpr hDead⟩
      | liveArray elems =>
        cases arrSc_step_mkLivenessCheckStmt_live pTgt pack.bodyTgt bbTgt f₂ cm
            pack.bodySrc.locals.length (some .unit) hBodyTgt hBbTgt hGetTgt hDeclLive hArrSl.2.2.1 with
        | intro slots₂' hLiveStep =>
          have hLivePres := s4b_arrSc_localMatch_set_liveLoc_unit pack hLM hLiveStep.1
          have hLM' : arrSc_LocalMatch pack f₁.locals slots₂' := by
            refine ⟨⟨hLM.1.1, fun i hi hNe => ?_⟩, ?_, ?_, ?_⟩
            · rw [hLivePres.1 i hi]; exact hLM.1.2 i hi hNe
            · rw [hLivePres.2.2.2, hLM.2.1]
            · refine ⟨.liveArray elems, hArrSl.1, hArrSl.2.1, ?_, fun j hj => ?_⟩
              · exact getElem?_setElem?_self f₂.locals pack.bodySrc.locals.length
                  (.baseSlot (.live (some .unit))) slots₂' hLiveStep.1
              · rw [hLivePres.2.1 j hj]; exact hArrSl.2.2.2 j hj
            · intro r hr; rw [hLivePres.2.2.1 r hr]; exact hLM.2.2.2 r hr
          refine ⟨?_, ?_, ?_⟩
          · intro s₁' h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
            rw [hEqArr, pack.hArrDecl, hArrSl.1] at h
            have hsEq := StepResult.step.inj h; rw [← hsEq]
            exact arrSc_reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hLeNext hLenNext
              (arrSc_reachesNArrSlice_one_step hLiveStep.2) hLM'
          · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
            rw [hEqArr, pack.hArrDecl, hArrSl.1] at h; cases h
          · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceStmt] at h
            rw [hEqArr, pack.hArrDecl, hArrSl.1] at h; cases h

private theorem arrSc_sim_stmt_readArrayConst
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (dst a : LocalId) (idx : Nat) (isMove : Bool)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.readArrayConst dst a idx isMove))
    (hBnd : arrSliceStmtLocalsInBounds pack.bodySrc.locals.length (.readArrayConst dst a idx isMove) = true)
    (hChk : checkStmtForArray pack.bodySrc.locals plan.arrLocal pack.elemTy pack.len (.readArrayConst dst a idx isMove) = true)
    (hGetGen : ∀ j : Nat, j < (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.readArrayConst dst a idx isMove)).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.readArrayConst dst a idx isMove)) j)
    (hLenNext : f₂.stmtIdx + (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.readArrayConst dst a idx isMove)).length =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  have hBndAnd := (bool_and_eq_true _ _).mp hBnd
  have hLtDst : dst < pack.bodySrc.locals.length := nat_blt_lt hBndAnd.1
  have hLtA : a < pack.bodySrc.locals.length := nat_blt_lt hBndAnd.2
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    getElem?_some_lt bbSrc.statements f₁.stmtIdx _ hStmtSrc
  cases s4b_arrSc_nat_eq_or_ne a plan.arrLocal with
  | inr hNeArr =>
    dsimp [checkStmtForArray] at hChk
    rw [nat_beq_false hNeArr] at hChk; dsimp at hChk
    have hNeDst : dst ≠ plan.arrLocal := fun h => by
      have hT := nat_beq_true h; rw [hT] at hChk; cases hChk
    have hGen : lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len (.readArrayConst dst a idx isMove) =
        [.readArrayConst dst a idx isMove] := by
      dsimp [lowerStmtForArray]; rw [nat_beq_false hNeArr]; rfl
    rw [hGen] at hGetGen hLenNext
    have hGetTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.readArrayConst dst a idx isMove) := by
      have h0 := hGetGen 0 (Nat.zero_lt_succ 0); rw [Nat.add_zero] at h0; exact h0
    have hDeclDstEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtDst hNeDst
    have hDeclAEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtA hNeArr
    have hSlAEq := hLM.1.2 a hLtA hNeArr
    refine arrSc_sim_stmt_one pack hSame hSame₂ hBbEq hBbSrc hStmtSrc hLenNext
      hBodySrc hBodyTgt hBbTgt hGetTgt ⟨?_, ?_, ?_⟩
    · intro s₁' h
      dsimp [evalArrSliceStmt] at h
      cases hDDst : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with
      | none => rw [hDDst] at h; cases h
      | some dDst =>
        rw [hDDst] at hDeclDstEq; rw [hDDst] at h
        cases dDst with
        | array _ _ | sliceView _ => cases h
        | base dstTy =>
          cases hDA : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
          | none => rw [hDA] at h; cases h
          | some dA =>
            rw [hDA] at hDeclAEq; rw [hDA] at h
            cases dA with
            | base _ | sliceView _ => cases h
            | array elemTy' len' =>
              cases hSlA : Trusted.MirSemantics.getElem? f₁.locals a with
              | none => rw [hSlA] at h; cases h
              | some slA =>
                rw [hSlA] at h
                cases slA with
                | baseSlot _ | sliceDead | liveSlice _ => cases h
                | arrDead =>
                  dsimp at h
                  cases hB2 : MirTy.beq dstTy elemTy' with
                  | true => rw [hB2] at h; cases h
                  | false => rw [hB2] at h; cases h
                | liveArray elems =>
                  dsimp at h
                  cases hTy : !MirTy.beq dstTy elemTy' with
                  | true => rw [hTy] at h; cases h
                  | false =>
                    rw [hTy] at h; dsimp at h
                    cases hIn : !Nat.blt idx len' with
                    | true => rw [hIn] at h; cases h
                    | false =>
                      rw [hIn] at h; dsimp at h
                      cases hEl : Trusted.MirSemantics.getElem? elems idx with
                      | none => rw [hEl] at h; cases h
                      | some ov =>
                        rw [hEl] at h
                        cases ov with
                        | none => cases h
                        | some v =>
                          dsimp at h
                          have hAfterBox : ∃ slots₁R slots₂R : List ArrSliceSlot,
                              (if isMove then
                                match setElem? elems idx (initElemOptVal elemTy') with
                                | some elems' => setElem? f₁.locals a (.liveArray elems')
                                | none => none
                              else some f₁.locals) = some slots₁R ∧
                              (if isMove then
                                match setElem? elems idx (initElemOptVal elemTy') with
                                | some elems' => setElem? f₂.locals a (.liveArray elems')
                                | none => none
                              else some f₂.locals) = some slots₂R ∧
                              arrSc_LocalMatch pack slots₁R slots₂R := by
                            cases isMove with
                            | false => exact ⟨f₁.locals, f₂.locals, rfl, rfl, hLM⟩
                            | true =>
                              dsimp
                              cases hSetEl : setElem? elems idx (initElemOptVal elemTy') with
                              | none => rw [hSetEl] at h; cases h
                              | some elems' =>
                                have hLt1 : a < f₁.locals.length := by rw [hLM.1.1]; exact hLtA
                                have hLt2 : a < f₂.locals.length := by
                                  rw [hLM.2.1]
                                  exact Nat.lt_of_lt_of_le hLtA (s4b_arrSc_le_bodyTgt_locals pack)
                                cases hS1 : setElem? f₁.locals a (.liveArray elems') with
                                | none =>
                                  cases lt_setElem?_some f₁.locals a (.liveArray elems') hLt1 with
                                  | intro _ hh => rw [hh] at hS1; cases hS1
                                | some sl1 =>
                                  cases hS2 : setElem? f₂.locals a (.liveArray elems') with
                                  | none =>
                                    cases lt_setElem?_some f₂.locals a (.liveArray elems') hLt2 with
                                    | intro _ hh => rw [hh] at hS2; cases hS2
                                  | some sl2 =>
                                    refine ⟨sl1, sl2, ?_, ?_,
                                      s4b_arrSc_localMatch_set_prefix_other pack hLM hLtA hNeArr hS1 hS2⟩
                                    · dsimp; exact hS1
                                    · dsimp; exact hS2
                          cases hAfterBox with
                          | intro slots₁R h1 => cases h1 with
                          | intro slots₂R hR =>
                            have hHStep :
                                (match writeArrSliceBasePlace slots₁R dst dstTy v with
                                | .error k => StepResult.fault k
                                | .ok slots' => stepStmtNext f₁ cm slots') = .step s₁' := by
                              cases hMv : isMove
                              · have hRt := hR.1; rw [hMv] at hRt; dsimp at hRt
                                cases Option.some.inj hRt
                                rw [hMv] at h; dsimp at h; exact h
                              · have hRt := hR.1; rw [hMv] at hRt; dsimp at hRt
                                rw [hMv] at h; dsimp at h
                                cases hSetEl : setElem? elems idx (initElemOptVal elemTy') with
                                | none => rw [hSetEl] at hRt; dsimp at hRt; cases hRt
                                | some elems' =>
                                  rw [hSetEl] at h hRt; dsimp at h; dsimp at hRt
                                  cases hS1 : setElem? f₁.locals a (.liveArray elems') with
                                  | none => rw [hS1] at hRt; cases hRt
                                  | some _ =>
                                    rw [hS1] at h hRt; dsimp at h; cases Option.some.inj hRt; exact h
                            cases arrSc_writeArrSliceBasePlace_prefix pack hR.2.2.1 dst hLtDst hNeDst dstTy v with
                            | inl hErrW =>
                              cases hErrW with
                              | intro _ hk => rw [hk.1] at hHStep; cases hHStep
                            | inr hOkW =>
                              cases hOkW with
                              | intro slots₁' h2 => cases h2 with
                              | intro slots₂' hW =>
                                rw [hW.1] at hHStep
                                have hsEq := StepResult.step.inj hHStep
                                have hLM' := arrSc_localMatch_lift_prefix pack hR.2.2
                                  hW.2.2.1 hW.2.2.2.1 hW.2.2.2.2.1 hW.2.2.2.2.2.1
                                refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                                dsimp [evalArrSliceStmt]
                                rw [hDeclDstEq, hDeclAEq, hSlAEq, hSlA]; dsimp
                                rw [hTy]; dsimp; rw [hIn]; dsimp; rw [hEl]; dsimp
                                have hTRt : (if isMove then
                                    match setElem? elems idx (initElemOptVal elemTy') with
                                    | some elems' => setElem? f₂.locals a (.liveArray elems')
                                    | none => none
                                  else some f₂.locals) = some slots₂R := hR.2.1
                                cases hMv : isMove
                                · have hRt2 := hTRt; rw [hMv] at hRt2; dsimp at hRt2
                                  cases Option.some.inj hRt2; dsimp; rw [hW.2.1]
                                · have hRt2 := hTRt; rw [hMv] at hRt2; dsimp at hRt2
                                  dsimp
                                  cases hSetEl : setElem? elems idx (initElemOptVal elemTy') with
                                  | none => rw [hSetEl] at hRt2; dsimp at hRt2; cases hRt2
                                  | some elems' =>
                                    rw [hSetEl] at hRt2; dsimp at hRt2; dsimp
                                    cases hS2 : setElem? f₂.locals a (.liveArray elems') with
                                    | none => rw [hS2] at hRt2; cases hRt2
                                    | some _ => rw [hS2] at hRt2; cases Option.some.inj hRt2; dsimp; rw [hW.2.1]
    · intro out h
      dsimp [evalArrSliceStmt] at h
      cases hDD : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with
      | none => rw [hDD] at h; cases h
      | some dDst =>
        rw [hDD] at h
        cases dDst with
        | array _ _ | sliceView _ => cases h
        | base dstTy =>
          cases hDA : Trusted.MirSemantics.getElem? pack.bodySrc.locals a with
          | none => rw [hDA] at h; cases h
          | some dA =>
            rw [hDA] at h
            cases dA with
            | base _ | sliceView _ => cases h
            | array elemTy' len' =>
              cases hSA : Trusted.MirSemantics.getElem? f₁.locals a with
              | none => rw [hSA] at h; cases h
              | some slA =>
                rw [hSA] at h
                cases slA with
                | baseSlot _ | sliceDead | liveSlice _ => cases h
                | arrDead =>
                  dsimp at h
                  cases hBM : MirTy.beq dstTy elemTy' with
                  | true => rw [hBM] at h; cases h
                  | false => rw [hBM] at h; cases h
                | liveArray elems =>
                  dsimp at h
                  cases hTy : !MirTy.beq dstTy elemTy' with
                  | true => rw [hTy] at h; cases h
                  | false =>
                    rw [hTy] at h; dsimp at h
                    cases hIn : !Nat.blt idx len' with
                    | true => rw [hIn] at h; cases h
