-- Section 6: Liveness Check Helpers, Simulation Relation, and Init Preservation
-- ============================================================================

private theorem step_arrayLivenessCheck_dead (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (arrLoc : LocalId) (elemTy : MirTy) (len : Nat)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (.arrayLivenessCheck arrLoc))
    (hDecl : Trusted.MirSemantics.getElem? body.locals arrLoc = some (.array elemTy len))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals arrLoc = some .arrDead) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      StepResult.fault FaultKind.undefined := by
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt,
      evalArrSliceStmt_arrayLivenessCheck, hDecl, hSlot]

private theorem step_arrayLivenessCheck_live (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (cm : CallerMemory)
    (arrLoc : LocalId) (elemTy : MirTy) (len : Nat) (elems : List (Option Val))
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some (.arrayLivenessCheck arrLoc))
    (hDecl : Trusted.MirSemantics.getElem? body.locals arrLoc = some (.array elemTy len))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals arrLoc = some (.liveArray elems)) :
    evalStepArrSlice p 0 { frames := [frame], callerMem := cm } =
      stepStmtNext frame cm frame.locals := by
  rw [evalStepArrSlice_at_stmt p body bb frame cm _ hBody hBb hStmt,
      evalArrSliceStmt_arrayLivenessCheck, hDecl, hSlot]

private noncomputable def backingTag : SliceBacking → Nat
  | .dangling => 0
  | .arrayLocal _ => 1

private noncomputable def SliceCompRel (base : Nat) (slots₂ : List ArrSliceSlot)
    (k : Nat) (optArr : Option LocalId) : ArrSliceSlot → Prop
  | .sliceDead =>
    let off := base + 4 * k
    Trusted.MirSemantics.getElem? slots₂ off = some (.baseSlot .dead) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 1) = some (.baseSlot .dead) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 2) = some (.baseSlot .dead) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 3) = some (.baseSlot .dead)
  | .liveSlice none =>
    let off := base + 4 * k
    (∃ ov, Trusted.MirSemantics.getElem? slots₂ off = some (.baseSlot (.live ov))) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 1) = some (.baseSlot (.live none)) ∧
    (∃ ov2, Trusted.MirSemantics.getElem? slots₂ (off + 2) = some (.baseSlot (.live ov2))) ∧
    (∃ ov3, Trusted.MirSemantics.getElem? slots₂ (off + 3) = some (.baseSlot (.live ov3)))
  | .liveSlice (some sv) =>
    let off := base + 4 * k
    sv.start + sv.len < maxUsize ∧
    (sv.backing = .dangling ∨ ∃ arrLoc, optArr = some arrLoc ∧ sv.backing = .arrayLocal arrLoc) ∧
    (∃ ov, Trusted.MirSemantics.getElem? slots₂ off = some (.baseSlot (.live ov))) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 1) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false
        (BitVec.ofNat 128 (backingTag sv.backing))))))) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 2) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false
        (BitVec.ofNat 128 sv.start)))))) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 3) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false
        (BitVec.ofNat 128 sv.len))))))
  | _ => False

private noncomputable def SliceLocalMatch
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (slots₁ slots₂ : List ArrSliceSlot) : Prop :=
  PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁ slots₂ ∧
  slots₂.length = pack.bodyTgt.locals.length ∧
  (∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
    ∃ sl₁, Trusted.MirSemantics.getElem? slots₁ sLoc = some sl₁ ∧
      SliceCompRel pack.bodySrc.locals.length slots₂ k optArr sl₁) ∧
  (∀ r, r < 5 →
    ∃ ov, Trusted.MirSemantics.getElem? slots₂
        (pack.bodySrc.locals.length + 4 * plan.entries.length + r) =
      some (.baseSlot (.live ov)))

private noncomputable def SliceFrameRel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (f₁ f₂ : ArrSliceFrame) : Prop :=
  (f₁.defId = plan.defId ∧
    f₂.defId = plan.defId ∧
    f₂.blockIdx = f₁.blockIdx ∧
    SliceLocalMatch pack f₁.locals f₂.locals ∧
    match Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx with
    | none => True
    | some bb =>
      f₁.stmtIdx ≤ bb.statements.length ∧
      f₂.stmtIdx = (listFlatMap
        (lowerStmtForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
        (bb.statements.take f₁.stmtIdx)).length) ∨
  (f₁.defId ≠ plan.defId ∧ f₂ = f₁)

private noncomputable def SliceStateRel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (s₁ s₂ : ArrSliceState) : Prop :=
  s₂.callerMem = s₁.callerMem ∧
  match s₁.frames, s₂.frames with
  | [f₁], [f₂] => SliceFrameRel pack f₁ f₂
  | _, _ => False

private theorem sliceFrameRel_prefixSlotsMatch
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {f₁ f₂ : ArrSliceFrame} (hSame : f₁.defId = plan.defId)
    (hRel : SliceFrameRel pack f₁ f₂) :
    PrefixSlotsMatch pack.bodySrc.locals plan.entries f₁.locals f₂.locals := by
  cases hRel with
  | inl h => exact h.2.2.2.1.1
  | inr h => exact False.elim (h.1 hSame)

private noncomputable def initArrSliceSlotAt (body : ArrSliceBody) (args : List Val)
    (idx : Nat) (d : ArrSliceLocalDecl) : ArrSliceSlot :=
  if Nat.beq idx 0 then
    liveUninitArrSliceSlot d
  else if Nat.ble idx body.argumentCount then
    match Trusted.MirSemantics.getElem? args (idx - 1) with
    | some v => .baseSlot (.live (some v))
    | none => .baseSlot .dead
  else if arrSliceHasStorageAnnotation body idx then
    deadArrSliceSlot d
  else
    liveUninitArrSliceSlot d

private theorem initArrSliceLocalsLoop_cons (body : ArrSliceBody) (args : List Val)
    (idx : Nat) (d : ArrSliceLocalDecl) (rest : List ArrSliceLocalDecl) :
    initArrSliceLocalsLoop body args idx (d :: rest) =
      initArrSliceSlotAt body args idx d :: initArrSliceLocalsLoop body args (idx + 1) rest := rfl

private theorem initArrSliceLocalsLoop_length (body : ArrSliceBody) (args : List Val)
    (startIdx : Nat) (decls : List ArrSliceLocalDecl) :
    (initArrSliceLocalsLoop body args startIdx decls).length = decls.length := by
  induction decls generalizing startIdx with
  | nil => rfl
  | cons d rest ih =>
    rw [initArrSliceLocalsLoop_cons]
    exact congrArg Nat.succ (ih (startIdx + 1))

private theorem getElem?_initArrSliceLocalsLoop (body : ArrSliceBody) (args : List Val)
    (startIdx : Nat) (decls : List ArrSliceLocalDecl) (i : Nat) (d : ArrSliceLocalDecl)
    (hGet : Trusted.MirSemantics.getElem? decls i = some d) :
    Trusted.MirSemantics.getElem? (initArrSliceLocalsLoop body args startIdx decls) i =
      some (initArrSliceSlotAt body args (startIdx + i) d) := by
  induction decls generalizing startIdx i with
  | nil => cases hGet
  | cons a rest ih =>
    cases i with
    | zero =>
      injection hGet with ha
      rw [initArrSliceLocalsLoop_cons, ← ha, Nat.add_zero]
      rfl
    | succ i' =>
      rw [initArrSliceLocalsLoop_cons]
      change Trusted.MirSemantics.getElem?
        (initArrSliceLocalsLoop body args (startIdx + 1) rest) i' = _
      rw [ih (startIdx + 1) i' hGet, Nat.add_assoc, Nat.add_comm 1 i', ← Nat.add_assoc]

private theorem allArrSliceLocalsSupported_bodyTgt_iff
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) :
    allArrSliceLocalsSupported pack.bodyTgt.argumentCount 0 pack.bodyTgt.locals =
      allArrSliceLocalsSupported pack.bodySrc.argumentCount 0 pack.bodySrc.locals := by
  cases hSrc : allArrSliceLocalsSupported pack.bodySrc.argumentCount 0 pack.bodySrc.locals
  · cases hTgt : allArrSliceLocalsSupported pack.bodyTgt.argumentCount 0 pack.bodyTgt.locals
    · rfl
    · have hSrcTrue : allArrSliceLocalsSupported pack.bodySrc.argumentCount 0 pack.bodySrc.locals = true := by
        apply (allArrSliceLocalsSupported_iff pack.bodySrc.argumentCount 0 pack.bodySrc.locals).mpr
        intro i d hGet
        rw [Nat.zero_add]
        have hTgtPt := (allArrSliceLocalsSupported_iff pack.bodyTgt.argumentCount 0 pack.bodyTgt.locals).mp hTgt
        have hArgEq : pack.bodyTgt.argumentCount = pack.bodySrc.argumentCount := by
          rw [pack.hBodyTgt]
        have hi : i < pack.bodySrc.locals.length := getElem?_some_lt pack.bodySrc.locals i d hGet
        cases d with
        | base ty =>
          have hNone : findSliceEntry plan.entries i = none := by
            apply findSliceEntry_none_of_not_sliceView pack.hLoop
            intro sTy hS; rw [hGet] at hS; cases hS
          have hTgtGet := getElem?_bodyTgt_nonSlice pack hi hNone
          rw [hGet] at hTgtGet
          have hSup := hTgtPt i (.base ty) hTgtGet
          rw [hArgEq, Nat.zero_add] at hSup
          exact hSup
        | array elemTy len =>
          have hNone : findSliceEntry plan.entries i = none := by
            apply findSliceEntry_none_of_not_sliceView pack.hLoop
            intro sTy hS; rw [hGet] at hS; cases hS
          have hTgtGet := getElem?_bodyTgt_nonSlice pack hi hNone
          rw [hGet] at hTgtGet
          have hSup := hTgtPt i (.array elemTy len) hTgtGet
          rw [hArgEq, Nat.zero_add] at hSup
          exact hSup
        | sliceView sTy =>
          have hEx := findSliceEntry_of_sliceView pack.hLoop hGet
          cases hEx with | intro k hK =>
          cases hK with | intro optArr hFind =>
          have hVal := findSliceEntry_some_lt_and_valid pack.hLoop hFind
          cases hVal.2 with | intro e hE =>
          have hValid := hE.2.2.2
          have hArgLt : pack.bodySrc.argumentCount < i := by
            rw [← hE.2.1]; exact hValid.2.1
          cases hValid.2.2 with | intro sTy' hs =>
          have hGet2 : Trusted.MirSemantics.getElem? pack.bodySrc.locals i =
              some (ArrSliceLocalDecl.sliceView sTy') := by
            rw [← hE.2.1]; exact hs.1
          rw [hGet] at hGet2
          injection hGet2 with hSV
          injection hSV with hTyEq
          rw [hTyEq]
          change (pack.bodySrc.argumentCount.blt i && isSupportedScalarOrUnitTy sTy') = true
          apply (bool_and_eq_true _ _).mpr
          exact ⟨lt_nat_blt hArgLt, hs.2.1⟩
      rw [hSrcTrue] at hSrc
      cases hSrc
  · exact allArrSliceLocalsSupported_bodyTgt pack hSrc

private noncomputable def initStateArrSliceBody (defId : DefId) (body : ArrSliceBody) (q : Query) :
    Except FaultKind ArrSliceState :=
  if body.basicBlocks.isEmpty then
    .error .unsupported
  else if !Nat.blt body.argumentCount body.locals.length then
    .error .unsupported
  else if !arrSliceStorageAnnotationsInBounds body then
    .error .unsupported
  else if !allArrSliceLocalsSupported body.argumentCount 0 body.locals then
    .error .unsupported
  else
    match arrSliceParamBaseTys? body with
    | none => .error .unsupported
    | some paramTys =>
      if !checkArgsMatch q.args paramTys then
        .error .unsupported
      else
        let frame : ArrSliceFrame := {
          defId := defId
          blockIdx := 0
          stmtIdx := 0
          locals := initArrSliceLocalsLoop body q.args 0 body.locals
        }
        .ok { frames := [frame], callerMem := q.callerMem }

private theorem initStateArrSlice_eq (p : ArrSliceProgram) (q : Query) :
    initStateArrSlice p q =
      if !Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1 then
        .error .unsupported
      else if !q.callerMem.allocations.isEmpty then
        .error .unsupported
      else
        match Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
        | none => .error .unsupported
        | some body => initStateArrSliceBody p.entryDefId body q := rfl

private theorem initStateArrSliceBody_tgt_check_eq
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) :
    pack.bodyTgt.basicBlocks.isEmpty = false ∧
    Nat.blt pack.bodyTgt.argumentCount pack.bodyTgt.locals.length = true ∧
    arrSliceStorageAnnotationsInBounds pack.bodyTgt = true := by
  refine ⟨?_, ?_, arrSliceStorageAnnotationsInBounds_bodyTgt pack⟩
  · rw [pack.hBodyTgt]
    cases hBbs : pack.bodySrc.basicBlocks with
    | nil =>
      have hEmp := pack.hNonEmpty
      rw [hBbs] at hEmp
      cases hEmp
    | cons _ _ => rfl
  · have hArgEq : pack.bodyTgt.argumentCount = pack.bodySrc.argumentCount := by rw [pack.hBodyTgt]
    rw [hArgEq, bodyTgt_locals_length pack]
    apply lt_nat_blt
    exact Nat.lt_of_lt_of_le pack.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))

private theorem initStateArrSlice_ne_eq
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (hNe : pSrc.entryDefId ≠ plan.defId) (q : Query) :
    initStateArrSlice pTgt q = initStateArrSlice pSrc q := by
  rw [initStateArrSlice_eq, initStateArrSlice_eq, pack.hPtrBits, pack.hProfile, pack.hEntryId,
      getElem?_pTgt_bodies_ne pack pSrc.entryDefId hNe]

private theorem initStateArrSlice_same_eq
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (hSame : pSrc.entryDefId = plan.defId) (q : Query) :
    (∀ k, initStateArrSlice pSrc q = .error k → initStateArrSlice pTgt q = .error k) ∧
    (∀ k, initStateArrSlice pTgt q = .error k → initStateArrSlice pSrc q = .error k) ∧
    (∀ s₁, initStateArrSlice pSrc q = .ok s₁ →
      ∃ s₂, initStateArrSlice pTgt q = .ok s₂ ∧ SliceStateRel pack s₁ s₂) := by
  rw [initStateArrSlice_eq pSrc q, initStateArrSlice_eq pTgt q]
  rw [pack.hPtrBits, pack.hProfile, pack.hEntryId, hSame]
  rw [pack.hGetBody, getElem?_pTgt_bodies_eq pack]
  cases hHdr : (!pSrc.pointerWidthBits.beq 64 || !pSrc.mirProfileVersion.beq 1) with
  | true =>
    dsimp
    refine ⟨fun k hk => hk, fun k hk => hk, fun s₁ hOk => by cases hOk⟩
  | false =>
    dsimp
    cases hAlloc : (!q.callerMem.allocations.isEmpty) with
    | true =>
      dsimp
      refine ⟨fun k hk => hk, fun k hk => hk, fun s₁ hOk => by cases hOk⟩
    | false =>
      dsimp
      dsimp [initStateArrSliceBody]
      have hChecks := initStateArrSliceBody_tgt_check_eq pack
      have hNegEmpSrc : pack.bodySrc.basicBlocks.isEmpty = false := pack.hNonEmpty
      have hNegEmpTgt : pack.bodyTgt.basicBlocks.isEmpty = false := hChecks.1
      have hNegArgSrc : (!pack.bodySrc.argumentCount.blt pack.bodySrc.locals.length) = false := by
        rw [lt_nat_blt pack.hArgLt]; rfl
      have hNegArgTgt : (!pack.bodyTgt.argumentCount.blt pack.bodyTgt.locals.length) = false := by
        rw [hChecks.2.1]; rfl
      have hNegStorSrc : (!arrSliceStorageAnnotationsInBounds pack.bodySrc) = false := by
        rw [pack.hStor]; rfl
      have hNegStorTgt : (!arrSliceStorageAnnotationsInBounds pack.bodyTgt) = false := by
        rw [hChecks.2.2]; rfl
      rw [hNegEmpSrc, hNegEmpTgt, hNegArgSrc, hNegArgTgt, hNegStorSrc, hNegStorTgt]
      dsimp
      rw [allArrSliceLocalsSupported_bodyTgt_iff pack, arrSliceParamBaseTys?_bodyTgt pack]
      cases hSup : (!allArrSliceLocalsSupported pack.bodySrc.argumentCount 0 pack.bodySrc.locals) with
      | true =>
        dsimp
        refine ⟨fun k hk => hk, fun k hk => hk, fun s₁ hOk => by cases hOk⟩
      | false =>
        dsimp
        cases hPT : arrSliceParamBaseTys? pack.bodySrc with
        | none =>
          dsimp
          refine ⟨fun k hk => hk, fun k hk => hk, fun s₁ hOk => by cases hOk⟩
        | some paramTys =>
          dsimp
          cases hArgs : (!checkArgsMatch q.args paramTys) with
          | true =>
            dsimp
            refine ⟨fun k hk => hk, fun k hk => hk, fun s₁ hOk => by cases hOk⟩
          | false =>
            dsimp
            refine ⟨(fun k hk => by cases hk), (fun k hk => by cases hk), ?_⟩
            intro s₁ hOk
            injection hOk with hsEq
            rw [← hsEq]
            let f₁ : ArrSliceFrame := {
              defId := plan.defId, blockIdx := 0, stmtIdx := 0,
              locals := initArrSliceLocalsLoop pack.bodySrc q.args 0 pack.bodySrc.locals
            }
            let f₂ : ArrSliceFrame := {
              defId := plan.defId, blockIdx := 0, stmtIdx := 0,
              locals := initArrSliceLocalsLoop pack.bodyTgt q.args 0 pack.bodyTgt.locals
            }
            refine ⟨{ frames := [f₂], callerMem := q.callerMem }, rfl, rfl, ?_⟩
            apply Or.inl
            refine ⟨rfl, rfl, rfl, ?_, ?_⟩
            · have hArgEq : pack.bodyTgt.argumentCount = pack.bodySrc.argumentCount := by rw [pack.hBodyTgt]
              have hLen1 : f₁.locals.length = pack.bodySrc.locals.length :=
                initArrSliceLocalsLoop_length pack.bodySrc q.args 0 pack.bodySrc.locals
              have hLen2 : f₂.locals.length = pack.bodyTgt.locals.length :=
                initArrSliceLocalsLoop_length pack.bodyTgt q.args 0 pack.bodyTgt.locals
              refine ⟨⟨hLen1, ?_⟩, hLen2, ?_, ?_⟩
              · intro i hi hNone
                have hExD := getElem?_lt_some pack.bodySrc.locals i hi
                cases hExD with | intro d hD =>
                have hDTgt := getElem?_bodyTgt_nonSlice pack hi hNone
                rw [hD] at hDTgt
                have hG1 := getElem?_initArrSliceLocalsLoop pack.bodySrc q.args 0 pack.bodySrc.locals i d hD
                have hG2 := getElem?_initArrSliceLocalsLoop pack.bodyTgt q.args 0 pack.bodyTgt.locals i d hDTgt
                rw [Nat.zero_add] at hG1 hG2
                change Trusted.MirSemantics.getElem? f₁.locals i = _ at hG1
                change Trusted.MirSemantics.getElem? f₂.locals i = _ at hG2
                rw [hG1, hG2]
                dsimp [initArrSliceSlotAt]
                rw [hArgEq, arrSliceHasStorageAnnotation_bodyTgt_nonSlice pack hi hNone]
              · intro sLoc k optArr hFind
                have hValid := findSliceEntry_some_lt_and_valid pack.hLoop hFind
                have hk : k < plan.entries.length := hValid.1
                cases hValid.2 with | intro e hE =>
                have hSLocEq : e.sliceLocal = sLoc := hE.2.1
                have hArgLt : pack.bodySrc.argumentCount < sLoc := by
                  rw [← hSLocEq]; exact hE.2.2.2.2.1
                cases hE.2.2.2.2.2 with | intro sTy hs =>
                have hSrcDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                  rw [← hSLocEq]; exact hs.1
                have hG1 := getElem?_initArrSliceLocalsLoop pack.bodySrc q.args 0 pack.bodySrc.locals sLoc (.sliceView sTy) hSrcDecl
                rw [Nat.zero_add] at hG1
                have hPos : 0 < sLoc := Nat.lt_of_le_of_lt (Nat.zero_le _) hArgLt
                have hNeqZero : Nat.beq sLoc 0 = false := nat_beq_false (Nat.ne_of_gt hPos)
                have hBleFalse : Nat.ble sLoc pack.bodySrc.argumentCount = false := by
                  cases hb : Nat.ble sLoc pack.bodySrc.argumentCount with
                  | false => rfl
                  | true =>
                    exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb) hArgLt)
                dsimp [initArrSliceSlotAt] at hG1
                rw [hNeqZero, hBleFalse] at hG1
                dsimp at hG1
                have hCompHelper : ∀ r, r < 4 →
                    ∃ declR,
                      Trusted.MirSemantics.getElem? pack.bodyTgt.locals (pack.bodySrc.locals.length + 4 * k + r) = some declR ∧
                      deadArrSliceSlot declR = .baseSlot .dead ∧
                      liveUninitArrSliceSlot declR =
                        .baseSlot (.live (match r with | 0 => some .unit | _ => none)) := by
                  intro r hr
                  have hDeclR := getElem?_bodyTgt_locals_comp pack hk hr
                  cases r with
                  | zero => exact ⟨.base .unit, hDeclR, rfl, rfl⟩
                  | succ r1 =>
                    cases r1 with
                    | zero => exact ⟨.base usizeTy, hDeclR, rfl, rfl⟩
                    | succ r2 =>
                      cases r2 with
                      | zero => exact ⟨.base usizeTy, hDeclR, rfl, rfl⟩
                      | succ _ => exact ⟨.base usizeTy, hDeclR, rfl, rfl⟩
                have hSlotR : ∀ r, r < 4 →
                    Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 4 * k + r) =
                      some (if arrSliceHasStorageAnnotation pack.bodySrc sLoc = true
                        then .baseSlot .dead
                        else .baseSlot (.live (match r with | 0 => some .unit | _ => none))) := by
                  intro r hr
                  have hDR := hCompHelper r hr
                  cases hDR with | intro declR hDeclR =>
                  have hGR := getElem?_initArrSliceLocalsLoop pack.bodyTgt q.args 0 pack.bodyTgt.locals
                    (pack.bodySrc.locals.length + 4 * k + r) declR hDeclR.1
                  rw [Nat.zero_add] at hGR
                  have hPosR : 0 < pack.bodySrc.locals.length + 4 * k + r :=
                    Nat.lt_of_le_of_lt (Nat.zero_le _)
                      (Nat.lt_of_lt_of_le pack.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)))
                  have hNeqZeroR : Nat.beq (pack.bodySrc.locals.length + 4 * k + r) 0 = false :=
                    nat_beq_false (Nat.ne_of_gt hPosR)
                  have hArgLtR : pack.bodyTgt.argumentCount < pack.bodySrc.locals.length + 4 * k + r := by
                    rw [hArgEq]
                    exact Nat.lt_of_lt_of_le pack.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
                  have hBleFalseR : Nat.ble (pack.bodySrc.locals.length + 4 * k + r) pack.bodyTgt.argumentCount = false := by
                    cases hb : Nat.ble (pack.bodySrc.locals.length + 4 * k + r) pack.bodyTgt.argumentCount with
                    | false => rfl
                    | true => exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb) hArgLtR)
                  dsimp [initArrSliceSlotAt] at hGR
                  rw [hNeqZeroR, hBleFalseR, arrSliceHasStorageAnnotation_bodyTgt_comp pack hFind hr] at hGR
                  dsimp at hGR
                  rw [hGR, hDeclR.2.1, hDeclR.2.2]
                cases hAnn : arrSliceHasStorageAnnotation pack.bodySrc sLoc with
                | true =>
                  rw [hAnn] at hG1
                  dsimp at hG1
                  refine ⟨.sliceDead, hG1, ?_⟩
                  dsimp [SliceCompRel]
                  have s0 := hSlotR 0 (by decide); rw [hAnn, Nat.add_zero] at s0
                  have s1 := hSlotR 1 (by decide); rw [hAnn] at s1
                  have s2 := hSlotR 2 (by decide); rw [hAnn] at s2
                  have s3 := hSlotR 3 (by decide); rw [hAnn] at s3
                  exact ⟨s0, s1, s2, s3⟩
                | false =>
                  rw [hAnn] at hG1
                  dsimp at hG1
                  refine ⟨.liveSlice none, hG1, ?_⟩
                  dsimp [SliceCompRel]
                  have s0 := hSlotR 0 (by decide); rw [hAnn, Nat.add_zero] at s0
                  have s1 := hSlotR 1 (by decide); rw [hAnn] at s1
                  have s2 := hSlotR 2 (by decide); rw [hAnn] at s2
                  have s3 := hSlotR 3 (by decide); rw [hAnn] at s3
                  exact ⟨⟨some .unit, s0⟩, s1, ⟨none, s2⟩, ⟨none, s3⟩⟩
              · intro r hr
                have hScrDecl := getElem?_bodyTgt_locals_scratch pack hr
                let declS := if Nat.beq r 4 = true then ArrSliceLocalDecl.base .bool else .base usizeTy
                have hGS := getElem?_initArrSliceLocalsLoop pack.bodyTgt q.args 0 pack.bodyTgt.locals
                  (pack.bodySrc.locals.length + 4 * plan.entries.length + r) declS hScrDecl
                rw [Nat.zero_add] at hGS
                have hPosS : 0 < pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
                  Nat.lt_of_le_of_lt (Nat.zero_le _)
                    (Nat.lt_of_lt_of_le pack.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)))
                have hNeqZeroS : Nat.beq (pack.bodySrc.locals.length + 4 * plan.entries.length + r) 0 = false :=
                  nat_beq_false (Nat.ne_of_gt hPosS)
                have hArgLtS : pack.bodyTgt.argumentCount < pack.bodySrc.locals.length + 4 * plan.entries.length + r := by
                  rw [hArgEq]
                  exact Nat.lt_of_lt_of_le pack.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
                have hBleFalseS : Nat.ble (pack.bodySrc.locals.length + 4 * plan.entries.length + r) pack.bodyTgt.argumentCount = false := by
                  cases hb : Nat.ble (pack.bodySrc.locals.length + 4 * plan.entries.length + r) pack.bodyTgt.argumentCount with
                  | false => rfl
                  | true => exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb) hArgLtS)
                dsimp [initArrSliceSlotAt] at hGS
                rw [hNeqZeroS, hBleFalseS, arrSliceHasStorageAnnotation_bodyTgt_scratch pack] at hGS
                dsimp at hGS
                have hLiveNone : liveUninitArrSliceSlot declS = .baseSlot (.live none) := by
                  dsimp [declS]
                  cases Nat.beq r 4 <;> rfl
                rw [hLiveNone] at hGS
                exact ⟨none, hGS⟩
            · cases Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks 0 with
              | none => exact True.intro
              | some _ => exact ⟨Nat.zero_le _, rfl⟩

private theorem initStateArrSlice_err_iff
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) (q : Query) :
    (∀ k, initStateArrSlice pSrc q = .error k → initStateArrSlice pTgt q = .error k) ∧
    (∀ k, initStateArrSlice pTgt q = .error k → initStateArrSlice pSrc q = .error k) := by
  cases Nat.decEq pSrc.entryDefId plan.defId with
  | isTrue hSame =>
    have hS := initStateArrSlice_same_eq pack hSame q
    exact ⟨hS.1, hS.2.1⟩
  | isFalse hNe =>
    rw [initStateArrSlice_ne_eq pack hNe q]
    exact ⟨fun _ h => h, fun _ h => h⟩

private theorem initStateArrSlice_ok_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) (q : Query) (s₁ : ArrSliceState)
    (hOk : initStateArrSlice pSrc q = .ok s₁) :
    ∃ s₂, initStateArrSlice pTgt q = .ok s₂ ∧ SliceStateRel pack s₁ s₂ := by
  cases Nat.decEq pSrc.entryDefId plan.defId with
  | isTrue hSame =>
    exact (initStateArrSlice_same_eq pack hSame q).2.2 s₁ hOk
  | isFalse hNe =>
    rw [initStateArrSlice_ne_eq pack hNe q]
    refine ⟨s₁, hOk, rfl, ?_⟩
    have hCopy := hOk
    rw [initStateArrSlice_eq] at hCopy
    cases hHdr : (!pSrc.pointerWidthBits.beq 64 || !pSrc.mirProfileVersion.beq 1) with
    | true => rw [hHdr] at hCopy; cases hCopy
    | false =>
      rw [hHdr] at hCopy
      dsimp at hCopy
      cases hAlloc : (!q.callerMem.allocations.isEmpty) with
      | true => rw [hAlloc] at hCopy; cases hCopy
      | false =>
        rw [hAlloc] at hCopy
        dsimp at hCopy
        cases hGet : Trusted.MirSemantics.getElem? pSrc.bodies pSrc.entryDefId with
        | none => rw [hGet] at hCopy; cases hCopy
        | some body =>
          rw [hGet] at hCopy
          dsimp [initStateArrSliceBody] at hCopy
          cases hEmp : body.basicBlocks.isEmpty with
          | true => rw [hEmp] at hCopy; cases hCopy
          | false =>
            rw [hEmp] at hCopy
            dsimp at hCopy
            cases hArg : (!body.argumentCount.blt body.locals.length) with
            | true => rw [hArg] at hCopy; cases hCopy
            | false =>
              rw [hArg] at hCopy
              dsimp at hCopy
              cases hStor : (!arrSliceStorageAnnotationsInBounds body) with
              | true => rw [hStor] at hCopy; cases hCopy
              | false =>
                rw [hStor] at hCopy
                dsimp at hCopy
                cases hSup : (!allArrSliceLocalsSupported body.argumentCount 0 body.locals) with
                | true => rw [hSup] at hCopy; cases hCopy
                | false =>
                  rw [hSup] at hCopy
                  dsimp at hCopy
                  cases hPT : arrSliceParamBaseTys? body with
                  | none => rw [hPT] at hCopy; cases hCopy
                  | some paramTys =>
                    rw [hPT] at hCopy
                    dsimp at hCopy
                    cases hArgs : (!checkArgsMatch q.args paramTys) with
                    | true => rw [hArgs] at hCopy; cases hCopy
                    | false =>
                      rw [hArgs] at hCopy
                      dsimp at hCopy
                      injection hCopy with hsEq
                      rw [← hsEq]
                      exact Or.inr ⟨hNe, rfl⟩

