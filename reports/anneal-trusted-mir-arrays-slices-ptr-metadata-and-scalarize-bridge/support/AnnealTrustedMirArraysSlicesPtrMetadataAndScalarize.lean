import Trusted.MirSemantics

namespace VrustcFormal.F1_15

open Trusted.MirAst Trusted.MirSemantics

/-!
# Bounded Arrays `[T; N]`, Wide-Pointer Slice Views `&[T]` / `*const [T]`, `UnOp::PtrMetadata`, `LowerSliceLenCalls`, `GVN` Metadata Folding, and Certified `ArraySliceScalarize` Reduction Directly Into `Trusted.MirSemantics` (`VrustcFormal.F1_15`)

This module conservatively extends Anneal's unmodified `Trusted.MirAst` and
`Trusted.MirSemantics` (`joshlf/anneal@c131b320eeeb26ef692e5afd5ec8db49ee518613`)
with `M_arrslice`, modeling fixed-size arrays `[T; N]` (`0 ≤ N ≤ 64`),
wide-pointer slice views `(backing, start, len)` (`&[T]` / `*const [T]`,
including `NonNull::dangling()` slices constructed via
`ptr::slice_from_raw_parts`), `Rvalue::Aggregate(Array)`, `Rvalue::Repeat`,
`PointerCoercion::Unsize` (`&[T; N] -> &[T]`), `ProjectionElem::ConstantIndex`
(both from-start and `from_end`), `ProjectionElem::Subslice`
(`let [head, mid @ .., tail] = slice`), `UnOp::PtrMetadata` (replacing removed
`Rvalue::Len` in `rustc_middle::mir`), `core::slice::<impl [T]>::len`
(`LowerSliceLenCalls`), and dynamic `AssertKind::BoundsCheck` +
`ProjectionElem::Index` reads and writes, grounded in upstream
`compiler/rustc_mir_transform/src/{lower_slice_len.rs, gvn.rs}` and live
`google/zerocopy` (`0.8.64`) MIR censuses (`E3-85`, `E3-90`).

It then formalizes four certified MIR passes—`LowerSliceLenCalls`,
`GvnFoldPtrMetadata`, `SliceScalarize`, and `ArrayScalarize`—lowering internal
slice and array locals **100% into unmodified `Trusted.MirAst.Program`
(`mirProfileVersion = 1`)** executed by unmodified
`Trusted.MirSemantics.evalStep`:

1. **Part I — Bounded Array & Wide-Pointer Slice Operational Semantics
   (`M_arrslice`) Conservatively Extending Unmodified `Trusted.MirSemantics`.**
2. **Part II — Certified `LowerSliceLenCalls`, `GvnFoldPtrMetadata`,
   `SliceScalarize`, and `ArrayScalarize` Lowering Directly Into Unmodified
   `Trusted.MirAst.Program`.**
3. **Part III — Five Core Target Theorems (`sorry` placeholders in frozen spec):**
   - `arrSlice_conservative_extension_exact`
   - `lowerSliceLenCalls_and_gvnPtrMetadata_sound_bidirectional_iff`
   - `danglingSlice_metadata_valid_deref_ub_and_boundsCheck_precedes_deref`
   - `arraySliceScalarize_reduces_to_trusted_mir`
   - `arraySlicePipeline_then_optPipeline_vc_transport`
4. **Part IV — Deterministic Adequacy, Eleven Sharpness Counterexamples &
   Witnesses (`CE1`--`CE11`), and End-to-End Lowering Witness Executed in
   Unmodified `Trusted.MirSemantics` (`0` `sorry`).**
-/

/-! ## Part I: Bounded Array & Wide-Pointer Slice Operational Semantics (`M_arrslice`) -/

/-- Structural boolean equality without `Decidable` instances. -/
noncomputable def boolEq : Bool → Bool → Bool
  | true, true => true
  | false, false => true
  | _, _ => false

/-- Pairwise boolean relation over two lists of equal length. -/
noncomputable def listRel {α β : Type} (r : α → β → Bool) :
    List α → List β → Bool
  | [], [] => true
  | x :: xs, y :: ys => r x y && listRel r xs ys
  | _, _ => false

/-- Map an option-returning function over a list, failing closed on `none`. -/
noncomputable def listMapOption {α β : Type} (f : α → Option β) :
    List α → Option (List β)
  | [] => some []
  | x :: xs =>
    match f x, listMapOption f xs with
    | some y, some ys => some (y :: ys)
    | _, _ => none

/-- Flatten a mapped list without `List.flatMap` library dependencies. -/
noncomputable def listFlatMap {α β : Type} (f : α → List β) :
    List α → List β
  | [] => []
  | x :: xs => f x ++ listFlatMap f xs

/-- Replicate `x` `n` times without extra imports. -/
noncomputable def listReplicate {α : Type} : Nat → α → List α
  | 0, _ => []
  | n + 1, x => x :: listReplicate n x

/-- Upper bound `2^64` for 64-bit `usize` values. -/
noncomputable def maxUsize : Nat := Nat.pow 2 64

/-- Canonical 64-bit `usize` type in `Trusted.MirAst`. -/
noncomputable def usizeTy : MirTy := .int .isize false

/-- Canonical `usize` constant operand. -/
noncomputable def usizeConst (n : Nat) : Operand :=
  .constant { ty := usizeTy, lit := .scalar (BitVec.ofNat 128 n) }

/-- Structural equality on `ProjectionElem`. -/
noncomputable def projElemEq : ProjectionElem → ProjectionElem → Bool
  | .deref, .deref => true
  | .field idx₁ ty₁, .field idx₂ ty₂ => Nat.beq idx₁ idx₂ && MirTy.beq ty₁ ty₂
  | .unsupported, .unsupported => true
  | _, _ => false

/-- Structural equality on `Place`. -/
noncomputable def placeEq (p₁ p₂ : Place) : Bool :=
  Nat.beq p₁.localId p₂.localId && listRel projElemEq p₁.projection p₂.projection

/-- Structural equality on `ConstLit`. -/
noncomputable def constLitEq : ConstLit → ConstLit → Bool
  | .scalar b₁, .scalar b₂ => b₁ == b₂
  | .zeroSized, .zeroSized => true
  | _, _ => false

/-- Structural equality on `ConstOperand`. -/
noncomputable def constOpEq (c₁ c₂ : ConstOperand) : Bool :=
  MirTy.beq c₁.ty c₂.ty && constLitEq c₁.lit c₂.lit

/-- Structural equality on `BinOp`. -/
noncomputable def binOpEq : BinOp → BinOp → Bool
  | .add, .add | .addUnchecked, .addUnchecked | .addWithOverflow, .addWithOverflow
  | .sub, .sub | .subUnchecked, .subUnchecked | .subWithOverflow, .subWithOverflow
  | .mul, .mul | .mulUnchecked, .mulUnchecked | .mulWithOverflow, .mulWithOverflow
  | .div, .div | .rem, .rem
  | .bitXor, .bitXor | .bitAnd, .bitAnd | .bitOr, .bitOr
  | .shl, .shl | .shlUnchecked, .shlUnchecked
  | .shr, .shr | .shrUnchecked, .shrUnchecked
  | .eq, .eq | .lt, .lt | .le, .le | .ne, .ne | .ge, .ge | .gt, .gt
  | .offset, .offset => true
  | _, _ => false

/-- Structural equality on `UnOp`. -/
noncomputable def unOpEq : UnOp → UnOp → Bool
  | .not, .not | .neg, .neg | .ptrMetadata, .ptrMetadata => true
  | _, _ => false

/-- Structural equality on `Operand`. -/
noncomputable def operandEq : Operand → Operand → Bool
  | .copy p₁, .copy p₂ => placeEq p₁ p₂
  | .move p₁, .move p₂ => placeEq p₁ p₂
  | .constant c₁, .constant c₂ => constOpEq c₁ c₂
  | _, _ => false

/-- Structural equality on `Rvalue`. -/
noncomputable def rvalueEq : Rvalue → Rvalue → Bool
  | .use o₁, .use o₂ => operandEq o₁ o₂
  | .binaryOp op₁ l₁ r₁, .binaryOp op₂ l₂ r₂ =>
    binOpEq op₁ op₂ && operandEq l₁ l₂ && operandEq r₁ r₂
  | .unaryOp op₁ o₁, .unaryOp op₂ o₂ => unOpEq op₁ op₂ && operandEq o₁ o₂
  | .discriminant p₁, .discriminant p₂ => placeEq p₁ p₂
  | .ref m₁ p₁, .ref m₂ p₂ => Mutability.beq m₁ m₂ && placeEq p₁ p₂
  | .addressOf m₁ p₁, .addressOf m₂ p₂ => Mutability.beq m₁ m₂ && placeEq p₁ p₂
  | .aggregateTuple fs₁, .aggregateTuple fs₂ => listRel operandEq fs₁ fs₂
  | .unsupported, .unsupported => true
  | _, _ => false

/-- Structural equality on `StatementKind`. -/
noncomputable def stmtEq : StatementKind → StatementKind → Bool
  | .assign d₁ r₁, .assign d₂ r₂ => placeEq d₁ d₂ && rvalueEq r₁ r₂
  | .storageLive l₁, .storageLive l₂ => Nat.beq l₁ l₂
  | .storageDead l₁, .storageDead l₂ => Nat.beq l₁ l₂
  | .nop, .nop => true
  | .unsupported, .unsupported => true
  | _, _ => false

/-- Structural equality on `SwitchTargets`. -/
noncomputable def switchTargetsEq (t₁ t₂ : SwitchTargets) : Bool :=
  Nat.beq t₁.otherwise t₂.otherwise &&
    listRel (fun a b => (a.1 == b.1) && Nat.beq a.2 b.2) t₁.branches t₂.branches

/-- Structural equality on `UnwindAction`. -/
noncomputable def unwindActionEq : UnwindAction → UnwindAction → Bool
  | .continue_, .continue_ | .unreachable, .unreachable
  | .terminate, .terminate => true
  | .cleanup b₁, .cleanup b₂ => Nat.beq b₁ b₂
  | _, _ => false

/-- Structural equality on `AssertKind`. -/
noncomputable def assertKindEq : AssertKind → AssertKind → Bool
  | .overflow op₁, .overflow op₂ => binOpEq op₁ op₂
  | .overflowNeg, .overflowNeg | .divByZero, .divByZero
  | .remByZero, .remByZero | .boundsCheck, .boundsCheck
  | .misalignedPtrDeref, .misalignedPtrDeref | .nullPtrDeref, .nullPtrDeref
  | .unsupported, .unsupported => true
  | _, _ => false

/-- Structural equality on `TerminatorKind`. -/
noncomputable def terminatorEq : TerminatorKind → TerminatorKind → Bool
  | .goto t₁, .goto t₂ => Nat.beq t₁ t₂
  | .switchInt d₁ ts₁, .switchInt d₂ ts₂ =>
    operandEq d₁ d₂ && switchTargetsEq ts₁ ts₂
  | .return_, .return_ | .unreachable, .unreachable
  | .unwindResume, .unwindResume | .unsupported, .unsupported => true
  | .assert c₁ e₁ m₁ t₁ u₁, .assert c₂ e₂ m₂ t₂ u₂ =>
    operandEq c₁ c₂ && boolEq e₁ e₂ && assertKindEq m₁ m₂ &&
      Nat.beq t₁ t₂ && unwindActionEq u₁ u₂
  | .call f₁ a₁ d₁ t₁ u₁, .call f₂ a₂ d₂ t₂ u₂ =>
    Nat.beq f₁ f₂ && listRel operandEq a₁ a₂ && placeEq d₁ d₂ &&
      (match t₁, t₂ with
       | none, none => true
       | some x, some y => Nat.beq x y
       | _, _ => false) &&
      unwindActionEq u₁ u₂
  | _, _ => false

/-- Structural equality on `VerificationScope`. -/
noncomputable def scopeEq : VerificationScope → VerificationScope → Bool
  | .unit, .unit | .crate, .crate => true
  | _, _ => false

/-- Structural equality on `BasicBlock`. -/
noncomputable def basicBlockEq (b₁ b₂ : BasicBlock) : Bool :=
  boolEq b₁.cleanup b₂.cleanup &&
    listRel stmtEq b₁.statements b₂.statements &&
    terminatorEq b₁.terminator b₂.terminator

/-- Structural equality on `Body`. -/
noncomputable def bodyEq (b₁ b₂ : Body) : Bool :=
  Nat.beq b₁.argumentCount b₂.argumentCount &&
    MirTy.beqList b₁.locals b₂.locals &&
    listRel basicBlockEq b₁.basicBlocks b₂.basicBlocks &&
    boolEq b₁.isUnsafe b₂.isUnsafe &&
    stringBeq b₁.identity b₂.identity

/-- Structural equality on `Program`. -/
noncomputable def programEq (p₁ p₂ : Program) : Bool :=
  listRel bodyEq p₁.bodies p₂.bodies &&
    Nat.beq p₁.entryDefId p₂.entryDefId &&
    Nat.beq p₁.pointerWidthBits p₂.pointerWidthBits &&
    Nat.beq p₁.mirProfileVersion p₂.mirProfileVersion &&
    scopeEq p₁.scope p₂.scope

/-- Initial `Option Val` of a newly live element slot of type `ty`, matching
`Trusted.MirSemantics.liveUninitSlot`. -/
noncomputable def initElemOptVal : MirTy → Option Val
  | .unit => some .unit
  | .enum ety => if isZstEnumTy ety then some (.enumVal ety 0) else none
  | _ => none

/-! ### `M_arrslice` Syntax Extending Unmodified `Trusted.MirAst` -/

/-- Local declaration in `M_arrslice`:
- `.base ty`: any unmodified `Trusted.MirAst.MirTy`.
- `.array elemTy len`: fixed-size array `[elemTy; len]` (`0 ≤ len ≤ 64`).
- `.sliceView elemTy`: wide-pointer slice view `&[elemTy]` / `*const [elemTy]`
  carrying `(backing, start, len)`. -/
inductive ArrSliceLocalDecl where
  | base (ty : MirTy)
  | array (elemTy : MirTy) (len : Nat)
  | sliceView (elemTy : MirTy)

noncomputable def arrSliceLocalDeclEq :
    ArrSliceLocalDecl → ArrSliceLocalDecl → Bool
  | .base t₁, .base t₂ => MirTy.beq t₁ t₂
  | .array t₁ n₁, .array t₂ n₂ => MirTy.beq t₁ t₂ && Nat.beq n₁ n₂
  | .sliceView t₁, .sliceView t₂ => MirTy.beq t₁ t₂
  | _, _ => false

/-- Straight-line statements in `M_arrslice` (never split basic blocks). -/
inductive ArrSliceStmt where
  | baseStmt (stmt : StatementKind)
  | aggregateArray (arrLocal : LocalId) (ops : List Operand)
  | repeatArray (arrLocal : LocalId) (op : Operand)
  | arrayLivenessCheck (arrLocal : LocalId)
  | readArrayConst (dstLocal : LocalId) (arrLocal : LocalId)
      (idx : Nat) (isMove : Bool)
  | writeArrayConst (arrLocal : LocalId) (idx : Nat) (rval : Rvalue)
  | unsizeArrayToSlice (sliceLocal : LocalId) (arrLocal : LocalId)
  | sliceFromRawParts (sliceLocal : LocalId) (lenOp : Operand)
  | subslice (dstSlice : LocalId) (srcSlice : LocalId)
      (fromIdx toIdx : Nat) (fromEnd : Bool)
  | ptrMetadata (dstLocal : LocalId) (sliceLocal : LocalId)

noncomputable def arrSliceStmtEq : ArrSliceStmt → ArrSliceStmt → Bool
  | .baseStmt s₁, .baseStmt s₂ => stmtEq s₁ s₂
  | .aggregateArray a₁ os₁, .aggregateArray a₂ os₂ =>
    Nat.beq a₁ a₂ && listRel operandEq os₁ os₂
  | .repeatArray a₁ o₁, .repeatArray a₂ o₂ =>
    Nat.beq a₁ a₂ && operandEq o₁ o₂
  | .arrayLivenessCheck a₁, .arrayLivenessCheck a₂ => Nat.beq a₁ a₂
  | .readArrayConst d₁ a₁ i₁ m₁, .readArrayConst d₂ a₂ i₂ m₂ =>
    Nat.beq d₁ d₂ && Nat.beq a₁ a₂ && Nat.beq i₁ i₂ && boolEq m₁ m₂
  | .writeArrayConst a₁ i₁ r₁, .writeArrayConst a₂ i₂ r₂ =>
    Nat.beq a₁ a₂ && Nat.beq i₁ i₂ && rvalueEq r₁ r₂
  | .unsizeArrayToSlice s₁ a₁, .unsizeArrayToSlice s₂ a₂ =>
    Nat.beq s₁ s₂ && Nat.beq a₁ a₂
  | .sliceFromRawParts s₁ o₁, .sliceFromRawParts s₂ o₂ =>
    Nat.beq s₁ s₂ && operandEq o₁ o₂
  | .subslice d₁ s₁ f₁ t₁ e₁, .subslice d₂ s₂ f₂ t₂ e₂ =>
    Nat.beq d₁ d₂ && Nat.beq s₁ s₂ && Nat.beq f₁ f₂ && Nat.beq t₁ t₂ &&
      boolEq e₁ e₂
  | .ptrMetadata d₁ s₁, .ptrMetadata d₂ s₂ =>
    Nat.beq d₁ d₂ && Nat.beq s₁ s₂
  | _, _ => false

/-- Terminators in `M_arrslice` (branching and dynamic/constant-index dispatch). -/
inductive ArrSliceTerm where
  | baseTerm (term : TerminatorKind)
  | sliceLenCall (dstLocal : LocalId) (sliceLocal : LocalId)
      (target : BasicBlockId)
  | boundsCheckArray (arrLocal : LocalId) (idxOp : Operand)
      (inBoundsBb panicBb : BasicBlockId)
  | boundsCheckSlice (sliceLocal : LocalId) (idxOp : Operand)
      (inBoundsBb panicBb : BasicBlockId)
  | readArrayElem (dstLocal : LocalId) (arrLocal : LocalId)
      (idxOp : Operand) (nextBb : BasicBlockId)
  | writeArrayElem (arrLocal : LocalId) (idxOp : Operand)
      (valOp : Operand) (nextBb : BasicBlockId)
  | readSliceElem (dstLocal : LocalId) (sliceLocal : LocalId)
      (idxOp : Operand) (nextBb : BasicBlockId)
  | readSliceConst (dstLocal : LocalId) (sliceLocal : LocalId)
      (offset minLen : Nat) (fromEnd : Bool) (nextBb : BasicBlockId)

noncomputable def arrSliceTermEq : ArrSliceTerm → ArrSliceTerm → Bool
  | .baseTerm t₁, .baseTerm t₂ => terminatorEq t₁ t₂
  | .sliceLenCall d₁ s₁ b₁, .sliceLenCall d₂ s₂ b₂ =>
    Nat.beq d₁ d₂ && Nat.beq s₁ s₂ && Nat.beq b₁ b₂
  | .boundsCheckArray a₁ o₁ i₁ p₁, .boundsCheckArray a₂ o₂ i₂ p₂ =>
    Nat.beq a₁ a₂ && operandEq o₁ o₂ && Nat.beq i₁ i₂ && Nat.beq p₁ p₂
  | .boundsCheckSlice s₁ o₁ i₁ p₁, .boundsCheckSlice s₂ o₂ i₂ p₂ =>
    Nat.beq s₁ s₂ && operandEq o₁ o₂ && Nat.beq i₁ i₂ && Nat.beq p₁ p₂
  | .readArrayElem d₁ a₁ o₁ n₁, .readArrayElem d₂ a₂ o₂ n₂ =>
    Nat.beq d₁ d₂ && Nat.beq a₁ a₂ && operandEq o₁ o₂ && Nat.beq n₁ n₂
  | .writeArrayElem a₁ i₁ v₁ n₁, .writeArrayElem a₂ i₂ v₂ n₂ =>
    Nat.beq a₁ a₂ && operandEq i₁ i₂ && operandEq v₁ v₂ && Nat.beq n₁ n₂
  | .readSliceElem d₁ s₁ o₁ n₁, .readSliceElem d₂ s₂ o₂ n₂ =>
    Nat.beq d₁ d₂ && Nat.beq s₁ s₂ && operandEq o₁ o₂ && Nat.beq n₁ n₂
  | .readSliceConst d₁ s₁ o₁ m₁ e₁ n₁, .readSliceConst d₂ s₂ o₂ m₂ e₂ n₂ =>
    Nat.beq d₁ d₂ && Nat.beq s₁ s₂ && Nat.beq o₁ o₂ && Nat.beq m₁ m₂ &&
      boolEq e₁ e₂ && Nat.beq n₁ n₂
  | _, _ => false

structure ArrSliceBlock where
  statements : List ArrSliceStmt
  terminator : ArrSliceTerm
  cleanup : Bool := false

noncomputable def arrSliceBlockEq (a b : ArrSliceBlock) : Bool :=
  boolEq a.cleanup b.cleanup &&
    listRel arrSliceStmtEq a.statements b.statements &&
    arrSliceTermEq a.terminator b.terminator

structure ArrSliceBody where
  argumentCount : Nat
  locals : List ArrSliceLocalDecl
  basicBlocks : List ArrSliceBlock
  isUnsafe : Bool := false
  identity : String := ""

noncomputable def arrSliceBodyEq (a b : ArrSliceBody) : Bool :=
  Nat.beq a.argumentCount b.argumentCount &&
    listRel arrSliceLocalDeclEq a.locals b.locals &&
    listRel arrSliceBlockEq a.basicBlocks b.basicBlocks &&
    boolEq a.isUnsafe b.isUnsafe &&
    stringBeq a.identity b.identity

structure ArrSliceProgram where
  bodies : List ArrSliceBody
  entryDefId : DefId := 0
  pointerWidthBits : Nat
  mirProfileVersion : Nat
  scope : VerificationScope := .unit

noncomputable def arrSliceProgramEq (a b : ArrSliceProgram) : Bool :=
  listRel arrSliceBodyEq a.bodies b.bodies &&
    Nat.beq a.entryDefId b.entryDefId &&
    Nat.beq a.pointerWidthBits b.pointerWidthBits &&
    Nat.beq a.mirProfileVersion b.mirProfileVersion &&
    scopeEq a.scope b.scope

/-- Canonical embedding of unmodified `Trusted.MirAst` into `M_arrslice`. -/
noncomputable def embedBaseBlock (bb : BasicBlock) : ArrSliceBlock := {
  statements := bb.statements.map ArrSliceStmt.baseStmt
  terminator := .baseTerm bb.terminator
  cleanup := bb.cleanup
}

noncomputable def embedBaseBody (b : Body) : ArrSliceBody := {
  argumentCount := b.argumentCount
  locals := b.locals.map ArrSliceLocalDecl.base
  basicBlocks := b.basicBlocks.map embedBaseBlock
  isUnsafe := b.isUnsafe
  identity := b.identity
}

noncomputable def embedBaseProgram (p : Program) : ArrSliceProgram := {
  bodies := p.bodies.map embedBaseBody
  entryDefId := p.entryDefId
  pointerWidthBits := p.pointerWidthBits
  mirProfileVersion := p.mirProfileVersion
  scope := p.scope
}

/-- Projection from a fully scalarized `ArrSliceProgram` back to an unmodified
`Trusted.MirAst.Program`. -/
noncomputable def unembedBaseBlock (bb : ArrSliceBlock) : Option BasicBlock :=
  let stmts? := listMapOption (fun s =>
    match s with | .baseStmt st => some st | _ => none) bb.statements
  match stmts?, bb.terminator with
  | some stmts, .baseTerm t =>
    some { statements := stmts, terminator := t, cleanup := bb.cleanup }
  | _, _ => none

noncomputable def unembedBaseBody (b : ArrSliceBody) : Option Body :=
  let tys? := listMapOption (fun d =>
    match d with | .base ty => some ty | _ => none) b.locals
  let bbs? := listMapOption unembedBaseBlock b.basicBlocks
  match tys?, bbs? with
  | some tys, some bbs =>
    some {
      argumentCount := b.argumentCount
      locals := tys
      basicBlocks := bbs
      isUnsafe := b.isUnsafe
      identity := b.identity
    }
  | _, _ => none

noncomputable def unembedBaseProgram (p : ArrSliceProgram) : Option Program :=
  match listMapOption unembedBaseBody p.bodies with
  | some bs =>
    some {
      bodies := bs
      entryDefId := p.entryDefId
      pointerWidthBits := p.pointerWidthBits
      mirProfileVersion := p.mirProfileVersion
      scope := p.scope
    }
  | none => none

/-! ### Runtime State & Small-Step Operational Semantics of `M_arrslice` -/

/-- Backing provenance of a wide-pointer slice value:
- `.dangling`: `NonNull::dangling()` raw slice (`ptr::slice_from_raw_parts`);
  `PtrMetadata` and valid-bounds `Subslice` succeed, while any element read
  faults `.fault .undefined` (`DanglingPointer`).
- `.arrayLocal arrLocal`: slice view referencing internal array local
  `arrLocal` starting at element `start` of length `len`. -/
inductive SliceBacking where
  | dangling
  | arrayLocal (arrLocal : LocalId)

structure SliceViewVal where
  backing : SliceBacking
  start : Nat
  len : Nat

inductive ArrSliceSlot where
  | baseSlot (slot : LocalSlot)
  | arrDead
  | liveArray (elems : List (Option Val))
  | sliceDead
  | liveSlice (val : Option SliceViewVal)

structure ArrSliceFrame where
  defId : DefId
  blockIdx : BasicBlockId
  stmtIdx : Nat
  locals : List ArrSliceSlot

structure ArrSliceState where
  frames : List ArrSliceFrame
  callerMem : CallerMemory := ⟨[]⟩

noncomputable def embedArrSliceFrame (f : FrameState) : ArrSliceFrame := {
  defId := f.defId
  blockIdx := f.blockIdx
  stmtIdx := f.stmtIdx
  locals := f.locals.map ArrSliceSlot.baseSlot
}

noncomputable def embedArrSliceState (s : State) : ArrSliceState := {
  frames := s.frames.map embedArrSliceFrame
  callerMem := s.callerMem
}

noncomputable def liftStepResultArrSlice :
    StepResult State TerminalOut → StepResult ArrSliceState TerminalOut
  | .step s => .step (embedArrSliceState s)
  | .done o => .done o
  | .fault k => .fault k

noncomputable def liveUninitArrSliceSlot : ArrSliceLocalDecl → ArrSliceSlot
  | .base ty => .baseSlot (liveUninitSlot ty)
  | .array elemTy len => .liveArray (listReplicate len (initElemOptVal elemTy))
  | .sliceView _ => .liveSlice none

noncomputable def deadArrSliceSlot : ArrSliceLocalDecl → ArrSliceSlot
  | .base _ => .baseSlot .dead
  | .array _ _ => .arrDead
  | .sliceView _ => .sliceDead

noncomputable def arrSliceStmtHasStorageMarker (localId : LocalId) :
    ArrSliceStmt → Bool
  | .baseStmt s => stmtHasStorageMarker localId s
  | _ => false

noncomputable def arrSliceHasStorageAnnotation (body : ArrSliceBody)
    (localId : LocalId) : Bool :=
  body.basicBlocks.any (fun bb =>
    bb.statements.any (arrSliceStmtHasStorageMarker localId))

noncomputable def arrSliceStorageAnnotationsInBounds (body : ArrSliceBody) : Bool :=
  let n := body.locals.length
  body.basicBlocks.all (fun bb =>
    bb.statements.all (fun stmt =>
      match stmt with
      | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) =>
        Nat.blt id n
      | _ => true))

noncomputable def isSupportedArrSliceLocalDecl (argumentCount : Nat)
    (idx : Nat) : ArrSliceLocalDecl → Bool
  | .base ty => isSupportedScalarOrUnitTy ty
  | .array elemTy len =>
    Nat.blt argumentCount idx && isSupportedScalarOrUnitTy elemTy &&
      Nat.ble len 64
  | .sliceView elemTy =>
    Nat.blt argumentCount idx && isSupportedScalarOrUnitTy elemTy

noncomputable def allArrSliceLocalsSupported (argumentCount : Nat) :
    Nat → List ArrSliceLocalDecl → Bool
  | _, [] => true
  | idx, d :: rest =>
    isSupportedArrSliceLocalDecl argumentCount idx d &&
      allArrSliceLocalsSupported argumentCount (idx + 1) rest

noncomputable def arrSliceParamBaseTys? (body : ArrSliceBody) :
    Option (List MirTy) :=
  listMapOption (fun d => match d with | .base ty => some ty | _ => none)
    ((body.locals.drop 1).take body.argumentCount)

noncomputable def initArrSliceLocalsLoop (body : ArrSliceBody)
    (args : List Val) : Nat → List ArrSliceLocalDecl → List ArrSliceSlot
  | _, [] => []
  | idx, decl :: rest =>
    let sl : ArrSliceSlot :=
      if Nat.beq idx 0 then
        liveUninitArrSliceSlot decl
      else if Nat.ble idx body.argumentCount then
        match Trusted.MirSemantics.getElem? args (idx - 1) with
        | some v => .baseSlot (.live (some v))
        | none => .baseSlot .dead
      else if arrSliceHasStorageAnnotation body idx then
        deadArrSliceSlot decl
      else
        liveUninitArrSliceSlot decl
    sl :: initArrSliceLocalsLoop body args (idx + 1) rest

noncomputable def initStateArrSlice (p : ArrSliceProgram) (q : Query) :
    Except FaultKind ArrSliceState :=
  if !Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1 then
    .error .unsupported
  else if !q.callerMem.allocations.isEmpty then
    .error .unsupported
  else
    match Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
    | none => .error .unsupported
    | some body =>
      if body.basicBlocks.isEmpty then
        .error .unsupported
      else if !Nat.blt body.argumentCount body.locals.length then
        .error .unsupported
      else if !arrSliceStorageAnnotationsInBounds body then
        .error .unsupported
      else if !allArrSliceLocalsSupported body.argumentCount 0 body.locals then
        .error .unsupported
      else
        match arrSliceParamBaseTys? body with
        | none => .error .unsupported
        | some paramTys =>
          if !checkArgsMatch q.args paramTys then
            .error .unsupported
          else
            let frame : ArrSliceFrame := {
              defId := p.entryDefId
              blockIdx := 0
              stmtIdx := 0
              locals := initArrSliceLocalsLoop body q.args 0 body.locals
            }
            .ok { frames := [frame], callerMem := q.callerMem }

/-- Base operand & rvalue evaluators in 1-to-1 lockstep with
`Trusted.MirSemantics`. -/
noncomputable def evalArrSliceBaseOperandToSlot
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot) :
    Operand → Except FaultKind (MirTy × Option Val × List ArrSliceSlot)
  | .copy place =>
    if !place.projection.isEmpty then
      .error .unsupported
    else
      match Trusted.MirSemantics.getElem? decls place.localId,
          Trusted.MirSemantics.getElem? slots place.localId with
      | some (.base ty), some (.baseSlot (.live optVal)) =>
        .ok (ty, optVal, slots)
      | some (.base _), some (.baseSlot .dead) =>
        .error .undefined
      | _, _ => .error .unsupported
  | .move place =>
    if !place.projection.isEmpty then
      .error .unsupported
    else
      match Trusted.MirSemantics.getElem? decls place.localId,
          Trusted.MirSemantics.getElem? slots place.localId with
      | some (.base ty), some (.baseSlot (.live optVal)) =>
        match setElem? slots place.localId (.baseSlot (liveUninitSlot ty)) with
        | some slots' => .ok (ty, optVal, slots')
        | none => .error .unsupported
      | some (.base _), some (.baseSlot .dead) =>
        .error .undefined
      | _, _ => .error .unsupported
  | .constant c =>
    match evalConstLit c.ty c.lit with
    | .ok v => .ok (c.ty, some v, slots)
    | .error k => .error k

noncomputable def evalArrSlicePrimitiveOperand
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (opnd : Operand) : Except FaultKind (Val × List ArrSliceSlot) :=
  match evalArrSliceBaseOperandToSlot decls slots opnd with
  | .error k => .error k
  | .ok (ty, optVal, slots') =>
    if !isPrimitiveReadableTy ty then
      .error .unsupported
    else
      match optVal with
      | some v => .ok (v, slots')
      | none => .error .undefined

/-- Evaluate a base operand expecting exact type `expectedTy` (used for array
constructors, repeat, and `usize` index/length operands). -/
noncomputable def evalArrSliceTypedOperand
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (expectedTy : MirTy) (opnd : Operand) :
    Except FaultKind (Val × List ArrSliceSlot) :=
  match evalArrSliceBaseOperandToSlot decls slots opnd with
  | .error k => .error k
  | .ok (srcTy, optVal, slots') =>
    if !MirTy.beq srcTy expectedTy then
      .error .unsupported
    else
      match optVal with
      | some v =>
        if checkVal v expectedTy then .ok (v, slots') else .error .unsupported
      | none => .error .undefined

/-- Evaluate a list of operands left-to-right expecting `expectedTy`. -/
noncomputable def evalArrSliceTypedOps (decls : List ArrSliceLocalDecl)
    (expectedTy : MirTy) :
    List ArrSliceSlot → List Operand →
      Except FaultKind (List Val × List ArrSliceSlot)
  | slots, [] => .ok ([], slots)
  | slots, op :: rest =>
    match evalArrSliceTypedOperand decls slots expectedTy op with
    | .error k => .error k
    | .ok (v, slots₁) =>
      match evalArrSliceTypedOps decls expectedTy slots₁ rest with
      | .error k => .error k
      | .ok (vs, slots₂) => .ok (v :: vs, slots₂)

/-- Evaluate a `usize` operand (`MirTy.int .isize false`) to its `Nat` value. -/
noncomputable def evalUsizeOperand (decls : List ArrSliceLocalDecl)
    (slots : List ArrSliceSlot) (opnd : Operand) :
    Except FaultKind (Nat × List ArrSliceSlot) :=
  match evalArrSliceTypedOperand decls slots usizeTy opnd with
  | .error k => .error k
  | .ok (.scalar sv, slots') => .ok (sv.bits.toNat, slots')
  | .ok (_, _) => .error .unsupported

noncomputable def evalArrSliceBaseRvalue
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (dstTy : MirTy) : Rvalue → Except FaultKind (Val × List ArrSliceSlot)
  | .use opnd =>
    match evalArrSliceBaseOperandToSlot decls slots opnd with
    | .error k => .error k
    | .ok (srcTy, optVal, slots₁) =>
      if !(MirTy.beq srcTy dstTy) then
        .error .unsupported
      else
        match optVal with
        | some v => .ok (v, slots₁)
        | none => .error .undefined
  | .binaryOp op lhs rhs =>
    match evalArrSlicePrimitiveOperand decls slots lhs with
    | .error k => .error k
    | .ok (lVal, slots₁) =>
      match evalArrSlicePrimitiveOperand decls slots₁ rhs with
      | .error k => .error k
      | .ok (rVal, slots₂) =>
        match evalBinOp op lVal rVal with
        | .error k => .error k
        | .ok res => .ok (res, slots₂)
  | .unaryOp op opnd =>
    match evalArrSlicePrimitiveOperand decls slots opnd with
    | .error k => .error k
    | .ok (v, slots₁) =>
      match evalUnOp op v with
      | .error k => .error k
      | .ok res => .ok (res, slots₁)
  | .discriminant place =>
    if !place.projection.isEmpty then
      .error .unsupported
    else
      match Trusted.MirSemantics.getElem? decls place.localId,
          Trusted.MirSemantics.getElem? slots place.localId with
      | some (.base (.enum ety)), some (.baseSlot slot) =>
        if !enumAdmitted ety then
          .error .unsupported
        else
          match ety.tagRepr, slot with
          | _, .dead => .error .undefined
          | .zeroSized, .live none =>
            match Trusted.MirSemantics.getElem? ety.discriminants 0 with
            | some disc =>
              .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩, slots)
            | none => .error .unsupported
          | .zeroSized, .live (some (.enumVal ety' v)) =>
            if EnumTy.beq ety ety' && Nat.beq v 0 then
              match Trusted.MirSemantics.getElem? ety.discriminants 0 with
              | some disc =>
                .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                  truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩, slots)
              | none => .error .unsupported
            else
              .error .unsupported
          | .zeroSized, .live (some _) => .error .unsupported
          | .scalar _ _, .live none => .error .undefined
          | .scalar _ _, .live (some (.enumVal ety' v)) =>
            if EnumTy.beq ety ety' && Nat.blt v ety.discriminants.length then
              match Trusted.MirSemantics.getElem? ety.discriminants v with
              | some disc =>
                .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                  truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩, slots)
              | none => .error .unsupported
            else
              .error .unsupported
          | .scalar _ _, .live (some _) => .error .unsupported
      | _, _ => .error .unsupported
  | _ => .error .unsupported

noncomputable def writeArrSliceBasePlace (slots : List ArrSliceSlot)
    (dstLocalId : LocalId) (dstTy : MirTy) (val : Val) :
    Except FaultKind (List ArrSliceSlot) :=
  if !checkVal val dstTy then
    .error .unsupported
  else
    match Trusted.MirSemantics.getElem? slots dstLocalId with
    | none => .error .unsupported
    | some (.baseSlot .dead) => .error .undefined
    | some (.baseSlot (.live _)) =>
      match setElem? slots dstLocalId (.baseSlot (.live (some val))) with
      | some slots' => .ok slots'
      | none => .error .unsupported
    | some _ => .error .unsupported

/-- Pure subslice bounds & view calculation (`ProjectionElem::Subslice`). -/
noncomputable def evalSubsliceVal (sv : SliceViewVal)
    (fromIdx toIdx : Nat) (fromEnd : Bool) : Except FaultKind SliceViewVal :=
  if !Nat.blt (sv.start + sv.len) maxUsize then
    .error .unsupported
  else if !fromEnd then
    if Nat.ble fromIdx toIdx && Nat.ble toIdx sv.len then
      .ok { backing := sv.backing, start := sv.start + fromIdx, len := toIdx - fromIdx }
    else
      .error .undefined
  else
    if Nat.ble (fromIdx + toIdx) sv.len then
      .ok {
        backing := sv.backing
        start := sv.start + fromIdx
        len := sv.len - (fromIdx + toIdx)
      }
    else
      .error .undefined

/-- Pure relative-index calculation for `ProjectionElem::ConstantIndex`. -/
noncomputable def evalSliceConstRelIdx (len offset minLen : Nat)
    (fromEnd : Bool) : Except FaultKind Nat :=
  if !Nat.ble minLen len then
    .error .undefined
  else if !fromEnd then
    if Nat.blt offset len then .ok offset else .error .undefined
  else
    if Nat.blt 0 offset && Nat.ble offset len then
      .ok (len - offset)
    else
      .error .undefined

/-- Helper to advance `stmtIdx` by 1 with updated `locals`. -/
noncomputable def stepStmtNext (frame : ArrSliceFrame)
    (callerMem : CallerMemory) (locals' : List ArrSliceSlot) :
    StepResult ArrSliceState TerminalOut :=
  .step {
    frames := [{ frame with stmtIdx := frame.stmtIdx + 1, locals := locals' }]
    callerMem
  }

/-- Helper to jump to `(target, 0)` with updated `locals`. -/
noncomputable def jumpArrSliceBlock (frame : ArrSliceFrame)
    (callerMem : CallerMemory) (locals' : List ArrSliceSlot)
    (target : BasicBlockId) : StepResult ArrSliceState TerminalOut :=
  .step {
    frames := [{ frame with blockIdx := target, stmtIdx := 0, locals := locals' }]
    callerMem
  }

/-- Evaluate an `ArrSliceStmt` in `M_arrslice`. -/
noncomputable def evalArrSliceStmt (body : ArrSliceBody)
    (frame : ArrSliceFrame) (callerMem : CallerMemory) :
    ArrSliceStmt → StepResult ArrSliceState TerminalOut
  | .baseStmt .nop => stepStmtNext frame callerMem frame.locals
  | .baseStmt .unsupported => .fault .unsupported
  | .baseStmt (.storageLive id) =>
    match Trusted.MirSemantics.getElem? body.locals id with
    | none => .fault .unsupported
    | some decl =>
      match setElem? frame.locals id (liveUninitArrSliceSlot decl) with
      | some slots' => stepStmtNext frame callerMem slots'
      | none => .fault .unsupported
  | .baseStmt (.storageDead id) =>
    if Nat.beq id 0 then
      .fault .unsupported
    else
      let deadSlot : ArrSliceSlot :=
        match Trusted.MirSemantics.getElem? body.locals id with
        | some decl => deadArrSliceSlot decl
        | none => .baseSlot .dead
      match setElem? frame.locals id deadSlot with
      | some slots' => stepStmtNext frame callerMem slots'
      | none => .fault .unsupported
  | .baseStmt (.assign dst rval) =>
    if !dst.projection.isEmpty then
      .fault .unsupported
    else
      match Trusted.MirSemantics.getElem? body.locals dst.localId with
      | some (.base dstTy) =>
        match evalArrSliceBaseRvalue body.locals frame.locals dstTy rval with
        | .error k => .fault k
        | .ok (val, slotsAfterRval) =>
          match writeArrSliceBasePlace slotsAfterRval dst.localId dstTy val with
          | .error k => .fault k
          | .ok slots' => stepStmtNext frame callerMem slots'
      | _ => .fault .unsupported
  | .aggregateArray arrLocal ops =>
    match Trusted.MirSemantics.getElem? body.locals arrLocal with
    | some (.array elemTy len) =>
      if !Nat.beq ops.length len then
        .fault .unsupported
      else
        match evalArrSliceTypedOps body.locals elemTy frame.locals ops with
        | .error k => .fault k
        | .ok (vals, slotsAfterOps) =>
          match Trusted.MirSemantics.getElem? slotsAfterOps arrLocal with
          | some .arrDead => .fault .undefined
          | some (.liveArray _) =>
            match setElem? slotsAfterOps arrLocal (.liveArray (vals.map some)) with
            | some slots' => stepStmtNext frame callerMem slots'
            | none => .fault .unsupported
          | _ => .fault .unsupported
    | _ => .fault .unsupported
  | .repeatArray arrLocal op =>
    match Trusted.MirSemantics.getElem? body.locals arrLocal with
    | some (.array elemTy len) =>
      match evalArrSliceTypedOperand body.locals frame.locals elemTy op with
      | .error k => .fault k
      | .ok (v, slotsAfterOp) =>
        match Trusted.MirSemantics.getElem? slotsAfterOp arrLocal with
        | some .arrDead => .fault .undefined
        | some (.liveArray _) =>
          match setElem? slotsAfterOp arrLocal
              (.liveArray (listReplicate len (some v))) with
          | some slots' => stepStmtNext frame callerMem slots'
          | none => .fault .unsupported
        | _ => .fault .unsupported
    | _ => .fault .unsupported
  | .arrayLivenessCheck arrLocal =>
    match Trusted.MirSemantics.getElem? body.locals arrLocal,
        Trusted.MirSemantics.getElem? frame.locals arrLocal with
    | some (.array _ _), some (.liveArray _) =>
      stepStmtNext frame callerMem frame.locals
    | some (.array _ _), some .arrDead => .fault .undefined
    | _, _ => .fault .unsupported
  | .readArrayConst dstLocal arrLocal idx isMove =>
    match Trusted.MirSemantics.getElem? body.locals dstLocal,
        Trusted.MirSemantics.getElem? body.locals arrLocal,
        Trusted.MirSemantics.getElem? frame.locals arrLocal with
    | some (.base dstTy), some (.array elemTy len), some (.liveArray elems) =>
      if !(MirTy.beq dstTy elemTy) then
        .fault .unsupported
      else if !Nat.blt idx len then
        .fault .undefined
      else
        match Trusted.MirSemantics.getElem? elems idx with
        | some (some v) =>
          let slotsAfterRead? : Option (List ArrSliceSlot) :=
            if isMove then
              match setElem? elems idx (initElemOptVal elemTy) with
              | some elems' => setElem? frame.locals arrLocal (.liveArray elems')
              | none => none
            else
              some frame.locals
          match slotsAfterRead? with
          | none => .fault .unsupported
          | some slotsAfterRead =>
            match writeArrSliceBasePlace slotsAfterRead dstLocal dstTy v with
            | .error k => .fault k
            | .ok slots' => stepStmtNext frame callerMem slots'
        | some none => .fault .undefined
        | none => .fault .unsupported
    | some (.base dstTy), some (.array elemTy _), some .arrDead =>
      if MirTy.beq dstTy elemTy then .fault .undefined else .fault .unsupported
    | _, _, _ => .fault .unsupported
  | .writeArrayConst arrLocal idx rval =>
    match Trusted.MirSemantics.getElem? body.locals arrLocal with
    | some (.array elemTy len) =>
      match evalArrSliceBaseRvalue body.locals frame.locals elemTy rval with
      | .error k => .fault k
      | .ok (v, slotsAfterRval) =>
        if !checkVal v elemTy then
          .fault .unsupported
        else
          match Trusted.MirSemantics.getElem? slotsAfterRval arrLocal with
          | some .arrDead => .fault .undefined
          | some (.liveArray elems) =>
            if !Nat.blt idx len then
              .fault .undefined
            else
              match setElem? elems idx (some v) with
              | none => .fault .unsupported
              | some elems' =>
                match setElem? slotsAfterRval arrLocal (.liveArray elems') with
                | some slots' => stepStmtNext frame callerMem slots'
                | none => .fault .unsupported
          | _ => .fault .unsupported
    | _ => .fault .unsupported
  | .unsizeArrayToSlice sliceLocal arrLocal =>
    match Trusted.MirSemantics.getElem? body.locals sliceLocal,
        Trusted.MirSemantics.getElem? body.locals arrLocal,
        Trusted.MirSemantics.getElem? frame.locals arrLocal,
        Trusted.MirSemantics.getElem? frame.locals sliceLocal with
    | some (.sliceView sTy), some (.array aTy len), arrSl, sliceSl =>
      if !(MirTy.beq sTy aTy) then
        .fault .unsupported
      else
        match arrSl with
        | some .arrDead => .fault .undefined
        | some (.liveArray _) =>
          match sliceSl with
          | some .sliceDead => .fault .undefined
          | some (.liveSlice _) =>
            let sv : SliceViewVal := {
              backing := .arrayLocal arrLocal
              start := 0
              len := len
            }
            match setElem? frame.locals sliceLocal (.liveSlice (some sv)) with
            | some slots' => stepStmtNext frame callerMem slots'
            | none => .fault .unsupported
          | _ => .fault .unsupported
        | _ => .fault .unsupported
    | _, _, _, _ => .fault .unsupported
  | .sliceFromRawParts sliceLocal lenOp =>
    match Trusted.MirSemantics.getElem? body.locals sliceLocal with
    | some (.sliceView _) =>
      match evalUsizeOperand body.locals frame.locals lenOp with
      | .error k => .fault k
      | .ok (len, slotsAfterLen) =>
        match Trusted.MirSemantics.getElem? slotsAfterLen sliceLocal with
        | some .sliceDead => .fault .undefined
        | some (.liveSlice _) =>
          let sv : SliceViewVal := { backing := .dangling, start := 0, len := len }
          match setElem? slotsAfterLen sliceLocal (.liveSlice (some sv)) with
          | some slots' => stepStmtNext frame callerMem slots'
          | none => .fault .unsupported
        | _ => .fault .unsupported
    | _ => .fault .unsupported
  | .subslice dstSlice srcSlice fromIdx toIdx fromEnd =>
    match Trusted.MirSemantics.getElem? body.locals dstSlice,
        Trusted.MirSemantics.getElem? body.locals srcSlice,
        Trusted.MirSemantics.getElem? frame.locals srcSlice with
    | some (.sliceView dstTy), some (.sliceView srcTy), some srcSl =>
      if !(MirTy.beq dstTy srcTy) ||
          !Nat.blt fromIdx maxUsize || !Nat.blt toIdx maxUsize then
        .fault .unsupported
      else
        match srcSl with
        | .sliceDead | .liveSlice none => .fault .undefined
        | .liveSlice (some sv) =>
          match evalSubsliceVal sv fromIdx toIdx fromEnd with
          | .error k => .fault k
          | .ok sv' =>
            match Trusted.MirSemantics.getElem? frame.locals dstSlice with
            | some .sliceDead => .fault .undefined
            | some (.liveSlice _) =>
              match setElem? frame.locals dstSlice (.liveSlice (some sv')) with
              | some slots' => stepStmtNext frame callerMem slots'
              | none => .fault .unsupported
            | _ => .fault .unsupported
        | _ => .fault .unsupported
    | _, _, _ => .fault .unsupported
  | .ptrMetadata dstLocal sliceLocal =>
    match Trusted.MirSemantics.getElem? body.locals dstLocal,
        Trusted.MirSemantics.getElem? body.locals sliceLocal,
        Trusted.MirSemantics.getElem? frame.locals sliceLocal with
    | some (.base dstTy), some (.sliceView _), some sliceSl =>
      if !(MirTy.beq dstTy usizeTy) then
        .fault .unsupported
      else
        match sliceSl with
        | .sliceDead | .liveSlice none => .fault .undefined
        | .liveSlice (some sv) =>
          let lenVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩
          match writeArrSliceBasePlace frame.locals dstLocal dstTy lenVal with
          | .error k => .fault k
          | .ok slots' => stepStmtNext frame callerMem slots'
        | _ => .fault .unsupported
    | _, _, _ => .fault .unsupported

/-- Shared helper reading element `effIdx` from array local `arrLocal` into
base local `dstLocal` and jumping to `nextBb`. -/
noncomputable def evalReadArrayAtIdx (body : ArrSliceBody)
    (frame : ArrSliceFrame) (callerMem : CallerMemory)
    (slots : List ArrSliceSlot) (dstLocal arrLocal : LocalId)
    (effIdx : Nat) (nextBb : BasicBlockId) :
    StepResult ArrSliceState TerminalOut :=
  match Trusted.MirSemantics.getElem? body.locals dstLocal,
      Trusted.MirSemantics.getElem? body.locals arrLocal,
      Trusted.MirSemantics.getElem? slots arrLocal with
  | some (.base dstTy), some (.array elemTy len), some arrSl =>
    if !(MirTy.beq dstTy elemTy) then
      .fault .unsupported
    else
      match arrSl with
      | .arrDead => .fault .undefined
      | .liveArray elems =>
        if !Nat.blt effIdx len then
          .fault .undefined
        else
          match Trusted.MirSemantics.getElem? elems effIdx with
          | some (some v) =>
            match writeArrSliceBasePlace slots dstLocal dstTy v with
            | .error k => .fault k
            | .ok slots' => jumpArrSliceBlock frame callerMem slots' nextBb
          | some none => .fault .undefined
          | none => .fault .unsupported
      | _ => .fault .unsupported
  | _, _, _ => .fault .unsupported

/-- Evaluate an `ArrSliceTerm` when `frame.stmtIdx == bb.statements.length`. -/
noncomputable def evalArrSliceTerm (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame)
    (callerMem : CallerMemory) : StepResult ArrSliceState TerminalOut :=
  match bb.terminator with
  | .baseTerm (.goto target) =>
    jumpArrSliceBlock frame callerMem frame.locals target
  | .baseTerm .return_ =>
    if bb.cleanup then
      .fault .unsupported
    else
      match Trusted.MirSemantics.getElem? frame.locals 0 with
      | some (.baseSlot (.live (some retVal))) =>
        .done (.returned ⟨retVal, callerMem⟩)
      | some (.baseSlot (.live none)) | some (.baseSlot .dead)
      | some .arrDead | some .sliceDead =>
        .fault .undefined
      | _ => .fault .unsupported
  | .baseTerm .unreachable => .fault .undefined
  | .baseTerm (.switchInt discr targets) =>
    match evalArrSlicePrimitiveOperand body.locals frame.locals discr with
    | .error k => .fault k
    | .ok (discrVal, slotsAfterDiscr) =>
      let targetRes : Except FaultKind BasicBlockId :=
        match discrVal with
        | .scalar sv =>
          evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches
        | .bool b =>
          evalBoolSwitchBranches b targets.otherwise targets.branches
        | _ => .error .unsupported
      match targetRes with
      | .error k => .fault k
      | .ok target =>
        jumpArrSliceBlock frame callerMem slotsAfterDiscr target
  | .baseTerm .unwindResume
  | .baseTerm (.assert _ _ _ _ _)
  | .baseTerm (.call _ _ _ _ _)
  | .baseTerm .unsupported =>
    .fault .unsupported
  | .sliceLenCall dstLocal sliceLocal target =>
    match Trusted.MirSemantics.getElem? body.locals dstLocal,
        Trusted.MirSemantics.getElem? body.locals sliceLocal,
        Trusted.MirSemantics.getElem? frame.locals sliceLocal with
    | some (.base dstTy), some (.sliceView _), some sliceSl =>
      if !(MirTy.beq dstTy usizeTy) then
        .fault .unsupported
      else
        match sliceSl with
        | .sliceDead | .liveSlice none => .fault .undefined
        | .liveSlice (some sv) =>
          let lenVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩
          match writeArrSliceBasePlace frame.locals dstLocal dstTy lenVal with
          | .error k => .fault k
          | .ok slots' => jumpArrSliceBlock frame callerMem slots' target
        | _ => .fault .unsupported
    | _, _, _ => .fault .unsupported
  | .boundsCheckArray arrLocal idxOp inBoundsBb panicBb =>
    match Trusted.MirSemantics.getElem? body.locals arrLocal,
        Trusted.MirSemantics.getElem? frame.locals arrLocal with
    | some (.array _ _), some .arrDead => .fault .undefined
    | some (.array _ len), some (.liveArray _) =>
      match evalUsizeOperand body.locals frame.locals idxOp with
      | .error k => .fault k
      | .ok (idx, slotsAfterIdx) =>
        let target := if Nat.blt idx len then inBoundsBb else panicBb
        jumpArrSliceBlock frame callerMem slotsAfterIdx target
    | _, _ => .fault .unsupported
  | .boundsCheckSlice sliceLocal idxOp inBoundsBb panicBb =>
    match Trusted.MirSemantics.getElem? body.locals sliceLocal,
        Trusted.MirSemantics.getElem? frame.locals sliceLocal with
    | some (.sliceView _), some (.sliceDead)
    | some (.sliceView _), some (.liveSlice none) => .fault .undefined
    | some (.sliceView _), some (.liveSlice (some sv)) =>
      match evalUsizeOperand body.locals frame.locals idxOp with
      | .error k => .fault k
      | .ok (idx, slotsAfterIdx) =>
        let target := if Nat.blt idx sv.len then inBoundsBb else panicBb
        jumpArrSliceBlock frame callerMem slotsAfterIdx target
    | _, _ => .fault .unsupported
  | .readArrayElem dstLocal arrLocal idxOp nextBb =>
    match evalUsizeOperand body.locals frame.locals idxOp with
    | .error k => .fault k
    | .ok (idx, slotsAfterIdx) =>
      evalReadArrayAtIdx body frame callerMem slotsAfterIdx
        dstLocal arrLocal idx nextBb
  | .writeArrayElem arrLocal idxOp valOp nextBb =>
    match Trusted.MirSemantics.getElem? body.locals arrLocal with
    | some (.array elemTy len) =>
      match evalUsizeOperand body.locals frame.locals idxOp with
      | .error k => .fault k
      | .ok (idx, slotsAfterIdx) =>
        match evalArrSliceTypedOperand body.locals slotsAfterIdx elemTy valOp with
        | .error k => .fault k
        | .ok (v, slotsAfterVal) =>
          match Trusted.MirSemantics.getElem? slotsAfterVal arrLocal with
          | some .arrDead => .fault .undefined
          | some (.liveArray elems) =>
            if !Nat.blt idx len then
              .fault .undefined
            else
              match setElem? elems idx (some v) with
              | none => .fault .unsupported
              | some elems' =>
                match setElem? slotsAfterVal arrLocal (.liveArray elems') with
                | some slots' => jumpArrSliceBlock frame callerMem slots' nextBb
                | none => .fault .unsupported
          | _ => .fault .unsupported
    | _ => .fault .unsupported
  | .readSliceElem dstLocal sliceLocal idxOp nextBb =>
    match Trusted.MirSemantics.getElem? body.locals dstLocal,
        Trusted.MirSemantics.getElem? body.locals sliceLocal,
        Trusted.MirSemantics.getElem? frame.locals sliceLocal with
    | some (.base dstTy), some (.sliceView elemTy), some sliceSl =>
      if !(MirTy.beq dstTy elemTy) then
        .fault .unsupported
      else
        match sliceSl with
        | .sliceDead | .liveSlice none => .fault .undefined
        | .liveSlice (some sv) =>
          match evalUsizeOperand body.locals frame.locals idxOp with
          | .error k => .fault k
          | .ok (idx, slotsAfterIdx) =>
            if !Nat.blt idx sv.len then
              .fault .undefined
            else
              match sv.backing with
              | .dangling => .fault .undefined
              | .arrayLocal arrLocal =>
                if !Nat.blt (sv.start + idx) maxUsize then
                  .fault .undefined
                else
                  evalReadArrayAtIdx body frame callerMem slotsAfterIdx
                    dstLocal arrLocal (sv.start + idx) nextBb
        | _ => .fault .unsupported
    | _, _, _ => .fault .unsupported
  | .readSliceConst dstLocal sliceLocal offset minLen fromEnd nextBb =>
    match Trusted.MirSemantics.getElem? body.locals dstLocal,
        Trusted.MirSemantics.getElem? body.locals sliceLocal,
        Trusted.MirSemantics.getElem? frame.locals sliceLocal with
    | some (.base dstTy), some (.sliceView elemTy), some sliceSl =>
      if !(MirTy.beq dstTy elemTy) ||
          !Nat.blt offset maxUsize || !Nat.blt minLen maxUsize then
        .fault .unsupported
      else
        match sliceSl with
        | .sliceDead | .liveSlice none => .fault .undefined
        | .liveSlice (some sv) =>
          match evalSliceConstRelIdx sv.len offset minLen fromEnd with
          | .error k => .fault k
          | .ok relIdx =>
            match sv.backing with
            | .dangling => .fault .undefined
            | .arrayLocal arrLocal =>
              if !Nat.blt (sv.start + relIdx) maxUsize then
                .fault .undefined
              else
                evalReadArrayAtIdx body frame callerMem frame.locals
                  dstLocal arrLocal (sv.start + relIdx) nextBb
        | _ => .fault .unsupported
    | _, _, _ => .fault .unsupported

/-- Total single-step evaluator `evalStepArrSlice` of `M_arrslice`. -/
noncomputable def evalStepArrSlice (p : ArrSliceProgram) (_c : Choice)
    (s : ArrSliceState) : StepResult ArrSliceState TerminalOut :=
  match s.frames with
  | [frame] =>
    match Trusted.MirSemantics.getElem? p.bodies frame.defId with
    | none => .fault .unsupported
    | some body =>
      match Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
      | none => .fault .unsupported
      | some bb =>
        match Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
        | some stmt => evalArrSliceStmt body frame s.callerMem stmt
        | none =>
          if Nat.beq frame.stmtIdx bb.statements.length then
            evalArrSliceTerm body bb frame s.callerMem
          else
            .fault .unsupported
  | _ => .fault .unsupported

/-! ### Top-Level Execution & Verification Judgments of `M_arrslice` -/

noncomputable def ValidChoiceArrSlice (_p : ArrSliceProgram)
    (_s : ArrSliceState) (c : Choice) : Prop :=
  c = 0

noncomputable def StepArrSlice (p : ArrSliceProgram) (s : ArrSliceState)
    (res : StepResult ArrSliceState TerminalOut) : Prop :=
  ∃ c : Choice, ValidChoiceArrSlice p s c ∧ evalStepArrSlice p c s = res

inductive ReachesArrSlice (p : ArrSliceProgram) :
    ArrSliceState → ArrSliceState → Prop where
  | refl (s : ArrSliceState) : ReachesArrSlice p s s
  | tail {s₁ s₂ s₃ : ArrSliceState} :
      ReachesArrSlice p s₁ s₂ →
      StepArrSlice p s₂ (.step s₃) →
      ReachesArrSlice p s₁ s₃

noncomputable def ReachesResultArrSlice (p : ArrSliceProgram) (q : Query)
    (res : StepResult ArrSliceState TerminalOut) : Prop :=
  match initStateArrSlice p q with
  | .error k => res = .fault k
  | .ok s₀ => ∃ s : ArrSliceState, ReachesArrSlice p s₀ s ∧ StepArrSlice p s res

noncomputable def WellFormedArrSlice (p : ArrSliceProgram) (q : Query) : Prop :=
  (∃ s₀ : ArrSliceState, initStateArrSlice p q = .ok s₀ ∧
    ∀ s : ArrSliceState, ReachesArrSlice p s₀ s →
      ∃ c : Choice, ValidChoiceArrSlice p s c) ∧
  (∀ k : FaultKind, ¬ ReachesResultArrSlice p q (.fault k))

noncomputable def BehaviorArrSlice (p : ArrSliceProgram) (q : Query)
    (out : TerminalOut) : Prop :=
  ReachesResultArrSlice p q (.done out)

noncomputable def stepChainFromArrSlice (p : ArrSliceProgram) :
    Nat → ArrSliceState → Option ArrSliceState
  | 0, s => some s
  | n + 1, s =>
    match evalStepArrSlice p 0 s with
    | .step s' => stepChainFromArrSlice p n s'
    | _ => none

noncomputable def DivergesArrSlice (p : ArrSliceProgram) (q : Query) : Prop :=
  ∃ s₀ : ArrSliceState, initStateArrSlice p q = .ok s₀ ∧
    ∀ n : Nat, ∃ sₙ : ArrSliceState, stepChainFromArrSlice p n s₀ = some sₙ

noncomputable def SatisfiesPostArrSlice (p : ArrSliceProgram) (q : Query)
    (post : TerminalOut → Prop) : Prop :=
  WellFormedArrSlice p q ∧ ∀ out : TerminalOut, BehaviorArrSlice p q out → post out

noncomputable def FullSemanticEquivArrSlice (p₁ p₂ : ArrSliceProgram) : Prop :=
  (∀ q : Query, WellFormedArrSlice p₁ q ↔ WellFormedArrSlice p₂ q) ∧
  (∀ q : Query, ∀ out : TerminalOut,
    BehaviorArrSlice p₁ q out ↔ BehaviorArrSlice p₂ q out) ∧
  (∀ q : Query, ∀ k : FaultKind,
    ReachesResultArrSlice p₁ q (.fault k) ↔
      ReachesResultArrSlice p₂ q (.fault k)) ∧
  (∀ q : Query, DivergesArrSlice p₁ q ↔ DivergesArrSlice p₂ q) ∧
  (∀ q : Query, ∀ post : TerminalOut → Prop,
    SatisfiesPostArrSlice p₁ q post ↔ SatisfiesPostArrSlice p₂ q post)

noncomputable def FullSemanticEquivBase (p₁ p₂ : Program) : Prop :=
  (∀ q : Query, WellFormed p₁ q ↔ WellFormed p₂ q) ∧
  (∀ q : Query, ∀ out : TerminalOut, Behavior p₁ q out ↔ Behavior p₂ q out) ∧
  (∀ q : Query, ∀ k : FaultKind,
    ReachesResult p₁ q (.fault k) ↔ ReachesResult p₂ q (.fault k)) ∧
  (∀ q : Query, Diverges p₁ q ↔ Diverges p₂ q) ∧
  (∀ q : Query, ∀ post : TerminalOut → Prop,
    SatisfiesPost p₁ q post ↔ SatisfiesPost p₂ q post)

/-! ## Part II: Certified `LowerSliceLenCalls`, `GvnFoldPtrMetadata`, `SliceScalarize`, & `ArrayScalarize` -/

/-! ### Common Well-Scopedness Predicates -/

noncomputable def operandLocalsInBounds (n : Nat) : Operand → Bool
  | .copy p | .move p => Nat.blt p.localId n
  | .constant _ => true

noncomputable def rvalueLocalsInBounds (n : Nat) : Rvalue → Bool
  | .use o | .unaryOp _ o => operandLocalsInBounds n o
  | .binaryOp _ l r => operandLocalsInBounds n l && operandLocalsInBounds n r
  | .discriminant p | .ref _ p | .addressOf _ p => Nat.blt p.localId n
  | .aggregateTuple os => os.all (operandLocalsInBounds n)
  | .unsupported => true

noncomputable def baseStmtLocalsInBounds (n : Nat) : StatementKind → Bool
  | .assign dst rv => Nat.blt dst.localId n && rvalueLocalsInBounds n rv
  | .storageLive id | .storageDead id => Nat.blt id n
  | .nop | .unsupported => true

noncomputable def arrSliceStmtLocalsInBounds (n : Nat) : ArrSliceStmt → Bool
  | .baseStmt s => baseStmtLocalsInBounds n s
  | .aggregateArray a os => Nat.blt a n && os.all (operandLocalsInBounds n)
  | .repeatArray a o => Nat.blt a n && operandLocalsInBounds n o
  | .arrayLivenessCheck a => Nat.blt a n
  | .readArrayConst d a _ _ => Nat.blt d n && Nat.blt a n
  | .writeArrayConst a _ rv => Nat.blt a n && rvalueLocalsInBounds n rv
  | .unsizeArrayToSlice s a => Nat.blt s n && Nat.blt a n
  | .sliceFromRawParts s o => Nat.blt s n && operandLocalsInBounds n o
  | .subslice d s _ _ _ => Nat.blt d n && Nat.blt s n
  | .ptrMetadata d s => Nat.blt d n && Nat.blt s n

noncomputable def arrSliceTermLocalsInBounds (n : Nat) : ArrSliceTerm → Bool
  | .baseTerm (.goto _) | .baseTerm .return_ | .baseTerm .unreachable
  | .baseTerm .unwindResume | .baseTerm .unsupported => true
  | .baseTerm (.switchInt d _) => operandLocalsInBounds n d
  | .baseTerm (.assert c _ _ _ _) => operandLocalsInBounds n c
  | .baseTerm (.call _ args dst _ _) =>
    Nat.blt dst.localId n && args.all (operandLocalsInBounds n)
  | .sliceLenCall d s _ => Nat.blt d n && Nat.blt s n
  | .boundsCheckArray a o _ _ => Nat.blt a n && operandLocalsInBounds n o
  | .boundsCheckSlice s o _ _ => Nat.blt s n && operandLocalsInBounds n o
  | .readArrayElem d a o _ =>
    Nat.blt d n && Nat.blt a n && operandLocalsInBounds n o
  | .writeArrayElem a i v _ =>
    Nat.blt a n && operandLocalsInBounds n i && operandLocalsInBounds n v
  | .readSliceElem d s o _ =>
    Nat.blt d n && Nat.blt s n && operandLocalsInBounds n o
  | .readSliceConst d s _ _ _ _ => Nat.blt d n && Nat.blt s n

noncomputable def arrSliceBodyLocalsInBounds (body : ArrSliceBody) : Bool :=
  let n := body.locals.length
  body.basicBlocks.all (fun bb =>
    bb.statements.all (arrSliceStmtLocalsInBounds n) &&
      arrSliceTermLocalsInBounds n bb.terminator)

noncomputable def arrSliceTermTargetsInBounds (numBbs : Nat) :
    ArrSliceTerm → Bool
  | .baseTerm (.goto t) => Nat.blt t numBbs
  | .baseTerm (.switchInt _ ts) =>
    Nat.blt ts.otherwise numBbs &&
      ts.branches.all (fun br => Nat.blt br.2 numBbs)
  | .baseTerm .return_ | .baseTerm .unreachable
  | .baseTerm .unwindResume | .baseTerm .unsupported => true
  | .baseTerm (.assert _ _ _ t u) =>
    Nat.blt t numBbs &&
      match u with | .cleanup b => Nat.blt b numBbs | _ => true
  | .baseTerm (.call _ _ _ t u) =>
    (match t with | none => true | some b => Nat.blt b numBbs) &&
      match u with | .cleanup b => Nat.blt b numBbs | _ => true
  | .sliceLenCall _ _ t => Nat.blt t numBbs
  | .boundsCheckArray _ _ i p | .boundsCheckSlice _ _ i p =>
    Nat.blt i numBbs && Nat.blt p numBbs
  | .readArrayElem _ _ _ n | .writeArrayElem _ _ _ n
  | .readSliceElem _ _ _ n | .readSliceConst _ _ _ _ _ n =>
    Nat.blt n numBbs

noncomputable def arrSliceBodyTargetsInBounds (body : ArrSliceBody) : Bool :=
  let b := body.basicBlocks.length
  body.basicBlocks.all (fun bb => arrSliceTermTargetsInBounds b bb.terminator)

/-- Straight-line base helper statements shared by `SliceScalarize` &
`ArrayScalarize`. -/
noncomputable def mkLivenessCheckStmt (liveLoc : LocalId) : ArrSliceStmt :=
  .baseStmt (.assign { localId := liveLoc, projection := [] }
    (.use (.constant { ty := .unit, lit := .zeroSized })))

noncomputable def mkImmediateUbStmt (scrUsize : LocalId) : ArrSliceStmt :=
  .baseStmt (.assign { localId := scrUsize, projection := [] }
    (.binaryOp .subUnchecked (usizeConst 0) (usizeConst 1)))

noncomputable def mkAssignUse (dst : LocalId) (op : Operand) : ArrSliceStmt :=
  .baseStmt (.assign { localId := dst, projection := [] } (.use op))

noncomputable def mkSubUncheckedUsize (dst : LocalId)
    (lhs rhs : Operand) : ArrSliceStmt :=
  .baseStmt (.assign { localId := dst, projection := [] }
    (.binaryOp .subUnchecked lhs rhs))

noncomputable def mkAddUncheckedUsize (dst : LocalId)
    (lhs rhs : Operand) : ArrSliceStmt :=
  .baseStmt (.assign { localId := dst, projection := [] }
    (.binaryOp .addUnchecked lhs rhs))

noncomputable def mkLtUsize (dst : LocalId)
    (lhs rhs : Operand) : ArrSliceStmt :=
  .baseStmt (.assign { localId := dst, projection := [] }
    (.binaryOp .lt lhs rhs))

noncomputable def mkStorageLiveRange : Nat → Nat → List ArrSliceStmt
  | _, 0 => []
  | start, k + 1 =>
    .baseStmt (.storageLive start) :: mkStorageLiveRange (start + 1) k

noncomputable def mkStorageDeadRange : Nat → Nat → List ArrSliceStmt
  | _, 0 => []
  | start, k + 1 =>
    .baseStmt (.storageDead start) :: mkStorageDeadRange (start + 1) k

/-! ### Pass 1: `LowerSliceLenCalls` (`compiler/rustc_mir_transform/src/lower_slice_len.rs`) -/

/-- Replace `sliceLenCall dst sliceLoc target` in block `(bodyId, bbIdx)` with
`ptrMetadata dst sliceLoc` followed by `goto target`. -/
noncomputable def applyLowerSliceLenCalls (bodyId : DefId)
    (bbIdx : BasicBlockId) (pSrc : ArrSliceProgram) :
    Option ArrSliceProgram :=
  match Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
  | none => none
  | some body =>
    match Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
    | none => none
    | some bb =>
      match bb.terminator with
      | .sliceLenCall dst sliceLoc target =>
        let bbTgt : ArrSliceBlock := {
          bb with
          statements := bb.statements ++ [.ptrMetadata dst sliceLoc]
          terminator := .baseTerm (.goto target)
        }
        match setElem? body.basicBlocks bbIdx bbTgt with
        | none => none
        | some bbsTgt =>
          match setElem? pSrc.bodies bodyId { body with basicBlocks := bbsTgt } with
          | none => none
          | some bodiesTgt => some { pSrc with bodies := bodiesTgt }
      | _ => none

noncomputable def checkLowerSliceLenCalls (bodyId : DefId)
    (bbIdx : BasicBlockId) (pSrc pTgt : ArrSliceProgram) : Bool :=
  match applyLowerSliceLenCalls bodyId bbIdx pSrc with
  | some pOut => arrSliceProgramEq pOut pTgt
  | none => false

/-! ### Pass 2: `GvnFoldPtrMetadata` (`compiler/rustc_mir_transform/src/gvn.rs` + `E3-85`) -/

/-- Whether `stmt` may write or alter the storage state of `sliceLocal`. -/
noncomputable def stmtModifiesSlice (sliceLocal : LocalId) :
    ArrSliceStmt → Bool
  | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) =>
    Nat.beq id sliceLocal
  | .unsizeArrayToSlice s _ | .sliceFromRawParts s _ | .subslice s _ _ _ _ =>
    Nat.beq s sliceLocal
  | _ => false

/-- Intra-block `GVN` constant-folding of `ptrMetadata dst sliceLocal` to
`const len_usize` when preceded by `unsizeArrayToSlice sliceLocal arrLocal`
with no intervening mutation or storage transition of `sliceLocal`. -/
noncomputable def applyGvnFoldPtrMetadata (bodyId : DefId)
    (bbIdx : BasicBlockId) (unsizeIdx metaIdx : Nat)
    (pSrc : ArrSliceProgram) : Option ArrSliceProgram :=
  if !Nat.blt unsizeIdx metaIdx then
    none
  else
    match Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
    | none => none
    | some body =>
      match Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
      | none => none
      | some bb =>
        match Trusted.MirSemantics.getElem? bb.statements unsizeIdx,
            Trusted.MirSemantics.getElem? bb.statements metaIdx with
        | some (.unsizeArrayToSlice sLoc arrLoc),
          some (.ptrMetadata dstLoc sLoc') =>
          if !Nat.beq sLoc sLoc' then
            none
          else
            match Trusted.MirSemantics.getElem? body.locals arrLoc,
                Trusted.MirSemantics.getElem? body.locals sLoc,
                Trusted.MirSemantics.getElem? body.locals dstLoc with
            | some (.array aTy len), some (.sliceView sTy), some (.base dstTy) =>
              if !(MirTy.beq aTy sTy) || !Nat.ble len 64 ||
                  !(MirTy.beq dstTy usizeTy) then
                none
              else
                let between :=
                  (bb.statements.drop (unsizeIdx + 1)).take (metaIdx - unsizeIdx - 1)
                if between.any (stmtModifiesSlice sLoc) then
                  none
                else
                  let foldedStmt : ArrSliceStmt :=
                    mkAssignUse dstLoc (usizeConst len)
                  match setElem? bb.statements metaIdx foldedStmt with
                  | none => none
                  | some stmtsTgt =>
                    match setElem? body.basicBlocks bbIdx
                        { bb with statements := stmtsTgt } with
                    | none => none
                    | some bbsTgt =>
                      match setElem? pSrc.bodies bodyId
                          { body with basicBlocks := bbsTgt } with
                      | none => none
                      | some bodiesTgt => some { pSrc with bodies := bodiesTgt }
            | _, _, _ => none
        | _, _ => none

noncomputable def checkGvnFoldPtrMetadata (bodyId : DefId)
    (bbIdx : BasicBlockId) (unsizeIdx metaIdx : Nat)
    (pSrc pTgt : ArrSliceProgram) : Bool :=
  match applyGvnFoldPtrMetadata bodyId bbIdx unsizeIdx metaIdx pSrc with
  | some pOut => arrSliceProgramEq pOut pTgt
  | none => false

/-! ### Pass 3: `SliceScalarize` (Zero-Block-Split Elimination of All `.sliceView` Locals in a Body) -/

/-- Backing assignment for a single `.sliceView` local in `body`:
`backing = none` means strictly `.dangling`; `backing = some arrLocal` means
either `.dangling` (`tag = 0`) or a view into `arrLocal` (`tag = 1`). -/
structure SliceBackingEntry where
  sliceLocal : LocalId
  backing : Option LocalId

structure SliceScalarizePlan where
  defId : DefId
  entries : List SliceBackingEntry

noncomputable def findSliceEntryIdxAux (sLoc : LocalId) :
    Nat → List SliceBackingEntry → Option (Nat × Option LocalId)
  | _, [] => none
  | idx, e :: rest =>
    if Nat.beq e.sliceLocal sLoc then
      some (idx, e.backing)
    else
      findSliceEntryIdxAux sLoc (idx + 1) rest

noncomputable def findSliceEntry (entries : List SliceBackingEntry)
    (sLoc : LocalId) : Option (Nat × Option LocalId) :=
  findSliceEntryIdxAux sLoc 0 entries

noncomputable def optNatEq : Option Nat → Option Nat → Bool
  | none, none => true
  | some a, some b => Nat.beq a b
  | _, _ => false

/-- Check that `entries` lists every `.sliceView` local of `body.locals`
exactly once in ascending index order, with every `some arrLocal` pointing to
an internal `.array` local of matching `elemTy`. -/
noncomputable def checkSliceBackingEntriesLoop
    (decls : List ArrSliceLocalDecl) (argCount : Nat) :
    Nat → List ArrSliceLocalDecl → List SliceBackingEntry → Bool
  | _, [], [] => true
  | idx, .sliceView sTy :: restDecls, e :: restEntries =>
    isSupportedScalarOrUnitTy sTy &&
      Nat.beq e.sliceLocal idx &&
      Nat.blt argCount idx &&
      (match e.backing with
       | none => true
       | some arrLocal =>
         Nat.blt argCount arrLocal &&
           match Trusted.MirSemantics.getElem? decls arrLocal with
           | some (.array aTy len) => MirTy.beq aTy sTy && Nat.ble len 64
           | _ => false) &&
      checkSliceBackingEntriesLoop decls argCount (idx + 1) restDecls restEntries
  | idx, .base _ :: restDecls, entries =>
    checkSliceBackingEntriesLoop decls argCount (idx + 1) restDecls entries
  | idx, .array _ _ :: restDecls, entries =>
    checkSliceBackingEntriesLoop decls argCount (idx + 1) restDecls entries
  | _, _, _ => false

/-- Replace every `.sliceView` declaration with `.base .unit` tombstone. -/
noncomputable def tombstoneSliceDecls :
    List ArrSliceLocalDecl → List ArrSliceLocalDecl
  | [] => []
  | .sliceView _ :: rest => .base .unit :: tombstoneSliceDecls rest
  | d :: rest => d :: tombstoneSliceDecls rest

/-- Check that an operand references only `.base` locals (not `.sliceView` or
`.array`). -/
noncomputable def operandUsesOnlyBase (decls : List ArrSliceLocalDecl) :
    Operand → Bool
  | .copy p | .move p =>
    p.projection.isEmpty &&
      match Trusted.MirSemantics.getElem? decls p.localId with
      | some (.base _) => true
      | _ => false
  | .constant _ => true

noncomputable def rvalueUsesOnlyBase (decls : List ArrSliceLocalDecl) :
    Rvalue → Bool
  | .use o | .unaryOp _ o => operandUsesOnlyBase decls o
  | .binaryOp _ l r => operandUsesOnlyBase decls l && operandUsesOnlyBase decls r
  | .discriminant p =>
    p.projection.isEmpty &&
      match Trusted.MirSemantics.getElem? decls p.localId with
      | some (.base _) => true
      | _ => false
  | .ref _ _ | .addressOf _ _ | .aggregateTuple _ | .unsupported => true

/-- Static admissibility of statements for `SliceScalarize`. -/
noncomputable def checkStmtForSlices (decls : List ArrSliceLocalDecl)
    (entries : List SliceBackingEntry) : ArrSliceStmt → Bool
  | .baseStmt (.storageLive _) | .baseStmt (.storageDead _)
  | .baseStmt .nop | .baseStmt .unsupported => true
  | .baseStmt (.assign dst rval) =>
    if !dst.projection.isEmpty then true
    else
      match Trusted.MirSemantics.getElem? decls dst.localId with
      | some (.sliceView _) => false
      | _ => rvalueUsesOnlyBase decls rval
  | .aggregateArray _ ops => ops.all (operandUsesOnlyBase decls)
  | .repeatArray _ op => operandUsesOnlyBase decls op
  | .arrayLivenessCheck _ => true
  | .readArrayConst dst _ _ _ =>
    match Trusted.MirSemantics.getElem? decls dst with
    | some (.sliceView _) => false
    | _ => true
  | .writeArrayConst _ _ rval => rvalueUsesOnlyBase decls rval
  | .unsizeArrayToSlice sLoc arrLoc =>
    match findSliceEntry entries sLoc,
        Trusted.MirSemantics.getElem? decls sLoc,
        Trusted.MirSemantics.getElem? decls arrLoc with
    | some (_, some bArr), some (.sliceView sTy), some (.array aTy len) =>
      Nat.beq bArr arrLoc && MirTy.beq sTy aTy && Nat.ble len 64
    | _, _, _ => false
  | .sliceFromRawParts sLoc lenOp =>
    match findSliceEntry entries sLoc with
    | some _ => operandUsesOnlyBase decls lenOp
    | none => false
  | .subslice dstS srcS fromIdx toIdx _ =>
    Nat.blt fromIdx maxUsize && Nat.blt toIdx maxUsize &&
      match findSliceEntry entries dstS, findSliceEntry entries srcS,
          Trusted.MirSemantics.getElem? decls dstS,
          Trusted.MirSemantics.getElem? decls srcS with
      | some (_, bDst), some (_, bSrc),
        some (.sliceView dTy), some (.sliceView sTy) =>
        MirTy.beq dTy sTy &&
          (match bSrc with
           | none => true
           | some aSrc => optNatEq bDst (some aSrc))
      | _, _, _, _ => false
  | .ptrMetadata dst sLoc =>
    match findSliceEntry entries sLoc,
        Trusted.MirSemantics.getElem? decls dst with
    | some _, some (.base dstTy) => MirTy.beq dstTy usizeTy
    | _, _ => false

/-- Static admissibility of terminators for `SliceScalarize`. -/
noncomputable def checkTermForSlices (decls : List ArrSliceLocalDecl)
    (entries : List SliceBackingEntry) : ArrSliceTerm → Bool
  | .baseTerm (.goto _) | .baseTerm .return_ | .baseTerm .unreachable => true
  | .baseTerm (.switchInt d _) => operandUsesOnlyBase decls d
  | .baseTerm .unwindResume | .baseTerm (.assert _ _ _ _ _)
  | .baseTerm (.call _ _ _ _ _) | .baseTerm .unsupported => true
  | .sliceLenCall _ _ _ => false -- Lower via `LowerSliceLenCalls` first.
  | .boundsCheckArray _ o _ _ => operandUsesOnlyBase decls o
  | .boundsCheckSlice sLoc o _ _ =>
    match findSliceEntry entries sLoc with
    | some _ => operandUsesOnlyBase decls o
    | none => false
  | .readArrayElem dst _ o _ =>
    operandUsesOnlyBase decls o &&
      match Trusted.MirSemantics.getElem? decls dst with
      | some (.sliceView _) => false
      | _ => true
  | .writeArrayElem _ i v _ =>
    operandUsesOnlyBase decls i && operandUsesOnlyBase decls v
  | .readSliceElem dst sLoc o _ =>
    operandUsesOnlyBase decls o &&
      match findSliceEntry entries sLoc,
          Trusted.MirSemantics.getElem? decls dst,
          Trusted.MirSemantics.getElem? decls sLoc with
      | some _, some (.base dstTy), some (.sliceView elemTy) =>
        MirTy.beq dstTy elemTy
      | _, _, _ => false
  | .readSliceConst dst sLoc offset minLen _ _ =>
    Nat.blt offset maxUsize && Nat.blt minLen maxUsize &&
      match findSliceEntry entries sLoc,
          Trusted.MirSemantics.getElem? decls dst,
          Trusted.MirSemantics.getElem? decls sLoc with
      | some _, some (.base dstTy), some (.sliceView elemTy) =>
        MirTy.beq dstTy elemTy
      | _, _, _ => false

/-- Layout of scalarized locals added by `SliceScalarize`:
- For slice entry `k ∈ 0 .. K-1`, 4 consecutive locals starting at
  `off = base + 4 * k`: `liveLoc = off`, `tagLoc = off + 1`,
  `startLoc = off + 2`, `lenLoc = off + 3`.
- 5 unannotated body-wide scratch locals starting at `scrBase = base + 4 * K`:
  `scrTag = scrBase`, `scrA = scrBase + 1`, `scrB = scrBase + 2`,
  `scrIdx = scrBase + 3`, `scrCond = scrBase + 4 : .bool`. -/
noncomputable def sliceCompDecls : Nat → List ArrSliceLocalDecl
  | 0 => []
  | k + 1 =>
    .base .unit :: .base usizeTy :: .base usizeTy :: .base usizeTy ::
      sliceCompDecls k

noncomputable def sliceScratchDecls : List ArrSliceLocalDecl :=
  [.base usizeTy, .base usizeTy, .base usizeTy, .base usizeTy, .base .bool]

/-- Lower a single `ArrSliceStmt` under `SliceScalarize` (straight-line, 0
block splits). -/
noncomputable def lowerStmtForSlices (decls : List ArrSliceLocalDecl)
    (entries : List SliceBackingEntry) (base : Nat) :
    ArrSliceStmt → List ArrSliceStmt
  | .baseStmt (.storageLive id) =>
    match findSliceEntry entries id with
    | some (k, _) => mkStorageLiveRange (base + 4 * k) 4
    | none => [.baseStmt (.storageLive id)]
  | .baseStmt (.storageDead id) =>
    match findSliceEntry entries id with
    | some (k, _) => mkStorageDeadRange (base + 4 * k) 4
    | none => [.baseStmt (.storageDead id)]
  | .unsizeArrayToSlice sLoc arrLoc =>
    match findSliceEntry entries sLoc,
        Trusted.MirSemantics.getElem? decls arrLoc with
    | some (k, _), some (.array _ len) =>
      let off := base + 4 * k
      [ .arrayLivenessCheck arrLoc,
        mkLivenessCheckStmt off,
        mkAssignUse (off + 1) (usizeConst 1),
        mkAssignUse (off + 2) (usizeConst 0),
        mkAssignUse (off + 3) (usizeConst len) ]
    | _, _ => [.baseStmt .unsupported]
  | .sliceFromRawParts sLoc lenOp =>
    let scrIdx := base + 4 * entries.length + 3
    match findSliceEntry entries sLoc with
    | some (k, _) =>
      let off := base + 4 * k
      [ mkAssignUse scrIdx lenOp,
        mkLivenessCheckStmt off,
        mkAssignUse (off + 1) (usizeConst 0),
        mkAssignUse (off + 2) (usizeConst 0),
        mkAssignUse (off + 3) (.move { localId := scrIdx, projection := [] }) ]
    | none => [.baseStmt .unsupported]
  | .subslice dstS srcS fromIdx toIdx fromEnd =>
    let scrBase := base + 4 * entries.length
    let scrTag := scrBase
    let scrA := scrBase + 1
    let scrB := scrBase + 2
    let scrIdx := scrBase + 3
    match findSliceEntry entries dstS, findSliceEntry entries srcS with
    | some (kD, _), some (kS, _) =>
      let offD := base + 4 * kD
      let offS := base + 4 * kS
      let readSrc : List ArrSliceStmt := [
        mkLivenessCheckStmt offS,
        mkAssignUse scrTag (.copy { localId := offS + 1, projection := [] })
      ]
      let boundsStmts : List ArrSliceStmt :=
        if !fromEnd then
          if !Nat.ble fromIdx toIdx then
            [mkImmediateUbStmt scrA]
          else
            [ mkSubUncheckedUsize scrA
                (.copy { localId := offS + 3, projection := [] })
                (usizeConst toIdx),
              mkAddUncheckedUsize scrIdx
                (.copy { localId := offS + 2, projection := [] })
                (usizeConst fromIdx),
              mkAssignUse scrB (usizeConst (toIdx - fromIdx)) ]
        else
          if !Nat.blt (fromIdx + toIdx) maxUsize then
            [mkImmediateUbStmt scrA]
          else
            [ mkSubUncheckedUsize scrB
                (.copy { localId := offS + 3, projection := [] })
                (usizeConst (fromIdx + toIdx)),
              mkAddUncheckedUsize scrIdx
                (.copy { localId := offS + 2, projection := [] })
                (usizeConst fromIdx) ]
      let writeDst : List ArrSliceStmt := [
        mkLivenessCheckStmt offD,
        mkAssignUse (offD + 1) (.move { localId := scrTag, projection := [] }),
        mkAssignUse (offD + 2) (.move { localId := scrIdx, projection := [] }),
        mkAssignUse (offD + 3) (.move { localId := scrB, projection := [] })
      ]
      readSrc ++ boundsStmts ++ writeDst
    | _, _ => [.baseStmt .unsupported]
  | .ptrMetadata dst sLoc =>
    let scrTag := base + 4 * entries.length
    match findSliceEntry entries sLoc with
    | some (k, _) =>
      let off := base + 4 * k
      [ mkLivenessCheckStmt off,
        mkAssignUse scrTag (.copy { localId := off + 1, projection := [] }),
        mkAssignUse dst (.copy { localId := off + 3, projection := [] }) ]
    | none => [.baseStmt .unsupported]
  | other => [other]

/-- Lower a block terminator under `SliceScalarize`, appending prefix
statements into the same basic block (`0` new basic blocks added). -/
noncomputable def lowerTermForSlices (entries : List SliceBackingEntry)
    (base : Nat) : ArrSliceTerm → List ArrSliceStmt × ArrSliceTerm
  | .boundsCheckSlice sLoc idxOp inBoundsBb panicBb =>
    let scrBase := base + 4 * entries.length
    let scrTag := scrBase
    let scrIdx := scrBase + 3
    let scrCond := scrBase + 4
    match findSliceEntry entries sLoc with
    | some (k, _) =>
      let off := base + 4 * k
      ([ mkLivenessCheckStmt off,
         mkAssignUse scrTag (.copy { localId := off + 1, projection := [] }),
         mkAssignUse scrIdx idxOp,
         mkLtUsize scrCond
           (.move { localId := scrIdx, projection := [] })
           (.copy { localId := off + 3, projection := [] }) ],
       .baseTerm (.switchInt (.move { localId := scrCond, projection := [] })
         { branches := [(BitVec.ofNat 128 1, inBoundsBb)], otherwise := panicBb }))
    | none => ([], .baseTerm .unsupported)
  | .readSliceElem dst sLoc idxOp nextBb =>
    let scrBase := base + 4 * entries.length
    let scrTag := scrBase
    let scrA := scrBase + 1
    let scrB := scrBase + 2
    let scrIdx := scrBase + 3
    match findSliceEntry entries sLoc with
    | some (k, optArr) =>
      let off := base + 4 * k
      let pre : List ArrSliceStmt := [
        mkLivenessCheckStmt off,
        mkAssignUse scrTag (.copy { localId := off + 1, projection := [] }),
        mkAssignUse scrIdx idxOp,
        mkSubUncheckedUsize scrA
          (.copy { localId := off + 3, projection := [] }) (usizeConst 1),
        mkSubUncheckedUsize scrB
          (.move { localId := scrA, projection := [] })
          (.copy { localId := scrIdx, projection := [] }),
        mkSubUncheckedUsize scrB
          (.move { localId := scrTag, projection := [] }) (usizeConst 1)
      ]
      match optArr with
      | some arrLoc =>
        (pre ++ [mkAddUncheckedUsize scrIdx
          (.copy { localId := off + 2, projection := [] })
          (.copy { localId := scrIdx, projection := [] })],
         .readArrayElem dst arrLoc
           (.move { localId := scrIdx, projection := [] }) nextBb)
      | none => (pre, .baseTerm .unreachable)
    | none => ([], .baseTerm .unsupported)
  | .readSliceConst dst sLoc offset minLen fromEnd nextBb =>
    let scrBase := base + 4 * entries.length
    let scrTag := scrBase
    let scrA := scrBase + 1
    let scrB := scrBase + 2
    let scrIdx := scrBase + 3
    match findSliceEntry entries sLoc with
    | some (k, optArr) =>
      let off := base + 4 * k
      let preHead : List ArrSliceStmt := [
        mkLivenessCheckStmt off,
        mkAssignUse scrTag (.copy { localId := off + 1, projection := [] }),
        mkSubUncheckedUsize scrA
          (.copy { localId := off + 3, projection := [] }) (usizeConst minLen)
      ]
      let relStmts : List ArrSliceStmt :=
        if !fromEnd then
          [ mkSubUncheckedUsize scrA
              (.copy { localId := off + 3, projection := [] }) (usizeConst 1),
            mkSubUncheckedUsize scrB
              (.move { localId := scrA, projection := [] }) (usizeConst offset),
            mkAssignUse scrIdx (usizeConst offset) ]
        else
          if Nat.beq offset 0 then
            [mkImmediateUbStmt scrA]
          else
            [mkSubUncheckedUsize scrIdx
              (.copy { localId := off + 3, projection := [] }) (usizeConst offset)]
      let tagChk : List ArrSliceStmt := [
        mkSubUncheckedUsize scrB
          (.move { localId := scrTag, projection := [] }) (usizeConst 1)
      ]
      match optArr with
      | some arrLoc =>
        (preHead ++ relStmts ++ tagChk ++
          [mkAddUncheckedUsize scrIdx
            (.copy { localId := off + 2, projection := [] })
            (.copy { localId := scrIdx, projection := [] })],
         .readArrayElem dst arrLoc
           (.move { localId := scrIdx, projection := [] }) nextBb)
      | none => (preHead ++ relStmts ++ tagChk, .baseTerm .unreachable)
    | none => ([], .baseTerm .unsupported)
  | other => ([], other)

noncomputable def lowerBlockForSlices (decls : List ArrSliceLocalDecl)
    (entries : List SliceBackingEntry) (base : Nat)
    (bb : ArrSliceBlock) : ArrSliceBlock :=
  let bodyStmts := listFlatMap (lowerStmtForSlices decls entries base) bb.statements
  let (termPre, termTgt) := lowerTermForSlices entries base bb.terminator
  { bb with statements := bodyStmts ++ termPre, terminator := termTgt }

noncomputable def applySliceScalarize (plan : SliceScalarizePlan)
    (pSrc : ArrSliceProgram) : Option ArrSliceProgram :=
  match Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => none
  | some body =>
    if body.basicBlocks.isEmpty ||
        !Nat.blt body.argumentCount body.locals.length ||
        !arrSliceStorageAnnotationsInBounds body ||
        !arrSliceBodyLocalsInBounds body ||
        !arrSliceBodyTargetsInBounds body ||
        !checkSliceBackingEntriesLoop body.locals body.argumentCount 0
          body.locals plan.entries then
      none
    else if !body.basicBlocks.all (fun bb =>
        bb.statements.all (checkStmtForSlices body.locals plan.entries) &&
          checkTermForSlices body.locals plan.entries bb.terminator) then
      none
    else
      let base := body.locals.length
      let bodyTgt : ArrSliceBody := {
        body with
        locals := tombstoneSliceDecls body.locals ++
          sliceCompDecls plan.entries.length ++ sliceScratchDecls
        basicBlocks :=
          body.basicBlocks.map (lowerBlockForSlices body.locals plan.entries base)
      }
      match setElem? pSrc.bodies plan.defId bodyTgt with
      | none => none
      | some bodiesTgt => some { pSrc with bodies := bodiesTgt }

/-! ### Pass 4: `ArrayScalarize` (Single-Array Lowering to Unmodified `Trusted.MirAst`) -/

structure ArrayScalarizePlan where
  defId : DefId
  arrLocal : LocalId

/-- Check that `stmt` contains no remaining slice reference to `arrLocal` and
satisfies static type compatibility when targeting `arrLocal`. -/
noncomputable def checkStmtForArray (decls : List ArrSliceLocalDecl)
    (arrLocal : LocalId) (elemTy : MirTy) (len : Nat) : ArrSliceStmt → Bool
  | .baseStmt (.storageLive _) | .baseStmt (.storageDead _)
  | .baseStmt .nop | .baseStmt .unsupported => true
  | .baseStmt (.assign dst rval) =>
    if !dst.projection.isEmpty then true
    else
      !Nat.beq dst.localId arrLocal && rvalueUsesOnlyBase decls rval
  | .aggregateArray a ops =>
    if Nat.beq a arrLocal then
      Nat.beq ops.length len && ops.all (operandUsesOnlyBase decls)
    else
      ops.all (operandUsesOnlyBase decls)
  | .repeatArray a op =>
    if Nat.beq a arrLocal then operandUsesOnlyBase decls op
    else operandUsesOnlyBase decls op
  | .arrayLivenessCheck _ => true
  | .readArrayConst dst a _ _ =>
    if Nat.beq a arrLocal then
      !Nat.beq dst arrLocal &&
        match Trusted.MirSemantics.getElem? decls dst with
        | some (.base dstTy) => MirTy.beq dstTy elemTy
        | _ => false
    else
      !Nat.beq dst arrLocal
  | .writeArrayConst _ _ rval => rvalueUsesOnlyBase decls rval
  | .unsizeArrayToSlice _ a => !Nat.beq a arrLocal
  | .sliceFromRawParts _ o => operandUsesOnlyBase decls o
  | .subslice _ _ _ _ _ => true
  | .ptrMetadata dst _ => !Nat.beq dst arrLocal

noncomputable def checkTermForArray (decls : List ArrSliceLocalDecl)
    (arrLocal : LocalId) (elemTy : MirTy) : ArrSliceTerm → Bool
  | .baseTerm (.goto _) | .baseTerm .return_ | .baseTerm .unreachable => true
  | .baseTerm (.switchInt d _) => operandUsesOnlyBase decls d
  | .baseTerm .unwindResume | .baseTerm (.assert _ _ _ _ _)
  | .baseTerm (.call _ _ _ _ _) | .baseTerm .unsupported => true
  | .sliceLenCall dst _ _ => !Nat.beq dst arrLocal
  | .boundsCheckArray _ o _ _ | .boundsCheckSlice _ o _ _ =>
    operandUsesOnlyBase decls o
  | .readArrayElem dst a o _ =>
    operandUsesOnlyBase decls o &&
      if Nat.beq a arrLocal then
        !Nat.beq dst arrLocal &&
          match Trusted.MirSemantics.getElem? decls dst with
          | some (.base dstTy) => MirTy.beq dstTy elemTy
          | _ => false
      else
        !Nat.beq dst arrLocal
  | .writeArrayElem _ i v _ =>
    operandUsesOnlyBase decls i && operandUsesOnlyBase decls v
  | .readSliceElem dst _ _ _ | .readSliceConst dst _ _ _ _ _ =>
    !Nat.beq dst arrLocal

/-- Layout of scalarized locals added by `ArrayScalarize` for `arrLocal`
(`[elemTy; len]`):
- `base + 0`: `liveLoc : .unit` (mirrors `StorageLive`/`StorageDead`)
- `base + 1 .. base + len`: `elem_0 .. elem_{len-1} : elemTy` (mirror storage)
- `scrBase = base + 1 + len`: unannotated scratch locals:
  * `scrBase + 0`: `faultUsize : usize`
  * `scrBase + 1`: `idxScr : usize`
  * `scrBase + 2`: `condScr : .bool`
  * `scrBase + 3`: `valScr : elemTy`
  * `scrBase + 4 .. scrBase + 4 + len - 1`: `opScr_0 .. opScr_{len-1} : elemTy` -/
noncomputable def mkEvalOpsToArrScratch (scrStart : Nat) :
    List Operand → List ArrSliceStmt
  | [] => []
  | op :: rest =>
    mkAssignUse scrStart op :: mkEvalOpsToArrScratch (scrStart + 1) rest

noncomputable def mkMoveArrScratchToElems (elemStart scrStart : Nat) :
    Nat → List ArrSliceStmt
  | 0 => []
  | k + 1 =>
    mkAssignUse elemStart (.move { localId := scrStart, projection := [] }) ::
      mkMoveArrScratchToElems (elemStart + 1) (scrStart + 1) k

noncomputable def mkCopyValToElems (valScr elemStart : Nat) :
    Nat → List ArrSliceStmt
  | 0 => []
  | k + 1 =>
    mkAssignUse elemStart (.copy { localId := valScr, projection := [] }) ::
      mkCopyValToElems valScr (elemStart + 1) k

noncomputable def lowerStmtForArray (arrLocal base len : Nat) :
    ArrSliceStmt → List ArrSliceStmt
  | .baseStmt (.storageLive id) =>
    if Nat.beq id arrLocal then
      mkStorageLiveRange base (1 + len)
    else
      [.baseStmt (.storageLive id)]
  | .baseStmt (.storageDead id) =>
    if Nat.beq id arrLocal then
      mkStorageDeadRange base (1 + len)
    else
      [.baseStmt (.storageDead id)]
  | .aggregateArray a ops =>
    if Nat.beq a arrLocal then
      let opScrStart := base + 1 + len + 4
      mkEvalOpsToArrScratch opScrStart ops ++
        [mkLivenessCheckStmt base] ++
        mkMoveArrScratchToElems (base + 1) opScrStart len
    else
      [.aggregateArray a ops]
  | .repeatArray a op =>
    if Nat.beq a arrLocal then
      let valScr := base + 1 + len + 3
      [mkAssignUse valScr op, mkLivenessCheckStmt base] ++
        mkCopyValToElems valScr (base + 1) len
    else
      [.repeatArray a op]
  | .arrayLivenessCheck a =>
    if Nat.beq a arrLocal then [mkLivenessCheckStmt base]
    else [.arrayLivenessCheck a]
  | .readArrayConst dst a idx isMove =>
    if Nat.beq a arrLocal then
      let faultScr := base + 1 + len
      if Nat.blt idx len then
        let op : Operand :=
          if isMove then
            .move { localId := base + 1 + idx, projection := [] }
          else
            .copy { localId := base + 1 + idx, projection := [] }
        [mkLivenessCheckStmt base, mkAssignUse dst op]
      else
        [mkLivenessCheckStmt base, mkImmediateUbStmt faultScr]
    else
      [.readArrayConst dst a idx isMove]
  | .writeArrayConst a idx rval =>
    if Nat.beq a arrLocal then
      let faultScr := base + 1 + len
      let valScr := base + 1 + len + 3
      let evalRval : ArrSliceStmt :=
        .baseStmt (.assign { localId := valScr, projection := [] } rval)
      if Nat.blt idx len then
        [ evalRval,
          mkLivenessCheckStmt base,
          mkAssignUse (base + 1 + idx)
            (.move { localId := valScr, projection := [] }) ]
      else
        [evalRval, mkLivenessCheckStmt base, mkImmediateUbStmt faultScr]
    else
      [.writeArrayConst a idx rval]
  | other => [other]

/-- Build trailing `SwitchInt` dispatch branches & blocks (`≥ nextBb`) for
dynamic `readArrayElem` (`k = 0 .. len - 1`, `otherwise = trapBb`). -/
noncomputable def buildReadArrayArms (dst elemBase nextBb : Nat) :
    Nat → Nat → Nat → List (BitVec 128 × BasicBlockId) × List ArrSliceBlock
  | _, _, 0 => ([], [])
  | idx, armBb, rem + 1 =>
    let arm : ArrSliceBlock := {
      statements :=
        [mkAssignUse dst (.copy { localId := elemBase + idx, projection := [] })]
      terminator := .baseTerm (.goto nextBb)
      cleanup := false
    }
    let rest := buildReadArrayArms dst elemBase nextBb (idx + 1) (armBb + 1) rem
    ((BitVec.ofNat 128 idx, armBb) :: rest.1, arm :: rest.2)

/-- Build trailing `SwitchInt` dispatch branches & blocks (`≥ nextBb`) for
dynamic `writeArrayElem` (`k = 0 .. len - 1`, `otherwise = trapBb`). -/
noncomputable def buildWriteArrayArms (valScr elemBase nextBb : Nat) :
    Nat → Nat → Nat → List (BitVec 128 × BasicBlockId) × List ArrSliceBlock
  | _, _, 0 => ([], [])
  | idx, armBb, rem + 1 =>
    let arm : ArrSliceBlock := {
      statements :=
        [mkAssignUse (elemBase + idx)
          (.move { localId := valScr, projection := [] })]
      terminator := .baseTerm (.goto nextBb)
      cleanup := false
    }
    let rest :=
      buildWriteArrayArms valScr elemBase nextBb (idx + 1) (armBb + 1) rem
    ((BitVec.ofNat 128 idx, armBb) :: rest.1, arm :: rest.2)

/-- Lower an `ArrSliceTerm` under `ArrayScalarize`, optionally appending
trailing dispatch blocks at `nextExtraBb ..`. -/
noncomputable def lowerTermForArray (arrLocal base len nextExtraBb : Nat) :
    ArrSliceTerm → List ArrSliceStmt × ArrSliceTerm × List ArrSliceBlock
  | .boundsCheckArray a idxOp inBoundsBb panicBb =>
    if Nat.beq a arrLocal then
      let idxScr := base + 1 + len + 1
      let condScr := base + 1 + len + 2
      ([ mkLivenessCheckStmt base,
         mkAssignUse idxScr idxOp,
         mkLtUsize condScr
           (.move { localId := idxScr, projection := [] }) (usizeConst len) ],
       .baseTerm (.switchInt (.move { localId := condScr, projection := [] })
         { branches := [(BitVec.ofNat 128 1, inBoundsBb)], otherwise := panicBb }),
       [])
    else
      ([], .boundsCheckArray a idxOp inBoundsBb panicBb, [])
  | .readArrayElem dst a idxOp nextBb =>
    if Nat.beq a arrLocal then
      let idxScr := base + 1 + len + 1
      let built := buildReadArrayArms dst (base + 1) nextBb 0 nextExtraBb len
      let trapBbId := nextExtraBb + len
      let trapBb : ArrSliceBlock := {
        statements := []
        terminator := .baseTerm .unreachable
        cleanup := false
      }
      ([mkAssignUse idxScr idxOp, mkLivenessCheckStmt base],
       .baseTerm (.switchInt (.move { localId := idxScr, projection := [] })
         { branches := built.1, otherwise := trapBbId }),
       built.2 ++ [trapBb])
    else
      ([], .readArrayElem dst a idxOp nextBb, [])
  | .writeArrayElem a idxOp valOp nextBb =>
    if Nat.beq a arrLocal then
      let idxScr := base + 1 + len + 1
      let valScr := base + 1 + len + 3
      let built :=
        buildWriteArrayArms valScr (base + 1) nextBb 0 nextExtraBb len
      let trapBbId := nextExtraBb + len
      let trapBb : ArrSliceBlock := {
        statements := []
        terminator := .baseTerm .unreachable
        cleanup := false
      }
      ([mkAssignUse idxScr idxOp, mkAssignUse valScr valOp,
        mkLivenessCheckStmt base],
       .baseTerm (.switchInt (.move { localId := idxScr, projection := [] })
         { branches := built.1, otherwise := trapBbId }),
       built.2 ++ [trapBb])
    else
      ([], .writeArrayElem a idxOp valOp nextBb, [])
  | other => ([], other, [])

noncomputable def lowerBlocksForArrayLoop (arrLocal base len : Nat) :
    Nat → List ArrSliceBlock → List ArrSliceBlock × List ArrSliceBlock
  | _, [] => ([], [])
  | nextExtra, bb :: rest =>
    let bodyStmts := listFlatMap (lowerStmtForArray arrLocal base len) bb.statements
    let (termPre, termTgt, extra) :=
      lowerTermForArray arrLocal base len nextExtra bb.terminator
    let bbTgt : ArrSliceBlock := {
      bb with
      statements := bodyStmts ++ termPre
      terminator := termTgt
    }
    let tail :=
      lowerBlocksForArrayLoop arrLocal base len (nextExtra + extra.length) rest
    (bbTgt :: tail.1, extra ++ tail.2)

noncomputable def applyArrayScalarize (plan : ArrayScalarizePlan)
    (pSrc : ArrSliceProgram) : Option ArrSliceProgram :=
  match Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => none
  | some body =>
    if body.basicBlocks.isEmpty ||
        !Nat.blt body.argumentCount plan.arrLocal ||
        !Nat.blt plan.arrLocal body.locals.length ||
        !arrSliceStorageAnnotationsInBounds body ||
        !arrSliceBodyLocalsInBounds body ||
        !arrSliceBodyTargetsInBounds body then
      none
    else
      match Trusted.MirSemantics.getElem? body.locals plan.arrLocal with
      | some (.array elemTy len) =>
        if !isSupportedScalarOrUnitTy elemTy || !Nat.ble len 64 then
          none
        else if body.locals.any (fun d =>
            match d with | .sliceView _ => true | _ => false) then
          none -- Scalarize `.sliceView` locals first via `SliceScalarize`.
        else if !body.basicBlocks.all (fun bb =>
            bb.statements.all (checkStmtForArray body.locals plan.arrLocal elemTy len) &&
              checkTermForArray body.locals plan.arrLocal elemTy bb.terminator) then
          none
        else
          match setElem? body.locals plan.arrLocal (.base .unit) with
          | none => none
          | some localsTombstoned =>
            let base := body.locals.length
            let elemDecls := listReplicate len (.base elemTy)
            let scrDecls : List ArrSliceLocalDecl :=
              [.base usizeTy, .base usizeTy, .base .bool, .base elemTy] ++
                listReplicate len (.base elemTy)
            let lowered :=
              lowerBlocksForArrayLoop plan.arrLocal base len
                body.basicBlocks.length body.basicBlocks
            let bodyTgt : ArrSliceBody := {
              body with
              locals := localsTombstoned ++ [.base .unit] ++ elemDecls ++ scrDecls
              basicBlocks := lowered.1 ++ lowered.2
            }
            match setElem? pSrc.bodies plan.defId bodyTgt with
            | none => none
            | some bodiesTgt => some { pSrc with bodies := bodiesTgt }
      | _ => none

/-! ### Unified `ArrSliceOptStep`, `ArrSliceOptTrace`, & `Trusted.MirAst` Validator -/

inductive ArrSliceOptStep where
  | lowerSliceLenCalls (bodyId : DefId) (bbIdx : BasicBlockId)
  | gvnFoldPtrMetadata (bodyId : DefId) (bbIdx : BasicBlockId)
      (unsizeIdx metaIdx : Nat)
  | sliceScalarize (plan : SliceScalarizePlan)
  | arrayScalarize (plan : ArrayScalarizePlan)

abbrev ArrSliceOptTrace := List ArrSliceOptStep

noncomputable def applyArrSliceOptStep :
    ArrSliceOptStep → ArrSliceProgram → Option ArrSliceProgram
  | .lowerSliceLenCalls bodyId bbIdx, p =>
    applyLowerSliceLenCalls bodyId bbIdx p
  | .gvnFoldPtrMetadata bodyId bbIdx uIdx mIdx, p =>
    applyGvnFoldPtrMetadata bodyId bbIdx uIdx mIdx p
  | .sliceScalarize plan, p => applySliceScalarize plan p
  | .arrayScalarize plan, p => applyArrayScalarize plan p

noncomputable def applyArrSliceOptTrace :
    ArrSliceOptTrace → ArrSliceProgram → Option ArrSliceProgram
  | [], p => some p
  | step :: rest, p =>
    match applyArrSliceOptStep step p with
    | some pMid => applyArrSliceOptTrace rest pMid
    | none => none

/-- Decidable certificate validator checking `pSrc --[trace]*--> pFlat` AND
projecting `pFlat` directly onto an unmodified `Trusted.MirAst.Program`
(`pMir`). -/
noncomputable def checkArrSliceToTrustedMir (trace : ArrSliceOptTrace)
    (pSrc : ArrSliceProgram) (pMir : Program) : Bool :=
  match applyArrSliceOptTrace trace pSrc with
  | none => false
  | some pFlat =>
    match unembedBaseProgram pFlat with
    | some pOut => programEq pOut pMir
    | none => false

/-! ### Minimal Constructive Shims for `Trusted.MirAst` + `Trusted.MirSemantics` Scope -/

private theorem s_nat_lt_of_add_lt_add_left : ∀ {k m n : Nat}, k + m < k + n → m < n
  | 0, m, n, h => by rw [Nat.zero_add, Nat.zero_add] at h; exact h
  | k + 1, m, n, h => by
    rw [Nat.succ_add, Nat.succ_add] at h
    exact s_nat_lt_of_add_lt_add_left (Nat.lt_of_succ_lt_succ h)

private theorem s_nat_lt_of_add_lt_add_right {m n k : Nat} (h : m + k < n + k) : m < n := by
  rw [Nat.add_comm m k, Nat.add_comm n k] at h
  exact s_nat_lt_of_add_lt_add_left h

private theorem s_nat_add_sub_cancel_prime {m n : Nat} (h : n ≤ m) : n + (m - n) = m := by
  rw [Nat.add_comm, Nat.sub_add_cancel h]

private theorem s_nat_pow_pos {n k : Nat} (hn : 0 < n) : 0 < Nat.pow n k := by
  induction k with
  | zero => exact Nat.zero_lt_one
  | succ k ih =>
    change 0 < Nat.pow n k * n
    exact Nat.mul_pos ih hn

private theorem s_nat_one_lt_pow {n k : Nat} (hk : k ≠ 0) (hn : 2 ≤ n) : 1 < Nat.pow n k := by
  cases k with
  | zero => exact False.elim (hk rfl)
  | succ m =>
    change 1 < Nat.pow n m * n
    have hp : 1 ≤ Nat.pow n m := s_nat_pow_pos (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) hn)
    have hmul := Nat.mul_le_mul_right n hp
    rw [Nat.one_mul] at hmul
    exact Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le (Nat.lt_succ_self 1) hn) hmul

private theorem s_nat_sub_lt_of_lt {a b : Nat} (h : a < b) : ∃ k : Nat, b - a = k + 1 := by
  cases hSub : b - a with
  | zero =>
    have hLe : b ≤ a := Nat.le_of_sub_eq_zero hSub
    exact False.elim (Nat.not_lt_of_ge hLe h)
  | succ k => exact ⟨k, rfl⟩

private theorem s_int_ofNat_lt_mpr {a b : Nat} (h : a < b) : Int.ofNat a < Int.ofNat b := by
  change (Int.subNatNat b (a + 1)).NonNeg
  unfold Int.subNatNat
  have hSubZ : (a + 1) - b = 0 := Nat.sub_eq_zero_of_le h
  rw [hSubZ]
  exact Int.NonNeg.mk _

private theorem s_int_ofNat_lt_mp {a b : Nat} (h : Int.ofNat a < Int.ofNat b) : a < b := by
  change (Int.subNatNat b (a + 1)).NonNeg at h
  cases Nat.lt_or_ge a b with
  | inl hlt => exact hlt
  | inr hge =>
    have hle : b < a + 1 := Nat.lt_succ_of_le hge
    cases s_nat_sub_lt_of_lt hle with
    | intro k hk =>
      unfold Int.subNatNat at h
      rw [hk] at h
      cases h

private theorem s_int_natCast_nonneg (n : Nat) : (0 : Int) ≤ Int.ofNat n := by
  change (Int.ofNat n - (0 : Int)).NonNeg
  exact Int.NonNeg.mk n

private theorem s_int_not_lt_zero_ofNat {n : Nat} (_ : 0 ≤ Int.ofNat n) : ¬ (Int.ofNat n < 0) := by
  intro hlt
  change (Int.negSucc n).NonNeg at hlt
  cases hlt

private theorem s_int_not_le_of_lt_ofNat {a b : Nat} (h : Int.ofNat a < Int.ofNat b) :
    ¬ (Int.ofNat b ≤ Int.ofNat a) := by
  intro hle
  have hlt := s_int_ofNat_lt_mp h
  cases b with
  | zero => cases hlt
  | succ b0 =>
    change (Int.subNatNat a (b0 + 1)).NonNeg at hle
    cases s_nat_sub_lt_of_lt hlt with
    | intro k hk =>
      unfold Int.subNatNat at hle
      rw [hk] at hle
      cases hle

private theorem s_int_ofNat_sub {m n : Nat} (h : m ≤ n) :
    Int.ofNat (n - m) = Int.ofNat n - Int.ofNat m := by
  cases m with
  | zero => rfl
  | succ m0 =>
    change Int.ofNat (n - (m0 + 1)) = Int.subNatNat n (m0 + 1)
    unfold Int.subNatNat
    have hSubZ : (m0 + 1) - n = 0 := Nat.sub_eq_zero_of_le h
    rw [hSubZ]

private theorem s_int_ofNat_sub_lt_zero {a b : Nat} (h : a < b) :
    Int.ofNat a - Int.ofNat b < 0 := by
  cases b with
  | zero => cases h
  | succ b0 =>
    change (0 - (Int.subNatNat a (b0 + 1) + 1)).NonNeg
    cases s_nat_sub_lt_of_lt h with
    | intro k hk =>
      have hEq : Int.subNatNat a (b0 + 1) = Int.negSucc k := by
        unfold Int.subNatNat
        rw [hk]
      rw [hEq]
      cases k with
      | zero => exact Int.NonNeg.mk 0
      | succ k0 => exact Int.NonNeg.mk (0 + (k0 + 1))

