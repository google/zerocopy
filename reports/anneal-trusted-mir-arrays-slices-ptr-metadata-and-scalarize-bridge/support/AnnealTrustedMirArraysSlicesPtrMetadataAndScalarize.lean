    exact hD
  have hDstSlot := hLM.2.2.2 rDst hrLt5
  cases hDstSlot with | intro ov hOv =>
  have hStep := step_mkAssignUse_const_usize pTgt pack.bodyTgt bbTgt frame₂ cm dst n ov hn
    hBodyTgt hBbTgt hStmt hDstDecl hOv
  cases hStep with | intro slots₂' hS =>
  have hLM' := sliceLocalMatch_set_scratch pack hLM hrLt5
    (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))) hS.1
  exact ⟨slots₂', hS.2, hLM', getElem?_setElem?_self frame₂.locals dst _ slots₂' hS.1⟩

private theorem step_subUnchecked_copy_const_from_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (slots₁ : List ArrSliceSlot) (rDst : Nat) (hrDst : rDst < 4)
    (src : LocalId) (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies frame₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks frame₂.blockIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements frame₂.stmtIdx =
      some (mkSubUncheckedUsize (pack.bodySrc.locals.length + 4 * plan.entries.length + rDst)
        (.copy { localId := src, projection := [] }) (usizeConst b)))
    (hLM : SliceLocalMatch pack slots₁ frame₂.locals)
    (hSrcDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals src = some (.base usizeTy))
    (hSrcSlot : Trusted.MirSemantics.getElem? frame₂.locals src =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a))))))) :
    (a < b →
      evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
        StepResult.fault FaultKind.undefined) ∧
    (b ≤ a →
      ∃ slots₂',
        evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
          stepStmtNext frame₂ cm slots₂' ∧
        SliceLocalMatch pack slots₁ slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length + rDst) =
          some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b)))))))) := by
  let dst := pack.bodySrc.locals.length + 4 * plan.entries.length + rDst
  have hrLt5 : rDst < 5 := Nat.lt_trans hrDst (by decide)
  have hNe4 : Nat.beq rDst 4 = false := by
    cases rDst with
    | zero => rfl
    | succ r1 =>
      cases r1 with
      | zero => rfl
      | succ r2 =>
        cases r2 with
        | zero => rfl
        | succ r3 =>
          cases r3 with
          | zero => rfl
          | succ _ => exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hrDst)))))
  have hDstDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some (.base usizeTy) := by
    have hD := getElem?_bodyTgt_locals_scratch pack hrLt5
