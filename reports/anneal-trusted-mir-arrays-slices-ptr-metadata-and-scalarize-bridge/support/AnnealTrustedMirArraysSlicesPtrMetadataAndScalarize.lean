private theorem step_readTag_from_rel_set
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
