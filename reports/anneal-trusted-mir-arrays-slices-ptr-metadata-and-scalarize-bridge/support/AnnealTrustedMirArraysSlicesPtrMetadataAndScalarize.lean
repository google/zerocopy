private theorem bitWidth_isize_eq : IntWidth.isize.bitWidth = 64 := by
  rfl

private theorem maxUsize_eq : maxUsize = Nat.pow 2 64 := by
  rfl

private theorem truncateBits_isize_lt_maxUsize (bv : BitVec 128) :
    (truncateBits IntWidth.isize bv).toNat < maxUsize := by
  change (BitVec.ofNat 128 (bvExtractLsb (IntWidth.isize.bitWidth - 1) 0 bv).toNat).toNat < maxUsize
  rw [bitWidth_isize_eq, maxUsize_eq]
  have hlt64 : (bvExtractLsb (64 - 1) 0 bv).toNat < Nat.pow 2 64 := BitVec.isLt _
  have hlt128 : (bvExtractLsb (64 - 1) 0 bv).toNat < Nat.pow 2 128 :=
    Nat.lt_trans hlt64 maxUsize_lt_pow128
  rw [bitVec_ofNat_toNat_of_lt hlt128]
  exact hlt64

private theorem scalarVal_wf_isize_lt_maxUsize (sv : ScalarVal)
    (hwf : sv.wf = true) (hw : sv.width = IntWidth.isize) :
    sv.bits.toNat < maxUsize := by
  have htr : truncateBits IntWidth.isize sv.bits = sv.bits := by
    have h1 : (truncateBits sv.width sv.bits == sv.bits) = true := hwf
    rw [hw] at h1
    exact beq_iff_eq.mp h1
  rw [← htr]
  exact truncateBits_isize_lt_maxUsize sv.bits

private theorem checkVal_usize_iff (v : Val) :
    checkVal v usizeTy = true ↔
      ∃ sv : ScalarVal, v = .scalar sv ∧ sv.wf = true ∧
        sv.width = IntWidth.isize ∧ sv.signed = false := by
  constructor
  · intro h
    cases v with
    | scalar sv =>
      change (match if sv.wf = true then some (MirTy.int sv.width sv.signed) else none with
        | some vTy => vTy.beq usizeTy
        | none => false) = true at h
      cases hwf : sv.wf with
      | false =>
        rw [hwf] at h
        cases h
      | true =>
        rw [hwf] at h
        have hbeq : (MirTy.int sv.width sv.signed).beq (MirTy.int IntWidth.isize false) = true := h
        have hEq := mirTy_beq_eq (MirTy.int sv.width sv.signed) (MirTy.int IntWidth.isize false) hbeq
        have hw : sv.width = IntWidth.isize := by injection hEq
        have hs : sv.signed = false := by injection hEq
        exact ⟨sv, rfl, hwf, hw, hs⟩
    | bool _ => cases h
    | unit => cases h
    | enumVal ety idx =>
      change (match if (enumAdmitted ety && idx.blt ety.discriminants.length) = true
          then some (MirTy.enum ety) else none with
        | some vTy => vTy.beq usizeTy
        | none => false) = true at h
      cases hadm : (enumAdmitted ety && idx.blt ety.discriminants.length) with
      | false => rw [hadm] at h; cases h
      | true => rw [hadm] at h; cases h
    | ptr _ => cases h
    | tuple _ => cases h
    | bytes _ => cases h
  · intro h
    cases h with | intro sv hSv =>
    rw [hSv.1]
    change (match if sv.wf = true then some (MirTy.int sv.width sv.signed) else none with
      | some vTy => vTy.beq usizeTy
      | none => false) = true
    rw [hSv.2.1, hSv.2.2.1, hSv.2.2.2]
    rfl

private theorem int_pow_2_128_eq : HPow.hPow (2 : Int) (128 : Nat) = Int.ofNat (Nat.pow 2 128) := by
  rfl

private theorem decodeScalar_usize (n : Nat) (hn : n < maxUsize) :
    decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)) =
      Int.ofNat n := by
  have h128 : n < Nat.pow 2 128 := Nat.lt_trans hn maxUsize_lt_pow128
  change (if false = true then
      signExtendBits IntWidth.isize (truncateBits IntWidth.isize (BitVec.ofNat 128 n))
    else Int.ofNat (truncateBits IntWidth.isize (BitVec.ofNat 128 n)).toNat) = Int.ofNat n
  rw [truncateBits_isize_of_lt_maxUsize n hn, bitVec_ofNat_toNat_of_lt h128]
  rfl

private theorem bvOfInt_128_ofNat (n : Nat) (hn : n < Nat.pow 2 128) :
    bvOfInt 128 (Int.ofNat n) = BitVec.ofNat 128 n := by
  change BitVec.ofNat 128 (intEmod (Int.ofNat n) (Int.ofNat (Nat.pow 2 128))).toNat =
    BitVec.ofNat 128 n
  have heq : intEmod (Int.ofNat n) (Int.ofNat (Nat.pow 2 128)) = Int.ofNat n :=
    congrArg Int.ofNat (Nat.mod_eq_of_lt hn)
  rw [heq]
  rfl

private theorem bitVec_bne_self {w : Nat} (bv : BitVec w) :
    (bv != bv) = false := by
  cases h : (bv != bv) with
  | false => rfl
  | true => exact False.elim (bne_iff_ne.mp h rfl)

private theorem int_sub_lt_zero_of_lt {a b : Nat} (h : a < b) :
    Int.ofNat a - Int.ofNat b < 0 := by
  exact s_int_ofNat_sub_lt_zero h

private theorem evalBinOp_usize_addUnchecked_ok (a b : Nat) (h : a + b < maxUsize) :
    evalBinOp .addUnchecked
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a + b)))) := by
  have ha : a < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_right a b) h
  have hb : b < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left b a) h
  have hsum128 : a + b < Nat.pow 2 128 := Nat.lt_trans h maxUsize_lt_pow128
  change evalArithOp .addUnchecked IntWidth.isize false
      (decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
      (decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) = _
  rw [decodeScalar_usize a ha, decodeScalar_usize b hb]
  change (match truncateScalar IntWidth.isize false (Int.ofNat a + Int.ofNat b) with
    | Except.error k => Except.error k
    | Except.ok (val, lossy) =>
      if ((decide (Int.ofNat a + Int.ofNat b < 0) ||
            decide (Int.ofNat a + Int.ofNat b ≥ HPow.hPow (2 : Int) (128 : Nat)) || lossy) && true) = true then
        Except.error FaultKind.undefined
      else Except.ok (Val.scalar val)) = _
  have hadd : Int.ofNat a + Int.ofNat b = Int.ofNat (a + b) := rfl
  rw [hadd]
  have htr : truncateScalar IntWidth.isize false (Int.ofNat (a + b)) =
      .ok (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a + b)), false) := by
    change Except.ok (ScalarVal.mk IntWidth.isize false
        (truncateBits IntWidth.isize (bvOfInt 128 (Int.ofNat (a + b)))),
      truncateBits IntWidth.isize (bvOfInt 128 (Int.ofNat (a + b))) !=
        bvOfInt 128 (Int.ofNat (a + b))) = _
    rw [bvOfInt_128_ofNat (a + b) hsum128, truncateBits_isize_of_lt_maxUsize (a + b) h]
    rw [bitVec_bne_self (BitVec.ofNat 128 (a + b))]
  rw [htr]
  have hnonneg : decide (Int.ofNat (a + b) < 0) = false :=
    decide_eq_false (s_int_not_lt_zero_ofNat (s_int_natCast_nonneg (a + b)))
  have hlt128 : decide (Int.ofNat (a + b) ≥ HPow.hPow (2 : Int) (128 : Nat)) = false := by
    rw [int_pow_2_128_eq]
    exact decide_eq_false (s_int_not_le_of_lt_ofNat (s_int_ofNat_lt_mpr hsum128))
  rw [hnonneg, hlt128]
  rfl

private theorem evalBinOp_usize_subUnchecked_ok (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize)
    (hle : b ≤ a) :
    evalBinOp .subUnchecked
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) =
      .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b)))) := by
  have hdiff : a - b < maxUsize := Nat.lt_of_le_of_lt (Nat.sub_le a b) ha
  have hdiff128 : a - b < Nat.pow 2 128 := Nat.lt_trans hdiff maxUsize_lt_pow128
  change evalArithOp .subUnchecked IntWidth.isize false
      (decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
      (decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) = _
  rw [decodeScalar_usize a ha, decodeScalar_usize b hb]
  change (match truncateScalar IntWidth.isize false (Int.ofNat a - Int.ofNat b) with
    | Except.error k => Except.error k
    | Except.ok (val, lossy) =>
      if ((decide (Int.ofNat a - Int.ofNat b < 0) ||
            decide (Int.ofNat a - Int.ofNat b ≥ HPow.hPow (2 : Int) (128 : Nat)) || lossy) && true) = true then
        Except.error FaultKind.undefined
      else Except.ok (Val.scalar val)) = _
  have hsub : Int.ofNat a - Int.ofNat b = Int.ofNat (a - b) := (s_int_ofNat_sub hle).symm
  rw [hsub]
  have htr : truncateScalar IntWidth.isize false (Int.ofNat (a - b)) =
      .ok (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a - b)), false) := by
    change Except.ok (ScalarVal.mk IntWidth.isize false
        (truncateBits IntWidth.isize (bvOfInt 128 (Int.ofNat (a - b)))),
      truncateBits IntWidth.isize (bvOfInt 128 (Int.ofNat (a - b))) !=
        bvOfInt 128 (Int.ofNat (a - b))) = _
    rw [bvOfInt_128_ofNat (a - b) hdiff128, truncateBits_isize_of_lt_maxUsize (a - b) hdiff]
    rw [bitVec_bne_self (BitVec.ofNat 128 (a - b))]
  rw [htr]
  have hnonneg : decide (Int.ofNat (a - b) < 0) = false :=
    decide_eq_false (s_int_not_lt_zero_ofNat (s_int_natCast_nonneg (a - b)))
  have hlt128 : decide (Int.ofNat (a - b) ≥ HPow.hPow (2 : Int) (128 : Nat)) = false := by
    rw [int_pow_2_128_eq]
    exact decide_eq_false (s_int_not_le_of_lt_ofNat (s_int_ofNat_lt_mpr hdiff128))
  rw [hnonneg, hlt128]
  rfl

private theorem evalBinOp_usize_subUnchecked_ub (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize)
    (hlt : a < b) :
    evalBinOp .subUnchecked
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) =
      .error .undefined := by
  change evalArithOp .subUnchecked IntWidth.isize false
      (decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
      (decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) = _
  rw [decodeScalar_usize a ha, decodeScalar_usize b hb]
  change (match Except.ok (ScalarVal.mk IntWidth.isize false
      (truncateBits IntWidth.isize (bvOfInt 128 (Int.ofNat a - Int.ofNat b))),
      truncateBits IntWidth.isize (bvOfInt 128 (Int.ofNat a - Int.ofNat b)) !=
        bvOfInt 128 (Int.ofNat a - Int.ofNat b)) with
    | Except.error k => Except.error k
    | Except.ok (val, lossy) =>
      if ((decide (Int.ofNat a - Int.ofNat b < 0) ||
            decide (Int.ofNat a - Int.ofNat b ≥ HPow.hPow (2 : Int) (128 : Nat)) || lossy) && true) = true then
        Except.error FaultKind.undefined
      else Except.ok (Val.scalar val)) = _
  have hneg : decide (Int.ofNat a - Int.ofNat b < 0) = true :=
    decide_eq_true (int_sub_lt_zero_of_lt hlt)
  rw [hneg]
  rfl

private theorem evalBinOp_usize_lt (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize) :
    evalBinOp .lt
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)))
      (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))) =
      .ok (.bool (a.blt b)) := by
  change Except.ok (Val.bool (decide
      (decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)) <
       decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))))) = _
  rw [decodeScalar_usize a ha, decodeScalar_usize b hb]
  cases hlt : a.blt b with
  | true =>
    have hNat : a < b := nat_blt_lt hlt
    have hd : decide (Int.ofNat a < Int.ofNat b) = true :=
      decide_eq_true (s_int_ofNat_lt_mpr hNat)
    rw [hd]
  | false =>
    have hge : ¬(a < b) := by
      intro hNat
      have ht : a.blt b = true := by
        rw [Nat.blt_eq]
        exact hNat
      rw [ht] at hlt
      cases hlt
    have hd : decide (Int.ofNat a < Int.ofNat b) = false :=
      decide_eq_false (fun hInt => hge (s_int_ofNat_lt_mp hInt))
    rw [hd]

private theorem evalBoolSwitchBranches_bool (b : Bool) (inBoundsBb panicBb : BasicBlockId) :
    evalBoolSwitchBranches b panicBb [(1, inBoundsBb)] =
      .ok (if b = true then inBoundsBb else panicBb) := by
  cases b <;> rfl

-- ============================================================================
-- Section 3: Declaration tables, checkSliceBackingEntriesLoop, findSliceEntry
-- ============================================================================

private theorem sliceCompDecls_zero :
    sliceCompDecls 0 = [] := by
  rfl

private theorem sliceCompDecls_succ (n : Nat) :
    sliceCompDecls (n + 1) =
      [.base .unit, .base usizeTy, .base usizeTy, .base usizeTy] ++ sliceCompDecls n := by
  rfl

private theorem sliceCompDecls_length (k : Nat) :
    (sliceCompDecls k).length = 4 * k := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [sliceCompDecls_succ, list_append_length, ih, Nat.mul_succ]
    change 4 + 4 * k = 4 * k + 4
    rw [Nat.add_comm 4 (4 * k)]

private theorem sliceScratchDecls_length :
    sliceScratchDecls.length = 5 := by
  rfl

private theorem tombstoneSliceDecls_nil :
    tombstoneSliceDecls [] = [] := by
  rfl

private theorem tombstoneSliceDecls_cons (d : ArrSliceLocalDecl) (tl : List ArrSliceLocalDecl) :
    tombstoneSliceDecls (d :: tl) =
      (match d with
        | .sliceView _ => .base .unit
        | other => other) :: tombstoneSliceDecls tl := by
  cases d <;> rfl

private theorem tombstoneSliceDecls_length (decls : List ArrSliceLocalDecl) :
    (tombstoneSliceDecls decls).length = decls.length := by
  induction decls with
  | nil => rfl
  | cons d tl ih =>
    rw [tombstoneSliceDecls_cons]
    exact congrArg Nat.succ ih

private theorem getElem?_tombstoneSliceDecls (decls : List ArrSliceLocalDecl) (i : Nat) :
    Trusted.MirSemantics.getElem? (tombstoneSliceDecls decls) i =
      (Trusted.MirSemantics.getElem? decls i).map (fun d =>
        match d with
        | .sliceView _ => .base .unit
        | other => other) := by
  induction decls generalizing i with
  | nil => rfl
  | cons d tl ih =>
    cases i with
    | zero =>
      rw [tombstoneSliceDecls_cons]
      rfl
    | succ i' =>
      rw [tombstoneSliceDecls_cons, getElem?_cons_succ, getElem?_cons_succ]
      exact ih i'

private theorem getElem?_sliceCompDecls_lt (n k r : Nat) (hk : k < n) (hr : r < 4) :
    Trusted.MirSemantics.getElem? (sliceCompDecls n) (4 * k + r) =
      some (match r with
        | 0 => .base .unit
        | 1 => .base usizeTy
        | 2 => .base usizeTy
        | _ => .base usizeTy) := by
  induction n generalizing k with
  | zero => cases hk
  | succ n' ih =>
    cases k with
    | zero =>
      have h4 : 4 * 0 + r = r := by
        rw [Nat.mul_zero, Nat.zero_add]
      rw [h4, sliceCompDecls_succ]
      cases r with
      | zero => rfl
      | succ r1 =>
        cases r1 with
        | zero => rfl
        | succ r2 =>
          cases r2 with
          | zero => rfl
          | succ r3 =>
            cases r3 with
            | zero => rfl
            | succ r4 =>
              exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hr)))))
    | succ k' =>
      have hk' : k' < n' := Nat.lt_of_succ_lt_succ hk
      have hidx : 4 * (k' + 1) + r = 4 + (4 * k' + r) := by
        rw [Nat.mul_succ, ← Nat.add_assoc, Nat.add_comm (4 * k') 4, Nat.add_assoc]
      rw [hidx, sliceCompDecls_succ]
      have hstep := getElem?_append_right
        [.base .unit, .base usizeTy, .base usizeTy, .base usizeTy]
        (sliceCompDecls n') (4 * k' + r)
      change Trusted.MirSemantics.getElem?
          ([.base .unit, .base usizeTy, .base usizeTy, .base usizeTy] ++ sliceCompDecls n')
          (4 + (4 * k' + r)) =
        Trusted.MirSemantics.getElem? (sliceCompDecls n') (4 * k' + r) at hstep
      rw [hstep]
      exact ih k' hk'

private theorem getElem?_sliceScratchDecls (r : Nat) (hr : r < 5) :
    Trusted.MirSemantics.getElem? sliceScratchDecls r =
      some (if Nat.beq r 4 = true then .base .bool else .base usizeTy) := by
  cases r with
  | zero => rfl
  | succ r1 =>
    cases r1 with
    | zero => rfl
    | succ r2 =>
      cases r2 with
      | zero => rfl
      | succ r3 =>
        cases r3 with
        | zero => rfl
        | succ r4 =>
          cases r4 with
          | zero => rfl
          | succ r5 =>
            exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hr))))))

private noncomputable def SliceEntryValid (decls : List ArrSliceLocalDecl)
    (argCount minIdx : Nat) (e : SliceBackingEntry) : Prop :=
  minIdx ≤ e.sliceLocal ∧
    argCount < e.sliceLocal ∧
    ∃ sTy, Trusted.MirSemantics.getElem? decls e.sliceLocal = some (.sliceView sTy) ∧
      isSupportedScalarOrUnitTy sTy = true ∧
      match e.backing with
      | none => True
      | some arrLocal =>
        argCount < arrLocal ∧
          ∃ aTy len, Trusted.MirSemantics.getElem? decls arrLocal = some (.array aTy len) ∧
            aTy = sTy ∧ len ≤ 64

private theorem sliceEntryValid_mono {decls : List ArrSliceLocalDecl} {argCount m₁ m₂ : Nat}
    {e : SliceBackingEntry} (hle : m₁ ≤ m₂)
    (hv : SliceEntryValid decls argCount m₂ e) :
    SliceEntryValid decls argCount m₁ e := by
  have h1 := hv.1
  have h2 := hv.2.1
  have h3 := hv.2.2
  cases h3 with | intro sTy hs =>
  exact ⟨Nat.le_trans hle h1, h2, sTy, hs.1, hs.2.1, hs.2.2⟩

private theorem checkSliceBackingEntriesLoop_sliceView_unfold
    (decls : List ArrSliceLocalDecl) (argCount idx : Nat) (sTy : MirTy)
    (restDecls : List ArrSliceLocalDecl) (e : SliceBackingEntry) (restEntries : List SliceBackingEntry) :
    checkSliceBackingEntriesLoop decls argCount idx (.sliceView sTy :: restDecls) (e :: restEntries) =
      ((isSupportedScalarOrUnitTy sTy && Nat.beq e.sliceLocal idx && argCount.blt idx &&
          match e.backing with
          | none => true
          | some arrLocal =>
            argCount.blt arrLocal &&
              match Trusted.MirSemantics.getElem? decls arrLocal with
              | some (.array aTy len) => aTy.beq sTy && len.ble 64
              | _ => false) &&
        checkSliceBackingEntriesLoop decls argCount (idx + 1) restDecls restEntries) := by
  rfl

private theorem checkSliceBackingEntriesLoop_base_unfold
    (decls : List ArrSliceLocalDecl) (argCount idx : Nat) (ty : MirTy)
    (restDecls : List ArrSliceLocalDecl) (entries : List SliceBackingEntry) :
    checkSliceBackingEntriesLoop decls argCount idx (.base ty :: restDecls) entries =
      checkSliceBackingEntriesLoop decls argCount (idx + 1) restDecls entries := by
  rfl

private theorem checkSliceBackingEntriesLoop_array_unfold
    (decls : List ArrSliceLocalDecl) (argCount idx : Nat) (elemTy : MirTy) (len : Nat)
    (restDecls : List ArrSliceLocalDecl) (entries : List SliceBackingEntry) :
    checkSliceBackingEntriesLoop decls argCount idx (.array elemTy len :: restDecls) entries =
      checkSliceBackingEntriesLoop decls argCount (idx + 1) restDecls entries := by
  rfl

private theorem checkSliceBackingEntriesLoop_spec
    (decls : List ArrSliceLocalDecl) (argCount startIdx : Nat)
    (restDecls : List ArrSliceLocalDecl) (entries : List SliceBackingEntry)
    (hMatch : ∀ j, Trusted.MirSemantics.getElem? restDecls j =
      Trusted.MirSemantics.getElem? decls (startIdx + j))
    (hLoop : checkSliceBackingEntriesLoop decls argCount startIdx restDecls entries = true) :
    (∀ pos e, Trusted.MirSemantics.getElem? entries pos = some e →
      SliceEntryValid decls argCount startIdx e) ∧
    (∀ pos₁ pos₂ e₁ e₂, pos₁ < pos₂ →
      Trusted.MirSemantics.getElem? entries pos₁ = some e₁ →
      Trusted.MirSemantics.getElem? entries pos₂ = some e₂ →
      e₁.sliceLocal < e₂.sliceLocal) ∧
    (∀ j sTy, Trusted.MirSemantics.getElem? restDecls j = some (.sliceView sTy) →
      ∃ pos e, Trusted.MirSemantics.getElem? entries pos = some e ∧ e.sliceLocal = startIdx + j) := by
  induction restDecls generalizing startIdx entries with
  | nil =>
    cases entries with
    | nil =>
      refine ⟨?_, ?_, ?_⟩
      · intro pos e hget; cases hget
      · intro pos₁ pos₂ e₁ e₂ _ h1 _; cases h1
      · intro j sTy hget; cases hget
    | cons _ _ =>
      cases hLoop
  | cons d tl ih =>
    have hTail : ∀ j, Trusted.MirSemantics.getElem? tl j =
        Trusted.MirSemantics.getElem? decls ((startIdx + 1) + j) := by
      intro j
      have hm := hMatch (j + 1)
      rw [getElem?_cons_succ] at hm
      rw [hm, Nat.succ_add, ← Nat.add_succ]
    cases d with
    | sliceView sTy =>
      cases entries with
      | nil =>
        cases hLoop
      | cons e restEntries =>
        rw [checkSliceBackingEntriesLoop_sliceView_unfold] at hLoop
        have hAnd0 := (bool_and_eq_true _ _).mp hLoop
        have hHeadBool := hAnd0.1
        have hRestLoop := hAnd0.2
        have hAnd1 := (bool_and_eq_true _ _).mp hHeadBool
        have h12 := hAnd1.1
        have hBackBool := hAnd1.2
        have hAnd2 := (bool_and_eq_true _ _).mp h12
        have h1 := hAnd2.1
        have hArg := hAnd2.2
        have hAnd3 := (bool_and_eq_true _ _).mp h1
        have hSup := hAnd3.1
        have hEqIdx := hAnd3.2
        have heIdx : e.sliceLocal = startIdx := nat_beq_eq _ _ hEqIdx
        have hArgLt : argCount < startIdx := nat_blt_lt hArg
        have hDeclHead : Trusted.MirSemantics.getElem? decls startIdx = some (.sliceView sTy) := by
          have hm0 := hMatch 0
          rw [Nat.add_zero] at hm0
          exact hm0.symm
        have hBackProp : match e.backing with
            | none => True
            | some arrLocal =>
              argCount < arrLocal ∧
                ∃ aTy len, Trusted.MirSemantics.getElem? decls arrLocal = some (.array aTy len) ∧
                  aTy = sTy ∧ len ≤ 64 := by
          cases hb : e.backing with
          | none => exact True.intro
          | some arrLocal =>
            rw [hb] at hBackBool
            have hAndB := (bool_and_eq_true _ _).mp hBackBool
            have hArrArg := hAndB.1
            have hArrDecl := hAndB.2
            have hArrArgLt : argCount < arrLocal := nat_blt_lt hArrArg
            cases hga : Trusted.MirSemantics.getElem? decls arrLocal with
            | none => rw [hga] at hArrDecl; cases hArrDecl
            | some da =>
              rw [hga] at hArrDecl
              cases da with
              | base _ => cases hArrDecl
              | sliceView _ => cases hArrDecl
              | array aTy len =>
                have hAndA := (bool_and_eq_true _ _).mp hArrDecl
                have hTyBeq := hAndA.1
                have hLenBle := hAndA.2
                exact ⟨hArrArgLt, aTy, len, hga, mirTy_beq_eq aTy sTy hTyBeq, nat_ble_le hLenBle⟩
        have hHeadValid : SliceEntryValid decls argCount startIdx e :=
          ⟨by rw [heIdx]; exact Nat.le_refl _,
           by rw [heIdx]; exact hArgLt,
           sTy,
           by rw [heIdx]; exact hDeclHead,
           hSup,
           hBackProp⟩
        have hIh := ih (startIdx + 1) restEntries hTail hRestLoop
        have ihValid := hIh.1
        have ihMono := hIh.2.1
        have ihComp := hIh.2.2
        refine ⟨?_, ?_, ?_⟩
        · intro pos ep hget
          cases pos with
          | zero =>
            cases hget
            exact hHeadValid
          | succ pos' =>
            rw [getElem?_cons_succ] at hget
            exact sliceEntryValid_mono (Nat.le_succ startIdx) (ihValid pos' ep hget)
        · intro pos₁ pos₂ e₁ e₂ hlt h1 h2
          cases pos₁ with
          | zero =>
            cases h1
            cases pos₂ with
            | zero => cases Nat.not_lt_zero _ hlt
            | succ pos₂' =>
              rw [getElem?_cons_succ] at h2
              have hv₂ := ihValid pos₂' e₂ h2
              rw [heIdx]
              exact Nat.lt_of_lt_of_le (Nat.lt_succ_self startIdx) hv₂.1
          | succ pos₁' =>
            cases pos₂ with
            | zero => cases Nat.not_lt_zero _ hlt
            | succ pos₂' =>
              rw [getElem?_cons_succ] at h1
              rw [getElem?_cons_succ] at h2
              exact ihMono pos₁' pos₂' e₁ e₂ (Nat.lt_of_succ_lt_succ hlt) h1 h2
        · intro j sj hget
          cases j with
          | zero =>
            exact ⟨0, e, rfl, by rw [heIdx, Nat.add_zero]⟩
          | succ j' =>
            rw [getElem?_cons_succ] at hget
            have hC := ihComp j' sj hget
            cases hC with | intro pos' hPos' =>
            cases hPos' with | intro ep hEp =>
            have hep' : ep.sliceLocal = startIdx + (j' + 1) := by
              rw [hEp.2, Nat.succ_add, ← Nat.add_succ]
            exact ⟨pos' + 1, ep, hEp.1, hep'⟩
    | base ty =>
      rw [checkSliceBackingEntriesLoop_base_unfold] at hLoop
      have hIh := ih (startIdx + 1) entries hTail hLoop
      have ihValid := hIh.1
      have ihMono := hIh.2.1
      have ihComp := hIh.2.2
      refine ⟨?_, ihMono, ?_⟩
      · intro pos e hget
        exact sliceEntryValid_mono (Nat.le_succ startIdx) (ihValid pos e hget)
      · intro j sTy hget
        cases j with
        | zero => cases hget
        | succ j' =>
          rw [getElem?_cons_succ] at hget
          have hC := ihComp j' sTy hget
          cases hC with | intro pos hPos =>
          cases hPos with | intro ep hEp =>
          have hep' : ep.sliceLocal = startIdx + (j' + 1) := by
            rw [hEp.2, Nat.succ_add, ← Nat.add_succ]
          exact ⟨pos, ep, hEp.1, hep'⟩
    | array elemTy len =>
      rw [checkSliceBackingEntriesLoop_array_unfold] at hLoop
      have hIh := ih (startIdx + 1) entries hTail hLoop
      have ihValid := hIh.1
      have ihMono := hIh.2.1
      have ihComp := hIh.2.2
      refine ⟨?_, ihMono, ?_⟩
      · intro pos e hget
        exact sliceEntryValid_mono (Nat.le_succ startIdx) (ihValid pos e hget)
      · intro j sTy hget
        cases j with
        | zero => cases hget
        | succ j' =>
          rw [getElem?_cons_succ] at hget
          have hC := ihComp j' sTy hget
          cases hC with | intro pos hPos =>
          cases hPos with | intro ep hEp =>
          have hep' : ep.sliceLocal = startIdx + (j' + 1) := by
            rw [hEp.2, Nat.succ_add, ← Nat.add_succ]
          exact ⟨pos, ep, hEp.1, hep'⟩

private theorem findSliceEntryIdxAux_nil (sLoc baseIdx : Nat) :
    findSliceEntryIdxAux sLoc baseIdx [] = none := by
  rfl

private theorem findSliceEntryIdxAux_cons (sLoc baseIdx : Nat) (e : SliceBackingEntry)
    (rest : List SliceBackingEntry) :
    findSliceEntryIdxAux sLoc baseIdx (e :: rest) =
      if Nat.beq e.sliceLocal sLoc = true then some (baseIdx, e.backing)
      else findSliceEntryIdxAux sLoc (baseIdx + 1) rest := by
  rfl

private theorem findSliceEntryIdxAux_eq_some_iff
    (entries : List SliceBackingEntry) (sLoc baseIdx k : Nat) (optArr : Option LocalId)
    (hMono : ∀ pos₁ pos₂ e₁ e₂, pos₁ < pos₂ →
      Trusted.MirSemantics.getElem? entries pos₁ = some e₁ →
      Trusted.MirSemantics.getElem? entries pos₂ = some e₂ →
      e₁.sliceLocal < e₂.sliceLocal) :
    findSliceEntryIdxAux sLoc baseIdx entries = some (k, optArr) ↔
      ∃ pos e, Trusted.MirSemantics.getElem? entries pos = some e ∧
        e.sliceLocal = sLoc ∧ k = baseIdx + pos ∧ optArr = e.backing := by
  induction entries generalizing baseIdx with
  | nil =>
    constructor
    · intro h; cases h
    · intro h
      cases h with | intro pos hPos =>
      cases hPos with | intro e hE =>
      cases hE.1
  | cons e rest ih =>
    have hMonoRest : ∀ pos₁ pos₂ e₁ e₂, pos₁ < pos₂ →
        Trusted.MirSemantics.getElem? rest pos₁ = some e₁ →
        Trusted.MirSemantics.getElem? rest pos₂ = some e₂ →
        e₁.sliceLocal < e₂.sliceLocal := by
      intro pos₁ pos₂ e₁ e₂ hlt h1 h2
      exact hMono (pos₁ + 1) (pos₂ + 1) e₁ e₂ (Nat.succ_lt_succ hlt) h1 h2
    constructor
    · intro h
      rw [findSliceEntryIdxAux_cons] at h
      cases hEq : Nat.beq e.sliceLocal sLoc with
      | true =>
        rw [hEq] at h
        injection h with hPair
        injection hPair with hkEq hbEq
        exact ⟨0, e, rfl, nat_beq_eq _ _ hEq, (by rw [hkEq, Nat.add_zero]), hbEq.symm⟩
      | false =>
        rw [hEq] at h
        have hM := (ih (baseIdx + 1) hMonoRest).mp h
        cases hM with | intro pos' hP =>
        cases hP with | intro ep hEp =>
        have hg := hEp.1
        have heq := hEp.2.1
        have hk := hEp.2.2.1
        have hb := hEp.2.2.2
        have hk' : k = baseIdx + (pos' + 1) := by
          rw [hk, Nat.add_assoc, Nat.add_comm 1 pos', ← Nat.add_assoc]
        exact ⟨pos' + 1, ep, hg, heq, hk', hb⟩
    · intro h
      cases h with | intro pos hPos =>
      cases hPos with | intro ep hEp =>
      have hg := hEp.1
      have heq := hEp.2.1
      have hk := hEp.2.2.1
      have hb := hEp.2.2.2
      rw [findSliceEntryIdxAux_cons]
      cases pos with
      | zero =>
        injection hg with hep
        have hBeq : Nat.beq e.sliceLocal sLoc = true := by
          rw [hep]
          exact nat_beq_true heq
        rw [hBeq, hk, Nat.add_zero, hb, hep]
        rfl
      | succ pos' =>
        rw [getElem?_cons_succ] at hg
        have hlt : e.sliceLocal < ep.sliceLocal :=
          hMono 0 (pos' + 1) e ep (Nat.zero_lt_succ pos') rfl hg
        rw [heq] at hlt
        have hNe : e.sliceLocal ≠ sLoc := Nat.ne_of_lt hlt
        have hBeqFalse : Nat.beq e.sliceLocal sLoc = false := by
          cases hb0 : Nat.beq e.sliceLocal sLoc with
          | false => rfl
          | true => exact False.elim (hNe (nat_beq_eq _ _ hb0))
        rw [hBeqFalse]
        apply (ih (baseIdx + 1) hMonoRest).mpr
        have hk' : k = (baseIdx + 1) + pos' := by
          rw [hk, Nat.add_assoc, Nat.add_comm 1 pos', ← Nat.add_assoc]
        exact ⟨pos', ep, hg, heq, hk', hb⟩

private theorem findSliceEntry_some_lt_and_valid
    {decls : List ArrSliceLocalDecl} {argCount : Nat} {entries : List SliceBackingEntry}
    (hLoop : checkSliceBackingEntriesLoop decls argCount 0 decls entries = true)
    {sLoc k : Nat} {optArr : Option LocalId}
    (hFind : findSliceEntry entries sLoc = some (k, optArr)) :
    k < entries.length ∧
      ∃ e, Trusted.MirSemantics.getElem? entries k = some e ∧
        e.sliceLocal = sLoc ∧ e.backing = optArr ∧
        SliceEntryValid decls argCount 0 e := by
  have hMatch : ∀ j, Trusted.MirSemantics.getElem? decls j =
      Trusted.MirSemantics.getElem? decls (0 + j) := by
    intro j; rw [Nat.zero_add]
  have hSpec := checkSliceBackingEntriesLoop_spec decls argCount 0 decls entries hMatch hLoop
  have hValid := hSpec.1
  have hMono := hSpec.2.1
  have hAux : findSliceEntryIdxAux sLoc 0 entries = some (k, optArr) := hFind
  have hSome := (findSliceEntryIdxAux_eq_some_iff entries sLoc 0 k optArr hMono).mp hAux
  cases hSome with | intro pos hPos =>
  cases hPos with | intro e hE =>
  have hg := hE.1
  have heq := hE.2.1
  have hk := hE.2.2.1
  have hb := hE.2.2.2
  rw [Nat.zero_add] at hk
  rw [← hk] at hg
  exact ⟨getElem?_some_lt entries k e hg, e, hg, heq, hb.symm, hValid k e hg⟩

private theorem findSliceEntry_inj
    {decls : List ArrSliceLocalDecl} {argCount : Nat} {entries : List SliceBackingEntry}
    (hLoop : checkSliceBackingEntriesLoop decls argCount 0 decls entries = true)
    {s₁ s₂ k : Nat} {o₁ o₂ : Option LocalId}
    (h1 : findSliceEntry entries s₁ = some (k, o₁))
    (h2 : findSliceEntry entries s₂ = some (k, o₂)) :
    s₁ = s₂ ∧ o₁ = o₂ := by
  have hV1 := findSliceEntry_some_lt_and_valid hLoop h1
  cases hV1.2 with | intro e₁ hE₁ =>
  have hV2 := findSliceEntry_some_lt_and_valid hLoop h2
  cases hV2.2 with | intro e₂ hE₂ =>
  have hg₁ := hE₁.1
  have hg₂ := hE₂.1
  rw [hg₁] at hg₂
  cases hg₂
  rw [← hE₁.2.1, ← hE₂.2.1, ← hE₁.2.2.1, ← hE₂.2.2.1]
  exact ⟨rfl, rfl⟩

private theorem findSliceEntry_of_sliceView
    {decls : List ArrSliceLocalDecl} {argCount : Nat} {entries : List SliceBackingEntry}
    (hLoop : checkSliceBackingEntriesLoop decls argCount 0 decls entries = true)
    {sLoc : LocalId} {sTy : MirTy}
    (hGet : Trusted.MirSemantics.getElem? decls sLoc = some (.sliceView sTy)) :
    ∃ k optArr, findSliceEntry entries sLoc = some (k, optArr) := by
  have hMatch : ∀ j, Trusted.MirSemantics.getElem? decls j =
      Trusted.MirSemantics.getElem? decls (0 + j) := by
    intro j; rw [Nat.zero_add]
  have hSpec := checkSliceBackingEntriesLoop_spec decls argCount 0 decls entries hMatch hLoop
  have hMono := hSpec.2.1
  have hComp := hSpec.2.2
  have hC := hComp sLoc sTy hGet
  cases hC with | intro pos hPos =>
  cases hPos with | intro e hE =>
  have hg := hE.1
  have heq := hE.2
  rw [Nat.zero_add] at heq
  refine ⟨pos, e.backing, ?_⟩
  apply (findSliceEntryIdxAux_eq_some_iff entries sLoc 0 pos e.backing hMono).mpr
  exact ⟨pos, e, hg, heq, (Nat.zero_add pos).symm, rfl⟩

private theorem no_sliceView_le_argCount
    {decls : List ArrSliceLocalDecl} {argCount : Nat} {entries : List SliceBackingEntry}
    (hLoop : checkSliceBackingEntriesLoop decls argCount 0 decls entries = true)
    {i : LocalId} (hi : i ≤ argCount) (sTy : MirTy) :
    Trusted.MirSemantics.getElem? decls i ≠ some (.sliceView sTy) := by
  intro hGet
  have hEx := findSliceEntry_of_sliceView hLoop hGet
  cases hEx with | intro k hK =>
  cases hK with | intro optArr hFind =>
  have hV := findSliceEntry_some_lt_and_valid hLoop hFind
  cases hV.2 with | intro e hE =>
  have hArgLt : argCount < i := by
    rw [← hE.2.1]
    exact hE.2.2.2.2.1
  exact Nat.not_lt_of_ge hi hArgLt

private theorem findSliceEntry_none_implies_not_sliceView
    {decls : List ArrSliceLocalDecl} {argCount : Nat} {entries : List SliceBackingEntry}
    (hLoop : checkSliceBackingEntriesLoop decls argCount 0 decls entries = true)
    {i : LocalId} (hNone : findSliceEntry entries i = none) (sTy : MirTy) :
    Trusted.MirSemantics.getElem? decls i ≠ some (.sliceView sTy) := by
  intro hGet
  have hEx := findSliceEntry_of_sliceView hLoop hGet
  cases hEx with | intro k hK =>
  cases hK with | intro optArr hFind =>
  rw [hNone] at hFind
  cases hFind

-- ============================================================================
-- Section 4: SliceScalarizePack, static compatibility, and storage markers
-- ============================================================================

private structure SliceScalarizePack (plan : SliceScalarizePlan) (pSrc pTgt : ArrSliceProgram) : Type where
  bodySrc : ArrSliceBody
  bodyTgt : ArrSliceBody
  hGetBody : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId = some bodySrc
  hNonEmpty : bodySrc.basicBlocks.isEmpty = false
  hArgLt : bodySrc.argumentCount < bodySrc.locals.length
  hStor : arrSliceStorageAnnotationsInBounds bodySrc = true
  hLocs : arrSliceBodyLocalsInBounds bodySrc = true
  hTargs : arrSliceBodyTargetsInBounds bodySrc = true
  hLoop : checkSliceBackingEntriesLoop bodySrc.locals bodySrc.argumentCount 0 bodySrc.locals plan.entries = true
  hCheckAll : bodySrc.basicBlocks.all (fun bb =>
    bb.statements.all (checkStmtForSlices bodySrc.locals plan.entries) &&
    checkTermForSlices bodySrc.locals plan.entries bb.terminator) = true
  hBodyTgt : bodyTgt =
    ArrSliceBody.mk bodySrc.argumentCount
      (tombstoneSliceDecls bodySrc.locals ++ sliceCompDecls plan.entries.length ++ sliceScratchDecls)
      (List.map (lowerBlockForSlices bodySrc.locals plan.entries bodySrc.locals.length) bodySrc.basicBlocks)
      bodySrc.isUnsafe bodySrc.identity
  hSetBody : setElem? pSrc.bodies plan.defId bodyTgt = some pTgt.bodies
  hEntryId : pTgt.entryDefId = pSrc.entryDefId
  hPtrBits : pTgt.pointerWidthBits = pSrc.pointerWidthBits
  hProfile : pTgt.mirProfileVersion = pSrc.mirProfileVersion
  hScope : pTgt.scope = pSrc.scope

private noncomputable def applySliceScalarize_unpack (plan : SliceScalarizePlan) (pSrc pTgt : ArrSliceProgram)
    (hApp : applySliceScalarize plan pSrc = some pTgt) :
    SliceScalarizePack plan pSrc pTgt := by
  change (match Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
    | none => none
    | some body =>
      if (body.basicBlocks.isEmpty || !body.argumentCount.blt body.locals.length ||
          !arrSliceStorageAnnotationsInBounds body || !arrSliceBodyLocalsInBounds body ||
          !arrSliceBodyTargetsInBounds body ||
          !checkSliceBackingEntriesLoop body.locals body.argumentCount 0 body.locals plan.entries) = true then
        none
      else
        if (!body.basicBlocks.all fun bb =>
            bb.statements.all (checkStmtForSlices body.locals plan.entries) &&
            checkTermForSlices body.locals plan.entries bb.terminator) = true then
          none
        else
          have base := body.locals.length
          have bodyTgt :=
            ArrSliceBody.mk body.argumentCount
              (tombstoneSliceDecls body.locals ++ sliceCompDecls plan.entries.length ++ sliceScratchDecls)
              (List.map (lowerBlockForSlices body.locals plan.entries base) body.basicBlocks)
              body.isUnsafe body.identity
          match setElem? pSrc.bodies plan.defId bodyTgt with
          | none => none
          | some bodiesTgt =>
            some (ArrSliceProgram.mk bodiesTgt pSrc.entryDefId
              pSrc.pointerWidthBits pSrc.mirProfileVersion pSrc.scope)) = some pTgt at hApp
  cases hGet : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => rw [hGet] at hApp; cases hApp
  | some bodySrc =>
    rw [hGet] at hApp
    change (if (bodySrc.basicBlocks.isEmpty || !bodySrc.argumentCount.blt bodySrc.locals.length ||
        !arrSliceStorageAnnotationsInBounds bodySrc || !arrSliceBodyLocalsInBounds bodySrc ||
        !arrSliceBodyTargetsInBounds bodySrc ||
        !checkSliceBackingEntriesLoop bodySrc.locals bodySrc.argumentCount 0 bodySrc.locals plan.entries) = true then
      none
    else
      if (!bodySrc.basicBlocks.all fun bb =>
          bb.statements.all (checkStmtForSlices bodySrc.locals plan.entries) &&
          checkTermForSlices bodySrc.locals plan.entries bb.terminator) = true then
        none
      else
        let base := bodySrc.locals.length
        let bodyTgt :=
          ArrSliceBody.mk bodySrc.argumentCount
            (tombstoneSliceDecls bodySrc.locals ++ sliceCompDecls plan.entries.length ++ sliceScratchDecls)
            (List.map (lowerBlockForSlices bodySrc.locals plan.entries base) bodySrc.basicBlocks)
            bodySrc.isUnsafe bodySrc.identity
        match setElem? pSrc.bodies plan.defId bodyTgt with
        | none => none
        | some bodiesTgt =>
          some (ArrSliceProgram.mk bodiesTgt pSrc.entryDefId
            pSrc.pointerWidthBits pSrc.mirProfileVersion pSrc.scope)) = some pTgt at hApp
    cases hCond1 : (bodySrc.basicBlocks.isEmpty || !bodySrc.argumentCount.blt bodySrc.locals.length ||
        !arrSliceStorageAnnotationsInBounds bodySrc || !arrSliceBodyLocalsInBounds bodySrc ||
        !arrSliceBodyTargetsInBounds bodySrc ||
        !checkSliceBackingEntriesLoop bodySrc.locals bodySrc.argumentCount 0 bodySrc.locals plan.entries) with
    | true => rw [hCond1] at hApp; cases hApp
    | false =>
      rw [hCond1] at hApp
      have hOr1 := (bool_or_eq_false _ _).mp hCond1
      have hOr2 := (bool_or_eq_false _ _).mp hOr1.1
      have hOr3 := (bool_or_eq_false _ _).mp hOr2.1
      have hOr4 := (bool_or_eq_false _ _).mp hOr3.1
      have hOr5 := (bool_or_eq_false _ _).mp hOr4.1
      have hArgLt : bodySrc.argumentCount < bodySrc.locals.length :=
        nat_blt_lt ((bool_not_eq_false _).mp hOr5.2)
      have hStor := (bool_not_eq_false _).mp hOr4.2
      have hLocs := (bool_not_eq_false _).mp hOr3.2
      have hTargs := (bool_not_eq_false _).mp hOr2.2
      have hLoop := (bool_not_eq_false _).mp hOr1.2
      have hEmpty := hOr5.1
      cases hCond2 : (!bodySrc.basicBlocks.all fun bb =>
          bb.statements.all (checkStmtForSlices bodySrc.locals plan.entries) &&
          checkTermForSlices bodySrc.locals plan.entries bb.terminator) with
      | true => rw [hCond2] at hApp; cases hApp
      | false =>
        rw [hCond2] at hApp
        have hCheckAll := (bool_not_eq_false _).mp hCond2
        let bodyTgt : ArrSliceBody :=
          { argumentCount := bodySrc.argumentCount
            locals := tombstoneSliceDecls bodySrc.locals ++ sliceCompDecls plan.entries.length ++ sliceScratchDecls
            basicBlocks := List.map (lowerBlockForSlices bodySrc.locals plan.entries bodySrc.locals.length) bodySrc.basicBlocks
            isUnsafe := bodySrc.isUnsafe
            identity := bodySrc.identity }
        change (match setElem? pSrc.bodies plan.defId bodyTgt with
          | none => none
          | some bodiesTgt =>
            some (ArrSliceProgram.mk bodiesTgt pSrc.entryDefId
              pSrc.pointerWidthBits pSrc.mirProfileVersion pSrc.scope)) = some pTgt at hApp
        cases hSet : setElem? pSrc.bodies plan.defId bodyTgt with
        | none => rw [hSet] at hApp; cases hApp
        | some bodiesTgt =>
          rw [hSet] at hApp
          injection hApp with hpTgt
          exact
            { bodySrc := bodySrc
              bodyTgt := bodyTgt
              hGetBody := hGet
              hNonEmpty := hEmpty
              hArgLt := hArgLt
              hStor := hStor
              hLocs := hLocs
              hTargs := hTargs
              hLoop := hLoop
              hCheckAll := hCheckAll
              hBodyTgt := rfl
              hSetBody := by rw [← hpTgt]; exact hSet
              hEntryId := by rw [← hpTgt]
              hPtrBits := by rw [← hpTgt]
              hProfile := by rw [← hpTgt]
              hScope := by rw [← hpTgt] }

private theorem getElem?_pTgt_bodies_eq {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt :=
  getElem?_setElem?_self pSrc.bodies plan.defId pack.bodyTgt pTgt.bodies pack.hSetBody

private theorem getElem?_pTgt_bodies_ne {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) (id : DefId) (hne : id ≠ plan.defId) :
    Trusted.MirSemantics.getElem? pTgt.bodies id =
      Trusted.MirSemantics.getElem? pSrc.bodies id :=
  getElem?_setElem?_ne pSrc.bodies plan.defId id pack.bodyTgt pTgt.bodies (Ne.symm hne) pack.hSetBody

private theorem bodyTgt_locals_length {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) :
    pack.bodyTgt.locals.length =
      pack.bodySrc.locals.length + 4 * plan.entries.length + 5 := by
  rw [pack.hBodyTgt]
  change (tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length ++ sliceScratchDecls).length = _
  rw [list_append_length, list_append_length, tombstoneSliceDecls_length,
      sliceCompDecls_length, sliceScratchDecls_length]

private theorem getElem?_bodyTgt_locals_lt {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {i : LocalId}
    (hi : i < pack.bodySrc.locals.length) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals i =
      Trusted.MirSemantics.getElem? (tombstoneSliceDecls pack.bodySrc.locals) i := by
  rw [pack.hBodyTgt]
  change Trusted.MirSemantics.getElem?
    ((tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length) ++ sliceScratchDecls) i = _
  have hTombLen : (tombstoneSliceDecls pack.bodySrc.locals).length = pack.bodySrc.locals.length :=
    tombstoneSliceDecls_length pack.bodySrc.locals
  have h1 : i < (tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length).length := by
    rw [list_append_length, hTombLen]
    exact Nat.lt_of_lt_of_le hi (Nat.le_add_right _ _)
  have h2 : i < (tombstoneSliceDecls pack.bodySrc.locals).length := by
    rw [hTombLen]; exact hi
  rw [getElem?_append_left _ sliceScratchDecls i h1]
  exact getElem?_append_left (tombstoneSliceDecls pack.bodySrc.locals)
    (sliceCompDecls plan.entries.length) i h2

private theorem getElem?_bodyTgt_locals_comp {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {k r : Nat}
    (hk : k < plan.entries.length) (hr : r < 4) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 4 * k + r) =
      some (match r with
        | 0 => .base .unit
        | 1 => .base usizeTy
        | 2 => .base usizeTy
        | _ => .base usizeTy) := by
  rw [pack.hBodyTgt]
  change Trusted.MirSemantics.getElem?
    ((tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length) ++ sliceScratchDecls)
    (pack.bodySrc.locals.length + 4 * k + r) = _
  have hkr : 4 * k + r < 4 * plan.entries.length := by
    have hk4 : 4 * (k + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hk
    rw [Nat.mul_succ] at hk4
    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hr (4 * k)) hk4
  have hCompLen : (sliceCompDecls plan.entries.length).length = 4 * plan.entries.length :=
    sliceCompDecls_length plan.entries.length
  have hTombLen : (tombstoneSliceDecls pack.bodySrc.locals).length = pack.bodySrc.locals.length :=
    tombstoneSliceDecls_length pack.bodySrc.locals
  rw [Nat.add_assoc pack.bodySrc.locals.length (4 * k) r]
  have hkrComp : 4 * k + r < (sliceCompDecls plan.entries.length).length := by
    rw [hCompLen]; exact hkr
  have hMid := getElem?_append_middle_add
    (tombstoneSliceDecls pack.bodySrc.locals)
    (sliceCompDecls plan.entries.length) sliceScratchDecls (4 * k + r) hkrComp
  rw [hTombLen] at hMid
  rw [hMid]
  exact getElem?_sliceCompDecls_lt plan.entries.length k r hk hr

private theorem getElem?_bodyTgt_locals_scratch {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) {r : Nat} (hr : r < 5) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 4 * plan.entries.length + r) =
      some (if Nat.beq r 4 = true then .base .bool else .base usizeTy) := by
  rw [pack.hBodyTgt]
  change Trusted.MirSemantics.getElem?
    ((tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length) ++ sliceScratchDecls)
    ((pack.bodySrc.locals.length + 4 * plan.entries.length) + r) = _
  have hPrefLen : (tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length).length =
      pack.bodySrc.locals.length + 4 * plan.entries.length := by
    rw [list_append_length, tombstoneSliceDecls_length, sliceCompDecls_length]
  have hRight := getElem?_append_right
    (tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length)
    sliceScratchDecls r
  rw [hPrefLen] at hRight
  rw [hRight]
  exact getElem?_sliceScratchDecls r hr

private theorem listMapOption_eq_of_pointwise {α β : Type} (f : α → Option β) (xs ys : List α)
    (hLen : xs.length = ys.length)
    (hPt : ∀ i, i < xs.length → Trusted.MirSemantics.getElem? xs i = Trusted.MirSemantics.getElem? ys i) :
    listMapOption f xs = listMapOption f ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases hLen
  | cons a tl ih =>
    cases ys with
    | nil => cases hLen
    | cons b ytl =>
      have h0 := hPt 0 (Nat.zero_lt_succ tl.length)
      injection h0 with hab
      have htlLen : tl.length = ytl.length := Nat.succ.inj hLen
      have htlPt : ∀ i, i < tl.length →
          Trusted.MirSemantics.getElem? tl i = Trusted.MirSemantics.getElem? ytl i := by
        intro i hi
        exact hPt (i + 1) (Nat.succ_lt_succ hi)
      have htlMap := ih ytl htlLen htlPt
      change (match f a, listMapOption f tl with
        | some y, some ys' => some (y :: ys')
        | _, _ => none) =
        (match f b, listMapOption f ytl with
        | some y, some ys' => some (y :: ys')
        | _, _ => none)
      rw [hab, htlMap]

private theorem arrSliceParamBaseTys?_bodyTgt {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt) :
    arrSliceParamBaseTys? pack.bodyTgt = arrSliceParamBaseTys? pack.bodySrc := by
  change listMapOption (fun d => match d with | .base ty => some ty | _ => none)
      ((pack.bodyTgt.locals.drop 1).take pack.bodyTgt.argumentCount) =
    listMapOption (fun d => match d with | .base ty => some ty | _ => none)
      ((pack.bodySrc.locals.drop 1).take pack.bodySrc.argumentCount)
  have hArgEq : pack.bodyTgt.argumentCount = pack.bodySrc.argumentCount := by
    rw [pack.hBodyTgt]
  rw [hArgEq]
  have hDropLen : pack.bodySrc.argumentCount ≤ (pack.bodySrc.locals.drop 1).length := by
    rw [list_length_drop]
    exact Nat.le_sub_one_of_lt pack.hArgLt
  have hTgtDropLen : pack.bodySrc.argumentCount ≤ (pack.bodyTgt.locals.drop 1).length := by
    rw [list_length_drop, bodyTgt_locals_length pack]
    have hLtTgt : pack.bodySrc.argumentCount < pack.bodySrc.locals.length + 4 * plan.entries.length + 5 :=
      Nat.lt_of_lt_of_le pack.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
    exact Nat.le_sub_one_of_lt hLtTgt
  have hLen1 : ((pack.bodyTgt.locals.drop 1).take pack.bodySrc.argumentCount).length = pack.bodySrc.argumentCount :=
    list_length_take_of_le hTgtDropLen
  have hLen2 : ((pack.bodySrc.locals.drop 1).take pack.bodySrc.argumentCount).length = pack.bodySrc.argumentCount :=
    list_length_take_of_le hDropLen
  apply listMapOption_eq_of_pointwise
  · rw [hLen1, hLen2]
  · intro i hi
    rw [hLen1] at hi
    rw [getElem?_take_lt _ _ _ hi, getElem?_take_lt _ _ _ hi, s3a_getElem?_drop, s3a_getElem?_drop]
    have hLeArg : 1 + i ≤ pack.bodySrc.argumentCount := by
      rw [Nat.add_comm 1 i]
      exact Nat.succ_le_of_lt hi
    have hLtSrc : 1 + i < pack.bodySrc.locals.length := Nat.lt_of_le_of_lt hLeArg pack.hArgLt
    rw [getElem?_bodyTgt_locals_lt pack hLtSrc, getElem?_tombstoneSliceDecls]
    cases hGet : Trusted.MirSemantics.getElem? pack.bodySrc.locals (1 + i) with
    | none => rfl
    | some d =>
      cases d with
      | base _ => rfl
      | array _ _ => rfl
      | sliceView sTy =>
        exact False.elim (no_sliceView_le_argCount pack.hLoop hLeArg sTy hGet)

private theorem allArrSliceLocalsSupported_unfold (argCount idx : Nat) (d : ArrSliceLocalDecl)
    (tl : List ArrSliceLocalDecl) :
    allArrSliceLocalsSupported argCount idx (d :: tl) =
      (isSupportedArrSliceLocalDecl argCount idx d &&
        allArrSliceLocalsSupported argCount (idx + 1) tl) := by
  rfl

private theorem allArrSliceLocalsSupported_iff (argCount startIdx : Nat) (decls : List ArrSliceLocalDecl) :
    allArrSliceLocalsSupported argCount startIdx decls = true ↔
      ∀ j d, Trusted.MirSemantics.getElem? decls j = some d →
        isSupportedArrSliceLocalDecl argCount (startIdx + j) d = true := by
  induction decls generalizing startIdx with
  | nil =>
    constructor
    · intro _ j d hg; cases hg
    · intro _; rfl
  | cons d tl ih =>
    constructor
    · intro h j dj hg
      rw [allArrSliceLocalsSupported_unfold] at h
      have hAnd := (bool_and_eq_true _ _).mp h
      cases j with
      | zero =>
        cases hg
        rw [Nat.add_zero]
        exact hAnd.1
      | succ j' =>
        rw [getElem?_cons_succ] at hg
        have hm := (ih (startIdx + 1)).mp hAnd.2 j' dj hg
        rw [Nat.succ_add, ← Nat.add_succ] at hm
        exact hm
    · intro h
      rw [allArrSliceLocalsSupported_unfold]
      apply (bool_and_eq_true _ _).mpr
      constructor
      · have h0 := h 0 d rfl
        rw [Nat.add_zero] at h0
        exact h0
      · apply (ih (startIdx + 1)).mpr
        intro j dj hg
        have hj := h (j + 1) dj hg
        rw [Nat.succ_add, ← Nat.add_succ]
        exact hj

private theorem allArrSliceLocalsSupported_bodyTgt {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (hSrc : allArrSliceLocalsSupported pack.bodySrc.argumentCount 0 pack.bodySrc.locals = true) :
    allArrSliceLocalsSupported pack.bodyTgt.argumentCount 0 pack.bodyTgt.locals = true := by
  have hArgEq : pack.bodyTgt.argumentCount = pack.bodySrc.argumentCount := by
    rw [pack.hBodyTgt]
  rw [hArgEq]
  apply (allArrSliceLocalsSupported_iff pack.bodySrc.argumentCount 0 pack.bodyTgt.locals).mpr
  intro j dj hGet
  rw [Nat.zero_add]
  have hSrcPt := (allArrSliceLocalsSupported_iff pack.bodySrc.argumentCount 0 pack.bodySrc.locals).mp hSrc
  have hjLt : j < pack.bodyTgt.locals.length := getElem?_some_lt _ j dj hGet
  rw [bodyTgt_locals_length pack] at hjLt
  cases hDec1 : Nat.decLt j pack.bodySrc.locals.length with
  | isTrue hLtBase =>
    rw [getElem?_bodyTgt_locals_lt pack hLtBase, getElem?_tombstoneSliceDecls] at hGet
    cases hSrcGet : Trusted.MirSemantics.getElem? pack.bodySrc.locals j with
    | none =>
      exact False.elim (Nat.not_lt_of_ge (getElem?_none_le pack.bodySrc.locals j hSrcGet) hLtBase)
    | some dSrc =>
      rw [hSrcGet] at hGet
      have hSup := hSrcPt j dSrc hSrcGet
      rw [Nat.zero_add] at hSup
      cases dSrc with
      | base ty =>
        injection hGet with hEq
        rw [← hEq]
        exact hSup
      | array elemTy len =>
        injection hGet with hEq
        rw [← hEq]
        exact hSup
      | sliceView sTy =>
        injection hGet with hEq
        rw [← hEq]
        rfl
  | isFalse hNotLtBase =>
    have hGeBase : pack.bodySrc.locals.length ≤ j := Nat.le_of_not_lt hNotLtBase
    let jRel := j - pack.bodySrc.locals.length
    have hjDecomp : j = pack.bodySrc.locals.length + jRel := (s_nat_add_sub_cancel_prime hGeBase).symm
    cases hDec2 : Nat.decLt jRel (4 * plan.entries.length) with
    | isTrue hLtComp =>
      have hGetComp : Trusted.MirSemantics.getElem? pack.bodyTgt.locals j =
          Trusted.MirSemantics.getElem? (sliceCompDecls plan.entries.length) jRel := by
        rw [pack.hBodyTgt]
        change Trusted.MirSemantics.getElem?
          ((tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length) ++ sliceScratchDecls)
          j = _
        have hTombLen : (tombstoneSliceDecls pack.bodySrc.locals).length = pack.bodySrc.locals.length :=
          tombstoneSliceDecls_length pack.bodySrc.locals
        have hCompLen : (sliceCompDecls plan.entries.length).length = 4 * plan.entries.length :=
          sliceCompDecls_length plan.entries.length
        have hLtPref : j < (tombstoneSliceDecls pack.bodySrc.locals ++ sliceCompDecls plan.entries.length).length := by
          rw [list_append_length, hTombLen, hCompLen, hjDecomp]
          exact Nat.add_lt_add_left hLtComp _
        rw [getElem?_append_left _ sliceScratchDecls j hLtPref, hjDecomp]
        have hR := getElem?_append_right (tombstoneSliceDecls pack.bodySrc.locals)
          (sliceCompDecls plan.entries.length) jRel
        rw [hTombLen] at hR
        exact hR
      rw [hGetComp] at hGet
      have hIsBase : ∀ n idx d, Trusted.MirSemantics.getElem? (sliceCompDecls n) idx = some d →
          isSupportedArrSliceLocalDecl pack.bodySrc.argumentCount 0 d = true ∧
          ∃ ty, d = .base ty := by
        intro n idx d hg
        induction n generalizing idx with
        | zero => cases hg
        | succ n' ih =>
          rw [sliceCompDecls_succ] at hg
          cases idx with
          | zero => cases hg; exact ⟨rfl, .unit, rfl⟩
          | succ i1 =>
            cases i1 with
            | zero => cases hg; exact ⟨rfl, usizeTy, rfl⟩
            | succ i2 =>
              cases i2 with
              | zero => cases hg; exact ⟨rfl, usizeTy, rfl⟩
              | succ i3 =>
                cases i3 with
                | zero => cases hg; exact ⟨rfl, usizeTy, rfl⟩
                | succ i4 => exact ih i4 hg
      have hB := hIsBase plan.entries.length jRel dj hGet
      have hSup0 := hB.1
      cases hB.2 with | intro ty hTy =>
      rw [hTy]
      rw [hTy] at hSup0
      exact hSup0
    | isFalse hNotLtComp =>
      have hGeComp : 4 * plan.entries.length ≤ jRel := Nat.le_of_not_lt hNotLtComp
      have hjGe : pack.bodySrc.locals.length + 4 * plan.entries.length ≤ j := by
        rw [hjDecomp]
        exact Nat.add_le_add_left hGeComp _
      let r := j - (pack.bodySrc.locals.length + 4 * plan.entries.length)
      have hjEq : j = pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
        (s_nat_add_sub_cancel_prime hjGe).symm
      have hr : r < 5 := by
        have h1 : pack.bodySrc.locals.length + 4 * plan.entries.length + r <
            pack.bodySrc.locals.length + 4 * plan.entries.length + 5 := by
          rw [← hjEq]; exact hjLt
        exact s_nat_lt_of_add_lt_add_left h1
      rw [hjEq, getElem?_bodyTgt_locals_scratch pack hr] at hGet
      injection hGet with hEq
      rw [← hEq]
      cases Nat.beq r 4 <;> rfl

private theorem arrSliceStmtHasStorageMarker_mkStorageLiveRange_iff (start count tgtId : LocalId) :
    (mkStorageLiveRange start count).any (arrSliceStmtHasStorageMarker tgtId) = true ↔
      start ≤ tgtId ∧ tgtId < start + count := by
  induction count generalizing start with
  | zero =>
    constructor
    · intro h; cases h
    · intro h
      have h1 := h.1
      have h2 := h.2
      rw [Nat.add_zero] at h2
      exact False.elim (Nat.not_lt_of_ge h1 h2)
  | succ count' ih =>
    change ((arrSliceStmtHasStorageMarker tgtId (.baseStmt (.storageLive start))) ||
        (mkStorageLiveRange (start + 1) count').any (arrSliceStmtHasStorageMarker tgtId)) = true ↔ _
    constructor
    · intro h
      cases (bool_or_eq_true _ _).mp h with
      | inl h0 =>
        have hEq : start = tgtId := nat_beq_eq _ _ h0
        rw [hEq]
        exact ⟨Nat.le_refl _, Nat.lt_add_of_pos_right (Nat.zero_lt_succ count')⟩
      | inr hTail =>
        have hIH := (ih (start + 1)).mp hTail
        have h2' : tgtId < start + (count' + 1) := by
          have h2 := hIH.2
          rw [Nat.succ_add, ← Nat.add_succ] at h2
          exact h2
        exact ⟨Nat.le_trans (Nat.le_succ start) hIH.1, h2'⟩
    · intro h
      have h1 := h.1
      have h2 := h.2
      apply (bool_or_eq_true _ _).mpr
      cases Nat.decEq start tgtId with
      | isTrue hEq =>
        left
        exact nat_beq_true hEq
      | isFalse hNe =>
        right
        apply (ih (start + 1)).mpr
        constructor
        · exact Nat.lt_of_le_of_ne h1 hNe
        · rw [Nat.succ_add, ← Nat.add_succ]
          exact h2

private theorem arrSliceStmtHasStorageMarker_mkStorageDeadRange_iff (start count tgtId : LocalId) :
    (mkStorageDeadRange start count).any (arrSliceStmtHasStorageMarker tgtId) = true ↔
      start ≤ tgtId ∧ tgtId < start + count := by
  induction count generalizing start with
  | zero =>
    constructor
    · intro h; cases h
    · intro h
      have h1 := h.1
      have h2 := h.2
      rw [Nat.add_zero] at h2
      exact False.elim (Nat.not_lt_of_ge h1 h2)
  | succ count' ih =>
    change ((arrSliceStmtHasStorageMarker tgtId (.baseStmt (.storageDead start))) ||
        (mkStorageDeadRange (start + 1) count').any (arrSliceStmtHasStorageMarker tgtId)) = true ↔ _
    constructor
    · intro h
      cases (bool_or_eq_true _ _).mp h with
      | inl h0 =>
        have hEq : start = tgtId := nat_beq_eq _ _ h0
        rw [hEq]
        exact ⟨Nat.le_refl _, Nat.lt_add_of_pos_right (Nat.zero_lt_succ count')⟩
      | inr hTail =>
        have hIH := (ih (start + 1)).mp hTail
        have h2' : tgtId < start + (count' + 1) := by
          have h2 := hIH.2
          rw [Nat.succ_add, ← Nat.add_succ] at h2
          exact h2
        exact ⟨Nat.le_trans (Nat.le_succ start) hIH.1, h2'⟩
    · intro h
      have h1 := h.1
      have h2 := h.2
      apply (bool_or_eq_true _ _).mpr
      cases Nat.decEq start tgtId with
      | isTrue hEq =>
        left
        exact nat_beq_true hEq
      | isFalse hNe =>
        right
        apply (ih (start + 1)).mpr
        constructor
        · exact Nat.lt_of_le_of_ne h1 hNe
        · rw [Nat.succ_add, ← Nat.add_succ]
          exact h2

private theorem arrSliceStmtHasStorageMarker_arrayLivenessCheck (tgtId x : LocalId) :
    arrSliceStmtHasStorageMarker tgtId (.arrayLivenessCheck x) = false := rfl

