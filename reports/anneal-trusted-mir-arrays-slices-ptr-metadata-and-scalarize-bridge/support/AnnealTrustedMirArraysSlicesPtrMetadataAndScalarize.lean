private theorem applyArrSliceOptStep_sound
    (step : ArrSliceOptStep) (pSrc pTgt : ArrSliceProgram)
    (hApp : applyArrSliceOptStep step pSrc = some pTgt) :
    FullSemanticEquivArrSlice pSrc pTgt := by
  cases step with
  | lowerSliceLenCalls bodyId bbIdx =>
    exact applyLowerSliceLenCalls_sound bodyId bbIdx pSrc pTgt hApp
  | gvnFoldPtrMetadata bodyId bbIdx unsizeIdx metaIdx =>
    exact applyGvnFoldPtrMetadata_sound bodyId bbIdx unsizeIdx metaIdx pSrc pTgt hApp
  | sliceScalarize plan =>
    exact applySliceScalarize_sound plan pSrc pTgt hApp
  | arrayScalarize plan =>
    exact applyArrayScalarize_sound plan pSrc pTgt hApp

private theorem applyArrSliceOptTrace_sound :
    ∀ (trace : ArrSliceOptTrace) (pSrc pTgt : ArrSliceProgram),
      applyArrSliceOptTrace trace pSrc = some pTgt →
      FullSemanticEquivArrSlice pSrc pTgt
  | [], pSrc, pTgt, hApp => by
    cases hApp
    exact fullSemanticEquivArrSlice_refl pSrc
  | step :: rest, pSrc, pTgt, hApp => by
    unfold applyArrSliceOptTrace at hApp
    cases hStep : applyArrSliceOptStep step pSrc with
    | none => rw [hStep] at hApp; cases hApp
    | some pMid =>
      rw [hStep] at hApp; dsimp at hApp
      exact fullSemanticEquivArrSlice_trans
        (applyArrSliceOptStep_sound step pSrc pMid hStep)
        (applyArrSliceOptTrace_sound rest pMid pTgt hApp)

private theorem listMapOption_some_map_inv {α β : Type}
    {g : α → Option β} {f : β → α}
    (hInv : ∀ (a : α) (b : β), g a = some b → f b = a) :
    ∀ {xs : List α} {ys : List β},
      listMapOption g xs = some ys → ys.map f = xs
  | [], _, h => by cases h; rfl
  | x :: xs, ys, h => by
    cases hx : g x with
    | none =>
      change
        (match g x, listMapOption g xs with
         | some y, some zs => some (y :: zs)
         | _, _ => none) = some ys at h
      rw [hx] at h; cases h
    | some y =>
      cases hxs : listMapOption g xs with
      | none =>
        change
          (match g x, listMapOption g xs with
           | some w, some zs => some (w :: zs)
           | _, _ => none) = some ys at h
        rw [hx, hxs] at h; cases h
      | some zs =>
        change
          (match g x, listMapOption g xs with
           | some w, some ws => some (w :: ws)
           | _, _ => none) = some ys at h
        rw [hx, hxs] at h; cases h
        change f y :: List.map f zs = x :: xs
        rw [hInv x y hx, listMapOption_some_map_inv hInv hxs]

private theorem unembedBaseLocal_some_eq (d : ArrSliceLocalDecl) (ty : MirTy)
    (h : (match d with | .base t => some t | _ => none) = some ty) :
    ArrSliceLocalDecl.base ty = d := by
  cases d with
  | base ty' => cases h; rfl
  | array _ _ | sliceView _ => cases h

private theorem unembedBaseStmt_some_eq (stA : ArrSliceStmt) (st : StatementKind)
    (h : (match stA with | .baseStmt s => some s | _ => none) = some st) :
    ArrSliceStmt.baseStmt st = stA := by
  cases stA with
  | baseStmt st' => cases h; rfl
  | aggregateArray _ _ | repeatArray _ _ | arrayLivenessCheck _
  | readArrayConst _ _ _ _ | writeArrayConst _ _ _ | unsizeArrayToSlice _ _
  | sliceFromRawParts _ _ | subslice _ _ _ _ | ptrMetadata _ _ => cases h

private theorem unembedBaseTerm_some_eq (tA : ArrSliceTerm) (t : TerminatorKind)
    (h : (match tA with | .baseTerm tk => some tk | _ => none) = some t) :
    ArrSliceTerm.baseTerm t = tA := by
  cases tA with
  | baseTerm t' => cases h; rfl
  | sliceLenCall _ _ _ | boundsCheckArray _ _ _ _ | boundsCheckSlice _ _ _ _
  | readArrayElem _ _ _ _ | writeArrayElem _ _ _ _
  | readSliceElem _ _ _ _ | readSliceConst _ _ _ _ _ _ => cases h

private theorem arrSc5_match_block {oa : Option (List StatementKind)} {tm : ArrSliceTerm}
    {cleanup : Bool} {bb : BasicBlock}
    (h : (match oa, tm with
      | some stmts, .baseTerm t =>
        some { statements := stmts, terminator := t, cleanup := cleanup }
      | _, _ => none) = some bb) :
    ∃ (stmts : List StatementKind) (t : TerminatorKind),
      oa = some stmts ∧ tm = .baseTerm t ∧
        bb = { statements := stmts, terminator := t, cleanup := cleanup } := by
  cases oa with
  | none => cases h
  | some stmts =>
    cases tm with
    | baseTerm t =>
      cases h
      exact ⟨stmts, t, rfl, rfl, rfl⟩
    | sliceLenCall _ _ _ | boundsCheckArray _ _ _ _ | boundsCheckSlice _ _ _ _
    | readArrayElem _ _ _ _ | writeArrayElem _ _ _ _
    | readSliceElem _ _ _ _ | readSliceConst _ _ _ _ _ _ =>
      cases h

private theorem arrSc5_match_body {oa : Option (List MirTy)} {ob : Option (List BasicBlock)}
    {ac : Nat} {iu : Bool} {ident : String} {r : Body}
    (h : (match oa, ob with
      | some tys, some bbs => some ({ argumentCount := ac, locals := tys, basicBlocks := bbs, isUnsafe := iu, identity := ident })
      | _, _ => none) = some r) :
    ∃ (tys : List MirTy) (bbs : List BasicBlock),
      oa = some tys ∧ ob = some bbs ∧
        { argumentCount := ac, locals := tys, basicBlocks := bbs, isUnsafe := iu, identity := ident } = r := by
  cases oa with
  | none => cases h
  | some tys =>
    cases ob with
    | none => cases h
    | some bbs =>
      cases h
      exact ⟨tys, bbs, rfl, rfl, rfl⟩

private theorem unembedBaseBlock_some_embed (bbA : ArrSliceBlock) (bb : BasicBlock)
    (h : unembedBaseBlock bbA = some bb) :
    embedBaseBlock bb = bbA := by
  unfold unembedBaseBlock at h
  dsimp at h
  cases arrSc5_match_block h with
  | intro stmts h1 =>
    cases h1 with
    | intro tm h2 =>
      have hStEq := listMapOption_some_map_inv unembedBaseStmt_some_eq h2.1
      rw [h2.2.2]
      dsimp [embedBaseBlock]
      cases bbA
      dsimp at hStEq h2
      rw [hStEq, h2.2.1]

private theorem unembedBaseBody_some_embed (bA : ArrSliceBody) (b : Body)
    (h : unembedBaseBody bA = some b) :
    embedBaseBody b = bA := by
  unfold unembedBaseBody at h
  dsimp at h
  cases arrSc5_match_body h with
  | intro locs h1 =>
    cases h1 with
    | intro bbs h2 =>
      have hLocEq := listMapOption_some_map_inv unembedBaseLocal_some_eq h2.1
      have hBbsEq := listMapOption_some_map_inv unembedBaseBlock_some_embed h2.2.1
      rw [← h2.2.2]
      dsimp [embedBaseBody]
      cases bA
      dsimp at hLocEq hBbsEq
      rw [hLocEq, hBbsEq]

private theorem unembedBaseProgram_some_embed (pA : ArrSliceProgram) (p : Program)
    (h : unembedBaseProgram pA = some p) :
    embedBaseProgram p = pA := by
  unfold unembedBaseProgram at h
  cases hBods : listMapOption unembedBaseBody pA.bodies with
  | none => rw [hBods] at h; cases h
  | some bods =>
    rw [hBods] at h; dsimp at h
    cases h
    dsimp [embedBaseProgram]
    have hBodsEq := listMapOption_some_map_inv unembedBaseBody_some_embed hBods
    cases pA
    dsimp at hBodsEq
    rw [hBodsEq]

private theorem arraySliceScalarize_reduces_to_trusted_mir_slice5
    (trace : ArrSliceOptTrace) (pSrc : ArrSliceProgram) (pMir : Program)
    (hLower : checkArrSliceToTrustedMir trace pSrc pMir = true) :
    (∀ q : Query, WellFormedArrSlice pSrc q ↔ WellFormed pMir q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorArrSlice pSrc q out ↔ Behavior pMir q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultArrSlice pSrc q (.fault k) ↔
        ReachesResult pMir q (.fault k)) ∧
    (∀ q : Query, DivergesArrSlice pSrc q ↔ Diverges pMir q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostArrSlice pSrc q post ↔ SatisfiesPost pMir q post) := by
  unfold checkArrSliceToTrustedMir at hLower
  cases hTr : applyArrSliceOptTrace trace pSrc with
  | none => rw [hTr] at hLower; cases hLower
  | some pFlat =>
    rw [hTr] at hLower; dsimp at hLower
    cases hUn : unembedBaseProgram pFlat with
    | none => rw [hUn] at hLower; cases hLower
    | some pOut =>
      rw [hUn] at hLower; dsimp at hLower
      have hEq : pOut = pMir := programEq_eq pOut pMir hLower
      have hEmbed : embedBaseProgram pMir = pFlat := by
        rw [← hEq]
        exact unembedBaseProgram_some_embed pFlat pOut hUn
      have hTraceEquiv : FullSemanticEquivArrSlice pSrc (embedBaseProgram pMir) := by
        rw [hEmbed]
        exact applyArrSliceOptTrace_sound trace pSrc pFlat hTr
      have hCons := arrSlice_conservative_extension_exact_slice1 pMir
      have hBeh : ∀ (q : Query) (out : TerminalOut),
          BehaviorArrSlice pSrc q out ↔ Behavior pMir q out := by
        intro q out
        exact Iff.trans (hTraceEquiv.2.1 q out) ((hCons.2 q).2.1 out)
      have hFault : ∀ (q : Query) (k : FaultKind),
          ReachesResultArrSlice pSrc q (.fault k) ↔
            ReachesResult pMir q (.fault k) := by
        intro q k
        exact Iff.trans (hTraceEquiv.2.2.1 q k) ((hCons.2 q).2.2.1 k)
      have hAll := equivArrSliceToBase_of_outcomes pSrc pMir hBeh hFault
      exact ⟨fun q => (hAll q).1, hBeh, hFault,
        fun q => (hAll q).2.2.2.1, fun q post => (hAll q).2.2.2.2 post⟩

private theorem arraySlicePipeline_then_optPipeline_vc_transport_slice5
    (trace : ArrSliceOptTrace) (pSrc : ArrSliceProgram) (pMir pOpt : Program)
    (hLower : checkArrSliceToTrustedMir trace pSrc pMir = true)
    (hOpt : FullSemanticEquivBase pMir pOpt) :
    (∀ q : Query, WellFormedArrSlice pSrc q ↔ WellFormed pOpt q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorArrSlice pSrc q out ↔ Behavior pOpt q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultArrSlice pSrc q (.fault k) ↔
        ReachesResult pOpt q (.fault k)) ∧
    (∀ q : Query, DivergesArrSlice pSrc q ↔ Diverges pOpt q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostArrSlice pSrc q post ↔ SatisfiesPost pOpt q post) := by
  have hRed := arraySliceScalarize_reduces_to_trusted_mir_slice5 trace pSrc pMir hLower
  have hBeh : ∀ (q : Query) (out : TerminalOut),
      BehaviorArrSlice pSrc q out ↔ Behavior pOpt q out :=
    fun q out => Iff.trans (hRed.2.1 q out) (hOpt.2.1 q out)
  have hFault : ∀ (q : Query) (k : FaultKind),
      ReachesResultArrSlice pSrc q (.fault k) ↔
        ReachesResult pOpt q (.fault k) :=
    fun q k => Iff.trans (hRed.2.2.1 q k) (hOpt.2.2.1 q k)
  have hAll := equivArrSliceToBase_of_outcomes pSrc pOpt hBeh hFault
  exact ⟨fun q => (hAll q).1, hBeh, hFault,
    fun q => (hAll q).2.2.2.1, fun q post => (hAll q).2.2.2.2 post⟩

/-! ## Part III: Five Core Target Theorems Directly Over Unmodified `Trusted.MirSemantics` -/

/-- **Theorem 1 (`arrSlice_conservative_extension_exact`):**
Canonical embedding `embedBaseProgram p` of any unmodified
`Trusted.MirAst.Program` into `M_arrslice` preserves exact 1-step operational
behavior (`evalStepArrSlice` = `liftStepResultArrSlice ∘ evalStep`) and exact
bidirectional equivalence (`↔`) across `WellFormed`, `Behavior`,
`ReachesResult (.fault k)`, `Diverges`, and `SatisfiesPost`. -/
theorem arrSlice_conservative_extension_exact
    (p : Program) :
    (∀ (c : Choice) (s : State),
      evalStepArrSlice (embedBaseProgram p) c (embedArrSliceState s) =
        liftStepResultArrSlice (evalStep p c s)) ∧
    (∀ q : Query,
      (WellFormedArrSlice (embedBaseProgram p) q ↔ WellFormed p q) ∧
      (∀ out : TerminalOut,
        BehaviorArrSlice (embedBaseProgram p) q out ↔ Behavior p q out) ∧
      (∀ k : FaultKind,
        ReachesResultArrSlice (embedBaseProgram p) q (.fault k) ↔
          ReachesResult p q (.fault k)) ∧
      (DivergesArrSlice (embedBaseProgram p) q ↔ Diverges p q) ∧
      (∀ post : TerminalOut → Prop,
        SatisfiesPostArrSlice (embedBaseProgram p) q post ↔
          SatisfiesPost p q post)) := by
  exact arrSlice_conservative_extension_exact_slice1 p

/-- **Theorem 2 (`lowerSliceLenCalls_and_gvnPtrMetadata_sound_bidirectional_iff`):**
Both `LowerSliceLenCalls` (`checkLowerSliceLenCalls`) and intra-block `GVN`
`PtrMetadata(Unsize)` constant folding (`checkGvnFoldPtrMetadata`) preserve
full bidirectional semantic equivalence `FullSemanticEquivArrSlice pSrc pTgt`. -/
theorem lowerSliceLenCalls_and_gvnPtrMetadata_sound_bidirectional_iff :
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (pSrc pTgt : ArrSliceProgram),
      checkLowerSliceLenCalls bodyId bbIdx pSrc pTgt = true →
      FullSemanticEquivArrSlice pSrc pTgt) ∧
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (unsizeIdx metaIdx : Nat)
        (pSrc pTgt : ArrSliceProgram),
      checkGvnFoldPtrMetadata bodyId bbIdx unsizeIdx metaIdx pSrc pTgt = true →
      FullSemanticEquivArrSlice pSrc pTgt) := by
  exact lowerSliceLenCalls_and_gvnPtrMetadata_sound_bidirectional_iff_slice2

/-- **Theorem 3 (`danglingSlice_metadata_valid_deref_ub_and_boundsCheck_precedes_deref`):**
Universal algebraic and operational laws of wide-pointer slices in `M_arrslice`:
1. **Dangling Slice Metadata Validity vs. Dereference UB:** On any live
   `.dangling` slice of length `len < 2^64` with live `usize` destination `dst`,
   `ptrMetadata dst sLoc` succeeds and writes `len : usize` independently of
   any array slot, whereas `readSliceElem` on a `.dangling` slice
   deterministically faults `.fault .undefined` (Part IV `CE8` additionally
   witnesses `.dangling` `readSliceConst` UB).
2. **`BoundsCheck` Precedes Dereference:** On any live slice `(backing, start,
   len)` (including `.dangling`) and `usize` index `idx < 2^64`,
   `boundsCheckSlice` jumps to `inBoundsBb` iff `idx < len` and to `panicBb`
   iff `idx ≥ len` without touching `backing`.
3. **Exact `Subslice` Composition Law:** Chaining two valid from-start
   `evalSubsliceVal` calls `(from₁, to₁, false)` then `(from₂, to₂, false)`
   equals a single `evalSubsliceVal` `(from₁ + from₂, from₁ + to₂, false)`
   preserving `backing` and `start' + len' < 2^64` (Part IV `CE8` additionally
   witnesses out-of-bounds `evalSubsliceVal` `.error .undefined`). -/
theorem danglingSlice_metadata_valid_deref_ub_and_boundsCheck_precedes_deref :
    (∀ (body : ArrSliceBody) (frame : ArrSliceFrame) (cm : CallerMemory)
        (dst sLoc : LocalId) (elemTy : MirTy) (len : Nat) (optOld : Option Val),
      Nat.blt len maxUsize = true →
      Trusted.MirSemantics.getElem? body.locals dst = some (.base usizeTy) →
      Trusted.MirSemantics.getElem? body.locals sLoc = some (.sliceView elemTy) →
      Trusted.MirSemantics.getElem? frame.locals sLoc =
        some (.liveSlice (some { backing := .dangling, start := 0, len := len })) →
      Trusted.MirSemantics.getElem? frame.locals dst = some (.baseSlot (.live optOld)) →
      ∃ slots' : List ArrSliceSlot,
        evalArrSliceStmt body frame cm (.ptrMetadata dst sLoc) =
          stepStmtNext frame cm slots' ∧
        Trusted.MirSemantics.getElem? slots' dst =
          some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 len⟩))))) ∧
    (∀ (body : ArrSliceBody) (bb : ArrSliceBlock) (frame : ArrSliceFrame)
        (cm : CallerMemory) (dst sLoc : LocalId) (elemTy : MirTy)
        (start len idx : Nat) (nextBb : BasicBlockId),
      Nat.blt idx maxUsize = true →
      Trusted.MirSemantics.getElem? body.locals dst = some (.base elemTy) →
      Trusted.MirSemantics.getElem? body.locals sLoc = some (.sliceView elemTy) →
      Trusted.MirSemantics.getElem? frame.locals sLoc =
        some (.liveSlice (some { backing := .dangling, start := start, len := len })) →
      bb.terminator = .readSliceElem dst sLoc (usizeConst idx) nextBb →
      evalArrSliceTerm body bb frame cm = .fault .undefined) ∧
    (∀ (body : ArrSliceBody) (bb : ArrSliceBlock) (frame : ArrSliceFrame)
        (cm : CallerMemory) (sLoc : LocalId) (elemTy : MirTy)
        (sv : SliceViewVal) (idx : Nat) (inBoundsBb panicBb : BasicBlockId),
      Nat.blt idx maxUsize = true →
      Trusted.MirSemantics.getElem? body.locals sLoc = some (.sliceView elemTy) →
      Trusted.MirSemantics.getElem? frame.locals sLoc =
        some (.liveSlice (some sv)) →
      bb.terminator = .boundsCheckSlice sLoc (usizeConst idx) inBoundsBb panicBb →
      evalArrSliceTerm body bb frame cm =
        jumpArrSliceBlock frame cm frame.locals
          (if Nat.blt idx sv.len then inBoundsBb else panicBb)) ∧
    (∀ (sv : SliceViewVal) (f₁ t₁ f₂ t₂ : Nat),
      Nat.blt (sv.start + sv.len) maxUsize = true →
      f₁ ≤ t₁ → t₁ ≤ sv.len → f₂ ≤ t₂ → t₂ ≤ t₁ - f₁ →
      ∃ sv₁ sv₂ : SliceViewVal,
        evalSubsliceVal sv f₁ t₁ false = .ok sv₁ ∧
        evalSubsliceVal sv₁ f₂ t₂ false = .ok sv₂ ∧
        evalSubsliceVal sv (f₁ + f₂) (f₁ + t₂) false = .ok sv₂ ∧
        sv₂.backing = sv.backing ∧
        sv₂.start + sv₂.len < maxUsize) := by
  exact danglingSlice_metadata_valid_deref_ub_and_boundsCheck_precedes_deref_slice1

/-- **Theorem 4 (`arraySliceScalarize_reduces_to_trusted_mir`):**
Any finite `ArrSliceOptTrace` certified by
`checkArrSliceToTrustedMir trace pSrc pMir = true` produces an unmodified
`Trusted.MirAst.Program` (`pMir`) whose unmodified `Trusted.MirSemantics`
judgments (`WellFormed`, `Behavior`, `ReachesResult (.fault k)`, `Diverges`,
and `SatisfiesPost`) are bidirectionally equivalent (`↔`) to `M_arrslice` on
`pSrc`. -/
theorem arraySliceScalarize_reduces_to_trusted_mir
    (trace : ArrSliceOptTrace) (pSrc : ArrSliceProgram) (pMir : Program)
    (hLower : checkArrSliceToTrustedMir trace pSrc pMir = true) :
    (∀ q : Query, WellFormedArrSlice pSrc q ↔ WellFormed pMir q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorArrSlice pSrc q out ↔ Behavior pMir q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultArrSlice pSrc q (.fault k) ↔
        ReachesResult pMir q (.fault k)) ∧
    (∀ q : Query, DivergesArrSlice pSrc q ↔ Diverges pMir q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostArrSlice pSrc q post ↔ SatisfiesPost pMir q post) := by
  exact arraySliceScalarize_reduces_to_trusted_mir_slice5 trace pSrc pMir hLower

/-- **Theorem 5 (`arraySlicePipeline_then_optPipeline_vc_transport`):**
Vertical composition: any certified `ArrSliceOptTrace` lowering `pSrc` into
unmodified `Trusted.MirAst.Program` `pMir` followed by any certified
`Trusted.MirSemantics` optimization equivalence `FullSemanticEquivBase pMir pOpt`
transports all five `M_arrslice` verification judgments bidirectionally (`↔`)
onto unmodified `Trusted.MirSemantics` on `pOpt`. -/
theorem arraySlicePipeline_then_optPipeline_vc_transport
    (trace : ArrSliceOptTrace) (pSrc : ArrSliceProgram) (pMir pOpt : Program)
    (hLower : checkArrSliceToTrustedMir trace pSrc pMir = true)
    (hOpt : FullSemanticEquivBase pMir pOpt) :
    (∀ q : Query, WellFormedArrSlice pSrc q ↔ WellFormed pOpt q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorArrSlice pSrc q out ↔ Behavior pOpt q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultArrSlice pSrc q (.fault k) ↔
        ReachesResult pOpt q (.fault k)) ∧
    (∀ q : Query, DivergesArrSlice pSrc q ↔ Diverges pOpt q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostArrSlice pSrc q post ↔ SatisfiesPost pOpt q post) := by
  exact arraySlicePipeline_then_optPipeline_vc_transport_slice5
    trace pSrc pMir pOpt hLower hOpt

/-! ## Part IV: Bounded-Fuel Adequacy, Eleven Sharpness Witnesses (`CE1`--`CE11`), & End-to-End `Trusted.MirSemantics` Lowering Witness (`0` `sorry`) -/

noncomputable def execFuelArrSlice (p : ArrSliceProgram) :
    Nat → ArrSliceState → Option (StepResult ArrSliceState TerminalOut)
  | 0, _ => none
  | fuel + 1, s =>
    match evalStepArrSlice p 0 s with
    | .step s' => execFuelArrSlice p fuel s'
    | .done out => some (.done out)
    | .fault k => some (.fault k)

noncomputable def execArrSlice (p : ArrSliceProgram) (q : Query) (fuel : Nat) :
    Option (StepResult ArrSliceState TerminalOut) :=
  match initStateArrSlice p q with
  | .error k => some (.fault k)
  | .ok s₀ => execFuelArrSlice p fuel s₀

noncomputable def execFuelBase (p : Program) :
    Nat → State → Option (StepResult State TerminalOut)
  | 0, _ => none
  | fuel + 1, s =>
    match evalStep p 0 s with
    | .step s' => execFuelBase p fuel s'
    | .done out => some (.done out)
    | .fault k => some (.fault k)

noncomputable def execBase (p : Program) (q : Query) (fuel : Nat) :
    Option (StepResult State TerminalOut) :=
  match initState p q with
  | .error k => some (.fault k)
  | .ok s₀ => execFuelBase p fuel s₀

theorem reachesArrSlice_head {p : ArrSliceProgram}
    {s₁ s₂ s₃ : ArrSliceState}
    (hStep : StepArrSlice p s₁ (.step s₂))
    (hRest : ReachesArrSlice p s₂ s₃) :
    ReachesArrSlice p s₁ s₃ := by
  induction hRest with
  | refl => exact ReachesArrSlice.tail (ReachesArrSlice.refl s₁) hStep
  | tail _ hLast ih => exact ReachesArrSlice.tail ih hLast

theorem reachesArrSlice_head_det {p : ArrSliceProgram}
    {s₁ s₂ s₃ : ArrSliceState}
    (hStep : evalStepArrSlice p 0 s₁ = .step s₂)
    (hRest : ReachesArrSlice p s₂ s₃) :
    ReachesArrSlice p s₁ s₃ :=
  reachesArrSlice_head ⟨0, rfl, hStep⟩ hRest

theorem execFuelArrSlice_sound (p : ArrSliceProgram) :
    ∀ (fuel : Nat) (s₀ : ArrSliceState)
      (res : StepResult ArrSliceState TerminalOut),
      execFuelArrSlice p fuel s₀ = some res →
      ∃ s : ArrSliceState, ReachesArrSlice p s₀ s ∧ StepArrSlice p s res
  | 0, _, _, h => by cases h
  | fuel + 1, s₀, res, h => by
    unfold execFuelArrSlice at h
    cases hEv : evalStepArrSlice p 0 s₀ with
    | step s₁ =>
      rw [hEv] at h
      let ⟨s, hR, hS⟩ := execFuelArrSlice_sound p fuel s₁ res h
      exact ⟨s, reachesArrSlice_head_det hEv hR, hS⟩
    | done out =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, ReachesArrSlice.refl s₀, ⟨0, rfl, hEv⟩⟩
    | fault k =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, ReachesArrSlice.refl s₀, ⟨0, rfl, hEv⟩⟩

theorem execArrSlice_sound {p : ArrSliceProgram} {q : Query} {fuel : Nat}
    {res : StepResult ArrSliceState TerminalOut}
    (h : execArrSlice p q fuel = some res) :
    ReachesResultArrSlice p q res := by
  unfold execArrSlice at h
  unfold ReachesResultArrSlice
  cases hInit : initStateArrSlice p q with
  | error k =>
    rw [hInit] at h
    injection h with hEq
    exact hEq.symm
  | ok s₀ =>
    rw [hInit] at h
    exact execFuelArrSlice_sound p fuel s₀ res h

theorem execFuelArrSlice_done_det (p : ArrSliceProgram) :
    ∀ (fuel : Nat) (s₀ : ArrSliceState) (out : TerminalOut),
      execFuelArrSlice p fuel s₀ = some (.done out) →
      (∀ s : ArrSliceState, ReachesArrSlice p s₀ s →
        ∀ k : FaultKind, ¬ StepArrSlice p s (.fault k)) ∧
      (∀ s : ArrSliceState, ReachesArrSlice p s₀ s →
        ∀ out' : TerminalOut, StepArrSlice p s (.done out') → out' = out)
  | 0, _, _, h => by cases h
  | fuel + 1, s₀, out, h => by
    unfold execFuelArrSlice at h
    cases hEv : evalStepArrSlice p 0 s₀ with
    | fault _ => rw [hEv] at h; cases h
    | done out₀ =>
      rw [hEv] at h
      injection h with hEq
      injection hEq with hOutEq
      subst hOutEq
      have hOnly0 : ∀ s, ReachesArrSlice p s₀ s → s = s₀ := by
        intro s hR
        induction hR with
        | refl => rfl
        | tail _ hStep ih =>
          subst ih
          let ⟨c, hc, hStepEq⟩ := hStep
          cases hc
          rw [hEv] at hStepEq
          cases hStepEq
      refine ⟨?_, ?_⟩
      · intro s hR k hF
        have hEq := hOnly0 s hR
        subst hEq
        let ⟨c, hc, hFEq⟩ := hF
        cases hc
        rw [hEv] at hFEq
        cases hFEq
      · intro s hR out' hD
        have hEq := hOnly0 s hR
        subst hEq
        let ⟨c, hc, hDEq⟩ := hD
        cases hc
        rw [hEv] at hDEq
        injection hDEq with hO
        exact hO.symm
    | step s₁ =>
      rw [hEv] at h
      let ⟨ihNoF, ihDet⟩ := execFuelArrSlice_done_det p fuel s₁ out h
      have hStepFrom0 :
          ∀ s, ReachesArrSlice p s₀ s → s = s₀ ∨ ReachesArrSlice p s₁ s := by
        intro s hR
        induction hR with
        | refl => exact Or.inl rfl
        | tail _ hSt ih =>
          cases ih with
          | inl hEq0 =>
            subst hEq0
            let ⟨c, hc, hStEq⟩ := hSt
            cases hc
            rw [hEv] at hStEq
            injection hStEq with hEq1
            subst hEq1
            exact Or.inr (ReachesArrSlice.refl s₁)
          | inr hR1 =>
            exact Or.inr (ReachesArrSlice.tail hR1 hSt)
      refine ⟨?_, ?_⟩
      · intro s hR k hF
        cases hStepFrom0 s hR with
        | inl hEq0 =>
          subst hEq0
          let ⟨c, hc, hFEq⟩ := hF
          cases hc
          rw [hEv] at hFEq
          cases hFEq
        | inr hR1 => exact ihNoF s hR1 k hF
      · intro s hR out' hD
        cases hStepFrom0 s hR with
        | inl hEq0 =>
          subst hEq0
          let ⟨c, hc, hDEq⟩ := hD
          cases hc
          rw [hEv] at hDEq
          cases hDEq
        | inr hR1 => exact ihDet s hR1 out' hD

theorem positiveCanaryArrSlice_of_exec {p : ArrSliceProgram} {q : Query}
    {fuel : Nat} {out : TerminalOut}
    (h : execArrSlice p q fuel = some (.done out)) :
    WellFormedArrSlice p q ∧ BehaviorArrSlice p q out ∧
      (∀ out' : TerminalOut, BehaviorArrSlice p q out' → out' = out) := by
  have hBeh : BehaviorArrSlice p q out := execArrSlice_sound h
  unfold execArrSlice at h
  cases hInit : initStateArrSlice p q with
  | error _ => rw [hInit] at h; cases h
  | ok s₀ =>
    rw [hInit] at h
    let ⟨hNoF, hDet⟩ := execFuelArrSlice_done_det p fuel s₀ out h
    refine ⟨⟨⟨s₀, hInit, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩, hBeh, ?_⟩
    · intro k hF
      unfold ReachesResultArrSlice at hF
      rw [hInit] at hF
      let ⟨s, hR, hS⟩ := hF
      exact hNoF s hR k hS
    · intro out' hB'
      unfold BehaviorArrSlice ReachesResultArrSlice at hB'
      rw [hInit] at hB'
      let ⟨s, hR, hS⟩ := hB'
      exact hDet s hR out' hS

theorem negativeCanaryArrSlice_of_exec {p : ArrSliceProgram} {q : Query}
    {fuel : Nat} {k : FaultKind}
    (h : execArrSlice p q fuel = some (.fault k)) :
    ReachesResultArrSlice p q (.fault k) ∧ ¬ WellFormedArrSlice p q := by
  have hF : ReachesResultArrSlice p q (.fault k) := execArrSlice_sound h
  exact ⟨hF, fun hWf => hWf.2 k hF⟩

theorem reachesBase_head {p : Program} {s₁ s₂ s₃ : State}
    (hStep : Step p s₁ (.step s₂)) (hRest : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction hRest with
  | refl => exact Reaches.tail (Reaches.refl s₁) hStep
  | tail _ hLast ih => exact Reaches.tail ih hLast

theorem execFuelBase_sound (p : Program) :
    ∀ (fuel : Nat) (s₀ : State) (res : StepResult State TerminalOut),
      execFuelBase p fuel s₀ = some res →
      ∃ s : State, Reaches p s₀ s ∧ Step p s res
  | 0, _, _, h => by cases h
  | fuel + 1, s₀, res, h => by
    unfold execFuelBase at h
    cases hEv : evalStep p 0 s₀ with
    | step s₁ =>
      rw [hEv] at h
      let ⟨s, hR, hS⟩ := execFuelBase_sound p fuel s₁ res h
      exact ⟨s, reachesBase_head ⟨0, rfl, hEv⟩ hR, hS⟩
    | done out =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, Reaches.refl s₀, ⟨0, rfl, hEv⟩⟩
    | fault k =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, Reaches.refl s₀, ⟨0, rfl, hEv⟩⟩

theorem execBase_sound {p : Program} {q : Query} {fuel : Nat}
    {res : StepResult State TerminalOut}
    (h : execBase p q fuel = some res) :
    ReachesResult p q res := by
  unfold execBase at h
  unfold ReachesResult
  cases hInit : initState p q with
  | error k =>
    rw [hInit] at h
    injection h with hEq
    exact hEq.symm
  | ok s₀ =>
    rw [hInit] at h
    exact execFuelBase_sound p fuel s₀ res h

/-- Helper to unwrap lowered `ArrSliceProgram` into `Program` for Part IV. -/
noncomputable def lowerOrEmpty (trace : ArrSliceOptTrace)
    (pSrc : ArrSliceProgram) : Program :=
  match applyArrSliceOptTrace trace pSrc with
  | some pFlat =>
    match unembedBaseProgram pFlat with
    | some pMir => pMir
    | none => { bodies := [], pointerWidthBits := 64, mirProfileVersion := 1 }
  | none => { bodies := [], pointerWidthBits := 64, mirProfileVersion := 1 }

noncomputable def u32Const (n : Nat) : Operand :=
  .constant { ty := .int .i32 false, lit := .scalar (BitVec.ofNat 128 n) }

noncomputable def emptyQuery : Query := { args := [], callerMem := ⟨[]⟩ }

noncomputable def queryUsize (n : Nat) : Query :=
  { args := [.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩], callerMem := ⟨[]⟩ }

/-- **CE1 (`[u32; 4]` `boundsCheckArray` Precedes UB vs. Unchecked OOB Read UB):**
Checked access returns `30` on `idx = 2` and routes `idx = 4` to `panicBb`
(`999`) before deref, whereas bypassing `boundsCheckArray` at `idx = 4` faults
`.fault .undefined` BOTH in `M_arrslice` AND in unmodified `Trusted.MirSemantics`. -/
noncomputable def progCe1Checked : ArrSliceProgram where
  bodies := [{
    argumentCount := 1
    locals := [.base (.int .i32 false), .base usizeTy, .array (.int .i32 false) 4]
    basicBlocks := [
      { statements := [.aggregateArray 2 [u32Const 10, u32Const 20, u32Const 30, u32Const 40]]
        terminator := .boundsCheckArray 2 (.copy { localId := 1, projection := [] }) 1 2 },
      { statements := []
        terminator := .readArrayElem 0 2 (.copy { localId := 1, projection := [] }) 3 },
      { statements := [mkAssignUse 0 (u32Const 999)]
        terminator := .baseTerm .return_ },
      { statements := [], terminator := .baseTerm .return_ }
    ]
  }]
  pointerWidthBits := 64
  mirProfileVersion := 1

noncomputable def progCe1UncheckedOob : ArrSliceProgram where
  bodies := [{
    argumentCount := 0
    locals := [.base (.int .i32 false), .array (.int .i32 false) 4]
    basicBlocks := [
      { statements := [.aggregateArray 1 [u32Const 10, u32Const 20, u32Const 30, u32Const 40]]
        terminator := .readArrayElem 0 1 (usizeConst 4) 1 },
      { statements := [], terminator := .baseTerm .return_ }
    ]
  }]
  pointerWidthBits := 64
  mirProfileVersion := 1

noncomputable def progCe1UncheckedOobMir : Program :=
  lowerOrEmpty [.arrayScalarize ⟨0, 1⟩] progCe1UncheckedOob

theorem ce1_bounds_check_precedes_ub_and_unchecked_oob_faults_in_trusted_mir :
    BehaviorArrSlice progCe1Checked (queryUsize 2)
      (.returned ⟨.scalar ⟨.i32, false, BitVec.ofNat 128 30⟩, ⟨[]⟩⟩) ∧
    BehaviorArrSlice progCe1Checked (queryUsize 4)
      (.returned ⟨.scalar ⟨.i32, false, BitVec.ofNat 128 999⟩, ⟨[]⟩⟩) ∧
    checkArrSliceToTrustedMir [.arrayScalarize ⟨0, 1⟩] progCe1UncheckedOob progCe1UncheckedOobMir = true ∧
    ReachesResultArrSlice progCe1UncheckedOob emptyQuery (.fault .undefined) ∧
    ReachesResult progCe1UncheckedOobMir emptyQuery (.fault .undefined) :=
  ⟨(positiveCanaryArrSlice_of_exec (fuel := 10) (by rfl)).2.1,
   (positiveCanaryArrSlice_of_exec (fuel := 10) (by rfl)).2.1,
   rfl,
   (negativeCanaryArrSlice_of_exec (fuel := 10) (by rfl)).1,
   execBase_sound (fuel := 30) (by rfl)⟩

/-- **CE2 (`E3-90` `let [head, mid @ .., tail] = slice` Pattern Match Lowered to
Unmodified `Trusted.MirSemantics`):**
Unsizes `[1, 2, 3, 4, 5]`, reads `head = slice[0 of 2]`, forms
`mid = slice[1..-1]`, reads `mid_len = PtrMetadata(mid)` (`= 3`), reads
`tail = slice[-1 of 2]` (`= 5`), lowers via `SliceScalarize + ArrayScalarize`
into unmodified `Trusted.MirSemantics`, and returns `head + tail = 6` plus
`mid_len = 3` (`= 9`). -/
noncomputable def progCe2PatternMatch : ArrSliceProgram where
  bodies := [{
    argumentCount := 0
    locals := [
      .base usizeTy,             -- _0: return usize (head + mid.len + tail)
      .array usizeTy 5,          -- _1: [1, 2, 3, 4, 5]
      .sliceView usizeTy,        -- _2: slice
      .sliceView usizeTy,        -- _3: mid
      .base usizeTy,             -- _4: head
      .base usizeTy,             -- _5: mid.len
      .base usizeTy,             -- _6: tail
      .base usizeTy              -- _7: head + mid.len
    ]
    basicBlocks := [
      { statements := [
          .aggregateArray 1 [usizeConst 1, usizeConst 2, usizeConst 3, usizeConst 4, usizeConst 5],
          .unsizeArrayToSlice 2 1,
          .subslice 3 2 1 1 true,
          .ptrMetadata 5 3
        ]
        terminator := .readSliceConst 4 2 0 2 false 1 },
      { statements := []
        terminator := .readSliceConst 6 2 1 2 true 2 },
      { statements := [
          .baseStmt (.assign { localId := 7, projection := [] }
            (.binaryOp .add (.copy { localId := 4, projection := [] })
              (.copy { localId := 5, projection := [] }))),
          .baseStmt (.assign { localId := 0, projection := [] }
            (.binaryOp .add (.copy { localId := 7, projection := [] })
              (.copy { localId := 6, projection := [] })))
        ]
        terminator := .baseTerm .return_ }
    ]
  }]
  pointerWidthBits := 64
  mirProfileVersion := 1

noncomputable def traceCe2 : ArrSliceOptTrace :=
  [.sliceScalarize ⟨0, [⟨2, some 1⟩, ⟨3, some 1⟩]⟩, .arrayScalarize ⟨0, 1⟩]

noncomputable def progCe2Mir : Program := lowerOrEmpty traceCe2 progCe2PatternMatch

theorem ce2_constant_index_and_subslice_lower_to_trusted_mir :
    checkArrSliceToTrustedMir traceCe2 progCe2PatternMatch progCe2Mir = true ∧
    BehaviorArrSlice progCe2PatternMatch emptyQuery
      (.returned ⟨.scalar ⟨.isize, false, BitVec.ofNat 128 9⟩, ⟨[]⟩⟩) ∧
    ReachesResult progCe2Mir emptyQuery
      (.done (.returned ⟨.scalar ⟨.isize, false, BitVec.ofNat 128 9⟩, ⟨[]⟩⟩)) :=
  ⟨rfl,
   (positiveCanaryArrSlice_of_exec (fuel := 20) (by rfl)).2.1,
   execBase_sound (fuel := 80) (by rfl)⟩

/-- **CE3 (`E3-90` `NonNull::dangling()` Slice: `PtrMetadata` Valid vs. Deref UB):**
A `.dangling` slice with `len = 100` returns `100_usize` via `ptrMetadata`
(both in `M_arrslice` and in `Trusted.MirSemantics`), while dereferencing
`(*raw)[0]` faults `.fault .undefined` in BOTH `M_arrslice` and
`Trusted.MirSemantics`! -/
noncomputable def progCe3DanglingMeta : ArrSliceProgram where
  bodies := [{
    argumentCount := 0
    locals := [.base usizeTy, .sliceView (.int .i32 false)]
    basicBlocks := [{
      statements := [.sliceFromRawParts 1 (usizeConst 100), .ptrMetadata 0 1]
      terminator := .baseTerm .return_
    }]
  }]
  pointerWidthBits := 64
  mirProfileVersion := 1

noncomputable def progCe3DanglingDeref : ArrSliceProgram where
  bodies := [{
    argumentCount := 0
    locals := [.base (.int .i32 false), .sliceView (.int .i32 false)]
    basicBlocks := [
