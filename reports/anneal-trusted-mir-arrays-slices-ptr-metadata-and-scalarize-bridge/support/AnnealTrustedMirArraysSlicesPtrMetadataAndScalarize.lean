private theorem s4b_arrSc_localMatch_set_prefix_other
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    (hLM : arrSc_LocalMatch pack slots₁ slots₂)
    {a : LocalId} (hLt : a < pack.bodySrc.locals.length) (hNe : a ≠ plan.arrLocal)
    {sl : ArrSliceSlot}
    (hSet₁ : setElem? slots₁ a sl = some slots₁')
    (hSet₂ : setElem? slots₂ a sl = some slots₂') :
    arrSc_LocalMatch pack slots₁' slots₂' := by
  have hPref' : arrSc_PrefixMatch pack slots₁' slots₂' := by
    refine ⟨?_, ?_⟩
    · rw [setElem?_length slots₁ a sl slots₁' hSet₁, hLM.1.1]
    · intro i hi _hNeI
      cases s4b_arrSc_nat_eq_or_ne i a with
      | inl hEq =>
        rw [hEq, getElem?_setElem?_self slots₂ a sl slots₂' hSet₂,
          getElem?_setElem?_self slots₁ a sl slots₁' hSet₁]
      | inr hNeI =>
        rw [getElem?_setElem?_ne slots₂ a i sl slots₂' (fun h => hNeI h.symm) hSet₂,
          getElem?_setElem?_ne slots₁ a i sl slots₁' (fun h => hNeI h.symm) hSet₁]
        exact hLM.1.2 i hi _hNeI
  have hLen' : slots₂'.length = slots₂.length := setElem?_length slots₂ a sl slots₂' hSet₂
  have hGe : ∀ j : Nat, pack.bodySrc.locals.length ≤ j →
      Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j := by
    intro j hj
    have hNeJ : a ≠ j := fun hEq =>
      nat_lt_irrefl a (Nat.lt_of_lt_of_le hLt (by rw [hEq]; exact hj))
    exact getElem?_setElem?_ne slots₂ a j sl slots₂' hNeJ hSet₂
  have hArr₁ : Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
      Trusted.MirSemantics.getElem? slots₁ plan.arrLocal :=
    getElem?_setElem?_ne slots₁ a plan.arrLocal sl slots₁' hNe hSet₁
  exact arrSc_localMatch_lift_prefix pack hLM hPref' hLen' hGe hArr₁

private theorem s4b_arrSc_compRel_liveArray_setElem
    {base len : Nat} {slots₂ slots₂' : List ArrSliceSlot}
    {elems elems' : List (Option Val)} {idx : Nat} {v : Val}
    (hComp : arrSc_CompRel base len slots₂ (.liveArray elems))
    (_hIdx : idx < len)
    (hElems : setElem? elems idx (some v) = some elems')
    (hSlots : setElem? slots₂ (base + 1 + idx) (.baseSlot (.live (some v))) = some slots₂') :
    arrSc_CompRel base len slots₂' (.liveArray elems') := by
  refine ⟨?_, ?_, ?_⟩
  · rw [setElem?_length elems idx (some v) elems' hElems, hComp.1]
  · have hNe : base + 1 + idx ≠ base := fun hEq => by
      have hLt : base < base + 1 + idx := by
        rw [Nat.add_assoc]
        exact arrSc_lt_add_one_add base idx
      rw [hEq] at hLt
      exact nat_lt_irrefl base hLt
    rw [getElem?_setElem?_ne slots₂ (base + 1 + idx) base _ slots₂' hNe hSlots]
    exact hComp.2.1
  · intro j hj
    cases s4b_arrSc_nat_eq_or_ne j idx with
    | inl hEq =>
      rw [hEq]
      refine ⟨some v, getElem?_setElem?_self elems idx (some v) elems' hElems, ?_⟩
      exact getElem?_setElem?_self slots₂ (base + 1 + idx) (.baseSlot (.live (some v))) slots₂' hSlots
    | inr hNe =>
      have hNeB : base + 1 + idx ≠ base + 1 + j := fun h =>
        hNe (Nat.add_left_cancel h).symm
      cases hComp.2.2 j hj with
      | intro optV hOpt =>
        refine ⟨optV, ?_, ?_⟩
        · rw [getElem?_setElem?_ne elems idx j (some v) elems' (fun h => hNe h.symm) hElems]
          exact hOpt.1
        · rw [getElem?_setElem?_ne slots₂ (base + 1 + idx) (base + 1 + j)
              (.baseSlot (.live (some v))) slots₂' hNeB hSlots]
          exact hOpt.2

private theorem arrSc_compRel_liveArray_moveElem
    {base len : Nat} {slots₂ slots₂' : List ArrSliceSlot}
    {elems elems' : List (Option Val)} {elemTy : MirTy} {idx : Nat}
    (hComp : arrSc_CompRel base len slots₂ (.liveArray elems))
    (_hIdx : idx < len)
    (hElems : setElem? elems idx (initElemOptVal elemTy) = some elems')
    (hSlots : setElem? slots₂ (base + 1 + idx) (.baseSlot (liveUninitSlot elemTy)) = some slots₂') :
    arrSc_CompRel base len slots₂' (.liveArray elems') := by
  refine ⟨?_, ?_, ?_⟩
  · rw [setElem?_length elems idx (initElemOptVal elemTy) elems' hElems, hComp.1]
  · have hNe : base + 1 + idx ≠ base := fun hEq => by
      have hLt : base < base + 1 + idx := by
        rw [Nat.add_assoc]
        exact arrSc_lt_add_one_add base idx
      rw [hEq] at hLt
      exact nat_lt_irrefl base hLt
    rw [getElem?_setElem?_ne slots₂ (base + 1 + idx) base _ slots₂' hNe hSlots]
    exact hComp.2.1
  · intro j hj
    cases s4b_arrSc_nat_eq_or_ne j idx with
    | inl hEq =>
      rw [hEq]
      refine ⟨initElemOptVal elemTy,
        getElem?_setElem?_self elems idx (initElemOptVal elemTy) elems' hElems, ?_⟩
      rw [getElem?_setElem?_self slots₂ (base + 1 + idx) (.baseSlot (liveUninitSlot elemTy)) slots₂' hSlots,
        arrSc_liveUninitSlot_eq elemTy]
    | inr hNe =>
      have hNeB : base + 1 + idx ≠ base + 1 + j := fun h =>
        hNe (Nat.add_left_cancel h).symm
      cases hComp.2.2 j hj with
      | intro optV hOpt =>
        refine ⟨optV, ?_, ?_⟩
        · rw [getElem?_setElem?_ne elems idx j (initElemOptVal elemTy) elems' (fun h => hNe h.symm) hElems]
          exact hOpt.1
        · rw [getElem?_setElem?_ne slots₂ (base + 1 + idx) (base + 1 + j)
              (.baseSlot (liveUninitSlot elemTy)) slots₂' hNeB hSlots]
          exact hOpt.2

private theorem s4b_arrSc_localMatch_set_arrElem
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List ArrSliceSlot}
    (hLM : arrSc_LocalMatch pack slots₁ slots₂)
    {elems' : List (Option Val)} {arrSl' : ArrSliceSlot}
    (hSet₁ : setElem? slots₁ plan.arrLocal arrSl' = some slots₁')
    {idx : Nat} (hIdx : idx < pack.len) {slEl : ArrSliceSlot}
    (hSet₂ : setElem? slots₂ (pack.bodySrc.locals.length + 1 + idx) slEl = some slots₂')
    (hComp' : arrSc_CompRel pack.bodySrc.locals.length pack.len slots₂' arrSl')
    (_hElems : elems'.length = pack.len ∨ arrSl' = .liveArray elems') :
    arrSc_LocalMatch pack slots₁' slots₂' := by
  let kIdx := pack.bodySrc.locals.length + 1 + idx
  refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · rw [setElem?_length slots₁ plan.arrLocal arrSl' slots₁' hSet₁, hLM.1.1]
  · intro i hi hNeArr
    have hNeI : kIdx ≠ i := fun hEq => by
      have hLt : pack.bodySrc.locals.length < kIdx := by
        change pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + idx
        rw [Nat.add_assoc]
        exact arrSc_lt_add_one_add pack.bodySrc.locals.length idx
      rw [hEq] at hLt
      exact nat_lt_irrefl i (Nat.lt_trans hi hLt)
    rw [getElem?_setElem?_ne slots₂ kIdx i slEl slots₂' hNeI hSet₂,
      getElem?_setElem?_ne slots₁ plan.arrLocal i arrSl' slots₁' (fun h => hNeArr h.symm) hSet₁]
    exact hLM.1.2 i hi hNeArr
  · rw [setElem?_length slots₂ kIdx slEl slots₂' hSet₂, hLM.2.1]
  · exact ⟨arrSl', getElem?_setElem?_self slots₁ plan.arrLocal arrSl' slots₁' hSet₁, hComp'⟩
  · intro r hr
    have hNeR : kIdx ≠ pack.bodySrc.locals.length + 1 + pack.len + r := fun hEq => by
      have hLt1 : kIdx < pack.bodySrc.locals.length + 1 + pack.len := by
        change pack.bodySrc.locals.length + 1 + idx < pack.bodySrc.locals.length + 1 + pack.len
        exact Nat.add_lt_add_left hIdx _
      have hLe : pack.bodySrc.locals.length + 1 + pack.len ≤ kIdx := by
        rw [hEq]
        exact Nat.le_add_right _ r
      exact nat_lt_irrefl kIdx (Nat.lt_of_lt_of_le hLt1 hLe)
    rw [getElem?_setElem?_ne slots₂ kIdx _ slEl slots₂' hNeR hSet₂]
    exact hLM.2.2.2 r hr

private theorem arrSc_evalArrSliceTypedOps_prefix
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    (expectedTy : MirTy) :
    ∀ (ops : List Operand) (slots₁ slots₂ : List ArrSliceSlot),
      arrSc_PrefixMatch pack slots₁ slots₂ →
      ops.all (operandUsesOnlyBase pack.bodySrc.locals) = true →
      (∃ k : FaultKind,
        evalArrSliceTypedOps pack.bodySrc.locals expectedTy slots₁ ops = .error k ∧
        evalArrSliceTypedOps pack.bodyTgt.locals expectedTy slots₂ ops = .error k) ∨
      (∃ (vals : List Val) (slots₁' slots₂' : List ArrSliceSlot),
        evalArrSliceTypedOps pack.bodySrc.locals expectedTy slots₁ ops = .ok (vals, slots₁') ∧
        evalArrSliceTypedOps pack.bodyTgt.locals expectedTy slots₂ ops = .ok (vals, slots₂') ∧
        vals.length = ops.length ∧
        (∀ v : Val, v ∈ vals → checkVal v expectedTy = true) ∧
        arrSc_PrefixMatch pack slots₁' slots₂' ∧
        slots₂'.length = slots₂.length ∧
        (∀ j : Nat, pack.bodySrc.locals.length ≤ j →
          Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) ∧
        Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
          Trusted.MirSemantics.getElem? slots₁ plan.arrLocal ∧
        Trusted.MirSemantics.getElem? slots₂' plan.arrLocal =
          Trusted.MirSemantics.getElem? slots₂ plan.arrLocal)
  | [], slots₁, slots₂, hPref, _ => by
    refine Or.inr ⟨[], slots₁, slots₂, rfl, rfl, rfl, (fun _ h => nomatch h),
      hPref, rfl, fun _ _ => rfl, rfl, rfl⟩
  | op :: rest, slots₁, slots₂, hPref, hAll => by
    have hAnd := (bool_and_eq_true _ _).mp hAll
    cases arrSc_evalArrSliceTypedOperand_prefix pack hPref expectedTy op hAnd.1 with
    | inl hErr =>
      cases hErr with
      | intro k hk =>
        refine Or.inl ⟨k, ?_, ?_⟩
        · dsimp [evalArrSliceTypedOps]; rw [hk.1]
        · dsimp [evalArrSliceTypedOps]; rw [hk.2]
    | inr hOk =>
      cases hOk with
      | intro v h1 => cases h1 with
      | intro slots₁Mid h2 => cases h2 with
      | intro slots₂Mid hOp =>
        cases arrSc_evalArrSliceTypedOps_prefix pack expectedTy rest slots₁Mid slots₂Mid
            hOp.2.2.2.1 hAnd.2 with
        | inl hErrTail =>
          cases hErrTail with
          | intro k hk =>
            refine Or.inl ⟨k, ?_, ?_⟩
            · dsimp [evalArrSliceTypedOps]; rw [hOp.1]; dsimp; rw [hk.1]
            · dsimp [evalArrSliceTypedOps]; rw [hOp.2.1]; dsimp; rw [hk.2]
        | inr hOkTail =>
          cases hOkTail with
          | intro vs h3 => cases h3 with
          | intro slots₁End h4 => cases h4 with
          | intro slots₂End hTl =>
            refine Or.inr ⟨v :: vs, slots₁End, slots₂End, ?_, ?_, ?_, ?_,
              hTl.2.2.2.2.1, ?_, ?_, ?_, ?_⟩
            · dsimp [evalArrSliceTypedOps]; rw [hOp.1]; dsimp; rw [hTl.1]
            · dsimp [evalArrSliceTypedOps]; rw [hOp.2.1]; dsimp; rw [hTl.2.1]
            · exact congrArg Nat.succ hTl.2.2.1
            · intro w hw
              cases hw with
              | head => exact hOp.2.2.1
              | tail _ hMem => exact hTl.2.2.2.1 w hMem
            · rw [hTl.2.2.2.2.2.1, hOp.2.2.2.2.1]
            · intro j hj
              rw [hTl.2.2.2.2.2.2.1 j hj, hOp.2.2.2.2.2.1 j hj]
            · rw [hTl.2.2.2.2.2.2.2.1, hOp.2.2.2.2.2.2.1]
            · rw [hTl.2.2.2.2.2.2.2.2, hOp.2.2.2.2.2.2.2]

