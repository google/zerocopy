-- Section 3: `lowerBlocksForArrayLoop` Spec & Storage Annotation Properties
-- ============================================================================

private theorem arrSc_lowerBlocksForArrayLoop_length (arrLocal base len : Nat) :
    ∀ (nextExtra : Nat) (bbs : List ArrSliceBlock),
      (lowerBlocksForArrayLoop arrLocal base len nextExtra bbs).1.length = bbs.length
  | _, [] => rfl
  | _, _ :: rest =>
    congrArg Nat.succ
      (arrSc_lowerBlocksForArrayLoop_length arrLocal base len _ rest)

private theorem arrSc_lowerBlocksForArrayLoop_spec (arrLocal base len : Nat) :
    ∀ (bbs : List ArrSliceBlock) (nextExtra idx : Nat) (bb : ArrSliceBlock),
      Trusted.MirSemantics.getElem? bbs idx = some bb →
      ∃ preExtras postExtras : List ArrSliceBlock,
        let termRes := lowerTermForArray arrLocal base len (nextExtra + preExtras.length) bb.terminator
        (lowerBlocksForArrayLoop arrLocal base len nextExtra bbs).2 =
          preExtras ++ termRes.2.2 ++ postExtras ∧
        Trusted.MirSemantics.getElem?
            (lowerBlocksForArrayLoop arrLocal base len nextExtra bbs).1 idx =
          some {
            bb with
            statements := listFlatMap (lowerStmtForArray arrLocal base len) bb.statements ++ termRes.1
            terminator := termRes.2.1
          }
  | [], _, _, _, h => by cases h
  | b :: rest, nextExtra, 0, bb, h => by
    have hEq : b = bb := Option.some.inj h
    rw [← hEq]
    refine ⟨[], (lowerBlocksForArrayLoop arrLocal base len
      (nextExtra + (lowerTermForArray arrLocal base len nextExtra b.terminator).2.2.length) rest).2, ?_⟩
    dsimp [lowerBlocksForArrayLoop]
    exact ⟨rfl, rfl⟩
  | b :: rest, nextExtra, idx + 1, bb, h => by
    let termB := lowerTermForArray arrLocal base len nextExtra b.terminator
    let ih := arrSc_lowerBlocksForArrayLoop_spec arrLocal base len rest
      (nextExtra + termB.2.2.length) idx bb h
    cases ih with
    | intro pre ih1 =>
      cases ih1 with
      | intro post hPair =>
        refine ⟨termB.2.2 ++ pre, post, ?_⟩
        dsimp [lowerBlocksForArrayLoop]
        have hAssoc : nextExtra + termB.2.2.length + pre.length =
            nextExtra + (termB.2.2 ++ pre).length := by
          rw [list_append_length, Nat.add_assoc]
        have hP2 :
            Trusted.MirSemantics.getElem?
                (lowerBlocksForArrayLoop arrLocal base len (nextExtra + termB.2.2.length) rest).1
                idx =
              some {
                bb with
                statements := listFlatMap (lowerStmtForArray arrLocal base len) bb.statements ++
                  (lowerTermForArray arrLocal base len (nextExtra + (termB.2.2 ++ pre).length)
                    bb.terminator).1
                terminator := (lowerTermForArray arrLocal base len
                  (nextExtra + (termB.2.2 ++ pre).length) bb.terminator).2.1
              } := by
          rw [← hAssoc]
          exact hPair.2
        have hP1 := hPair.1
        rw [hAssoc] at hP1
        rw [hP1]
        constructor
        · dsimp [termB]
          rw [← List.append_assoc _ (pre ++ _) post, ← List.append_assoc _ pre _]
        · exact hP2

private theorem arrSc_getElem?_bodyTgt_blocks {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bb : ArrSliceBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb) :
    ∃ extraStart : Nat,
      let base := pack.bodySrc.locals.length
      let termRes := lowerTermForArray plan.arrLocal base pack.len extraStart bb.terminator
      pack.bodySrc.basicBlocks.length ≤ extraStart ∧
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx =
        some {
          bb with
          statements :=
            listFlatMap (lowerStmtForArray plan.arrLocal base pack.len) bb.statements ++ termRes.1
          terminator := termRes.2.1
        } ∧
      (∀ k : Nat, k < termRes.2.2.length →
        Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (extraStart + k) =
          Trusted.MirSemantics.getElem? termRes.2.2 k) := by
  have hSpec := arrSc_lowerBlocksForArrayLoop_spec plan.arrLocal pack.bodySrc.locals.length
    pack.len pack.bodySrc.basicBlocks pack.bodySrc.basicBlocks.length bbIdx bb hBb
  cases hSpec with
  | intro pre hS1 =>
    cases hS1 with
    | intro post hPair =>
      refine ⟨pack.bodySrc.basicBlocks.length + pre.length, ?_⟩
      dsimp
      have hGe : pack.bodySrc.basicBlocks.length ≤ pack.bodySrc.basicBlocks.length + pre.length :=
        Nat.le_add_right _ _
      have hBbs := congrArg ArrSliceBody.basicBlocks pack.hBodyTgt
      refine ⟨hGe, ?_, ?_⟩
      · rw [hBbs]
        have hLt1 : bbIdx < (lowerBlocksForArrayLoop plan.arrLocal pack.bodySrc.locals.length
            pack.len pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).1.length := by
          rw [arrSc_lowerBlocksForArrayLoop_length]
          exact getElem?_some_lt pack.bodySrc.basicBlocks bbIdx bb hBb
        rw [getElem?_append_left _ _ bbIdx hLt1]
        exact hPair.2
      · intro k hk
        rw [hBbs]
        have hL1 : (lowerBlocksForArrayLoop plan.arrLocal pack.bodySrc.locals.length
            pack.len pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).1.length =
            pack.bodySrc.basicBlocks.length :=
          arrSc_lowerBlocksForArrayLoop_length _ _ _ _ _
        have hIdx : pack.bodySrc.basicBlocks.length + pre.length + k =
            (lowerBlocksForArrayLoop plan.arrLocal pack.bodySrc.locals.length
              pack.len pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).1.length +
            (pre.length + k) := by
          rw [hL1, Nat.add_assoc]
        rw [hIdx, getElem?_append_right]
        rw [hPair.1]
        exact arrSc_getElem?_append_middle_add pre _ post k hk

private theorem arrSc_noStorageMarker_mkAssignUse (loc dst : LocalId) (op : Operand) :
    arrSliceStmtHasStorageMarker loc (mkAssignUse dst op) = false := rfl

private theorem arrSc_noStorageMarker_mkLivenessCheckStmt (loc liveLoc : LocalId) :
    arrSliceStmtHasStorageMarker loc (mkLivenessCheckStmt liveLoc) = false := rfl

