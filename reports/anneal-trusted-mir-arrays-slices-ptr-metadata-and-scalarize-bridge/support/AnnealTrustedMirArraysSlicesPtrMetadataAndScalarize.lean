-- Section 8D: Terminator Simulation (`arrSc_term_step_sim`)
-- ============================================================================

private noncomputable def arrSc_FwdTermSim
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    (f₁ f₂ : ArrSliceFrame) (cm : CallerMemory) : Prop :=
  (∀ s₁', evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .step s₁' →
    ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ arrSc_StateRel pack s₁' s₂') ∧
  (∀ out, evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .done out →
    ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.done out)) ∧
  (∀ k, evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .fault k →
    ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.fault k))

private theorem arrSc_reachesPlus_jump_rel
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {slots₁' slots₂' : List ArrSliceSlot} (target : BasicBlockId) {n : Nat}
    (hSame : f₁.defId = plan.defId)
    (hSame₂ : f₂.defId = plan.defId)
    (hReach : ReachesNArrSlice pTgt (n + 1) { frames := [f₂], callerMem := cm }
      { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], callerMem := cm })
    (hLM' : arrSc_LocalMatch pack slots₁' slots₂') :
    ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧
      arrSc_StateRel pack
        { frames := [{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' }], callerMem := cm } s₂' := by
  let s₂' : ArrSliceState :=
    { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], callerMem := cm }
  refine ⟨s₂', ⟨n, hReach⟩, rfl, Or.inl ⟨hSame, hSame₂, rfl, hLM', ?_⟩⟩
  cases Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks target with
  | none => exact True.intro
  | some _ => exact ⟨Nat.zero_le _, rfl⟩

private theorem arrSc_sim_term_one_same
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdx₂ : f₂.stmtIdx = bbTgt.statements.length)
    (hEvalSim :
      (∀ s₁', evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = .step s₁' →
        ∃ target slots₁' slots₂',
          s₁' = { frames := [{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' }], callerMem := cm } ∧
          evalArrSliceTerm pack.bodyTgt bbTgt f₂ cm = jumpArrSliceBlock f₂ cm slots₂' target ∧
          arrSc_LocalMatch pack slots₁' slots₂') ∧
      (∀ out, evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = .done out →
        evalArrSliceTerm pack.bodyTgt bbTgt f₂ cm = .done out) ∧
      (∀ k, evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = .fault k →
        evalArrSliceTerm pack.bodyTgt bbTgt f₂ cm = .fault k)) :
    arrSc_FwdTermSim pack f₁ f₂ cm := by
  have hS1 := arrSc_evalStepArrSlice_at_term pSrc pack.bodySrc f₁ cm bbSrc hBodySrc hBbSrc hIdx₁
  have hS2 := arrSc_evalStepArrSlice_at_term pTgt pack.bodyTgt f₂ cm bbTgt hBodyTgt hBbTgt hIdx₂
  dsimp [arrSc_FwdTermSim]
  rw [hS1]
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    cases hEvalSim.1 s₁' hStep with | intro target hR1 =>
    cases hR1 with | intro slots₁' hR2 =>
    cases hR2 with | intro slots₂' hR3 =>
    rw [hR3.1]
    have hReach1 : ReachesNArrSlice pTgt 1 { frames := [f₂], callerMem := cm }
        { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], callerMem := cm } := by
      apply arrSc_reachesNArrSlice_one_step
      rw [hS2]
      exact hR3.2.1
    exact arrSc_reachesPlus_jump_rel pack target hSame hSame₂ hReach1 hR3.2.2
  · intro out hDone
    exact arrSc_reachesArrSlice_of_reach_done (ReachesNArrSlice.zero _)
      (by rw [hS2]; exact hEvalSim.2.1 out hDone)
  · intro k hFault
    exact arrSc_reachesArrSlice_of_reach_fault (ReachesNArrSlice.zero _)
      (by rw [hS2]; exact hEvalSim.2.2 k hFault)

private theorem arrSc_sim_term_boundsCheckArray
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (arrLocal : LocalId) (idxOp : Operand) (inBoundsBb panicBb : BasicBlockId)
    (extraStart : Nat)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hTermSrc : bbSrc.terminator = .boundsCheckArray arrLocal idxOp inBoundsBb panicBb)
    (hTermTgt : bbTgt.terminator =
      (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).2.1)
    (hBnd : arrSliceTermLocalsInBounds pack.bodySrc.locals.length bbSrc.terminator = true)
    (hChk : checkTermForArray pack.bodySrc.locals plan.arrLocal pack.elemTy bbSrc.terminator = true)
    (hGetPre : ∀ j : Nat,
      j < (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem?
          (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1 j)
    (hLenPre : f₂.stmtIdx +
      (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1.length =
      bbTgt.statements.length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdTermSim pack f₁ f₂ cm := by
  rw [hTermSrc] at hBnd hChk
  dsimp [arrSliceTermLocalsInBounds] at hBnd
  dsimp [checkTermForArray] at hChk
  have hLtA := nat_blt_lt ((bool_and_eq_true _ _).mp hBnd).1
  cases s4c_arrSc_nat_eq_or_ne arrLocal plan.arrLocal with
  | inr hNeArr =>
    have hBeqF : Nat.beq arrLocal plan.arrLocal = false := nat_beq_false hNeArr
    have hPreNil : (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart
        bbSrc.terminator).1 = [] := by
      rw [hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqF]; rfl
    have hIdx₂ : f₂.stmtIdx = bbTgt.statements.length := by
      rw [← hLenPre, hPreNil]; rfl
    have hTgtSame : bbTgt.terminator = .boundsCheckArray arrLocal idxOp inBoundsBb panicBb := by
      rw [hTermTgt, hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqF]; rfl
    have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtA hNeArr
    have hSlEq := hLM.1.2 arrLocal hLtA hNeArr
    apply arrSc_sim_term_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbSrc hBbTgt hIdx₁ hIdx₂
    dsimp [evalArrSliceTerm]
    rw [hTermSrc, hTgtSame]; dsimp
    rw [hDeclEq, hSlEq]
    cases hDA : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
    | none =>
      refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
    | some dA =>
      cases dA with
      | base _ | sliceView _ =>
        refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
      | array _ len =>
        cases hSA : Trusted.MirSemantics.getElem? f₁.locals arrLocal with
        | none => refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
        | some slA =>
          cases slA with
          | baseSlot _ | arrDead | sliceDead | liveSlice _ =>
            refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
          | liveArray _ =>
            dsimp
            cases arrSc_evalUsizeOperand_prefix pack hLM.1 idxOp hChk with
            | inl hErr =>
              cases hErr with
              | intro _ hk =>
                rw [hk.1, hk.2]
                refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
            | inr hOk =>
              cases hOk with
              | intro idx h1 => cases h1 with
              | intro slots₁' h2 => cases h2 with
              | intro slots₂' hU =>
                rw [hU.1, hU.2.1]
                dsimp
                have hLM' := arrSc_localMatch_lift_prefix pack hLM
                  hU.2.2.2.1 hU.2.2.2.2.1 hU.2.2.2.2.2.1 hU.2.2.2.2.2.2.1
                refine ⟨?_, fun _ h => (by cases h), fun _ h => (by cases h)⟩
                intro s₁' hs
                have hsEq := StepResult.step.inj hs
                exact ⟨if Nat.blt idx len then inBoundsBb else panicBb, slots₁', slots₂',
                  hsEq.symm, rfl, hLM'⟩
  | inl hEqArr =>
    have hBeqT : Nat.beq arrLocal plan.arrLocal = true := nat_beq_true hEqArr
    let base := pack.bodySrc.locals.length
    let idxScr := base + 1 + pack.len + 1
    let condScr := base + 1 + pack.len + 2
    have hPreEq : (lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator).1 =
        [mkLivenessCheckStmt base, mkAssignUse idxScr idxOp,
         mkLtUsize condScr (.move { localId := idxScr, projection := [] }) (usizeConst pack.len)] := by
      rw [hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqT]; rfl
    have hPreLen : (lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator).1.length = 3 := by
      rw [hPreEq]; rfl
    have hIdx3 : f₂.stmtIdx + 3 = bbTgt.statements.length := by
      rw [← hPreLen]; exact hLenPre
    have hGet0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (mkLivenessCheckStmt base) := by
      have h0 := hGetPre 0 (by rw [hPreLen]; exact Nat.zero_lt_succ 2)
      rw [Nat.add_zero, hPreEq] at h0; exact h0
    have hGet1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
        some (mkAssignUse idxScr idxOp) := by
      have h1 := hGetPre 1 (by rw [hPreLen]; exact Nat.succ_lt_succ (Nat.zero_lt_succ 1))
      rw [hPreEq] at h1; exact h1
    have hGet2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
        some (mkLtUsize condScr (.move { localId := idxScr, projection := [] }) (usizeConst pack.len)) := by
      have h2 := hGetPre 2 (by rw [hPreLen]; exact Nat.lt_succ_self 2)
      rw [hPreEq] at h2; exact h2
    have hTgtSwitch : bbTgt.terminator = .baseTerm (.switchInt
        (.move { localId := condScr, projection := [] })
        { branches := [(BitVec.ofNat 128 1, inBoundsBb)], otherwise := panicBb }) := by
      rw [hTermTgt, hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqT]; rfl
    have hEvSrc : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
        evalArrSliceTerm pack.bodySrc bbSrc f₁ cm :=
      arrSc_evalStepArrSlice_at_term pSrc pack.bodySrc f₁ cm bbSrc hBodySrc hBbSrc hIdx₁
    have hDeclLive := arrSc_getElem?_bodyTgt_locals_liveLoc pack
    have hDeclIdx := arrSc_getElem?_bodyTgt_locals_idxScr pack
    have hDeclCond := arrSc_getElem?_bodyTgt_locals_condScr pack
    cases hLM.2.2.1 with
    | intro arrSl hArr =>
      cases arrSl with
      | baseSlot _ | sliceDead | liveSlice _ => exact False.elim hArr.2
      | arrDead =>
        have hDead : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
            .fault .undefined :=
          arrSc_step_mkLivenessCheckStmt_dead pTgt pack.bodyTgt bbTgt f₂ cm base
            hBodyTgt hBbTgt hGet0 hDeclLive hArr.2.1
        refine ⟨?_, ?_, ?_⟩
        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
          rw [hTermSrc] at h; dsimp at h
          rw [hEqArr, pack.hArrDecl, hArr.1] at h; cases h
        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
          rw [hTermSrc] at h; dsimp at h
          rw [hEqArr, pack.hArrDecl, hArr.1] at h; cases h
        · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
          rw [hTermSrc] at h; dsimp at h
          rw [hEqArr, pack.hArrDecl, hArr.1] at h
          have hEqK := StepResult.fault.inj h; rw [← hEqK]
          exact arrSc_reachesArrSlice_of_reach_fault (ReachesNArrSlice.zero _) hDead
      | liveArray elems =>
        cases arrSc_step_mkLivenessCheckStmt_live pTgt pack.bodyTgt bbTgt f₂ cm base (some .unit)
            hBodyTgt hBbTgt hGet0 hDeclLive hArr.2.2.1 with
        | intro slots₂Live hLiveStep =>
          let fLive : ArrSliceFrame :=
            { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂Live }
          have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
              .step { frames := [fLive], callerMem := cm } := by
            rw [hLiveStep.2]; rfl
          have hLMLive := s4c_arrSc_localMatch_set_liveLoc_unit pack hLM hArr.2.2.1 hLiveStep.1
          cases arrSc_evalArrSliceTypedOperand_prefix pack hLMLive.1 usizeTy idxOp hChk with
          | inl hErr =>
            cases hErr with
            | intro err hk =>
              have hStepErr := arrSc_step_mkAssignUse_typedOp_err pTgt pack.bodyTgt bbTgt fLive cm
                idxScr usizeTy idxOp err hBodyTgt hBbTgt hGet1 hDeclIdx hk.2
              refine ⟨?_, ?_, ?_⟩
              · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                rw [hTermSrc] at h; dsimp at h
                rw [hEqArr, pack.hArrDecl, hArr.1] at h; dsimp [evalUsizeOperand] at h
                rw [hk.1] at h; cases h
              · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                rw [hTermSrc] at h; dsimp at h
                rw [hEqArr, pack.hArrDecl, hArr.1] at h; dsimp [evalUsizeOperand] at h
                rw [hk.1] at h; cases h
              · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                rw [hTermSrc] at h; dsimp at h
                rw [hEqArr, pack.hArrDecl, hArr.1] at h; dsimp [evalUsizeOperand] at h
                rw [hk.1] at h
                have hEqK := StepResult.fault.inj h; rw [← hEqK]
                exact arrSc_reachesArrSlice_of_reach_fault
                  (arrSc_reachesNArrSlice_one_step hStep0) hStepErr
          | inr hOk =>
            cases hOk with
            | intro vIdx h1 => cases h1 with
            | intro slots₁Mid h2 => cases h2 with
            | intro slots₂Mid hOp =>
              cases (arrSc_checkVal_usize_iff vIdx).mp hOp.2.2.1 with
              | intro sv hsv =>
                let idx := sv.bits.toNat
                have hIdxMax : idx < maxUsize := hsv.2.2.2.2
                have hSvEq : sv = ⟨.isize, false, BitVec.ofNat 128 idx⟩ :=
                  arrSc_scalarVal_eq_ofNat sv hsv.2.1 hsv.2.2.1 hsv.2.2.2.1
                have hVIdxEq : vIdx = .scalar ⟨.isize, false, BitVec.ofNat 128 idx⟩ := by
                  rw [hsv.1, hSvEq]
                have hUsizeSrc : evalUsizeOperand pack.bodySrc.locals f₁.locals idxOp =
                    .ok (idx, slots₁Mid) := by
                  dsimp [evalUsizeOperand]
                  rw [hOp.1, hsv.1]
                have hLMMid := arrSc_localMatch_lift_prefix pack hLMLive
                  hOp.2.2.2.1 hOp.2.2.2.2.1 hOp.2.2.2.2.2.1 hOp.2.2.2.2.2.2.1
                have hR1 : 1 < 4 + pack.len := by
                  rw [Nat.add_comm 4 pack.len]
                  exact Nat.lt_of_lt_of_le (Nat.succ_lt_succ (Nat.zero_lt_succ 2)) (Nat.le_add_left 4 pack.len)
                cases hLMMid.2.2.2 1 hR1 with
                | intro ovIdx hOvIdx =>
                  have hLtIdxScr : idxScr < slots₂Mid.length := getElem?_some_lt slots₂Mid idxScr _ hOvIdx
                  cases hSetIdx : setElem? slots₂Mid idxScr (.baseSlot (.live (some vIdx))) with
                  | none =>
                    cases lt_setElem?_some slots₂Mid idxScr _ hLtIdxScr with
                    | intro _ hh => rw [hh] at hSetIdx; cases hSetIdx
                  | some slots₂Idx =>
                    have hStep1 := arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt bbTgt fLive cm
                      idxScr usizeTy idxOp vIdx slots₂Mid slots₂Idx hBodyTgt hBbTgt hGet1 hDeclIdx
                      hOp.2.1 ovIdx hOvIdx hSetIdx
                    let fIdx : ArrSliceFrame :=
                      { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂Idx }
                    have hStep1' : evalStepArrSlice pTgt 0 { frames := [fLive], callerMem := cm } =
                        .step { frames := [fIdx], callerMem := cm } := by
                      rw [hStep1]; rfl
                    have hLMIdx := arrSc_localMatch_set_scr pack hLMMid hR1 hSetIdx
                    have hLiveIdx : Trusted.MirSemantics.getElem? slots₂Idx idxScr =
                        some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 idx⟩)))) := by
                      rw [← hVIdxEq]
                      exact getElem?_setElem?_self slots₂Mid idxScr _ slots₂Idx hSetIdx
                    have hR2 : 2 < 4 + pack.len := by
                      rw [Nat.add_comm 4 pack.len]
                      exact Nat.lt_of_lt_of_le (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 1)))
                        (Nat.le_add_left 4 pack.len)
                    cases hLMIdx.2.2.2 2 hR2 with
                    | intro ovCond hOvCond =>
                      have hNeCondIdx : condScr ≠ idxScr := fun h => by
                        have hLt : idxScr < condScr := by
                          change base + 1 + pack.len + 1 < base + 1 + pack.len + 2
                          exact Nat.lt_succ_self _
                        rw [h] at hLt; exact nat_lt_irrefl _ hLt
                      cases arrSc_step_mkLtUsize_move_const pTgt pack.bodyTgt bbTgt fIdx cm
                          condScr idxScr idx pack.len hNeCondIdx hIdxMax (arrSc_len_lt_maxUsize pack)
                          hBodyTgt hBbTgt hGet2 hDeclCond hDeclIdx hLiveIdx ovCond hOvCond with
                      | intro slots₂AfterMove hStep2Ex => cases hStep2Ex with
                      | intro slots₂Cond hStep2 =>
                        let fCond : ArrSliceFrame :=
                          { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂Cond }
                        have hStep2' : evalStepArrSlice pTgt 0 { frames := [fIdx], callerMem := cm } =
                            .step { frames := [fCond], callerMem := cm } := by
                          rw [hStep2.2.2]; rfl
                        have hMoveIdx : setElem? slots₂Idx (base + 1 + pack.len + 1)
                            (.baseSlot (.live (initElemOptVal usizeTy))) = some slots₂AfterMove := by
                          rw [← arrSc_liveUninitSlot_eq usizeTy]; exact hStep2.1
                        have hLMMove := arrSc_localMatch_set_scr pack hLMIdx hR1 hMoveIdx
                        have hLMCond := arrSc_localMatch_set_scr pack hLMMove hR2 hStep2.2.1
                        have hLiveCond : Trusted.MirSemantics.getElem? slots₂Cond condScr =
                            some (.baseSlot (.live (some (.bool (Nat.blt idx pack.len))))) :=
                          getElem?_setElem?_self slots₂AfterMove condScr _ slots₂Cond hStep2.2.1
                        have hLtCond : condScr < slots₂Cond.length :=
                          getElem?_some_lt slots₂Cond condScr _ hLiveCond
                        cases hMoveCond : setElem? slots₂Cond condScr (.baseSlot (liveUninitSlot .bool)) with
                        | none =>
                          cases lt_setElem?_some slots₂Cond condScr _ hLtCond with
                          | intro _ hh => rw [hh] at hMoveCond; cases hMoveCond
                        | some slots₂' =>
                          have hStep3 := arrSc_step_switchInt_move_bool pTgt pack.bodyTgt bbTgt fCond cm
                            condScr (Nat.blt idx pack.len) inBoundsBb panicBb slots₂'
                            hBodyTgt hBbTgt hIdx3 hTgtSwitch hDeclCond hLiveCond hMoveCond
                          have hMoveCond' : setElem? slots₂Cond (base + 1 + pack.len + 2)
                              (.baseSlot (.live (initElemOptVal .bool))) = some slots₂' := by
                            rw [← arrSc_liveUninitSlot_eq .bool]; exact hMoveCond
                          have hLM' := arrSc_localMatch_set_scr pack hLMCond hR2 hMoveCond'
                          have hReach3 : ReachesNArrSlice pTgt 3 { frames := [f₂], callerMem := cm }
                              { frames := [fCond], callerMem := cm } :=
                            reachesNArrSlice_trans
                              (arrSc_reachesNArrSlice_succ_head hStep0 (arrSc_reachesNArrSlice_one_step hStep1'))
                              (arrSc_reachesNArrSlice_one_step hStep2')
                          let nextTargetBb := if Nat.blt idx pack.len then inBoundsBb else panicBb
                          have hReach4 : ReachesNArrSlice pTgt 4 { frames := [f₂], callerMem := cm }
                              { frames := [{ f₂ with blockIdx := nextTargetBb, stmtIdx := 0, locals := slots₂' }],
                                callerMem := cm } :=
                            reachesNArrSlice_trans hReach3 (arrSc_reachesNArrSlice_one_step hStep3)
                          refine ⟨?_, ?_, ?_⟩
                          · intro s₁' h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                            rw [hTermSrc] at h; dsimp at h
                            rw [hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                            rw [hUsizeSrc] at h
                            have hsEq := StepResult.step.inj h; rw [← hsEq]
                            exact arrSc_reachesPlus_jump_rel pack nextTargetBb hSame hSame₂ hReach4 hLM'
                          · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                            rw [hTermSrc] at h; dsimp at h
                            rw [hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                            rw [hUsizeSrc] at h; cases h
                          · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                            rw [hTermSrc] at h; dsimp at h
                            rw [hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                            rw [hUsizeSrc] at h; cases h

private theorem arrSc_sim_term_readArrayElem
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (dst arrLocal : LocalId) (idxOp : Operand) (nextBb : BasicBlockId)
    (extraStart : Nat)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hTermSrc : bbSrc.terminator = .readArrayElem dst arrLocal idxOp nextBb)
    (hTermTgt : bbTgt.terminator =
      (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).2.1)
    (hBnd : arrSliceTermLocalsInBounds pack.bodySrc.locals.length bbSrc.terminator = true)
    (hChk : checkTermForArray pack.bodySrc.locals plan.arrLocal pack.elemTy bbSrc.terminator = true)
    (hGetPre : ∀ j : Nat,
      j < (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem?
          (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1 j)
    (hLenPre : f₂.stmtIdx +
      (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1.length =
      bbTgt.statements.length)
    (hExtra : ∀ k : Nat,
      k < (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).2.2.length →
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (extraStart + k) =
        Trusted.MirSemantics.getElem?
          (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).2.2 k)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdTermSim pack f₁ f₂ cm := by
  rw [hTermSrc] at hBnd hChk
  dsimp [arrSliceTermLocalsInBounds] at hBnd
  dsimp [checkTermForArray] at hChk
  have hBndAnd := (bool_and_eq_true _ _).mp hBnd
  have hBnd1 := (bool_and_eq_true _ _).mp hBndAnd.1
  have hLtDst := nat_blt_lt hBnd1.1
  have hLtArr := nat_blt_lt hBnd1.2
  have hChkAnd := (bool_and_eq_true _ _).mp hChk
  have hChkOp := hChkAnd.1
  cases s4c_arrSc_nat_eq_or_ne arrLocal plan.arrLocal with
  | inr hNeArr =>
    have hBeqF : Nat.beq arrLocal plan.arrLocal = false := nat_beq_false hNeArr
    have hChkR := hChkAnd.2
    rw [hBeqF] at hChkR
    have hNeDst : dst ≠ plan.arrLocal := fun h => by
      rw [h, nat_beq_refl] at hChkR; cases hChkR
    have hPreNil : (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart
        bbSrc.terminator).1 = [] := by
      rw [hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqF]; rfl
    have hIdx₂ : f₂.stmtIdx = bbTgt.statements.length := by rw [← hLenPre, hPreNil]; rfl
    have hTgtSame : bbTgt.terminator = .readArrayElem dst arrLocal idxOp nextBb := by
      rw [hTermTgt, hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqF]; rfl
    have hDeclDstEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtDst hNeDst
    have hDeclArrEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtArr hNeArr
    apply arrSc_sim_term_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbSrc hBbTgt hIdx₁ hIdx₂
    dsimp [evalArrSliceTerm]
    rw [hTermSrc, hTgtSame]
    dsimp
    cases arrSc_evalUsizeOperand_prefix pack hLM.1 idxOp hChkOp with
    | inl hErr =>
      cases hErr with
      | intro _ hk =>
        rw [hk.1, hk.2]
        refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
    | inr hOk =>
      cases hOk with
      | intro idx h1 => cases h1 with
      | intro slots₁Mid h2 => cases h2 with
      | intro slots₂Mid hU =>
        rw [hU.1, hU.2.1]
        dsimp
        have hLMMid := arrSc_localMatch_lift_prefix pack hLM
          hU.2.2.2.1 hU.2.2.2.2.1 hU.2.2.2.2.2.1 hU.2.2.2.2.2.2.1
        dsimp [evalReadArrayAtIdx]
        rw [hDeclDstEq, hDeclArrEq, hLMMid.1.2 arrLocal hLtArr hNeArr]
        cases hDD : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with
        | none => refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
        | some dDst =>
          cases dDst with
          | array _ _ | sliceView _ =>
            refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
          | base dstTy =>
            cases hDA : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
