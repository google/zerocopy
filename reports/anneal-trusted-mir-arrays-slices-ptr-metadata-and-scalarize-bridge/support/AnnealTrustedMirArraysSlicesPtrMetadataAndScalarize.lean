                    | error _ => rw [hWr] at h; cases h
                    | ok slots' => rw [hWr] at h; exact stepStmtNext_preserves_defId f cm slots' h

private theorem evalArrSliceTerm_preserves_defId (body : ArrSliceBody) (bb : ArrSliceBlock)
    (f : ArrSliceFrame) (cm : CallerMemory) {s' : ArrSliceState}
    (h : evalArrSliceTerm body bb f cm = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId := by
  dsimp [evalArrSliceTerm] at h
  cases hT : bb.terminator with
  | baseTerm bt =>
    cases bt with
    | goto target =>
      rw [hT] at h; dsimp at h; exact jumpArrSliceBlock_preserves_defId f cm f.locals target h
    | return_ =>
      rw [hT] at h; dsimp at h
      cases hCl : bb.cleanup with
      | true => rw [hCl] at h; cases h
      | false =>
        rw [hCl] at h; dsimp at h
        cases hS0 : Trusted.MirSemantics.getElem? f.locals 0 with
        | none => rw [hS0] at h; cases h
        | some sl =>
          cases sl with
          | arrDead => rw [hS0] at h; cases h
          | liveArray _ => rw [hS0] at h; cases h
          | sliceDead => rw [hS0] at h; cases h
          | liveSlice _ => rw [hS0] at h; cases h
          | baseSlot b =>
            cases b with
            | dead => rw [hS0] at h; cases h
            | live ov => cases ov <;> (rw [hS0] at h; cases h)
    | unreachable => rw [hT] at h; cases h
    | unwindResume => rw [hT] at h; cases h
    | assert _ _ _ _ _ => rw [hT] at h; cases h
    | call _ _ _ _ _ => rw [hT] at h; cases h
    | unsupported => rw [hT] at h; cases h
    | switchInt discr targets =>
      rw [hT] at h; dsimp at h
      cases hP : evalArrSlicePrimitiveOperand body.locals f.locals discr with
      | error _ => rw [hP] at h; cases h
      | ok p =>
        rw [hP] at h; dsimp at h
        cases hV : p.1 with
        | scalar sv =>
          rw [hV] at h; dsimp at h
          cases hSw : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
          | error _ => rw [hSw] at h; cases h
          | ok target => rw [hSw] at h; exact jumpArrSliceBlock_preserves_defId f cm p.2 target h
        | bool b =>
          rw [hV] at h; dsimp at h
          cases hSw : evalBoolSwitchBranches b targets.otherwise targets.branches with
          | error _ => rw [hSw] at h; cases h
          | ok target => rw [hSw] at h; exact jumpArrSliceBlock_preserves_defId f cm p.2 target h
        | ptr _ => rw [hV] at h; cases h
        | tuple _ => rw [hV] at h; cases h
        | enumVal _ _ => rw [hV] at h; cases h
        | bytes _ => rw [hV] at h; cases h
        | unit => rw [hV] at h; cases h
  | sliceLenCall dst sLoc target =>
    rw [hT] at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at h; cases h
    | some d1 =>
      cases d1 with
      | array _ _ => rw [hD] at h; cases h
      | sliceView _ => rw [hD] at h; cases h
      | base dstTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hD, hS] at h; cases h
        | some d2 =>
          cases d2 with
          | base _ => rw [hD, hS] at h; cases h
          | array _ _ => rw [hD, hS] at h; cases h
          | sliceView _ =>
            cases hSl : Trusted.MirSemantics.getElem? f.locals sLoc with
            | none => rw [hD, hS, hSl] at h; cases h
            | some sliceSl =>
              rw [hD, hS, hSl] at h; dsimp at h
              cases hTy : !(MirTy.beq dstTy usizeTy) with
              | true => rw [hTy] at h; cases h
              | false =>
                rw [hTy] at h; dsimp at h
                cases sliceSl with
                | baseSlot _ => cases h
                | arrDead => cases h
                | liveArray _ => cases h
                | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hWr : writeArrSliceBasePlace f.locals dst dstTy (.scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩) with
                    | error _ => rw [hWr] at h; cases h
                    | ok slots' => rw [hWr] at h; exact jumpArrSliceBlock_preserves_defId f cm slots' target h
  | boundsCheckArray arrLocal idxOp inBb pBb =>
    rw [hT] at h; dsimp at h
    cases hA : Trusted.MirSemantics.getElem? body.locals arrLocal with
    | none => rw [hA] at h; cases h
    | some d =>
      cases d with
      | base _ => rw [hA] at h; cases h
      | sliceView _ => rw [hA] at h; cases h
      | array _ len =>
        cases hS : Trusted.MirSemantics.getElem? f.locals arrLocal with
        | none => rw [hA, hS] at h; cases h
        | some sl =>
          cases sl with
          | baseSlot _ => rw [hA, hS] at h; cases h
          | arrDead => rw [hA, hS] at h; cases h
          | sliceDead => rw [hA, hS] at h; cases h
          | liveSlice _ => rw [hA, hS] at h; cases h
          | liveArray _ =>
            rw [hA, hS] at h; dsimp at h
            cases hU : evalUsizeOperand body.locals f.locals idxOp with
            | error _ => rw [hU] at h; cases h
            | ok p => rw [hU] at h; exact jumpArrSliceBlock_preserves_defId f cm p.2 _ h
  | boundsCheckSlice sLoc idxOp inBb pBb =>
    rw [hT] at h; dsimp at h
    cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
    | none => rw [hS] at h; cases h
    | some d =>
      cases d with
      | base _ => rw [hS] at h; cases h
      | array _ _ => rw [hS] at h; cases h
      | sliceView _ =>
        cases hSl : Trusted.MirSemantics.getElem? f.locals sLoc with
        | none => rw [hS, hSl] at h; cases h
        | some sl =>
          cases sl with
          | baseSlot _ => rw [hS, hSl] at h; cases h
          | arrDead => rw [hS, hSl] at h; cases h
          | liveArray _ => rw [hS, hSl] at h; cases h
          | sliceDead => rw [hS, hSl] at h; cases h
          | liveSlice osv =>
            cases osv with
            | none => rw [hS, hSl] at h; cases h
            | some sv =>
              rw [hS, hSl] at h; dsimp at h
              cases hU : evalUsizeOperand body.locals f.locals idxOp with
              | error _ => rw [hU] at h; cases h
              | ok p => rw [hU] at h; exact jumpArrSliceBlock_preserves_defId f cm p.2 _ h
  | readArrayElem dst arrLocal idxOp nextBb =>
    rw [hT] at h; dsimp at h
    cases hU : evalUsizeOperand body.locals f.locals idxOp with
    | error _ => rw [hU] at h; cases h
    | ok p => rw [hU] at h; exact evalReadArrayAtIdx_preserves_defId body f cm p.2 dst arrLocal p.1 nextBb h
  | writeArrayElem arrLocal idxOp valOp nextBb =>
    rw [hT] at h; dsimp at h
    cases hA : Trusted.MirSemantics.getElem? body.locals arrLocal with
    | none => rw [hA] at h; cases h
    | some d =>
      cases d with
      | base _ => rw [hA] at h; cases h
      | sliceView _ => rw [hA] at h; cases h
      | array elemTy len =>
        rw [hA] at h; dsimp at h
        cases hU : evalUsizeOperand body.locals f.locals idxOp with
        | error _ => rw [hU] at h; cases h
        | ok p =>
          rw [hU] at h; dsimp at h
          cases hT2 : evalArrSliceTypedOperand body.locals p.2 elemTy valOp with
          | error _ => rw [hT2] at h; cases h
          | ok q =>
            rw [hT2] at h; dsimp at h
            cases hSl : Trusted.MirSemantics.getElem? q.2 arrLocal with
            | none => rw [hSl] at h; cases h
            | some sl =>
              cases sl with
              | baseSlot _ => rw [hSl] at h; cases h
              | sliceDead => rw [hSl] at h; cases h
              | liveSlice _ => rw [hSl] at h; cases h
              | arrDead => rw [hSl] at h; cases h
              | liveArray elems =>
                rw [hSl] at h; dsimp at h
                cases hLt : !Nat.blt p.1 len with
                | true => rw [hLt] at h; cases h
                | false =>
                  rw [hLt] at h; dsimp at h
                  cases hEl : setElem? elems p.1 (some q.1) with
                  | none => rw [hEl] at h; cases h
                  | some elems' =>
                    rw [hEl] at h; dsimp at h
                    cases hSet : setElem? q.2 arrLocal (.liveArray elems') with
                    | none => rw [hSet] at h; cases h
                    | some slots' => rw [hSet] at h; exact jumpArrSliceBlock_preserves_defId f cm slots' nextBb h
  | readSliceElem dst sLoc idxOp nextBb =>
    rw [hT] at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at h; cases h
    | some d1 =>
      cases d1 with
      | array _ _ => rw [hD] at h; cases h
      | sliceView _ => rw [hD] at h; cases h
      | base dstTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hD, hS] at h; cases h
        | some d2 =>
          cases d2 with
          | base _ => rw [hD, hS] at h; cases h
          | array _ _ => rw [hD, hS] at h; cases h
          | sliceView elemTy =>
            cases hSl : Trusted.MirSemantics.getElem? f.locals sLoc with
            | none => rw [hD, hS, hSl] at h; cases h
            | some sliceSl =>
              rw [hD, hS, hSl] at h; dsimp at h
              cases hTy : !(MirTy.beq dstTy elemTy) with
              | true => rw [hTy] at h; cases h
              | false =>
                rw [hTy] at h; dsimp at h
                cases sliceSl with
                | baseSlot _ => cases h
                | arrDead => cases h
                | liveArray _ => cases h
                | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hU : evalUsizeOperand body.locals f.locals idxOp with
                    | error _ => rw [hU] at h; cases h
                    | ok p =>
                      rw [hU] at h; dsimp at h
                      cases hLt : !Nat.blt p.1 sv.len with
                      | true => rw [hLt] at h; cases h
                      | false =>
                        rw [hLt] at h; dsimp at h
                        cases hBk : sv.backing with
                        | dangling => rw [hBk] at h; cases h
                        | arrayLocal arrLocal =>
                          rw [hBk] at h; dsimp at h
                          cases hOob : !Nat.blt (sv.start + p.1) maxUsize with
                          | true => rw [hOob] at h; cases h
                          | false =>
                            rw [hOob] at h; dsimp at h
                            exact evalReadArrayAtIdx_preserves_defId body f cm p.2 dst arrLocal (sv.start + p.1) nextBb h
  | readSliceConst dst sLoc offset minLen fromEnd nextBb =>
    rw [hT] at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at h; cases h
    | some d1 =>
      cases d1 with
      | array _ _ => rw [hD] at h; cases h
      | sliceView _ => rw [hD] at h; cases h
      | base dstTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hD, hS] at h; cases h
        | some d2 =>
          cases d2 with
          | base _ => rw [hD, hS] at h; cases h
          | array _ _ => rw [hD, hS] at h; cases h
          | sliceView elemTy =>
            cases hSl : Trusted.MirSemantics.getElem? f.locals sLoc with
            | none => rw [hD, hS, hSl] at h; cases h
            | some sliceSl =>
              rw [hD, hS, hSl] at h; dsimp at h
              cases hCond : (!(MirTy.beq dstTy elemTy) || !Nat.blt offset maxUsize || !Nat.blt minLen maxUsize) with
              | true => rw [hCond] at h; cases h
              | false =>
                rw [hCond] at h; dsimp at h
                cases sliceSl with
                | baseSlot _ => cases h
                | arrDead => cases h
                | liveArray _ => cases h
                | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hRel : evalSliceConstRelIdx sv.len offset minLen fromEnd with
                    | error _ => rw [hRel] at h; cases h
                    | ok relIdx =>
                      rw [hRel] at h; dsimp at h
                      cases hBk : sv.backing with
                      | dangling => rw [hBk] at h; cases h
                      | arrayLocal arrLocal =>
                        rw [hBk] at h; dsimp at h
                        cases hOob : !Nat.blt (sv.start + relIdx) maxUsize with
                        | true => rw [hOob] at h; cases h
                        | false =>
                          rw [hOob] at h; dsimp at h
                          exact evalReadArrayAtIdx_preserves_defId body f cm f.locals dst arrLocal (sv.start + relIdx) nextBb h

private theorem evalStepArrSlice_preserves_defId (p : ArrSliceProgram) (f : ArrSliceFrame)
    (cm : CallerMemory) {s' : ArrSliceState}
    (h : evalStepArrSlice p 0 { frames := [f], callerMem := cm } = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId := by
  change (match Trusted.MirSemantics.getElem? p.bodies f.defId with
    | none => StepResult.fault FaultKind.unsupported
    | some body =>
      match Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
      | none => StepResult.fault FaultKind.unsupported
      | some bb =>
        match Trusted.MirSemantics.getElem? bb.statements f.stmtIdx with
        | some stmt => evalArrSliceStmt body f cm stmt
        | none => if Nat.beq f.stmtIdx bb.statements.length then evalArrSliceTerm body bb f cm else StepResult.fault FaultKind.unsupported) = .step s' at h
  cases hB : Trusted.MirSemantics.getElem? p.bodies f.defId with
  | none => rw [hB] at h; cases h
  | some body =>
    rw [hB] at h; dsimp at h
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
    | none => rw [hBb] at h; cases h
    | some bb =>
      rw [hBb] at h; dsimp at h
      cases hSt : Trusted.MirSemantics.getElem? bb.statements f.stmtIdx with
      | some stmt => rw [hSt] at h; exact evalArrSliceStmt_preserves_defId body f cm stmt h
      | none =>
        rw [hSt] at h; dsimp at h
        cases hEq : Nat.beq f.stmtIdx bb.statements.length with
        | false => rw [hEq] at h; cases h
        | true => rw [hEq] at h; exact evalArrSliceTerm_preserves_defId body bb f cm h

private theorem scalarize_step_sim
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {s₁ s₂ : ArrSliceState}
    (hRel : SliceStateRel pack s₁ s₂) :
    (∀ s₁' : ArrSliceState, evalStepArrSlice pSrc 0 s₁ = .step s₁' →
      (SliceStateRel pack s₁' s₂ ∧ (0 : Nat) < 0) ∨
      (∃ s₂' : ArrSliceState, ReachesPlusArrSlice pTgt s₂ s₂' ∧ SliceStateRel pack s₁' s₂')) ∧
    (∀ out : TerminalOut, evalStepArrSlice pSrc 0 s₁ = .done out →
      ∃ s₂' : ArrSliceState, ReachesArrSlice pTgt s₂ s₂' ∧ StepArrSlice pTgt s₂' (.done out)) ∧
    (∀ k : FaultKind, evalStepArrSlice pSrc 0 s₁ = StepResult.fault k →
      ∃ s₂' : ArrSliceState, ReachesArrSlice pTgt s₂ s₂' ∧ StepArrSlice pTgt s₂' (StepResult.fault k)) := by
  cases s₁ with | mk fs₁ cm₁ =>
  cases s₂ with | mk fs₂ cm₂ =>
  have hCm : cm₂ = cm₁ := hRel.1
  rw [hCm]
  have hFsRel := hRel.2
  dsimp at hFsRel
  cases fs₁ with
  | nil => cases hFsRel
  | cons f₁ tl₁ =>
    cases tl₁ with
    | cons _ _ => cases hFsRel
    | nil =>
      cases fs₂ with
      | nil => cases hFsRel
      | cons f₂ tl₂ =>
        cases tl₂ with
        | cons _ _ => cases hFsRel
        | nil =>
          cases hFsRel with
          | inr hNe =>
            have hDefNe : f₁.defId ≠ plan.defId := hNe.1
            have hFEq : f₂ = f₁ := hNe.2
            rw [hFEq]
            have hEvalEq : evalStepArrSlice pTgt 0 { frames := [f₁], callerMem := cm₁ } =
                evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm₁ } := by
              change (match Trusted.MirSemantics.getElem? pTgt.bodies f₁.defId with
                  | none => StepResult.fault FaultKind.unsupported
                  | some body =>
                    match Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
                    | none => StepResult.fault FaultKind.unsupported
                    | some bb =>
                      match Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
                      | some stmt => evalArrSliceStmt body f₁ cm₁ stmt
                      | none => if Nat.beq f₁.stmtIdx bb.statements.length then evalArrSliceTerm body bb f₁ cm₁ else StepResult.fault FaultKind.unsupported) =
                (match Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId with
                  | none => StepResult.fault FaultKind.unsupported
                  | some body =>
                    match Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
                    | none => StepResult.fault FaultKind.unsupported
                    | some bb =>
                      match Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
                      | some stmt => evalArrSliceStmt body f₁ cm₁ stmt
                      | none => if Nat.beq f₁.stmtIdx bb.statements.length then evalArrSliceTerm body bb f₁ cm₁ else StepResult.fault FaultKind.unsupported)
              rw [getElem?_pTgt_bodies_ne pack f₁.defId hDefNe]
            refine ⟨?_, ?_, ?_⟩
            · intro s₁' hStep
              right
              have hStepTgt : evalStepArrSlice pTgt 0 { frames := [f₁], callerMem := cm₁ } = .step s₁' := by
                rw [hEvalEq]; exact hStep
              have hPres := evalStepArrSlice_preserves_defId pSrc f₁ cm₁ hStep
              cases hPres with | intro f₁' hF1' =>
              have hS1' : s₁' = { frames := [f₁'], callerMem := s₁'.callerMem } := by
                cases s₁' with | mk fs1' cm1' =>
                dsimp at hF1'; rw [hF1'.1]
              refine ⟨s₁', ⟨0, reachesNArrSlice_one_step hStepTgt⟩, rfl, ?_⟩
              rw [hS1']; dsimp
              exact Or.inr ⟨by rw [hF1'.2]; exact hDefNe, rfl⟩
            · intro out hDone
              exact ⟨{ frames := [f₁], callerMem := cm₁ }, ReachesArrSlice.refl _,
                (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hEvalEq]; exact hDone)⟩
            · intro k hFault
              exact ⟨{ frames := [f₁], callerMem := cm₁ }, ReachesArrSlice.refl _,
                (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hEvalEq]; exact hFault)⟩
          | inl hSamePack =>
            have hSame := hSamePack.1
            have hSame₂ := hSamePack.2.1
            have hBbEq := hSamePack.2.2.1
            have hLM := hSamePack.2.2.2.1
            have hBlockInfo := hSamePack.2.2.2.2
            have hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc := by
              rw [hSame]; exact pack.hGetBody
            have hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt := by
              rw [hSame₂]; exact getElem?_pTgt_bodies_eq pack
            cases hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx with
            | none =>
              have hBbTgtNone : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = none := by
                rw [hBbEq, pack.hBodyTgt]
                change Trusted.MirSemantics.getElem?
                  (List.map (lowerBlockForSlices pack.bodySrc.locals plan.entries pack.bodySrc.locals.length)
                    pack.bodySrc.basicBlocks) f₁.blockIdx = none
                rw [getElem?_map, hBbSrc]
              have hF1 : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm₁ } = StepResult.fault FaultKind.unsupported := by
                change (match Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId with
                  | none => StepResult.fault FaultKind.unsupported
                  | some body => match Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
                    | none => StepResult.fault FaultKind.unsupported | some _ => _) = _
                rw [hBodySrc]; dsimp; rw [hBbSrc]
              have hF2 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm₁ } = StepResult.fault FaultKind.unsupported := by
                change (match Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId with
                  | none => StepResult.fault FaultKind.unsupported
                  | some body => match Trusted.MirSemantics.getElem? body.basicBlocks f₂.blockIdx with
                    | none => StepResult.fault FaultKind.unsupported | some _ => _) = _
                rw [hBodyTgt]; dsimp; rw [hBbTgtNone]
              refine ⟨fun s₁' h => (by rw [hF1] at h; cases h),
                fun out h => (by rw [hF1] at h; cases h),
                fun k h => by rw [hF1] at h; exact ⟨{ frames := [f₂], callerMem := cm₁ }, ReachesArrSlice.refl _, (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hF2]; exact h)⟩⟩
            | some bbSrc =>
              rw [hBbSrc] at hBlockInfo
              have hStmtLe := hBlockInfo.1
              have hLen₂ := hBlockInfo.2
              cases Nat.decLt f₁.stmtIdx bbSrc.statements.length with
              | isTrue hLt =>
                have hExSt := getElem?_lt_some bbSrc.statements f₁.stmtIdx hLt
                cases hExSt with | intro stmt hStmtSrc =>
                have hSim := stmt_step_sim (cm := cm₁) pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hStmtSrc hLen₂ hLM
                exact ⟨fun s₁' h => Or.inr (hSim.1 s₁' h), hSim.2.1, hSim.2.2⟩
              | isFalse hNotLt =>
                have hIdx₁ : f₁.stmtIdx = bbSrc.statements.length := Nat.le_antisymm hStmtLe (Nat.le_of_not_lt hNotLt)
                have hSim := term_step_sim (cm := cm₁) pack hBodySrc hBodyTgt hSame hSame₂ hBbEq hBbSrc hIdx₁ hLen₂ hLM
                exact ⟨fun s₁' h => Or.inr (hSim.1 s₁' h), hSim.2.1, hSim.2.2⟩

/-- Main soundness theorem for `applySliceScalarize`: if `applySliceScalarize plan pSrc = some pTgt`,
then `pSrc` and `pTgt` have identical observable behavior on all queries (`FullSemanticEquivArrSlice`). -/
private theorem applySliceScalarize_sound (plan : SliceScalarizePlan)
    (pSrc pTgt : ArrSliceProgram) :
    applySliceScalarize plan pSrc = some pTgt →
    FullSemanticEquivArrSlice pSrc pTgt := by
  intro hApp
  let pack := applySliceScalarize_unpack plan pSrc pTgt hApp
  exact fullSemanticEquivArrSlice_of_fwd_stutter_sim pSrc pTgt
    (SliceStateRel pack) (fun _ => 0)
    (fun q k => (initStateArrSlice_err_iff pack q).1 k)
    (fun q k => (initStateArrSlice_err_iff pack q).2 k)
    (fun q s₁ => initStateArrSlice_ok_rel pack q s₁)
    (fun s₁ s₂ hRel => scalarize_step_sim pack hRel)

