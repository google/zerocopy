                                      rw [hOvEl.1] at h; dsimp at h
                                      unfold writeArrSliceBasePlace at h; rw [hNotChkV] at h; cases h
                                    · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                      rw [hTermSrc] at h; dsimp at h; rw [hUsizeSrc] at h; dsimp at h
                                      dsimp [evalReadArrayAtIdx] at h
                                      rw [hDDst, hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                                      rw [hNotMir] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                      rw [hOvEl.1] at h; dsimp at h
                                      unfold writeArrSliceBasePlace at h; rw [hNotChkV] at h; cases h
                                    · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                      rw [hTermSrc] at h; dsimp at h; rw [hUsizeSrc] at h; dsimp at h
                                      dsimp [evalReadArrayAtIdx] at h
                                      rw [hDDst, hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                                      rw [hNotMir] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                      rw [hOvEl.1] at h; dsimp at h
                                      unfold writeArrSliceBasePlace at h; rw [hNotChkV] at h
                                      have hEqK := StepResult.fault.inj h; rw [← hEqK]
                                      exact arrSc_reachesArrSlice_of_reach_fault hReach3 hStepErr
                                  | true =>
                                    have hOkOp : evalArrSliceTypedOperand pack.bodyTgt.locals slots₂AfterSw
                                        dstTy (.copy { localId := base + 1 + idx, projection := [] }) =
                                        .ok (v, slots₂AfterSw) := by
                                      dsimp [evalArrSliceTypedOperand, evalArrSliceBaseOperandToSlot]
                                      rw [hDeclEl, hElLive]
                                      dsimp
                                      have hMir : (!MirTy.beq pack.elemTy dstTy) = false := by
                                        rw [hDstTyEq, mirTy_beq_refl]; rfl
                                      rw [hMir]; dsimp; rw [hChkV]; rfl
                                    cases arrSc_writeArrSliceBasePlace_prefix pack hLMAfterSw.1 dst hLtDst hNeDst dstTy v with
                                    | inl hErrW =>
                                      cases hErrW with
                                      | intro errW hkW =>
                                        have hStepErr := arrSc_step_mkAssignUse_typedOp_writeErr pTgt pack.bodyTgt arm fArm cm
                                          dst dstTy _ v slots₂AfterSw errW hBodyTgt hGetArm hArmStmt hDeclDst₂ hOkOp hkW.2
                                        refine ⟨?_, ?_, ?_⟩
                                        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                          rw [hTermSrc] at h; dsimp at h; rw [hUsizeSrc] at h; dsimp at h
                                          dsimp [evalReadArrayAtIdx] at h
                                          rw [hDDst, hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                                          rw [hNotMir] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                          rw [hOvEl.1] at h; dsimp at h
                                          rw [hkW.1] at h; cases h
                                        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                          rw [hTermSrc] at h; dsimp at h; rw [hUsizeSrc] at h; dsimp at h
                                          dsimp [evalReadArrayAtIdx] at h
                                          rw [hDDst, hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                                          rw [hNotMir] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                          rw [hOvEl.1] at h; dsimp at h
                                          rw [hkW.1] at h; cases h
                                        · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                          rw [hTermSrc] at h; dsimp at h; rw [hUsizeSrc] at h; dsimp at h
                                          dsimp [evalReadArrayAtIdx] at h
                                          rw [hDDst, hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                                          rw [hNotMir] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                          rw [hOvEl.1] at h; dsimp at h
                                          rw [hkW.1] at h
                                          have hEqK := StepResult.fault.inj h; rw [← hEqK]
                                          exact arrSc_reachesArrSlice_of_reach_fault hReach3 hStepErr
                                    | inr hOkW =>
                                      cases hOkW with
                                      | intro slots₁' h3 => cases h3 with
                                      | intro slots₂' hW =>
                                        have hLM' := arrSc_localMatch_lift_prefix pack hLMAfterSw
                                          hW.2.2.1 hW.2.2.2.1 hW.2.2.2.2.1 hW.2.2.2.2.2.1
                                        have hStep3 : evalStepArrSlice pTgt 0 { frames := [fArm], callerMem := cm } =
                                            stepStmtNext fArm cm slots₂' := by
                                          rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt fArm cm arm _
                                            hBodyTgt hGetArm hArmStmt]
                                          dsimp [mkAssignUse, evalArrSliceStmt]
                                          rw [hDeclDst₂]; dsimp
                                          rw [arrSc_evalArrSliceBaseRvalue_use_of_typedOp pack.bodyTgt.locals
                                            slots₂AfterSw dstTy (.copy { localId := base + 1 + idx, projection := [] })
                                            v slots₂AfterSw hOkOp]
                                          dsimp; rw [hW.2.1]
                                        let fArm1 : ArrSliceFrame :=
                                          { f₂ with blockIdx := armBbId, stmtIdx := 1, locals := slots₂' }
                                        have hStep3' : evalStepArrSlice pTgt 0 { frames := [fArm], callerMem := cm } =
                                            .step { frames := [fArm1], callerMem := cm } := by
                                          rw [hStep3]; rfl
                                        let fEnd : ArrSliceFrame :=
                                          { f₂ with blockIdx := nextBb, stmtIdx := 0, locals := slots₂' }
                                        have hStep4 : evalStepArrSlice pTgt 0 { frames := [fArm1], callerMem := cm } =
                                            .step { frames := [fEnd], callerMem := cm } := by
                                          rw [arrSc_evalStepArrSlice_at_term pTgt pack.bodyTgt fArm1 cm arm
                                            hBodyTgt hGetArm rfl]
                                          rfl
                                        have hReach5 : ReachesNArrSlice pTgt 5 { frames := [f₂], callerMem := cm }
                                            { frames := [fEnd], callerMem := cm } :=
                                          reachesNArrSlice_trans
                                            (reachesNArrSlice_trans hReach3 (arrSc_reachesNArrSlice_one_step hStep3'))
                                            (arrSc_reachesNArrSlice_one_step hStep4)
                                        refine ⟨?_, ?_, ?_⟩
                                        · intro s₁' h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                          rw [hTermSrc] at h; dsimp at h; rw [hUsizeSrc] at h; dsimp at h
                                          dsimp [evalReadArrayAtIdx] at h
                                          rw [hDDst, hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                                          rw [hNotMir] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                          rw [hOvEl.1] at h; dsimp at h
                                          rw [hW.1] at h
                                          have hsEq := StepResult.step.inj h; rw [← hsEq]
                                          exact arrSc_reachesPlus_jump_rel pack nextBb hSame hSame₂ hReach5 hLM'
                                        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                          rw [hTermSrc] at h; dsimp at h; rw [hUsizeSrc] at h; dsimp at h
                                          dsimp [evalReadArrayAtIdx] at h
                                          rw [hDDst, hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                                          rw [hNotMir] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                          rw [hOvEl.1] at h; dsimp at h
                                          rw [hW.1] at h; cases h
                                        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                          rw [hTermSrc] at h; dsimp at h; rw [hUsizeSrc] at h; dsimp at h
                                          dsimp [evalReadArrayAtIdx] at h
                                          rw [hDDst, hEqArr, pack.hArrDecl, hArr.1] at h; dsimp at h
                                          rw [hNotMir] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                          rw [hOvEl.1] at h; dsimp at h
                                          rw [hW.1] at h; cases h

private theorem arrSc_sim_term_writeArrayElem
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (arrLocal : LocalId) (idxOp valOp : Operand) (nextBb : BasicBlockId)
    (extraStart : Nat)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hTermSrc : bbSrc.terminator = .writeArrayElem arrLocal idxOp valOp nextBb)
    (hTermTgt : bbTgt.terminator =
      (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).2.1)
    (hBnd : arrSliceTermLocalsInBounds pack.bodySrc.locals.length bbSrc.terminator = true)
    (hChk : checkTermForArray pack.bodySrc.locals plan.arrLocal pack.elemTy bbSrc.terminator = true)
    (hGetPre : ∀ j : Nat,
      j < (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem?
          (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1 j)
    (hLenPre : f₂.stmtIdx +
      (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).1.length =
      bbTgt.statements.length)
    (hExtra : ∀ k : Nat,
      k < (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).2.2.length →
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (extraStart + k) =
        Trusted.MirSemantics.getElem?
          (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart bbSrc.terminator).2.2 k)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdTermSim pack f₁ f₂ cm := by
  rw [hTermSrc] at hBnd hChk
  dsimp [arrSliceTermLocalsInBounds] at hBnd
  dsimp [checkTermForArray] at hChk
  have hBnd1 := (bool_and_eq_true _ _).mp ((bool_and_eq_true _ _).mp hBnd).1
  have hLtArr := nat_blt_lt hBnd1.1
  have hChkAnd := (bool_and_eq_true _ _).mp hChk
  have hChkIdx := hChkAnd.1
  have hChkVal := hChkAnd.2
  cases s4c_arrSc_nat_eq_or_ne arrLocal plan.arrLocal with
  | inr hNeArr =>
    have hBeqF : Nat.beq arrLocal plan.arrLocal = false := nat_beq_false hNeArr
    have hPreNil : (lowerTermForArray plan.arrLocal pack.bodySrc.locals.length pack.len extraStart
        bbSrc.terminator).1 = [] := by
      rw [hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqF]; rfl
    have hIdx₂ : f₂.stmtIdx = bbTgt.statements.length := by rw [← hLenPre, hPreNil]; rfl
    have hTgtSame : bbTgt.terminator = .writeArrayElem arrLocal idxOp valOp nextBb := by
      rw [hTermTgt, hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqF]; rfl
    have hDeclEq := arrSc_getElem?_bodyTgt_locals_lt pack hLtArr hNeArr
    apply arrSc_sim_term_one_same pack hBodySrc hBodyTgt hSame hSame₂ hBbSrc hBbTgt hIdx₁ hIdx₂
    dsimp [evalArrSliceTerm]
    rw [hTermSrc, hTgtSame]; dsimp
    rw [hDeclEq]
    cases hDA : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
    | none => refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
    | some dA =>
      cases dA with
      | base _ | sliceView _ =>
        refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
      | array elemTy len =>
        dsimp
        cases arrSc_evalUsizeOperand_prefix pack hLM.1 idxOp hChkIdx with
        | inl hErr =>
          cases hErr with
          | intro _ hk =>
            rw [hk.1, hk.2]
            refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
        | inr hOk =>
          cases hOk with
          | intro idx h1 => cases h1 with
          | intro slots₁Mid h2 => cases h2 with
          | intro slots₂Mid hU =>
            rw [hU.1, hU.2.1]
            dsimp
            have hLMMid := arrSc_localMatch_lift_prefix pack hLM
              hU.2.2.2.1 hU.2.2.2.2.1 hU.2.2.2.2.2.1 hU.2.2.2.2.2.2.1
            cases arrSc_evalArrSliceTypedOperand_prefix pack hLMMid.1 elemTy valOp hChkVal with
            | inl hErrV =>
              cases hErrV with
              | intro _ hk =>
                rw [hk.1, hk.2]
                refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
            | inr hOkV =>
              cases hOkV with
              | intro v h3 => cases h3 with
              | intro slots₁Val h4 => cases h4 with
              | intro slots₂Val hV =>
                rw [hV.1, hV.2.1]
                dsimp
                have hLMVal := arrSc_localMatch_lift_prefix pack hLMMid
                  hV.2.2.2.1 hV.2.2.2.2.1 hV.2.2.2.2.2.1 hV.2.2.2.2.2.2.1
                rw [hLMVal.1.2 arrLocal hLtArr hNeArr]
                cases hSA : Trusted.MirSemantics.getElem? slots₁Val arrLocal with
                | none => refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
                | some slA =>
                  cases slA with
                  | baseSlot _ | arrDead | sliceDead | liveSlice _ =>
                    refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
                  | liveArray elems =>
                    dsimp
                    cases hIn : !Nat.blt idx len with
                    | true => refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
                    | false =>
                      dsimp
                      cases hSE : setElem? elems idx (some v) with
                      | none => refine ⟨fun _ h => (by cases h), fun _ h => (by cases h), fun _ h => h⟩
                      | some elems' =>
                        dsimp
                        have hLt1 : arrLocal < slots₁Val.length := by rw [hLMVal.1.1]; exact hLtArr
                        have hLt2 : arrLocal < slots₂Val.length := by
                          rw [hLMVal.2.1]
                          exact Nat.lt_of_lt_of_le hLtArr (s4c_arrSc_le_bodyTgt_locals pack)
                        cases hS1 : setElem? slots₁Val arrLocal (.liveArray elems') with
                        | none =>
                          cases lt_setElem?_some slots₁Val arrLocal _ hLt1 with
                          | intro _ hh => rw [hh] at hS1; cases hS1
                        | some slots₁' =>
                          cases hS2 : setElem? slots₂Val arrLocal (.liveArray elems') with
                          | none =>
                            cases lt_setElem?_some slots₂Val arrLocal _ hLt2 with
                            | intro _ hh => rw [hh] at hS2; cases hS2
                          | some slots₂' =>
                            have hLM' := s4c_arrSc_localMatch_set_prefix_other pack hLMVal hLtArr hNeArr hS1 hS2
                            refine ⟨?_, fun _ h => (by cases h), fun _ h => (by cases h)⟩
                            intro s₁' hs
                            have hsEq := StepResult.step.inj hs
                            exact ⟨nextBb, slots₁', slots₂', hsEq.symm, rfl, hLM'⟩
  | inl hEqArr =>
    have hBeqT : Nat.beq arrLocal plan.arrLocal = true := nat_beq_true hEqArr
    let base := pack.bodySrc.locals.length
    let idxScr := base + 1 + pack.len + 1
    let valScr := base + 1 + pack.len + 3
    let built := buildWriteArrayArms valScr (base + 1) nextBb 0 extraStart pack.len
    let trapBbId := extraStart + pack.len
    let trapBb : ArrSliceBlock := {
      statements := []
      terminator := .baseTerm .unreachable
      cleanup := false
    }
    have hPreEq : (lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator).1 =
        [mkAssignUse idxScr idxOp, mkAssignUse valScr valOp, mkLivenessCheckStmt base] := by
      rw [hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqT]; rfl
    have hPreLen : (lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator).1.length = 3 := by
      rw [hPreEq]; rfl
    have hIdx3 : f₂.stmtIdx + 3 = bbTgt.statements.length := by rw [← hPreLen]; exact hLenPre
    have hGet0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (mkAssignUse idxScr idxOp) := by
      have h0 := hGetPre 0 (by rw [hPreLen]; exact Nat.zero_lt_succ 2)
      rw [Nat.add_zero, hPreEq] at h0; exact h0
    have hGet1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
        some (mkAssignUse valScr valOp) := by
      have h1 := hGetPre 1 (by rw [hPreLen]; exact Nat.succ_lt_succ (Nat.zero_lt_succ 1))
      rw [hPreEq] at h1; exact h1
    have hGet2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
        some (mkLivenessCheckStmt base) := by
      have h2 := hGetPre 2 (by rw [hPreLen]; exact Nat.lt_succ_self 2)
      rw [hPreEq] at h2; exact h2
    have hTgtSwitch : bbTgt.terminator = .baseTerm (.switchInt
        (.move { localId := idxScr, projection := [] })
        { branches := built.1, otherwise := trapBbId }) := by
      rw [hTermTgt, hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqT]; rfl
    have hExtraEq : (lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator).2.2 =
        built.2 ++ [trapBb] := by
      rw [hTermSrc]; dsimp [lowerTermForArray]; rw [hBeqT]; rfl
    have hEvSrc : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
        evalArrSliceTerm pack.bodySrc bbSrc f₁ cm :=
      arrSc_evalStepArrSlice_at_term pSrc pack.bodySrc f₁ cm bbSrc hBodySrc hBbSrc hIdx₁
    have hDeclIdx := arrSc_getElem?_bodyTgt_locals_idxScr pack
    have hDeclVal := arrSc_getElem?_bodyTgt_locals_valScr pack
    have hDeclLive := arrSc_getElem?_bodyTgt_locals_liveLoc pack
    cases arrSc_evalArrSliceTypedOperand_prefix pack hLM.1 usizeTy idxOp hChkIdx with
    | inl hErr =>
      cases hErr with
      | intro err hk =>
        have hStepErr := arrSc_step_mkAssignUse_typedOp_err pTgt pack.bodyTgt bbTgt f₂ cm
          idxScr usizeTy idxOp err hBodyTgt hBbTgt hGet0 hDeclIdx hk.2
        refine ⟨?_, ?_, ?_⟩
        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
          rw [hTermSrc] at h; dsimp at h
          rw [hEqArr, pack.hArrDecl] at h; dsimp [evalUsizeOperand] at h
          rw [hk.1] at h; cases h
        · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
          rw [hTermSrc] at h; dsimp at h
          rw [hEqArr, pack.hArrDecl] at h; dsimp [evalUsizeOperand] at h
          rw [hk.1] at h; cases h
        · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
          rw [hTermSrc] at h; dsimp at h
          rw [hEqArr, pack.hArrDecl] at h; dsimp [evalUsizeOperand] at h
          rw [hk.1] at h
          have hEqK := StepResult.fault.inj h; rw [← hEqK]
          exact arrSc_reachesArrSlice_of_reach_fault (ReachesNArrSlice.zero _) hStepErr
    | inr hOk =>
      cases hOk with
      | intro vIdx h1 => cases h1 with
      | intro slots₁Mid h2 => cases h2 with
      | intro slots₂Mid hOp =>
        cases (arrSc_checkVal_usize_iff vIdx).mp hOp.2.2.1 with
        | intro sv hsv =>
          let idx := sv.bits.toNat
          have hIdxMax : idx < maxUsize := hsv.2.2.2.2
          have hSvEq : sv = ⟨.isize, false, BitVec.ofNat 128 idx⟩ :=
            arrSc_scalarVal_eq_ofNat sv hsv.2.1 hsv.2.2.1 hsv.2.2.2.1
          have hVIdxEq : vIdx = .scalar ⟨.isize, false, BitVec.ofNat 128 idx⟩ := by
            rw [hsv.1, hSvEq]
          have hUsizeSrc : evalUsizeOperand pack.bodySrc.locals f₁.locals idxOp =
              .ok (idx, slots₁Mid) := by
            dsimp [evalUsizeOperand]; rw [hOp.1, hsv.1]
          have hLMMid := arrSc_localMatch_lift_prefix pack hLM
            hOp.2.2.2.1 hOp.2.2.2.2.1 hOp.2.2.2.2.2.1 hOp.2.2.2.2.2.2.1
          have hR1 : 1 < 4 + pack.len := by
            rw [Nat.add_comm 4 pack.len]
            exact Nat.lt_of_lt_of_le (Nat.succ_lt_succ (Nat.zero_lt_succ 2)) (Nat.le_add_left 4 pack.len)
          cases hLMMid.2.2.2 1 hR1 with
          | intro ovIdx hOvIdx =>
            have hLtIdxScr : idxScr < slots₂Mid.length := getElem?_some_lt slots₂Mid idxScr _ hOvIdx
            cases hSetIdx : setElem? slots₂Mid idxScr (.baseSlot (.live (some vIdx))) with
            | none =>
              cases lt_setElem?_some slots₂Mid idxScr _ hLtIdxScr with
              | intro _ hh => rw [hh] at hSetIdx; cases hSetIdx
            | some slots₂Idx =>
              have hStep0 := arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt bbTgt f₂ cm
                idxScr usizeTy idxOp vIdx slots₂Mid slots₂Idx hBodyTgt hBbTgt hGet0 hDeclIdx
                hOp.2.1 ovIdx hOvIdx hSetIdx
              let fIdx : ArrSliceFrame :=
                { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂Idx }
              have hStep0' : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
                  .step { frames := [fIdx], callerMem := cm } := by
                rw [hStep0]; rfl
              have hLMIdx := arrSc_localMatch_set_scr pack hLMMid hR1 hSetIdx
              cases arrSc_evalArrSliceTypedOperand_prefix pack hLMIdx.1 pack.elemTy valOp hChkVal with
              | inl hErrV =>
                cases hErrV with
                | intro errV hkV =>
                  have hStepErr := arrSc_step_mkAssignUse_typedOp_err pTgt pack.bodyTgt bbTgt fIdx cm
                    valScr pack.elemTy valOp errV hBodyTgt hBbTgt hGet1 hDeclVal hkV.2
                  refine ⟨?_, ?_, ?_⟩
                  · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                    rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                    rw [hUsizeSrc] at h; dsimp at h; rw [hkV.1] at h; cases h
                  · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                    rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                    rw [hUsizeSrc] at h; dsimp at h; rw [hkV.1] at h; cases h
                  · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                    rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                    rw [hUsizeSrc] at h; dsimp at h; rw [hkV.1] at h
                    have hEqK := StepResult.fault.inj h; rw [← hEqK]
                    exact arrSc_reachesArrSlice_of_reach_fault
                      (arrSc_reachesNArrSlice_one_step hStep0') hStepErr
              | inr hOkV =>
                cases hOkV with
                | intro vVal h3 => cases h3 with
                | intro slots₁Val h4 => cases h4 with
                | intro slots₂PreVal hV =>
                  have hLMPreVal := arrSc_localMatch_lift_prefix pack hLMIdx
                    hV.2.2.2.1 hV.2.2.2.2.1 hV.2.2.2.2.2.1 hV.2.2.2.2.2.2.1
                  have hR3 : 3 < 4 + pack.len := by
                    rw [Nat.add_comm 4 pack.len]
                    exact Nat.lt_of_lt_of_le (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 0))))
                      (Nat.le_add_left 4 pack.len)
                  cases hLMPreVal.2.2.2 3 hR3 with
                  | intro ovVal hOvVal =>
                    have hLtValScr : valScr < slots₂PreVal.length :=
                      getElem?_some_lt slots₂PreVal valScr _ hOvVal
                    cases hSetVal : setElem? slots₂PreVal valScr (.baseSlot (.live (some vVal))) with
                    | none =>
                      cases lt_setElem?_some slots₂PreVal valScr _ hLtValScr with
                      | intro _ hh => rw [hh] at hSetVal; cases hSetVal
                    | some slots₂Val =>
                      have hStep1 := arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt bbTgt fIdx cm
                        valScr pack.elemTy valOp vVal slots₂PreVal slots₂Val hBodyTgt hBbTgt hGet1 hDeclVal
                        hV.2.1 ovVal hOvVal hSetVal
                      let fVal : ArrSliceFrame :=
                        { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂Val }
                      have hStep1' : evalStepArrSlice pTgt 0 { frames := [fIdx], callerMem := cm } =
                          .step { frames := [fVal], callerMem := cm } := by
                        rw [hStep1]; rfl
                      have hLMVal := arrSc_localMatch_set_scr pack hLMPreVal hR3 hSetVal
                      have hReach2 := arrSc_reachesNArrSlice_succ_head hStep0'
                        (arrSc_reachesNArrSlice_one_step hStep1')
                      cases hLMVal.2.2.1 with
                      | intro arrSl hArr =>
                        cases arrSl with
                        | baseSlot _ | sliceDead | liveSlice _ => exact False.elim hArr.2
                        | arrDead =>
                          have hDead := arrSc_step_mkLivenessCheckStmt_dead pTgt pack.bodyTgt bbTgt fVal cm
                            base hBodyTgt hBbTgt hGet2 hDeclLive hArr.2.1
                          refine ⟨?_, ?_, ?_⟩
                          · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                            rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                            rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                            rw [hArr.1] at h; cases h
                          · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                            rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                            rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                            rw [hArr.1] at h; cases h
                          · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                            rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                            rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                            rw [hArr.1] at h
                            have hEqK := StepResult.fault.inj h; rw [← hEqK]
                            exact arrSc_reachesArrSlice_of_reach_fault hReach2 hDead
                        | liveArray elems =>
                          cases arrSc_step_mkLivenessCheckStmt_live pTgt pack.bodyTgt bbTgt fVal cm
                              base (some .unit) hBodyTgt hBbTgt hGet2 hDeclLive hArr.2.2.1 with
                          | intro slots₂Live hLiveStep =>
                            let fLive : ArrSliceFrame :=
                              { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂Live }
                            have hStep2' : evalStepArrSlice pTgt 0 { frames := [fVal], callerMem := cm } =
                                .step { frames := [fLive], callerMem := cm } := by
                              rw [hLiveStep.2]; rfl
                            have hLMLive := s4c_arrSc_localMatch_set_liveLoc_unit pack hLMVal hArr.2.2.1 hLiveStep.1
                            have hLiveIdx : Trusted.MirSemantics.getElem? slots₂Live idxScr =
                                some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 idx⟩)))) := by
                              have hNe1 : base ≠ idxScr := fun h => by
                                have hLt : base < idxScr := by
                                  change base < base + 1 + pack.len + 1
                                  rw [Nat.add_assoc base 1 pack.len, Nat.add_assoc base (1 + pack.len) 1,
                                    Nat.add_comm 1 pack.len, Nat.add_assoc pack.len 1 1]
                                  exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ (pack.len + 1))
                                rw [h] at hLt; exact nat_lt_irrefl _ hLt
                              have hNe2 : valScr ≠ idxScr := fun h => by
                                have hLt : idxScr < valScr := by
                                  change base + 1 + pack.len + 1 < base + 1 + pack.len + 3
                                  exact Nat.lt_trans (Nat.lt_succ_self _) (Nat.lt_succ_self _)
                                rw [h] at hLt; exact nat_lt_irrefl _ hLt
                              rw [getElem?_setElem?_ne slots₂Val base idxScr _ slots₂Live hNe1 hLiveStep.1,
                                getElem?_setElem?_ne slots₂PreVal valScr idxScr _ slots₂Val hNe2 hSetVal,
                                hV.2.2.2.2.2.1 idxScr (Nat.le_trans (Nat.le_add_right _ 1)
                                  (Nat.le_trans (Nat.le_add_right _ pack.len) (Nat.le_add_right _ 1))),
                                ← hVIdxEq]
                              exact getElem?_setElem?_self slots₂Mid idxScr _ slots₂Idx hSetIdx
                            have hLtIdxLive : idxScr < slots₂Live.length :=
                              getElem?_some_lt slots₂Live idxScr _ hLiveIdx
                            cases hMoveIdx : setElem? slots₂Live idxScr (.baseSlot (liveUninitSlot usizeTy)) with
                            | none =>
                              cases lt_setElem?_some slots₂Live idxScr _ hLtIdxLive with
                              | intro _ hh => rw [hh] at hMoveIdx; cases hMoveIdx
                            | some slots₂AfterSw =>
                              have hBrEq : built.1 = arrSc_armBranches 0 extraStart pack.len :=
                                arrSc_buildWriteArrayArms_branches valScr (base + 1) nextBb pack.len 0 extraStart
                              have hStep3 := arrSc_step_switchInt_move_armBranches pTgt pack.bodyTgt bbTgt fLive cm
                                idxScr idx pack.len extraStart built.1 slots₂AfterSw
                                hIdxMax (Nat.le_of_lt (arrSc_len_lt_maxUsize pack)) hBrEq
                                hBodyTgt hBbTgt hIdx3 hTgtSwitch hDeclIdx hLiveIdx hMoveIdx
                              have hMoveIdx' : setElem? slots₂Live (base + 1 + pack.len + 1)
                                  (.baseSlot (.live (initElemOptVal usizeTy))) = some slots₂AfterSw := by
                                rw [← arrSc_liveUninitSlot_eq usizeTy]; exact hMoveIdx
                              have hLMAfterSw := arrSc_localMatch_set_scr pack hLMLive hR1 hMoveIdx'
                              have hReach3 := reachesNArrSlice_trans hReach2 (arrSc_reachesNArrSlice_one_step hStep2')
                              cases hIn : Nat.blt idx pack.len with
                              | false =>
                                have hNotIn : (!Nat.blt idx pack.len) = true := by rw [hIn]; rfl
                                let fTrap : ArrSliceFrame :=
                                  { f₂ with blockIdx := trapBbId, stmtIdx := 0, locals := slots₂AfterSw }
                                have hStep3F : evalStepArrSlice pTgt 0 { frames := [fLive], callerMem := cm } =
                                    .step { frames := [fTrap], callerMem := cm } := by
                                  rw [hStep3, hIn]; rfl
                                have hGetTrap : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks trapBbId =
                                    some trapBb := by
                                  have hK : pack.len <
                                      (lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator).2.2.length := by
                                    rw [hExtraEq, list_append_length, arrSc_buildWriteArrayArms_blocks_length]
                                    exact Nat.lt_succ_self _
                                  have hEx := hExtra pack.len hK
                                  have hApp : Trusted.MirSemantics.getElem? (built.2 ++ [trapBb]) pack.len =
                                      some trapBb := by
                                    have hZ : pack.len = built.2.length + 0 := by
                                      rw [arrSc_buildWriteArrayArms_blocks_length]; rfl
                                    rw [hZ, getElem?_append_right]
                                    rfl
                                  rw [hExtraEq, hApp] at hEx
                                  exact hEx
                                have hTrapFault : evalStepArrSlice pTgt 0 { frames := [fTrap], callerMem := cm } =
                                    .fault .undefined := by
                                  rw [arrSc_evalStepArrSlice_at_term pTgt pack.bodyTgt fTrap cm trapBb
                                    hBodyTgt hGetTrap rfl]
                                  rfl
                                have hReach4 := reachesNArrSlice_trans hReach3 (arrSc_reachesNArrSlice_one_step hStep3F)
                                refine ⟨?_, ?_, ?_⟩
                                · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                  rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                                  rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                                  rw [hArr.1] at h; dsimp at h; rw [hNotIn] at h; cases h
                                · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                  rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                                  rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                                  rw [hArr.1] at h; dsimp at h; rw [hNotIn] at h; cases h
                                · intro k h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                  rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                                  rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                                  rw [hArr.1] at h; dsimp at h; rw [hNotIn] at h
                                  have hEqK := StepResult.fault.inj h; rw [← hEqK]
                                  exact arrSc_reachesArrSlice_of_reach_fault hReach4 hTrapFault
                              | true =>
                                have hNotIn : (!Nat.blt idx pack.len) = false := by rw [hIn]; rfl
                                have hIdxLt : idx < pack.len := nat_blt_lt hIn
                                let elLoc := base + 1 + idx
                                let armBbId := extraStart + idx
                                let arm : ArrSliceBlock := {
                                  statements :=
                                    [mkAssignUse elLoc (.move { localId := valScr, projection := [] })]
                                  terminator := .baseTerm (.goto nextBb)
                                  cleanup := false
                                }
                                have hGetArm : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks armBbId =
                                    some arm := by
                                  have hK : idx <
                                      (lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator).2.2.length := by
                                    rw [hExtraEq, list_append_length, arrSc_buildWriteArrayArms_blocks_length]
                                    exact Nat.lt_trans hIdxLt (Nat.lt_succ_self _)
                                  have hEx := hExtra idx hK
                                  rw [hExtraEq, getElem?_append_left built.2 [trapBb] idx
                                      (by rw [arrSc_buildWriteArrayArms_blocks_length]; exact hIdxLt),
                                    arrSc_getElem?_buildWriteArrayArms valScr (base + 1) nextBb pack.len 0 extraStart idx hIdxLt,
                                    Nat.zero_add] at hEx
                                  exact hEx
                                let fArm : ArrSliceFrame :=
                                  { f₂ with blockIdx := armBbId, stmtIdx := 0, locals := slots₂AfterSw }
                                have hStep3Arm : evalStepArrSlice pTgt 0 { frames := [fLive], callerMem := cm } =
                                    .step { frames := [fArm], callerMem := cm } := by
                                  rw [hStep3, hIn]; rfl
                                have hReach4 := reachesNArrSlice_trans hReach3 (arrSc_reachesNArrSlice_one_step hStep3Arm)
                                have hArmStmt : Trusted.MirSemantics.getElem? arm.statements fArm.stmtIdx =
                                    some (mkAssignUse elLoc (.move { localId := valScr, projection := [] })) := rfl
                                have hDeclEl := arrSc_getElem?_bodyTgt_locals_elem pack hIdxLt
                                have hValLive : Trusted.MirSemantics.getElem? slots₂AfterSw valScr =
                                    some (.baseSlot (.live (some vVal))) := by
                                  have hNe1 : idxScr ≠ valScr := fun h => by
                                    have hLt : idxScr < valScr := by
                                      change base + 1 + pack.len + 1 < base + 1 + pack.len + 3
                                      exact Nat.lt_trans (Nat.lt_succ_self _) (Nat.lt_succ_self _)
                                    rw [h] at hLt; exact nat_lt_irrefl _ hLt
                                  have hNe2 : base ≠ valScr := fun h => by
                                    have hLt : base < valScr := by
                                      change base < base + 1 + pack.len + 3
                                      rw [Nat.add_assoc base 1 pack.len, Nat.add_assoc base (1 + pack.len) 3,
                                        Nat.add_comm 1 pack.len, Nat.add_assoc pack.len 1 3]
                                      exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ (pack.len + 3))
                                    rw [h] at hLt; exact nat_lt_irrefl _ hLt
                                  rw [getElem?_setElem?_ne slots₂Live idxScr valScr _ slots₂AfterSw hNe1 hMoveIdx,
                                    getElem?_setElem?_ne slots₂Val base valScr _ slots₂Live hNe2 hLiveStep.1]
                                  exact getElem?_setElem?_self slots₂PreVal valScr _ slots₂Val hSetVal
                                have hLtValLive : valScr < slots₂AfterSw.length :=
                                  getElem?_some_lt slots₂AfterSw valScr _ hValLive
                                cases hMoveVal : setElem? slots₂AfterSw valScr (.baseSlot (liveUninitSlot pack.elemTy)) with
                                | none =>
                                  cases lt_setElem?_some slots₂AfterSw valScr _ hLtValLive with
                                  | intro _ hh => rw [hh] at hMoveVal; cases hMoveVal
                                | some slots₂AfterMove =>
                                  have hOkOp : evalArrSliceTypedOperand pack.bodyTgt.locals slots₂AfterSw
                                      pack.elemTy (.move { localId := valScr, projection := [] }) =
                                      .ok (vVal, slots₂AfterMove) := by
                                    dsimp [evalArrSliceTypedOperand, evalArrSliceBaseOperandToSlot]
                                    rw [hDeclVal, hValLive]; dsimp; rw [hMoveVal]; dsimp
                                    have hMir : (!MirTy.beq pack.elemTy pack.elemTy) = false := by
                                      rw [mirTy_beq_refl]; rfl
                                    rw [hMir]; dsimp; rw [hV.2.2.1]; rfl
                                  have hMoveVal' : setElem? slots₂AfterSw (base + 1 + pack.len + 3)
                                      (.baseSlot (.live (initElemOptVal pack.elemTy))) = some slots₂AfterMove := by
                                    rw [← arrSc_liveUninitSlot_eq pack.elemTy]; exact hMoveVal
                                  have hLMMove := arrSc_localMatch_set_scr pack hLMAfterSw hR3 hMoveVal'
                                  cases hLMMove.2.2.1 with
                                  | intro arrSlM hArrM =>
                                    have hEqSlM : arrSlM = .liveArray elems := by
                                      have hS := hArr.1
                                      rw [hS] at hArrM
                                      exact (Option.some.inj hArrM.1).symm
                                    rw [hEqSlM] at hArrM
                                    cases hArrM.2.2.2 idx hIdxLt with
                                    | intro ovEl hOvEl =>
                                      have hLtEl : elLoc < slots₂AfterMove.length :=
                                        getElem?_some_lt slots₂AfterMove elLoc _ hOvEl.2
                                      cases hSetEl2 : setElem? slots₂AfterMove elLoc (.baseSlot (.live (some vVal))) with
                                      | none =>
                                        cases lt_setElem?_some slots₂AfterMove elLoc _ hLtEl with
                                        | intro _ hh => rw [hh] at hSetEl2; cases hSetEl2
                                      | some slots₂' =>
                                        have hStep4 := arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt arm fArm cm
                                          elLoc pack.elemTy _ vVal slots₂AfterMove slots₂'
                                          hBodyTgt hGetArm hArmStmt hDeclEl hOkOp ovEl hOvEl.2 hSetEl2
                                        let fArm1 : ArrSliceFrame :=
                                          { f₂ with blockIdx := armBbId, stmtIdx := 1, locals := slots₂' }
                                        have hStep4' : evalStepArrSlice pTgt 0 { frames := [fArm], callerMem := cm } =
                                            .step { frames := [fArm1], callerMem := cm } := by
                                          rw [hStep4]; rfl
                                        let fEnd : ArrSliceFrame :=
                                          { f₂ with blockIdx := nextBb, stmtIdx := 0, locals := slots₂' }
                                        have hStep5 : evalStepArrSlice pTgt 0 { frames := [fArm1], callerMem := cm } =
                                            .step { frames := [fEnd], callerMem := cm } := by
                                          rw [arrSc_evalStepArrSlice_at_term pTgt pack.bodyTgt fArm1 cm arm
                                            hBodyTgt hGetArm rfl]
                                          rfl
                                        have hReach6 := reachesNArrSlice_trans
                                          (reachesNArrSlice_trans hReach4 (arrSc_reachesNArrSlice_one_step hStep4'))
                                          (arrSc_reachesNArrSlice_one_step hStep5)
                                        have hLtElSrc : idx < elems.length := by rw [hArrM.2.1]; exact hIdxLt
                                        cases hSetElSrc : setElem? elems idx (some vVal) with
                                        | none =>
                                          cases lt_setElem?_some elems idx (some vVal) hLtElSrc with
                                          | intro _ hh => rw [hh] at hSetElSrc; cases hSetElSrc
                                        | some elems' =>
                                          have hLtArr1 : plan.arrLocal < slots₁Val.length := by
                                            rw [hLMMove.1.1]; exact pack.hLocLt
                                          cases hS1 : setElem? slots₁Val plan.arrLocal (.liveArray elems') with
                                          | none =>
                                            cases lt_setElem?_some slots₁Val plan.arrLocal _ hLtArr1 with
                                            | intro _ hh => rw [hh] at hS1; cases hS1
                                          | some slots₁' =>
                                            have hComp' := s4c_arrSc_compRel_liveArray_setElem hArrM.2 hIdxLt hSetElSrc hSetEl2
                                            have hLM' := s4c_arrSc_localMatch_set_arrElem pack hLMMove hS1 hIdxLt hSetEl2 hComp'
                                            refine ⟨?_, ?_, ?_⟩
                                            · intro s₁' h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                              rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                                              rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                                              rw [hArr.1] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                              rw [hSetElSrc] at h; dsimp at h; rw [hS1] at h
                                              have hsEq := StepResult.step.inj h; rw [← hsEq]
                                              exact arrSc_reachesPlus_jump_rel pack nextBb hSame hSame₂ hReach6 hLM'
                                            · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                              rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                                              rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                                              rw [hArr.1] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                              rw [hSetElSrc] at h; dsimp at h; rw [hS1] at h; cases h
                                            · intro _ h; rw [hEvSrc] at h; dsimp [evalArrSliceTerm] at h
                                              rw [hTermSrc] at h; dsimp at h; rw [hEqArr, pack.hArrDecl] at h; dsimp at h
                                              rw [hUsizeSrc] at h; dsimp at h; rw [hV.1] at h; dsimp at h
                                              rw [hArr.1] at h; dsimp at h; rw [hNotIn] at h; dsimp at h
                                              rw [hSetElSrc] at h; dsimp at h; rw [hS1] at h; cases h

private theorem arrSc_term_step_sim
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hLen₂ : f₂.stmtIdx = (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
      (bbSrc.statements.take f₁.stmtIdx)).length)
    (hLM : arrSc_LocalMatch pack f₁.locals f₂.locals) :
    arrSc_FwdTermSim pack f₁ f₂ cm := by
  have hPre := arrSc_lowerBlock_getElem?_termPre pack hBbSrc
  cases hPre with
  | intro extraStart hSpec =>
    let base := pack.bodySrc.locals.length
    let termRes := lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator
    let bbTgt : ArrSliceBlock := {
      bbSrc with
      statements :=
        listFlatMap (lowerStmtForArray plan.arrLocal base pack.len) bbSrc.statements ++ termRes.1
      terminator := termRes.2.1
    }
    have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
      rw [hBbEq]; exact hSpec.2.1
    have hF2Off : f₂.stmtIdx =
        (listFlatMap (lowerStmtForArray plan.arrLocal base pack.len)
          (bbSrc.statements.take bbSrc.statements.length)).length := by
      rw [hLen₂, hIdx₁]
    have hGetPre : ∀ j : Nat, j < termRes.1.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
          Trusted.MirSemantics.getElem? termRes.1 j := by
      intro j hj
      rw [hF2Off, ← hSpec.2.2.1]
      exact hSpec.2.2.2.2.1 j hj
    have hLenPre : f₂.stmtIdx + termRes.1.length = bbTgt.statements.length := by
      rw [hF2Off, ← hSpec.2.2.1]
      exact hSpec.2.2.2.1
    have hExtra := hSpec.2.2.2.2.2
    have hBnd := arrSc_bodySrc_term_localsInBounds pack hBbSrc
    have hChk := (arrSc_bodySrc_block_checks pack hBbSrc).2
    cases hTermSrc : bbSrc.terminator with
    | boundsCheckArray a idxOp inBb pBb =>
      exact arrSc_sim_term_boundsCheckArray pack a idxOp inBb pBb extraStart
        hBodySrc hBodyTgt hSame hSame₂ hBbSrc hBbTgt hIdx₁ hTermSrc rfl
        hBnd hChk hGetPre hLenPre hLM
    | readArrayElem dst a idxOp nextBb =>
      exact arrSc_sim_term_readArrayElem pack dst a idxOp nextBb extraStart
        hBodySrc hBodyTgt hSame hSame₂ hBbSrc hBbTgt hIdx₁ hTermSrc rfl
        hBnd hChk hGetPre hLenPre hExtra hLM
    | writeArrayElem a idxOp valOp nextBb =>
      exact arrSc_sim_term_writeArrayElem pack a idxOp valOp nextBb extraStart
