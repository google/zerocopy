/-! ## Local List, Arithmetic, Init, Step-Shape, and Slice-Preservation Helpers -/

private theorem getElem?_none_of_le {α : Type} :
    ∀ (xs : List α) (i : Nat), xs.length ≤ i → Trusted.MirSemantics.getElem? xs i = none
  | [], _, _ => rfl
  | _ :: _, 0, h => nomatch h
  | _ :: xs, i + 1, h => getElem?_none_of_le xs i (Nat.le_of_succ_le_succ h)

private theorem s2_getElem?_drop {α : Type} :
    ∀ (n i : Nat) (xs : List α),
      Trusted.MirSemantics.getElem? (xs.drop n) i =
        Trusted.MirSemantics.getElem? xs (n + i)
  | 0, i, xs => by
    rw [List.drop_zero, Nat.zero_add]
  | _ + 1, _, [] => rfl
  | n + 1, i, _ :: xs => by
    rw [List.drop_succ_cons, Nat.succ_add]
    exact s2_getElem?_drop n i xs

private theorem getElem?_take {α : Type} :
    ∀ (n i : Nat) (xs : List α),
      i < n →
      Trusted.MirSemantics.getElem? (xs.take n) i =
        Trusted.MirSemantics.getElem? xs i
  | 0, _, _, h => nomatch h
  | _ + 1, _, [], _ => rfl
  | _ + 1, 0, _ :: _, _ => rfl
  | n + 1, i + 1, _ :: xs, h =>
    getElem?_take n i xs (Nat.lt_of_succ_lt_succ h)

private theorem nat_pow_two_gt_id : ∀ n : Nat, n < Nat.pow 2 n
  | 0 => Nat.zero_lt_succ 0
  | n + 1 => by
    have ih := nat_pow_two_gt_id n
    change n + 1 < Nat.pow 2 n * 2
    rw [Nat.mul_two]
    have hPos : 0 < Nat.pow 2 n := nat_pow_two_pos n
    exact Nat.lt_of_le_of_lt ih (Nat.lt_add_of_pos_right hPos)

private theorem len_le_64_lt_maxUsize (len : Nat) (h : len ≤ 64) : len < maxUsize :=
  Nat.lt_of_le_of_lt h (nat_pow_two_gt_id 64)

private theorem nat_sub_lt_sub_right {a b c : Nat} (h1 : c ≤ a) (h2 : a < b) :
    a - c < b - c := by
  have hSum1 : c + (a - c) = a := Nat.add_sub_of_le h1
  have hLe : c ≤ b := Nat.le_trans h1 (Nat.le_of_lt h2)
  have hSum2 : c + (b - c) = b := Nat.add_sub_of_le hLe
  rw [← hSum1, ← hSum2] at h2
  exact s_nat_lt_of_add_lt_add_left h2

private theorem initStateArrSlice_ok_stmtIdx_zero
    {p : ArrSliceProgram} {q : Query} {s₀ : ArrSliceState}
    (hInit : initStateArrSlice p q = .ok s₀) :
    ∃ f₀ : ArrSliceFrame, s₀.frames = [f₀] ∧ f₀.stmtIdx = 0 := by
  unfold initStateArrSlice at hInit
  dsimp at hInit
  cases hC1 : (!Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1) with
  | true => rw [hC1] at hInit; cases hInit
  | false =>
    rw [hC1] at hInit; dsimp at hInit
    cases hC2 : q.callerMem.allocations.isEmpty with
    | false => rw [hC2] at hInit; cases hInit
    | true =>
      rw [hC2] at hInit; dsimp at hInit
      cases hEnt : Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
      | none => rw [hEnt] at hInit; cases hInit
      | some body =>
        rw [hEnt] at hInit; dsimp at hInit
        cases hE1 : body.basicBlocks.isEmpty with
        | true => rw [hE1] at hInit; cases hInit
        | false =>
          rw [hE1] at hInit; dsimp at hInit
          cases hE2 : (!Nat.blt body.argumentCount body.locals.length) with
          | true => rw [hE2] at hInit; cases hInit
          | false =>
            rw [hE2] at hInit; dsimp at hInit
            cases hE3 : (!arrSliceStorageAnnotationsInBounds body) with
            | true => rw [hE3] at hInit; cases hInit
            | false =>
              rw [hE3] at hInit; dsimp at hInit
              cases hE4 : (!allArrSliceLocalsSupported body.argumentCount 0 body.locals) with
              | true => rw [hE4] at hInit; cases hInit
              | false =>
                rw [hE4] at hInit; dsimp at hInit
                cases hPrm : arrSliceParamBaseTys? body with
                | none => rw [hPrm] at hInit; cases hInit
                | some pTys =>
                  rw [hPrm] at hInit; dsimp at hInit
                  cases hChk : (!checkArgsMatch q.args pTys) with
                  | true => rw [hChk] at hInit; cases hInit
                  | false =>
                    rw [hChk] at hInit
                    cases hInit
                    exact ⟨_, rfl, rfl⟩

private theorem evalArrSliceBaseOperandToSlot_preserves_sliceLocal
    {decls : List ArrSliceLocalDecl} {sLoc : LocalId} {sTy : MirTy}
    (hDecl : Trusted.MirSemantics.getElem? decls sLoc = some (.sliceView sTy)) :
    ∀ {slots slots' : List ArrSliceSlot} {opnd : Operand}
      {ty : MirTy} {optVal : Option Val},
      evalArrSliceBaseOperandToSlot decls slots opnd = .ok (ty, optVal, slots') →
      Trusted.MirSemantics.getElem? slots' sLoc =
        Trusted.MirSemantics.getElem? slots sLoc := by
  intro slots slots' opnd ty optVal hEv
  cases opnd with
  | copy place =>
    unfold evalArrSliceBaseOperandToSlot at hEv
    dsimp at hEv
    cases hEmpty : place.projection.isEmpty with
    | false => rw [hEmpty] at hEv; cases hEv
    | true =>
      rw [hEmpty] at hEv; dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? decls place.localId with
      | none => rw [hD] at hEv; cases hEv
      | some decl =>
        cases decl with
        | base _ =>
          cases hS : Trusted.MirSemantics.getElem? slots place.localId with
          | none => rw [hD, hS] at hEv; cases hEv
          | some sl =>
            cases sl with
            | baseSlot bsl =>
              cases bsl with
              | dead => rw [hD, hS] at hEv; cases hEv
              | live _ => rw [hD, hS] at hEv; cases hEv; rfl
            | _ => rw [hD, hS] at hEv; cases hEv
        | _ => rw [hD] at hEv; cases hEv
  | move place =>
    unfold evalArrSliceBaseOperandToSlot at hEv
    dsimp at hEv
    cases hEmpty : place.projection.isEmpty with
    | false => rw [hEmpty] at hEv; cases hEv
    | true =>
      rw [hEmpty] at hEv; dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? decls place.localId with
      | none => rw [hD] at hEv; cases hEv
      | some decl =>
        cases decl with
        | base mTy =>
          have hNe : place.localId ≠ sLoc := by
            intro hEq; rw [hEq, hDecl] at hD; cases hD
          cases hS : Trusted.MirSemantics.getElem? slots place.localId with
          | none => rw [hD, hS] at hEv; cases hEv
          | some sl =>
            cases sl with
            | baseSlot bsl =>
              cases bsl with
              | dead => rw [hD, hS] at hEv; cases hEv
              | live _ =>
                rw [hD, hS] at hEv; dsimp at hEv
                cases hSet : setElem? slots place.localId (.baseSlot (liveUninitSlot mTy)) with
                | none => rw [hSet] at hEv; cases hEv
                | some ss =>
                  rw [hSet] at hEv; cases hEv
                  exact getElem?_setElem?_ne slots place.localId sLoc _ slots' hNe hSet
            | _ => rw [hD, hS] at hEv; cases hEv
        | _ => rw [hD] at hEv; cases hEv
  | constant c =>
    unfold evalArrSliceBaseOperandToSlot at hEv
    dsimp at hEv
    cases hC : evalConstLit c.ty c.lit with
    | error _ => rw [hC] at hEv; cases hEv
    | ok _ => rw [hC] at hEv; cases hEv; rfl

private theorem evalArrSlicePrimitiveOperand_preserves_sliceLocal
    {decls : List ArrSliceLocalDecl} {sLoc : LocalId} {sTy : MirTy}
    (hDecl : Trusted.MirSemantics.getElem? decls sLoc = some (.sliceView sTy)) :
    ∀ {slots slots' : List ArrSliceSlot} {opnd : Operand} {v : Val},
      evalArrSlicePrimitiveOperand decls slots opnd = .ok (v, slots') →
      Trusted.MirSemantics.getElem? slots' sLoc =
        Trusted.MirSemantics.getElem? slots sLoc := by
  intro slots slots' opnd v hEv
  unfold evalArrSlicePrimitiveOperand at hEv
  cases hBase : evalArrSliceBaseOperandToSlot decls slots opnd with
  | error _ => rw [hBase] at hEv; cases hEv
  | ok res =>
    cases res with
    | mk ty rest =>
      cases rest with
      | mk optVal slots₁ =>
        rw [hBase] at hEv; dsimp at hEv
        cases hPrim : isPrimitiveReadableTy ty with
        | false => rw [hPrim] at hEv; cases hEv
        | true =>
          rw [hPrim] at hEv; dsimp at hEv
          cases optVal with
          | none => cases hEv
          | some _ =>
            cases hEv
            exact evalArrSliceBaseOperandToSlot_preserves_sliceLocal hDecl hBase

private theorem evalArrSliceTypedOperand_preserves_sliceLocal
    {decls : List ArrSliceLocalDecl} {sLoc : LocalId} {sTy : MirTy}
    (hDecl : Trusted.MirSemantics.getElem? decls sLoc = some (.sliceView sTy)) :
    ∀ {slots slots' : List ArrSliceSlot} {expectedTy : MirTy} {opnd : Operand} {v : Val},
      evalArrSliceTypedOperand decls slots expectedTy opnd = .ok (v, slots') →
      Trusted.MirSemantics.getElem? slots' sLoc =
        Trusted.MirSemantics.getElem? slots sLoc := by
  intro slots slots' expectedTy opnd v hEv
  unfold evalArrSliceTypedOperand at hEv
  cases hBase : evalArrSliceBaseOperandToSlot decls slots opnd with
  | error _ => rw [hBase] at hEv; cases hEv
  | ok res =>
    cases res with
    | mk srcTy rest =>
      cases rest with
      | mk optVal slots₁ =>
        rw [hBase] at hEv; dsimp at hEv
        cases hEq : MirTy.beq srcTy expectedTy with
        | false => rw [hEq] at hEv; cases hEv
        | true =>
          rw [hEq] at hEv; dsimp at hEv
          cases optVal with
          | none => cases hEv
          | some val =>
            dsimp at hEv
            cases hChk : checkVal val expectedTy with
            | false => rw [hChk] at hEv; cases hEv
            | true =>
              rw [hChk] at hEv; cases hEv
              exact evalArrSliceBaseOperandToSlot_preserves_sliceLocal hDecl hBase

private theorem evalArrSliceTypedOps_preserves_sliceLocal
    {decls : List ArrSliceLocalDecl} {sLoc : LocalId} {sTy : MirTy}
    (hDecl : Trusted.MirSemantics.getElem? decls sLoc = some (.sliceView sTy))
    (expectedTy : MirTy) :
    ∀ (ops : List Operand) (slots slots' : List ArrSliceSlot) (vs : List Val),
      evalArrSliceTypedOps decls expectedTy slots ops = .ok (vs, slots') →
      Trusted.MirSemantics.getElem? slots' sLoc =
        Trusted.MirSemantics.getElem? slots sLoc
  | [], slots, slots', vs, hEv => by
    unfold evalArrSliceTypedOps at hEv
    cases hEv
    rfl
  | op :: ops, slots, slots', vs, hEv => by
    unfold evalArrSliceTypedOps at hEv
    cases hHead : evalArrSliceTypedOperand decls slots expectedTy op with
    | error _ => rw [hHead] at hEv; cases hEv
    | ok p1 =>
      cases p1 with
      | mk v slots₁ =>
        rw [hHead] at hEv; dsimp at hEv
        cases hTail : evalArrSliceTypedOps decls expectedTy slots₁ ops with
        | error _ => rw [hTail] at hEv; cases hEv
        | ok p2 =>
          cases p2 with
          | mk vs₁ slots₂ =>
            rw [hTail] at hEv; cases hEv
            have h2 := evalArrSliceTypedOps_preserves_sliceLocal hDecl expectedTy
              ops slots₁ slots' vs₁ hTail
            have h1 := evalArrSliceTypedOperand_preserves_sliceLocal hDecl hHead
            rw [h2, h1]

private theorem evalUsizeOperand_preserves_sliceLocal
    {decls : List ArrSliceLocalDecl} {sLoc : LocalId} {sTy : MirTy}
    (hDecl : Trusted.MirSemantics.getElem? decls sLoc = some (.sliceView sTy)) :
    ∀ {slots slots' : List ArrSliceSlot} {opnd : Operand} {n : Nat},
      evalUsizeOperand decls slots opnd = .ok (n, slots') →
      Trusted.MirSemantics.getElem? slots' sLoc =
        Trusted.MirSemantics.getElem? slots sLoc := by
  intro slots slots' opnd n hEv
  unfold evalUsizeOperand at hEv
  cases hT : evalArrSliceTypedOperand decls slots usizeTy opnd with
  | error _ => rw [hT] at hEv; cases hEv
  | ok res =>
    cases res with
    | mk v slots₁ =>
      cases v with
      | scalar sv =>
        rw [hT] at hEv; cases hEv
        exact evalArrSliceTypedOperand_preserves_sliceLocal hDecl hT
      | _ => rw [hT] at hEv; cases hEv

private theorem evalArrSliceBaseRvalue_preserves_sliceLocal
    {decls : List ArrSliceLocalDecl} {sLoc : LocalId} {sTy : MirTy}
    (hDecl : Trusted.MirSemantics.getElem? decls sLoc = some (.sliceView sTy)) :
    ∀ {slots slots' : List ArrSliceSlot} {dstTy : MirTy} {rv : Rvalue} {v : Val},
      evalArrSliceBaseRvalue decls slots dstTy rv = .ok (v, slots') →
      Trusted.MirSemantics.getElem? slots' sLoc =
        Trusted.MirSemantics.getElem? slots sLoc := by
  intro slots slots' dstTy rv v hEv
  cases rv with
  | use opnd =>
    unfold evalArrSliceBaseRvalue at hEv; dsimp at hEv
    cases hBase : evalArrSliceBaseOperandToSlot decls slots opnd with
    | error _ => rw [hBase] at hEv; cases hEv
    | ok res =>
      cases res with
      | mk srcTy rest =>
        cases rest with
        | mk optVal slots₁ =>
          rw [hBase] at hEv; dsimp at hEv
          cases hTyEq : MirTy.beq srcTy dstTy with
          | false => rw [hTyEq] at hEv; cases hEv
          | true =>
            rw [hTyEq] at hEv; dsimp at hEv
            cases optVal with
            | none => cases hEv
            | some _ =>
              cases hEv
              exact evalArrSliceBaseOperandToSlot_preserves_sliceLocal hDecl hBase
  | binaryOp op lhs rhs =>
    unfold evalArrSliceBaseRvalue at hEv; dsimp at hEv
    cases hL : evalArrSlicePrimitiveOperand decls slots lhs with
    | error _ => rw [hL] at hEv; cases hEv
    | ok p1 =>
      cases p1 with
      | mk lVal slots₁ =>
        rw [hL] at hEv; dsimp at hEv
        cases hR : evalArrSlicePrimitiveOperand decls slots₁ rhs with
        | error _ => rw [hR] at hEv; cases hEv
        | ok p2 =>
          cases p2 with
          | mk rVal slots₂ =>
            rw [hR] at hEv; dsimp at hEv
            cases hB : evalBinOp op lVal rVal with
            | error _ => rw [hB] at hEv; cases hEv
            | ok _ =>
              rw [hB] at hEv; cases hEv
              have h2 := evalArrSlicePrimitiveOperand_preserves_sliceLocal hDecl hR
              have h1 := evalArrSlicePrimitiveOperand_preserves_sliceLocal hDecl hL
              rw [h2, h1]
  | unaryOp op opnd =>
    unfold evalArrSliceBaseRvalue at hEv; dsimp at hEv
    cases hO : evalArrSlicePrimitiveOperand decls slots opnd with
    | error _ => rw [hO] at hEv; cases hEv
    | ok p1 =>
      cases p1 with
      | mk val slots₁ =>
        rw [hO] at hEv; dsimp at hEv
        cases hU : evalUnOp op val with
        | error _ => rw [hU] at hEv; cases hEv
        | ok _ =>
          rw [hU] at hEv; cases hEv
          exact evalArrSlicePrimitiveOperand_preserves_sliceLocal hDecl hO
  | discriminant place =>
    unfold evalArrSliceBaseRvalue at hEv; dsimp at hEv
    cases hEmpty : place.projection.isEmpty with
    | false => rw [hEmpty] at hEv; cases hEv
    | true =>
      rw [hEmpty] at hEv; dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? decls place.localId with
      | none => rw [hD] at hEv; cases hEv
      | some decl =>
        cases decl with
        | base ty =>
          cases ty with
          | enum ety =>
            cases hS : Trusted.MirSemantics.getElem? slots place.localId with
            | none => rw [hD, hS] at hEv; cases hEv
            | some sl =>
              cases sl with
              | baseSlot bsl =>
                rw [hD, hS] at hEv; dsimp at hEv
                cases hAdm : enumAdmitted ety with
                | false => rw [hAdm] at hEv; cases hEv
                | true =>
                  rw [hAdm] at hEv; dsimp at hEv
                  cases ety with
                  | mk eid edw eds etr ediscs =>
                    dsimp at hEv
                    cases etr with
                    | zeroSized =>
                      cases bsl with
                      | dead => cases hEv
                      | live ov =>
                        cases ov with
                        | none =>
                          cases hDisc : Trusted.MirSemantics.getElem? ediscs 0 with
                          | none => rw [hDisc] at hEv; cases hEv
                          | some _ => rw [hDisc] at hEv; cases hEv; rfl
                        | some val =>
                          cases val with
                          | enumVal ety' vv =>
                            dsimp at hEv
                            cases hCond : (EnumTy.beq ⟨eid, edw, eds, .zeroSized, ediscs⟩ ety' && Nat.beq vv 0) with
                            | false => rw [hCond] at hEv; cases hEv
                            | true =>
                              rw [hCond] at hEv; dsimp at hEv
                              cases hDisc : Trusted.MirSemantics.getElem? ediscs 0 with
                              | none => rw [hDisc] at hEv; cases hEv
                              | some _ => rw [hDisc] at hEv; cases hEv; rfl
                          | _ => cases hEv
                    | scalar tw ts =>
                      cases bsl with
                      | dead => cases hEv
                      | live ov =>
                        cases ov with
                        | none => cases hEv
                        | some val =>
                          cases val with
                          | enumVal ety' vv =>
                            dsimp at hEv
                            cases hCond : (EnumTy.beq ⟨eid, edw, eds, .scalar tw ts, ediscs⟩ ety' &&
                                Nat.blt vv ediscs.length) with
                            | false => rw [hCond] at hEv; cases hEv
                            | true =>
                              rw [hCond] at hEv; dsimp at hEv
                              cases hDisc : Trusted.MirSemantics.getElem? ediscs vv with
                              | none => rw [hDisc] at hEv; cases hEv
                              | some _ => rw [hDisc] at hEv; cases hEv; rfl
                          | _ => cases hEv
              | _ => rw [hD, hS] at hEv; cases hEv
          | _ => rw [hD] at hEv; cases hEv
        | _ => rw [hD] at hEv; cases hEv
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported =>
    unfold evalArrSliceBaseRvalue at hEv; cases hEv

private theorem s2_writeArrSliceBasePlace_preserves_ne
    {slots slots' : List ArrSliceSlot} {dst sLoc : LocalId}
    {dstTy : MirTy} {val : Val}
    (hNe : dst ≠ sLoc)
    (hWr : writeArrSliceBasePlace slots dst dstTy val = .ok slots') :
    Trusted.MirSemantics.getElem? slots' sLoc =
      Trusted.MirSemantics.getElem? slots sLoc := by
  unfold writeArrSliceBasePlace at hWr
  cases hChk : checkVal val dstTy with
  | false => rw [hChk] at hWr; cases hWr
  | true =>
    rw [hChk] at hWr; dsimp at hWr
    cases hG : Trusted.MirSemantics.getElem? slots dst with
    | none => rw [hG] at hWr; cases hWr
    | some sl =>
      cases sl with
      | baseSlot bsl =>
        cases bsl with
        | dead => rw [hG] at hWr; cases hWr
        | live _ =>
          rw [hG] at hWr; dsimp at hWr
          cases hSet : setElem? slots dst (.baseSlot (.live (some val))) with
          | none => rw [hSet] at hWr; cases hWr
          | some ss =>
            rw [hSet] at hWr; cases hWr
            exact getElem?_setElem?_ne slots dst sLoc _ slots' hNe hSet
      | _ => rw [hG] at hWr; cases hWr

private theorem evalArrSliceStmt_step_frames
    {body : ArrSliceBody} {frame : ArrSliceFrame}
    {cm : CallerMemory} {st : ArrSliceStmt} {s' : ArrSliceState}
    (hStep : evalArrSliceStmt body frame cm st = .step s') :
    ∃ slots' : List ArrSliceSlot,
      s' = { frames := [{ frame with stmtIdx := frame.stmtIdx + 1, locals := slots' }],
             callerMem := cm } := by
  cases st with
  | baseStmt b =>
    cases b with
    | nop => cases hStep; exact ⟨frame.locals, rfl⟩
    | unsupported => cases hStep
    | storageLive id =>
      unfold evalArrSliceStmt at hStep; dsimp at hStep
      cases hG : Trusted.MirSemantics.getElem? body.locals id with
      | none => rw [hG] at hStep; cases hStep
      | some decl =>
        rw [hG] at hStep; dsimp at hStep
        cases hS : setElem? frame.locals id (liveUninitArrSliceSlot decl) with
        | none => rw [hS] at hStep; cases hStep
        | some ss => rw [hS] at hStep; cases hStep; exact ⟨ss, rfl⟩
    | storageDead id =>
      unfold evalArrSliceStmt at hStep; dsimp at hStep
      cases h0 : Nat.beq id 0 with
      | true => rw [h0] at hStep; cases hStep
      | false =>
        rw [h0] at hStep; dsimp at hStep
        cases hDeclId : Trusted.MirSemantics.getElem? body.locals id with
        | none =>
          rw [hDeclId] at hStep; dsimp at hStep
          cases hS : setElem? frame.locals id (.baseSlot .dead) with
          | none => rw [hS] at hStep; cases hStep
          | some ss => rw [hS] at hStep; cases hStep; exact ⟨ss, rfl⟩
        | some decl =>
          rw [hDeclId] at hStep; dsimp at hStep
          cases hS : setElem? frame.locals id (deadArrSliceSlot decl) with
          | none => rw [hS] at hStep; cases hStep
          | some ss => rw [hS] at hStep; cases hStep; exact ⟨ss, rfl⟩
    | assign dst rv =>
      unfold evalArrSliceStmt at hStep; dsimp at hStep
      cases hE : dst.projection.isEmpty with
      | false => rw [hE] at hStep; cases hStep
      | true =>
        rw [hE] at hStep; dsimp at hStep
        cases hD : Trusted.MirSemantics.getElem? body.locals dst.localId with
        | none => rw [hD] at hStep; cases hStep
        | some dd =>
          cases dd with
          | base dTy =>
            rw [hD] at hStep; dsimp at hStep
            cases hR : evalArrSliceBaseRvalue body.locals frame.locals dTy rv with
            | error _ => rw [hR] at hStep; cases hStep
            | ok p1 =>
              rw [hR] at hStep; dsimp at hStep
              cases hW : writeArrSliceBasePlace p1.2 dst.localId dTy p1.1 with
              | error _ => rw [hW] at hStep; cases hStep
              | ok ss => rw [hW] at hStep; cases hStep; exact ⟨ss, rfl⟩
          | _ => rw [hD] at hStep; cases hStep
  | aggregateArray arrLoc ops =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hA : Trusted.MirSemantics.getElem? body.locals arrLoc with
    | none => rw [hA] at hStep; cases hStep
    | some ad =>
      cases ad with
      | array eTy len =>
        rw [hA] at hStep; dsimp at hStep
        cases hL : Nat.beq ops.length len with
        | false => rw [hL] at hStep; cases hStep
        | true =>
          rw [hL] at hStep; dsimp at hStep
          cases hO : evalArrSliceTypedOps body.locals eTy frame.locals ops with
          | error _ => rw [hO] at hStep; cases hStep
          | ok p1 =>
            rw [hO] at hStep; dsimp at hStep
            cases hSl : Trusted.MirSemantics.getElem? p1.2 arrLoc with
            | none => rw [hSl] at hStep; cases hStep
            | some asl =>
              cases asl with
              | liveArray _ =>
                rw [hSl] at hStep; dsimp at hStep
                cases hSe : setElem? p1.2 arrLoc (.liveArray (p1.1.map some)) with
                | none => rw [hSe] at hStep; cases hStep
                | some ss => rw [hSe] at hStep; cases hStep; exact ⟨ss, rfl⟩
              | _ => rw [hSl] at hStep; cases hStep
      | _ => rw [hA] at hStep; cases hStep
  | repeatArray arrLoc op =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hA : Trusted.MirSemantics.getElem? body.locals arrLoc with
    | none => rw [hA] at hStep; cases hStep
    | some ad =>
      cases ad with
      | array eTy len =>
        rw [hA] at hStep; dsimp at hStep
        cases hO : evalArrSliceTypedOperand body.locals frame.locals eTy op with
        | error _ => rw [hO] at hStep; cases hStep
        | ok p1 =>
          rw [hO] at hStep; dsimp at hStep
          cases hSl : Trusted.MirSemantics.getElem? p1.2 arrLoc with
          | none => rw [hSl] at hStep; cases hStep
          | some asl =>
            cases asl with
            | liveArray _ =>
              rw [hSl] at hStep; dsimp at hStep
              cases hSe : setElem? p1.2 arrLoc (.liveArray (listReplicate len (some p1.1))) with
              | none => rw [hSe] at hStep; cases hStep
              | some ss => rw [hSe] at hStep; cases hStep; exact ⟨ss, rfl⟩
            | _ => rw [hSl] at hStep; cases hStep
      | _ => rw [hA] at hStep; cases hStep
  | arrayLivenessCheck arrLoc =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hA : Trusted.MirSemantics.getElem? body.locals arrLoc with
    | none => rw [hA] at hStep; cases hStep
    | some ad =>
      cases ad with
      | array _ _ =>
        cases hSl : Trusted.MirSemantics.getElem? frame.locals arrLoc with
        | none => rw [hA, hSl] at hStep; cases hStep
        | some asl =>
          cases asl with
          | liveArray _ => rw [hA, hSl] at hStep; cases hStep; exact ⟨frame.locals, rfl⟩
          | _ => rw [hA, hSl] at hStep; cases hStep
      | _ => rw [hA] at hStep; cases hStep
  | readArrayConst dstLocal arrLocal idx isMove =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dstLocal with
    | none => rw [hD] at hStep; cases hStep
    | some dd =>
      cases dd with
      | base dTy =>
        cases hA : Trusted.MirSemantics.getElem? body.locals arrLocal with
        | none => rw [hD, hA] at hStep; cases hStep
        | some ad =>
          cases ad with
          | array eTy len =>
            cases hSl : Trusted.MirSemantics.getElem? frame.locals arrLocal with
            | none => rw [hD, hA, hSl] at hStep; cases hStep
            | some asl =>
              cases asl with
              | liveArray elems =>
                rw [hD, hA, hSl] at hStep; dsimp at hStep
                cases hEq : MirTy.beq dTy eTy with
                | false => rw [hEq] at hStep; cases hStep
                | true =>
                  rw [hEq] at hStep; dsimp at hStep
                  cases hLt : Nat.blt idx len with
                  | false => rw [hLt] at hStep; cases hStep
                  | true =>
                    rw [hLt] at hStep; dsimp at hStep
                    cases hEl : Trusted.MirSemantics.getElem? elems idx with
                    | none => rw [hEl] at hStep; cases hStep
                    | some ov =>
                      cases ov with
                      | none => rw [hEl] at hStep; cases hStep
                      | some v =>
                        rw [hEl] at hStep; dsimp at hStep
                        cases isMove with
                        | false =>
                          dsimp at hStep
                          cases hWr : writeArrSliceBasePlace frame.locals dstLocal dTy v with
                          | error _ => rw [hWr] at hStep; cases hStep
                          | ok ss => rw [hWr] at hStep; cases hStep; exact ⟨ss, rfl⟩
                        | true =>
                          dsimp at hStep
                          cases hSetE : setElem? elems idx (initElemOptVal eTy) with
                          | none => rw [hSetE] at hStep; cases hStep
                          | some elems' =>
                            rw [hSetE] at hStep; dsimp at hStep
                            cases hSetA : setElem? frame.locals arrLocal (.liveArray elems') with
                            | none => rw [hSetA] at hStep; cases hStep
                            | some slotsAfter =>
                              rw [hSetA] at hStep; dsimp at hStep
                              cases hWr : writeArrSliceBasePlace slotsAfter dstLocal dTy v with
                              | error _ => rw [hWr] at hStep; cases hStep
                              | ok ss => rw [hWr] at hStep; cases hStep; exact ⟨ss, rfl⟩
              | arrDead =>
                rw [hD, hA, hSl] at hStep; dsimp at hStep
                cases hEq2 : MirTy.beq dTy eTy with
                | false => rw [hEq2] at hStep; cases hStep
                | true => rw [hEq2] at hStep; cases hStep
              | _ =>
                rw [hD, hA, hSl] at hStep
                cases hStep
          | _ => rw [hD, hA] at hStep; cases hStep
      | _ => rw [hD] at hStep; cases hStep
  | writeArrayConst arrLocal idx rv =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hA : Trusted.MirSemantics.getElem? body.locals arrLocal with
    | none => rw [hA] at hStep; cases hStep
    | some ad =>
      cases ad with
      | array eTy len =>
        rw [hA] at hStep; dsimp at hStep
        cases hR : evalArrSliceBaseRvalue body.locals frame.locals eTy rv with
        | error _ => rw [hR] at hStep; cases hStep
        | ok p1 =>
          rw [hR] at hStep; dsimp at hStep
          cases hC : checkVal p1.1 eTy with
          | false => rw [hC] at hStep; cases hStep
          | true =>
            rw [hC] at hStep; dsimp at hStep
            cases hSl : Trusted.MirSemantics.getElem? p1.2 arrLocal with
            | none => rw [hSl] at hStep; cases hStep
            | some asl =>
              cases asl with
              | liveArray elems =>
                rw [hSl] at hStep; dsimp at hStep
                cases hLt : Nat.blt idx len with
                | false => rw [hLt] at hStep; cases hStep
                | true =>
                  rw [hLt] at hStep; dsimp at hStep
                  cases hSE : setElem? elems idx (some p1.1) with
                  | none => rw [hSE] at hStep; cases hStep
                  | some elems' =>
                    rw [hSE] at hStep; dsimp at hStep
                    cases hSA : setElem? p1.2 arrLocal (.liveArray elems') with
                    | none => rw [hSA] at hStep; cases hStep
                    | some ss => rw [hSA] at hStep; cases hStep; exact ⟨ss, rfl⟩
              | _ => rw [hSl] at hStep; cases hStep
      | _ => rw [hA] at hStep; cases hStep
  | unsizeArrayToSlice s arr =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hS : Trusted.MirSemantics.getElem? body.locals s with
    | none => rw [hS] at hStep; cases hStep
    | some sd =>
      cases sd with
      | sliceView sTy =>
        cases hA : Trusted.MirSemantics.getElem? body.locals arr with
        | none => rw [hS, hA] at hStep; cases hStep
        | some ad =>
          cases ad with
          | array aTy len =>
            rw [hS, hA] at hStep; dsimp at hStep
            cases hEq : MirTy.beq sTy aTy with
            | false => rw [hEq] at hStep; cases hStep
            | true =>
              rw [hEq] at hStep; dsimp at hStep
              cases hASl : Trusted.MirSemantics.getElem? frame.locals arr with
              | none => rw [hASl] at hStep; cases hStep
              | some asl =>
                cases asl with
                | liveArray _ =>
                  rw [hASl] at hStep; dsimp at hStep
                  cases hSSl : Trusted.MirSemantics.getElem? frame.locals s with
                  | none => rw [hSSl] at hStep; cases hStep
                  | some ssl =>
                    cases ssl with
                    | liveSlice _ =>
                      rw [hSSl] at hStep; dsimp at hStep
                      cases hSe : setElem? frame.locals s
                          (.liveSlice (some { backing := .arrayLocal arr, start := 0, len := len })) with
                      | none => rw [hSe] at hStep; cases hStep
                      | some ss => rw [hSe] at hStep; cases hStep; exact ⟨ss, rfl⟩
                    | _ => rw [hSSl] at hStep; cases hStep
                | _ => rw [hASl] at hStep; cases hStep
          | _ => rw [hS, hA] at hStep; cases hStep
      | _ => rw [hS] at hStep; cases hStep
  | sliceFromRawParts s lenOp =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hS : Trusted.MirSemantics.getElem? body.locals s with
    | none => rw [hS] at hStep; cases hStep
    | some sd =>
      cases sd with
      | sliceView _ =>
        rw [hS] at hStep; dsimp at hStep
        cases hU : evalUsizeOperand body.locals frame.locals lenOp with
        | error _ => rw [hU] at hStep; cases hStep
        | ok p1 =>
          rw [hU] at hStep; dsimp at hStep
          cases hSSl : Trusted.MirSemantics.getElem? p1.2 s with
          | none => rw [hSSl] at hStep; cases hStep
          | some ssl =>
            cases ssl with
            | liveSlice _ =>
              rw [hSSl] at hStep; dsimp at hStep
              cases hSe : setElem? p1.2 s
                  (.liveSlice (some { backing := .dangling, start := 0, len := p1.1 })) with
              | none => rw [hSe] at hStep; cases hStep
              | some ss => rw [hSe] at hStep; cases hStep; exact ⟨ss, rfl⟩
            | _ => rw [hSSl] at hStep; cases hStep
      | _ => rw [hS] at hStep; cases hStep
  | subslice dstS srcS fromIdx toIdx fromEnd =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dstS with
    | none => rw [hD] at hStep; cases hStep
    | some dd =>
      cases dd with
      | sliceView dTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals srcS with
        | none => rw [hD, hS] at hStep; cases hStep
        | some sd =>
          cases sd with
          | sliceView sTy =>
            cases hSSl : Trusted.MirSemantics.getElem? frame.locals srcS with
            | none => rw [hD, hS, hSSl] at hStep; cases hStep
            | some ssl =>
              rw [hD, hS, hSSl] at hStep; dsimp at hStep
              cases hCond : (!MirTy.beq dTy sTy || !Nat.blt fromIdx maxUsize || !Nat.blt toIdx maxUsize) with
              | true => rw [hCond] at hStep; cases hStep
              | false =>
                rw [hCond] at hStep; dsimp at hStep
                cases ssl with
                | liveSlice ov =>
                  cases ov with
                  | none => cases hStep
                  | some sv =>
                    dsimp at hStep
                    cases hSub : evalSubsliceVal sv fromIdx toIdx fromEnd with
                    | error _ => rw [hSub] at hStep; cases hStep
                    | ok sv' =>
                      rw [hSub] at hStep; dsimp at hStep
                      cases hDSl : Trusted.MirSemantics.getElem? frame.locals dstS with
                      | none => rw [hDSl] at hStep; cases hStep
                      | some dsl =>
                        cases dsl with
                        | liveSlice _ =>
                          rw [hDSl] at hStep; dsimp at hStep
                          cases hSe : setElem? frame.locals dstS (.liveSlice (some sv')) with
                          | none => rw [hSe] at hStep; cases hStep
                          | some ss => rw [hSe] at hStep; cases hStep; exact ⟨ss, rfl⟩
                        | _ => rw [hDSl] at hStep; cases hStep
                | _ => cases hStep
          | _ => rw [hD, hS] at hStep; cases hStep
      | _ => rw [hD] at hStep; cases hStep
  | ptrMetadata dstLocal sliceLocal =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dstLocal with
    | none => rw [hD] at hStep; cases hStep
    | some dd =>
      cases dd with
      | base dTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sliceLocal with
        | none => rw [hD, hS] at hStep; cases hStep
        | some sd =>
          cases sd with
          | sliceView _ =>
            cases hSSl : Trusted.MirSemantics.getElem? frame.locals sliceLocal with
            | none => rw [hD, hS, hSSl] at hStep; cases hStep
            | some ssl =>
              rw [hD, hS, hSSl] at hStep; dsimp at hStep
              cases hEq : MirTy.beq dTy usizeTy with
              | false => rw [hEq] at hStep; cases hStep
              | true =>
                rw [hEq] at hStep; dsimp at hStep
                cases ssl with
                | liveSlice ov =>
                  cases ov with
                  | none => cases hStep
                  | some sv =>
                    dsimp at hStep
                    cases hWr : writeArrSliceBasePlace frame.locals dstLocal dTy
                        (.scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩) with
                    | error _ => rw [hWr] at hStep; cases hStep
                    | ok ss => rw [hWr] at hStep; cases hStep; exact ⟨ss, rfl⟩
                | _ => cases hStep
          | _ => rw [hD, hS] at hStep; cases hStep
      | _ => rw [hD] at hStep; cases hStep

private theorem evalArrSliceStmt_preserves_sliceLocal
    {body : ArrSliceBody} {frame frame' : ArrSliceFrame}
    {cm cm' : CallerMemory} {st : ArrSliceStmt}
    {sLoc : LocalId} {sTy : MirTy}
    (hDecl : Trusted.MirSemantics.getElem? body.locals sLoc = some (.sliceView sTy))
    (hNoMod : stmtModifiesSlice sLoc st = false)
    (hStep : evalArrSliceStmt body frame cm st = .step { frames := [frame'], callerMem := cm' }) :
    Trusted.MirSemantics.getElem? frame'.locals sLoc =
      Trusted.MirSemantics.getElem? frame.locals sLoc := by
  cases st with
  | baseStmt b =>
    cases b with
    | nop => cases hStep; rfl
    | unsupported => cases hStep
    | storageLive id =>
      have hNe : id ≠ sLoc := by
        intro hEq
        change Nat.beq id sLoc = false at hNoMod
        rw [hEq, nat_beq_refl sLoc] at hNoMod
        cases hNoMod
      unfold evalArrSliceStmt at hStep; dsimp at hStep
      cases hG : Trusted.MirSemantics.getElem? body.locals id with
      | none => rw [hG] at hStep; cases hStep
      | some decl =>
        rw [hG] at hStep; dsimp at hStep
        cases hSet : setElem? frame.locals id (liveUninitArrSliceSlot decl) with
        | none => rw [hSet] at hStep; cases hStep
        | some ss =>
          rw [hSet] at hStep; cases hStep
          exact getElem?_setElem?_ne frame.locals id sLoc _ ss hNe hSet
    | storageDead id =>
      have hNe : id ≠ sLoc := by
        intro hEq
        change Nat.beq id sLoc = false at hNoMod
        rw [hEq, nat_beq_refl sLoc] at hNoMod
        cases hNoMod
      unfold evalArrSliceStmt at hStep; dsimp at hStep
      cases h0 : Nat.beq id 0 with
      | true => rw [h0] at hStep; cases hStep
      | false =>
        rw [h0] at hStep; dsimp at hStep
        cases hDeclId : Trusted.MirSemantics.getElem? body.locals id with
        | none =>
          rw [hDeclId] at hStep; dsimp at hStep
          cases hSet : setElem? frame.locals id (.baseSlot .dead) with
          | none => rw [hSet] at hStep; cases hStep
          | some ss =>
            rw [hSet] at hStep; cases hStep
            exact getElem?_setElem?_ne frame.locals id sLoc _ ss hNe hSet
        | some decl =>
          rw [hDeclId] at hStep; dsimp at hStep
          cases hSet : setElem? frame.locals id (deadArrSliceSlot decl) with
          | none => rw [hSet] at hStep; cases hStep
          | some ss =>
            rw [hSet] at hStep; cases hStep
            exact getElem?_setElem?_ne frame.locals id sLoc _ ss hNe hSet
    | assign dst rv =>
      unfold evalArrSliceStmt at hStep; dsimp at hStep
      cases hEmpty : dst.projection.isEmpty with
      | false => rw [hEmpty] at hStep; cases hStep
      | true =>
        rw [hEmpty] at hStep; dsimp at hStep
        cases hDst : Trusted.MirSemantics.getElem? body.locals dst.localId with
        | none => rw [hDst] at hStep; cases hStep
        | some dDecl =>
          cases dDecl with
          | base dstTy =>
            have hNe : dst.localId ≠ sLoc := by
              intro hEq; rw [hEq, hDecl] at hDst; cases hDst
            rw [hDst] at hStep; dsimp at hStep
            cases hRv : evalArrSliceBaseRvalue body.locals frame.locals dstTy rv with
            | error _ => rw [hRv] at hStep; cases hStep
            | ok p1 =>
              rw [hRv] at hStep; dsimp at hStep
              cases hWr : writeArrSliceBasePlace p1.2 dst.localId dstTy p1.1 with
              | error _ => rw [hWr] at hStep; cases hStep
              | ok ss =>
                rw [hWr] at hStep; cases hStep
                have hW := s2_writeArrSliceBasePlace_preserves_ne hNe hWr
                have hR := evalArrSliceBaseRvalue_preserves_sliceLocal hDecl hRv
                rw [hW, hR]
          | _ => rw [hDst] at hStep; cases hStep
  | aggregateArray arrLoc ops =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hArr : Trusted.MirSemantics.getElem? body.locals arrLoc with
    | none => rw [hArr] at hStep; cases hStep
    | some aDecl =>
      cases aDecl with
      | array elemTy len =>
        have hNe : arrLoc ≠ sLoc := by
          intro hEq; rw [hEq, hDecl] at hArr; cases hArr
        rw [hArr] at hStep; dsimp at hStep
        cases hLen : Nat.beq ops.length len with
        | false => rw [hLen] at hStep; cases hStep
        | true =>
          rw [hLen] at hStep; dsimp at hStep
          cases hOps : evalArrSliceTypedOps body.locals elemTy frame.locals ops with
          | error _ => rw [hOps] at hStep; cases hStep
          | ok p1 =>
            rw [hOps] at hStep; dsimp at hStep
            cases hSl : Trusted.MirSemantics.getElem? p1.2 arrLoc with
            | none => rw [hSl] at hStep; cases hStep
            | some arrSl =>
              cases arrSl with
              | liveArray _ =>
                rw [hSl] at hStep; dsimp at hStep
                cases hSet : setElem? p1.2 arrLoc (.liveArray (p1.1.map some)) with
                | none => rw [hSet] at hStep; cases hStep
                | some ss =>
                  rw [hSet] at hStep; cases hStep
                  have hS := getElem?_setElem?_ne p1.2 arrLoc sLoc _ ss hNe hSet
                  have hO := evalArrSliceTypedOps_preserves_sliceLocal hDecl elemTy
                    ops frame.locals p1.2 p1.1 hOps
                  rw [hS, hO]
              | _ => rw [hSl] at hStep; cases hStep
      | _ => rw [hArr] at hStep; cases hStep
  | repeatArray arrLoc op =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hArr : Trusted.MirSemantics.getElem? body.locals arrLoc with
    | none => rw [hArr] at hStep; cases hStep
    | some aDecl =>
      cases aDecl with
      | array elemTy len =>
        have hNe : arrLoc ≠ sLoc := by
          intro hEq; rw [hEq, hDecl] at hArr; cases hArr
        rw [hArr] at hStep; dsimp at hStep
        cases hOp : evalArrSliceTypedOperand body.locals frame.locals elemTy op with
        | error _ => rw [hOp] at hStep; cases hStep
        | ok p1 =>
          rw [hOp] at hStep; dsimp at hStep
          cases hSl : Trusted.MirSemantics.getElem? p1.2 arrLoc with
          | none => rw [hSl] at hStep; cases hStep
          | some arrSl =>
            cases arrSl with
            | liveArray _ =>
              rw [hSl] at hStep; dsimp at hStep
              cases hSet : setElem? p1.2 arrLoc (.liveArray (listReplicate len (some p1.1))) with
              | none => rw [hSet] at hStep; cases hStep
              | some ss =>
                rw [hSet] at hStep; cases hStep
                have hS := getElem?_setElem?_ne p1.2 arrLoc sLoc _ ss hNe hSet
                have hO := evalArrSliceTypedOperand_preserves_sliceLocal hDecl hOp
                rw [hS, hO]
            | _ => rw [hSl] at hStep; cases hStep
      | _ => rw [hArr] at hStep; cases hStep
  | arrayLivenessCheck arrLoc =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hArr : Trusted.MirSemantics.getElem? body.locals arrLoc with
    | none => rw [hArr] at hStep; cases hStep
    | some aDecl =>
      cases aDecl with
      | array _ _ =>
        cases hSl : Trusted.MirSemantics.getElem? frame.locals arrLoc with
        | none => rw [hArr, hSl] at hStep; cases hStep
        | some arrSl =>
          cases arrSl with
          | liveArray _ => rw [hArr, hSl] at hStep; cases hStep; rfl
          | _ => rw [hArr, hSl] at hStep; cases hStep
      | _ => rw [hArr] at hStep; cases hStep
  | readArrayConst dstLocal arrLocal idx isMove =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hDst : Trusted.MirSemantics.getElem? body.locals dstLocal with
    | none => rw [hDst] at hStep; cases hStep
    | some dDecl =>
      cases dDecl with
      | base dstTy =>
        have hNeDst : dstLocal ≠ sLoc := by
          intro hEq; rw [hEq, hDecl] at hDst; cases hDst
        cases hArr : Trusted.MirSemantics.getElem? body.locals arrLocal with
        | none => rw [hDst, hArr] at hStep; cases hStep
        | some aDecl =>
          cases aDecl with
          | array elemTy len =>
            have hNeArr : arrLocal ≠ sLoc := by
              intro hEq; rw [hEq, hDecl] at hArr; cases hArr
            cases hSl : Trusted.MirSemantics.getElem? frame.locals arrLocal with
            | none => rw [hDst, hArr, hSl] at hStep; cases hStep
            | some arrSl =>
              cases arrSl with
              | liveArray elems =>
                rw [hDst, hArr, hSl] at hStep; dsimp at hStep
                cases hEq : MirTy.beq dstTy elemTy with
                | false => rw [hEq] at hStep; cases hStep
                | true =>
                  rw [hEq] at hStep; dsimp at hStep
                  cases hLt : Nat.blt idx len with
                  | false => rw [hLt] at hStep; cases hStep
                  | true =>
                    rw [hLt] at hStep; dsimp at hStep
                    cases hEl : Trusted.MirSemantics.getElem? elems idx with
                    | none => rw [hEl] at hStep; cases hStep
                    | some ov =>
                      cases ov with
                      | none => rw [hEl] at hStep; cases hStep
                      | some v =>
                        rw [hEl] at hStep; dsimp at hStep
                        cases isMove with
                        | false =>
                          dsimp at hStep
                          cases hWr : writeArrSliceBasePlace frame.locals dstLocal dstTy v with
                          | error _ => rw [hWr] at hStep; cases hStep
                          | ok ss =>
                            rw [hWr] at hStep; cases hStep
                            exact s2_writeArrSliceBasePlace_preserves_ne hNeDst hWr
                        | true =>
                          dsimp at hStep
                          cases hSetE : setElem? elems idx (initElemOptVal elemTy) with
                          | none => rw [hSetE] at hStep; cases hStep
                          | some elems' =>
                            rw [hSetE] at hStep; dsimp at hStep
                            cases hSetA : setElem? frame.locals arrLocal (.liveArray elems') with
                            | none => rw [hSetA] at hStep; cases hStep
                            | some slotsAfterRead =>
                              rw [hSetA] at hStep; dsimp at hStep
                              cases hWr : writeArrSliceBasePlace slotsAfterRead dstLocal dstTy v with
                              | error _ => rw [hWr] at hStep; cases hStep
                              | ok ss =>
                                rw [hWr] at hStep; cases hStep
                                have hW := s2_writeArrSliceBasePlace_preserves_ne hNeDst hWr
                                have hA := getElem?_setElem?_ne frame.locals arrLocal sLoc _
                                  slotsAfterRead hNeArr hSetA
                                rw [hW, hA]
              | arrDead =>
                rw [hDst, hArr, hSl] at hStep; dsimp at hStep
                cases hEq2 : MirTy.beq dstTy elemTy with
                | false => rw [hEq2] at hStep; cases hStep
                | true => rw [hEq2] at hStep; cases hStep
              | _ =>
                rw [hDst, hArr, hSl] at hStep
                cases hStep
          | _ => rw [hDst, hArr] at hStep; cases hStep
      | _ => rw [hDst] at hStep; cases hStep
  | writeArrayConst arrLocal idx rval =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hArr : Trusted.MirSemantics.getElem? body.locals arrLocal with
    | none => rw [hArr] at hStep; cases hStep
    | some aDecl =>
      cases aDecl with
      | array elemTy len =>
        have hNeArr : arrLocal ≠ sLoc := by
          intro hEq; rw [hEq, hDecl] at hArr; cases hArr
        rw [hArr] at hStep; dsimp at hStep
        cases hRv : evalArrSliceBaseRvalue body.locals frame.locals elemTy rval with
        | error _ => rw [hRv] at hStep; cases hStep
        | ok p1 =>
          rw [hRv] at hStep; dsimp at hStep
          cases hChk : checkVal p1.1 elemTy with
          | false => rw [hChk] at hStep; cases hStep
          | true =>
            rw [hChk] at hStep; dsimp at hStep
            cases hSl : Trusted.MirSemantics.getElem? p1.2 arrLocal with
            | none => rw [hSl] at hStep; cases hStep
            | some arrSl =>
              cases arrSl with
              | liveArray elems =>
                rw [hSl] at hStep; dsimp at hStep
                cases hLt : Nat.blt idx len with
                | false => rw [hLt] at hStep; cases hStep
                | true =>
                  rw [hLt] at hStep; dsimp at hStep
                  cases hSetE : setElem? elems idx (some p1.1) with
                  | none => rw [hSetE] at hStep; cases hStep
                  | some elems' =>
                    rw [hSetE] at hStep; dsimp at hStep
                    cases hSetA : setElem? p1.2 arrLocal (.liveArray elems') with
                    | none => rw [hSetA] at hStep; cases hStep
                    | some ss =>
                      rw [hSetA] at hStep; cases hStep
                      have hA := getElem?_setElem?_ne p1.2 arrLocal sLoc _ ss hNeArr hSetA
                      have hR := evalArrSliceBaseRvalue_preserves_sliceLocal hDecl hRv
                      rw [hA, hR]
              | _ => rw [hSl] at hStep; cases hStep
      | _ => rw [hArr] at hStep; cases hStep
  | unsizeArrayToSlice s arr =>
    have hNe : s ≠ sLoc := by
      intro hEq
      change Nat.beq s sLoc = false at hNoMod
      rw [hEq, nat_beq_refl sLoc] at hNoMod
      cases hNoMod
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hS : Trusted.MirSemantics.getElem? body.locals s with
    | none => rw [hS] at hStep; cases hStep
    | some sD =>
      cases sD with
      | sliceView _ =>
        cases hA : Trusted.MirSemantics.getElem? body.locals arr with
        | none => rw [hS, hA] at hStep; cases hStep
        | some aD =>
          cases aD with
          | array _ len =>
            rw [hS, hA] at hStep; dsimp at hStep
            cases hTyEq : MirTy.beq _ _ with
            | false => rw [hTyEq] at hStep; cases hStep
            | true =>
              rw [hTyEq] at hStep; dsimp at hStep
              cases hASl : Trusted.MirSemantics.getElem? frame.locals arr with
              | none => rw [hASl] at hStep; cases hStep
              | some arrSl =>
                cases arrSl with
                | liveArray _ =>
                  rw [hASl] at hStep; dsimp at hStep
                  cases hSSl : Trusted.MirSemantics.getElem? frame.locals s with
                  | none => rw [hSSl] at hStep; cases hStep
                  | some sliceSl =>
                    cases sliceSl with
                    | liveSlice _ =>
                      rw [hSSl] at hStep; dsimp at hStep
                      cases hSet : setElem? frame.locals s
                          (.liveSlice (some { backing := .arrayLocal arr, start := 0, len := len })) with
                      | none => rw [hSet] at hStep; cases hStep
                      | some ss =>
                        rw [hSet] at hStep; cases hStep
                        exact getElem?_setElem?_ne frame.locals s sLoc _ ss hNe hSet
                    | _ => rw [hSSl] at hStep; cases hStep
                | _ => rw [hASl] at hStep; cases hStep
          | _ => rw [hS, hA] at hStep; cases hStep
      | _ => rw [hS] at hStep; cases hStep
  | sliceFromRawParts s lenOp =>
    have hNe : s ≠ sLoc := by
      intro hEq
      change Nat.beq s sLoc = false at hNoMod
      rw [hEq, nat_beq_refl sLoc] at hNoMod
      cases hNoMod
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hS : Trusted.MirSemantics.getElem? body.locals s with
    | none => rw [hS] at hStep; cases hStep
    | some sD =>
      cases sD with
      | sliceView _ =>
        rw [hS] at hStep; dsimp at hStep
        cases hLen : evalUsizeOperand body.locals frame.locals lenOp with
        | error _ => rw [hLen] at hStep; cases hStep
        | ok p1 =>
          rw [hLen] at hStep; dsimp at hStep
          cases hSSl : Trusted.MirSemantics.getElem? p1.2 s with
          | none => rw [hSSl] at hStep; cases hStep
          | some sliceSl =>
            cases sliceSl with
            | liveSlice _ =>
              rw [hSSl] at hStep; dsimp at hStep
              cases hSet : setElem? p1.2 s
                  (.liveSlice (some { backing := .dangling, start := 0, len := p1.1 })) with
              | none => rw [hSet] at hStep; cases hStep
              | some ss =>
                rw [hSet] at hStep; cases hStep
                have hW := getElem?_setElem?_ne p1.2 s sLoc _ ss hNe hSet
                have hL := evalUsizeOperand_preserves_sliceLocal hDecl hLen
                rw [hW, hL]
            | _ => rw [hSSl] at hStep; cases hStep
      | _ => rw [hS] at hStep; cases hStep
  | subslice dstS srcS fromIdx toIdx fromEnd =>
    have hNe : dstS ≠ sLoc := by
      intro hEq
      change Nat.beq dstS sLoc = false at hNoMod
      rw [hEq, nat_beq_refl sLoc] at hNoMod
      cases hNoMod
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dstS with
    | none => rw [hD] at hStep; cases hStep
    | some dDecl =>
      cases dDecl with
      | sliceView dstTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals srcS with
        | none => rw [hD, hS] at hStep; cases hStep
        | some sDecl =>
          cases sDecl with
          | sliceView srcTy =>
            cases hSSl : Trusted.MirSemantics.getElem? frame.locals srcS with
            | none => rw [hD, hS, hSSl] at hStep; cases hStep
            | some srcSl =>
              rw [hD, hS, hSSl] at hStep; dsimp at hStep
              cases hCond : (!MirTy.beq dstTy srcTy || !Nat.blt fromIdx maxUsize || !Nat.blt toIdx maxUsize) with
              | true => rw [hCond] at hStep; cases hStep
              | false =>
                rw [hCond] at hStep; dsimp at hStep
                cases srcSl with
                | liveSlice ov =>
                  cases ov with
                  | none => cases hStep
                  | some sv =>
                    dsimp at hStep
                    cases hEvSub : evalSubsliceVal sv fromIdx toIdx fromEnd with
                    | error _ => rw [hEvSub] at hStep; cases hStep
                    | ok sv' =>
                      rw [hEvSub] at hStep; dsimp at hStep
                      cases hDSl : Trusted.MirSemantics.getElem? frame.locals dstS with
                      | none => rw [hDSl] at hStep; cases hStep
                      | some dstSl =>
                        cases dstSl with
                        | liveSlice _ =>
                          rw [hDSl] at hStep; dsimp at hStep
                          cases hSet : setElem? frame.locals dstS (.liveSlice (some sv')) with
                          | none => rw [hSet] at hStep; cases hStep
                          | some ss =>
                            rw [hSet] at hStep; cases hStep
                            exact getElem?_setElem?_ne frame.locals dstS sLoc _ ss hNe hSet
                        | _ => rw [hDSl] at hStep; cases hStep
                | _ => cases hStep
          | _ => rw [hD, hS] at hStep; cases hStep
      | _ => rw [hD] at hStep; cases hStep
  | ptrMetadata dstLocal sliceLocal =>
    unfold evalArrSliceStmt at hStep; dsimp at hStep
    cases hDst : Trusted.MirSemantics.getElem? body.locals dstLocal with
    | none => rw [hDst] at hStep; cases hStep
    | some dDecl =>
      cases dDecl with
      | base dstTy =>
        have hNe : dstLocal ≠ sLoc := by
          intro hEq; rw [hEq, hDecl] at hDst; cases hDst
        cases hS : Trusted.MirSemantics.getElem? body.locals sliceLocal with
        | none => rw [hDst, hS] at hStep; cases hStep
        | some sDecl =>
          cases sDecl with
          | sliceView _ =>
            cases hSSl : Trusted.MirSemantics.getElem? frame.locals sliceLocal with
            | none => rw [hDst, hS, hSSl] at hStep; cases hStep
            | some sliceSl =>
              rw [hDst, hS, hSSl] at hStep; dsimp at hStep
              cases hTyEq : MirTy.beq dstTy usizeTy with
              | false => rw [hTyEq] at hStep; cases hStep
              | true =>
                rw [hTyEq] at hStep; dsimp at hStep
                cases sliceSl with
                | liveSlice ov =>
                  cases ov with
                  | none => cases hStep
                  | some sv =>
                    dsimp at hStep
                    cases hWr : writeArrSliceBasePlace frame.locals dstLocal dstTy
                        (.scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩) with
                    | error _ => rw [hWr] at hStep; cases hStep
                    | ok ss =>
                      rw [hWr] at hStep; cases hStep
                      exact s2_writeArrSliceBasePlace_preserves_ne hNe hWr
                | _ => cases hStep
          | _ => rw [hDst, hS] at hStep; cases hStep
      | _ => rw [hDst] at hStep; cases hStep

private theorem evalReadArrayAtIdx_step_stmtIdx_zero
    {body : ArrSliceBody} {frame : ArrSliceFrame} {cm : CallerMemory}
    {slots : List ArrSliceSlot} {dstLocal arrLocal : LocalId}
    {effIdx : Nat} {nextBb : BasicBlockId} {s' : ArrSliceState}
    (hStep : evalReadArrayAtIdx body frame cm slots dstLocal arrLocal effIdx nextBb = .step s') :
    ∃ f' : ArrSliceFrame, s'.frames = [f'] ∧ f'.stmtIdx = 0 := by
  unfold evalReadArrayAtIdx at hStep
  cases hD : Trusted.MirSemantics.getElem? body.locals dstLocal with
  | none => rw [hD] at hStep; cases hStep
  | some dd =>
    cases dd with
    | base dTy =>
      cases hA : Trusted.MirSemantics.getElem? body.locals arrLocal with
      | none => rw [hD, hA] at hStep; cases hStep
      | some ad =>
        cases ad with
        | array eTy len =>
          cases hSl : Trusted.MirSemantics.getElem? slots arrLocal with
          | none => rw [hD, hA, hSl] at hStep; cases hStep
          | some asl =>
            rw [hD, hA, hSl] at hStep; dsimp at hStep
            cases hEq : MirTy.beq dTy eTy with
            | false => rw [hEq] at hStep; cases hStep
            | true =>
              rw [hEq] at hStep; dsimp at hStep
              cases asl with
              | liveArray elems =>
                dsimp at hStep
                cases hLt : Nat.blt effIdx len with
                | false => rw [hLt] at hStep; cases hStep
                | true =>
                  rw [hLt] at hStep; dsimp at hStep
                  cases hEl : Trusted.MirSemantics.getElem? elems effIdx with
                  | none => rw [hEl] at hStep; cases hStep
                  | some ov =>
                    cases ov with
                    | none => rw [hEl] at hStep; cases hStep
                    | some v =>
                      rw [hEl] at hStep; dsimp at hStep
                      cases hWr : writeArrSliceBasePlace slots dstLocal dTy v with
                      | error _ => rw [hWr] at hStep; cases hStep
                      | ok ss =>
                        rw [hWr] at hStep; cases hStep
                        exact ⟨{ frame with blockIdx := nextBb, stmtIdx := 0, locals := ss }, rfl, rfl⟩
              | _ => dsimp at hStep; cases hStep
        | _ => rw [hD, hA] at hStep; cases hStep
    | _ => rw [hD] at hStep; cases hStep

private theorem evalArrSliceTerm_step_stmtIdx_zero
    {body : ArrSliceBody} {bb : ArrSliceBlock} {frame : ArrSliceFrame}
    {cm : CallerMemory} {s' : ArrSliceState}
    (hStep : evalArrSliceTerm body bb frame cm = .step s') :
    ∃ f' : ArrSliceFrame, s'.frames = [f'] ∧ f'.stmtIdx = 0 := by
  unfold evalArrSliceTerm at hStep
  cases hTerm : bb.terminator with
  | baseTerm bt =>
    rw [hTerm] at hStep
    cases bt with
    | goto target =>
      cases hStep
      exact ⟨{ frame with blockIdx := target, stmtIdx := 0, locals := frame.locals }, rfl, rfl⟩
    | return_ =>
      dsimp at hStep
      cases hCl : bb.cleanup with
      | true => rw [hCl] at hStep; cases hStep
      | false =>
        rw [hCl] at hStep; dsimp at hStep
        cases hG : Trusted.MirSemantics.getElem? frame.locals 0 with
        | none => rw [hG] at hStep; cases hStep
        | some sl =>
          cases sl with
          | baseSlot bsl =>
            cases bsl with
            | dead => rw [hG] at hStep; cases hStep
            | live ov =>
              cases ov with
              | none => rw [hG] at hStep; cases hStep
              | some _ => rw [hG] at hStep; cases hStep
          | _ => rw [hG] at hStep; cases hStep
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      cases hStep
    | switchInt discr targets =>
      dsimp at hStep
      cases hPr : evalArrSlicePrimitiveOperand body.locals frame.locals discr with
      | error _ => rw [hPr] at hStep; cases hStep
      | ok p1 =>
        rw [hPr] at hStep; dsimp at hStep
        cases p1 with
        | mk pVal pSlots =>
          dsimp at hStep
          cases pVal with
          | scalar sv =>
            dsimp at hStep
            cases hSw : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
            | error _ => rw [hSw] at hStep; cases hStep
            | ok target =>
              rw [hSw] at hStep; cases hStep
              exact ⟨{ frame with blockIdx := target, stmtIdx := 0, locals := pSlots }, rfl, rfl⟩
          | bool b =>
            dsimp at hStep
            cases hSw : evalBoolSwitchBranches b targets.otherwise targets.branches with
            | error _ => rw [hSw] at hStep; cases hStep
            | ok target =>
              rw [hSw] at hStep; cases hStep
              exact ⟨{ frame with blockIdx := target, stmtIdx := 0, locals := pSlots }, rfl, rfl⟩
          | _ => dsimp at hStep; cases hStep
  | sliceLenCall dst sLoc target =>
    rw [hTerm] at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at hStep; cases hStep
    | some dd =>
      cases dd with
      | base dTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hD, hS] at hStep; cases hStep
        | some sd =>
          cases sd with
          | sliceView _ =>
            cases hSl : Trusted.MirSemantics.getElem? frame.locals sLoc with
            | none => rw [hD, hS, hSl] at hStep; cases hStep
            | some ssl =>
              rw [hD, hS, hSl] at hStep; dsimp at hStep
              cases hEq : MirTy.beq dTy usizeTy with
              | false => rw [hEq] at hStep; cases hStep
              | true =>
                rw [hEq] at hStep; dsimp at hStep
                cases ssl with
                | liveSlice ov =>
                  cases ov with
                  | none => cases hStep
                  | some sv =>
                    dsimp at hStep
                    cases hWr : writeArrSliceBasePlace frame.locals dst dTy _ with
                    | error _ => rw [hWr] at hStep; cases hStep
                    | ok ss =>
                      rw [hWr] at hStep; cases hStep
                      exact ⟨{ frame with blockIdx := target, stmtIdx := 0, locals := ss }, rfl, rfl⟩
                | _ => cases hStep
          | _ => rw [hD, hS] at hStep; cases hStep
      | _ => rw [hD] at hStep; cases hStep
  | boundsCheckArray aLoc idxOp inBb panicBb =>
    rw [hTerm] at hStep; dsimp at hStep
    cases hA : Trusted.MirSemantics.getElem? body.locals aLoc with
    | none => rw [hA] at hStep; cases hStep
    | some ad =>
      cases ad with
      | array _ _ =>
        cases hSl : Trusted.MirSemantics.getElem? frame.locals aLoc with
        | none => rw [hA, hSl] at hStep; cases hStep
        | some asl =>
          cases asl with
          | liveArray _ =>
            rw [hA, hSl] at hStep; dsimp at hStep
            cases hU : evalUsizeOperand body.locals frame.locals idxOp with
            | error _ => rw [hU] at hStep; cases hStep
            | ok p1 =>
              rw [hU] at hStep; cases hStep
              exact ⟨{ frame with blockIdx := _, stmtIdx := 0, locals := p1.2 }, rfl, rfl⟩
          | _ => rw [hA, hSl] at hStep; cases hStep
      | _ => rw [hA] at hStep; cases hStep
  | boundsCheckSlice sLoc idxOp inBb panicBb =>
    rw [hTerm] at hStep; dsimp at hStep
    cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
    | none => rw [hS] at hStep; cases hStep
    | some sd =>
      cases sd with
      | sliceView _ =>
        cases hSl : Trusted.MirSemantics.getElem? frame.locals sLoc with
        | none => rw [hS, hSl] at hStep; cases hStep
        | some ssl =>
          cases ssl with
          | liveSlice ov =>
            cases ov with
            | none => rw [hS, hSl] at hStep; cases hStep
            | some _ =>
              rw [hS, hSl] at hStep; dsimp at hStep
              cases hU : evalUsizeOperand body.locals frame.locals idxOp with
              | error _ => rw [hU] at hStep; cases hStep
              | ok p1 =>
                rw [hU] at hStep; cases hStep
                exact ⟨{ frame with blockIdx := _, stmtIdx := 0, locals := p1.2 }, rfl, rfl⟩
          | _ => rw [hS, hSl] at hStep; cases hStep
      | _ => rw [hS] at hStep; cases hStep
  | readArrayElem dst aLoc idxOp nextBb =>
    rw [hTerm] at hStep; dsimp at hStep
    cases hU : evalUsizeOperand body.locals frame.locals idxOp with
    | error _ => rw [hU] at hStep; cases hStep
    | ok _ =>
      rw [hU] at hStep; dsimp at hStep
      exact evalReadArrayAtIdx_step_stmtIdx_zero hStep
  | writeArrayElem aLoc idxOp valOp nextBb =>
    rw [hTerm] at hStep; dsimp at hStep
    cases hA : Trusted.MirSemantics.getElem? body.locals aLoc with
    | none => rw [hA] at hStep; cases hStep
    | some ad =>
      cases ad with
      | array eTy len =>
        rw [hA] at hStep; dsimp at hStep
        cases hU : evalUsizeOperand body.locals frame.locals idxOp with
        | error _ => rw [hU] at hStep; cases hStep
        | ok p1 =>
          rw [hU] at hStep; dsimp at hStep
          cases hV : evalArrSliceTypedOperand body.locals p1.2 eTy valOp with
          | error _ => rw [hV] at hStep; cases hStep
          | ok p2 =>
            rw [hV] at hStep; dsimp at hStep
            cases hSl : Trusted.MirSemantics.getElem? p2.2 aLoc with
            | none => rw [hSl] at hStep; cases hStep
            | some asl =>
              cases asl with
              | liveArray elems =>
                rw [hSl] at hStep; dsimp at hStep
                cases hLt : Nat.blt p1.1 len with
                | false => rw [hLt] at hStep; cases hStep
                | true =>
                  rw [hLt] at hStep; dsimp at hStep
                  cases hSE : setElem? elems p1.1 (some p2.1) with
                  | none => rw [hSE] at hStep; cases hStep
                  | some elems' =>
                    rw [hSE] at hStep; dsimp at hStep
                    cases hSA : setElem? p2.2 aLoc (.liveArray elems') with
                    | none => rw [hSA] at hStep; cases hStep
                    | some ss =>
                      rw [hSA] at hStep; cases hStep
                      exact ⟨{ frame with blockIdx := nextBb, stmtIdx := 0, locals := ss }, rfl, rfl⟩
              | _ => rw [hSl] at hStep; cases hStep
      | _ => rw [hA] at hStep; cases hStep
  | readSliceElem dst sLoc idxOp nextBb =>
    rw [hTerm] at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at hStep; cases hStep
    | some dd =>
      cases dd with
      | base dTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hD, hS] at hStep; cases hStep
        | some sd =>
          cases sd with
          | sliceView eTy =>
            cases hSl : Trusted.MirSemantics.getElem? frame.locals sLoc with
            | none => rw [hD, hS, hSl] at hStep; cases hStep
            | some ssl =>
              rw [hD, hS, hSl] at hStep; dsimp at hStep
              cases hEq : MirTy.beq dTy eTy with
              | false => rw [hEq] at hStep; cases hStep
              | true =>
                rw [hEq] at hStep; dsimp at hStep
                cases ssl with
                | liveSlice ov =>
                  cases ov with
                  | none => cases hStep
                  | some sv =>
                    dsimp at hStep
                    cases hU : evalUsizeOperand body.locals frame.locals idxOp with
                    | error _ => rw [hU] at hStep; cases hStep
                    | ok p1 =>
                      rw [hU] at hStep; dsimp at hStep
                      cases hLt : Nat.blt p1.1 sv.len with
                      | false => rw [hLt] at hStep; cases hStep
                      | true =>
                        rw [hLt] at hStep; dsimp at hStep
                        cases hBk : sv.backing with
                        | dangling => rw [hBk] at hStep; cases hStep
                        | arrayLocal _ =>
                          rw [hBk] at hStep; dsimp at hStep
                          cases hB : Nat.blt (sv.start + p1.1) maxUsize with
                          | false => rw [hB] at hStep; cases hStep
                          | true =>
                            rw [hB] at hStep; dsimp at hStep
                            exact evalReadArrayAtIdx_step_stmtIdx_zero hStep
                | _ => cases hStep
          | _ => rw [hD, hS] at hStep; cases hStep
      | _ => rw [hD] at hStep; cases hStep
  | readSliceConst dst sLoc offset minLen fromEnd nextBb =>
    rw [hTerm] at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dst with
    | none => rw [hD] at hStep; cases hStep
    | some dd =>
      cases dd with
      | base dTy =>
        cases hS : Trusted.MirSemantics.getElem? body.locals sLoc with
        | none => rw [hD, hS] at hStep; cases hStep
        | some sd =>
          cases sd with
          | sliceView eTy =>
            cases hSl : Trusted.MirSemantics.getElem? frame.locals sLoc with
            | none => rw [hD, hS, hSl] at hStep; cases hStep
            | some ssl =>
              rw [hD, hS, hSl] at hStep; dsimp at hStep
              cases hCond : (!MirTy.beq dTy eTy || !Nat.blt offset maxUsize || !Nat.blt minLen maxUsize) with
              | true => rw [hCond] at hStep; cases hStep
              | false =>
                rw [hCond] at hStep; dsimp at hStep
                cases ssl with
                | liveSlice ov =>
                  cases ov with
                  | none => cases hStep
                  | some sv =>
                    dsimp at hStep
                    cases hRel : evalSliceConstRelIdx sv.len offset minLen fromEnd with
                    | error _ => rw [hRel] at hStep; cases hStep
                    | ok relIdx =>
                      rw [hRel] at hStep; dsimp at hStep
                      cases hBk : sv.backing with
                      | dangling => rw [hBk] at hStep; cases hStep
                      | arrayLocal _ =>
                        rw [hBk] at hStep; dsimp at hStep
                        cases hB : Nat.blt (sv.start + relIdx) maxUsize with
                        | false => rw [hB] at hStep; cases hStep
                        | true =>
                          rw [hB] at hStep; dsimp at hStep
                          exact evalReadArrayAtIdx_step_stmtIdx_zero hStep
                | _ => cases hStep
          | _ => rw [hD, hS] at hStep; cases hStep
      | _ => rw [hD] at hStep; cases hStep

private noncomputable def validStmtIdxInSrc (pSrc : ArrSliceProgram)
    (s : ArrSliceState) : Prop :=
  match s.frames with
  | [frame] =>
    match Trusted.MirSemantics.getElem? pSrc.bodies frame.defId with
    | some body =>
      match Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
      | some bb => frame.stmtIdx ≤ bb.statements.length
      | none => True
    | none => True
  | _ => True

private theorem validStmtIdxInSrc_of_stmtIdx_zero
    (pSrc : ArrSliceProgram) (s : ArrSliceState) (f : ArrSliceFrame)
    (hFrames : s.frames = [f]) (hZero : f.stmtIdx = 0) :
    validStmtIdxInSrc pSrc s := by
  unfold validStmtIdxInSrc
  rw [hFrames]
  dsimp
  cases Trusted.MirSemantics.getElem? pSrc.bodies f.defId with
  | none => exact True.intro
  | some body =>
    dsimp
    cases Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
    | none => exact True.intro
    | some _ =>
      dsimp
      rw [hZero]
      exact Nat.zero_le _

private theorem evalStepArrSlice_preserves_validStmtIdx
    (pSrc : ArrSliceProgram) {s s' : ArrSliceState}
    (hStep : evalStepArrSlice pSrc 0 s = .step s') :
    validStmtIdxInSrc pSrc s' := by
  unfold evalStepArrSlice at hStep
  cases hFr : s.frames with
  | nil => rw [hFr] at hStep; cases hStep
  | cons frame rest =>
    cases rest with
    | cons _ _ => rw [hFr] at hStep; cases hStep
    | nil =>
      rw [hFr] at hStep; dsimp at hStep
      cases hB : Trusted.MirSemantics.getElem? pSrc.bodies frame.defId with
      | none => rw [hB] at hStep; cases hStep
      | some body =>
        rw [hB] at hStep; dsimp at hStep
        cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
        | none => rw [hBb] at hStep; cases hStep
        | some bb =>
          rw [hBb] at hStep; dsimp at hStep
          cases hSt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
          | some st =>
            rw [hSt] at hStep; dsimp at hStep
            cases evalArrSliceStmt_step_frames hStep with
            | intro slots' hEqS' =>
              have hLt : frame.stmtIdx < bb.statements.length := getElem?_some_lt _ _ _ hSt
              rw [hEqS']
              unfold validStmtIdxInSrc
              dsimp
              rw [hB]; dsimp
              rw [hBb]; dsimp
              exact hLt
          | none =>
            rw [hSt] at hStep; dsimp at hStep
            cases hLen : Nat.beq frame.stmtIdx bb.statements.length with
            | false => rw [hLen] at hStep; cases hStep
            | true =>
              rw [hLen] at hStep; dsimp at hStep
              cases evalArrSliceTerm_step_stmtIdx_zero hStep with
              | intro f' hf' =>
                exact validStmtIdxInSrc_of_stmtIdx_zero pSrc s' f' hf'.1 hf'.2

private theorem list_all_setElem?_preserve {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (i : Nat) (x y : α) (xs' : List α),
      setElem? xs i y = some xs' →
      Trusted.MirSemantics.getElem? xs i = some x →
      p x = true → p y = true →
      xs'.all p = xs.all p
  | [], _, _, _, _, hSet, _, _, _ => by cases hSet
  | z :: xs, 0, x, y, xs', hSet, hGet, hPx, hPy => by
    cases hGet; cases hSet
    change (p y && xs.all p) = (p z && xs.all p)
    rw [hPx, hPy]
  | z :: xs, i + 1, x, y, xs', hSet, hGet, hPx, hPy => by
    cases hSub : setElem? xs i y with
    | none =>
      change (match setElem? xs i y with | some zs => some (z :: zs) | none => none) = some xs' at hSet
      rw [hSub] at hSet; cases hSet
    | some ys =>
      change (match setElem? xs i y with | some zs => some (z :: zs) | none => none) = some xs' at hSet
      rw [hSub] at hSet; cases hSet
      change (p z && ys.all p) = (p z && xs.all p)
      rw [list_all_setElem?_preserve p xs i x y ys hSub hGet hPx hPy]

private theorem list_any_setElem?_preserve {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (i : Nat) (x y : α) (xs' : List α),
      setElem? xs i y = some xs' →
      Trusted.MirSemantics.getElem? xs i = some x →
      p x = false → p y = false →
      xs'.any p = xs.any p
  | [], _, _, _, _, hSet, _, _, _ => by cases hSet
  | z :: xs, 0, x, y, xs', hSet, hGet, hPx, hPy => by
    cases hGet; cases hSet
    change (p y || xs.any p) = (p z || xs.any p)
    rw [hPx, hPy]
  | z :: xs, i + 1, x, y, xs', hSet, hGet, hPx, hPy => by
    cases hSub : setElem? xs i y with
    | none =>
      change (match setElem? xs i y with | some zs => some (z :: zs) | none => none) = some xs' at hSet
      rw [hSub] at hSet; cases hSet
    | some ys =>
      change (match setElem? xs i y with | some zs => some (z :: zs) | none => none) = some xs' at hSet
      rw [hSub] at hSet; cases hSet
      change (p z || ys.any p) = (p z || xs.any p)
      rw [list_any_setElem?_preserve p xs i x y ys hSub hGet hPx hPy]

private theorem list_all_setElem?_preserves_bool {α : Type} (p : α → Bool)
    (xs : List α) (i : Nat) (x y : α) (xs' : List α)
    (hSet : setElem? xs i y = some xs')
    (hGet : Trusted.MirSemantics.getElem? xs i = some x)
    (hSame : p y = p x) :
    xs'.all p = xs.all p := by
  cases hPx : p x with
  | true =>
    have hPy : p y = true := by rw [hSame, hPx]
    exact list_all_setElem?_preserve p xs i x y xs' hSet hGet hPx hPy
  | false =>
    have hLeft : xs'.all p = false := by
      cases hB : xs'.all p with
      | false => rfl
      | true =>
        have hAll := (list_all_iff_getElem? p xs').mp hB i y (getElem?_setElem?_self xs i y xs' hSet)
        rw [hSame, hPx] at hAll; cases hAll
    have hRight : xs.all p = false := by
      cases hA : xs.all p with
      | false => rfl
      | true =>
        have hAll := (list_all_iff_getElem? p xs).mp hA i x hGet
        rw [hAll] at hPx; cases hPx
    rw [hLeft, hRight]

private theorem initStateArrSlice_eq_of_body_transform
    (pSrc pTgt : ArrSliceProgram) (bodyId : DefId)
    (bodySrc bodyTgt : ArrSliceBody) (bodiesTgt : List ArrSliceBody)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies bodyId = some bodySrc)
    (hSetBody : setElem? pSrc.bodies bodyId bodyTgt = some bodiesTgt)
    (hPgt : pTgt = { pSrc with bodies := bodiesTgt })
    (hArg : bodyTgt.argumentCount = bodySrc.argumentCount)
    (hLoc : bodyTgt.locals = bodySrc.locals)
    (hEmpty : bodyTgt.basicBlocks.isEmpty = bodySrc.basicBlocks.isEmpty)
    (hStorInB : arrSliceStorageAnnotationsInBounds bodyTgt = arrSliceStorageAnnotationsInBounds bodySrc)
    (hHasAnn : ∀ idx : LocalId, arrSliceHasStorageAnnotation bodyTgt idx = arrSliceHasStorageAnnotation bodySrc idx) :
    ∀ q : Query, initStateArrSlice pSrc q = initStateArrSlice pTgt q := by
  intro q
  subst hPgt
  unfold initStateArrSlice
  dsimp
  cases (!Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1) with
  | true => rfl
  | false =>
    dsimp
    cases q.callerMem.allocations.isEmpty with
    | false => rfl
    | true =>
      dsimp
      cases hEqId : Nat.beq pSrc.entryDefId bodyId with
      | false =>
        have hNe : pSrc.entryDefId ≠ bodyId := by
          intro hEq; rw [hEq, nat_beq_refl bodyId] at hEqId; cases hEqId
        rw [getElem?_setElem?_ne pSrc.bodies bodyId pSrc.entryDefId bodyTgt bodiesTgt
          (Ne.symm hNe) hSetBody]
      | true =>
        have hId : pSrc.entryDefId = bodyId := nat_beq_eq _ _ hEqId
        rw [hId, hBodySrc, getElem?_setElem?_self pSrc.bodies bodyId bodyTgt bodiesTgt hSetBody]
        dsimp
        have hLoopEq :
            initArrSliceLocalsLoop bodyTgt q.args 0 bodyTgt.locals =
              initArrSliceLocalsLoop bodySrc q.args 0 bodySrc.locals := by
          rw [hLoc]
          have hGen : ∀ (idx : Nat) (ds : List ArrSliceLocalDecl),
              initArrSliceLocalsLoop bodyTgt q.args idx ds =
                initArrSliceLocalsLoop bodySrc q.args idx ds := by
            intro idx ds
            induction ds generalizing idx with
            | nil => rfl
            | cons d rest ih =>
              unfold initArrSliceLocalsLoop
              rw [hArg, hHasAnn idx, ih (idx + 1)]
          exact hGen 0 bodySrc.locals
        have hParamEq : arrSliceParamBaseTys? bodyTgt = arrSliceParamBaseTys? bodySrc := by
          unfold arrSliceParamBaseTys?; rw [hLoc, hArg]
        have hSupEq :
            allArrSliceLocalsSupported bodySrc.argumentCount 0 bodyTgt.locals =
              allArrSliceLocalsSupported bodySrc.argumentCount 0 bodySrc.locals := by
          rw [hLoc]
        have hLocLen : bodyTgt.locals.length = bodySrc.locals.length := by rw [hLoc]
        rw [hEmpty, hArg, hLocLen, hStorInB, hSupEq, hParamEq, hLoopEq]

private theorem evalReadArrayAtIdx_locals_congr
    {b1 b2 : ArrSliceBody} (hLoc : b1.locals = b2.locals)
    (frame : ArrSliceFrame) (cm : CallerMemory) (slots : List ArrSliceSlot)
    (dstLocal arrLocal : LocalId) (effIdx : Nat) (nextBb : BasicBlockId) :
    evalReadArrayAtIdx b1 frame cm slots dstLocal arrLocal effIdx nextBb =
      evalReadArrayAtIdx b2 frame cm slots dstLocal arrLocal effIdx nextBb := by
  unfold evalReadArrayAtIdx
  rw [hLoc]

private theorem evalArrSliceStmt_locals_congr
    {b1 b2 : ArrSliceBody} (hLoc : b1.locals = b2.locals)
    (frame : ArrSliceFrame) (cm : CallerMemory) (st : ArrSliceStmt) :
    evalArrSliceStmt b1 frame cm st = evalArrSliceStmt b2 frame cm st := by
  unfold evalArrSliceStmt
  rw [hLoc]

private theorem evalArrSliceTerm_locals_term_congr
    {b1 b2 : ArrSliceBody} {bb1 bb2 : ArrSliceBlock}
    (hLoc : b1.locals = b2.locals) (hTerm : bb1.terminator = bb2.terminator)
    (hClean : bb1.cleanup = bb2.cleanup)
    (frame : ArrSliceFrame) (cm : CallerMemory) :
    evalArrSliceTerm b1 bb1 frame cm = evalArrSliceTerm b2 bb2 frame cm := by
  unfold evalArrSliceTerm
  rw [hTerm, hClean]
  cases bb2.terminator with
  | baseTerm term =>
    cases term with
    | switchInt _ _ => dsimp; rw [hLoc]
    | _ => rfl
  | sliceLenCall _ _ _ | boundsCheckArray _ _ _ _
  | boundsCheckSlice _ _ _ _ | writeArrayElem _ _ _ _ =>
    dsimp; rw [hLoc]
  | readArrayElem dst aLoc idxOp nextBb =>
    dsimp; rw [hLoc]
    cases evalUsizeOperand b2.locals frame.locals idxOp with
    | error _ => rfl
    | ok _ => dsimp; exact evalReadArrayAtIdx_locals_congr hLoc _ _ _ _ _ _ _
  | readSliceElem dst sLoc idxOp nextBb =>
    dsimp; rw [hLoc]
    cases Trusted.MirSemantics.getElem? b2.locals dst with
    | none =>
      cases Trusted.MirSemantics.getElem? b2.locals sLoc with
      | none =>
        cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
      | some _ =>
        cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
    | some dd =>
      cases dd with
      | base dTy =>
        cases Trusted.MirSemantics.getElem? b2.locals sLoc with
        | none =>
          cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
        | some sd =>
          cases sd with
          | sliceView eTy =>
            cases Trusted.MirSemantics.getElem? frame.locals sLoc with
            | none => rfl
            | some ssl =>
              dsimp
              cases MirTy.beq dTy eTy with
              | false => rfl
              | true =>
                dsimp
                cases ssl with
                | liveSlice ov =>
                  cases ov with
                  | none => rfl
                  | some sv =>
                    dsimp
                    cases evalUsizeOperand b2.locals frame.locals idxOp with
                    | error _ => rfl
                    | ok _ =>
                      dsimp
                      cases Nat.blt _ sv.len with
                      | false => rfl
                      | true =>
                        dsimp
                        cases sv.backing with
                        | dangling => rfl
                        | arrayLocal _ =>
                          dsimp
                          cases Nat.blt _ maxUsize with
                          | false => rfl
                          | true => dsimp; exact evalReadArrayAtIdx_locals_congr hLoc _ _ _ _ _ _ _
                | _ => rfl
          | _ =>
            cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
      | _ =>
        cases Trusted.MirSemantics.getElem? b2.locals sLoc with
        | none =>
          cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
        | some _ =>
          cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
  | readSliceConst dst sLoc offset minLen fromEnd nextBb =>
    dsimp; rw [hLoc]
    cases Trusted.MirSemantics.getElem? b2.locals dst with
    | none =>
      cases Trusted.MirSemantics.getElem? b2.locals sLoc with
      | none =>
        cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
      | some _ =>
        cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
    | some dd =>
      cases dd with
      | base dTy =>
        cases Trusted.MirSemantics.getElem? b2.locals sLoc with
        | none =>
          cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
        | some sd =>
          cases sd with
          | sliceView eTy =>
            cases Trusted.MirSemantics.getElem? frame.locals sLoc with
            | none => rfl
            | some ssl =>
              dsimp
              cases (!MirTy.beq dTy eTy || !Nat.blt offset maxUsize || !Nat.blt minLen maxUsize) with
              | true => rfl
              | false =>
                dsimp
                cases ssl with
                | liveSlice ov =>
                  cases ov with
                  | none => rfl
                  | some sv =>
                    dsimp
                    cases evalSliceConstRelIdx sv.len offset minLen fromEnd with
                    | error _ => rfl
                    | ok _ =>
                      dsimp
                      cases sv.backing with
                      | dangling => rfl
                      | arrayLocal _ =>
                        dsimp
                        cases Nat.blt _ maxUsize with
                        | false => rfl
                        | true => dsimp; exact evalReadArrayAtIdx_locals_congr hLoc _ _ _ _ _ _ _
                | _ => rfl
          | _ =>
            cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
      | _ =>
        cases Trusted.MirSemantics.getElem? b2.locals sLoc with
        | none =>
          cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl
        | some _ =>
          cases Trusted.MirSemantics.getElem? frame.locals sLoc <;> rfl

private theorem evalStepArrSlice_body_ne_eq
    (pSrc pOut : ArrSliceProgram) (bodyId : DefId)
    (bodyTgt : ArrSliceBody) (bodiesTgt : List ArrSliceBody)
    (hOut : pOut = { pSrc with bodies := bodiesTgt })
    (hSetBody : setElem? pSrc.bodies bodyId bodyTgt = some bodiesTgt)
    (s : ArrSliceState) (frame : ArrSliceFrame)
    (hFr : s.frames = [frame]) (hDefNe : frame.defId ≠ bodyId) :
    evalStepArrSlice pOut 0 s = evalStepArrSlice pSrc 0 s := by
  unfold evalStepArrSlice
  rw [hFr, hOut]; dsimp
  rw [getElem?_setElem?_ne pSrc.bodies bodyId frame.defId bodyTgt bodiesTgt
    (Ne.symm hDefNe) hSetBody]

private theorem evalStepArrSlice_block_ne_eq
    (pSrc pOut : ArrSliceProgram) (bodyId : DefId) (bbIdx : BasicBlockId)
    (bodySrc bodyTgt : ArrSliceBody) (bbsTgt : List ArrSliceBlock)
    (bbTgt : ArrSliceBlock) (bodiesTgt : List ArrSliceBody)
    (hOut : pOut = { pSrc with bodies := bodiesTgt })
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies bodyId = some bodySrc)
    (hSetBody : setElem? pSrc.bodies bodyId bodyTgt = some bodiesTgt)
    (hBodyLoc : bodyTgt.locals = bodySrc.locals)
    (hBodyBbs : bodyTgt.basicBlocks = bbsTgt)
    (hSetBb : setElem? bodySrc.basicBlocks bbIdx bbTgt = some bbsTgt)
    (s : ArrSliceState) (frame : ArrSliceFrame)
    (hFr : s.frames = [frame]) (hDefId : frame.defId = bodyId)
    (hBbNe : frame.blockIdx ≠ bbIdx) :
    evalStepArrSlice pOut 0 s = evalStepArrSlice pSrc 0 s := by
  unfold evalStepArrSlice
  rw [hFr, hOut]; dsimp
  rw [hDefId, hBodySrc, getElem?_setElem?_self _ _ _ _ hSetBody]
  dsimp
  rw [hBodyBbs, getElem?_setElem?_ne bodySrc.basicBlocks bbIdx frame.blockIdx bbTgt bbsTgt
    (Ne.symm hBbNe) hSetBb]
  cases Trusted.MirSemantics.getElem? bodySrc.basicBlocks frame.blockIdx with
  | none => rfl
  | some bb =>
    dsimp
    cases Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
    | some stmt => exact evalArrSliceStmt_locals_congr hBodyLoc frame s.callerMem stmt
    | none =>
      dsimp
      cases frame.stmtIdx.beq bb.statements.length with
      | false => rfl
      | true => dsimp; exact evalArrSliceTerm_locals_term_congr hBodyLoc rfl rfl frame s.callerMem

private theorem evalStepArrSlice_stmt_at_eq
    (pSrc pOut : ArrSliceProgram) (bodyId : DefId) (bbIdx : BasicBlockId)
    (bodySrc bodyTgt : ArrSliceBody) (bbsTgt : List ArrSliceBlock)
    (bbSrc bbTgt : ArrSliceBlock) (bodiesTgt : List ArrSliceBody)
    (hOut : pOut = { pSrc with bodies := bodiesTgt })
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies bodyId = some bodySrc)
    (hSetBody : setElem? pSrc.bodies bodyId bodyTgt = some bodiesTgt)
    (hBodyLoc : bodyTgt.locals = bodySrc.locals)
    (hBodyBbs : bodyTgt.basicBlocks = bbsTgt)
    (hBbSrc : Trusted.MirSemantics.getElem? bodySrc.basicBlocks bbIdx = some bbSrc)
    (hSetBb : setElem? bodySrc.basicBlocks bbIdx bbTgt = some bbsTgt)
    (s : ArrSliceState) (frame : ArrSliceFrame) (st : ArrSliceStmt)
    (hFr : s.frames = [frame]) (hDefId : frame.defId = bodyId) (hBbId : frame.blockIdx = bbIdx)
    (hStTgt : Trusted.MirSemantics.getElem? bbTgt.statements frame.stmtIdx = some st)
    (hStSrc : Trusted.MirSemantics.getElem? bbSrc.statements frame.stmtIdx = some st) :
    evalStepArrSlice pOut 0 s = evalStepArrSlice pSrc 0 s := by
  unfold evalStepArrSlice
  rw [hFr, hOut]; dsimp
  rw [hDefId, hBbId, hBodySrc, getElem?_setElem?_self _ _ _ _ hSetBody]
  dsimp
  rw [hBodyBbs, hBbSrc, getElem?_setElem?_self _ _ _ _ hSetBb]
  dsimp
  rw [hStTgt, hStSrc]
  dsimp
  exact evalArrSliceStmt_locals_congr hBodyLoc frame s.callerMem st

/-! ## Standalone Pass 1 Soundness: `applyLowerSliceLenCalls_sound` -/

private theorem applyLowerSliceLenCalls_sound
    (bodyId : DefId) (bbIdx : BasicBlockId) (pSrc pTgt : ArrSliceProgram)
    (hApp : applyLowerSliceLenCalls bodyId bbIdx pSrc = some pTgt) :
    FullSemanticEquivArrSlice pSrc pTgt := by
  unfold applyLowerSliceLenCalls at hApp
  cases hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
  | none => rw [hBodySrc] at hApp; cases hApp
  | some bodySrc =>
    rw [hBodySrc] at hApp; dsimp at hApp
    cases hBbSrc : Trusted.MirSemantics.getElem? bodySrc.basicBlocks bbIdx with
    | none => rw [hBbSrc] at hApp; cases hApp
    | some bbSrc =>
      rw [hBbSrc] at hApp; dsimp at hApp
      cases hTerm : bbSrc.terminator with
      | sliceLenCall dst sliceLoc target =>
        rw [hTerm] at hApp; dsimp at hApp
        let bbTgt : ArrSliceBlock := {
          bbSrc with
          statements := bbSrc.statements ++ [.ptrMetadata dst sliceLoc]
          terminator := .baseTerm (.goto target)
        }
        cases hSetBb : setElem? bodySrc.basicBlocks bbIdx bbTgt with
        | none => rw [hSetBb] at hApp; cases hApp
        | some bbsTgt =>
          rw [hSetBb] at hApp; dsimp at hApp
          let bodyTgt : ArrSliceBody := { bodySrc with basicBlocks := bbsTgt }
          cases hSetBody : setElem? pSrc.bodies bodyId bodyTgt with
          | none => rw [hSetBody] at hApp; cases hApp
          | some bodiesTgt =>
            rw [hSetBody] at hApp; cases hApp
            have hEmpty : bodyTgt.basicBlocks.isEmpty = bodySrc.basicBlocks.isEmpty := by
              have hLen := setElem?_length _ _ _ _ hSetBb
              dsimp [bodyTgt]
              cases hSrcBbs : bodySrc.basicBlocks with
              | nil => rw [hSrcBbs] at hBbSrc; cases hBbSrc
              | cons _ _ =>
                cases hTgtBbs : bbsTgt with
                | nil => rw [hSrcBbs, hTgtBbs] at hLen; cases hLen
                | cons _ _ => rfl
            have hStorInB :
                arrSliceStorageAnnotationsInBounds bodyTgt =
                  arrSliceStorageAnnotationsInBounds bodySrc := by
              unfold arrSliceStorageAnnotationsInBounds
              dsimp [bodyTgt]
              apply list_all_setElem?_preserves_bool _ bodySrc.basicBlocks bbIdx bbSrc bbTgt bbsTgt hSetBb hBbSrc
              dsimp [bbTgt]
              rw [list_all_append]
              dsimp
              exact Bool.and_true _
            have hHasAnn : ∀ idx : LocalId,
                arrSliceHasStorageAnnotation bodyTgt idx =
                  arrSliceHasStorageAnnotation bodySrc idx := by
              intro idx
              unfold arrSliceHasStorageAnnotation
              dsimp [bodyTgt]
              have hBbAny :
                  bbTgt.statements.any (arrSliceStmtHasStorageMarker idx) =
                    bbSrc.statements.any (arrSliceStmtHasStorageMarker idx) := by
                dsimp [bbTgt]
                rw [list_any_append]
                change (bbSrc.statements.any (arrSliceStmtHasStorageMarker idx) || false) = _
                cases bbSrc.statements.any (arrSliceStmtHasStorageMarker idx) <;> rfl
              cases hSrcAny : bbSrc.statements.any (arrSliceStmtHasStorageMarker idx) with
              | false =>
                have hTgtAny : bbTgt.statements.any (arrSliceStmtHasStorageMarker idx) = false := by
                  rw [hBbAny, hSrcAny]
                exact list_any_setElem?_preserve
                  (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker idx))
                  bodySrc.basicBlocks bbIdx bbSrc bbTgt bbsTgt hSetBb hBbSrc hSrcAny hTgtAny
              | true =>
                have hAnyTrue : ∀ (bs : List ArrSliceBlock) (b : ArrSliceBlock),
                    Trusted.MirSemantics.getElem? bs bbIdx = some b →
                    b.statements.any (arrSliceStmtHasStorageMarker idx) = true →
                    bs.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker idx)) = true := by
                  intro bs b hG hT
                  cases hA : bs.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker idx)) with
                  | true => rfl
                  | false =>
                    have hFalse := (list_any_eq_false_iff _ bs).mp hA bbIdx b hG
                    rw [hFalse] at hT; cases hT
                have hTgtTrue : bbTgt.statements.any (arrSliceStmtHasStorageMarker idx) = true := by
                  rw [hBbAny, hSrcAny]
                have h1 := hAnyTrue bbsTgt bbTgt (getElem?_setElem?_self _ _ _ _ hSetBb) hTgtTrue
                have h2 := hAnyTrue bodySrc.basicBlocks bbSrc hBbSrc hSrcAny
                rw [h1, h2]
            let pOut : ArrSliceProgram := { pSrc with bodies := bodiesTgt }
            have hInitEq := initStateArrSlice_eq_of_body_transform pSrc pOut bodyId
              bodySrc bodyTgt bodiesTgt hBodySrc hSetBody rfl rfl rfl hEmpty hStorInB hHasAnn
            let R : ArrSliceState → ArrSliceState → Prop :=
              fun s₁ s₂ => s₁ = s₂ ∧ validStmtIdxInSrc pSrc s₁
            refine fullSemanticEquivArrSlice_of_fwd_stutter_sim pSrc pOut R (fun _ => 0)
              (fun q k hk => by rw [← hInitEq q]; exact hk)
              (fun q k hk => by rw [hInitEq q]; exact hk)
              (fun q s₁ hs₁ => by
                cases initStateArrSlice_ok_stmtIdx_zero hs₁ with
                | intro f₀ hf₀ =>
                  refine ⟨s₁, ?_, rfl, validStmtIdxInSrc_of_stmtIdx_zero pSrc s₁ f₀ hf₀.1 hf₀.2⟩
                  rw [← hInitEq q]; exact hs₁)
              ?_
            intro s₁ s₂ hR
            have hEq := hR.1
            have hValid := hR.2
            rw [← hEq]
            refine ⟨?_, ?_, ?_⟩
            · intro s₁' hS₁
              have hValid' := evalStepArrSlice_preserves_validStmtIdx pSrc hS₁
              cases hFr : s₁.frames with
              | nil =>
                unfold evalStepArrSlice at hS₁; rw [hFr] at hS₁; cases hS₁
              | cons frame rest =>
                cases rest with
                | cons _ _ =>
                  unfold evalStepArrSlice at hS₁; rw [hFr] at hS₁; cases hS₁
                | nil =>
                  cases hDefEq : Nat.beq frame.defId bodyId with
                  | false =>
                    have hDefNe : frame.defId ≠ bodyId := by
                      intro hE; rw [hE, nat_beq_refl bodyId] at hDefEq; cases hDefEq
                    have hSame := evalStepArrSlice_body_ne_eq pSrc pOut bodyId bodyTgt bodiesTgt
                      rfl hSetBody s₁ frame hFr hDefNe
                    rw [← hSame] at hS₁
                    exact Or.inr ⟨s₁', ⟨0, .succ ((stepArrSlice_iff_evalStep pOut s₁ (.step s₁')).mpr hS₁) (.zero s₁')⟩,
                      rfl, hValid'⟩
                  | true =>
                    have hDefId : frame.defId = bodyId := nat_beq_eq _ _ hDefEq
                    cases hBbEq : Nat.beq frame.blockIdx bbIdx with
                    | false =>
                      have hBbNe : frame.blockIdx ≠ bbIdx := by
                        intro hE; rw [hE, nat_beq_refl bbIdx] at hBbEq; cases hBbEq
                      have hSame := evalStepArrSlice_block_ne_eq pSrc pOut bodyId bbIdx bodySrc
                        bodyTgt bbsTgt bbTgt bodiesTgt rfl hBodySrc hSetBody rfl rfl hSetBb s₁ frame
                        hFr hDefId hBbNe
                      rw [← hSame] at hS₁
                      exact Or.inr ⟨s₁', ⟨0, .succ ((stepArrSlice_iff_evalStep pOut s₁ (.step s₁')).mpr hS₁) (.zero s₁')⟩,
                        rfl, hValid'⟩
                    | true =>
                      have hBbId : frame.blockIdx = bbIdx := nat_beq_eq _ _ hBbEq
                      unfold validStmtIdxInSrc at hValid
                      rw [hFr] at hValid
                      dsimp at hValid
                      rw [hDefId, hBodySrc] at hValid
                      dsimp at hValid
                      rw [hBbId, hBbSrc] at hValid
                      dsimp at hValid
                      cases Nat.lt_or_eq_of_le hValid with
                      | inl hLt =>
                        have hSome := getElem?_lt_some bbSrc.statements frame.stmtIdx hLt
                        cases hSome with
                        | intro st hSt =>
                          have hStTgt : Trusted.MirSemantics.getElem? bbTgt.statements frame.stmtIdx = some st := by
                            dsimp [bbTgt]
                            rw [getElem?_append_left bbSrc.statements [ArrSliceStmt.ptrMetadata dst sliceLoc]
                              frame.stmtIdx hLt]
                            exact hSt
                          have hSame := evalStepArrSlice_stmt_at_eq pSrc pOut bodyId bbIdx bodySrc
                            bodyTgt bbsTgt bbSrc bbTgt bodiesTgt rfl hBodySrc hSetBody rfl rfl
                            hBbSrc hSetBb s₁ frame st hFr hDefId hBbId hStTgt hSt
                          rw [← hSame] at hS₁
                          exact Or.inr ⟨s₁', ⟨0, .succ ((stepArrSlice_iff_evalStep pOut s₁ (.step s₁')).mpr hS₁) (.zero s₁')⟩,
                            rfl, hValid'⟩
                      | inr hAtEnd =>
                        unfold evalStepArrSlice at hS₁
                        rw [hFr] at hS₁; dsimp at hS₁
                        rw [hDefId, hBodySrc] at hS₁; dsimp at hS₁
                        rw [hBbId, hBbSrc] at hS₁; dsimp at hS₁
                        have hNoneSrc : Trusted.MirSemantics.getElem? bbSrc.statements frame.stmtIdx = none := by
                          rw [hAtEnd]
                          exact getElem?_none_of_le bbSrc.statements bbSrc.statements.length (Nat.le_refl _)
                        rw [hNoneSrc] at hS₁; dsimp at hS₁
                        rw [hAtEnd, nat_beq_refl] at hS₁; dsimp at hS₁
                        unfold evalArrSliceTerm at hS₁
                        rw [hTerm] at hS₁; dsimp at hS₁
                        cases hD : Trusted.MirSemantics.getElem? bodySrc.locals dst with
                        | none => rw [hD] at hS₁; cases hS₁
                        | some dd =>
                          cases dd with
                          | base dTy =>
                            cases hS : Trusted.MirSemantics.getElem? bodySrc.locals sliceLoc with
                            | none => rw [hD, hS] at hS₁; cases hS₁
                            | some sd =>
                              cases sd with
                              | sliceView _ =>
                                cases hSl : Trusted.MirSemantics.getElem? frame.locals sliceLoc with
                                | none => rw [hD, hS, hSl] at hS₁; cases hS₁
                                | some ssl =>
                                  rw [hD, hS, hSl] at hS₁; dsimp at hS₁
                                  cases hTy : MirTy.beq dTy usizeTy with
                                  | false => rw [hTy] at hS₁; cases hS₁
                                  | true =>
                                    rw [hTy] at hS₁; dsimp at hS₁
                                    cases ssl with
                                    | liveSlice ov =>
                                      cases ov with
                                      | none => cases hS₁
                                      | some sv =>
                                        dsimp at hS₁
                                        cases hWr : writeArrSliceBasePlace frame.locals dst dTy
                                            (.scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩) with
                                        | error _ => rw [hWr] at hS₁; cases hS₁
                                        | ok slots' =>
                                          rw [hWr] at hS₁; cases hS₁
                                          let midFrame : ArrSliceFrame := {
                                            frame with
                                            stmtIdx := bbSrc.statements.length + 1
                                            locals := slots'
                                          }
                                          let sMid : ArrSliceState := {
                                            frames := [midFrame]
                                            callerMem := s₁.callerMem
                                          }
                                          have hApp0 :
                                              Trusted.MirSemantics.getElem?
                                                (bbSrc.statements ++ [ArrSliceStmt.ptrMetadata dst sliceLoc])
                                                bbSrc.statements.length =
                                                some (ArrSliceStmt.ptrMetadata dst sliceLoc) := by
                                            rw [← Nat.add_zero bbSrc.statements.length,
                                              getElem?_append_right bbSrc.statements
                                                [ArrSliceStmt.ptrMetadata dst sliceLoc] 0]
                                            rfl
                                          have hStep1 : evalStepArrSlice pOut 0 s₁ = .step sMid := by
                                            unfold evalStepArrSlice
                                            rw [hFr]; dsimp [pOut]
                                            rw [hDefId, hBbId, getElem?_setElem?_self _ _ _ _ hSetBody]
                                            dsimp [bodyTgt]
                                            rw [getElem?_setElem?_self _ _ _ _ hSetBb]
                                            dsimp [bbTgt]
                                            rw [hAtEnd, hApp0]; dsimp [evalArrSliceStmt]
                                            rw [hD, hS, hSl]; dsimp
                                            rw [hTy]; dsimp
                                            rw [hWr]; dsimp [stepStmtNext]
                                            rw [hAtEnd]
                                          have hStep2 :
                                              evalStepArrSlice pOut 0 sMid =
                                                jumpArrSliceBlock frame s₁.callerMem slots' target := by
                                            unfold evalStepArrSlice
                                            dsimp [pOut, sMid, midFrame]
                                            rw [hDefId, hBbId, getElem?_setElem?_self _ _ _ _ hSetBody]
                                            dsimp [bodyTgt]
                                            rw [getElem?_setElem?_self _ _ _ _ hSetBb]
                                            dsimp [bbTgt]
                                            have hLenTgt :
                                                (bbSrc.statements ++ [ArrSliceStmt.ptrMetadata dst sliceLoc]).length =
                                                  bbSrc.statements.length + 1 :=
                                              list_append_length bbSrc.statements [ArrSliceStmt.ptrMetadata dst sliceLoc]
                                            have hNoneTgt :
                                                Trusted.MirSemantics.getElem?
                                                  (bbSrc.statements ++ [ArrSliceStmt.ptrMetadata dst sliceLoc])
                                                  (bbSrc.statements.length + 1) = none := by
                                              apply getElem?_none_of_le
                                              rw [hLenTgt]; exact Nat.le_refl _
                                            rw [hNoneTgt]; dsimp
                                            rw [hLenTgt, nat_beq_refl]
                                            dsimp [evalArrSliceTerm, jumpArrSliceBlock]
                                            rw [← hDefId]
                                          refine Or.inr ⟨_, ⟨1, .succ
                                            ((stepArrSlice_iff_evalStep pOut s₁ (.step sMid)).mpr hStep1)
                                            (.succ ((stepArrSlice_iff_evalStep pOut sMid (.step _)).mpr hStep2)
                                              (.zero _))⟩, rfl, hValid'⟩
                                    | _ => cases hS₁
                              | _ => rw [hD, hS] at hS₁; cases hS₁
                          | _ => rw [hD] at hS₁; cases hS₁
            · intro out hDone
              cases hFr : s₁.frames with
              | nil => unfold evalStepArrSlice at hDone; rw [hFr] at hDone; cases hDone
              | cons frame rest =>
                cases rest with
                | cons _ _ => unfold evalStepArrSlice at hDone; rw [hFr] at hDone; cases hDone
                | nil =>
                  cases hDefEq : Nat.beq frame.defId bodyId with
                  | false =>
                    have hDefNe : frame.defId ≠ bodyId := by
                      intro hE; rw [hE, nat_beq_refl bodyId] at hDefEq; cases hDefEq
                    have hSame := evalStepArrSlice_body_ne_eq pSrc pOut bodyId bodyTgt bodiesTgt
                      rfl hSetBody s₁ frame hFr hDefNe
                    rw [← hSame] at hDone
                    exact ⟨s₁, ReachesArrSlice.refl s₁,
                      (stepArrSlice_iff_evalStep pOut s₁ (.done out)).mpr hDone⟩
                  | true =>
                    have hDefId : frame.defId = bodyId := nat_beq_eq _ _ hDefEq
                    cases hBbEq : Nat.beq frame.blockIdx bbIdx with
                    | false =>
                      have hBbNe : frame.blockIdx ≠ bbIdx := by
                        intro hE; rw [hE, nat_beq_refl bbIdx] at hBbEq; cases hBbEq
                      have hSame := evalStepArrSlice_block_ne_eq pSrc pOut bodyId bbIdx bodySrc
                        bodyTgt bbsTgt bbTgt bodiesTgt rfl hBodySrc hSetBody rfl rfl hSetBb s₁ frame
                        hFr hDefId hBbNe
                      rw [← hSame] at hDone
                      exact ⟨s₁, ReachesArrSlice.refl s₁,
                        (stepArrSlice_iff_evalStep pOut s₁ (.done out)).mpr hDone⟩
                    | true =>
                      have hBbId : frame.blockIdx = bbIdx := nat_beq_eq _ _ hBbEq
                      unfold validStmtIdxInSrc at hValid
                      rw [hFr] at hValid; dsimp at hValid
                      rw [hDefId, hBodySrc] at hValid; dsimp at hValid
                      rw [hBbId, hBbSrc] at hValid; dsimp at hValid
                      cases Nat.lt_or_eq_of_le hValid with
                      | inl hLt =>
                        have hSome := getElem?_lt_some bbSrc.statements frame.stmtIdx hLt
                        cases hSome with
                        | intro st hSt =>
                          have hStTgt : Trusted.MirSemantics.getElem? bbTgt.statements frame.stmtIdx = some st := by
                            dsimp [bbTgt]
                            rw [getElem?_append_left bbSrc.statements [ArrSliceStmt.ptrMetadata dst sliceLoc]
                              frame.stmtIdx hLt]
                            exact hSt
                          have hSame := evalStepArrSlice_stmt_at_eq pSrc pOut bodyId bbIdx bodySrc
                            bodyTgt bbsTgt bbSrc bbTgt bodiesTgt rfl hBodySrc hSetBody rfl rfl
                            hBbSrc hSetBb s₁ frame st hFr hDefId hBbId hStTgt hSt
                          rw [← hSame] at hDone
                          exact ⟨s₁, ReachesArrSlice.refl s₁,
                            (stepArrSlice_iff_evalStep pOut s₁ (.done out)).mpr hDone⟩
                      | inr hAtEnd =>
                        unfold evalStepArrSlice at hDone
                        rw [hFr] at hDone; dsimp at hDone
                        rw [hDefId, hBodySrc] at hDone; dsimp at hDone
                        rw [hBbId, hBbSrc] at hDone; dsimp at hDone
                        have hNoneSrc : Trusted.MirSemantics.getElem? bbSrc.statements frame.stmtIdx = none := by
                          rw [hAtEnd]
                          exact getElem?_none_of_le bbSrc.statements bbSrc.statements.length (Nat.le_refl _)
                        rw [hNoneSrc] at hDone; dsimp at hDone
                        rw [hAtEnd, nat_beq_refl] at hDone; dsimp at hDone
                        unfold evalArrSliceTerm at hDone
                        rw [hTerm] at hDone; dsimp at hDone
                        cases hD : Trusted.MirSemantics.getElem? bodySrc.locals dst with
                        | none => rw [hD] at hDone; cases hDone
                        | some dd =>
                          cases dd with
                          | base dTy =>
                            cases hS : Trusted.MirSemantics.getElem? bodySrc.locals sliceLoc with
                            | none => rw [hD, hS] at hDone; cases hDone
                            | some sd =>
                              cases sd with
                              | sliceView _ =>
                                cases hSl : Trusted.MirSemantics.getElem? frame.locals sliceLoc with
                                | none => rw [hD, hS, hSl] at hDone; cases hDone
                                | some ssl =>
                                  rw [hD, hS, hSl] at hDone; dsimp at hDone
                                  cases hTy : MirTy.beq dTy usizeTy with
                                  | false => rw [hTy] at hDone; cases hDone
                                  | true =>
                                    rw [hTy] at hDone; dsimp at hDone
                                    cases ssl with
                                    | liveSlice ov =>
                                      cases ov with
                                      | none => cases hDone
                                      | some sv =>
                                        dsimp at hDone
                                        cases hWr : writeArrSliceBasePlace frame.locals dst dTy _ with
                                        | error _ => rw [hWr] at hDone; cases hDone
                                        | ok _ => rw [hWr] at hDone; cases hDone
                                    | _ => cases hDone
                              | _ => rw [hD, hS] at hDone; cases hDone
                          | _ => rw [hD] at hDone; cases hDone
            · intro fk hFault
              cases hFr : s₁.frames with
              | nil =>
                have hSame : evalStepArrSlice pOut 0 s₁ = evalStepArrSlice pSrc 0 s₁ := by
                  unfold evalStepArrSlice; rw [hFr]
                rw [← hSame] at hFault
                exact ⟨s₁, ReachesArrSlice.refl s₁,
                  (stepArrSlice_iff_evalStep pOut s₁ (.fault fk)).mpr hFault⟩
              | cons frame rest =>
                cases rest with
                | cons _ _ =>
                  have hSame : evalStepArrSlice pOut 0 s₁ = evalStepArrSlice pSrc 0 s₁ := by
                    unfold evalStepArrSlice; rw [hFr]
                  rw [← hSame] at hFault
                  exact ⟨s₁, ReachesArrSlice.refl s₁,
                    (stepArrSlice_iff_evalStep pOut s₁ (.fault fk)).mpr hFault⟩
                | nil =>
                  cases hDefEq : Nat.beq frame.defId bodyId with
                  | false =>
                    have hDefNe : frame.defId ≠ bodyId := by
                      intro hE; rw [hE, nat_beq_refl bodyId] at hDefEq; cases hDefEq
                    have hSame := evalStepArrSlice_body_ne_eq pSrc pOut bodyId bodyTgt bodiesTgt
                      rfl hSetBody s₁ frame hFr hDefNe
                    rw [← hSame] at hFault
                    exact ⟨s₁, ReachesArrSlice.refl s₁,
                      (stepArrSlice_iff_evalStep pOut s₁ (.fault fk)).mpr hFault⟩
                  | true =>
                    have hDefId : frame.defId = bodyId := nat_beq_eq _ _ hDefEq
                    cases hBbEq : Nat.beq frame.blockIdx bbIdx with
                    | false =>
                      have hBbNe : frame.blockIdx ≠ bbIdx := by
                        intro hE; rw [hE, nat_beq_refl bbIdx] at hBbEq; cases hBbEq
                      have hSame := evalStepArrSlice_block_ne_eq pSrc pOut bodyId bbIdx bodySrc
                        bodyTgt bbsTgt bbTgt bodiesTgt rfl hBodySrc hSetBody rfl rfl hSetBb s₁ frame
                        hFr hDefId hBbNe
                      rw [← hSame] at hFault
                      exact ⟨s₁, ReachesArrSlice.refl s₁,
                        (stepArrSlice_iff_evalStep pOut s₁ (.fault fk)).mpr hFault⟩
                    | true =>
                      have hBbId : frame.blockIdx = bbIdx := nat_beq_eq _ _ hBbEq
                      unfold validStmtIdxInSrc at hValid
                      rw [hFr] at hValid; dsimp at hValid
                      rw [hDefId, hBodySrc] at hValid; dsimp at hValid
                      rw [hBbId, hBbSrc] at hValid; dsimp at hValid
                      cases Nat.lt_or_eq_of_le hValid with
                      | inl hLt =>
                        have hSome := getElem?_lt_some bbSrc.statements frame.stmtIdx hLt
                        cases hSome with
                        | intro st hSt =>
                          have hStTgt : Trusted.MirSemantics.getElem? bbTgt.statements frame.stmtIdx = some st := by
                            dsimp [bbTgt]
                            rw [getElem?_append_left bbSrc.statements [ArrSliceStmt.ptrMetadata dst sliceLoc]
                              frame.stmtIdx hLt]
                            exact hSt
                          have hSame := evalStepArrSlice_stmt_at_eq pSrc pOut bodyId bbIdx bodySrc
                            bodyTgt bbsTgt bbSrc bbTgt bodiesTgt rfl hBodySrc hSetBody rfl rfl
                            hBbSrc hSetBb s₁ frame st hFr hDefId hBbId hStTgt hSt
                          rw [← hSame] at hFault
                          exact ⟨s₁, ReachesArrSlice.refl s₁,
                            (stepArrSlice_iff_evalStep pOut s₁ (.fault fk)).mpr hFault⟩
                      | inr hAtEnd =>
                        have hNoneSrc : Trusted.MirSemantics.getElem? bbSrc.statements frame.stmtIdx = none := by
                          rw [hAtEnd]
                          exact getElem?_none_of_le bbSrc.statements bbSrc.statements.length (Nat.le_refl _)
                        have hApp0 :
                            Trusted.MirSemantics.getElem?
                              (bbSrc.statements ++ [ArrSliceStmt.ptrMetadata dst sliceLoc])
                              bbSrc.statements.length =
                              some (ArrSliceStmt.ptrMetadata dst sliceLoc) := by
                          rw [← Nat.add_zero bbSrc.statements.length,
                            getElem?_append_right bbSrc.statements
                              [ArrSliceStmt.ptrMetadata dst sliceLoc] 0]
                          rfl
                        unfold evalStepArrSlice at hFault
                        rw [hFr] at hFault; dsimp at hFault
                        rw [hDefId, hBodySrc] at hFault; dsimp at hFault
                        rw [hBbId, hBbSrc] at hFault; dsimp at hFault
                        rw [hNoneSrc] at hFault; dsimp at hFault
                        rw [hAtEnd, nat_beq_refl] at hFault; dsimp at hFault
                        unfold evalArrSliceTerm at hFault
                        rw [hTerm] at hFault; dsimp at hFault
                        have hOutFault : evalStepArrSlice pOut 0 s₁ = .fault fk := by
                          unfold evalStepArrSlice
                          rw [hFr]; dsimp [pOut]
                          rw [hDefId, hBbId, getElem?_setElem?_self _ _ _ _ hSetBody]
                          dsimp [bodyTgt]
                          rw [getElem?_setElem?_self _ _ _ _ hSetBb]
                          dsimp [bbTgt]
                          rw [hAtEnd, hApp0]; dsimp [evalArrSliceStmt]
                          cases hD : Trusted.MirSemantics.getElem? bodySrc.locals dst with
                          | none =>
                            rw [hD] at hFault
                            cases hS : Trusted.MirSemantics.getElem? bodySrc.locals sliceLoc <;>
                              (rw [hS] at hFault
                               cases hSl : Trusted.MirSemantics.getElem? frame.locals sliceLoc <;>
                                 (rw [hSl] at hFault; dsimp at hFault; dsimp; exact hFault))
                          | some dd =>
                            rw [hD] at hFault
                            cases dd with
                            | base dTy =>
                              cases hS : Trusted.MirSemantics.getElem? bodySrc.locals sliceLoc with
                              | none =>
                                rw [hS] at hFault
                                cases hSl : Trusted.MirSemantics.getElem? frame.locals sliceLoc <;>
                                  (rw [hSl] at hFault; dsimp at hFault; dsimp; exact hFault)
                              | some sd =>
                                rw [hS] at hFault
                                cases sd with
                                | sliceView _ =>
                                  cases hSl : Trusted.MirSemantics.getElem? frame.locals sliceLoc with
                                  | none =>
                                    rw [hSl] at hFault; dsimp at hFault; dsimp; exact hFault
                                  | some ssl =>
                                    rw [hSl] at hFault; dsimp at hFault; dsimp
                                    cases hTy : MirTy.beq dTy usizeTy with
                                    | false =>
                                      rw [hTy] at hFault; dsimp at hFault
                                      dsimp; exact hFault
                                    | true =>
                                      rw [hTy] at hFault; dsimp at hFault
                                      dsimp
                                      cases ssl with
                                      | liveSlice ov =>
                                        cases ov with
                                        | none => exact hFault
                                        | some sv =>
                                          dsimp at hFault; dsimp
                                          cases hWr : writeArrSliceBasePlace frame.locals dst dTy
                                              (.scalar ⟨.isize, false, BitVec.ofNat 128 sv.len⟩) with
                                          | error _ =>
                                            rw [hWr] at hFault; dsimp at hFault
                                            dsimp; exact hFault
                                          | ok _ =>
                                            rw [hWr] at hFault; dsimp at hFault
                                            cases hFault
                                      | _ => exact hFault
                                | _ =>
                                  cases hSl : Trusted.MirSemantics.getElem? frame.locals sliceLoc <;>
                                    (rw [hSl] at hFault; dsimp at hFault; dsimp; exact hFault)
                            | _ =>
                              cases hS : Trusted.MirSemantics.getElem? bodySrc.locals sliceLoc <;>
                                (rw [hS] at hFault
                                 cases hSl : Trusted.MirSemantics.getElem? frame.locals sliceLoc <;>
                                   (rw [hSl] at hFault; dsimp at hFault; dsimp; exact hFault))
                        exact ⟨s₁, ReachesArrSlice.refl s₁,
                          (stepArrSlice_iff_evalStep pOut s₁ (.fault fk)).mpr hOutFault⟩
      | _ => rw [hTerm] at hApp; cases hApp

/-! ## Standalone Pass 2 Soundness: `applyGvnFoldPtrMetadata_sound` -/

private noncomputable def gvnInv (pSrc : ArrSliceProgram)
    (bodyId : DefId) (bbIdx : BasicBlockId)
    (unsizeIdx metaIdx : Nat) (sLoc arrLoc : LocalId) (len : Nat)
    (s : ArrSliceState) : Prop :=
  validStmtIdxInSrc pSrc s ∧
  match s.frames with
  | [frame] =>
    frame.defId = bodyId →
    frame.blockIdx = bbIdx →
    unsizeIdx < frame.stmtIdx →
    frame.stmtIdx ≤ metaIdx →
    Trusted.MirSemantics.getElem? frame.locals sLoc =
      some (.liveSlice (some { backing := .arrayLocal arrLoc, start := 0, len := len }))
  | _ => True

private theorem applyGvnFoldPtrMetadata_sound
    (bodyId : DefId) (bbIdx : BasicBlockId) (unsizeIdx metaIdx : Nat)
    (pSrc pTgt : ArrSliceProgram)
    (hApp : applyGvnFoldPtrMetadata bodyId bbIdx unsizeIdx metaIdx pSrc = some pTgt) :
    FullSemanticEquivArrSlice pSrc pTgt := by
  unfold applyGvnFoldPtrMetadata at hApp
  cases hUM : Nat.blt unsizeIdx metaIdx with
  | false => rw [hUM] at hApp; cases hApp
  | true =>
    rw [hUM] at hApp; dsimp at hApp
    have hUltM : unsizeIdx < metaIdx := nat_blt_lt hUM
    cases hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
    | none => rw [hBodySrc] at hApp; cases hApp
    | some bodySrc =>
      rw [hBodySrc] at hApp; dsimp at hApp
      cases hBbSrc : Trusted.MirSemantics.getElem? bodySrc.basicBlocks bbIdx with
      | none => rw [hBbSrc] at hApp; cases hApp
      | some bbSrc =>
        rw [hBbSrc] at hApp; dsimp at hApp
        cases hStU : Trusted.MirSemantics.getElem? bbSrc.statements unsizeIdx with
        | none => rw [hStU] at hApp; cases hApp
        | some stU =>
          cases stU with
          | unsizeArrayToSlice sLoc arrLoc =>
            cases hStM : Trusted.MirSemantics.getElem? bbSrc.statements metaIdx with
            | none => rw [hStU, hStM] at hApp; cases hApp
            | some stM =>
              cases stM with
              | ptrMetadata dstLoc sLoc' =>
                rw [hStU, hStM] at hApp; dsimp at hApp
                cases hSEqBool : Nat.beq sLoc sLoc' with
                | false => rw [hSEqBool] at hApp; cases hApp
                | true =>
                  rw [hSEqBool] at hApp; dsimp at hApp
                  have hSEq : sLoc = sLoc' := nat_beq_eq sLoc sLoc' hSEqBool
                  cases hArrD : Trusted.MirSemantics.getElem? bodySrc.locals arrLoc with
                  | none => rw [hArrD] at hApp; cases hApp
                  | some arrDecl =>
                    cases arrDecl with
                    | array aTy len =>
                      cases hSD : Trusted.MirSemantics.getElem? bodySrc.locals sLoc with
                      | none => rw [hArrD, hSD] at hApp; cases hApp
                      | some sDecl =>
                        cases sDecl with
                        | sliceView sTy =>
                          cases hDD : Trusted.MirSemantics.getElem? bodySrc.locals dstLoc with
                          | none => rw [hArrD, hSD, hDD] at hApp; cases hApp
                          | some dstDecl =>
                            cases dstDecl with
                            | base dstTy =>
                              rw [hArrD, hSD, hDD] at hApp; dsimp at hApp
                              cases hCond : (!MirTy.beq aTy sTy || !Nat.ble len 64 || !MirTy.beq dstTy usizeTy) with
                              | true => rw [hCond] at hApp; cases hApp
                              | false =>
                                rw [hCond] at hApp; dsimp at hApp
                                have hCond1 := (bool_or_eq_false _ _).mp hCond
                                have hCond2 := (bool_or_eq_false _ _).mp hCond1.1
                                have hTyAS : MirTy.beq aTy sTy = true := (bool_not_eq_false _).mp hCond2.1
                                have hATyEq : aTy = sTy := mirTy_beq_eq aTy sTy hTyAS
                                have hLenLe : len ≤ 64 := nat_ble_le ((bool_not_eq_false _).mp hCond2.2)
                                have hLenLt : len < maxUsize := len_le_64_lt_maxUsize len hLenLe
                                have hTyDst : MirTy.beq dstTy usizeTy = true := (bool_not_eq_false _).mp hCond1.2
                                have hDstTyEq : dstTy = usizeTy := mirTy_beq_eq dstTy usizeTy hTyDst
                                let between := (bbSrc.statements.drop (unsizeIdx + 1)).take (metaIdx - unsizeIdx - 1)
                                cases hBet : between.any (stmtModifiesSlice sLoc) with
                                | true => rw [hBet] at hApp; cases hApp
                                | false =>
                                  rw [hBet] at hApp; dsimp at hApp
                                  let foldedStmt : ArrSliceStmt := mkAssignUse dstLoc (usizeConst len)
                                  cases hSetStmts : setElem? bbSrc.statements metaIdx foldedStmt with
                                  | none => rw [hSetStmts] at hApp; cases hApp
                                  | some stmtsTgt =>
                                    rw [hSetStmts] at hApp; dsimp at hApp
                                    let bbTgt : ArrSliceBlock := { bbSrc with statements := stmtsTgt }
                                    cases hSetBb : setElem? bodySrc.basicBlocks bbIdx bbTgt with
                                    | none => rw [hSetBb] at hApp; cases hApp
                                    | some bbsTgt =>
                                      rw [hSetBb] at hApp; dsimp at hApp
                                      let bodyTgt : ArrSliceBody := { bodySrc with basicBlocks := bbsTgt }
                                      cases hSetBody : setElem? pSrc.bodies bodyId bodyTgt with
                                      | none => rw [hSetBody] at hApp; cases hApp
                                      | some bodiesTgt =>
                                        rw [hSetBody] at hApp; cases hApp
                                        have hEmpty : bodyTgt.basicBlocks.isEmpty = bodySrc.basicBlocks.isEmpty := by
                                          have hLen := setElem?_length _ _ _ _ hSetBb
                                          dsimp [bodyTgt]
                                          cases hSrcBbs : bodySrc.basicBlocks with
                                          | nil => rw [hSrcBbs] at hBbSrc; cases hBbSrc
                                          | cons _ _ =>
                                            cases hTgtBbs : bbsTgt with
                                            | nil => rw [hSrcBbs, hTgtBbs] at hLen; cases hLen
                                            | cons _ _ => rfl
                                        have hStorInB :
                                            arrSliceStorageAnnotationsInBounds bodyTgt =
                                              arrSliceStorageAnnotationsInBounds bodySrc := by
                                          unfold arrSliceStorageAnnotationsInBounds
                                          dsimp [bodyTgt]
                                          apply list_all_setElem?_preserves_bool _ bodySrc.basicBlocks bbIdx
                                            bbSrc bbTgt bbsTgt hSetBb hBbSrc
                                          dsimp [bbTgt]
                                          exact list_all_setElem?_preserves_bool _ bbSrc.statements metaIdx
                                            (.ptrMetadata dstLoc sLoc') foldedStmt stmtsTgt hSetStmts hStM rfl
                                        have hHasAnn : ∀ idx : LocalId,
                                            arrSliceHasStorageAnnotation bodyTgt idx =
                                              arrSliceHasStorageAnnotation bodySrc idx := by
                                          intro idx
                                          unfold arrSliceHasStorageAnnotation
                                          dsimp [bodyTgt]
                                          have hStAny :
                                              stmtsTgt.any (arrSliceStmtHasStorageMarker idx) =
                                                bbSrc.statements.any (arrSliceStmtHasStorageMarker idx) :=
                                            list_any_setElem?_preserve (arrSliceStmtHasStorageMarker idx)
                                              bbSrc.statements metaIdx (.ptrMetadata dstLoc sLoc') foldedStmt
                                              stmtsTgt hSetStmts hStM rfl rfl
                                          cases hSrcAny : bbSrc.statements.any (arrSliceStmtHasStorageMarker idx) with
                                          | false =>
                                            have hTgtAny : bbTgt.statements.any (arrSliceStmtHasStorageMarker idx) = false := by
                                              dsimp [bbTgt]; rw [hStAny, hSrcAny]
                                            exact list_any_setElem?_preserve _ bodySrc.basicBlocks bbIdx
                                              bbSrc bbTgt bbsTgt hSetBb hBbSrc hSrcAny hTgtAny
                                          | true =>
                                            have hAnyTrue : ∀ (bs : List ArrSliceBlock) (b : ArrSliceBlock),
                                                Trusted.MirSemantics.getElem? bs bbIdx = some b →
                                                b.statements.any (arrSliceStmtHasStorageMarker idx) = true →
                                                bs.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker idx)) = true := by
                                              intro bs b hG hT
                                              cases hA : bs.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker idx)) with
                                              | true => rfl
                                              | false =>
                                                have hFalse := (list_any_eq_false_iff _ bs).mp hA bbIdx b hG
                                                rw [hFalse] at hT; cases hT
                                            have hTgtTrue : bbTgt.statements.any (arrSliceStmtHasStorageMarker idx) = true := by
                                              dsimp [bbTgt]; rw [hStAny, hSrcAny]
                                            have h1 := hAnyTrue bbsTgt bbTgt (getElem?_setElem?_self _ _ _ _ hSetBb) hTgtTrue
                                            have h2 := hAnyTrue bodySrc.basicBlocks bbSrc hBbSrc hSrcAny
                                            rw [h1, h2]
                                        let pOut : ArrSliceProgram := { pSrc with bodies := bodiesTgt }
                                        have hInitEq := initStateArrSlice_eq_of_body_transform pSrc pOut bodyId
                                          bodySrc bodyTgt bodiesTgt hBodySrc hSetBody rfl rfl rfl hEmpty hStorInB hHasAnn
                                        let R : ArrSliceState → ArrSliceState → Prop :=
                                          fun s₁ s₂ => s₁ = s₂ ∧ gvnInv pSrc bodyId bbIdx unsizeIdx metaIdx sLoc arrLoc len s₁
                                        have hSameStep : ∀ s₁ : ArrSliceState,
                                            gvnInv pSrc bodyId bbIdx unsizeIdx metaIdx sLoc arrLoc len s₁ →
                                            evalStepArrSlice pOut 0 s₁ = evalStepArrSlice pSrc 0 s₁ := by
                                          intro s₁ hGvn
                                          cases hFr : s₁.frames with
                                          | nil => unfold evalStepArrSlice; rw [hFr]
                                          | cons frame rest =>
                                            cases rest with
                                            | cons _ _ => unfold evalStepArrSlice; rw [hFr]
                                            | nil =>
                                              cases hDefEq : Nat.beq frame.defId bodyId with
                                              | false =>
                                                have hDefNe : frame.defId ≠ bodyId := by
                                                  intro hE; rw [hE, nat_beq_refl bodyId] at hDefEq; cases hDefEq
                                                exact evalStepArrSlice_body_ne_eq pSrc pOut bodyId bodyTgt bodiesTgt
                                                  rfl hSetBody s₁ frame hFr hDefNe
                                              | true =>
                                                have hDefId : frame.defId = bodyId := nat_beq_eq _ _ hDefEq
                                                cases hBbEq : Nat.beq frame.blockIdx bbIdx with
                                                | false =>
                                                  have hBbNe : frame.blockIdx ≠ bbIdx := by
                                                    intro hE; rw [hE, nat_beq_refl bbIdx] at hBbEq; cases hBbEq
                                                  exact evalStepArrSlice_block_ne_eq pSrc pOut bodyId bbIdx bodySrc
                                                    bodyTgt bbsTgt bbTgt bodiesTgt rfl hBodySrc hSetBody rfl rfl
                                                    hSetBb s₁ frame hFr hDefId hBbNe
                                                | true =>
                                                  have hBbId : frame.blockIdx = bbIdx := nat_beq_eq _ _ hBbEq
                                                  cases hMetaEq : Nat.beq frame.stmtIdx metaIdx with
                                                  | false =>
                                                    have hMetaNe : frame.stmtIdx ≠ metaIdx := by
                                                      intro hE; rw [hE, nat_beq_refl metaIdx] at hMetaEq; cases hMetaEq
                                                    cases hStSrc : Trusted.MirSemantics.getElem? bbSrc.statements frame.stmtIdx with
                                                    | some st =>
                                                      have hStTgt : Trusted.MirSemantics.getElem? bbTgt.statements frame.stmtIdx = some st := by
                                                        dsimp [bbTgt]
                                                        rw [getElem?_setElem?_ne bbSrc.statements metaIdx frame.stmtIdx
                                                          foldedStmt stmtsTgt (Ne.symm hMetaNe) hSetStmts]
                                                        exact hStSrc
                                                      exact evalStepArrSlice_stmt_at_eq pSrc pOut bodyId bbIdx bodySrc
                                                        bodyTgt bbsTgt bbSrc bbTgt bodiesTgt rfl hBodySrc hSetBody rfl rfl
                                                        hBbSrc hSetBb s₁ frame st hFr hDefId hBbId hStTgt hStSrc
                                                    | none =>
                                                      unfold evalStepArrSlice
                                                      rw [hFr]; dsimp [pOut]
                                                      rw [hDefId, hBbId, hBodySrc, getElem?_setElem?_self _ _ _ _ hSetBody]
                                                      dsimp [bodyTgt]
                                                      rw [hBbSrc, getElem?_setElem?_self _ _ _ _ hSetBb]
                                                      dsimp [bbTgt]
                                                      rw [setElem?_length _ _ _ _ hSetStmts,
                                                        getElem?_setElem?_ne bbSrc.statements metaIdx frame.stmtIdx
                                                          foldedStmt stmtsTgt (Ne.symm hMetaNe) hSetStmts,
                                                        hStSrc]
                                                      dsimp
                                                      cases frame.stmtIdx.beq bbSrc.statements.length with
                                                      | false => rfl
                                                      | true =>
                                                        dsimp
                                                        exact evalArrSliceTerm_locals_term_congr rfl rfl rfl frame s₁.callerMem
                                                  | true =>
                                                    have hMetaId : frame.stmtIdx = metaIdx := nat_beq_eq _ _ hMetaEq
                                                    have hInvSlice := hGvn.2
                                                    rw [hFr] at hInvSlice; dsimp at hInvSlice
                                                    have hUltM' : unsizeIdx < frame.stmtIdx := by rw [hMetaId]; exact hUltM
                                                    have hLeM' : frame.stmtIdx ≤ metaIdx := by rw [hMetaId]; exact Nat.le_refl _
                                                    have hSliceVal := hInvSlice hDefId hBbId hUltM' hLeM'
                                                    unfold evalStepArrSlice
                                                    rw [hFr]; dsimp [pOut]
