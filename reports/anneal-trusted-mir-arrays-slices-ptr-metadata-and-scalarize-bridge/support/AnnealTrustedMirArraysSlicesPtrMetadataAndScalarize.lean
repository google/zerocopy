private theorem s4b_arrSc_nat_eq_or_ne (a b : Nat) : a = b ∨ a ≠ b := by
  cases h : Nat.beq a b with
  | true => exact Or.inl (Nat.eq_of_beq_eq_true h)
  | false =>
    apply Or.inr
    intro hEq
    rw [hEq, Nat.beq_refl] at h
    cases h

private theorem arrSc_lt_add_one_add (a b : Nat) : a < a + (1 + b) := by
  rw [Nat.add_comm 1 b]
  exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ b)

private theorem arrSc_lt_add_one_add_add (a b c : Nat) : a < a + ((1 + b) + c) := by
  rw [Nat.add_comm 1 b]
  exact Nat.lt_add_of_pos_right (Nat.lt_of_lt_of_le (Nat.zero_lt_succ b) (Nat.le_add_right _ c))

private theorem s4b_arrSc_le_bodyTgt_locals {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pack.bodySrc.locals.length ≤ pack.bodyTgt.locals.length := by
  rw [arrSc_bodyTgt_locals_length pack]
  exact Nat.le_trans (Nat.le_add_right _ 1)
    (Nat.le_trans (Nat.le_add_right _ pack.len) (Nat.le_add_right _ (4 + pack.len)))

private theorem arrSc_list_map_length {α β : Type} (f : α → β) :
    ∀ xs : List α, (xs.map f).length = xs.length
  | [] => rfl
  | _ :: tl => congrArg Nat.succ (arrSc_list_map_length f tl)


private theorem arrSc_list_take_drop_eq {α : Type} (xs : List α) (n : Nat) :
    xs.take n ++ xs.drop n = xs := by
  induction xs generalizing n with
  | nil =>
    cases n <;> rfl
  | cons a tl ih =>
    cases n with
    | zero => rfl
    | succ n' =>
      change a :: (tl.take n' ++ tl.drop n') = a :: tl
      rw [ih n']

private theorem arrSc_list_drop_eq_cons_of_getElem? {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α),
      Trusted.MirSemantics.getElem? xs i = some x →
      xs.drop i = x :: xs.drop (i + 1)
  | [], _, _, h => by cases h
  | _ :: _, 0, x, h => by
    have hEq := Option.some.inj h
    rw [hEq]
    rfl
  | _ :: tl, i + 1, x, h =>
    arrSc_list_drop_eq_cons_of_getElem? tl i x h

private theorem arrSc_listFlatMap_split_at_strong {α β : Type} (f : α → List β)
    {xs : List α} {i : Nat} {x : α} (h : Trusted.MirSemantics.getElem? xs i = some x) :
    listFlatMap f xs =
      (listFlatMap f (xs.take i) ++ f x) ++ listFlatMap f (xs.drop (i + 1)) := by
  have hSplit : xs = (xs.take i ++ [x]) ++ xs.drop (i + 1) := by
    rw [← arrSc_list_take_succ_of_getElem? xs i x h, arrSc_list_take_drop_eq]
  have hStep := congrArg (listFlatMap f) hSplit
  rw [listFlatMap_append, listFlatMap_append, arrSc_listFlatMap_singleton] at hStep
  exact hStep

private theorem arrSc_reachesNArrSlice_succ_head {p : ArrSliceProgram} {n : Nat}
    {s₀ s₁ s₂ : ArrSliceState}
    (h01 : evalStepArrSlice p 0 s₀ = .step s₁)
    (h12 : ReachesNArrSlice p n s₁ s₂) :
    ReachesNArrSlice p (n + 1) s₀ s₂ :=
