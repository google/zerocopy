      unfold basicBlockEq at h
      dsimp at h
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      rw [boolEq_eq cl₁ cl₂ h2.1, listRel_eq_of_eq stmtEq_eq st₁ st₂ h2.2,
        terminatorEq_eq tm₁ tm₂ h1.2]

