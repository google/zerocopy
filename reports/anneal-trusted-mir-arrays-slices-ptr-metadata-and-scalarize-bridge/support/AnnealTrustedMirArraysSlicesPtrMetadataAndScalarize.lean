-- Section 7D: Terminator Simulation (`term_step_sim`)
-- ============================================================================

private noncomputable def FwdTermSim
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (f₁ f₂ : ArrSliceFrame) (cm : CallerMemory) : Prop :=
  (∀ s₁', evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .step s₁' →
    ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ SliceStateRel pack s₁' s₂') ∧
  (∀ out, evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .done out →
    ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.done out)) ∧
  (∀ k, evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .fault k →
    ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.fault k))

private theorem reachesPlus_jump_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {slots₁' slots₂' : List ArrSliceSlot} (target : BasicBlockId) {n : Nat}
    (hSame : f₁.defId = plan.defId)
    (hSame₂ : f₂.defId = plan.defId)
    (hReach : ReachesNArrSlice pTgt (n + 1) { frames := [f₂], callerMem := cm }
      { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], callerMem := cm })
    (hLM' : SliceLocalMatch pack slots₁' slots₂') :
    ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧
      SliceStateRel pack
        { frames := [{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' }], callerMem := cm } s₂' := by
  let s₂' : ArrSliceState :=
    { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], callerMem := cm }
  refine ⟨s₂', ⟨n, hReach⟩, rfl, Or.inl ⟨hSame, hSame₂, rfl, hLM', ?_⟩⟩
  cases Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks target with
  | none => exact True.intro
  | some _ => exact ⟨Nat.zero_le _, rfl⟩

private theorem reachesPlus_of_n_plus {p : ArrSliceProgram} {n : Nat} {s₁ s₂ s₃ : ArrSliceState}
    (h1 : ReachesNArrSlice p n s₁ s₂) (h2 : ReachesPlusArrSlice p s₂ s₃) :
    ReachesPlusArrSlice p s₁ s₃ := by
  cases h2 with | intro m hm =>
  have hT := reachesNArrSlice_trans h1 hm
  rw [← Nat.add_assoc] at hT
  exact ⟨n + m, hT⟩

private theorem nat_beq_false_ne {a b : Nat} (h : Nat.beq a b = false) : a ≠ b := by
  intro hEq; rw [hEq, nat_beq_true rfl] at h; cases h

private theorem list_len_lt_append3 {α : Type} (xs ys zs : List α) {j : Nat} (hj : j < xs.length) :
    j < (xs ++ ys ++ zs).length := by
  rw [list_append_length, list_append_length]
  exact Nat.lt_of_lt_of_le hj (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))

private theorem list_len_lt_append4 {α : Type} (xs ys zs ws : List α) {j : Nat} (hj : j < xs.length) :
    j < (xs ++ ys ++ zs ++ ws).length := by
  rw [list_append_length]
  exact Nat.lt_of_lt_of_le (list_len_lt_append3 xs ys zs hj) (Nat.le_add_right _ _)

private def ReadSliceTailMatchProp (bbTgt : ArrSliceBlock) (optArr : Option LocalId)
    (f2StmtIdx : Nat) (dst scrIdx off : LocalId) (nextBb : BasicBlockId) : Prop :=
  match optArr with
  | some arrLoc =>
    Trusted.MirSemantics.getElem? bbTgt.statements (f2StmtIdx + 1) =
      some (mkAddUncheckedUsize scrIdx (.copy { localId := off + 2, projection := [] }) (.copy { localId := scrIdx, projection := [] })) ∧
    f2StmtIdx + 2 = bbTgt.statements.length ∧
    bbTgt.terminator = .readArrayElem dst arrLoc (.move { localId := scrIdx, projection := [] }) nextBb
  | none =>
    f2StmtIdx + 1 = bbTgt.statements.length ∧
    bbTgt.terminator = .baseTerm .unreachable

private theorem evalReadArrayAtIdx_prefix
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (f₁ f₂ : ArrSliceFrame) (cm : CallerMemory)
    {slots₁ slots₂ : List ArrSliceSlot} {dstLocal arrLocal : LocalId}
    (effIdx : Nat) (nextBb : BasicBlockId)
    (hLM : SliceLocalMatch pack slots₁ slots₂)
    (hDstLt : dstLocal < pack.bodySrc.locals.length)
    (hArrLt : arrLocal < pack.bodySrc.locals.length)
    (hDstNotSlice : ∀ sTy, Trusted.MirSemantics.getElem? pack.bodySrc.locals dstLocal ≠ some (.sliceView sTy)) :
    (∀ s₁', evalReadArrayAtIdx pack.bodySrc f₁ cm slots₁ dstLocal arrLocal effIdx nextBb = .step s₁' →
      ∃ slots₁' slots₂',
        s₁' = { frames := [{ f₁ with blockIdx := nextBb, stmtIdx := 0, locals := slots₁' }], callerMem := cm } ∧
        evalReadArrayAtIdx pack.bodyTgt f₂ cm slots₂ dstLocal arrLocal effIdx nextBb =
          jumpArrSliceBlock f₂ cm slots₂' nextBb ∧
        SliceLocalMatch pack slots₁' slots₂') ∧
    (∀ out, evalReadArrayAtIdx pack.bodySrc f₁ cm slots₁ dstLocal arrLocal effIdx nextBb = .done out → False) ∧
    (∀ k, evalReadArrayAtIdx pack.bodySrc f₁ cm slots₁ dstLocal arrLocal effIdx nextBb = .fault k →
      evalReadArrayAtIdx pack.bodyTgt f₂ cm slots₂ dstLocal arrLocal effIdx nextBb = .fault k) := by
  have evalEq : ∀ body frame slots,
      evalReadArrayAtIdx body frame cm slots dstLocal arrLocal effIdx nextBb =
        match Trusted.MirSemantics.getElem? body.locals dstLocal,
            Trusted.MirSemantics.getElem? body.locals arrLocal,
            Trusted.MirSemantics.getElem? slots arrLocal with
        | some (.base dstTy), some (.array elemTy len), some arrSl =>
          if !(MirTy.beq dstTy elemTy) then .fault .unsupported
          else match arrSl with
            | .arrDead => .fault .undefined
            | .liveArray elems =>
              if !Nat.blt effIdx len then .fault .undefined
              else match Trusted.MirSemantics.getElem? elems effIdx with
                | some (some v) =>
                  match writeArrSliceBasePlace slots dstLocal dstTy v with
                  | .error k => .fault k
                  | .ok slots' => jumpArrSliceBlock frame cm slots' nextBb
                | some none => .fault .undefined
                | none => .fault .unsupported
            | _ => .fault .unsupported
        | _, _, _ => .fault .unsupported := fun _ _ _ => rfl
  have hDstNS := bodyTgt_decl_nonSlice_lt pack hDstLt hDstNotSlice
  cases hDDst : Trusted.MirSemantics.getElem? pack.bodySrc.locals dstLocal with
  | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hDDst) hDstLt)
  | some dDst =>
    have hDTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dstLocal = some dDst := by
      rw [hDstNS.2, hDDst]
    cases dDst with
    | sliceView sTy => exact False.elim (hDstNotSlice sTy hDDst)
    | array _ _ =>
      refine ⟨fun s₁' h => (by rw [evalEq, hDDst] at h; cases h),
        fun out h => (by rw [evalEq, hDDst] at h; cases h),
        fun k h => by rw [evalEq, hDDst] at h; rw [evalEq, hDTgt]; exact h⟩
    | base dstTy =>
      cases hDArr : Trusted.MirSemantics.getElem? pack.bodySrc.locals arrLocal with
      | none => exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hDArr) hArrLt)
      | some dArr =>
        cases dArr with
        | base _ =>
          have hArrNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hDArr] at h; cases h)
          refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr] at h; cases h),
            fun out h => (by rw [evalEq, hDDst, hDArr] at h; cases h),
            fun k h => by rw [evalEq, hDDst, hDArr] at h; rw [evalEq, hDTgt, hArrNS.2, hDArr]; exact h⟩
        | sliceView _ =>
          have hATgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.base .unit) := by
            rw [getElem?_bodyTgt_locals_lt pack hArrLt, getElem?_tombstoneSliceDecls, hDArr]; rfl
          refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr] at h; cases h),
            fun out h => (by rw [evalEq, hDDst, hDArr] at h; cases h),
            fun k h => by rw [evalEq, hDDst, hDArr] at h; rw [evalEq, hDTgt, hATgt]; exact h⟩
        | array elemTy len =>
          have hArrNS := bodyTgt_decl_nonSlice_lt pack hArrLt (fun sTy h => by rw [hDArr] at h; cases h)
          have hATgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals arrLocal = some (.array elemTy len) := by
            rw [hArrNS.2, hDArr]
          have hSlotEq : Trusted.MirSemantics.getElem? slots₂ arrLocal =
              Trusted.MirSemantics.getElem? slots₁ arrLocal := hLM.1.2 arrLocal hArrLt hArrNS.1
          cases hSl : Trusted.MirSemantics.getElem? slots₁ arrLocal with
          | none =>
            exact False.elim (Nat.not_lt_of_ge (getElem?_none_le _ _ hSl) (by rw [hLM.1.1]; exact hArrLt))
          | some arrSl =>
            cases hTyNe : (!dstTy.beq elemTy) with
            | true =>
              refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                fun k h => by
                  rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h
                  rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe]; exact h⟩
            | false =>
              cases arrSl with
              | baseSlot _ =>
                refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun k h => by
                    rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h
                    rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe]; exact h⟩
              | sliceDead =>
                refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun k h => by
                    rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h
                    rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe]; exact h⟩
              | liveSlice _ =>
                refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun k h => by
                    rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h
                    rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe]; exact h⟩
              | arrDead =>
                refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h; cases h),
                  fun k h => by
                    rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe] at h
                    rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe]; exact h⟩
              | liveArray elems =>
                cases hIdxLt : (!effIdx.blt len) with
                | true =>
                  refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; cases h),
                    fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; cases h),
                    fun k h => by
                      rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h
                      rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; exact h⟩
                | false =>
                  cases hEl : Trusted.MirSemantics.getElem? elems effIdx with
                  | none =>
                    refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h; cases h),
                      fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h; cases h),
                      fun k h => by
                        rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h
                        rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; dsimp; rw [hEl]; exact h⟩
                  | some ov =>
                    cases ov with
                    | none =>
                      refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h; cases h),
                        fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h; cases h),
                        fun k h => by
                          rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h
                          rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; dsimp; rw [hEl]; exact h⟩
                    | some v =>
                      have hWr := writeArrSliceBasePlace_prefix hLM.1 hDstLt hDstNS.1 dstTy v
                      cases hW1 : writeArrSliceBasePlace slots₁ dstLocal dstTy v with
                      | error err =>
                        have hW2 := hWr.1 err hW1
                        refine ⟨fun s₁' h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h; dsimp at h; rw [hW1] at h; cases h),
                          fun out h => (by rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h; dsimp at h; rw [hW1] at h; cases h),
                          fun k h => by
                            rw [evalEq, hDDst, hDArr, hSl] at h; dsimp at h; rw [hTyNe, hIdxLt] at h; dsimp at h; rw [hEl] at h; dsimp at h; rw [hW1] at h
                            rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; dsimp; rw [hEl]; dsimp; rw [hW2]; exact h⟩
                      | ok slots₁' =>
                        have hW2Ex := hWr.2 slots₁' hW1
                        cases hW2Ex with | intro slots₂' hS2' =>
                        have hPresWr := s3c_writeArrSliceBasePlace_preserves_ne slots₁ dstLocal dstTy v slots₁' hW1
                        have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
                            Trusted.MirSemantics.getElem? slots₁' sLoc = Trusted.MirSemantics.getElem? slots₁ sLoc := by
                          intro sLoc k optArr hF
                          have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
                          cases hV.2 with | intro e hE =>
                          cases hE.2.2.2.2.2 with | intro sTy hs =>
                          have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
                            rw [← hE.2.1]; exact hs.1
                          have hNe : sLoc ≠ dstLocal := by intro hEq; rw [hEq, hDDst] at hSD; cases hSD
                          exact hPresWr.2 sLoc hNe
                        have hLM' := sliceLocalMatch_of_baseUpdate pack hLM hS2'.2.1 hS2'.2.2.1 hSl₁Pres hS2'.2.2.2
                        refine ⟨?_, ?_, ?_⟩
                        · intro s₁' hStep
                          rw [evalEq, hDDst, hDArr, hSl] at hStep; dsimp at hStep; rw [hTyNe, hIdxLt] at hStep; dsimp at hStep
                          rw [hEl] at hStep; dsimp at hStep; rw [hW1] at hStep
                          injection hStep with hsEq
                          refine ⟨slots₁', slots₂', hsEq.symm, ?_, hLM'⟩
                          rw [evalEq, hDTgt, hATgt, hSlotEq, hSl]; dsimp; rw [hTyNe, hIdxLt]; dsimp
                          rw [hEl]; dsimp; rw [hS2'.1]
                        · intro out hDone
                          rw [evalEq, hDDst, hDArr, hSl] at hDone; dsimp at hDone; rw [hTyNe, hIdxLt] at hDone; dsimp at hDone
                          rw [hEl] at hDone; dsimp at hDone; rw [hW1] at hDone; cases hDone
                        · intro k hFault
                          rw [evalEq, hDDst, hDArr, hSl] at hFault; dsimp at hFault; rw [hTyNe, hIdxLt] at hFault; dsimp at hFault
                          rw [hEl] at hFault; dsimp at hFault; rw [hW1] at hFault; cases hFault

private theorem sim_term_one_same
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdx₂ : f₂.stmtIdx = bbTgt.statements.length)
    (hEvalSim :
      (∀ s₁', evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = .step s₁' →
        ∃ target slots₁' slots₂',
          s₁' = { frames := [{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' }], callerMem := cm } ∧
          evalArrSliceTerm pack.bodyTgt bbTgt f₂ cm = jumpArrSliceBlock f₂ cm slots₂' target ∧
          SliceLocalMatch pack slots₁' slots₂') ∧
      (∀ out, evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = .done out →
        evalArrSliceTerm pack.bodyTgt bbTgt f₂ cm = .done out) ∧
      (∀ k, evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = .fault k →
        evalArrSliceTerm pack.bodyTgt bbTgt f₂ cm = .fault k)) :
    FwdTermSim pack f₁ f₂ cm := by
  have hS1 := evalStepArrSlice_at_term pSrc pack.bodySrc bbSrc f₁ cm hBodySrc hBbSrc hIdx₁
  have hS2 := evalStepArrSlice_at_term pTgt pack.bodyTgt bbTgt f₂ cm hBodyTgt hBbTgt hIdx₂
  dsimp [FwdTermSim]
  rw [hS1]
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    have hEx := hEvalSim.1 s₁' hStep
    cases hEx with | intro target hR1 =>
    cases hR1 with | intro slots₁' hR2 =>
    cases hR2 with | intro slots₂' hR3 =>
    rw [hR3.1]
    have hReach1 : ReachesNArrSlice pTgt 1 { frames := [f₂], callerMem := cm }
        { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], callerMem := cm } := by
      apply reachesNArrSlice_one_step
      rw [hS2]
      exact hR3.2.1
    exact reachesPlus_jump_rel pack target hSame hSame₂ hReach1 hR3.2.2
  · intro out hDone
    exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
      (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hS2]; exact hEvalSim.2.1 out hDone)⟩
  · intro k hFault
    exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _,
      (stepArrSlice_iff_evalStep _ _ _).mpr (by rw [hS2]; exact hEvalSim.2.2 k hFault)⟩

private theorem sliceLocalMatch_of_usizeOp_step
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁Mid slots₂Mid : List ArrSliceSlot} {scrIdx : LocalId}
    (hLM : SliceLocalMatch pack slots₁ slots₂)
    (hPM : PrefixSlotsMatch pack.bodySrc.locals plan.entries slots₁Mid slots₂Mid)
    (hLen : slots₂Mid.length = slots₂.length)
    (hPres₁ : slots₁Mid.length = slots₁.length ∧
      ∀ i, (∀ bTy, Trusted.MirSemantics.getElem? pack.bodySrc.locals i ≠ some (.base bTy)) →
        Trusted.MirSemantics.getElem? slots₁Mid i = Trusted.MirSemantics.getElem? slots₁ i)
    (hPres₂ : ∀ j, pack.bodySrc.locals.length ≤ j → j ≠ scrIdx →
      Trusted.MirSemantics.getElem? slots₂Mid j = Trusted.MirSemantics.getElem? slots₂ j)
    (hScr : ∃ ov, Trusted.MirSemantics.getElem? slots₂Mid scrIdx = some (.baseSlot (.live ov)))
    (hScrEq : ∃ r₀, r₀ < 5 ∧ scrIdx = pack.bodySrc.locals.length + 4 * plan.entries.length + r₀) :
    SliceLocalMatch pack slots₁Mid slots₂Mid := by
  cases hScrEq with | intro r₀ hr₀ =>
  have hSl₁Pres : ∀ sLoc k optArr, findSliceEntry plan.entries sLoc = some (k, optArr) →
      Trusted.MirSemantics.getElem? slots₁Mid sLoc = Trusted.MirSemantics.getElem? slots₁ sLoc := by
    intro sLoc k optArr hF
    have hV := findSliceEntry_some_lt_and_valid pack.hLoop hF
    cases hV.2 with | intro e hE =>
    cases hE.2.2.2.2.2 with | intro sTy hs =>
    exact hPres₁.2 sLoc (fun bTy hB => by rw [← hE.2.1] at hB; rw [hs.1] at hB; cases hB)
  refine ⟨hPM, by rw [hLen, hLM.2.1], ?_, ?_⟩
  · intro sLoc' k' optArr' hF'
    have hOld := hLM.2.2.1 sLoc' k' optArr' hF'
    cases hOld with | intro sl' hSl' =>
    refine ⟨sl', by rw [hSl₁Pres sLoc' k' optArr' hF']; exact hSl'.1, ?_⟩
    apply sliceCompRel_of_ext_eq hSl'.2
    intro r' hr'
    have hk'Lt := (findSliceEntry_some_lt_and_valid pack.hLoop hF').1
    have hGe : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 4 * k' + r' :=
      Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
    have hNe : pack.bodySrc.locals.length + 4 * k' + r' ≠ scrIdx := by
      rw [hr₀.2]
      exact Nat.ne_of_lt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left hr' _) (comp_range_le_scr hk'Lt))
    exact hPres₂ _ hGe hNe
  · intro r hr
    cases Nat.decEq r r₀ with
    | isTrue hEq => rw [hEq, ← hr₀.2]; exact hScr
    | isFalse hNe =>
      have hGe : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 4 * plan.entries.length + r :=
        Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      have hNeScr : pack.bodySrc.locals.length + 4 * plan.entries.length + r ≠ scrIdx := by
        rw [hr₀.2]; intro hEq; exact hNe (Nat.add_left_cancel hEq)
      rw [hPres₂ _ hGe hNeScr]
      exact hLM.2.2.2 r hr

private theorem sim_term_boundsCheckSlice
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {sLoc : LocalId} {idxOp : Operand} {inBoundsBb panicBb : BasicBlockId}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hTermSrc : bbSrc.terminator = .boundsCheckSlice sLoc idxOp inBoundsBb panicBb)
    (hTermTgt : bbTgt.terminator = (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).2)
    (hChk : checkTermForSlices pack.bodySrc.locals plan.entries bbSrc.terminator = true)
    (hGetPre : ∀ j, j < (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1 j)
    (hLenPre : f₂.stmtIdx + (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1.length = bbTgt.statements.length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdTermSim pack f₁ f₂ cm := by
  rw [hTermSrc] at hChk hGetPre hLenPre hTermTgt
  change (match findSliceEntry plan.entries sLoc with | some _ => operandUsesOnlyBase pack.bodySrc.locals idxOp | none => false) = true at hChk
  cases hFind : findSliceEntry plan.entries sLoc with
  | none => rw [hFind] at hChk; cases hChk
  | some p =>
    cases p with | mk k optArr =>
    rw [hFind] at hChk
    have hVal := findSliceEntry_some_lt_and_valid pack.hLoop hFind
    have hkLt := hVal.1
    cases hVal.2 with | intro e hE =>
    cases hE.2.2.2.2.2 with | intro sTy hs =>
    have hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc = some (.sliceView sTy) := by
      rw [← hE.2.1]; exact hs.1
    let base := pack.bodySrc.locals.length
    let off := base + 4 * k
    let scrBase := base + 4 * plan.entries.length
    let scrTag := scrBase
    let scrIdx := scrBase + 3
    let scrCond := scrBase + 4
    have hLowEq : lowerTermForSlices plan.entries base (.boundsCheckSlice sLoc idxOp inBoundsBb panicBb) =
        ([ mkLivenessCheckStmt off,
           mkAssignUse scrTag (.copy { localId := off + 1, projection := [] }),
           mkAssignUse scrIdx idxOp,
           mkLtUsize scrCond (.move { localId := scrIdx, projection := [] }) (.copy { localId := off + 3, projection := [] }) ],
         .baseTerm (.switchInt (.move { localId := scrCond, projection := [] })
           { branches := [(BitVec.ofNat 128 1, inBoundsBb)], otherwise := panicBb })) := by
      dsimp [lowerTermForSlices]; rw [hFind]
    have hTermTgtEq : bbTgt.terminator = .baseTerm (.switchInt (.move { localId := scrCond, projection := [] })
        { branches := [(BitVec.ofNat 128 1, inBoundsBb)], otherwise := panicBb }) := by
      rw [hTermTgt]; change (lowerTermForSlices plan.entries base (.boundsCheckSlice sLoc idxOp inBoundsBb panicBb)).2 = _; rw [hLowEq]
    have hG0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (mkLivenessCheckStmt off) := by
      have h0 := hGetPre 0 (by rw [hLowEq]; exact nat_blt_lt rfl); rw [Nat.add_zero, hLowEq] at h0; exact h0
    have hG1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
        some (mkAssignUse scrTag (.copy { localId := off + 1, projection := [] })) := by
      have h1 := hGetPre 1 (by rw [hLowEq]; exact nat_blt_lt rfl); rw [hLowEq] at h1; exact h1
    have hG2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) = some (mkAssignUse scrIdx idxOp) := by
      have h2 := hGetPre 2 (by rw [hLowEq]; exact nat_blt_lt rfl); rw [hLowEq] at h2; exact h2
    have hG3 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 3) =
        some (mkLtUsize scrCond (.move { localId := scrIdx, projection := [] }) (.copy { localId := off + 3, projection := [] })) := by
      have h3 := hGetPre 3 (by rw [hLowEq]; exact nat_blt_lt rfl); rw [hLowEq] at h3; exact h3
    have hLen4 : f₂.stmtIdx + 4 = bbTgt.statements.length := by
      have hL : (lowerTermForSlices plan.entries base (.boundsCheckSlice sLoc idxOp inBoundsBb panicBb)).1.length = 4 := by
        rw [hLowEq]; rfl
      rw [← hL]; exact hLenPre
    have hS1 : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
        (match Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc,
            Trusted.MirSemantics.getElem? f₁.locals sLoc with
          | some (.sliceView _), some .sliceDead
          | some (.sliceView _), some (.liveSlice none) => .fault .undefined
          | some (.sliceView _), some (.liveSlice (some sv)) =>
            match evalUsizeOperand pack.bodySrc.locals f₁.locals idxOp with
            | .error k => .fault k
            | .ok (idx, slotsAfterIdx) =>
              jumpArrSliceBlock f₁ cm slotsAfterIdx (if Nat.blt idx sv.len then inBoundsBb else panicBb)
          | _, _ => .fault .unsupported) := by
      rw [evalStepArrSlice_at_term pSrc pack.bodySrc bbSrc f₁ cm hBodySrc hBbSrc hIdx₁]
      change evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = _
      (dsimp [evalArrSliceTerm]; rw [hTermSrc]) <;> (dsimp; rfl)
    dsimp [FwdTermSim]; rw [hS1]
    have hExSl := hLM.2.2.1 sLoc k optArr hFind
    cases hExSl with | intro slS hSlS =>
    have hLive0 := step_mkLivenessCheckStmt_from_rel pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFind hSlS.1
    cases hSlSEq : slS with
    | baseSlot _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
    | arrDead => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
    | liveArray _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
    | sliceDead =>
      have hF0 := hLive0.1 hSlSEq
      refine ⟨fun s₁' h => (by rw [hSD, hSlS.1, hSlSEq] at h; cases h),
        fun out h => (by rw [hSD, hSlS.1, hSlSEq] at h; cases h),
        fun kFault h => by
          rw [hSD, hSlS.1, hSlSEq] at h; injection h with hkEq; rw [← hkEq]
          exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _, (stepArrSlice_iff_evalStep _ _ _).mpr hF0⟩⟩
    | liveSlice optSv =>
      have hStep0Ex := step_mkLivenessCheckStmt_live_pres pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFind (by rw [hSlS.1, hSlSEq])
      cases hStep0Ex with | intro slots₂_1 hS0 =>
      have hReach0 := reachesNArrSlice_one_step hS0.2.1
      let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂_1 }
      have hExSl1 := hS0.2.2.2.2.1 sLoc k optArr hFind
      cases hExSl1 with | intro slS1 hSlS1 =>
      have hEqSl1 : slS1 = .liveSlice optSv := by
        have hS : some slS1 = some (.liveSlice optSv) := by rw [← hSlS1.1, hSlS.1, hSlSEq]
        injection hS
      rw [hEqSl1] at hSlS1
      cases optSv with
      | none =>
        have hRT := step_readTag_from_rel pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFind hSlS1.1
        have hF1 := hRT.1 rfl
        refine ⟨fun s₁' h => (by rw [hSD, hSlS.1, hSlSEq] at h; cases h),
          fun out h => (by rw [hSD, hSlS.1, hSlSEq] at h; cases h),
          fun kFault h => by
            rw [hSD, hSlS.1, hSlSEq] at h; injection h with hkEq; rw [← hkEq]
            exact reachesArrSlice_of_reach_fault hReach0 hF1⟩
      | some sv =>
        have hStep1Ex := step_readTag_from_rel_set pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFind hSlS1.1
        cases hStep1Ex with | intro slots₂_2 hS1 =>
        have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS1.2.1)
        let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
        have hScrGe : base ≤ scrIdx := Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
        have hScrDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrIdx = some (.base usizeTy) :=
          getElem?_bodyTgt_locals_scratch pack (r := 3) (by decide)
        have hScrOv := hS1.2.2.2.2.2 3 (by decide)
        cases hScrOv with | intro ovScr hOvScr =>
        have hLen₂' : base ≤ slots₂_2.length := by
          rw [hS1.2.2.2.1, bodyTgt_locals_length pack]
          exact Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
        have hStep2 := step_mkAssignUse_usizeOp pack bbTgt f₂_2 cm f₁.locals scrIdx idxOp ovScr
          hBodyTgt hBbTgt hG2 hS1.2.2.1 hLen₂' hChk hScrGe hScrDecl hOvScr
        cases hU : evalUsizeOperand pack.bodySrc.locals f₁.locals idxOp with
        | error err =>
          have hF2 := hStep2.1 err hU
          refine ⟨fun s₁' h => (by rw [hSD, hSlS.1, hSlSEq] at h; cases h),
            fun out h => (by rw [hSD, hSlS.1, hSlSEq] at h; cases h),
            fun kFault h => by
              rw [hSD, hSlS.1, hSlSEq] at h; injection h with hkEq; rw [← hkEq]
              exact reachesArrSlice_of_reach_fault hReach1 hF2⟩
        | ok pIdx =>
          cases pIdx with | mk idx slots₁Mid =>
          have hOk2 := hStep2.2 idx slots₁Mid hU
          have hIdxLtMax : idx < maxUsize := hOk2.1
          cases hOk2.2 with | intro slots₂_3 hS2 =>
          have hReach2 := reachesNArrSlice_trans hReach1 (reachesNArrSlice_one_step hS2.1)
          have hPresU := evalUsizeOperand_preserves_nonBase pack.bodySrc.locals f₁.locals idxOp idx slots₁Mid hU
          have hLM3 := sliceLocalMatch_of_usizeOp_step pack hS1.2.2 hS2.2.1 (by rw [hS2.2.2.1]) hPresU
            hS2.2.2.2.2 ⟨_, hS2.2.2.2.1⟩ ⟨3, by decide, rfl⟩
          let f₂_3 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂_3 }
          have hExSl3 := hLM3.2.2.1 sLoc k optArr hFind
          cases hExSl3 with | intro slS3 hSlS3 =>
          have hSl₁MidEq : Trusted.MirSemantics.getElem? slots₁Mid sLoc = some (.liveSlice (some sv)) := by
            rw [hPresU.2 sLoc (fun bTy hB => by rw [hSD] at hB; cases hB), hSlS.1, hSlSEq]
          have hEqSl3 : slS3 = .liveSlice (some sv) := by
            have hS : some slS3 = some (.liveSlice (some sv)) := by rw [← hSlS3.1, hSl₁MidEq]
            injection hS
          rw [hEqSl3] at hSlS3
          have hComp3 := hSlS3.2; dsimp [SliceCompRel] at hComp3
          have hSvLenLtMax : sv.len < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left _ _) hComp3.1
          have hIdxDeclTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrIdx = some (.base usizeTy) := hScrDecl
          have hLenDeclTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (off + 3) = some (.base usizeTy) :=
            getElem?_bodyTgt_locals_comp pack hkLt (r := 3) (by decide)
          have hCondDeclTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrCond = some (.base .bool) :=
            getElem?_bodyTgt_locals_scratch pack (r := 4) (by decide)
          have hExMv := evalArrSlicePrimitiveOperand_move_usize pack.bodyTgt.locals slots₂_3 scrIdx idx hIdxDeclTgt hS2.2.2.2.1
          cases hExMv with | intro slots₂_3m hMv =>
          have hLM3m := sliceLocalMatch_set_scratch pack hLM3 (r₀ := 3) (by decide) none hMv.1
          have hExSl3m := hLM3m.2.2.1 sLoc k optArr hFind
          cases hExSl3m with | intro slS3m hSlS3m =>
          have hEqSl3m : slS3m = .liveSlice (some sv) := by
            have hS : some slS3m = some (.liveSlice (some sv)) := by rw [← hSlS3m.1, hSl₁MidEq]
            injection hS
          rw [hEqSl3m] at hSlS3m
          have hComp3m := hSlS3m.2; dsimp [SliceCompRel] at hComp3m
          have hCpLen := evalArrSlicePrimitiveOperand_copy_usize pack.bodyTgt.locals slots₂_3m (off + 3) sv.len hLenDeclTgt hComp3m.2.2.2.2.2
          have hBinLt := step_mkBinOp_usize pTgt pack.bodyTgt bbTgt f₂_3 cm .lt scrCond
            (.move { localId := scrIdx, projection := [] }) (.copy { localId := off + 3, projection := [] })
            .bool idx sv.len slots₂_3m slots₂_3m hBodyTgt hBbTgt hG3 hCondDeclTgt hMv.2 hCpLen
          rw [evalBinOp_usize_lt idx sv.len hIdxLtMax hSvLenLtMax] at hBinLt
          dsimp at hBinLt
          have hChkBool : (!checkVal (.bool (idx.blt sv.len)) .bool) = false := by cases idx.blt sv.len <;> rfl
          have hCondOv := hLM3m.2.2.2 4 (by decide)
          cases hCondOv with | intro ovCond hOvCond =>
          have hCondLt := getElem?_some_lt slots₂_3m scrCond _ hOvCond
          have hExSetCond := lt_setElem?_some slots₂_3m scrCond (.baseSlot (.live (some (.bool (idx.blt sv.len))))) hCondLt
          cases hExSetCond with | intro slots₂_4 hSetCond =>
          rw [writeArrSliceBasePlace_eq, hChkBool, hOvCond, hSetCond] at hBinLt
          have hReach3 := reachesNArrSlice_trans hReach2 (reachesNArrSlice_one_step hBinLt)
          have hLM4 := sliceLocalMatch_set_scratch pack hLM3m (r₀ := 4) (by decide) (some (.bool (idx.blt sv.len))) hSetCond
          let f₂_4 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 4, locals := slots₂_4 }
          have hCondSlot4 : Trusted.MirSemantics.getElem? slots₂_4 scrCond =
              some (.baseSlot (.live (some (.bool (idx.blt sv.len))))) :=
            getElem?_setElem?_self slots₂_3m scrCond _ slots₂_4 hSetCond
          have hCondLt4 := getElem?_some_lt slots₂_4 scrCond _ hCondSlot4
          have hExMvCond := lt_setElem?_some slots₂_4 scrCond (.baseSlot (.live none)) hCondLt4
          cases hExMvCond with | intro slots₂' hSetCondEnd =>
          have hPrimCond : evalArrSlicePrimitiveOperand pack.bodyTgt.locals slots₂_4
              (.move { localId := scrCond, projection := [] }) = .ok (.bool (idx.blt sv.len), slots₂') := by
            have hB : evalArrSliceBaseOperandToSlot pack.bodyTgt.locals slots₂_4
                (.move { localId := scrCond, projection := [] }) = .ok (.bool, some (.bool (idx.blt sv.len)), slots₂') := by
              rw [evalArrSliceBaseOperandToSlot_move]
              change (if (!List.isEmpty ([] : List ProjectionElem)) = true then Except.error FaultKind.unsupported
                else match Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrCond,
                    Trusted.MirSemantics.getElem? slots₂_4 scrCond with
                  | some (.base ty), some (.baseSlot (.live optVal)) =>
                    match setElem? slots₂_4 scrCond (.baseSlot (liveUninitSlot ty)) with
                    | some slots' => Except.ok (ty, optVal, slots') | none => Except.error FaultKind.unsupported
                  | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
                  | _, _ => Except.error FaultKind.unsupported) = _
              rw [hCondDeclTgt, hCondSlot4]
              change (match setElem? slots₂_4 scrCond (.baseSlot (.live none)) with
                | some slots' => Except.ok (MirTy.bool, some (Val.bool (idx.blt sv.len)), slots') | none => Except.error FaultKind.unsupported) = _
              rw [hSetCondEnd]
            rw [evalArrSlicePrimitiveOperand_ok _ _ _ _ _ _ hB]
            rfl
          have hTermStep : evalStepArrSlice pTgt 0 { frames := [f₂_4], callerMem := cm } =
              jumpArrSliceBlock f₂_4 cm slots₂' (if idx.blt sv.len = true then inBoundsBb else panicBb) := by
            rw [evalStepArrSlice_at_term pTgt pack.bodyTgt bbTgt f₂_4 cm hBodyTgt hBbTgt hLen4]
            change evalArrSliceTerm pack.bodyTgt bbTgt f₂_4 cm = _
            dsimp [evalArrSliceTerm]; rw [hTermTgtEq]; dsimp; rw [hPrimCond]; dsimp
            have hSw : evalBoolSwitchBranches (idx.blt sv.len) panicBb [(BitVec.ofNat 128 1, inBoundsBb)] =
                .ok (if idx.blt sv.len = true then inBoundsBb else panicBb) :=
              evalBoolSwitchBranches_bool (idx.blt sv.len) inBoundsBb panicBb
            rw [hSw]
          have hReach4 := reachesNArrSlice_trans hReach3 (reachesNArrSlice_one_step hTermStep)
          have hLM' := sliceLocalMatch_set_scratch pack hLM4 (r₀ := 4) (by decide) none hSetCondEnd
          refine ⟨?_, ?_, ?_⟩
          · intro s₁' hStep
            rw [hSD, hSlS.1, hSlSEq] at hStep; injection hStep with hsEq; rw [← hsEq]
            exact reachesPlus_jump_rel pack (if idx.blt sv.len = true then inBoundsBb else panicBb) hSame hSame₂ hReach4 hLM'
          · intro out hDone; rw [hSD, hSlS.1, hSlSEq] at hDone; cases hDone
          · intro kFault hFault; rw [hSD, hSlS.1, hSlSEq] at hFault; cases hFault

private theorem exec_readSlice_backing_tail
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {slots₁ : List ArrSliceSlot} {dst sLoc : LocalId} {dstTy : MirTy}
    {k : Nat} {optArr : Option LocalId} {sv : SliceViewVal}
    (relIdx : Nat) (nextBb : BasicBlockId)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hFind : findSliceEntry plan.entries sLoc = some (k, optArr))
    (hSlot₁ : Trusted.MirSemantics.getElem? slots₁ sLoc = some (.liveSlice (some sv)))
    (hLM : SliceLocalMatch pack slots₁ f₂.locals)
    (hDstDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst = some (.base dstTy))
    (hRelLt : relIdx < sv.len)
    (hTagVal : Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))))
    (hIdxVal : Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + 3) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 relIdx)))))))
    (hStTag : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (mkSubUncheckedUsize (pack.bodySrc.locals.length + 4 * plan.entries.length + 2)
        (.move { localId := pack.bodySrc.locals.length + 4 * plan.entries.length, projection := [] }) (usizeConst 1)))
    (hTailMatch : ReadSliceTailMatchProp bbTgt optArr f₂.stmtIdx dst
      (pack.bodySrc.locals.length + 4 * plan.entries.length + 3)
      (pack.bodySrc.locals.length + 4 * k) nextBb) :
    (∀ s₁', (match sv.backing with
        | .dangling => StepResult.fault FaultKind.undefined
        | .arrayLocal arrLoc =>
          if !Nat.blt (sv.start + relIdx) maxUsize then StepResult.fault FaultKind.undefined
          else evalReadArrayAtIdx pack.bodySrc f₁ cm slots₁ dst arrLoc (sv.start + relIdx) nextBb) = StepResult.step s₁' →
      ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ SliceStateRel pack s₁' s₂') ∧
    (∀ out, (match sv.backing with
        | .dangling => StepResult.fault FaultKind.undefined
        | .arrayLocal arrLoc =>
          if !Nat.blt (sv.start + relIdx) maxUsize then StepResult.fault FaultKind.undefined
          else evalReadArrayAtIdx pack.bodySrc f₁ cm slots₁ dst arrLoc (sv.start + relIdx) nextBb) = StepResult.done out →
      ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.done out)) ∧
    (∀ kFault, (match sv.backing with
        | .dangling => StepResult.fault FaultKind.undefined
        | .arrayLocal arrLoc =>
          if !Nat.blt (sv.start + relIdx) maxUsize then StepResult.fault FaultKind.undefined
          else evalReadArrayAtIdx pack.bodySrc f₁ cm slots₁ dst arrLoc (sv.start + relIdx) nextBb) = StepResult.fault kFault →
      ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.fault kFault)) := by
  have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
  have hExSl := hLM.2.2.1 sLoc k optArr hFind
  cases hExSl with | intro slS hSlS =>
  have hEqSl : slS = .liveSlice (some sv) := by
    have hS : some slS = some (.liveSlice (some sv)) := by rw [← hSlS.1, hSlot₁]
    injection hS
  rw [hEqSl] at hSlS
  have hComp := hSlS.2; dsimp [SliceCompRel] at hComp
  let base := pack.bodySrc.locals.length
  let scrTag := base + 4 * plan.entries.length
  let scrB := scrTag + 2
  let scrIdx := scrTag + 3
  let off := base + 4 * k
  have hTagLtMax : backingTag sv.backing < maxUsize := by
    have hMax := maxUsize_eq
    cases sv.backing with
    | dangling => rw [hMax]; change 0 < Nat.pow 2 64; decide
    | arrayLocal _ => rw [hMax]; change 1 < Nat.pow 2 64; decide
  have h1LtMax : 1 < maxUsize := by rw [maxUsize_eq]; decide
  have hTagRhs : ∀ slotsMid,
      setElem? f₂.locals (scrTag + 0) (.baseSlot (.live none)) = some slotsMid →
      evalArrSlicePrimitiveOperand pack.bodyTgt.locals slotsMid (usizeConst 1) =
        .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 1)), slotsMid) :=
    fun slotsMid _ => evalArrSlicePrimitiveOperand_const_usize pack.bodyTgt.locals slotsMid 1 h1LtMax
  have hStTag' : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (mkSubUncheckedUsize (scrTag + 2) (.move { localId := scrTag + 0, projection := [] }) (usizeConst 1)) := by
    rw [Nat.add_zero]; exact hStTag
  have hTagVal' : Trusted.MirSemantics.getElem? f₂.locals (scrTag + 0) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) := by
    rw [Nat.add_zero]; exact hTagVal
  have hSub := step_subUnchecked_move_from_rel_set pack bbTgt f₂ cm slots₁ 2 0 (by decide) (by decide)
    (backingTag sv.backing) hTagLtMax (usizeConst 1) 1 h1LtMax hBodyTgt hBbTgt hStTag' hLM hTagVal' hTagRhs
  cases hBack : sv.backing with
  | dangling =>
    have hTag0 : backingTag SliceBacking.dangling = 0 := rfl
    rw [hBack, hTag0] at hSub
    have hF0 := hSub.1 Nat.zero_lt_one
    exact ⟨fun s₁' h => (by dsimp at h; cases h), fun out h => (by dsimp at h; cases h), fun kFault h => (by
      dsimp at h
      injection h with hkEq; rw [← hkEq]
      exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _, (stepArrSlice_iff_evalStep _ _ _).mpr hF0⟩)⟩
  | arrayLocal arrLoc =>
    have hOptArr : optArr = some arrLoc := by
      cases hComp.2.1 with
      | inl hD => rw [hBack] at hD; cases hD
      | inr hExA =>
        cases hExA with | intro a' ha' =>
        rw [hBack] at ha'; injection ha'.2 with haEq; rw [haEq]; exact ha'.1
    rw [hOptArr] at hTailMatch; dsimp [ReadSliceTailMatchProp] at hTailMatch
    have hTag1 : backingTag (.arrayLocal arrLoc) = 1 := rfl
    rw [hBack, hTag1] at hSub
    have hSubEx := hSub.2 (Nat.le_refl 1)
    cases hSubEx with | intro slots₂_m hSm =>
    cases hSm with | intro slots₂_1 hS1 =>
    have hReach0 := reachesNArrSlice_one_step hS1.2.2.1
    let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂_1 }
    have hExSl1 := hS1.2.2.2.2.2.1 sLoc k optArr hFind
    cases hExSl1 with | intro slS1 hSlS1 =>
    have hEqSl1 : slS1 = .liveSlice (some sv) := by
      have hS : some slS1 = some (.liveSlice (some sv)) := by rw [← hSlS1.1, hSlot₁]
      injection hS
    rw [hEqSl1] at hSlS1
    have hComp1 := hSlS1.2; dsimp [SliceCompRel] at hComp1
    have hStartDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (off + 2) = some (.base usizeTy) :=
      getElem?_bodyTgt_locals_comp pack hkLt (r := 2) (by decide)
    have hIdxDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrIdx = some (.base usizeTy) :=
      getElem?_bodyTgt_locals_scratch pack (r := 3) (by decide)
    have hIdx1 : Trusted.MirSemantics.getElem? slots₂_1 scrIdx =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 relIdx)))))) := by
      have hBNeIdx : scrB ≠ scrIdx := by intro hEq; exact absurd (Nat.add_left_cancel hEq) (by decide)
      have hTagNeIdx : scrTag ≠ scrIdx := by
        intro hEq; have hEq' : scrTag + 0 = scrIdx := by rw [Nat.add_zero]; exact hEq
        exact absurd (Nat.add_left_cancel hEq') (by decide)
      rw [getElem?_setElem?_ne _ _ _ _ _ hBNeIdx hS1.2.1,
          getElem?_setElem?_ne _ _ _ _ _ (by rw [Nat.add_zero]; exact hTagNeIdx) hS1.1]
      exact hIdxVal
    have hRhsIdx := evalArrSlicePrimitiveOperand_copy_usize pack.bodyTgt.locals slots₂_1 scrIdx relIdx hIdxDecl hIdx1
    have hSumLtMax : sv.start + relIdx < maxUsize :=
      Nat.lt_trans (Nat.add_lt_add_left hRelLt sv.start) hComp.1
    have hAddEx := step_addUnchecked_copy_from_rel_set pack bbTgt f₂_1 cm slots₁ 3 (by decide)
      (off + 2) sv.start (.copy { localId := scrIdx, projection := [] }) relIdx hSumLtMax
      hBodyTgt hBbTgt hTailMatch.1 hS1.2.2.2 hStartDecl hComp1.2.2.2.2.1 hRhsIdx
    cases hAddEx with | intro slots₂_2 hS2 =>
    have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS2.2.1)
    let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
    have hIdx2 : Trusted.MirSemantics.getElem? slots₂_2 scrIdx =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.start + relIdx))))))) :=
      getElem?_setElem?_self _ _ _ _ hS2.1
    have hIdx2Lt := getElem?_some_lt slots₂_2 scrIdx _ hIdx2
    have hExMv := lt_setElem?_some slots₂_2 scrIdx (.baseSlot (.live none)) hIdx2Lt
    cases hExMv with | intro slots₂_3 hSetMv =>
    have hLM3 := sliceLocalMatch_set_scratch pack hS2.2.2 (r₀ := 3) (by decide) none hSetMv
    have hUIdx : evalUsizeOperand pack.bodyTgt.locals slots₂_2 (.move { localId := scrIdx, projection := [] }) =
        .ok (sv.start + relIdx, slots₂_3) := by
      have hB : evalArrSliceBaseOperandToSlot pack.bodyTgt.locals slots₂_2 (.move { localId := scrIdx, projection := [] }) =
          .ok (usizeTy, some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.start + relIdx)))), slots₂_3) := by
        rw [evalArrSliceBaseOperandToSlot_move]
        change (if (!List.isEmpty ([] : List ProjectionElem)) = true then Except.error FaultKind.unsupported
          else match Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrIdx,
              Trusted.MirSemantics.getElem? slots₂_2 scrIdx with
            | some (.base ty), some (.baseSlot (.live optVal)) =>
              match setElem? slots₂_2 scrIdx (.baseSlot (liveUninitSlot ty)) with
              | some slots' => Except.ok (ty, optVal, slots') | none => Except.error FaultKind.unsupported
            | some (.base _), some (.baseSlot .dead) => Except.error FaultKind.undefined
            | _, _ => Except.error FaultKind.unsupported) = _
        rw [hIdxDecl, hIdx2]
        change (match setElem? slots₂_2 scrIdx (.baseSlot (.live none)) with
          | some slots' => Except.ok (usizeTy, some (Val.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.start + relIdx)))), slots')
          | none => Except.error FaultKind.unsupported) = _
        rw [hSetMv]
      have hT := evalArrSliceTypedOperand_ok pack.bodyTgt.locals slots₂_2 usizeTy
        (.move { localId := scrIdx, projection := [] }) usizeTy
        (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.start + relIdx))))) slots₂_3 hB
      have hBeqFalse : (!usizeTy.beq usizeTy) = false := by rw [mirTy_beq_refl usizeTy]; rfl
      have hChkTrue : checkVal (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.start + relIdx)))) usizeTy = true :=
        checkVal_usize_of_lt_maxUsize _ hSumLtMax
      rw [hBeqFalse] at hT; dsimp at hT; rw [hChkTrue] at hT; dsimp at hT
      have hU := evalUsizeOperand_ok pack.bodyTgt.locals slots₂_2 (.move { localId := scrIdx, projection := [] })
        (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.start + relIdx)))) slots₂_3 hT
      rw [hU]
      dsimp [evalUsizeOfVal]
      rw [bitVec_ofNat_toNat_of_lt (Nat.lt_trans hSumLtMax maxUsize_lt_pow128)]
    have hTermEq : evalStepArrSlice pTgt 0 { frames := [f₂_2], callerMem := cm } =
        evalReadArrayAtIdx pack.bodyTgt f₂_2 cm slots₂_3 dst arrLoc (sv.start + relIdx) nextBb := by
      rw [evalStepArrSlice_at_term pTgt pack.bodyTgt bbTgt f₂_2 cm hBodyTgt hBbTgt hTailMatch.2.1]
      change evalArrSliceTerm pack.bodyTgt bbTgt f₂_2 cm = _
      dsimp [evalArrSliceTerm]; rw [hTailMatch.2.2]; dsimp; rw [hUIdx]
    have hNotOob : (!Nat.blt (sv.start + relIdx) maxUsize) = false := by
      rw [lt_nat_blt hSumLtMax]; rfl
    have hDstLt : dst < pack.bodySrc.locals.length := getElem?_some_lt _ _ _ hDstDecl
    have hDstNotSlice : ∀ sTy', Trusted.MirSemantics.getElem? pack.bodySrc.locals dst ≠ some (.sliceView sTy') := by
      intro sTy' h; rw [hDstDecl] at h; cases h
    have hArrLt : arrLoc < pack.bodySrc.locals.length := by
      have hV := findSliceEntry_some_lt_and_valid pack.hLoop hFind
      cases hV.2 with | intro e hE =>
      cases hE.2.2.2.2.2 with | intro sTy hs =>
      rw [hE.2.2.1, hOptArr] at hs
      have ha := hs.2.2
      cases ha.2 with | intro aTy ha2 =>
      cases ha2 with | intro len ha3 =>
      exact getElem?_some_lt _ _ _ ha3.1
    have hRA := evalReadArrayAtIdx_prefix pack f₁ f₂_2 cm (sv.start + relIdx) nextBb hLM3 hDstLt hArrLt hDstNotSlice
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      rw [hNotOob] at hStep; dsimp at hStep
      have hEx := hRA.1 s₁' hStep
      cases hEx with | intro slots₁' hR =>
      cases hR with | intro slots₂' hR2 =>
      have hTermJump : evalStepArrSlice pTgt 0 { frames := [f₂_2], callerMem := cm } =
          jumpArrSliceBlock f₂_2 cm slots₂' nextBb := by
        rw [hTermEq]; exact hR2.2.1
      have hReach2 := reachesNArrSlice_trans hReach1 (reachesNArrSlice_one_step hTermJump)
      rw [hR2.1]
      exact reachesPlus_jump_rel pack nextBb hSame hSame₂ hReach2 hR2.2.2
    · intro out hDone
      rw [hNotOob] at hDone; dsimp at hDone
      exact False.elim (hRA.2.1 out hDone)
    · intro kFault hFault
      rw [hNotOob] at hFault; dsimp at hFault
      have hF2 := hRA.2.2 kFault hFault
      rw [← hTermEq] at hF2
      exact reachesArrSlice_of_reach_fault hReach1 hF2

private noncomputable def lowerReadSliceElemOut (optArr : Option LocalId)
    (preHead : List ArrSliceStmt) (dst scrIdx off : LocalId) (nextBb : BasicBlockId) :
    List ArrSliceStmt × ArrSliceTerm :=
  match optArr with
  | some arrLoc =>
    (preHead ++ [mkAddUncheckedUsize scrIdx (.copy { localId := off + 2, projection := [] }) (.copy { localId := scrIdx, projection := [] })],
     .readArrayElem dst arrLoc (.move { localId := scrIdx, projection := [] }) nextBb)
  | none => (preHead, .baseTerm .unreachable)

private noncomputable def lowerReadSliceConstOut (optArr : Option LocalId)
    (preHead relStmts tagChk : List ArrSliceStmt) (dst scrIdx off : LocalId) (nextBb : BasicBlockId) :
    List ArrSliceStmt × ArrSliceTerm :=
  match optArr with
  | some arrLoc =>
    (preHead ++ relStmts ++ tagChk ++
      [mkAddUncheckedUsize scrIdx (.copy { localId := off + 2, projection := [] }) (.copy { localId := scrIdx, projection := [] })],
     .readArrayElem dst arrLoc (.move { localId := scrIdx, projection := [] }) nextBb)
  | none => (preHead ++ relStmts ++ tagChk, .baseTerm .unreachable)

private theorem sim_term_readSliceElem
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {dst sLoc : LocalId} {idxOp : Operand} {nextBb : BasicBlockId}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hTermSrc : bbSrc.terminator = .readSliceElem dst sLoc idxOp nextBb)
    (hTermTgt : bbTgt.terminator = (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).2)
    (hChk : checkTermForSlices pack.bodySrc.locals plan.entries bbSrc.terminator = true)
    (hGetPre : ∀ j, j < (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1 j)
    (hLenPre : f₂.stmtIdx + (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1.length = bbTgt.statements.length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdTermSim pack f₁ f₂ cm := by
  rw [hTermSrc] at hChk hGetPre hLenPre hTermTgt
  change (operandUsesOnlyBase pack.bodySrc.locals idxOp &&
      match findSliceEntry plan.entries sLoc,
          Trusted.MirSemantics.getElem? pack.bodySrc.locals dst,
          Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc with
      | some _, some (.base dstTy), some (.sliceView elemTy) => MirTy.beq dstTy elemTy
      | _, _, _ => false) = true at hChk
  have hC0 := (bool_and_eq_true _ _).mp hChk
  have hIdxOp := hC0.1
  have hRest := hC0.2
  cases hFind : findSliceEntry plan.entries sLoc with
  | none => rw [hFind] at hRest; cases hRest
  | some p =>
    cases p with | mk k optArr =>
    cases hDstDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with
    | none => rw [hFind, hDstDecl] at hRest; cases hRest
    | some dDst =>
      cases dDst with
      | array _ _ => rw [hFind, hDstDecl] at hRest; cases hRest
      | sliceView _ => rw [hFind, hDstDecl] at hRest; cases hRest
      | base dstTy =>
        cases hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc with
        | none => rw [hFind, hDstDecl, hSD] at hRest; cases hRest
        | some dS =>
          cases dS with
          | base _ => rw [hFind, hDstDecl, hSD] at hRest; cases hRest
          | array _ _ => rw [hFind, hDstDecl, hSD] at hRest; cases hRest
          | sliceView elemTy =>
            rw [hFind, hDstDecl, hSD] at hRest
            dsimp at hRest
            have hTyEq : dstTy = elemTy := mirTy_beq_eq _ _ hRest
            have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
            let base := pack.bodySrc.locals.length
            let off := base + 4 * k
            let scrBase := base + 4 * plan.entries.length
            let scrTag := scrBase
            let scrA := scrBase + 1
            let scrB := scrBase + 2
            let scrIdx := scrBase + 3
            let preHead : List ArrSliceStmt := [
              mkLivenessCheckStmt off,
              mkAssignUse scrTag (.copy { localId := off + 1, projection := [] }),
              mkAssignUse scrIdx idxOp,
              mkSubUncheckedUsize scrA (.copy { localId := off + 3, projection := [] }) (usizeConst 1),
              mkSubUncheckedUsize scrB (.move { localId := scrA, projection := [] }) (.copy { localId := scrIdx, projection := [] }),
              mkSubUncheckedUsize scrB (.move { localId := scrTag, projection := [] }) (usizeConst 1)
            ]
            have hLowEq : lowerTermForSlices plan.entries base (.readSliceElem dst sLoc idxOp nextBb) =
                lowerReadSliceElemOut optArr preHead dst scrIdx off nextBb := by
              dsimp [lowerTermForSlices]; rw [hFind]; cases optArr <;> rfl
            have hG0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (mkLivenessCheckStmt off) := by
              have h0 := hGetPre 0 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceElemOut]; exact nat_blt_lt rfl))
              rw [Nat.add_zero, hLowEq] at h0; cases optArr <;> (dsimp [lowerReadSliceElemOut] at h0; exact h0)
            have hG1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
                some (mkAssignUse scrTag (.copy { localId := off + 1, projection := [] })) := by
              have h1 := hGetPre 1 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceElemOut]; exact nat_blt_lt rfl))
              rw [hLowEq] at h1; cases optArr <;> (dsimp [lowerReadSliceElemOut] at h1; exact h1)
            have hG2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) = some (mkAssignUse scrIdx idxOp) := by
              have h2 := hGetPre 2 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceElemOut]; exact nat_blt_lt rfl))
              rw [hLowEq] at h2; cases optArr <;> (dsimp [lowerReadSliceElemOut] at h2; exact h2)
            have hG3 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 3) =
                some (mkSubUncheckedUsize scrA (.copy { localId := off + 3, projection := [] }) (usizeConst 1)) := by
              have h3 := hGetPre 3 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceElemOut]; exact nat_blt_lt rfl))
              rw [hLowEq] at h3; cases optArr <;> (dsimp [lowerReadSliceElemOut] at h3; exact h3)
            have hG4 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 4) =
                some (mkSubUncheckedUsize scrB (.move { localId := scrA, projection := [] }) (.copy { localId := scrIdx, projection := [] })) := by
              have h4 := hGetPre 4 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceElemOut]; exact nat_blt_lt rfl))
              rw [hLowEq] at h4; cases optArr <;> (dsimp [lowerReadSliceElemOut] at h4; exact h4)
            have hG5 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 5) =
                some (mkSubUncheckedUsize scrB (.move { localId := scrTag, projection := [] }) (usizeConst 1)) := by
              have h5 := hGetPre 5 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceElemOut]; exact nat_blt_lt rfl))
              rw [hLowEq] at h5; cases optArr <;> (dsimp [lowerReadSliceElemOut] at h5; exact h5)
            have hS1 : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
                (match Trusted.MirSemantics.getElem? pack.bodySrc.locals dst,
                    Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc,
                    Trusted.MirSemantics.getElem? f₁.locals sLoc with
                  | some (.base dstTy'), some (.sliceView elemTy'), some sliceSl =>
                    if !(MirTy.beq dstTy' elemTy') then .fault .unsupported
                    else match sliceSl with
                      | .sliceDead | .liveSlice none => .fault .undefined
                      | .liveSlice (some sv) =>
                        match evalUsizeOperand pack.bodySrc.locals f₁.locals idxOp with
                        | .error k => .fault k
                        | .ok (idx, slotsAfterIdx) =>
                          if !Nat.blt idx sv.len then .fault .undefined
                          else match sv.backing with
                            | .dangling => .fault .undefined
                            | .arrayLocal arrLocal =>
                              if !Nat.blt (sv.start + idx) maxUsize then .fault .undefined
                              else evalReadArrayAtIdx pack.bodySrc f₁ cm slotsAfterIdx dst arrLocal (sv.start + idx) nextBb
                      | _ => .fault .unsupported
                  | _, _, _ => .fault .unsupported) := by
              rw [evalStepArrSlice_at_term pSrc pack.bodySrc bbSrc f₁ cm hBodySrc hBbSrc hIdx₁]
              change evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = _
              (dsimp [evalArrSliceTerm]; rw [hTermSrc]) <;> (dsimp; rfl)
            have hNoUnsup : (!(MirTy.beq dstTy elemTy)) = false := by rw [hTyEq, mirTy_beq_refl elemTy]; rfl
            dsimp [FwdTermSim]; rw [hS1]
            have hExSl := hLM.2.2.1 sLoc k optArr hFind
            cases hExSl with | intro slS hSlS =>
            have hLive0 := step_mkLivenessCheckStmt_from_rel pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFind hSlS.1
            cases hSlSEq : slS with
            | baseSlot _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
            | arrDead => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
            | liveArray _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
            | sliceDead =>
              have hF0 := hLive0.1 hSlSEq
              refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                fun kFault h => by
                  rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                  injection h with hkEq; rw [← hkEq]
                  exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _, (stepArrSlice_iff_evalStep _ _ _).mpr hF0⟩⟩
            | liveSlice optSv =>
              have hStep0Ex := step_mkLivenessCheckStmt_live_pres pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFind (by rw [hSlS.1, hSlSEq])
              cases hStep0Ex with | intro slots₂_1 hS0 =>
              have hReach0 := reachesNArrSlice_one_step hS0.2.1
              let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂_1 }
              have hExSl1 := hS0.2.2.2.2.1 sLoc k optArr hFind
              cases hExSl1 with | intro slS1 hSlS1 =>
              have hEqSl1 : slS1 = .liveSlice optSv := by
                have hS : some slS1 = some (.liveSlice optSv) := by rw [← hSlS1.1, hSlS.1, hSlSEq]
                injection hS
              rw [hEqSl1] at hSlS1
              cases optSv with
              | none =>
                have hRT := step_readTag_from_rel pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFind hSlS1.1
                have hF1 := hRT.1 rfl
                refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                  fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                  fun kFault h => by
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                    injection h with hkEq; rw [← hkEq]
                    exact reachesArrSlice_of_reach_fault hReach0 hF1⟩
              | some sv =>
                have hStep1Ex := step_readTag_from_rel_set pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFind hSlS1.1
                cases hStep1Ex with | intro slots₂_2 hS1 =>
                have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS1.2.1)
                let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
                have hScrGe : base ≤ scrIdx := Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
                have hScrDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrIdx = some (.base usizeTy) :=
                  getElem?_bodyTgt_locals_scratch pack (r := 3) (by decide)
                have hScrOv := hS1.2.2.2.2.2 3 (by decide)
                cases hScrOv with | intro ovScr hOvScr =>
                have hLen₂' : base ≤ slots₂_2.length := by
                  rw [setElem?_length _ _ _ _ hS1.1, setElem?_length _ _ _ _ hS0.1, hLM.2.1, bodyTgt_locals_length pack]
                  exact Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
                have hStep2 := step_mkAssignUse_usizeOp pack bbTgt f₂_2 cm f₁.locals scrIdx idxOp ovScr
                  hBodyTgt hBbTgt hG2 hS1.2.2.1 hLen₂' hIdxOp hScrGe hScrDecl hOvScr
                cases hU : evalUsizeOperand pack.bodySrc.locals f₁.locals idxOp with
                | error err =>
                  have hF2 := hStep2.1 err hU
                  refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                    fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                    fun kFault h => by
                      rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                      injection h with hkEq; rw [← hkEq]
                      exact reachesArrSlice_of_reach_fault hReach1 hF2⟩
                | ok pIdx =>
                  cases pIdx with | mk idx slots₁Mid =>
                  have hOk2 := hStep2.2 idx slots₁Mid hU
                  have hIdxLtMax : idx < maxUsize := hOk2.1
                  cases hOk2.2 with | intro slots₂_3 hS2 =>
                  have hReach2 := reachesNArrSlice_trans hReach1 (reachesNArrSlice_one_step hS2.1)
                  have hPresU := evalUsizeOperand_preserves_nonBase pack.bodySrc.locals f₁.locals idxOp idx slots₁Mid hU
                  have hLM3 := sliceLocalMatch_of_usizeOp_step pack hS1.2.2 hS2.2.1 (by rw [hS2.2.2.1]) hPresU
                    hS2.2.2.2.2 ⟨_, hS2.2.2.2.1⟩ ⟨3, by decide, rfl⟩
                  let f₂_3 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂_3 }
                  have hSl₁MidEq : Trusted.MirSemantics.getElem? slots₁Mid sLoc = some (.liveSlice (some sv)) := by
                    rw [hPresU.2 sLoc (fun bTy hB => by rw [hSD] at hB; cases hB), hSlS.1, hSlSEq]
                  have hExSl3 := hLM3.2.2.1 sLoc k optArr hFind
                  cases hExSl3 with | intro slS3 hSlS3 =>
                  have hEqSl3 : slS3 = .liveSlice (some sv) := by
                    have hS : some slS3 = some (.liveSlice (some sv)) := by rw [← hSlS3.1, hSl₁MidEq]
                    injection hS
                  rw [hEqSl3] at hSlS3
                  have hComp3 := hSlS3.2; dsimp [SliceCompRel] at hComp3
                  have hSvLenLtMax : sv.len < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left _ _) hComp3.1
                  have h1LtMax : 1 < maxUsize := by rw [maxUsize_eq]; decide
                  have hLenDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (off + 3) = some (.base usizeTy) :=
                    getElem?_bodyTgt_locals_comp pack hkLt (r := 3) (by decide)
                  have hSub3 := step_subUnchecked_copy_const_from_rel_set pack bbTgt f₂_3 cm slots₁Mid 1 (by decide)
                    (off + 3) sv.len 1 hSvLenLtMax h1LtMax hBodyTgt hBbTgt hG3 hLM3 hLenDecl hComp3.2.2.2.2.2
                  have hTagNeIdx : scrTag ≠ scrIdx := by
                    intro hEq; have hEq' : scrTag + 0 = scrIdx := by rw [Nat.add_zero]; exact hEq
                    exact absurd (Nat.add_left_cancel hEq') (by decide)
                  have hTagGe : base ≤ scrTag := Nat.le_trans (Nat.le_add_right _ _) (Nat.le_refl _)
                  have hTagVal3 : Trusted.MirSemantics.getElem? slots₂_3 scrTag =
                      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) := by
                    rw [hS2.2.2.2.2 _ hTagGe hTagNeIdx]; exact getElem?_setElem?_self _ _ _ _ hS1.1
                  cases Nat.decEq sv.len 0 with
                  | isTrue hLen0 =>
                    have hBltFalse : (!Nat.blt idx sv.len) = true := by rw [hLen0]; rfl
                    have hF3 := hSub3.1 (by rw [hLen0]; exact Nat.zero_lt_one)
                    refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hBltFalse] at h; cases h),
                      fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hBltFalse] at h; cases h),
                      fun kFault h => by
                        rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hBltFalse] at h
                        injection h with hkEq; rw [← hkEq]
                        exact reachesArrSlice_of_reach_fault hReach2 hF3⟩
                  | isFalse hLenPos =>
                    have h1LeLen : 1 ≤ sv.len := Nat.succ_le_of_lt (Nat.pos_of_ne_zero hLenPos)
                    have hSub3Ex := hSub3.2 h1LeLen
                    cases hSub3Ex with | intro slots₂_4 hS3 =>
                    have hReach3 := reachesNArrSlice_trans hReach2 (reachesNArrSlice_one_step hS3.2.1)
                    let f₂_4 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 4, locals := slots₂_4 }
                    have hScrALtMax : sv.len - 1 < maxUsize := Nat.lt_of_le_of_lt (Nat.sub_le _ _) hSvLenLtMax
                    have hScrAVal4 : Trusted.MirSemantics.getElem? slots₂_4 scrA =
                        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (sv.len - 1))))))) :=
                      getElem?_setElem?_self _ _ _ _ hS3.1
                    have hANeIdx : scrA ≠ scrIdx := by intro hEq; exact absurd (Nat.add_left_cancel hEq) (by decide)
                    have hIdxVal4 : Trusted.MirSemantics.getElem? slots₂_4 scrIdx =
                        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 idx)))))) := by
                      rw [getElem?_setElem?_ne _ _ _ _ _ hANeIdx hS3.1]; exact hS2.2.2.2.1
                    have hTagNeA : scrTag ≠ scrA := by
                      intro hEq; have hEq' : scrTag + 0 = scrA := by rw [Nat.add_zero]; exact hEq
                      exact absurd (Nat.add_left_cancel hEq') (by decide)
                    have hTagVal4 : Trusted.MirSemantics.getElem? slots₂_4 scrTag =
                        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) := by
                      rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeA) hS3.1]; exact hTagVal3
                    have hRhsCopy4 : ∀ slotsMid,
                        setElem? slots₂_4 scrA (.baseSlot (.live none)) = some slotsMid →
                        evalArrSlicePrimitiveOperand pack.bodyTgt.locals slotsMid (.copy { localId := scrIdx, projection := [] }) =
                          .ok (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 idx)), slotsMid) := by
                      intro slotsMid hSetA
                      have hIdxMid : Trusted.MirSemantics.getElem? slotsMid scrIdx =
                          some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 idx)))))) := by
                        rw [getElem?_setElem?_ne _ _ _ _ _ hANeIdx hSetA]; exact hIdxVal4
                      exact evalArrSlicePrimitiveOperand_copy_usize pack.bodyTgt.locals slotsMid scrIdx idx hScrDecl hIdxMid
                    have hSub4 := step_subUnchecked_move_from_rel_set pack bbTgt f₂_4 cm slots₁Mid 2 1 (by decide) (by decide)
                      (sv.len - 1) hScrALtMax (.copy { localId := scrIdx, projection := [] }) idx hIdxLtMax
                      hBodyTgt hBbTgt hG4 hS3.2.2 hScrAVal4 hRhsCopy4
                    cases Nat.decLt idx sv.len with
                    | isFalse hNotLt =>
                      have hLenLeIdx : sv.len ≤ idx := Nat.le_of_not_lt hNotLt
                      have hSubLtIdx : sv.len - 1 < idx :=
                        Nat.lt_of_lt_of_le (Nat.sub_lt (Nat.pos_of_ne_zero hLenPos) Nat.zero_lt_one) hLenLeIdx
                      have hBltFalse : (!Nat.blt idx sv.len) = true := by
                        cases hb : Nat.blt idx sv.len with
                        | false => rfl
                        | true => exact False.elim (hNotLt (nat_blt_lt hb))
                      have hF4 := hSub4.1 hSubLtIdx
                      refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hBltFalse] at h; cases h),
                        fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hBltFalse] at h; cases h),
                        fun kFault h => by
                          rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp at h; rw [hBltFalse] at h
                          injection h with hkEq; rw [← hkEq]
                          exact reachesArrSlice_of_reach_fault hReach3 hF4⟩
                    | isTrue hIdxLtLen =>
                      have hIdxLeSub : idx ≤ sv.len - 1 := Nat.le_sub_one_of_lt hIdxLtLen
                      have hBltTrue : (!Nat.blt idx sv.len) = false := by rw [lt_nat_blt hIdxLtLen]; rfl
                      have hSub4Ex := hSub4.2 hIdxLeSub
                      cases hSub4Ex with | intro slots₂_4m hS4m =>
                      cases hS4m with | intro slots₂_5 hS4 =>
                      have hReach4 := reachesNArrSlice_trans hReach3 (reachesNArrSlice_one_step hS4.2.2.1)
                      let f₂_5 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 5, locals := slots₂_5 }
                      have hTagNeB : scrTag ≠ scrB := by
                        intro hEq; have hEq' : scrTag + 0 = scrB := by rw [Nat.add_zero]; exact hEq
                        exact absurd (Nat.add_left_cancel hEq') (by decide)
                      have hBNeIdx : scrB ≠ scrIdx := by intro hEq; exact absurd (Nat.add_left_cancel hEq) (by decide)
                      have hTagVal5 : Trusted.MirSemantics.getElem? slots₂_5 scrTag =
                          some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) := by
                        rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeB) hS4.2.1,
                            getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeA) hS4.1]; exact hTagVal4
                      have hIdxVal5 : Trusted.MirSemantics.getElem? slots₂_5 scrIdx =
                          some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 idx)))))) := by
                        rw [getElem?_setElem?_ne _ _ _ _ _ hBNeIdx hS4.2.1,
                            getElem?_setElem?_ne _ _ _ _ _ hANeIdx hS4.1]; exact hIdxVal4
                      have hTailMatch : ReadSliceTailMatchProp bbTgt optArr f₂_5.stmtIdx dst scrIdx off nextBb := by
                        cases hOpt : optArr with
                        | none =>
                          dsimp [ReadSliceTailMatchProp]
                          have hL : (lowerTermForSlices plan.entries base (.readSliceElem dst sLoc idxOp nextBb)).1.length = 6 := by
                            rw [hLowEq, hOpt]; rfl
                          have hTermEq : bbTgt.terminator = .baseTerm .unreachable := by
                            rw [hTermTgt]; change (lowerTermForSlices plan.entries base (.readSliceElem dst sLoc idxOp nextBb)).2 = _; rw [hLowEq, hOpt]; rfl
                          refine ⟨?_, hTermEq⟩
                          dsimp [f₂_5]; change f₂.stmtIdx + 6 = bbTgt.statements.length
                          rw [← hL]; exact hLenPre
                        | some arrLoc =>
                          dsimp [ReadSliceTailMatchProp]
                          have hL : (lowerTermForSlices plan.entries base (.readSliceElem dst sLoc idxOp nextBb)).1.length = 7 := by
                            rw [hLowEq, hOpt]; rfl
                          have hG6 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 6) =
                              some (mkAddUncheckedUsize scrIdx (.copy { localId := off + 2, projection := [] }) (.copy { localId := scrIdx, projection := [] })) := by
                            have h6 := hGetPre 6 (by rw [hLowEq, hOpt]; dsimp [lowerReadSliceElemOut]; exact nat_blt_lt rfl)
                            rw [hLowEq, hOpt] at h6; dsimp [lowerReadSliceElemOut] at h6; exact h6
                          have hTermEq : bbTgt.terminator = .readArrayElem dst arrLoc (.move { localId := scrIdx, projection := [] }) nextBb := by
                            rw [hTermTgt]; change (lowerTermForSlices plan.entries base (.readSliceElem dst sLoc idxOp nextBb)).2 = _; rw [hLowEq, hOpt]; rfl
                          refine ⟨?_, ?_, hTermEq⟩
                          · dsimp [f₂_5]; rw [Nat.add_assoc]; exact hG6
                          · dsimp [f₂_5]; change f₂.stmtIdx + 7 = bbTgt.statements.length
                            rw [← hL]; exact hLenPre
                      have hTail := exec_readSlice_backing_tail (f₂ := f₂_5) (cm := cm) pack idx nextBb hBodyTgt hBbTgt hSame hSame₂
                        hFind hSl₁MidEq hS4.2.2.2 hDstDecl hIdxLtLen hTagVal5 hIdxVal5 hG5 hTailMatch
                      refine ⟨?_, ?_, ?_⟩
                      · intro s₁' hStep
                        rw [hDstDecl, hSD, hSlS.1, hSlSEq] at hStep; dsimp at hStep; rw [hNoUnsup] at hStep
                        dsimp at hStep; rw [hBltTrue] at hStep; dsimp at hStep
                        have hRes := hTail.1 s₁' hStep
                        cases hRes with | intro s₂' hS2' =>
                        exact ⟨s₂', reachesPlus_of_n_plus hReach4 hS2'.1, hS2'.2⟩
                      · intro out hDone
                        rw [hDstDecl, hSD, hSlS.1, hSlSEq] at hDone; dsimp at hDone; rw [hNoUnsup] at hDone
                        dsimp at hDone; rw [hBltTrue] at hDone; dsimp at hDone
                        have hRes := hTail.2.1 out hDone
                        cases hRes with | intro s₂' hS2' =>
                        exact ⟨s₂', reachesArrSlice_trans (reachesArrSlice_of_reachesNArrSlice hReach4) hS2'.1, hS2'.2⟩
                      · intro kFault hFault
                        rw [hDstDecl, hSD, hSlS.1, hSlSEq] at hFault; dsimp at hFault; rw [hNoUnsup] at hFault
                        dsimp at hFault; rw [hBltTrue] at hFault; dsimp at hFault
                        have hRes := hTail.2.2 kFault hFault
                        cases hRes with | intro s₂' hS2' =>
                        exact ⟨s₂', reachesArrSlice_trans (reachesArrSlice_of_reachesNArrSlice hReach4) hS2'.1, hS2'.2⟩

private theorem sim_term_readSliceConst
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {dst sLoc : LocalId} {offset minLen : Nat} {fromEnd : Bool} {nextBb : BasicBlockId}
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hIdx₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hTermSrc : bbSrc.terminator = .readSliceConst dst sLoc offset minLen fromEnd nextBb)
    (hTermTgt : bbTgt.terminator = (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).2)
    (hChk : checkTermForSlices pack.bodySrc.locals plan.entries bbSrc.terminator = true)
    (hGetPre : ∀ j, j < (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + j) =
        Trusted.MirSemantics.getElem? (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1 j)
    (hLenPre : f₂.stmtIdx + (lowerTermForSlices plan.entries pack.bodySrc.locals.length bbSrc.terminator).1.length = bbTgt.statements.length)
    (hLM : SliceLocalMatch pack f₁.locals f₂.locals) :
    FwdTermSim pack f₁ f₂ cm := by
  rw [hTermSrc] at hChk hGetPre hLenPre hTermTgt
  change (Nat.blt offset maxUsize && Nat.blt minLen maxUsize &&
      match findSliceEntry plan.entries sLoc,
          Trusted.MirSemantics.getElem? pack.bodySrc.locals dst,
          Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc with
      | some _, some (.base dstTy), some (.sliceView elemTy) => MirTy.beq dstTy elemTy
      | _, _, _ => false) = true at hChk
  have hC0 := (bool_and_eq_true _ _).mp hChk
  have hBnds := (bool_and_eq_true _ _).mp hC0.1
  have hOffLtMax : offset < maxUsize := nat_blt_lt hBnds.1
  have hMinLtMax : minLen < maxUsize := nat_blt_lt hBnds.2
  have hRest := hC0.2
  cases hFind : findSliceEntry plan.entries sLoc with
  | none => rw [hFind] at hRest; cases hRest
  | some p =>
    cases p with | mk k optArr =>
    cases hDstDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst with
    | none => rw [hFind, hDstDecl] at hRest; cases hRest
    | some dDst =>
      cases dDst with
      | array _ _ => rw [hFind, hDstDecl] at hRest; cases hRest
      | sliceView _ => rw [hFind, hDstDecl] at hRest; cases hRest
      | base dstTy =>
        cases hSD : Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc with
        | none => rw [hFind, hDstDecl, hSD] at hRest; cases hRest
        | some dS =>
          cases dS with
          | base _ => rw [hFind, hDstDecl, hSD] at hRest; cases hRest
          | array _ _ => rw [hFind, hDstDecl, hSD] at hRest; cases hRest
          | sliceView elemTy =>
            rw [hFind, hDstDecl, hSD] at hRest
            dsimp at hRest
            have hTyEq : dstTy = elemTy := mirTy_beq_eq _ _ hRest
            have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
            let base := pack.bodySrc.locals.length
            let off := base + 4 * k
            let scrBase := base + 4 * plan.entries.length
            let scrTag := scrBase
            let scrA := scrBase + 1
            let scrB := scrBase + 2
            let scrIdx := scrBase + 3
            let preHead : List ArrSliceStmt := [
              mkLivenessCheckStmt off,
              mkAssignUse scrTag (.copy { localId := off + 1, projection := [] }),
              mkSubUncheckedUsize scrA (.copy { localId := off + 3, projection := [] }) (usizeConst minLen)
            ]
            let relStmts : List ArrSliceStmt :=
              if !fromEnd then
                [ mkSubUncheckedUsize scrA (.copy { localId := off + 3, projection := [] }) (usizeConst 1),
                  mkSubUncheckedUsize scrB (.move { localId := scrA, projection := [] }) (usizeConst offset),
                  mkAssignUse scrIdx (usizeConst offset) ]
              else
                if Nat.beq offset 0 then [mkImmediateUbStmt scrA]
                else [mkSubUncheckedUsize scrIdx (.copy { localId := off + 3, projection := [] }) (usizeConst offset)]
            let tagChk : List ArrSliceStmt := [
              mkSubUncheckedUsize scrB (.move { localId := scrTag, projection := [] }) (usizeConst 1)
            ]
            have hLowEq : lowerTermForSlices plan.entries base (.readSliceConst dst sLoc offset minLen fromEnd nextBb) =
                lowerReadSliceConstOut optArr preHead relStmts tagChk dst scrIdx off nextBb := by
              dsimp [lowerTermForSlices]; rw [hFind]; cases optArr <;> rfl
            have hLenPreGe4 : ∀ j, j < 3 → j < (lowerTermForSlices plan.entries base (.readSliceConst dst sLoc offset minLen fromEnd nextBb)).1.length := by
              intro j hj
              rw [hLowEq]
              cases optArr with
              | none => exact list_len_lt_append3 preHead relStmts tagChk hj
              | some _ => exact list_len_lt_append4 preHead relStmts tagChk _ hj
            have hG0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some (mkLivenessCheckStmt off) := by
              have h0 := hGetPre 0 (hLenPreGe4 0 (by decide))
              rw [Nat.add_zero, hLowEq] at h0
              cases optArr <;> cases fromEnd <;> dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk] at h0
              · exact h0
              · cases hBeq : Nat.beq offset 0 with
                | true => rw [hBeq] at h0; dsimp at h0; exact h0
                | false => rw [hBeq] at h0; dsimp at h0; exact h0
              · exact h0
              · cases hBeq : Nat.beq offset 0 with
                | true => rw [hBeq] at h0; dsimp at h0; exact h0
                | false => rw [hBeq] at h0; dsimp at h0; exact h0
            have hG1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
                some (mkAssignUse scrTag (.copy { localId := off + 1, projection := [] })) := by
              have h1 := hGetPre 1 (hLenPreGe4 1 (by decide))
              rw [hLowEq] at h1
              cases optArr <;> cases fromEnd <;> dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk] at h1
              · exact h1
              · cases hBeq : Nat.beq offset 0 with
                | true => rw [hBeq] at h1; dsimp at h1; exact h1
                | false => rw [hBeq] at h1; dsimp at h1; exact h1
              · exact h1
              · cases hBeq : Nat.beq offset 0 with
                | true => rw [hBeq] at h1; dsimp at h1; exact h1
                | false => rw [hBeq] at h1; dsimp at h1; exact h1
            have hG2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
                some (mkSubUncheckedUsize scrA (.copy { localId := off + 3, projection := [] }) (usizeConst minLen)) := by
              have h2 := hGetPre 2 (hLenPreGe4 2 (by decide))
              rw [hLowEq] at h2
              cases optArr <;> cases fromEnd <;> dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk] at h2
              · exact h2
              · cases hBeq : Nat.beq offset 0 with
                | true => rw [hBeq] at h2; dsimp at h2; exact h2
                | false => rw [hBeq] at h2; dsimp at h2; exact h2
              · exact h2
              · cases hBeq : Nat.beq offset 0 with
                | true => rw [hBeq] at h2; dsimp at h2; exact h2
                | false => rw [hBeq] at h2; dsimp at h2; exact h2
            have hS1 : evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } =
                (match Trusted.MirSemantics.getElem? pack.bodySrc.locals dst,
                    Trusted.MirSemantics.getElem? pack.bodySrc.locals sLoc,
                    Trusted.MirSemantics.getElem? f₁.locals sLoc with
                  | some (.base dstTy'), some (.sliceView elemTy'), some sliceSl =>
                    if !(MirTy.beq dstTy' elemTy') || !Nat.blt offset maxUsize || !Nat.blt minLen maxUsize then
                      .fault .unsupported
                    else match sliceSl with
                      | .sliceDead | .liveSlice none => .fault .undefined
                      | .liveSlice (some sv) =>
                        match evalSliceConstRelIdx sv.len offset minLen fromEnd with
                        | .error k => .fault k
                        | .ok relIdx =>
                          match sv.backing with
                          | .dangling => .fault .undefined
                          | .arrayLocal arrLocal =>
                            if !Nat.blt (sv.start + relIdx) maxUsize then .fault .undefined
                            else evalReadArrayAtIdx pack.bodySrc f₁ cm f₁.locals dst arrLocal (sv.start + relIdx) nextBb
                      | _ => .fault .unsupported
                  | _, _, _ => .fault .unsupported) := by
              rw [evalStepArrSlice_at_term pSrc pack.bodySrc bbSrc f₁ cm hBodySrc hBbSrc hIdx₁]
              change evalArrSliceTerm pack.bodySrc bbSrc f₁ cm = _
              (dsimp [evalArrSliceTerm]; rw [hTermSrc]) <;> (dsimp; rfl)
            have hNoUnsup : (!(MirTy.beq dstTy elemTy) || !Nat.blt offset maxUsize || !Nat.blt minLen maxUsize) = false := by
              rw [hTyEq, mirTy_beq_refl elemTy, hBnds.1, hBnds.2]; rfl
            dsimp [FwdTermSim]; rw [hS1]
            have hExSl := hLM.2.2.1 sLoc k optArr hFind
            cases hExSl with | intro slS hSlS =>
            have hLive0 := step_mkLivenessCheckStmt_from_rel pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFind hSlS.1
            cases hSlSEq : slS with
            | baseSlot _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
            | arrDead => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
            | liveArray _ => have hF := hSlS.2; rw [hSlSEq] at hF; cases hF
            | sliceDead =>
              have hF0 := hLive0.1 hSlSEq
              refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                fun kFault h => by
                  rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                  injection h with hkEq; rw [← hkEq]
                  exact ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _, (stepArrSlice_iff_evalStep _ _ _).mpr hF0⟩⟩
            | liveSlice optSv =>
              have hStep0Ex := step_mkLivenessCheckStmt_live_pres pack bbTgt f₂ cm f₁.locals hBodyTgt hBbTgt hG0 hLM hFind (by rw [hSlS.1, hSlSEq])
              cases hStep0Ex with | intro slots₂_1 hS0 =>
              have hReach0 := reachesNArrSlice_one_step hS0.2.1
              let f₂_1 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂_1 }
              have hExSl1 := hS0.2.2.2.2.1 sLoc k optArr hFind
              cases hExSl1 with | intro slS1 hSlS1 =>
              have hEqSl1 : slS1 = .liveSlice optSv := by
                have hS : some slS1 = some (.liveSlice optSv) := by rw [← hSlS1.1, hSlS.1, hSlSEq]
                injection hS
              rw [hEqSl1] at hSlS1
              cases optSv with
              | none =>
                have hRT := step_readTag_from_rel pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFind hSlS1.1
                have hF1 := hRT.1 rfl
                refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                  fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; cases h),
                  fun kFault h => by
                    rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                    injection h with hkEq; rw [← hkEq]
                    exact reachesArrSlice_of_reach_fault hReach0 hF1⟩
              | some sv =>
                have hStep1Ex := step_readTag_from_rel_set pack bbTgt f₂_1 cm f₁.locals hBodyTgt hBbTgt hG1 hS0.2.2 hFind hSlS1.1
                cases hStep1Ex with | intro slots₂_2 hS1 =>
                have hReach1 := reachesNArrSlice_trans hReach0 (reachesNArrSlice_one_step hS1.2.1)
                let f₂_2 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 2, locals := slots₂_2 }
                have hExSl2 := hS1.2.2.2.2.1 sLoc k optArr hFind
                cases hExSl2 with | intro slS2 hSlS2 =>
                have hEqSl2 : slS2 = .liveSlice (some sv) := by
                  have hS : some slS2 = some (.liveSlice (some sv)) := by rw [← hSlS2.1, hSlS.1, hSlSEq]
                  injection hS
                rw [hEqSl2] at hSlS2
                have hComp2 := hSlS2.2; dsimp [SliceCompRel] at hComp2
                have hSvLenLtMax : sv.len < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left _ _) hComp2.1
                have hLenDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (off + 3) = some (.base usizeTy) :=
                  getElem?_bodyTgt_locals_comp pack hkLt (r := 3) (by decide)
                have hSub2 := step_subUnchecked_copy_const_from_rel_set pack bbTgt f₂_2 cm f₁.locals 1 (by decide)
                  (off + 3) sv.len minLen hSvLenLtMax hMinLtMax hBodyTgt hBbTgt hG2 hS1.2.2 hLenDecl hComp2.2.2.2.2.2
                have hTagNeA : scrTag ≠ scrA := by
                  intro hEq; have hEq' : scrTag + 0 = scrA := by rw [Nat.add_zero]; exact hEq
                  exact absurd (Nat.add_left_cancel hEq') (by decide)
                have hTagNeB : scrTag ≠ scrB := by
                  intro hEq; have hEq' : scrTag + 0 = scrB := by rw [Nat.add_zero]; exact hEq
                  exact absurd (Nat.add_left_cancel hEq') (by decide)
                have hTagNeIdx : scrTag ≠ scrIdx := by
                  intro hEq; have hEq' : scrTag + 0 = scrIdx := by rw [Nat.add_zero]; exact hEq
                  exact absurd (Nat.add_left_cancel hEq') (by decide)
                cases Nat.decLt sv.len minLen with
                | isTrue hLenLtMin =>
                  have hBleFalse : Nat.ble minLen sv.len = false := by
                    cases hb : Nat.ble minLen sv.len with
                    | false => rfl
                    | true => exact False.elim (Nat.lt_irrefl _ (Nat.lt_of_lt_of_le hLenLtMin (nat_ble_le hb)))
                  have hF2 := hSub2.1 hLenLtMin
                  refine ⟨fun s₁' h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp [evalSliceConstRelIdx] at h; rw [hBleFalse] at h; cases h),
                    fun out h => (by rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h; dsimp [evalSliceConstRelIdx] at h; rw [hBleFalse] at h; cases h),
                    fun kFault h => by
                      rw [hDstDecl, hSD, hSlS.1, hSlSEq] at h; dsimp at h; rw [hNoUnsup] at h
                      dsimp [evalSliceConstRelIdx] at h; rw [hBleFalse] at h
                      injection h with hkEq; rw [← hkEq]
                      exact reachesArrSlice_of_reach_fault hReach1 hF2⟩
                | isFalse hNotLt =>
                  have hMinLeLen : minLen ≤ sv.len := Nat.le_of_not_lt hNotLt
                  have hBleTrue : Nat.ble minLen sv.len = true := le_nat_ble hMinLeLen
                  have hSub2Ex := hSub2.2 hMinLeLen
                  cases hSub2Ex with | intro slots₂_3 hS2 =>
                  have hReach2 := reachesNArrSlice_trans hReach1 (reachesNArrSlice_one_step hS2.2.1)
                  let f₂_3 : ArrSliceFrame := { f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂_3 }
                  have hTagVal3 : Trusted.MirSemantics.getElem? slots₂_3 scrTag =
                      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))))) := by
                    rw [getElem?_setElem?_ne _ _ _ _ _ (Ne.symm hTagNeA) hS2.1]
                    exact getElem?_setElem?_self _ _ _ _ hS1.1
                  have hExSl3 := hS2.2.2.2.2.1 sLoc k optArr hFind
                  cases hExSl3 with | intro slS3 hSlS3 =>
                  have hEqSl3 : slS3 = .liveSlice (some sv) := by
                    have hS : some slS3 = some (.liveSlice (some sv)) := by rw [← hSlS3.1, hSlS.1, hSlSEq]
                    injection hS
                  rw [hEqSl3] at hSlS3
                  have hComp3 := hSlS3.2; dsimp [SliceCompRel] at hComp3
                  cases hFE : fromEnd with
                  | false =>
                    have hG3 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 3) =
                        some (mkSubUncheckedUsize scrA (.copy { localId := off + 3, projection := [] }) (usizeConst 1)) := by
                      have h3 := hGetPre 3 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk]; rw [hFE]; exact nat_blt_lt rfl))
                      rw [hLowEq] at h3; cases optArr <;> (dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk] at h3; rw [hFE] at h3; exact h3)
                    have hG4 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 4) =
                        some (mkSubUncheckedUsize scrB (.move { localId := scrA, projection := [] }) (usizeConst offset)) := by
                      have h4 := hGetPre 4 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk]; rw [hFE]; exact nat_blt_lt rfl))
                      rw [hLowEq] at h4; cases optArr <;> (dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk] at h4; rw [hFE] at h4; exact h4)
                    have hG5 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 5) =
                        some (mkAssignUse scrIdx (usizeConst offset)) := by
                      have h5 := hGetPre 5 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk]; rw [hFE]; exact nat_blt_lt rfl))
                      rw [hLowEq] at h5; cases optArr <;> (dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk] at h5; rw [hFE] at h5; exact h5)
                    have hG6 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 6) =
                        some (mkSubUncheckedUsize scrB (.move { localId := scrTag, projection := [] }) (usizeConst 1)) := by
                      have h6 := hGetPre 6 (by rw [hLowEq]; cases optArr <;> (dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk]; rw [hFE]; exact nat_blt_lt rfl))
                      rw [hLowEq] at h6; cases optArr <;> (dsimp [lowerReadSliceConstOut, preHead, relStmts, tagChk] at h6; rw [hFE] at h6; exact h6)
                    have h1LtMax : 1 < maxUsize := by rw [maxUsize_eq]; decide
