private theorem step_move_scr_to_comp
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (k rDst rSrc : Nat) (hk : k < plan.entries.length)
    (hrDst : rDst < 4) (hrSrc : rSrc < 4) (n : Nat) (hn : n < maxUsize)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies frame₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks frame₂.blockIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements frame₂.stmtIdx =
      some (mkAssignUse (pack.bodySrc.locals.length + 4 * k + rDst)
        (.move { localId := pack.bodySrc.locals.length + 4 * plan.entries.length + rSrc, projection := [] })))
    (hSrcSlot : Trusted.MirSemantics.getElem? frame₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + rSrc) =
      some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))))))
    (hDstOv : ∃ ov, Trusted.MirSemantics.getElem? frame₂.locals (pack.bodySrc.locals.length + 4 * k + rDst) =
      some (.baseSlot (.live ov)))
    (hrDstPos : 0 < rDst) :
    ∃ slotsMid slots₂',
      setElem? frame₂.locals (pack.bodySrc.locals.length + 4 * plan.entries.length + rSrc)
        (.baseSlot (.live none)) = some slotsMid ∧
      setElem? slotsMid (pack.bodySrc.locals.length + 4 * k + rDst)
        (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)))))) = some slots₂' ∧
      evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
        stepStmtNext frame₂ cm slots₂' := by
  let dst := pack.bodySrc.locals.length + 4 * k + rDst
  let src := pack.bodySrc.locals.length + 4 * plan.entries.length + rSrc
  have hNe4S : Nat.beq rSrc 4 = false := by
    cases rSrc with
    | zero => rfl
    | succ r1 => cases r1 with | zero => rfl | succ r2 => cases r2 with | zero => rfl | succ r3 => cases r3 with | zero => rfl | succ _ => exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hrSrc)))))
  have hSrcDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals src = some (.base usizeTy) := by
    have hD := getElem?_bodyTgt_locals_scratch pack (Nat.lt_trans hrSrc (by decide))
    rw [hNe4S] at hD; exact hD
  have hDstDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some (.base usizeTy) := by
    have hD := getElem?_bodyTgt_locals_comp pack hk hrDst
    cases rDst with
    | zero => exact False.elim (Nat.lt_irrefl 0 hrDstPos)
    | succ r1 =>
      cases r1 with
      | zero => exact hD
      | succ r2 => cases r2 with | zero => exact hD | succ _ => exact hD
  have h4 : 4 * k + rDst < 4 * plan.entries.length := by
    have hk4 : 4 * (k + 1) ≤ 4 * plan.entries.length := Nat.mul_le_mul_left 4 hk
    rw [Nat.mul_succ] at hk4
    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hrDst (4 * k)) hk4
  have hNe : src ≠ dst := by
    apply Nat.ne_of_gt
    dsimp [dst, src]
    rw [Nat.add_assoc pack.bodySrc.locals.length (4 * k) rDst]
    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left h4 _) (Nat.le_add_right _ _)
  cases hDstOv with | intro ov hOv =>
  exact step_mkAssignUse_move_usize pTgt pack.bodyTgt bbTgt frame₂ cm dst src n ov hn hNe
    hBodyTgt hBbTgt hStmt hDstDecl hSrcDecl hSrcSlot hOv

private theorem nat_beq_four_false_of_lt4 {r : Nat} (hr : r < 4) : Nat.beq r 4 = false := by
  cases r with
  | zero => rfl
  | succ r1 =>
    cases r1 with
    | zero => rfl
    | succ r2 =>
      cases r2 with
      | zero => rfl
      | succ r3 =>
        cases r3 with
        | zero => rfl
        | succ _ => exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hr)))))

private theorem step_mkLivenessCheckStmt_live_pres
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (slots₁ : List ArrSliceSlot) {sLoc k : Nat} {optArr : Option LocalId} {optSv : Option SliceViewVal}
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies frame₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks frame₂.blockIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements frame₂.stmtIdx =
      some (mkLivenessCheckStmt (pack.bodySrc.locals.length + 4 * k)))
    (hLM : SliceLocalMatch pack slots₁ frame₂.locals)
    (hFind : findSliceEntry plan.entries sLoc = some (k, optArr))
    (hSlot₁ : Trusted.MirSemantics.getElem? slots₁ sLoc = some (.liveSlice optSv)) :
    ∃ slots₂',
      setElem? frame₂.locals (pack.bodySrc.locals.length + 4 * k) (.baseSlot (.live (some .unit))) = some slots₂' ∧
      evalStepArrSlice pTgt 0 { frames := [frame₂], callerMem := cm } =
        stepStmtNext frame₂ cm slots₂' ∧
      SliceLocalMatch pack slots₁ slots₂' := by
  have hkLt := (findSliceEntry_some_lt_and_valid pack.hLoop hFind).1
  have hDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals (pack.bodySrc.locals.length + 4 * k) =
      some (.base .unit) := by
    have hG := getElem?_bodyTgt_locals_comp pack hkLt (r := 0) (by decide)
    rw [Nat.add_zero] at hG
    exact hG
  have hEx := hLM.2.2.1 sLoc k optArr hFind
  cases hEx with | intro sl₁' hSl =>
  have hEqSl : sl₁' = .liveSlice optSv := by
    have hS : some sl₁' = some (.liveSlice optSv) := by rw [← hSl.1, hSlot₁]
    injection hS
  rw [hEqSl] at hSl
  have hComp := hSl.2
  have hExOv : ∃ ov, Trusted.MirSemantics.getElem? frame₂.locals (pack.bodySrc.locals.length + 4 * k) =
      some (.baseSlot (.live ov)) := by
    cases optSv with
    | none => exact hComp.1
    | some _ => exact hComp.2.2.1
  cases hExOv with | intro ov hOv =>
  have hStep := step_mkLivenessCheckStmt_live pTgt pack.bodyTgt bbTgt frame₂ cm _ ov
    hBodyTgt hBbTgt hStmt hDecl hOv
  cases hStep with | intro slots₂' hStepPair =>
  have hLM' := sliceLocalMatch_set_comp_live0 pack hLM hFind hSlot₁ hStepPair.1
  exact ⟨slots₂', hStepPair.1, hStepPair.2, hLM'⟩

private theorem step_mkImmediateUbStmt_from_rel
    {plan : SliceScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : SliceScalarizePack plan pSrc pTgt)
    (bbTgt : ArrSliceBlock) (frame₂ : ArrSliceFrame) (cm : CallerMemory)
    (rDst : Nat) (hrDst : rDst < 4)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies frame₂.defId = some pack.bodyTgt)
