   rfl,
   (negativeCanaryArrSlice_of_exec (fuel := 10) (by rfl)).1,
   execBase_sound (fuel := 30) (by rfl)⟩

/-- **CE4 (`LowerSliceLenCalls` + `GvnFoldPtrMetadata` Pass Chain):**
Lowers `sliceLenCall` to `ptrMetadata` and folds `ptrMetadata(unsize([u32; 4]))`
to `const 4_usize`. -/
noncomputable def progCe4Src : ArrSliceProgram where
  bodies := [{
    argumentCount := 0
    locals := [.base usizeTy, .array (.int .i32 false) 4, .sliceView (.int .i32 false)]
    basicBlocks := [
      { statements := [.unsizeArrayToSlice 2 1]
        terminator := .sliceLenCall 0 2 1 },
