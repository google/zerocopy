private theorem arrSc_exec_mkStorageLiveRange_elems
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bbTgt : ArrSliceBlock) (cm : CallerMemory)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt) :
    ∀ (count : Nat) (sIdx elemOff : Nat) (f₂ : ArrSliceFrame),
      f₂.defId = plan.defId →
      f₂.blockIdx = bbIdx →
      f₂.stmtIdx = sIdx →
      elemOff + count ≤ pack.len →
      pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ f₂.locals.length →
      (∀ k : Nat, k < count →
        Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + k) =
          some (.baseStmt (.storageLive (pack.bodySrc.locals.length + 1 + (elemOff + k))))) →
      ∃ slots₂' : List ArrSliceSlot,
        ReachesNArrSlice pTgt count { frames := [f₂], callerMem := cm }
          { frames := [{ f₂ with stmtIdx := sIdx + count, locals := slots₂' }], callerMem := cm } ∧
        slots₂'.length = f₂.locals.length ∧
        (∀ idx : Nat, idx < pack.bodySrc.locals.length + 1 + elemOff →
          Trusted.MirSemantics.getElem? slots₂' idx =
            Trusted.MirSemantics.getElem? f₂.locals idx) ∧
        (∀ k : Nat, k < count →
          Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 1 + (elemOff + k)) =
            some (.baseSlot (.live (initElemOptVal pack.elemTy)))) ∧
        (∀ idx : Nat, pack.bodySrc.locals.length + 1 + (elemOff + count) ≤ idx →
          Trusted.MirSemantics.getElem? slots₂' idx =
            Trusted.MirSemantics.getElem? f₂.locals idx)
  | 0, sIdx, elemOff, f₂, _, _, hSIdx, _, _, _ => by
    rw [Nat.add_zero, ← hSIdx]
    exact ⟨f₂.locals, ReachesNArrSlice.zero _, rfl, fun _ _ => rfl,
      (fun _ hk => nomatch hk), fun _ _ => rfl⟩
  | count + 1, sIdx, elemOff, f₂, hDef, hBbIdx, hSIdx, hBound, hLen, hStmts => by
    let targetLoc := pack.bodySrc.locals.length + 1 + elemOff
    have hElemLt : elemOff < pack.len :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count)) hBound
    have hLocLt : targetLoc < f₂.locals.length := by
      have h1 : targetLoc < pack.bodySrc.locals.length + 1 + pack.len := by
        exact Nat.add_lt_add_left hElemLt _
      exact Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le h1 (Nat.le_add_right _ _)) hLen
    have hStmt0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.baseStmt (.storageLive targetLoc)) := by
      have h0 := hStmts 0 (Nat.zero_lt_succ count)
      rw [Nat.add_zero, Nat.add_zero] at h0
      rw [hSIdx]
      exact h0
    have hDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals targetLoc =
        some (.base pack.elemTy) := arrSc_getElem?_bodyTgt_locals_elem pack hElemLt
    cases hSet : setElem? f₂.locals targetLoc (liveUninitArrSliceSlot (.base pack.elemTy)) with
    | none =>
      cases lt_setElem?_some f₂.locals targetLoc _ hLocLt with
      | intro _ hS => rw [hS] at hSet; cases hSet
    | some slotsMid =>
      have hBodyF : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt := by
        rw [hDef]; exact hBodyTgt
      have hBbF : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
        rw [hBbIdx]; exact hBbTgt
      have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := sIdx + 1, locals := slotsMid }], callerMem := cm } := by
        rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt f₂ cm bbTgt _
          hBodyF hBbF hStmt0]
        dsimp [evalArrSliceStmt]
        rw [hDecl]
        dsimp [stepStmtNext]
        rw [hSet, hSIdx]
      let fMid : ArrSliceFrame := { f₂ with stmtIdx := sIdx + 1, locals := slotsMid }
      have hBound' : elemOff + 1 + count ≤ pack.len := by
        rw [Nat.add_right_comm elemOff 1 count]
        exact hBound
      have hLen' : pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ fMid.locals.length := by
        change pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ slotsMid.length
        rw [setElem?_length f₂.locals targetLoc _ slotsMid hSet]
        exact hLen
      have hStmts' : ∀ k : Nat, k < count →
          Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + 1 + k) =
            some (.baseStmt (.storageLive (pack.bodySrc.locals.length + 1 + (elemOff + 1 + k)))) := by
        intro k hk
        have hk1 : k + 1 < count + 1 := Nat.succ_lt_succ hk
        have hS := hStmts (k + 1) hk1
        have hEq1 : sIdx + (k + 1) = sIdx + 1 + k := by
          rw [Nat.add_comm k 1, ← Nat.add_assoc]
        have hEq2 : elemOff + (k + 1) = elemOff + 1 + k := by
          rw [Nat.add_comm k 1, ← Nat.add_assoc]
        rw [hEq1, hEq2] at hS
        exact hS
      cases arrSc_exec_mkStorageLiveRange_elems pack bbIdx bbTgt cm hBodyTgt hBbTgt
          count (sIdx + 1) (elemOff + 1) fMid hDef hBbIdx rfl hBound' hLen' hStmts' with
      | intro slots₂' hRest =>
        have hEndIdx : sIdx + 1 + count = sIdx + (count + 1) := by
          rw [Nat.add_assoc, Nat.add_comm 1 count]
        have hReach : ReachesNArrSlice pTgt (count + 1) { frames := [f₂], callerMem := cm }
            { frames := [{ f₂ with stmtIdx := sIdx + (count + 1), locals := slots₂' }], callerMem := cm } := by
          rw [← hEndIdx]
          exact arrSc_reachesNArrSlice_succ_head hStep0 hRest.1
        refine ⟨slots₂', hReach, ?_, ?_, ?_, ?_⟩
        · rw [hRest.2.1]
          exact setElem?_length f₂.locals targetLoc _ slotsMid hSet
        · intro idx hIdx
          have hLtMid : idx < pack.bodySrc.locals.length + 1 + (elemOff + 1) := by
            have h1 : idx < targetLoc := hIdx
            exact Nat.lt_trans h1 (Nat.lt_succ_self _)
          have hNeTgt : targetLoc ≠ idx := fun hEq => by
            have h1 : idx < targetLoc := hIdx
            rw [hEq] at h1
            exact nat_lt_irrefl idx h1
          rw [hRest.2.2.1 idx hLtMid]
          exact getElem?_setElem?_ne f₂.locals targetLoc idx _ slotsMid hNeTgt hSet
        · intro k hk
          cases k with
          | zero =>
            rw [Nat.add_zero]
            have hLtMid : targetLoc < pack.bodySrc.locals.length + 1 + (elemOff + 1) := by
              change pack.bodySrc.locals.length + 1 + elemOff <
                pack.bodySrc.locals.length + 1 + (elemOff + 1)
              exact Nat.add_lt_add_left (Nat.lt_succ_self elemOff) _
            change Trusted.MirSemantics.getElem? slots₂' targetLoc = _
            rw [hRest.2.2.1 targetLoc hLtMid,
              getElem?_setElem?_self f₂.locals targetLoc _ slotsMid hSet,
              arrSc_liveUninitArrSliceSlot_base_eq pack.elemTy]
          | succ k' =>
            have hk' : k' < count := Nat.lt_of_succ_lt_succ hk
            have hEqE : elemOff + (k' + 1) = elemOff + 1 + k' := by
              rw [Nat.add_comm k' 1, ← Nat.add_assoc]
            rw [hEqE]
            exact hRest.2.2.2.1 k' hk'
        · intro idx hIdx
          have hGeMid : pack.bodySrc.locals.length + 1 + (elemOff + 1 + count) ≤ idx := by
            have hEq : elemOff + 1 + count = elemOff + (count + 1) := by
              rw [Nat.add_assoc, Nat.add_comm 1 count]
            rw [hEq]
            exact hIdx
          have hNeTgt : targetLoc ≠ idx := fun hEq => by
            have hLt : targetLoc < pack.bodySrc.locals.length + 1 + (elemOff + (count + 1)) := by
              exact Nat.add_lt_add_left (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count)) _
            rw [← hEq] at hIdx
            exact nat_lt_irrefl targetLoc (Nat.lt_of_lt_of_le hLt hIdx)
          rw [hRest.2.2.2.2 idx hGeMid]
          exact getElem?_setElem?_ne f₂.locals targetLoc idx _ slotsMid hNeTgt hSet

private theorem arrSc_exec_mkStorageDeadRange_elems
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bbTgt : ArrSliceBlock) (cm : CallerMemory)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt) :
    ∀ (count : Nat) (sIdx elemOff : Nat) (f₂ : ArrSliceFrame),
      f₂.defId = plan.defId →
      f₂.blockIdx = bbIdx →
      f₂.stmtIdx = sIdx →
      elemOff + count ≤ pack.len →
      pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ f₂.locals.length →
      (∀ k : Nat, k < count →
        Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + k) =
          some (.baseStmt (.storageDead (pack.bodySrc.locals.length + 1 + (elemOff + k))))) →
      ∃ slots₂' : List ArrSliceSlot,
        ReachesNArrSlice pTgt count { frames := [f₂], callerMem := cm }
          { frames := [{ f₂ with stmtIdx := sIdx + count, locals := slots₂' }], callerMem := cm } ∧
        slots₂'.length = f₂.locals.length ∧
        (∀ idx : Nat, idx < pack.bodySrc.locals.length + 1 + elemOff →
          Trusted.MirSemantics.getElem? slots₂' idx =
            Trusted.MirSemantics.getElem? f₂.locals idx) ∧
        (∀ k : Nat, k < count →
          Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 1 + (elemOff + k)) =
            some (.baseSlot .dead)) ∧
        (∀ idx : Nat, pack.bodySrc.locals.length + 1 + (elemOff + count) ≤ idx →
          Trusted.MirSemantics.getElem? slots₂' idx =
            Trusted.MirSemantics.getElem? f₂.locals idx)
  | 0, sIdx, elemOff, f₂, _, _, hSIdx, _, _, _ => by
    rw [Nat.add_zero, ← hSIdx]
    exact ⟨f₂.locals, ReachesNArrSlice.zero _, rfl, fun _ _ => rfl,
      (fun _ hk => nomatch hk), fun _ _ => rfl⟩
  | count + 1, sIdx, elemOff, f₂, hDef, hBbIdx, hSIdx, hBound, hLen, hStmts => by
    let targetLoc := pack.bodySrc.locals.length + 1 + elemOff
    have hElemLt : elemOff < pack.len :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count)) hBound
    have hLocLt : targetLoc < f₂.locals.length := by
      have h1 : targetLoc < pack.bodySrc.locals.length + 1 + pack.len :=
        Nat.add_lt_add_left hElemLt _
      exact Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le h1 (Nat.le_add_right _ _)) hLen
    have hStmt0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (.baseStmt (.storageDead targetLoc)) := by
      have h0 := hStmts 0 (Nat.zero_lt_succ count)
      rw [Nat.add_zero, Nat.add_zero] at h0
      rw [hSIdx]
      exact h0
    have hNe0 : Nat.beq targetLoc 0 = false := by
      have hNe : targetLoc ≠ 0 := fun h => by
        have h' : pack.bodySrc.locals.length + (1 + elemOff) = 0 := by
          rw [← Nat.add_assoc]; exact h
        rw [Nat.add_comm 1 elemOff, ← Nat.add_assoc] at h'
        cases h'
      exact nat_beq_false hNe
    have hDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals targetLoc =
        some (.base pack.elemTy) := arrSc_getElem?_bodyTgt_locals_elem pack hElemLt
    cases hSet : setElem? f₂.locals targetLoc (deadArrSliceSlot (.base pack.elemTy)) with
    | none =>
      cases lt_setElem?_some f₂.locals targetLoc _ hLocLt with
      | intro _ hS => rw [hS] at hSet; cases hSet
    | some slotsMid =>
      have hBodyF : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt := by
        rw [hDef]; exact hBodyTgt
      have hBbF : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
        rw [hBbIdx]; exact hBbTgt
      have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := sIdx + 1, locals := slotsMid }], callerMem := cm } := by
        rw [arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt f₂ cm bbTgt _
          hBodyF hBbF hStmt0]
        dsimp [evalArrSliceStmt]
        rw [hNe0]
        dsimp
        rw [hDecl]
        dsimp [stepStmtNext]
        rw [hSet, hSIdx]
      let fMid : ArrSliceFrame := { f₂ with stmtIdx := sIdx + 1, locals := slotsMid }
      have hBound' : elemOff + 1 + count ≤ pack.len := by
        rw [Nat.add_right_comm elemOff 1 count]
        exact hBound
      have hLen' : pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ fMid.locals.length := by
        change pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ slotsMid.length
        rw [setElem?_length f₂.locals targetLoc _ slotsMid hSet]
        exact hLen
      have hStmts' : ∀ k : Nat, k < count →
          Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + 1 + k) =
            some (.baseStmt (.storageDead (pack.bodySrc.locals.length + 1 + (elemOff + 1 + k)))) := by
        intro k hk
        have hk1 : k + 1 < count + 1 := Nat.succ_lt_succ hk
        have hS := hStmts (k + 1) hk1
        have hEq1 : sIdx + (k + 1) = sIdx + 1 + k := by
          rw [Nat.add_comm k 1, ← Nat.add_assoc]
        have hEq2 : elemOff + (k + 1) = elemOff + 1 + k := by
          rw [Nat.add_comm k 1, ← Nat.add_assoc]
        rw [hEq1, hEq2] at hS
        exact hS
      cases arrSc_exec_mkStorageDeadRange_elems pack bbIdx bbTgt cm hBodyTgt hBbTgt
          count (sIdx + 1) (elemOff + 1) fMid hDef hBbIdx rfl hBound' hLen' hStmts' with
      | intro slots₂' hRest =>
        have hEndIdx : sIdx + 1 + count = sIdx + (count + 1) := by
          rw [Nat.add_assoc, Nat.add_comm 1 count]
        have hReach : ReachesNArrSlice pTgt (count + 1) { frames := [f₂], callerMem := cm }
            { frames := [{ f₂ with stmtIdx := sIdx + (count + 1), locals := slots₂' }], callerMem := cm } := by
          rw [← hEndIdx]
          exact arrSc_reachesNArrSlice_succ_head hStep0 hRest.1
        refine ⟨slots₂', hReach, ?_, ?_, ?_, ?_⟩
        · rw [hRest.2.1]
          exact setElem?_length f₂.locals targetLoc _ slotsMid hSet
        · intro idx hIdx
          have hLtMid : idx < pack.bodySrc.locals.length + 1 + (elemOff + 1) :=
            Nat.lt_trans hIdx (Nat.lt_succ_self _)
          have hNeTgt : targetLoc ≠ idx := fun hEq => by
            have h1 : idx < targetLoc := hIdx
            rw [hEq] at h1
            exact nat_lt_irrefl idx h1
          rw [hRest.2.2.1 idx hLtMid]
          exact getElem?_setElem?_ne f₂.locals targetLoc idx _ slotsMid hNeTgt hSet
        · intro k hk
          cases k with
          | zero =>
            rw [Nat.add_zero]
            have hLtMid : targetLoc < pack.bodySrc.locals.length + 1 + (elemOff + 1) := by
              change pack.bodySrc.locals.length + 1 + elemOff <
                pack.bodySrc.locals.length + 1 + (elemOff + 1)
              exact Nat.add_lt_add_left (Nat.lt_succ_self elemOff) _
            change Trusted.MirSemantics.getElem? slots₂' targetLoc = _
            rw [hRest.2.2.1 targetLoc hLtMid,
              getElem?_setElem?_self f₂.locals targetLoc _ slotsMid hSet]
            rfl
          | succ k' =>
            have hk' : k' < count := Nat.lt_of_succ_lt_succ hk
            have hEqE : elemOff + (k' + 1) = elemOff + 1 + k' := by
              rw [Nat.add_comm k' 1, ← Nat.add_assoc]
            rw [hEqE]
            exact hRest.2.2.2.1 k' hk'
        · intro idx hIdx
          have hGeMid : pack.bodySrc.locals.length + 1 + (elemOff + 1 + count) ≤ idx := by
            have hEq : elemOff + 1 + count = elemOff + (count + 1) := by
              rw [Nat.add_assoc, Nat.add_comm 1 count]
            rw [hEq]
            exact hIdx
          have hNeTgt : targetLoc ≠ idx := fun hEq => by
            have hLt : targetLoc < pack.bodySrc.locals.length + 1 + (elemOff + (count + 1)) :=
              Nat.add_lt_add_left (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count)) _
            rw [← hEq] at hIdx
            exact nat_lt_irrefl targetLoc (Nat.lt_of_lt_of_le hLt hIdx)
          rw [hRest.2.2.2.2 idx hGeMid]
          exact getElem?_setElem?_ne f₂.locals targetLoc idx _ slotsMid hNeTgt hSet

private theorem arrSc_getElem?_mkStorageLiveRange
    (start count k : Nat) (hk : k < count) :
    Trusted.MirSemantics.getElem? (mkStorageLiveRange start count) k =
      some (.baseStmt (.storageLive (start + k))) := by
  induction count generalizing start k with
  | zero => exact nomatch hk
  | succ c ih =>
    cases k with
    | zero => rw [Nat.add_zero]; rfl
    | succ k' =>
      have hEq : start + 1 + k' = start + (k' + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 k']
      rw [← hEq]
      exact ih (start + 1) k' (Nat.lt_of_succ_lt_succ hk)

private theorem arrSc_getElem?_mkStorageDeadRange
    (start count k : Nat) (hk : k < count) :
    Trusted.MirSemantics.getElem? (mkStorageDeadRange start count) k =
      some (.baseStmt (.storageDead (start + k))) := by
  induction count generalizing start k with
  | zero => exact nomatch hk
  | succ c ih =>
    cases k with
    | zero => rw [Nat.add_zero]; rfl
    | succ k' =>
      have hEq : start + 1 + k' = start + (k' + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 k']
      rw [← hEq]
      exact ih (start + 1) k' (Nat.lt_of_succ_lt_succ hk)

private theorem arrSc_getElem?_mkEvalOpsToArrScratch
    (scrStart : Nat) :
    ∀ (ops : List Operand) (k : Nat) (op : Operand),
      Trusted.MirSemantics.getElem? ops k = some op →
      Trusted.MirSemantics.getElem? (mkEvalOpsToArrScratch scrStart ops) k =
        some (mkAssignUse (scrStart + k) op)
  | [], _, _, h => by cases h
  | o :: _, 0, op, h => by
    have hEq := Option.some.inj h
    rw [hEq, Nat.add_zero]
    rfl
  | _ :: tl, k + 1, op, h => by
    have hEq : scrStart + 1 + k = scrStart + (k + 1) := by
      rw [Nat.add_assoc, Nat.add_comm 1 k]
    rw [← hEq]
    exact arrSc_getElem?_mkEvalOpsToArrScratch (scrStart + 1) tl k op h

private theorem arrSc_mkEvalOpsToArrScratch_length (scrStart : Nat) :
    ∀ (ops : List Operand), (mkEvalOpsToArrScratch scrStart ops).length = ops.length
  | [] => rfl
  | _ :: tl => congrArg Nat.succ (arrSc_mkEvalOpsToArrScratch_length (scrStart + 1) tl)

private theorem arrSc_getElem?_mkMoveArrScratchToElems
    (elemStart scrStart count k : Nat) (hk : k < count) :
    Trusted.MirSemantics.getElem? (mkMoveArrScratchToElems elemStart scrStart count) k =
      some (mkAssignUse (elemStart + k) (.move { localId := scrStart + k, projection := [] })) := by
  induction count generalizing elemStart scrStart k with
  | zero => exact nomatch hk
  | succ c ih =>
    cases k with
    | zero => rw [Nat.add_zero, Nat.add_zero]; rfl
    | succ k' =>
      have hEq1 : elemStart + 1 + k' = elemStart + (k' + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 k']
      have hEq2 : scrStart + 1 + k' = scrStart + (k' + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 k']
      rw [← hEq1, ← hEq2]
      exact ih (elemStart + 1) (scrStart + 1) k' (Nat.lt_of_succ_lt_succ hk)

private theorem arrSc_mkMoveArrScratchToElems_length (elemStart scrStart : Nat) :
    ∀ count : Nat, (mkMoveArrScratchToElems elemStart scrStart count).length = count
  | 0 => rfl
  | c + 1 => congrArg Nat.succ (arrSc_mkMoveArrScratchToElems_length (elemStart + 1) (scrStart + 1) c)

private theorem arrSc_getElem?_mkCopyValToElems
    (valScr elemStart count k : Nat) (hk : k < count) :
    Trusted.MirSemantics.getElem? (mkCopyValToElems valScr elemStart count) k =
      some (mkAssignUse (elemStart + k) (.copy { localId := valScr, projection := [] })) := by
  induction count generalizing elemStart k with
  | zero => exact nomatch hk
  | succ c ih =>
    cases k with
    | zero => rw [Nat.add_zero]; rfl
    | succ k' =>
      have hEq : elemStart + 1 + k' = elemStart + (k' + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 k']
      rw [← hEq]
      exact ih (elemStart + 1) k' (Nat.lt_of_succ_lt_succ hk)

private theorem arrSc_mkCopyValToElems_length (valScr elemStart : Nat) :
    ∀ count : Nat, (mkCopyValToElems valScr elemStart count).length = count
  | 0 => rfl
  | c + 1 => congrArg Nat.succ (arrSc_mkCopyValToElems_length valScr (elemStart + 1) c)

private theorem arrSc_exec_mkEvalOpsToArrScratch
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bbTgt : ArrSliceBlock) (cm : CallerMemory)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt) :
    ∀ (ops : List Operand) (sIdx scrOff : Nat) (slots₁ : List ArrSliceSlot)
      (f₂ : ArrSliceFrame),
      f₂.defId = plan.defId →
      f₂.blockIdx = bbIdx →
      f₂.stmtIdx = sIdx →
      scrOff + ops.length ≤ pack.len →
      arrSc_LocalMatch pack slots₁ f₂.locals →
      ops.all (operandUsesOnlyBase pack.bodySrc.locals) = true →
      (∀ k : Nat, k < ops.length →
        ∃ op : Operand,
          Trusted.MirSemantics.getElem? ops k = some op ∧
          Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + k) =
            some (mkAssignUse (pack.bodySrc.locals.length + 1 + pack.len + 4 + (scrOff + k)) op)) →
      (∀ k : FaultKind,
        evalArrSliceTypedOps pack.bodySrc.locals pack.elemTy slots₁ ops = .error k →
        ∃ s₂' : ArrSliceState,
          ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧
          StepArrSlice pTgt s₂' (.fault k)) ∧
      (∀ (vals : List Val) (slots₁' : List ArrSliceSlot),
        evalArrSliceTypedOps pack.bodySrc.locals pack.elemTy slots₁ ops = .ok (vals, slots₁') →
        ∃ slots₂' : List ArrSliceSlot,
          ReachesNArrSlice pTgt ops.length { frames := [f₂], callerMem := cm }
            { frames := [{ f₂ with stmtIdx := sIdx + ops.length, locals := slots₂' }], callerMem := cm } ∧
          vals.length = ops.length ∧
          arrSc_LocalMatch pack slots₁' slots₂' ∧
          (∀ idx : Nat, pack.bodySrc.locals.length ≤ idx →
            idx < pack.bodySrc.locals.length + 1 + pack.len + 4 + scrOff →
            Trusted.MirSemantics.getElem? slots₂' idx =
              Trusted.MirSemantics.getElem? f₂.locals idx) ∧
          (∀ j : Nat, j < ops.length →
            ∃ v : Val,
              Trusted.MirSemantics.getElem? vals j = some v ∧
              checkVal v pack.elemTy = true ∧
              Trusted.MirSemantics.getElem? slots₂'
                (pack.bodySrc.locals.length + 1 + pack.len + 4 + (scrOff + j)) =
                  some (.baseSlot (.live (some v)))))
  | [], sIdx, _, slots₁, f₂, _, _, hSIdx, _, hLM, _, _ => by
    constructor
    · intro k hErr; cases hErr
    · intro vals slots₁' hOk
      dsimp [evalArrSliceTypedOps] at hOk
      have hPair := Option.some.inj (congrArg Except.toOption hOk)
      have hVEq : [] = vals := congrArg Prod.fst hPair
      have hSEq : slots₁ = slots₁' := congrArg Prod.snd hPair
      rw [← hVEq, ← hSEq, Nat.add_zero, ← hSIdx]
      exact ⟨f₂.locals, ReachesNArrSlice.zero _, rfl, hLM, fun _ _ _ => rfl, fun _ hj => nomatch hj⟩
  | op :: rest, sIdx, scrOff, slots₁, f₂, hDef, hBbIdx, hSIdx, hBound, hLM, hAll, hStmts => by
    have hAnd := (bool_and_eq_true _ _).mp hAll
    let scrLoc := pack.bodySrc.locals.length + 1 + pack.len + 4 + scrOff
    have hScrLtLen : scrOff < pack.len :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rest.length)) hBound
    have hR4 : 4 + scrOff < 4 + pack.len := Nat.add_lt_add_left hScrLtLen 4
    have hScrLocEq : pack.bodySrc.locals.length + 1 + pack.len + (4 + scrOff) = scrLoc := by
      rw [← Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 scrOff]
    have hDeclScr : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrLoc =
        some (.base pack.elemTy) := arrSc_getElem?_bodyTgt_locals_opScr pack hScrLtLen
    have hStmt0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (mkAssignUse scrLoc op) := by
      cases hStmts 0 (Nat.zero_lt_succ rest.length) with
      | intro op0 h0 =>
        have hOpEq : op = op0 := Option.some.inj h0.1
        have hS := h0.2
        rw [Nat.add_zero, Nat.add_zero, ← hOpEq, ← hSIdx] at hS
        exact hS
    have hBodyF : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt := by
      rw [hDef]; exact hBodyTgt
    have hBbF : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
      rw [hBbIdx]; exact hBbTgt
    cases arrSc_evalArrSliceTypedOperand_prefix pack hLM.1 pack.elemTy op hAnd.1 with
    | inl hErrOp =>
      cases hErrOp with
      | intro k hk =>
        constructor
        · intro kErr hErrAll
          dsimp [evalArrSliceTypedOps] at hErrAll
          rw [hk.1] at hErrAll
          have hEqK : k = kErr := Except.error.inj hErrAll
          rw [← hEqK]
          refine ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _, ?_⟩
          exact (stepArrSlice_iff_evalStep pTgt { frames := [f₂], callerMem := cm } (.fault k)).mpr
            (arrSc_step_mkAssignUse_typedOp_err pTgt pack.bodyTgt bbTgt f₂ cm
              scrLoc pack.elemTy op k hBodyF hBbF hStmt0 hDeclScr hk.2)
        · intro vals slots₁' hOk
          dsimp [evalArrSliceTypedOps] at hOk
          rw [hk.1] at hOk
          cases hOk
    | inr hOkOp =>
      cases hOkOp with
      | intro v h1 => cases h1 with
      | intro slots₁Mid h2 => cases h2 with
      | intro slots₂Mid hOp =>
        have hLiveScrBox : ∃ ov : Option Val,
            Trusted.MirSemantics.getElem? slots₂Mid scrLoc = some (.baseSlot (.live ov)) := by
          rw [hOp.2.2.2.2.2.1 scrLoc
            (Nat.le_trans (Nat.le_add_right _ 1)
              (Nat.le_trans (Nat.le_add_right _ pack.len)
                (Nat.le_trans (Nat.le_add_right _ 4) (Nat.le_add_right _ scrOff))))]
          rw [← hScrLocEq]
          exact hLM.2.2.2 (4 + scrOff) hR4
        cases hLiveScrBox with
        | intro ovScr hLiveScr =>
          have hLtScrMid : scrLoc < slots₂Mid.length :=
            getElem?_some_lt slots₂Mid scrLoc (.baseSlot (.live ovScr)) hLiveScr
          cases hSetMid : setElem? slots₂Mid scrLoc (.baseSlot (.live (some v))) with
          | none =>
            cases lt_setElem?_some slots₂Mid scrLoc (.baseSlot (.live (some v))) hLtScrMid with
            | intro _ hS => rw [hS] at hSetMid; cases hSetMid
          | some slots₂Next =>
            have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
                stepStmtNext f₂ cm slots₂Next :=
              arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt bbTgt f₂ cm
                scrLoc pack.elemTy op v slots₂Mid slots₂Next
                hBodyF hBbF hStmt0 hDeclScr hOp.2.1 ovScr hLiveScr hSetMid
            have hLMMid : arrSc_LocalMatch pack slots₁Mid slots₂Mid :=
              arrSc_localMatch_lift_prefix pack hLM hOp.2.2.2.1 hOp.2.2.2.2.1
                hOp.2.2.2.2.2.1 hOp.2.2.2.2.2.2.1
            have hSetEq : setElem? slots₂Mid (pack.bodySrc.locals.length + 1 + pack.len + (4 + scrOff))
                (.baseSlot (.live (some v))) = some slots₂Next := by
              rw [hScrLocEq]; exact hSetMid
            have hLMNext : arrSc_LocalMatch pack slots₁Mid slots₂Next :=
              arrSc_localMatch_set_scr pack hLMMid hR4 hSetEq
            let fNext : ArrSliceFrame := { f₂ with stmtIdx := sIdx + 1, locals := slots₂Next }
            have hStep0' : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
                .step { frames := [fNext], callerMem := cm } := by
              rw [hStep0]
              dsimp [stepStmtNext]
              rw [hSIdx]
            have hBound' : scrOff + 1 + rest.length ≤ pack.len := by
              rw [Nat.add_right_comm scrOff 1 rest.length]
              exact hBound
            have hStmts' : ∀ k : Nat, k < rest.length →
                ∃ opK : Operand,
                  Trusted.MirSemantics.getElem? rest k = some opK ∧
                  Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + 1 + k) =
                    some (mkAssignUse (pack.bodySrc.locals.length + 1 + pack.len + 4 + (scrOff + 1 + k)) opK) := by
              intro k hk
              cases hStmts (k + 1) (Nat.succ_lt_succ hk) with
              | intro opK hK =>
                have hEq1 : sIdx + (k + 1) = sIdx + 1 + k := by
                  rw [Nat.add_comm k 1, ← Nat.add_assoc]
                have hEq2 : scrOff + (k + 1) = scrOff + 1 + k := by
                  rw [Nat.add_comm k 1, ← Nat.add_assoc]
                rw [hEq1, hEq2] at hK
                exact ⟨opK, hK⟩
            have hRec := arrSc_exec_mkEvalOpsToArrScratch pack bbIdx bbTgt cm hBodyTgt hBbTgt
              rest (sIdx + 1) (scrOff + 1) slots₁Mid fNext hDef hBbIdx rfl hBound' hLMNext hAnd.2 hStmts'
            constructor
            · intro kErr hErrAll
              dsimp [evalArrSliceTypedOps] at hErrAll
              rw [hOp.1] at hErrAll
              dsimp at hErrAll
              cases hErrTail : evalArrSliceTypedOps pack.bodySrc.locals pack.elemTy slots₁Mid rest with
              | ok _ => rw [hErrTail] at hErrAll; cases hErrAll
              | error kTail =>
                rw [hErrTail] at hErrAll
                have hEqK : kTail = kErr := Except.error.inj hErrAll
                rw [← hEqK]
                cases hRec.1 kTail hErrTail with
                | intro s₂' hs =>
                  exact ⟨s₂', c_reachesArrSlice_head ((stepArrSlice_iff_evalStep _ _ _).mpr hStep0') hs.1, hs.2⟩
            · intro vals slots₁' hOkAll
              dsimp [evalArrSliceTypedOps] at hOkAll
              rw [hOp.1] at hOkAll
              dsimp at hOkAll
              cases hOkTail : evalArrSliceTypedOps pack.bodySrc.locals pack.elemTy slots₁Mid rest with
              | error _ => rw [hOkTail] at hOkAll; cases hOkAll
              | ok resTail =>
                rw [hOkTail] at hOkAll
                have hPair := Option.some.inj (congrArg Except.toOption hOkAll)
                have hVEq : v :: resTail.1 = vals := congrArg Prod.fst hPair
                have hSEq : resTail.2 = slots₁' := congrArg Prod.snd hPair
                have hOkTail' : evalArrSliceTypedOps pack.bodySrc.locals pack.elemTy slots₁Mid rest =
                    .ok (resTail.1, slots₁') := by
                  cases resTail
                  dsimp at hSEq
                  rw [hOkTail, hSEq]
                cases hRec.2 resTail.1 slots₁' hOkTail' with
                | intro slots₂' hR =>
                  have hEndIdx : sIdx + 1 + rest.length = sIdx + (rest.length + 1) := by
                    rw [Nat.add_assoc, Nat.add_comm 1 rest.length]
                  have hReach : ReachesNArrSlice pTgt (rest.length + 1) { frames := [f₂], callerMem := cm }
                      { frames := [{ f₂ with stmtIdx := sIdx + (rest.length + 1), locals := slots₂' }], callerMem := cm } := by
                    rw [← hEndIdx]
                    exact arrSc_reachesNArrSlice_succ_head hStep0' hR.1
                  refine ⟨slots₂', hReach, ?_, hR.2.2.1, ?_, ?_⟩
                  · rw [← hVEq]
                    exact congrArg Nat.succ hR.2.1
                  · intro idx hGeB hIdx
                    have hLtNext : idx < pack.bodySrc.locals.length + 1 + pack.len + 4 + (scrOff + 1) :=
                      Nat.lt_trans hIdx (Nat.lt_succ_self _)
                    have hNeScr : scrLoc ≠ idx := fun hEq => by
                      have h1 : idx < scrLoc := hIdx
                      rw [hEq] at h1
                      exact nat_lt_irrefl idx h1
                    rw [hR.2.2.2.1 idx hGeB hLtNext,
                      getElem?_setElem?_ne slots₂Mid scrLoc idx _ slots₂Next hNeScr hSetMid]
                    exact hOp.2.2.2.2.2.1 idx hGeB
                  · intro j hj
                    cases j with
                    | zero =>
                      rw [← hVEq, Nat.add_zero]
                      have hLtNext : scrLoc < pack.bodySrc.locals.length + 1 + pack.len + 4 + (scrOff + 1) := by
                        change pack.bodySrc.locals.length + 1 + pack.len + 4 + scrOff <
                          pack.bodySrc.locals.length + 1 + pack.len + 4 + (scrOff + 1)
                        exact Nat.add_lt_add_left (Nat.lt_succ_self scrOff) _
                      have hGeScr : pack.bodySrc.locals.length ≤ scrLoc :=
                        Nat.le_trans (Nat.le_add_right _ 1)
                          (Nat.le_trans (Nat.le_add_right _ pack.len)
                            (Nat.le_trans (Nat.le_add_right _ 4) (Nat.le_add_right _ scrOff)))
                      refine ⟨v, rfl, hOp.2.2.1, ?_⟩
                      change Trusted.MirSemantics.getElem? slots₂' scrLoc = _
                      rw [hR.2.2.2.1 scrLoc hGeScr hLtNext,
                        getElem?_setElem?_self slots₂Mid scrLoc (.baseSlot (.live (some v))) slots₂Next hSetMid]
                    | succ j' =>
                      have hj' : j' < rest.length := Nat.lt_of_succ_lt_succ hj
                      have hEqJ : scrOff + (j' + 1) = scrOff + 1 + j' := by
                        rw [Nat.add_comm j' 1, ← Nat.add_assoc]
                      rw [← hVEq, hEqJ]
                      exact hR.2.2.2.2 j' hj'

private theorem arrSc_list_mem_of_getElem? {α : Type} :
    ∀ {xs : List α} {i : Nat} {x : α},
      Trusted.MirSemantics.getElem? xs i = some x → x ∈ xs
  | [], _, _, h => by cases h
  | _ :: _, 0, x, h => by
    have hEq := Option.some.inj h
    rw [← hEq]
    exact List.Mem.head _
  | a :: tl, i + 1, x, h =>
    List.Mem.tail a (arrSc_list_mem_of_getElem? h)

private theorem arrSc_exec_mkMoveArrScratchToElems
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bbTgt : ArrSliceBlock) (cm : CallerMemory)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt) :
    ∀ (count : Nat) (sIdx off : Nat) (vals : List Val) (f₂ : ArrSliceFrame),
      f₂.defId = plan.defId →
      f₂.blockIdx = bbIdx →
      f₂.stmtIdx = sIdx →
      off + count ≤ pack.len →
      vals.length = pack.len →
      (∀ v : Val, v ∈ vals → checkVal v pack.elemTy = true) →
      pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ f₂.locals.length →
      (∀ k : Nat, k < count →
        Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + k) =
          some (mkAssignUse (pack.bodySrc.locals.length + 1 + (off + k))
            (.move { localId := pack.bodySrc.locals.length + 1 + pack.len + 4 + (off + k), projection := [] }))) →
      (∀ k : Nat, k < count →
        ∃ ov : Option Val,
          Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 1 + (off + k)) =
            some (.baseSlot (.live ov))) →
      (∀ r : Nat, r < 4 + pack.len →
        ∃ ov : Option Val,
          Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 1 + pack.len + r) =
            some (.baseSlot (.live ov))) →
      (∀ k : Nat, k < count →
        ∃ v : Val,
          Trusted.MirSemantics.getElem? vals (off + k) = some v ∧
          Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 1 + pack.len + 4 + (off + k)) =
            some (.baseSlot (.live (some v)))) →
      ∃ slots₂' : List ArrSliceSlot,
        ReachesNArrSlice pTgt count { frames := [f₂], callerMem := cm }
          { frames := [{ f₂ with stmtIdx := sIdx + count, locals := slots₂' }], callerMem := cm } ∧
        slots₂'.length = f₂.locals.length ∧
        (∀ idx : Nat, idx < pack.bodySrc.locals.length + 1 + off →
          Trusted.MirSemantics.getElem? slots₂' idx =
            Trusted.MirSemantics.getElem? f₂.locals idx) ∧
        (∀ k : Nat, k < count →
          ∃ v : Val,
            Trusted.MirSemantics.getElem? vals (off + k) = some v ∧
            Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 1 + (off + k)) =
              some (.baseSlot (.live (some v)))) ∧
        (∀ r : Nat, r < 4 + pack.len →
          ∃ ov : Option Val,
            Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 1 + pack.len + r) =
              some (.baseSlot (.live ov)))
  | 0, sIdx, _, _, f₂, _, _, hSIdx, _, _, _, _, _, _, hScrLive, _ => by
    rw [Nat.add_zero, ← hSIdx]
    exact ⟨f₂.locals, ReachesNArrSlice.zero _, rfl, fun _ _ => rfl,
      (fun _ hk => nomatch hk), hScrLive⟩
  | count + 1, sIdx, off, vals, f₂, hDef, hBbIdx, hSIdx, hBound, hValsLen, hChkVals,
      hLen, hStmts, hElemsLive, hScrLive, hScrVals => by
    let elemLoc := pack.bodySrc.locals.length + 1 + off
    let scrLoc := pack.bodySrc.locals.length + 1 + pack.len + 4 + off
    have hOffLt : off < pack.len :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count)) hBound
    have hDeclElem : Trusted.MirSemantics.getElem? pack.bodyTgt.locals elemLoc =
        some (.base pack.elemTy) := arrSc_getElem?_bodyTgt_locals_elem pack hOffLt
    have hDeclScr : Trusted.MirSemantics.getElem? pack.bodyTgt.locals scrLoc =
        some (.base pack.elemTy) := arrSc_getElem?_bodyTgt_locals_opScr pack hOffLt
    have hStmt0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (mkAssignUse elemLoc (.move { localId := scrLoc, projection := [] })) := by
      have h0 := hStmts 0 (Nat.zero_lt_succ count)
      rw [Nat.add_zero, Nat.add_zero, Nat.add_zero] at h0
      rw [hSIdx]
      exact h0
    have hNeLocs : scrLoc ≠ elemLoc := fun hEq => by
      have hLt1 : elemLoc < pack.bodySrc.locals.length + 1 + pack.len :=
        Nat.add_lt_add_left hOffLt _
      have hLe2 : pack.bodySrc.locals.length + 1 + pack.len ≤ scrLoc := by
        change pack.bodySrc.locals.length + 1 + pack.len ≤
          pack.bodySrc.locals.length + 1 + pack.len + 4 + off
        rw [Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 off]
        exact Nat.le_add_right _ _
      rw [hEq] at hLe2
      exact nat_lt_irrefl elemLoc (Nat.lt_of_lt_of_le hLt1 hLe2)
    cases hScrVals 0 (Nat.zero_lt_succ count) with
    | intro v hv =>
      rw [Nat.add_zero] at hv
      have hChkV : checkVal v pack.elemTy = true :=
        hChkVals v (arrSc_list_mem_of_getElem? hv.1)
      have hLtScr : scrLoc < f₂.locals.length :=
        getElem?_some_lt f₂.locals scrLoc _ hv.2
      cases hSetMove : setElem? f₂.locals scrLoc (.baseSlot (liveUninitSlot pack.elemTy)) with
      | none =>
        cases lt_setElem?_some f₂.locals scrLoc _ hLtScr with
        | intro _ hS => rw [hS] at hSetMove; cases hSetMove
      | some slotsAfterMove =>
        cases hElemsLive 0 (Nat.zero_lt_succ count) with
        | intro ovEl hovEl =>
          rw [Nat.add_zero] at hovEl
          have hovEl2 : Trusted.MirSemantics.getElem? slotsAfterMove elemLoc =
              some (.baseSlot (.live ovEl)) := by
            rw [getElem?_setElem?_ne f₂.locals scrLoc elemLoc _ slotsAfterMove hNeLocs hSetMove]
            exact hovEl
          have hLtEl : elemLoc < slotsAfterMove.length :=
            getElem?_some_lt slotsAfterMove elemLoc _ hovEl2
          cases hSetWrite : setElem? slotsAfterMove elemLoc (.baseSlot (.live (some v))) with
          | none =>
            cases lt_setElem?_some slotsAfterMove elemLoc _ hLtEl with
            | intro _ hS => rw [hS] at hSetWrite; cases hSetWrite
          | some slotsMid =>
            have hOpOk : evalArrSliceTypedOperand pack.bodyTgt.locals f₂.locals pack.elemTy
                (.move { localId := scrLoc, projection := [] }) = .ok (v, slotsAfterMove) := by
              dsimp [evalArrSliceTypedOperand, evalArrSliceBaseOperandToSlot]
              rw [hDeclScr, hv.2]
              dsimp
              rw [hSetMove]
              dsimp
              have hBeq : (!MirTy.beq pack.elemTy pack.elemTy) = false := by
                rw [mirTy_beq_refl]
                rfl
              rw [hBeq]
              dsimp
              rw [hChkV]
              rfl
            have hBodyF : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt := by
              rw [hDef]; exact hBodyTgt
            have hBbF : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
              rw [hBbIdx]; exact hBbTgt
            have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
                stepStmtNext f₂ cm slotsMid :=
              arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt bbTgt f₂ cm
                elemLoc pack.elemTy _ v slotsAfterMove slotsMid
                hBodyF hBbF hStmt0 hDeclElem hOpOk ovEl hovEl2 hSetWrite
            let fMid : ArrSliceFrame := { f₂ with stmtIdx := sIdx + 1, locals := slotsMid }
            have hStep0' : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
                .step { frames := [fMid], callerMem := cm } := by
              rw [hStep0]; dsimp [stepStmtNext]; rw [hSIdx]
            have hBound' : off + 1 + count ≤ pack.len := by
              rw [Nat.add_right_comm off 1 count]
              exact hBound
            have hLen' : pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ fMid.locals.length := by
              change pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ slotsMid.length
              rw [setElem?_length slotsAfterMove elemLoc _ slotsMid hSetWrite,
                setElem?_length f₂.locals scrLoc _ slotsAfterMove hSetMove]
              exact hLen
            have hStmts' : ∀ k : Nat, k < count →
                Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + 1 + k) =
                  some (mkAssignUse (pack.bodySrc.locals.length + 1 + (off + 1 + k))
                    (.move { localId := pack.bodySrc.locals.length + 1 + pack.len + 4 + (off + 1 + k), projection := [] })) := by
              intro k hk
              have hS := hStmts (k + 1) (Nat.succ_lt_succ hk)
              have hEq1 : sIdx + (k + 1) = sIdx + 1 + k := by rw [Nat.add_comm k 1, ← Nat.add_assoc]
              have hEq2 : off + (k + 1) = off + 1 + k := by rw [Nat.add_comm k 1, ← Nat.add_assoc]
              rw [hEq1, hEq2] at hS
              exact hS
            have hElemsLive' : ∀ k : Nat, k < count →
                ∃ ov : Option Val,
                  Trusted.MirSemantics.getElem? fMid.locals (pack.bodySrc.locals.length + 1 + (off + 1 + k)) =
                    some (.baseSlot (.live ov)) := by
              intro k hk
              have hEq2 : off + (k + 1) = off + 1 + k := by rw [Nat.add_comm k 1, ← Nat.add_assoc]
              cases hElemsLive (k + 1) (Nat.succ_lt_succ hk) with
              | intro ov hOv =>
                rw [hEq2] at hOv
                have hNeE : elemLoc ≠ pack.bodySrc.locals.length + 1 + (off + 1 + k) := fun h => by
                  have hLt : elemLoc < pack.bodySrc.locals.length + 1 + (off + 1 + k) := by
                    change pack.bodySrc.locals.length + 1 + off <
                      pack.bodySrc.locals.length + 1 + (off + 1 + k)
                    rw [Nat.add_assoc off 1 k]
                    exact Nat.add_lt_add_left (arrSc_lt_add_one_add off k) _
                  rw [h] at hLt
                  exact nat_lt_irrefl _ hLt
                have hNeS : scrLoc ≠ pack.bodySrc.locals.length + 1 + (off + 1 + k) := fun h => by
                  have hLt : pack.bodySrc.locals.length + 1 + (off + 1 + k) <
                      pack.bodySrc.locals.length + 1 + pack.len := by
                    have hBoundK : off + 1 + k < pack.len := by
                      have hLe : off + 1 + (k + 1) ≤ off + 1 + count := Nat.add_le_add_left hk _
                      exact Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) hLe) hBound'
                    exact Nat.add_lt_add_left hBoundK _
                  have hLe : pack.bodySrc.locals.length + 1 + pack.len ≤ scrLoc := by
                    change pack.bodySrc.locals.length + 1 + pack.len ≤
                      pack.bodySrc.locals.length + 1 + pack.len + 4 + off
                    rw [Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 off]
                    exact Nat.le_add_right _ _
                  rw [← h] at hLt
                  exact nat_lt_irrefl _ (Nat.lt_of_lt_of_le hLt hLe)
                refine ⟨ov, ?_⟩
                change Trusted.MirSemantics.getElem? slotsMid _ = _
                rw [getElem?_setElem?_ne slotsAfterMove elemLoc _ _ slotsMid hNeE hSetWrite,
                  getElem?_setElem?_ne f₂.locals scrLoc _ _ slotsAfterMove hNeS hSetMove]
                exact hOv
            have hScrLive' : ∀ r : Nat, r < 4 + pack.len →
                ∃ ov : Option Val,
                  Trusted.MirSemantics.getElem? fMid.locals (pack.bodySrc.locals.length + 1 + pack.len + r) =
                    some (.baseSlot (.live ov)) := by
              intro r hr
              let rLoc := pack.bodySrc.locals.length + 1 + pack.len + r
              have hNeE : elemLoc ≠ rLoc := fun h => by
                have hLt : elemLoc < pack.bodySrc.locals.length + 1 + pack.len :=
                  Nat.add_lt_add_left hOffLt _
                have hLe : pack.bodySrc.locals.length + 1 + pack.len ≤ rLoc :=
                  Nat.le_add_right _ r
                rw [h] at hLt
                exact nat_lt_irrefl _ (Nat.lt_of_lt_of_le hLt hLe)
              change ∃ ov, Trusted.MirSemantics.getElem? slotsMid rLoc = some (.baseSlot (.live ov))
              rw [getElem?_setElem?_ne slotsAfterMove elemLoc rLoc _ slotsMid hNeE hSetWrite]
              cases s4b_arrSc_nat_eq_or_ne r (4 + off) with
              | inl hEq =>
                have hEqLoc : scrLoc = rLoc := by
                  change pack.bodySrc.locals.length + 1 + pack.len + 4 + off =
                    pack.bodySrc.locals.length + 1 + pack.len + r
                  rw [hEq, Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 off]
                rw [← hEqLoc, getElem?_setElem?_self f₂.locals scrLoc _ slotsAfterMove hSetMove,
                  arrSc_liveUninitSlot_eq pack.elemTy]
                exact ⟨initElemOptVal pack.elemTy, rfl⟩
              | inr hNe =>
                have hNeS : scrLoc ≠ rLoc := fun h => by
                  change pack.bodySrc.locals.length + 1 + pack.len + 4 + off =
                    pack.bodySrc.locals.length + 1 + pack.len + r at h
                  rw [Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 off] at h
                  exact hNe (Nat.add_left_cancel h).symm
                rw [getElem?_setElem?_ne f₂.locals scrLoc rLoc _ slotsAfterMove hNeS hSetMove]
                exact hScrLive r hr
            have hScrVals' : ∀ k : Nat, k < count →
                ∃ vK : Val,
                  Trusted.MirSemantics.getElem? vals (off + 1 + k) = some vK ∧
                  Trusted.MirSemantics.getElem? fMid.locals
                    (pack.bodySrc.locals.length + 1 + pack.len + 4 + (off + 1 + k)) =
                      some (.baseSlot (.live (some vK))) := by
              intro k hk
              have hEq2 : off + (k + 1) = off + 1 + k := by rw [Nat.add_comm k 1, ← Nat.add_assoc]
              cases hScrVals (k + 1) (Nat.succ_lt_succ hk) with
              | intro vK hvK =>
                rw [hEq2] at hvK
                let scrK := pack.bodySrc.locals.length + 1 + pack.len + 4 + (off + 1 + k)
                have hNeE : elemLoc ≠ scrK := fun h => by
                  have hLt : elemLoc < pack.bodySrc.locals.length + 1 + pack.len :=
                    Nat.add_lt_add_left hOffLt _
                  have hLe : pack.bodySrc.locals.length + 1 + pack.len ≤ scrK := by
                    change pack.bodySrc.locals.length + 1 + pack.len ≤
                      pack.bodySrc.locals.length + 1 + pack.len + 4 + (off + 1 + k)
                    rw [Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 _]
                    exact Nat.le_add_right _ _
                  rw [h] at hLt
                  exact nat_lt_irrefl _ (Nat.lt_of_lt_of_le hLt hLe)
                have hNeS : scrLoc ≠ scrK := fun h => by
                  have hLt : scrLoc < scrK := by
                    change pack.bodySrc.locals.length + 1 + pack.len + 4 + off <
                      pack.bodySrc.locals.length + 1 + pack.len + 4 + (off + 1 + k)
                    rw [Nat.add_assoc off 1 k]
                    exact Nat.add_lt_add_left (arrSc_lt_add_one_add off k) _
                  rw [h] at hLt
                  exact nat_lt_irrefl _ hLt
                refine ⟨vK, hvK.1, ?_⟩
                change Trusted.MirSemantics.getElem? slotsMid scrK = _
                rw [getElem?_setElem?_ne slotsAfterMove elemLoc scrK _ slotsMid hNeE hSetWrite,
                  getElem?_setElem?_ne f₂.locals scrLoc scrK _ slotsAfterMove hNeS hSetMove]
                exact hvK.2
            cases arrSc_exec_mkMoveArrScratchToElems pack bbIdx bbTgt cm hBodyTgt hBbTgt
                count (sIdx + 1) (off + 1) vals fMid hDef hBbIdx rfl hBound' hValsLen hChkVals
                hLen' hStmts' hElemsLive' hScrLive' hScrVals' with
            | intro slots₂' hRest =>
              have hEndIdx : sIdx + 1 + count = sIdx + (count + 1) := by
                rw [Nat.add_assoc, Nat.add_comm 1 count]
              have hReach : ReachesNArrSlice pTgt (count + 1) { frames := [f₂], callerMem := cm }
                  { frames := [{ f₂ with stmtIdx := sIdx + (count + 1), locals := slots₂' }], callerMem := cm } := by
                rw [← hEndIdx]
                exact arrSc_reachesNArrSlice_succ_head hStep0' hRest.1
              refine ⟨slots₂', hReach, ?_, ?_, ?_, hRest.2.2.2.2⟩
              · rw [hRest.2.1]
                change slotsMid.length = f₂.locals.length
                rw [setElem?_length slotsAfterMove elemLoc _ slotsMid hSetWrite,
                  setElem?_length f₂.locals scrLoc _ slotsAfterMove hSetMove]
              · intro idx hIdx
                have hLtNext : idx < pack.bodySrc.locals.length + 1 + (off + 1) :=
                  Nat.lt_trans hIdx (Nat.lt_succ_self _)
                have hNeE : elemLoc ≠ idx := fun h => by
                  have h1 : idx < elemLoc := hIdx
                  rw [h] at h1
                  exact nat_lt_irrefl idx h1
                have hNeS : scrLoc ≠ idx := fun h => by
                  have hLt : idx < pack.bodySrc.locals.length + 1 + pack.len :=
                    Nat.lt_trans hIdx (Nat.add_lt_add_left hOffLt _)
                  have hLe : pack.bodySrc.locals.length + 1 + pack.len ≤ scrLoc := by
                    change pack.bodySrc.locals.length + 1 + pack.len ≤
                      pack.bodySrc.locals.length + 1 + pack.len + 4 + off
                    rw [Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 off]
                    exact Nat.le_add_right _ _
                  rw [← h] at hLt
                  exact nat_lt_irrefl _ (Nat.lt_of_lt_of_le hLt hLe)
                rw [hRest.2.2.1 idx hLtNext]
                change Trusted.MirSemantics.getElem? slotsMid idx = _
                rw [getElem?_setElem?_ne slotsAfterMove elemLoc idx _ slotsMid hNeE hSetWrite,
                  getElem?_setElem?_ne f₂.locals scrLoc idx _ slotsAfterMove hNeS hSetMove]
              · intro k hk
                cases k with
                | zero =>
                  rw [Nat.add_zero]
                  have hLtNext : elemLoc < pack.bodySrc.locals.length + 1 + (off + 1) := by
                    change pack.bodySrc.locals.length + 1 + off <
                      pack.bodySrc.locals.length + 1 + (off + 1)
                    exact Nat.add_lt_add_left (Nat.lt_succ_self off) _
                  refine ⟨v, hv.1, ?_⟩
                  change Trusted.MirSemantics.getElem? slots₂' elemLoc = _
                  rw [hRest.2.2.1 elemLoc hLtNext]
                  change Trusted.MirSemantics.getElem? slotsMid elemLoc = _
                  rw [getElem?_setElem?_self slotsAfterMove elemLoc (.baseSlot (.live (some v))) slotsMid hSetWrite]
                | succ k' =>
                  have hEq2 : off + (k' + 1) = off + 1 + k' := by
                    rw [Nat.add_comm k' 1, ← Nat.add_assoc]
                  rw [hEq2]
                  exact hRest.2.2.2.1 k' (Nat.lt_of_succ_lt_succ hk)

private theorem arrSc_exec_mkCopyValToElems
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bbTgt : ArrSliceBlock) (cm : CallerMemory)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (v : Val) (hChkV : checkVal v pack.elemTy = true) :
    ∀ (count : Nat) (sIdx off : Nat) (f₂ : ArrSliceFrame),
      f₂.defId = plan.defId →
      f₂.blockIdx = bbIdx →
      f₂.stmtIdx = sIdx →
      off + count ≤ pack.len →
      pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ f₂.locals.length →
      Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 1 + pack.len + 3) =
        some (.baseSlot (.live (some v))) →
      (∀ k : Nat, k < count →
        Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + k) =
          some (mkAssignUse (pack.bodySrc.locals.length + 1 + (off + k))
            (.copy { localId := pack.bodySrc.locals.length + 1 + pack.len + 3, projection := [] }))) →
      (∀ k : Nat, k < count →
        ∃ ov : Option Val,
          Trusted.MirSemantics.getElem? f₂.locals (pack.bodySrc.locals.length + 1 + (off + k)) =
            some (.baseSlot (.live ov))) →
      ∃ slots₂' : List ArrSliceSlot,
        ReachesNArrSlice pTgt count { frames := [f₂], callerMem := cm }
          { frames := [{ f₂ with stmtIdx := sIdx + count, locals := slots₂' }], callerMem := cm } ∧
        slots₂'.length = f₂.locals.length ∧
        (∀ idx : Nat, idx < pack.bodySrc.locals.length + 1 + off →
          Trusted.MirSemantics.getElem? slots₂' idx =
            Trusted.MirSemantics.getElem? f₂.locals idx) ∧
        (∀ k : Nat, k < count →
          Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 1 + (off + k)) =
            some (.baseSlot (.live (some v)))) ∧
        (∀ idx : Nat, pack.bodySrc.locals.length + 1 + (off + count) ≤ idx →
          Trusted.MirSemantics.getElem? slots₂' idx =
            Trusted.MirSemantics.getElem? f₂.locals idx)
  | 0, sIdx, _, f₂, _, _, hSIdx, _, _, _, _, _ => by
    rw [Nat.add_zero, ← hSIdx]
    exact ⟨f₂.locals, ReachesNArrSlice.zero _, rfl, fun _ _ => rfl,
      (fun _ hk => nomatch hk), fun _ _ => rfl⟩
  | count + 1, sIdx, off, f₂, hDef, hBbIdx, hSIdx, hBound, hLen, hValScr, hStmts, hElemsLive => by
    let elemLoc := pack.bodySrc.locals.length + 1 + off
    let valScr := pack.bodySrc.locals.length + 1 + pack.len + 3
    have hOffLt : off < pack.len :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count)) hBound
    have hDeclElem : Trusted.MirSemantics.getElem? pack.bodyTgt.locals elemLoc =
        some (.base pack.elemTy) := arrSc_getElem?_bodyTgt_locals_elem pack hOffLt
    have hDeclVal : Trusted.MirSemantics.getElem? pack.bodyTgt.locals valScr =
        some (.base pack.elemTy) := arrSc_getElem?_bodyTgt_locals_valScr pack
    have hStmt0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
        some (mkAssignUse elemLoc (.copy { localId := valScr, projection := [] })) := by
      have h0 := hStmts 0 (Nat.zero_lt_succ count)
      rw [Nat.add_zero, Nat.add_zero] at h0
      rw [hSIdx]
      exact h0
    have hNeVal : elemLoc ≠ valScr := fun hEq => by
      have hLt : elemLoc < pack.bodySrc.locals.length + 1 + pack.len :=
        Nat.add_lt_add_left hOffLt _
      have hLe : pack.bodySrc.locals.length + 1 + pack.len ≤ valScr := Nat.le_add_right _ 3
      rw [hEq] at hLt
      exact nat_lt_irrefl _ (Nat.lt_of_lt_of_le hLt hLe)
    cases hElemsLive 0 (Nat.zero_lt_succ count) with
    | intro ovEl hovEl =>
      rw [Nat.add_zero] at hovEl
      have hLtEl : elemLoc < f₂.locals.length := getElem?_some_lt f₂.locals elemLoc _ hovEl
      cases hSetWrite : setElem? f₂.locals elemLoc (.baseSlot (.live (some v))) with
      | none =>
        cases lt_setElem?_some f₂.locals elemLoc _ hLtEl with
        | intro _ hS => rw [hS] at hSetWrite; cases hSetWrite
      | some slotsMid =>
        have hOpOk : evalArrSliceTypedOperand pack.bodyTgt.locals f₂.locals pack.elemTy
            (.copy { localId := valScr, projection := [] }) = .ok (v, f₂.locals) := by
          dsimp [evalArrSliceTypedOperand, evalArrSliceBaseOperandToSlot]
          rw [hDeclVal, hValScr]
          dsimp
          have hBeq : (!MirTy.beq pack.elemTy pack.elemTy) = false := by
            rw [mirTy_beq_refl]
            rfl
          rw [hBeq]
          dsimp
          rw [hChkV]
          rfl
        have hBodyF : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt := by
          rw [hDef]; exact hBodyTgt
        have hBbF : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
          rw [hBbIdx]; exact hBbTgt
        have hStep0 : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
            stepStmtNext f₂ cm slotsMid :=
          arrSc_step_mkAssignUse_typedOp_ok pTgt pack.bodyTgt bbTgt f₂ cm
            elemLoc pack.elemTy _ v f₂.locals slotsMid
            hBodyF hBbF hStmt0 hDeclElem hOpOk ovEl hovEl hSetWrite
        let fMid : ArrSliceFrame := { f₂ with stmtIdx := sIdx + 1, locals := slotsMid }
        have hStep0' : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
            .step { frames := [fMid], callerMem := cm } := by
          rw [hStep0]; dsimp [stepStmtNext]; rw [hSIdx]
        have hBound' : off + 1 + count ≤ pack.len := by
          rw [Nat.add_right_comm off 1 count]
          exact hBound
        have hLen' : pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ fMid.locals.length := by
          change pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) ≤ slotsMid.length
          rw [setElem?_length f₂.locals elemLoc _ slotsMid hSetWrite]
          exact hLen
        have hValScr' : Trusted.MirSemantics.getElem? fMid.locals valScr =
            some (.baseSlot (.live (some v))) := by
          change Trusted.MirSemantics.getElem? slotsMid valScr = _
          rw [getElem?_setElem?_ne f₂.locals elemLoc valScr _ slotsMid hNeVal hSetWrite]
          exact hValScr
        have hStmts' : ∀ k : Nat, k < count →
            Trusted.MirSemantics.getElem? bbTgt.statements (sIdx + 1 + k) =
              some (mkAssignUse (pack.bodySrc.locals.length + 1 + (off + 1 + k))
                (.copy { localId := valScr, projection := [] })) := by
          intro k hk
          have hS := hStmts (k + 1) (Nat.succ_lt_succ hk)
          have hEq1 : sIdx + (k + 1) = sIdx + 1 + k := by rw [Nat.add_comm k 1, ← Nat.add_assoc]
          have hEq2 : off + (k + 1) = off + 1 + k := by rw [Nat.add_comm k 1, ← Nat.add_assoc]
          rw [hEq1, hEq2] at hS
          exact hS
        have hElemsLive' : ∀ k : Nat, k < count →
            ∃ ov : Option Val,
              Trusted.MirSemantics.getElem? fMid.locals (pack.bodySrc.locals.length + 1 + (off + 1 + k)) =
                some (.baseSlot (.live ov)) := by
          intro k hk
          have hEq2 : off + (k + 1) = off + 1 + k := by rw [Nat.add_comm k 1, ← Nat.add_assoc]
          cases hElemsLive (k + 1) (Nat.succ_lt_succ hk) with
          | intro ov hOv =>
            rw [hEq2] at hOv
            have hNeE : elemLoc ≠ pack.bodySrc.locals.length + 1 + (off + 1 + k) := fun h => by
              have hLt : elemLoc < pack.bodySrc.locals.length + 1 + (off + 1 + k) := by
                change pack.bodySrc.locals.length + 1 + off <
                  pack.bodySrc.locals.length + 1 + (off + 1 + k)
                rw [Nat.add_assoc off 1 k]
                exact Nat.add_lt_add_left (arrSc_lt_add_one_add off k) _
              rw [h] at hLt
              exact nat_lt_irrefl _ hLt
            refine ⟨ov, ?_⟩
            change Trusted.MirSemantics.getElem? slotsMid _ = _
            rw [getElem?_setElem?_ne f₂.locals elemLoc _ _ slotsMid hNeE hSetWrite]
            exact hOv
        cases arrSc_exec_mkCopyValToElems pack bbIdx bbTgt cm hBodyTgt hBbTgt v hChkV
            count (sIdx + 1) (off + 1) fMid hDef hBbIdx rfl hBound' hLen' hValScr' hStmts' hElemsLive' with
        | intro slots₂' hRest =>
          have hEndIdx : sIdx + 1 + count = sIdx + (count + 1) := by
            rw [Nat.add_assoc, Nat.add_comm 1 count]
          have hReach : ReachesNArrSlice pTgt (count + 1) { frames := [f₂], callerMem := cm }
              { frames := [{ f₂ with stmtIdx := sIdx + (count + 1), locals := slots₂' }], callerMem := cm } := by
            rw [← hEndIdx]
            exact arrSc_reachesNArrSlice_succ_head hStep0' hRest.1
          refine ⟨slots₂', hReach, ?_, ?_, ?_, ?_⟩
          · rw [hRest.2.1]
            exact setElem?_length f₂.locals elemLoc _ slotsMid hSetWrite
          · intro idx hIdx
            have hLtNext : idx < pack.bodySrc.locals.length + 1 + (off + 1) :=
              Nat.lt_trans hIdx (Nat.lt_succ_self _)
            have hNeE : elemLoc ≠ idx := fun h => by
              have h1 : idx < elemLoc := hIdx
              rw [h] at h1
              exact nat_lt_irrefl idx h1
            rw [hRest.2.2.1 idx hLtNext]
            exact getElem?_setElem?_ne f₂.locals elemLoc idx _ slotsMid hNeE hSetWrite
          · intro k hk
            cases k with
            | zero =>
              rw [Nat.add_zero]
              have hLtNext : elemLoc < pack.bodySrc.locals.length + 1 + (off + 1) := by
                change pack.bodySrc.locals.length + 1 + off <
                  pack.bodySrc.locals.length + 1 + (off + 1)
                exact Nat.add_lt_add_left (Nat.lt_succ_self off) _
              change Trusted.MirSemantics.getElem? slots₂' elemLoc = _
              rw [hRest.2.2.1 elemLoc hLtNext,
                getElem?_setElem?_self f₂.locals elemLoc (.baseSlot (.live (some v))) slotsMid hSetWrite]
            | succ k' =>
              have hEq2 : off + (k' + 1) = off + 1 + k' := by
                rw [Nat.add_comm k' 1, ← Nat.add_assoc]
              rw [hEq2]
              exact hRest.2.2.2.1 k' (Nat.lt_of_succ_lt_succ hk)
          · intro idx hIdx
            have hGeNext : pack.bodySrc.locals.length + 1 + (off + 1 + count) ≤ idx := by
              have hEq : off + 1 + count = off + (count + 1) := by rw [Nat.add_assoc, Nat.add_comm 1 count]
              rw [hEq]
              exact hIdx
            have hNeE : elemLoc ≠ idx := fun h => by
              have hLt : elemLoc < pack.bodySrc.locals.length + 1 + (off + (count + 1)) :=
                Nat.add_lt_add_left (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count)) _
              rw [← h] at hIdx
              exact nat_lt_irrefl _ (Nat.lt_of_lt_of_le hLt hIdx)
            rw [hRest.2.2.2.2 idx hGeNext]
            exact getElem?_setElem?_ne f₂.locals elemLoc idx _ slotsMid hNeE hSetWrite

