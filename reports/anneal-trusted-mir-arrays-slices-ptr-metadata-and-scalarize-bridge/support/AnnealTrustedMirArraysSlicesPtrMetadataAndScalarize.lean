/-! ## Part III, Theorem 2: `LowerSliceLenCalls` + `GVN` Metadata Folding -/

private theorem lowerSliceLenCalls_and_gvnPtrMetadata_sound_bidirectional_iff_slice2 :
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (pSrc pTgt : ArrSliceProgram),
      checkLowerSliceLenCalls bodyId bbIdx pSrc pTgt = true →
      FullSemanticEquivArrSlice pSrc pTgt) ∧
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (unsizeIdx metaIdx : Nat)
        (pSrc pTgt : ArrSliceProgram),
      checkGvnFoldPtrMetadata bodyId bbIdx unsizeIdx metaIdx pSrc pTgt = true →
      FullSemanticEquivArrSlice pSrc pTgt) := by
  constructor
  · intro bodyId bbIdx pSrc pTgt hChk
    unfold checkLowerSliceLenCalls at hChk
    cases hApp : applyLowerSliceLenCalls bodyId bbIdx pSrc with
    | none => rw [hApp] at hChk; cases hChk
    | some pOut =>
      rw [hApp] at hChk
      have hEq : pOut = pTgt := arrSliceProgramEq_eq pOut pTgt hChk
      rw [← hEq]
      exact applyLowerSliceLenCalls_sound bodyId bbIdx pSrc pOut hApp
  · intro bodyId bbIdx unsizeIdx metaIdx pSrc pTgt hChk
    unfold checkGvnFoldPtrMetadata at hChk
    cases hApp : applyGvnFoldPtrMetadata bodyId bbIdx unsizeIdx metaIdx pSrc with
    | none => rw [hApp] at hChk; cases hChk
    | some pOut =>
      rw [hApp] at hChk
      have hEq : pOut = pTgt := arrSliceProgramEq_eq pOut pTgt hChk
      rw [← hEq]
      exact applyGvnFoldPtrMetadata_sound bodyId bbIdx unsizeIdx metaIdx pSrc pOut hApp

private theorem lowerSliceLenCalls_and_gvnPtrMetadata_sound :
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (pSrc pTgt : ArrSliceProgram),
      checkLowerSliceLenCalls bodyId bbIdx pSrc pTgt = true →
      FullSemanticEquivArrSlice pSrc pTgt) ∧
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (unsizeIdx metaIdx : Nat)
        (pSrc pTgt : ArrSliceProgram),
      checkGvnFoldPtrMetadata bodyId bbIdx unsizeIdx metaIdx pSrc pTgt = true →
      FullSemanticEquivArrSlice pSrc pTgt) :=
  lowerSliceLenCalls_and_gvnPtrMetadata_sound_bidirectional_iff_slice2

