          cases hChk : (!checkVal p.1 elemTy) with
          | true => rw [hChk] at h; cases h
          | false =>
            rw [hChk] at h; dsimp at h
            cases hS : Trusted.MirSemantics.getElem? p.2 arrLocal with
            | none => rw [hS] at h; cases h
            | some sl =>
              cases sl with
              | baseSlot _ => rw [hS] at h; cases h
              | sliceDead => rw [hS] at h; cases h
              | liveSlice _ => rw [hS] at h; cases h
              | arrDead => rw [hS] at h; cases h
              | liveArray elems =>
                rw [hS] at h; dsimp at h
                cases hLt : !Nat.blt idx len with
                | true => rw [hLt] at h; cases h
                | false =>
                  rw [hLt] at h; dsimp at h
                  cases hEl : setElem? elems idx (some p.1) with
                  | none => rw [hEl] at h; cases h
                  | some elems' =>
                    rw [hEl] at h; dsimp at h
                    cases hSet : setElem? p.2 arrLocal (.liveArray elems') with
                    | none => rw [hSet] at h; cases h
                    | some slots' => rw [hSet] at h; exact stepStmtNext_preserves_defId f cm slots' h
  | unsizeArrayToSlice sLoc arrLocal =>
    change (match Trusted.MirSemantics.getElem? body.locals sLoc,
        Trusted.MirSemantics.getElem? body.locals arrLocal,
        Trusted.MirSemantics.getElem? f.locals arrLocal,
        Trusted.MirSemantics.getElem? f.locals sLoc with
      | some (.sliceView sTy), some (.array aTy len), arrSl, sliceSl =>
        if !(MirTy.beq sTy aTy) then StepResult.fault FaultKind.unsupported
        else match arrSl with
          | some .arrDead => StepResult.fault FaultKind.undefined
          | some (.liveArray _) =>
            match sliceSl with
            | some .sliceDead => StepResult.fault FaultKind.undefined
            | some (.liveSlice _) =>
              match setElem? f.locals sLoc (.liveSlice (some { backing := .arrayLocal arrLocal, start := 0, len := len })) with
              | some slots' => stepStmtNext f cm slots' | none => StepResult.fault FaultKind.unsupported
            | _ => StepResult.fault FaultKind.unsupported
          | _ => StepResult.fault FaultKind.unsupported
      | _, _, _, _ => StepResult.fault FaultKind.unsupported) = .step s' at h
    cases hDS : Trusted.MirSemantics.getElem? body.locals sLoc with
    | none => rw [hDS] at h; cases h
    | some d1 =>
      cases d1 with
      | base _ => rw [hDS] at h; cases h
      | array _ _ => rw [hDS] at h; cases h
      | sliceView sTy =>
        cases hDA : Trusted.MirSemantics.getElem? body.locals arrLocal with
        | none => rw [hDS, hDA] at h; cases h
        | some d2 =>
          cases d2 with
          | base _ => rw [hDS, hDA] at h; cases h
          | sliceView _ => rw [hDS, hDA] at h; cases h
          | array aTy len =>
            rw [hDS, hDA] at h; dsimp at h
            cases hTy : !(MirTy.beq sTy aTy) with
            | true => rw [hTy] at h; cases h
            | false =>
              rw [hTy] at h; dsimp at h
              cases hA : Trusted.MirSemantics.getElem? f.locals arrLocal with
              | none => rw [hA] at h; cases h
              | some asl =>
                cases asl with
                | baseSlot _ => rw [hA] at h; cases h
                | arrDead => rw [hA] at h; cases h
                | sliceDead => rw [hA] at h; cases h
                | liveSlice _ => rw [hA] at h; cases h
                | liveArray _ =>
                  rw [hA] at h; dsimp at h
                  cases hS : Trusted.MirSemantics.getElem? f.locals sLoc with
                  | none => rw [hS] at h; cases h
                  | some ssl =>
                    cases ssl with
                    | baseSlot _ => rw [hS] at h; cases h
                    | arrDead => rw [hS] at h; cases h
                    | liveArray _ => rw [hS] at h; cases h
                    | sliceDead => rw [hS] at h; cases h
                    | liveSlice _ =>
