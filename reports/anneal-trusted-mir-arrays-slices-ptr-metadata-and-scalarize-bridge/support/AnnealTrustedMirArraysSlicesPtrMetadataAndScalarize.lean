      some slots₂' := by
    rw [Nat.add_zero]; exact hSet₂
  have hLM' := sliceLocalMatch_set_scratch pack hLM (r₀ := 0) (by decide)
    (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (backingTag sv.backing))))) hSetZero
  exact ⟨slots₂', hSet₂, hStep, hLM'⟩

