    arrSliceStmtHasStorageMarker loc (mkImmediateUbStmt scr) = false := rfl

private theorem arrSc_noStorageMarker_mkLtUsize (loc dst : LocalId) (lhs rhs : Operand) :
    arrSliceStmtHasStorageMarker loc (mkLtUsize dst lhs rhs) = false := rfl

private theorem arrSc_noStorageMarker_mkEvalOpsToArrScratch (loc scrStart : Nat) :
    ∀ ops : List Operand,
      (mkEvalOpsToArrScratch scrStart ops).any (arrSliceStmtHasStorageMarker loc) = false
  | [] => rfl
  | op :: rest => by
    change (arrSliceStmtHasStorageMarker loc (mkAssignUse scrStart op) ||
        (mkEvalOpsToArrScratch (scrStart + 1) rest).any (arrSliceStmtHasStorageMarker loc)) = false
    rw [arrSc_noStorageMarker_mkAssignUse,
      arrSc_noStorageMarker_mkEvalOpsToArrScratch loc (scrStart + 1) rest]
    rfl

private theorem arrSc_noStorageMarker_mkMoveArrScratchToElems (loc : Nat) :
    ∀ (elemStart scrStart k : Nat),
      (mkMoveArrScratchToElems elemStart scrStart k).any (arrSliceStmtHasStorageMarker loc) = false
  | _, _, 0 => rfl
  | elemStart, scrStart, k + 1 => by
    change (arrSliceStmtHasStorageMarker loc
          (mkAssignUse elemStart (.move { localId := scrStart, projection := [] })) ||
        (mkMoveArrScratchToElems (elemStart + 1) (scrStart + 1) k).any
          (arrSliceStmtHasStorageMarker loc)) = false
    rw [arrSc_noStorageMarker_mkAssignUse,
      arrSc_noStorageMarker_mkMoveArrScratchToElems loc (elemStart + 1) (scrStart + 1) k]
    rfl

private theorem arrSc_noStorageMarker_mkCopyValToElems (loc valScr : Nat) :
    ∀ (elemStart k : Nat),
      (mkCopyValToElems valScr elemStart k).any (arrSliceStmtHasStorageMarker loc) = false
  | _, 0 => rfl
  | elemStart, k + 1 => by
    change (arrSliceStmtHasStorageMarker loc
          (mkAssignUse elemStart (.copy { localId := valScr, projection := [] })) ||
        (mkCopyValToElems valScr (elemStart + 1) k).any
          (arrSliceStmtHasStorageMarker loc)) = false
    rw [arrSc_noStorageMarker_mkAssignUse,
      arrSc_noStorageMarker_mkCopyValToElems loc valScr (elemStart + 1) k]
    rfl

private theorem arrSc_any_mkStorageLiveRange (loc : Nat) :
    ∀ (start count : Nat),
      (mkStorageLiveRange start count).any (arrSliceStmtHasStorageMarker loc) =
        (Nat.ble start loc && Nat.blt loc (start + count))
  | start, 0 => by
    cases hBle : Nat.ble start loc with
    | false => rfl
    | true =>
      have hF : Nat.blt loc (start + 0) = false := by
        cases hBlt : Nat.blt loc (start + 0) with
        | false => rfl
        | true =>
          have hLe := nat_ble_le hBle
          have hLt := nat_blt_lt hBlt
          rw [Nat.add_zero] at hLt
          exact False.elim (nat_lt_irrefl loc (Nat.lt_of_lt_of_le hLt hLe))
      rw [hF]
      rfl
  | start, count + 1 => by
    change (Nat.beq start loc ||
        (mkStorageLiveRange (start + 1) count).any (arrSliceStmtHasStorageMarker loc)) =
      (Nat.ble start loc && Nat.blt loc (start + (count + 1)))
    rw [arrSc_any_mkStorageLiveRange loc (start + 1) count]
    have hAssoc : start + 1 + count = start + (count + 1) := by
      rw [Nat.add_assoc, Nat.add_comm 1 count]
    rw [hAssoc]
    cases s4a_arrSc_nat_eq_or_ne start loc with
    | inl hEq =>
      rw [hEq, nat_beq_refl]
      have hT : (Nat.ble loc loc && Nat.blt loc (loc + (count + 1))) = true := by
        rw [le_nat_ble (nat_le_refl loc),
          lt_nat_blt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count))]
        rfl
      rw [hT]
      rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      cases hBle : Nat.ble start loc with
      | false =>
        have hNot : ¬ start ≤ loc := fun h => by
          have hT := le_nat_ble h
          rw [hBle] at hT
          cases hT
        have hBle2 : Nat.ble (start + 1) loc = false := by
          cases hB : Nat.ble (start + 1) loc with
          | false => rfl
          | true => exact False.elim (hNot (Nat.le_trans (Nat.le_succ start) (nat_ble_le hB)))
        rw [hBle2]
        rfl
      | true =>
        have hLt : start < loc := Nat.lt_of_le_of_ne (nat_ble_le hBle) hEq
        rw [le_nat_ble hLt]
        rfl

private theorem arrSc_any_mkStorageDeadRange (loc : Nat) :
    ∀ (start count : Nat),
      (mkStorageDeadRange start count).any (arrSliceStmtHasStorageMarker loc) =
        (Nat.ble start loc && Nat.blt loc (start + count))
  | start, 0 => by
    cases hBle : Nat.ble start loc with
    | false => rfl
    | true =>
      have hF : Nat.blt loc (start + 0) = false := by
        cases hBlt : Nat.blt loc (start + 0) with
        | false => rfl
        | true =>
          have hLe := nat_ble_le hBle
          have hLt := nat_blt_lt hBlt
          rw [Nat.add_zero] at hLt
          exact False.elim (nat_lt_irrefl loc (Nat.lt_of_lt_of_le hLt hLe))
      rw [hF]
      rfl
  | start, count + 1 => by
    change (Nat.beq start loc ||
        (mkStorageDeadRange (start + 1) count).any (arrSliceStmtHasStorageMarker loc)) =
      (Nat.ble start loc && Nat.blt loc (start + (count + 1)))
    rw [arrSc_any_mkStorageDeadRange loc (start + 1) count]
    have hAssoc : start + 1 + count = start + (count + 1) := by
      rw [Nat.add_assoc, Nat.add_comm 1 count]
    rw [hAssoc]
    cases s4a_arrSc_nat_eq_or_ne start loc with
    | inl hEq =>
      rw [hEq, nat_beq_refl]
      have hT : (Nat.ble loc loc && Nat.blt loc (loc + (count + 1))) = true := by
        rw [le_nat_ble (nat_le_refl loc),
          lt_nat_blt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count))]
        rfl
      rw [hT]
      rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      cases hBle : Nat.ble start loc with
      | false =>
        have hNot : ¬ start ≤ loc := fun h => by
          have hT := le_nat_ble h
          rw [hBle] at hT
          cases hT
        have hBle2 : Nat.ble (start + 1) loc = false := by
          cases hB : Nat.ble (start + 1) loc with
          | false => rfl
          | true => exact False.elim (hNot (Nat.le_trans (Nat.le_succ start) (nat_ble_le hB)))
        rw [hBle2]
        rfl
      | true =>
        have hLt : start < loc := Nat.lt_of_le_of_ne (nat_ble_le hBle) hEq
        rw [le_nat_ble hLt]
        rfl

private theorem arrSc_lowerStmt_any_storageMarker (arrLocal base len loc : Nat)
    (stmt : ArrSliceStmt)
    (hBound : match stmt with
      | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => id < base
      | _ => True) :
    (lowerStmtForArray arrLocal base len stmt).any (arrSliceStmtHasStorageMarker loc) =
      if Nat.ble base loc && Nat.blt loc (base + (1 + len)) then
        arrSliceStmtHasStorageMarker arrLocal stmt
      else if Nat.beq loc arrLocal then
        false
      else
        arrSliceStmtHasStorageMarker loc stmt := by
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop =>
      dsimp [lowerStmtForArray, arrSliceStmtHasStorageMarker, stmtHasStorageMarker]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
    | unsupported =>
      dsimp [lowerStmtForArray, arrSliceStmtHasStorageMarker, stmtHasStorageMarker]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
    | assign dst rval =>
      dsimp [lowerStmtForArray, arrSliceStmtHasStorageMarker, stmtHasStorageMarker]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
    | storageLive id =>
      dsimp [lowerStmtForArray]
      have hIdLt : id < base := hBound
      cases s4a_arrSc_nat_eq_or_ne id arrLocal with
      | inl hId =>
        rw [nat_beq_true hId]
        dsimp
        rw [arrSc_any_mkStorageLiveRange loc base (1 + len)]
        have hM : arrSliceStmtHasStorageMarker arrLocal (.baseStmt (.storageLive id)) = true := by
          change Nat.beq id arrLocal = true
          exact nat_beq_true hId
        rw [hM]
        cases hIn : Nat.ble base loc && Nat.blt loc (base + (1 + len)) with
        | true => rfl
        | false =>
          dsimp
          cases hEqLoc : Nat.beq loc arrLocal with
          | true => rfl
          | false =>
            have hId2 : Nat.beq id loc = false := by
              cases hB : Nat.beq id loc with
              | false => rfl
              | true =>
                have hEq1 := nat_beq_eq _ _ hB
                rw [hId] at hEq1
                rw [nat_beq_true hEq1.symm] at hEqLoc
                cases hEqLoc
            exact hId2.symm
      | inr hId =>
        rw [nat_beq_false hId]
        dsimp
        have hM1 : arrSliceStmtHasStorageMarker arrLocal (.baseStmt (.storageLive id)) = false := by
          change Nat.beq id arrLocal = false
          exact nat_beq_false hId
        rw [hM1]
        change (Nat.beq id loc || false) = _
        have hOr : (Nat.beq id loc || false) = Nat.beq id loc := by
          cases Nat.beq id loc <;> rfl
        rw [hOr]
        cases hIn : Nat.ble base loc && Nat.blt loc (base + (1 + len)) with
        | true =>
          have hAnd := (bool_and_eq_true _ _).mp hIn
          have hGe : base ≤ loc := nat_ble_le hAnd.1
          have hNe : id ≠ loc := fun hEq =>
            nat_lt_irrefl loc (Nat.lt_of_lt_of_le (by rw [← hEq]; exact hIdLt) hGe)
          exact nat_beq_false hNe
        | false =>
          dsimp
          cases hEqLoc : Nat.beq loc arrLocal with
          | true =>
            have hLocEq := nat_beq_eq _ _ hEqLoc
            have hNe : id ≠ loc := fun hEq => hId (hEq.trans hLocEq)
            exact nat_beq_false hNe
          | false => rfl
    | storageDead id =>
      dsimp [lowerStmtForArray]
      have hIdLt : id < base := hBound
      cases s4a_arrSc_nat_eq_or_ne id arrLocal with
      | inl hId =>
        rw [nat_beq_true hId]
        dsimp
        rw [arrSc_any_mkStorageDeadRange loc base (1 + len)]
        have hM : arrSliceStmtHasStorageMarker arrLocal (.baseStmt (.storageDead id)) = true := by
          change Nat.beq id arrLocal = true
          exact nat_beq_true hId
        rw [hM]
        cases hIn : Nat.ble base loc && Nat.blt loc (base + (1 + len)) with
        | true => rfl
        | false =>
          dsimp
          cases hEqLoc : Nat.beq loc arrLocal with
          | true => rfl
          | false =>
            have hId2 : Nat.beq id loc = false := by
              cases hB : Nat.beq id loc with
              | false => rfl
              | true =>
                have hEq1 := nat_beq_eq _ _ hB
                rw [hId] at hEq1
                rw [nat_beq_true hEq1.symm] at hEqLoc
                cases hEqLoc
            exact hId2.symm
      | inr hId =>
        rw [nat_beq_false hId]
        dsimp
        have hM1 : arrSliceStmtHasStorageMarker arrLocal (.baseStmt (.storageDead id)) = false := by
          change Nat.beq id arrLocal = false
          exact nat_beq_false hId
        rw [hM1]
        change (Nat.beq id loc || false) = _
        have hOr : (Nat.beq id loc || false) = Nat.beq id loc := by
          cases Nat.beq id loc <;> rfl
        rw [hOr]
        cases hIn : Nat.ble base loc && Nat.blt loc (base + (1 + len)) with
        | true =>
          have hAnd := (bool_and_eq_true _ _).mp hIn
          have hGe : base ≤ loc := nat_ble_le hAnd.1
          have hNe : id ≠ loc := fun hEq =>
            nat_lt_irrefl loc (Nat.lt_of_lt_of_le (by rw [← hEq]; exact hIdLt) hGe)
          exact nat_beq_false hNe
        | false =>
          dsimp
          cases hEqLoc : Nat.beq loc arrLocal with
          | true =>
            have hLocEq := nat_beq_eq _ _ hEqLoc
            have hNe : id ≠ loc := fun hEq => hId (hEq.trans hLocEq)
            exact nat_beq_false hNe
          | false => rfl
  | aggregateArray a ops =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      dsimp
      rw [list_any_append, list_any_append,
        arrSc_noStorageMarker_mkEvalOpsToArrScratch,
        arrSc_noStorageMarker_mkMoveArrScratchToElems]
      change (false || ((false || false) || false)) = _
      have hL : (false || ((false || false) || false)) = false := rfl
      rw [hL]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
  | repeatArray a op =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      dsimp
      rw [arrSc_noStorageMarker_mkCopyValToElems]
      have hL : (arrSliceStmtHasStorageMarker loc (mkAssignUse (base + 1 + len + 3) op) ||
          (arrSliceStmtHasStorageMarker loc (mkLivenessCheckStmt base) || false)) = false := rfl
      rw [hL]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
  | arrayLivenessCheck a =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
  | readArrayConst dst a idx isMove =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      dsimp
      cases Nat.blt idx len <;>
        (dsimp
         cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
           cases Nat.beq loc arrLocal <;> rfl)
    | inr hEq =>
      rw [nat_beq_false hEq]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
  | writeArrayConst a idx rval =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      dsimp
      cases Nat.blt idx len <;>
        (dsimp
         cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
           cases Nat.beq loc arrLocal <;> rfl)
    | inr hEq =>
      rw [nat_beq_false hEq]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
        cases Nat.beq loc arrLocal <;> rfl
  | unsizeArrayToSlice _ _ | sliceFromRawParts _ _ | subslice _ _ _ _ _ | ptrMetadata _ _ =>
    cases Nat.ble base loc && Nat.blt loc (base + (1 + len)) <;>
      cases Nat.beq loc arrLocal <;> rfl

private theorem arrSc_buildReadArrayArms_noStorageMarker (loc dst elemBase nextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildReadArrayArms dst elemBase nextBb idx armBb rem).2.all
        (fun b => b.statements.all (fun s => !arrSliceStmtHasStorageMarker loc s)) = true
  | 0, _, _ => rfl
  | rem + 1, idx, armBb => by
    change (true &&
      (buildReadArrayArms dst elemBase nextBb (idx + 1) (armBb + 1) rem).2.all
        (fun b => b.statements.all (fun s => !arrSliceStmtHasStorageMarker loc s))) = true
    have ih := arrSc_buildReadArrayArms_noStorageMarker loc dst elemBase nextBb rem (idx + 1) (armBb + 1)
    rw [ih]
    rfl

private theorem arrSc_buildWriteArrayArms_noStorageMarker (loc valScr elemBase nextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildWriteArrayArms valScr elemBase nextBb idx armBb rem).2.all
        (fun b => b.statements.all (fun s => !arrSliceStmtHasStorageMarker loc s)) = true
  | 0, _, _ => rfl
  | rem + 1, idx, armBb => by
    change (true &&
      (buildWriteArrayArms valScr elemBase nextBb (idx + 1) (armBb + 1) rem).2.all
        (fun b => b.statements.all (fun s => !arrSliceStmtHasStorageMarker loc s))) = true
    have ih :=
      arrSc_buildWriteArrayArms_noStorageMarker loc valScr elemBase nextBb rem (idx + 1) (armBb + 1)
    rw [ih]
    rfl

private theorem arrSc_lowerTermForArray_noStorageMarker
    (arrLocal base len nextExtra loc : Nat) (term : ArrSliceTerm) :
    (lowerTermForArray arrLocal base len nextExtra term).1.any
        (arrSliceStmtHasStorageMarker loc) = false ∧
    (lowerTermForArray arrLocal base len nextExtra term).2.2.any
        (fun b => b.statements.any (arrSliceStmtHasStorageMarker loc)) = false := by
  cases term with
  | baseTerm _ | sliceLenCall _ _ _ | boundsCheckSlice _ _ _ _
  | readSliceElem _ _ _ _ | readSliceConst _ _ _ _ _ _ =>
    exact ⟨rfl, rfl⟩
  | boundsCheckArray a _ _ _ =>
    dsimp [lowerTermForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      exact ⟨rfl, rfl⟩
    | inr hEq =>
      rw [nat_beq_false hEq]
      exact ⟨rfl, rfl⟩
  | readArrayElem dst a _ nextBb =>
    dsimp [lowerTermForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      dsimp
      constructor
      · rfl
      · rw [list_any_append]
        have hTrap : ([({ statements := [], terminator := ArrSliceTerm.baseTerm .unreachable, cleanup := false } : ArrSliceBlock)]).any
            (fun b => b.statements.any (arrSliceStmtHasStorageMarker loc)) = false := rfl
        have hArms : (buildReadArrayArms dst (base + 1) nextBb 0 nextExtra len).2.any
            (fun b => b.statements.any (arrSliceStmtHasStorageMarker loc)) = false := by
          rw [arrSc_list_any_eq_false_iff_mem]
          intro b hb
          have hAll := arrSc_buildReadArrayArms_noStorageMarker loc dst (base + 1) nextBb len 0 nextExtra
          have hB := (arrSc_list_all_iff_mem _ _).mp hAll b hb
          rw [arrSc_list_any_eq_false_iff_mem]
          intro s hs
          have hS := (arrSc_list_all_iff_mem _ _).mp hB s hs
          exact (bool_not_eq_true _).mp hS
        rw [hArms, hTrap]
        rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      exact ⟨rfl, rfl⟩
  | writeArrayElem a _ _ nextBb =>
    dsimp [lowerTermForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      dsimp
      constructor
      · rfl
      · rw [list_any_append]
        have hTrap : ([({ statements := [], terminator := ArrSliceTerm.baseTerm .unreachable, cleanup := false } : ArrSliceBlock)]).any
            (fun b => b.statements.any (arrSliceStmtHasStorageMarker loc)) = false := rfl
        have hArms : (buildWriteArrayArms (base + 1 + len + 3) (base + 1) nextBb 0 nextExtra len).2.any
            (fun b => b.statements.any (arrSliceStmtHasStorageMarker loc)) = false := by
          rw [arrSc_list_any_eq_false_iff_mem]
          intro b hb
          have hAll := arrSc_buildWriteArrayArms_noStorageMarker loc (base + 1 + len + 3) (base + 1) nextBb len 0 nextExtra
          have hB := (arrSc_list_all_iff_mem _ _).mp hAll b hb
          rw [arrSc_list_any_eq_false_iff_mem]
          intro s hs
          have hS := (arrSc_list_all_iff_mem _ _).mp hB s hs
          exact (bool_not_eq_true _).mp hS
        rw [hArms, hTrap]
        rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      exact ⟨rfl, rfl⟩

private theorem arrSc_lowerBlocksForArrayLoop_extras_noStorageMarker
    (arrLocal base len loc : Nat) :
    ∀ (nextExtra : Nat) (bbs : List ArrSliceBlock),
      (lowerBlocksForArrayLoop arrLocal base len nextExtra bbs).2.any
        (fun b => b.statements.any (arrSliceStmtHasStorageMarker loc)) = false
  | _, [] => rfl
  | nextExtra, bb :: rest => by
    dsimp [lowerBlocksForArrayLoop]
    rw [list_any_append,
      (arrSc_lowerTermForArray_noStorageMarker arrLocal base len nextExtra loc bb.terminator).2,
      arrSc_lowerBlocksForArrayLoop_extras_noStorageMarker arrLocal base len loc _ rest]
    rfl

private theorem arrSc_lowerStmt_storageBounds (arrLocal base len locBound : Nat)
    (hRange : base + (1 + len) ≤ locBound)
    (stmt : ArrSliceStmt)
    (hBound : match stmt with
      | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => id < base
      | _ => True) :
    (lowerStmtForArray arrLocal base len stmt).all (fun s =>
      match s with
      | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
      | _ => true) = true := by
  have hRangeAux : ∀ (start count : Nat), start + count ≤ locBound →
      (mkStorageLiveRange start count).all (fun s =>
        match s with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
        | _ => true) = true := by
    intro start count hSc
    induction count generalizing start with
    | zero => rfl
    | succ k ih =>
      have hLt : start < locBound :=
        Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ k)) hSc
      have hNext : (start + 1) + k ≤ locBound := by
        rw [Nat.add_assoc, Nat.add_comm 1 k, ← Nat.add_assoc]
        exact hSc
      change (Nat.blt start locBound && _) = true
      rw [lt_nat_blt hLt, ih (start + 1) hNext]
      rfl
  have hRangeDead : ∀ (start count : Nat), start + count ≤ locBound →
      (mkStorageDeadRange start count).all (fun s =>
        match s with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
        | _ => true) = true := by
    intro start count hSc
    induction count generalizing start with
    | zero => rfl
    | succ k ih =>
      have hLt : start < locBound :=
        Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ k)) hSc
      have hNext : (start + 1) + k ≤ locBound := by
        rw [Nat.add_assoc, Nat.add_comm 1 k, ← Nat.add_assoc]
        exact hSc
      change (Nat.blt start locBound && _) = true
      rw [lt_nat_blt hLt, ih (start + 1) hNext]
      rfl
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop => rfl
    | unsupported => rfl
    | assign _ _ => rfl
    | storageLive id =>
      dsimp [lowerStmtForArray]
      cases s4a_arrSc_nat_eq_or_ne id arrLocal with
      | inl hEq =>
        rw [nat_beq_true hEq]
        exact hRangeAux base (1 + len) hRange
      | inr hEq =>
        rw [nat_beq_false hEq]
        have hLt : id < locBound :=
          Nat.lt_of_lt_of_le hBound (Nat.le_trans (Nat.le_add_right base (1 + len)) hRange)
        change (Nat.blt id locBound && true) = true
        rw [lt_nat_blt hLt]
        rfl
    | storageDead id =>
      dsimp [lowerStmtForArray]
      cases s4a_arrSc_nat_eq_or_ne id arrLocal with
      | inl hEq =>
        rw [nat_beq_true hEq]
        exact hRangeDead base (1 + len) hRange
      | inr hEq =>
        rw [nat_beq_false hEq]
        have hLt : id < locBound :=
          Nat.lt_of_lt_of_le hBound (Nat.le_trans (Nat.le_add_right base (1 + len)) hRange)
        change (Nat.blt id locBound && true) = true
        rw [lt_nat_blt hLt]
        rfl
  | aggregateArray a _ =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      dsimp
      have hE1 : ∀ (scrStart : Nat) (ops : List Operand),
          (mkEvalOpsToArrScratch scrStart ops).all (fun s =>
            match s with
            | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
            | _ => true) = true := by
        intro scrStart ops
        induction ops generalizing scrStart with
        | nil => rfl
        | cons _ _ ih => exact ih _
      have hE2 : ∀ (es ss k : Nat),
          (mkMoveArrScratchToElems es ss k).all (fun s =>
            match s with
            | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
            | _ => true) = true := by
        intro es ss k
        induction k generalizing es ss with
        | zero => rfl
        | succ _ ih => exact ih _ _
      rw [list_all_append, list_all_append, hE1, hE2]
      rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      rfl
  | repeatArray a _ =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      dsimp
      have hE : ∀ (vs es k : Nat),
          (mkCopyValToElems vs es k).all (fun s =>
            match s with
            | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
            | _ => true) = true := by
        intro vs es k
        induction k generalizing es with
        | zero => rfl
        | succ _ ih => exact ih _
      rw [hE]
      rfl
    | inr hEq =>
      rw [nat_beq_false hEq]
      rfl
  | arrayLivenessCheck a =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq => rw [nat_beq_true hEq]; rfl
    | inr hEq => rw [nat_beq_false hEq]; rfl
  | readArrayConst _ a idx _ =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      cases Nat.blt idx len <;> rfl
    | inr hEq => rw [nat_beq_false hEq]; rfl
  | writeArrayConst a idx _ =>
    dsimp [lowerStmtForArray]
    cases s4a_arrSc_nat_eq_or_ne a arrLocal with
    | inl hEq =>
      rw [nat_beq_true hEq]
      cases Nat.blt idx len <;> rfl
    | inr hEq => rw [nat_beq_false hEq]; rfl
  | unsizeArrayToSlice _ _ | sliceFromRawParts _ _ | subslice _ _ _ _ _ | ptrMetadata _ _ =>
    rfl

private theorem arrSc_arrSliceStorageAnnotationsInBounds_bodyTgt {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    arrSliceStorageAnnotationsInBounds pack.bodyTgt = true := by
  unfold arrSliceStorageAnnotationsInBounds
  have hBbs := congrArg ArrSliceBody.basicBlocks pack.hBodyTgt
  rw [arrSc_bodyTgt_locals_length pack, hBbs]
  dsimp
  let base := pack.bodySrc.locals.length
  let locBound := base + 1 + pack.len + (4 + pack.len)
  have hRange : base + (1 + pack.len) ≤ locBound := by
    change base + (1 + pack.len) ≤ base + 1 + pack.len + (4 + pack.len)
    rw [Nat.add_assoc base 1 pack.len]
    exact Nat.le_add_right _ _
  rw [list_all_append]
  have hExtra : (lowerBlocksForArrayLoop plan.arrLocal base pack.len
      pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).2.all (fun bb =>
        bb.statements.all (fun stmt =>
          match stmt with
          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
          | _ => true)) = true := by
    rw [arrSc_list_all_iff_mem]
    intro bb hMem
    rw [arrSc_list_all_iff_mem]
    intro stmt hStmt
    cases stmt with
    | baseStmt bs =>
      cases bs with
      | storageLive id =>
        have hNo := arrSc_lowerBlocksForArrayLoop_extras_noStorageMarker
          plan.arrLocal base pack.len id pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks
        have hF := (arrSc_list_any_eq_false_iff_mem _ _).mp hNo bb hMem
        have hF2 := (arrSc_list_any_eq_false_iff_mem _ _).mp hF (.baseStmt (.storageLive id)) hStmt
        have hId : Nat.beq id id = false := hF2
        rw [nat_beq_refl] at hId
        cases hId
      | storageDead id =>
        have hNo := arrSc_lowerBlocksForArrayLoop_extras_noStorageMarker
          plan.arrLocal base pack.len id pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks
        have hF := (arrSc_list_any_eq_false_iff_mem _ _).mp hNo bb hMem
        have hF2 := (arrSc_list_any_eq_false_iff_mem _ _).mp hF (.baseStmt (.storageDead id)) hStmt
        have hId : Nat.beq id id = false := hF2
        rw [nat_beq_refl] at hId
        cases hId
      | nop | unsupported | assign _ _ => rfl
    | _ => rfl
  have hMain : ∀ (nextExtra : Nat) (bbs : List ArrSliceBlock),
      bbs.all (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id base
        | _ => true)) = true →
      (lowerBlocksForArrayLoop plan.arrLocal base pack.len nextExtra bbs).1.all (fun bb =>
        bb.statements.all (fun stmt =>
          match stmt with
          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
          | _ => true)) = true := by
    intro nextExtra bbs hBbs
    induction bbs generalizing nextExtra with
    | nil => rfl
    | cons b tl ih =>
      have hHeadAnd := (bool_and_eq_true _ _).mp hBbs
      dsimp [lowerBlocksForArrayLoop]
      rw [bool_and_eq_true]
      constructor
      · rw [list_all_append, bool_and_eq_true]
        constructor
        · rw [arrSc_list_all_iff_mem]
          intro s hs
          have hFlat : ∀ (stmts : List ArrSliceStmt),
              stmts.all (fun stmt =>
                match stmt with
                | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id base
                | _ => true) = true →
              (listFlatMap (lowerStmtForArray plan.arrLocal base pack.len) stmts).all
                (fun stmt =>
                  match stmt with
                  | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
                  | _ => true) = true := by
            intro stmts hStmts
            induction stmts with
            | nil => rfl
            | cons st stTl ihSt =>
              have hStAnd := (bool_and_eq_true _ _).mp hStmts
              rw [arrSc_listFlatMap_cons, list_all_append, bool_and_eq_true]
              refine ⟨arrSc_lowerStmt_storageBounds plan.arrLocal base pack.len locBound hRange st ?_,
                ihSt hStAnd.2⟩
              cases st with
              | baseStmt bs =>
                cases bs with
                | storageLive id => exact nat_blt_lt hStAnd.1
                | storageDead id => exact nat_blt_lt hStAnd.1
                | nop | unsupported | assign _ _ => exact True.intro
              | _ => exact True.intro
          exact (arrSc_list_all_iff_mem _ _).mp (hFlat b.statements hHeadAnd.1) s hs
        · have hPre : (lowerTermForArray plan.arrLocal base pack.len nextExtra b.terminator).1.all
              (fun stmt =>
                match stmt with
                | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
                | _ => true) = true := by
            rw [arrSc_list_all_iff_mem]
            intro s hs
            cases s with
            | baseStmt bs =>
              cases bs with
              | storageLive id =>
                have hNo := (arrSc_lowerTermForArray_noStorageMarker plan.arrLocal base pack.len nextExtra id b.terminator).1
                have hF := (arrSc_list_any_eq_false_iff_mem _ _).mp hNo (.baseStmt (.storageLive id)) hs
                have hId : Nat.beq id id = false := hF
                rw [nat_beq_refl] at hId
                cases hId
              | storageDead id =>
                have hNo := (arrSc_lowerTermForArray_noStorageMarker plan.arrLocal base pack.len nextExtra id b.terminator).1
                have hF := (arrSc_list_any_eq_false_iff_mem _ _).mp hNo (.baseStmt (.storageDead id)) hs
                have hId : Nat.beq id id = false := hF
                rw [nat_beq_refl] at hId
                cases hId
              | nop => rfl
              | unsupported => rfl
              | assign _ _ => rfl
            | _ => rfl
          exact hPre
      · exact ih _ hHeadAnd.2
  have hSrcSt : pack.bodySrc.basicBlocks.all (fun bb => bb.statements.all (fun stmt =>
      match stmt with
      | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id pack.bodySrc.locals.length
      | _ => true)) = true := pack.hStorage
  have hMainRes := hMain pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks hSrcSt
  have hAnd : ((lowerBlocksForArrayLoop plan.arrLocal base pack.len
      pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).1.all
      (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
        | _ => true)) &&
    (lowerBlocksForArrayLoop plan.arrLocal base pack.len
      pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks).2.all
      (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id locBound
        | _ => true))) = true := by
    rw [hMainRes, hExtra]
    rfl
  exact hAnd

private theorem arrSc_arrSliceHasStorageAnnotation_bodyTgt_iff {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) (loc : Nat) :
    arrSliceHasStorageAnnotation pack.bodyTgt loc =
      if Nat.ble pack.bodySrc.locals.length loc &&
          Nat.blt loc (pack.bodySrc.locals.length + (1 + pack.len)) then
        arrSliceHasStorageAnnotation pack.bodySrc plan.arrLocal
      else if Nat.beq loc plan.arrLocal then
        false
      else
        arrSliceHasStorageAnnotation pack.bodySrc loc := by
  unfold arrSliceHasStorageAnnotation
  have hBbs := congrArg ArrSliceBody.basicBlocks pack.hBodyTgt
  rw [hBbs]
  dsimp
  let base := pack.bodySrc.locals.length
  rw [list_any_append,
    arrSc_lowerBlocksForArrayLoop_extras_noStorageMarker plan.arrLocal base pack.len loc
      pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks]
  have hTailF : ∀ b : Bool, (b || false) = b := fun b => by cases b <;> rfl
  rw [hTailF]
  have hLoop : ∀ (nextExtra : Nat) (bbs : List ArrSliceBlock),
      bbs.all (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id base
        | _ => true)) = true →
      (lowerBlocksForArrayLoop plan.arrLocal base pack.len nextExtra bbs).1.any
          (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker loc)) =
        if Nat.ble base loc && Nat.blt loc (base + (1 + pack.len)) then
          bbs.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker plan.arrLocal))
        else if Nat.beq loc plan.arrLocal then
          false
        else
          bbs.any (fun bb => bb.statements.any (arrSliceStmtHasStorageMarker loc)) := by
    intro nextExtra bbs hBbs
    induction bbs generalizing nextExtra with
    | nil =>
      dsimp [lowerBlocksForArrayLoop]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + pack.len)) <;>
        cases Nat.beq loc plan.arrLocal <;> rfl
    | cons b tl ih =>
      have hBbsAnd := (bool_and_eq_true _ _).mp hBbs
      dsimp only [lowerBlocksForArrayLoop]
      rw [arrSc_list_any_cons, list_any_append,
        (arrSc_lowerTermForArray_noStorageMarker plan.arrLocal base pack.len nextExtra loc b.terminator).1,
        hTailF]
      have hStmts : ∀ (stmts : List ArrSliceStmt),
          stmts.all (fun stmt =>
            match stmt with
            | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id base
            | _ => true) = true →
          (listFlatMap (lowerStmtForArray plan.arrLocal base pack.len) stmts).any
              (arrSliceStmtHasStorageMarker loc) =
            if Nat.ble base loc && Nat.blt loc (base + (1 + pack.len)) then
              stmts.any (arrSliceStmtHasStorageMarker plan.arrLocal)
            else if Nat.beq loc plan.arrLocal then
              false
            else
              stmts.any (arrSliceStmtHasStorageMarker loc) := by
        intro stmts hS
        induction stmts with
        | nil =>
          cases Nat.ble base loc && Nat.blt loc (base + (1 + pack.len)) <;>
            cases Nat.beq loc plan.arrLocal <;> rfl
        | cons st sTl ihSt =>
          have hSAnd := (bool_and_eq_true _ _).mp hS
          rw [arrSc_listFlatMap_cons, list_any_append, arrSc_lowerStmt_any_storageMarker,
            ihSt hSAnd.2]
          · cases Nat.ble base loc && Nat.blt loc (base + (1 + pack.len)) with
            | true => rfl
            | false =>
              cases Nat.beq loc plan.arrLocal <;> rfl
          · cases st with
            | baseStmt bs =>
              cases bs with
              | storageLive id => exact nat_blt_lt hSAnd.1
              | storageDead id => exact nat_blt_lt hSAnd.1
              | nop | unsupported | assign _ _ => exact True.intro
            | _ => exact True.intro
      rw [hStmts b.statements hBbsAnd.1, ih _ hBbsAnd.2]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + pack.len)) with
      | true => rfl
      | false =>
        cases Nat.beq loc plan.arrLocal <;> rfl
  exact hLoop pack.bodySrc.basicBlocks.length pack.bodySrc.basicBlocks pack.hStorage

private theorem arrSc_arrSliceHasStorageAnnotation_bodyTgt_prefix {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {i : Nat} (hLt : i < pack.bodySrc.locals.length) (hNe : i ≠ plan.arrLocal) :
    arrSliceHasStorageAnnotation pack.bodyTgt i =
      arrSliceHasStorageAnnotation pack.bodySrc i := by
  rw [arrSc_arrSliceHasStorageAnnotation_bodyTgt_iff pack i]
  have hOut : (Nat.ble pack.bodySrc.locals.length i &&
      Nat.blt i (pack.bodySrc.locals.length + (1 + pack.len))) = false := by
    cases hBle : Nat.ble pack.bodySrc.locals.length i with
    | false => rfl
    | true => exact False.elim (nat_lt_irrefl i (Nat.lt_of_lt_of_le hLt (nat_ble_le hBle)))
  rw [hOut, nat_beq_false hNe]
  rfl

private theorem arrSc_arrSliceHasStorageAnnotation_bodyTgt_arrLocal {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    arrSliceHasStorageAnnotation pack.bodyTgt plan.arrLocal = false := by
  rw [arrSc_arrSliceHasStorageAnnotation_bodyTgt_iff pack plan.arrLocal]
  have hOut : (Nat.ble pack.bodySrc.locals.length plan.arrLocal &&
      Nat.blt plan.arrLocal (pack.bodySrc.locals.length + (1 + pack.len))) = false := by
    cases hBle : Nat.ble pack.bodySrc.locals.length plan.arrLocal with
    | false => rfl
    | true => exact False.elim (nat_lt_irrefl plan.arrLocal (Nat.lt_of_lt_of_le pack.hLocLt (nat_ble_le hBle)))
  rw [hOut, nat_beq_refl]
  rfl

private theorem arrSc_arrSliceHasStorageAnnotation_bodyTgt_liveLoc {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    arrSliceHasStorageAnnotation pack.bodyTgt pack.bodySrc.locals.length =
      arrSliceHasStorageAnnotation pack.bodySrc plan.arrLocal := by
  rw [arrSc_arrSliceHasStorageAnnotation_bodyTgt_iff pack pack.bodySrc.locals.length]
  have hPos : 0 < 1 + pack.len := by
    rw [Nat.add_comm 1 pack.len]
    exact Nat.zero_lt_succ pack.len
  have hIn : (Nat.ble pack.bodySrc.locals.length pack.bodySrc.locals.length &&
      Nat.blt pack.bodySrc.locals.length (pack.bodySrc.locals.length + (1 + pack.len))) = true := by
    rw [le_nat_ble (nat_le_refl _), lt_nat_blt (Nat.lt_add_of_pos_right hPos)]
    rfl
  rw [hIn]
  rfl

private theorem arrSc_arrSliceHasStorageAnnotation_bodyTgt_elem {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {j : Nat} (hj : j < pack.len) :
    arrSliceHasStorageAnnotation pack.bodyTgt (pack.bodySrc.locals.length + 1 + j) =
      arrSliceHasStorageAnnotation pack.bodySrc plan.arrLocal := by
  rw [arrSc_arrSliceHasStorageAnnotation_bodyTgt_iff pack (pack.bodySrc.locals.length + 1 + j)]
  have hGe : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 1 + j := by
    rw [Nat.add_assoc]
    exact Nat.le_add_right _ _
  have hLt : pack.bodySrc.locals.length + 1 + j < pack.bodySrc.locals.length + (1 + pack.len) := by
    rw [Nat.add_assoc]
    exact Nat.add_lt_add_left (Nat.add_lt_add_left hj 1) _
  have hIn : (Nat.ble pack.bodySrc.locals.length (pack.bodySrc.locals.length + 1 + j) &&
      Nat.blt (pack.bodySrc.locals.length + 1 + j) (pack.bodySrc.locals.length + (1 + pack.len))) = true := by
    rw [le_nat_ble hGe, lt_nat_blt hLt]
    rfl
  rw [hIn]
  rfl

private theorem arrSc_arrSliceHasStorageAnnotation_bodyTgt_scr {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (r : Nat) :
    arrSliceHasStorageAnnotation pack.bodyTgt
      (pack.bodySrc.locals.length + 1 + pack.len + r) = false := by
  rw [arrSc_arrSliceHasStorageAnnotation_bodyTgt_iff]
  have hGe : pack.bodySrc.locals.length + (1 + pack.len) ≤
      pack.bodySrc.locals.length + 1 + pack.len + r := by
    rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
    exact Nat.le_add_right _ _
  have hOut1 : Nat.blt (pack.bodySrc.locals.length + 1 + pack.len + r)
      (pack.bodySrc.locals.length + (1 + pack.len)) = false := by
    cases hB : Nat.blt (pack.bodySrc.locals.length + 1 + pack.len + r)
        (pack.bodySrc.locals.length + (1 + pack.len)) with
    | false => rfl
    | true => exact False.elim (nat_lt_irrefl _ (Nat.lt_of_lt_of_le (nat_blt_lt hB) hGe))
  have hAndF : (Nat.ble pack.bodySrc.locals.length (pack.bodySrc.locals.length + 1 + pack.len + r) &&
      Nat.blt (pack.bodySrc.locals.length + 1 + pack.len + r)
        (pack.bodySrc.locals.length + (1 + pack.len))) = false := by
    rw [hOut1]
    cases Nat.ble pack.bodySrc.locals.length (pack.bodySrc.locals.length + 1 + pack.len + r) <;> rfl
  have hNe : pack.bodySrc.locals.length + 1 + pack.len + r ≠ plan.arrLocal := fun hEq => by
    have hLt : plan.arrLocal < pack.bodySrc.locals.length + 1 + pack.len + r :=
      Nat.lt_of_lt_of_le pack.hLocLt
        (Nat.le_trans (Nat.le_add_right _ (1 + pack.len)) hGe)
    rw [hEq] at hLt
    exact nat_lt_irrefl _ hLt
  have hGtBase : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 1 + pack.len + r :=
    Nat.le_trans (Nat.le_add_right _ (1 + pack.len)) hGe
  have hSrcFalse : arrSliceHasStorageAnnotation pack.bodySrc
      (pack.bodySrc.locals.length + 1 + pack.len + r) = false := by
    unfold arrSliceHasStorageAnnotation
    rw [arrSc_list_any_eq_false_iff_mem]
    intro bb hBb
    rw [arrSc_list_any_eq_false_iff_mem]
    intro st hSt
    have hStorage : pack.bodySrc.basicBlocks.all (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) =>
          Nat.blt id pack.bodySrc.locals.length
        | _ => true)) = true := pack.hStorage
    have hAll := (arrSc_list_all_iff_mem _ _).mp hStorage bb hBb
    have hS := (arrSc_list_all_iff_mem _ _).mp hAll st hSt
    cases hStKind : st with
    | baseStmt bs =>
      cases hBs : bs with
      | storageLive id =>
        rw [hStKind, hBs] at hS
        have hIdLt : id < pack.bodySrc.locals.length := nat_blt_lt hS
        exact nat_beq_false (fun hEq =>
          nat_lt_irrefl id (Nat.lt_of_lt_of_le hIdLt (by rw [hEq]; exact hGtBase)))
      | storageDead id =>
        rw [hStKind, hBs] at hS
        have hIdLt : id < pack.bodySrc.locals.length := nat_blt_lt hS
        exact nat_beq_false (fun hEq =>
          nat_lt_irrefl id (Nat.lt_of_lt_of_le hIdLt (by rw [hEq]; exact hGtBase)))
      | nop => rfl
      | unsupported => rfl
      | assign _ _ => rfl
    | aggregateArray _ _ => rfl
    | repeatArray _ _ => rfl
    | arrayLivenessCheck _ => rfl
    | readArrayConst _ _ _ _ => rfl
    | writeArrayConst _ _ _ => rfl
    | unsizeArrayToSlice _ _ => rfl
    | sliceFromRawParts _ _ => rfl
    | subslice _ _ _ _ _ => rfl
    | ptrMetadata _ _ => rfl
  rw [hAndF, nat_beq_false hNe]
  exact hSrcFalse

-- ============================================================================
-- Section 4: Simulation Relation, Operand/Rvalue Preservation, & Init State
-- ============================================================================

private noncomputable def arrSc_PrefixMatch {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (slots₁ slots₂ : List ArrSliceSlot) : Prop :=
  slots₁.length = pack.bodySrc.locals.length ∧
  ∀ i : Nat, i < pack.bodySrc.locals.length → i ≠ plan.arrLocal →
    Trusted.MirSemantics.getElem? slots₂ i = Trusted.MirSemantics.getElem? slots₁ i

private noncomputable def arrSc_CompRel (base len : Nat) (slots₂ : List ArrSliceSlot) :
    ArrSliceSlot → Prop
  | .arrDead =>
    Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot .dead) ∧
    ∀ j : Nat, j < len →
      Trusted.MirSemantics.getElem? slots₂ (base + 1 + j) = some (.baseSlot .dead)
  | .liveArray elems =>
    elems.length = len ∧
    Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot (.live (some .unit))) ∧
    ∀ j : Nat, j < len →
      ∃ optV : Option Val,
        Trusted.MirSemantics.getElem? elems j = some optV ∧
        Trusted.MirSemantics.getElem? slots₂ (base + 1 + j) = some (.baseSlot (.live optV))
  | _ => False

private noncomputable def arrSc_LocalMatch {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (slots₁ slots₂ : List ArrSliceSlot) : Prop :=
  arrSc_PrefixMatch pack slots₁ slots₂ ∧
  slots₂.length = pack.bodyTgt.locals.length ∧
  (∃ arrSl : ArrSliceSlot,
    Trusted.MirSemantics.getElem? slots₁ plan.arrLocal = some arrSl ∧
    arrSc_CompRel pack.bodySrc.locals.length pack.len slots₂ arrSl) ∧
  (∀ r : Nat, r < 4 + pack.len →
    ∃ optV : Option Val,
      Trusted.MirSemantics.getElem? slots₂
        (pack.bodySrc.locals.length + 1 + pack.len + r) =
          some (.baseSlot (.live optV)))

private noncomputable def arrSc_FrameRel {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (f₁ f₂ : ArrSliceFrame) : Prop :=
  (f₁.defId = plan.defId ∧
    f₂.defId = plan.defId ∧
    f₂.blockIdx = f₁.blockIdx ∧
    arrSc_LocalMatch pack f₁.locals f₂.locals ∧
    match Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx with
    | none => True
    | some bb =>
      f₁.stmtIdx ≤ bb.statements.length ∧
      f₂.stmtIdx = (listFlatMap
        (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bb.statements.take f₁.stmtIdx)).length) ∨
  (f₁.defId ≠ plan.defId ∧ f₂ = f₁)

private noncomputable def arrSc_StateRel {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    (s₁ s₂ : ArrSliceState) : Prop :=
  s₂.callerMem = s₁.callerMem ∧
  match s₁.frames, s₂.frames with
  | [f₁], [f₂] => arrSc_FrameRel pack f₁ f₂
  | _, _ => False

private theorem arrSc_liveUninitSlot_eq (ty : MirTy) :
    liveUninitSlot ty = .live (initElemOptVal ty) := by
  cases ty with
  | unit => rfl
  | enum ety =>
    change (if isZstEnumTy ety = true then LocalSlot.live (some (Val.enumVal ety 0)) else .live none) =
      .live (if isZstEnumTy ety = true then some (Val.enumVal ety 0) else none)
    cases isZstEnumTy ety <;> rfl
  | bool | int _ _ | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported => rfl

private theorem arrSc_liveUninitArrSliceSlot_base_eq (ty : MirTy) :
    liveUninitArrSliceSlot (.base ty) = .baseSlot (.live (initElemOptVal ty)) :=
  congrArg ArrSliceSlot.baseSlot (arrSc_liveUninitSlot_eq ty)

private theorem arrSc_evalArrSliceBaseOperandToSlot_prefix {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPref : arrSc_PrefixMatch pack slots₁ slots₂)
    (op : Operand) (hOp : operandUsesOnlyBase pack.bodySrc.locals op = true) :
    (evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op = .error FaultKind.unsupported ∧
      evalArrSliceBaseOperandToSlot pack.bodyTgt.locals slots₂ op = .error FaultKind.unsupported) ∨
    (evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op = .error FaultKind.undefined ∧
      evalArrSliceBaseOperandToSlot pack.bodyTgt.locals slots₂ op = .error FaultKind.undefined) ∨
    (∃ (ty : MirTy) (optVal : Option Val) (slots₁' slots₂' : List ArrSliceSlot),
      evalArrSliceBaseOperandToSlot pack.bodySrc.locals slots₁ op = .ok (ty, optVal, slots₁') ∧
      evalArrSliceBaseOperandToSlot pack.bodyTgt.locals slots₂ op = .ok (ty, optVal, slots₂') ∧
      arrSc_PrefixMatch pack slots₁' slots₂' ∧
      slots₂'.length = slots₂.length ∧
      (∀ j : Nat, pack.bodySrc.locals.length ≤ j →
        Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) ∧
      Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₁ plan.arrLocal ∧
      Trusted.MirSemantics.getElem? slots₂' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₂ plan.arrLocal) := by
  cases op with
  | constant c =>
    dsimp [evalArrSliceBaseOperandToSlot]
    cases hLit : evalConstLit c.ty c.lit with
    | error k =>
      cases k with
      | unsupported => exact Or.inl ⟨rfl, rfl⟩
      | undefined => exact Or.inr (Or.inl ⟨rfl, rfl⟩)
    | ok v =>
      exact Or.inr (Or.inr ⟨c.ty, some v, slots₁, slots₂, rfl, rfl, hPref, rfl,
        fun _ _ => rfl, rfl, rfl⟩)
  | copy p =>
    unfold operandUsesOnlyBase at hOp
    have hPAnd := (bool_and_eq_true _ _).mp hOp
    have hProj : (!p.projection.isEmpty) = false := by
      rw [hPAnd.1]
      rfl
    cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
    | none =>
      rw [hDecl] at hPAnd
      cases hPAnd.2
    | some d =>
      rw [hDecl] at hPAnd
      cases d with
      | array _ _ | sliceView _ => cases hPAnd.2
      | base ty =>
        have hLt : p.localId < pack.bodySrc.locals.length :=
          getElem?_some_lt pack.bodySrc.locals p.localId (.base ty) hDecl
        have hNe : p.localId ≠ plan.arrLocal := fun hEq => by
          rw [hEq, pack.hArrDecl] at hDecl
          cases hDecl
        have hDecl₂ := arrSc_getElem?_bodyTgt_locals_lt pack hLt hNe
        rw [hDecl] at hDecl₂
        have hSlEq := hPref.2 p.localId hLt hNe
        dsimp [evalArrSliceBaseOperandToSlot]
        rw [hProj]
        dsimp
        rw [hDecl, hDecl₂, ← hSlEq]
        cases hSl : Trusted.MirSemantics.getElem? slots₂ p.localId with
        | none => exact Or.inl ⟨rfl, rfl⟩
        | some sl =>
          cases sl with
          | arrDead | liveArray _ | sliceDead | liveSlice _ => exact Or.inl ⟨rfl, rfl⟩
          | baseSlot bs =>
            cases bs with
            | dead => exact Or.inr (Or.inl ⟨rfl, rfl⟩)
            | live optV =>
              exact Or.inr (Or.inr ⟨ty, optV, slots₁, slots₂, rfl, rfl, hPref, rfl,
                fun _ _ => rfl, rfl, rfl⟩)
  | move p =>
    unfold operandUsesOnlyBase at hOp
    have hPAnd := (bool_and_eq_true _ _).mp hOp
    have hProj : (!p.projection.isEmpty) = false := by
      rw [hPAnd.1]
      rfl
    cases hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
    | none =>
      rw [hDecl] at hPAnd
      cases hPAnd.2
    | some d =>
      rw [hDecl] at hPAnd
      cases d with
      | array _ _ | sliceView _ => cases hPAnd.2
      | base ty =>
        have hLt : p.localId < pack.bodySrc.locals.length :=
          getElem?_some_lt pack.bodySrc.locals p.localId (.base ty) hDecl
        have hNe : p.localId ≠ plan.arrLocal := fun hEq => by
          rw [hEq, pack.hArrDecl] at hDecl
          cases hDecl
        have hDecl₂ := arrSc_getElem?_bodyTgt_locals_lt pack hLt hNe
        rw [hDecl] at hDecl₂
        have hSlEq := hPref.2 p.localId hLt hNe
        dsimp [evalArrSliceBaseOperandToSlot]
        rw [hProj]
        dsimp
        rw [hDecl, hDecl₂, ← hSlEq]
        cases hSl : Trusted.MirSemantics.getElem? slots₂ p.localId with
        | none => exact Or.inl ⟨rfl, rfl⟩
        | some sl =>
          cases sl with
          | arrDead | liveArray _ | sliceDead | liveSlice _ => exact Or.inl ⟨rfl, rfl⟩
          | baseSlot bs =>
            cases bs with
            | dead => exact Or.inr (Or.inl ⟨rfl, rfl⟩)
            | live optV =>
              have hLt₁ : p.localId < slots₁.length := by rw [hPref.1]; exact hLt
              have hLt₂ : p.localId < slots₂.length :=
                getElem?_some_lt slots₂ p.localId (.baseSlot (.live optV)) hSl
              cases hSet₁ : setElem? slots₁ p.localId (.baseSlot (liveUninitSlot ty)) with
              | none =>
                cases lt_setElem?_some slots₁ p.localId (.baseSlot (liveUninitSlot ty)) hLt₁ with
                | intro _ hS => rw [hS] at hSet₁; cases hSet₁
              | some slots₁' =>
                cases hSet₂ : setElem? slots₂ p.localId (.baseSlot (liveUninitSlot ty)) with
                | none =>
                  cases lt_setElem?_some slots₂ p.localId (.baseSlot (liveUninitSlot ty)) hLt₂ with
                  | intro _ hS => rw [hS] at hSet₂; cases hSet₂
                | some slots₂' =>
                  refine Or.inr (Or.inr ⟨ty, optV, slots₁', slots₂',
                    by dsimp; rw [hSet₁], by dsimp; rw [hSet₂], ?_, ?_, ?_, ?_, ?_⟩)
                  · constructor
                    · rw [setElem?_length slots₁ p.localId (.baseSlot (liveUninitSlot ty)) slots₁' hSet₁,
                        hPref.1]
                    · intro i hi hNeArr
                      cases s4a_arrSc_nat_eq_or_ne i p.localId with
                      | inl hEqP =>
                        rw [hEqP,
                          getElem?_setElem?_self slots₂ p.localId (.baseSlot (liveUninitSlot ty)) slots₂' hSet₂,
                          getElem?_setElem?_self slots₁ p.localId (.baseSlot (liveUninitSlot ty)) slots₁' hSet₁]
                      | inr hEqP =>
                        rw [getElem?_setElem?_ne slots₂ p.localId i (.baseSlot (liveUninitSlot ty)) slots₂'
                              (fun h => hEqP h.symm) hSet₂,
                          getElem?_setElem?_ne slots₁ p.localId i (.baseSlot (liveUninitSlot ty)) slots₁'
                              (fun h => hEqP h.symm) hSet₁]
                        exact hPref.2 i hi hNeArr
                  · exact setElem?_length slots₂ p.localId (.baseSlot (liveUninitSlot ty)) slots₂' hSet₂
                  · intro j hj
                    have hNeJ : p.localId ≠ j := fun hEq =>
                      nat_lt_irrefl p.localId (Nat.lt_of_lt_of_le hLt (by rw [hEq]; exact hj))
                    exact getElem?_setElem?_ne slots₂ p.localId j (.baseSlot (liveUninitSlot ty)) slots₂'
                      hNeJ hSet₂
                  · exact getElem?_setElem?_ne slots₁ p.localId plan.arrLocal
                      (.baseSlot (liveUninitSlot ty)) slots₁' hNe hSet₁
                  · exact getElem?_setElem?_ne slots₂ p.localId plan.arrLocal
                      (.baseSlot (liveUninitSlot ty)) slots₂' hNe hSet₂

private theorem arrSc_evalArrSliceTypedOperand_prefix {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPref : arrSc_PrefixMatch pack slots₁ slots₂)
    (expectedTy : MirTy) (op : Operand)
    (hOp : operandUsesOnlyBase pack.bodySrc.locals op = true) :
    (∃ k : FaultKind,
      evalArrSliceTypedOperand pack.bodySrc.locals slots₁ expectedTy op = .error k ∧
      evalArrSliceTypedOperand pack.bodyTgt.locals slots₂ expectedTy op = .error k) ∨
    (∃ (v : Val) (slots₁' slots₂' : List ArrSliceSlot),
      evalArrSliceTypedOperand pack.bodySrc.locals slots₁ expectedTy op = .ok (v, slots₁') ∧
      evalArrSliceTypedOperand pack.bodyTgt.locals slots₂ expectedTy op = .ok (v, slots₂') ∧
      checkVal v expectedTy = true ∧
      arrSc_PrefixMatch pack slots₁' slots₂' ∧
      slots₂'.length = slots₂.length ∧
      (∀ j : Nat, pack.bodySrc.locals.length ≤ j →
        Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) ∧
      Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₁ plan.arrLocal ∧
      Trusted.MirSemantics.getElem? slots₂' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₂ plan.arrLocal) := by
  cases arrSc_evalArrSliceBaseOperandToSlot_prefix pack hPref op hOp with
  | inl hErr =>
    left
    refine ⟨.unsupported, ?_, ?_⟩
    · dsimp [evalArrSliceTypedOperand]; rw [hErr.1]
    · dsimp [evalArrSliceTypedOperand]; rw [hErr.2]
  | inr hRest =>
    cases hRest with
    | inl hErr =>
      left
      refine ⟨.undefined, ?_, ?_⟩
      · dsimp [evalArrSliceTypedOperand]; rw [hErr.1]
      · dsimp [evalArrSliceTypedOperand]; rw [hErr.2]
    | inr hOk =>
      cases hOk with
      | intro ty h1 => cases h1 with
      | intro optVal h2 => cases h2 with
      | intro slots₁' h3 => cases h3 with
      | intro slots₂' hAll =>
        dsimp [evalArrSliceTypedOperand]
        rw [hAll.1, hAll.2.1]
        dsimp
        cases hBeq : !MirTy.beq ty expectedTy with
        | true => exact Or.inl ⟨.unsupported, rfl, rfl⟩
        | false =>
          dsimp
          cases optVal with
          | none => exact Or.inl ⟨.undefined, rfl, rfl⟩
          | some v =>
            dsimp
            cases hChk : checkVal v expectedTy with
            | false => exact Or.inl ⟨.unsupported, rfl, rfl⟩
            | true =>
              exact Or.inr ⟨v, slots₁', slots₂', rfl, rfl, hChk, hAll.2.2⟩

private theorem arrSc_evalUsizeOperand_prefix {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List ArrSliceSlot}
    (hPref : arrSc_PrefixMatch pack slots₁ slots₂)
    (op : Operand)
    (hOp : operandUsesOnlyBase pack.bodySrc.locals op = true) :
    (∃ k : FaultKind,
      evalUsizeOperand pack.bodySrc.locals slots₁ op = .error k ∧
      evalUsizeOperand pack.bodyTgt.locals slots₂ op = .error k) ∨
    (∃ (n : Nat) (slots₁' slots₂' : List ArrSliceSlot),
      evalUsizeOperand pack.bodySrc.locals slots₁ op = .ok (n, slots₁') ∧
      evalUsizeOperand pack.bodyTgt.locals slots₂ op = .ok (n, slots₂') ∧
      n < maxUsize ∧
      arrSc_PrefixMatch pack slots₁' slots₂' ∧
      slots₂'.length = slots₂.length ∧
      (∀ j : Nat, pack.bodySrc.locals.length ≤ j →
        Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) ∧
      Trusted.MirSemantics.getElem? slots₁' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₁ plan.arrLocal ∧
      Trusted.MirSemantics.getElem? slots₂' plan.arrLocal =
        Trusted.MirSemantics.getElem? slots₂ plan.arrLocal) := by
  cases arrSc_evalArrSliceTypedOperand_prefix pack hPref usizeTy op hOp with
  | inl hErr =>
    cases hErr with
    | intro k hk =>
      left
      refine ⟨k, ?_, ?_⟩
      · dsimp [evalUsizeOperand]; rw [hk.1]
      · dsimp [evalUsizeOperand]; rw [hk.2]
  | inr hOk =>
    cases hOk with
    | intro v h1 => cases h1 with
    | intro slots₁' h2 => cases h2 with
    | intro slots₂' hAll =>
      cases (arrSc_checkVal_usize_iff v).mp hAll.2.2.1 with
      | intro sv hsv =>
        dsimp [evalUsizeOperand]
        rw [hAll.1, hAll.2.1, hsv.1]
        exact Or.inr ⟨sv.bits.toNat, slots₁', slots₂', rfl, rfl, hsv.2.2.2.2, hAll.2.2.2⟩

private theorem arrSc_evalArrSlicePrimitiveOperand_prefix {plan : ArrayScalarizePlan}
