private theorem arrSc_lowerBlock_getElem?_stmt
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bbSrc : ArrSliceBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bbSrc)
    {i : Nat} {stmt : ArrSliceStmt}
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements i = some stmt) :
    ∃ extraStart : Nat,
      let base := pack.bodySrc.locals.length
      let termRes := lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator
      let bbTgt : ArrSliceBlock := {
        bbSrc with
        statements :=
          listFlatMap (lowerStmtForArray plan.arrLocal base pack.len) bbSrc.statements ++ termRes.1
        terminator := termRes.2.1
      }
      let off :=
        (listFlatMap (lowerStmtForArray plan.arrLocal base pack.len)
          (bbSrc.statements.take i)).length
      let gen := lowerStmtForArray plan.arrLocal base pack.len stmt
      pack.bodySrc.basicBlocks.length ≤ extraStart ∧
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt ∧
      (∀ j : Nat, j < gen.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
          Trusted.MirSemantics.getElem? gen j) ∧
      off + gen.length =
        (listFlatMap (lowerStmtForArray plan.arrLocal base pack.len)
          (bbSrc.statements.take (i + 1))).length ∧
      (∀ k : Nat, k < termRes.2.2.length →
        Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (extraStart + k) =
          Trusted.MirSemantics.getElem? termRes.2.2 k) := by
  cases arrSc_getElem?_bodyTgt_blocks pack hBb with
  | intro extraStart hSpec =>
    refine ⟨extraStart, hSpec.1, hSpec.2.1, ?_, ?_, hSpec.2.2⟩
    · intro j hj
      let f := lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len
      have hFlat := arrSc_listFlatMap_split_at_strong f hStmt
      dsimp
      rw [hFlat]
      rw [List.append_assoc (listFlatMap f (bbSrc.statements.take i)) (f stmt) _,
        List.append_assoc (listFlatMap f (bbSrc.statements.take i))
          (f stmt ++ listFlatMap f (bbSrc.statements.drop (i + 1))) _]
      rw [getElem?_append_right (listFlatMap f (bbSrc.statements.take i)) _ j,
        List.append_assoc (f stmt) (listFlatMap f (bbSrc.statements.drop (i + 1))) _,
        getElem?_append_left (f stmt) _ j hj]
    · rw [arrSc_listFlatMap_take_split _ hStmt, list_append_length]

private theorem arrSc_lowerBlock_getElem?_termPre
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bbSrc : ArrSliceBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bbSrc) :
    ∃ extraStart : Nat,
      let base := pack.bodySrc.locals.length
      let termRes := lowerTermForArray plan.arrLocal base pack.len extraStart bbSrc.terminator
      let bbTgt : ArrSliceBlock := {
        bbSrc with
        statements :=
          listFlatMap (lowerStmtForArray plan.arrLocal base pack.len) bbSrc.statements ++ termRes.1
        terminator := termRes.2.1
      }
      let off :=
        (listFlatMap (lowerStmtForArray plan.arrLocal base pack.len) bbSrc.statements).length
      pack.bodySrc.basicBlocks.length ≤ extraStart ∧
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bbTgt ∧
      off =
        (listFlatMap (lowerStmtForArray plan.arrLocal base pack.len)
          (bbSrc.statements.take bbSrc.statements.length)).length ∧
      off + termRes.1.length = bbTgt.statements.length ∧
      (∀ j : Nat, j < termRes.1.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
          Trusted.MirSemantics.getElem? termRes.1 j) ∧
      (∀ k : Nat, k < termRes.2.2.length →
        Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (extraStart + k) =
          Trusted.MirSemantics.getElem? termRes.2.2 k) := by
  cases arrSc_getElem?_bodyTgt_blocks pack hBb with
  | intro extraStart hSpec =>
    refine ⟨extraStart, hSpec.1, hSpec.2.1, ?_, ?_, ?_, hSpec.2.2⟩
    · rw [arrSc_list_take_all]
    · dsimp
      rw [list_append_length]
    · intro j hj
      dsimp
      rw [getElem?_append_right _ _ j]

private noncomputable def arrSc_FwdSim
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    (f₁ f₂ : ArrSliceFrame) (cm : CallerMemory) : Prop :=
  (∀ s₁', evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .step s₁' →
    ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ arrSc_StateRel pack s₁' s₂') ∧
  (∀ out, evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .done out →
    ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.done out)) ∧
  (∀ k, evalStepArrSlice pSrc 0 { frames := [f₁], callerMem := cm } = .fault k →
    ∃ s₂', ReachesArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧ StepArrSlice pTgt s₂' (.fault k))

private theorem arrSc_reachesPlus_stmt_rel
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {slots₁' slots₂' : List ArrSliceSlot} {genLen n : Nat}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length)
    (hLenNext : f₂.stmtIdx + genLen =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hReach : ReachesNArrSlice pTgt (n + 1) { frames := [f₂], callerMem := cm }
      { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + genLen, locals := slots₂' }], callerMem := cm })
    (hLM' : arrSc_LocalMatch pack slots₁' slots₂') :
    ∃ s₂', ReachesPlusArrSlice pTgt { frames := [f₂], callerMem := cm } s₂' ∧
      arrSc_StateRel pack
        { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], callerMem := cm }
        s₂' := by
  let s₂' : ArrSliceState :=
    { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + genLen, locals := slots₂' }], callerMem := cm }
  refine ⟨s₂', ⟨n, hReach⟩, rfl, Or.inl ⟨hSame, hSame₂, hBbEq, hLM', ?_⟩⟩
  rw [hBbSrc]
  exact ⟨hLeNext, hLenNext⟩

private theorem arrSc_sim_stmt_one
    {plan : ArrayScalarizePlan} {pSrc pTgt : ArrSliceProgram}
    (pack : ArrScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : ArrSliceBlock} {f₁ f₂ : ArrSliceFrame} {cm : CallerMemory}
    {stmtSrc stmtTgt : ArrSliceStmt}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbEq : f₂.blockIdx = f₁.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmtSrc)
    (hLenNext : f₂.stmtIdx + 1 =
      (listFlatMap (lowerStmtForArray plan.arrLocal pack.bodySrc.locals.length pack.len)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some stmtTgt)
    (hCore :
      (∀ s₁', evalArrSliceStmt pack.bodySrc f₁ cm stmtSrc = .step s₁' →
        ∃ slots₁' slots₂',
          s₁' = { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], callerMem := cm } ∧
          evalArrSliceStmt pack.bodyTgt f₂ cm stmtTgt = stepStmtNext f₂ cm slots₂' ∧
          arrSc_LocalMatch pack slots₁' slots₂') ∧
      (∀ out, evalArrSliceStmt pack.bodySrc f₁ cm stmtSrc = .done out → False) ∧
      (∀ k, evalArrSliceStmt pack.bodySrc f₁ cm stmtSrc = .fault k →
        evalArrSliceStmt pack.bodyTgt f₂ cm stmtTgt = .fault k)) :
    arrSc_FwdSim pack f₁ f₂ cm := by
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    getElem?_some_lt bbSrc.statements f₁.stmtIdx stmtSrc hStmtSrc
  have hEvSrc := arrSc_evalStepArrSlice_at_stmt pSrc pack.bodySrc f₁ cm bbSrc stmtSrc
    hBodySrc hBbSrc hStmtSrc
  have hEvTgt := arrSc_evalStepArrSlice_at_stmt pTgt pack.bodyTgt f₂ cm bbTgt stmtTgt
    hBodyTgt hBbTgt hStmtTgt
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    rw [hEvSrc] at hStep
    cases hCore.1 s₁' hStep with
    | intro slots₁' h1 => cases h1 with
    | intro slots₂' h2 =>
      rw [h2.1]
      have hTgtStep : evalStepArrSlice pTgt 0 { frames := [f₂], callerMem := cm } =
          stepStmtNext f₂ cm slots₂' := by
        rw [hEvTgt]
        exact h2.2.1
      exact arrSc_reachesPlus_stmt_rel pack hSame hSame₂ hBbEq hBbSrc hLeNext hLenNext
        (arrSc_reachesNArrSlice_one_step hTgtStep) h2.2.2
  · intro out hDone
    rw [hEvSrc] at hDone
    exact False.elim (hCore.2.1 out hDone)
  · intro k hFault
    rw [hEvSrc] at hFault
    refine ⟨{ frames := [f₂], callerMem := cm }, ReachesArrSlice.refl _, ?_⟩
    rw [stepArrSlice_iff_evalStep, hEvTgt]
    exact hCore.2.2 k hFault

