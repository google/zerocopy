private theorem arrSc_evalArrSliceBaseRvalue_use_of_typedOp
    (decls : List ArrSliceLocalDecl) (slots : List ArrSliceSlot)
    (expectedTy : MirTy) (op : Operand) (v : Val) (slots' : List ArrSliceSlot)
    (hOk : evalArrSliceTypedOperand decls slots expectedTy op = .ok (v, slots')) :
    evalArrSliceBaseRvalue decls slots expectedTy (.use op) = .ok (v, slots') := by
  dsimp [evalArrSliceTypedOperand] at hOk
  cases hBase : evalArrSliceBaseOperandToSlot decls slots op with
  | error _ => rw [hBase] at hOk; cases hOk
  | ok res =>
    rw [hBase] at hOk
    cases res with
    | mk srcTy rest => cases rest with
    | mk optVal slotsMid =>
      dsimp at hOk
      cases hBeq : !MirTy.beq srcTy expectedTy with
      | true => rw [hBeq] at hOk; cases hOk
      | false =>
        rw [hBeq] at hOk; dsimp at hOk
        cases optVal with
        | none => cases hOk
        | some v' =>
          dsimp at hOk
          cases hChk : checkVal v' expectedTy with
          | false => rw [hChk] at hOk; cases hOk
          | true =>
            rw [hChk] at hOk
            have hEq := Except.ok.inj hOk
            dsimp [evalArrSliceBaseRvalue]
            rw [hBase]; dsimp; rw [hBeq]; dsimp; rw [hEq]

private theorem arrSc_step_mkAssignUse_typedOp_writeErr (p : ArrSliceProgram)
    (body : ArrSliceBody) (bb : ArrSliceBlock) (frame : ArrSliceFrame)
    (callerMem : CallerMemory) (dst : LocalId) (expectedTy : MirTy) (op : Operand)
    (v : Val) (slots' : List ArrSliceSlot) (k : FaultKind)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx =
      some (mkAssignUse dst op))
    (hDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base expectedTy))
    (hOk : evalArrSliceTypedOperand body.locals frame.locals expectedTy op = .ok (v, slots'))
    (hErr : writeArrSliceBasePlace slots' dst expectedTy v = .error k) :
    evalStepArrSlice p 0 { frames := [frame], callerMem } = .fault k := by
  rw [arrSc_evalStepArrSlice_at_stmt p body frame callerMem bb _ hBody hBb hStmt]
  dsimp [mkAssignUse, evalArrSliceStmt]
  rw [hDecl]
  dsimp
  rw [arrSc_evalArrSliceBaseRvalue_use_of_typedOp body.locals frame.locals expectedTy op v slots' hOk]
  dsimp
  rw [hErr]

private theorem arrSc_step_switchInt_move_bool (p : ArrSliceProgram) (body : ArrSliceBody)
    (bb : ArrSliceBlock) (frame : ArrSliceFrame) (callerMem : CallerMemory)
    (condScr : LocalId) (b : Bool) (inBoundsBb panicBb : BasicBlockId)
    (slots' : List ArrSliceSlot)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hIdx : frame.stmtIdx = bb.statements.length)
    (hTerm : bb.terminator = .baseTerm (.switchInt (.move { localId := condScr, projection := [] })
      { branches := [(BitVec.ofNat 128 1, inBoundsBb)], otherwise := panicBb }))
    (hDecl : Trusted.MirSemantics.getElem? body.locals condScr = some (.base .bool))
    (hLive : Trusted.MirSemantics.getElem? frame.locals condScr =
      some (.baseSlot (.live (some (.bool b)))))
    (hSet : setElem? frame.locals condScr (.baseSlot (liveUninitSlot .bool)) = some slots') :
    evalStepArrSlice p 0 { frames := [frame], callerMem } =
      jumpArrSliceBlock frame callerMem slots' (if b then inBoundsBb else panicBb) := by
  rw [arrSc_evalStepArrSlice_at_term p body frame callerMem bb hBody hBb hIdx]
  dsimp [evalArrSliceTerm]
  rw [hTerm]
  dsimp
  have hPrim : evalArrSlicePrimitiveOperand body.locals frame.locals
      (.move { localId := condScr, projection := [] }) = .ok (.bool b, slots') := by
    dsimp [evalArrSlicePrimitiveOperand, evalArrSliceBaseOperandToSlot]
    rw [hDecl, hLive]
    dsimp
    rw [hSet]
    rfl
  rw [hPrim]
  dsimp
  rw [arrSc_evalBoolSwitchBranches_bool b inBoundsBb panicBb]

private theorem arrSc_step_switchInt_move_armBranches (p : ArrSliceProgram)
    (body : ArrSliceBody) (bb : ArrSliceBlock) (frame : ArrSliceFrame)
    (callerMem : CallerMemory) (idxScr : LocalId) (idx len armStart : Nat)
    (branches : List (BitVec 128 × BasicBlockId))
    (slots' : List ArrSliceSlot)
    (hIdxLt : idx < maxUsize)
    (hLenLt : len ≤ maxUsize)
    (hBr : branches = arrSc_armBranches 0 armStart len)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hIdx : frame.stmtIdx = bb.statements.length)
    (hTerm : bb.terminator = .baseTerm (.switchInt (.move { localId := idxScr, projection := [] })
      { branches := branches, otherwise := armStart + len }))
    (hDecl : Trusted.MirSemantics.getElem? body.locals idxScr = some (.base usizeTy))
    (hLive : Trusted.MirSemantics.getElem? frame.locals idxScr =
      some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 idx⟩)))))
    (hSet : setElem? frame.locals idxScr (.baseSlot (liveUninitSlot usizeTy)) = some slots') :
    evalStepArrSlice p 0 { frames := [frame], callerMem } =
      jumpArrSliceBlock frame callerMem slots'
        (if Nat.blt idx len then armStart + idx else armStart + len) := by
  rw [arrSc_evalStepArrSlice_at_term p body frame callerMem bb hBody hBb hIdx]
  dsimp [evalArrSliceTerm]
  rw [hTerm, hBr]
  dsimp
  have hPrim : evalArrSlicePrimitiveOperand body.locals frame.locals
      (.move { localId := idxScr, projection := [] }) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 idx⟩, slots') := by
    dsimp [evalArrSlicePrimitiveOperand, evalArrSliceBaseOperandToSlot]
    rw [hDecl, hLive]
    dsimp
    rw [hSet]
    rfl
  rw [hPrim]
  dsimp
  have hSw := arrSc_evalSwitchBranches_armBranches (armStart + len) idx hIdxLt len 0 armStart
    (by rw [Nat.zero_add]; exact hLenLt)
  rw [Nat.zero_add, Nat.sub_zero] at hSw
  have hBle : Nat.ble 0 idx = true := by cases idx <;> rfl
  rw [hBle] at hSw
  rw [hSw]
  rfl

