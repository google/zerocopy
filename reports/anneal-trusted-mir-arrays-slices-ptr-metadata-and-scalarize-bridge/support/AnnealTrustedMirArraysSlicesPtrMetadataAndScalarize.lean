private theorem s4a_arrSc_nat_eq_or_ne (a b : Nat) : a = b ∨ a ≠ b :=
  match h : Nat.beq a b with
  | true => Or.inl (nat_beq_eq a b h)
  | false => Or.inr (fun hEq => by rw [nat_beq_true hEq] at h; cases h)

private theorem arrSc_list_append_nil {α : Type} (xs : List α) :
    xs ++ [] = xs := by
  induction xs with
  | nil => rfl
  | cons a tl ih =>
    change a :: (tl ++ []) = a :: tl
    rw [ih]

private theorem arrSc_listFlatMap_nil {α β : Type} (f : α → List β) :
    listFlatMap f [] = [] := rfl

private theorem arrSc_listFlatMap_cons {α β : Type} (f : α → List β) (x : α) (xs : List α) :
    listFlatMap f (x :: xs) = f x ++ listFlatMap f xs := rfl

private theorem arrSc_listFlatMap_singleton {α β : Type} (f : α → List β) (x : α) :
    listFlatMap f [x] = f x := by
  rw [arrSc_listFlatMap_cons, arrSc_listFlatMap_nil, arrSc_list_append_nil]

private theorem arrSc_getElem?_cons_zero {α : Type} (a : α) (tl : List α) :
    Trusted.MirSemantics.getElem? (a :: tl) 0 = some a := rfl

private theorem arrSc_getElem?_cons_succ {α : Type} (a : α) (tl : List α) (i : Nat) :
    Trusted.MirSemantics.getElem? (a :: tl) (i + 1) =
      Trusted.MirSemantics.getElem? tl i := rfl

private theorem arrSc_list_take_succ_of_getElem? {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α),
      Trusted.MirSemantics.getElem? xs i = some x →
      xs.take (i + 1) = xs.take i ++ [x]
  | [], _, _, h => by cases h
  | a :: _, 0, x, h => by
    have hEq : a = x := Option.some.inj h
    rw [hEq]
    rfl
  | a :: tl, i + 1, x, h => by
    have hTail := arrSc_list_take_succ_of_getElem? tl i x h
    change a :: tl.take (i + 1) = (a :: tl.take i) ++ [x]
    rw [hTail]
    rfl

private theorem arrSc_listFlatMap_take_split {α β : Type} (f : α → List β) {xs : List α}
    {i : Nat} {x : α} (h : Trusted.MirSemantics.getElem? xs i = some x) :
    listFlatMap f (xs.take (i + 1)) = listFlatMap f (xs.take i) ++ f x := by
  rw [arrSc_list_take_succ_of_getElem? xs i x h, listFlatMap_append,
    arrSc_listFlatMap_singleton]

private theorem arrSc_list_take_all {α : Type} :
    ∀ (xs : List α), xs.take xs.length = xs
  | [] => rfl
  | a :: tl => congrArg (List.cons a) (arrSc_list_take_all tl)

private theorem arrSc_list_drop_zero {α : Type} (xs : List α) :
    xs.drop 0 = xs := rfl

private theorem arrSc_list_drop_succ_cons {α : Type} (a : α) (tl : List α) (n : Nat) :
    (a :: tl).drop (n + 1) = tl.drop n := rfl

private theorem arrSc_list_length_drop {α : Type} :
    ∀ (xs : List α) (n : Nat), (xs.drop n).length = xs.length - n
  | [], 0 => rfl
  | [], n + 1 => (Nat.zero_sub (n + 1)).symm
  | a :: tl, 0 => by
    rw [arrSc_list_drop_zero, Nat.sub_zero]
  | a :: tl, n + 1 => by
    rw [arrSc_list_drop_succ_cons, arrSc_list_length_drop tl n, List.length_cons,
      Nat.succ_sub_succ_eq_sub]

private theorem arrSc_getElem?_drop {α : Type} :
    ∀ (xs : List α) (n i : Nat),
      Trusted.MirSemantics.getElem? (xs.drop n) i =
        Trusted.MirSemantics.getElem? xs (n + i)
  | [], 0, i => by rw [arrSc_list_drop_zero, Nat.zero_add]
  | [], n + 1, i => rfl
  | xs, 0, i => by rw [arrSc_list_drop_zero, Nat.zero_add]
  | a :: tl, n + 1, i => by
    rw [arrSc_list_drop_succ_cons, arrSc_getElem?_drop tl n i, Nat.succ_add]
    rfl

private theorem arrSc_getElem?_take_lt {α : Type} :
    ∀ (xs : List α) (n i : Nat),
      i < n → Trusted.MirSemantics.getElem? (xs.take n) i = Trusted.MirSemantics.getElem? xs i
  | [], _, _, _ => by cases ‹_› <;> rfl
  | _ :: _, 0, _, h => nomatch h
  | a :: _, _ + 1, 0, _ => rfl
  | _ :: tl, n + 1, i + 1, h =>
    arrSc_getElem?_take_lt tl n i (Nat.lt_of_succ_lt_succ h)

private theorem arrSc_list_take_append_left {α : Type} :
    ∀ (xs ys : List α) (n : Nat),
      n ≤ xs.length → (xs ++ ys).take n = xs.take n
  | _, _, 0, _ => rfl
  | [], _, _ + 1, h => nomatch h
  | a :: xs, ys, n + 1, h => by
    change a :: (xs ++ ys).take n = a :: xs.take n
    rw [arrSc_list_take_append_left xs ys n (Nat.le_of_succ_le_succ h)]

private theorem arrSc_list_length_take_le {α : Type} :
    ∀ (xs : List α) (n : Nat), (xs.take n).length ≤ n
  | [], n => by cases n <;> exact Nat.zero_le _
  | _ :: _, 0 => Nat.zero_le _
  | _ :: tl, n + 1 => Nat.succ_le_succ (arrSc_list_length_take_le tl n)

private theorem arrSc_list_length_take_of_le {α : Type} :
    ∀ (xs : List α) (n : Nat), n ≤ xs.length → (xs.take n).length = n
  | [], 0, _ => rfl
  | [], _ + 1, h => nomatch h
  | _ :: _, 0, _ => rfl
  | _ :: tl, n + 1, h =>
    congrArg Nat.succ (arrSc_list_length_take_of_le tl n (Nat.le_of_succ_le_succ h))

private theorem arrSc_getElem?_append_middle {α : Type} (xs : List α) (x : α) (ys : List α) :
    Trusted.MirSemantics.getElem? (xs ++ x :: ys) xs.length = some x := by
  have h := getElem?_append_right xs (x :: ys) 0
  rw [Nat.add_zero] at h
  exact h

private theorem arrSc_getElem?_append_middle_add {α : Type} (xs ys zs : List α) (k : Nat)
    (hk : k < ys.length) :
    Trusted.MirSemantics.getElem? (xs ++ ys ++ zs) (xs.length + k) =
      Trusted.MirSemantics.getElem? ys k := by
  rw [List.append_assoc, getElem?_append_right xs (ys ++ zs) k,
    getElem?_append_left ys zs k hk]

private theorem arrSc_setElem?_append_middle {α : Type} (xs ys zs : List α) (k : Nat) (v : α)
    (hk : k < ys.length) :
    setElem? (xs ++ ys ++ zs) (xs.length + k) v =
      match setElem? ys k v with
      | some ys' => some (xs ++ ys' ++ zs)
      | none => none := by
  rw [List.append_assoc, setElem?_append_right xs (ys ++ zs) k v,
    setElem?_append_left ys zs k v hk]
  cases setElem? ys k v with
  | none => rfl
  | some ys' =>
    dsimp
    rw [List.append_assoc]

private theorem arrSc_list_any_cons {α : Type} (p : α → Bool) (a : α) (tl : List α) :
    (a :: tl).any p = (p a || tl.any p) := by
  rfl

private theorem arrSc_list_any_iff_getElem? {α : Type} (p : α → Bool) :
    ∀ (xs : List α),
      xs.any p = true ↔ ∃ (i : Nat) (x : α),
        Trusted.MirSemantics.getElem? xs i = some x ∧ p x = true
  | [] => by
    constructor
    · intro h
      cases h
    · intro h
      cases h with
      | intro i hi =>
        cases hi with
        | intro x hx => cases hx.1
  | a :: tl => by
    rw [arrSc_list_any_cons, bool_or_eq_true, arrSc_list_any_iff_getElem? p tl]
    constructor
    · intro h
      cases h with
      | inl ha => exact ⟨0, a, rfl, ha⟩
      | inr htl =>
        cases htl with
        | intro i hi =>
          cases hi with
          | intro x hx => exact ⟨i + 1, x, hx.1, hx.2⟩
    · intro h
      cases h with
      | intro i hi =>
        cases hi with
        | intro x hx =>
          cases i with
          | zero =>
            have ha : a = x := Option.some.inj hx.1
            rw [ha]
            exact Or.inl hx.2
          | succ j => exact Or.inr ⟨j, x, hx.1, hx.2⟩

private theorem arrSc_listFlatMap_any_iff {α β : Type} (f : α → List β) (p : β → Bool) :
    ∀ (xs : List α),
      (listFlatMap f xs).any p = true ↔ ∃ (x : α), x ∈ xs ∧ (f x).any p = true
  | [] => by
    constructor
    · intro h
      cases h
    · intro h
      cases h with
      | intro x hx => cases hx.1
  | a :: tl => by
    rw [arrSc_listFlatMap_cons, list_any_append, bool_or_eq_true,
      arrSc_listFlatMap_any_iff f p tl]
    constructor
    · intro h
      cases h with
      | inl ha => exact ⟨a, List.Mem.head tl, ha⟩
      | inr htl =>
        cases htl with
        | intro x hx => exact ⟨x, List.Mem.tail a hx.1, hx.2⟩
    · intro h
      cases h with
      | intro x hx =>
        cases hx.1 with
        | head => exact Or.inl hx.2
        | tail _ hMem => exact Or.inr ⟨x, hMem, hx.2⟩

private theorem arrSc_list_any_iff_mem {α : Type} (p : α → Bool) :
    ∀ (xs : List α), xs.any p = true ↔ ∃ x : α, x ∈ xs ∧ p x = true
  | [] => by
    constructor
    · intro h
      cases h
    · intro h
      cases h with
      | intro _ hx => cases hx.1
  | a :: tl => by
    rw [arrSc_list_any_cons, bool_or_eq_true, arrSc_list_any_iff_mem p tl]
    constructor
    · intro h
      cases h with
      | inl ha => exact ⟨a, List.Mem.head tl, ha⟩
      | inr htl =>
        cases htl with
        | intro x hx => exact ⟨x, List.Mem.tail a hx.1, hx.2⟩
    · intro h
      cases h with
      | intro x hx =>
        cases hx.1 with
        | head => exact Or.inl hx.2
        | tail _ hMem => exact Or.inr ⟨x, hMem, hx.2⟩

private theorem arrSc_list_any_eq_false_iff_mem {α : Type} (p : α → Bool) (xs : List α) :
    xs.any p = false ↔ ∀ x : α, x ∈ xs → p x = false := by
  constructor
  · intro h x hMem
    cases hP : p x with
    | false => rfl
    | true =>
      have hT : xs.any p = true := (arrSc_list_any_iff_mem p xs).mpr ⟨x, hMem, hP⟩
      rw [h] at hT
      cases hT
  · intro h
    cases hAny : xs.any p with
    | false => rfl
    | true =>
      cases (arrSc_list_any_iff_mem p xs).mp hAny with
      | intro x hx =>
        have hF := h x hx.1
        rw [hx.2] at hF
        cases hF

private theorem arrSc_list_all_iff_mem {α : Type} (p : α → Bool) (xs : List α) :
    xs.all p = true ↔ ∀ x : α, x ∈ xs → p x = true := by
  rw [list_all_iff_getElem?]
  constructor
  · intro h x hMem
    induction xs with
    | nil => cases hMem
    | cons _ tl ih =>
      cases hMem with
      | head => exact h 0 x rfl
      | tail _ hIn => exact ih (fun i y hy => h (i + 1) y hy) hIn
  · intro h i x hx
    induction xs generalizing i with
    | nil => cases hx
    | cons a tl ih =>
      cases i with
      | zero =>
        have hEq : a = x := Option.some.inj hx
        rw [← hEq]
        exact h a (List.Mem.head tl)
      | succ j =>
        exact ih (fun y hIn => h y (List.Mem.tail a hIn)) j hx

private theorem arrSc_maxUsize_eq : maxUsize = Nat.pow 2 64 := by
  rfl

private theorem arrSc_truncateBits_isize_lt_maxUsize (bv : BitVec 128) :
    (truncateBits .isize bv).toNat < maxUsize := by
  have hMod := bitVec_ofNat_toNat_eq_mod 64 bv.toNat
  change (BitVec.ofNat 128 (BitVec.ofNat 64 bv.toNat).toNat).toNat < maxUsize
  have h64 : (BitVec.ofNat 64 bv.toNat).toNat < maxUsize := by
    rw [hMod, arrSc_maxUsize_eq]
    exact Nat.mod_lt _ (nat_pow_two_pos 64)
  have h128 : (BitVec.ofNat 64 bv.toNat).toNat < Nat.pow 2 128 :=
    Nat.lt_trans h64 maxUsize_lt_pow128
  rw [bitVec_ofNat_toNat_of_lt h128]
  exact h64

private theorem arrSc_scalarVal_wf_isize_lt_maxUsize (sv : ScalarVal)
    (hw : sv.width = .isize)
    (hwf : sv.wf = true) : sv.bits.toNat < maxUsize := by
  have hwf' : (truncateBits sv.width sv.bits == sv.bits) = true := hwf
  rw [hw] at hwf'
  have hEq : truncateBits .isize sv.bits = sv.bits := bitVec_beq_eq _ _ hwf'
  rw [← hEq]
  exact arrSc_truncateBits_isize_lt_maxUsize sv.bits

private theorem arrSc_checkVal_usize_iff (v : Val) :
    checkVal v usizeTy = true ↔
      ∃ sv : ScalarVal, v = .scalar sv ∧ sv.width = .isize ∧ sv.signed = false ∧
        sv.wf = true ∧ sv.bits.toNat < maxUsize := by
  constructor
  · intro h
    cases v with
    | scalar sv =>
      change (match if sv.wf = true then some (MirTy.int sv.width sv.signed) else none with
        | some vTy => vTy.beq usizeTy
        | none => false) = true at h
      cases hwf : sv.wf with
      | false =>
        rw [hwf] at h
        cases h
      | true =>
        rw [hwf] at h
        have hbeq : (MirTy.int sv.width sv.signed).beq (MirTy.int IntWidth.isize false) = true := h
        have hEq := mirTy_beq_eq (MirTy.int sv.width sv.signed) (MirTy.int IntWidth.isize false) hbeq
        have hw : sv.width = IntWidth.isize := by injection hEq
        have hs : sv.signed = false := by injection hEq
        exact ⟨sv, rfl, hw, hs, hwf, arrSc_scalarVal_wf_isize_lt_maxUsize sv hw hwf⟩
    | bool _ => cases h
    | unit => cases h
    | enumVal ety idx =>
      change (match if (enumAdmitted ety && idx.blt ety.discriminants.length) = true
          then some (MirTy.enum ety) else none with
        | some vTy => vTy.beq usizeTy
        | none => false) = true at h
      cases hadm : (enumAdmitted ety && idx.blt ety.discriminants.length) with
      | false => rw [hadm] at h; cases h
      | true => rw [hadm] at h; cases h
    | ptr _ => cases h
    | tuple _ => cases h
    | bytes _ => cases h
  · intro h
    cases h with
    | intro sv hSv =>
      rw [hSv.1]
      change (match if sv.wf = true then some (MirTy.int sv.width sv.signed) else none with
        | some vTy => vTy.beq usizeTy
        | none => false) = true
      rw [hSv.2.2.2.1, hSv.2.1, hSv.2.2.1]
      rfl

private theorem arrSc_checkVal_bool_iff (v : Val) :
    checkVal v .bool = true ↔ ∃ b : Bool, v = .bool b := by
  constructor
  · intro h
    cases v with
    | bool b => exact ⟨b, rfl⟩
    | scalar sv =>
      change (match if sv.wf = true then some (MirTy.int sv.width sv.signed) else none with
        | some vTy => vTy.beq MirTy.bool
        | none => false) = true at h
      cases hwf : sv.wf with
      | false => rw [hwf] at h; cases h
      | true => rw [hwf] at h; cases h
    | unit => cases h
    | enumVal ety idx =>
      change (match if (enumAdmitted ety && idx.blt ety.discriminants.length) = true
          then some (MirTy.enum ety) else none with
        | some vTy => vTy.beq MirTy.bool
        | none => false) = true at h
      cases hadm : (enumAdmitted ety && idx.blt ety.discriminants.length) with
      | false => rw [hadm] at h; cases h
      | true => rw [hadm] at h; cases h
    | ptr _ => cases h
    | tuple _ => cases h
    | bytes _ => cases h
  · intro h
    cases h with
    | intro b hb =>
      rw [hb]
      rfl

private theorem arrSc_bvOfInt_128_ofNat (n : Nat) (hn : n < Nat.pow 2 128) :
    bvOfInt 128 (Int.ofNat n) = BitVec.ofNat 128 n := by
  change BitVec.ofNat 128 (intEmod (Int.ofNat n) (Int.ofNat (Nat.pow 2 128))).toNat =
    BitVec.ofNat 128 n
  have heq : intEmod (Int.ofNat n) (Int.ofNat (Nat.pow 2 128)) = Int.ofNat n :=
    congrArg Int.ofNat (Nat.mod_eq_of_lt hn)
  rw [heq]
  rfl

private theorem arrSc_decodeScalar_usize (n : Nat) (hn : n < maxUsize) :
    decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 n)) =
      Int.ofNat n := by
  have h128 : n < Nat.pow 2 128 := Nat.lt_trans hn maxUsize_lt_pow128
  change (if false = true then
      signExtendBits IntWidth.isize (truncateBits IntWidth.isize (BitVec.ofNat 128 n))
    else Int.ofNat (truncateBits IntWidth.isize (BitVec.ofNat 128 n)).toNat) = Int.ofNat n
  rw [truncateBits_isize_of_lt_maxUsize n hn, bitVec_ofNat_toNat_of_lt h128]
  rfl

private theorem arrSc_evalBinOp_usize_lt (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize) :
    evalBinOp .lt
        (.scalar ⟨.isize, false, BitVec.ofNat 128 a⟩)
        (.scalar ⟨.isize, false, BitVec.ofNat 128 b⟩) =
      .ok (.bool (Nat.blt a b)) := by
  change Except.ok (Val.bool (decide
      (decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 a)) <
       decodeScalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 b))))) = _
  rw [arrSc_decodeScalar_usize a ha, arrSc_decodeScalar_usize b hb]
  cases hlt : a.blt b with
  | true =>
    have hNat : a < b := nat_blt_lt hlt
    have hd : decide (Int.ofNat a < Int.ofNat b) = true :=
      decide_eq_true (s_int_ofNat_lt_mpr hNat)
    rw [hd]
  | false =>
    have hge : ¬(a < b) := fun hNat => by
      have ht : a.blt b = true := lt_nat_blt hNat
      rw [ht] at hlt
      cases hlt
    have hd : decide (Int.ofNat a < Int.ofNat b) = false :=
      decide_eq_false (fun hInt => hge (s_int_ofNat_lt_mp hInt))
    rw [hd]

private theorem arrSc_evalBinOp_usize_subUnchecked_zero_one :
    evalBinOp .subUnchecked
        (.scalar ⟨.isize, false, BitVec.ofNat 128 0⟩)
        (.scalar ⟨.isize, false, BitVec.ofNat 128 1⟩) =
      .error .undefined := rfl

private theorem arrSc_evalBoolSwitchBranches_bool (b : Bool) (inBoundsBb panicBb : BasicBlockId) :
    evalBoolSwitchBranches b panicBb [(BitVec.ofNat 128 1, inBoundsBb)] =
      .ok (if b then inBoundsBb else panicBb) := by
  cases b <;> rfl

/-- Canonical branch list produced by both `buildReadArrayArms` and
`buildWriteArrayArms`. -/
private noncomputable def arrSc_armBranches (idxStart armStart : Nat) :
    Nat → List (BitVec 128 × BasicBlockId)
  | 0 => []
  | rem + 1 =>
    (BitVec.ofNat 128 idxStart, armStart) ::
      arrSc_armBranches (idxStart + 1) (armStart + 1) rem

private theorem arrSc_buildReadArrayArms_branches (dst elemBase nextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildReadArrayArms dst elemBase nextBb idx armBb rem).1 =
        arrSc_armBranches idx armBb rem
  | 0, _, _ => rfl
  | rem + 1, idx, armBb => by
    change
      (BitVec.ofNat 128 idx, armBb) ::
        (buildReadArrayArms dst elemBase nextBb (idx + 1) (armBb + 1) rem).1 =
      (BitVec.ofNat 128 idx, armBb) ::
        arrSc_armBranches (idx + 1) (armBb + 1) rem
    rw [arrSc_buildReadArrayArms_branches dst elemBase nextBb rem (idx + 1) (armBb + 1)]

private theorem arrSc_buildWriteArrayArms_branches (valScr elemBase nextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildWriteArrayArms valScr elemBase nextBb idx armBb rem).1 =
        arrSc_armBranches idx armBb rem
  | 0, _, _ => rfl
  | rem + 1, idx, armBb => by
    change
      (BitVec.ofNat 128 idx, armBb) ::
        (buildWriteArrayArms valScr elemBase nextBb (idx + 1) (armBb + 1) rem).1 =
      (BitVec.ofNat 128 idx, armBb) ::
        arrSc_armBranches (idx + 1) (armBb + 1) rem
    rw [arrSc_buildWriteArrayArms_branches valScr elemBase nextBb rem (idx + 1) (armBb + 1)]

private theorem arrSc_buildReadArrayArms_blocks_length (dst elemBase nextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildReadArrayArms dst elemBase nextBb idx armBb rem).2.length = rem
  | 0, _, _ => rfl
  | rem + 1, idx, armBb =>
    congrArg Nat.succ
      (arrSc_buildReadArrayArms_blocks_length dst elemBase nextBb rem (idx + 1) (armBb + 1))

private theorem arrSc_buildWriteArrayArms_blocks_length (valScr elemBase nextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildWriteArrayArms valScr elemBase nextBb idx armBb rem).2.length = rem
  | 0, _, _ => rfl
  | rem + 1, idx, armBb =>
    congrArg Nat.succ
      (arrSc_buildWriteArrayArms_blocks_length valScr elemBase nextBb rem (idx + 1) (armBb + 1))

private theorem arrSc_getElem?_buildReadArrayArms (dst elemBase nextBb : Nat) :
    ∀ (rem idx armBb k : Nat), k < rem →
      Trusted.MirSemantics.getElem?
        (buildReadArrayArms dst elemBase nextBb idx armBb rem).2 k =
      some {
        statements :=
          [mkAssignUse dst (.copy { localId := elemBase + (idx + k), projection := [] })]
        terminator := .baseTerm (.goto nextBb)
        cleanup := false
      }
  | 0, _, _, _, h => nomatch h
  | _ + 1, idx, armBb, 0, _ => by
    rw [Nat.add_zero]
    rfl
  | rem + 1, idx, armBb, k + 1, h => by
    have hk : k < rem := Nat.lt_of_succ_lt_succ h
    have ih := arrSc_getElem?_buildReadArrayArms dst elemBase nextBb rem (idx + 1) (armBb + 1) k hk
    have hEq : elemBase + (idx + 1 + k) = elemBase + (idx + (k + 1)) := by
      rw [Nat.add_assoc idx 1 k, Nat.add_comm 1 k]
    rw [hEq] at ih
    exact ih

private theorem arrSc_getElem?_buildWriteArrayArms (valScr elemBase nextBb : Nat) :
    ∀ (rem idx armBb k : Nat), k < rem →
      Trusted.MirSemantics.getElem?
        (buildWriteArrayArms valScr elemBase nextBb idx armBb rem).2 k =
      some {
        statements :=
          [mkAssignUse (elemBase + (idx + k)) (.move { localId := valScr, projection := [] })]
        terminator := .baseTerm (.goto nextBb)
        cleanup := false
      }
  | 0, _, _, _, h => nomatch h
  | _ + 1, idx, armBb, 0, _ => by
    rw [Nat.add_zero]
    rfl
  | rem + 1, idx, armBb, k + 1, h => by
    have hk : k < rem := Nat.lt_of_succ_lt_succ h
    have ih :=
      arrSc_getElem?_buildWriteArrayArms valScr elemBase nextBb rem (idx + 1) (armBb + 1) k hk
    have hEq : elemBase + (idx + 1 + k) = elemBase + (idx + (k + 1)) := by
      rw [Nat.add_assoc idx 1 k, Nat.add_comm 1 k]
    rw [hEq] at ih
    exact ih

private theorem arrSc_bitVec_ofNat_128_beq_eq {a b : Nat}
    (ha : a < Nat.pow 2 128) (hb : b < Nat.pow 2 128)
    (h : (BitVec.ofNat 128 a == BitVec.ofNat 128 b) = true) : a = b := by
  have hBv := bitVec_beq_eq _ _ h
  have hTo : (BitVec.ofNat 128 a).toNat = (BitVec.ofNat 128 b).toNat :=
    congrArg BitVec.toNat hBv
  rw [bitVec_ofNat_toNat_of_lt ha, bitVec_ofNat_toNat_of_lt hb] at hTo
  exact hTo

private theorem arrSc_evalSwitchBranches_armBranches (trapBb : BasicBlockId) (discrIdx : Nat)
    (hDiscr : discrIdx < maxUsize) :
    ∀ (rem idxStart armStart : Nat),
      idxStart + rem ≤ maxUsize →
      evalSwitchBranches .isize (BitVec.ofNat 128 discrIdx) trapBb
          (arrSc_armBranches idxStart armStart rem) =
        .ok (if Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + rem) then
          armStart + (discrIdx - idxStart)
        else
          trapBb)
  | 0, idxStart, armStart, _ => by
    have hF : (Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + 0)) = false := by
      cases hBle : Nat.ble idxStart discrIdx with
      | false => rfl
      | true =>
        cases hBlt : Nat.blt discrIdx (idxStart + 0) with
        | false => rfl
        | true =>
          have h1 : idxStart ≤ discrIdx := nat_ble_le hBle
          have h2 : discrIdx < idxStart := by
            rw [Nat.add_zero] at hBlt
            exact nat_blt_lt hBlt
          exact False.elim (nat_lt_irrefl discrIdx (Nat.lt_of_lt_of_le h2 h1))
    rw [hF]
    rfl
  | rem + 1, idxStart, armStart, hBound => by
    have hIdxLt : idxStart < maxUsize :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hBound
    have hNextBound : (idxStart + 1) + rem ≤ maxUsize := by
      rw [Nat.add_right_comm idxStart 1 rem]
      exact hBound
    have ih := arrSc_evalSwitchBranches_armBranches trapBb discrIdx hDiscr
      rem (idxStart + 1) (armStart + 1) hNextBound
    have h128Idx : idxStart < Nat.pow 2 128 := Nat.lt_trans hIdxLt maxUsize_lt_pow128
    have h128Discr : discrIdx < Nat.pow 2 128 := Nat.lt_trans hDiscr maxUsize_lt_pow128
    have hTruncIdx : truncateBits .isize (BitVec.ofNat 128 idxStart) = BitVec.ofNat 128 idxStart :=
      truncateBits_isize_of_lt_maxUsize idxStart hIdxLt
    have hTruncDiscr : truncateBits .isize (BitVec.ofNat 128 discrIdx) = BitVec.ofNat 128 discrIdx :=
      truncateBits_isize_of_lt_maxUsize discrIdx hDiscr
    have hBneFalse :
        (truncateBits .isize (BitVec.ofNat 128 idxStart) != BitVec.ofNat 128 idxStart) = false := by
      rw [hTruncIdx]
      change (!(BitVec.ofNat 128 idxStart == BitVec.ofNat 128 idxStart)) = false
      rw [bitVec_beq_refl]
      rfl
    have hCons : arrSc_armBranches idxStart armStart (rem + 1) =
        (BitVec.ofNat 128 idxStart, armStart) ::
          arrSc_armBranches (idxStart + 1) (armStart + 1) rem := rfl
    rw [hCons]
    change (if (truncateBits .isize (BitVec.ofNat 128 idxStart) != BitVec.ofNat 128 idxStart) = true then
        .error .unsupported
      else if (truncateBits .isize (BitVec.ofNat 128 discrIdx) ==
          truncateBits .isize (BitVec.ofNat 128 idxStart)) = true then
        .ok armStart
      else
        evalSwitchBranches .isize (BitVec.ofNat 128 discrIdx) trapBb
          (arrSc_armBranches (idxStart + 1) (armStart + 1) rem)) = _
    rw [hBneFalse, hTruncDiscr, hTruncIdx]
    change (if (BitVec.ofNat 128 discrIdx == BitVec.ofNat 128 idxStart) = true then
        .ok armStart
      else
        evalSwitchBranches .isize (BitVec.ofNat 128 discrIdx) trapBb
          (arrSc_armBranches (idxStart + 1) (armStart + 1) rem)) = _
    cases s4a_arrSc_nat_eq_or_ne discrIdx idxStart with
    | inl hEq =>
      have hBeq : (BitVec.ofNat 128 discrIdx == BitVec.ofNat 128 idxStart) = true := by
        rw [hEq]
        exact bitVec_beq_refl _
      have hCond : (Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + (rem + 1))) = true := by
        rw [hEq]
        have hBle : Nat.ble idxStart idxStart = true := le_nat_ble (nat_le_refl idxStart)
        have hBlt : Nat.blt idxStart (idxStart + (rem + 1)) = true :=
          lt_nat_blt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem))
        rw [hBle, hBlt]
        rfl
      rw [hBeq, hCond, hEq, Nat.sub_self, Nat.add_zero]
      rfl
    | inr hEq =>
      have hBeq : (BitVec.ofNat 128 discrIdx == BitVec.ofNat 128 idxStart) = false := by
        cases hB : BitVec.ofNat 128 discrIdx == BitVec.ofNat 128 idxStart with
        | false => rfl
        | true =>
          exact False.elim (hEq (arrSc_bitVec_ofNat_128_beq_eq h128Discr h128Idx hB))
      rw [hBeq]
      dsimp
      rw [ih]
      have hTailCond :
          (Nat.ble (idxStart + 1) discrIdx && Nat.blt discrIdx (idxStart + 1 + rem)) =
            (Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + (rem + 1))) := by
        have hRhs : idxStart + 1 + rem = idxStart + (rem + 1) := by
          rw [Nat.add_assoc, Nat.add_comm 1 rem]
        rw [hRhs]
        cases hBle1 : Nat.ble idxStart discrIdx with
        | false =>
          have hNot : ¬ idxStart ≤ discrIdx := fun h => by
            have hT := le_nat_ble h
            rw [hBle1] at hT
            cases hT
          have hBle2 : Nat.ble (idxStart + 1) discrIdx = false := by
            cases hB : Nat.ble (idxStart + 1) discrIdx with
            | false => rfl
            | true =>
              exact False.elim (hNot (Nat.le_trans (Nat.le_succ idxStart) (nat_ble_le hB)))
          rw [hBle2]
        | true =>
          have hLe : idxStart ≤ discrIdx := nat_ble_le hBle1
          have hLt : idxStart < discrIdx := Nat.lt_of_le_of_ne hLe (fun h => hEq h.symm)
          have hBle2 : Nat.ble (idxStart + 1) discrIdx = true := le_nat_ble hLt
          rw [hBle2]
      rw [hTailCond]
      cases hIn : Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + (rem + 1)) with
      | false => rfl
      | true =>
        have hAnd := (bool_and_eq_true _ _).mp hIn
        have hLe : idxStart ≤ discrIdx := nat_ble_le hAnd.1
        have hLt : idxStart < discrIdx := Nat.lt_of_le_of_ne hLe (fun h => hEq h.symm)
        have hStepEq : armStart + 1 + (discrIdx - (idxStart + 1)) =
            armStart + (discrIdx - idxStart) := by
          have hSub : discrIdx - idxStart = 1 + (discrIdx - (idxStart + 1)) := by
            have hPlus : idxStart + (discrIdx - idxStart) = discrIdx :=
              Nat.add_sub_of_le hLe
            have hPlus2 : idxStart + 1 + (discrIdx - (idxStart + 1)) = discrIdx :=
              Nat.add_sub_of_le hLt
            have hBoth : idxStart + (1 + (discrIdx - (idxStart + 1))) =
                idxStart + (discrIdx - idxStart) := by
              rw [← Nat.add_assoc, hPlus2, hPlus]
            exact (Nat.add_left_cancel hBoth).symm
          rw [hSub, Nat.add_assoc]
        dsimp
        rw [hStepEq]

-- ============================================================================
-- Section 2: `ArrScalarizePack`, Unpacking, & `bodyTgt.locals` Layout
-- ============================================================================

/-- Unpacked witness of a successful `applyArrayScalarize plan pSrc = some pTgt`. -/
private structure ArrScalarizePack (plan : ArrayScalarizePlan)
    (pSrc pTgt : ArrSliceProgram) : Type where
  bodySrc : ArrSliceBody
  elemTy : MirTy
  len : Nat
  localsTombstoned : List ArrSliceLocalDecl
  bodyTgt : ArrSliceBody
  bodiesTgt : List ArrSliceBody
  hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId = some bodySrc
  hNonEmpty : bodySrc.basicBlocks.isEmpty = false
  hArgLt : bodySrc.argumentCount < plan.arrLocal
  hLocLt : plan.arrLocal < bodySrc.locals.length
  hStorage : arrSliceStorageAnnotationsInBounds bodySrc = true
  hLocInBounds : arrSliceBodyLocalsInBounds bodySrc = true
  hTgtInBounds : arrSliceBodyTargetsInBounds bodySrc = true
  hArrDecl : Trusted.MirSemantics.getElem? bodySrc.locals plan.arrLocal =
    some (.array elemTy len)
  hElemSupp : isSupportedScalarOrUnitTy elemTy = true
  hLenLe : len ≤ 64
  hNoSlice : bodySrc.locals.any (fun d => match d with | .sliceView _ => true | _ => false) = false
  hChecks : bodySrc.basicBlocks.all (fun bb =>
    bb.statements.all (checkStmtForArray bodySrc.locals plan.arrLocal elemTy len) &&
      checkTermForArray bodySrc.locals plan.arrLocal elemTy bb.terminator) = true
  hTomb : setElem? bodySrc.locals plan.arrLocal (.base .unit) = some localsTombstoned
  hBodyTgt : bodyTgt = {
    bodySrc with
    locals :=
      localsTombstoned ++ [.base .unit] ++ listReplicate len (.base elemTy) ++
        ([.base usizeTy, .base usizeTy, .base .bool, .base elemTy] ++
          listReplicate len (.base elemTy))
    basicBlocks :=
      let lowered :=
        lowerBlocksForArrayLoop plan.arrLocal bodySrc.locals.length len
          bodySrc.basicBlocks.length bodySrc.basicBlocks
      lowered.1 ++ lowered.2
  }
  hBodiesTgt : setElem? pSrc.bodies plan.defId bodyTgt = some bodiesTgt
  hPTgt : pTgt = { pSrc with bodies := bodiesTgt }

private noncomputable def arrSc_applyArrayScalarize_unpack
    (plan : ArrayScalarizePlan) (pSrc pTgt : ArrSliceProgram)
    (hApp : applyArrayScalarize plan pSrc = some pTgt) :
    ArrScalarizePack plan pSrc pTgt := by
  unfold applyArrayScalarize at hApp
  cases hB : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none =>
    rw [hB] at hApp
    cases hApp
  | some body =>
    rw [hB] at hApp
    dsimp at hApp
    cases hEmpty : body.basicBlocks.isEmpty with
    | true =>
      rw [hEmpty] at hApp
      cases hApp
    | false =>
      cases hArg : Nat.blt body.argumentCount plan.arrLocal with
      | false =>
        rw [hEmpty, hArg] at hApp
        cases hApp
      | true =>
        cases hLoc : Nat.blt plan.arrLocal body.locals.length with
        | false =>
          rw [hEmpty, hArg, hLoc] at hApp
          cases hApp
        | true =>
          cases hSt : arrSliceStorageAnnotationsInBounds body with
          | false =>
            rw [hEmpty, hArg, hLoc, hSt] at hApp
            cases hApp
          | true =>
            cases hLIB : arrSliceBodyLocalsInBounds body with
            | false =>
              rw [hEmpty, hArg, hLoc, hSt, hLIB] at hApp
              cases hApp
            | true =>
              cases hTIB : arrSliceBodyTargetsInBounds body with
              | false =>
                rw [hEmpty, hArg, hLoc, hSt, hLIB, hTIB] at hApp
                cases hApp
              | true =>
                rw [hEmpty, hArg, hLoc, hSt, hLIB, hTIB] at hApp
                dsimp at hApp
                cases hDecl : Trusted.MirSemantics.getElem? body.locals plan.arrLocal with
                | none =>
                  rw [hDecl] at hApp
                  cases hApp
                | some decl =>
                  rw [hDecl] at hApp
                  cases decl with
                  | base _ | sliceView _ => cases hApp
                  | array elemTy len =>
                    dsimp at hApp
                    cases hSupp : isSupportedScalarOrUnitTy elemTy with
                    | false =>
                      rw [hSupp] at hApp
                      cases hApp
                    | true =>
                      cases hLe : Nat.ble len 64 with
                      | false =>
                        rw [hSupp, hLe] at hApp
                        cases hApp
                      | true =>
                        rw [hSupp, hLe] at hApp
                        dsimp at hApp
                        let hasSv := body.locals.any
                          (fun d => match d with | .sliceView _ => true | _ => false)
                        change (if hasSv = true then none else _) = some pTgt at hApp
                        cases hNoSl : hasSv with
                        | true =>
                          rw [hNoSl] at hApp
                          cases hApp
                        | false =>
                          rw [hNoSl] at hApp
                          dsimp at hApp
                          cases hChk : body.basicBlocks.all (fun bb =>
                              bb.statements.all
                                (checkStmtForArray body.locals plan.arrLocal elemTy len) &&
                                checkTermForArray body.locals plan.arrLocal elemTy bb.terminator) with
                          | false =>
                            rw [hChk] at hApp
                            cases hApp
                          | true =>
                            rw [hChk] at hApp
                            cases hTomb : setElem? body.locals plan.arrLocal (.base .unit) with
                            | none =>
                              rw [hTomb] at hApp
                              cases hApp
                            | some localsTomb =>
                              rw [hTomb] at hApp
                              dsimp at hApp
                              let lowered := lowerBlocksForArrayLoop plan.arrLocal
                                body.locals.length len body.basicBlocks.length body.basicBlocks
                              let bodyTgt : ArrSliceBody := {
                                body with
                                locals := localsTomb ++ [.base .unit] ++
                                  listReplicate len (.base elemTy) ++
                                  ([.base usizeTy, .base usizeTy, .base .bool, .base elemTy] ++
                                    listReplicate len (.base elemTy))
                                basicBlocks := lowered.1 ++ lowered.2
                              }
                              change (match setElem? pSrc.bodies plan.defId bodyTgt with
                                | none => none
                                | some bodiesTgt =>
                                  some { pSrc with bodies := bodiesTgt }) = some pTgt at hApp
                              cases hBds : setElem? pSrc.bodies plan.defId bodyTgt with
                              | none =>
                                rw [hBds] at hApp
                                cases hApp
                              | some bodiesTgt =>
                                rw [hBds] at hApp
                                have hEqP : { pSrc with bodies := bodiesTgt } = pTgt :=
                                  Option.some.inj hApp
                                exact {
                                  bodySrc := body
                                  elemTy := elemTy
                                  len := len
                                  localsTombstoned := localsTomb
                                  bodyTgt := bodyTgt
                                  bodiesTgt := bodiesTgt
                                  hBodySrc := hB
                                  hNonEmpty := hEmpty
                                  hArgLt := nat_blt_lt hArg
                                  hLocLt := nat_blt_lt hLoc
                                  hStorage := hSt
                                  hLocInBounds := hLIB
                                  hTgtInBounds := hTIB
                                  hArrDecl := hDecl
                                  hElemSupp := hSupp
                                  hLenLe := nat_ble_le hLe
                                  hNoSlice := hNoSl
                                  hChecks := hChk
                                  hTomb := hTomb
                                  hBodyTgt := rfl
                                  hBodiesTgt := hBds
                                  hPTgt := hEqP.symm
                                }

private theorem arrSc_getElem?_pTgt_bodies_eq {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt := by
  have hBodies : pTgt.bodies = pack.bodiesTgt := congrArg ArrSliceProgram.bodies pack.hPTgt
  rw [hBodies]
  exact getElem?_setElem?_self pSrc.bodies plan.defId pack.bodyTgt pack.bodiesTgt pack.hBodiesTgt

private theorem arrSc_getElem?_pTgt_bodies_ne {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {id : DefId} (hNe : id ≠ plan.defId) :
    Trusted.MirSemantics.getElem? pTgt.bodies id =
      Trusted.MirSemantics.getElem? pSrc.bodies id := by
  have hBodies : pTgt.bodies = pack.bodiesTgt := congrArg ArrSliceProgram.bodies pack.hPTgt
  rw [hBodies]
  exact getElem?_setElem?_ne pSrc.bodies plan.defId id pack.bodyTgt pack.bodiesTgt hNe.symm pack.hBodiesTgt

private theorem arrSc_pTgt_entryDefId {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pTgt.entryDefId = pSrc.entryDefId := by
  have h := congrArg ArrSliceProgram.entryDefId pack.hPTgt
  exact h

private theorem arrSc_pTgt_pointerWidthBits {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pTgt.pointerWidthBits = pSrc.pointerWidthBits := by
  have h := congrArg ArrSliceProgram.pointerWidthBits pack.hPTgt
  exact h

private theorem arrSc_pTgt_mirProfileVersion {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pTgt.mirProfileVersion = pSrc.mirProfileVersion := by
  have h := congrArg ArrSliceProgram.mirProfileVersion pack.hPTgt
  exact h

private theorem arrSc_pTgt_bodies_length {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pTgt.bodies.length = pSrc.bodies.length := by
  have hBodies : pTgt.bodies = pack.bodiesTgt := congrArg ArrSliceProgram.bodies pack.hPTgt
  rw [hBodies]
  exact setElem?_length pSrc.bodies plan.defId pack.bodyTgt pack.bodiesTgt pack.hBodiesTgt

private theorem arrSc_localsTombstoned_length {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pack.localsTombstoned.length = pack.bodySrc.locals.length :=
  setElem?_length pack.bodySrc.locals plan.arrLocal (.base .unit) pack.localsTombstoned pack.hTomb

private theorem arrSc_scrDecls_length (elemTy : MirTy) (len : Nat) :
    ([ArrSliceLocalDecl.base usizeTy, ArrSliceLocalDecl.base usizeTy,
      ArrSliceLocalDecl.base .bool, ArrSliceLocalDecl.base elemTy] ++
      listReplicate len (ArrSliceLocalDecl.base elemTy)).length = 4 + len := by
  rw [list_append_length, list_length_replicate]
  rfl

private theorem arrSc_bodyTgt_locals_length {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    pack.bodyTgt.locals.length =
      pack.bodySrc.locals.length + 1 + pack.len + (4 + pack.len) := by
  have hLocs := congrArg ArrSliceBody.locals pack.hBodyTgt
  rw [hLocs]
  rw [list_append_length, list_append_length, list_append_length,
    arrSc_localsTombstoned_length pack, list_length_replicate,
    arrSc_scrDecls_length]
  rfl

private theorem arrSc_getElem?_bodyTgt_locals_lt {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {i : Nat} (hLt : i < pack.bodySrc.locals.length) (hNe : i ≠ plan.arrLocal) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals i =
      Trusted.MirSemantics.getElem? pack.bodySrc.locals i := by
  have hLocs := congrArg ArrSliceBody.locals pack.hBodyTgt
  rw [hLocs]
  rw [List.append_assoc, List.append_assoc]
  have hLtTomb : i < pack.localsTombstoned.length := by
    rw [arrSc_localsTombstoned_length pack]
    exact hLt
  rw [getElem?_append_left pack.localsTombstoned _ i hLtTomb]
  exact getElem?_setElem?_ne pack.bodySrc.locals plan.arrLocal i (.base .unit) pack.localsTombstoned hNe.symm pack.hTomb

private theorem arrSc_getElem?_bodyTgt_locals_arrLocal {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals plan.arrLocal =
      some (.base .unit) := by
  have hLocs := congrArg ArrSliceBody.locals pack.hBodyTgt
  rw [hLocs]
  rw [List.append_assoc, List.append_assoc]
  have hLtTomb : plan.arrLocal < pack.localsTombstoned.length := by
    rw [arrSc_localsTombstoned_length pack]
    exact pack.hLocLt
  rw [getElem?_append_left pack.localsTombstoned _ plan.arrLocal hLtTomb]
  exact getElem?_setElem?_self pack.bodySrc.locals plan.arrLocal (.base .unit) pack.localsTombstoned pack.hTomb

private theorem arrSc_getElem?_bodyTgt_locals_liveLoc {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals pack.bodySrc.locals.length =
      some (.base .unit) := by
  have hLocs := congrArg ArrSliceBody.locals pack.hBodyTgt
  rw [hLocs, List.append_assoc, List.append_assoc]
  have hL := getElem?_append_right pack.localsTombstoned
    ([ArrSliceLocalDecl.base .unit] ++
      (listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy) ++
        ([ArrSliceLocalDecl.base usizeTy, ArrSliceLocalDecl.base usizeTy,
          ArrSliceLocalDecl.base .bool, ArrSliceLocalDecl.base pack.elemTy] ++
          listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)))) 0
  rw [Nat.add_zero, arrSc_localsTombstoned_length pack] at hL
  exact hL

private theorem arrSc_getElem?_bodyTgt_locals_elem {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {j : Nat} (hj : j < pack.len) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 1 + j) =
      some (.base pack.elemTy) := by
  have hLocs := congrArg ArrSliceBody.locals pack.hBodyTgt
  rw [hLocs]
  rw [List.append_assoc]
  have hLen1 : (pack.localsTombstoned ++ [ArrSliceLocalDecl.base .unit]).length =
      pack.bodySrc.locals.length + 1 := by
    rw [list_append_length, arrSc_localsTombstoned_length pack]
    rfl
  rw [← hLen1, getElem?_append_right]
  rw [getElem?_append_left (listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)) _ j
    (by rw [list_length_replicate]; exact hj)]
  exact getElem?_replicate pack.len j (ArrSliceLocalDecl.base pack.elemTy) hj

private theorem arrSc_getElem?_bodyTgt_locals_scr {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {r : Nat} (_hr : r < 4 + pack.len) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 1 + pack.len + r) =
      Trusted.MirSemantics.getElem?
        ([ArrSliceLocalDecl.base usizeTy, .base usizeTy, .base .bool, .base pack.elemTy] ++
          listReplicate pack.len (.base pack.elemTy)) r := by
  have hLocs := congrArg ArrSliceBody.locals pack.hBodyTgt
  rw [hLocs]
  have hPrefLen :
      (pack.localsTombstoned ++ [ArrSliceLocalDecl.base .unit] ++
          listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)).length =
        pack.bodySrc.locals.length + 1 + pack.len := by
    rw [list_append_length, list_append_length, arrSc_localsTombstoned_length pack,
      list_length_replicate]
    rfl
  rw [← hPrefLen, getElem?_append_right]

private theorem arrSc_getElem?_bodyTgt_locals_faultScr {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 1 + pack.len) =
      some (.base usizeTy) := by
  have hr : 0 < 4 + pack.len := by
    rw [Nat.add_comm 4 pack.len]
    exact Nat.zero_lt_succ (pack.len + 3)
  have h := arrSc_getElem?_bodyTgt_locals_scr pack hr
  rw [Nat.add_zero] at h
  exact h

private theorem arrSc_getElem?_bodyTgt_locals_idxScr {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 1 + pack.len + 1) =
      some (.base usizeTy) := by
  have hr : 1 < 4 + pack.len := by
    rw [Nat.add_comm 4 pack.len]
    exact Nat.lt_of_lt_of_le (Nat.succ_lt_succ (Nat.zero_lt_succ 2)) (Nat.le_add_left 4 pack.len)
  exact arrSc_getElem?_bodyTgt_locals_scr pack hr

private theorem arrSc_getElem?_bodyTgt_locals_condScr {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 1 + pack.len + 2) =
      some (.base .bool) := by
  have hr : 2 < 4 + pack.len := by
    rw [Nat.add_comm 4 pack.len]
    exact Nat.lt_of_lt_of_le (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 1)))
      (Nat.le_add_left 4 pack.len)
  exact arrSc_getElem?_bodyTgt_locals_scr pack hr

private theorem arrSc_getElem?_bodyTgt_locals_valScr {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 1 + pack.len + 3) =
      some (.base pack.elemTy) := by
  have hr : 3 < 4 + pack.len := by
    rw [Nat.add_comm 4 pack.len]
    exact Nat.lt_of_lt_of_le (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 0))))
      (Nat.le_add_left 4 pack.len)
  exact arrSc_getElem?_bodyTgt_locals_scr pack hr

private theorem arrSc_getElem?_bodyTgt_locals_opScr {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {j : Nat} (hj : j < pack.len) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 1 + pack.len + 4 + j) =
      some (.base pack.elemTy) := by
  have hr : 4 + j < 4 + pack.len := by
    rw [Nat.add_comm 4 j, Nat.add_comm 4 pack.len]
    exact Nat.add_lt_add_right hj 4
  have h := arrSc_getElem?_bodyTgt_locals_scr pack hr
  have h4j : pack.bodySrc.locals.length + 1 + pack.len + 4 + j =
      pack.bodySrc.locals.length + 1 + pack.len + (4 + j) :=
    Nat.add_assoc (pack.bodySrc.locals.length + 1 + pack.len) 4 j
  rw [h4j, h]
  have hLenScr : ([ArrSliceLocalDecl.base usizeTy, .base usizeTy,
      .base .bool, .base pack.elemTy] : List ArrSliceLocalDecl).length = 4 := rfl
  rw [← hLenScr, getElem?_append_right]
  exact getElem?_replicate pack.len j (ArrSliceLocalDecl.base pack.elemTy) hj

private theorem arrSc_noSliceView_bodySrc {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {i : Nat} {d : ArrSliceLocalDecl}
    (hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals i = some d) :
    ∀ t : MirTy, d ≠ .sliceView t := by
  intro t hEq
  have hF := arrSc_list_any_iff_getElem?
    (fun d => match d with | .sliceView _ => true | _ => false) pack.bodySrc.locals
  have hTrue : pack.bodySrc.locals.any
      (fun d => match d with | .sliceView _ => true | _ => false) = true := by
    apply hF.mpr
    refine ⟨i, d, hDecl, ?_⟩
    rw [hEq]
  rw [pack.hNoSlice] at hTrue
  cases hTrue

private theorem arrSc_noSliceView_bodyTgt {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {i : Nat} {d : ArrSliceLocalDecl}
    (hDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals i = some d) :
    ∀ t : MirTy, d ≠ .sliceView t := by
  intro t hEq
  cases Nat.lt_or_ge i pack.bodySrc.locals.length with
  | inl hLt =>
    cases s4a_arrSc_nat_eq_or_ne i plan.arrLocal with
    | inl hArr =>
      rw [hArr, arrSc_getElem?_bodyTgt_locals_arrLocal pack] at hDecl
      cases Option.some.inj hDecl
      cases hEq
    | inr hArr =>
      rw [arrSc_getElem?_bodyTgt_locals_lt pack hLt hArr] at hDecl
      exact arrSc_noSliceView_bodySrc pack hDecl t hEq
  | inr hGe =>
    have hSub : i < pack.bodyTgt.locals.length :=
      getElem?_some_lt pack.bodyTgt.locals i d hDecl
    rw [arrSc_bodyTgt_locals_length pack] at hSub
    let k := i - pack.bodySrc.locals.length
    have hkEq : pack.bodySrc.locals.length + k = i := Nat.add_sub_of_le hGe
    cases hK : k with
    | zero =>
      rw [hK, Nat.add_zero] at hkEq
      rw [← hkEq, arrSc_getElem?_bodyTgt_locals_liveLoc pack] at hDecl
      cases Option.some.inj hDecl
      cases hEq
    | succ k' =>
      rw [hK] at hkEq
      cases Nat.lt_or_ge k' pack.len with
      | inl hkLen =>
        have hEq' : pack.bodySrc.locals.length + 1 + k' = i := by
          rw [Nat.add_assoc, Nat.add_comm 1 k']
          exact hkEq
        rw [← hEq', arrSc_getElem?_bodyTgt_locals_elem pack hkLen] at hDecl
        cases Option.some.inj hDecl
        cases hEq
      | inr hGeLen =>
        let r := k' - pack.len
        have hrEq : pack.len + r = k' := Nat.add_sub_of_le hGeLen
        have hrLt : r < 4 + pack.len := by
          have hSubR : pack.bodySrc.locals.length + (k' + 1) <
              pack.bodySrc.locals.length + (1 + pack.len + (4 + pack.len)) := by
            rw [hkEq, ← Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) (4 + pack.len),
              ← Nat.add_assoc pack.bodySrc.locals.length 1 pack.len]
            exact hSub
          have hkLt : k' + 1 < 1 + pack.len + (4 + pack.len) :=
            s_nat_lt_of_add_lt_add_left hSubR
          have hkLt' : k' + 1 < (pack.len + (4 + pack.len)) + 1 := by
            rw [Nat.add_comm (pack.len + (4 + pack.len)) 1, ← Nat.add_assoc 1 pack.len (4 + pack.len)]
            exact hkLt
          have hkLt2 : pack.len + r < pack.len + (4 + pack.len) := by
            rw [hrEq]
            exact Nat.lt_of_succ_lt_succ hkLt'
          exact s_nat_lt_of_add_lt_add_left hkLt2
        have hEq'' : pack.bodySrc.locals.length + 1 + pack.len + r = i := by
          rw [Nat.add_assoc pack.bodySrc.locals.length 1 pack.len,
            Nat.add_assoc pack.bodySrc.locals.length (1 + pack.len) r,
            Nat.add_assoc 1 pack.len r, hrEq, Nat.add_comm 1 k']
          exact hkEq
        rw [← hEq'', arrSc_getElem?_bodyTgt_locals_scr pack hrLt] at hDecl
        cases r with
        | zero | succ _ =>
          have hScr : ∀ (q : Nat) (x : ArrSliceLocalDecl),
              Trusted.MirSemantics.getElem?
                ([ArrSliceLocalDecl.base usizeTy, .base usizeTy, .base .bool, .base pack.elemTy] ++
                  listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)) q = some x →
              ∃ ty : MirTy, x = .base ty := by
            intro q x hq
            cases q with
            | zero => exact ⟨usizeTy, (Option.some.inj hq).symm⟩
            | succ q1 =>
              cases q1 with
              | zero => exact ⟨usizeTy, (Option.some.inj hq).symm⟩
              | succ q2 =>
                cases q2 with
                | zero => exact ⟨.bool, (Option.some.inj hq).symm⟩
                | succ q3 =>
                  cases q3 with
                  | zero => exact ⟨pack.elemTy, (Option.some.inj hq).symm⟩
                  | succ j =>
                    have hRep : Trusted.MirSemantics.getElem?
                        (listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)) j = some x := by
                      have hLen4 : ([ArrSliceLocalDecl.base usizeTy, .base usizeTy,
                          .base .bool, .base pack.elemTy] : List ArrSliceLocalDecl).length = 4 := rfl
                      have hq' : Trusted.MirSemantics.getElem?
                          ([ArrSliceLocalDecl.base usizeTy, .base usizeTy, .base .bool, .base pack.elemTy] ++
                            listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy))
                          (4 + j) = some x := by
                        rw [Nat.add_comm 4 j]
                        exact hq
                      rw [← hLen4, getElem?_append_right] at hq'
                      exact hq'
                    have hj : j < pack.len := by
                      have hj' := getElem?_some_lt
                        (listReplicate pack.len (ArrSliceLocalDecl.base pack.elemTy)) j x hRep
                      rw [list_length_replicate] at hj'
                      exact hj'
                    rw [getElem?_replicate pack.len j (ArrSliceLocalDecl.base pack.elemTy) hj] at hRep
                    exact ⟨pack.elemTy, (Option.some.inj hRep).symm⟩
          cases hScr _ d hDecl with
          | intro ty hTy =>
            rw [hTy] at hEq
            cases hEq

private theorem arrSc_bodySrc_block_checks {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bb : ArrSliceBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb) :
    bb.statements.all (checkStmtForArray pack.bodySrc.locals plan.arrLocal pack.elemTy pack.len) = true ∧
    checkTermForArray pack.bodySrc.locals plan.arrLocal pack.elemTy bb.terminator = true := by
  have hAll := (list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hChecks bbIdx bb hBb
  exact (bool_and_eq_true _ _).mp hAll

private theorem arrSc_bodySrc_stmt_check {plan : ArrayScalarizePlan}
    {pSrc pTgt : ArrSliceProgram} (pack : ArrScalarizePack plan pSrc pTgt)
    {bbIdx sIdx : Nat} {bb : ArrSliceBlock} {stmt : ArrSliceStmt}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements sIdx = some stmt) :
    checkStmtForArray pack.bodySrc.locals plan.arrLocal pack.elemTy pack.len stmt = true :=
  (list_all_iff_getElem? _ bb.statements).mp (arrSc_bodySrc_block_checks pack hBb).1 sIdx stmt hStmt

