      | _, _, _ => StepResult.fault FaultKind.unsupported) = .step s' at h
    cases hDD : Trusted.MirSemantics.getElem? body.locals dstS with
    | none => rw [hDD] at h; cases h
    | some d1 =>
      cases d1 with
      | base _ => rw [hDD] at h; cases h
      | array _ _ => rw [hDD] at h; cases h
      | sliceView dTy =>
        cases hDS : Trusted.MirSemantics.getElem? body.locals srcS with
        | none => rw [hDD, hDS] at h; cases h
        | some d2 =>
          cases d2 with
          | base _ => rw [hDD, hDS] at h; cases h
          | array _ _ => rw [hDD, hDS] at h; cases h
          | sliceView sTy =>
            cases hSS : Trusted.MirSemantics.getElem? f.locals srcS with
            | none => rw [hDD, hDS, hSS] at h; cases h
            | some srcSl =>
              rw [hDD, hDS, hSS] at h; dsimp at h
              cases hCond : (!(MirTy.beq dTy sTy) || !Nat.blt fromIdx maxUsize || !Nat.blt toIdx maxUsize) with
              | true => rw [hCond] at h; cases h
              | false =>
                rw [hCond] at h; dsimp at h
                cases srcSl with
                | baseSlot _ => cases h
                | arrDead => cases h
                | liveArray _ => cases h
                | sliceDead => cases h
                | liveSlice osv =>
                  cases osv with
                  | none => cases h
                  | some sv =>
                    dsimp at h
                    cases hSub : evalSubsliceVal sv fromIdx toIdx fromEnd with
                    | error _ => rw [hSub] at h; cases h
                    | ok sv' =>
                      rw [hSub] at h; dsimp at h
                      cases hSD : Trusted.MirSemantics.getElem? f.locals dstS with
                      | none => rw [hSD] at h; cases h
                      | some dsl =>
                        cases dsl with
                        | baseSlot _ => rw [hSD] at h; cases h
                        | arrDead => rw [hSD] at h; cases h
                        | liveArray _ => rw [hSD] at h; cases h
                        | sliceDead => rw [hSD] at h; cases h
                        | liveSlice _ =>
                          rw [hSD] at h; dsimp at h
