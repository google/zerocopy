  dsimp at hBin
  have hChk : (!checkVal (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a + b)))) usizeTy) = false := by
    rw [checkVal_usize_of_lt_maxUsize (a + b) hab]; rfl
