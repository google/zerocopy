      SliceLocalMatch pack slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (pack.bodySrc.locals.length + 4 * plan.entries.length + rDst) =
        some (.baseSlot (.live (some (.scalar (ScalarVal.mk IntWidth.isize false (BitVec.ofNat 128 (a + b))))))) := by
  let dst := pack.bodySrc.locals.length + 4 * plan.entries.length + rDst
  have hrLt5 : rDst < 5 := Nat.lt_trans hrDst (by decide)
  have hNe4 : Nat.beq rDst 4 = false := by
    cases rDst with
    | zero => rfl
    | succ r1 => cases r1 with | zero => rfl | succ r2 => cases r2 with | zero => rfl | succ r3 => cases r3 with | zero => rfl | succ _ => exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hrDst)))))
  have hDstDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some (.base usizeTy) := by
    have hD := getElem?_bodyTgt_locals_scratch pack hrLt5; rw [hNe4] at hD; exact hD
  have hLhs := evalArrSlicePrimitiveOperand_copy_usize pack.bodyTgt.locals frame₂.locals src a hSrcDecl hSrcSlot
  have hBin := step_mkBinOp_usize pTgt pack.bodyTgt bbTgt frame₂ cm .addUnchecked dst
