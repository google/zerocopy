private theorem s3_stmt_step_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} {stmt : MemCopyStmt}
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmt)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  cases stmt with
  | baseStmt sk =>
    cases sk with
    | nop =>
      cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      have hBbTgt := hBlock.2.2.1
      have hGetSt := hBlock.2.2.2.1
      have hIdxNext := hBlock.2.2.2.2
      rw [hBbRel] at hBbTgt
      rw [← hIdxEq] at hGetSt hIdxNext
      have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
          (.baseStmt .nop) = [.baseStmt .nop] := rfl
      rw [hGenEq] at hGetSt hIdxNext
      have hStmtTgt := hGetSt 0 (show 0 < 1 from by decide)
      rw [Nat.add_zero] at hStmtTgt
      apply s3_sim_stmt_one ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxNext hBbTgt hStmtTgt
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep; cases hStep; exact ⟨f₁.locals, f₂.locals, mem, rfl, rfl, hWf, hRel⟩
      · intro out hDone; cases hDone
      · intro k hFault; cases hFault
    | unsupported =>
      cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      have hBbTgt := hBlock.2.2.1
      have hGetSt := hBlock.2.2.2.1
      have hIdxNext := hBlock.2.2.2.2
      rw [hBbRel] at hBbTgt
      rw [← hIdxEq] at hGetSt hIdxNext
      have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
          (.baseStmt .unsupported) = [.baseStmt .unsupported] := rfl
      rw [hGenEq] at hGetSt hIdxNext
      have hStmtTgt := hGetSt 0 (show 0 < 1 from by decide)
      rw [Nat.add_zero] at hStmtTgt
      apply s3_sim_stmt_one ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxNext hBbTgt hStmtTgt
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep; cases hStep
      · intro out hDone; cases hDone
      · intro k hFault; cases hFault; rfl
    | storageLive id =>
      exact s3c_stmt_storageLive_sim ctx id hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel
    | storageDead id =>
      exact s3c_stmt_storageDead_sim ctx id hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel
    | assign dst rval =>
      exact s3c_stmt_assign_sim ctx dst rval hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel
  | bufLivenessCheck b =>
    exact s3c_stmt_bufLivenessCheck_sim ctx b hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel
  | mkNullPtr d =>
    exact s3c_stmt_mkNullPtr_sim ctx d hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel
  | mkDanglingPtr d al =>
    exact s3c_stmt_mkDanglingPtr_sim ctx d al hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel
  | addrOfByteBuf d b =>
    exact s3c_stmt_addrOfByteBuf_sim ctx d b hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel
  | copyPtr d s isMove =>
    exact s3c_stmt_copyPtr_sim ctx d s isMove hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel
  | ptrWrappingOffset d s cntOp elemSize =>
    exact s3c_stmt_ptrWrappingOffset_sim ctx d s cntOp elemSize hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hRel

