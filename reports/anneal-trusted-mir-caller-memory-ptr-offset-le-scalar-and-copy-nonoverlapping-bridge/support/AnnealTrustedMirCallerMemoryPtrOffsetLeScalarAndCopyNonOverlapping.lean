/-! ## Part III Helpers: Reflexivity, Unembedding Soundness, Trace & VC Transport -/

/-! ### Structural Equality Reflexivity for `MemCopyProgram` -/

private theorem s5_bitVec_beq_refl {w : Nat} (a : BitVec w) :
    (a == a) = true := by
  cases hDec : BitVec.decEq a a with
  | isTrue _ =>
    change (@decide (a = a) (BitVec.decEq a a)) = true
    unfold decide
    rw [hDec]
  | isFalse hne =>
    exact False.elim (hne rfl)

private theorem s5_uint8_beq_refl (a : UInt8) : (a == a) = true := by
  cases hDec : UInt8.decEq a a with
  | isTrue _ =>
    change (@decide (a = a) (UInt8.decEq a a)) = true
    unfold decide
    rw [hDec]
  | isFalse hne =>
    exact False.elim (hne rfl)

private theorem s5_list_beq_uint8_refl :
    ∀ xs : List UInt8, List.beq xs xs = true
  | [] => rfl
  | x :: xs => by
    change ((x == x) && List.beq xs xs) = true
    rw [s5_uint8_beq_refl x, s5_list_beq_uint8_refl xs]
    rfl

private theorem s5_stringBeq_refl (s : String) : stringBeq s s = true := by
  unfold stringBeq
  exact s5_list_beq_uint8_refl s.toByteArray.data.toList

private theorem s5_intWidth_beq_refl (w : IntWidth) : IntWidth.beq w w = true := by
  cases w <;> rfl

private theorem s5_bool_beq_refl (b : Bool) : (b == b) = true := by
  cases b <;> rfl

private theorem s5_mutability_beq_refl (m : Mutability) :
    Mutability.beq m m = true := by
  cases m <;> rfl

private theorem s5_enumTagRepr_beq_refl (tr : EnumTagRepr) :
    EnumTagRepr.beq tr tr = true := by
  cases tr with
  | zeroSized => rfl
  | scalar w s =>
    change (IntWidth.beq w w && (s == s)) = true
    rw [s5_intWidth_beq_refl w, s5_bool_beq_refl s]
    rfl

private theorem s5_natListBeq_refl : ∀ xs : List Nat, natListBeq xs xs = true
  | [] => rfl
  | x :: xs => by
    change (Nat.beq x x && natListBeq xs xs) = true
    rw [nat_beq_refl x, s5_natListBeq_refl xs]
    rfl

private theorem s5_enumTy_beq_refl (ety : EnumTy) : EnumTy.beq ety ety = true := by
  cases ety with
  | mk id w s tr ds =>
    change (Nat.beq id id && IntWidth.beq w w && (s == s) &&
      EnumTagRepr.beq tr tr && natListBeq ds ds) = true
    rw [nat_beq_refl id, s5_intWidth_beq_refl w, s5_bool_beq_refl s,
      s5_enumTagRepr_beq_refl tr, s5_natListBeq_refl ds]
    rfl

mutual
  private theorem s5_mirTy_beq_refl : ∀ ty : MirTy, MirTy.beq ty ty = true
    | .bool => rfl
    | .int w s => by
      change (IntWidth.beq w w && (s == s)) = true
      rw [s5_intWidth_beq_refl w, s5_bool_beq_refl s]
      rfl
    | .unit => rfl
    | .never => rfl
    | .enum ety => s5_enumTy_beq_refl ety
    | .tuple fs => s5_mirTy_beqList_refl fs
    | .ref m p => by
      change (Mutability.beq m m && MirTy.beq p p) = true
      rw [s5_mutability_beq_refl m, s5_mirTy_beq_refl p]
      rfl
    | .rawPtr m p => by
      change (Mutability.beq m m && MirTy.beq p p) = true
      rw [s5_mutability_beq_refl m, s5_mirTy_beq_refl p]
      rfl
    | .unsupported => rfl

  private theorem s5_mirTy_beqList_refl :
      ∀ fs : List MirTy, MirTy.beqList fs fs = true
    | [] => rfl
    | f :: fs => by
      change (MirTy.beq f f && MirTy.beqList fs fs) = true
      rw [s5_mirTy_beq_refl f, s5_mirTy_beqList_refl fs]
      rfl
end

private theorem s5_projElemEq_refl :
    ∀ pe : ProjectionElem, projElemEq pe pe = true
  | .deref => rfl
  | .field idx ty => by
    change (Nat.beq idx idx && MirTy.beq ty ty) = true
    rw [nat_beq_refl idx, s5_mirTy_beq_refl ty]
    rfl
  | .unsupported => rfl

private theorem s5_placeEq_refl (p : Place) : placeEq p p = true := by
  unfold placeEq
  rw [nat_beq_refl p.localId, listRel_refl s5_projElemEq_refl p.projection]
  rfl

private theorem s5_constLitEq_refl : ∀ l : ConstLit, constLitEq l l = true
  | .scalar bv => s5_bitVec_beq_refl bv
  | .zeroSized => rfl

private theorem s5_constOpEq_refl (c : ConstOperand) :
    constOpEq c c = true := by
  unfold constOpEq
  rw [s5_mirTy_beq_refl c.ty, s5_constLitEq_refl c.lit]
  rfl

private theorem s5_binOpEq_refl (op : BinOp) : binOpEq op op = true := by
  cases op <;> rfl

private theorem s5_unOpEq_refl (op : UnOp) : unOpEq op op = true := by
  cases op <;> rfl

private theorem s5_operandEq_refl : ∀ op : Operand, operandEq op op = true
  | .copy p => s5_placeEq_refl p
  | .move p => s5_placeEq_refl p
  | .constant c => s5_constOpEq_refl c

private theorem s5_rvalueEq_refl : ∀ rv : Rvalue, rvalueEq rv rv = true
  | .use o => s5_operandEq_refl o
  | .binaryOp op l r => by
    change (binOpEq op op && operandEq l l && operandEq r r) = true
    rw [s5_binOpEq_refl op, s5_operandEq_refl l, s5_operandEq_refl r]
    rfl
  | .unaryOp op o => by
    change (unOpEq op op && operandEq o o) = true
    rw [s5_unOpEq_refl op, s5_operandEq_refl o]
    rfl
  | .discriminant p => s5_placeEq_refl p
  | .ref m p => by
    change (Mutability.beq m m && placeEq p p) = true
    rw [s5_mutability_beq_refl m, s5_placeEq_refl p]
    rfl
  | .addressOf m p => by
    change (Mutability.beq m m && placeEq p p) = true
    rw [s5_mutability_beq_refl m, s5_placeEq_refl p]
    rfl
  | .aggregateTuple fs => listRel_refl s5_operandEq_refl fs
  | .unsupported => rfl

private theorem s5_stmtEq_refl : ∀ st : StatementKind, stmtEq st st = true
  | .assign d r => by
    change (placeEq d d && rvalueEq r r) = true
    rw [s5_placeEq_refl d, s5_rvalueEq_refl r]
    rfl
  | .storageLive l => nat_beq_refl l
  | .storageDead l => nat_beq_refl l
  | .nop => rfl
  | .unsupported => rfl

private theorem s5_switchTargetsEq_refl (ts : SwitchTargets) :
    switchTargetsEq ts ts = true := by
  unfold switchTargetsEq
  rw [nat_beq_refl ts.otherwise]
  have hBr : listRel (fun a b => (a.1 == b.1) && Nat.beq a.2 b.2)
      ts.branches ts.branches = true := by
    refine listRel_refl (fun x => ?_) ts.branches
    rw [s5_bitVec_beq_refl x.1, nat_beq_refl x.2]
    rfl
  rw [hBr]
  rfl

private theorem s5_unwindActionEq_refl :
    ∀ u : UnwindAction, unwindActionEq u u = true
  | .continue_ => rfl
  | .unreachable => rfl
  | .terminate => rfl
  | .cleanup b => nat_beq_refl b

private theorem s5_assertKindEq_refl :
    ∀ k : AssertKind, assertKindEq k k = true
  | .overflow op => s5_binOpEq_refl op
  | .overflowNeg => rfl
  | .divByZero => rfl
  | .remByZero => rfl
  | .boundsCheck => rfl
  | .misalignedPtrDeref => rfl
  | .nullPtrDeref => rfl
  | .unsupported => rfl

private theorem s5_terminatorEq_refl :
    ∀ t : TerminatorKind, terminatorEq t t = true
  | .goto b => nat_beq_refl b
  | .switchInt d ts => by
    change (operandEq d d && switchTargetsEq ts ts) = true
    rw [s5_operandEq_refl d, s5_switchTargetsEq_refl ts]
    rfl
  | .return_ => rfl
  | .unreachable => rfl
  | .unwindResume => rfl
  | .unsupported => rfl
  | .assert c e m t u => by
    change (operandEq c c && boolEq e e && assertKindEq m m &&
      Nat.beq t t && unwindActionEq u u) = true
    rw [s5_operandEq_refl c, boolEq_refl e, s5_assertKindEq_refl m,
      nat_beq_refl t, s5_unwindActionEq_refl u]
    rfl
  | .call f a d t u => by
    change (Nat.beq f f && listRel operandEq a a && placeEq d d &&
      optNatEq t t && unwindActionEq u u) = true
    rw [nat_beq_refl f, listRel_refl s5_operandEq_refl a, s5_placeEq_refl d,
      optNatEq_refl t, s5_unwindActionEq_refl u]
    rfl

private theorem s5_leWidthEq_refl (w : LeWidth) : leWidthEq w w = true := by
  cases w <;> rfl

private theorem s5_memCopyLocalDeclEq_refl :
    ∀ d : MemCopyLocalDecl, memCopyLocalDeclEq d d = true
  | .base ty => s5_mirTy_beq_refl ty
  | .byteBuf sz al m => by
    change (Nat.beq sz sz && Nat.beq al al && Mutability.beq m m) = true
    rw [nat_beq_refl sz, nat_beq_refl al, s5_mutability_beq_refl m]
    rfl
  | .ptrLocal => rfl

private theorem s5_memCopyStmtEq_refl :
    ∀ st : MemCopyStmt, memCopyStmtEq st st = true
  | .baseStmt s => s5_stmtEq_refl s
  | .bufLivenessCheck b => nat_beq_refl b
  | .mkNullPtr d => nat_beq_refl d
  | .mkDanglingPtr d a => by
    change (Nat.beq d d && Nat.beq a a) = true
    rw [nat_beq_refl d, nat_beq_refl a]
    rfl
  | .addrOfByteBuf d b => by
    change (Nat.beq d d && Nat.beq b b) = true
    rw [nat_beq_refl d, nat_beq_refl b]
    rfl
  | .copyPtr d s m => by
    change (Nat.beq d d && Nat.beq s s && boolEq m m) = true
    rw [nat_beq_refl d, nat_beq_refl s, boolEq_refl m]
    rfl
  | .ptrWrappingOffset d s c e => by
    change (Nat.beq d d && Nat.beq s s && operandEq c c && Nat.beq e e) = true
    rw [nat_beq_refl d, nat_beq_refl s, s5_operandEq_refl c, nat_beq_refl e]
    rfl

private theorem s5_memCopyTermEq_refl :
    ∀ tm : MemCopyTerm, memCopyTermEq tm tm = true
  | .baseTerm t => s5_terminatorEq_refl t
  | .ptrOffsetInbounds d s c e n => by
    change (Nat.beq d d && Nat.beq s s && operandEq c c &&
      Nat.beq e e && Nat.beq n n) = true
    rw [nat_beq_refl d, nat_beq_refl s, s5_operandEq_refl c,
      nat_beq_refl e, nat_beq_refl n]
    rfl
  | .checkPtrPairAlign s d e a z n => by
    change (Nat.beq s s && Nat.beq d d && Nat.beq e e && Nat.beq a a &&
      boolEq z z && Nat.beq n n) = true
    rw [nat_beq_refl s, nat_beq_refl d, nat_beq_refl e, nat_beq_refl a,
      boolEq_refl z, nat_beq_refl n]
    rfl
  | .readLeUsize d p w r n => by
    change (Nat.beq d d && Nat.beq p p && leWidthEq w w &&
      boolEq r r && Nat.beq n n) = true
    rw [nat_beq_refl d, nat_beq_refl p, s5_leWidthEq_refl w,
      boolEq_refl r, nat_beq_refl n]
    rfl
  | .writeLeUsize p v w r n => by
    change (Nat.beq p p && operandEq v v && leWidthEq w w &&
      boolEq r r && Nat.beq n n) = true
    rw [nat_beq_refl p, s5_operandEq_refl v, s5_leWidthEq_refl w,
      boolEq_refl r, nat_beq_refl n]
    rfl
  | .readPtrLe8 d a r n => by
    change (Nat.beq d d && Nat.beq a a && boolEq r r && Nat.beq n n) = true
    rw [nat_beq_refl d, nat_beq_refl a, boolEq_refl r, nat_beq_refl n]
    rfl
  | .writePtrLe8 a v r n => by
    change (Nat.beq a a && Nat.beq v v && boolEq r r && Nat.beq n n) = true
    rw [nat_beq_refl a, nat_beq_refl v, boolEq_refl r, nat_beq_refl n]
    rfl
  | .copyNonOverlapping s d c e a z n => by
    change (Nat.beq s s && Nat.beq d d && operandEq c c && Nat.beq e e &&
      Nat.beq a a && boolEq z z && Nat.beq n n) = true
    rw [nat_beq_refl s, nat_beq_refl d, s5_operandEq_refl c, nat_beq_refl e,
      nat_beq_refl a, boolEq_refl z, nat_beq_refl n]
    rfl
  | .readBufRawByte td vd b o n => by
    change (Nat.beq td td && Nat.beq vd vd && Nat.beq b b &&
      operandEq o o && Nat.beq n n) = true
    rw [nat_beq_refl td, nat_beq_refl vd, nat_beq_refl b,
      s5_operandEq_refl o, nat_beq_refl n]
    rfl
  | .writeBufRawByte b o t v n => by
    change (Nat.beq b b && operandEq o o && operandEq t t &&
      operandEq v v && Nat.beq n n) = true
    rw [nat_beq_refl b, s5_operandEq_refl o, s5_operandEq_refl t,
      s5_operandEq_refl v, nat_beq_refl n]
    rfl

private theorem s5_memCopyBlockEq_refl (bb : MemCopyBlock) :
    memCopyBlockEq bb bb = true := by
  unfold memCopyBlockEq
  rw [boolEq_refl bb.cleanup, listRel_refl s5_memCopyStmtEq_refl bb.statements,
    s5_memCopyTermEq_refl bb.terminator]
  rfl

private theorem s5_memCopyBodyEq_refl (b : MemCopyBody) :
    memCopyBodyEq b b = true := by
  unfold memCopyBodyEq
  rw [nat_beq_refl b.argumentCount,
    listRel_refl s5_memCopyLocalDeclEq_refl b.locals,
    listRel_refl s5_memCopyBlockEq_refl b.basicBlocks,
    boolEq_refl b.isUnsafe, s5_stringBeq_refl b.identity,
    boolEq_refl b.acceptsCallerMem]
  rfl

private theorem s5_scopeEq_refl (s : VerificationScope) :
    scopeEq s s = true := by
  cases s <;> rfl

private theorem s5_memCopyProgramEq_refl (p : MemCopyProgram) :
    memCopyProgramEq p p = true := by
  unfold memCopyProgramEq
  rw [listRel_refl s5_memCopyBodyEq_refl p.bodies,
    nat_beq_refl p.entryDefId, nat_beq_refl p.pointerWidthBits,
    nat_beq_refl p.mirProfileVersion, s5_scopeEq_refl p.scope]
  rfl

/-! ### Unembedding Soundness & Reduction to Base `Trusted.MirAst` -/

private theorem s5_listMapOption_some_map_inv {α β : Type}
    {g : α → Option β} {f : β → α}
    (hInv : ∀ (a : α) (b : β), g a = some b → f b = a) :
    ∀ {xs : List α} {ys : List β},
      listMapOption g xs = some ys → ys.map f = xs
  | [], _, h => by cases h; rfl
  | x :: xs, ys, h => by
    cases hx : g x with
    | none =>
      change
        (match g x, listMapOption g xs with
         | some y, some zs => some (y :: zs)
         | _, _ => none) = some ys at h
      rw [hx] at h
      cases h
    | some y =>
      cases hxs : listMapOption g xs with
      | none =>
        change
          (match g x, listMapOption g xs with
           | some w, some zs => some (w :: zs)
           | _, _ => none) = some ys at h
        rw [hx, hxs] at h
        cases h
      | some zs =>
        change
          (match g x, listMapOption g xs with
           | some w, some ws => some (w :: ws)
           | _, _ => none) = some ys at h
        rw [hx, hxs] at h
        cases h
        change f y :: List.map f zs = x :: xs
        rw [hInv x y hx, s5_listMapOption_some_map_inv hInv hxs]

private theorem s5_unembedBaseLocal_some_eq (d : MemCopyLocalDecl) (ty : MirTy)
    (h : (match d with | .base t => some t | _ => none) = some ty) :
    MemCopyLocalDecl.base ty = d := by
  cases d with
  | base ty' => cases h; rfl
  | byteBuf _ _ _ | ptrLocal => cases h

private theorem s5_unembedBaseStmt_some_eq (stM : MemCopyStmt)
    (st : StatementKind)
    (h : (match stM with | .baseStmt s => some s | _ => none) = some st) :
    MemCopyStmt.baseStmt st = stM := by
  cases stM with
  | baseStmt st' => cases h; rfl
  | bufLivenessCheck _ | mkNullPtr _ | mkDanglingPtr _ _ | addrOfByteBuf _ _
  | copyPtr _ _ _ | ptrWrappingOffset _ _ _ _ => cases h

private theorem s5_unembedBaseTerm_some_eq (tM : MemCopyTerm)
    (t : TerminatorKind)
    (h : (match tM with | .baseTerm tk => some tk | _ => none) = some t) :
    MemCopyTerm.baseTerm t = tM := by
  cases tM with
  | baseTerm t' => cases h; rfl
  | ptrOffsetInbounds _ _ _ _ _ | checkPtrPairAlign _ _ _ _ _ _
  | readLeUsize _ _ _ _ _ | writeLeUsize _ _ _ _ _
  | readPtrLe8 _ _ _ _ | writePtrLe8 _ _ _ _
  | copyNonOverlapping _ _ _ _ _ _ _ | readBufRawByte _ _ _ _ _
  | writeBufRawByte _ _ _ _ _ => cases h

private theorem s5_match_block {oa : Option (List StatementKind)}
    {tm : MemCopyTerm} {cleanup : Bool} {bb : BasicBlock}
    (h : (match oa, tm with
      | some stmts, .baseTerm t =>
        some { statements := stmts, terminator := t, cleanup := cleanup }
      | _, _ => none) = some bb) :
    ∃ (stmts : List StatementKind) (t : TerminatorKind),
      oa = some stmts ∧ tm = .baseTerm t ∧
        bb = { statements := stmts, terminator := t, cleanup := cleanup } := by
  cases oa with
  | none => cases h
  | some stmts =>
    cases tm with
    | baseTerm t =>
      cases h
      exact ⟨stmts, t, rfl, rfl, rfl⟩
    | ptrOffsetInbounds _ _ _ _ _ | checkPtrPairAlign _ _ _ _ _ _
    | readLeUsize _ _ _ _ _ | writeLeUsize _ _ _ _ _
    | readPtrLe8 _ _ _ _ | writePtrLe8 _ _ _ _
    | copyNonOverlapping _ _ _ _ _ _ _ | readBufRawByte _ _ _ _ _
    | writeBufRawByte _ _ _ _ _ =>
      cases h

private theorem s5_match_body {oa : Option (List MirTy)}
    {ob : Option (List BasicBlock)} {ac : Nat} {iu : Bool} {ident : String}
    {r : Body}
    (h : (match oa, ob with
      | some tys, some bbs =>
        some ({ argumentCount := ac, locals := tys, basicBlocks := bbs,
                isUnsafe := iu, identity := ident })
      | _, _ => none) = some r) :
    ∃ (tys : List MirTy) (bbs : List BasicBlock),
      oa = some tys ∧ ob = some bbs ∧
        { argumentCount := ac, locals := tys, basicBlocks := bbs,
          isUnsafe := iu, identity := ident } = r := by
  cases oa with
  | none => cases h
  | some tys =>
    cases ob with
    | none => cases h
    | some bbs =>
      cases h
      exact ⟨tys, bbs, rfl, rfl, rfl⟩

private theorem s5_unembedBaseBlock_some_embed (bbM : MemCopyBlock)
    (bb : BasicBlock) (h : unembedBaseBlock bbM = some bb) :
    embedBaseBlock bb = bbM := by
  unfold unembedBaseBlock at h
  dsimp at h
  cases s5_match_block h with
  | intro stmts h1 =>
    cases h1 with
    | intro tm h2 =>
      have hStEq := s5_listMapOption_some_map_inv s5_unembedBaseStmt_some_eq h2.1
      rw [h2.2.2]
      dsimp [embedBaseBlock]
      cases bbM
      dsimp at hStEq h2
      rw [hStEq, h2.2.1]

private theorem s5_unembedBaseBody_some_embed (bM : MemCopyBody) (b : Body)
    (h : unembedBaseBody bM = some b) :
    embedBaseBody b = bM := by
  unfold unembedBaseBody at h
  cases hAcc : bM.acceptsCallerMem with
  | true =>
    rw [hAcc] at h
    cases h
  | false =>
    rw [hAcc] at h
    dsimp at h
    cases s5_match_body h with
    | intro locs h1 =>
      cases h1 with
      | intro bbs h2 =>
        have hLocEq := s5_listMapOption_some_map_inv s5_unembedBaseLocal_some_eq h2.1
        have hBbsEq :=
          s5_listMapOption_some_map_inv s5_unembedBaseBlock_some_embed h2.2.1
        rw [← h2.2.2]
        dsimp [embedBaseBody]
        cases bM
        dsimp at hAcc hLocEq hBbsEq
        rw [hLocEq, hBbsEq, hAcc]

private theorem s5_unembedBaseProgram_some_embed (pM : MemCopyProgram) (p : Program)
    (h : unembedBaseProgram pM = some p) :
    embedBaseProgram p = pM := by
  unfold unembedBaseProgram at h
  cases hBods : listMapOption unembedBaseBody pM.bodies with
  | none => rw [hBods] at h; cases h
  | some bods =>
    rw [hBods] at h
    dsimp at h
    cases h
    dsimp [embedBaseProgram]
    have hBodsEq :=
      s5_listMapOption_some_map_inv s5_unembedBaseBody_some_embed hBods
    cases pM
    dsimp at hBodsEq
    rw [hBodsEq]

private theorem s5_listRel_map_both {α β : Type} {f : α → β}
    {rBase : α → α → Bool} {rExt : β → β → Bool}
    (hElem : ∀ a₁ a₂ : α, rExt (f a₁) (f a₂) = rBase a₁ a₂) :
    ∀ xs ys : List α,
      listRel rExt (xs.map f) (ys.map f) = listRel rBase xs ys
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by
    change (rExt (f x) (f y) && listRel rExt (xs.map f) (ys.map f)) =
      (rBase x y && listRel rBase xs ys)
    rw [hElem x y, s5_listRel_map_both hElem xs ys]

private theorem s5_listRel_mirTy_map :
    ∀ xs ys : List MirTy,
      listRel memCopyLocalDeclEq (xs.map MemCopyLocalDecl.base)
        (ys.map MemCopyLocalDecl.base) = MirTy.beqList xs ys
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by
    change (MirTy.beq x y &&
      listRel memCopyLocalDeclEq (xs.map MemCopyLocalDecl.base)
        (ys.map MemCopyLocalDecl.base)) =
      (MirTy.beq x y && MirTy.beqList xs ys)
    rw [s5_listRel_mirTy_map xs ys]

private theorem s5_memCopyBlockEq_embedBase (bb₁ bb₂ : BasicBlock) :
    memCopyBlockEq (embedBaseBlock bb₁) (embedBaseBlock bb₂) =
      basicBlockEq bb₁ bb₂ := by
  unfold memCopyBlockEq basicBlockEq embedBaseBlock
  dsimp
  have hStmts := s5_listRel_map_both (f := MemCopyStmt.baseStmt)
    (rBase := stmtEq) (rExt := memCopyStmtEq) (fun _ _ => rfl)
    bb₁.statements bb₂.statements
  rw [hStmts]
  rfl

private theorem s5_memCopyBodyEq_embedBase (b₁ b₂ : Body) :
    memCopyBodyEq (embedBaseBody b₁) (embedBaseBody b₂) = bodyEq b₁ b₂ := by
  unfold memCopyBodyEq bodyEq embedBaseBody
  dsimp
  rw [s5_listRel_mirTy_map b₁.locals b₂.locals,
    s5_listRel_map_both s5_memCopyBlockEq_embedBase b₁.basicBlocks b₂.basicBlocks]
  cases (Nat.beq b₁.argumentCount b₂.argumentCount &&
    MirTy.beqList b₁.locals b₂.locals &&
    listRel basicBlockEq b₁.basicBlocks b₂.basicBlocks &&
    boolEq b₁.isUnsafe b₂.isUnsafe &&
    stringBeq b₁.identity b₂.identity) <;> rfl

private theorem s5_memCopyProgramEq_embedBase (p₁ p₂ : Program) :
    memCopyProgramEq (embedBaseProgram p₁) (embedBaseProgram p₂) =
      programEq p₁ p₂ := by
  unfold memCopyProgramEq programEq embedBaseProgram
  dsimp
  rw [s5_listRel_map_both s5_memCopyBodyEq_embedBase p₁.bodies p₂.bodies]

private theorem s5_unembedBaseProgram_sound
    (pFlat : MemCopyProgram) (pOut pMir : Program)
    (hUn : unembedBaseProgram pFlat = some pOut)
    (hEq : programEq pOut pMir = true) :
    (∀ q : Query, WellFormedMemCopy pFlat q ↔ WellFormed pMir q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorMemCopy pFlat q out ↔ Behavior pMir q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultMemCopy pFlat q (.fault k) ↔
        ReachesResult pMir q (.fault k)) ∧
    (∀ q : Query, DivergesMemCopy pFlat q ↔ Diverges pMir q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostMemCopy pFlat q post ↔ SatisfiesPost pMir q post) := by
  have hEmbed : embedBaseProgram pOut = pFlat :=
    s5_unembedBaseProgram_some_embed pFlat pOut hUn
  have hMcEq :
      memCopyProgramEq (embedBaseProgram pOut) (embedBaseProgram pMir) = true := by
    rw [s5_memCopyProgramEq_embedBase]
    exact hEq
  have hSem : FullSemanticEquivMemCopy pFlat (embedBaseProgram pMir) := by
    rw [← hEmbed]
    exact memCopyProgramEq_semEquiv hMcEq
  have hCons := (memcopy_conservative_extension_exact_slice1 pMir).2
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro q
    exact Iff.trans (hSem.1 q) (hCons q).1
  · intro q out
    exact Iff.trans (hSem.2.1 q out) ((hCons q).2.1 out)
  · intro q k
    exact Iff.trans (hSem.2.2.1 q k) ((hCons q).2.2.1 k)
  · intro q
    exact Iff.trans (hSem.2.2.2.1 q) (hCons q).2.2.2.1
  · intro q post
    exact Iff.trans (hSem.2.2.2.2 q post) ((hCons q).2.2.2.2 post)

/-! ### Parameterized Pipeline Composition & VC Transport Helpers -/

private theorem s5_applyMemCopyOptStep_sound_of_ptrScalarize
    (hPtr : ∀ (plan : PtrScalarizePlan) (p₁ p₂ : MemCopyProgram),
      applyPtrScalarize plan p₁ = some p₂ → FullSemanticEquivMemCopy p₁ p₂)
    (step : MemCopyOptStep) (pSrc pTgt : MemCopyProgram)
    (hApp : applyMemCopyOptStep step pSrc = some pTgt) :
    FullSemanticEquivMemCopy pSrc pTgt := by
  cases step with
  | foldZeroOffsetStmt bodyId bbIdx stmtIdx =>
    apply foldZeroOffset_and_guardedZeroCopy_sound_bidirectional_iff_slice2.1
      bodyId bbIdx stmtIdx pSrc pTgt
    unfold checkFoldZeroOffsetStmt
    change applyFoldZeroOffsetStmt bodyId bbIdx stmtIdx pSrc = some pTgt at hApp
    rw [hApp]
    exact s5_memCopyProgramEq_refl pTgt
  | foldZeroOffsetTerm bodyId bbIdx =>
    apply foldZeroOffset_and_guardedZeroCopy_sound_bidirectional_iff_slice2.2.1
      bodyId bbIdx pSrc pTgt
    unfold checkFoldZeroOffsetTerm
    change applyFoldZeroOffsetTerm bodyId bbIdx pSrc = some pTgt at hApp
    rw [hApp]
    exact s5_memCopyProgramEq_refl pTgt
  | foldGuardedZeroCopy bodyId bbIdx =>
    apply foldZeroOffset_and_guardedZeroCopy_sound_bidirectional_iff_slice2.2.2
      bodyId bbIdx pSrc pTgt
    unfold checkFoldGuardedZeroCopy
    change applyFoldGuardedZeroCopy bodyId bbIdx pSrc = some pTgt at hApp
    rw [hApp]
    exact s5_memCopyProgramEq_refl pTgt
  | ptrScalarize plan =>
    exact hPtr plan pSrc pTgt hApp
  | bufScalarize plan =>
    exact applyBufScalarize_sound plan pSrc pTgt hApp

private theorem s5_applyMemCopyOptTrace_sound_of_ptrScalarize
    (hPtr : ∀ (plan : PtrScalarizePlan) (p₁ p₂ : MemCopyProgram),
      applyPtrScalarize plan p₁ = some p₂ → FullSemanticEquivMemCopy p₁ p₂) :
    ∀ (trace : MemCopyOptTrace) (pSrc pTgt : MemCopyProgram),
      applyMemCopyOptTrace trace pSrc = some pTgt →
      FullSemanticEquivMemCopy pSrc pTgt
  | [], pSrc, pTgt, hApp => by
    cases hApp
    exact fullSemanticEquivMemCopy_refl pSrc
  | step :: rest, pSrc, pTgt, hApp => by
    unfold applyMemCopyOptTrace at hApp
    cases hStep : applyMemCopyOptStep step pSrc with
    | none => rw [hStep] at hApp; cases hApp
    | some pMid =>
      rw [hStep] at hApp
      dsimp at hApp
      exact fullSemanticEquivMemCopy_trans
        (s5_applyMemCopyOptStep_sound_of_ptrScalarize hPtr step pSrc pMid hStep)
        (s5_applyMemCopyOptTrace_sound_of_ptrScalarize hPtr rest pMid pTgt hApp)

private theorem s5_memAllocScalarize_reduces_of_ptrScalarize
    (hPtr : ∀ (plan : PtrScalarizePlan) (p₁ p₂ : MemCopyProgram),
      applyPtrScalarize plan p₁ = some p₂ → FullSemanticEquivMemCopy p₁ p₂)
    (trace : MemCopyOptTrace) (pSrc : MemCopyProgram) (pMir : Program)
    (hLower : checkMemCopyToTrustedMir trace pSrc pMir = true) :
    (∀ q : Query, WellFormedMemCopy pSrc q ↔ WellFormed pMir q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorMemCopy pSrc q out ↔ Behavior pMir q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultMemCopy pSrc q (.fault k) ↔
        ReachesResult pMir q (.fault k)) ∧
    (∀ q : Query, DivergesMemCopy pSrc q ↔ Diverges pMir q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostMemCopy pSrc q post ↔ SatisfiesPost pMir q post) := by
  unfold checkMemCopyToTrustedMir at hLower
  cases hTr : applyMemCopyOptTrace trace pSrc with
  | none => rw [hTr] at hLower; cases hLower
  | some pFlat =>
    rw [hTr] at hLower
    dsimp at hLower
    cases hUn : unembedBaseProgram pFlat with
    | none => rw [hUn] at hLower; cases hLower
    | some pOut =>
      rw [hUn] at hLower
      dsimp at hLower
      have hTraceEquiv : FullSemanticEquivMemCopy pSrc pFlat :=
        s5_applyMemCopyOptTrace_sound_of_ptrScalarize hPtr trace pSrc pFlat hTr
      have hBaseEquiv := s5_unembedBaseProgram_sound pFlat pOut pMir hUn hLower
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · intro q
        exact Iff.trans (hTraceEquiv.1 q) (hBaseEquiv.1 q)
      · intro q out
        exact Iff.trans (hTraceEquiv.2.1 q out) (hBaseEquiv.2.1 q out)
      · intro q k
        exact Iff.trans (hTraceEquiv.2.2.1 q k) (hBaseEquiv.2.2.1 q k)
      · intro q
        exact Iff.trans (hTraceEquiv.2.2.2.1 q) (hBaseEquiv.2.2.2.1 q)
      · intro q post
        exact Iff.trans (hTraceEquiv.2.2.2.2 q post) (hBaseEquiv.2.2.2.2 q post)

private theorem s5_vc_transport_of_reduces
    (pSrc : MemCopyProgram) (pMir pOpt : Program)
    (hRed :
      (∀ q : Query, WellFormedMemCopy pSrc q ↔ WellFormed pMir q) ∧
      (∀ q : Query, ∀ out : TerminalOut,
        BehaviorMemCopy pSrc q out ↔ Behavior pMir q out) ∧
      (∀ q : Query, ∀ k : FaultKind,
        ReachesResultMemCopy pSrc q (.fault k) ↔
          ReachesResult pMir q (.fault k)) ∧
      (∀ q : Query, DivergesMemCopy pSrc q ↔ Diverges pMir q) ∧
      (∀ q : Query, ∀ post : TerminalOut → Prop,
        SatisfiesPostMemCopy pSrc q post ↔ SatisfiesPost pMir q post))
    (hOpt : FullSemanticEquivBase pMir pOpt) :
    (∀ q : Query, WellFormedMemCopy pSrc q ↔ WellFormed pOpt q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorMemCopy pSrc q out ↔ Behavior pOpt q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultMemCopy pSrc q (.fault k) ↔
        ReachesResult pOpt q (.fault k)) ∧
    (∀ q : Query, DivergesMemCopy pSrc q ↔ Diverges pOpt q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostMemCopy pSrc q post ↔ SatisfiesPost pOpt q post) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro q
    exact Iff.trans (hRed.1 q) (hOpt.1 q)
  · intro q out
