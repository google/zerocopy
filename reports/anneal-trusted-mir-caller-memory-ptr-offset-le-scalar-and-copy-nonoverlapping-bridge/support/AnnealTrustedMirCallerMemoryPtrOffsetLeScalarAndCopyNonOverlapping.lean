private theorem s3b_nat_beq_false_of_ne {a b : Nat} (h : a ≠ b) : Nat.beq a b = false := by
  cases hEq : Nat.beq a b with
  | false => rfl
  | true => exact False.elim (h (nat_beq_eq _ _ hEq))

private theorem s3b_nat_eq_or_ne (a b : Nat) : a = b ∨ a ≠ b :=
  match hEq : Nat.beq a b with
  | true => Or.inl (nat_beq_eq _ _ hEq)
  | false => Or.inr (nat_beq_false_ne hEq)

private theorem s3b_getElem?_setElem?_ne {α : Type} (xs : List α) (i : Nat) (v : α)
    (xs' : List α) (j : Nat) (hne : i ≠ j) (h : setElem? xs i v = some xs') :
    Trusted.MirSemantics.getElem? xs' j = Trusted.MirSemantics.getElem? xs j :=
  s3_getElem?_setElem?_ne xs i j v xs' hne h

private theorem s3b_list_all_append {α : Type} (p : α → Bool) :
    ∀ (xs ys : List α), (xs ++ ys).all p = (xs.all p && ys.all p)
  | [], _ => rfl
  | x :: xs, ys => by
    change (p x && (xs ++ ys).all p) = (p x && xs.all p && ys.all p)
    rw [s3b_list_all_append p xs ys, Bool.and_assoc]

private theorem s3b_list_any_append {α : Type} (p : α → Bool) :
    ∀ (xs ys : List α), (xs ++ ys).any p = (xs.any p || ys.any p)
  | [], _ => rfl
  | x :: xs, ys => by
    change (p x || (xs ++ ys).any p) = (p x || xs.any p || ys.any p)
    rw [s3b_list_any_append p xs ys, Bool.or_assoc]

private theorem s3b_take_length_le_self {α : Type} :
    ∀ (xs : List α) (n : Nat), (xs.take n).length ≤ n
  | _, 0 => Nat.le_refl 0
  | [], _ + 1 => Nat.zero_le _
  | _ :: xs, n + 1 => Nat.succ_le_succ (s3b_take_length_le_self xs n)

private theorem s3b_mkStorageLiveRange_3 (start : Nat) :
    mkStorageLiveRange start 3 =
      [.baseStmt (.storageLive start), .baseStmt (.storageLive (start + 1)),
       .baseStmt (.storageLive (start + 2))] := rfl

private theorem s3b_mkStorageDeadRange_3 (start : Nat) :
    mkStorageDeadRange start 3 =
      [.baseStmt (.storageDead start), .baseStmt (.storageDead (start + 1)),
       .baseStmt (.storageDead (start + 2))] := rfl

private theorem s3_any_storageMarker_false_of_all (id : LocalId) :
    ∀ (xs : List MemCopyStmt),
      xs.all (fun s => !memCopyStmtHasStorageMarker id s) = true →
      xs.any (memCopyStmtHasStorageMarker id) = false
  | [], _ => rfl
  | s :: xs, h => by
    unfold List.all at h
    have h1 := (bool_and_eq_true _ _).mp h
    have hHead : memCopyStmtHasStorageMarker id s = false := (bool_not_eq_true _).mp h1.1
    change (memCopyStmtHasStorageMarker id s || xs.any (memCopyStmtHasStorageMarker id)) = false
    rw [hHead, s3_any_storageMarker_false_of_all id xs h1.2]
    rfl

/-! ## Section 1: Simulation Invariants & Frame/Memory Preservation -/

private noncomputable def s3_scrBase (ctx : s3_PtrCtx) : Nat :=
  ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length

private noncomputable def s3_AllocBytesTagBounded (bytes : List AllocByte) : Prop :=
  ∀ (idx : Nat) (ab : AllocByte),
    Trusted.MirSemantics.getElem? bytes idx = some ab →
      (encodeAllocByte ab).fst < maxUsize

private noncomputable def s3_BufWfEntry (slots : List MemCopySlot) (mem : CallerMemory)
    (bufLoc sz al : Nat) (mutab : Mutability) : Prop :=
  ∃ (live : Bool) (a : Allocation),
    Trusted.MirSemantics.getElem? slots bufLoc = some (.bufSlot live) ∧
    findAlloc? (internalAllocBase + bufLoc) mem.allocations = some a ∧
    a.live = live ∧
    a.alignLog2 = al ∧
    a.mutability = mutab ∧
    (live = true → a.bytes.length = sz) ∧
    s3_AllocBytesTagBounded a.bytes

private noncomputable def s3_MemWf (body : MemCopyBody) (slots : List MemCopySlot) (mem : CallerMemory) : Prop :=
  slots.length = body.locals.length ∧
  (∀ (bufLoc sz al : Nat) (mutab : Mutability),
    Trusted.MirSemantics.getElem? body.locals bufLoc = some (.byteBuf sz al mutab) →
      s3_BufWfEntry slots mem bufLoc sz al mutab) ∧
  (∀ (id : Nat) (ty : MirTy) (v : Val),
    Trusted.MirSemantics.getElem? body.locals id = some (.base ty) →
    Trusted.MirSemantics.getElem? slots id = some (.baseSlot (.live (some v))) →
      checkVal v ty = true)

private noncomputable def s3_PtrTagMatches (optBuf : Option LocalId) (pv : PtrVal) (tagVal : Nat) : Prop :=
  match optBuf with
  | none => pv.allocId = none ∧ tagVal = 0
  | some bufLoc =>
    (pv.allocId = none ∧ tagVal = 0) ∨
    (pv.allocId = some (internalAllocBase + bufLoc) ∧ tagVal = 1)

private noncomputable def s3_PtrSlotEntryRel (base k : Nat) (e : PtrBackingEntry)
    (slots₁ slots₂ : List MemCopySlot) : Prop :=
  let off := base + 3 * k
  match Trusted.MirSemantics.getElem? slots₁ e.ptrLocal with
  | some .ptrDead =>
    Trusted.MirSemantics.getElem? slots₂ off = some (.baseSlot .dead) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 1) = some (.baseSlot .dead) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 2) = some (.baseSlot .dead)
  | some (.livePtr none) =>
    (∃ ov : Option Val,
      Trusted.MirSemantics.getElem? slots₂ off = some (.baseSlot (.live ov))) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 1) = some (.baseSlot (.live none)) ∧
    Trusted.MirSemantics.getElem? slots₂ (off + 2) = some (.baseSlot (.live none))
  | some (.livePtr (some pv)) =>
    ∃ (tagVal : Nat) (ov : Option Val),
      pv.width = .isize ∧
      s3_PtrTagMatches e.backingBuf pv tagVal ∧
      Trusted.MirSemantics.getElem? slots₂ off = some (.baseSlot (.live ov)) ∧
      Trusted.MirSemantics.getElem? slots₂ (off + 1) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) ∧
      Trusted.MirSemantics.getElem? slots₂ (off + 2) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat }))))
  | _ => False

private noncomputable def s3_ScratchLive (ctx : s3_PtrCtx) (slots₂ : List MemCopySlot) : Prop :=
  ∀ (j : Nat),
    j < 12 →
    ∃ ov : Option Val,
      Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j) = some (.baseSlot (.live ov))

private noncomputable def s3_SlotsRel (ctx : s3_PtrCtx) (slots₁ slots₂ : List MemCopySlot) : Prop :=
  slots₁.length = ctx.bodySrc.locals.length ∧
  slots₂.length = ctx.bodyTgt.locals.length ∧
  (∀ (id : Nat) (ty : MirTy),
    Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty) →
      Trusted.MirSemantics.getElem? slots₂ id = Trusted.MirSemantics.getElem? slots₁ id) ∧
  (∀ (bufLoc sz al : Nat) (mutab : Mutability),
    Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc = some (.byteBuf sz al mutab) →
      Trusted.MirSemantics.getElem? slots₂ bufLoc = Trusted.MirSemantics.getElem? slots₁ bufLoc) ∧
  (∀ (k : Nat) (e : PtrBackingEntry),
    Trusted.MirSemantics.getElem? ctx.plan.entries k = some e →
      s3_PtrSlotEntryRel ctx.bodySrc.locals.length k e slots₁ slots₂) ∧
  s3_ScratchLive ctx slots₂

private noncomputable def s3_loweredStmtIdx (ctx : s3_PtrCtx) (stmts : List MemCopyStmt) (idx : Nat) : Nat :=
  (listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length)
    (stmts.take idx)).length

private noncomputable def s3_SimRel (ctx : s3_PtrCtx) (pSrc _pTgt : MemCopyProgram)
    (s₁ s₂ : MemCopyState) : Prop :=
  if Nat.beq ctx.plan.defId pSrc.entryDefId then
    ∃ (f₁ f₂ : MemCopyFrame) (mem : CallerMemory) (bb : MemCopyBlock),
      s₁ = { frames := [f₁], mem := mem } ∧
      s₂ = { frames := [f₂], mem := mem } ∧
      f₁.defId = ctx.plan.defId ∧
      f₂.defId = ctx.plan.defId ∧
      f₁.blockIdx = f₂.blockIdx ∧
      Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bb ∧
      f₁.stmtIdx ≤ bb.statements.length ∧
      f₂.stmtIdx = s3_loweredStmtIdx ctx bb.statements f₁.stmtIdx ∧
      s3_MemWf ctx.bodySrc f₁.locals mem ∧
      s3_SlotsRel ctx f₁.locals f₂.locals
  else
    s₁ = s₂ ∧ ∀ f : MemCopyFrame, s₁.frames = [f] → f.defId = pSrc.entryDefId

private theorem s3_bodyTgt_locals_length (ctx : s3_PtrCtx) :
    ctx.bodyTgt.locals.length = s3_scrBase ctx + 12 := by
  rw [ctx.hBodyTgtEq]; dsimp
  rw [List.length_append, List.length_append, s3_tombstonePtrDecls_length,
      s3_ptrCompDecls_length, s3_ptrScratchDecls_length]
  rfl

private theorem s3_scrLoc_lt_bodyTgt (ctx : s3_PtrCtx) (j : Nat) (hj : j < 12) :
    s3_scrBase ctx + j < ctx.bodyTgt.locals.length := by
  rw [s3_bodyTgt_locals_length]
  exact Nat.add_lt_add_left hj (s3_scrBase ctx)

private theorem s3_findAlloc?_update_eq :
    ∀ (allocs : List Allocation) (aid : AllocId) (newA : Allocation) (allocs' : List Allocation),
      newA.allocId = aid →
      updateAlloc? aid newA allocs = some allocs' →
      findAlloc? aid allocs' = some newA
  | [], _, _, _, _, hUp => by cases hUp
  | a :: rest, aid, newA, allocs', hAid, hUp => by
    unfold updateAlloc? at hUp
    cases hEq : Nat.beq a.allocId aid with
    | true =>
      rw [hEq] at hUp; dsimp at hUp
      cases hUp
      unfold findAlloc?
      rw [hAid, nat_beq_refl]
      rfl
    | false =>
      rw [hEq] at hUp; dsimp at hUp
      cases hRec : updateAlloc? aid newA rest with
      | none => rw [hRec] at hUp; cases hUp
      | some rest' =>
        rw [hRec] at hUp; dsimp at hUp
        cases hUp
        unfold findAlloc?
        rw [hEq]; dsimp
        exact s3_findAlloc?_update_eq rest aid newA rest' hAid hRec

private theorem s3_findAlloc?_update_ne :
    ∀ (allocs : List Allocation) (aid1 aid2 : AllocId) (newA : Allocation) (allocs' : List Allocation),
      newA.allocId = aid1 →
      aid1 ≠ aid2 →
      updateAlloc? aid1 newA allocs = some allocs' →
      findAlloc? aid2 allocs' = findAlloc? aid2 allocs
  | [], _, _, _, _, _, _, hUp => by cases hUp
  | a :: rest, aid1, aid2, newA, allocs', hAid1, hNe, hUp => by
    unfold updateAlloc? at hUp
    cases hEq1 : Nat.beq a.allocId aid1 with
    | true =>
      rw [hEq1] at hUp; dsimp at hUp
      cases hUp
      have hA1 : a.allocId = aid1 := nat_beq_eq _ _ hEq1
      have hNeA : Nat.beq a.allocId aid2 = false := s3b_nat_beq_false_of_ne (by rw [hA1]; exact hNe)
      have hNeN : Nat.beq newA.allocId aid2 = false := s3b_nat_beq_false_of_ne (by rw [hAid1]; exact hNe)
      unfold findAlloc?
      rw [hNeN, hNeA]
      rfl
    | false =>
      rw [hEq1] at hUp; dsimp at hUp
      cases hRec : updateAlloc? aid1 newA rest with
      | none => rw [hRec] at hUp; cases hUp
      | some rest' =>
        rw [hRec] at hUp; dsimp at hUp
        cases hUp
        unfold findAlloc?
        cases hEq2 : Nat.beq a.allocId aid2 with
        | true => rfl
        | false =>
          dsimp
          exact s3_findAlloc?_update_ne rest aid1 aid2 newA rest' hAid1 hNe hRec

private theorem s3_allocBytesTagBounded_replicate_uninit (n : Nat) :
    s3_AllocBytesTagBounded (listReplicate n .uninit) := by
  intro idx ab hGet
  have hLt : idx < n := by
    rw [← s3_listReplicate_length n AllocByte.uninit]
    exact s3_getElem?_some_lt _ _ _ hGet
  rw [s3_listReplicate_getElem? n idx AllocByte.uninit hLt] at hGet
  cases hGet
  exact s3_nat_pow_pos 2 (Nat.succ_pos 1) 64

private theorem s3_allocBytesTagBounded_encodeLeBytesAux_none :
    ∀ (k n idx : Nat) (ab : AllocByte),
      Trusted.MirSemantics.getElem? (encodeLeBytesAux none k n) idx = some ab →
      (encodeAllocByte ab).fst < maxUsize
  | 0, _, _, _, h => by cases h
  | k + 1, n, 0, ab, h => by
    cases h
    exact (by decide : 1 < maxUsize)
  | k + 1, n, idx + 1, ab, h => by
    change Trusted.MirSemantics.getElem? (encodeLeBytesAux none k (Nat.div n 256)) idx = some ab at h
    exact s3_allocBytesTagBounded_encodeLeBytesAux_none k (Nat.div n 256) idx ab h

private theorem s3_allocBytesTagBounded_take (bs : List AllocByte) (n : Nat)
    (h : s3_AllocBytesTagBounded bs) : s3_AllocBytesTagBounded (bs.take n) := by
  intro idx ab hGet
  cases Nat.lt_or_ge idx n with
  | inl hLt =>
    rw [s3_take_getElem? bs n idx hLt] at hGet
    exact h idx ab hGet
  | inr hGe =>
    rw [s3_getElem?_ge_none (bs.take n) idx (Nat.le_trans (s3b_take_length_le_self bs n) hGe)] at hGet
    cases hGet

private theorem s3_allocBytesTagBounded_drop (bs : List AllocByte) (n : Nat)
    (h : s3_AllocBytesTagBounded bs) : s3_AllocBytesTagBounded (bs.drop n) := by
  intro idx ab hGet
  rw [s3_drop_getElem?] at hGet
  exact h (n + idx) ab hGet

private theorem s3_allocBytesTagBounded_append (xs ys : List AllocByte)
    (hx : s3_AllocBytesTagBounded xs) (hy : s3_AllocBytesTagBounded ys) :
    s3_AllocBytesTagBounded (xs ++ ys) := by
  intro idx ab hGet
  cases Nat.lt_or_ge idx xs.length with
  | inl hLt =>
    rw [s3_getElem?_append_left xs ys idx hLt] at hGet
    exact hx idx ab hGet
  | inr hGe =>
    rw [s3_getElem?_append_right xs ys idx hGe] at hGet
    exact hy (idx - xs.length) ab hGet

private theorem s3_allocBytesTagBounded_spliceBytes (oldBytes rep : List AllocByte) (off : Nat)
    (hOld : s3_AllocBytesTagBounded oldBytes) (hRep : s3_AllocBytesTagBounded rep) :
    s3_AllocBytesTagBounded (spliceBytes oldBytes off rep) := by
  unfold spliceBytes
  exact s3_allocBytesTagBounded_append _ _
    (s3_allocBytesTagBounded_append _ _
      (s3_allocBytesTagBounded_take oldBytes off hOld) hRep)
    (s3_allocBytesTagBounded_drop oldBytes (off + rep.length) hOld)

private theorem s3_allocBytesTagBounded_decode (t v : Nat) (ht : t < maxUsize) :
    s3_AllocBytesTagBounded [decodeAllocByte t v] := by
  intro idx ab hGet
  cases idx with
  | zero =>
    cases hGet
    exact s3_encodeAllocByte_decodeAllocByte_lt t v ht
  | succ _ => cases hGet

private theorem s3_memWf_set_nonBuf (body : MemCopyBody) (slots slots' : List MemCopySlot)
    (mem : CallerMemory) (id : LocalId) (sl : MemCopySlot)
    (hWf : s3_MemWf body slots mem)
    (hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? body.locals id ≠ some (.byteBuf sz al mutab))
    (hBaseOk : ∀ (ty : MirTy) (v : Val),
      Trusted.MirSemantics.getElem? body.locals id = some (.base ty) →
      sl = .baseSlot (.live (some v)) →
      checkVal v ty = true)
    (hSet : setElem? slots id sl = some slots') :
    s3_MemWf body slots' mem := by
  refine ⟨?_, ?_, ?_⟩
  · rw [s3_setElem?_length slots id sl slots' hSet]; exact hWf.1
  · intro bufLoc sz al mutab hDecl
    have hNe : id ≠ bufLoc := by
      intro hEq; rw [hEq] at hNotBuf; exact hNotBuf sz al mutab hDecl
    cases hWf.2.1 bufLoc sz al mutab hDecl with
    | intro live hR =>
      cases hR with
      | intro a ha =>
        refine ⟨live, a, ?_, ha.2⟩
        rw [s3b_getElem?_setElem?_ne slots id sl slots' bufLoc hNe hSet]
        exact ha.1
  · intro id' ty v hDecl hSl
    cases s3b_nat_eq_or_ne id id' with
    | inl hEq =>
      rw [← hEq] at hSl hDecl
      rw [s3_getElem?_setElem?_eq slots id sl slots' hSet] at hSl
      cases hSl
      exact hBaseOk ty v hDecl rfl
    | inr hNe =>
      rw [s3b_getElem?_setElem?_ne slots id sl slots' id' hNe hSet] at hSl
      exact hWf.2.2 id' ty v hDecl hSl

private theorem s3_memWf_set_bufSlot (body : MemCopyBody) (slots slots' : List MemCopySlot)
    (mem : CallerMemory) (bufLoc : LocalId) (newLive : Bool) (allocs' : List Allocation)
    (newA : Allocation) (sz al : Nat) (mutab : Mutability)
    (hWf : s3_MemWf body slots mem)
    (hDecl : Trusted.MirSemantics.getElem? body.locals bufLoc = some (.byteBuf sz al mutab))
    (hSet : setElem? slots bufLoc (.bufSlot newLive) = some slots')
    (hAid : newA.allocId = internalAllocBase + bufLoc)
    (hUp : updateAlloc? (internalAllocBase + bufLoc) newA mem.allocations = some allocs')
    (hNew : newA.live = newLive ∧ newA.alignLog2 = al ∧ newA.mutability = mutab ∧
      (newLive = true → newA.bytes.length = sz) ∧ s3_AllocBytesTagBounded newA.bytes) :
    s3_MemWf body slots' ⟨allocs'⟩ := by
  refine ⟨?_, ?_, ?_⟩
  · rw [s3_setElem?_length slots bufLoc _ slots' hSet]; exact hWf.1
  · intro bLoc' sz' al' mutab' hDecl'
    cases s3b_nat_eq_or_ne bufLoc bLoc' with
    | inl hEq =>
      rw [← hEq] at hDecl'
      rw [hDecl] at hDecl'
      cases hDecl'
      rw [← hEq]
      refine ⟨newLive, newA, ?_, ?_, hNew⟩
      · exact s3_getElem?_setElem?_eq slots bufLoc _ slots' hSet
      · exact s3_findAlloc?_update_eq mem.allocations (internalAllocBase + bufLoc) newA allocs' hAid hUp
    | inr hNe =>
      cases hWf.2.1 bLoc' sz' al' mutab' hDecl' with
      | intro live' hR =>
        cases hR with
        | intro a' ha' =>
          refine ⟨live', a', ?_, ?_, ha'.2.2⟩
          · rw [s3b_getElem?_setElem?_ne slots bufLoc _ slots' bLoc' hNe hSet]
            exact ha'.1
          · have hAidNe : internalAllocBase + bufLoc ≠ internalAllocBase + bLoc' := by
              intro hEq
              exact hNe (Nat.add_left_cancel hEq)
            rw [s3_findAlloc?_update_ne mem.allocations (internalAllocBase + bufLoc)
                (internalAllocBase + bLoc') newA allocs' hAid hAidNe hUp]
            exact ha'.2.1
  · intro id' ty v hDecl' hSl
    have hNe : bufLoc ≠ id' := by intro hEq; rw [← hEq, hDecl] at hDecl'; cases hDecl'
    rw [s3b_getElem?_setElem?_ne slots bufLoc _ slots' id' hNe hSet] at hSl
    exact hWf.2.2 id' ty v hDecl' hSl

private theorem s3_memWf_updateAlloc_sameShape (body : MemCopyBody) (slots : List MemCopySlot)
    (mem : CallerMemory) (bufLoc : LocalId) (newA : Allocation) (allocs' : List Allocation)
    (oldA : Allocation) (sz al : Nat) (mutab : Mutability)
    (hWf : s3_MemWf body slots mem)
    (hDecl : Trusted.MirSemantics.getElem? body.locals bufLoc = some (.byteBuf sz al mutab))
    (hOld : findAlloc? (internalAllocBase + bufLoc) mem.allocations = some oldA)
    (hAid : newA.allocId = internalAllocBase + bufLoc)
    (hUp : updateAlloc? (internalAllocBase + bufLoc) newA mem.allocations = some allocs')
    (hPres : newA.live = oldA.live ∧ newA.alignLog2 = oldA.alignLog2 ∧
      newA.mutability = oldA.mutability ∧ newA.bytes.length = oldA.bytes.length ∧
      s3_AllocBytesTagBounded newA.bytes) :
    s3_MemWf body slots ⟨allocs'⟩ := by
  refine ⟨hWf.1, ?_, hWf.2.2⟩
  intro bLoc' sz' al' mutab' hDecl'
  cases s3b_nat_eq_or_ne bufLoc bLoc' with
  | inl hEq =>
    rw [← hEq]
    cases hWf.2.1 bufLoc sz al mutab hDecl with
    | intro live hR =>
      cases hR with
      | intro a ha =>
        rw [hOld] at ha
        have haEq : a = oldA := by cases ha.2.1; rfl
        rw [haEq] at ha
        rw [← hEq] at hDecl'
        rw [hDecl] at hDecl'
        cases hDecl'
        refine ⟨live, newA, ha.1, ?_, ?_, ?_, ?_, ?_, hPres.2.2.2.2⟩
        · exact s3_findAlloc?_update_eq mem.allocations (internalAllocBase + bufLoc) newA allocs' hAid hUp
        · rw [hPres.1]; exact ha.2.2.1
        · rw [hPres.2.1]; exact ha.2.2.2.1
        · rw [hPres.2.2.1]; exact ha.2.2.2.2.1
        · intro hLv; rw [hPres.2.2.2.1]; exact ha.2.2.2.2.2.1 hLv
  | inr hNe =>
    cases hWf.2.1 bLoc' sz' al' mutab' hDecl' with
    | intro live' hR =>
      cases hR with
      | intro a' ha' =>
        refine ⟨live', a', ha'.1, ?_, ha'.2.2⟩
        have hAidNe : internalAllocBase + bufLoc ≠ internalAllocBase + bLoc' := by
          intro hEq; exact hNe (Nat.add_left_cancel hEq)
        rw [s3_findAlloc?_update_ne mem.allocations (internalAllocBase + bufLoc)
            (internalAllocBase + bLoc') newA allocs' hAid hAidNe hUp]
        exact ha'.2.1

private theorem s3_ptrEntry_bounds (ctx : s3_PtrCtx) (k : Nat) (e : PtrBackingEntry)
    (hK : Trusted.MirSemantics.getElem? ctx.plan.entries k = some e) :
    ctx.bodySrc.argumentCount < e.ptrLocal ∧
    e.ptrLocal < ctx.bodySrc.locals.length ∧
    Trusted.MirSemantics.getElem? ctx.bodySrc.locals e.ptrLocal = some .ptrLocal ∧
    k < ctx.plan.entries.length := by
  have hSpec := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
    ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
  have hLen := s3_checkPtrBackingEntriesLoop_len_le ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
    ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
  have hS := hSpec.1 k e hK
  have hL := hLen k e hK
  rw [Nat.zero_add] at hL
  rw [Nat.sub_zero] at hS
  exact ⟨hS.1, hL.1, hS.2.1, s3_getElem?_some_lt _ _ _ hK⟩

private theorem s3_ptrEntry_inj (ctx : s3_PtrCtx) (k₁ k₂ : Nat) (e₁ e₂ : PtrBackingEntry)
    (h1 : Trusted.MirSemantics.getElem? ctx.plan.entries k₁ = some e₁)
    (h2 : Trusted.MirSemantics.getElem? ctx.plan.entries k₂ = some e₂)
    (hEq : e₁.ptrLocal = e₂.ptrLocal) : k₁ = k₂ := by
  have hSpec := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
    ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
  exact hSpec.2.2.2 k₁ k₂ e₁ e₂ h1 h2 hEq

private theorem s3_compOffset_bounds (ctx : s3_PtrCtx) (k r : Nat) (hk : k < ctx.plan.entries.length)
    (hr : r < 3) :
    ctx.bodySrc.locals.length ≤ ctx.bodySrc.locals.length + 3 * k + r ∧
    ctx.bodySrc.locals.length + 3 * k + r < s3_scrBase ctx := by
  constructor
  · rw [Nat.add_assoc]; exact Nat.le_add_right _ _
  · unfold s3_scrBase
    rw [Nat.add_assoc]
    have hK1 : 3 * (k + 1) ≤ 3 * ctx.plan.entries.length := Nat.mul_le_mul_left 3 hk
    rw [Nat.mul_add, Nat.mul_one] at hK1
    exact Nat.add_lt_add_left (Nat.lt_of_lt_of_le (Nat.add_lt_add_left hr _) hK1) _

private theorem s3_compOffset_inj (base k₁ k₂ r₁ r₂ : Nat) (hr₁ : r₁ < 3) (hr₂ : r₂ < 3)
    (hEq : base + 3 * k₁ + r₁ = base + 3 * k₂ + r₂) :
    k₁ = k₂ ∧ r₁ = r₂ := by
  rw [Nat.add_assoc base, Nat.add_assoc base] at hEq
  have hInner : 3 * k₁ + r₁ = 3 * k₂ + r₂ := Nat.add_left_cancel hEq
  have hQ1 : Nat.div (3 * k₁ + r₁) 3 = k₁ := by
    rw [Nat.mul_comm 3 k₁]
    exact s3_nat_div_eq_div_add_lt hr₁ (Nat.succ_pos 2)
  have hQ2 : Nat.div (3 * k₂ + r₂) 3 = k₂ := by
    rw [Nat.mul_comm 3 k₂]
    exact s3_nat_div_eq_div_add_lt hr₂ (Nat.succ_pos 2)
  have hK : k₁ = k₂ := by rw [← hQ1, ← hQ2, hInner]
  rw [hK] at hInner
  exact ⟨hK, Nat.add_left_cancel hInner⟩

private theorem s3_slotsRel_set_scratch (ctx : s3_PtrCtx) (slots₁ slots₂ slots₂' : List MemCopySlot)
    (j : Nat) (ovNew : Option Val) (_hj : j < 12)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hSet : setElem? slots₂ (s3_scrBase ctx + j) (.baseSlot (.live ovNew)) = some slots₂') :
    s3_SlotsRel ctx slots₁ slots₂' := by
  refine ⟨hRel.1, ?_, ?_, ?_, ?_, ?_⟩
  · rw [s3_setElem?_length slots₂ _ _ slots₂' hSet]; exact hRel.2.1
  · intro id ty hDecl
    have hIdLt : id < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
    have hNe : s3_scrBase ctx + j ≠ id := by
      intro hEq
      have hGe : ctx.bodySrc.locals.length ≤ s3_scrBase ctx + j :=
        Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      rw [hEq] at hGe
      exact Nat.not_lt_of_le hGe hIdLt
    rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' id hNe hSet]
    exact hRel.2.2.1 id ty hDecl
  · intro bLoc sz al mutab hDecl
    have hBLt : bLoc < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
    have hNe : s3_scrBase ctx + j ≠ bLoc := by
      intro hEq
      have hGe : ctx.bodySrc.locals.length ≤ s3_scrBase ctx + j :=
        Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      rw [hEq] at hGe
      exact Nat.not_lt_of_le hGe hBLt
    rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' bLoc hNe hSet]
    exact hRel.2.2.2.1 bLoc sz al mutab hDecl
  · intro k e hK
    have hKB := (s3_ptrEntry_bounds ctx k e hK).2.2.2
    have hNe0 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * k := by
      intro hEq
      have hLt := (s3_compOffset_bounds ctx k 0 hKB (Nat.succ_pos 2)).2
      rw [Nat.add_zero] at hLt
      rw [← hEq] at hLt
      exact Nat.not_le_of_lt hLt (Nat.le_add_right _ _)
    have hNe1 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * k + 1 := by
      intro hEq
      have hLt := (s3_compOffset_bounds ctx k 1 hKB (by decide)).2
      rw [← hEq] at hLt
      exact Nat.not_le_of_lt hLt (Nat.le_add_right _ _)
    have hNe2 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * k + 2 := by
      intro hEq
      have hLt := (s3_compOffset_bounds ctx k 2 hKB (by decide)).2
      rw [← hEq] at hLt
      exact Nat.not_le_of_lt hLt (Nat.le_add_right _ _)
    have hOrig := hRel.2.2.2.2.1 k e hK
    unfold s3_PtrSlotEntryRel
    unfold s3_PtrSlotEntryRel at hOrig
    cases hP : Trusted.MirSemantics.getElem? slots₁ e.ptrLocal with
    | none => rw [hP] at hOrig; exact False.elim hOrig
    | some sl =>
      rw [hP] at hOrig
      cases sl with
      | baseSlot _ | bufSlot _ => exact False.elim hOrig
      | ptrDead =>
        dsimp at hOrig; dsimp
        rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hSet,
            s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hSet,
            s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hSet]
        exact hOrig
      | livePtr optPv =>
        cases optPv with
        | none =>
          dsimp at hOrig; dsimp
          cases hOrig.1 with
          | intro ov hOv =>
            refine ⟨⟨ov, ?_⟩, ?_, ?_⟩
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hSet]; exact hOv
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hSet]; exact hOrig.2.1
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hSet]; exact hOrig.2.2
        | some pv =>
          dsimp at hOrig; dsimp
          cases hOrig with
          | intro tagVal hT =>
            cases hT with
            | intro ov hOv =>
              refine ⟨tagVal, ov, hOv.1, hOv.2.1, ?_, ?_, ?_⟩
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hSet]; exact hOv.2.2.1
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hSet]; exact hOv.2.2.2.1
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hSet]; exact hOv.2.2.2.2
  · intro j' hj'
    cases s3b_nat_eq_or_ne j j' with
    | inl hEq =>
      rw [← hEq]
      exact ⟨ovNew, s3_getElem?_setElem?_eq slots₂ _ _ slots₂' hSet⟩
    | inr hNe =>
      have hAidNe : s3_scrBase ctx + j ≠ s3_scrBase ctx + j' := by
        intro hEq; exact hNe (Nat.add_left_cancel hEq)
      cases hRel.2.2.2.2.2 j' hj' with
      | intro ov' hOv' =>
        refine ⟨ov', ?_⟩
        rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hAidNe hSet]
        exact hOv'

private theorem s3_slotsRel_set_base (ctx : s3_PtrCtx) (slots₁ slots₂ slots₁' slots₂' : List MemCopySlot)
    (id : LocalId) (ty : MirTy) (sl : MemCopySlot)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hS1 : setElem? slots₁ id sl = some slots₁')
    (hS2 : setElem? slots₂ id sl = some slots₂') :
    s3_SlotsRel ctx slots₁' slots₂' := by
  have hIdLt : id < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [s3_setElem?_length slots₁ _ _ slots₁' hS1]; exact hRel.1
  · rw [s3_setElem?_length slots₂ _ _ slots₂' hS2]; exact hRel.2.1
  · intro id' ty' hDecl'
    cases s3b_nat_eq_or_ne id id' with
    | inl hEq =>
      rw [← hEq, s3_getElem?_setElem?_eq slots₁ _ _ slots₁' hS1,
          s3_getElem?_setElem?_eq slots₂ _ _ slots₂' hS2]
    | inr hNe =>
      rw [s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' id' hNe hS1,
          s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' id' hNe hS2]
      exact hRel.2.2.1 id' ty' hDecl'
  · intro bLoc sz al mutab hB
    have hNe : id ≠ bLoc := by
      intro hEq; rw [hEq] at hDecl; rw [hDecl] at hB; cases hB
    rw [s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' bLoc hNe hS1,
        s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' bLoc hNe hS2]
    exact hRel.2.2.2.1 bLoc sz al mutab hB
  · intro k e hK
    have hEB := s3_ptrEntry_bounds ctx k e hK
    have hNeP : id ≠ e.ptrLocal := by
      intro hEq; rw [hEq] at hDecl; rw [hDecl] at hEB; cases hEB.2.2.1
    have hNe0 : id ≠ ctx.bodySrc.locals.length + 3 * k := by
      intro hEq
      have hGe := (s3_compOffset_bounds ctx k 0 hEB.2.2.2 (Nat.succ_pos 2)).1
      rw [Nat.add_zero, ← hEq] at hGe
      exact Nat.not_lt_of_le hGe hIdLt
    have hNe1 : id ≠ ctx.bodySrc.locals.length + 3 * k + 1 := by
      intro hEq
      have hGe := (s3_compOffset_bounds ctx k 1 hEB.2.2.2 (by decide)).1
      rw [← hEq] at hGe
      exact Nat.not_lt_of_le hGe hIdLt
    have hNe2 : id ≠ ctx.bodySrc.locals.length + 3 * k + 2 := by
      intro hEq
      have hGe := (s3_compOffset_bounds ctx k 2 hEB.2.2.2 (by decide)).1
      rw [← hEq] at hGe
      exact Nat.not_lt_of_le hGe hIdLt
    have hOrig := hRel.2.2.2.2.1 k e hK
    unfold s3_PtrSlotEntryRel
    unfold s3_PtrSlotEntryRel at hOrig
    rw [s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' e.ptrLocal hNeP hS1]
    cases hP : Trusted.MirSemantics.getElem? slots₁ e.ptrLocal with
    | none => rw [hP] at hOrig; exact False.elim hOrig
    | some slP =>
      rw [hP] at hOrig
      cases slP with
      | baseSlot _ | bufSlot _ => exact False.elim hOrig
      | ptrDead =>
        dsimp at hOrig; dsimp
        rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hS2,
            s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hS2,
            s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hS2]
        exact hOrig
      | livePtr optPv =>
        cases optPv with
        | none =>
          dsimp at hOrig; dsimp
          cases hOrig.1 with
          | intro ov hOv =>
            refine ⟨⟨ov, ?_⟩, ?_, ?_⟩
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hS2]; exact hOv
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hS2]; exact hOrig.2.1
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hS2]; exact hOrig.2.2
        | some pv =>
          dsimp at hOrig; dsimp
          cases hOrig with
          | intro tagVal hT =>
            cases hT with
            | intro ov hOv =>
              refine ⟨tagVal, ov, hOv.1, hOv.2.1, ?_, ?_, ?_⟩
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hS2]; exact hOv.2.2.1
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hS2]; exact hOv.2.2.2.1
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hS2]; exact hOv.2.2.2.2
  · intro j hj
    have hNe : id ≠ s3_scrBase ctx + j := by
      intro hEq
      have hGe : ctx.bodySrc.locals.length ≤ s3_scrBase ctx + j :=
        Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      rw [← hEq] at hGe
      exact Nat.not_lt_of_le hGe hIdLt
    cases hRel.2.2.2.2.2 j hj with
    | intro ov hOv =>
      refine ⟨ov, ?_⟩
      rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe hS2]
      exact hOv

private theorem s3_slotsRel_set_buf (ctx : s3_PtrCtx) (slots₁ slots₂ slots₁' slots₂' : List MemCopySlot)
    (bLoc sz al : Nat) (mutab : Mutability) (sl : MemCopySlot)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bLoc = some (.byteBuf sz al mutab))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hS1 : setElem? slots₁ bLoc sl = some slots₁')
    (hS2 : setElem? slots₂ bLoc sl = some slots₂') :
    s3_SlotsRel ctx slots₁' slots₂' := by
  have hBLt : bLoc < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [s3_setElem?_length slots₁ _ _ slots₁' hS1]; exact hRel.1
  · rw [s3_setElem?_length slots₂ _ _ slots₂' hS2]; exact hRel.2.1
  · intro id' ty' hDecl'
    have hNe : bLoc ≠ id' := by intro hEq; rw [← hEq, hDecl] at hDecl'; cases hDecl'
    rw [s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' id' hNe hS1,
        s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' id' hNe hS2]
    exact hRel.2.2.1 id' ty' hDecl'
  · intro bLoc' sz' al' mutab' hB'
    cases s3b_nat_eq_or_ne bLoc bLoc' with
    | inl hEq =>
      rw [← hEq, s3_getElem?_setElem?_eq slots₁ _ _ slots₁' hS1,
          s3_getElem?_setElem?_eq slots₂ _ _ slots₂' hS2]
    | inr hNe =>
      rw [s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' bLoc' hNe hS1,
          s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' bLoc' hNe hS2]
      exact hRel.2.2.2.1 bLoc' sz' al' mutab' hB'
  · intro k e hK
    have hEB := s3_ptrEntry_bounds ctx k e hK
    have hNeP : bLoc ≠ e.ptrLocal := by
      intro hEq; rw [← hEq, hDecl] at hEB; cases hEB.2.2.1
    have hNe0 : bLoc ≠ ctx.bodySrc.locals.length + 3 * k := by
      intro hEq
      have hGe := (s3_compOffset_bounds ctx k 0 hEB.2.2.2 (Nat.succ_pos 2)).1
      rw [Nat.add_zero, ← hEq] at hGe
      exact Nat.not_lt_of_le hGe hBLt
    have hNe1 : bLoc ≠ ctx.bodySrc.locals.length + 3 * k + 1 := by
      intro hEq
      have hGe := (s3_compOffset_bounds ctx k 1 hEB.2.2.2 (by decide)).1
      rw [← hEq] at hGe
      exact Nat.not_lt_of_le hGe hBLt
    have hNe2 : bLoc ≠ ctx.bodySrc.locals.length + 3 * k + 2 := by
      intro hEq
      have hGe := (s3_compOffset_bounds ctx k 2 hEB.2.2.2 (by decide)).1
      rw [← hEq] at hGe
      exact Nat.not_lt_of_le hGe hBLt
    have hOrig := hRel.2.2.2.2.1 k e hK
    unfold s3_PtrSlotEntryRel
    unfold s3_PtrSlotEntryRel at hOrig
    rw [s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' e.ptrLocal hNeP hS1]
    cases hP : Trusted.MirSemantics.getElem? slots₁ e.ptrLocal with
    | none => rw [hP] at hOrig; exact False.elim hOrig
    | some slP =>
      rw [hP] at hOrig
      cases slP with
      | baseSlot _ | bufSlot _ => exact False.elim hOrig
      | ptrDead =>
        dsimp at hOrig; dsimp
        rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hS2,
            s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hS2,
            s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hS2]
        exact hOrig
      | livePtr optPv =>
        cases optPv with
        | none =>
          dsimp at hOrig; dsimp
          cases hOrig.1 with
          | intro ov hOv =>
            refine ⟨⟨ov, ?_⟩, ?_, ?_⟩
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hS2]; exact hOv
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hS2]; exact hOrig.2.1
            · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hS2]; exact hOrig.2.2
        | some pv =>
          dsimp at hOrig; dsimp
          cases hOrig with
          | intro tagVal hT =>
            cases hT with
            | intro ov hOv =>
              refine ⟨tagVal, ov, hOv.1, hOv.2.1, ?_, ?_, ?_⟩
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe0 hS2]; exact hOv.2.2.1
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe1 hS2]; exact hOv.2.2.2.1
              · rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe2 hS2]; exact hOv.2.2.2.2
  · intro j hj
    have hNe : bLoc ≠ s3_scrBase ctx + j := by
      intro hEq
      have hGe : ctx.bodySrc.locals.length ≤ s3_scrBase ctx + j :=
        Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
      rw [← hEq] at hGe
      exact Nat.not_lt_of_le hGe hBLt
    cases hRel.2.2.2.2.2 j hj with
    | intro ov hOv =>
      refine ⟨ov, ?_⟩
      rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂' _ hNe hS2]
      exact hOv

private theorem s3_slotsRel_set_ptr (ctx : s3_PtrCtx) (slots₁ slots₂ slots₁' slots₂a slots₂b slots₂' : List MemCopySlot)
    (k : Nat) (e : PtrBackingEntry) (sl1 sl2a sl2b sl2c : MemCopySlot)
    (hK : Trusted.MirSemantics.getElem? ctx.plan.entries k = some e)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hS1 : setElem? slots₁ e.ptrLocal sl1 = some slots₁')
    (hS2a : setElem? slots₂ (ctx.bodySrc.locals.length + 3 * k) sl2a = some slots₂a)
    (hS2b : setElem? slots₂a (ctx.bodySrc.locals.length + 3 * k + 1) sl2b = some slots₂b)
    (hS2c : setElem? slots₂b (ctx.bodySrc.locals.length + 3 * k + 2) sl2c = some slots₂')
    (hRelEntry : s3_PtrSlotEntryRel ctx.bodySrc.locals.length k e slots₁' slots₂') :
    s3_SlotsRel ctx slots₁' slots₂' := by
  have hEB := s3_ptrEntry_bounds ctx k e hK
  have hL2a : slots₂a.length = ctx.bodyTgt.locals.length := by
    rw [s3_setElem?_length slots₂ _ _ slots₂a hS2a]; exact hRel.2.1
  have hL2b : slots₂b.length = ctx.bodyTgt.locals.length := by
    rw [s3_setElem?_length slots₂a _ _ slots₂b hS2b]; exact hL2a
  have hL2' : slots₂'.length = ctx.bodyTgt.locals.length := by
    rw [s3_setElem?_length slots₂b _ _ slots₂' hS2c]; exact hL2b
  have hPresNotComp : ∀ x,
      (x < ctx.bodySrc.locals.length ∨ s3_scrBase ctx ≤ x) →
      Trusted.MirSemantics.getElem? slots₂' x = Trusted.MirSemantics.getElem? slots₂ x := by
    intro x hx
    have hNe0 : ctx.bodySrc.locals.length + 3 * k ≠ x := by
      intro hEq
      have hB := s3_compOffset_bounds ctx k 0 hEB.2.2.2 (Nat.succ_pos 2)
      rw [Nat.add_zero, hEq] at hB
      cases hx with
      | inl h => exact Nat.not_lt_of_le hB.1 h
      | inr h => exact Nat.not_lt_of_le h hB.2
    have hNe1 : ctx.bodySrc.locals.length + 3 * k + 1 ≠ x := by
      intro hEq
      have hB := s3_compOffset_bounds ctx k 1 hEB.2.2.2 (by decide)
      rw [hEq] at hB
      cases hx with
      | inl h => exact Nat.not_lt_of_le hB.1 h
      | inr h => exact Nat.not_lt_of_le h hB.2
    have hNe2 : ctx.bodySrc.locals.length + 3 * k + 2 ≠ x := by
      intro hEq
      have hB := s3_compOffset_bounds ctx k 2 hEB.2.2.2 (by decide)
      rw [hEq] at hB
      cases hx with
      | inl h => exact Nat.not_lt_of_le hB.1 h
      | inr h => exact Nat.not_lt_of_le h hB.2
    rw [s3b_getElem?_setElem?_ne slots₂b _ _ slots₂' x hNe2 hS2c]
    rw [s3b_getElem?_setElem?_ne slots₂a _ _ slots₂b x hNe1 hS2b]
    rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂a x hNe0 hS2a]
  refine ⟨?_, hL2', ?_, ?_, ?_, ?_⟩
  · rw [s3_setElem?_length slots₁ _ _ slots₁' hS1]; exact hRel.1
  · intro id ty hDecl
    have hIdLt : id < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
    have hNeP : e.ptrLocal ≠ id := by
      intro hEq; rw [hEq, hDecl] at hEB; cases hEB.2.2.1
    rw [hPresNotComp id (Or.inl hIdLt),
        s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' id hNeP hS1]
    exact hRel.2.2.1 id ty hDecl
  · intro bLoc sz al mutab hB
    have hBLt : bLoc < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hB
    have hNeP : e.ptrLocal ≠ bLoc := by
      intro hEq
      rw [hEq, hB] at hEB; cases hEB.2.2.1
    rw [hPresNotComp bLoc (Or.inl hBLt),
        s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' bLoc hNeP hS1]
    exact hRel.2.2.2.1 bLoc sz al mutab hB
  · intro k' e' hK'
    cases s3b_nat_eq_or_ne k k' with
    | inl hEq =>
      rw [← hEq] at hK'
      rw [hK] at hK'
      cases hK'
      rw [← hEq]
      exact hRelEntry
    | inr hNeK =>
      have hNeP : e.ptrLocal ≠ e'.ptrLocal := by
        intro hEq
        exact hNeK (s3_ptrEntry_inj ctx k k' e e' hK hK' hEq)
      have hNeOff : ∀ r r', r < 3 → r' < 3 →
          ctx.bodySrc.locals.length + 3 * k + r ≠ ctx.bodySrc.locals.length + 3 * k' + r' := by
        intro r r' hr hr' hEq
        exact hNeK (s3_compOffset_inj ctx.bodySrc.locals.length k k' r r' hr hr' hEq).1
      have hPresComp : ∀ r', r' < 3 →
          Trusted.MirSemantics.getElem? slots₂' (ctx.bodySrc.locals.length + 3 * k' + r') =
            Trusted.MirSemantics.getElem? slots₂ (ctx.bodySrc.locals.length + 3 * k' + r') := by
        intro r' hr'
        rw [s3b_getElem?_setElem?_ne slots₂b _ _ slots₂' _ (hNeOff 2 r' (by decide) hr') hS2c]
        rw [s3b_getElem?_setElem?_ne slots₂a _ _ slots₂b _ (hNeOff 1 r' (by decide) hr') hS2b]
        rw [s3b_getElem?_setElem?_ne slots₂ _ _ slots₂a _ (hNeOff 0 r' (Nat.succ_pos 2) hr') hS2a]
      have hPresComp0 : Trusted.MirSemantics.getElem? slots₂' (ctx.bodySrc.locals.length + 3 * k') =
          Trusted.MirSemantics.getElem? slots₂ (ctx.bodySrc.locals.length + 3 * k') := by
        have h0 := hPresComp 0 (Nat.succ_pos 2)
        rw [Nat.add_zero] at h0
        exact h0
      have hOrig := hRel.2.2.2.2.1 k' e' hK'
      unfold s3_PtrSlotEntryRel
      unfold s3_PtrSlotEntryRel at hOrig
      rw [s3b_getElem?_setElem?_ne slots₁ _ _ slots₁' e'.ptrLocal hNeP hS1]
      cases hP : Trusted.MirSemantics.getElem? slots₁ e'.ptrLocal with
      | none => rw [hP] at hOrig; exact False.elim hOrig
      | some slP =>
        rw [hP] at hOrig
        cases slP with
        | baseSlot _ | bufSlot _ => exact False.elim hOrig
        | ptrDead =>
          dsimp at hOrig; dsimp
          rw [hPresComp0, hPresComp 1 (by decide), hPresComp 2 (by decide)]
          exact hOrig
        | livePtr optPv =>
          cases optPv with
          | none =>
            dsimp at hOrig; dsimp
            cases hOrig.1 with
            | intro ov hOv =>
              refine ⟨⟨ov, ?_⟩, ?_, ?_⟩
              · rw [hPresComp0]; exact hOv
              · rw [hPresComp 1 (by decide)]; exact hOrig.2.1
              · rw [hPresComp 2 (by decide)]; exact hOrig.2.2
          | some pv =>
            dsimp at hOrig; dsimp
            cases hOrig with
            | intro tagVal hT =>
              cases hT with
              | intro ov hOv =>
                refine ⟨tagVal, ov, hOv.1, hOv.2.1, ?_, ?_, ?_⟩
                · rw [hPresComp0]; exact hOv.2.2.1
                · rw [hPresComp 1 (by decide)]; exact hOv.2.2.2.1
                · rw [hPresComp 2 (by decide)]; exact hOv.2.2.2.2
  · intro j hj
    cases hRel.2.2.2.2.2 j hj with
    | intro ov hOv =>
      refine ⟨ov, ?_⟩
      rw [hPresNotComp (s3_scrBase ctx + j) (Or.inr (Nat.le_add_right _ _))]
      exact hOv

private noncomputable def s3_stmtStorageAnnotInBounds (n : Nat) : MemCopyStmt → Prop
  | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => id < n
  | _ => True

private theorem s3_storageMarker_lowerStmt_comp (ctx : s3_PtrCtx) (k r : Nat) (e : PtrBackingEntry)
    (stmt : MemCopyStmt)
    (hK : Trusted.MirSemantics.getElem? ctx.plan.entries k = some e) (hr : r < 3)
    (hAnnot : s3_stmtStorageAnnotInBounds ctx.bodySrc.locals.length stmt) :
    (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length stmt).any
      (memCopyStmtHasStorageMarker (ctx.bodySrc.locals.length + 3 * k + r)) =
      memCopyStmtHasStorageMarker e.ptrLocal stmt := by
  have hEB := s3_ptrEntry_bounds ctx k e hK
  have hGeBase : ctx.bodySrc.locals.length ≤ ctx.bodySrc.locals.length + 3 * k + r :=
    (s3_compOffset_bounds ctx k r hEB.2.2.2 hr).1
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | assign _ _ | nop | unsupported => rfl
    | storageLive p =>
      unfold lowerStmtForPtrs; dsimp
      have hpLt : p < ctx.bodySrc.locals.length := hAnnot
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none =>
        have hNotPtr := (s3_findPtrEntry_none_iff ctx p).mp hFind
        have hNe : e.ptrLocal ≠ p := fun hEq => hNotPtr (by rw [← hEq]; exact hEB.2.2.1)
        have hNeOff : ctx.bodySrc.locals.length + 3 * k + r ≠ p := fun hEq =>
          Nat.not_lt_of_le (by rw [← hEq]; exact hGeBase) hpLt
        have hLhs : ([.baseStmt (.storageLive p)]).any
            (memCopyStmtHasStorageMarker (ctx.bodySrc.locals.length + 3 * k + r)) = false := by
          unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
          rw [s3b_nat_beq_false_of_ne hNeOff.symm]; rfl
        have hRhs : memCopyStmtHasStorageMarker e.ptrLocal (.baseStmt (.storageLive p)) = false := by
          unfold memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
          exact s3b_nat_beq_false_of_ne hNe.symm
        rw [hLhs, hRhs]
      | some kp =>
        have hEx := (s3_findPtrEntry_some_iff ctx p kp.1 kp.2).mp hFind
        cases hEx with
        | intro e' he' =>
          have hRhs : memCopyStmtHasStorageMarker e.ptrLocal (.baseStmt (.storageLive p)) =
              Nat.beq k kp.1 := by
            unfold memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
            cases s3b_nat_eq_or_ne k kp.1 with
            | inl hEqK =>
              rw [hEqK, nat_beq_refl]
              rw [hEqK] at hK
              rw [hK] at he'
              cases he'.1
              rw [he'.2.1, nat_beq_refl]
            | inr hNeK =>
              have hNeP : e.ptrLocal ≠ p := fun hEq =>
                hNeK (s3_ptrEntry_inj ctx k kp.1 e e' hK he'.1 (by rw [hEq, he'.2.1]))
              rw [s3b_nat_beq_false_of_ne hNeP.symm, s3b_nat_beq_false_of_ne hNeK]
          rw [hRhs]
          cases kp with | mk kp1 kp2 =>
          dsimp at he'
          dsimp
          rw [s3b_mkStorageLiveRange_3]
          unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
          cases s3b_nat_eq_or_ne k kp1 with
          | inl hEqK =>
            rw [hEqK, nat_beq_refl]
            cases r with
            | zero => rw [Nat.add_zero, nat_beq_refl]; rfl
            | succ r1 =>
              cases r1 with
              | zero =>
                rw [Nat.zero_add, nat_beq_refl, Bool.true_or, Bool.or_true]
              | succ r2 =>
                cases r2 with
                | zero =>
                  rw [Nat.zero_add]
                  have hB2 : (ctx.bodySrc.locals.length + 3 * kp1 + 2).beq
                      (ctx.bodySrc.locals.length + 3 * kp1 + (1 + 1)) = true := by
                    change (ctx.bodySrc.locals.length + 3 * kp1 + 2).beq
                      (ctx.bodySrc.locals.length + 3 * kp1 + 2) = true
                    exact nat_beq_refl _
                  rw [hB2, Bool.true_or, Bool.or_true, Bool.or_true]
                | succ r3 =>
                  have h3 : 3 ≤ 3 + r3 := Nat.le_add_right 3 r3
                  have hr' : 3 + r3 < 3 := by rw [Nat.add_comm]; exact hr
                  exact False.elim (Nat.not_lt_of_le h3 hr')
          | inr hNeK =>
            rw [s3b_nat_beq_false_of_ne hNeK]
            have hN0 : ctx.bodySrc.locals.length + 3 * k + r ≠ ctx.bodySrc.locals.length + 3 * kp1 := fun h =>
              hNeK (s3_compOffset_inj ctx.bodySrc.locals.length k kp1 r 0 hr (Nat.succ_pos 2) (by rw [Nat.add_zero]; exact h)).1
            have hN1 : ctx.bodySrc.locals.length + 3 * k + r ≠ ctx.bodySrc.locals.length + 3 * kp1 + 1 := fun h =>
              hNeK (s3_compOffset_inj ctx.bodySrc.locals.length k kp1 r 1 hr (by decide) h).1
            have hN2 : ctx.bodySrc.locals.length + 3 * k + r ≠ ctx.bodySrc.locals.length + 3 * kp1 + 2 := fun h =>
              hNeK (s3_compOffset_inj ctx.bodySrc.locals.length k kp1 r 2 hr (by decide) h).1
            rw [s3b_nat_beq_false_of_ne hN0.symm, s3b_nat_beq_false_of_ne hN1.symm, s3b_nat_beq_false_of_ne hN2.symm]
            rfl
    | storageDead p =>
      unfold lowerStmtForPtrs; dsimp
      have hpLt : p < ctx.bodySrc.locals.length := hAnnot
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none =>
        have hNotPtr := (s3_findPtrEntry_none_iff ctx p).mp hFind
        have hNe : e.ptrLocal ≠ p := fun hEq => hNotPtr (by rw [← hEq]; exact hEB.2.2.1)
        have hNeOff : ctx.bodySrc.locals.length + 3 * k + r ≠ p := fun hEq =>
          Nat.not_lt_of_le (by rw [← hEq]; exact hGeBase) hpLt
        have hLhs : ([.baseStmt (.storageDead p)]).any
            (memCopyStmtHasStorageMarker (ctx.bodySrc.locals.length + 3 * k + r)) = false := by
          unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
          rw [s3b_nat_beq_false_of_ne hNeOff.symm]; rfl
        have hRhs : memCopyStmtHasStorageMarker e.ptrLocal (.baseStmt (.storageDead p)) = false := by
          unfold memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
          exact s3b_nat_beq_false_of_ne hNe.symm
        rw [hLhs, hRhs]
      | some kp =>
        have hEx := (s3_findPtrEntry_some_iff ctx p kp.1 kp.2).mp hFind
        cases hEx with
        | intro e' he' =>
          have hRhs : memCopyStmtHasStorageMarker e.ptrLocal (.baseStmt (.storageDead p)) =
              Nat.beq k kp.1 := by
            unfold memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
            cases s3b_nat_eq_or_ne k kp.1 with
            | inl hEqK =>
              rw [hEqK, nat_beq_refl]
              rw [hEqK] at hK
              rw [hK] at he'
              cases he'.1
              rw [he'.2.1, nat_beq_refl]
            | inr hNeK =>
              have hNeP : e.ptrLocal ≠ p := fun hEq =>
                hNeK (s3_ptrEntry_inj ctx k kp.1 e e' hK he'.1 (by rw [hEq, he'.2.1]))
              rw [s3b_nat_beq_false_of_ne hNeP.symm, s3b_nat_beq_false_of_ne hNeK]
          rw [hRhs]
          cases kp with | mk kp1 kp2 =>
          dsimp at he'
          dsimp
          rw [s3b_mkStorageDeadRange_3]
          unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
          cases s3b_nat_eq_or_ne k kp1 with
          | inl hEqK =>
            rw [hEqK, nat_beq_refl]
            cases r with
            | zero => rw [Nat.add_zero, nat_beq_refl]; rfl
            | succ r1 =>
              cases r1 with
              | zero =>
                rw [Nat.zero_add, nat_beq_refl, Bool.true_or, Bool.or_true]
              | succ r2 =>
                cases r2 with
                | zero =>
                  rw [Nat.zero_add]
                  have hB2 : (ctx.bodySrc.locals.length + 3 * kp1 + 2).beq
                      (ctx.bodySrc.locals.length + 3 * kp1 + (1 + 1)) = true := by
                    change (ctx.bodySrc.locals.length + 3 * kp1 + 2).beq
                      (ctx.bodySrc.locals.length + 3 * kp1 + 2) = true
                    exact nat_beq_refl _
                  rw [hB2, Bool.true_or, Bool.or_true, Bool.or_true]
                | succ r3 =>
                  have h3 : 3 ≤ 3 + r3 := Nat.le_add_right 3 r3
                  have hr' : 3 + r3 < 3 := by rw [Nat.add_comm]; exact hr
                  exact False.elim (Nat.not_lt_of_le h3 hr')
          | inr hNeK =>
            rw [s3b_nat_beq_false_of_ne hNeK]
            have hN0 : ctx.bodySrc.locals.length + 3 * k + r ≠ ctx.bodySrc.locals.length + 3 * kp1 := fun h =>
              hNeK (s3_compOffset_inj ctx.bodySrc.locals.length k kp1 r 0 hr (Nat.succ_pos 2) (by rw [Nat.add_zero]; exact h)).1
            have hN1 : ctx.bodySrc.locals.length + 3 * k + r ≠ ctx.bodySrc.locals.length + 3 * kp1 + 1 := fun h =>
              hNeK (s3_compOffset_inj ctx.bodySrc.locals.length k kp1 r 1 hr (by decide) h).1
            have hN2 : ctx.bodySrc.locals.length + 3 * k + r ≠ ctx.bodySrc.locals.length + 3 * kp1 + 2 := fun h =>
              hNeK (s3_compOffset_inj ctx.bodySrc.locals.length k kp1 r 2 hr (by decide) h).1
            rw [s3b_nat_beq_false_of_ne hN0.symm, s3b_nat_beq_false_of_ne hN1.symm, s3b_nat_beq_false_of_ne hN2.symm]
            rfl
  | bufLivenessCheck _ => rfl
  | mkNullPtr d =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | mkDanglingPtr d _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | addrOfByteBuf d _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | copyPtr d s _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with
    | none => rfl
    | some kd =>
      cases kd
      cases findPtrEntry ctx.plan.entries s with | none => rfl | some ks => cases ks; rfl
  | ptrWrappingOffset d s cntOp _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with
    | none => rfl
    | some kd =>
      cases kd
      cases findPtrEntry ctx.plan.entries s with
      | none => rfl
      | some ks =>
        cases ks
        cases constIsizeValue? cntOp <;> rfl

private theorem s3_storageMarker_lowerStmt_scratch (ctx : s3_PtrCtx) (j : Nat) (stmt : MemCopyStmt)
    (hAnnot : s3_stmtStorageAnnotInBounds ctx.bodySrc.locals.length stmt) :
    (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length stmt).any
      (memCopyStmtHasStorageMarker (s3_scrBase ctx + j)) = false := by
  have hGeBase : ctx.bodySrc.locals.length ≤ s3_scrBase ctx + j :=
    Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | assign _ _ | nop | unsupported => rfl
    | storageLive p =>
      unfold lowerStmtForPtrs; dsimp
      have hpLt : p < ctx.bodySrc.locals.length := hAnnot
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none =>
        have hNe : s3_scrBase ctx + j ≠ p := fun hEq =>
          Nat.not_lt_of_le (by rw [← hEq]; exact hGeBase) hpLt
        unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
        rw [s3b_nat_beq_false_of_ne hNe.symm]; rfl
      | some kp =>
        have hEx := (s3_findPtrEntry_some_iff ctx p kp.1 kp.2).mp hFind
        cases hEx with
        | intro e he =>
          have hB := (s3_ptrEntry_bounds ctx kp.1 e he.1).2.2.2
          have hN0 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * kp.1 := fun h => by
            have hL := (s3_compOffset_bounds ctx kp.1 0 hB (Nat.succ_pos 2)).2
            rw [Nat.add_zero, ← h] at hL
            exact Nat.not_le_of_lt hL (Nat.le_add_right _ _)
          have hN1 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * kp.1 + 1 := fun h => by
            have hL := (s3_compOffset_bounds ctx kp.1 1 hB (by decide)).2
            rw [← h] at hL
            exact Nat.not_le_of_lt hL (Nat.le_add_right _ _)
          have hN2 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * kp.1 + 2 := fun h => by
            have hL := (s3_compOffset_bounds ctx kp.1 2 hB (by decide)).2
            rw [← h] at hL
            exact Nat.not_le_of_lt hL (Nat.le_add_right _ _)
          cases kp with | mk kp1 kp2 =>
          dsimp at hN0 hN1 hN2
          dsimp
          rw [s3b_mkStorageLiveRange_3]
          unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker
          dsimp
          rw [s3b_nat_beq_false_of_ne (Ne.symm hN0), s3b_nat_beq_false_of_ne (Ne.symm hN1), s3b_nat_beq_false_of_ne (Ne.symm hN2)]; rfl
    | storageDead p =>
      unfold lowerStmtForPtrs; dsimp
      have hpLt : p < ctx.bodySrc.locals.length := hAnnot
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none =>
        have hNe : s3_scrBase ctx + j ≠ p := fun hEq =>
          Nat.not_lt_of_le (by rw [← hEq]; exact hGeBase) hpLt
        unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
        rw [s3b_nat_beq_false_of_ne hNe.symm]; rfl
      | some kp =>
        have hEx := (s3_findPtrEntry_some_iff ctx p kp.1 kp.2).mp hFind
        cases hEx with
        | intro e he =>
          have hB := (s3_ptrEntry_bounds ctx kp.1 e he.1).2.2.2
          have hN0 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * kp.1 := fun h => by
            have hL := (s3_compOffset_bounds ctx kp.1 0 hB (Nat.succ_pos 2)).2
            rw [Nat.add_zero, ← h] at hL
            exact Nat.not_le_of_lt hL (Nat.le_add_right _ _)
          have hN1 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * kp.1 + 1 := fun h => by
            have hL := (s3_compOffset_bounds ctx kp.1 1 hB (by decide)).2
            rw [← h] at hL
            exact Nat.not_le_of_lt hL (Nat.le_add_right _ _)
          have hN2 : s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * kp.1 + 2 := fun h => by
            have hL := (s3_compOffset_bounds ctx kp.1 2 hB (by decide)).2
            rw [← h] at hL
            exact Nat.not_le_of_lt hL (Nat.le_add_right _ _)
          cases kp with | mk kp1 kp2 =>
          dsimp at hN0 hN1 hN2
          dsimp
          rw [s3b_mkStorageDeadRange_3]
          unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker
          dsimp
          rw [s3b_nat_beq_false_of_ne (Ne.symm hN0), s3b_nat_beq_false_of_ne (Ne.symm hN1), s3b_nat_beq_false_of_ne (Ne.symm hN2)]; rfl
  | bufLivenessCheck _ => rfl
  | mkNullPtr d => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | mkDanglingPtr d _ => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | addrOfByteBuf d _ => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | copyPtr d s _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with
    | none => rfl | some kd => cases kd; cases findPtrEntry ctx.plan.entries s with | none => rfl | some ks => cases ks; rfl
  | ptrWrappingOffset d s cntOp _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with
    | none => rfl | some kd => cases kd; cases findPtrEntry ctx.plan.entries s with | none => rfl | some ks => cases ks; cases constIsizeValue? cntOp <;> rfl

private theorem s3_storageAnnotInBounds_lowerStmt (ctx : s3_PtrCtx) (stmt : MemCopyStmt)
    (hAnnot : s3_stmtStorageAnnotInBounds ctx.bodySrc.locals.length stmt) :
    (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length stmt).all
      (fun s => match s with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id ctx.bodyTgt.locals.length
        | _ => true) = true := by
  have hBaseLe : ctx.bodySrc.locals.length < ctx.bodyTgt.locals.length := by
    rw [s3_bodyTgt_locals_length]
    exact Nat.lt_of_le_of_lt (Nat.le_add_right _ _) (Nat.lt_add_of_pos_right (by decide : 0 < 12))
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | assign _ _ | nop | unsupported => rfl
    | storageLive p =>
      unfold lowerStmtForPtrs; dsimp
      have hpLt : p < ctx.bodySrc.locals.length := hAnnot
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none =>
        unfold List.all; dsimp
        rw [(nat_blt_eq_lt _ _).mpr (Nat.lt_trans hpLt hBaseLe)]
        rfl
      | some kp =>
        have hEx := (s3_findPtrEntry_some_iff ctx p kp.1 kp.2).mp hFind
        cases hEx with
        | intro e he =>
          have hB := (s3_ptrEntry_bounds ctx kp.1 e he.1).2.2.2
          have h0 : ctx.bodySrc.locals.length + 3 * kp.1 < ctx.bodyTgt.locals.length := by
            rw [s3_bodyTgt_locals_length]
            have hc := (s3_compOffset_bounds ctx kp.1 0 hB (Nat.succ_pos 2)).2
            rw [Nat.add_zero] at hc
            exact Nat.lt_of_lt_of_le hc (Nat.le_add_right _ _)
          have h1 : ctx.bodySrc.locals.length + 3 * kp.1 + 1 < ctx.bodyTgt.locals.length := by
            rw [s3_bodyTgt_locals_length]
            exact Nat.lt_of_lt_of_le (s3_compOffset_bounds ctx kp.1 1 hB (by decide)).2 (Nat.le_add_right _ _)
          have h2 : ctx.bodySrc.locals.length + 3 * kp.1 + 2 < ctx.bodyTgt.locals.length := by
            rw [s3_bodyTgt_locals_length]
            exact Nat.lt_of_lt_of_le (s3_compOffset_bounds ctx kp.1 2 hB (by decide)).2 (Nat.le_add_right _ _)
          cases kp with | mk kp1 kp2 =>
          dsimp at h0 h1 h2
          dsimp
          rw [s3b_mkStorageLiveRange_3]
          unfold List.all
          dsimp
          rw [(nat_blt_eq_lt _ _).mpr h0, (nat_blt_eq_lt _ _).mpr h1, (nat_blt_eq_lt _ _).mpr h2]
          rfl
    | storageDead p =>
      unfold lowerStmtForPtrs; dsimp
      have hpLt : p < ctx.bodySrc.locals.length := hAnnot
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none =>
        unfold List.all; dsimp
        rw [(nat_blt_eq_lt _ _).mpr (Nat.lt_trans hpLt hBaseLe)]
        rfl
      | some kp =>
        have hEx := (s3_findPtrEntry_some_iff ctx p kp.1 kp.2).mp hFind
        cases hEx with
        | intro e he =>
          have hB := (s3_ptrEntry_bounds ctx kp.1 e he.1).2.2.2
          have h0 : ctx.bodySrc.locals.length + 3 * kp.1 < ctx.bodyTgt.locals.length := by
            rw [s3_bodyTgt_locals_length]
            have hc := (s3_compOffset_bounds ctx kp.1 0 hB (Nat.succ_pos 2)).2
            rw [Nat.add_zero] at hc
            exact Nat.lt_of_lt_of_le hc (Nat.le_add_right _ _)
          have h1 : ctx.bodySrc.locals.length + 3 * kp.1 + 1 < ctx.bodyTgt.locals.length := by
            rw [s3_bodyTgt_locals_length]
            exact Nat.lt_of_lt_of_le (s3_compOffset_bounds ctx kp.1 1 hB (by decide)).2 (Nat.le_add_right _ _)
          have h2 : ctx.bodySrc.locals.length + 3 * kp.1 + 2 < ctx.bodyTgt.locals.length := by
            rw [s3_bodyTgt_locals_length]
            exact Nat.lt_of_lt_of_le (s3_compOffset_bounds ctx kp.1 2 hB (by decide)).2 (Nat.le_add_right _ _)
          cases kp with | mk kp1 kp2 =>
          dsimp at h0 h1 h2
          dsimp
          rw [s3b_mkStorageDeadRange_3]
          unfold List.all
          dsimp
          rw [(nat_blt_eq_lt _ _).mpr h0, (nat_blt_eq_lt _ _).mpr h1, (nat_blt_eq_lt _ _).mpr h2]
          rfl
  | bufLivenessCheck _ => rfl
  | mkNullPtr d => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | mkDanglingPtr d _ => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | addrOfByteBuf d _ => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | copyPtr d s _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with
    | none => rfl | some kd => cases kd; cases findPtrEntry ctx.plan.entries s with | none => rfl | some ks => cases ks; rfl
  | ptrWrappingOffset d s cntOp _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with
    | none => rfl | some kd => cases kd; cases findPtrEntry ctx.plan.entries s with | none => rfl | some ks => cases ks; cases constIsizeValue? cntOp <;> rfl

private theorem s3_any_listFlatMap {α β : Type} (f : α → List β) (p : β → Bool) (xs : List α) :
    (listFlatMap f xs).any p = xs.any (fun x => (f x).any p) := by
  induction xs with
  | nil => rfl
  | cons x rest ih =>
    change (f x ++ listFlatMap f rest).any p = ((f x).any p || rest.any (fun x => (f x).any p))
    rw [s3b_list_any_append, ih]

private theorem s3_all_listFlatMap {α β : Type} (f : α → List β) (p : β → Bool) (xs : List α) :
    (listFlatMap f xs).all p = xs.all (fun x => (f x).all p) := by
  induction xs with
  | nil => rfl
  | cons x rest ih =>
    change (f x ++ listFlatMap f rest).all p = ((f x).all p && rest.all (fun x => (f x).all p))
    rw [s3b_list_all_append, ih]

private theorem s3_mkPtrAlignCheckStmts_noStorageMarker (id : LocalId) (decls : List MemCopyLocalDecl)
    (optBuf : Option LocalId) (tagLoc offLoc scrTmpA scrTmpB : LocalId) (reqAlignLog2 : Nat) :
    (mkPtrAlignCheckStmts decls optBuf tagLoc offLoc scrTmpA scrTmpB reqAlignLog2).all
      (fun s => !memCopyStmtHasStorageMarker id s) = true := by
  unfold mkPtrAlignCheckStmts
  cases optBuf with
  | none => rfl
  | some bLoc =>
    dsimp
    cases hG : Trusted.MirSemantics.getElem? decls bLoc with
    | none => rfl
    | some dl =>
      cases dl with
      | base _ | ptrLocal => rfl
      | byteBuf _ bufAlign _ =>
        dsimp
        cases Nat.ble reqAlignLog2 bufAlign <;> rfl

private theorem s3_buildReadLeByteBlocks_noStorageMarker (id dstLocal bufLoc : LocalId)
    (scrOff1 scrTmpA scrTmpB scrAcc scrBTag scrBVal : LocalId) (nextBb : BasicBlockId) :
    ∀ (rem i curBb : Nat),
      (buildReadLeByteBlocks dstLocal bufLoc scrOff1 scrTmpA scrTmpB scrAcc scrBTag scrBVal
        nextBb i curBb rem).all
        (fun eb => eb.statements.all (fun s => !memCopyStmtHasStorageMarker id s)) = true
  | 0, _, _ => rfl
  | rem + 1, i, curBb => by
    unfold buildReadLeByteBlocks
    have ih := s3_buildReadLeByteBlocks_noStorageMarker id dstLocal bufLoc scrOff1 scrTmpA scrTmpB
      scrAcc scrBTag scrBVal nextBb rem (i + 1) (curBb + 1)
    cases rem with
    | zero =>
      dsimp
      cases Nat.beq i 0 <;> rfl
    | succ rem' =>
      dsimp
      change (((if Nat.beq i 0 then [mkAssignUse scrAcc (Operand.move { localId := scrBVal, projection := [] })]
          else [mkBinOpStmt scrTmpB BinOp.shl (Operand.move { localId := scrBVal, projection := [] }) (usizeConst (8 * i)),
            mkBinOpStmt scrAcc BinOp.bitOr (Operand.move { localId := scrAcc, projection := [] }) (Operand.move { localId := scrTmpB, projection := [] })]) ++
          [mkBinOpStmt scrTmpA BinOp.add (Operand.copy { localId := scrOff1, projection := [] }) (usizeConst (i + 1))]).all
          (fun s => !memCopyStmtHasStorageMarker id s) &&
          (buildReadLeByteBlocks dstLocal bufLoc scrOff1 scrTmpA scrTmpB scrAcc scrBTag scrBVal
            nextBb (i + 1) (curBb + 1) (rem' + 1)).all
            (fun eb => eb.statements.all (fun s => !memCopyStmtHasStorageMarker id s))) = true
      rw [ih, Bool.and_true]
      cases Nat.beq i 0 <;> rfl

private theorem s3_buildWriteLeByteBlocks_noStorageMarker (id bufLoc : LocalId)
    (scrOff1 scrTmpA scrTmpB scrAcc scrBVal : LocalId) (nextBb : BasicBlockId) :
    ∀ (rem i curBb : Nat),
      (buildWriteLeByteBlocks bufLoc scrOff1 scrTmpA scrTmpB scrAcc scrBVal
        nextBb i curBb rem).all
        (fun eb => eb.statements.all (fun s => !memCopyStmtHasStorageMarker id s)) = true
  | 0, _, _ => rfl
  | rem + 1, i, curBb => by
    unfold buildWriteLeByteBlocks
    have ih := s3_buildWriteLeByteBlocks_noStorageMarker id bufLoc scrOff1 scrTmpA scrTmpB
      scrAcc scrBVal nextBb rem (i + 1) (curBb + 1)
    cases rem with
    | zero => rfl
    | succ rem' =>
      dsimp
      change (true && (buildWriteLeByteBlocks bufLoc scrOff1 scrTmpA scrTmpB scrAcc scrBVal
          nextBb (i + 1) (curBb + 1) (rem' + 1)).all
            (fun eb => eb.statements.all (fun s => !memCopyStmtHasStorageMarker id s))) = true
      rw [ih]; rfl

private theorem s3_lowerTerm_noStorageMarker (id : LocalId) (decls : List MemCopyLocalDecl)
    (entries : List PtrBackingEntry) (base nextExtraBb : Nat) (term : MemCopyTerm) :
    (lowerTermForPtrs decls entries base nextExtraBb term).1.all
      (fun s => !memCopyStmtHasStorageMarker id s) = true ∧
    (lowerTermForPtrs decls entries base nextExtraBb term).2.2.all
      (fun eb => eb.statements.all (fun s => !memCopyStmtHasStorageMarker id s)) = true := by
  cases term with
  | baseTerm _ | readBufRawByte _ _ _ _ _ | writeBufRawByte _ _ _ _ _
  | readPtrLe8 _ _ _ _ | writePtrLe8 _ _ _ _ => exact ⟨rfl, rfl⟩
  | ptrOffsetInbounds d s cntOp elemSize nextBb =>
    unfold lowerTermForPtrs; dsimp
    cases hD : findPtrEntry entries d with
    | none => exact ⟨rfl, rfl⟩
    | some kD =>
      cases hS : findPtrEntry entries s with
      | none => exact ⟨rfl, rfl⟩
      | some kS =>
        cases kD with | mk kD1 kD2 =>
        cases kS with | mk kS1 optBufS =>
        dsimp
        cases hC : constIsizeValue? cntOp with
        | some z =>
          dsimp
          cases decide (z * Int.ofNat elemSize < minIsize) ||
              decide (Int.ofNat maxIsize < z * Int.ofNat elemSize) with
          | true => exact ⟨rfl, rfl⟩
          | false =>
            dsimp
            cases (z * Int.ofNat elemSize == 0) with
            | true => exact ⟨rfl, rfl⟩
            | false =>
              cases optBufS with
              | none => exact ⟨rfl, rfl⟩
              | some bLoc =>
                dsimp
                cases hG : Trusted.MirSemantics.getElem? decls bLoc with
                | none => exact ⟨rfl, rfl⟩
                | some dl =>
                  cases dl with
                  | base _ | ptrLocal => exact ⟨rfl, rfl⟩
                  | byteBuf bSz _ _ =>
                    dsimp
                    cases decide (0 < z * Int.ofNat elemSize) with
                    | false => exact ⟨rfl, rfl⟩
                    | true => cases !Nat.ble (z * Int.ofNat elemSize).toNat bSz <;> exact ⟨rfl, rfl⟩
        | none =>
          dsimp
          cases Nat.beq elemSize 0 with
          | true => exact ⟨rfl, rfl⟩
          | false =>
            cases !Nat.ble elemSize maxIsize with
            | true => exact ⟨rfl, rfl⟩
            | false =>
              dsimp
              cases optBufS with
              | none => exact ⟨rfl, rfl⟩
              | some bLoc =>
                dsimp
                cases hG : Trusted.MirSemantics.getElem? decls bLoc with
                | none => exact ⟨rfl, rfl⟩
                | some dl =>
                  cases dl <;> exact ⟨rfl, rfl⟩
  | checkPtrPairAlign s d _ reqAlignLog2 checkNonNullZero nextBb =>
    unfold lowerTermForPtrs; dsimp
    cases hS : findPtrEntry entries s with
    | none => exact ⟨rfl, rfl⟩
    | some kS =>
      cases hD : findPtrEntry entries d with
      | none => exact ⟨rfl, rfl⟩
      | some kD =>
        cases kS with | mk kS1 optBufS =>
        cases kD with | mk kD1 optBufD =>
        dsimp
        have hA1 := s3_mkPtrAlignCheckStmts_noStorageMarker id decls optBufS
          (base + 3 * entries.length) (base + 3 * entries.length + 1)
          (base + 3 * entries.length + 5) (base + 3 * entries.length + 6) reqAlignLog2
        have hA2 := s3_mkPtrAlignCheckStmts_noStorageMarker id decls optBufD
          (base + 3 * entries.length + 2) (base + 3 * entries.length + 3)
          (base + 3 * entries.length + 5) (base + 3 * entries.length + 6) reqAlignLog2
        rw [s3b_list_all_append, s3b_list_all_append, hA1, hA2]
        cases checkNonNullZero <;> exact ⟨rfl, rfl⟩
  | readLeUsize dstLocal p w requireAligned nextBb =>
    unfold lowerTermForPtrs; dsimp
    cases hP : findPtrEntry entries p with
    | none => exact ⟨rfl, rfl⟩
    | some kP =>
      cases kP with | mk kP1 optBufP =>
      dsimp
      have hA := s3_mkPtrAlignCheckStmts_noStorageMarker id decls optBufP
        (base + 3 * entries.length) (base + 3 * entries.length + 1)
        (base + 3 * entries.length + 5) (base + 3 * entries.length + 6)
        (if requireAligned then w.naturalAlignLog2 else 0)
      cases optBufP with
      | none =>
        dsimp
        rw [s3b_list_all_append, hA]
        exact ⟨rfl, rfl⟩
      | some bLoc =>
        dsimp
        cases hG : Trusted.MirSemantics.getElem? decls bLoc with
        | none => exact ⟨rfl, rfl⟩
        | some dl =>
          cases dl with
          | base _ | ptrLocal => exact ⟨rfl, rfl⟩
          | byteBuf bSz _ _ =>
            dsimp
            cases !Nat.ble w.byteCount bSz with
            | true =>
              dsimp
              rw [s3b_list_all_append, s3b_list_all_append, hA]
              exact ⟨rfl, rfl⟩
            | false =>
              dsimp
              constructor
              · rw [s3b_list_all_append, s3b_list_all_append, hA]; rfl
              · exact s3_buildReadLeByteBlocks_noStorageMarker id dstLocal bLoc
                  (base + 3 * entries.length + 1) (base + 3 * entries.length + 5)
                  (base + 3 * entries.length + 6) (base + 3 * entries.length + 7)
                  (base + 3 * entries.length + 8) (base + 3 * entries.length + 9)
                  nextBb w.byteCount 0 nextExtraBb
  | writeLeUsize p valOp w requireAligned nextBb =>
    unfold lowerTermForPtrs; dsimp
    cases hP : findPtrEntry entries p with
    | none => exact ⟨rfl, rfl⟩
    | some kP =>
      cases kP with | mk kP1 optBufP =>
      dsimp
      have hA := s3_mkPtrAlignCheckStmts_noStorageMarker id decls optBufP
        (base + 3 * entries.length) (base + 3 * entries.length + 1)
        (base + 3 * entries.length + 5) (base + 3 * entries.length + 6)
        (if requireAligned then w.naturalAlignLog2 else 0)
      cases optBufP with
      | none =>
        dsimp
        rw [s3b_list_all_append, hA]
        exact ⟨rfl, rfl⟩
      | some bLoc =>
        dsimp
        cases hG : Trusted.MirSemantics.getElem? decls bLoc with
        | none => exact ⟨rfl, rfl⟩
        | some dl =>
          cases dl with
          | base _ | ptrLocal => exact ⟨rfl, rfl⟩
          | byteBuf bSz _ mutab =>
            dsimp
            cases !(Mutability.beq mutab .mut) || !Nat.ble w.byteCount bSz with
            | true =>
              dsimp
              rw [s3b_list_all_append, s3b_list_all_append, hA]
              exact ⟨rfl, rfl⟩
            | false =>
              dsimp
              cases Nat.beq w.byteCount 1 with
              | true =>
                dsimp
                rw [s3b_list_all_append, s3b_list_all_append, hA]
                exact ⟨rfl, rfl⟩
              | false =>
                dsimp
                constructor
                · rw [s3b_list_all_append, s3b_list_all_append, hA]; rfl
                · exact s3_buildWriteLeByteBlocks_noStorageMarker id bLoc
                    (base + 3 * entries.length + 1) (base + 3 * entries.length + 5)
                    (base + 3 * entries.length + 6) (base + 3 * entries.length + 7)
                    (base + 3 * entries.length + 9) nextBb (w.byteCount - 1) 1 nextExtraBb
  | copyNonOverlapping s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb =>
    unfold lowerTermForPtrs; dsimp
    cases hS : findPtrEntry entries s with
    | none => exact ⟨rfl, rfl⟩
    | some kS =>
      cases hD : findPtrEntry entries d with
      | none => exact ⟨rfl, rfl⟩
      | some kD =>
        cases kS with | mk kS1 optBufS =>
        cases kD with | mk kD1 optBufD =>
        dsimp
        have hA1 := s3_mkPtrAlignCheckStmts_noStorageMarker id decls optBufS
          (base + 3 * entries.length) (base + 3 * entries.length + 1)
          (base + 3 * entries.length + 5) (base + 3 * entries.length + 6) reqAlignLog2
        have hA2 := s3_mkPtrAlignCheckStmts_noStorageMarker id decls optBufD
          (base + 3 * entries.length + 2) (base + 3 * entries.length + 3)
          (base + 3 * entries.length + 5) (base + 3 * entries.length + 6) reqAlignLog2
        have hHdr : (([mkAssignUse (base + 3 * entries.length + 4) cntOp,
              mkLivenessCheckStmt (base + 3 * kS1),
              mkAssignUse (base + 3 * entries.length) (.copy { localId := base + 3 * kS1 + 1, projection := [] }),
              mkAssignUse (base + 3 * entries.length + 1) (.copy { localId := base + 3 * kS1 + 2, projection := [] }),
              mkLivenessCheckStmt (base + 3 * kD1),
              mkAssignUse (base + 3 * entries.length + 2) (.copy { localId := base + 3 * kD1 + 1, projection := [] }),
              mkAssignUse (base + 3 * entries.length + 3) (.copy { localId := base + 3 * kD1 + 2, projection := [] })] ++
              (if Nat.beq elemSize 0 then [mkAssignUse (base + 3 * entries.length + 4) (usizeConst 0)]
              else if !Nat.ble elemSize maxIsize then
                [mkRequireZeroUsize (base + 3 * entries.length + 5) (.copy { localId := base + 3 * entries.length + 4, projection := [] })]
              else [mkSubUncheckedUsize (base + 3 * entries.length + 5) (usizeConst (Nat.div maxIsize elemSize)) (.copy { localId := base + 3 * entries.length + 4, projection := [] }),
                mkBinOpStmt (base + 3 * entries.length + 4) .mul (.move { localId := base + 3 * entries.length + 4, projection := [] }) (usizeConst elemSize)])) ++
              (mkPtrAlignCheckStmts decls optBufS (base + 3 * entries.length) (base + 3 * entries.length + 1) (base + 3 * entries.length + 5) (base + 3 * entries.length + 6) reqAlignLog2 ++
                mkPtrAlignCheckStmts decls optBufD (base + 3 * entries.length + 2) (base + 3 * entries.length + 3) (base + 3 * entries.length + 5) (base + 3 * entries.length + 6) reqAlignLog2 ++
                (if checkNonNullZero then
                  mkPtrNonNullCheckStmts (base + 3 * entries.length) (base + 3 * entries.length + 1) (base + 3 * entries.length + 5) (base + 3 * entries.length + 6) ++
                    mkPtrNonNullCheckStmts (base + 3 * entries.length + 2) (base + 3 * entries.length + 3) (base + 3 * entries.length + 5) (base + 3 * entries.length + 6)
                else []))).all (fun s => !memCopyStmtHasStorageMarker id s) = true := by
          rw [s3b_list_all_append, s3b_list_all_append, s3b_list_all_append, s3b_list_all_append, hA1, hA2]
          cases Nat.beq elemSize 0 <;> cases !Nat.ble elemSize maxIsize <;> cases checkNonNullZero <;> rfl
        cases optBufS with
        | none =>
          cases optBufD <;> exact ⟨hHdr, rfl⟩
        | some bS =>
          cases optBufD with
          | none => exact ⟨hHdr, rfl⟩
          | some bD =>
            dsimp
            cases hGS : Trusted.MirSemantics.getElem? decls bS with
            | none => exact ⟨rfl, rfl⟩
            | some dS =>
              cases dS with
              | base _ | ptrLocal => exact ⟨rfl, rfl⟩
              | byteBuf sS _ _ =>
                cases hGD : Trusted.MirSemantics.getElem? decls bD with
                | none => exact ⟨rfl, rfl⟩
                | some dD =>
                  cases dD with
                  | base _ | ptrLocal => exact ⟨rfl, rfl⟩
                  | byteBuf sD _ mD =>
                    dsimp
                    cases !(Mutability.beq mD .mut) with
                    | true => exact ⟨hHdr, rfl⟩
                    | false =>
                      dsimp
                      cases Nat.beq bS bD with
                      | true => exact ⟨hHdr, rfl⟩
                      | false => exact ⟨hHdr, rfl⟩

private theorem s3_lowerBlocksLoop_any_storageMarker (ctx : s3_PtrCtx)
    (id : LocalId) (pSrcId : LocalId)
    (hStmtEq : ∀ stmt, s3_stmtStorageAnnotInBounds ctx.bodySrc.locals.length stmt →
      (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length stmt).any
        (memCopyStmtHasStorageMarker id) = memCopyStmtHasStorageMarker pSrcId stmt) :
    ∀ (nextExtra : Nat) (bbs : List MemCopyBlock),
      bbs.all (fun bb => bb.statements.all (fun s =>
        match s with
        | .baseStmt (.storageLive x) | .baseStmt (.storageDead x) => Nat.blt x ctx.bodySrc.locals.length
        | _ => true)) = true →
      ((lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bbs).1.any
          (fun bb => bb.statements.any (memCopyStmtHasStorageMarker id)) ||
        (lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bbs).2.any
          (fun bb => bb.statements.any (memCopyStmtHasStorageMarker id))) =
        bbs.any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker pSrcId))
  | _, [], _ => rfl
  | nextExtra, bb :: rest, hBbs => by
    have hSplit := (bool_and_eq_true _ _).mp hBbs
    have ih := s3_lowerBlocksLoop_any_storageMarker ctx id pSrcId hStmtEq
      (nextExtra + (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).2.2.length)
      rest hSplit.2
    have hTermNo := s3_lowerTerm_noStorageMarker id ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator
    have hTermPreFalse : (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).1.any
        (memCopyStmtHasStorageMarker id) = false :=
      s3_any_storageMarker_false_of_all id _ hTermNo.1
    have hTermExtraFalse : (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).2.2.any
        (fun eb => eb.statements.any (memCopyStmtHasStorageMarker id)) = false := by
      have hNeg : ∀ (ebs : List MemCopyBlock),
          ebs.all (fun eb => eb.statements.all (fun s => !memCopyStmtHasStorageMarker id s)) = true →
          ebs.any (fun eb => eb.statements.any (memCopyStmtHasStorageMarker id)) = false := by
        intro ebs hebs
        induction ebs with
        | nil => rfl
        | cons eb' rest' ih' =>
          unfold List.all at hebs; have h1 := (bool_and_eq_true _ _).mp hebs
          change (eb'.statements.any (memCopyStmtHasStorageMarker id) ||
              rest'.any (fun eb => eb.statements.any (memCopyStmtHasStorageMarker id))) = false
          rw [s3_any_storageMarker_false_of_all id _ h1.1, ih' h1.2]
          rfl
      exact hNeg _ hTermNo.2
    have hBbStmtsAux : ∀ (stmts : List MemCopyStmt),
        stmts.all (fun s => match s with
          | .baseStmt (.storageLive x) | .baseStmt (.storageDead x) => Nat.blt x ctx.bodySrc.locals.length
          | _ => true) = true →
        (listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) stmts).any
          (memCopyStmtHasStorageMarker id) =
          stmts.any (memCopyStmtHasStorageMarker pSrcId) := by
      intro stmts hStmts
      rw [s3_any_listFlatMap]
      induction stmts with
      | nil => rfl
      | cons st sts ihS =>
        unfold List.all at hStmts; have h1 := (bool_and_eq_true _ _).mp hStmts
        have hSA : s3_stmtStorageAnnotInBounds ctx.bodySrc.locals.length st := by
          cases st with
          | baseStmt bs =>
            cases bs with
            | storageLive x | storageDead x => exact (nat_blt_eq_lt _ _).mp h1.1
            | _ => exact True.intro
          | _ => exact True.intro
        change ((lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length st).any
            (memCopyStmtHasStorageMarker id) ||
            sts.any (fun s => (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length s).any
              (memCopyStmtHasStorageMarker id))) =
          (memCopyStmtHasStorageMarker pSrcId st || sts.any (memCopyStmtHasStorageMarker pSrcId))
        rw [hStmtEq st hSA, ihS h1.2]
    have hBbStmts := hBbStmtsAux bb.statements hSplit.1
    unfold lowerBlocksForPtrsLoop
    dsimp
    change ((((listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) bb.statements ++
          (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).1).any
          (memCopyStmtHasStorageMarker id) ||
          (lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
            (nextExtra + (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).2.2.length)
            rest).1.any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker id))) ||
        ((lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).2.2 ++
          (lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
            (nextExtra + (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).2.2.length)
            rest).2).any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker id))) =
        (bb.statements.any (memCopyStmtHasStorageMarker pSrcId) ||
          rest.any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker pSrcId))))
    rw [s3b_list_any_append, s3b_list_any_append, hTermPreFalse, hTermExtraFalse, hBbStmts, Bool.or_false, Bool.false_or]
    rw [Bool.or_assoc, ih]

private theorem s3_storageMarker_lowerStmt_nonPtr (ctx : s3_PtrCtx) (id : LocalId) (stmt : MemCopyStmt)
    (hid : id < ctx.bodySrc.locals.length)
    (hNonPtr : Trusted.MirSemantics.getElem? ctx.bodySrc.locals id ≠ some .ptrLocal) :
    (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length stmt).any
      (memCopyStmtHasStorageMarker id) = memCopyStmtHasStorageMarker id stmt := by
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | assign _ _ | nop | unsupported => rfl
    | storageLive p =>
      unfold lowerStmtForPtrs; dsimp
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none => exact Bool.or_false _
      | some kp =>
        have hEx := (s3_findPtrEntry_some_iff ctx p kp.1 kp.2).mp hFind
        cases hEx with
        | intro e he =>
          have hPtr := (s3_ptrEntry_bounds ctx kp.1 e he.1).2.2.1
          rw [he.2.1] at hPtr
          have hNeP : id ≠ p := fun hEq => hNonPtr (by rw [hEq]; exact hPtr)
          have hB := (s3_ptrEntry_bounds ctx kp.1 e he.1).2.2.2
          have hNe0 : id ≠ ctx.bodySrc.locals.length + 3 * kp.1 := fun hEq =>
            Nat.not_lt_of_le (Nat.le_trans (Nat.le_add_right _ _) (by rw [← hEq]; exact Nat.le_refl _)) hid
          have hNe1 : id ≠ ctx.bodySrc.locals.length + 3 * kp.1 + 1 := fun hEq =>
            Nat.not_lt_of_le (Nat.le_trans (s3_compOffset_bounds ctx kp.1 1 hB (by decide)).1 (by rw [← hEq]; exact Nat.le_refl _)) hid
          have hNe2 : id ≠ ctx.bodySrc.locals.length + 3 * kp.1 + 2 := fun hEq =>
            Nat.not_lt_of_le (Nat.le_trans (s3_compOffset_bounds ctx kp.1 2 hB (by decide)).1 (by rw [← hEq]; exact Nat.le_refl _)) hid
          cases kp with | mk kp1 kp2 =>
          dsimp at hNe0 hNe1 hNe2
          dsimp
          have hLhs : (mkStorageLiveRange (ctx.bodySrc.locals.length + 3 * kp1) 3).any
              (memCopyStmtHasStorageMarker id) = false := by
            rw [s3b_mkStorageLiveRange_3]
            unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker
            dsimp
            rw [s3b_nat_beq_false_of_ne (Ne.symm hNe0), s3b_nat_beq_false_of_ne (Ne.symm hNe1), s3b_nat_beq_false_of_ne (Ne.symm hNe2)]
            rfl
          have hRhs : memCopyStmtHasStorageMarker id (.baseStmt (.storageLive p)) = false := by
            unfold memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
            exact s3b_nat_beq_false_of_ne hNeP.symm
          rw [hLhs, hRhs]
    | storageDead p =>
      unfold lowerStmtForPtrs; dsimp
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none => exact Bool.or_false _
      | some kp =>
        have hEx := (s3_findPtrEntry_some_iff ctx p kp.1 kp.2).mp hFind
        cases hEx with
        | intro e he =>
          have hPtr := (s3_ptrEntry_bounds ctx kp.1 e he.1).2.2.1
          rw [he.2.1] at hPtr
          have hNeP : id ≠ p := fun hEq => hNonPtr (by rw [hEq]; exact hPtr)
          have hB := (s3_ptrEntry_bounds ctx kp.1 e he.1).2.2.2
          have hNe0 : id ≠ ctx.bodySrc.locals.length + 3 * kp.1 := fun hEq =>
            Nat.not_lt_of_le (Nat.le_trans (Nat.le_add_right _ _) (by rw [← hEq]; exact Nat.le_refl _)) hid
          have hNe1 : id ≠ ctx.bodySrc.locals.length + 3 * kp.1 + 1 := fun hEq =>
            Nat.not_lt_of_le (Nat.le_trans (s3_compOffset_bounds ctx kp.1 1 hB (by decide)).1 (by rw [← hEq]; exact Nat.le_refl _)) hid
          have hNe2 : id ≠ ctx.bodySrc.locals.length + 3 * kp.1 + 2 := fun hEq =>
            Nat.not_lt_of_le (Nat.le_trans (s3_compOffset_bounds ctx kp.1 2 hB (by decide)).1 (by rw [← hEq]; exact Nat.le_refl _)) hid
          cases kp with | mk kp1 kp2 =>
          dsimp at hNe0 hNe1 hNe2
          dsimp
          have hLhs : (mkStorageDeadRange (ctx.bodySrc.locals.length + 3 * kp1) 3).any
              (memCopyStmtHasStorageMarker id) = false := by
            rw [s3b_mkStorageDeadRange_3]
            unfold List.any memCopyStmtHasStorageMarker stmtHasStorageMarker
            dsimp
            rw [s3b_nat_beq_false_of_ne (Ne.symm hNe0), s3b_nat_beq_false_of_ne (Ne.symm hNe1), s3b_nat_beq_false_of_ne (Ne.symm hNe2)]
            rfl
          have hRhs : memCopyStmtHasStorageMarker id (.baseStmt (.storageDead p)) = false := by
            unfold memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
            exact s3b_nat_beq_false_of_ne hNeP.symm
          rw [hLhs, hRhs]
  | bufLivenessCheck _ => rfl
  | mkNullPtr d => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | mkDanglingPtr d _ => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | addrOfByteBuf d _ => unfold lowerStmtForPtrs; dsimp; cases findPtrEntry ctx.plan.entries d with | none => rfl | some kp => cases kp; rfl
  | copyPtr d s _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with
    | none => rfl | some kd => cases kd; cases findPtrEntry ctx.plan.entries s with | none => rfl | some ks => cases ks; rfl
  | ptrWrappingOffset d s cntOp _ =>
    unfold lowerStmtForPtrs; dsimp
    cases findPtrEntry ctx.plan.entries d with
    | none => rfl | some kd => cases kd; cases findPtrEntry ctx.plan.entries s with | none => rfl | some ks => cases ks; cases constIsizeValue? cntOp <;> rfl

private theorem s3_memCopyHasStorageAnnotation_bodyTgt_nonPtr (ctx : s3_PtrCtx) (id : LocalId)
    (hid : id < ctx.bodySrc.locals.length)
    (hNonPtr : Trusted.MirSemantics.getElem? ctx.bodySrc.locals id ≠ some .ptrLocal) :
    memCopyHasStorageAnnotation ctx.bodyTgt id = memCopyHasStorageAnnotation ctx.bodySrc id := by
  unfold memCopyHasStorageAnnotation
  rw [ctx.hBodyTgtEq]; dsimp
  rw [s3b_list_any_append]
  exact s3_lowerBlocksLoop_any_storageMarker ctx id id
    (fun stmt _ => s3_storageMarker_lowerStmt_nonPtr ctx id stmt hid hNonPtr)
    ctx.bodySrc.basicBlocks.length ctx.bodySrc.basicBlocks ctx.hAnnot

private theorem s3_memCopyHasStorageAnnotation_bodyTgt_comp (ctx : s3_PtrCtx) (k r : Nat) (e : PtrBackingEntry)
    (hK : Trusted.MirSemantics.getElem? ctx.plan.entries k = some e) (hr : r < 3) :
    memCopyHasStorageAnnotation ctx.bodyTgt (ctx.bodySrc.locals.length + 3 * k + r) =
      memCopyHasStorageAnnotation ctx.bodySrc e.ptrLocal := by
  unfold memCopyHasStorageAnnotation
  rw [ctx.hBodyTgtEq]; dsimp
  rw [s3b_list_any_append]
  exact s3_lowerBlocksLoop_any_storageMarker ctx (ctx.bodySrc.locals.length + 3 * k + r) e.ptrLocal
    (fun stmt hSA => s3_storageMarker_lowerStmt_comp ctx k r e stmt hK hr hSA)
    ctx.bodySrc.basicBlocks.length ctx.bodySrc.basicBlocks ctx.hAnnot

private theorem s3_memCopyHasStorageAnnotation_bodyTgt_scratch (ctx : s3_PtrCtx) (j : Nat) :
    memCopyHasStorageAnnotation ctx.bodyTgt (s3_scrBase ctx + j) = false := by
  unfold memCopyHasStorageAnnotation
  rw [ctx.hBodyTgtEq]; dsimp
  rw [s3b_list_any_append]
  have hL := s3_lowerBlocksLoop_any_storageMarker ctx (s3_scrBase ctx + j) (s3_scrBase ctx + j)
    (fun stmt hSA => by
      rw [s3_storageMarker_lowerStmt_scratch ctx j stmt hSA]
      cases stmt with
      | baseStmt bs =>
        cases bs with
        | storageLive x =>
          have hx : x < ctx.bodySrc.locals.length := hSA
          have hNe : s3_scrBase ctx + j ≠ x := fun hEq =>
            Nat.not_lt_of_le (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_trans (Nat.le_add_right _ _) (by rw [← hEq]; exact Nat.le_refl _))) hx
          unfold memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
          exact (s3b_nat_beq_false_of_ne hNe.symm).symm
        | storageDead x =>
          have hx : x < ctx.bodySrc.locals.length := hSA
          have hNe : s3_scrBase ctx + j ≠ x := fun hEq =>
            Nat.not_lt_of_le (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_trans (Nat.le_add_right _ _) (by rw [← hEq]; exact Nat.le_refl _))) hx
          unfold memCopyStmtHasStorageMarker stmtHasStorageMarker; dsimp
          exact (s3b_nat_beq_false_of_ne hNe.symm).symm
        | _ => rfl
      | _ => rfl)
    ctx.bodySrc.basicBlocks.length ctx.bodySrc.basicBlocks ctx.hAnnot
  have hSrcAux : ∀ (bbs : List MemCopyBlock),
      bbs.all (fun bb => bb.statements.all (fun s =>
        match s with
        | .baseStmt (.storageLive x) | .baseStmt (.storageDead x) => Nat.blt x ctx.bodySrc.locals.length
        | _ => true)) = true →
      bbs.any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker (s3_scrBase ctx + j))) = false := by
    intro bbs hA
    induction bbs with
    | nil => rfl
    | cons bb rest ih =>
      unfold List.all at hA; have h1 := (bool_and_eq_true _ _).mp hA
      have hBbAux : ∀ (stmts : List MemCopyStmt),
          stmts.all (fun s => match s with
            | .baseStmt (.storageLive x) | .baseStmt (.storageDead x) => Nat.blt x ctx.bodySrc.locals.length
            | _ => true) = true →
          stmts.any (memCopyStmtHasStorageMarker (s3_scrBase ctx + j)) = false := by
        intro stmts hS
        induction stmts with
        | nil => rfl
        | cons st sts ihS =>
          unfold List.all at hS; have h2 := (bool_and_eq_true _ _).mp hS
          have hStF : memCopyStmtHasStorageMarker (s3_scrBase ctx + j) st = false := by
            cases st with
            | baseStmt bs =>
              cases bs with
              | storageLive x =>
                have hx : x < ctx.bodySrc.locals.length := (nat_blt_eq_lt _ _).mp h2.1
                have hNe : s3_scrBase ctx + j ≠ x := fun hEq =>
                  Nat.not_lt_of_le (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_trans (Nat.le_add_right _ _) (by rw [← hEq]; exact Nat.le_refl _))) hx
                unfold memCopyStmtHasStorageMarker stmtHasStorageMarker
                exact s3b_nat_beq_false_of_ne hNe.symm
              | storageDead x =>
                have hx : x < ctx.bodySrc.locals.length := (nat_blt_eq_lt _ _).mp h2.1
                have hNe : s3_scrBase ctx + j ≠ x := fun hEq =>
                  Nat.not_lt_of_le (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_trans (Nat.le_add_right _ _) (by rw [← hEq]; exact Nat.le_refl _))) hx
                unfold memCopyStmtHasStorageMarker stmtHasStorageMarker
                exact s3b_nat_beq_false_of_ne hNe.symm
              | _ => rfl
            | _ => rfl
          change (memCopyStmtHasStorageMarker (s3_scrBase ctx + j) st ||
              sts.any (memCopyStmtHasStorageMarker (s3_scrBase ctx + j))) = false
          rw [hStF, ihS h2.2]; rfl
      have hBbF := hBbAux bb.statements h1.1
      change (bb.statements.any (memCopyStmtHasStorageMarker (s3_scrBase ctx + j)) ||
          rest.any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker (s3_scrBase ctx + j)))) = false
      rw [hBbF, ih h1.2]; rfl
  have hSrcFalse := hSrcAux ctx.bodySrc.basicBlocks ctx.hAnnot
  rw [hL, hSrcFalse]

private theorem s3_all_storageInBounds_of_noMarker (n : Nat) :
    ∀ (xs : List MemCopyStmt),
      (∀ id : LocalId, xs.all (fun s => !memCopyStmtHasStorageMarker id s) = true) →
      xs.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
        | _ => true) = true
  | [], _ => rfl
  | st :: rest, h => by
    have hTail : ∀ id : LocalId, rest.all (fun s => !memCopyStmtHasStorageMarker id s) = true :=
      fun id => ((bool_and_eq_true _ _).mp (h id)).2
    unfold List.all
    rw [s3_all_storageInBounds_of_noMarker n rest hTail, Bool.and_true]
    cases st with
    | baseStmt bs =>
      cases bs with
      | storageLive x =>
        have hx := ((bool_and_eq_true _ _).mp (h x)).1
        change (!Nat.beq x x) = true at hx
        rw [nat_beq_refl] at hx; cases hx
      | storageDead x =>
        have hx := ((bool_and_eq_true _ _).mp (h x)).1
        change (!Nat.beq x x) = true at hx
        rw [nat_beq_refl] at hx; cases hx
      | _ => rfl
    | _ => rfl

private theorem s3_all_blocks_storageInBounds_of_noMarker (n : Nat) :
    ∀ (bbs : List MemCopyBlock),
      (∀ id : LocalId, bbs.all (fun eb => eb.statements.all (fun s => !memCopyStmtHasStorageMarker id s)) = true) →
      bbs.all (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
        | _ => true)) = true
  | [], _ => rfl
  | eb :: rest, h => by
    have hHead := s3_all_storageInBounds_of_noMarker n eb.statements
      (fun id => ((bool_and_eq_true _ _).mp (h id)).1)
    have hTail := s3_all_blocks_storageInBounds_of_noMarker n rest
      (fun id => ((bool_and_eq_true _ _).mp (h id)).2)
    change (eb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
        | _ => true) && rest.all (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
        | _ => true))) = true
    rw [hHead, hTail]
    rfl

private theorem s3_memCopyStorageAnnotationsInBounds_bodyTgt (ctx : s3_PtrCtx) :
    memCopyStorageAnnotationsInBounds ctx.bodyTgt = true := by
  unfold memCopyStorageAnnotationsInBounds
  rw [ctx.hBodyTgtEq]; dsimp
  rw [s3b_list_all_append]
  have hGen : ∀ (nextExtra : Nat) (bbs : List MemCopyBlock),
      bbs.all (fun bb => bb.statements.all (fun s =>
        match s with
        | .baseStmt (.storageLive x) | .baseStmt (.storageDead x) => Nat.blt x ctx.bodySrc.locals.length
        | _ => true)) = true →
      (lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bbs).1.all
        (fun bb => bb.statements.all (fun stmt =>
          match stmt with
          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id ctx.bodyTgt.locals.length
          | _ => true)) = true ∧
      (lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bbs).2.all
        (fun bb => bb.statements.all (fun stmt =>
          match stmt with
          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id ctx.bodyTgt.locals.length
          | _ => true)) = true := by
    intro nextExtra bbs hBbs
    induction bbs generalizing nextExtra with
    | nil => exact ⟨rfl, rfl⟩
    | cons bb rest ih =>
      unfold List.all at hBbs; have h1 := (bool_and_eq_true _ _).mp hBbs
      have ihR := ih (nextExtra + (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).2.2.length) h1.2
      have hPreOk := s3_all_storageInBounds_of_noMarker ctx.bodyTgt.locals.length _
        (fun id => (s3_lowerTerm_noStorageMarker id ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).1)
      have hExtOk := s3_all_blocks_storageInBounds_of_noMarker ctx.bodyTgt.locals.length _
        (fun id => (s3_lowerTerm_noStorageMarker id ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).2)
      have hBodyOkAux : ∀ (stmts : List MemCopyStmt),
          stmts.all (fun s => match s with | .baseStmt (.storageLive x) | .baseStmt (.storageDead x) => Nat.blt x ctx.bodySrc.locals.length | _ => true) = true →
          (listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) stmts).all
            (fun stmt => match stmt with | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id ctx.bodyTgt.locals.length | _ => true) = true := by
        intro stmts hS
        rw [s3_all_listFlatMap]
        induction stmts with
        | nil => rfl
        | cons st sts ihS =>
          unfold List.all at hS; have h2 := (bool_and_eq_true _ _).mp hS
          have hSA : s3_stmtStorageAnnotInBounds ctx.bodySrc.locals.length st := by
            cases st with
            | baseStmt bs => cases bs with | storageLive x | storageDead x => exact (nat_blt_eq_lt _ _).mp h2.1 | _ => exact True.intro
            | _ => exact True.intro
          change ((lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length st).all
              (fun stmt => match stmt with | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id ctx.bodyTgt.locals.length | _ => true) &&
              sts.all (fun s => (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length s).all
                (fun stmt => match stmt with | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id ctx.bodyTgt.locals.length | _ => true))) = true
          rw [s3_storageAnnotInBounds_lowerStmt ctx st hSA, ihS h2.2]; rfl
      have hBodyOk := hBodyOkAux bb.statements h1.1
      unfold lowerBlocksForPtrsLoop
      dsimp
      constructor
      · change ((listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) bb.statements ++
              (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).1).all
              (fun stmt => match stmt with | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id ctx.bodyTgt.locals.length | _ => true) &&
            (lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
              (nextExtra + (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length nextExtra bb.terminator).2.2.length)
              rest).1.all (fun bb => bb.statements.all (fun stmt => match stmt with | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id ctx.bodyTgt.locals.length | _ => true))) = true
        rw [s3b_list_all_append, hBodyOk, hPreOk, ihR.1]; rfl
      · rw [s3b_list_all_append, hExtOk, ihR.2]; rfl
  have hG := hGen ctx.bodySrc.basicBlocks.length ctx.bodySrc.basicBlocks ctx.hAnnot
  have hLenRaw :
      (tombstonePtrDecls ctx.bodySrc.locals ++ ptrCompDecls ctx.plan.entries.length ++ ptrScratchDecls).length =
        ctx.bodyTgt.locals.length := by
    rw [ctx.hBodyTgtEq]
  have hAllForall : ∀ {α : Type} (p : α → Bool) (xs : List α),
      (∀ i x, Trusted.MirSemantics.getElem? xs i = some x → p x = true) → xs.all p = true := by
    intro α p xs h
    induction xs with
    | nil => rfl
    | cons x rest ih =>
      unfold List.all
      rw [h 0 x rfl, ih (fun i y hy => h (i + 1) y hy)]
      rfl
  rw [hLenRaw]
  refine (bool_and_eq_true _ _).mpr ⟨?_, ?_⟩
  · apply hAllForall
    intro bIdx bb hBB
    apply hAllForall
    intro sIdx st hSt
    have hBB' := s3_list_all_getElem? _ _ bIdx bb hG.1 hBB
    have hSt' := s3_list_all_getElem? _ _ sIdx st hBB' hSt
    cases st with
    | baseStmt bs => cases bs <;> exact hSt'
    | bufLivenessCheck _ | mkNullPtr _ | mkDanglingPtr _ _ | addrOfByteBuf _ _ | copyPtr _ _ _ | ptrWrappingOffset _ _ _ _ => exact hSt'
  · apply hAllForall
    intro bIdx bb hBB
    apply hAllForall
    intro sIdx st hSt
    have hBB' := s3_list_all_getElem? _ _ bIdx bb hG.2 hBB
    have hSt' := s3_list_all_getElem? _ _ sIdx st hBB' hSt
    cases st with
    | baseStmt bs => cases bs <;> exact hSt'
    | bufLivenessCheck _ | mkNullPtr _ | mkDanglingPtr _ _ | addrOfByteBuf _ _ | copyPtr _ _ _ | ptrWrappingOffset _ _ _ _ => exact hSt'

private theorem s3_allMemCopyLocalsSupported_bodyTgt_eq (ctx : s3_PtrCtx) :
    allMemCopyLocalsSupported ctx.bodyTgt.argumentCount ctx.bodyTgt.acceptsCallerMem 0 ctx.bodyTgt.locals =
      allMemCopyLocalsSupported ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem 0 ctx.bodySrc.locals := by
  have hSpec := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
    ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
  have hPtrGt : ∀ (i : Nat), Trusted.MirSemantics.getElem? ctx.bodySrc.locals i = some .ptrLocal →
      ctx.bodySrc.argumentCount < i := by
    intro i hPtr
    cases hSpec.2.1 i hPtr with
    | intro j hj =>
      cases hj with
      | intro e he =>
        have hEB := s3_ptrEntry_bounds ctx j e he.1
        rw [Nat.zero_add] at he
        rw [he.2] at hEB
        exact hEB.1
  have hTomb : ∀ (idx : Nat) (ds : List MemCopyLocalDecl),
      (∀ i, Trusted.MirSemantics.getElem? ds i = some .ptrLocal → ctx.bodySrc.argumentCount < idx + i) →
      allMemCopyLocalsSupported ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem idx (tombstonePtrDecls ds) =
        allMemCopyLocalsSupported ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem idx ds := by
    intro idx ds hds
    induction ds generalizing idx with
    | nil => rfl
    | cons d rest ih =>
      have hTail := ih (idx + 1) (fun i hG => by
        have h := hds (i + 1) hG
        rw [Nat.add_comm i 1, ← Nat.add_assoc] at h
        exact h)
      cases d with
      | base _ | byteBuf _ _ _ =>
        unfold tombstonePtrDecls allMemCopyLocalsSupported
        rw [hTail]
      | ptrLocal =>
        have hGt := hds 0 rfl
        rw [Nat.add_zero] at hGt
        have hNe0 : Nat.beq idx 0 = false :=
          s3b_nat_beq_false_of_ne (fun h0 => by rw [h0] at hGt; exact Nat.not_lt_zero _ hGt)
        have hNotLe : Nat.ble idx ctx.bodySrc.argumentCount = false := by
          cases hBle : Nat.ble idx ctx.bodySrc.argumentCount with
          | false => rfl
          | true => exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hBle) hGt)
        have hIsPtr : isSupportedMemCopyLocalDecl ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem idx .ptrLocal = true := by
          unfold isSupportedMemCopyLocalDecl
          rw [hNe0, hNotLe]; rfl
        have hIsUnit : isSupportedMemCopyLocalDecl ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem idx (.base .unit) = true := rfl
        unfold tombstonePtrDecls allMemCopyLocalsSupported
        rw [hIsUnit, hIsPtr, Bool.true_and, Bool.true_and]
        exact hTail
  have hComp : ∀ (idx k : Nat),
      allMemCopyLocalsSupported ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem idx (ptrCompDecls k) = true := by
    intro idx k
    induction k generalizing idx with
    | zero => rfl
    | succ k' ih =>
      unfold ptrCompDecls allMemCopyLocalsSupported
      have hZ1 : isSupportedMemCopyLocalDecl ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem (idx + 1) (.base usizeTy) = true := rfl
      have hZ2 : isSupportedMemCopyLocalDecl ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem (idx + 1 + 1) (.base usizeTy) = true := rfl
      change (true && (isSupportedMemCopyLocalDecl ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem (idx + 1) (.base usizeTy) &&
        (isSupportedMemCopyLocalDecl ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem (idx + 1 + 1) (.base usizeTy) &&
          allMemCopyLocalsSupported ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem (idx + 1 + 1 + 1) (ptrCompDecls k')))) = true
      rw [hZ1, hZ2, ih (idx + 1 + 1 + 1)]; rfl
  have hScr : ∀ (idx : Nat),
      allMemCopyLocalsSupported ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem idx ptrScratchDecls = true := by
    intro idx; rfl
  rw [ctx.hBodyTgtEq]; dsimp
  have hAppDirect : ∀ (argCount : Nat) (accMem : Bool) (idx : Nat) (xs ys : List MemCopyLocalDecl),
      allMemCopyLocalsSupported argCount accMem (idx + xs.length) ys = true →
      allMemCopyLocalsSupported argCount accMem idx (xs ++ ys) =
        allMemCopyLocalsSupported argCount accMem idx xs := by
    intro argCount accMem idx xs ys hy
    induction xs generalizing idx with
    | nil =>
      change allMemCopyLocalsSupported argCount accMem (idx + 0) ys = true at hy
      rw [Nat.add_zero] at hy
      change allMemCopyLocalsSupported argCount accMem idx ys = true
      exact hy
    | cons x rest ih =>
      have hy' : allMemCopyLocalsSupported argCount accMem ((idx + 1) + rest.length) ys = true := by
        change allMemCopyLocalsSupported argCount accMem (idx + (rest.length + 1)) ys = true at hy
        rw [Nat.add_comm rest.length 1, ← Nat.add_assoc] at hy
        exact hy
      change (isSupportedMemCopyLocalDecl argCount accMem idx x &&
          allMemCopyLocalsSupported argCount accMem (idx + 1) (rest ++ ys)) =
        (isSupportedMemCopyLocalDecl argCount accMem idx x &&
          allMemCopyLocalsSupported argCount accMem (idx + 1) rest)
      rw [ih (idx + 1) hy']
  rw [List.append_assoc]
  have hCompScr : allMemCopyLocalsSupported ctx.bodySrc.argumentCount ctx.bodySrc.acceptsCallerMem
      (0 + (tombstonePtrDecls ctx.bodySrc.locals).length)
      (ptrCompDecls ctx.plan.entries.length ++ ptrScratchDecls) = true := by
    rw [hAppDirect _ _ _ (ptrCompDecls ctx.plan.entries.length) ptrScratchDecls (hScr _)]
    exact hComp _ _
  rw [hAppDirect _ _ 0 (tombstonePtrDecls ctx.bodySrc.locals) _ hCompScr]
  exact hTomb 0 ctx.bodySrc.locals (fun i hG => by rw [Nat.zero_add]; exact hPtrGt i hG)

private theorem s3_intWidth_beq_refl : ∀ w : IntWidth, IntWidth.beq w w = true
  | .i8 | .i16 | .i32 | .i64 | .i128 | .isize => rfl

private theorem s3_natListBeq_refl : ∀ xs : List Nat, natListBeq xs xs = true
  | [] => rfl
  | x :: xs => by
    change (Nat.beq x x && natListBeq xs xs) = true
    rw [nat_beq_refl, s3_natListBeq_refl xs]
    rfl

private theorem s3_enumTagRepr_beq_refl : ∀ r : EnumTagRepr, EnumTagRepr.beq r r = true
  | .zeroSized => rfl
  | .scalar w s => by cases w <;> cases s <;> rfl

private theorem s3b_bool_beq_refl : ∀ a : Bool, (a == a) = true
  | true => rfl
  | false => rfl

private theorem s3_enumTy_beq_refl (ety : EnumTy) : EnumTy.beq ety ety = true := by
  change (Nat.beq ety.id ety.id && IntWidth.beq ety.discrWidth ety.discrWidth &&
      (ety.discrSigned == ety.discrSigned) && EnumTagRepr.beq ety.tagRepr ety.tagRepr &&
      natListBeq ety.discriminants ety.discriminants) = true
  rw [nat_beq_refl, s3_intWidth_beq_refl, s3b_bool_beq_refl, s3_enumTagRepr_beq_refl, s3_natListBeq_refl]
  rfl

private theorem s3_mirTy_beq_refl_base (ty : MirTy) (hPrim : match ty with
    | .bool | .int _ _ | .unit | .never | .enum _ | .unsupported => True | _ => False) :
    MirTy.beq ty ty = true := by
  cases ty with
  | bool | unit | never | unsupported => rfl
  | int w s =>
    change (IntWidth.beq w w && (s == s)) = true
    rw [s3_intWidth_beq_refl, s3b_bool_beq_refl]; rfl
  | enum ety =>
    change EnumTy.beq ety ety = true
    exact s3_enumTy_beq_refl ety
  | tuple _ | ref _ _ | rawPtr _ _ => exact False.elim hPrim

private theorem s3_checkMemCopyArgsMatch_base_wf :
    ∀ (extMem : CallerMemory) (vs : List Val) (ds : List MemCopyLocalDecl) (i : Nat) (v : Val) (ty : MirTy),
      checkMemCopyArgsMatch false extMem vs ds = true →
      Trusted.MirSemantics.getElem? vs i = some v →
      Trusted.MirSemantics.getElem? ds i = some (.base ty) →
      checkVal v ty = true
  | _, [], [], _, _, _, _, hV, _ => by cases hV
  | _, [], _ :: _, _, _, _, h, _, _ => by cases h
  | _, _ :: _, [], _, _, _, h, _, _ => by cases h
  | extMem, v0 :: vs, d0 :: ds, 0, v, ty, h, hV, hD => by
    cases hV; cases hD
    unfold checkMemCopyArgsMatch checkMemCopyArgVal at h
    exact ((bool_and_eq_true _ _).mp h).1
  | extMem, v0 :: vs, d0 :: ds, i + 1, v, ty, h, hV, hD => by
    unfold checkMemCopyArgsMatch at h
    exact s3_checkMemCopyArgsMatch_base_wf extMem vs ds i v ty ((bool_and_eq_true _ _).mp h).2 hV hD

private theorem s3_initMemCopyLocalsLoop_length (body : MemCopyBody) (args : List Val) :
    ∀ (idx : Nat) (ds : List MemCopyLocalDecl),
      (initMemCopyLocalsLoop body args idx ds).length = ds.length
  | _, [] => rfl
  | idx, _ :: ds => by
    change (initMemCopyLocalsLoop body args (idx + 1) ds).length + 1 = ds.length + 1
    rw [s3_initMemCopyLocalsLoop_length body args (idx + 1) ds]

private theorem s3_initMemCopyLocalsLoop_getElem? (body : MemCopyBody) (args : List Val) :
    ∀ (idx i : Nat) (ds : List MemCopyLocalDecl) (decl : MemCopyLocalDecl),
      Trusted.MirSemantics.getElem? ds i = some decl →
      Trusted.MirSemantics.getElem? (initMemCopyLocalsLoop body args idx ds) i =
        some (
          if Nat.beq (idx + i) 0 then
            liveUninitMemCopySlot decl
          else if Nat.ble (idx + i) body.argumentCount then
            match Trusted.MirSemantics.getElem? args ((idx + i) - 1), decl with
            | some (.ptr pv), .ptrLocal => .livePtr (some pv)
            | some v, .base _ => .baseSlot (.live (some v))
            | _, _ => deadMemCopySlot decl
          else if memCopyHasStorageAnnotation body (idx + i) then
            deadMemCopySlot decl
          else
            liveUninitMemCopySlot decl)
  | _, _, [], _, h => by cases h
  | idx, 0, d :: ds, decl, h => by
    cases h
    rw [Nat.add_zero]
    rfl
  | idx, i + 1, _ :: ds, decl, h => by
    have ih := s3_initMemCopyLocalsLoop_getElem? body args (idx + 1) i ds decl h
    have hIdx : idx + 1 + i = idx + (i + 1) := by rw [Nat.add_assoc, Nat.add_comm 1 i]
    rw [hIdx] at ih
    exact ih

private theorem s3_findAlloc?_buildInternalBufAllocs (body : MemCopyBody) :
    ∀ (idx bLoc sz al : Nat) (mutab : Mutability) (ds : List MemCopyLocalDecl),
      Trusted.MirSemantics.getElem? ds bLoc = some (.byteBuf sz al mutab) →
      findAlloc? (internalAllocBase + (idx + bLoc)) (buildInternalBufAllocs body idx ds) =
        some {
          allocId := internalAllocBase + (idx + bLoc)
          alignLog2 := al
          mutability := mutab
          bytes := listReplicate sz .uninit
          live := !memCopyHasStorageAnnotation body (idx + bLoc)
        }
  | _, _, _, _, _, [], h => by cases h
  | idx, 0, sz, al, mutab, d :: ds, h => by
    cases h
    rw [Nat.add_zero]
    unfold buildInternalBufAllocs findAlloc?
    rw [nat_beq_refl]
    rfl
  | idx, bLoc + 1, sz, al, mutab, d :: ds, h => by
    have ih := s3_findAlloc?_buildInternalBufAllocs body (idx + 1) bLoc sz al mutab ds h
    have hIdx : idx + 1 + bLoc = idx + (bLoc + 1) := by rw [Nat.add_assoc, Nat.add_comm 1 bLoc]
    rw [hIdx] at ih
    cases d with
    | base _ | ptrLocal =>
      unfold buildInternalBufAllocs
      exact ih
    | byteBuf _ _ _ =>
      have hNe : internalAllocBase + idx ≠ internalAllocBase + (idx + (bLoc + 1)) := by
        intro hEq
        have h1 : idx = idx + (bLoc + 1) := Nat.add_left_cancel hEq
        have h2 : 0 = bLoc + 1 := by
          have h3 : idx + 0 = idx + (bLoc + 1) := by rw [Nat.add_zero]; exact h1
          exact Nat.add_left_cancel h3
        cases h2
      unfold buildInternalBufAllocs findAlloc?
      dsimp
      rw [s3b_nat_beq_false_of_ne hNe]
      exact ih

private theorem s3_buildInternalBufAllocs_append (body : MemCopyBody) :
    ∀ (idx : Nat) (xs ys : List MemCopyLocalDecl),
      buildInternalBufAllocs body idx (xs ++ ys) =
        buildInternalBufAllocs body idx xs ++
          buildInternalBufAllocs body (idx + xs.length) ys
  | idx, [], ys => rfl
  | idx, x :: xs, ys => by
    have ih := s3_buildInternalBufAllocs_append body (idx + 1) xs ys
    have hIdx : idx + 1 + xs.length = idx + (x :: xs).length := by
      change idx + 1 + xs.length = idx + (xs.length + 1)
      rw [Nat.add_assoc, Nat.add_comm 1 xs.length]
    rw [hIdx] at ih
    cases x with
    | base _ | ptrLocal =>
      exact ih
    | byteBuf _ _ _ =>
      exact congrArg (List.cons _) ih

private theorem s3_buildInternalBufAllocs_ptrCompDecls_nil (body : MemCopyBody) :
    ∀ (idx k : Nat), buildInternalBufAllocs body idx (ptrCompDecls k) = []
  | _, 0 => rfl
  | idx, k + 1 => by
    unfold ptrCompDecls buildInternalBufAllocs
    exact s3_buildInternalBufAllocs_ptrCompDecls_nil body (idx + 1 + 1 + 1) k

private theorem s3_buildInternalBufAllocs_ptrScratchDecls_nil (body : MemCopyBody) (idx : Nat) :
    buildInternalBufAllocs body idx ptrScratchDecls = [] := rfl

private theorem s3_buildInternalBufAllocs_bodyTgt (ctx : s3_PtrCtx) :
    buildInternalBufAllocs ctx.bodyTgt 0 ctx.bodyTgt.locals =
      buildInternalBufAllocs ctx.bodySrc 0 ctx.bodySrc.locals := by
  have hTomb : ∀ (idx : Nat) (ds : List MemCopyLocalDecl),
      (∀ i sz al mutab, Trusted.MirSemantics.getElem? ds i = some (.byteBuf sz al mutab) →
        idx + i < ctx.bodySrc.locals.length ∧
        Trusted.MirSemantics.getElem? ctx.bodySrc.locals (idx + i) = some (.byteBuf sz al mutab)) →
      buildInternalBufAllocs ctx.bodyTgt idx (tombstonePtrDecls ds) =
        buildInternalBufAllocs ctx.bodySrc idx ds := by
    intro idx ds hds
    induction ds generalizing idx with
    | nil => rfl
    | cons d rest ih =>
      have hTail := ih (idx + 1) (fun i sz al mutab hG => by
        have h := hds (i + 1) sz al mutab hG
        rw [Nat.add_comm i 1, ← Nat.add_assoc] at h
        exact h)
      cases d with
      | base _ | ptrLocal =>
        unfold tombstonePtrDecls buildInternalBufAllocs
        exact hTail
      | byteBuf sz al mutab =>
        have hB := hds 0 sz al mutab rfl
        rw [Nat.add_zero] at hB
        have hNonPtr : Trusted.MirSemantics.getElem? ctx.bodySrc.locals idx ≠ some .ptrLocal := by
          intro hEq; rw [hB.2] at hEq; cases hEq
        unfold tombstonePtrDecls buildInternalBufAllocs
        rw [s3_memCopyHasStorageAnnotation_bodyTgt_nonPtr ctx idx hB.1 hNonPtr, hTail]
  rw [ctx.hBodyTgtEq]; dsimp
  rw [s3_buildInternalBufAllocs_append, s3_buildInternalBufAllocs_append]
  rw [s3_buildInternalBufAllocs_ptrCompDecls_nil, s3_buildInternalBufAllocs_ptrScratchDecls_nil]
  rw [List.append_nil, List.append_nil]
  have hRes := hTomb 0 ctx.bodySrc.locals (fun i sz al mutab hG => by
    rw [Nat.zero_add]
    exact ⟨s3_getElem?_some_lt _ _ _ hG, hG⟩)
  rw [ctx.hBodyTgtEq] at hRes
  exact hRes

private theorem s3_paramDecls_bodyTgt (ctx : s3_PtrCtx) :
    (ctx.bodyTgt.locals.drop 1).take ctx.bodySrc.argumentCount =
      (ctx.bodySrc.locals.drop 1).take ctx.bodySrc.argumentCount := by
  have hSpec := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
    ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
  have hLen1 : ((ctx.bodyTgt.locals.drop 1).take ctx.bodySrc.argumentCount).length = ctx.bodySrc.argumentCount := by
    apply s3_take_length_le
    rw [s3_list_drop_length, s3_bodyTgt_locals_length]
    have hGe : ctx.bodySrc.argumentCount + 1 ≤ ctx.bodySrc.locals.length := ctx.hArgLt
    have hLe : ctx.bodySrc.argumentCount ≤ ctx.bodySrc.locals.length - 1 := by
      rw [← Nat.add_sub_cancel ctx.bodySrc.argumentCount 1]
      exact Nat.sub_le_sub_right hGe 1
    exact Nat.le_trans hLe (Nat.sub_le_sub_right (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)) 1)
  apply s3_list_ext_mirGetElem?
  intro i
  cases Nat.lt_or_ge i ctx.bodySrc.argumentCount with
  | inr hGe =>
    have hGe1 : ((ctx.bodyTgt.locals.drop 1).take ctx.bodySrc.argumentCount).length ≤ i := by
      rw [hLen1]; exact hGe
    have hGe2 : ((ctx.bodySrc.locals.drop 1).take ctx.bodySrc.argumentCount).length ≤ i := by
      exact Nat.le_trans (s3b_take_length_le_self _ _) hGe
    rw [s3_getElem?_ge_none _ i hGe1, s3_getElem?_ge_none _ i hGe2]
  | inl hi =>
    rw [s3_take_getElem? _ _ i hi, s3_take_getElem? _ _ i hi]
    rw [s3_drop_getElem?, s3_drop_getElem?]
    have hLtSrc : 1 + i < ctx.bodySrc.locals.length := by
      rw [Nat.add_comm]; exact Nat.lt_of_le_of_lt (Nat.succ_le_of_lt hi) ctx.hArgLt
    rw [s3_bodyTgt_locals_base ctx (1 + i) hLtSrc]
    cases hG : Trusted.MirSemantics.getElem? ctx.bodySrc.locals (1 + i) with
    | none => rfl
    | some dl =>
      cases dl with
      | base _ | byteBuf _ _ _ => rfl
      | ptrLocal =>
        cases hSpec.2.1 (1 + i) hG with
        | intro k hk =>
          cases hk with
          | intro e he =>
            have hEB := s3_ptrEntry_bounds ctx k e he.1
            rw [Nat.zero_add] at he
            rw [he.2] at hEB
            have hLe : 1 + i ≤ ctx.bodySrc.argumentCount := by rw [Nat.add_comm]; exact hi
            exact False.elim (Nat.not_lt_of_le hLe hEB.1)

private theorem s3_initStateMemCopy_simRel (ctx : s3_PtrCtx) (q : Query) :
    match initStateMemCopy ctx.pSrc q, initStateMemCopy ctx.pTgt q with
    | .ok s₁, .ok s₂ => s3_SimRel ctx ctx.pSrc ctx.pTgt s₁ s₂
    | .error k₁, .error k₂ => k₁ = k₂
    | _, _ => False := by
  have hNoEntry := s3b_getElem?_setElem?_ne ctx.pSrc.bodies ctx.plan.defId ctx.bodyTgt ctx.pTgt.bodies
  cases hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId with
  | false =>
    have hNeId : ctx.plan.defId ≠ ctx.pSrc.entryDefId := nat_beq_false_ne hEqId
    have hBodySame : Trusted.MirSemantics.getElem? ctx.pTgt.bodies ctx.pSrc.entryDefId =
        Trusted.MirSemantics.getElem? ctx.pSrc.bodies ctx.pSrc.entryDefId :=
      hNoEntry ctx.pSrc.entryDefId hNeId ctx.hSetBody
    unfold initStateMemCopy
    rw [ctx.hPtgtOther.1, ctx.hPtgtOther.2.1, ctx.hPtgtOther.2.2, hBodySame]
    cases Trusted.MirSemantics.getElem? ctx.pSrc.bodies ctx.pSrc.entryDefId with
    | none =>
      cases !Nat.beq ctx.pSrc.pointerWidthBits 64 || !Nat.beq ctx.pSrc.mirProfileVersion 1 <;> rfl
    | some b =>
      dsimp
      cases !Nat.beq ctx.pSrc.pointerWidthBits 64 || !Nat.beq ctx.pSrc.mirProfileVersion 1 with
      | true => rfl
      | false =>
        dsimp
        cases !b.acceptsCallerMem && !q.callerMem.allocations.isEmpty with
        | true => rfl
        | false =>
          cases b.acceptsCallerMem && !wfExternalCallerMem q.callerMem with
          | true => rfl
          | false =>
            cases b.basicBlocks.isEmpty with
            | true => rfl
            | false =>
              cases !Nat.blt b.argumentCount b.locals.length with
              | true => rfl
              | false =>
                cases !memCopyStorageAnnotationsInBounds b with
                | true => rfl
                | false =>
                  cases !allMemCopyLocalsSupported b.argumentCount b.acceptsCallerMem 0 b.locals with
                  | true => rfl
                  | false =>
                    cases !checkMemCopyArgsMatch b.acceptsCallerMem q.callerMem q.args ((b.locals.drop 1).take b.argumentCount) with
                    | true => rfl
                    | false =>
                      dsimp
                      unfold s3_SimRel
                      rw [hEqId]
                      dsimp
                      refine ⟨rfl, ?_⟩
                      intro f hf
                      cases hf
                      rfl
  | true =>
    have hIdEq : ctx.plan.defId = ctx.pSrc.entryDefId := nat_beq_eq _ _ hEqId
    have hBodyTgtGet : Trusted.MirSemantics.getElem? ctx.pTgt.bodies ctx.pTgt.entryDefId = some ctx.bodyTgt := by
      rw [ctx.hPtgtOther.2.2, ← hIdEq]
      exact s3_getElem?_setElem?_eq ctx.pSrc.bodies ctx.plan.defId ctx.bodyTgt ctx.pTgt.bodies ctx.hSetBody
    have hBodySrcGet : Trusted.MirSemantics.getElem? ctx.pSrc.bodies ctx.pSrc.entryDefId = some ctx.bodySrc := by
      rw [← hIdEq]; exact ctx.hBodies
    have hNonEmptyTgt : ctx.bodyTgt.basicBlocks.isEmpty = false := by
      rw [ctx.hBodyTgtEq]; dsimp
      have hL1 := (s3_lowerBlocksForPtrsLoop_spec ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
          ctx.bodySrc.basicBlocks.length ctx.bodySrc.basicBlocks).1
      cases hBbs : ctx.bodySrc.basicBlocks with
      | nil =>
        have hNE := ctx.hNonEmpty
        rw [hBbs] at hNE
        cases hNE
      | cons bb rest =>
        cases hL : (lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
            (bb :: rest).length (bb :: rest)).1 with
        | nil =>
          rw [hBbs] at hL1
          rw [hL] at hL1
          cases hL1
        | cons _ _ => rfl
    have hArgLtTgt : ctx.bodyTgt.argumentCount < ctx.bodyTgt.locals.length := by
      have hAcEq : ctx.bodyTgt.argumentCount = ctx.bodySrc.argumentCount := by rw [ctx.hBodyTgtEq]
      rw [hAcEq, s3_bodyTgt_locals_length]
      exact Nat.lt_of_lt_of_le ctx.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
    have hNoCallerTgt : ctx.bodyTgt.acceptsCallerMem = false := by rw [ctx.hBodyTgtEq]; exact ctx.hNoCaller
    have hAcEq : ctx.bodyTgt.argumentCount = ctx.bodySrc.argumentCount := by rw [ctx.hBodyTgtEq]
    unfold initStateMemCopy
    rw [ctx.hPtgtOther.1, ctx.hPtgtOther.2.1, hBodySrcGet, hBodyTgtGet]
    cases !Nat.beq ctx.pSrc.pointerWidthBits 64 || !Nat.beq ctx.pSrc.mirProfileVersion 1 with
    | true => rfl
    | false =>
      dsimp
      rw [ctx.hNoCaller, hNoCallerTgt]; dsimp
      cases hEmpty : q.callerMem.allocations.isEmpty with
      | false => rfl
      | true =>
        dsimp
        rw [ctx.hNonEmpty, hNonEmptyTgt]; dsimp
        rw [(nat_blt_eq_lt _ _).mpr ctx.hArgLt, (nat_blt_eq_lt _ _).mpr hArgLtTgt]; dsimp
        rw [ctx.hAnnot, s3_memCopyStorageAnnotationsInBounds_bodyTgt ctx]; dsimp
        have hAllSuppEq := s3_allMemCopyLocalsSupported_bodyTgt_eq ctx
        rw [ctx.hNoCaller, hNoCallerTgt] at hAllSuppEq
        rw [hAllSuppEq]
        cases hAllSupp : allMemCopyLocalsSupported ctx.bodySrc.argumentCount false 0 ctx.bodySrc.locals with
        | false => rfl
        | true =>
          dsimp
          rw [hAcEq, s3_paramDecls_bodyTgt ctx]
          cases hArgsOk : checkMemCopyArgsMatch false q.callerMem q.args ((ctx.bodySrc.locals.drop 1).take ctx.bodySrc.argumentCount) with
          | false => rfl
          | true =>
            dsimp
            unfold s3_SimRel
            rw [hEqId]; dsimp
            have hEmptyAlloc : q.callerMem.allocations = [] := by
              cases hA : q.callerMem.allocations with
              | nil => rfl
              | cons _ _ => rw [hA] at hEmpty; cases hEmpty
            have hBb0 : 0 < ctx.bodySrc.basicBlocks.length := by
              cases hBbs : ctx.bodySrc.basicBlocks with
              | nil =>
                have hNE := ctx.hNonEmpty
                rw [hBbs] at hNE
                cases hNE
              | cons _ _ => exact Nat.zero_lt_succ _
            cases s3_getElem?_lt_some ctx.bodySrc.basicBlocks 0 hBb0 with
            | intro bb0 hBb0Get =>
              have hMemEq : q.callerMem.allocations ++ buildInternalBufAllocs ctx.bodyTgt 0 ctx.bodyTgt.locals =
                  buildInternalBufAllocs ctx.bodySrc 0 ctx.bodySrc.locals := by
                rw [hEmptyAlloc, List.nil_append, s3_buildInternalBufAllocs_bodyTgt ctx]
              have hMemEq1 : q.callerMem.allocations ++ buildInternalBufAllocs ctx.bodySrc 0 ctx.bodySrc.locals =
                  buildInternalBufAllocs ctx.bodySrc 0 ctx.bodySrc.locals := by
                rw [hEmptyAlloc, List.nil_append]
              rw [hMemEq, hMemEq1]
              refine ⟨_, _, _, bb0, rfl, rfl, hIdEq.symm, ctx.hPtgtOther.2.2.trans hIdEq.symm, rfl, hBb0Get, Nat.zero_le _, rfl, ?_, ?_⟩
              · refine ⟨s3_initMemCopyLocalsLoop_length ctx.bodySrc q.args 0 ctx.bodySrc.locals, ?_, ?_⟩
                · intro bLoc sz al mutab hB
                  have hSlot := s3_initMemCopyLocalsLoop_getElem? ctx.bodySrc q.args 0 bLoc ctx.bodySrc.locals (.byteBuf sz al mutab) hB
                  rw [Nat.zero_add] at hSlot
                  have hSpec := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
                    ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
                  have hBufSpec := hSpec.2.2.1 bLoc sz al mutab hB
                  rw [Nat.zero_add] at hBufSpec
                  have hNe0 : Nat.beq bLoc 0 = false :=
                    s3b_nat_beq_false_of_ne (fun h0 => by rw [h0] at hBufSpec; exact Nat.not_lt_zero _ hBufSpec.1)
                  have hNotLe : Nat.ble bLoc ctx.bodySrc.argumentCount = false := by
                    cases hBle : Nat.ble bLoc ctx.bodySrc.argumentCount with
                    | false => rfl
                    | true => exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hBle) hBufSpec.1)
                  rw [hNe0, hNotLe] at hSlot; dsimp at hSlot
                  have hFa := s3_findAlloc?_buildInternalBufAllocs ctx.bodySrc 0 bLoc sz al mutab ctx.bodySrc.locals hB
                  rw [Nat.zero_add] at hFa
                  cases hAnn : memCopyHasStorageAnnotation ctx.bodySrc bLoc with
                  | true =>
                    rw [hAnn] at hSlot hFa; dsimp at hSlot hFa
                    refine ⟨false, _, hSlot, hFa, rfl, rfl, rfl, (fun h => by cases h), s3_allocBytesTagBounded_replicate_uninit sz⟩
                  | false =>
                    rw [hAnn] at hSlot hFa; dsimp at hSlot hFa
                    refine ⟨true, _, hSlot, hFa, rfl, rfl, rfl, (fun _ => s3_listReplicate_length sz AllocByte.uninit), s3_allocBytesTagBounded_replicate_uninit sz⟩
                · intro id ty v hDecl hSlot
                  have hInit := s3_initMemCopyLocalsLoop_getElem? ctx.bodySrc q.args 0 id ctx.bodySrc.locals (.base ty) hDecl
                  rw [Nat.zero_add, hSlot] at hInit
                  have hLiveUninit : ∀ t, liveUninitSlot t = .live (some v) → checkVal v t = true := by
                    intro t ht
                    cases t with
                    | unit => unfold liveUninitSlot at ht; cases ht; rfl
                    | enum ety =>
                      unfold liveUninitSlot at ht
                      dsimp at ht
                      cases hZ : isZstEnumTy ety with
                      | false => rw [hZ] at ht; cases ht
                      | true =>
                        rw [hZ] at ht; cases ht
                        unfold isZstEnumTy at hZ
                        cases hTR : ety.tagRepr with
                        | scalar _ _ => rw [hTR] at hZ; cases hZ
                        | zeroSized =>
                          rw [hTR] at hZ
                          have hAdm : enumAdmitted ety = true := hZ
                          have hAdmZ : enumAdmitted ety = true := hZ
                          unfold enumAdmitted at hAdm
                          have h1 := (bool_and_eq_true _ _).mp hAdm
                          have h2 := (bool_and_eq_true _ _).mp h1.1
                          have h3 := (bool_and_eq_true _ _).mp h2.1
                          have h4 := (bool_and_eq_true _ _).mp h3.1
                          have hNeEmpty := (bool_not_eq_true _).mp h4.1
                          have hPos : 0 < ety.discriminants.length := by
                            cases hD : ety.discriminants with
                            | nil => rw [hD] at hNeEmpty; cases hNeEmpty
                            | cons _ _ => exact Nat.zero_lt_succ _
                          unfold checkVal Val.ty?
                          dsimp
                          rw [hAdmZ, (nat_blt_eq_lt _ _).mpr hPos]; dsimp
                          exact s3_mirTy_beq_refl_base (.enum ety) True.intro
                    | bool | int _ _ | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported =>
                      unfold liveUninitSlot at ht; cases ht
                  cases hEq0 : Nat.beq id 0 with
                  | true =>
                    rw [hEq0] at hInit; dsimp at hInit
                    injection hInit with hIn1
                    unfold liveUninitMemCopySlot at hIn1
                    injection hIn1 with hIn2
                    exact hLiveUninit ty hIn2.symm
                  | false =>
                    rw [hEq0] at hInit; dsimp at hInit
                    cases hBle : Nat.ble id ctx.bodySrc.argumentCount with
                    | true =>
                      rw [hBle] at hInit; dsimp at hInit
                      have hIdPos : 0 < id := Nat.pos_of_ne_zero (nat_beq_false_ne hEq0)
                      have hId1Lt : id - 1 < ctx.bodySrc.argumentCount := by
                        have hLe := (nat_ble_eq_le _ _).mp hBle
                        cases id with
                        | zero => cases hIdPos
                        | succ id' => exact hLe
                      have hParam : Trusted.MirSemantics.getElem? ((ctx.bodySrc.locals.drop 1).take ctx.bodySrc.argumentCount) (id - 1) =
                          some (.base ty) := by
                        rw [s3_take_getElem? _ _ (id - 1) hId1Lt, s3_drop_getElem?]
                        have hEq1 : 1 + (id - 1) = id := by rw [Nat.add_comm]; exact Nat.sub_add_cancel hIdPos
                        rw [hEq1]; exact hDecl
                      cases hArg : Trusted.MirSemantics.getElem? q.args (id - 1) with
                      | none => rw [hArg] at hInit; cases hInit
                      | some av =>
                        rw [hArg] at hInit
                        cases av <;> cases hInit <;>
                          exact s3_checkMemCopyArgsMatch_base_wf q.callerMem q.args _ (id - 1) _ ty hArgsOk hArg hParam
                    | false =>
                      rw [hBle] at hInit; dsimp at hInit
                      cases hAnn : memCopyHasStorageAnnotation ctx.bodySrc id with
                      | true => rw [hAnn] at hInit; cases hInit
                      | false =>
                        rw [hAnn] at hInit; dsimp at hInit
                        injection hInit with hIn1
                        unfold liveUninitMemCopySlot at hIn1
                        injection hIn1 with hIn2
                        exact hLiveUninit ty hIn2.symm
              · refine ⟨s3_initMemCopyLocalsLoop_length ctx.bodySrc q.args 0 ctx.bodySrc.locals,
                    s3_initMemCopyLocalsLoop_length ctx.bodyTgt q.args 0 ctx.bodyTgt.locals, ?_, ?_, ?_, ?_⟩
                · intro id ty hDecl
                  have hIdLt : id < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
                  have hNonPtr : Trusted.MirSemantics.getElem? ctx.bodySrc.locals id ≠ some .ptrLocal := fun h => by
                    rw [h] at hDecl; cases hDecl
                  have hDeclTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals id = some (.base ty) := by
                    rw [s3_bodyTgt_locals_base ctx id hIdLt, hDecl]
                  have hS1 := s3_initMemCopyLocalsLoop_getElem? ctx.bodySrc q.args 0 id ctx.bodySrc.locals (.base ty) hDecl
                  have hS2 := s3_initMemCopyLocalsLoop_getElem? ctx.bodyTgt q.args 0 id ctx.bodyTgt.locals (.base ty) hDeclTgt
                  rw [Nat.zero_add] at hS1 hS2
                  rw [hS1, hS2, hAcEq, s3_memCopyHasStorageAnnotation_bodyTgt_nonPtr ctx id hIdLt hNonPtr]
                · intro bLoc sz al mutab hB
                  have hBLt : bLoc < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hB
                  have hNonPtr : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bLoc ≠ some .ptrLocal := fun h => by
                    rw [h] at hB; cases hB
                  have hDeclTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals bLoc = some (.byteBuf sz al mutab) := by
                    rw [s3_bodyTgt_locals_base ctx bLoc hBLt, hB]
                  have hS1 := s3_initMemCopyLocalsLoop_getElem? ctx.bodySrc q.args 0 bLoc ctx.bodySrc.locals (.byteBuf sz al mutab) hB
                  have hS2 := s3_initMemCopyLocalsLoop_getElem? ctx.bodyTgt q.args 0 bLoc ctx.bodyTgt.locals (.byteBuf sz al mutab) hDeclTgt
                  rw [Nat.zero_add] at hS1 hS2
                  rw [hS1, hS2, hAcEq, s3_memCopyHasStorageAnnotation_bodyTgt_nonPtr ctx bLoc hBLt hNonPtr]
                · intro k e hK
                  have hEB := s3_ptrEntry_bounds ctx k e hK
                  have hS1 := s3_initMemCopyLocalsLoop_getElem? ctx.bodySrc q.args 0 e.ptrLocal ctx.bodySrc.locals .ptrLocal hEB.2.2.1
                  rw [Nat.zero_add] at hS1
                  have hNe0 : Nat.beq e.ptrLocal 0 = false :=
                    s3b_nat_beq_false_of_ne (fun h0 => by rw [h0] at hEB; exact Nat.not_lt_zero _ hEB.1)
                  have hNotLe : Nat.ble e.ptrLocal ctx.bodySrc.argumentCount = false := by
                    cases hBle : Nat.ble e.ptrLocal ctx.bodySrc.argumentCount with
                    | false => rfl
                    | true => exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hBle) hEB.1)
                  rw [hNe0, hNotLe] at hS1; dsimp at hS1
                  have hCompDecls := s3_bodyTgt_locals_comp ctx k hEB.2.2.2
                  have hC0 := s3_initMemCopyLocalsLoop_getElem? ctx.bodyTgt q.args 0 (ctx.bodySrc.locals.length + 3 * k) ctx.bodyTgt.locals (.base .unit) hCompDecls.1
                  have hC1 := s3_initMemCopyLocalsLoop_getElem? ctx.bodyTgt q.args 0 (ctx.bodySrc.locals.length + 3 * k + 1) ctx.bodyTgt.locals (.base usizeTy) hCompDecls.2.1
                  have hC2 := s3_initMemCopyLocalsLoop_getElem? ctx.bodyTgt q.args 0 (ctx.bodySrc.locals.length + 3 * k + 2) ctx.bodyTgt.locals (.base usizeTy) hCompDecls.2.2
                  rw [Nat.zero_add] at hC0 hC1 hC2
                  have hCompGt : ∀ r, r < 3 → ctx.bodySrc.argumentCount < ctx.bodySrc.locals.length + 3 * k + r := by
                    intro r hr
                    exact Nat.lt_of_lt_of_le ctx.hArgLt (s3_compOffset_bounds ctx k r hEB.2.2.2 hr).1
                  have hCn0 : Nat.beq (ctx.bodySrc.locals.length + 3 * k) 0 = false :=
                    s3b_nat_beq_false_of_ne (fun h => by have hg := hCompGt 0 (Nat.succ_pos 2); rw [Nat.add_zero, h] at hg; exact Nat.not_lt_zero _ hg)
                  have hCn1 : Nat.beq (ctx.bodySrc.locals.length + 3 * k + 1) 0 = false := by rw [Nat.add_assoc]; rfl
                  have hCn2 : Nat.beq (ctx.bodySrc.locals.length + 3 * k + 2) 0 = false := by rw [Nat.add_assoc]; rfl
                  have hCble0 : Nat.ble (ctx.bodySrc.locals.length + 3 * k) ctx.bodyTgt.argumentCount = false := by
                    rw [hAcEq]
                    cases hB : Nat.ble (ctx.bodySrc.locals.length + 3 * k) ctx.bodySrc.argumentCount with
                    | false => rfl
                    | true =>
                      have hg := hCompGt 0 (Nat.succ_pos 2); rw [Nat.add_zero] at hg
                      exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hB) hg)
                  have hCble1 : Nat.ble (ctx.bodySrc.locals.length + 3 * k + 1) ctx.bodyTgt.argumentCount = false := by
                    rw [hAcEq]
                    cases hB : Nat.ble (ctx.bodySrc.locals.length + 3 * k + 1) ctx.bodySrc.argumentCount with
                    | false => rfl
                    | true => exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hB) (hCompGt 1 (by decide)))
                  have hCble2 : Nat.ble (ctx.bodySrc.locals.length + 3 * k + 2) ctx.bodyTgt.argumentCount = false := by
                    rw [hAcEq]
                    cases hB : Nat.ble (ctx.bodySrc.locals.length + 3 * k + 2) ctx.bodySrc.argumentCount with
                    | false => rfl
                    | true => exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hB) (hCompGt 2 (by decide)))
                  have hA0 := s3_memCopyHasStorageAnnotation_bodyTgt_comp ctx k 0 e hK (Nat.succ_pos 2)
                  rw [Nat.add_zero] at hA0
                  have hA1 := s3_memCopyHasStorageAnnotation_bodyTgt_comp ctx k 1 e hK (by decide)
                  have hA2 := s3_memCopyHasStorageAnnotation_bodyTgt_comp ctx k 2 e hK (by decide)
                  rw [hCn0, hCble0, hA0] at hC0
                  rw [hCn1, hCble1, hA1] at hC1
                  rw [hCn2, hCble2, hA2] at hC2
                  dsimp at hC0 hC1 hC2
                  unfold s3_PtrSlotEntryRel
                  rw [hS1]
                  cases hAnnP : memCopyHasStorageAnnotation ctx.bodySrc e.ptrLocal with
                  | true =>
                    rw [hAnnP] at hC0 hC1 hC2; dsimp at hC0 hC1 hC2
                    exact ⟨hC0, hC1, hC2⟩
                  | false =>
                    rw [hAnnP] at hC0 hC1 hC2; dsimp at hC0 hC1 hC2
                    exact ⟨⟨some .unit, hC0⟩, hC1, hC2⟩
                · intro j hj
                  have hDeclS := s3_bodyTgt_locals_scratch ctx j hj
                  cases hJ10 : Nat.blt j 10 with
                  | true =>
                    rw [hJ10] at hDeclS; dsimp at hDeclS
                    have hSl := s3_initMemCopyLocalsLoop_getElem? ctx.bodyTgt q.args 0 (s3_scrBase ctx + j) ctx.bodyTgt.locals (.base usizeTy) hDeclS
                    rw [Nat.zero_add, s3_memCopyHasStorageAnnotation_bodyTgt_scratch] at hSl
                    have hGt : ctx.bodySrc.argumentCount < s3_scrBase ctx + j :=
                      Nat.lt_of_lt_of_le ctx.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
                    have hN0 : Nat.beq (s3_scrBase ctx + j) 0 = false :=
                      s3b_nat_beq_false_of_ne (fun h => by rw [h] at hGt; exact Nat.not_lt_zero _ hGt)
                    have hNle : Nat.ble (s3_scrBase ctx + j) ctx.bodyTgt.argumentCount = false := by
                      rw [hAcEq]
                      cases hB : Nat.ble (s3_scrBase ctx + j) ctx.bodySrc.argumentCount with
                      | false => rfl
                      | true => exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hB) hGt)
                    rw [hN0, hNle] at hSl; dsimp at hSl
                    exact ⟨none, hSl⟩
                  | false =>
                    rw [hJ10] at hDeclS; dsimp at hDeclS
                    have hSl := s3_initMemCopyLocalsLoop_getElem? ctx.bodyTgt q.args 0 (s3_scrBase ctx + j) ctx.bodyTgt.locals (.base .bool) hDeclS
                    rw [Nat.zero_add, s3_memCopyHasStorageAnnotation_bodyTgt_scratch] at hSl
                    have hGt : ctx.bodySrc.argumentCount < s3_scrBase ctx + j :=
                      Nat.lt_of_lt_of_le ctx.hArgLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
                    have hN0 : Nat.beq (s3_scrBase ctx + j) 0 = false :=
                      s3b_nat_beq_false_of_ne (fun h => by rw [h] at hGt; exact Nat.not_lt_zero _ hGt)
                    have hNle : Nat.ble (s3_scrBase ctx + j) ctx.bodyTgt.argumentCount = false := by
                      rw [hAcEq]
                      cases hB : Nat.ble (s3_scrBase ctx + j) ctx.bodySrc.argumentCount with
                      | false => rfl
                      | true => exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hB) hGt)
                    rw [hN0, hNle] at hSl; dsimp at hSl
                    exact ⟨none, hSl⟩

/-! ## Section 3: Base Operand, Rvalue, & Place Write Equivalence -/

private theorem s3_checkVal_usize_elim (v : Val) (h : checkVal v usizeTy = true) :
    ∃ (n : Nat), n < maxUsize ∧ v = .scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n } := by
  unfold checkVal Val.ty? usizeTy at h
  cases v with
  | bool _ | unit | ptr _ | tuple _ | bytes _ => cases h
  | enumVal ety k =>
    dsimp at h
    cases hCond : enumAdmitted ety && Nat.blt k ety.discriminants.length with
    | false => rw [hCond] at h; cases h
    | true => rw [hCond] at h; cases h
  | scalar sv =>
    dsimp at h
    cases hWf : sv.wf with
    | false => rw [hWf] at h; cases h
    | true =>
      rw [hWf] at h; dsimp at h
      have hMirInt : ∀ w₁ w₂ s₁ s₂,
          MirTy.beq (.int w₁ s₁) (.int w₂ s₂) = (IntWidth.beq w₁ w₂ && (s₁ == s₂)) := fun _ _ _ _ => rfl
      rw [hMirInt] at h
      have h1 := (bool_and_eq_true _ _).mp h
      have hW : sv.width = .isize := by cases hSw : sv.width <;> rw [hSw] at h1 <;> first | rfl | cases h1.1
      have hS : sv.signed = false := by cases hSs : sv.signed <;> rw [hSs] at h1 <;> first | rfl | cases h1.2
      unfold ScalarVal.wf at hWf
      rw [hW] at hWf
      have hTr : truncateBits .isize sv.bits = sv.bits := by
        cases hEq : truncateBits .isize sv.bits == sv.bits with
        | false => rw [hEq] at hWf; cases hWf
        | true => exact eq_of_beq hEq
      have hLt : sv.bits.toNat < maxUsize := by
        have hBitsLt : sv.bits.toNat < Nat.pow 2 128 := by
          cases sv.bits with | ofFin fn => exact fn.isLt
        have hEqB : BitVec.ofNat 128 (Nat.mod sv.bits.toNat maxUsize) = sv.bits := by
          have hT := s3_truncateBits_isize sv.bits.toNat hBitsLt
          rw [s3_bitvec_ofNat_toNat] at hT
          rw [← hT, hTr]
        have hModLt : Nat.mod sv.bits.toNat maxUsize < maxUsize :=
          s3_nat_mod_lt_of_pos (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)
        have hToNat : sv.bits.toNat = Nat.mod sv.bits.toNat maxUsize := by
          rw [← hEqB, s3_bitvec_toNat_ofNat_lt _ (s3_evalConstLit_usize_lt128 _ hModLt)]
          exact (Nat.mod_eq_of_lt hModLt).symm
        rw [hToNat]; exact hModLt
      refine ⟨sv.bits.toNat, hLt, ?_⟩
      cases sv
      dsimp at hW hS
      rw [hW, hS, s3_bitvec_ofNat_toNat]

private theorem s3_mirTy_beq_usize_eq (ty : MirTy) : MirTy.beq ty usizeTy = true → ty = usizeTy := by
  cases ty with
  | int w s =>
    change (IntWidth.beq w .isize && (s == false)) = true → _
    cases w <;> cases s <;> intro h <;> first | rfl | cases h
  | bool | unit | never | enum _ | tuple _ | ref _ _ | rawPtr _ _ | unsupported =>
    intro h; cases h

private theorem s3_findDiscrVariantAux_bound :
    ∀ (ds : List Nat) (idx : Nat) (db : BitVec 128) (v : Nat),
      findDiscrVariantAux idx db ds = some v →
      ∃ off, off < ds.length ∧ v = idx + off
  | [], _, _, _, h => by cases h
  | d :: rest, idx, db, v, h => by
    change (if BitVec.ofNat 128 d == db then some idx else findDiscrVariantAux (idx + 1) db rest) = some v at h
    cases hEq : BitVec.ofNat 128 d == db with
    | true =>
      rw [hEq] at h; dsimp at h; cases h
      exact ⟨0, Nat.zero_lt_succ _, (Nat.add_zero idx).symm⟩
    | false =>
      rw [hEq] at h; dsimp at h
      cases s3_findDiscrVariantAux_bound rest (idx + 1) db v h with
      | intro off hoff =>
        refine ⟨off + 1, Nat.succ_lt_succ hoff.1, ?_⟩
        rw [hoff.2, Nat.add_assoc, Nat.add_comm 1 off]

private theorem s3_evalConstLit_checkVal (ty : MirTy) (lit : ConstLit) (v : Val)
    (h : evalConstLit ty lit = .ok v) : checkVal v ty = true := by
  unfold evalConstLit at h
  cases ty with
  | int w s =>
    cases lit with
    | zeroSized => cases h
    | scalar bits =>
      dsimp at h
      cases hNe : truncateBits w bits != bits with
      | true => rw [hNe] at h; cases h
      | false =>
        rw [hNe] at h; cases h
        have hEq : truncateBits w bits = bits := by
          cases hE : truncateBits w bits == bits with
          | true => exact eq_of_beq hE
          | false =>
            have hT : (truncateBits w bits != bits) = true := by
              change (!(truncateBits w bits == bits)) = true; rw [hE]; rfl
            rw [hT] at hNe; cases hNe
        have hB : (truncateBits w bits == bits) = true := by
          rw [hEq]
          exact BEq.refl bits
        unfold checkVal Val.ty? ScalarVal.wf
        dsimp
        rw [hEq, hB]; dsimp
        exact s3_mirTy_beq_refl_base (.int w s) True.intro
  | bool =>
    cases lit with
    | zeroSized => cases h
    | scalar bits =>
      dsimp at h
      cases hNe : truncateBits .i8 bits != bits with
      | true => rw [hNe] at h; cases h
      | false =>
        rw [hNe] at h; dsimp at h
        cases hZ : UInt8.ofNat (truncateBits .i8 bits).toNat == 0 with
        | true => rw [hZ] at h; cases h; rfl
        | false =>
          rw [hZ] at h; dsimp at h
          cases hO : UInt8.ofNat (truncateBits .i8 bits).toNat == 1 with
          | true => rw [hO] at h; cases h; rfl
          | false => rw [hO] at h; cases h
  | unit =>
    cases lit with
    | scalar _ => cases h
    | zeroSized => cases h; rfl
  | enum ety =>
    cases lit with
    | zeroSized =>
      dsimp at h
      cases hZ : isZstEnumTy ety with
      | false => rw [hZ] at h; cases h
      | true =>
        rw [hZ] at h; cases h
        unfold isZstEnumTy at hZ
        cases hTR : ety.tagRepr with
        | scalar _ _ => rw [hTR] at hZ; cases hZ
        | zeroSized =>
          rw [hTR] at hZ
          have hAdm : enumAdmitted ety = true := hZ
          have hAdm' := hAdm
          unfold enumAdmitted at hAdm'
          have h1 := (bool_and_eq_true _ _).mp hAdm'
          have h2 := (bool_and_eq_true _ _).mp h1.1
          have h3 := (bool_and_eq_true _ _).mp h2.1
          have h4 := (bool_and_eq_true _ _).mp h3.1
          have hNeEmpty := (bool_not_eq_true _).mp h4.1
          have hPos : 0 < ety.discriminants.length := by
            cases hD : ety.discriminants with
            | nil => rw [hD] at hNeEmpty; cases hNeEmpty
            | cons _ _ => exact Nat.zero_lt_succ _
          unfold checkVal Val.ty?
          dsimp
          rw [hAdm, (nat_blt_eq_lt _ _).mpr hPos]; dsimp
          exact s3_mirTy_beq_refl_base (.enum ety) True.intro
    | scalar bits =>
      dsimp at h
      cases hTR : ety.tagRepr with
      | zeroSized => rw [hTR] at h; cases h
      | scalar tagW tagS =>
        rw [hTR] at h; dsimp at h
        cases hGuard : !enumAdmitted ety || (truncateBits tagW bits != bits) with
        | true => rw [hGuard] at h; cases h
        | false =>
          rw [hGuard] at h; dsimp at h
          have hAdm : enumAdmitted ety = true := by
            cases hb : enumAdmitted ety with
            | true => rfl
            | false =>
              have hNt : (!enumAdmitted ety) = true := by rw [hb]; rfl
              rw [hNt] at hGuard
              cases hGuard
          cases hFind : findDiscrVariant? (tagBitsToDiscrBits tagW tagS ety.discrWidth bits) ety.discriminants with
          | none => rw [hFind] at h; cases h
          | some idx =>
            rw [hFind] at h; cases h
            have hBnd := s3_findDiscrVariantAux_bound ety.discriminants 0
              (tagBitsToDiscrBits tagW tagS ety.discrWidth bits) idx hFind
            cases hBnd with
            | intro off hoff =>
              rw [Nat.zero_add] at hoff
              have hIdxLt : idx < ety.discriminants.length := by rw [hoff.2]; exact hoff.1
              unfold checkVal Val.ty?
              dsimp
              rw [hAdm, (nat_blt_eq_lt _ _).mpr hIdxLt]; dsimp
              exact s3_mirTy_beq_refl_base (.enum ety) True.intro
  | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported =>
    cases lit <;> cases h

private theorem s3_evalBaseOp_sim (ctx : s3_PtrCtx) (slots₁ slots₂ : List MemCopySlot) (mem : CallerMemory) (op : Operand)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hOp : operandUsesOnlyBaseMem ctx.bodySrc.locals op = true) :
    match evalMemCopyBaseOperandToSlot ctx.bodySrc.locals slots₁ op,
          evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op with
    | .ok (ty₁, ov₁, s₁'), .ok (ty₂, ov₂, s₂') =>
      ty₁ = ty₂ ∧ ov₁ = ov₂ ∧
      (∀ v, ov₁ = some v → checkVal v ty₁ = true) ∧
      s3_MemWf ctx.bodySrc s₁' mem ∧ s3_SlotsRel ctx s₁' s₂'
    | .error k₁, .error k₂ => k₁ = k₂
    | _, _ => False := by
  cases op with
  | constant c =>
    unfold evalMemCopyBaseOperandToSlot
    dsimp
    cases hLit : evalConstLit c.ty c.lit with
    | error _ => rfl
    | ok v =>
      dsimp
      exact ⟨rfl, rfl, (fun _ h => by cases h; exact s3_evalConstLit_checkVal c.ty c.lit v hLit), hWf, hRel⟩
  | copy p =>
    unfold operandUsesOnlyBaseMem at hOp
    have h1 := (bool_and_eq_true _ _).mp hOp
    unfold evalMemCopyBaseOperandToSlot
    dsimp
    rw [h1.1]; dsimp
    cases hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p.localId with
    | none => rw [hDecl] at h1; cases h1.2
    | some d =>
      rw [hDecl] at h1
      cases d with
      | byteBuf _ _ _ | ptrLocal => cases h1.2
      | base ty =>
        have hIdLt : p.localId < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
        have hDeclTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals p.localId = some (.base ty) := by
          rw [s3_bodyTgt_locals_base ctx p.localId hIdLt, hDecl]
        rw [hDeclTgt, hRel.2.2.1 p.localId ty hDecl]
        cases hSl : Trusted.MirSemantics.getElem? slots₁ p.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | bufSlot _ | ptrDead | livePtr _ => rfl
          | baseSlot lsl =>
            cases lsl with
            | dead => rfl
            | live ov =>
              refine ⟨rfl, rfl, ?_, hWf, hRel⟩
              intro v hv
              rw [hv] at hSl
              exact hWf.2.2 p.localId ty v hDecl hSl
  | move p =>
    unfold operandUsesOnlyBaseMem at hOp
    have h1 := (bool_and_eq_true _ _).mp hOp
    unfold evalMemCopyBaseOperandToSlot
    dsimp
    rw [h1.1]; dsimp
    cases hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p.localId with
    | none => rw [hDecl] at h1; cases h1.2
    | some d =>
      rw [hDecl] at h1
      cases d with
      | byteBuf _ _ _ | ptrLocal => cases h1.2
      | base ty =>
        have hIdLt : p.localId < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
        have hDeclTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals p.localId = some (.base ty) := by
          rw [s3_bodyTgt_locals_base ctx p.localId hIdLt, hDecl]
        rw [hDeclTgt, hRel.2.2.1 p.localId ty hDecl]
        cases hSl : Trusted.MirSemantics.getElem? slots₁ p.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | bufSlot _ | ptrDead | livePtr _ => rfl
          | baseSlot lsl =>
            cases lsl with
            | dead => rfl
            | live ov =>
              dsimp
              have hLt1 : p.localId < slots₁.length := by rw [hRel.1]; exact hIdLt
              have hLt2 : p.localId < slots₂.length := by
                rw [hRel.2.1, s3_bodyTgt_locals_length]
                exact Nat.lt_of_lt_of_le hIdLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
              cases s3_setElem?_some_of_lt slots₁ p.localId (.baseSlot (liveUninitSlot ty)) hLt1 with
              | intro s₁' hs₁' =>
                cases s3_setElem?_some_of_lt slots₂ p.localId (.baseSlot (liveUninitSlot ty)) hLt2 with
                | intro s₂' hs₂' =>
                  rw [hs₁', hs₂']
                  have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals p.localId ≠ some (.byteBuf sz al mutab) :=
                    fun _ _ _ h => by rw [hDecl] at h; cases h
                  have hBaseOk : ∀ ty' v', Trusted.MirSemantics.getElem? ctx.bodySrc.locals p.localId = some (.base ty') →
                      MemCopySlot.baseSlot (liveUninitSlot ty) = .baseSlot (.live (some v')) → checkVal v' ty' = true := by
                    intro ty' v' hD' hEqL
                    rw [hDecl] at hD'; cases hD'
                    cases ty with
                    | unit => unfold liveUninitSlot at hEqL; cases hEqL; rfl
                    | enum ety =>
                      unfold liveUninitSlot at hEqL
                      dsimp at hEqL
                      cases hZ : isZstEnumTy ety with
                      | false => rw [hZ] at hEqL; cases hEqL
                      | true =>
                        rw [hZ] at hEqL; cases hEqL
                        unfold isZstEnumTy at hZ
                        cases hTR : ety.tagRepr with
                        | scalar _ _ => rw [hTR] at hZ; cases hZ
                        | zeroSized =>
                          rw [hTR] at hZ
                          have hAdm : enumAdmitted ety = true := hZ
                          have hAdm' := hAdm
                          unfold enumAdmitted at hAdm'
                          have h1 := (bool_and_eq_true _ _).mp hAdm'
                          have h2 := (bool_and_eq_true _ _).mp h1.1
                          have h3 := (bool_and_eq_true _ _).mp h2.1
                          have h4 := (bool_and_eq_true _ _).mp h3.1
                          have hNeEmpty := (bool_not_eq_true _).mp h4.1
                          have hPos : 0 < ety.discriminants.length := by
                            cases hD : ety.discriminants with
                            | nil => rw [hD] at hNeEmpty; cases hNeEmpty
                            | cons _ _ => exact Nat.zero_lt_succ _
                          unfold checkVal Val.ty?
                          dsimp
                          rw [hAdm, (nat_blt_eq_lt _ _).mpr hPos]; dsimp
                          exact s3_mirTy_beq_refl_base (.enum ety) True.intro
                    | bool | int _ _ | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported =>
                      unfold liveUninitSlot at hEqL; cases hEqL
                  refine ⟨rfl, rfl, ?_, s3_memWf_set_nonBuf _ _ _ _ _ _ hWf hNotBuf hBaseOk hs₁',
                      s3_slotsRel_set_base ctx slots₁ slots₂ s₁' s₂' p.localId ty _ hDecl hRel hs₁' hs₂'⟩
                  intro v hv
                  rw [hv] at hSl
                  exact hWf.2.2 p.localId ty v hDecl hSl

private theorem s3_evalPrimOp_sim (ctx : s3_PtrCtx) (slots₁ slots₂ : List MemCopySlot) (mem : CallerMemory) (op : Operand)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hOp : operandUsesOnlyBaseMem ctx.bodySrc.locals op = true) :
    match evalMemCopyPrimitiveOperand ctx.bodySrc.locals slots₁ op,
          evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ op with
    | .ok (v₁, s₁'), .ok (v₂, s₂') =>
      v₁ = v₂ ∧ s3_MemWf ctx.bodySrc s₁' mem ∧ s3_SlotsRel ctx s₁' s₂'
    | .error k₁, .error k₂ => k₁ = k₂
    | _, _ => False := by
  have hBase := s3_evalBaseOp_sim ctx slots₁ slots₂ mem op hWf hRel hOp
  unfold evalMemCopyPrimitiveOperand
  cases h1 : evalMemCopyBaseOperandToSlot ctx.bodySrc.locals slots₁ op with
  | error k₁ =>
    rw [h1] at hBase
    cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op with
    | error k₂ => rw [h2] at hBase; exact hBase
    | ok _ => rw [h2] at hBase; exact False.elim hBase
  | ok p₁ =>
    rw [h1] at hBase
    cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op with
    | error _ => rw [h2] at hBase; exact False.elim hBase
    | ok p₂ =>
      rw [h2] at hBase
      cases p₁ with | mk ty₁ r₁ =>
      cases r₁ with | mk ov₁ s₁' =>
      cases p₂ with | mk ty₂ r₂ =>
      cases r₂ with | mk ov₂ s₂' =>
      dsimp at hBase
      rw [← hBase.1, ← hBase.2.1]
      dsimp
      cases !isPrimitiveReadableTy ty₁ with
      | true => rfl
      | false =>
        cases ov₁ with
        | none => rfl
        | some v => exact ⟨rfl, hBase.2.2.2.1, hBase.2.2.2.2⟩

private theorem s3_operandHasBaseTy_usesOnlyBase (decls : List MemCopyLocalDecl) (expectedTy : MirTy) (op : Operand)
    (h : operandHasBaseTy decls expectedTy op = true) :
    operandUsesOnlyBaseMem decls op = true := by
  cases op with
  | constant _ => rfl
  | copy p =>
    unfold operandHasBaseTy at h; dsimp at h; have h1 := (bool_and_eq_true _ _).mp h
    unfold operandUsesOnlyBaseMem; dsimp
    rw [h1.1]
    cases hD : Trusted.MirSemantics.getElem? decls p.localId with
    | none => rw [hD] at h1; cases h1.2
    | some d => cases d with | base _ => rfl | byteBuf _ _ _ | ptrLocal => rw [hD] at h1; cases h1.2
  | move p =>
    unfold operandHasBaseTy at h; dsimp at h; have h1 := (bool_and_eq_true _ _).mp h
    unfold operandUsesOnlyBaseMem; dsimp
    rw [h1.1]
    cases hD : Trusted.MirSemantics.getElem? decls p.localId with
    | none => rw [hD] at h1; cases h1.2
    | some d => cases d with | base _ => rfl | byteBuf _ _ _ | ptrLocal => rw [hD] at h1; cases h1.2

private theorem s3_evalUsizeOp_sim (ctx : s3_PtrCtx) (slots₁ slots₂ : List MemCopySlot) (mem : CallerMemory) (op : Operand)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hOp : operandUsesOnlyBaseMem ctx.bodySrc.locals op = true) :
    match evalUsizeOp ctx.bodySrc.locals slots₁ op,
          evalUsizeOp ctx.bodyTgt.locals slots₂ op with
    | .ok (n₁, s₁'), .ok (n₂, s₂') =>
      n₁ = n₂ ∧ n₁ < maxUsize ∧ s3_MemWf ctx.bodySrc s₁' mem ∧ s3_SlotsRel ctx s₁' s₂'
    | .error k₁, .error k₂ => k₁ = k₂
    | _, _ => False := by
  have hBase := s3_evalBaseOp_sim ctx slots₁ slots₂ mem op hWf hRel hOp
  unfold evalUsizeOp
  cases h1 : evalMemCopyBaseOperandToSlot ctx.bodySrc.locals slots₁ op with
  | error k₁ =>
    rw [h1] at hBase
    cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op with
    | error k₂ => rw [h2] at hBase; exact hBase
    | ok _ => rw [h2] at hBase; exact False.elim hBase
  | ok p₁ =>
    rw [h1] at hBase
    cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op with
    | error _ => rw [h2] at hBase; exact False.elim hBase
    | ok p₂ =>
      rw [h2] at hBase
      cases p₁ with | mk ty₁ r₁ =>
      cases r₁ with | mk ov₁ s₁' =>
      cases p₂ with | mk ty₂ r₂ =>
      cases r₂ with | mk ov₂ s₂' =>
      dsimp at hBase
      rw [← hBase.1, ← hBase.2.1]
      dsimp
      cases hTy : !(MirTy.beq ty₁ usizeTy) with
      | true => rfl
      | false =>
        have hTyEq : ty₁ = usizeTy := s3_mirTy_beq_usize_eq ty₁ ((bool_not_eq_false _).mp hTy)
        cases hOv : ov₁ with
        | none => rfl
        | some v =>
          have hChk := hBase.2.2.1 v hOv
          rw [hTyEq] at hChk
          cases s3_checkVal_usize_elim v hChk with
          | intro n hn =>
            rw [hn.2]; dsimp
            have hSvWf : ScalarVal.wf { width := .isize, signed := false, bits := BitVec.ofNat 128 n } = true :=
              s3_usize_scalar_wf n hn.1
            rw [hSvWf]; dsimp
            rw [s3_bitvec_toNat_ofNat_lt n (s3_evalConstLit_usize_lt128 n hn.1)]
            exact ⟨rfl, hn.1, hBase.2.2.2.1, hBase.2.2.2.2⟩

private theorem s3_evalMemCopyStmt_mkAssignUse (body : MemCopyBody) (frame : MemCopyFrame)
    (mem : CallerMemory) (dst : LocalId) (dstTy : MirTy) (op : Operand)
    (hDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base dstTy)) :
    evalMemCopyStmt body frame mem (mkAssignUse dst op) =
      match evalMemCopyBaseRvalue body.locals frame.locals dstTy (.use op) with
      | .error k => .fault k
      | .ok (val, slotsAfterRval) =>
        match writeMemCopyBasePlace slotsAfterRval dst dstTy val with
        | .error k => .fault k
        | .ok slots' => stepMemCopyNext frame mem slots' := by
  unfold mkAssignUse evalMemCopyStmt
  change (if !([] : List ProjectionElem).isEmpty then StepResult.fault .unsupported
    else match Trusted.MirSemantics.getElem? body.locals dst with
      | some (.base dstTy) =>
        match evalMemCopyBaseRvalue body.locals frame.locals dstTy (.use op) with
        | .error k => StepResult.fault k
        | .ok (val, slotsAfterRval) =>
          match writeMemCopyBasePlace slotsAfterRval dst dstTy val with
          | .error k => StepResult.fault k
          | .ok slots' => stepMemCopyNext frame mem slots'
      | _ => StepResult.fault .unsupported) = _
  rw [hDecl]
  rfl

private theorem s3_evalUsizeOp_assign_scr (ctx : s3_PtrCtx) (frame : MemCopyFrame)
    (slots₁ : List MemCopySlot) (mem : CallerMemory)
    (scrIdx : Nat) (op : Operand) (hScr : scrIdx < 10)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ frame.locals)
    (hOp : operandHasBaseTy ctx.bodySrc.locals usizeTy op = true) :
    let scrLoc := s3_scrBase ctx + scrIdx
    match evalUsizeOp ctx.bodySrc.locals slots₁ op with
    | .ok (n, s₁') =>
      n < maxUsize ∧
      ∃ slots₂'',
        evalMemCopyStmt ctx.bodyTgt frame mem (mkAssignUse scrLoc op) =
          stepMemCopyNext frame mem slots₂'' ∧
        Trusted.MirSemantics.getElem? slots₂'' scrLoc =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))) ∧
        s3_MemWf ctx.bodySrc s₁' mem ∧
        s3_SlotsRel ctx s₁' slots₂''
    | .error k =>
      evalMemCopyStmt ctx.bodyTgt frame mem (mkAssignUse scrLoc op) = .fault k := by
  intro scrLoc
  have hScr12 : scrIdx < 12 := Nat.lt_trans hScr (by decide)
  have hDeclScr : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals scrLoc = some (.base usizeTy) := by
    have hS := s3_bodyTgt_locals_scratch ctx scrIdx hScr12
    have h10 : Nat.blt scrIdx 10 = true := (nat_blt_eq_lt _ _).mpr hScr
    rw [h10] at hS; exact hS
  have hBaseOp := s3_evalBaseOp_sim ctx slots₁ frame.locals mem op hWf hRel
    (s3_operandHasBaseTy_usesOnlyBase ctx.bodySrc.locals usizeTy op hOp)
  have hSrcTyUsize : ∀ ty₁ ov₁ s₁',
      evalMemCopyBaseOperandToSlot ctx.bodySrc.locals slots₁ op = .ok (ty₁, ov₁, s₁') →
      ty₁ = usizeTy := by
    intro ty₁ ov₁ s₁' hEv
    cases op with
    | constant c =>
      unfold operandHasBaseTy at hOp
      have h1 := (bool_and_eq_true _ _).mp hOp
      unfold evalMemCopyBaseOperandToSlot at hEv; dsimp at hEv
      cases hL : evalConstLit c.ty c.lit with
      | error _ => rw [hL] at hEv; cases hEv
      | ok _ => rw [hL] at hEv; cases hEv; exact s3_mirTy_beq_usize_eq c.ty h1.1
    | copy p =>
      unfold operandHasBaseTy at hOp; have h1 := (bool_and_eq_true _ _).mp hOp
      unfold evalMemCopyBaseOperandToSlot at hEv; dsimp at hEv
      rw [h1.1] at hEv; dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p.localId with
      | none => rw [hD] at h1; cases h1.2
      | some d =>
        rw [hD] at hEv h1
        cases d with
        | byteBuf _ _ _ | ptrLocal => cases h1.2
        | base ty =>
          cases hS : Trusted.MirSemantics.getElem? slots₁ p.localId with
          | none => rw [hS] at hEv; cases hEv
          | some sl =>
            rw [hS] at hEv
            cases sl with
            | bufSlot _ | ptrDead | livePtr _ => cases hEv
            | baseSlot lsl => cases lsl with | dead => cases hEv | live _ => cases hEv; exact s3_mirTy_beq_usize_eq _ h1.2
    | move p =>
      unfold operandHasBaseTy at hOp; have h1 := (bool_and_eq_true _ _).mp hOp
      unfold evalMemCopyBaseOperandToSlot at hEv; dsimp at hEv
      rw [h1.1] at hEv; dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p.localId with
      | none => rw [hD] at h1; cases h1.2
      | some d =>
        rw [hD] at hEv h1
        cases d with
        | byteBuf _ _ _ | ptrLocal => cases h1.2
        | base ty =>
          cases hS : Trusted.MirSemantics.getElem? slots₁ p.localId with
          | none => rw [hS] at hEv; cases hEv
          | some sl =>
            rw [hS] at hEv
            cases sl with
            | bufSlot _ | ptrDead | livePtr _ => cases hEv
            | baseSlot lsl =>
              cases lsl with
              | dead => cases hEv
              | live _ =>
                dsimp at hEv
                cases hSe : setElem? slots₁ p.localId (.baseSlot (liveUninitSlot ty)) with
                | none => rw [hSe] at hEv; cases hEv
                | some _ => rw [hSe] at hEv; cases hEv; exact s3_mirTy_beq_usize_eq _ h1.2
  unfold evalUsizeOp
  rw [s3_evalMemCopyStmt_mkAssignUse ctx.bodyTgt frame mem scrLoc usizeTy op hDeclScr]
  unfold evalMemCopyBaseRvalue
  dsimp
  cases h1 : evalMemCopyBaseOperandToSlot ctx.bodySrc.locals slots₁ op with
  | error k₁ =>
    rw [h1] at hBaseOp
    cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals frame.locals op with
    | error k₂ => rw [h2] at hBaseOp; rw [hBaseOp]
    | ok _ => rw [h2] at hBaseOp; exact False.elim hBaseOp
  | ok p₁ =>
    rw [h1] at hBaseOp
    cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals frame.locals op with
    | error _ => rw [h2] at hBaseOp; exact False.elim hBaseOp
    | ok p₂ =>
      rw [h2] at hBaseOp
      cases p₁ with | mk ty₁ r₁ =>
      cases r₁ with | mk ov₁ s₁' =>
      cases p₂ with | mk ty₂ r₂ =>
      cases r₂ with | mk ov₂ s₂' =>
      dsimp at hBaseOp
      have hTyEq : ty₁ = usizeTy := hSrcTyUsize ty₁ ov₁ s₁' h1
      have hTyBeq : MirTy.beq usizeTy usizeTy = true := rfl
      rw [← hBaseOp.1, hTyEq]; dsimp
      rw [hTyBeq]; dsimp
      rw [← hBaseOp.2.1]
      cases hOv : ov₁ with
      | none => rfl
      | some v =>
        have hChk := hBaseOp.2.2.1 v hOv
        rw [hTyEq] at hChk
        cases s3_checkVal_usize_elim v hChk with
        | intro n hn =>
          rw [hn.2]; dsimp
          have hSvWf : ScalarVal.wf { width := .isize, signed := false, bits := BitVec.ofNat 128 n } = true :=
            s3_usize_scalar_wf n hn.1
          rw [hSvWf]; dsimp
          rw [s3_bitvec_toNat_ofNat_lt n (s3_evalConstLit_usize_lt128 n hn.1)]
          refine ⟨hn.1, ?_⟩
          have hLive : ∃ ov, Trusted.MirSemantics.getElem? s₂' scrLoc = some (.baseSlot (.live ov)) :=
            hBaseOp.2.2.2.2.2.2.2.2.2 scrIdx hScr12
          cases hLive with
          | intro ov hSlotScr =>
            have hLtScr : scrLoc < s₂'.length := by
              rw [hBaseOp.2.2.2.2.2.1]
              exact s3_scrLoc_lt_bodyTgt ctx scrIdx hScr12
            cases s3_setElem?_some_of_lt s₂' scrLoc
                (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))) hLtScr with
            | intro slots₂'' hSetScr =>
              refine ⟨slots₂'', ?_, s3_getElem?_setElem?_eq s₂' scrLoc _ slots₂'' hSetScr,
                  hBaseOp.2.2.2.1, s3_slotsRel_set_scratch ctx s₁' s₂' slots₂'' scrIdx _ hScr12 hBaseOp.2.2.2.2 hSetScr⟩
              unfold writeMemCopyBasePlace
              rw [s3_usize_scalar_checkVal n hn.1]; dsimp
              rw [hSlotScr]; dsimp
              rw [hSetScr]

private theorem s3_mirTy_beq_isize_eq (ty : MirTy) : MirTy.beq ty isizeTy = true → ty = isizeTy := by
  cases ty with
  | int w s =>
    change (IntWidth.beq w .isize && (s == true)) = true → _
    cases w <;> cases s <;> intro h <;> first | rfl | cases h
  | bool | unit | never | enum _ | tuple _ | ref _ _ | rawPtr _ _ | unsupported =>
    intro h; cases h

private theorem s3_evalOffsetCountOp_const_ok (decls : List MemCopyLocalDecl) (slots : List MemCopySlot)
    (op : Operand) (z : Int) (hConst : constIsizeValue? op = some z) :
    evalOffsetCountOp decls slots op = .ok (z, slots) := by
  cases op with
  | copy _ | move _ => cases hConst
  | constant c =>
    unfold constIsizeValue? at hConst; dsimp at hConst
    cases hTy : MirTy.beq c.ty isizeTy with
    | false => rw [hTy] at hConst; cases hConst
    | true =>
      rw [hTy] at hConst; dsimp at hConst
      have hEqTy : c.ty = isizeTy := s3_mirTy_beq_isize_eq c.ty hTy
      cases hLit : evalConstLit isizeTy c.lit with
      | error _ => rw [hLit] at hConst; cases hConst
      | ok v =>
        rw [hLit] at hConst
        cases v with
        | bool _ | unit | ptr _ | enumVal _ _ | tuple _ | bytes _ => cases hConst
        | scalar sv =>
          dsimp at hConst
          cases hWf : sv.wf with
          | false => rw [hWf] at hConst; cases hConst
          | true =>
            rw [hWf] at hConst; cases hConst
            unfold evalOffsetCountOp evalMemCopyBaseOperandToSlot; dsimp
            rw [hEqTy, hLit]; dsimp
            have hBeqU : MirTy.beq isizeTy usizeTy = false := rfl
            have hBeqI : MirTy.beq isizeTy isizeTy = true := rfl
            rw [hBeqU, hBeqI]; dsimp
            rw [hWf]; rfl

private theorem s3_evalOffsetCountOp_usize_iff (ctx : s3_PtrCtx) (slots₁ slots₂ : List MemCopySlot) (mem : CallerMemory)
    (op : Operand)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hOp : operandHasBaseTy ctx.bodySrc.locals usizeTy op = true) :
    match evalUsizeOp ctx.bodySrc.locals slots₁ op, evalOffsetCountOp ctx.bodySrc.locals slots₁ op with
    | .ok (n, s₁'), .ok (z, s₁'') => z = Int.ofNat n ∧ s₁' = s₁'' ∧ n < maxUsize
    | .error k₁, .error k₂ => k₁ = k₂
    | _, _ => False := by
  have hBaseOp := s3_evalBaseOp_sim ctx slots₁ slots₂ mem op hWf hRel
    (s3_operandHasBaseTy_usesOnlyBase ctx.bodySrc.locals usizeTy op hOp)
  have hSrcTyUsize : ∀ ty₁ ov₁ s₁',
      evalMemCopyBaseOperandToSlot ctx.bodySrc.locals slots₁ op = .ok (ty₁, ov₁, s₁') →
      ty₁ = usizeTy := by
    intro ty₁ ov₁ s₁' hEv
    cases op with
    | constant c =>
      unfold operandHasBaseTy at hOp; have h1 := (bool_and_eq_true _ _).mp hOp
      unfold evalMemCopyBaseOperandToSlot at hEv; dsimp at hEv
      cases hL : evalConstLit c.ty c.lit with
      | error _ => rw [hL] at hEv; cases hEv
      | ok _ => rw [hL] at hEv; cases hEv; exact s3_mirTy_beq_usize_eq c.ty h1.1
    | copy p =>
      unfold operandHasBaseTy at hOp; have h1 := (bool_and_eq_true _ _).mp hOp
      unfold evalMemCopyBaseOperandToSlot at hEv; dsimp at hEv; rw [h1.1] at hEv; dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p.localId with
      | none => rw [hD] at h1; cases h1.2
      | some d =>
        rw [hD] at hEv h1
        cases d with
        | byteBuf _ _ _ | ptrLocal => cases h1.2
        | base ty =>
          cases hS : Trusted.MirSemantics.getElem? slots₁ p.localId with
          | none => rw [hS] at hEv; cases hEv
          | some sl =>
            rw [hS] at hEv
            cases sl with | bufSlot _ | ptrDead | livePtr _ => cases hEv | baseSlot lsl => cases lsl with | dead => cases hEv | live _ => cases hEv; exact s3_mirTy_beq_usize_eq _ h1.2
    | move p =>
      unfold operandHasBaseTy at hOp; have h1 := (bool_and_eq_true _ _).mp hOp
      unfold evalMemCopyBaseOperandToSlot at hEv; dsimp at hEv; rw [h1.1] at hEv; dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p.localId with
      | none => rw [hD] at h1; cases h1.2
      | some d =>
        rw [hD] at hEv h1
        cases d with
        | byteBuf _ _ _ | ptrLocal => cases h1.2
        | base ty =>
          cases hS : Trusted.MirSemantics.getElem? slots₁ p.localId with
          | none => rw [hS] at hEv; cases hEv
          | some sl =>
            rw [hS] at hEv
            cases sl with
            | bufSlot _ | ptrDead | livePtr _ => cases hEv
            | baseSlot lsl =>
              cases lsl with
              | dead => cases hEv
              | live _ =>
                dsimp at hEv
                cases hSe : setElem? slots₁ p.localId (.baseSlot (liveUninitSlot ty)) with
                | none => rw [hSe] at hEv; cases hEv
                | some _ => rw [hSe] at hEv; cases hEv; exact s3_mirTy_beq_usize_eq _ h1.2
  unfold evalUsizeOp evalOffsetCountOp
  cases h1 : evalMemCopyBaseOperandToSlot ctx.bodySrc.locals slots₁ op with
  | error k₁ => rfl
  | ok p₁ =>
    rw [h1] at hBaseOp
    cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op with
    | error _ => rw [h2] at hBaseOp; exact False.elim hBaseOp
    | ok p₂ =>
      rw [h2] at hBaseOp
      cases p₁ with | mk ty₁ r₁ =>
      cases r₁ with | mk ov₁ s₁' =>
      dsimp at hBaseOp
      have hTyEq : ty₁ = usizeTy := hSrcTyUsize ty₁ ov₁ s₁' h1
      rw [hTyEq]
      dsimp
      have hBu : MirTy.beq usizeTy usizeTy = true := rfl
      have hBi : MirTy.beq usizeTy isizeTy = false := rfl
      rw [hBu, hBi]; dsimp
      cases hOv : ov₁ with
      | none => rfl
      | some v =>
        have hChk := hBaseOp.2.2.1 v hOv
        rw [hTyEq] at hChk
        cases s3_checkVal_usize_elim v hChk with
        | intro n hn =>
          rw [hn.2]; dsimp
          have hSvWf : ScalarVal.wf { width := .isize, signed := false, bits := BitVec.ofNat 128 n } = true :=
            s3_usize_scalar_wf n hn.1
          rw [hSvWf]; dsimp
          rw [s3_bitvec_toNat_ofNat_lt n (s3_evalConstLit_usize_lt128 n hn.1), s3_decodeScalar_usize n hn.1]
          exact ⟨rfl, rfl, hn.1⟩

private theorem s3_evalBaseRvalue_sim (ctx : s3_PtrCtx) (slots₁ slots₂ : List MemCopySlot) (mem : CallerMemory)
    (dstTy : MirTy) (rv : Rvalue)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hRv : rvalueUsesOnlyBaseMem ctx.bodySrc.locals rv = true) :
    match evalMemCopyBaseRvalue ctx.bodySrc.locals slots₁ dstTy rv,
          evalMemCopyBaseRvalue ctx.bodyTgt.locals slots₂ dstTy rv with
    | .ok (v₁, s₁'), .ok (v₂, s₂') =>
      v₁ = v₂ ∧ s3_MemWf ctx.bodySrc s₁' mem ∧ s3_SlotsRel ctx s₁' s₂'
    | .error k₁, .error k₂ => k₁ = k₂
    | _, _ => False := by
  cases rv with
  | use op =>
    have hB := s3_evalBaseOp_sim ctx slots₁ slots₂ mem op hWf hRel hRv
    unfold evalMemCopyBaseRvalue; dsimp
    cases h1 : evalMemCopyBaseOperandToSlot ctx.bodySrc.locals slots₁ op with
    | error k₁ =>
      rw [h1] at hB
      cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op with
      | error k₂ => rw [h2] at hB; exact hB
      | ok _ => rw [h2] at hB; exact False.elim hB
    | ok p₁ =>
      rw [h1] at hB
      cases h2 : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op with
      | error _ => rw [h2] at hB; exact False.elim hB
      | ok p₂ =>
        rw [h2] at hB
        cases p₁ with | mk ty₁ r₁ =>
        cases r₁ with | mk ov₁ s₁' =>
        cases p₂ with | mk ty₂ r₂ =>
        cases r₂ with | mk ov₂ s₂' =>
        dsimp at hB
        rw [← hB.1, ← hB.2.1]; dsimp
        cases !(MirTy.beq ty₁ dstTy) with
        | true => rfl
        | false =>
          cases ov₁ with
          | none => rfl
          | some v => exact ⟨rfl, hB.2.2.2.1, hB.2.2.2.2⟩
  | unaryOp uop op =>
    have hP := s3_evalPrimOp_sim ctx slots₁ slots₂ mem op hWf hRel hRv
    unfold evalMemCopyBaseRvalue; dsimp
    cases h1 : evalMemCopyPrimitiveOperand ctx.bodySrc.locals slots₁ op with
    | error k₁ =>
      rw [h1] at hP
      cases h2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ op with
      | error k₂ => rw [h2] at hP; exact hP
      | ok _ => rw [h2] at hP; exact False.elim hP
    | ok p₁ =>
      rw [h1] at hP
      cases h2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ op with
      | error _ => rw [h2] at hP; exact False.elim hP
      | ok p₂ =>
        rw [h2] at hP
        cases p₁ with | mk v₁ s₁' =>
        cases p₂ with | mk v₂ s₂' =>
        dsimp at hP
        rw [← hP.1]; dsimp
        cases evalUnOp uop v₁ with
        | error _ => rfl
        | ok _ => exact ⟨rfl, hP.2.1, hP.2.2⟩
  | binaryOp bop l r =>
    unfold rvalueUsesOnlyBaseMem at hRv; dsimp at hRv
    have h12 := (bool_and_eq_true _ _).mp hRv
    have hL := s3_evalPrimOp_sim ctx slots₁ slots₂ mem l hWf hRel h12.1
    unfold evalMemCopyBaseRvalue; dsimp
    cases h1 : evalMemCopyPrimitiveOperand ctx.bodySrc.locals slots₁ l with
    | error k₁ =>
      rw [h1] at hL
      cases h2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ l with
      | error k₂ => rw [h2] at hL; exact hL
      | ok _ => rw [h2] at hL; exact False.elim hL
    | ok p₁ =>
      rw [h1] at hL
      cases h2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ l with
      | error _ => rw [h2] at hL; exact False.elim hL
      | ok p₂ =>
        rw [h2] at hL
        cases p₁ with | mk vl₁ sl₁ =>
        cases p₂ with | mk vl₂ sl₂ =>
        dsimp at hL
        rw [← hL.1]; dsimp
        have hR := s3_evalPrimOp_sim ctx sl₁ sl₂ mem r hL.2.1 hL.2.2 h12.2
        cases hR1 : evalMemCopyPrimitiveOperand ctx.bodySrc.locals sl₁ r with
        | error kr₁ =>
          rw [hR1] at hR
          cases hR2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals sl₂ r with
          | error kr₂ => rw [hR2] at hR; exact hR
          | ok _ => rw [hR2] at hR; exact False.elim hR
        | ok pr₁ =>
          rw [hR1] at hR
          cases hR2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals sl₂ r with
          | error _ => rw [hR2] at hR; exact False.elim hR
          | ok pr₂ =>
            rw [hR2] at hR
            cases pr₁ with | mk vr₁ sr₁ =>
            cases pr₂ with | mk vr₂ sr₂ =>
            dsimp at hR
            rw [← hR.1]; dsimp
            cases evalBinOp bop vl₁ vr₁ with
            | error _ => rfl
            | ok _ => exact ⟨rfl, hR.2.1, hR.2.2⟩
  | discriminant place =>
    unfold rvalueUsesOnlyBaseMem at hRv; dsimp at hRv
    have h1 := (bool_and_eq_true _ _).mp hRv
    unfold evalMemCopyBaseRvalue; dsimp
    rw [h1.1]; dsimp
    cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals place.localId with
    | none => rw [hD] at h1; cases h1.2
    | some d =>
      rw [hD] at h1
      cases d with
      | byteBuf _ _ _ | ptrLocal => cases h1.2
      | base ty =>
        have hIdLt : place.localId < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hD
        have hDTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals place.localId = some (.base ty) := by
          rw [s3_bodyTgt_locals_base ctx place.localId hIdLt, hD]
        rw [hDTgt, hRel.2.2.1 place.localId ty hD]
        cases ty with
        | enum ety =>
          cases hSl : Trusted.MirSemantics.getElem? slots₁ place.localId with
          | none => rfl
          | some sl =>
            cases sl with
            | bufSlot _ | ptrDead | livePtr _ => rfl
            | baseSlot lsl =>
              dsimp
              cases hAdm : !enumAdmitted ety with
              | true => rfl
              | false =>
                cases hTR : ety.tagRepr with
                | zeroSized =>
                  cases lsl with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none =>
                      cases hD0 : Trusted.MirSemantics.getElem? ety.discriminants 0 with
                      | none => rfl
                      | some _ => exact ⟨rfl, hWf, hRel⟩
                    | some v =>
                      cases v with
                      | enumVal ety' idx =>
                        dsimp
                        cases hCnd : ety.beq ety' && idx.beq 0 with
                        | true =>
                          dsimp
                          cases hD0 : Trusted.MirSemantics.getElem? ety.discriminants 0 with
                          | none => dsimp
                          | some _ => dsimp; exact ⟨rfl, hWf, hRel⟩
                        | false => dsimp
                      | _ => rfl
                | scalar _ _ =>
                  cases lsl with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none => rfl
                    | some v =>
                      cases v with
                      | enumVal ety' idx =>
                        dsimp
                        cases hCnd : ety.beq ety' && idx.blt ety.discriminants.length with
                        | true =>
                          dsimp
                          cases hDv : Trusted.MirSemantics.getElem? ety.discriminants idx with
                          | none => dsimp
                          | some _ => dsimp; exact ⟨rfl, hWf, hRel⟩
                        | false => dsimp
                      | _ => rfl
        | _ => rfl
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported => rfl

private theorem s3_writeBasePlace_sim (ctx : s3_PtrCtx) (slots₁ slots₂ : List MemCopySlot) (mem : CallerMemory)
    (id : LocalId) (ty : MirTy) (v : Val)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty))
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂) :
    match writeMemCopyBasePlace slots₁ id ty v,
          writeMemCopyBasePlace slots₂ id ty v with
    | .ok s₁', .ok s₂' => s3_MemWf ctx.bodySrc s₁' mem ∧ s3_SlotsRel ctx s₁' s₂'
    | .error k₁, .error k₂ => k₁ = k₂
    | _, _ => False := by
  have hIdLt : id < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
  unfold writeMemCopyBasePlace
  cases hChk : checkVal v ty with
  | false => rfl
  | true =>
    dsimp
    rw [hRel.2.2.1 id ty hDecl]
    cases hSl : Trusted.MirSemantics.getElem? slots₁ id with
    | none => rfl
    | some sl =>
      cases sl with
      | bufSlot _ | ptrDead | livePtr _ => rfl
      | baseSlot lsl =>
        cases lsl with
        | dead => rfl
        | live _ =>
          have hLt1 : id < slots₁.length := by rw [hRel.1]; exact hIdLt
          have hLt2 : id < slots₂.length := by
            rw [hRel.2.1, s3_bodyTgt_locals_length]
            exact Nat.lt_of_lt_of_le hIdLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
          cases s3_setElem?_some_of_lt slots₁ id (.baseSlot (.live (some v))) hLt1 with
          | intro s₁' hs₁' =>
            cases s3_setElem?_some_of_lt slots₂ id (.baseSlot (.live (some v))) hLt2 with
            | intro s₂' hs₂' =>
              rw [hs₁', hs₂']
              have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals id ≠ some (.byteBuf sz al mutab) :=
                fun _ _ _ h => by rw [hDecl] at h; cases h
              have hBaseOk : ∀ ty' v', Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty') →
                  MemCopySlot.baseSlot (.live (some v)) = .baseSlot (.live (some v')) → checkVal v' ty' = true := by
                intro ty' v' hD' hEqL
                rw [hDecl] at hD'; cases hD'; cases hEqL; exact hChk
              exact ⟨s3_memWf_set_nonBuf _ _ _ _ _ _ hWf hNotBuf hBaseOk hs₁',
                  s3_slotsRel_set_base ctx slots₁ slots₂ s₁' s₂' id ty _ hDecl hRel hs₁' hs₂'⟩

