private theorem s3_evalBinOp_usize_addUnchecked_ok (a b : Nat) (hSum : a + b < maxUsize) :
    evalBinOp .addUnchecked
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a + b) }) := by
  have ha : a < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_right _ _) hSum
  have hb : b < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left _ _) hSum
  unfold evalBinOp evalArithOp
  dsimp [BinOp.isShift, BinOp.isUnchecked]
  rw [s3_decodeScalar_usize a ha, s3_decodeScalar_usize b hb]
  change (match truncateScalar IntWidth.isize false (Int.ofNat (a + b)) with
    | Except.error k => Except.error k
    | Except.ok (val, lossy) =>
      if ((decide (Int.ofNat (a + b) < 0) || decide (Int.ofNat (a + b) ≥ HPow.hPow (2 : Int) 128) || lossy) &&
          decide (true = true)) = true then Except.error FaultKind.undefined
      else Except.ok (Val.scalar val)) = _
  rw [s3_truncateScalar_isize_ofNat_lt (a + b) hSum]
  dsimp
  have hLt128 : a + b < Nat.pow 2 128 := s3_evalConstLit_usize_lt128 _ hSum
  have hNeg : decide (Int.ofNat (a + b) < 0) = false := decide_eq_false (s0_int_not_lt_mpr (s0_int_natCast_nonneg _))
  have hGe : decide (Int.ofNat (a + b) ≥ HPow.hPow (2 : Int) 128) = false := by
    apply decide_eq_false
    intro h
    have hNat : Nat.pow 2 128 ≤ a + b := s0_int_ofNat_le_mp h
    exact Nat.not_lt_of_le hNat hLt128
  exact s3_arith_ite_false _ _ hNeg hGe _ _

private theorem s3_evalBinOp_usize_subUnchecked_ok (a b : Nat) (ha : a < maxUsize) (hLe : b ≤ a) :
    evalBinOp .subUnchecked
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a - b) }) := by
  have hb : b < maxUsize := Nat.lt_of_le_of_lt hLe ha
  have hSubLt : a - b < maxUsize := Nat.lt_of_le_of_lt (Nat.sub_le _ _) ha
  unfold evalBinOp evalArithOp
  dsimp [BinOp.isShift, BinOp.isUnchecked]
  rw [s3_decodeScalar_usize a ha, s3_decodeScalar_usize b hb]
  have hDiff : Int.ofNat a - Int.ofNat b = Int.ofNat (a - b) := (s0_int_ofNat_sub hLe).symm
  change (match truncateScalar IntWidth.isize false (Int.ofNat a - Int.ofNat b) with
    | Except.error k => Except.error k
    | Except.ok (val, lossy) =>
      if ((decide (Int.ofNat a - Int.ofNat b < 0) || decide (Int.ofNat a - Int.ofNat b ≥ HPow.hPow (2 : Int) 128) || lossy) &&
          decide (true = true)) = true then Except.error FaultKind.undefined
      else Except.ok (Val.scalar val)) = _
  rw [hDiff]
  rw [s3_truncateScalar_isize_ofNat_lt (a - b) hSubLt]
  dsimp
  have hLt128 : a - b < Nat.pow 2 128 := s3_evalConstLit_usize_lt128 _ hSubLt
  have hNeg : decide (Int.ofNat (a - b) < 0) = false := decide_eq_false (s0_int_not_lt_mpr (s0_int_natCast_nonneg _))
  have hGe : decide (Int.ofNat (a - b) ≥ HPow.hPow (2 : Int) 128) = false := by
    apply decide_eq_false
    intro h
    exact Nat.not_lt_of_le (s0_int_ofNat_le_mp h) hLt128
  exact s3_arith_ite_false _ _ hNeg hGe _ _

private theorem s3_evalBinOp_usize_subUnchecked_err (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize)
    (hLt : a < b) :
    evalBinOp .subUnchecked
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }) =
      .error .undefined := by
  unfold evalBinOp evalArithOp
  dsimp [BinOp.isShift, BinOp.isUnchecked]
  rw [s3_decodeScalar_usize a ha, s3_decodeScalar_usize b hb]
  change (match truncateScalar IntWidth.isize false (Int.ofNat a - Int.ofNat b) with
    | Except.error k => Except.error k
    | Except.ok (val, lossy) =>
      if ((decide (Int.ofNat a - Int.ofNat b < 0) || decide (Int.ofNat a - Int.ofNat b ≥ HPow.hPow (2 : Int) 128) || lossy) &&
          decide (true = true)) = true then Except.error FaultKind.undefined
      else Except.ok (Val.scalar val)) = _
  have hLtInt : Int.ofNat a - Int.ofNat b < 0 :=
    s0_int_sub_lt_iff_mpr (by rw [s0_int_zero_add]; exact s0_int_ofNat_lt_mpr hLt)
  have hNeg : decide (Int.ofNat a - Int.ofNat b < 0) = true := decide_eq_true hLtInt
  rw [hNeg]
  dsimp
  cases hTr : truncateScalar IntWidth.isize false (Int.ofNat a - Int.ofNat b) with
  | error _ => unfold truncateScalar at hTr; cases hTr
  | ok p => rfl

private theorem s3_evalBinOp_usize_bitAnd (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize) :
    evalBinOp .bitAnd
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (Nat.land a b) }) := by
  unfold evalBinOp
  dsimp [BinOp.isShift]
