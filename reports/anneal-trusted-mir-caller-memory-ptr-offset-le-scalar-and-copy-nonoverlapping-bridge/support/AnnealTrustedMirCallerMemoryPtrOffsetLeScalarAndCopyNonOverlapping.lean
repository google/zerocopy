    have h3 := (bool_and_eq_true _ _).mp h2.1
    rw [nat_beq_eq d₁ d₂ h3.1, nat_beq_eq a₁ a₂ h3.2,
      boolEq_eq r₁ r₂ h2.2, nat_beq_eq n₁ n₂ h1.2]
  | .writePtrLe8 a₁ v₁ r₁ n₁, .writePtrLe8 a₂ v₂ r₂ n₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
    have h2 := (bool_and_eq_true _ _).mp h1.1
    have h3 := (bool_and_eq_true _ _).mp h2.1
    rw [nat_beq_eq a₁ a₂ h3.1, nat_beq_eq v₁ v₂ h3.2,
      boolEq_eq r₁ r₂ h2.2, nat_beq_eq n₁ n₂ h1.2]
  | .copyNonOverlapping s₁ d₁ c₁ e₁ a₁ z₁ n₁,
    .copyNonOverlapping s₂ d₂ c₂ e₂ a₂ z₂ n₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
