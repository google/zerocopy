/-! ## Part A: Structural Equality Reflection & Program Equivalence -/

private theorem bool_beq_eq (a b : Bool) (h : (a == b) = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem intWidth_beq_eq (a b : IntWidth) (h : IntWidth.beq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem mutability_beq_eq (a b : Mutability) (h : Mutability.beq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem enumTagRepr_beq_eq : ∀ a b : EnumTagRepr, EnumTagRepr.beq a b = true → a = b
  | .zeroSized, .zeroSized, _ => rfl
  | .zeroSized, .scalar _ _, h => by cases h
  | .scalar _ _, .zeroSized, h => by cases h
  | .scalar w₁ s₁, .scalar w₂ s₂, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [intWidth_beq_eq w₁ w₂ hAnd.1, bool_beq_eq s₁ s₂ hAnd.2]

private theorem natListBeq_eq : ∀ xs ys : List Nat, natListBeq xs ys = true → xs = ys
  | [], [], _ => rfl
  | [], _ :: _, h => by cases h
  | _ :: _, [], h => by cases h
  | x :: xs, y :: ys, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [nat_beq_eq x y hAnd.1, natListBeq_eq xs ys hAnd.2]

private theorem enumTy_beq_eq (a b : EnumTy) (h : EnumTy.beq a b = true) : a = b := by
  cases a with
  | mk id₁ w₁ s₁ tr₁ ds₁ =>
    cases b with
    | mk id₂ w₂ s₂ tr₂ ds₂ =>
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      have h3 := (bool_and_eq_true _ _).mp h2.1
      have h4 := (bool_and_eq_true _ _).mp h3.1
      rw [nat_beq_eq id₁ id₂ h4.1, intWidth_beq_eq w₁ w₂ h4.2,
        bool_beq_eq s₁ s₂ h3.2, enumTagRepr_beq_eq tr₁ tr₂ h2.2,
        natListBeq_eq ds₁ ds₂ h1.2]

mutual
  private theorem mirTy_beq_eq : ∀ t₁ t₂ : MirTy, MirTy.beq t₁ t₂ = true → t₁ = t₂
    | .bool, .bool, _ => rfl
    | .int w₁ s₁, .int w₂ s₂, h => by
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [intWidth_beq_eq w₁ w₂ hAnd.1, bool_beq_eq s₁ s₂ hAnd.2]
    | .unit, .unit, _ => rfl
    | .never, .never, _ => rfl
    | .enum ety₁, .enum ety₂, h => by rw [enumTy_beq_eq ety₁ ety₂ h]
    | .tuple fs₁, .tuple fs₂, h => by rw [mirTy_beqList_eq fs₁ fs₂ h]
    | .ref m₁ p₁, .ref m₂ p₂, h => by
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [mutability_beq_eq m₁ m₂ hAnd.1, mirTy_beq_eq p₁ p₂ hAnd.2]
    | .rawPtr m₁ p₁, .rawPtr m₂ p₂, h => by
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [mutability_beq_eq m₁ m₂ hAnd.1, mirTy_beq_eq p₁ p₂ hAnd.2]
    | .unsupported, .unsupported, _ => rfl
    | .bool, .int _ _, h | .bool, .unit, h | .bool, .never, h
    | .bool, .enum _, h | .bool, .tuple _, h | .bool, .ref _ _, h
    | .bool, .rawPtr _ _, h | .bool, .unsupported, h => by cases h
    | .int _ _, .bool, h | .int _ _, .unit, h | .int _ _, .never, h
    | .int _ _, .enum _, h | .int _ _, .tuple _, h | .int _ _, .ref _ _, h
    | .int _ _, .rawPtr _ _, h | .int _ _, .unsupported, h => by cases h
    | .unit, .bool, h | .unit, .int _ _, h | .unit, .never, h
    | .unit, .enum _, h | .unit, .tuple _, h | .unit, .ref _ _, h
    | .unit, .rawPtr _ _, h | .unit, .unsupported, h => by cases h
    | .never, .bool, h | .never, .int _ _, h | .never, .unit, h
    | .never, .enum _, h | .never, .tuple _, h | .never, .ref _ _, h
    | .never, .rawPtr _ _, h | .never, .unsupported, h => by cases h
    | .enum _, .bool, h | .enum _, .int _ _, h | .enum _, .unit, h
    | .enum _, .never, h | .enum _, .tuple _, h | .enum _, .ref _ _, h
    | .enum _, .rawPtr _ _, h | .enum _, .unsupported, h => by cases h
    | .tuple _, .bool, h | .tuple _, .int _ _, h | .tuple _, .unit, h
    | .tuple _, .never, h | .tuple _, .enum _, h | .tuple _, .ref _ _, h
    | .tuple _, .rawPtr _ _, h | .tuple _, .unsupported, h => by cases h
    | .ref _ _, .bool, h | .ref _ _, .int _ _, h | .ref _ _, .unit, h
    | .ref _ _, .never, h | .ref _ _, .enum _, h | .ref _ _, .tuple _, h
    | .ref _ _, .rawPtr _ _, h | .ref _ _, .unsupported, h => by cases h
    | .rawPtr _ _, .bool, h | .rawPtr _ _, .int _ _, h | .rawPtr _ _, .unit, h
    | .rawPtr _ _, .never, h | .rawPtr _ _, .enum _, h | .rawPtr _ _, .tuple _, h
    | .rawPtr _ _, .ref _ _, h | .rawPtr _ _, .unsupported, h => by cases h
    | .unsupported, .bool, h | .unsupported, .int _ _, h | .unsupported, .unit, h
    | .unsupported, .never, h | .unsupported, .enum _, h | .unsupported, .tuple _, h
    | .unsupported, .ref _ _, h | .unsupported, .rawPtr _ _, h => by cases h

  private theorem mirTy_beqList_eq : ∀ fs₁ fs₂ : List MirTy, MirTy.beqList fs₁ fs₂ = true → fs₁ = fs₂
    | [], [], _ => rfl
    | [], _ :: _, h => by cases h
    | _ :: _, [], h => by cases h
    | x :: xs, y :: ys, h => by
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [mirTy_beq_eq x y hAnd.1, mirTy_beqList_eq xs ys hAnd.2]
end

private theorem bitVec128_beq_eq (a b : BitVec 128) (h : (a == b) = true) : a = b := by
  cases hDec : (BitVec.decEq a b) with
  | isTrue heq => exact heq
  | isFalse _ =>
    have hF : (a == b) = false := by
      change (@decide (a = b) (BitVec.decEq a b)) = false
      unfold decide
      rw [hDec]
    rw [hF] at h
    cases h

private theorem projElemEq_eq : ∀ a b : ProjectionElem, projElemEq a b = true → a = b
  | .deref, .deref, _ => rfl
  | .field i₁ t₁, .field i₂ t₂, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [nat_beq_eq i₁ i₂ hAnd.1, mirTy_beq_eq t₁ t₂ hAnd.2]
  | .unsupported, .unsupported, _ => rfl
  | .deref, .field _ _, h | .deref, .unsupported, h
  | .field _ _, .deref, h | .field _ _, .unsupported, h
  | .unsupported, .deref, h | .unsupported, .field _ _, h => by cases h

private theorem placeEq_eq (a b : Place) (h : placeEq a b = true) : a = b := by
  cases a with
  | mk la pa =>
    cases b with
    | mk lb pb =>
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [nat_beq_eq la lb hAnd.1, listRel_eq_of_eq projElemEq_eq pa pb hAnd.2]

private theorem constLitEq_eq : ∀ a b : ConstLit, constLitEq a b = true → a = b
  | .scalar b₁, .scalar b₂, h => by rw [bitVec128_beq_eq b₁ b₂ h]
  | .zeroSized, .zeroSized, _ => rfl
  | .scalar _, .zeroSized, h | .zeroSized, .scalar _, h => by cases h

private theorem constOpEq_eq (a b : ConstOperand) (h : constOpEq a b = true) : a = b := by
  cases a with
  | mk ta la =>
    cases b with
    | mk tb lb =>
      have hAnd := (bool_and_eq_true _ _).mp h
      rw [mirTy_beq_eq ta tb hAnd.1, constLitEq_eq la lb hAnd.2]

private theorem binOpEq_eq (a b : BinOp) (h : binOpEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem unOpEq_eq (a b : UnOp) (h : unOpEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem operandEq_eq : ∀ a b : Operand, operandEq a b = true → a = b
  | .copy p₁, .copy p₂, h => by rw [placeEq_eq p₁ p₂ h]
  | .move p₁, .move p₂, h => by rw [placeEq_eq p₁ p₂ h]
  | .constant c₁, .constant c₂, h => by rw [constOpEq_eq c₁ c₂ h]
  | .copy _, .move _, h | .copy _, .constant _, h
  | .move _, .copy _, h | .move _, .constant _, h
  | .constant _, .copy _, h | .constant _, .move _, h => by cases h

private theorem rvalueEq_eq : ∀ a b : Rvalue, rvalueEq a b = true → a = b
  | .use o₁, .use o₂, h => by rw [operandEq_eq o₁ o₂ h]
  | .binaryOp op₁ l₁ r₁, .binaryOp op₂ l₂ r₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
    have h2 := (bool_and_eq_true _ _).mp h1.1
    rw [binOpEq_eq op₁ op₂ h2.1, operandEq_eq l₁ l₂ h2.2, operandEq_eq r₁ r₂ h1.2]
  | .unaryOp op₁ o₁, .unaryOp op₂ o₂, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [unOpEq_eq op₁ op₂ hAnd.1, operandEq_eq o₁ o₂ hAnd.2]
  | .discriminant p₁, .discriminant p₂, h => by rw [placeEq_eq p₁ p₂ h]
  | .ref m₁ p₁, .ref m₂ p₂, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [mutability_beq_eq m₁ m₂ hAnd.1, placeEq_eq p₁ p₂ hAnd.2]
  | .addressOf m₁ p₁, .addressOf m₂ p₂, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [mutability_beq_eq m₁ m₂ hAnd.1, placeEq_eq p₁ p₂ hAnd.2]
  | .aggregateTuple fs₁, .aggregateTuple fs₂, h => by
    rw [listRel_eq_of_eq operandEq_eq fs₁ fs₂ h]
  | .unsupported, .unsupported, _ => rfl
  | .use _, .binaryOp _ _ _, h | .use _, .unaryOp _ _, h | .use _, .discriminant _, h
  | .use _, .ref _ _, h | .use _, .addressOf _ _, h | .use _, .aggregateTuple _, h
  | .use _, .unsupported, h
  | .binaryOp _ _ _, .use _, h | .binaryOp _ _ _, .unaryOp _ _, h | .binaryOp _ _ _, .discriminant _, h
  | .binaryOp _ _ _, .ref _ _, h | .binaryOp _ _ _, .addressOf _ _, h | .binaryOp _ _ _, .aggregateTuple _, h
  | .binaryOp _ _ _, .unsupported, h
  | .unaryOp _ _, .use _, h | .unaryOp _ _, .binaryOp _ _ _, h | .unaryOp _ _, .discriminant _, h
  | .unaryOp _ _, .ref _ _, h | .unaryOp _ _, .addressOf _ _, h | .unaryOp _ _, .aggregateTuple _, h
  | .unaryOp _ _, .unsupported, h
  | .discriminant _, .use _, h | .discriminant _, .binaryOp _ _ _, h | .discriminant _, .unaryOp _ _, h
  | .discriminant _, .ref _ _, h | .discriminant _, .addressOf _ _, h | .discriminant _, .aggregateTuple _, h
  | .discriminant _, .unsupported, h
  | .ref _ _, .use _, h | .ref _ _, .binaryOp _ _ _, h | .ref _ _, .unaryOp _ _, h
  | .ref _ _, .discriminant _, h | .ref _ _, .addressOf _ _, h | .ref _ _, .aggregateTuple _, h
  | .ref _ _, .unsupported, h
  | .addressOf _ _, .use _, h | .addressOf _ _, .binaryOp _ _ _, h | .addressOf _ _, .unaryOp _ _, h
  | .addressOf _ _, .discriminant _, h | .addressOf _ _, .ref _ _, h | .addressOf _ _, .aggregateTuple _, h
  | .addressOf _ _, .unsupported, h
  | .aggregateTuple _, .use _, h | .aggregateTuple _, .binaryOp _ _ _, h | .aggregateTuple _, .unaryOp _ _, h
  | .aggregateTuple _, .discriminant _, h | .aggregateTuple _, .ref _ _, h | .aggregateTuple _, .addressOf _ _, h
  | .aggregateTuple _, .unsupported, h
  | .unsupported, .use _, h | .unsupported, .binaryOp _ _ _, h | .unsupported, .unaryOp _ _, h
  | .unsupported, .discriminant _, h | .unsupported, .ref _ _, h | .unsupported, .addressOf _ _, h
  | .unsupported, .aggregateTuple _, h => by cases h

private theorem stmtEq_eq : ∀ a b : StatementKind, stmtEq a b = true → a = b
  | .assign d₁ r₁, .assign d₂ r₂, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [placeEq_eq d₁ d₂ hAnd.1, rvalueEq_eq r₁ r₂ hAnd.2]
  | .storageLive l₁, .storageLive l₂, h => by rw [nat_beq_eq l₁ l₂ h]
  | .storageDead l₁, .storageDead l₂, h => by rw [nat_beq_eq l₁ l₂ h]
  | .nop, .nop, _ => rfl
  | .unsupported, .unsupported, _ => rfl
  | .assign _ _, .storageLive _, h | .assign _ _, .storageDead _, h
  | .assign _ _, .nop, h | .assign _ _, .unsupported, h
  | .storageLive _, .assign _ _, h | .storageLive _, .storageDead _, h
  | .storageLive _, .nop, h | .storageLive _, .unsupported, h
  | .storageDead _, .assign _ _, h | .storageDead _, .storageLive _, h
  | .storageDead _, .nop, h | .storageDead _, .unsupported, h
  | .nop, .assign _ _, h | .nop, .storageLive _, h
  | .nop, .storageDead _, h | .nop, .unsupported, h
  | .unsupported, .assign _ _, h | .unsupported, .storageLive _, h
  | .unsupported, .storageDead _, h | .unsupported, .nop, h => by cases h

private theorem switchTargetsEq_eq (a b : SwitchTargets) (h : switchTargetsEq a b = true) : a = b := by
  cases a with
  | mk br₁ o₁ =>
    cases b with
    | mk br₂ o₂ =>
      have hAnd := (bool_and_eq_true _ _).mp h
      have hBr : br₁ = br₂ := listRel_eq_of_eq (fun x y hxy => by
        cases x with
        | mk vx bx =>
          cases y with
          | mk vy byy =>
            have hPair := (bool_and_eq_true _ _).mp hxy
            rw [bitVec128_beq_eq vx vy hPair.1, nat_beq_eq bx byy hPair.2]) br₁ br₂ hAnd.2
      rw [nat_beq_eq o₁ o₂ hAnd.1, hBr]

private theorem unwindActionEq_eq : ∀ a b : UnwindAction, unwindActionEq a b = true → a = b
  | .continue_, .continue_, _ => rfl
  | .unreachable, .unreachable, _ => rfl
  | .terminate, .terminate, _ => rfl
  | .cleanup b₁, .cleanup b₂, h => by rw [nat_beq_eq b₁ b₂ h]
  | .continue_, .unreachable, h | .continue_, .terminate, h | .continue_, .cleanup _, h
  | .unreachable, .continue_, h | .unreachable, .terminate, h | .unreachable, .cleanup _, h
  | .terminate, .continue_, h | .terminate, .unreachable, h | .terminate, .cleanup _, h
  | .cleanup _, .continue_, h | .cleanup _, .unreachable, h | .cleanup _, .terminate, h => by cases h

