private theorem s3_nat_div_add_mod (a b : Nat) : b * Nat.div a b + Nat.mod a b = a := Nat.div_add_mod a b
private theorem s3_nat_mul_add_div {m : Nat} (hm : 0 < m) (x y : Nat) : Nat.div (m * x + y) m = x + Nat.div y m := s0_nat_mul_add_div hm x y
private theorem s3_nat_mul_add_mod (m x y : Nat) : Nat.mod (m * x + y) m = Nat.mod y m := s0_nat_mul_add_mod m x y
private theorem s3_nat_add_mul_mod_self_left (x y z : Nat) : Nat.mod (x + y * z) y = Nat.mod x y := Nat.add_mul_mod_self_left x y z
private theorem s3_nat_div_one (n : Nat) : Nat.div n 1 = n := Nat.div_one n
private theorem s3_nat_div_eq_of_lt {a b : Nat} (h : a < b) : Nat.div a b = 0 := Nat.div_eq_of_lt h
private theorem s3_nat_div_le_self (a b : Nat) : Nat.div a b ≤ a := Nat.div_le_self a b
private theorem s3_nat_mod_lt (a : Nat) {b : Nat} (hb : 0 < b) : Nat.mod a b < b := Nat.mod_lt a hb
private theorem s3_nat_div_div_eq_div_mul (a b c : Nat) : Nat.div (Nat.div a b) c = Nat.div a (b * c) := Nat.div_div_eq_div_mul a b c
private theorem s3_nat_mod_mod (a b : Nat) : Nat.mod (Nat.mod a b) b = Nat.mod a b := s0_nat_mod_mod a b
private theorem s3_nat_add_mod_left (a b : Nat) : Nat.mod (a + b) a = Nat.mod b a := Nat.add_mod_left a b
private theorem s3_nat_add_mod (a b m : Nat) : Nat.mod (a + b) m = Nat.mod (Nat.mod a m + Nat.mod b m) m := s0_nat_add_mod a b m
private theorem s3_nat_pow_add (a m n : Nat) : Nat.pow a (m + n) = Nat.pow a m * Nat.pow a n := s0_nat_pow_add a m n
private theorem s3_nat_shiftRight_eq_div_pow (m n : Nat) : Nat.shiftRight m n = Nat.div m (Nat.pow 2 n) := s0_nat_shiftRight_eq_div_pow m n
private theorem s3_nat_lt_two_mul_self {a : Nat} (ha : 0 < a) : a < a * 2 := by
  rw [Nat.mul_two]
  exact Nat.lt_add_of_pos_right ha
private theorem s3_nat_zero_lor (x : Nat) : Nat.lor 0 x = x := s0_nat_zero_or x
private theorem s3_nat_testBit_lt_two_pow {x i : Nat} (h : x < Nat.pow 2 i) : x.testBit i = false := s0_nat_testBit_lt_two_pow h
private theorem s3_nat_or_lt_two_pow {a b i : Nat} (ha : a < Nat.pow 2 i) (hb : b < Nat.pow 2 i) : Nat.lor a b < Nat.pow 2 i := s0_nat_or_lt_two_pow ha hb
