    Nat.lt_of_le_of_lt (s0_nat_and_le_left : Nat.land a b ≤ a) ha
  rw [s3_truncateBits_isize (Nat.land a b) (s3_evalConstLit_usize_lt128 _ hLandLt)]
  rw [s3_nat_mod_eq_of_lt hLandLt]
  rfl

private theorem s3_evalBinOp_usize_bitOr (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize) :
