      nat_beq_eq e₁ e₂ h4.2, nat_beq_eq a₁ a₂ h3.2,
      boolEq_eq z₁ z₂ h2.2, nat_beq_eq n₁ n₂ h1.2]
  | .readBufRawByte td₁ vd₁ b₁ o₁ n₁, .readBufRawByte td₂ vd₂ b₂ o₂ n₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
