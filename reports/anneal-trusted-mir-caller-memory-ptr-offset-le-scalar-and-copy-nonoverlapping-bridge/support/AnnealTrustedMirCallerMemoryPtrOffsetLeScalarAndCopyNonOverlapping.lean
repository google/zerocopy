  | .ptrWrappingOffset _ _ _ _, .addrOfByteBuf _ _, h | .ptrWrappingOffset _ _ _ _, .copyPtr _ _ _, h => by cases h

private theorem memCopyTermEq_eq : ∀ a b : MemCopyTerm, memCopyTermEq a b = true → a = b
  | .baseTerm t₁, .baseTerm t₂, h => by rw [terminatorEq_eq t₁ t₂ h]
  | .ptrOffsetInbounds d₁ s₁ c₁ e₁ n₁, .ptrOffsetInbounds d₂ s₂ c₂ e₂ n₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
    have h2 := (bool_and_eq_true _ _).mp h1.1
    have h3 := (bool_and_eq_true _ _).mp h2.1
    have h4 := (bool_and_eq_true _ _).mp h3.1
    rw [nat_beq_eq d₁ d₂ h4.1, nat_beq_eq s₁ s₂ h4.2,
      operandEq_eq c₁ c₂ h3.2, nat_beq_eq e₁ e₂ h2.2, nat_beq_eq n₁ n₂ h1.2]
  | .checkPtrPairAlign s₁ d₁ e₁ a₁ z₁ n₁, .checkPtrPairAlign s₂ d₂ e₂ a₂ z₂ n₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
    have h2 := (bool_and_eq_true _ _).mp h1.1
    have h3 := (bool_and_eq_true _ _).mp h2.1
    have h4 := (bool_and_eq_true _ _).mp h3.1
    have h5 := (bool_and_eq_true _ _).mp h4.1
    rw [nat_beq_eq s₁ s₂ h5.1, nat_beq_eq d₁ d₂ h5.2,
      nat_beq_eq e₁ e₂ h4.2, nat_beq_eq a₁ a₂ h3.2,
      boolEq_eq z₁ z₂ h2.2, nat_beq_eq n₁ n₂ h1.2]
  | .readLeUsize d₁ p₁ w₁ r₁ n₁, .readLeUsize d₂ p₂ w₂ r₂ n₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
    have h2 := (bool_and_eq_true _ _).mp h1.1
    have h3 := (bool_and_eq_true _ _).mp h2.1
    have h4 := (bool_and_eq_true _ _).mp h3.1
    rw [nat_beq_eq d₁ d₂ h4.1, nat_beq_eq p₁ p₂ h4.2,
      leWidthEq_eq w₁ w₂ h3.2, boolEq_eq r₁ r₂ h2.2, nat_beq_eq n₁ n₂ h1.2]
  | .writeLeUsize p₁ v₁ w₁ r₁ n₁, .writeLeUsize p₂ v₂ w₂ r₂ n₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
