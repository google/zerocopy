private theorem s3_maxUsize_mul_maxUsize_lt_128 :
    maxUsize * maxUsize ≤ Nat.pow 2 128 := by
  have h : Nat.pow 2 64 * Nat.pow 2 64 = Nat.pow 2 (64 + 64) :=
    (s3_nat_pow_add 2 64 64).symm
  exact Nat.le_of_eq h

private theorem s3_arith_ite_false (h1 h2 : Bool) (hh1 : h1 = false) (hh2 : h2 = false)
    (a b : Except FaultKind Val) :
    (if ((h1 || h2 || false) && decide (true = true)) = true then a else b) = b := by
  rw [hh1, hh2]; rfl

private theorem s3_arith_ite_unchecked_false (h : Bool) (a b : Except FaultKind Val) :
