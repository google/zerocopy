private theorem s3d_ptrOffsetInbounds_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (dstPtr srcPtr : LocalId) (countOp : Operand) (elemSize : Nat) (nextBb : BasicBlockId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator = .ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3d_blockTerm_check ctx hBbSrc
  have hTib := s3d_blockTerm_targetsInBounds ctx hBbSrc
  rw [hTerm] at hChk hTib
  unfold checkTermForPtrs at hChk; dsimp at hChk
  have hChkP := (bool_and_eq_true _ _).mp hChk
  have hCntChk : checkOffsetCountOp ctx.bodySrc.locals countOp = true := hChkP.1
  have hFindPair := hChkP.2
  cases hFindD : findPtrEntry ctx.plan.entries dstPtr with
  | none => rw [hFindD] at hFindPair; cases hFindPair
  | some pD =>
    cases pD with | mk kD optBufD =>
    cases hFindS : findPtrEntry ctx.plan.entries srcPtr with
    | none => rw [hFindD, hFindS] at hFindPair; cases hFindPair
    | some pS =>
      cases pS with | mk kS optBufS =>
      have hCompat : checkPtrCopyCompat optBufD optBufS = true := by
        rw [hFindD, hFindS] at hFindPair; exact hFindPair
      unfold memCopyTermTargetsInBounds at hTib
      have hTgtLt : nextBb < ctx.bodySrc.basicBlocks.length := (nat_blt_eq_lt _ _).mp hTib
      cases s3d_getElem?_some_of_lt hTgtLt with | intro bbJump hBbJump =>
      cases s3_lowerBlock_getElem?_termPre ctx hBbSrc with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      let off := s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length
      have hf₂Eq : f₂ = {
          defId := ctx.plan.defId
          blockIdx := f₁.blockIdx
          stmtIdx := off
          locals := f₂.locals } := by
        cases f₂ with
        | mk d₂ b₂ s₂ l₂ =>
          dsimp at hDef₂ hBbRel hIdxEq
          have hSt2 : s₂ = off := by rw [hIdxEq, hEnd₁]
          subst hDef₂; subst hBbRel; subst hSt2; rfl
      have hRun : match evalMemCopyTerm ctx.bodySrc bbSrc f₁ mem with
          | .step s₁' =>
            ∃ s₂' : MemCopyState,
              ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
              s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂'
          | .done _ => False
          | .fault k =>
            ∃ s₂' : MemCopyState,
              ReachesMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
              StepMemCopy ctx.pTgt s₂' (.fault k) := by
        cases hConst : constIsizeValue? countOp with
        | some z =>
          exact s3d_ptrOffsetInbounds_const_run ctx dstPtr srcPtr countOp elemSize nextBb z
            optBufD optBufS hEqId hDef₁ hDef₂ hTerm hConst hFindD hFindS hCompat hWf hRel
            hBlock.2.2.1 hf₂Eq hBlock.2.2.2.1 rfl hBlock.2.2.2.2.1 hBbJump
        | none =>
          have hCntBase : operandHasBaseTy ctx.bodySrc.locals usizeTy countOp = true := by
            unfold checkOffsetCountOp at hCntChk
            rw [hConst] at hCntChk; dsimp at hCntChk
            cases hB : operandHasBaseTy ctx.bodySrc.locals usizeTy countOp with
            | true => rfl
            | false => rw [hB] at hCntChk; cases hCntChk
          exact s3d_ptrOffsetInbounds_runtime_run ctx dstPtr srcPtr countOp elemSize nextBb
            optBufD optBufS hEqId hDef₁ hDef₂ hTerm hConst hCntBase hFindD hFindS hCompat hWf hRel
            hBlock.2.2.1 hf₂Eq hBlock.1 hBlock.2.2.2.1 rfl hBlock.2.2.2.2.1 hBlock.2.2.2.2.2 hBbJump
      apply s3d_fwdStepSim_of_term_multi ctx hDef₁ hBbSrc hEnd₁
      · intro s₁' hStep; rw [hStep] at hRun; exact hRun
      · intro out hDone; rw [hDone] at hRun; exact False.elim hRun
      · intro k hFault; rw [hFault] at hRun; exact hRun

/-! ## Section 5: Top-Level `s3_term_step_sim`, `s3_scalarize_step_sim`, & `applyPtrScalarize_sound` -/

private theorem s3_term_step_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  cases hTerm : bbSrc.terminator with
  | baseTerm bt =>
    exact s3d_baseTerm_sim ctx bt hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel
  | ptrOffsetInbounds d s cntOp elemSize nextBb =>
    exact s3d_ptrOffsetInbounds_sim ctx d s cntOp elemSize nextBb
      hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel
  | checkPtrPairAlign s d elemSize reqAlignLog2 checkNonNullZero nextBb =>
    exact s3d_checkPtrPairAlign_sim ctx s d elemSize reqAlignLog2 checkNonNullZero nextBb
      hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel
  | readLeUsize dst p w reqAlign nextBb =>
    exact s3x_readLeUsize_sim ctx dst p w reqAlign nextBb
      hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel
  | writeLeUsize p valOp w reqAlign nextBb =>
    exact s3x_writeLeUsize_sim ctx p valOp w reqAlign nextBb
      hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel
  | readPtrLe8 _ _ _ _ =>
    have hChk := s3d_blockTerm_check ctx hBbSrc
    rw [hTerm] at hChk
    cases hChk
  | writePtrLe8 _ _ _ _ =>
    have hChk := s3d_blockTerm_check ctx hBbSrc
    rw [hTerm] at hChk
    cases hChk
  | copyNonOverlapping s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb =>
    exact s3x_copyNonOverlapping_sim ctx s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb
      hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel
  | readBufRawByte td vd b o nextBb =>
    exact s3d_readBufRawByte_sim ctx td vd b o nextBb
      hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel
  | writeBufRawByte b o t v nextBb =>
    exact s3d_writeBufRawByte_sim ctx b o t v nextBb
      hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel

private theorem s3d_stepMemCopyNext_defId {frame : MemCopyFrame} {mem : CallerMemory}
    {ls : List MemCopySlot} {s' : MemCopyState}
    (h : stepMemCopyNext frame mem ls = .step s') :
    ∀ f' : MemCopyFrame, s'.frames = [f'] → f'.defId = frame.defId := by
  cases StepResult.step.inj h
  intro f' hf
  cases hf
  rfl

private theorem s3d_jumpMemCopyBlock_defId {frame : MemCopyFrame} {mem : CallerMemory}
    {ls : List MemCopySlot} {tgt : BasicBlockId} {s' : MemCopyState}
    (h : jumpMemCopyBlock frame mem ls tgt = .step s') :
    ∀ f' : MemCopyFrame, s'.frames = [f'] → f'.defId = frame.defId := by
  cases StepResult.step.inj h
  intro f' hf
  cases hf
  rfl

private theorem s3d_evalMemCopyStmt_preserves_defId
    (body : MemCopyBody) (frame : MemCopyFrame) (mem : CallerMemory) (stmt : MemCopyStmt)
    {s' : MemCopyState} (h : evalMemCopyStmt body frame mem stmt = .step s') :
    ∀ f' : MemCopyFrame, s'.frames = [f'] → f'.defId = frame.defId := by
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop => exact s3d_stepMemCopyNext_defId h
    | unsupported => cases h
    | storageLive id =>
      dsimp [evalMemCopyStmt] at h
      cases hD : Trusted.MirSemantics.getElem? body.locals id with
      | none => rw [hD] at h; cases h
      | some d =>
        rw [hD] at h; dsimp at h
        cases hS : setElem? frame.locals id (liveUninitMemCopySlot d) with
        | none => rw [hS] at h; cases h
        | some sl =>
          rw [hS] at h
          cases d with
          | byteBuf sz al mutab =>
            dsimp at h
            cases hU : updateAlloc? (internalAllocBase + id)
                { allocId := internalAllocBase + id, alignLog2 := al, mutability := mutab,
                  bytes := listReplicate sz .uninit, live := true } mem.allocations with
            | none => rw [hU] at h; cases h
            | some _ => rw [hU] at h; exact s3d_stepMemCopyNext_defId h
          | base _ | ptrLocal => exact s3d_stepMemCopyNext_defId h
    | storageDead id =>
      dsimp [evalMemCopyStmt] at h
      cases hZ : Nat.beq id 0 with
      | true => rw [hZ] at h; cases h
      | false =>
        rw [hZ] at h; dsimp at h
        cases hD : Trusted.MirSemantics.getElem? body.locals id with
        | none =>
          rw [hD] at h; dsimp at h
          cases hS : setElem? frame.locals id (.baseSlot .dead) with
          | none => rw [hS] at h; cases h
          | some _ => rw [hS] at h; exact s3d_stepMemCopyNext_defId h
        | some d =>
          rw [hD] at h; dsimp at h
          cases hS : setElem? frame.locals id (deadMemCopySlot d) with
          | none => rw [hS] at h; cases h
          | some _ =>
            rw [hS] at h
            cases d with
            | byteBuf sz al mutab =>
              dsimp at h
              cases hU : updateAlloc? (internalAllocBase + id)
                  { allocId := internalAllocBase + id, alignLog2 := al, mutability := mutab,
                    bytes := listReplicate sz .uninit, live := false } mem.allocations with
              | none => rw [hU] at h; cases h
              | some _ => rw [hU] at h; exact s3d_stepMemCopyNext_defId h
            | base _ | ptrLocal => exact s3d_stepMemCopyNext_defId h
    | assign dst rval =>
      dsimp [evalMemCopyStmt] at h
      cases hE : !dst.projection.isEmpty with
      | true => rw [hE] at h; cases h
      | false =>
        rw [hE] at h; dsimp at h
        cases hD : Trusted.MirSemantics.getElem? body.locals dst.localId with
        | none => rw [hD] at h; cases h
        | some d =>
          rw [hD] at h
          cases d with
          | ptrLocal | byteBuf _ _ _ => cases h
          | base dstTy =>
            dsimp at h
            cases hRv : evalMemCopyBaseRvalue body.locals frame.locals dstTy rval with
            | error _ => rw [hRv] at h; cases h
            | ok r1 =>
              rw [hRv] at h; dsimp at h
              cases hWr : writeMemCopyBasePlace r1.2 dst.localId dstTy r1.1 with
              | error _ => rw [hWr] at h; cases h
              | ok _ => rw [hWr] at h; exact s3d_stepMemCopyNext_defId h
  | bufLivenessCheck bufLocal =>
    dsimp [evalMemCopyStmt] at h
    cases hD : Trusted.MirSemantics.getElem? body.locals bufLocal with
    | none => rw [hD] at h; cases h
    | some d =>
      rw [hD] at h
      cases d with
      | base _ | ptrLocal => cases h
      | byteBuf _ _ _ =>
        cases hS : Trusted.MirSemantics.getElem? frame.locals bufLocal with
        | none => rw [hS] at h; cases h
        | some sl =>
          rw [hS] at h
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => cases h
          | bufSlot b =>
            cases b with
            | false => cases h
            | true => exact s3d_stepMemCopyNext_defId h
  | mkNullPtr dstPtr =>
    dsimp [evalMemCopyStmt] at h
    cases hW : writePtrLocal body.locals frame.locals dstPtr
        { allocId := none, offsetBytes := 0, width := .isize } with
    | error _ => rw [hW] at h; cases h
    | ok _ => rw [hW] at h; exact s3d_stepMemCopyNext_defId h
  | mkDanglingPtr dstPtr alignLog2 =>
    change (if !Nat.ble alignLog2 30 then StepResult.fault .unsupported
      else match writePtrLocal body.locals frame.locals dstPtr
          { allocId := none, offsetBytes := UInt64.ofNat (Nat.pow 2 alignLog2), width := .isize } with
        | .ok slots' => stepMemCopyNext frame mem slots'
        | .error k => StepResult.fault k) = .step s' at h
    cases hB : !Nat.ble alignLog2 30 with
    | true => rw [hB] at h; cases h
    | false =>
      rw [hB] at h
      change (match writePtrLocal body.locals frame.locals dstPtr
          { allocId := none, offsetBytes := UInt64.ofNat (Nat.pow 2 alignLog2), width := .isize } with
        | .ok slots' => stepMemCopyNext frame mem slots'
        | .error k => StepResult.fault k) = .step s' at h
      cases hW : writePtrLocal body.locals frame.locals dstPtr
          { allocId := none, offsetBytes := UInt64.ofNat (Nat.pow 2 alignLog2), width := .isize } with
      | error _ => rw [hW] at h; cases h
      | ok _ => rw [hW] at h; exact s3d_stepMemCopyNext_defId h
  | addrOfByteBuf dstPtr bufLocal =>
    dsimp [evalMemCopyStmt] at h
    cases hD : Trusted.MirSemantics.getElem? body.locals bufLocal with
    | none => rw [hD] at h; cases h
    | some d =>
      rw [hD] at h
      cases d with
      | base _ | ptrLocal => cases h
      | byteBuf _ _ _ =>
        cases hS : Trusted.MirSemantics.getElem? frame.locals bufLocal with
        | none => rw [hS] at h; cases h
        | some sl =>
          rw [hS] at h
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => cases h
          | bufSlot b =>
            cases b with
            | false =>
              cases hD2 : Trusted.MirSemantics.getElem? body.locals dstPtr with
              | none => rw [hD2] at h; cases h
              | some d2 => rw [hD2] at h; cases d2 <;> cases h
            | true =>
              dsimp at h
              cases hW : writePtrLocal body.locals frame.locals dstPtr
                  { allocId := some (internalAllocBase + bufLocal), offsetBytes := 0, width := .isize } with
              | error _ => rw [hW] at h; cases h
              | ok _ => rw [hW] at h; exact s3d_stepMemCopyNext_defId h
  | copyPtr dstPtr srcPtr isMove =>
    dsimp [evalMemCopyStmt] at h
    cases hR : readPtrLocal body.locals frame.locals srcPtr isMove with
    | error _ => rw [hR] at h; cases h
    | ok r1 =>
      rw [hR] at h; dsimp at h
      cases hW : writePtrLocal body.locals r1.2 dstPtr r1.1 with
      | error _ => rw [hW] at h; cases h
      | ok _ => rw [hW] at h; exact s3d_stepMemCopyNext_defId h
  | ptrWrappingOffset dstPtr srcPtr countOp elemSize =>
    dsimp [evalMemCopyStmt] at h
    cases hE : evalOffsetCountOp body.locals frame.locals countOp with
    | error _ => rw [hE] at h; cases h
    | ok r1 =>
      rw [hE] at h; dsimp at h
      cases hR : readPtrLocal body.locals r1.2 srcPtr false with
      | error _ => rw [hR] at h; cases h
      | ok r2 =>
        rw [hR] at h; dsimp at h
        cases hW : writePtrLocal body.locals r2.2 dstPtr (calcWrappingOffset r2.1 r1.1 elemSize) with
        | error _ => rw [hW] at h; cases h
        | ok _ => rw [hW] at h; exact s3d_stepMemCopyNext_defId h

private theorem s3d_evalMemCopyTerm_preserves_defId
    (body : MemCopyBody) (bb : MemCopyBlock) (frame : MemCopyFrame) (mem : CallerMemory)
    {s' : MemCopyState} (h : evalMemCopyTerm body bb frame mem = .step s') :
    ∀ f' : MemCopyFrame, s'.frames = [f'] → f'.defId = frame.defId := by
  cases hT : bb.terminator with
  | baseTerm bt =>
    cases bt with
    | goto _ =>
      dsimp [evalMemCopyTerm] at h; rw [hT] at h
      exact s3d_jumpMemCopyBlock_defId h
    | return_ =>
      dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
      cases hCl : bb.cleanup with
      | true => rw [hCl] at h; cases h
      | false =>
        rw [hCl] at h; dsimp at h
        cases hD0 : Trusted.MirSemantics.getElem? body.locals 0 with
        | none =>
          rw [hD0] at h
          cases hF0 : Trusted.MirSemantics.getElem? frame.locals 0 with
          | none => rw [hF0] at h; cases h
          | some sl =>
            rw [hF0] at h
            cases sl with
            | ptrDead | livePtr _ | bufSlot _ => cases h
            | baseSlot bs => cases bs with | dead => cases h | live ov => cases ov <;> cases h
        | some d0 =>
          rw [hD0] at h
          cases d0 with
          | byteBuf _ _ _ =>
            cases hF0 : Trusted.MirSemantics.getElem? frame.locals 0 with
            | none => rw [hF0] at h; cases h
            | some _ => rw [hF0] at h; cases h
          | base _ =>
            cases hF0 : Trusted.MirSemantics.getElem? frame.locals 0 with
            | none => rw [hF0] at h; cases h
            | some sl =>
              rw [hF0] at h
              cases sl with
              | ptrDead | livePtr _ | bufSlot _ => cases h
              | baseSlot bs => cases bs with | dead => cases h | live ov => cases ov <;> cases h
          | ptrLocal =>
            cases hF0 : Trusted.MirSemantics.getElem? frame.locals 0 with
            | none => rw [hF0] at h; cases h
            | some sl =>
              rw [hF0] at h
              cases sl with
              | baseSlot _ | bufSlot _ | ptrDead => cases h
              | livePtr opv =>
                cases opv with
                | none => cases h
                | some pv =>
                  dsimp at h
                  cases hAcc : !body.acceptsCallerMem with
                  | true => rw [hAcc] at h; cases h
                  | false =>
                    rw [hAcc] at h; dsimp at h
                    cases hAl : pv.allocId with
                    | none => rw [hAl] at h; cases h
                    | some aid =>
                      rw [hAl] at h; dsimp at h
                      cases hBlt : !Nat.blt aid internalAllocBase with
                      | true => rw [hBlt] at h; cases h
                      | false => rw [hBlt] at h; cases h
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      dsimp [evalMemCopyTerm] at h; rw [hT] at h; cases h
    | switchInt discr targets =>
      dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
      cases hEv : evalMemCopyPrimitiveOperand body.locals frame.locals discr with
      | error _ => rw [hEv] at h; cases h
      | ok r1 =>
        rw [hEv] at h; dsimp at h
        cases hV : r1.1 with
        | scalar sv =>
          rw [hV] at h; dsimp at h
          cases hTg : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
          | error _ => rw [hTg] at h; cases h
          | ok _ => rw [hTg] at h; exact s3d_jumpMemCopyBlock_defId h
        | bool b =>
          rw [hV] at h; dsimp at h
          cases hTg : evalBoolSwitchBranches b targets.otherwise targets.branches with
          | error _ => rw [hTg] at h; cases h
          | ok _ => rw [hTg] at h; exact s3d_jumpMemCopyBlock_defId h
        | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ =>
          rw [hV] at h; cases h
  | ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hC : evalOffsetCountOp body.locals frame.locals countOp with
    | error _ => rw [hC] at h; cases h
    | ok r1 =>
      rw [hC] at h; dsimp at h
      cases hR : readPtrLocal body.locals r1.2 srcPtr false with
      | error _ => rw [hR] at h; cases h
      | ok r2 =>
        rw [hR] at h; dsimp at h
        cases hCalc : calcInboundsOffset mem r2.1 r1.1 elemSize with
        | error _ => rw [hCalc] at h; cases h
        | ok pv' =>
          rw [hCalc] at h; dsimp at h
          cases hW : writePtrLocal body.locals r2.2 dstPtr pv' with
          | error _ => rw [hW] at h; cases h
          | ok _ => rw [hW] at h; exact s3d_jumpMemCopyBlock_defId h
  | checkPtrPairAlign srcPtr dstPtr _elemSize reqAlignLog2 checkNonNullZero nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hB : !Nat.ble reqAlignLog2 30 with
    | true => rw [hB] at h; cases h
    | false =>
      rw [hB] at h; dsimp at h
      cases hRs : readPtrLocal body.locals frame.locals srcPtr false with
      | error _ => rw [hRs] at h; cases h
      | ok r1 =>
        rw [hRs] at h; dsimp at h
        cases hRd : readPtrLocal body.locals r1.2 dstPtr false with
        | error _ => rw [hRd] at h; cases h
        | ok r2 =>
          rw [hRd] at h; dsimp at h
          cases hAs : checkPtrAlignMem mem r1.1 reqAlignLog2 with
          | error _ => rw [hAs] at h; cases h
          | ok u1 =>
            cases u1
            cases hAd : checkPtrAlignMem mem r2.1 reqAlignLog2 with
            | error _ => rw [hAs, hAd] at h; cases h
            | ok u2 =>
              cases u2
              rw [hAs, hAd] at h; dsimp at h
              cases hNz : checkNonNullZero && (isNullPtr r1.1 || isNullPtr r2.1) with
              | true => rw [hNz] at h; cases h
              | false => rw [hNz] at h; exact s3d_jumpMemCopyBlock_defId h
  | readLeUsize dstLocal ptrLocal w requireAligned nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals dstLocal with
    | none => rw [hD] at h; cases h
    | some d =>
      rw [hD] at h
      cases d with
      | ptrLocal | byteBuf _ _ _ => cases h
      | base dstTy =>
        dsimp at h
        cases hTy : !MirTy.beq dstTy usizeTy with
        | true => rw [hTy] at h; cases h
        | false =>
          rw [hTy] at h; dsimp at h
          cases hR : readPtrLocal body.locals frame.locals ptrLocal false with
          | error _ => rw [hR] at h; cases h
          | ok r1 =>
            rw [hR] at h; dsimp at h
            cases hRm : readMemSlice mem r1.1 w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) with
            | error _ => rw [hRm] at h; cases h
            | ok bs =>
              rw [hRm] at h; dsimp at h
              cases hDec : decodeLeUsize w bs with
              | error _ => rw [hDec] at h; cases h
              | ok valNat =>
                rw [hDec] at h; dsimp at h
                cases hW : writeMemCopyBasePlace r1.2 dstLocal usizeTy
                    (.scalar ⟨.isize, false, BitVec.ofNat 128 valNat⟩) with
                | error _ => rw [hW] at h; cases h
                | ok _ => rw [hW] at h; exact s3d_jumpMemCopyBlock_defId h
  | writeLeUsize ptrLocal valOp w requireAligned nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hEv : evalUsizeOp body.locals frame.locals valOp with
    | error _ => rw [hEv] at h; cases h
    | ok r1 =>
      rw [hEv] at h; dsimp at h
      cases hR : readPtrLocal body.locals r1.2 ptrLocal false with
      | error _ => rw [hR] at h; cases h
      | ok r2 =>
        rw [hR] at h; dsimp at h
        cases hWm : writeMemSlice mem r2.1 (encodeLeUsize w r1.1)
            (if requireAligned then w.naturalAlignLog2 else 0) with
        | error _ => rw [hWm] at h; cases h
        | ok _ => rw [hWm] at h; exact s3d_jumpMemCopyBlock_defId h
  | readPtrLe8 dstPtr addrPtr requireAligned nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals dstPtr with
    | none => rw [hD] at h; cases h
    | some d =>
      rw [hD] at h
      cases d with
      | base _ | byteBuf _ _ _ => cases h
      | ptrLocal =>
        dsimp at h
        cases hR : readPtrLocal body.locals frame.locals addrPtr false with
        | error _ => rw [hR] at h; cases h
        | ok r1 =>
          rw [hR] at h; dsimp at h
          cases hRm : readMemSlice mem r1.1 8 (if requireAligned then 3 else 0) with
          | error _ => rw [hRm] at h; cases h
          | ok bs =>
            rw [hRm] at h; dsimp at h
            cases hDec : decodePtrLe8 bs with
            | error _ => rw [hDec] at h; cases h
            | ok pvOut =>
              rw [hDec] at h; dsimp at h
              cases hW : writePtrLocal body.locals r1.2 dstPtr pvOut with
              | error _ => rw [hW] at h; cases h
              | ok _ => rw [hW] at h; exact s3d_jumpMemCopyBlock_defId h
  | writePtrLe8 addrPtr valPtr requireAligned nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hRa : readPtrLocal body.locals frame.locals addrPtr false with
    | error _ => rw [hRa] at h; cases h
    | ok r1 =>
      rw [hRa] at h; dsimp at h
      cases hRv : readPtrLocal body.locals r1.2 valPtr false with
      | error _ => rw [hRv] at h; cases h
      | ok r2 =>
        rw [hRv] at h; dsimp at h
        cases hWm : writeMemSlice mem r1.1
            (encodeLeBytesAux r2.1.allocId 8 r2.1.offsetBytes.toNat)
            (if requireAligned then 3 else 0) with
        | error _ => rw [hWm] at h; cases h
        | ok _ => rw [hWm] at h; exact s3d_jumpMemCopyBlock_defId h
  | copyNonOverlapping srcPtr dstPtr countOp elemSize reqAlignLog2 checkNonNullZero nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hB : !Nat.ble reqAlignLog2 30 with
    | true => rw [hB] at h; cases h
    | false =>
      rw [hB] at h; dsimp at h
      cases hEv : evalUsizeOp body.locals frame.locals countOp with
      | error _ => rw [hEv] at h; cases h
      | ok r1 =>
        rw [hEv] at h; dsimp at h
        cases hRs : readPtrLocal body.locals r1.2 srcPtr false with
        | error _ => rw [hRs] at h; cases h
        | ok r2 =>
          rw [hRs] at h; dsimp at h
          cases hRd : readPtrLocal body.locals r2.2 dstPtr false with
          | error _ => rw [hRd] at h; cases h
          | ok r3 =>
            rw [hRd] at h; dsimp at h
            cases hCp : evalCopyNonOverlapping mem r2.1 r3.1 r1.1 elemSize
                reqAlignLog2 checkNonNullZero with
            | error _ => rw [hCp] at h; cases h
            | ok _ => rw [hCp] at h; exact s3d_jumpMemCopyBlock_defId h
  | readBufRawByte tagDst valDst bufLocal offOp nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hSame : Nat.beq tagDst valDst with
    | true => rw [hSame] at h; cases h
    | false =>
      rw [hSame] at h; dsimp at h
      cases hDt : Trusted.MirSemantics.getElem? body.locals tagDst with
      | none => rw [hDt] at h; cases h
      | some dt =>
        rw [hDt] at h
        cases dt with
        | ptrLocal | byteBuf _ _ _ => cases h
        | base tTy =>
          cases hDv : Trusted.MirSemantics.getElem? body.locals valDst with
          | none => rw [hDv] at h; cases h
          | some dv =>
            rw [hDv] at h
            cases dv with
            | ptrLocal | byteBuf _ _ _ => cases h
            | base vTy =>
              cases hDb : Trusted.MirSemantics.getElem? body.locals bufLocal with
              | none => rw [hDb] at h; cases h
              | some db =>
                rw [hDb] at h
                cases db with
                | base _ | ptrLocal => cases h
                | byteBuf _ _ _ =>
                  dsimp at h
                  cases hTy : !(MirTy.beq tTy usizeTy) || !(MirTy.beq vTy usizeTy) with
                  | true => rw [hTy] at h; cases h
                  | false =>
                    rw [hTy] at h; dsimp at h
                    cases hEv : evalUsizeOp body.locals frame.locals offOp with
                    | error _ => rw [hEv] at h; cases h
                    | ok r1 =>
                      rw [hEv] at h; dsimp at h
                      cases hSl : Trusted.MirSemantics.getElem? r1.2 bufLocal with
                      | none => rw [hSl] at h; cases h
                      | some sl =>
                        rw [hSl] at h
                        cases sl with
                        | baseSlot _ | ptrDead | livePtr _ => cases h
                        | bufSlot b =>
                          cases b with
                          | false => cases h
                          | true =>
                            dsimp at h
                            cases hFd : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                            | none => rw [hFd] at h; cases h
                            | some alloc =>
                              rw [hFd] at h; dsimp at h
                              cases hLv : !alloc.live with
                              | true => rw [hLv] at h; cases h
                              | false =>
                                rw [hLv] at h; dsimp at h
                                cases hBy : Trusted.MirSemantics.getElem? alloc.bytes r1.1 with
                                | none => rw [hBy] at h; cases h
                                | some ab =>
                                  rw [hBy] at h; dsimp at h
                                  cases hBt : !Nat.blt (encodeAllocByte ab).1 maxUsize with
                                  | true => rw [hBt] at h; cases h
                                  | false =>
                                    rw [hBt] at h; dsimp at h
                                    cases hW1 : writeMemCopyBasePlace r1.2 tagDst usizeTy
                                        (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩) with
                                    | error _ => rw [hW1] at h; cases h
                                    | ok sl2 =>
                                      rw [hW1] at h; dsimp at h
                                      cases hW2 : writeMemCopyBasePlace sl2 valDst usizeTy
                                          (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩) with
                                      | error _ => rw [hW2] at h; cases h
                                      | ok _ => rw [hW2] at h; exact s3d_jumpMemCopyBlock_defId h
  | writeBufRawByte bufLocal offOp tagOp valOp nextBb =>
    dsimp [evalMemCopyTerm] at h; rw [hT] at h; dsimp at h
    cases hDb : Trusted.MirSemantics.getElem? body.locals bufLocal with
    | none => rw [hDb] at h; cases h
    | some db =>
      rw [hDb] at h
      cases db with
      | base _ | ptrLocal => cases h
      | byteBuf _ _ _ =>
        dsimp at h
        cases hE1 : evalUsizeOp body.locals frame.locals offOp with
        | error _ => rw [hE1] at h; cases h
        | ok r1 =>
          rw [hE1] at h; dsimp at h
          cases hE2 : evalUsizeOp body.locals r1.2 tagOp with
          | error _ => rw [hE2] at h; cases h
          | ok r2 =>
            rw [hE2] at h; dsimp at h
            cases hE3 : evalUsizeOp body.locals r2.2 valOp with
            | error _ => rw [hE3] at h; cases h
            | ok r3 =>
              rw [hE3] at h; dsimp at h
              cases hSl : Trusted.MirSemantics.getElem? r3.2 bufLocal with
              | none => rw [hSl] at h; cases h
              | some sl =>
                rw [hSl] at h
                cases sl with
                | baseSlot _ | ptrDead | livePtr _ => cases h
                | bufSlot b =>
                  cases b with
                  | false => cases h
                  | true =>
                    dsimp at h
                    cases hFd : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                    | none => rw [hFd] at h; cases h
                    | some alloc =>
                      rw [hFd] at h; dsimp at h
                      cases hBad : !alloc.live || !Mutability.beq alloc.mutability .mut ||
                          !Nat.blt r1.1 alloc.bytes.length with
                      | true => rw [hBad] at h; cases h
                      | false =>
                        rw [hBad] at h; dsimp at h
                        cases hUp : updateAlloc? (internalAllocBase + bufLocal)
                            { alloc with bytes := spliceBytes alloc.bytes r1.1 [decodeAllocByte r2.1 r3.1] }
                            mem.allocations with
                        | none => rw [hUp] at h; cases h
                        | some _ => rw [hUp] at h; exact s3d_jumpMemCopyBlock_defId h

private theorem s3d_evalStepMemCopy_preserves_defId
    (p : MemCopyProgram) (defId : DefId) (s s' : MemCopyState)
    (hEntry : ∀ f : MemCopyFrame, s.frames = [f] → f.defId = defId)
    (hStep : evalStepMemCopy p 0 s = .step s') :
    ∀ f' : MemCopyFrame, s'.frames = [f'] → f'.defId = defId := by
  unfold evalStepMemCopy at hStep
  cases hFr : s.frames with
  | nil => rw [hFr] at hStep; cases hStep
  | cons f tl =>
    cases tl with
    | cons _ _ => rw [hFr] at hStep; cases hStep
    | nil =>
      rw [hFr] at hStep
      have hFid : f.defId = defId := hEntry f hFr
      dsimp at hStep
      cases hB : Trusted.MirSemantics.getElem? p.bodies f.defId with
      | none => rw [hB] at hStep; cases hStep
      | some body =>
        rw [hB] at hStep; dsimp at hStep
        cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
        | none => rw [hBb] at hStep; cases hStep
        | some bb =>
          rw [hBb] at hStep; dsimp at hStep
          cases hSt : Trusted.MirSemantics.getElem? bb.statements f.stmtIdx with
          | some stmt =>
            rw [hSt] at hStep; dsimp at hStep
            rw [← hFid]
            exact s3d_evalMemCopyStmt_preserves_defId body f s.mem stmt hStep
          | none =>
            rw [hSt] at hStep; dsimp at hStep
            cases hEqL : Nat.beq f.stmtIdx bb.statements.length with
            | false => rw [hEqL] at hStep; cases hStep
            | true =>
              rw [hEqL] at hStep; dsimp at hStep
              rw [← hFid]
              exact s3d_evalMemCopyTerm_preserves_defId body bb f s.mem hStep

private theorem s3_scalarize_step_sim (ctx : s3_PtrCtx) (s₁ s₂ : MemCopyState)
    (hRel : s3_SimRel ctx ctx.pSrc ctx.pTgt s₁ s₂) :
    (∀ s₁' : MemCopyState, evalStepMemCopy ctx.pSrc 0 s₁ = .step s₁' →
      ∃ s₂' : MemCopyState, ReachesPlusMemCopy ctx.pTgt s₂ s₂' ∧
        s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂') ∧
    (∀ out : TerminalOut, evalStepMemCopy ctx.pSrc 0 s₁ = .done out →
      ∃ s₂' : MemCopyState, ReachesMemCopy ctx.pTgt s₂ s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.done out)) ∧
    (∀ k : FaultKind, evalStepMemCopy ctx.pSrc 0 s₁ = .fault k →
      ∃ s₂' : MemCopyState, ReachesMemCopy ctx.pTgt s₂ s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.fault k)) := by
  unfold s3_SimRel at hRel
  cases hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId with
  | true =>
    rw [hEqId] at hRel; dsimp at hRel
    cases hRel with | intro f₁ hR1 =>
    cases hR1 with | intro f₂ hR2 =>
    cases hR2 with | intro mem hR3 =>
    cases hR3 with | intro bbSrc hR4 =>
    have hs₁ := hR4.1
    have hs₂ := hR4.2.1
    have hDef₁ := hR4.2.2.1
    have hDef₂ := hR4.2.2.2.1
    have hBbRel := hR4.2.2.2.2.1
    have hBbSrc := hR4.2.2.2.2.2.1
    have hStmtLe := hR4.2.2.2.2.2.2.1
    have hIdxEq := hR4.2.2.2.2.2.2.2.1
    have hWf := hR4.2.2.2.2.2.2.2.2.1
    have hSlots := hR4.2.2.2.2.2.2.2.2.2
    rw [hs₁, hs₂]
    cases Nat.decLt f₁.stmtIdx bbSrc.statements.length with
    | isTrue hLt =>
      cases s3d_getElem?_some_of_lt hLt with | intro stmt hStmt =>
      exact s3_stmt_step_sim ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxEq hWf hSlots
    | isFalse hNotLt =>
      have hEnd₁ : f₁.stmtIdx = bbSrc.statements.length :=
        Nat.le_antisymm hStmtLe (Nat.le_of_not_lt hNotLt)
      exact s3_term_step_sim ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hEnd₁ hIdxEq hWf hSlots
  | false =>
    rw [hEqId] at hRel; dsimp at hRel
    have hSEq : s₁ = s₂ := hRel.1
    have hDefEntry : ∀ f : MemCopyFrame, s₁.frames = [f] → f.defId = ctx.pSrc.entryDefId := hRel.2
    rw [← hSEq]
    have hNeId : ctx.plan.defId ≠ ctx.pSrc.entryDefId := nat_beq_false_ne hEqId
    have hEvalEq : evalStepMemCopy ctx.pTgt 0 s₁ = evalStepMemCopy ctx.pSrc 0 s₁ := by
      cases s₁ with | mk fs m =>
      cases fs with
      | nil => rfl
      | cons f tl =>
        cases tl with
        | cons _ _ => rfl
        | nil =>
          have hFd : f.defId = ctx.pSrc.entryDefId := hDefEntry f rfl
          have hNe : ctx.plan.defId ≠ f.defId := by rw [hFd]; exact hNeId
          have hBdyEq : Trusted.MirSemantics.getElem? ctx.pTgt.bodies f.defId =
              Trusted.MirSemantics.getElem? ctx.pSrc.bodies f.defId :=
            s3_getElem?_setElem?_ne ctx.pSrc.bodies ctx.plan.defId f.defId ctx.bodyTgt ctx.pTgt.bodies
              hNe ctx.hSetBody
          unfold evalStepMemCopy; dsimp
          rw [hBdyEq]
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      have hStepTgt : evalStepMemCopy ctx.pTgt 0 s₁ = .step s₁' := by
        rw [hEvalEq]; exact hStep
      have hPres := s3d_evalStepMemCopy_preserves_defId ctx.pSrc ctx.pSrc.entryDefId s₁ s₁' hDefEntry hStep
      refine ⟨s₁', s3_step_reachesPlus hStepTgt, ?_⟩
      unfold s3_SimRel
      rw [hEqId]; dsimp
      exact ⟨rfl, hPres⟩
    · intro out hDone
      refine ⟨s₁, ReachesMemCopy.refl _, ?_⟩
      rw [stepMemCopy_iff_evalStep, hEvalEq]
      exact hDone
    · intro k hFault
      refine ⟨s₁, ReachesMemCopy.refl _, ?_⟩
      rw [stepMemCopy_iff_evalStep, hEvalEq]
      exact hFault

private theorem applyPtrScalarize_sound (plan : PtrScalarizePlan)
    (pSrc pTgt : MemCopyProgram)
    (hApp : applyPtrScalarize plan pSrc = some pTgt) :
    FullSemanticEquivMemCopy pSrc pTgt := by
  unfold applyPtrScalarize at hApp
  cases hB : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => rw [hB] at hApp; cases hApp
  | some body =>
    rw [hB] at hApp; dsimp at hApp
    cases hPre1 : (body.acceptsCallerMem ||
        body.basicBlocks.isEmpty ||
        !Nat.blt body.argumentCount body.locals.length ||
        !memCopyStorageAnnotationsInBounds body ||
        !memCopyBodyLocalsInBounds body ||
        !memCopyBodyTargetsInBounds body ||
        !checkPtrBackingEntriesLoop body.locals body.argumentCount 0
          body.locals plan.entries) with
    | true => rw [hPre1] at hApp; cases hApp
    | false =>
      rw [hPre1] at hApp; dsimp at hApp
      cases hPre2 : (!body.basicBlocks.all (fun bb =>
          bb.statements.all (checkStmtForPtrs body.locals plan.entries) &&
            checkTermForPtrs body.locals plan.entries bb.terminator)) with
      | true => rw [hPre2] at hApp; cases hApp
      | false =>
        rw [hPre2] at hApp; dsimp at hApp
        cases hSet : setElem? pSrc.bodies plan.defId {
            body with
            locals := tombstonePtrDecls body.locals ++
              ptrCompDecls plan.entries.length ++ ptrScratchDecls
            basicBlocks :=
              (lowerBlocksForPtrsLoop body.locals plan.entries body.locals.length
                body.basicBlocks.length body.basicBlocks).1 ++
              (lowerBlocksForPtrsLoop body.locals plan.entries body.locals.length
                body.basicBlocks.length body.basicBlocks).2
          } with
        | none => rw [hSet] at hApp; cases hApp
        | some bodiesTgt =>
          rw [hSet] at hApp
          have hP : { pSrc with bodies := bodiesTgt } = pTgt := Option.some.inj hApp
          have hP1 : ∀ (a b : Bool), (a || b) = false → a = false ∧ b = false := by
            intro a b h; cases a <;> cases b <;> first | exact ⟨rfl, rfl⟩ | cases h
          have h1 := hP1 _ _ hPre1
          have h2 := hP1 _ _ h1.1
          have h3 := hP1 _ _ h2.1
          have h4 := hP1 _ _ h3.1
          have h5 := hP1 _ _ h4.1
          have h6 := hP1 _ _ h5.1
          let ctx : s3_PtrCtx := {
            plan := plan
            pSrc := pSrc
            pTgt := pTgt
            bodySrc := body
            bodyTgt := {
              body with
              locals := tombstonePtrDecls body.locals ++
                ptrCompDecls plan.entries.length ++ ptrScratchDecls
              basicBlocks :=
                (lowerBlocksForPtrsLoop body.locals plan.entries body.locals.length
                  body.basicBlocks.length body.basicBlocks).1 ++
                (lowerBlocksForPtrsLoop body.locals plan.entries body.locals.length
                  body.basicBlocks.length body.basicBlocks).2
            }
            hBodies := hB
            hNoCaller := h6.1
            hNonEmpty := h6.2
            hArgLt := (nat_blt_eq_lt _ _).mp ((bool_not_eq_false _).mp h5.2)
            hAnnot := (bool_not_eq_false _).mp h4.2
            hLocalsIb := (bool_not_eq_false _).mp h3.2
            hTargetsIb := (bool_not_eq_false _).mp h2.2
            hEntries := (bool_not_eq_false _).mp h1.2
            hBlocksCheck := (bool_not_eq_false _).mp hPre2
            hSetBody := by rw [← hP]; exact hSet
            hBodyTgtEq := rfl
            hPtgtOther := ⟨by rw [← hP], by rw [← hP], by rw [← hP]⟩
          }
          refine fullSemanticEquivMemCopy_of_fwd_stutter_sim pSrc pTgt
            (fun s₁ s₂ => s3_SimRel ctx pSrc pTgt s₁ s₂)
            (fun _ => 0)
            (fun q => ?_)
            (fun s₁ s₂ hRel => ?_)
          · have hInit := s3_initStateMemCopy_simRel ctx q
            change match initStateMemCopy pSrc q, initStateMemCopy pTgt q with
              | .ok s₁, .ok s₂ => s3_SimRel ctx pSrc pTgt s₁ s₂
              | .error k₁, .error k₂ => k₁ = k₂
              | _, _ => False at hInit
            refine ⟨?_, ?_⟩
            · intro k
              cases hI1 : initStateMemCopy pSrc q with
              | error k₁ =>
                rw [hI1] at hInit
                cases hI2 : initStateMemCopy pTgt q with
                | error k₂ =>
                  rw [hI2] at hInit; dsimp at hInit
                  exact Iff.intro
                    (fun hk => by rw [← hInit, hk])
                    (fun hk => by rw [hInit, hk])
                | ok _ => rw [hI2] at hInit; exact False.elim hInit
              | ok _ =>
                rw [hI1] at hInit
                cases hI2 : initStateMemCopy pTgt q with
                | error _ => rw [hI2] at hInit; exact False.elim hInit
                | ok _ =>
                  exact Iff.intro (fun hk => by cases hk) (fun hk => by cases hk)
            · intro s₁ hOk
              cases hI1 : initStateMemCopy pSrc q with
              | error _ => rw [hI1] at hOk; cases hOk
              | ok s₁' =>
                rw [hI1] at hOk hInit
                cases hI2 : initStateMemCopy pTgt q with
                | error _ => rw [hI2] at hInit; exact False.elim hInit
                | ok s₂ =>
                  rw [hI2] at hInit; dsimp at hInit
                  cases hOk
                  exact ⟨s₂, rfl, hInit⟩
          · have hSim := s3_scalarize_step_sim ctx s₁ s₂ hRel
            exact ⟨fun s₁' hStep => Or.inr (hSim.1 s₁' hStep), hSim.2.1, hSim.2.2⟩

