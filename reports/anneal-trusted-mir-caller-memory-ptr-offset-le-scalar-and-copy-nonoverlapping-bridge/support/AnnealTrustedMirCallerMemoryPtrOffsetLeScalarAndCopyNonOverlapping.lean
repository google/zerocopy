private theorem s3_eval_mkBinOpStmt_err (body : MemCopyBody) (frame : MemCopyFrame) (mem : CallerMemory)
    (dst : LocalId) (dstTy : MirTy) (bop : BinOp) (lhs rhs : Operand)
