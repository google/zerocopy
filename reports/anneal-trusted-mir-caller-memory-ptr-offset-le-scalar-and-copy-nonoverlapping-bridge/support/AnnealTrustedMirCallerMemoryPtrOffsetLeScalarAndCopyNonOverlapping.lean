/-!
# F1-16 Slice 3d: `PtrScalarize` Terminator & Full Simulation Soundness

This module proves forward stuttering simulation and `FullSemanticEquivMemCopy`
soundness for Pass 3 (`PtrScalarize`) on `MemCopyProgram`:
1. Section 1: Term checking unpack helpers, target-block lookups, return-ABI
   invariance (`hasInternalBufs` / local 0), and arithmetic bounds helpers.
2. Section 2: Simulation of `.baseTerm`, `.readBufRawByte`, and
   `.writeBufRawByte`.
3. Section 3: Simulation of `.checkPtrPairAlign`.
4. Section 4: Simulation of `.ptrOffsetInbounds` (constant & runtime counts).
5. Section 5: Top-level `s3_term_step_sim`, `s3_scalarize_step_sim`, and
   `applyPtrScalarize_sound`.
-/



/-! ## Section 1: Structural, Primitive & Arithmetic Helpers -/

private theorem s3d_blockTerm_check (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbSrc : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bbSrc) :
    checkTermForPtrs ctx.bodySrc.locals ctx.plan.entries bbSrc.terminator = true := by
  have hBlk := s3_list_all_getElem? _ ctx.bodySrc.basicBlocks bbIdx bbSrc ctx.hBlocksCheck hBb
  exact ((bool_and_eq_true _ _).mp hBlk).2

private theorem s3d_blockTerm_targetsInBounds (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbSrc : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bbSrc) :
    memCopyTermTargetsInBounds ctx.bodySrc.basicBlocks.length bbSrc.terminator = true := by
  have hT := ctx.hTargetsIb
  unfold memCopyBodyTargetsInBounds at hT
  exact s3_list_all_getElem? _ ctx.bodySrc.basicBlocks bbIdx bbSrc hT hBb

private theorem s3d_getElem?_some_of_lt {α : Type} :
    ∀ {xs : List α} {i : Nat}, i < xs.length →
      ∃ x : α, Trusted.MirSemantics.getElem? xs i = some x
  | [], _, h => False.elim (Nat.not_lt_zero _ h)
  | x :: _, 0, _ => ⟨x, rfl⟩
  | _ :: xs, i + 1, h =>
    s3d_getElem?_some_of_lt (xs := xs) (i := i)
      (Nat.lt_of_succ_lt_succ (n := i) (m := xs.length) h)

private theorem s3d_reachesN_to_reaches {p : MemCopyProgram} {n : Nat} {s₁ s₂ : MemCopyState}
    (h : ReachesNMemCopy p n s₁ s₂) : ReachesMemCopy p s₁ s₂ :=
  reachesMemCopy_of_reachesNMemCopy h

private theorem s3d_evalStep_none_stmt {p : MemCopyProgram} {body : MemCopyBody}
    {bb : MemCopyBlock} {f : MemCopyFrame} {mem : CallerMemory}
    (hBody : Trusted.MirSemantics.getElem? p.bodies f.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx = some bb)
    (hNone : Trusted.MirSemantics.getElem? bb.statements f.stmtIdx = none)
    (hNe : Nat.beq f.stmtIdx bb.statements.length = false) :
    evalStepMemCopy p 0 { frames := [f], mem := mem } = .fault .unsupported := by
  unfold evalStepMemCopy; dsimp
  rw [hBody]; dsimp
  rw [hBb]; dsimp
  rw [hNone]; dsimp
  rw [hNe]
  rfl

private theorem s3d_list_any_append {α : Type} (p : α → Bool) :
    ∀ (xs ys : List α), (xs ++ ys).any p = (xs.any p || ys.any p)
  | [], ys => by simp
  | x :: xs, ys => by
    change (p x || (xs ++ ys).any p) = (p x || xs.any p || ys.any p)
    rw [s3d_list_any_append p xs ys, Bool.or_assoc]

private def s3d_isByteBufDecl : MemCopyLocalDecl → Bool
  | .byteBuf _ _ _ => true
  | _ => false

private theorem s3d_tombstone_any_byteBuf :
    ∀ (ds : List MemCopyLocalDecl),
      (tombstonePtrDecls ds).any s3d_isByteBufDecl = ds.any s3d_isByteBufDecl
  | [] => rfl
  | d :: ds => by
    cases d with
    | base _ =>
      change (false || (tombstonePtrDecls ds).any s3d_isByteBufDecl) = (false || ds.any s3d_isByteBufDecl)
      rw [s3d_tombstone_any_byteBuf ds]
    | ptrLocal =>
      change (false || (tombstonePtrDecls ds).any s3d_isByteBufDecl) = (false || ds.any s3d_isByteBufDecl)
      rw [s3d_tombstone_any_byteBuf ds]
    | byteBuf _ _ _ =>
      change (true || (tombstonePtrDecls ds).any s3d_isByteBufDecl) = (true || ds.any s3d_isByteBufDecl)
      rfl

private theorem s3d_ptrCompDecls_any_byteBuf :
    ∀ (k : Nat), (ptrCompDecls k).any s3d_isByteBufDecl = false
  | 0 => rfl
  | k + 1 => by
    change (false || (false || (false || (ptrCompDecls k).any s3d_isByteBufDecl))) = false
    rw [s3d_ptrCompDecls_any_byteBuf k]
    rfl

private theorem s3d_ptrScratchDecls_any_byteBuf :
    ptrScratchDecls.any s3d_isByteBufDecl = false := by
  decide

private theorem s3d_hasInternalBufs_any_eq (ctx : s3_PtrCtx) (p : MemCopyLocalDecl → Bool)
    (hBuf : ∀ sz al mutab, p (.byteBuf sz al mutab) = true)
    (hBase : ∀ ty, p (.base ty) = false)
    (hPtr : p .ptrLocal = false) :
    ctx.bodyTgt.locals.any p = ctx.bodySrc.locals.any p := by
  have hTomb : ∀ ds : List MemCopyLocalDecl, (tombstonePtrDecls ds).any p = ds.any p := by
    intro ds
    induction ds with
    | nil => rfl
    | cons d ds ih =>
      cases d with
      | base ty =>
        change (p (.base ty) || (tombstonePtrDecls ds).any p) = (p (.base ty) || ds.any p)
        rw [ih]
      | ptrLocal =>
        change (p (.base .unit) || (tombstonePtrDecls ds).any p) = (p .ptrLocal || ds.any p)
        rw [hBase .unit, hPtr, ih]
      | byteBuf sz al mutab =>
        change (p (.byteBuf sz al mutab) || (tombstonePtrDecls ds).any p) = (p (.byteBuf sz al mutab) || ds.any p)
        rw [hBuf sz al mutab]; rfl
  have hComp : ∀ k : Nat, (ptrCompDecls k).any p = false := by
    intro k
    induction k with
    | zero => rfl
    | succ k ih =>
      change (p (.base .unit) || (p (.base usizeTy) || (p (.base usizeTy) || (ptrCompDecls k).any p))) = false
      rw [hBase .unit, hBase usizeTy, ih]; rfl
  have hScr : ptrScratchDecls.any p = false := by
    change (p (.base usizeTy) || (p (.base usizeTy) || (p (.base usizeTy) || (p (.base usizeTy) ||
      (p (.base usizeTy) || (p (.base usizeTy) || (p (.base usizeTy) || (p (.base usizeTy) ||
      (p (.base usizeTy) || (p (.base usizeTy) || (p (.base .bool) || (p (.base .bool) || false)))))))))))) = false
    rw [hBase usizeTy, hBase .bool]; rfl
  rw [ctx.hBodyTgtEq]; dsimp
  rw [s3d_list_any_append, s3d_list_any_append, hTomb, hComp, hScr, Bool.or_false, Bool.or_false]

private theorem s3d_mirTy_beq_usize_eq (ty : MirTy) : MirTy.beq ty usizeTy = true → ty = usizeTy := by
  cases ty with
  | int w s =>
    change (IntWidth.beq w .isize && (s == false)) = true → _
    cases w <;> cases s <;> intro h <;> first | rfl | cases h
  | bool | unit | never | enum _ | tuple _ | ref _ _ | rawPtr _ _ | unsupported =>
    intro h; cases h

private theorem s3d_findAlloc?_allocId (aid : AllocId) (a : Allocation) :
    ∀ allocs : List Allocation, findAlloc? aid allocs = some a → a.allocId = aid
  | [], h => by cases h
  | x :: xs, h => by
    unfold findAlloc? at h
    cases hEq : Nat.beq x.allocId aid with
    | true => rw [hEq] at h; cases h; exact nat_beq_eq _ _ hEq
    | false => rw [hEq] at h; exact s3d_findAlloc?_allocId aid a xs h

private theorem s3d_hasInternalBufs_eq (ctx : s3_PtrCtx) :
    ctx.bodyTgt.locals.any (fun d => match d with | .byteBuf _ _ _ => true | _ => false) =
      ctx.bodySrc.locals.any (fun d => match d with | .byteBuf _ _ _ => true | _ => false) :=
  s3d_hasInternalBufs_any_eq ctx _ (fun _ _ _ => rfl) (fun _ => rfl) rfl

private theorem s3d_checkPtrBackingEntriesLoop_nonBuf_nonPtr_at_start :
    ∀ (allDecls : List MemCopyLocalDecl) (argCount idx : Nat)
      (tailDecls : List MemCopyLocalDecl) (entries : List PtrBackingEntry),
      checkPtrBackingEntriesLoop allDecls argCount idx tailDecls entries = true →
      idx ≤ argCount →
      ∀ (d0 : MemCopyLocalDecl) (rest : List MemCopyLocalDecl),
        tailDecls = d0 :: rest →
        ∃ ty, d0 = .base ty
  | _, _, _, [], _, _, _, _, _, h => by cases h
  | allDecls, argCount, idx, .base ty :: _, _, _, _, d0, _, hEq => by
    cases hEq; exact ⟨ty, rfl⟩
  | allDecls, argCount, idx, .ptrLocal :: restDecls, [], hChk, _, _, _, _ => by
    cases hChk
  | allDecls, argCount, idx, .ptrLocal :: _, _ :: _, hChk, hLe, _, _, _ => by
    change ((_ && Nat.blt argCount idx && _) && _) = true at hChk
    have h1 := ((bool_and_eq_true _ _).mp hChk).1
    have h2 := ((bool_and_eq_true _ _).mp h1).1
    have hBlt := ((bool_and_eq_true _ _).mp h2).2
    have hLt := (nat_blt_eq_lt _ _).mp hBlt
    exact False.elim (Nat.not_lt_of_le hLe hLt)
  | allDecls, argCount, idx, .byteBuf _ _ _ :: _, _, hChk, hLe, _, _, _ => by
    change (((Nat.blt argCount idx && _) && _) && _) = true at hChk
    have h1 := ((bool_and_eq_true _ _).mp hChk).1
    have h2 := ((bool_and_eq_true _ _).mp h1).1
    have hBlt := ((bool_and_eq_true _ _).mp h2).1
    have hLt := (nat_blt_eq_lt _ _).mp hBlt
    exact False.elim (Nat.not_lt_of_le hLe hLt)

private theorem s3d_bodySrc_local0_base (ctx : s3_PtrCtx) :
    ∃ retTy : MirTy, Trusted.MirSemantics.getElem? ctx.bodySrc.locals 0 = some (.base retTy) := by
  have hPos : 0 < ctx.bodySrc.locals.length := Nat.lt_of_le_of_lt (Nat.zero_le _) ctx.hArgLt
  cases h0 : ctx.bodySrc.locals with
  | nil => rw [h0] at hPos; exact False.elim (Nat.not_lt_zero _ hPos)
  | cons d0 rest =>
    cases s3d_checkPtrBackingEntriesLoop_nonBuf_nonPtr_at_start
        ctx.bodySrc.locals ctx.bodySrc.argumentCount 0 ctx.bodySrc.locals ctx.plan.entries
        ctx.hEntries (Nat.zero_le _) d0 rest h0 with
    | intro ty hTy =>
      refine ⟨ty, ?_⟩
      rw [hTy]
      rfl

private theorem s3d_evalSwitchBranches_in_bounds (w : IntWidth) (bits : BitVec 128)
    (otherwise : BasicBlockId) :
    ∀ (branches : List (BitVec 128 × BasicBlockId)) (n : Nat) (tgt : BasicBlockId),
      evalSwitchBranches w bits otherwise branches = .ok tgt →
      (Nat.blt otherwise n = true ∧ branches.all (fun br => Nat.blt br.2 n) = true) →
      tgt < n
  | [], n, tgt, hEv, hIn => by
    change Except.ok otherwise = Except.ok tgt at hEv
    cases hEv
    exact (nat_blt_eq_lt _ _).mp hIn.1
  | br :: tl, n, tgt, hEv, hIn => by
    change (if truncateBits w br.1 != br.1 then Except.error FaultKind.unsupported
      else if truncateBits w bits == truncateBits w br.1 then Except.ok br.2
      else evalSwitchBranches w bits otherwise tl) = Except.ok tgt at hEv
    have hAll : (Nat.blt br.2 n && tl.all (fun br => Nat.blt br.2 n)) = true := hIn.2
    have hPair := (bool_and_eq_true _ _).mp hAll
    cases hBad : (truncateBits w br.1 != br.1) with
    | true => rw [hBad] at hEv; cases hEv
    | false =>
      rw [hBad] at hEv; dsimp at hEv
      cases hEq : (truncateBits w bits == truncateBits w br.1) with
      | true =>
        rw [hEq] at hEv; cases hEv
        exact (nat_blt_eq_lt _ _).mp hPair.1
      | false =>
        rw [hEq] at hEv; dsimp at hEv
        exact s3d_evalSwitchBranches_in_bounds w bits otherwise tl n tgt hEv ⟨hIn.1, hPair.2⟩

private theorem s3d_evalBoolSwitchBranches_in_bounds (b : Bool)
    (otherwise : BasicBlockId) :
    ∀ (branches : List (BitVec 128 × BasicBlockId)) (n : Nat) (tgt : BasicBlockId),
      evalBoolSwitchBranches b otherwise branches = .ok tgt →
      (Nat.blt otherwise n = true ∧ branches.all (fun br => Nat.blt br.2 n) = true) →
      tgt < n
  | [], n, tgt, hEv, hIn => by
    change Except.ok otherwise = Except.ok tgt at hEv
    cases hEv
    exact (nat_blt_eq_lt _ _).mp hIn.1
  | br :: tl, n, tgt, hEv, hIn => by
    change (match evalConstLit MirTy.bool (ConstLit.scalar br.1) with
      | Except.ok (Val.bool false) =>
        if (!b) = true then Except.ok br.2 else evalBoolSwitchBranches b otherwise tl
      | Except.ok (Val.bool true) =>
        if b = true then Except.ok br.2 else evalBoolSwitchBranches b otherwise tl
      | Except.error k => Except.error k
      | Except.ok _ => Except.error FaultKind.unsupported) = Except.ok tgt at hEv
    have hAll : (Nat.blt br.2 n && tl.all (fun br => Nat.blt br.2 n)) = true := hIn.2
    have hPair := (bool_and_eq_true _ _).mp hAll
    cases hEc : evalConstLit MirTy.bool (ConstLit.scalar br.1) with
    | error _ => rw [hEc] at hEv; cases hEv
    | ok v =>
      rw [hEc] at hEv
      cases v with
      | bool bv =>
        cases bv with
        | false =>
          dsimp at hEv
          cases hNb : !b with
          | true => rw [hNb] at hEv; cases hEv; exact (nat_blt_eq_lt _ _).mp hPair.1
          | false =>
            rw [hNb] at hEv; dsimp at hEv
            exact s3d_evalBoolSwitchBranches_in_bounds b otherwise tl n tgt hEv ⟨hIn.1, hPair.2⟩
        | true =>
          dsimp at hEv
          cases hB : b with
          | true => rw [hB] at hEv; cases hEv; exact (nat_blt_eq_lt _ _).mp hPair.1
          | false =>
            rw [hB] at hEv; dsimp at hEv
            exact s3d_evalBoolSwitchBranches_in_bounds false otherwise tl n tgt hEv ⟨hIn.1, hPair.2⟩
      | scalar _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => cases hEv

private theorem s3d_fwdStepSim_of_term_multi (ctx : s3_PtrCtx) {bbSrc : MemCopyBlock}
    {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    (hDef₁ : f₁.defId = ctx.plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hStepProp : ∀ s₁', evalMemCopyTerm ctx.bodySrc bbSrc f₁ m₁ = .step s₁' →
      ∃ s₂', ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := m₂ } s₂' ∧
        s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂')
    (hDoneProp : ∀ out, evalMemCopyTerm ctx.bodySrc bbSrc f₁ m₁ = .done out →
      ∃ s₂', ReachesMemCopy ctx.pTgt { frames := [f₂], mem := m₂ } s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.done out))
    (hFaultProp : ∀ k, evalMemCopyTerm ctx.bodySrc bbSrc f₁ m₁ = .fault k →
      ∃ s₂', ReachesMemCopy ctx.pTgt { frames := [f₂], mem := m₂ } s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.fault k)) :
    s3_FwdStepSim ctx f₁ m₁ f₂ m₂ := by
  have hBodySrc : Trusted.MirSemantics.getElem? ctx.pSrc.bodies f₁.defId = some ctx.bodySrc := by
    rw [hDef₁]; exact ctx.hBodies
  have hEvSrc := s3_step_state_of_term ctx.pSrc f₁ m₁ ctx.bodySrc bbSrc hBodySrc hBbSrc hEnd₁
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hEv; rw [hEvSrc] at hEv; exact hStepProp s₁' hEv
  · intro out hEv; rw [hEvSrc] at hEv; exact hDoneProp out hEv
  · intro k hEv; rw [hEvSrc] at hEv; exact hFaultProp k hEv

private theorem s3d_nat_le_div_iff_mul_le (a b k : Nat) (hb : 0 < b) :
    a ≤ Nat.div k b ↔ a * b ≤ k := by
  constructor
  · intro hLe
    have h1 := Nat.mul_le_mul_right b hLe
    exact Nat.le_trans h1 (Nat.div_mul_le_self k b)
  · intro hMul
    exact (Nat.le_div_iff_mul_le hb).mpr hMul

private theorem s3d_div_lt_maxUsize_of_le (k b : Nat) (hk : k ≤ maxIsize) :
    Nat.div k b < maxUsize := by
  have h1 : Nat.div k b ≤ k := Nat.div_le_self k b
  have h2 : maxIsize < maxUsize := by decide
  exact Nat.lt_of_le_of_lt (Nat.le_trans h1 hk) h2

private theorem s3d_isize_toNat_pos_le {z : Int} (hNonNeg : 0 < z)
    (hNoHi : ¬(Int.ofNat maxIsize < z)) :
    z.toNat ≤ maxIsize ∧ 0 < z.toNat ∧ Int.ofNat z.toNat = z := by
  have hLe : z ≤ Int.ofNat maxIsize := s0_int_le_of_not_gt hNoHi
  have hPos : 0 ≤ z := s0_int_le_of_lt hNonNeg
  have hEq : Int.ofNat z.toNat = z := s0_int_toNat_of_nonneg hPos
  have hNatLe : z.toNat ≤ maxIsize := by
    have hI : Int.ofNat z.toNat ≤ Int.ofNat maxIsize := by rw [hEq]; exact hLe
    exact s0_int_ofNat_le_mp hI
  have hNatPos : 0 < z.toNat := by
    have hI : Int.ofNat 0 < Int.ofNat z.toNat := by rw [hEq]; exact hNonNeg
    exact s0_int_ofNat_lt_mp hI
  exact ⟨hNatLe, hNatPos, hEq⟩

private theorem s3d_isize_neg_toNat_lt {z : Int} (hNeg : z < 0)
    (hNoLo : ¬(z < minIsize)) :
    (Neg.neg z).toNat < maxUsize ∧ 0 < (Neg.neg z).toNat ∧
      Int.ofNat (Neg.neg z).toNat = Neg.neg z := by
  have hGe : minIsize ≤ z := s0_int_le_of_not_gt hNoLo
  have hPos : 0 < Neg.neg z := s0_int_neg_pos_of_neg hNeg
  have hNonNeg : 0 ≤ Neg.neg z := s0_int_le_of_lt hPos
  have hEq : Int.ofNat (Neg.neg z).toNat = Neg.neg z := s0_int_toNat_of_nonneg hNonNeg
  have hNegLe : Neg.neg z ≤ Neg.neg minIsize := s0_int_neg_le_neg hGe
  have hMinVal : Neg.neg minIsize = Int.ofNat (Nat.pow 2 63) := by decide
  have hNatLe : (Neg.neg z).toNat ≤ Nat.pow 2 63 := by
    have hI : Int.ofNat (Neg.neg z).toNat ≤ Int.ofNat (Nat.pow 2 63) := by rw [hEq, ← hMinVal]; exact hNegLe
    exact s0_int_ofNat_le_mp hI
  have hPowLt : Nat.pow 2 63 < maxUsize := by decide
  have hNatLt : (Neg.neg z).toNat < maxUsize := Nat.lt_of_le_of_lt hNatLe hPowLt
  have hNatPos : 0 < (Neg.neg z).toNat := by
    have hI : Int.ofNat 0 < Int.ofNat (Neg.neg z).toNat := by rw [hEq]; exact hPos
    exact s0_int_ofNat_lt_mp hI
  exact ⟨hNatLt, hNatPos, hEq⟩

private theorem s3d_maxIsize_plus_32_lt_maxUsize : maxIsize + 32 < maxUsize := by
  decide

private theorem s3d_pv_width_isize_eq (pv : PtrVal) (hW : pv.width = .isize) :
    { pv with width := .isize } = pv := by
  cases pv; dsimp at hW; rw [hW]

private theorem s3d_ptrTagMatches_width_isize (optBuf : Option LocalId) (pv : PtrVal) (tagVal : Nat)
    (h : s3_PtrTagMatches optBuf pv tagVal) :
    s3_PtrTagMatches optBuf { pv with width := .isize } tagVal := by
  exact h

private theorem s3d_list_take_ge_zero {α : Type} (xs : List α) (i : Nat) (h : i = xs.length) :
    Trusted.MirSemantics.getElem? xs i = none :=
  s3_getElem?_ge_none xs i (by rw [h]; exact Nat.le_refl _)

/-! ## Section 2: `.baseTerm`, `.readBufRawByte`, & `.writeBufRawByte` Simulation -/

private theorem s3d_baseTerm_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} (bt : TerminatorKind)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator = .baseTerm bt)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3d_blockTerm_check ctx hBbSrc
  have hTib := s3d_blockTerm_targetsInBounds ctx hBbSrc
  rw [hTerm] at hChk hTib
  cases s3_lowerBlock_getElem?_termPre ctx hBbSrc with | intro extraBase hEx =>
  cases hEx with | intro extraSelf hBlock =>
  let bbTgt : MemCopyBlock := {
    bbSrc with
    statements := listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) bbSrc.statements ++
      (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).1
    terminator := (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).2.1
  }
  have hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₁.blockIdx = some bbTgt := hBlock.2.2.1
  have hEnd₂ : f₂.stmtIdx = bbTgt.statements.length := by
    have hPre0 : (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).1.length = 0 := by
      rw [hTerm]; rfl
    have hOff := hBlock.2.2.2.1
    rw [hPre0, Nat.add_zero] at hOff
    rw [hIdxEq, hEnd₁, hOff]
  have hTermTgt : bbTgt.terminator = .baseTerm bt := by
    dsimp [bbTgt]; rw [hTerm]; rfl
  have hClnTgt : bbTgt.cleanup = bbSrc.cleanup := rfl
  have hf₂Eq : f₂ = {
      defId := ctx.plan.defId
      blockIdx := f₁.blockIdx
      stmtIdx := bbTgt.statements.length
      locals := f₂.locals } := by
    cases f₂; dsimp at hDef₂ hBbRel hEnd₂; subst hDef₂; subst hBbRel; subst hEnd₂; rfl
  have hBbTgt₂ : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₁.blockIdx = some bbTgt := hBbTgt
  apply s3d_fwdStepSim_of_term_multi ctx hDef₁ hBbSrc hEnd₁
  · intro s₁' hStep
    cases bt with
    | goto target =>
      unfold evalMemCopyTerm at hStep; dsimp at hStep; rw [hTerm] at hStep; dsimp at hStep
      unfold jumpMemCopyBlock at hStep; cases hStep
      unfold memCopyTermTargetsInBounds at hTib
      have hTgtLt : target < ctx.bodySrc.basicBlocks.length := (nat_blt_eq_lt _ _).mp hTib
      cases s3d_getElem?_some_of_lt hTgtLt with | intro bbTgtJump hBbJump =>
      have hExecJump : ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem }
          { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := f₂.locals }], mem := mem } := by
        rw [hf₂Eq]
        refine s3_exec_term_jump ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals f₂.locals mem mem target
          (s3_bodyTgt_get ctx) hBbTgt₂ ?_
        unfold evalMemCopyTerm; dsimp; rw [hTermTgt]
      cases hExecJump with | intro n hReach =>
      exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbJump hReach rfl hWf hRel
    | switchInt discr targets =>
      unfold evalMemCopyTerm at hStep; dsimp at hStep; rw [hTerm] at hStep; dsimp at hStep
      unfold checkTermForPtrs at hChk; dsimp at hChk
      have hOpSim := s3_evalPrimOp_sim ctx f₁.locals f₂.locals mem discr hWf hRel hChk
      cases hEv1 : evalMemCopyPrimitiveOperand ctx.bodySrc.locals f₁.locals discr with
      | error _ => rw [hEv1] at hStep; cases hStep
      | ok p1 =>
        rw [hEv1] at hStep hOpSim; dsimp at hStep
        cases hEv2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals f₂.locals discr with
        | error _ => rw [hEv2] at hOpSim; exact False.elim hOpSim
        | ok p2 =>
          rw [hEv2] at hOpSim
          cases p1 with | mk dv1 slots₁' =>
          cases p2 with | mk dv2 slots₂' =>
          dsimp at hOpSim hStep
          cases dv1 with
          | unit | ptr _ | enumVal _ _ | tuple _ | bytes _ =>
            dsimp at hStep; cases hStep
          | bool b =>
            dsimp at hStep
            cases hR : evalBoolSwitchBranches b targets.otherwise targets.branches with
            | error _ => rw [hR] at hStep; cases hStep
            | ok target =>
              rw [hR] at hStep; dsimp at hStep
              unfold jumpMemCopyBlock at hStep; cases hStep
              unfold memCopyTermTargetsInBounds at hTib
              have hTgtLt := s3d_evalBoolSwitchBranches_in_bounds b targets.otherwise targets.branches _ target hR ((bool_and_eq_true _ _).mp hTib)
              cases s3d_getElem?_some_of_lt hTgtLt with | intro bbTgtJump hBbJump =>
              have hExecJump : ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem }
                  { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], mem := mem } := by
                rw [hf₂Eq]
                refine s3_exec_term_jump ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals slots₂' mem mem target
                  (s3_bodyTgt_get ctx) hBbTgt₂ ?_
                unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
                rw [hEv2]; dsimp; rw [← hOpSim.1]; dsimp; rw [hR]
              cases hExecJump with | intro n hReach =>
              exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbJump hReach rfl hOpSim.2.1 hOpSim.2.2
          | scalar sv =>
            dsimp at hStep
            cases hR : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
            | error _ => rw [hR] at hStep; cases hStep
            | ok target =>
              rw [hR] at hStep; dsimp at hStep
              unfold jumpMemCopyBlock at hStep; cases hStep
              unfold memCopyTermTargetsInBounds at hTib
              have hTgtLt := s3d_evalSwitchBranches_in_bounds sv.width sv.bits targets.otherwise targets.branches _ target hR ((bool_and_eq_true _ _).mp hTib)
              cases s3d_getElem?_some_of_lt hTgtLt with | intro bbTgtJump hBbJump =>
              have hExecJump : ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem }
                  { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], mem := mem } := by
                rw [hf₂Eq]
                refine s3_exec_term_jump ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals slots₂' mem mem target
                  (s3_bodyTgt_get ctx) hBbTgt₂ ?_
                unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
                rw [hEv2]; dsimp; rw [← hOpSim.1]; dsimp; rw [hR]
              cases hExecJump with | intro n hReach =>
              exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbJump hReach rfl hOpSim.2.1 hOpSim.2.2
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      unfold evalMemCopyTerm at hStep; dsimp at hStep; rw [hTerm] at hStep; dsimp at hStep; cases hStep
    | return_ =>
      unfold evalMemCopyTerm at hStep; dsimp at hStep; rw [hTerm] at hStep; dsimp at hStep
      cases hCl : bbSrc.cleanup with
      | true => rw [hCl] at hStep; dsimp at hStep; cases hStep
      | false =>
        rw [hCl] at hStep; dsimp at hStep
        cases s3d_bodySrc_local0_base ctx with | intro retTy hDecl0 =>
        rw [hDecl0] at hStep
        cases hL0 : Trusted.MirSemantics.getElem? f₁.locals 0 with
        | none => rw [hL0] at hStep; cases hStep
        | some sl =>
          rw [hL0] at hStep
          cases sl with
          | bufSlot _ | ptrDead | livePtr _ => cases hStep
          | baseSlot lsl => cases lsl with
            | dead => cases hStep
            | live ov => cases ov <;> cases hStep
  · intro out hDone
    cases bt with
    | goto _ | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      unfold evalMemCopyTerm at hDone; dsimp at hDone; rw [hTerm] at hDone; dsimp at hDone; cases hDone
    | switchInt discr targets =>
      unfold evalMemCopyTerm at hDone; dsimp at hDone; rw [hTerm] at hDone; dsimp at hDone
      cases hEv : evalMemCopyPrimitiveOperand ctx.bodySrc.locals f₁.locals discr with
      | error _ => rw [hEv] at hDone; cases hDone
      | ok p1 =>
        rw [hEv] at hDone; dsimp at hDone
        cases hV1 : p1.1 with
        | bool b =>
          rw [hV1] at hDone; dsimp at hDone
          cases hR : evalBoolSwitchBranches b targets.otherwise targets.branches with
          | error _ => rw [hR] at hDone; cases hDone
          | ok _ => rw [hR] at hDone; unfold jumpMemCopyBlock at hDone; cases hDone
        | scalar sv =>
          rw [hV1] at hDone; dsimp at hDone
          cases hR : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
          | error _ => rw [hR] at hDone; cases hDone
          | ok _ => rw [hR] at hDone; unfold jumpMemCopyBlock at hDone; cases hDone
        | unit | ptr _ | enumVal _ _ | tuple _ | bytes _ =>
          rw [hV1] at hDone; cases hDone
    | return_ =>
      unfold evalMemCopyTerm at hDone; dsimp at hDone; rw [hTerm] at hDone; dsimp at hDone
      cases hCln : bbSrc.cleanup with
      | true => rw [hCln] at hDone; cases hDone
      | false =>
        rw [hCln] at hDone; dsimp at hDone
        cases s3d_bodySrc_local0_base ctx with | intro retTy hDecl0 =>
        have hDeclTgt0 := s3_bodyTgt_locals_base ctx 0 (s3_getElem?_some_lt _ _ _ hDecl0)
        rw [hDecl0] at hDone hDeclTgt0
        have hNoCallerTgt : ctx.bodyTgt.acceptsCallerMem = false := by
          rw [ctx.hBodyTgtEq]; exact ctx.hNoCaller
        refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
        rw [hf₂Eq]
        refine s3_exec_term_done ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals mem out
          (s3_bodyTgt_get ctx) hBbTgt₂ ?_
        unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
        rw [hClnTgt, hCln]; dsimp
        rw [hDeclTgt0, hRel.2.2.1 0 retTy hDecl0]
        cases hSl0 : Trusted.MirSemantics.getElem? f₁.locals 0 with
        | none => rw [hSl0] at hDone; cases hDone
        | some sl0 =>
          rw [hSl0] at hDone
          cases sl0 with
          | bufSlot _ | ptrDead | livePtr _ => cases hDone
          | baseSlot lsl =>
            cases lsl with
            | dead => cases hDone
            | live ov =>
              cases ov with
              | none => cases hDone
              | some retVal =>
                dsimp at hDone; dsimp
                rw [ctx.hNoCaller] at hDone
                rw [hNoCallerTgt, s3d_hasInternalBufs_any_eq ctx _ (fun _ _ _ => rfl) (fun _ => rfl) rfl]
                exact hDone
  · intro k hFault
    cases bt with
    | goto _ =>
      unfold evalMemCopyTerm at hFault; dsimp at hFault; rw [hTerm] at hFault; cases hFault
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
      rw [hf₂Eq]
      refine s3_exec_term_fault ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals mem k
        (s3_bodyTgt_get ctx) hBbTgt₂ ?_
      unfold evalMemCopyTerm at hFault; dsimp at hFault
      unfold evalMemCopyTerm; dsimp
      rw [hTerm] at hFault; dsimp at hFault
      rw [hTermTgt]; dsimp
      exact hFault
    | return_ =>
      unfold evalMemCopyTerm at hFault; dsimp at hFault; rw [hTerm] at hFault; dsimp at hFault
      cases hCln : bbSrc.cleanup with
      | true =>
        rw [hCln] at hFault; dsimp at hFault; cases hFault
        refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
        rw [hf₂Eq]
        refine s3_exec_term_fault ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals mem .unsupported
          (s3_bodyTgt_get ctx) hBbTgt₂ ?_
        unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp; rw [hClnTgt, hCln]; rfl
      | false =>
        rw [hCln] at hFault; dsimp at hFault
        cases s3d_bodySrc_local0_base ctx with | intro retTy hDecl0 =>
        have hDeclTgt0 := s3_bodyTgt_locals_base ctx 0 (s3_getElem?_some_lt _ _ _ hDecl0)
        rw [hDecl0] at hFault hDeclTgt0
        refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
        rw [hf₂Eq]
        refine s3_exec_term_fault ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals mem k
          (s3_bodyTgt_get ctx) hBbTgt₂ ?_
        unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
        rw [hClnTgt, hCln]; dsimp
        rw [hDeclTgt0, hRel.2.2.1 0 retTy hDecl0]
        cases hSl0 : Trusted.MirSemantics.getElem? f₁.locals 0 with
        | none => rw [hSl0] at hFault; exact hFault
        | some sl0 =>
          rw [hSl0] at hFault
          cases sl0 with
          | bufSlot _ | ptrDead | livePtr _ => exact hFault
          | baseSlot lsl =>
            cases lsl with
            | dead => exact hFault
            | live ov =>
              cases ov with
              | none => exact hFault
              | some retVal => cases hFault
    | switchInt discr targets =>
      unfold evalMemCopyTerm at hFault; dsimp at hFault; rw [hTerm] at hFault; dsimp at hFault
      unfold checkTermForPtrs at hChk; dsimp at hChk
      have hOpSim := s3_evalPrimOp_sim ctx f₁.locals f₂.locals mem discr hWf hRel hChk
      refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
      rw [hf₂Eq]
      refine s3_exec_term_fault ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals mem k
        (s3_bodyTgt_get ctx) hBbTgt₂ ?_
      unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
      cases hEv1 : evalMemCopyPrimitiveOperand ctx.bodySrc.locals f₁.locals discr with
      | error k1 =>
        rw [hEv1] at hFault hOpSim; cases hFault
        cases hEv2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals f₂.locals discr with
        | ok _ => rw [hEv2] at hOpSim; exact False.elim hOpSim
        | error k2 => rw [hEv2] at hOpSim; rw [hOpSim]
      | ok p1 =>
        rw [hEv1] at hFault hOpSim; dsimp at hFault
        cases hEv2 : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals f₂.locals discr with
        | error _ => rw [hEv2] at hOpSim; exact False.elim hOpSim
        | ok p2 =>
          rw [hEv2] at hOpSim; dsimp
          cases p1 with | mk dv1 slots₁' =>
          cases p2 with | mk dv2 slots₂' =>
          dsimp at hOpSim
          rw [← hOpSim.1]
          cases dv1 with
          | bool b =>
            dsimp at hFault; dsimp
            cases hR : evalBoolSwitchBranches b targets.otherwise targets.branches with
            | ok _ => rw [hR] at hFault; cases hFault
            | error ke => rw [hR] at hFault; exact hFault
          | scalar sv =>
            dsimp at hFault; dsimp
            cases hR : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
            | ok _ => rw [hR] at hFault; cases hFault
            | error ke => rw [hR] at hFault; exact hFault
          | unit | ptr _ | enumVal _ _ | tuple _ | bytes _ =>
            dsimp at hFault; dsimp; exact hFault

private theorem s3d_readBufRawByte_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (tagDst valDst bufLocal : LocalId) (offOp : Operand) (nextBb : BasicBlockId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator = .readBufRawByte tagDst valDst bufLocal offOp nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3d_blockTerm_check ctx hBbSrc
  have hTib := s3d_blockTerm_targetsInBounds ctx hBbSrc
  rw [hTerm] at hChk hTib
  unfold checkTermForPtrs at hChk; dsimp at hChk
  have hAnd1 := (bool_and_eq_true _ _).mp hChk
  have hAnd2 := (bool_and_eq_true _ _).mp hAnd1.1
  have hOffBase : operandUsesOnlyBaseMem ctx.bodySrc.locals offOp = true :=
    s3_operandHasBaseTy_usesOnlyBase ctx.bodySrc.locals usizeTy offOp hAnd2.2
  have hDecls := hAnd1.2
  cases hTD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals tagDst with
  | none => rw [hTD] at hDecls; cases hDecls
  | some dt =>
    rw [hTD] at hDecls
    cases dt with
    | byteBuf _ _ _ | ptrLocal => cases hDecls
    | base t1 =>
      cases hVD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals valDst with
      | none => rw [hVD] at hDecls; cases hDecls
      | some dv =>
        rw [hVD] at hDecls
        cases dv with
        | byteBuf _ _ _ | ptrLocal => cases hDecls
        | base t2 =>
          cases hBD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLocal with
          | none => rw [hBD] at hDecls; cases hDecls
          | some db =>
            rw [hBD] at hDecls
            cases db with
            | base _ | ptrLocal => cases hDecls
            | byteBuf sz al mutab =>
              dsimp at hDecls
              have hTDTgt := s3_bodyTgt_locals_base ctx tagDst (s3_getElem?_some_lt _ _ _ hTD)
              have hVDTgt := s3_bodyTgt_locals_base ctx valDst (s3_getElem?_some_lt _ _ _ hVD)
              have hBDTgt := s3_bodyTgt_locals_base ctx bufLocal (s3_getElem?_some_lt _ _ _ hBD)
              rw [hTD] at hTDTgt; rw [hVD] at hVDTgt; rw [hBD] at hBDTgt
              cases s3_lowerBlock_getElem?_termPre ctx hBbSrc with | intro extraBase hEx =>
              cases hEx with | intro extraSelf hBlock =>
              let bbTgt : MemCopyBlock := {
                bbSrc with
                statements := listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) bbSrc.statements ++
                  (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).1
                terminator := (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).2.1
              }
              have hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₁.blockIdx = some bbTgt := hBlock.2.2.1
              have hEnd₂ : f₂.stmtIdx = bbTgt.statements.length := by
                have hPre0 : (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).1.length = 0 := by
                  rw [hTerm]; rfl
                have hOff := hBlock.2.2.2.1
                rw [hPre0, Nat.add_zero] at hOff
                rw [hIdxEq, hEnd₁, hOff]
              have hTermTgt : bbTgt.terminator = .readBufRawByte tagDst valDst bufLocal offOp nextBb := by
                dsimp [bbTgt]; rw [hTerm]; rfl
              have hf₂Eq : f₂ = {
                  defId := ctx.plan.defId
                  blockIdx := f₁.blockIdx
                  stmtIdx := bbTgt.statements.length
                  locals := f₂.locals } := by
                cases f₂; dsimp at hDef₂ hBbRel hEnd₂; subst hDef₂; subst hBbRel; subst hEnd₂; rfl
              have hTgtLt : nextBb < ctx.bodySrc.basicBlocks.length := by
                unfold memCopyTermTargetsInBounds at hTib
                exact (nat_blt_eq_lt _ _).mp hTib
              have hEvSim := s3_evalUsizeOp_sim ctx f₁.locals f₂.locals mem offOp hWf hRel hOffBase
              apply s3d_fwdStepSim_of_term_multi ctx hDef₁ hBbSrc hEnd₁
              · intro s₁' hStep
                unfold evalMemCopyTerm at hStep; dsimp at hStep; rw [hTerm] at hStep; dsimp at hStep
                cases hBeq : Nat.beq tagDst valDst with
                | true => rw [hBeq] at hStep; cases hStep
                | false =>
                  rw [hBeq] at hStep; dsimp at hStep
                  rw [hTD, hVD, hBD] at hStep; dsimp at hStep
                  cases hTy : !(MirTy.beq t1 usizeTy) || !(MirTy.beq t2 usizeTy) with
                  | true => rw [hTy] at hStep; cases hStep
                  | false =>
                    rw [hTy] at hStep; dsimp at hStep
                    cases hEv1 : evalUsizeOp ctx.bodySrc.locals f₁.locals offOp with
                    | error _ => rw [hEv1] at hStep; cases hStep
                    | ok p1 =>
                      rw [hEv1] at hStep hEvSim; dsimp at hStep
                      cases hEv2 : evalUsizeOp ctx.bodyTgt.locals f₂.locals offOp with
                      | error _ => rw [hEv2] at hEvSim; exact False.elim hEvSim
                      | ok p2 =>
                        rw [hEv2] at hEvSim
                        cases p1 with | mk off1 slots₁' =>
                        cases p2 with | mk off2 slots₂' =>
                        dsimp at hEvSim
                        cases hSl : Trusted.MirSemantics.getElem? slots₁' bufLocal with
                        | none => rw [hSl] at hStep; cases hStep
                        | some sl =>
                          rw [hSl] at hStep
                          cases sl with
                          | baseSlot _ | ptrDead | livePtr _ => cases hStep
                          | bufSlot live =>
                            cases live with
                            | false => cases hStep
                            | true =>
                              dsimp at hStep
                              cases hFa : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                              | none => rw [hFa] at hStep; cases hStep
                              | some alloc =>
                                rw [hFa] at hStep; dsimp at hStep
                                cases hAl : !alloc.live with
                                | true => rw [hAl] at hStep; cases hStep
                                | false =>
                                  rw [hAl] at hStep; dsimp at hStep
                                  cases hAb : Trusted.MirSemantics.getElem? alloc.bytes off1 with
                                  | none => rw [hAb] at hStep; cases hStep
                                  | some ab =>
                                    rw [hAb] at hStep; dsimp at hStep
                                    cases hBLT : !Nat.blt (encodeAllocByte ab).1 maxUsize with
                                    | true => rw [hBLT] at hStep; cases hStep
                                    | false =>
                                      rw [hBLT] at hStep; dsimp at hStep
                                      have hWr1Sim := s3_writeBasePlace_sim ctx slots₁' slots₂' mem tagDst usizeTy
                                        (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩)
                                        (by rw [hTD, s3d_mirTy_beq_usize_eq t1 ((bool_and_eq_true _ _).mp hDecls).1])
                                        hEvSim.2.2.1 hEvSim.2.2.2
                                      cases hW1 : writeMemCopyBasePlace slots₁' tagDst usizeTy
                                          (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩) with
                                      | error _ => rw [hW1] at hStep; cases hStep
                                      | ok slots₁'' =>
                                        rw [hW1] at hStep hWr1Sim; dsimp at hStep
                                        cases hW1' : writeMemCopyBasePlace slots₂' tagDst usizeTy
                                            (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩) with
                                        | error _ => rw [hW1'] at hWr1Sim; exact False.elim hWr1Sim
                                        | ok slots₂'' =>
                                          rw [hW1'] at hWr1Sim
                                          have hWr2Sim := s3_writeBasePlace_sim ctx slots₁'' slots₂'' mem valDst usizeTy
                                            (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩)
                                            (by rw [hVD, s3d_mirTy_beq_usize_eq t2 ((bool_and_eq_true _ _).mp hDecls).2])
                                            hWr1Sim.1 hWr1Sim.2
                                          cases hW2 : writeMemCopyBasePlace slots₁'' valDst usizeTy
                                              (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩) with
                                          | error _ => rw [hW2] at hStep; cases hStep
                                          | ok slots₁''' =>
                                            rw [hW2] at hStep hWr2Sim; dsimp at hStep
                                            cases hW2' : writeMemCopyBasePlace slots₂'' valDst usizeTy
                                                (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩) with
                                            | error _ => rw [hW2'] at hWr2Sim; exact False.elim hWr2Sim
                                            | ok slots₂''' =>
                                              rw [hW2'] at hWr2Sim
                                              unfold jumpMemCopyBlock at hStep; cases hStep
                                              cases s3d_getElem?_some_of_lt hTgtLt with | intro bbJump hBbJump =>
                                              have hExecJump : ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem }
                                                  { frames := [{ f₂ with blockIdx := nextBb, stmtIdx := 0, locals := slots₂''' }], mem := mem } := by
                                                rw [hf₂Eq]
                                                refine s3_exec_term_jump ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals slots₂''' mem mem nextBb
                                                  (s3_bodyTgt_get ctx) hBbTgt ?_
                                                unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
                                                rw [hBeq]; dsimp; rw [hTDTgt, hVDTgt, hBDTgt]; dsimp
                                                rw [hTy]; dsimp; rw [hEv2]; dsimp; rw [← hEvSim.1]
                                                rw [hEvSim.2.2.2.2.2.2.1 bufLocal sz al mutab hBD, hSl]; dsimp
                                                rw [hFa]; dsimp; rw [hAl]; dsimp; rw [hAb]; dsimp; rw [hBLT]; dsimp
                                                rw [hW1']; dsimp; rw [hW2']
                                              cases hExecJump with | intro n hReach =>
                                              exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbJump hReach rfl hWr2Sim.1 hWr2Sim.2
              · intro out hDone
                unfold evalMemCopyTerm at hDone; dsimp at hDone; rw [hTerm] at hDone; dsimp at hDone
                cases hBeq : Nat.beq tagDst valDst with
                | true => rw [hBeq] at hDone; cases hDone
                | false =>
                  rw [hBeq] at hDone; dsimp at hDone; rw [hTD, hVD, hBD] at hDone; dsimp at hDone
                  cases hTy : !(MirTy.beq t1 usizeTy) || !(MirTy.beq t2 usizeTy) with
                  | true => rw [hTy] at hDone; cases hDone
                  | false =>
                    rw [hTy] at hDone; dsimp at hDone
                    cases hEv1 : evalUsizeOp ctx.bodySrc.locals f₁.locals offOp with
                    | error _ => rw [hEv1] at hDone; cases hDone
                    | ok p1 =>
                      rw [hEv1] at hDone; dsimp at hDone
                      cases hSl : Trusted.MirSemantics.getElem? p1.2 bufLocal with
                      | none => rw [hSl] at hDone; cases hDone
                      | some sl =>
                        rw [hSl] at hDone
                        cases sl with
                        | baseSlot _ | ptrDead | livePtr _ => cases hDone
                        | bufSlot live =>
                          cases live with
                          | false => cases hDone
                          | true =>
                            cases hFa : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                            | none => rw [hFa] at hDone; cases hDone
                            | some alloc =>
                              rw [hFa] at hDone; dsimp at hDone
                              cases hAl : !alloc.live with
                              | true => rw [hAl] at hDone; cases hDone
                              | false =>
                                rw [hAl] at hDone; dsimp at hDone
                                cases hAb : Trusted.MirSemantics.getElem? alloc.bytes p1.1 with
                                | none => rw [hAb] at hDone; cases hDone
                                | some ab =>
                                  rw [hAb] at hDone; dsimp at hDone
                                  cases hBLT : !Nat.blt (encodeAllocByte ab).1 maxUsize with
                                  | true => rw [hBLT] at hDone; cases hDone
                                  | false =>
                                    rw [hBLT] at hDone; dsimp at hDone
                                    cases hW1 : writeMemCopyBasePlace p1.2 tagDst usizeTy _ with
                                    | error _ => rw [hW1] at hDone; cases hDone
                                    | ok s2 =>
                                      rw [hW1] at hDone; dsimp at hDone
                                      cases hW2 : writeMemCopyBasePlace s2 valDst usizeTy _ with
                                      | error _ => rw [hW2] at hDone; cases hDone
                                      | ok _ => rw [hW2] at hDone; cases hDone
              · intro k hFault
                refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
                rw [hf₂Eq]
                refine s3_exec_term_fault ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals mem k
                  (s3_bodyTgt_get ctx) hBbTgt ?_
                unfold evalMemCopyTerm at hFault; dsimp at hFault
                unfold evalMemCopyTerm; dsimp
                rw [hTerm] at hFault; rw [hTermTgt]; dsimp at hFault; dsimp
                cases hBeq : Nat.beq tagDst valDst with
                | true => rw [hBeq] at hFault; exact hFault
                | false =>
                  rw [hBeq] at hFault; dsimp at hFault; dsimp
                  rw [hTD, hVD, hBD] at hFault; rw [hTDTgt, hVDTgt, hBDTgt]; dsimp at hFault; dsimp
                  cases hTy : !(MirTy.beq t1 usizeTy) || !(MirTy.beq t2 usizeTy) with
                  | true => rw [hTy] at hFault; exact hFault
                  | false =>
                    rw [hTy] at hFault; dsimp at hFault; dsimp
                    cases hEv1 : evalUsizeOp ctx.bodySrc.locals f₁.locals offOp with
                    | error k1 =>
                      rw [hEv1] at hFault hEvSim; cases hFault
                      cases hEv2 : evalUsizeOp ctx.bodyTgt.locals f₂.locals offOp with
                      | ok _ => rw [hEv2] at hEvSim; exact False.elim hEvSim
                      | error k2 => rw [hEv2] at hEvSim; rw [hEvSim]
                    | ok p1 =>
                      rw [hEv1] at hFault hEvSim; dsimp at hFault
                      cases hEv2 : evalUsizeOp ctx.bodyTgt.locals f₂.locals offOp with
                      | error _ => rw [hEv2] at hEvSim; exact False.elim hEvSim
                      | ok p2 =>
                        rw [hEv2] at hEvSim; dsimp
                        cases p1 with | mk off1 slots₁' =>
                        cases p2 with | mk off2 slots₂' =>
                        dsimp at hEvSim
                        rw [← hEvSim.1, hEvSim.2.2.2.2.2.2.1 bufLocal sz al mutab hBD]
                        cases hSl : Trusted.MirSemantics.getElem? slots₁' bufLocal with
                        | none => rw [hSl] at hFault; exact hFault
                        | some sl =>
                          rw [hSl] at hFault
                          cases sl with
                          | baseSlot _ | ptrDead | livePtr _ => exact hFault
                          | bufSlot live =>
                            cases live with
                            | false => exact hFault
                            | true =>
                              dsimp at hFault; dsimp
                              cases hFa : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                              | none => rw [hFa] at hFault; exact hFault
                              | some alloc =>
                                rw [hFa] at hFault; dsimp at hFault; dsimp
                                cases hAl : !alloc.live with
                                | true => rw [hAl] at hFault; exact hFault
                                | false =>
                                  rw [hAl] at hFault; dsimp at hFault; dsimp
                                  cases hAb : Trusted.MirSemantics.getElem? alloc.bytes off1 with
                                  | none => rw [hAb] at hFault; exact hFault
                                  | some ab =>
                                    rw [hAb] at hFault; dsimp at hFault; dsimp
                                    cases hBLT : !Nat.blt (encodeAllocByte ab).1 maxUsize with
                                    | true => rw [hBLT] at hFault; exact hFault
                                    | false =>
                                      rw [hBLT] at hFault; dsimp at hFault; dsimp
                                      have hWr1Sim := s3_writeBasePlace_sim ctx slots₁' slots₂' mem tagDst usizeTy
                                        (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩)
                                        (by rw [hTD, s3d_mirTy_beq_usize_eq t1 ((bool_and_eq_true _ _).mp hDecls).1])
                                        hEvSim.2.2.1 hEvSim.2.2.2
                                      cases hW1 : writeMemCopyBasePlace slots₁' tagDst usizeTy
                                          (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩) with
                                      | error ke1 =>
                                        rw [hW1] at hFault hWr1Sim
                                        cases hW1' : writeMemCopyBasePlace slots₂' tagDst usizeTy
                                            (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩) with
                                        | ok _ => rw [hW1'] at hWr1Sim; exact False.elim hWr1Sim
                                        | error ke2 =>
                                          rw [hW1'] at hWr1Sim; dsimp at hFault hWr1Sim; cases hFault; dsimp; rw [hWr1Sim]
                                      | ok slots₁'' =>
                                        rw [hW1] at hFault hWr1Sim; dsimp at hFault
                                        cases hW1' : writeMemCopyBasePlace slots₂' tagDst usizeTy
                                            (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩) with
                                        | error _ => rw [hW1'] at hWr1Sim; exact False.elim hWr1Sim
                                        | ok slots₂'' =>
                                          rw [hW1'] at hWr1Sim; dsimp
                                          have hWr2Sim := s3_writeBasePlace_sim ctx slots₁'' slots₂'' mem valDst usizeTy
                                            (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩)
                                            (by rw [hVD, s3d_mirTy_beq_usize_eq t2 ((bool_and_eq_true _ _).mp hDecls).2])
                                            hWr1Sim.1 hWr1Sim.2
                                          cases hW2 : writeMemCopyBasePlace slots₁'' valDst usizeTy
                                              (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩) with
                                          | ok _ => rw [hW2] at hFault; cases hFault
                                          | error ke1 =>
                                            rw [hW2] at hFault hWr2Sim
                                            cases hW2' : writeMemCopyBasePlace slots₂'' valDst usizeTy
                                                (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩) with
                                            | ok _ => rw [hW2'] at hWr2Sim; exact False.elim hWr2Sim
                                            | error ke2 =>
                                              rw [hW2'] at hWr2Sim; dsimp at hFault hWr2Sim; cases hFault; dsimp; rw [hWr2Sim]

private theorem s3d_writeBufRawByte_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (bufLocal : LocalId) (offOp tagOp valOp : Operand) (nextBb : BasicBlockId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator = .writeBufRawByte bufLocal offOp tagOp valOp nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3d_blockTerm_check ctx hBbSrc
  have hTib := s3d_blockTerm_targetsInBounds ctx hBbSrc
  rw [hTerm] at hChk hTib
  unfold checkTermForPtrs at hChk; dsimp at hChk
  have hAnd1 := (bool_and_eq_true _ _).mp hChk
  have hAnd2 := (bool_and_eq_true _ _).mp hAnd1.1
  have hAnd3 := (bool_and_eq_true _ _).mp hAnd2.1
  have hOffBase : operandUsesOnlyBaseMem ctx.bodySrc.locals offOp = true :=
    s3_operandHasBaseTy_usesOnlyBase ctx.bodySrc.locals usizeTy offOp hAnd3.1
  have hTagBase : operandUsesOnlyBaseMem ctx.bodySrc.locals tagOp = true :=
    s3_operandHasBaseTy_usesOnlyBase ctx.bodySrc.locals usizeTy tagOp hAnd3.2
  have hValBase : operandUsesOnlyBaseMem ctx.bodySrc.locals valOp = true :=
    s3_operandHasBaseTy_usesOnlyBase ctx.bodySrc.locals usizeTy valOp hAnd2.2
  have hBDecl := hAnd1.2
  cases hBD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLocal with
  | none => rw [hBD] at hBDecl; cases hBDecl
  | some db =>
    rw [hBD] at hBDecl
    cases db with
    | base _ | ptrLocal => cases hBDecl
    | byteBuf sz al mutab =>
      have hBDTgt := s3_bodyTgt_locals_base ctx bufLocal (s3_getElem?_some_lt _ _ _ hBD)
      rw [hBD] at hBDTgt
      cases s3_lowerBlock_getElem?_termPre ctx hBbSrc with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      let bbTgt : MemCopyBlock := {
        bbSrc with
        statements := listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) bbSrc.statements ++
          (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).1
        terminator := (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).2.1
      }
      have hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₁.blockIdx = some bbTgt := hBlock.2.2.1
      have hEnd₂ : f₂.stmtIdx = bbTgt.statements.length := by
        have hPre0 : (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bbSrc.terminator).1.length = 0 := by
          rw [hTerm]; rfl
        have hOff := hBlock.2.2.2.1
        rw [hPre0, Nat.add_zero] at hOff
        rw [hIdxEq, hEnd₁, hOff]
      have hTermTgt : bbTgt.terminator = .writeBufRawByte bufLocal offOp tagOp valOp nextBb := by
        dsimp [bbTgt]; rw [hTerm]; rfl
      have hf₂Eq : f₂ = {
          defId := ctx.plan.defId
          blockIdx := f₁.blockIdx
          stmtIdx := bbTgt.statements.length
          locals := f₂.locals } := by
        cases f₂; dsimp at hDef₂ hBbRel hEnd₂; subst hDef₂; subst hBbRel; subst hEnd₂; rfl
      have hTgtLt : nextBb < ctx.bodySrc.basicBlocks.length := by
        unfold memCopyTermTargetsInBounds at hTib
        exact (nat_blt_eq_lt _ _).mp hTib
      have hEvOffSim := s3_evalUsizeOp_sim ctx f₁.locals f₂.locals mem offOp hWf hRel hOffBase
      apply s3d_fwdStepSim_of_term_multi ctx hDef₁ hBbSrc hEnd₁
      · intro s₁' hStep
        unfold evalMemCopyTerm at hStep; dsimp at hStep; rw [hTerm] at hStep; dsimp at hStep
        rw [hBD] at hStep; dsimp at hStep
        cases hEO1 : evalUsizeOp ctx.bodySrc.locals f₁.locals offOp with
        | error _ => rw [hEO1] at hStep; cases hStep
        | ok pO1 =>
          rw [hEO1] at hStep hEvOffSim; dsimp at hStep
          cases hEO2 : evalUsizeOp ctx.bodyTgt.locals f₂.locals offOp with
          | error _ => rw [hEO2] at hEvOffSim; exact False.elim hEvOffSim
          | ok pO2 =>
            rw [hEO2] at hEvOffSim
            cases pO1 with | mk off1 slots₁a =>
            cases pO2 with | mk off2 slots₂a =>
            dsimp at hEvOffSim
            have hEvTagSim := s3_evalUsizeOp_sim ctx slots₁a slots₂a mem tagOp hEvOffSim.2.2.1 hEvOffSim.2.2.2 hTagBase
            cases hET1 : evalUsizeOp ctx.bodySrc.locals slots₁a tagOp with
            | error _ => rw [hET1] at hStep; cases hStep
            | ok pT1 =>
              rw [hET1] at hStep hEvTagSim; dsimp at hStep
              cases hET2 : evalUsizeOp ctx.bodyTgt.locals slots₂a tagOp with
              | error _ => rw [hET2] at hEvTagSim; exact False.elim hEvTagSim
              | ok pT2 =>
                rw [hET2] at hEvTagSim
                cases pT1 with | mk t1 slots₁b =>
                cases pT2 with | mk t2 slots₂b =>
                dsimp at hEvTagSim
                have hEvValSim := s3_evalUsizeOp_sim ctx slots₁b slots₂b mem valOp hEvTagSim.2.2.1 hEvTagSim.2.2.2 hValBase
                cases hEV1 : evalUsizeOp ctx.bodySrc.locals slots₁b valOp with
                | error _ => rw [hEV1] at hStep; cases hStep
                | ok pV1 =>
                  rw [hEV1] at hStep hEvValSim; dsimp at hStep
                  cases hEV2 : evalUsizeOp ctx.bodyTgt.locals slots₂b valOp with
                  | error _ => rw [hEV2] at hEvValSim; exact False.elim hEvValSim
                  | ok pV2 =>
                    rw [hEV2] at hEvValSim
                    cases pV1 with | mk v1 slots₁c =>
                    cases pV2 with | mk v2 slots₂c =>
                    dsimp at hEvValSim
                    cases hSl : Trusted.MirSemantics.getElem? slots₁c bufLocal with
                    | none => rw [hSl] at hStep; cases hStep
                    | some sl =>
                      rw [hSl] at hStep
                      cases sl with
                      | baseSlot _ | ptrDead | livePtr _ => cases hStep
                      | bufSlot live =>
                        cases live with
                        | false => cases hStep
                        | true =>
                          dsimp at hStep
                          cases hFa : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                          | none => rw [hFa] at hStep; cases hStep
                          | some alloc =>
                            rw [hFa] at hStep; dsimp at hStep
                            cases hGuard : !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
                                !Nat.blt off1 alloc.bytes.length with
                            | true => rw [hGuard] at hStep; cases hStep
                            | false =>
                              rw [hGuard] at hStep; dsimp at hStep
                              let ab := decodeAllocByte t1 v1
                              let updated : Allocation := { alloc with bytes := spliceBytes alloc.bytes off1 [ab] }
                              cases hUp : updateAlloc? (internalAllocBase + bufLocal) updated mem.allocations with
                              | none => rw [hUp] at hStep; cases hStep
                              | some allocs' =>
                                rw [hUp] at hStep; dsimp at hStep
                                unfold jumpMemCopyBlock at hStep; cases hStep
                                have hOffLtLen : off1 < alloc.bytes.length := by
                                  cases hBL : Nat.blt off1 alloc.bytes.length with
                                  | true => exact (nat_blt_eq_lt _ _).mp hBL
                                  | false =>
                                    rw [hBL] at hGuard
                                    have hOrF : ∀ x : Bool, (x || !false) = false → False :=
                                      fun x h => match x with
                                      | true => Bool.noConfusion h
                                      | false => Bool.noConfusion h
                                    exact False.elim (hOrF _ hGuard)
                                have hOldWf := hEvValSim.2.2.1.2.1 bufLocal sz al mutab hBD
                                have hOldBytesBounded : s3_AllocBytesTagBounded alloc.bytes := by
                                  cases hOldWf with | intro lv hR =>
                                  cases hR with | intro oldA hA =>
                                  rw [hFa] at hA
                                  cases hA.2.1; exact hA.2.2.2.2.2.2
                                have hSpLen : (spliceBytes alloc.bytes off1 [ab]).length = alloc.bytes.length :=
                                  s3_spliceBytes_length alloc.bytes off1 [ab] hOffLtLen
                                have hTagBounded : s3_AllocBytesTagBounded updated.bytes :=
                                  s3_allocBytesTagBounded_spliceBytes alloc.bytes [ab] off1 hOldBytesBounded
                                    (s3_allocBytesTagBounded_decode t1 v1 hEvTagSim.2.1)
                                have hWf' := s3_memWf_updateAlloc_sameShape ctx.bodySrc slots₁c mem bufLocal updated allocs' alloc
                                  sz al mutab hEvValSim.2.2.1 hBD hFa (s3d_findAlloc?_allocId (internalAllocBase + bufLocal) alloc mem.allocations hFa) hUp ⟨rfl, rfl, rfl, hSpLen, hTagBounded⟩
                                cases s3d_getElem?_some_of_lt hTgtLt with | intro bbJump hBbJump =>
                                have hExecJump : ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem }
                                    { frames := [{ f₂ with blockIdx := nextBb, stmtIdx := 0, locals := slots₂c }], mem := ⟨allocs'⟩ } := by
                                  rw [hf₂Eq]
                                  refine s3_exec_term_jump ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals slots₂c mem ⟨allocs'⟩ nextBb
                                    (s3_bodyTgt_get ctx) hBbTgt ?_
                                  unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
                                  rw [hBDTgt]; dsimp
                                  rw [hEO2]; dsimp; rw [← hEvOffSim.1]
                                  rw [hET2]; dsimp; rw [← hEvTagSim.1]
                                  rw [hEV2]; dsimp; rw [← hEvValSim.1]
                                  rw [hEvValSim.2.2.2.2.2.2.1 bufLocal sz al mutab hBD, hSl]; dsimp
                                  rw [hFa]; dsimp; rw [hGuard]; dsimp; rw [hUp]
                                cases hExecJump with | intro n hReach =>
                                exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbJump hReach rfl hWf' hEvValSim.2.2.2
      · intro out hDone
        unfold evalMemCopyTerm at hDone; dsimp at hDone; rw [hTerm] at hDone; dsimp at hDone
        rw [hBD] at hDone; dsimp at hDone
        cases hEO : evalUsizeOp ctx.bodySrc.locals f₁.locals offOp with
        | error _ => rw [hEO] at hDone; cases hDone
        | ok pO =>
          rw [hEO] at hDone; dsimp at hDone
          cases hET : evalUsizeOp ctx.bodySrc.locals pO.2 tagOp with
          | error _ => rw [hET] at hDone; cases hDone
          | ok pT =>
            rw [hET] at hDone; dsimp at hDone
            cases hEV : evalUsizeOp ctx.bodySrc.locals pT.2 valOp with
            | error _ => rw [hEV] at hDone; cases hDone
            | ok pV =>
              rw [hEV] at hDone; dsimp at hDone
              cases hSl : Trusted.MirSemantics.getElem? pV.2 bufLocal with
              | none => rw [hSl] at hDone; cases hDone
              | some sl =>
                rw [hSl] at hDone
                cases sl with
                | baseSlot _ | ptrDead | livePtr _ => cases hDone
                | bufSlot live =>
                  cases live with
                  | false => cases hDone
                  | true =>
                    cases hFa : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                    | none => rw [hFa] at hDone; cases hDone
                    | some alloc =>
                      rw [hFa] at hDone; dsimp at hDone
                      cases hGuard : !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
                          !Nat.blt pO.1 alloc.bytes.length with
                      | true => rw [hGuard] at hDone; cases hDone
                      | false =>
                        rw [hGuard] at hDone; dsimp at hDone
                        cases hUp : updateAlloc? (internalAllocBase + bufLocal) _ mem.allocations with
                        | none => rw [hUp] at hDone; cases hDone
                        | some _ => rw [hUp] at hDone; cases hDone
      · intro k hFault
        refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
        rw [hf₂Eq]
        refine s3_exec_term_fault ctx.pTgt ctx.plan.defId f₁.blockIdx ctx.bodyTgt _ f₂.locals mem k
          (s3_bodyTgt_get ctx) hBbTgt ?_
        unfold evalMemCopyTerm at hFault; dsimp at hFault
        unfold evalMemCopyTerm; dsimp
        rw [hTerm] at hFault; rw [hTermTgt]; dsimp at hFault; dsimp
        rw [hBD] at hFault; rw [hBDTgt]; dsimp at hFault; dsimp
        cases hEO1 : evalUsizeOp ctx.bodySrc.locals f₁.locals offOp with
        | error k1 =>
          rw [hEO1] at hFault hEvOffSim; cases hFault
          cases hEO2 : evalUsizeOp ctx.bodyTgt.locals f₂.locals offOp with
          | ok _ => rw [hEO2] at hEvOffSim; exact False.elim hEvOffSim
          | error k2 => rw [hEO2] at hEvOffSim; rw [hEvOffSim]
        | ok pO1 =>
          rw [hEO1] at hFault hEvOffSim; dsimp at hFault
          cases hEO2 : evalUsizeOp ctx.bodyTgt.locals f₂.locals offOp with
          | error _ => rw [hEO2] at hEvOffSim; exact False.elim hEvOffSim
          | ok pO2 =>
            rw [hEO2] at hEvOffSim; dsimp
            cases pO1 with | mk off1 slots₁a =>
            cases pO2 with | mk off2 slots₂a =>
            dsimp at hEvOffSim
            rw [← hEvOffSim.1]
            have hEvTagSim := s3_evalUsizeOp_sim ctx slots₁a slots₂a mem tagOp hEvOffSim.2.2.1 hEvOffSim.2.2.2 hTagBase
            cases hET1 : evalUsizeOp ctx.bodySrc.locals slots₁a tagOp with
            | error k1 =>
              rw [hET1] at hFault hEvTagSim; cases hFault
              cases hET2 : evalUsizeOp ctx.bodyTgt.locals slots₂a tagOp with
              | ok _ => rw [hET2] at hEvTagSim; exact False.elim hEvTagSim
              | error k2 => rw [hET2] at hEvTagSim; rw [hEvTagSim]
            | ok pT1 =>
              rw [hET1] at hFault hEvTagSim; dsimp at hFault
              cases hET2 : evalUsizeOp ctx.bodyTgt.locals slots₂a tagOp with
              | error _ => rw [hET2] at hEvTagSim; exact False.elim hEvTagSim
              | ok pT2 =>
                rw [hET2] at hEvTagSim; dsimp
                cases pT1 with | mk t1 slots₁b =>
                cases pT2 with | mk t2 slots₂b =>
                dsimp at hEvTagSim
                rw [← hEvTagSim.1]
                have hEvValSim := s3_evalUsizeOp_sim ctx slots₁b slots₂b mem valOp hEvTagSim.2.2.1 hEvTagSim.2.2.2 hValBase
                cases hEV1 : evalUsizeOp ctx.bodySrc.locals slots₁b valOp with
                | error k1 =>
                  rw [hEV1] at hFault hEvValSim; cases hFault
                  cases hEV2 : evalUsizeOp ctx.bodyTgt.locals slots₂b valOp with
                  | ok _ => rw [hEV2] at hEvValSim; exact False.elim hEvValSim
                  | error k2 => rw [hEV2] at hEvValSim; rw [hEvValSim]
                | ok pV1 =>
                  rw [hEV1] at hFault hEvValSim; dsimp at hFault
                  cases hEV2 : evalUsizeOp ctx.bodyTgt.locals slots₂b valOp with
                  | error _ => rw [hEV2] at hEvValSim; exact False.elim hEvValSim
                  | ok pV2 =>
                    rw [hEV2] at hEvValSim; dsimp
                    cases pV1 with | mk v1 slots₁c =>
                    cases pV2 with | mk v2 slots₂c =>
                    dsimp at hEvValSim
                    rw [← hEvValSim.1, hEvValSim.2.2.2.2.2.2.1 bufLocal sz al mutab hBD]
                    cases hSl : Trusted.MirSemantics.getElem? slots₁c bufLocal with
                    | none => rw [hSl] at hFault; exact hFault
                    | some sl =>
                      rw [hSl] at hFault
                      cases sl with
                      | baseSlot _ | ptrDead | livePtr _ => exact hFault
                      | bufSlot live =>
                        cases live with
                        | false => exact hFault
                        | true =>
                          dsimp at hFault; dsimp
                          cases hFa : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                          | none => rw [hFa] at hFault; exact hFault
                          | some alloc =>
                            rw [hFa] at hFault; dsimp at hFault; dsimp
                            cases hGuard : !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
                                !Nat.blt off1 alloc.bytes.length with
                            | true => rw [hGuard] at hFault; exact hFault
                            | false =>
                              rw [hGuard] at hFault; dsimp at hFault; dsimp
                              cases hUp : updateAlloc? (internalAllocBase + bufLocal) _ mem.allocations with
                              | none => rw [hUp] at hFault; exact hFault
                              | some _ => rw [hUp] at hFault; cases hFault

/-! ## Section 3: `.checkPtrPairAlign` Simulation -/

private theorem s3d_reachesN_trans {p : MemCopyProgram} :
    ∀ {n m : Nat} {s₁ s₂ s₃ : MemCopyState},
      ReachesNMemCopy p n s₁ s₂ →
      ReachesNMemCopy p m s₂ s₃ →
      ReachesNMemCopy p (n + m) s₁ s₃
  | 0, _, _, _, _, .zero _, h23 => by
    rw [Nat.zero_add]; exact h23
  | _ + 1, _, _, _, _, .succ hStep h12, h23 => by
    rw [Nat.succ_add]
    exact .succ hStep (s3d_reachesN_trans h12 h23)

private theorem s3d_findPtrEntry_buf_decl (ctx : s3_PtrCtx) {pLoc : LocalId} {k : Nat}
    {bLoc : LocalId} (hFind : findPtrEntry ctx.plan.entries pLoc = some (k, some bLoc)) :
    ctx.bodySrc.argumentCount < bLoc ∧
      ∃ sz al mutab,
        Trusted.MirSemantics.getElem? ctx.bodySrc.locals bLoc =
            some (.byteBuf sz al mutab) ∧
          sz ≤ 32 ∧ al ≤ 30 := by
  cases (s3_findPtrEntry_some_iff ctx pLoc k (some bLoc)).mp hFind with
  | intro e hE =>
    have hSpec :=
      (s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
        ctx.bodySrc.locals ctx.plan.entries ctx.hEntries).1 k e hE.1
    have hBuf := hSpec.2.2
    rw [hE.2.2] at hBuf
    exact hBuf

private theorem s3d_findPtrEntry_optBuf_forall (ctx : s3_PtrCtx) {pLoc : LocalId} {k : Nat}
    {optBuf : Option LocalId} (hFind : findPtrEntry ctx.plan.entries pLoc = some (k, optBuf)) :
    ∀ bLoc : LocalId, optBuf = some bLoc →
      ∃ sz al mutab,
        Trusted.MirSemantics.getElem? ctx.bodySrc.locals bLoc =
            some (.byteBuf sz al mutab) ∧
          sz ≤ 32 ∧ al ≤ 30 := by
  intro bLoc hb
  have hF := hFind
  rw [hb] at hF
  exact (s3d_findPtrEntry_buf_decl ctx hF).2

private theorem s3d_getElem?_append_mid {α : Type} (xs ys zs : List α) (k : Nat)
    (hk : k < ys.length) :
    Trusted.MirSemantics.getElem? ((xs ++ ys) ++ zs) (xs.length + k) =
      Trusted.MirSemantics.getElem? ys k := by
  rw [s3_getElem?_append_left (xs ++ ys) zs (xs.length + k) (by
    rw [List.length_append]; exact Nat.add_lt_add_left hk _)]
  rw [s3_getElem?_append_right xs ys (xs.length + k) (Nat.le_add_right _ _)]
  rw [Nat.add_sub_cancel_left]

private theorem s3d_stmt_pre_at (bbTgt : MemCopyBlock) (off : Nat) (pre : List MemCopyStmt)
    (hPre : ∀ j : Nat, j < pre.length →
      Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
        Trusted.MirSemantics.getElem? pre j)
    (j : Nat) (hj : j < pre.length) :
    Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
      Trusted.MirSemantics.getElem? pre j :=
  hPre j hj

private theorem s3d_stmt_left_at (bbTgt : MemCopyBlock) (off : Nat)
    (ys zs : List MemCopyStmt)
    (hPre : ∀ j : Nat, j < (ys ++ zs).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
        Trusted.MirSemantics.getElem? (ys ++ zs) j)
    (k : Nat) (hk : k < ys.length) :
    Trusted.MirSemantics.getElem? bbTgt.statements (off + k) =
      Trusted.MirSemantics.getElem? ys k := by
  have hLt : k < (ys ++ zs).length := by
    rw [List.length_append]; exact Nat.lt_of_lt_of_le hk (Nat.le_add_right _ _)
  rw [hPre k hLt, s3_getElem?_append_left ys zs k hk]

private theorem s3d_stmt_mid_at (bbTgt : MemCopyBlock) (off : Nat)
    (xs ys zs : List MemCopyStmt)
    (hPre : ∀ j : Nat, j < ((xs ++ ys) ++ zs).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
        Trusted.MirSemantics.getElem? ((xs ++ ys) ++ zs) j)
    (k : Nat) (hk : k < ys.length) :
    Trusted.MirSemantics.getElem? bbTgt.statements ((off + xs.length) + k) =
      Trusted.MirSemantics.getElem? ys k := by
  have hLt : xs.length + k < ((xs ++ ys) ++ zs).length := by
    rw [List.length_append, List.length_append]
    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hk _) (Nat.le_add_right _ _)
  rw [Nat.add_assoc, hPre (xs.length + k) hLt, s3d_getElem?_append_mid xs ys zs k hk]

private theorem s3d_stmt_right_at (bbTgt : MemCopyBlock) (off : Nat)
    (xs ys : List MemCopyStmt)
    (hPre : ∀ j : Nat, j < (xs ++ ys).length →
      Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
        Trusted.MirSemantics.getElem? (xs ++ ys) j)
    (k : Nat) (hk : k < ys.length) :
    Trusted.MirSemantics.getElem? bbTgt.statements ((off + xs.length) + k) =
      Trusted.MirSemantics.getElem? ys k := by
  have hLt : xs.length + k < (xs ++ ys).length := by
    rw [List.length_append]; exact Nat.add_lt_add_left hk _
  rw [Nat.add_assoc, hPre (xs.length + k) hLt]
  rw [s3_getElem?_append_right xs ys (xs.length + k) (Nat.le_add_right _ _)]
  rw [Nat.add_sub_cancel_left]

private theorem s3d_checkPtrPairAlign_run (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (srcPtr dstPtr : LocalId) (elemSize reqAlignLog2 : Nat)
    (checkNonNullZero : Bool) (nextBb : BasicBlockId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator =
      .checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    match evalMemCopyTerm ctx.bodySrc bbSrc f₁ mem with
    | .step s₁' =>
      ∃ s₂' : MemCopyState,
        ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
        s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂'
    | .done _ => False
    | .fault k =>
      ∃ s₂' : MemCopyState,
        ReachesMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.fault k) := by
  have hChk := s3d_blockTerm_check ctx hBbSrc
  have hTib := s3d_blockTerm_targetsInBounds ctx hBbSrc
  rw [hTerm] at hChk hTib
  unfold checkTermForPtrs at hChk; dsimp at hChk
  have hChkP := (bool_and_eq_true _ _).mp hChk
  have hReqBle : Nat.ble reqAlignLog2 30 = true := hChkP.1
  have hReqLe : reqAlignLog2 ≤ 30 := (nat_ble_eq_le _ _).mp hReqBle
  have hNotReq : (!Nat.ble reqAlignLog2 30) = false := by rw [hReqBle]; rfl
  have hFindPair := hChkP.2
  cases hFindS : findPtrEntry ctx.plan.entries srcPtr with
  | none => rw [hFindS] at hFindPair; cases hFindPair
  | some pS =>
    cases pS with | mk kS optBufS =>
    cases hFindD : findPtrEntry ctx.plan.entries dstPtr with
    | none => rw [hFindS, hFindD] at hFindPair; cases hFindPair
    | some pD =>
      cases pD with | mk kD optBufD =>
      unfold memCopyTermTargetsInBounds at hTib
      have hTgtLt : nextBb < ctx.bodySrc.basicBlocks.length := (nat_blt_eq_lt _ _).mp hTib
      cases s3d_getElem?_some_of_lt hTgtLt with | intro bbJump hBbJump =>
      cases s3_lowerBlock_getElem?_termPre ctx hBbSrc with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      let pair := lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
        ctx.bodySrc.locals.length extraBase bbSrc.terminator
      let bbTgt : MemCopyBlock := {
        bbSrc with
        statements := listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries
          ctx.bodySrc.locals.length) bbSrc.statements ++ pair.1
        terminator := pair.2.1
      }
      let off := s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length
      have hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₁.blockIdx = some bbTgt :=
        hBlock.2.2.1
      have hOffLen : off + pair.1.length = bbTgt.statements.length := hBlock.2.2.2.1
      have hPreStmts : ∀ j : Nat, j < pair.1.length →
          Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
            Trusted.MirSemantics.getElem? pair.1 j := hBlock.2.2.2.2.1
      have hf₂Eq : f₂ = {
          defId := ctx.plan.defId
          blockIdx := f₁.blockIdx
          stmtIdx := off
          locals := f₂.locals } := by
        cases f₂ with
        | mk d₂ b₂ s₂ l₂ =>
          dsimp at hDef₂ hBbRel hIdxEq
          have hSt2 : s₂ = off := by rw [hIdxEq, hEnd₁]
          subst hDef₂; subst hBbRel; subst hSt2; rfl
      let scrTag1 := s3_scrBase ctx
      let scrOff1 := s3_scrBase ctx + 1
      let scrTag2 := s3_scrBase ctx + 2
      let scrOff2 := s3_scrBase ctx + 3
      let scrTmpA := s3_scrBase ctx + 5
      let scrTmpB := s3_scrBase ctx + 6
      let offS := ctx.bodySrc.locals.length + 3 * kS
      let offD := ctx.bodySrc.locals.length + 3 * kD
      let readBoth : List MemCopyStmt := [
        mkLivenessCheckStmt offS,
        mkAssignUse scrTag1 (.copy { localId := offS + 1, projection := [] }),
        mkAssignUse scrOff1 (.copy { localId := offS + 2, projection := [] }),
        mkLivenessCheckStmt offD,
        mkAssignUse scrTag2 (.copy { localId := offD + 1, projection := [] }),
        mkAssignUse scrOff2 (.copy { localId := offD + 2, projection := [] })
      ]
      let align1 := mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS
        scrTag1 scrOff1 scrTmpA scrTmpB reqAlignLog2
      let align2 := mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD
        scrTag2 scrOff2 scrTmpA scrTmpB reqAlignLog2
      let nonNullStmts : List MemCopyStmt :=
        if checkNonNullZero = true then
          mkPtrNonNullCheckStmts scrTag1 scrOff1 scrTmpA scrTmpB ++
          mkPtrNonNullCheckStmts scrTag2 scrOff2 scrTmpA scrTmpB
        else []
      have hPairEq : pair = ((readBoth ++ (align1 ++ align2)) ++ nonNullStmts,
          .baseTerm (.goto nextBb), []) := by
        dsimp [pair]
        rw [hTerm]; dsimp [lowerTermForPtrs]
        rw [hFindS, hFindD]; rfl
      have hPair1Eq : pair.1 = (readBoth ++ (align1 ++ align2)) ++ nonNullStmts := by
        rw [hPairEq]
      have hTermTgt : bbTgt.terminator = .baseTerm (.goto nextBb) := by
        dsimp [bbTgt]; rw [hPairEq]
      have hPreStmts' : ∀ j : Nat, j < ((readBoth ++ (align1 ++ align2)) ++ nonNullStmts).length →
          Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
            Trusted.MirSemantics.getElem? ((readBoth ++ (align1 ++ align2)) ++ nonNullStmts) j := by
        intro j hj
        rw [← hPair1Eq]
        exact hPreStmts j (by rw [hPair1Eq]; exact hj)
      have hRBLen : readBoth.length = 6 := rfl
      have hEqLeft : readBoth ++ ((align1 ++ align2) ++ nonNullStmts) =
          (readBoth ++ (align1 ++ align2)) ++ nonNullStmts := by
        rw [List.append_assoc readBoth (align1 ++ align2) nonNullStmts]
      have hPreLeft : ∀ j : Nat, j < (readBoth ++ ((align1 ++ align2) ++ nonNullStmts)).length →
          Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
            Trusted.MirSemantics.getElem? (readBoth ++ ((align1 ++ align2) ++ nonNullStmts)) j := by
        intro j hj; rw [hEqLeft] at hj; rw [hEqLeft]; exact hPreStmts' j hj
      have hRB0 : Trusted.MirSemantics.getElem? bbTgt.statements off =
          some (mkLivenessCheckStmt offS) := by
        have h0 := s3d_stmt_left_at bbTgt off readBoth ((align1 ++ align2) ++ nonNullStmts)
          hPreLeft 0 (by rw [hRBLen]; decide)
        rw [Nat.add_zero] at h0; exact h0
      have hRB1 : Trusted.MirSemantics.getElem? bbTgt.statements (off + 1) =
          some (mkAssignUse (s3_scrBase ctx + 0) (.copy { localId := offS + 1, projection := [] })) :=
        s3d_stmt_left_at bbTgt off readBoth ((align1 ++ align2) ++ nonNullStmts)
          hPreLeft 1 (by rw [hRBLen]; decide)
      have hRB2 : Trusted.MirSemantics.getElem? bbTgt.statements (off + 2) =
          some (mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := offS + 2, projection := [] })) :=
        s3d_stmt_left_at bbTgt off readBoth ((align1 ++ align2) ++ nonNullStmts)
          hPreLeft 2 (by rw [hRBLen]; decide)
      have hRB3 : Trusted.MirSemantics.getElem? bbTgt.statements (off + 3) =
          some (mkLivenessCheckStmt offD) :=
        s3d_stmt_left_at bbTgt off readBoth ((align1 ++ align2) ++ nonNullStmts)
          hPreLeft 3 (by rw [hRBLen]; decide)
      have hRB4 : Trusted.MirSemantics.getElem? bbTgt.statements ((off + 3) + 1) =
          some (mkAssignUse (s3_scrBase ctx + 2) (.copy { localId := offD + 1, projection := [] })) := by
        rw [Nat.add_assoc]
        exact s3d_stmt_left_at bbTgt off readBoth ((align1 ++ align2) ++ nonNullStmts)
          hPreLeft 4 (by rw [hRBLen]; decide)
      have hRB5 : Trusted.MirSemantics.getElem? bbTgt.statements ((off + 3) + 2) =
          some (mkAssignUse (s3_scrBase ctx + 3) (.copy { localId := offD + 2, projection := [] })) := by
        rw [Nat.add_assoc]
        exact s3d_stmt_left_at bbTgt off readBoth ((align1 ++ align2) ++ nonNullStmts)
          hPreLeft 5 (by rw [hRBLen]; decide)
      have hEq1 : (readBoth ++ align1) ++ (align2 ++ nonNullStmts) =
          (readBoth ++ (align1 ++ align2)) ++ nonNullStmts := by
        rw [← List.append_assoc (readBoth ++ align1) align2 nonNullStmts,
          List.append_assoc readBoth align1 align2]
      have hEq2 : ((readBoth ++ align1) ++ align2) ++ nonNullStmts =
          (readBoth ++ (align1 ++ align2)) ++ nonNullStmts := by
        rw [List.append_assoc readBoth align1 align2]
      have hA1At : ∀ k : Nat, ∀ s : MemCopyStmt,
          Trusted.MirSemantics.getElem? align1 k = some s →
          Trusted.MirSemantics.getElem? bbTgt.statements ((off + 6) + k) = some s := by
        intro k s hK
        have hk := s3_getElem?_some_lt _ _ _ hK
        have hMid := s3d_stmt_mid_at bbTgt off readBoth align1 (align2 ++ nonNullStmts)
          (fun j hj => by rw [hEq1] at hj; rw [hEq1]; exact hPreStmts' j hj)
          k hk
        rw [← hK]; exact hMid
      have hA2At : ∀ k : Nat, ∀ s : MemCopyStmt,
          Trusted.MirSemantics.getElem? align2 k = some s →
          Trusted.MirSemantics.getElem? bbTgt.statements ((off + 6 + align1.length) + k) = some s := by
        intro k s hK
        have hk := s3_getElem?_some_lt _ _ _ hK
        have hMid := s3d_stmt_mid_at bbTgt off (readBoth ++ align1) align2 nonNullStmts
          (fun j hj => by rw [hEq2] at hj; rw [hEq2]; exact hPreStmts' j hj)
          k hk
        have hLenRB : (readBoth ++ align1).length = 6 + align1.length := by
          rw [List.length_append, hRBLen]
        rw [hLenRB, ← Nat.add_assoc off 6 align1.length] at hMid
        rw [← hK]; exact hMid
      unfold evalMemCopyTerm; dsimp; rw [hTerm]; dsimp; rw [hNotReq]; dsimp
      have hExecS := s3_exec_readPtr ctx (bbIdx := f₁.blockIdx) (bbTgt := bbTgt)
        (startIdx := off) (slots₁ := f₁.locals) (slots₂ := f₂.locals) (mem := mem)
        srcPtr kS 0 1 optBufS false hFindS (by decide) (by decide) (by decide)
        hWf hRel hBbTgt hRB0 hRB1 hRB2
      cases hRS : readPtrLocal ctx.bodySrc.locals f₁.locals srcPtr false with
      | error k =>
        rw [hRS] at hExecS; dsimp
        cases hExecS with | intro n hB =>
        cases hB with | intro sBad hBad =>
        rw [hf₂Eq]
        exact s3_fault_of_reachesN hBad.1 hBad.2
      | ok p1 =>
        rw [hRS] at hExecS; dsimp
        cases p1 with | mk pvSrc slots₁a =>
        cases hExecS with | intro tagS hS =>
        cases hS with | intro slots₂a hS =>
        have hReach1 := hS.2.2.2.1
        have hWf1 := hS.2.2.2.2.1
        have hRel1 := hS.2.2.2.2.2.1
        have hTagS : Trusted.MirSemantics.getElem? slots₂a (s3_scrBase ctx + 0) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagS })))) :=
          hS.2.2.2.2.2.2.1
        have hOffS : Trusted.MirSemantics.getElem? slots₂a (s3_scrBase ctx + 1) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvSrc.offsetBytes.toNat })))) :=
          hS.2.2.2.2.2.2.2.1
        have hExecD := s3_exec_readPtr ctx (bbIdx := f₁.blockIdx) (bbTgt := bbTgt)
          (startIdx := off + 3) (slots₁ := slots₁a) (slots₂ := slots₂a) (mem := mem)
          dstPtr kD 2 3 optBufD false hFindD (by decide) (by decide) (by decide)
          hWf1 hRel1 hBbTgt hRB3 hRB4 hRB5
        cases hRD : readPtrLocal ctx.bodySrc.locals slots₁a dstPtr false with
        | error k =>
          rw [hRD] at hExecD; dsimp
          cases hExecD with | intro n hB =>
          cases hB with | intro sBad hBad =>
          rw [hf₂Eq]
          exact s3_fault_of_reachesN (s3d_reachesN_trans hReach1 hBad.1) hBad.2
        | ok p2 =>
          rw [hRD] at hExecD; dsimp
          cases p2 with | mk pvDst slots₁b =>
          cases hExecD with | intro tagD hD =>
          cases hD with | intro slots₂b hD =>
          let f2AInit : MemCopyFrame := {
            defId := ctx.plan.defId
            blockIdx := f₁.blockIdx
            stmtIdx := off
            locals := f₂.locals
          }
          let f2AMid : MemCopyFrame := {
            defId := ctx.plan.defId
            blockIdx := f₁.blockIdx
            stmtIdx := off + 6
            locals := slots₂b
          }
          have hReach2 : ReachesNMemCopy ctx.pTgt (3 + 3)
              { frames := [f2AInit], mem := mem }
              { frames := [f2AMid], mem := mem } := by
            have hR := s3d_reachesN_trans hReach1 hD.2.2.2.1
            rw [Nat.add_assoc off 3 3] at hR
            exact hR
          have hWf2 := hD.2.2.2.2.1
          have hRel2 := hD.2.2.2.2.2.1
          have hPres0 := hD.2.2.2.2.2.2.2.2 0 (by decide) (by decide) (by decide)
          have hPres1 := hD.2.2.2.2.2.2.2.2 1 (by decide) (by decide) (by decide)
          have hTagS2 := hPres0.trans hTagS
          have hOffS2 := hPres1.trans hOffS
          have hTagD2 := hD.2.2.2.2.2.2.1
          have hOffD2 := hD.2.2.2.2.2.2.2.1
          have hExecAS := s3_exec_mkPtrAlignCheckStmts ctx (bbIdx := f₁.blockIdx) (bbTgt := bbTgt)
            (startIdx := off + 6) (slots₁ := slots₁b) (slots₂ := slots₂b) (mem := mem)
            optBufS 0 1 reqAlignLog2 tagS pvSrc.offsetBytes.toNat pvSrc
            hReqLe (by decide) (by decide) hS.2.2.1 (s3_u64_toNat_lt _) hS.2.1 rfl
            (by
              have hB := s3d_findPtrEntry_optBuf_forall ctx hFindS
              cases optBufS with
              | none => exact True.intro
              | some bLoc => exact hB bLoc rfl)
            hWf2 hRel2 hTagS2 hOffS2 hBbTgt hA1At
          cases hAS : checkPtrAlignMem mem pvSrc reqAlignLog2 with
          | error k =>
            rw [hAS] at hExecAS; dsimp
            cases hExecAS with | intro n hB =>
            cases hB with | intro sBad hBad =>
            rw [hf₂Eq]
            exact s3_fault_of_reachesN (s3d_reachesN_trans hReach2 hBad.1) hBad.2
          | ok u1 =>
            cases u1
            rw [hAS] at hExecAS; dsimp
            cases hExecAS with | intro slots₂c hC =>
            have hReach3 := s3d_reachesN_trans hReach2 hC.1
            have hRel3 := hC.2.1
            have hPresC0 := hC.2.2 0 (by decide) (by decide) (by decide)
            have hPresC1 := hC.2.2 1 (by decide) (by decide) (by decide)
            have hPresC2 := hC.2.2 2 (by decide) (by decide) (by decide)
            have hPresC3 := hC.2.2 3 (by decide) (by decide) (by decide)
            have hTagS3 := hPresC0.trans hTagS2
            have hOffS3 := hPresC1.trans hOffS2
            have hTagD3 := hPresC2.trans hTagD2
            have hOffD3 := hPresC3.trans hOffD2
            have hExecAD := s3_exec_mkPtrAlignCheckStmts ctx (bbIdx := f₁.blockIdx) (bbTgt := bbTgt)
              (startIdx := off + 6 + align1.length) (slots₁ := slots₁b) (slots₂ := slots₂c) (mem := mem)
              optBufD 2 3 reqAlignLog2 tagD pvDst.offsetBytes.toNat pvDst
              hReqLe (by decide) (by decide) hD.2.2.1 (s3_u64_toNat_lt _) hD.2.1 rfl
              (by
                have hB := s3d_findPtrEntry_optBuf_forall ctx hFindD
                cases optBufD with
                | none => exact True.intro
                | some bLoc => exact hB bLoc rfl)
              hWf2 hRel3 hTagD3 hOffD3 hBbTgt hA2At
            cases hAD : checkPtrAlignMem mem pvDst reqAlignLog2 with
            | error k =>
              rw [hAD] at hExecAD; dsimp
              cases hExecAD with | intro n hB =>
              cases hB with | intro sBad hBad =>
              rw [hf₂Eq]
              exact s3_fault_of_reachesN (s3d_reachesN_trans hReach3 hBad.1) hBad.2
            | ok u2 =>
              cases u2
              rw [hAD] at hExecAD; dsimp
              cases hExecAD with | intro slots₂d hD2 =>
              have hReach4 := s3d_reachesN_trans hReach3 hD2.1
              have hRel4 := hD2.2.1
              have hPresD0 := hD2.2.2 0 (by decide) (by decide) (by decide)
              have hPresD1 := hD2.2.2 1 (by decide) (by decide) (by decide)
              have hPresD2 := hD2.2.2 2 (by decide) (by decide) (by decide)
              have hPresD3 := hD2.2.2 3 (by decide) (by decide) (by decide)
              have hTagS4 := hPresD0.trans hTagS3
              have hOffS4 := hPresD1.trans hOffS3
              have hTagD4 := hPresD2.trans hTagD3
              have hOffD4 := hPresD3.trans hOffD3
              have hF2InitEq : f2AInit = f₂ := by dsimp [f2AInit]; rw [hf₂Eq]
              cases hNN : checkNonNullZero with
              | false =>
                dsimp
                have hLenFin : off + 6 + align1.length + align2.length = bbTgt.statements.length := by
                  have hNNNil : nonNullStmts = [] := by dsimp [nonNullStmts]; rw [hNN]; rfl
                  have hP : pair.1.length = 6 + align1.length + align2.length := by
                    rw [hPair1Eq, hNNNil, List.length_append, List.length_append, List.length_append]
                    change (6 + (align1.length + align2.length)) + 0 = _
                    rw [Nat.add_zero, Nat.add_assoc]
                  rw [Nat.add_assoc off 6 align1.length,
                    Nat.add_assoc off (6 + align1.length) align2.length, ← hP]
                  exact hOffLen
                let fBefore : MemCopyFrame := {
                  defId := ctx.plan.defId
                  blockIdx := f₁.blockIdx
                  stmtIdx := off + 6 + align1.length + align2.length
                  locals := slots₂d
                }
                let fAfter : MemCopyFrame := {
                  defId := f₂.defId
                  blockIdx := nextBb
                  stmtIdx := 0
                  locals := slots₂d
                }
                have hStepJump : evalStepMemCopy ctx.pTgt 0 { frames := [fBefore], mem := mem } =
                    .step { frames := [fAfter], mem := mem } := by
                  rw [s3_step_state_of_term ctx.pTgt fBefore mem ctx.bodyTgt bbTgt
                    (s3_bodyTgt_get ctx) hBbTgt hLenFin]
                  unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
                  unfold jumpMemCopyBlock
                  dsimp [fBefore, fAfter]; rw [hDef₂]
                have hReachFin := s3d_reachesN_trans hReach4 (s3_reachesN_one hStepJump)
                rw [hF2InitEq] at hReachFin
                exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbJump hReachFin rfl hWf2 hRel4
              | true =>
                have hNNTrue : nonNullStmts =
                    mkPtrNonNullCheckStmts scrTag1 scrOff1 scrTmpA scrTmpB ++
                    mkPtrNonNullCheckStmts scrTag2 scrOff2 scrTmpA scrTmpB := by
                  dsimp [nonNullStmts]; rw [hNN]; rfl
                let startNN := off + 6 + align1.length + align2.length
                have hPreAlignLen : (readBoth ++ (align1 ++ align2)).length =
                    6 + align1.length + align2.length := by
                  rw [List.length_append, List.length_append]
                  change 6 + (align1.length + align2.length) = _
                  rw [Nat.add_assoc]
                have hNNAt : ∀ k : Nat, k < 4 →
                    Trusted.MirSemantics.getElem? bbTgt.statements (startNN + k) =
                      Trusted.MirSemantics.getElem? nonNullStmts k := by
                  intro k hk
                  have hk' : k < nonNullStmts.length := by rw [hNNTrue]; exact hk
                  have hR := s3d_stmt_right_at bbTgt off (readBoth ++ (align1 ++ align2)) nonNullStmts
                    hPreStmts' k hk'
                  rw [hPreAlignLen, ← Nat.add_assoc, ← Nat.add_assoc] at hR
                  exact hR
                have hNNS0 : Trusted.MirSemantics.getElem? bbTgt.statements startNN =
                    some (mkBinOpStmt (s3_scrBase ctx + 6) .bitOr
                      (.copy { localId := s3_scrBase ctx + 0 })
                      (.copy { localId := s3_scrBase ctx + 1 })) := by
                  have h0 := hNNAt 0 (by decide)
                  rw [Nat.add_zero] at h0
                  rw [hNNTrue] at h0
                  exact h0
                have hNNS1 : Trusted.MirSemantics.getElem? bbTgt.statements (startNN + 1) =
                    some (mkSubUncheckedUsize (s3_scrBase ctx + 5)
                      (.move { localId := s3_scrBase ctx + 6 }) (usizeConst 1)) := by
                  have h1 := hNNAt 1 (by decide)
                  rw [hNNTrue] at h1
                  exact h1
                have hNND0 : Trusted.MirSemantics.getElem? bbTgt.statements (startNN + 2) =
                    some (mkBinOpStmt (s3_scrBase ctx + 6) .bitOr
                      (.copy { localId := s3_scrBase ctx + 2 })
                      (.copy { localId := s3_scrBase ctx + 3 })) := by
                  have h2 := hNNAt 2 (by decide)
                  rw [hNNTrue] at h2
                  exact h2
                have hNND1 : Trusted.MirSemantics.getElem? bbTgt.statements ((startNN + 2) + 1) =
                    some (mkSubUncheckedUsize (s3_scrBase ctx + 5)
                      (.move { localId := s3_scrBase ctx + 6 }) (usizeConst 1)) := by
                  have h3 := hNNAt 3 (by decide)
                  rw [Nat.add_assoc]; rw [hNNTrue] at h3
                  exact h3
                have hExecNNS := s3_exec_mkPtrNonNullCheckStmts ctx (bbIdx := f₁.blockIdx)
                  (bbTgt := bbTgt) (startIdx := startNN) (slots₁ := slots₁b) (slots₂ := slots₂d)
                  (mem := mem) optBufS 0 1 tagS pvSrc.offsetBytes.toNat pvSrc
                  (by decide) (by decide) hS.2.2.1 (s3_u64_toNat_lt _) hS.2.1 rfl
                  hRel4 hTagS4 hOffS4 hBbTgt hNNS0 hNNS1
                cases hNullS : isNullPtr pvSrc with
                | true =>
                  rw [hNullS] at hExecNNS; dsimp
                  cases hExecNNS with | intro sBad hBad =>
                  rw [hf₂Eq]
                  exact s3_fault_of_reachesN (s3d_reachesN_trans hReach4 hBad.1) hBad.2
                | false =>
                  rw [hNullS] at hExecNNS
                  cases hExecNNS with | intro slots₂e hE =>
                  have hReach5 := s3d_reachesN_trans hReach4 hE.1
                  have hRel5 := hE.2.1
                  have hTagD5 := (hE.2.2 2 (by decide) (by decide) (by decide)).trans hTagD4
                  have hOffD5 := (hE.2.2 3 (by decide) (by decide) (by decide)).trans hOffD4
                  have hExecNND := s3_exec_mkPtrNonNullCheckStmts ctx (bbIdx := f₁.blockIdx)
                    (bbTgt := bbTgt) (startIdx := startNN + 2) (slots₁ := slots₁b) (slots₂ := slots₂e)
                    (mem := mem) optBufD 2 3 tagD pvDst.offsetBytes.toNat pvDst
                    (by decide) (by decide) hD.2.2.1 (s3_u64_toNat_lt _) hD.2.1 rfl
                    hRel5 hTagD5 hOffD5 hBbTgt hNND0 hNND1
                  cases hNullD : isNullPtr pvDst with
                  | true =>
                    rw [hNullD] at hExecNND
                    cases hExecNND with | intro sBad hBad =>
                    rw [hf₂Eq]
                    exact s3_fault_of_reachesN (s3d_reachesN_trans hReach5 hBad.1) hBad.2
                  | false =>
                    rw [hNullD] at hExecNND; dsimp
                    cases hExecNND with | intro slots₂f hF2 =>
                    have hReach6 := s3d_reachesN_trans hReach5 hF2.1
                    have hRel6 := hF2.2.1
                    have hLenFin : (startNN + 2) + 2 = bbTgt.statements.length := by
                      have hP : pair.1.length = 6 + align1.length + align2.length + 4 := by
                        rw [hPair1Eq, hNNTrue, List.length_append, hPreAlignLen]; rfl
                      rw [Nat.add_assoc startNN 2 2]
                      dsimp [startNN]
                      rw [Nat.add_assoc off 6 align1.length,
                        Nat.add_assoc off (6 + align1.length) align2.length,
                        Nat.add_assoc off (6 + align1.length + align2.length) 4, ← hP]
                      exact hOffLen
                    let fBefore : MemCopyFrame := {
                      defId := ctx.plan.defId
                      blockIdx := f₁.blockIdx
                      stmtIdx := (startNN + 2) + 2
                      locals := slots₂f
                    }
                    let fAfter : MemCopyFrame := {
                      defId := f₂.defId
                      blockIdx := nextBb
                      stmtIdx := 0
                      locals := slots₂f
                    }
                    have hStepJump : evalStepMemCopy ctx.pTgt 0 { frames := [fBefore], mem := mem } =
                        .step { frames := [fAfter], mem := mem } := by
                      rw [s3_step_state_of_term ctx.pTgt fBefore mem ctx.bodyTgt bbTgt
                        (s3_bodyTgt_get ctx) hBbTgt hLenFin]
                      unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
                      unfold jumpMemCopyBlock
                      dsimp [fBefore, fAfter]; rw [hDef₂]
                    have hReachFin := s3d_reachesN_trans hReach6 (s3_reachesN_one hStepJump)
                    rw [hF2InitEq] at hReachFin
                    exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbJump hReachFin rfl hWf2 hRel6

private theorem s3d_checkPtrPairAlign_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (srcPtr dstPtr : LocalId) (elemSize reqAlignLog2 : Nat)
    (checkNonNullZero : Bool) (nextBb : BasicBlockId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator =
      .checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hRun := s3d_checkPtrPairAlign_run ctx srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero
    nextBb hEqId hDef₁ hDef₂ hBbRel hBbSrc hTerm hEnd₁ hIdxEq hWf hRel
  apply s3d_fwdStepSim_of_term_multi ctx hDef₁ hBbSrc hEnd₁
  · intro s₁' hStep; rw [hStep] at hRun; exact hRun
  · intro out hDone; rw [hDone] at hRun; exact False.elim hRun
  · intro k hFault; rw [hFault] at hRun; exact hRun

/-! ## Section 4: `.ptrOffsetInbounds` Simulation -/

private theorem s3d_ptrTagMatches_compat {bDst bSrc : Option LocalId} {pv : PtrVal}
    {tagVal : Nat} (hCompat : checkPtrCopyCompat bDst bSrc = true)
    (hMatch : s3_PtrTagMatches bSrc pv tagVal) :
    s3_PtrTagMatches bDst pv tagVal := by
  unfold checkPtrCopyCompat at hCompat
  cases bSrc with
  | none =>
    unfold s3_PtrTagMatches at hMatch
    cases bDst with
    | none => exact hMatch
    | some _ => exact Or.inl hMatch
  | some bufS =>
    have hEq := optNatEq_eq _ _ hCompat
    rw [hEq]
    exact hMatch

private theorem s3d_scr_usize_decl (ctx : s3_PtrCtx) (j : Nat) (hj : j < 10) :
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals (s3_scrBase ctx + j) = some (.base usizeTy) := by
  have hS := s3_bodyTgt_locals_scratch ctx j (Nat.lt_trans hj (by decide))
  rw [(nat_blt_eq_lt _ _).mpr hj] at hS
  exact hS

private theorem s3d_eval_mkImmediateUbStmt_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId}
    {bbTgt : MemCopyBlock} {idx : Nat} {slots₂ : List MemCopySlot} {mem : CallerMemory}
    (j : Nat) (hj : j < 10)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkImmediateUbStmt (s3_scrBase ctx + j))) :
    evalStepMemCopy ctx.pTgt 0
        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
          mem := mem } = .fault .undefined := by
  rw [s3_step_state_of_stmt ctx.pTgt _ mem ctx.bodyTgt bbTgt _ (s3_bodyTgt_get ctx) hBbTgt hStmt]
  exact s3_eval_mkImmediateUbStmt ctx.bodyTgt _ mem (s3_scrBase ctx + j) (s3d_scr_usize_decl ctx j hj)

private theorem s3d_memWf_buf_alloc (ctx : s3_PtrCtx) {slots₁ : List MemCopySlot}
    {mem : CallerMemory} {bufLoc sz al : Nat} {mutab : Mutability}
    (hBD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc = some (.byteBuf sz al mutab))
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem) :
    ∃ live : Bool, ∃ alloc : Allocation,
      Trusted.MirSemantics.getElem? slots₁ bufLoc = some (.bufSlot live) ∧
      findAlloc? (internalAllocBase + bufLoc) mem.allocations = some alloc ∧
      alloc.live = live ∧
      (live = true → alloc.bytes.length = sz) := by
  cases hWf.2.1 bufLoc sz al mutab hBD with | intro live hB =>
  cases hB with | intro alloc hA =>
  exact ⟨live, alloc, hA.1, hA.2.1, hA.2.2.1, hA.2.2.2.2.2.1⟩

private theorem s3d_exec_bufLivenessCheck (ctx : s3_PtrCtx) {bbIdx : BasicBlockId}
    {bbTgt : MemCopyBlock} {idx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (bufLoc sz al : Nat) (mutab : Mutability) (live : Bool)
    (hBD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc = some (.byteBuf sz al mutab))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hSl : Trusted.MirSemantics.getElem? slots₁ bufLoc = some (.bufSlot live))
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx = some (.bufLivenessCheck bufLoc)) :
    (live = true →
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
            mem := mem } =
        .step
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂ }],
            mem := mem }) ∧
    (live = false →
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
            mem := mem } =
        .fault .undefined) := by
  have hBDTgt := s3_bodyTgt_locals_base ctx bufLoc (s3_getElem?_some_lt _ _ _ hBD)
  rw [hBD] at hBDTgt
  have hSlTgt := (hRel.2.2.2.1 bufLoc sz al mutab hBD).trans hSl
  refine ⟨fun hT => ?_, fun hF => ?_⟩
  · rw [s3_step_state_of_stmt ctx.pTgt _ mem ctx.bodyTgt bbTgt _ (s3_bodyTgt_get ctx) hBbTgt hStmt]
    unfold evalMemCopyStmt; dsimp
    rw [hBDTgt, hSlTgt, hT]; rfl
  · rw [s3_step_state_of_stmt ctx.pTgt _ mem ctx.bodyTgt bbTgt _ (s3_bodyTgt_get ctx) hBbTgt hStmt]
    unfold evalMemCopyStmt; dsimp
    rw [hBDTgt, hSlTgt, hF]

private theorem s3d_exec_subUnchecked_const_copy_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId}
    {bbTgt : MemCopyBlock} {idx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (jDst jRhs a b : Nat)
    (hjDst : jDst < 10) (hjRhs : jRhs < 10) (ha : a < maxUsize) (hb : b < maxUsize)
    (hSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jRhs) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b })))))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkSubUncheckedUsize (s3_scrBase ctx + jDst) (usizeConst a)
        (.copy { localId := s3_scrBase ctx + jRhs, projection := [] }))) :
    (b ≤ a →
      ∃ slots₂' : List MemCopySlot,
        evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
              mem := mem } =
          .step
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }],
              mem := mem } ∧
        s3_SlotsRel ctx slots₁ slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a - b) })))) ∧
        ∀ j' : Nat, j' < 12 → j' ≠ jDst →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) ∧
    (a < b →
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
            mem := mem } = .fault .undefined) :=
  s3_exec_mkSubUncheckedUsize_scr ctx jDst (usizeConst a)
    (.copy { localId := s3_scrBase ctx + jRhs, projection := [] }) a b
    hjDst ha hb
    (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals slots₂ a ha)
    (s3_evalPrimOp_scr_copy ctx slots₂ jRhs b hjRhs hSlot)
    hRel hBbTgt hStmt

private theorem s3d_exec_subUnchecked_move_const_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId}
    {bbTgt : MemCopyBlock} {idx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (jDst a b : Nat)
    (hjDst : jDst < 10) (ha : a < maxUsize) (hb : b < maxUsize)
    (hSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jDst) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })))))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkSubUncheckedUsize (s3_scrBase ctx + jDst)
        (.move { localId := s3_scrBase ctx + jDst, projection := [] }) (usizeConst b))) :
    (b ≤ a →
      ∃ slots₂' : List MemCopySlot,
        evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
              mem := mem } =
          .step
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }],
              mem := mem } ∧
        s3_SlotsRel ctx slots₁ slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a - b) })))) ∧
        ∀ j' : Nat, j' < 12 → j' ≠ jDst →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) ∧
    (a < b →
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
            mem := mem } = .fault .undefined) := by
  have hj12 : jDst < 12 := Nat.lt_trans hjDst (by decide)
  have hLen : s3_scrBase ctx + jDst < slots₂.length := by
    rw [hRel.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jDst hj12
  cases s3_evalPrimOp_scr_move ctx slots₂ jDst a hjDst hLen hSlot with | intro slotsA hA =>
  have hRelA := s3_slotsRel_set_scratch ctx slots₁ slots₂ slotsA jDst none hj12 hRel hA.1
  have hExec := s3_exec_mkSubUncheckedUsize_scr ctx (mem := mem) jDst
    (.move { localId := s3_scrBase ctx + jDst, projection := [] }) (usizeConst b) a b
    hjDst ha hb hA.2 (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals slotsA b hb) hRelA hBbTgt hStmt
  refine ⟨fun hLe => ?_, hExec.2⟩
  cases hExec.1 hLe with | intro slots₂' hOut =>
  refine ⟨slots₂', hOut.1, hOut.2.1, hOut.2.2.1, fun j' hj' hNe => ?_⟩
  rw [hOut.2.2.2 j' hj' hNe]
  have hNeLoc : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + j' :=
    fun h => hNe (Nat.add_left_cancel h).symm
  exact s3_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hA.1

private theorem s3d_exec_addUnchecked_move_const_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId}
    {bbTgt : MemCopyBlock} {idx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (jDst a b : Nat)
    (hjDst : jDst < 10) (hSum : a + b < maxUsize)
    (hSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jDst) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })))))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkAddUncheckedUsize (s3_scrBase ctx + jDst)
        (.move { localId := s3_scrBase ctx + jDst, projection := [] }) (usizeConst b))) :
    ∃ slots₂' : List MemCopySlot,
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
            mem := mem } =
        .step
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }],
            mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a + b) })))) ∧
      ∀ j' : Nat, j' < 12 → j' ≠ jDst →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') := by
  have hj12 : jDst < 12 := Nat.lt_trans hjDst (by decide)
  have hLen : s3_scrBase ctx + jDst < slots₂.length := by
    rw [hRel.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jDst hj12
  have hb : b < maxUsize := Nat.lt_of_le_of_lt (Nat.le_add_left _ _) hSum
  cases s3_evalPrimOp_scr_move ctx slots₂ jDst a hjDst hLen hSlot with | intro slotsA hA =>
  have hRelA := s3_slotsRel_set_scratch ctx slots₁ slots₂ slotsA jDst none hj12 hRel hA.1
  have hExec := s3_exec_mkAddUncheckedUsize_scr ctx (mem := mem) jDst
    (.move { localId := s3_scrBase ctx + jDst, projection := [] }) (usizeConst b) a b
    hjDst hSum hA.2 (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals slotsA b hb) hRelA hBbTgt hStmt
  cases hExec with | intro slots₂' hOut =>
  refine ⟨slots₂', hOut.1, hOut.2.1, hOut.2.2.1, fun j' hj' hNe => ?_⟩
  rw [hOut.2.2.2 j' hj' hNe]
  have hNeLoc : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + j' :=
    fun h => hNe (Nat.add_left_cancel h).symm
  exact s3_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hA.1

private theorem s3d_exec_addUnchecked_move_move_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId}
    {bbTgt : MemCopyBlock} {idx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (jDst jRhs a b : Nat)
    (hjDst : jDst < 10) (hjRhs : jRhs < 10) (hjNe : jDst ≠ jRhs) (hSum : a + b < maxUsize)
    (hSlotL : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jDst) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })))))
    (hSlotR : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jRhs) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b })))))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkAddUncheckedUsize (s3_scrBase ctx + jDst)
        (.move { localId := s3_scrBase ctx + jDst, projection := [] })
        (.move { localId := s3_scrBase ctx + jRhs, projection := [] }))) :
    ∃ slots₂' : List MemCopySlot,
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
            mem := mem } =
        .step
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }],
            mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a + b) })))) ∧
      ∀ j' : Nat, j' < 12 → j' ≠ jDst → j' ≠ jRhs →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') := by
  have hjDst12 : jDst < 12 := Nat.lt_trans hjDst (by decide)
  have hjRhs12 : jRhs < 12 := Nat.lt_trans hjRhs (by decide)
  have hLenL : s3_scrBase ctx + jDst < slots₂.length := by
    rw [hRel.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jDst hjDst12
  cases s3_evalPrimOp_scr_move ctx slots₂ jDst a hjDst hLenL hSlotL with | intro slotsA hA =>
  have hRelA := s3_slotsRel_set_scratch ctx slots₁ slots₂ slotsA jDst none hjDst12 hRel hA.1
  have hLenR : s3_scrBase ctx + jRhs < slotsA.length := by
    rw [hRelA.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jRhs hjRhs12
  have hNeLR : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + jRhs :=
    fun h => hjNe (Nat.add_left_cancel h)
  have hSlotRA : Trusted.MirSemantics.getElem? slotsA (s3_scrBase ctx + jRhs) = _ :=
    (s3_getElem?_setElem?_ne _ _ _ _ _ hNeLR hA.1).trans hSlotR
  cases s3_evalPrimOp_scr_move ctx slotsA jRhs b hjRhs hLenR hSlotRA with | intro slotsB hB =>
  have hRelB := s3_slotsRel_set_scratch ctx slots₁ slotsA slotsB jRhs none hjRhs12 hRelA hB.1
  have hExec := s3_exec_mkAddUncheckedUsize_scr ctx (mem := mem) jDst
    (.move { localId := s3_scrBase ctx + jDst, projection := [] })
    (.move { localId := s3_scrBase ctx + jRhs, projection := [] }) a b
    hjDst hSum hA.2 hB.2 hRelB hBbTgt hStmt
  cases hExec with | intro slots₂' hOut =>
  refine ⟨slots₂', hOut.1, hOut.2.1, hOut.2.2.1, fun j' hj' hNeD hNeR => ?_⟩
  rw [hOut.2.2.2 j' hj' hNeD]
  have hNe1 : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + j' := fun h => hNeD (Nat.add_left_cancel h).symm
  have hNe2 : s3_scrBase ctx + jRhs ≠ s3_scrBase ctx + j' := fun h => hNeR (Nat.add_left_cancel h).symm
  exact (s3_getElem?_setElem?_ne _ _ _ _ _ hNe2 hB.1).trans (s3_getElem?_setElem?_ne _ _ _ _ _ hNe1 hA.1)

private theorem s3d_exec_mul_move_const_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId}
    {bbTgt : MemCopyBlock} {idx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (jDst jSrc a b : Nat)
    (hjDst : jDst < 10) (hjSrc : jSrc < 10) (_hjNe : jDst ≠ jSrc)
    (ha : a < maxUsize) (hb : b < maxUsize) (hProd : a * b < maxUsize)
    (hSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jSrc) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })))))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkBinOpStmt (s3_scrBase ctx + jDst) .mul
        (.move { localId := s3_scrBase ctx + jSrc, projection := [] }) (usizeConst b))) :
    ∃ slots₂' : List MemCopySlot,
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }],
            mem := mem } =
        .step
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }],
            mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a * b) })))) ∧
      ∀ j' : Nat, j' < 12 → j' ≠ jDst → j' ≠ jSrc →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') := by
  have hjSrc12 : jSrc < 12 := Nat.lt_trans hjSrc (by decide)
  have hLen : s3_scrBase ctx + jSrc < slots₂.length := by
    rw [hRel.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jSrc hjSrc12
  cases s3_evalPrimOp_scr_move ctx slots₂ jSrc a hjSrc hLen hSlot with | intro slotsA hA =>
  have hRelA := s3_slotsRel_set_scratch ctx slots₁ slots₂ slotsA jSrc none hjSrc12 hRel hA.1
  have hBin := s3_evalBinOp_usize_mul a b ha hb
  have hMod : Nat.mod (a * b) maxUsize = a * b := Nat.mod_eq_of_lt hProd
  rw [hMod] at hBin
  have hExec := s3_exec_mkBinOpStmt_usize_scr ctx (mem := mem) jDst .mul
    (.move { localId := s3_scrBase ctx + jSrc, projection := [] }) (usizeConst b)
    (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
    (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b })
    (a * b) hjDst hProd hA.2 (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals slotsA b hb) hBin
    hRelA hBbTgt hStmt
  cases hExec with | intro slots₂' hOut =>
  refine ⟨slots₂', hOut.1, hOut.2.1, hOut.2.2.1, fun j' hj' hNeD hNeS => ?_⟩
  rw [hOut.2.2.2 j' hj' hNeD]
  have hNe : s3_scrBase ctx + jSrc ≠ s3_scrBase ctx + j' := fun h => hNeS (Nat.add_left_cancel h).symm
  exact s3_getElem?_setElem?_ne _ _ _ _ _ hNe hA.1

private theorem s3d_evalSwitchBranches_zero_ok (zeroBb otherBb : BasicBlockId) :
    evalSwitchBranches .isize (BitVec.ofNat 128 0) otherBb [(BitVec.ofNat 128 0, zeroBb)] = .ok zeroBb :=
  rfl

private theorem s3d_evalSwitchBranches_zero_nz (n : Nat) (hn0 : 0 < n) (hnMax : n < maxUsize)
    (zeroBb otherBb : BasicBlockId) :
    evalSwitchBranches .isize (BitVec.ofNat 128 n) otherBb [(BitVec.ofNat 128 0, zeroBb)] = .ok otherBb := by
  change (if (truncateBits .isize (BitVec.ofNat 128 0) != BitVec.ofNat 128 0) = true then .error .unsupported
    else if (truncateBits .isize (BitVec.ofNat 128 n) == truncateBits .isize (BitVec.ofNat 128 0)) = true then .ok zeroBb
    else evalSwitchBranches .isize (BitVec.ofNat 128 n) otherBb []) = .ok otherBb
  have h0 : (truncateBits .isize (BitVec.ofNat 128 0) != BitVec.ofNat 128 0) = false := by decide
  have h1 : truncateBits .isize (BitVec.ofNat 128 0) = BitVec.ofNat 128 0 := by decide
  rw [h0, h1]; dsimp
  have h128 : n < Nat.pow 2 128 := Nat.lt_trans hnMax s3_pow2_128_eq
  have hTr : truncateBits .isize (BitVec.ofNat 128 n) = BitVec.ofNat 128 n := by
    rw [s3_truncateBits_isize n h128, show Nat.mod n maxUsize = n from Nat.mod_eq_of_lt hnMax]
  rw [hTr]
  have hNeZero : (BitVec.ofNat 128 n == BitVec.ofNat 128 0) = false := by
    cases hBeq : (BitVec.ofNat 128 n == BitVec.ofNat 128 0) with
    | false => rfl
    | true =>
      have hEq : BitVec.ofNat 128 n = BitVec.ofNat 128 0 := by
        cases hD : (BitVec.ofNat 128 n == BitVec.ofNat 128 0) with
        | true => exact LawfulBEq.eq_of_beq hD
        | false => rw [hBeq] at hD; cases hD
      have hV := congrArg BitVec.toNat hEq
      rw [s3_bitvec_toNat_ofNat_lt n h128] at hV
      exact False.elim (Nat.ne_of_gt hn0 hV)
  rw [hNeZero]; rfl

private theorem s3d_exec_writeDst_and_goto (ctx : s3_PtrCtx) {bbIdx : BasicBlockId}
    {bbTgt : MemCopyBlock} {startIdx : Nat} {f₁ f₂Init : MemCopyFrame}
    {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory} {nPre : Nat}
    (dPtr : LocalId) (kD tagVal offVal : Nat) (optBufD : Option LocalId) (pv' : PtrVal)
    (nextBb : BasicBlockId) {bbJump : MemCopyBlock}
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂Init.defId = ctx.plan.defId)
    (hFindD : findPtrEntry ctx.plan.entries dPtr = some (kD, optBufD))
    (ht : tagVal < maxUsize) (ho : offVal < maxUsize)
    (hWidth : pv'.width = .isize) (hMatch : s3_PtrTagMatches optBufD pv' tagVal)
    (hOffEq : pv'.offsetBytes.toNat = offVal)
    (hTagSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 0) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))))
    (hOffSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 1) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))))
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hReachPre : ReachesNMemCopy ctx.pTgt nPre { frames := [f₂Init], mem := mem }
      { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }],
        mem := mem })
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hWD0 : Trusted.MirSemantics.getElem? bbTgt.statements startIdx =
      some (mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kD)))
    (hWD1 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 1) =
      some (mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 1) (.move { localId := s3_scrBase ctx + 0, projection := [] })))
    (hWD2 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 2) =
      some (mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 2) (.move { localId := s3_scrBase ctx + 1, projection := [] })))
    (hEnd : startIdx + 3 = bbTgt.statements.length)
    (hTermTgt : bbTgt.terminator = .baseTerm (.goto nextBb))
    (hBbJump : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks nextBb = some bbJump) :
    match (match writePtrLocal ctx.bodySrc.locals slots₁ dPtr pv' with
      | .error k => StepResult.fault k
      | .ok slots₁' => jumpMemCopyBlock f₁ mem slots₁' nextBb) with
    | .step s₁' =>
      ∃ s₂' : MemCopyState,
        ReachesPlusMemCopy ctx.pTgt { frames := [f₂Init], mem := mem } s₂' ∧
        s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂'
    | .done _ => False
    | .fault k =>
      ∃ s₂' : MemCopyState,
        ReachesMemCopy ctx.pTgt { frames := [f₂Init], mem := mem } s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.fault k) := by
  have hExecW := s3_exec_writePtr_from_scr ctx (bbIdx := bbIdx) (bbTgt := bbTgt)
    (startIdx := startIdx) (slots₁ := slots₁) (slots₂ := slots₂) (mem := mem)
    dPtr kD 0 1 optBufD tagVal offVal pv'
    hFindD (by decide) (by decide) (by decide) ht ho hWidth hMatch hOffEq
    hTagSlot hOffSlot hWf hRel hBbTgt hWD0 hWD1 hWD2
  cases hWr : writePtrLocal ctx.bodySrc.locals slots₁ dPtr pv' with
  | error k =>
    rw [hWr] at hExecW; dsimp
    exact s3_fault_of_reachesN hReachPre hExecW
  | ok slots₁' =>
    rw [hWr] at hExecW; dsimp
    unfold jumpMemCopyBlock; dsimp
    cases hExecW with | intro slots₂' hW =>
    have hReachW := s3d_reachesN_trans hReachPre hW.1
    let fBefore : MemCopyFrame := {
      defId := ctx.plan.defId
      blockIdx := bbIdx
      stmtIdx := startIdx + 3
      locals := slots₂'
    }
    let fAfter : MemCopyFrame := {
      defId := f₂Init.defId
      blockIdx := nextBb
      stmtIdx := 0
      locals := slots₂'
    }
    have hStepJump : evalStepMemCopy ctx.pTgt 0 { frames := [fBefore], mem := mem } =
        .step { frames := [fAfter], mem := mem } := by
      rw [s3_step_state_of_term ctx.pTgt fBefore mem ctx.bodyTgt bbTgt
        (s3_bodyTgt_get ctx) hBbTgt hEnd]
      unfold evalMemCopyTerm; dsimp; rw [hTermTgt]; dsimp
      unfold jumpMemCopyBlock
      dsimp [fBefore, fAfter]; rw [hDef₂]
    have hReachFin := s3d_reachesN_trans hReachW (s3_reachesN_one hStepJump)
    exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbJump hReachFin rfl hW.2.1 hW.2.2

private theorem s3d_ite_true_cond {α : Type} {c : Bool} (hc : c = true) (t e : α) :
    (if c = true then t else e) = t := by
  rw [hc]; rfl

private theorem s3d_ite_false_cond {α : Type} {c : Bool} (hc : c = false) (t e : α) :
    (if c = true then t else e) = e := by
  rw [hc]; rfl

private theorem s3d_calcInbounds_fault_range (mem : CallerMemory) (pv : PtrVal) (z : Int) (elemSize : Nat)
    (h : (decide (z * (elemSize : Int) < minIsize) ||
        decide ((maxIsize : Int) < z * (elemSize : Int))) = true) :
    calcInboundsOffset mem pv z elemSize = .error .undefined := by
  unfold calcInboundsOffset; dsimp
  rw [s3d_ite_true_cond h]

private theorem s3d_calcInbounds_zero (mem : CallerMemory) (pv : PtrVal) (z : Int) (elemSize : Nat)
    (hRng : (decide (z * (elemSize : Int) < minIsize) ||
        decide ((maxIsize : Int) < z * (elemSize : Int))) = false)
    (hZero : (z * (elemSize : Int) == 0) = true) :
    calcInboundsOffset mem pv z elemSize = .ok { allocId := pv.allocId, offsetBytes := pv.offsetBytes } := by
  unfold calcInboundsOffset; dsimp
  rw [s3d_ite_false_cond hRng, s3d_ite_true_cond hZero]

private theorem s3d_calcInbounds_zero_of_eq (mem : CallerMemory) (pv : PtrVal) (z : Int) (elemSize : Nat)
    (hd : z * (elemSize : Int) = 0) :
    calcInboundsOffset mem pv z elemSize = .ok { allocId := pv.allocId, offsetBytes := pv.offsetBytes } := by
  have hRng : (decide (z * (elemSize : Int) < minIsize) ||
      decide ((maxIsize : Int) < z * (elemSize : Int))) = false := by
    rw [hd]; decide
  have hZero : (z * (elemSize : Int) == 0) = true := by
    rw [hd]; decide
  exact s3d_calcInbounds_zero mem pv z elemSize hRng hZero

private theorem s3d_calcInbounds_body (mem : CallerMemory) (pv : PtrVal) (z : Int) (elemSize : Nat)
    (hRng : (decide (z * (elemSize : Int) < minIsize) ||
        decide ((maxIsize : Int) < z * (elemSize : Int))) = false)
    (hZero : (z * (elemSize : Int) == 0) = false) :
    calcInboundsOffset mem pv z elemSize =
      match pv.allocId with
      | none => .error .undefined
      | some aid =>
        match findAlloc? aid mem.allocations with
        | none => .error .undefined
        | some alloc =>
          if (!alloc.live) = true then .error .undefined
          else
            let off := Int.ofNat pv.offsetBytes.toNat
            let len := Int.ofNat alloc.bytes.length
            let newOff := off + z * (elemSize : Int)
            if (decide (0 ≤ off) && decide (off ≤ len) &&
                decide (0 ≤ newOff) && decide (newOff ≤ len)) = true then
              .ok { allocId := pv.allocId, offsetBytes := UInt64.ofNat newOff.toNat }
            else .error .undefined := by
  unfold calcInboundsOffset; dsimp
  rw [s3d_ite_false_cond hRng, s3d_ite_false_cond hZero]

private theorem s3d_bool_or_false_unpack {a b : Bool} (h : (a || b) = false) :
    a = false ∧ b = false := by
  cases a with
  | true => cases h
  | false => cases b with | true => cases h | false => exact ⟨rfl, rfl⟩

private theorem s3d_int_nonneg_of_sub_zero (a b : Nat)
    (h : (0 : Int) ≤ Int.ofNat a + Neg.neg (Int.ofNat b)) : b ≤ a := by
  have h1 : (0 : Int) + Int.ofNat b ≤ (Int.ofNat a - Int.ofNat b) + Int.ofNat b :=
    s0_int_add_le_add_right h (Int.ofNat b)
  rw [s0_int_zero_add, s0_int_sub_add_cancel] at h1
  exact s0_int_ofNat_le_mp h1

private theorem s3d_ptrOffsetInbounds_const_run (ctx : s3_PtrCtx)
    {bbSrc bbTgt bbJump : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    {extraBase off kD kS : Nat}
    (dstPtr srcPtr : LocalId) (countOp : Operand) (elemSize : Nat) (nextBb : BasicBlockId)
    (z : Int) (optBufD optBufS : Option LocalId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hTerm : bbSrc.terminator = .ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb)
    (hConst : constIsizeValue? countOp = some z)
    (hFindD : findPtrEntry ctx.plan.entries dstPtr = some (kD, optBufD))
    (hFindS : findPtrEntry ctx.plan.entries srcPtr = some (kS, optBufS))
    (hCompat : checkPtrCopyCompat optBufD optBufS = true)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₁.blockIdx = some bbTgt)
    (hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off, locals := f₂.locals })
    (hOffLen : off + (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
        ctx.bodySrc.locals.length extraBase bbSrc.terminator).1.length = bbTgt.statements.length)
    (hTermTgt : bbTgt.terminator = (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
        ctx.bodySrc.locals.length extraBase bbSrc.terminator).2.1)
    (hPreStmts : ∀ j : Nat,
        j < (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
          ctx.bodySrc.locals.length extraBase bbSrc.terminator).1.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
          Trusted.MirSemantics.getElem? (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
            ctx.bodySrc.locals.length extraBase bbSrc.terminator).1 j)
    (hBbJump : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks nextBb = some bbJump) :
    match evalMemCopyTerm ctx.bodySrc bbSrc f₁ mem with
    | .step s₁' =>
      ∃ s₂' : MemCopyState,
        ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
        s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂'
    | .done _ => False
    | .fault k =>
      ∃ s₂' : MemCopyState,
        ReachesMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.fault k) := by
  let scrTag1 := s3_scrBase ctx
  let scrOff1 := s3_scrBase ctx + 1
  let scrTmpA := s3_scrBase ctx + 5
  let offD := ctx.bodySrc.locals.length + 3 * kD
  let offS := ctx.bodySrc.locals.length + 3 * kS
  let readSrc : List MemCopyStmt := [
    mkLivenessCheckStmt offS,
    mkAssignUse scrTag1 (.copy { localId := offS + 1, projection := [] }),
    mkAssignUse scrOff1 (.copy { localId := offS + 2, projection := [] })
  ]
  let writeDst : List MemCopyStmt := [
    mkLivenessCheckStmt offD,
    mkAssignUse (offD + 1) (.move { localId := scrTag1, projection := [] }),
    mkAssignUse (offD + 2) (.move { localId := scrOff1, projection := [] })
  ]
  have hRSLen : readSrc.length = 3 := rfl
  have hWDLen : writeDst.length = 3 := rfl
  let delta := z * (elemSize : Int)
  have hEvalCnt := s3_evalOffsetCountOp_const_ok ctx.bodySrc.locals f₁.locals countOp z hConst
