                              unfold evalStepMemCopy
                              rw [hFr]
                              dsimp [p']
                              rw [hDef, getElem?_setElem?_eq _ _ _ _ hSetB]
                              dsimp
                              rw [hBlk, getElem?_setElem?_eq _ _ _ _ hSetBb]
                              dsimp
                              rw [hSt, getElem?_append_eq_length bb.statements (MemCopyStmt.copyPtr dstPtr srcPtr false)]
