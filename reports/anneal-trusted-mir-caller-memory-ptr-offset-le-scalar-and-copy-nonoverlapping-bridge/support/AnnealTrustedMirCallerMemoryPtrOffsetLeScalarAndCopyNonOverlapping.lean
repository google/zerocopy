/-! ## Section 5: `copyNonOverlapping` Terminator Simulation (`s3x_copyNonOverlapping_sim`) -/

private theorem s3x_pow2_pos : ∀ k : Nat, 0 < Nat.pow 2 k
  | 0 => Nat.zero_lt_one
  | k + 1 => Nat.mul_pos (s3x_pow2_pos k) (by decide : 0 < 2)

private theorem s3x_maxIsize_lt_maxUsize : maxIsize < maxUsize := by
  have hPos : 0 < Nat.pow 2 63 := s3x_pow2_pos 63
  have hSub : Nat.pow 2 63 - 1 < Nat.pow 2 63 := Nat.sub_lt hPos Nat.zero_lt_one
  have hMul : Nat.pow 2 63 < Nat.pow 2 63 * 2 := by
    have h1 : Nat.pow 2 63 * 2 = Nat.pow 2 63 + Nat.pow 2 63 := Nat.mul_two (Nat.pow 2 63)
    rw [h1]
    exact Nat.lt_add_of_pos_right hPos
  have hPow64 : Nat.pow 2 64 = Nat.pow 2 63 * 2 := Nat.pow_succ 2 63
  change Nat.pow 2 63 - 1 < Nat.pow 2 64
  rw [hPow64]
  exact Nat.lt_trans hSub hMul

private theorem s3x_nat_ble_true_of_le {a b : Nat} (h : a ≤ b) : Nat.ble a b = true := by
  cases hB : Nat.ble a b with
  | true => rfl
  | false => exact False.elim (Nat.not_le_of_gt (nat_ble_false_gt hB) h)

private theorem s3x_nat_ble_false_of_gt {a b : Nat} (h : b < a) : Nat.ble a b = false := by
  cases hB : Nat.ble a b with
  | false => rfl
  | true => exact False.elim (Nat.not_lt_of_le ((nat_ble_eq_le _ _).mp hB) h)

private theorem s3x_nat_blt_true_of_lt {a b : Nat} (h : a < b) : Nat.blt a b = true := by
  cases hB : Nat.blt a b with
  | true => rfl
  | false =>
    have h1 : b < a + 1 := nat_ble_false_gt hB
    exact False.elim (Nat.not_le_of_gt h1 h)

private theorem s3x_nat_blt_false_of_ge {a b : Nat} (h : b ≤ a) : Nat.blt a b = false := by
  cases hB : Nat.blt a b with
  | false => rfl
  | true => exact False.elim (Nat.not_le_of_gt ((nat_blt_eq_lt _ _).mp hB) h)

private theorem s3x_nat_beq_false_of_ne {a b : Nat} (h : a ≠ b) : Nat.beq a b = false := by
  cases hB : Nat.beq a b with
  | false => rfl
  | true => exact False.elim (h (nat_beq_eq _ _ hB))

private theorem s3x_spliceBytes_nil (xs : List AllocByte) (off : Nat) (hLe : off ≤ xs.length) :
    spliceBytes xs off [] = xs := by
  apply s3_list_ext_mirGetElem?
  intro i
  cases Nat.lt_or_ge i off with
  | inl hLt =>
    exact s3_spliceBytes_getElem?_lt xs off [] i hLt hLe
  | inr hGe =>
    have hGe0 : off + ([] : List AllocByte).length ≤ i := by
      change off + 0 ≤ i
      rw [Nat.add_zero]
      exact hGe
    exact s3_spliceBytes_getElem?_ge xs off [] i hGe0 hLe

private theorem s3x_updateAlloc?_trans (aid : AllocId) (a1 a2 : Allocation)
    (hAid1 : a1.allocId = aid) :
    ∀ (xs ys zs : List Allocation),
      updateAlloc? aid a1 xs = some ys →
      updateAlloc? aid a2 ys = some zs →
      updateAlloc? aid a2 xs = some zs
  | [], _, _, h1, _ => by cases h1
  | x :: rest, ys, zs, h1, h2 => by
    unfold updateAlloc? at h1
    cases hEq : Nat.beq x.allocId aid with
    | true =>
      rw [hEq] at h1
      dsimp at h1
      cases h1
      unfold updateAlloc? at h2
      have hEq1 : Nat.beq a1.allocId aid = true := by rw [hAid1]; exact nat_beq_refl aid
      rw [hEq1] at h2
      dsimp at h2
      cases h2
      unfold updateAlloc?
      rw [hEq]
      rfl
    | false =>
      rw [hEq] at h1
      dsimp at h1
      cases hR1 : updateAlloc? aid a1 rest with
      | none => rw [hR1] at h1; cases h1
      | some ys' =>
        rw [hR1] at h1
        dsimp at h1
        cases h1
        unfold updateAlloc? at h2
        rw [hEq] at h2
        dsimp at h2
        cases hR2 : updateAlloc? aid a2 ys' with
        | none => rw [hR2] at h2; cases h2
        | some zs' =>
          rw [hR2] at h2
          dsimp at h2
          cases h2
          have hIh := s3x_updateAlloc?_trans aid a1 a2 hAid1 rest ys' zs' hR1 hR2
          unfold updateAlloc?
          rw [hEq, hIh]
          rfl

private theorem s3x_copy_readSrcByte_eq
    (mem0 memCur : CallerMemory)
    (bufS bufD : LocalId) (srcOff dstOff byteLen acc : Nat)
    (srcAlloc0 dstAlloc0 : Allocation) (snap : List AllocByte) (ab : AllocByte)
    (hFindS0 : findAlloc? (internalAllocBase + bufS) mem0.allocations = some srcAlloc0)
    (hFindD0 : findAlloc? (internalAllocBase + bufD) mem0.allocations = some dstAlloc0)
    (hAidD : dstAlloc0.allocId = internalAllocBase + bufD)
    (hLiveS0 : srcAlloc0.live = true)
    (hUpD : updateAlloc? (internalAllocBase + bufD)
      { dstAlloc0 with bytes := spliceBytes dstAlloc0.bytes dstOff (snap.take acc) }
      mem0.allocations = some memCur.allocations)
    (hNonOvlp : (bufS ≠ bufD) ∨ (srcOff + byteLen ≤ dstOff ∨ dstOff + byteLen ≤ srcOff))
    (hDstLen : dstOff ≤ dstAlloc0.bytes.length)
    (hSnapTakeLe : (snap.take acc).length ≤ acc)
    (hAccLt : acc < byteLen)
    (hByte0 : Trusted.MirSemantics.getElem? srcAlloc0.bytes (srcOff + acc) = some ab) :
    ∃ srcAllocCur : Allocation,
      findAlloc? (internalAllocBase + bufS) memCur.allocations = some srcAllocCur ∧
      srcAllocCur.live = true ∧
      Trusted.MirSemantics.getElem? srcAllocCur.bytes (srcOff + acc) = some ab := by
  cases s3x_nat_eq_or_ne bufD bufS with
  | inr hBufNe =>
    have hAidNe : internalAllocBase + bufD ≠ internalAllocBase + bufS :=
      fun hEq => hBufNe (Nat.add_left_cancel hEq)
    have hFindS := s3_findAlloc?_update_ne mem0.allocations
      (internalAllocBase + bufD) (internalAllocBase + bufS)
      { dstAlloc0 with bytes := spliceBytes dstAlloc0.bytes dstOff (snap.take acc) }
      memCur.allocations hAidD hAidNe hUpD
    rw [hFindS0] at hFindS
    exact ⟨srcAlloc0, hFindS, hLiveS0, hByte0⟩
  | inl hBufEq =>
    subst hBufEq
    have hSameAlloc : dstAlloc0 = srcAlloc0 := by
      rw [hFindS0] at hFindD0; cases hFindD0; rfl
    let dstCur : Allocation :=
      { dstAlloc0 with bytes := spliceBytes dstAlloc0.bytes dstOff (snap.take acc) }
    have hFindCur := s3_findAlloc?_update_eq mem0.allocations
      (internalAllocBase + bufD) dstCur memCur.allocations hAidD hUpD
    refine ⟨dstCur, hFindCur, ?_, ?_⟩
    · dsimp [dstCur]; rw [hSameAlloc]; exact hLiveS0
    · cases hNonOvlp with
      | inl hNe => exact False.elim (hNe rfl)
      | inr hDisj =>
        cases hDisj with
        | inl hLeft =>
          have hLt : srcOff + acc < dstOff :=
            Nat.lt_of_lt_of_le (Nat.add_lt_add_left hAccLt srcOff) hLeft
          rw [s3_spliceBytes_getElem?_lt dstAlloc0.bytes dstOff (snap.take acc) (srcOff + acc) hLt hDstLen]
          rw [hSameAlloc]
          exact hByte0
        | inr hRight =>
          have hGe : dstOff + (snap.take acc).length ≤ srcOff + acc :=
            Nat.le_trans
              (Nat.le_trans (Nat.add_le_add_left hSnapTakeLe dstOff)
                (Nat.add_le_add_left (Nat.le_of_lt hAccLt) dstOff))
              (Nat.le_trans hRight (Nat.le_add_right srcOff acc))
          rw [s3_spliceBytes_getElem?_ge dstAlloc0.bytes dstOff (snap.take acc) (srcOff + acc) hGe hDstLen]
          rw [hSameAlloc]
          exact hByte0

private theorem s3x_copy_byteLenStmts_sim (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock} {startIdx : Nat}
    {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (count elemSize : Nat)
    (hCntLt : count < maxUsize)
    (hSlotCnt : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 4) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 count })))))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hWin :
      let byteLenStmts : List MemCopyStmt :=
        if Nat.beq elemSize 0 then
          [mkAssignUse (s3_scrBase ctx + 4) (usizeConst 0)]
        else if !Nat.ble elemSize maxIsize then
          [mkRequireZeroUsize (s3_scrBase ctx + 5) (.copy { localId := s3_scrBase ctx + 4, projection := [] })]
        else
          [mkSubUncheckedUsize (s3_scrBase ctx + 5)
              (usizeConst (Nat.div maxIsize elemSize))
              (.copy { localId := s3_scrBase ctx + 4, projection := [] }),
           mkBinOpStmt (s3_scrBase ctx + 4) .mul
              (.move { localId := s3_scrBase ctx + 4, projection := [] })
              (usizeConst elemSize)]
      ∀ (k : Nat) (s : MemCopyStmt),
        Trusted.MirSemantics.getElem? byteLenStmts k = some s →
          Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + k) = some s) :
    let byteLenStmts : List MemCopyStmt :=
      if Nat.beq elemSize 0 then
        [mkAssignUse (s3_scrBase ctx + 4) (usizeConst 0)]
      else if !Nat.ble elemSize maxIsize then
        [mkRequireZeroUsize (s3_scrBase ctx + 5) (.copy { localId := s3_scrBase ctx + 4, projection := [] })]
      else
        [mkSubUncheckedUsize (s3_scrBase ctx + 5)
            (usizeConst (Nat.div maxIsize elemSize))
            (.copy { localId := s3_scrBase ctx + 4, projection := [] }),
         mkBinOpStmt (s3_scrBase ctx + 4) .mul
            (.move { localId := s3_scrBase ctx + 4, projection := [] })
            (usizeConst elemSize)]
    match Nat.ble (elemSize * count) maxIsize with
    | false =>
      ∃ n sBad,
        ReachesNMemCopy ctx.pTgt n
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
            sBad ∧
          evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined
    | true =>
      elemSize * count ≤ maxIsize ∧
      ∃ slots₂',
        ReachesNMemCopy ctx.pTgt byteLenStmts.length
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + byteLenStmts.length, locals := slots₂' }], mem := mem } ∧
        s3_SlotsRel ctx slots₁ slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 4) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (elemSize * count) })))) ∧
        (∀ j' : Nat, j' < 4 →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
  intro byteLenStmts
  cases hE0 : Nat.beq elemSize 0 with
  | true =>
    have hElemZero : elemSize = 0 := nat_beq_eq _ _ hE0
    have hMulZero : elemSize * count = 0 := by rw [hElemZero, Nat.zero_mul]
    have hBle0 : Nat.ble (elemSize * count) maxIsize = true := by rw [hMulZero]; rfl
    rw [hBle0]
    dsimp [byteLenStmts] at hWin
    dsimp [byteLenStmts]
    rw [hE0] at hWin
    rw [hE0]
    dsimp at hWin
    dsimp
    have hStmt0 := hWin 0 _ rfl
    rw [Nat.add_zero] at hStmt0
    have hStep := s3_exec_mkAssignUse_usize_scr ctx (mem := mem) 4 0 (by decide)
      (s3_nat_pow_pos 2 (by decide) 64) hRel hBbTgt hStmt0
    cases hStep with | intro slots₂' hS2 =>
    refine ⟨by rw [hMulZero]; exact Nat.zero_le maxIsize, slots₂', s3_reachesN_one hS2.1, hS2.2.1, ?_, ?_⟩
    · rw [hMulZero]; exact hS2.2.2.1
    · intro j' hj4
      exact hS2.2.2.2 j' (Nat.lt_trans hj4 (by decide)) (Nat.ne_of_lt hj4)
  | false =>
    have hElemPos : 0 < elemSize := Nat.pos_of_ne_zero (nat_beq_false_ne hE0)
    cases hELe : Nat.ble elemSize maxIsize with
    | false =>
      have hMaxLtElem : maxIsize < elemSize := nat_ble_false_gt hELe
      dsimp [byteLenStmts] at hWin
      dsimp [byteLenStmts]
      rw [hE0, hELe] at hWin
      rw [hE0, hELe]
      dsimp at hWin
      dsimp
      have hStmt0 := hWin 0 _ rfl
      rw [Nat.add_zero] at hStmt0
      have hReq := s3_exec_mkRequireZeroUsize_scr ctx (mem := mem) 5
        (.copy { localId := s3_scrBase ctx + 4, projection := [] }) count
        (by decide) hCntLt
        (s3_evalPrimOp_scr_copy ctx slots₂ 4 count (by decide) hSlotCnt)
        hRel hBbTgt hStmt0
      cases hC0 : Nat.beq count 0 with
      | true =>
        have hCntZero : count = 0 := nat_beq_eq _ _ hC0
        have hMulZero : elemSize * count = 0 := by rw [hCntZero, Nat.mul_zero]
        have hBle0 : Nat.ble (elemSize * count) maxIsize = true := by rw [hMulZero]; rfl
        rw [hBle0]
        dsimp
        cases hReq.1 hCntZero with | intro slots₂' hS2 =>
        refine ⟨by rw [hMulZero]; exact Nat.zero_le maxIsize, slots₂', s3_reachesN_one hS2.1, hS2.2.1, ?_, ?_⟩
        · rw [hMulZero, hS2.2.2.2 4 (by decide) (by decide), hSlotCnt, hCntZero]
        · intro j' hj4
          exact hS2.2.2.2 j' (Nat.lt_trans hj4 (by decide))
            (fun h => by rw [h] at hj4; exact False.elim (Nat.not_lt_of_ge (Nat.le_succ 4) hj4))
      | false =>
        have hCntPos : 0 < count := Nat.pos_of_ne_zero (nat_beq_false_ne hC0)
        have hMaxLtMul : maxIsize < elemSize * count :=
          Nat.lt_of_lt_of_le hMaxLtElem
            (by have h1 := Nat.mul_le_mul_left elemSize hCntPos; rw [Nat.mul_one] at h1; exact h1)
        rw [s3x_nat_ble_false_of_gt hMaxLtMul]
        exact ⟨0, _, ReachesNMemCopy.zero _, hReq.2 hCntPos⟩
    | true =>
      have hElemLeMax : elemSize ≤ maxIsize := (nat_ble_eq_le _ _).mp hELe
      have hElemLtU : elemSize < maxUsize := Nat.lt_of_le_of_lt hElemLeMax s3x_maxIsize_lt_maxUsize
      have hDivLtU : Nat.div maxIsize elemSize < maxUsize :=
        Nat.lt_of_le_of_lt (Nat.div_le_self maxIsize elemSize) s3x_maxIsize_lt_maxUsize
      dsimp [byteLenStmts] at hWin
      dsimp [byteLenStmts]
      rw [hE0, hELe] at hWin
      rw [hE0, hELe]
      dsimp at hWin
      dsimp
      have hStmt0 := hWin 0 _ rfl
      rw [Nat.add_zero] at hStmt0
      have hStmt1 := hWin 1 _ rfl
      have hSub := s3_exec_mkSubUncheckedUsize_scr ctx (mem := mem) (idx := startIdx) 5
        (usizeConst (Nat.div maxIsize elemSize))
        (.copy { localId := s3_scrBase ctx + 4, projection := [] })
        (Nat.div maxIsize elemSize) count (by decide) hDivLtU hCntLt
        (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals slots₂ _ hDivLtU)
        (s3_evalPrimOp_scr_copy ctx slots₂ 4 count (by decide) hSlotCnt)
        hRel hBbTgt hStmt0
      cases hCLe : Nat.ble count (Nat.div maxIsize elemSize) with
      | false =>
        have hDivLtCnt : Nat.div maxIsize elemSize < count := nat_ble_false_gt hCLe
        have hMaxLtMul : maxIsize < elemSize * count := by
          rw [Nat.mul_comm]
          exact (s3x_nat_div_lt_iff_lt_mul hElemPos).mp hDivLtCnt
        rw [s3x_nat_ble_false_of_gt hMaxLtMul]
        exact ⟨0, _, ReachesNMemCopy.zero _, hSub.2 hDivLtCnt⟩
      | true =>
        have hCntLeDiv : count ≤ Nat.div maxIsize elemSize := (nat_ble_eq_le _ _).mp hCLe
        have hMulLeMax : elemSize * count ≤ maxIsize := s3x_nat_mul_le_of_le_div hElemPos hCntLeDiv
        have hMulLtU : elemSize * count < maxUsize := Nat.lt_of_le_of_lt hMulLeMax s3x_maxIsize_lt_maxUsize
        rw [s3x_nat_ble_true_of_le hMulLeMax]
        dsimp
        cases hSub.1 hCntLeDiv with | intro sA hSA =>
        have hCntA : Trusted.MirSemantics.getElem? sA (s3_scrBase ctx + 4) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 count })))) := by
          rw [hSA.2.2.2 4 (by decide) (by decide), hSlotCnt]
        have hLen4 : s3_scrBase ctx + 4 < sA.length := by
          rw [hSA.2.1.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 4 (by decide)
        cases s3_evalPrimOp_scr_move ctx sA 4 count (by decide) hLen4 hCntA with | intro sAm hMove4 =>
        have hRelAm := s3_slotsRel_set_scratch ctx slots₁ sA sAm 4 _ (by decide) hSA.2.1 hMove4.1
        have hBinEq := s3_evalBinOp_usize_mul count elemSize hCntLt hElemLtU
        have hMulMod : Nat.mod (count * elemSize) maxUsize = elemSize * count := by
          rw [Nat.mul_comm, s3x_nat_mod_eq_of_lt hMulLtU]
        rw [hMulMod] at hBinEq
        have hMulStep := s3_exec_mkBinOpStmt_usize_scr ctx (mem := mem) (idx := startIdx + 1) 4 .mul
          (.move { localId := s3_scrBase ctx + 4, projection := [] }) (usizeConst elemSize)
          _ _ (elemSize * count) (by decide) hMulLtU
          hMove4.2 (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals sAm elemSize hElemLtU)
          hBinEq hRelAm hBbTgt hStmt1
        cases hMulStep with | intro sB hSB =>
        refine ⟨hMulLeMax, sB, s3_reachesN_cons hSA.1 (s3_reachesN_one hSB.1), hSB.2.1, hSB.2.2.1, ?_⟩
        intro j' hj4
        have hNe4 : j' ≠ 4 := Nat.ne_of_lt hj4
        have hNe5 : j' ≠ 5 := Nat.ne_of_lt (Nat.lt_trans hj4 (by decide))
        have hNeLoc : s3_scrBase ctx + 4 ≠ s3_scrBase ctx + j' :=
          fun h => hNe4 (Nat.add_left_cancel h).symm
        rw [hSB.2.2.2 j' (Nat.lt_trans hj4 (by decide)) hNe4]
        rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hMove4.1]
        rw [hSA.2.2.2 j' (Nat.lt_trans hj4 (by decide)) hNe5]

private theorem s3x_copy_alignAndNull_sim (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock} {startIdx : Nat}
    {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (optBufS optBufD : Option LocalId) (reqAlignLog2 tagS tagD : Nat) (pvSrc pvDst : PtrVal)
    (checkNonNullZero : Bool)
    (hReq : reqAlignLog2 ≤ 30)
    (hTagSLt : tagS < maxUsize) (hTagDLt : tagD < maxUsize)
    (hMatchS : s3_PtrTagMatches optBufS pvSrc tagS)
    (hMatchD : s3_PtrTagMatches optBufD pvDst tagD)
    (hSpecS : ∀ b, optBufS = some b →
      ∃ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals b = some (.byteBuf sz al mutab) ∧ sz ≤ 32 ∧ al ≤ 30)
    (hSpecD : ∀ b, optBufD = some b →
      ∃ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals b = some (.byteBuf sz al mutab) ∧ sz ≤ 32 ∧ al ≤ 30)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hS0 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 0) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagS })))))
    (hS1 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 1) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvSrc.offsetBytes.toNat })))))
    (hS2 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 2) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagD })))))
    (hS3 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 3) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvDst.offsetBytes.toNat })))))
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hWin :
      let alignAndNull : List MemCopyStmt :=
        mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2 ++
          mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2 ++
          (if checkNonNullZero then
            mkPtrNonNullCheckStmts (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) ++
              mkPtrNonNullCheckStmts (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6)
          else [])
      ∀ (k : Nat) (s : MemCopyStmt),
        Trusted.MirSemantics.getElem? alignAndNull k = some s →
          Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + k) = some s) :
    let alignAndNull : List MemCopyStmt :=
      mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2 ++
        mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2 ++
        (if checkNonNullZero then
          mkPtrNonNullCheckStmts (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) ++
            mkPtrNonNullCheckStmts (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6)
        else [])
    match checkPtrAlignMem mem pvSrc reqAlignLog2,
          checkPtrAlignMem mem pvDst reqAlignLog2 with
    | .error err, _ =>
      ∃ n sBad,
        ReachesNMemCopy ctx.pTgt n
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
            sBad ∧
          evalStepMemCopy ctx.pTgt 0 sBad = .fault err
    | _, .error err =>
      ∃ n sBad,
        ReachesNMemCopy ctx.pTgt n
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
            sBad ∧
          evalStepMemCopy ctx.pTgt 0 sBad = .fault err
    | .ok (), .ok () =>
      if checkNonNullZero && (isNullPtr pvSrc || isNullPtr pvDst) then
        ∃ n sBad,
          ReachesNMemCopy ctx.pTgt n
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
              sBad ∧
            evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined
      else
        ∃ slots₂',
          ReachesNMemCopy ctx.pTgt alignAndNull.length
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + alignAndNull.length, locals := slots₂' }], mem := mem } ∧
          s3_SlotsRel ctx slots₁ slots₂' ∧
          (∀ j' : Nat, j' < 5 →
            Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
              Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
  intro alignAndNull
  have hWinAlBoth := s3x_window_append_left hWin
  have hWinAlS := s3x_window_append_left hWinAlBoth
  have hWinAlD := s3x_window_append_right hWinAlBoth
  have hWinNNAll := s3x_window_append_right hWin
  have hAlSRes :
      match checkPtrAlignMem mem pvSrc reqAlignLog2 with
      | .error err =>
        ∃ n sBad,
          ReachesNMemCopy ctx.pTgt n
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
              sBad ∧
            evalStepMemCopy ctx.pTgt 0 sBad = .fault err
      | .ok () =>
        let nS := (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length
        ∃ slots₂',
          ReachesNMemCopy ctx.pTgt nS
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + nS, locals := slots₂' }], mem := mem } ∧
          s3_SlotsRel ctx slots₁ slots₂' ∧
          (∀ j' : Nat, j' < 12 → j' ≠ 5 → j' ≠ 6 →
            Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
              Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
    have hOffSLt : pvSrc.offsetBytes.toNat < maxUsize := s3x_uint64_toNat_lt_maxUsize pvSrc.offsetBytes
    cases optBufS with
    | none =>
      exact s3_exec_mkPtrAlignCheckStmts ctx (mem := mem) none 0 1 reqAlignLog2 tagS pvSrc.offsetBytes.toNat pvSrc
        hReq (by decide) (by decide) hTagSLt hOffSLt hMatchS rfl True.intro hWf hRel hS0 hS1 hBbTgt hWinAlS
    | some bS =>
      exact s3_exec_mkPtrAlignCheckStmts ctx (mem := mem) (some bS) 0 1 reqAlignLog2 tagS pvSrc.offsetBytes.toNat pvSrc
        hReq (by decide) (by decide) hTagSLt hOffSLt hMatchS rfl (hSpecS bS rfl) hWf hRel hS0 hS1 hBbTgt hWinAlS
  cases hAlS : checkPtrAlignMem mem pvSrc reqAlignLog2 with
  | error err =>
    rw [hAlS] at hAlSRes
    dsimp at hAlSRes
    dsimp
    exact hAlSRes
  | ok uS =>
    cases uS
    rw [hAlS] at hAlSRes
    dsimp at hAlSRes
    cases hAlSRes with | intro sA hSA =>
    have hPresS : ∀ j' : Nat, j' < 5 →
        Trusted.MirSemantics.getElem? sA (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') :=
      fun j' hj5 => hSA.2.2 j' (Nat.lt_trans hj5 (by decide : 5 < 12)) (Nat.ne_of_lt hj5) (Nat.ne_of_lt (Nat.lt_trans hj5 (by decide : 5 < 6)))
    have hA2 : Trusted.MirSemantics.getElem? sA (s3_scrBase ctx + 2) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagD })))) := by
      rw [hPresS 2 (by decide), hS2]
    have hA3 : Trusted.MirSemantics.getElem? sA (s3_scrBase ctx + 3) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvDst.offsetBytes.toNat })))) := by
      rw [hPresS 3 (by decide), hS3]
    let offA := startIdx + (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length
    let fA : MemCopyFrame := { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := offA, locals := sA }
    have hAlDRes :
        match checkPtrAlignMem mem pvDst reqAlignLog2 with
