prelude
import Trusted.MirAst
import Trusted.MirSemantics

namespace VrustcFormal.F1_16

open Trusted.MirAst Trusted.MirSemantics

/-!
# `CallerMemory` Byte Allocations, In-Bounds vs. Wrapping `PtrVal` Offsets, Aligned & Unaligned Little-Endian Scalar/Pointer Loads & Stores, `copy_nonoverlapping`, and Certified `MemAllocScalarize` Reduction Directly Into `Trusted.MirSemantics` (`VrustcFormal.F1_16`)

This module conservatively extends Anneal's unmodified `Trusted.MirAst` and
`Trusted.MirSemantics` (`joshlf/anneal@c131b320eeeb26ef692e5afd5ec8db49ee518613`)
with `M_memcopy`, activating the latent `PtrVal`, `AllocByte`, `Allocation`,
`CallerMemory`, and `BinOp.offset` types already declared in
`Trusted/MirSemantics.lean:415-605` while faithfully modeling:
- caller-supplied `CallerMemory` byte allocations (`acceptsCallerMem = true`,
  mutable vs. `.shared` read-only permissions, `Val.ptr` arguments, and
  persistent `Out.callerMem` effects) alongside frame-owned internal byte
  buffers (`.byteBuf size alignLog2 mutability`);
- provenance-preserving wrapping pointer arithmetic (`ptrWrappingOffset`,
  supporting signed `isize` and unsigned `usize` counts across out-of-bounds
  round-trips) vs. `BinOp.offset` in-bounds pointer arithmetic
  (`ptrOffsetInbounds`, allowing `delta == 0` on `null` and `NonNull::dangling()`
  while requiring live allocation bounds `0 ≤ off ≤ len` and
  `0 ≤ off + delta ≤ len` when `delta ≠ 0`);
- little-endian multi-byte scalar loads and stores (`1`, `2`, `4`, and `8`
  bytes, both aligned `*ptr` and unaligned `ptr::read_unaligned` /
  `ptr::write_unaligned`, faulting `.undefined` on `AllocByte.uninit` or
  provenance-bearing `AllocByte.init _ (some _)` `ReadPointerAsInt`) alongside
  8-byte pointer-in-memory loads and stores (`writePtrLe8` / `readPtrLe8`)
  preserving per-byte `Option AllocId` provenance; and
- `StatementKind::Intrinsic(CopyNonOverlapping)` vs.
  `core::ptr::copy_nonoverlapping` (`elemSize * count ≤ isize::MAX`,
  unconditional `src`/`dst` alignment checks even when `elemSize * count == 0`,
  parameterized `checkNonNullZero : Bool` capturing the exact raw-intrinsic vs.
  `ub_checks::maybe_is_aligned_and_not_null` separation on `null` at `count = 0`,
  no-deref short-circuit at `byteLen = 0` on aligned `NonNull::dangling()`,
  same-allocation interval disjointness, `.shared` destination rejection, and
  exact per-byte `AllocByte` `.uninit` + provenance copy), grounded in upstream
  `compiler/rustc_const_eval/src/interpret/{operator.rs, intrinsics.rs, memory.rs}`,
  vendored `proofs-rs/lean-miri`, and live `google/zerocopy` (`0.8.64`) + `Miri`
  census `E3-137`.

It then formalizes three certified MIR passes—`FoldZeroOffset`,
`FoldGuardedZeroCopy`, and `MemAllocScalarize`—lowering internal byte-buffer and
pointer programs **100% into unmodified `Trusted.MirAst.Program`
(`mirProfileVersion = 1`)** executed by unmodified
`Trusted.MirSemantics.evalStep`:

1. **Part I — Byte-Granular `CallerMemory`, `PtrVal` Offset, Little-Endian
   Load/Store, and `copy_nonoverlapping` Operational Semantics (`M_memcopy`)
   Conservatively Extending Unmodified `Trusted.MirSemantics`.**
2. **Part II — Certified `FoldZeroOffset`, `FoldGuardedZeroCopy`, and
   `MemAllocScalarize` Lowering Directly Into Unmodified
   `Trusted.MirAst.Program`.**
3. **Part III — Five Core Target Theorems (`sorry` placeholders in frozen spec):**
   - `memcopy_conservative_extension_exact`
   - `foldZeroOffset_and_guardedZeroCopy_sound_bidirectional_iff`
   - `inboundsOffset_leRoundTrip_and_copyNonOverlapping_laws`
   - `memAllocScalarize_reduces_to_trusted_mir`
   - `memCopyPipeline_then_optPipeline_vc_transport`
4. **Part IV — Deterministic Adequacy, Eleven Sharpness Counterexamples &
   Witnesses (`CE1`--`CE11`), and End-to-End Lowering Witness Executed in
   Unmodified `Trusted.MirSemantics` (`0` `sorry`).**
-/

/-! ## Part I: Byte-Granular `M_memcopy` Operational Semantics -/

/-- Structural boolean equality without `Decidable` instances. -/
noncomputable def boolEq : Bool → Bool → Bool
  | true, true => true
  | false, false => true
  | _, _ => false

/-- Structural equality on `Option Nat`. -/
noncomputable def optNatEq : Option Nat → Option Nat → Bool
  | none, none => true
  | some a, some b => Nat.beq a b
  | _, _ => false

/-- Pairwise boolean relation over two lists of equal length. -/
noncomputable def listRel {α β : Type} (r : α → β → Bool) :
    List α → List β → Bool
  | [], [] => true
  | x :: xs, y :: ys => r x y && listRel r xs ys
  | _, _ => false

/-- Map an option-returning function over a list, failing closed on `none`. -/
noncomputable def listMapOption {α β : Type} (f : α → Option β) :
    List α → Option (List β)
  | [] => some []
  | x :: xs =>
    match f x, listMapOption f xs with
    | some y, some ys => some (y :: ys)
    | _, _ => none

/-- Flatten a mapped list without extra library imports. -/
noncomputable def listFlatMap {α β : Type} (f : α → List β) :
    List α → List β
  | [] => []
  | x :: xs => f x ++ listFlatMap f xs

/-- Replicate `x` `n` times without extra imports. -/
noncomputable def listReplicate {α : Type} : Nat → α → List α
  | 0, _ => []
  | n + 1, x => x :: listReplicate n x

/-- 64-bit `usize` modulus `2^64`. -/
noncomputable def maxUsize : Nat := Nat.pow 2 64

/-- Maximum signed 64-bit `isize` value `2^63 - 1` (`maxSizeOfVal`). -/
noncomputable def maxIsize : Nat := Nat.pow 2 63 - 1

/-- Minimum signed 64-bit `isize` value `-2^63`. -/
noncomputable def minIsize : Int := Neg.neg (Int.ofNat (Nat.pow 2 63))

/-- Reserved `AllocId` base (`65536`) separating caller-visible external
allocations (`allocId < 65536`) from internal frame `.byteBuf` allocations
(`allocId = 65536 + localId`). -/
noncomputable def internalAllocBase : Nat := 65536

/-- Canonical 64-bit `usize` and `isize` types in `Trusted.MirAst`. -/
noncomputable def usizeTy : MirTy := .int .isize false
noncomputable def isizeTy : MirTy := .int .isize true

/-- Canonical `usize` and signed `isize` constant operands. -/
noncomputable def usizeConst (n : Nat) : Operand :=
  .constant { ty := usizeTy, lit := .scalar (BitVec.ofNat 128 n) }

noncomputable def isizeConst (z : Int) : Operand :=
  .constant { ty := isizeTy, lit := .scalar (truncateBits .isize (bvOfInt 128 z)) }

/-- Little-endian scalar access width (`1`, `2`, `4`, or `8` bytes). -/
inductive LeWidth where
  | b1
  | b2
  | b4
  | b8

noncomputable def leWidthEq : LeWidth → LeWidth → Bool
  | .b1, .b1 | .b2, .b2 | .b4, .b4 | .b8, .b8 => true
  | _, _ => false

noncomputable def LeWidth.byteCount : LeWidth → Nat
  | .b1 => 1
  | .b2 => 2
  | .b4 => 4
  | .b8 => 8

noncomputable def LeWidth.naturalAlignLog2 : LeWidth → Nat
  | .b1 => 0
  | .b2 => 1
  | .b4 => 2
  | .b8 => 3

noncomputable def LeWidth.bitWidth : LeWidth → Nat
  | .b1 => 8
  | .b2 => 16
  | .b4 => 32
  | .b8 => 64

/-- Structural equality helpers over unmodified `Trusted.MirAst`. -/
noncomputable def projElemEq : ProjectionElem → ProjectionElem → Bool
  | .deref, .deref => true
  | .field idx₁ ty₁, .field idx₂ ty₂ => Nat.beq idx₁ idx₂ && MirTy.beq ty₁ ty₂
  | .unsupported, .unsupported => true
  | _, _ => false

noncomputable def placeEq (p₁ p₂ : Place) : Bool :=
  Nat.beq p₁.localId p₂.localId && listRel projElemEq p₁.projection p₂.projection

noncomputable def constLitEq : ConstLit → ConstLit → Bool
  | .scalar b₁, .scalar b₂ => b₁ == b₂
  | .zeroSized, .zeroSized => true
  | _, _ => false

noncomputable def constOpEq (c₁ c₂ : ConstOperand) : Bool :=
  MirTy.beq c₁.ty c₂.ty && constLitEq c₁.lit c₂.lit

noncomputable def binOpEq : BinOp → BinOp → Bool
  | .add, .add | .addUnchecked, .addUnchecked | .addWithOverflow, .addWithOverflow
  | .sub, .sub | .subUnchecked, .subUnchecked | .subWithOverflow, .subWithOverflow
  | .mul, .mul | .mulUnchecked, .mulUnchecked | .mulWithOverflow, .mulWithOverflow
  | .div, .div | .rem, .rem
  | .bitXor, .bitXor | .bitAnd, .bitAnd | .bitOr, .bitOr
  | .shl, .shl | .shlUnchecked, .shlUnchecked
  | .shr, .shr | .shrUnchecked, .shrUnchecked
  | .eq, .eq | .lt, .lt | .le, .le | .ne, .ne | .ge, .ge | .gt, .gt
  | .offset, .offset => true
  | _, _ => false

noncomputable def unOpEq : UnOp → UnOp → Bool
  | .not, .not | .neg, .neg | .ptrMetadata, .ptrMetadata => true
  | _, _ => false

noncomputable def operandEq : Operand → Operand → Bool
  | .copy p₁, .copy p₂ => placeEq p₁ p₂
  | .move p₁, .move p₂ => placeEq p₁ p₂
  | .constant c₁, .constant c₂ => constOpEq c₁ c₂
  | _, _ => false

noncomputable def rvalueEq : Rvalue → Rvalue → Bool
  | .use o₁, .use o₂ => operandEq o₁ o₂
  | .binaryOp op₁ l₁ r₁, .binaryOp op₂ l₂ r₂ =>
    binOpEq op₁ op₂ && operandEq l₁ l₂ && operandEq r₁ r₂
  | .unaryOp op₁ o₁, .unaryOp op₂ o₂ => unOpEq op₁ op₂ && operandEq o₁ o₂
  | .discriminant p₁, .discriminant p₂ => placeEq p₁ p₂
  | .ref m₁ p₁, .ref m₂ p₂ => Mutability.beq m₁ m₂ && placeEq p₁ p₂
  | .addressOf m₁ p₁, .addressOf m₂ p₂ => Mutability.beq m₁ m₂ && placeEq p₁ p₂
  | .aggregateTuple fs₁, .aggregateTuple fs₂ => listRel operandEq fs₁ fs₂
  | .unsupported, .unsupported => true
  | _, _ => false

noncomputable def stmtEq : StatementKind → StatementKind → Bool
  | .assign d₁ r₁, .assign d₂ r₂ => placeEq d₁ d₂ && rvalueEq r₁ r₂
  | .storageLive l₁, .storageLive l₂ => Nat.beq l₁ l₂
  | .storageDead l₁, .storageDead l₂ => Nat.beq l₁ l₂
  | .nop, .nop => true
  | .unsupported, .unsupported => true
  | _, _ => false

noncomputable def switchTargetsEq (t₁ t₂ : SwitchTargets) : Bool :=
  Nat.beq t₁.otherwise t₂.otherwise &&
    listRel (fun a b => (a.1 == b.1) && Nat.beq a.2 b.2) t₁.branches t₂.branches

noncomputable def unwindActionEq : UnwindAction → UnwindAction → Bool
  | .continue_, .continue_ | .unreachable, .unreachable
  | .terminate, .terminate => true
  | .cleanup b₁, .cleanup b₂ => Nat.beq b₁ b₂
  | _, _ => false

noncomputable def assertKindEq : AssertKind → AssertKind → Bool
  | .overflow op₁, .overflow op₂ => binOpEq op₁ op₂
  | .overflowNeg, .overflowNeg | .divByZero, .divByZero
  | .remByZero, .remByZero | .boundsCheck, .boundsCheck
  | .misalignedPtrDeref, .misalignedPtrDeref | .nullPtrDeref, .nullPtrDeref
  | .unsupported, .unsupported => true
  | _, _ => false

noncomputable def terminatorEq : TerminatorKind → TerminatorKind → Bool
  | .goto t₁, .goto t₂ => Nat.beq t₁ t₂
  | .switchInt d₁ ts₁, .switchInt d₂ ts₂ =>
    operandEq d₁ d₂ && switchTargetsEq ts₁ ts₂
  | .return_, .return_ | .unreachable, .unreachable
  | .unwindResume, .unwindResume | .unsupported, .unsupported => true
  | .assert c₁ e₁ m₁ t₁ u₁, .assert c₂ e₂ m₂ t₂ u₂ =>
    operandEq c₁ c₂ && boolEq e₁ e₂ && assertKindEq m₁ m₂ &&
      Nat.beq t₁ t₂ && unwindActionEq u₁ u₂
  | .call f₁ a₁ d₁ t₁ u₁, .call f₂ a₂ d₂ t₂ u₂ =>
    Nat.beq f₁ f₂ && listRel operandEq a₁ a₂ && placeEq d₁ d₂ &&
      optNatEq t₁ t₂ && unwindActionEq u₁ u₂
  | _, _ => false

noncomputable def scopeEq : VerificationScope → VerificationScope → Bool
  | .unit, .unit | .crate, .crate => true
  | _, _ => false

noncomputable def basicBlockEq (b₁ b₂ : BasicBlock) : Bool :=
  boolEq b₁.cleanup b₂.cleanup &&
    listRel stmtEq b₁.statements b₂.statements &&
    terminatorEq b₁.terminator b₂.terminator

noncomputable def bodyEq (b₁ b₂ : Body) : Bool :=
  Nat.beq b₁.argumentCount b₂.argumentCount &&
    MirTy.beqList b₁.locals b₂.locals &&
    listRel basicBlockEq b₁.basicBlocks b₂.basicBlocks &&
    boolEq b₁.isUnsafe b₂.isUnsafe &&
    stringBeq b₁.identity b₂.identity

noncomputable def programEq (p₁ p₂ : Program) : Bool :=
  listRel bodyEq p₁.bodies p₂.bodies &&
    Nat.beq p₁.entryDefId p₂.entryDefId &&
    Nat.beq p₁.pointerWidthBits p₂.pointerWidthBits &&
    Nat.beq p₁.mirProfileVersion p₂.mirProfileVersion &&
    scopeEq p₁.scope p₂.scope

/-! ### `M_memcopy` Syntax Extending Unmodified `Trusted.MirAst` -/

/-- Local declaration in `M_memcopy`:
- `.base ty`: any unmodified `Trusted.MirAst.MirTy`.
- `.byteBuf size alignLog2 mutability`: internal frame-allocated byte buffer
  with `allocId = internalAllocBase + localId`.
- `.ptrLocal`: pointer/reference local holding `Option PtrVal`. -/
inductive MemCopyLocalDecl where
  | base (ty : MirTy)
  | byteBuf (size : Nat) (alignLog2 : Nat) (mutability : Mutability)
  | ptrLocal

noncomputable def memCopyLocalDeclEq :
    MemCopyLocalDecl → MemCopyLocalDecl → Bool
  | .base t₁, .base t₂ => MirTy.beq t₁ t₂
  | .byteBuf s₁ a₁ m₁, .byteBuf s₂ a₂ m₂ =>
    Nat.beq s₁ s₂ && Nat.beq a₁ a₂ && Mutability.beq m₁ m₂
  | .ptrLocal, .ptrLocal => true
  | _, _ => false

/-- Straight-line statements in `M_memcopy`. -/
inductive MemCopyStmt where
  | baseStmt (stmt : StatementKind)
  | bufLivenessCheck (bufLocal : LocalId)
  | mkNullPtr (dstPtr : LocalId)
  | mkDanglingPtr (dstPtr : LocalId) (alignLog2 : Nat)
  | addrOfByteBuf (dstPtr : LocalId) (bufLocal : LocalId)
  | copyPtr (dstPtr : LocalId) (srcPtr : LocalId) (isMove : Bool)
  | ptrWrappingOffset (dstPtr : LocalId) (srcPtr : LocalId)
      (countOp : Operand) (elemSize : Nat)

noncomputable def memCopyStmtEq : MemCopyStmt → MemCopyStmt → Bool
  | .baseStmt s₁, .baseStmt s₂ => stmtEq s₁ s₂
  | .bufLivenessCheck b₁, .bufLivenessCheck b₂ => Nat.beq b₁ b₂
  | .mkNullPtr d₁, .mkNullPtr d₂ => Nat.beq d₁ d₂
  | .mkDanglingPtr d₁ a₁, .mkDanglingPtr d₂ a₂ =>
    Nat.beq d₁ d₂ && Nat.beq a₁ a₂
  | .addrOfByteBuf d₁ b₁, .addrOfByteBuf d₂ b₂ =>
    Nat.beq d₁ d₂ && Nat.beq b₁ b₂
  | .copyPtr d₁ s₁ m₁, .copyPtr d₂ s₂ m₂ =>
    Nat.beq d₁ d₂ && Nat.beq s₁ s₂ && boolEq m₁ m₂
  | .ptrWrappingOffset d₁ s₁ c₁ e₁, .ptrWrappingOffset d₂ s₂ c₂ e₂ =>
    Nat.beq d₁ d₂ && Nat.beq s₁ s₂ && operandEq c₁ c₂ && Nat.beq e₁ e₂
  | _, _ => false

/-- Terminators in `M_memcopy` (control flow, `BinOp.offset` in-bounds pointer
arithmetic, pure alignment/non-null guards, LE loads/stores, and
`copy_nonoverlapping`). -/
inductive MemCopyTerm where
  | baseTerm (term : TerminatorKind)
  | ptrOffsetInbounds (dstPtr : LocalId) (srcPtr : LocalId)
      (countOp : Operand) (elemSize : Nat) (nextBb : BasicBlockId)
  | checkPtrPairAlign (srcPtr dstPtr : LocalId) (elemSize reqAlignLog2 : Nat)
      (checkNonNullZero : Bool) (nextBb : BasicBlockId)
  | readLeUsize (dstLocal : LocalId) (ptrLocal : LocalId)
      (w : LeWidth) (requireAligned : Bool) (nextBb : BasicBlockId)
  | writeLeUsize (ptrLocal : LocalId) (valOp : Operand)
      (w : LeWidth) (requireAligned : Bool) (nextBb : BasicBlockId)
  | readPtrLe8 (dstPtr : LocalId) (addrPtr : LocalId)
      (requireAligned : Bool) (nextBb : BasicBlockId)
  | writePtrLe8 (addrPtr : LocalId) (valPtr : LocalId)
      (requireAligned : Bool) (nextBb : BasicBlockId)
  | copyNonOverlapping (srcPtr dstPtr : LocalId) (countOp : Operand)
      (elemSize reqAlignLog2 : Nat) (checkNonNullZero : Bool)
      (nextBb : BasicBlockId)
  | readBufRawByte (tagDst valDst : LocalId) (bufLocal : LocalId)
      (offOp : Operand) (nextBb : BasicBlockId)
  | writeBufRawByte (bufLocal : LocalId) (offOp tagOp valOp : Operand)
      (nextBb : BasicBlockId)

noncomputable def memCopyTermEq : MemCopyTerm → MemCopyTerm → Bool
  | .baseTerm t₁, .baseTerm t₂ => terminatorEq t₁ t₂
  | .ptrOffsetInbounds d₁ s₁ c₁ e₁ n₁, .ptrOffsetInbounds d₂ s₂ c₂ e₂ n₂ =>
    Nat.beq d₁ d₂ && Nat.beq s₁ s₂ && operandEq c₁ c₂ &&
      Nat.beq e₁ e₂ && Nat.beq n₁ n₂
  | .checkPtrPairAlign s₁ d₁ e₁ a₁ z₁ n₁,
    .checkPtrPairAlign s₂ d₂ e₂ a₂ z₂ n₂ =>
    Nat.beq s₁ s₂ && Nat.beq d₁ d₂ && Nat.beq e₁ e₂ && Nat.beq a₁ a₂ &&
      boolEq z₁ z₂ && Nat.beq n₁ n₂
  | .readLeUsize d₁ p₁ w₁ r₁ n₁, .readLeUsize d₂ p₂ w₂ r₂ n₂ =>
    Nat.beq d₁ d₂ && Nat.beq p₁ p₂ && leWidthEq w₁ w₂ &&
      boolEq r₁ r₂ && Nat.beq n₁ n₂
  | .writeLeUsize p₁ v₁ w₁ r₁ n₁, .writeLeUsize p₂ v₂ w₂ r₂ n₂ =>
    Nat.beq p₁ p₂ && operandEq v₁ v₂ && leWidthEq w₁ w₂ &&
      boolEq r₁ r₂ && Nat.beq n₁ n₂
  | .readPtrLe8 d₁ a₁ r₁ n₁, .readPtrLe8 d₂ a₂ r₂ n₂ =>
    Nat.beq d₁ d₂ && Nat.beq a₁ a₂ && boolEq r₁ r₂ && Nat.beq n₁ n₂
  | .writePtrLe8 a₁ v₁ r₁ n₁, .writePtrLe8 a₂ v₂ r₂ n₂ =>
    Nat.beq a₁ a₂ && Nat.beq v₁ v₂ && boolEq r₁ r₂ && Nat.beq n₁ n₂
  | .copyNonOverlapping s₁ d₁ c₁ e₁ a₁ z₁ n₁,
    .copyNonOverlapping s₂ d₂ c₂ e₂ a₂ z₂ n₂ =>
    Nat.beq s₁ s₂ && Nat.beq d₁ d₂ && operandEq c₁ c₂ &&
      Nat.beq e₁ e₂ && Nat.beq a₁ a₂ && boolEq z₁ z₂ && Nat.beq n₁ n₂
  | .readBufRawByte td₁ vd₁ b₁ o₁ n₁, .readBufRawByte td₂ vd₂ b₂ o₂ n₂ =>
    Nat.beq td₁ td₂ && Nat.beq vd₁ vd₂ && Nat.beq b₁ b₂ &&
      operandEq o₁ o₂ && Nat.beq n₁ n₂
  | .writeBufRawByte b₁ o₁ t₁ v₁ n₁, .writeBufRawByte b₂ o₂ t₂ v₂ n₂ =>
    Nat.beq b₁ b₂ && operandEq o₁ o₂ && operandEq t₁ t₂ &&
      operandEq v₁ v₂ && Nat.beq n₁ n₂
  | _, _ => false

structure MemCopyBlock where
  statements : List MemCopyStmt
  terminator : MemCopyTerm
  cleanup : Bool := false

noncomputable def memCopyBlockEq (a b : MemCopyBlock) : Bool :=
  boolEq a.cleanup b.cleanup &&
    listRel memCopyStmtEq a.statements b.statements &&
    memCopyTermEq a.terminator b.terminator

structure MemCopyBody where
  argumentCount : Nat
  locals : List MemCopyLocalDecl
  basicBlocks : List MemCopyBlock
  isUnsafe : Bool := false
  identity : String := ""
  acceptsCallerMem : Bool := false

noncomputable def memCopyBodyEq (a b : MemCopyBody) : Bool :=
  Nat.beq a.argumentCount b.argumentCount &&
    listRel memCopyLocalDeclEq a.locals b.locals &&
    listRel memCopyBlockEq a.basicBlocks b.basicBlocks &&
    boolEq a.isUnsafe b.isUnsafe &&
    stringBeq a.identity b.identity &&
    boolEq a.acceptsCallerMem b.acceptsCallerMem

structure MemCopyProgram where
  bodies : List MemCopyBody
  entryDefId : DefId := 0
  pointerWidthBits : Nat
  mirProfileVersion : Nat
  scope : VerificationScope := .unit

noncomputable def memCopyProgramEq (a b : MemCopyProgram) : Bool :=
  listRel memCopyBodyEq a.bodies b.bodies &&
    Nat.beq a.entryDefId b.entryDefId &&
    Nat.beq a.pointerWidthBits b.pointerWidthBits &&
    Nat.beq a.mirProfileVersion b.mirProfileVersion &&
    scopeEq a.scope b.scope

/-- Canonical embedding of unmodified `Trusted.MirAst` into `M_memcopy`. -/
noncomputable def embedBaseBlock (bb : BasicBlock) : MemCopyBlock := {
  statements := bb.statements.map MemCopyStmt.baseStmt
  terminator := .baseTerm bb.terminator
  cleanup := bb.cleanup
}

noncomputable def embedBaseBody (b : Body) : MemCopyBody := {
  argumentCount := b.argumentCount
  locals := b.locals.map MemCopyLocalDecl.base
  basicBlocks := b.basicBlocks.map embedBaseBlock
  isUnsafe := b.isUnsafe
  identity := b.identity
  acceptsCallerMem := false
}

noncomputable def embedBaseProgram (p : Program) : MemCopyProgram := {
  bodies := p.bodies.map embedBaseBody
  entryDefId := p.entryDefId
  pointerWidthBits := p.pointerWidthBits
  mirProfileVersion := p.mirProfileVersion
  scope := p.scope
}

/-- Projection from a fully scalarized `MemCopyProgram` (`acceptsCallerMem = false`)
back to an unmodified `Trusted.MirAst.Program`. -/
noncomputable def unembedBaseBlock (bb : MemCopyBlock) : Option BasicBlock :=
  let stmts? := listMapOption (fun s =>
    match s with | .baseStmt st => some st | _ => none) bb.statements
  match stmts?, bb.terminator with
  | some stmts, .baseTerm t =>
    some { statements := stmts, terminator := t, cleanup := bb.cleanup }
  | _, _ => none

noncomputable def unembedBaseBody (b : MemCopyBody) : Option Body :=
  if b.acceptsCallerMem then
    none
  else
    let tys? := listMapOption (fun d =>
      match d with | .base ty => some ty | _ => none) b.locals
    let bbs? := listMapOption unembedBaseBlock b.basicBlocks
    match tys?, bbs? with
    | some tys, some bbs =>
      some {
        argumentCount := b.argumentCount
        locals := tys
        basicBlocks := bbs
        isUnsafe := b.isUnsafe
        identity := b.identity
      }
    | _, _ => none

noncomputable def unembedBaseProgram (p : MemCopyProgram) : Option Program :=
  match listMapOption unembedBaseBody p.bodies with
  | some bs =>
    some {
      bodies := bs
      entryDefId := p.entryDefId
      pointerWidthBits := p.pointerWidthBits
      mirProfileVersion := p.mirProfileVersion
      scope := p.scope
    }
  | none => none

/-! ### Pure Memory, Pointer Arithmetic, Endianness, & `copy_nonoverlapping` Kernel -/

/-- Find an `Allocation` by `AllocId` in `CallerMemory`. -/
noncomputable def findAlloc? (aid : AllocId) :
    List Allocation → Option Allocation
  | [] => none
  | a :: rest => if Nat.beq a.allocId aid then some a else findAlloc? aid rest

/-- Replace an `Allocation` by `AllocId` in `CallerMemory`. -/
noncomputable def updateAlloc? (aid : AllocId) (newAlloc : Allocation) :
    List Allocation → Option (List Allocation)
  | [] => none
  | a :: rest =>
    if Nat.beq a.allocId aid then
      some (newAlloc :: rest)
    else
      match updateAlloc? aid newAlloc rest with
      | some rest' => some (a :: rest')
      | none => none

/-- Strip internal frame `.byteBuf` allocations (`allocId ≥ internalAllocBase`)
when returning observable `CallerMemory` in `TerminalOut`. -/
noncomputable def projectExternalCallerMem (mem : CallerMemory) : CallerMemory :=
  ⟨mem.allocations.filter (fun a => Nat.blt a.allocId internalAllocBase)⟩

/-- Well-formedness of caller-supplied `CallerMemory`: external `AllocId`s
(`< internalAllocBase`), pairwise-distinct IDs, bounded sizes (`≤ maxIsize`),
and bounded alignments (`≤ 30`). -/
noncomputable def wfExternalCallerMem (mem : CallerMemory) : Bool :=
  natListPairwiseNe (mem.allocations.map (fun a => a.allocId)) &&
    mem.allocations.all (fun a =>
      Nat.blt a.allocId internalAllocBase &&
        Nat.ble a.alignLog2 30 &&
        Nat.ble a.bytes.length maxIsize)

/-- Null-pointer check (`allocId = none` and `offsetBytes = 0`). -/
noncomputable def isNullPtr (pv : PtrVal) : Bool :=
  match pv.allocId with
  | none => Nat.beq pv.offsetBytes.toNat 0
  | some _ => false

/-- Relative-provenance alignment check matching `Miri.Memory.Access.isPtrMisaligned`
(`vendor/lean-miri/Miri/Memory/Access.lean:218-221`):
- `allocId = none`: checks `offsetBytes % 2^reqAlignLog2 == 0`.
- `allocId = some aid`: checks `reqAlignLog2 ≤ alloc.alignLog2` AND
  `offsetBytes % 2^reqAlignLog2 == 0` (independent of `alloc.live`, matching
  `rustc_const_eval`'s `get_alloc_info` alignment query). -/
noncomputable def checkPtrAlignMem (mem : CallerMemory) (pv : PtrVal)
    (reqAlignLog2 : Nat) : Except FaultKind Unit :=
  if !Nat.ble reqAlignLog2 30 then
    .error .unsupported
  else
    let reqBytes := Nat.pow 2 reqAlignLog2
    let offAligned := Nat.beq (Nat.mod pv.offsetBytes.toNat reqBytes) 0
    match pv.allocId with
    | none =>
      if offAligned then .ok () else .error .undefined
    | some aid =>
      match findAlloc? aid mem.allocations with
      | none => .error .undefined
      | some alloc =>
        if Nat.ble reqAlignLog2 alloc.alignLog2 && offAligned then
          .ok ()
        else
          .error .undefined

/-- Provenance-preserving 64-bit wrapping pointer offset (`ptr.wrapping_offset` /
`ptr.wrapping_add`), wrapping `(offsetBytes + count * elemSize) mod 2^64`. -/
noncomputable def calcWrappingOffset (pv : PtrVal) (count : Int)
    (elemSize : Nat) : PtrVal :=
  let m : Int := Int.ofNat maxUsize
  let wrapped : Int :=
    intEmod (Int.ofNat pv.offsetBytes.toNat + count * Int.ofNat elemSize) m
  { pv with offsetBytes := UInt64.ofNat wrapped.toNat, width := .isize }

/-- In-bounds pointer arithmetic (`BinOp.offset` / `ptrOffsetInbounds`,
`vendor/lean-miri/Miri/Interpreter/PointerOffset.lean:14-21` &
`compiler/rustc_const_eval/src/interpret/operator.rs:326-357`). -/
noncomputable def calcInboundsOffset (mem : CallerMemory) (pv : PtrVal)
    (count : Int) (elemSize : Nat) : Except FaultKind PtrVal :=
  let delta : Int := count * Int.ofNat elemSize
  if decide (delta < minIsize) || decide (Int.ofNat maxIsize < delta) then
    .error .undefined
  else if delta == 0 then
    .ok { pv with width := .isize }
  else
    match pv.allocId with
    | none => .error .undefined
    | some aid =>
      match findAlloc? aid mem.allocations with
      | none => .error .undefined
      | some alloc =>
        if !alloc.live then
          .error .undefined
        else
          let off : Int := Int.ofNat pv.offsetBytes.toNat
          let len : Int := Int.ofNat alloc.bytes.length
          let newOff : Int := off + delta
          if decide (0 ≤ off) && decide (off ≤ len) &&
              decide (0 ≤ newOff) && decide (newOff ≤ len) then
            .ok { pv with offsetBytes := UInt64.ofNat newOff.toNat, width := .isize }
          else
            .error .undefined

/-- Encode the low `k` little-endian bytes of `n` with optional provenance `prov`. -/
noncomputable def encodeLeBytesAux (prov : Option AllocId) :
    Nat → Nat → List AllocByte
  | 0, _ => []
  | k + 1, n =>
    AllocByte.init (UInt8.ofNat (Nat.mod n 256)) prov ::
      encodeLeBytesAux prov k (Nat.div n 256)

noncomputable def encodeLeUsize (w : LeWidth) (n : Nat) : List AllocByte :=
  encodeLeBytesAux none w.byteCount n

/-- Decode a list of `AllocByte`s as a little-endian unsigned scalar integer,
faulting `.undefined` if any byte is `.uninit` (`InvalidUninitBytes`) or carries
`some provAid` pointer provenance (`ReadPointerAsInt`). -/
noncomputable def decodeLeBytesAux : List AllocByte → Except FaultKind Nat
  | [] => .ok 0
  | .uninit :: _ => .error .undefined
  | .init _ (some _) :: _ => .error .undefined
  | .init b none :: rest =>
    match decodeLeBytesAux rest with
    | .ok hi => .ok (b.toNat + 256 * hi)
    | .error k => .error k

noncomputable def decodeLeUsize (w : LeWidth) (bs : List AllocByte) :
    Except FaultKind Nat :=
  if !Nat.beq bs.length w.byteCount then
    .error .unsupported
  else
    decodeLeBytesAux bs

/-- Decode 8 `AllocByte`s as a 64-bit `PtrVal`, requiring all 8 bytes to be
initialized and carry identical `Option AllocId` provenance (`none` or the same
`some aid`). -/
noncomputable def decodePtrBytesAux (expectedProv : Option AllocId) :
    List AllocByte → Except FaultKind Nat
  | [] => .ok 0
  | .uninit :: _ => .error .undefined
  | .init b prov :: rest =>
    if optNatEq prov expectedProv then
      match decodePtrBytesAux expectedProv rest with
      | .ok hi => .ok (b.toNat + 256 * hi)
      | .error k => .error k
    else
      .error .undefined

noncomputable def decodePtrLe8 (bs : List AllocByte) :
    Except FaultKind PtrVal :=
  if !Nat.beq bs.length 8 then
    .error .unsupported
  else
    match bs with
    | .init _ prov₀ :: _ =>
      match decodePtrBytesAux prov₀ bs with
      | .ok offNat =>
        .ok { allocId := prov₀, offsetBytes := UInt64.ofNat offNat, width := .isize }
      | .error k => .error k
    | _ => .error .undefined

/-- Splice `newBytes` into `oldBytes` at offset `off` (caller checks
`off + newBytes.length ≤ oldBytes.length`). -/
noncomputable def spliceBytes (oldBytes : List AllocByte) (off : Nat)
    (newBytes : List AllocByte) : List AllocByte :=
  oldBytes.take off ++ newBytes ++ oldBytes.drop (off + newBytes.length)

/-- Read `len ≥ 1` bytes from a live allocation in `CallerMemory`. -/
noncomputable def readMemSlice (mem : CallerMemory) (pv : PtrVal)
    (len reqAlignLog2 : Nat) : Except FaultKind (List AllocByte) :=
  match checkPtrAlignMem mem pv reqAlignLog2 with
  | .error k => .error k
  | .ok () =>
    match pv.allocId with
    | none => .error .undefined
    | some aid =>
      match findAlloc? aid mem.allocations with
      | none => .error .undefined
      | some alloc =>
        let off := pv.offsetBytes.toNat
        if !alloc.live || !Nat.ble (off + len) alloc.bytes.length then
          .error .undefined
        else
          .ok ((alloc.bytes.drop off).take len)

/-- Write `newBytes` (`newBytes.length ≥ 1`) into a live `.mut` allocation in
`CallerMemory` (rejecting `.shared` immutable allocations!). -/
noncomputable def writeMemSlice (mem : CallerMemory) (pv : PtrVal)
    (newBytes : List AllocByte) (reqAlignLog2 : Nat) :
    Except FaultKind CallerMemory :=
  match checkPtrAlignMem mem pv reqAlignLog2 with
  | .error k => .error k
  | .ok () =>
    match pv.allocId with
    | none => .error .undefined
    | some aid =>
      match findAlloc? aid mem.allocations with
      | none => .error .undefined
      | some alloc =>
        let off := pv.offsetBytes.toNat
        if !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
            !Nat.ble (off + newBytes.length) alloc.bytes.length then
          .error .undefined
        else
          let updated : Allocation :=
            { alloc with bytes := spliceBytes alloc.bytes off newBytes }
          match updateAlloc? aid updated mem.allocations with
          | some allocs' => .ok ⟨allocs'⟩
          | none => .error .unsupported

/-- Pure operational kernel of `copy_nonoverlapping` matching
`compiler/rustc_const_eval/src/interpret/{intrinsics.rs:1096-1109, memory.rs:1484-1615}`
(`checkNonNullZero = false`) and `core::ptr::copy_nonoverlapping`
(`library/core/src/ptr/mod.rs:553-575`, `checkNonNullZero = true`). -/
noncomputable def evalCopyNonOverlapping (mem : CallerMemory)
    (pvSrc pvDst : PtrVal) (count elemSize reqAlignLog2 : Nat)
    (checkNonNullZero : Bool) : Except FaultKind CallerMemory :=
  let byteLen := elemSize * count
  if !Nat.ble reqAlignLog2 30 then
    .error .unsupported
  else if !Nat.ble byteLen maxIsize then
    .error .undefined
  else
    match checkPtrAlignMem mem pvSrc reqAlignLog2,
        checkPtrAlignMem mem pvDst reqAlignLog2 with
    | .error k, _ => .error k
    | _, .error k => .error k
    | .ok (), .ok () =>
      if checkNonNullZero && (isNullPtr pvSrc || isNullPtr pvDst) then
        .error .undefined
      else if Nat.beq byteLen 0 then
        .ok mem
      else
        match pvSrc.allocId, pvDst.allocId with
        | some srcAid, some dstAid =>
          match findAlloc? srcAid mem.allocations,
              findAlloc? dstAid mem.allocations with
          | some srcAlloc, some dstAlloc =>
            let srcOff := pvSrc.offsetBytes.toNat
            let dstOff := pvDst.offsetBytes.toNat
            let nonOverlap : Bool :=
              !Nat.beq srcAid dstAid ||
                Nat.ble (srcOff + byteLen) dstOff ||
                Nat.ble (dstOff + byteLen) srcOff
            if !srcAlloc.live || !dstAlloc.live ||
                !(Mutability.beq dstAlloc.mutability .mut) ||
                !Nat.ble (srcOff + byteLen) srcAlloc.bytes.length ||
                !Nat.ble (dstOff + byteLen) dstAlloc.bytes.length ||
                !nonOverlap then
              .error .undefined
            else
              let snap := (srcAlloc.bytes.drop srcOff).take byteLen
              let dstUpdated : Allocation :=
                { dstAlloc with bytes := spliceBytes dstAlloc.bytes dstOff snap }
              match updateAlloc? dstAid dstUpdated mem.allocations with
              | some allocs' => .ok ⟨allocs'⟩
              | none => .error .unsupported
          | _, _ => .error .undefined
        | _, _ => .error .undefined

/-! ### Runtime State & Small-Step Operational Semantics of `M_memcopy` -/

inductive MemCopySlot where
  | baseSlot (slot : LocalSlot)
  | bufSlot (live : Bool)
  | ptrDead
  | livePtr (val : Option PtrVal)

structure MemCopyFrame where
  defId : DefId
  blockIdx : BasicBlockId
  stmtIdx : Nat
  locals : List MemCopySlot

structure MemCopyState where
  frames : List MemCopyFrame
  mem : CallerMemory := ⟨[]⟩

noncomputable def embedMemCopyFrame (f : FrameState) : MemCopyFrame := {
  defId := f.defId
  blockIdx := f.blockIdx
  stmtIdx := f.stmtIdx
  locals := f.locals.map MemCopySlot.baseSlot
}

noncomputable def embedMemCopyState (s : State) : MemCopyState := {
  frames := s.frames.map embedMemCopyFrame
  mem := s.callerMem
}

noncomputable def liftStepResultMemCopy :
    StepResult State TerminalOut → StepResult MemCopyState TerminalOut
  | .step s => .step (embedMemCopyState s)
  | .done o => .done o
  | .fault k => .fault k

noncomputable def liveUninitMemCopySlot : MemCopyLocalDecl → MemCopySlot
  | .base ty => .baseSlot (liveUninitSlot ty)
  | .byteBuf _ _ _ => .bufSlot true
  | .ptrLocal => .livePtr none

noncomputable def deadMemCopySlot : MemCopyLocalDecl → MemCopySlot
  | .base _ => .baseSlot .dead
  | .byteBuf _ _ _ => .bufSlot false
  | .ptrLocal => .ptrDead

noncomputable def memCopyStmtHasStorageMarker (localId : LocalId) :
    MemCopyStmt → Bool
  | .baseStmt s => stmtHasStorageMarker localId s
  | _ => false

noncomputable def memCopyHasStorageAnnotation (body : MemCopyBody)
    (localId : LocalId) : Bool :=
  body.basicBlocks.any (fun bb =>
    bb.statements.any (memCopyStmtHasStorageMarker localId))

noncomputable def memCopyStorageAnnotationsInBounds (body : MemCopyBody) : Bool :=
  let n := body.locals.length
  body.basicBlocks.all (fun bb =>
    bb.statements.all (fun stmt =>
      match stmt with
      | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) =>
        Nat.blt id n
      | _ => true))

noncomputable def isSupportedMemCopyLocalDecl (argumentCount : Nat)
    (acceptsCallerMem : Bool) (idx : Nat) : MemCopyLocalDecl → Bool
  | .base ty => isSupportedScalarOrUnitTy ty
  | .byteBuf size alignLog2 _ =>
    Nat.blt argumentCount idx && Nat.ble size maxIsize && Nat.ble alignLog2 30
  | .ptrLocal =>
    if Nat.beq idx 0 then
      acceptsCallerMem
    else if Nat.ble idx argumentCount then
      acceptsCallerMem
    else
      true

noncomputable def allMemCopyLocalsSupported (argumentCount : Nat)
    (acceptsCallerMem : Bool) : Nat → List MemCopyLocalDecl → Bool
  | _, [] => true
  | idx, d :: rest =>
    isSupportedMemCopyLocalDecl argumentCount acceptsCallerMem idx d &&
      allMemCopyLocalsSupported argumentCount acceptsCallerMem (idx + 1) rest

noncomputable def checkMemCopyArgVal (acceptsCallerMem : Bool)
    (extMem : CallerMemory) : Val → MemCopyLocalDecl → Bool
  | v, .base ty => checkVal v ty
  | .ptr pv, .ptrLocal =>
    acceptsCallerMem && IntWidth.beq pv.width .isize &&
      match pv.allocId with
      | none => true
      | some aid =>
        Nat.blt aid internalAllocBase &&
          match findAlloc? aid extMem.allocations with
          | some _ => true
          | none => false
  | _, _ => false

noncomputable def checkMemCopyArgsMatch (acceptsCallerMem : Bool)
    (extMem : CallerMemory) : List Val → List MemCopyLocalDecl → Bool
  | [], [] => true
  | v :: vs, d :: ds =>
    checkMemCopyArgVal acceptsCallerMem extMem v d &&
      checkMemCopyArgsMatch acceptsCallerMem extMem vs ds
  | _, _ => false

noncomputable def initMemCopyLocalsLoop (body : MemCopyBody)
    (args : List Val) : Nat → List MemCopyLocalDecl → List MemCopySlot
  | _, [] => []
  | idx, decl :: rest =>
    let sl : MemCopySlot :=
      if Nat.beq idx 0 then
        liveUninitMemCopySlot decl
      else if Nat.ble idx body.argumentCount then
        match Trusted.MirSemantics.getElem? args (idx - 1), decl with
        | some (.ptr pv), .ptrLocal => .livePtr (some pv)
        | some v, .base _ => .baseSlot (.live (some v))
        | _, _ => deadMemCopySlot decl
      else if memCopyHasStorageAnnotation body idx then
        deadMemCopySlot decl
      else
        liveUninitMemCopySlot decl
    sl :: initMemCopyLocalsLoop body args (idx + 1) rest

noncomputable def buildInternalBufAllocs (body : MemCopyBody) :
    Nat → List MemCopyLocalDecl → List Allocation
  | _, [] => []
  | idx, .byteBuf size alignLog2 mutability :: rest =>
    let initLive := !memCopyHasStorageAnnotation body idx
    { allocId := internalAllocBase + idx
      alignLog2 := alignLog2
      mutability := mutability
      bytes := listReplicate size .uninit
      live := initLive } :: buildInternalBufAllocs body (idx + 1) rest
  | idx, _ :: rest => buildInternalBufAllocs body (idx + 1) rest

noncomputable def initStateMemCopy (p : MemCopyProgram) (q : Query) :
    Except FaultKind MemCopyState :=
  if !Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1 then
    .error .unsupported
  else
    match Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
    | none => .error .unsupported
    | some body =>
      if !body.acceptsCallerMem && !q.callerMem.allocations.isEmpty then
        .error .unsupported
      else if body.acceptsCallerMem && !wfExternalCallerMem q.callerMem then
        .error .unsupported
      else if body.basicBlocks.isEmpty then
        .error .unsupported
      else if !Nat.blt body.argumentCount body.locals.length then
        .error .unsupported
      else if !memCopyStorageAnnotationsInBounds body then
        .error .unsupported
      else if !allMemCopyLocalsSupported body.argumentCount
          body.acceptsCallerMem 0 body.locals then
        .error .unsupported
      else
        let paramDecls := (body.locals.drop 1).take body.argumentCount
        if !checkMemCopyArgsMatch body.acceptsCallerMem q.callerMem
            q.args paramDecls then
          .error .unsupported
        else
          let frame : MemCopyFrame := {
            defId := p.entryDefId
            blockIdx := 0
            stmtIdx := 0
            locals := initMemCopyLocalsLoop body q.args 0 body.locals
          }
          let intAllocs := buildInternalBufAllocs body 0 body.locals
          .ok {
            frames := [frame]
            mem := ⟨q.callerMem.allocations ++ intAllocs⟩
          }

/-- Base operand & rvalue evaluators in 1-to-1 lockstep with
`Trusted.MirSemantics`. -/
noncomputable def evalMemCopyBaseOperandToSlot
    (decls : List MemCopyLocalDecl) (slots : List MemCopySlot) :
    Operand → Except FaultKind (MirTy × Option Val × List MemCopySlot)
  | .copy place =>
    if !place.projection.isEmpty then
      .error .unsupported
    else
      match Trusted.MirSemantics.getElem? decls place.localId,
          Trusted.MirSemantics.getElem? slots place.localId with
      | some (.base ty), some (.baseSlot (.live optVal)) =>
        .ok (ty, optVal, slots)
      | some (.base _), some (.baseSlot .dead) =>
        .error .undefined
      | _, _ => .error .unsupported
  | .move place =>
    if !place.projection.isEmpty then
      .error .unsupported
    else
      match Trusted.MirSemantics.getElem? decls place.localId,
          Trusted.MirSemantics.getElem? slots place.localId with
      | some (.base ty), some (.baseSlot (.live optVal)) =>
        match setElem? slots place.localId (.baseSlot (liveUninitSlot ty)) with
        | some slots' => .ok (ty, optVal, slots')
        | none => .error .unsupported
      | some (.base _), some (.baseSlot .dead) =>
        .error .undefined
      | _, _ => .error .unsupported
  | .constant c =>
    match evalConstLit c.ty c.lit with
    | .ok v => .ok (c.ty, some v, slots)
    | .error k => .error k

noncomputable def evalMemCopyPrimitiveOperand
    (decls : List MemCopyLocalDecl) (slots : List MemCopySlot)
    (opnd : Operand) : Except FaultKind (Val × List MemCopySlot) :=
  match evalMemCopyBaseOperandToSlot decls slots opnd with
  | .error k => .error k
  | .ok (ty, optVal, slots') =>
    if !isPrimitiveReadableTy ty then
      .error .unsupported
    else
      match optVal with
      | some v => .ok (v, slots')
      | none => .error .undefined

noncomputable def evalUsizeOp (decls : List MemCopyLocalDecl)
    (slots : List MemCopySlot) (opnd : Operand) :
    Except FaultKind (Nat × List MemCopySlot) :=
  match evalMemCopyBaseOperandToSlot decls slots opnd with
  | .error k => .error k
  | .ok (srcTy, optVal, slots') =>
    if !(MirTy.beq srcTy usizeTy) then
      .error .unsupported
    else
      match optVal with
      | some (.scalar sv) =>
        if sv.wf then .ok (sv.bits.toNat, slots') else .error .unsupported
      | some _ => .error .unsupported
      | none => .error .undefined

/-- Evaluate a pointer-offset count operand accepting BOTH `usize` (`ptr.add`)
and `isize` (`ptr.offset`), matching `rustc_const_eval`'s `operator.rs:326-357`. -/
noncomputable def evalOffsetCountOp (decls : List MemCopyLocalDecl)
    (slots : List MemCopySlot) (opnd : Operand) :
    Except FaultKind (Int × List MemCopySlot) :=
  match evalMemCopyBaseOperandToSlot decls slots opnd with
  | .error k => .error k
  | .ok (srcTy, optVal, slots') =>
    if !(MirTy.beq srcTy usizeTy) && !(MirTy.beq srcTy isizeTy) then
      .error .unsupported
    else
      match optVal with
      | some (.scalar sv) =>
        if sv.wf then .ok (decodeScalar sv, slots') else .error .unsupported
      | some _ => .error .unsupported
      | none => .error .undefined

noncomputable def evalMemCopyBaseRvalue
    (decls : List MemCopyLocalDecl) (slots : List MemCopySlot)
    (dstTy : MirTy) : Rvalue → Except FaultKind (Val × List MemCopySlot)
  | .use opnd =>
    match evalMemCopyBaseOperandToSlot decls slots opnd with
    | .error k => .error k
    | .ok (srcTy, optVal, slots₁) =>
      if !(MirTy.beq srcTy dstTy) then
        .error .unsupported
      else
        match optVal with
        | some v => .ok (v, slots₁)
        | none => .error .undefined
  | .binaryOp op lhs rhs =>
    match evalMemCopyPrimitiveOperand decls slots lhs with
    | .error k => .error k
    | .ok (lVal, slots₁) =>
      match evalMemCopyPrimitiveOperand decls slots₁ rhs with
      | .error k => .error k
      | .ok (rVal, slots₂) =>
        match evalBinOp op lVal rVal with
        | .error k => .error k
        | .ok res => .ok (res, slots₂)
  | .unaryOp op opnd =>
    match evalMemCopyPrimitiveOperand decls slots opnd with
    | .error k => .error k
    | .ok (v, slots₁) =>
      match evalUnOp op v with
      | .error k => .error k
      | .ok res => .ok (res, slots₁)
  | .discriminant place =>
    if !place.projection.isEmpty then
      .error .unsupported
    else
      match Trusted.MirSemantics.getElem? decls place.localId,
          Trusted.MirSemantics.getElem? slots place.localId with
      | some (.base (.enum ety)), some (.baseSlot slot) =>
        if !enumAdmitted ety then
          .error .unsupported
        else
          match ety.tagRepr, slot with
          | _, .dead => .error .undefined
          | .zeroSized, .live none =>
            match Trusted.MirSemantics.getElem? ety.discriminants 0 with
            | some disc =>
              .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩, slots)
            | none => .error .unsupported
          | .zeroSized, .live (some (.enumVal ety' v)) =>
            if EnumTy.beq ety ety' && Nat.beq v 0 then
              match Trusted.MirSemantics.getElem? ety.discriminants 0 with
              | some disc =>
                .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                  truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩, slots)
              | none => .error .unsupported
            else
              .error .unsupported
          | .zeroSized, .live (some _) => .error .unsupported
          | .scalar _ _, .live none => .error .undefined
          | .scalar _ _, .live (some (.enumVal ety' v)) =>
            if EnumTy.beq ety ety' && Nat.blt v ety.discriminants.length then
              match Trusted.MirSemantics.getElem? ety.discriminants v with
              | some disc =>
                .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                  truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩, slots)
              | none => .error .unsupported
            else
              .error .unsupported
          | .scalar _ _, .live (some _) => .error .unsupported
      | _, _ => .error .unsupported
  | _ => .error .unsupported

noncomputable def writeMemCopyBasePlace (slots : List MemCopySlot)
    (dstLocalId : LocalId) (dstTy : MirTy) (val : Val) :
    Except FaultKind (List MemCopySlot) :=
  if !checkVal val dstTy then
    .error .unsupported
  else
    match Trusted.MirSemantics.getElem? slots dstLocalId with
    | none => .error .unsupported
    | some (.baseSlot .dead) => .error .undefined
    | some (.baseSlot (.live _)) =>
      match setElem? slots dstLocalId (.baseSlot (.live (some val))) with
      | some slots' => .ok slots'
      | none => .error .unsupported
    | some _ => .error .unsupported

noncomputable def readPtrLocal (decls : List MemCopyLocalDecl)
    (slots : List MemCopySlot) (ptrLocal : LocalId) (isMove : Bool) :
    Except FaultKind (PtrVal × List MemCopySlot) :=
  match Trusted.MirSemantics.getElem? decls ptrLocal,
      Trusted.MirSemantics.getElem? slots ptrLocal with
  | some .ptrLocal, some (.livePtr (some pv)) =>
    if isMove then
      match setElem? slots ptrLocal (.livePtr none) with
      | some slots' => .ok (pv, slots')
      | none => .error .unsupported
    else
      .ok (pv, slots)
  | some .ptrLocal, some (.livePtr none) => .error .undefined
  | some .ptrLocal, some .ptrDead => .error .undefined
  | _, _ => .error .unsupported

noncomputable def writePtrLocal (decls : List MemCopyLocalDecl)
    (slots : List MemCopySlot) (dstPtr : LocalId) (pv : PtrVal) :
    Except FaultKind (List MemCopySlot) :=
  match Trusted.MirSemantics.getElem? decls dstPtr,
      Trusted.MirSemantics.getElem? slots dstPtr with
  | some .ptrLocal, some (.livePtr _) =>
    match setElem? slots dstPtr (.livePtr (some { pv with width := .isize })) with
    | some slots' => .ok slots'
    | none => .error .unsupported
  | some .ptrLocal, some .ptrDead => .error .undefined
  | _, _ => .error .unsupported

noncomputable def stepMemCopyNext (frame : MemCopyFrame) (mem : CallerMemory)
    (locals' : List MemCopySlot) : StepResult MemCopyState TerminalOut :=
  .step {
    frames := [{ frame with stmtIdx := frame.stmtIdx + 1, locals := locals' }]
    mem := mem
  }

noncomputable def jumpMemCopyBlock (frame : MemCopyFrame) (mem : CallerMemory)
    (locals' : List MemCopySlot) (target : BasicBlockId) :
    StepResult MemCopyState TerminalOut :=
  .step {
    frames := [{ frame with blockIdx := target, stmtIdx := 0, locals := locals' }]
    mem := mem
  }

/-- Evaluate a `MemCopyStmt` in `M_memcopy`. -/
noncomputable def evalMemCopyStmt (body : MemCopyBody)
    (frame : MemCopyFrame) (mem : CallerMemory) :
    MemCopyStmt → StepResult MemCopyState TerminalOut
  | .baseStmt .nop => stepMemCopyNext frame mem frame.locals
  | .baseStmt .unsupported => .fault .unsupported
  | .baseStmt (.storageLive id) =>
    match Trusted.MirSemantics.getElem? body.locals id with
    | none => .fault .unsupported
    | some decl =>
      match setElem? frame.locals id (liveUninitMemCopySlot decl) with
      | none => .fault .unsupported
      | some slots' =>
        match decl with
        | .byteBuf size alignLog2 mutability =>
          let aid := internalAllocBase + id
          let fresh : Allocation := {
            allocId := aid
            alignLog2 := alignLog2
            mutability := mutability
            bytes := listReplicate size .uninit
            live := true
          }
          match updateAlloc? aid fresh mem.allocations with
          | some allocs' => stepMemCopyNext frame ⟨allocs'⟩ slots'
          | none => .fault .unsupported
        | _ => stepMemCopyNext frame mem slots'
  | .baseStmt (.storageDead id) =>
    if Nat.beq id 0 then
      .fault .unsupported
    else
      let decl? := Trusted.MirSemantics.getElem? body.locals id
      let deadSlot : MemCopySlot :=
        match decl? with
        | some d => deadMemCopySlot d
        | none => .baseSlot .dead
      match setElem? frame.locals id deadSlot with
      | none => .fault .unsupported
      | some slots' =>
        match decl? with
        | some (.byteBuf size alignLog2 mutability) =>
          let aid := internalAllocBase + id
          let deadAlloc : Allocation := {
            allocId := aid
            alignLog2 := alignLog2
            mutability := mutability
            bytes := listReplicate size .uninit
            live := false
          }
          match updateAlloc? aid deadAlloc mem.allocations with
          | some allocs' => stepMemCopyNext frame ⟨allocs'⟩ slots'
          | none => .fault .unsupported
        | _ => stepMemCopyNext frame mem slots'
  | .baseStmt (.assign dst rval) =>
    if !dst.projection.isEmpty then
      .fault .unsupported
    else
      match Trusted.MirSemantics.getElem? body.locals dst.localId with
      | some (.base dstTy) =>
        match evalMemCopyBaseRvalue body.locals frame.locals dstTy rval with
        | .error k => .fault k
        | .ok (val, slotsAfterRval) =>
          match writeMemCopyBasePlace slotsAfterRval dst.localId dstTy val with
          | .error k => .fault k
          | .ok slots' => stepMemCopyNext frame mem slots'
      | _ => .fault .unsupported
  | .bufLivenessCheck bufLocal =>
    match Trusted.MirSemantics.getElem? body.locals bufLocal,
        Trusted.MirSemantics.getElem? frame.locals bufLocal with
    | some (.byteBuf _ _ _), some (.bufSlot true) =>
      stepMemCopyNext frame mem frame.locals
    | some (.byteBuf _ _ _), some (.bufSlot false) =>
      .fault .undefined
    | _, _ => .fault .unsupported
  | .mkNullPtr dstPtr =>
    match writePtrLocal body.locals frame.locals dstPtr
        { allocId := none, offsetBytes := 0, width := .isize } with
    | .ok slots' => stepMemCopyNext frame mem slots'
    | .error k => .fault k
  | .mkDanglingPtr dstPtr alignLog2 =>
    if !Nat.ble alignLog2 30 then
      .fault .unsupported
    else
      match writePtrLocal body.locals frame.locals dstPtr
          { allocId := none
            offsetBytes := UInt64.ofNat (Nat.pow 2 alignLog2)
            width := .isize } with
      | .ok slots' => stepMemCopyNext frame mem slots'
      | .error k => .fault k
  | .addrOfByteBuf dstPtr bufLocal =>
    match Trusted.MirSemantics.getElem? body.locals bufLocal,
        Trusted.MirSemantics.getElem? frame.locals bufLocal with
    | some (.byteBuf _ _ _), some (.bufSlot true) =>
      let pv : PtrVal := {
        allocId := some (internalAllocBase + bufLocal)
        offsetBytes := 0
        width := .isize
      }
      match writePtrLocal body.locals frame.locals dstPtr pv with
      | .ok slots' => stepMemCopyNext frame mem slots'
      | .error k => .fault k
    | some (.byteBuf _ _ _), some (.bufSlot false) =>
      match Trusted.MirSemantics.getElem? body.locals dstPtr with
      | some .ptrLocal => .fault .undefined
      | _ => .fault .unsupported
    | _, _ => .fault .unsupported
  | .copyPtr dstPtr srcPtr isMove =>
    match readPtrLocal body.locals frame.locals srcPtr isMove with
    | .error k => .fault k
    | .ok (pv, slots₁) =>
      match writePtrLocal body.locals slots₁ dstPtr pv with
      | .ok slots₂ => stepMemCopyNext frame mem slots₂
      | .error k => .fault k
  | .ptrWrappingOffset dstPtr srcPtr countOp elemSize =>
    match evalOffsetCountOp body.locals frame.locals countOp with
    | .error k => .fault k
    | .ok (count, slots₁) =>
      match readPtrLocal body.locals slots₁ srcPtr false with
      | .error k => .fault k
      | .ok (pv, slots₂) =>
        let pv' := calcWrappingOffset pv count elemSize
        match writePtrLocal body.locals slots₂ dstPtr pv' with
        | .ok slots₃ => stepMemCopyNext frame mem slots₃
        | .error k => .fault k

/-- Canonical `(tag, val)` representation of an `AllocByte` in flat `usize`
storage:
- `.uninit` -> `(0, 0)`
- `.init b none` -> `(1, b.toNat)`
- `.init b (some aid)` -> `(2 + aid, b.toNat)` -/
noncomputable def encodeAllocByte : AllocByte → Nat × Nat
  | .uninit => (0, 0)
  | .init b none => (1, b.toNat)
  | .init b (some aid) => (2 + aid, b.toNat)

/-- Total inverse from `(tag, val)` (`usize` scalars) to `AllocByte`. -/
noncomputable def decodeAllocByte (tag val : Nat) : AllocByte :=
  if Nat.beq tag 0 then
    .uninit
  else if Nat.beq tag 1 then
    .init (UInt8.ofNat (Nat.mod val 256)) none
  else
    .init (UInt8.ofNat (Nat.mod val 256)) (some (tag - 2))

/-- Evaluate a `MemCopyTerm` in `M_memcopy`. -/
noncomputable def evalMemCopyTerm (body : MemCopyBody) (bb : MemCopyBlock)
    (frame : MemCopyFrame) (mem : CallerMemory) :
    StepResult MemCopyState TerminalOut :=
  match bb.terminator with
  | .baseTerm (.goto target) => jumpMemCopyBlock frame mem frame.locals target
  | .baseTerm .return_ =>
    if bb.cleanup then
      .fault .unsupported
    else
      let hasInternalBufs := body.locals.any (fun d =>
        match d with | .byteBuf _ _ _ => true | _ => false)
      let extMem :=
        if body.acceptsCallerMem || hasInternalBufs then
          projectExternalCallerMem mem
        else
          mem
      match Trusted.MirSemantics.getElem? body.locals 0,
          Trusted.MirSemantics.getElem? frame.locals 0 with
      | some (.base _), some (.baseSlot (.live (some retVal)))
      | none, some (.baseSlot (.live (some retVal))) =>
        .done (.returned ⟨retVal, extMem⟩)
      | some .ptrLocal, some (.livePtr (some pv)) =>
        if !body.acceptsCallerMem then
          .fault .unsupported
        else
          match pv.allocId with
          | some aid =>
            if !Nat.blt aid internalAllocBase then
              .fault .undefined -- Returning dangling pointer to dead frame buffer!
            else
              .done (.returned ⟨.ptr pv, extMem⟩)
          | none => .done (.returned ⟨.ptr pv, extMem⟩)
      | some (.base _), some (.baseSlot (.live none))
      | some (.base _), some (.baseSlot .dead)
      | none, some (.baseSlot (.live none))
      | none, some (.baseSlot .dead)
      | some .ptrLocal, some (.livePtr none)
      | some .ptrLocal, some .ptrDead =>
        .fault .undefined
      | _, _ => .fault .unsupported
  | .baseTerm .unreachable => .fault .undefined
  | .baseTerm (.switchInt discr targets) =>
    match evalMemCopyPrimitiveOperand body.locals frame.locals discr with
    | .error k => .fault k
    | .ok (discrVal, slots₁) =>
      let targetRes : Except FaultKind BasicBlockId :=
        match discrVal with
        | .scalar sv =>
          evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches
        | .bool b =>
          evalBoolSwitchBranches b targets.otherwise targets.branches
        | _ => .error .unsupported
      match targetRes with
      | .error k => .fault k
      | .ok target => jumpMemCopyBlock frame mem slots₁ target
  | .baseTerm .unwindResume
  | .baseTerm (.assert _ _ _ _ _)
  | .baseTerm (.call _ _ _ _ _)
  | .baseTerm .unsupported =>
    .fault .unsupported
  | .ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb =>
    match evalOffsetCountOp body.locals frame.locals countOp with
    | .error k => .fault k
    | .ok (count, slots₁) =>
      match readPtrLocal body.locals slots₁ srcPtr false with
      | .error k => .fault k
      | .ok (pv, slots₂) =>
        match calcInboundsOffset mem pv count elemSize with
        | .error k => .fault k
        | .ok pv' =>
          match writePtrLocal body.locals slots₂ dstPtr pv' with
          | .error k => .fault k
          | .ok slots₃ => jumpMemCopyBlock frame mem slots₃ nextBb
  | .checkPtrPairAlign srcPtr dstPtr _elemSize reqAlignLog2 checkNonNullZero nextBb =>
    if !Nat.ble reqAlignLog2 30 then
      .fault .unsupported
    else
      match readPtrLocal body.locals frame.locals srcPtr false with
      | .error k => .fault k
      | .ok (pvSrc, slots₁) =>
        match readPtrLocal body.locals slots₁ dstPtr false with
        | .error k => .fault k
        | .ok (pvDst, slots₂) =>
          match checkPtrAlignMem mem pvSrc reqAlignLog2,
              checkPtrAlignMem mem pvDst reqAlignLog2 with
          | .error k, _ => .fault k
          | _, .error k => .fault k
          | .ok (), .ok () =>
            if checkNonNullZero && (isNullPtr pvSrc || isNullPtr pvDst) then
              .fault .undefined
            else
              jumpMemCopyBlock frame mem slots₂ nextBb
  | .readLeUsize dstLocal ptrLocal w requireAligned nextBb =>
    match Trusted.MirSemantics.getElem? body.locals dstLocal with
    | some (.base dstTy) =>
      if !(MirTy.beq dstTy usizeTy) then
        .fault .unsupported
      else
        match readPtrLocal body.locals frame.locals ptrLocal false with
        | .error k => .fault k
        | .ok (pv, slots₁) =>
          let reqAlign := if requireAligned then w.naturalAlignLog2 else 0
          match readMemSlice mem pv w.byteCount reqAlign with
          | .error k => .fault k
          | .ok bs =>
            match decodeLeUsize w bs with
            | .error k => .fault k
            | .ok valNat =>
              let v : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 valNat⟩
              match writeMemCopyBasePlace slots₁ dstLocal usizeTy v with
              | .error k => .fault k
              | .ok slots₂ => jumpMemCopyBlock frame mem slots₂ nextBb
    | _ => .fault .unsupported
  | .writeLeUsize ptrLocal valOp w requireAligned nextBb =>
    match evalUsizeOp body.locals frame.locals valOp with
    | .error k => .fault k
    | .ok (valNat, slots₁) =>
      match readPtrLocal body.locals slots₁ ptrLocal false with
      | .error k => .fault k
      | .ok (pv, slots₂) =>
        let reqAlign := if requireAligned then w.naturalAlignLog2 else 0
        let encoded := encodeLeUsize w valNat
        match writeMemSlice mem pv encoded reqAlign with
        | .error k => .fault k
        | .ok mem' => jumpMemCopyBlock frame mem' slots₂ nextBb
  | .readPtrLe8 dstPtr addrPtr requireAligned nextBb =>
    match Trusted.MirSemantics.getElem? body.locals dstPtr with
    | some .ptrLocal =>
      match readPtrLocal body.locals frame.locals addrPtr false with
      | .error k => .fault k
      | .ok (pvAddr, slots₁) =>
        let reqAlign := if requireAligned then 3 else 0
        match readMemSlice mem pvAddr 8 reqAlign with
        | .error k => .fault k
        | .ok bs =>
          match decodePtrLe8 bs with
          | .error k => .fault k
          | .ok pvOut =>
            match writePtrLocal body.locals slots₁ dstPtr pvOut with
            | .error k => .fault k
            | .ok slots₂ => jumpMemCopyBlock frame mem slots₂ nextBb
    | _ => .fault .unsupported
  | .writePtrLe8 addrPtr valPtr requireAligned nextBb =>
    match readPtrLocal body.locals frame.locals addrPtr false with
    | .error k => .fault k
    | .ok (pvAddr, slots₁) =>
      match readPtrLocal body.locals slots₁ valPtr false with
      | .error k => .fault k
      | .ok (pvVal, slots₂) =>
        let reqAlign := if requireAligned then 3 else 0
        let bs := encodeLeBytesAux pvVal.allocId 8 pvVal.offsetBytes.toNat
        match writeMemSlice mem pvAddr bs reqAlign with
        | .error k => .fault k
        | .ok mem' => jumpMemCopyBlock frame mem' slots₂ nextBb
  | .copyNonOverlapping srcPtr dstPtr countOp elemSize reqAlignLog2
      checkNonNullZero nextBb =>
    if !Nat.ble reqAlignLog2 30 then
      .fault .unsupported
    else
      match evalUsizeOp body.locals frame.locals countOp with
      | .error k => .fault k
      | .ok (count, slots₁) =>
        match readPtrLocal body.locals slots₁ srcPtr false with
        | .error k => .fault k
        | .ok (pvSrc, slots₂) =>
          match readPtrLocal body.locals slots₂ dstPtr false with
          | .error k => .fault k
          | .ok (pvDst, slots₃) =>
            match evalCopyNonOverlapping mem pvSrc pvDst count elemSize
                reqAlignLog2 checkNonNullZero with
            | .error k => .fault k
            | .ok mem' => jumpMemCopyBlock frame mem' slots₃ nextBb
  | .readBufRawByte tagDst valDst bufLocal offOp nextBb =>
    if Nat.beq tagDst valDst then
      .fault .unsupported
    else
      match Trusted.MirSemantics.getElem? body.locals tagDst,
          Trusted.MirSemantics.getElem? body.locals valDst,
          Trusted.MirSemantics.getElem? body.locals bufLocal with
      | some (.base tTy), some (.base vTy), some (.byteBuf _ _ _) =>
        if !(MirTy.beq tTy usizeTy) || !(MirTy.beq vTy usizeTy) then
          .fault .unsupported
        else
          match evalUsizeOp body.locals frame.locals offOp with
          | .error k => .fault k
          | .ok (off, slots₁) =>
            match Trusted.MirSemantics.getElem? slots₁ bufLocal with
            | some (.bufSlot false) => .fault .undefined
            | some (.bufSlot true) =>
              match findAlloc? (internalAllocBase + bufLocal) mem.allocations with
              | none => .fault .unsupported
              | some alloc =>
                if !alloc.live then
                  .fault .undefined
                else
                  match Trusted.MirSemantics.getElem? alloc.bytes off with
                  | none => .fault .undefined
                  | some ab =>
                    let (tNat, vNat) := encodeAllocByte ab
                    if !Nat.blt tNat maxUsize then
                      .fault .unsupported
                    else
                      let tVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 tNat⟩
                      let vVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 vNat⟩
                      match writeMemCopyBasePlace slots₁ tagDst usizeTy tVal with
                      | .error k => .fault k
                      | .ok slots₂ =>
                        match writeMemCopyBasePlace slots₂ valDst usizeTy vVal with
                        | .error k => .fault k
                        | .ok slots₃ => jumpMemCopyBlock frame mem slots₃ nextBb
            | _ => .fault .unsupported
      | _, _, _ => .fault .unsupported
  | .writeBufRawByte bufLocal offOp tagOp valOp nextBb =>
    match Trusted.MirSemantics.getElem? body.locals bufLocal with
    | some (.byteBuf _ _ _) =>
      match evalUsizeOp body.locals frame.locals offOp with
      | .error k => .fault k
      | .ok (off, slots₁) =>
        match evalUsizeOp body.locals slots₁ tagOp with
        | .error k => .fault k
        | .ok (tNat, slots₂) =>
          match evalUsizeOp body.locals slots₂ valOp with
          | .error k => .fault k
          | .ok (vNat, slots₃) =>
            match Trusted.MirSemantics.getElem? slots₃ bufLocal with
            | some (.bufSlot false) => .fault .undefined
            | some (.bufSlot true) =>
              let aid := internalAllocBase + bufLocal
              match findAlloc? aid mem.allocations with
              | none => .fault .unsupported
              | some alloc =>
                if !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
                    !Nat.blt off alloc.bytes.length then
                  .fault .undefined
                else
                  let ab := decodeAllocByte tNat vNat
                  let updated : Allocation :=
                    { alloc with bytes := spliceBytes alloc.bytes off [ab] }
                  match updateAlloc? aid updated mem.allocations with
                  | some allocs' => jumpMemCopyBlock frame ⟨allocs'⟩ slots₃ nextBb
                  | none => .fault .unsupported
            | _ => .fault .unsupported
    | _ => .fault .unsupported

/-- Total single-step evaluator `evalStepMemCopy` of `M_memcopy`. -/
noncomputable def evalStepMemCopy (p : MemCopyProgram) (_c : Choice)
    (s : MemCopyState) : StepResult MemCopyState TerminalOut :=
  match s.frames with
  | [frame] =>
    match Trusted.MirSemantics.getElem? p.bodies frame.defId with
    | none => .fault .unsupported
    | some body =>
      match Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
      | none => .fault .unsupported
      | some bb =>
        match Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
        | some stmt => evalMemCopyStmt body frame s.mem stmt
        | none =>
          if Nat.beq frame.stmtIdx bb.statements.length then
            evalMemCopyTerm body bb frame s.mem
          else
            .fault .unsupported
  | _ => .fault .unsupported

/-! ### Top-Level Execution & Verification Judgments of `M_memcopy` -/

noncomputable def ValidChoiceMemCopy (_p : MemCopyProgram)
    (_s : MemCopyState) (c : Choice) : Prop :=
  c = 0

noncomputable def StepMemCopy (p : MemCopyProgram) (s : MemCopyState)
    (res : StepResult MemCopyState TerminalOut) : Prop :=
  ∃ c : Choice, ValidChoiceMemCopy p s c ∧ evalStepMemCopy p c s = res

inductive ReachesMemCopy (p : MemCopyProgram) :
    MemCopyState → MemCopyState → Prop where
  | refl (s : MemCopyState) : ReachesMemCopy p s s
  | tail {s₁ s₂ s₃ : MemCopyState} :
      ReachesMemCopy p s₁ s₂ →
      StepMemCopy p s₂ (.step s₃) →
      ReachesMemCopy p s₁ s₃

noncomputable def ReachesResultMemCopy (p : MemCopyProgram) (q : Query)
    (res : StepResult MemCopyState TerminalOut) : Prop :=
  match initStateMemCopy p q with
  | .error k => res = .fault k
  | .ok s₀ => ∃ s : MemCopyState, ReachesMemCopy p s₀ s ∧ StepMemCopy p s res

noncomputable def WellFormedMemCopy (p : MemCopyProgram) (q : Query) : Prop :=
  (∃ s₀ : MemCopyState, initStateMemCopy p q = .ok s₀ ∧
    ∀ s : MemCopyState, ReachesMemCopy p s₀ s →
      ∃ c : Choice, ValidChoiceMemCopy p s c) ∧
  (∀ k : FaultKind, ¬ ReachesResultMemCopy p q (.fault k))

noncomputable def BehaviorMemCopy (p : MemCopyProgram) (q : Query)
    (out : TerminalOut) : Prop :=
  ReachesResultMemCopy p q (.done out)

noncomputable def stepChainFromMemCopy (p : MemCopyProgram) :
    Nat → MemCopyState → Option MemCopyState
  | 0, s => some s
  | n + 1, s =>
    match evalStepMemCopy p 0 s with
    | .step s' => stepChainFromMemCopy p n s'
    | _ => none

noncomputable def DivergesMemCopy (p : MemCopyProgram) (q : Query) : Prop :=
  ∃ s₀ : MemCopyState, initStateMemCopy p q = .ok s₀ ∧
    ∀ n : Nat, ∃ sₙ : MemCopyState, stepChainFromMemCopy p n s₀ = some sₙ

noncomputable def SatisfiesPostMemCopy (p : MemCopyProgram) (q : Query)
    (post : TerminalOut → Prop) : Prop :=
  WellFormedMemCopy p q ∧ ∀ out : TerminalOut, BehaviorMemCopy p q out → post out

noncomputable def FullSemanticEquivMemCopy (p₁ p₂ : MemCopyProgram) : Prop :=
  (∀ q : Query, WellFormedMemCopy p₁ q ↔ WellFormedMemCopy p₂ q) ∧
  (∀ q : Query, ∀ out : TerminalOut,
    BehaviorMemCopy p₁ q out ↔ BehaviorMemCopy p₂ q out) ∧
  (∀ q : Query, ∀ k : FaultKind,
    ReachesResultMemCopy p₁ q (.fault k) ↔
      ReachesResultMemCopy p₂ q (.fault k)) ∧
  (∀ q : Query, DivergesMemCopy p₁ q ↔ DivergesMemCopy p₂ q) ∧
  (∀ q : Query, ∀ post : TerminalOut → Prop,
    SatisfiesPostMemCopy p₁ q post ↔ SatisfiesPostMemCopy p₂ q post)

noncomputable def FullSemanticEquivBase (p₁ p₂ : Program) : Prop :=
  (∀ q : Query, WellFormed p₁ q ↔ WellFormed p₂ q) ∧
  (∀ q : Query, ∀ out : TerminalOut, Behavior p₁ q out ↔ Behavior p₂ q out) ∧
  (∀ q : Query, ∀ k : FaultKind,
    ReachesResult p₁ q (.fault k) ↔ ReachesResult p₂ q (.fault k)) ∧
  (∀ q : Query, Diverges p₁ q ↔ Diverges p₂ q) ∧
  (∀ q : Query, ∀ post : TerminalOut → Prop,
    SatisfiesPost p₁ q post ↔ SatisfiesPost p₂ q post)


/-! ## Part II: Certified `FoldZeroOffset`, `FoldGuardedZeroCopy`, `PtrScalarize`, & `BufScalarize` -/

/-! ### Common Well-Scopedness Predicates -/

noncomputable def operandLocalsInBounds (n : Nat) : Operand → Bool
  | .copy p | .move p => Nat.blt p.localId n
  | .constant _ => true

noncomputable def rvalueLocalsInBounds (n : Nat) : Rvalue → Bool
  | .use o | .unaryOp _ o => operandLocalsInBounds n o
  | .binaryOp _ l r => operandLocalsInBounds n l && operandLocalsInBounds n r
  | .discriminant p | .ref _ p | .addressOf _ p => Nat.blt p.localId n
  | .aggregateTuple os => os.all (operandLocalsInBounds n)
  | .unsupported => true

noncomputable def baseStmtLocalsInBounds (n : Nat) : StatementKind → Bool
  | .assign dst rv => Nat.blt dst.localId n && rvalueLocalsInBounds n rv
  | .storageLive id | .storageDead id => Nat.blt id n
  | .nop | .unsupported => true

noncomputable def memCopyStmtLocalsInBounds (n : Nat) : MemCopyStmt → Bool
  | .baseStmt s => baseStmtLocalsInBounds n s
  | .bufLivenessCheck b => Nat.blt b n
  | .mkNullPtr d | .mkDanglingPtr d _ => Nat.blt d n
  | .addrOfByteBuf d b => Nat.blt d n && Nat.blt b n
  | .copyPtr d s _ => Nat.blt d n && Nat.blt s n
  | .ptrWrappingOffset d s c _ =>
    Nat.blt d n && Nat.blt s n && operandLocalsInBounds n c

noncomputable def memCopyTermLocalsInBounds (n : Nat) : MemCopyTerm → Bool
  | .baseTerm (.goto _) | .baseTerm .return_ | .baseTerm .unreachable
  | .baseTerm .unwindResume | .baseTerm .unsupported => true
  | .baseTerm (.switchInt d _) => operandLocalsInBounds n d
  | .baseTerm (.assert c _ _ _ _) => operandLocalsInBounds n c
  | .baseTerm (.call _ args dst _ _) =>
    Nat.blt dst.localId n && args.all (operandLocalsInBounds n)
  | .ptrOffsetInbounds d s c _ _ =>
    Nat.blt d n && Nat.blt s n && operandLocalsInBounds n c
  | .checkPtrPairAlign s d _ _ _ _ => Nat.blt s n && Nat.blt d n
  | .readLeUsize d p _ _ _ => Nat.blt d n && Nat.blt p n
  | .writeLeUsize p v _ _ _ => Nat.blt p n && operandLocalsInBounds n v
  | .readPtrLe8 d a _ _ | .writePtrLe8 a d _ _ => Nat.blt d n && Nat.blt a n
  | .copyNonOverlapping s d c _ _ _ _ =>
    Nat.blt s n && Nat.blt d n && operandLocalsInBounds n c
  | .readBufRawByte td vd b o _ =>
    Nat.blt td n && Nat.blt vd n && Nat.blt b n && operandLocalsInBounds n o
  | .writeBufRawByte b o t v _ =>
    Nat.blt b n && operandLocalsInBounds n o &&
      operandLocalsInBounds n t && operandLocalsInBounds n v

noncomputable def memCopyBodyLocalsInBounds (body : MemCopyBody) : Bool :=
  let n := body.locals.length
  body.basicBlocks.all (fun bb =>
    bb.statements.all (memCopyStmtLocalsInBounds n) &&
      memCopyTermLocalsInBounds n bb.terminator)

noncomputable def memCopyTermTargetsInBounds (numBbs : Nat) :
    MemCopyTerm → Bool
  | .baseTerm (.goto t) => Nat.blt t numBbs
  | .baseTerm (.switchInt _ ts) =>
    Nat.blt ts.otherwise numBbs &&
      ts.branches.all (fun br => Nat.blt br.2 numBbs)
  | .baseTerm .return_ | .baseTerm .unreachable
  | .baseTerm .unwindResume | .baseTerm .unsupported => true
  | .baseTerm (.assert _ _ _ t u) =>
    Nat.blt t numBbs &&
      match u with | .cleanup b => Nat.blt b numBbs | _ => true
  | .baseTerm (.call _ _ _ t u) =>
    (match t with | none => true | some b => Nat.blt b numBbs) &&
      match u with | .cleanup b => Nat.blt b numBbs | _ => true
  | .ptrOffsetInbounds _ _ _ _ nextBb
  | .checkPtrPairAlign _ _ _ _ _ nextBb
  | .readLeUsize _ _ _ _ nextBb
  | .writeLeUsize _ _ _ _ nextBb
  | .readPtrLe8 _ _ _ nextBb
  | .writePtrLe8 _ _ _ nextBb
  | .copyNonOverlapping _ _ _ _ _ _ nextBb
  | .readBufRawByte _ _ _ _ nextBb
  | .writeBufRawByte _ _ _ _ nextBb =>
    Nat.blt nextBb numBbs

noncomputable def memCopyBodyTargetsInBounds (body : MemCopyBody) : Bool :=
  let b := body.basicBlocks.length
  body.basicBlocks.all (fun bb => memCopyTermTargetsInBounds b bb.terminator)

/-- Straight-line base helper statements shared by `PtrScalarize` &
`BufScalarize`. -/
noncomputable def mkLivenessCheckStmt (liveLoc : LocalId) : MemCopyStmt :=
  .baseStmt (.assign { localId := liveLoc, projection := [] }
    (.use (.constant { ty := .unit, lit := .zeroSized })))

noncomputable def mkImmediateUbStmt (scrUsize : LocalId) : MemCopyStmt :=
  .baseStmt (.assign { localId := scrUsize, projection := [] }
    (.binaryOp .subUnchecked (usizeConst 0) (usizeConst 1)))

noncomputable def mkRequireZeroUsize (scrUsize : LocalId)
    (op : Operand) : MemCopyStmt :=
  .baseStmt (.assign { localId := scrUsize, projection := [] }
    (.binaryOp .subUnchecked (usizeConst 0) op))

noncomputable def mkAssignUse (dst : LocalId) (op : Operand) : MemCopyStmt :=
  .baseStmt (.assign { localId := dst, projection := [] } (.use op))

noncomputable def mkBinOpStmt (dst : LocalId) (bop : BinOp)
    (lhs rhs : Operand) : MemCopyStmt :=
  .baseStmt (.assign { localId := dst, projection := [] }
    (.binaryOp bop lhs rhs))

noncomputable def mkSubUncheckedUsize (dst : LocalId)
    (lhs rhs : Operand) : MemCopyStmt :=
  mkBinOpStmt dst .subUnchecked lhs rhs

noncomputable def mkAddUncheckedUsize (dst : LocalId)
    (lhs rhs : Operand) : MemCopyStmt :=
  mkBinOpStmt dst .addUnchecked lhs rhs

noncomputable def mkStorageLiveRange : Nat → Nat → List MemCopyStmt
  | _, 0 => []
  | start, k + 1 =>
    .baseStmt (.storageLive start) :: mkStorageLiveRange (start + 1) k

noncomputable def mkStorageDeadRange : Nat → Nat → List MemCopyStmt
  | _, 0 => []
  | start, k + 1 =>
    .baseStmt (.storageDead start) :: mkStorageDeadRange (start + 1) k

noncomputable def mkZeroUsizeRange : Nat → Nat → List MemCopyStmt
  | _, 0 => []
  | start, k + 1 =>
    mkAssignUse start (usizeConst 0) :: mkZeroUsizeRange (start + 1) k

/-! ### Pass 1: `FoldZeroOffset` (`ptrWrappingOffset` & `ptrOffsetInbounds` Zero-Byte Folding) -/

/-- Whether `(countOp, elemSize)` is a well-formed `usize`/`isize` constant
whose byte delta `count * elemSize` equals `0`. -/
noncomputable def isZeroOffsetConst (countOp : Operand)
    (elemSize : Nat) : Bool :=
  match countOp with
  | .constant c =>
    if !(MirTy.beq c.ty usizeTy) && !(MirTy.beq c.ty isizeTy) then
      false
    else
      match evalConstLit c.ty c.lit with
      | .ok (.scalar sv) =>
        sv.wf && (decodeScalar sv * Int.ofNat elemSize == 0)
      | _ => false
  | _ => false

noncomputable def applyFoldZeroOffsetStmt (bodyId : DefId)
    (bbIdx : BasicBlockId) (stmtIdx : Nat)
    (pSrc : MemCopyProgram) : Option MemCopyProgram :=
  match Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
  | none => none
  | some body =>
    match Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
    | none => none
    | some bb =>
      match Trusted.MirSemantics.getElem? bb.statements stmtIdx with
      | some (.ptrWrappingOffset dstPtr srcPtr countOp elemSize) =>
        if !isZeroOffsetConst countOp elemSize then
          none
        else
          match setElem? bb.statements stmtIdx (.copyPtr dstPtr srcPtr false) with
          | none => none
          | some stmts' =>
            match setElem? body.basicBlocks bbIdx { bb with statements := stmts' } with
            | none => none
            | some bbs' =>
              match setElem? pSrc.bodies bodyId { body with basicBlocks := bbs' } with
              | none => none
              | some bodies' => some { pSrc with bodies := bodies' }
      | _ => none

noncomputable def checkFoldZeroOffsetStmt (bodyId : DefId)
    (bbIdx : BasicBlockId) (stmtIdx : Nat)
    (pSrc pTgt : MemCopyProgram) : Bool :=
  match applyFoldZeroOffsetStmt bodyId bbIdx stmtIdx pSrc with
  | some pOut => memCopyProgramEq pOut pTgt
  | none => false

noncomputable def applyFoldZeroOffsetTerm (bodyId : DefId)
    (bbIdx : BasicBlockId) (pSrc : MemCopyProgram) : Option MemCopyProgram :=
  match Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
  | none => none
  | some body =>
    match Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
    | none => none
    | some bb =>
      match bb.terminator with
      | .ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb =>
        if !isZeroOffsetConst countOp elemSize then
          none
        else
          let bbTgt : MemCopyBlock := {
            bb with
            statements := bb.statements ++ [.copyPtr dstPtr srcPtr false]
            terminator := .baseTerm (.goto nextBb)
          }
          match setElem? body.basicBlocks bbIdx bbTgt with
          | none => none
          | some bbs' =>
            match setElem? pSrc.bodies bodyId { body with basicBlocks := bbs' } with
            | none => none
            | some bodies' => some { pSrc with bodies := bodies' }
      | _ => none

noncomputable def checkFoldZeroOffsetTerm (bodyId : DefId)
    (bbIdx : BasicBlockId) (pSrc pTgt : MemCopyProgram) : Bool :=
  match applyFoldZeroOffsetTerm bodyId bbIdx pSrc with
  | some pOut => memCopyProgramEq pOut pTgt
  | none => false

/-! ### Pass 2: `FoldGuardedZeroCopy` (Alignment- & Non-Null-Guarded Zero-Length `copy_nonoverlapping` Folding) -/

/-- Whether `(countOp, elemSize)` is a well-formed `usize` constant with
`elemSize * count == 0`. -/
noncomputable def isZeroCopyConst (countOp : Operand) (elemSize : Nat) : Bool :=
  match countOp with
  | .constant c =>
    if !(MirTy.beq c.ty usizeTy) then
      false
    else
      match evalConstLit usizeTy c.lit with
      | .ok (.scalar sv) =>
        sv.wf && Nat.beq (elemSize * sv.bits.toNat) 0
      | _ => false
  | _ => false

/-- Replace zero-byte `copyNonOverlapping` with `checkPtrPairAlign` (preserving
alignment and `checkNonNullZero` UB checks while eliding memory traffic). -/
noncomputable def applyFoldGuardedZeroCopy (bodyId : DefId)
    (bbIdx : BasicBlockId) (pSrc : MemCopyProgram) : Option MemCopyProgram :=
  match Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
  | none => none
  | some body =>
    match Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
    | none => none
    | some bb =>
      match bb.terminator with
      | .copyNonOverlapping srcPtr dstPtr countOp elemSize reqAlignLog2
          checkNonNullZero nextBb =>
        if !isZeroCopyConst countOp elemSize then
          none
        else
          let bbTgt : MemCopyBlock := {
            bb with
            terminator := .checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2
              checkNonNullZero nextBb
          }
          match setElem? body.basicBlocks bbIdx bbTgt with
          | none => none
          | some bbs' =>
            match setElem? pSrc.bodies bodyId { body with basicBlocks := bbs' } with
            | none => none
            | some bodies' => some { pSrc with bodies := bodies' }
      | _ => none

noncomputable def checkFoldGuardedZeroCopy (bodyId : DefId)
    (bbIdx : BasicBlockId) (pSrc pTgt : MemCopyProgram) : Bool :=
  match applyFoldGuardedZeroCopy bodyId bbIdx pSrc with
  | some pOut => memCopyProgramEq pOut pTgt
  | none => false

/-! ### Pass 3: `PtrScalarize` (Eliminates All `.ptrLocal` Locals & Lowers Pointer/LE/`copy_nonoverlapping` Ops to Single-Buffer Raw-Byte Ops) -/

structure PtrBackingEntry where
  ptrLocal : LocalId
  backingBuf : Option LocalId

structure PtrScalarizePlan where
  defId : DefId
  entries : List PtrBackingEntry

noncomputable def findPtrEntryAux (pLoc : LocalId) :
    Nat → List PtrBackingEntry → Option (Nat × Option LocalId)
  | _, [] => none
  | idx, e :: rest =>
    if Nat.beq e.ptrLocal pLoc then
      some (idx, e.backingBuf)
    else
      findPtrEntryAux pLoc (idx + 1) rest

noncomputable def findPtrEntry (entries : List PtrBackingEntry)
    (pLoc : LocalId) : Option (Nat × Option LocalId) :=
  findPtrEntryAux pLoc 0 entries

noncomputable def checkPtrBackingEntriesLoop (decls : List MemCopyLocalDecl)
    (argCount : Nat) :
    Nat → List MemCopyLocalDecl → List PtrBackingEntry → Bool
  | _, [], [] => true
  | idx, .ptrLocal :: restDecls, e :: restEntries =>
    Nat.beq e.ptrLocal idx &&
      Nat.blt argCount idx &&
      (match e.backingBuf with
       | none => true
       | some bufLoc =>
         Nat.blt argCount bufLoc &&
           match Trusted.MirSemantics.getElem? decls bufLoc with
           | some (.byteBuf sz al _) => Nat.ble sz 32 && Nat.ble al 30
           | _ => false) &&
      checkPtrBackingEntriesLoop decls argCount (idx + 1) restDecls restEntries
  | idx, .base _ :: restDecls, entries =>
    checkPtrBackingEntriesLoop decls argCount (idx + 1) restDecls entries
  | idx, .byteBuf sz al _ :: restDecls, entries =>
    Nat.blt argCount idx && Nat.ble sz 32 && Nat.ble al 30 &&
      checkPtrBackingEntriesLoop decls argCount (idx + 1) restDecls entries
  | _, _, _ => false

noncomputable def tombstonePtrDecls :
    List MemCopyLocalDecl → List MemCopyLocalDecl
  | [] => []
  | .ptrLocal :: rest => .base .unit :: tombstonePtrDecls rest
  | d :: rest => d :: tombstonePtrDecls rest

noncomputable def operandUsesOnlyBaseMem (decls : List MemCopyLocalDecl) :
    Operand → Bool
  | .copy p | .move p =>
    p.projection.isEmpty &&
      match Trusted.MirSemantics.getElem? decls p.localId with
      | some (.base _) => true
      | _ => false
  | .constant _ => true

noncomputable def operandHasBaseTy (decls : List MemCopyLocalDecl)
    (expectedTy : MirTy) : Operand → Bool
  | .copy p | .move p =>
    p.projection.isEmpty &&
      match Trusted.MirSemantics.getElem? decls p.localId with
      | some (.base ty) => MirTy.beq ty expectedTy
      | _ => false
  | .constant c =>
    MirTy.beq c.ty expectedTy &&
      match evalConstLit c.ty c.lit with
      | .ok v => checkVal v expectedTy
      | .error _ => false

noncomputable def constIsizeValue? : Operand → Option Int
  | .constant c =>
    if !(MirTy.beq c.ty isizeTy) then
      none
    else
      match evalConstLit isizeTy c.lit with
      | .ok (.scalar sv) => if sv.wf then some (decodeScalar sv) else none
      | _ => none
  | _ => none

noncomputable def checkOffsetCountOp (decls : List MemCopyLocalDecl)
    (op : Operand) : Bool :=
  operandHasBaseTy decls usizeTy op ||
    match constIsizeValue? op with
    | some _ => true
    | none => false

noncomputable def rvalueUsesOnlyBaseMem (decls : List MemCopyLocalDecl) :
    Rvalue → Bool
  | .use o | .unaryOp _ o => operandUsesOnlyBaseMem decls o
  | .binaryOp _ l r =>
    operandUsesOnlyBaseMem decls l && operandUsesOnlyBaseMem decls r
  | .discriminant p =>
    p.projection.isEmpty &&
      match Trusted.MirSemantics.getElem? decls p.localId with
      | some (.base _) => true
      | _ => false
  | .ref _ _ | .addressOf _ _ | .aggregateTuple _ | .unsupported => true

noncomputable def checkPtrCopyCompat (bDst bSrc : Option LocalId) : Bool :=
  match bSrc with
  | none => true
  | some bufS => optNatEq bDst (some bufS)

noncomputable def checkStmtForPtrs (decls : List MemCopyLocalDecl)
    (entries : List PtrBackingEntry) : MemCopyStmt → Bool
  | .baseStmt (.storageLive _) | .baseStmt (.storageDead _)
  | .baseStmt .nop | .baseStmt .unsupported => true
  | .baseStmt (.assign dst rval) =>
    if !dst.projection.isEmpty then true
    else
      match Trusted.MirSemantics.getElem? decls dst.localId with
      | some (.base _) => rvalueUsesOnlyBaseMem decls rval
      | _ => false
  | .bufLivenessCheck b =>
    match Trusted.MirSemantics.getElem? decls b with
    | some (.byteBuf _ _ _) => true
    | _ => false
  | .mkNullPtr d =>
    match findPtrEntry entries d with | some _ => true | none => false
  | .mkDanglingPtr d al =>
    Nat.ble al 30 &&
      match findPtrEntry entries d with | some _ => true | none => false
  | .addrOfByteBuf d b =>
    match findPtrEntry entries d, Trusted.MirSemantics.getElem? decls b with
    | some (_, some bDst), some (.byteBuf _ _ _) => Nat.beq bDst b
    | _, _ => false
  | .copyPtr d s _ =>
    match findPtrEntry entries d, findPtrEntry entries s with
    | some (_, bD), some (_, bS) => checkPtrCopyCompat bD bS
    | _, _ => false
  | .ptrWrappingOffset d s cntOp _ =>
    checkOffsetCountOp decls cntOp &&
      match findPtrEntry entries d, findPtrEntry entries s with
      | some (_, bD), some (_, bS) => checkPtrCopyCompat bD bS
      | _, _ => false

noncomputable def checkTermForPtrs (decls : List MemCopyLocalDecl)
    (entries : List PtrBackingEntry) : MemCopyTerm → Bool
  | .baseTerm (.goto _) | .baseTerm .return_ | .baseTerm .unreachable => true
  | .baseTerm (.switchInt d _) => operandUsesOnlyBaseMem decls d
  | .baseTerm .unwindResume | .baseTerm (.assert _ _ _ _ _)
  | .baseTerm (.call _ _ _ _ _) | .baseTerm .unsupported => true
  | .ptrOffsetInbounds d s cntOp _ _ =>
    checkOffsetCountOp decls cntOp &&
      match findPtrEntry entries d, findPtrEntry entries s with
      | some (_, bD), some (_, bS) => checkPtrCopyCompat bD bS
      | _, _ => false
  | .checkPtrPairAlign s d _ al _ _ =>
    Nat.ble al 30 &&
      match findPtrEntry entries s, findPtrEntry entries d with
      | some _, some _ => true
      | _, _ => false
  | .readLeUsize dst p _ _ _ =>
    match Trusted.MirSemantics.getElem? decls dst, findPtrEntry entries p with
    | some (.base ty), some _ => MirTy.beq ty usizeTy
    | _, _ => false
  | .writeLeUsize p valOp _ _ _ =>
    operandHasBaseTy decls usizeTy valOp &&
      match findPtrEntry entries p with | some _ => true | none => false
  | .readPtrLe8 _ _ _ _ | .writePtrLe8 _ _ _ _ => false
  | .copyNonOverlapping s d cntOp _ al _ _ =>
    Nat.ble al 30 && operandHasBaseTy decls usizeTy cntOp &&
      match findPtrEntry entries s, findPtrEntry entries d with
      | some _, some _ => true
      | _, _ => false
  | .readBufRawByte td vd b o _ =>
    !Nat.beq td vd &&
      operandHasBaseTy decls usizeTy o &&
      match Trusted.MirSemantics.getElem? decls td,
          Trusted.MirSemantics.getElem? decls vd,
          Trusted.MirSemantics.getElem? decls b with
      | some (.base t1), some (.base t2), some (.byteBuf _ _ _) =>
        MirTy.beq t1 usizeTy && MirTy.beq t2 usizeTy
      | _, _, _ => false
  | .writeBufRawByte b o t v _ =>
    operandHasBaseTy decls usizeTy o &&
      operandHasBaseTy decls usizeTy t &&
      operandHasBaseTy decls usizeTy v &&
      match Trusted.MirSemantics.getElem? decls b with
      | some (.byteBuf _ _ _) => true
      | _ => false

/-- Component locals added per `.ptrLocal` entry `k`:
`off = base + 3 * k` (`liveLoc : .unit`, `tagLoc : usize`, `offLoc : usize`),
followed by 12 unannotated body-wide scratch locals starting at
`scrBase = base + 3 * entries.length`:
`scrTag1 (+0)`, `scrOff1 (+1)`, `scrTag2 (+2)`, `scrOff2 (+3)`, `scrCnt (+4)`,
`scrTmpA (+5)`, `scrTmpB (+6)`, `scrAcc (+7)`, `scrBTag (+8)`, `scrBVal (+9)`,
`scrCond1 (+10 : .bool)`, `scrCond2 (+11 : .bool)`. -/
noncomputable def ptrCompDecls : Nat → List MemCopyLocalDecl
  | 0 => []
  | k + 1 =>
    .base .unit :: .base usizeTy :: .base usizeTy :: ptrCompDecls k

noncomputable def ptrScratchDecls : List MemCopyLocalDecl :=
  listReplicate 10 (.base usizeTy) ++ [.base .bool, .base .bool]

/-- Emit straight-line alignment & optional non-null zero checks for a
decomposed pointer `(tagLoc, offLoc)` backed by `optBuf`. -/
noncomputable def mkPtrAlignCheckStmts (decls : List MemCopyLocalDecl)
    (optBuf : Option LocalId) (tagLoc offLoc scrTmpA scrTmpB : LocalId)
    (reqAlignLog2 : Nat) : List MemCopyStmt :=
  let mask := Nat.pow 2 reqAlignLog2 - 1
  let offAlignStmts : List MemCopyStmt := [
    mkBinOpStmt scrTmpB .bitAnd
      (.copy { localId := offLoc, projection := [] }) (usizeConst mask),
    mkRequireZeroUsize scrTmpA (.move { localId := scrTmpB, projection := [] })
  ]
  let allocAlignStmts : List MemCopyStmt :=
    match optBuf with
    | none => []
    | some bufLoc =>
      match Trusted.MirSemantics.getElem? decls bufLoc with
      | some (.byteBuf _ bufAlign _) =>
        if Nat.ble reqAlignLog2 bufAlign then
          []
        else
          [mkRequireZeroUsize scrTmpA
            (.copy { localId := tagLoc, projection := [] })]
      | _ => [.baseStmt .unsupported]
  offAlignStmts ++ allocAlignStmts

noncomputable def mkPtrNonNullCheckStmts
    (tagLoc offLoc scrTmpA scrTmpB : LocalId) : List MemCopyStmt :=
  [ mkBinOpStmt scrTmpB .bitOr
      (.copy { localId := tagLoc, projection := [] })
      (.copy { localId := offLoc, projection := [] }),
    mkSubUncheckedUsize scrTmpA
      (.move { localId := scrTmpB, projection := [] }) (usizeConst 1) ]

/-- Lower a single `MemCopyStmt` under `PtrScalarize` (`0` block splits). -/
noncomputable def lowerStmtForPtrs (_decls : List MemCopyLocalDecl)
    (entries : List PtrBackingEntry) (base : Nat) :
    MemCopyStmt → List MemCopyStmt
  | .baseStmt (.storageLive id) =>
    match findPtrEntry entries id with
    | some (k, _) => mkStorageLiveRange (base + 3 * k) 3
    | none => [.baseStmt (.storageLive id)]
  | .baseStmt (.storageDead id) =>
    match findPtrEntry entries id with
    | some (k, _) => mkStorageDeadRange (base + 3 * k) 3
    | none => [.baseStmt (.storageDead id)]
  | .mkNullPtr d =>
    match findPtrEntry entries d with
    | some (k, _) =>
      let off := base + 3 * k
      [ mkLivenessCheckStmt off,
        mkAssignUse (off + 1) (usizeConst 0),
        mkAssignUse (off + 2) (usizeConst 0) ]
    | none => [.baseStmt .unsupported]
  | .mkDanglingPtr d al =>
    match findPtrEntry entries d with
    | some (k, _) =>
      let off := base + 3 * k
      [ mkLivenessCheckStmt off,
        mkAssignUse (off + 1) (usizeConst 0),
        mkAssignUse (off + 2) (usizeConst (Nat.pow 2 al)) ]
    | none => [.baseStmt .unsupported]
  | .addrOfByteBuf d b =>
    match findPtrEntry entries d with
    | some (k, _) =>
      let off := base + 3 * k
      [ .bufLivenessCheck b,
        mkLivenessCheckStmt off,
        mkAssignUse (off + 1) (usizeConst 1),
        mkAssignUse (off + 2) (usizeConst 0) ]
    | none => [.baseStmt .unsupported]
  | .copyPtr d s isMove =>
    let scrBase := base + 3 * entries.length
    let scrTag1 := scrBase
    let scrOff1 := scrBase + 1
    match findPtrEntry entries d, findPtrEntry entries s with
    | some (kD, _), some (kS, _) =>
      let offD := base + 3 * kD
      let offS := base + 3 * kS
      let opTag : Operand :=
        if isMove then .move { localId := offS + 1, projection := [] }
        else .copy { localId := offS + 1, projection := [] }
      let opOff : Operand :=
        if isMove then .move { localId := offS + 2, projection := [] }
        else .copy { localId := offS + 2, projection := [] }
      [ mkLivenessCheckStmt offS,
        mkAssignUse scrTag1 opTag,
        mkAssignUse scrOff1 opOff,
        mkLivenessCheckStmt offD,
        mkAssignUse (offD + 1) (.move { localId := scrTag1, projection := [] }),
        mkAssignUse (offD + 2) (.move { localId := scrOff1, projection := [] }) ]
    | _, _ => [.baseStmt .unsupported]
  | .ptrWrappingOffset d s cntOp elemSize =>
    let scrBase := base + 3 * entries.length
    let scrTag1 := scrBase
    let scrOff1 := scrBase + 1
    let scrCnt := scrBase + 4
    let scrTmpA := scrBase + 5
    match findPtrEntry entries d, findPtrEntry entries s with
    | some (kD, _), some (kS, _) =>
      let offD := base + 3 * kD
      let offS := base + 3 * kS
      match constIsizeValue? cntOp with
      | some z =>
        let deltaMod : Nat :=
          (intEmod (z * Int.ofNat elemSize) (Int.ofNat maxUsize)).toNat
        [ mkLivenessCheckStmt offS,
          mkAssignUse scrTag1 (.copy { localId := offS + 1, projection := [] }),
          mkAssignUse scrOff1 (.copy { localId := offS + 2, projection := [] }),
          mkBinOpStmt scrOff1 .add
            (.move { localId := scrOff1, projection := [] })
            (usizeConst deltaMod),
          mkLivenessCheckStmt offD,
          mkAssignUse (offD + 1) (.move { localId := scrTag1, projection := [] }),
          mkAssignUse (offD + 2) (.move { localId := scrOff1, projection := [] }) ]
      | none =>
        [ mkAssignUse scrCnt cntOp,
          mkLivenessCheckStmt offS,
          mkAssignUse scrTag1 (.copy { localId := offS + 1, projection := [] }),
          mkAssignUse scrOff1 (.copy { localId := offS + 2, projection := [] }),
          mkBinOpStmt scrTmpA .mul
            (.move { localId := scrCnt, projection := [] })
            (usizeConst (Nat.mod elemSize maxUsize)),
          mkBinOpStmt scrOff1 .add
            (.move { localId := scrOff1, projection := [] })
            (.move { localId := scrTmpA, projection := [] }),
          mkLivenessCheckStmt offD,
          mkAssignUse (offD + 1) (.move { localId := scrTag1, projection := [] }),
          mkAssignUse (offD + 2) (.move { localId := scrOff1, projection := [] }) ]
    | _, _ => [.baseStmt .unsupported]
  | other => [other]

/-- Build the `m = w.byteCount` sequential byte-read blocks for `readLeUsize`. -/
noncomputable def buildReadLeByteBlocks (dstLocal bufLoc : LocalId)
    (scrOff1 scrTmpA scrTmpB scrAcc scrBTag scrBVal : LocalId)
    (nextBb : BasicBlockId) : Nat → Nat → Nat → List MemCopyBlock
  | _, _, 0 => []
  | i, curBb, rem + 1 =>
    let tagChk : List MemCopyStmt := [
      mkSubUncheckedUsize scrTmpA
        (.copy { localId := scrBTag, projection := [] }) (usizeConst 1),
      mkSubUncheckedUsize scrTmpA
        (usizeConst 1) (.move { localId := scrBTag, projection := [] })
    ]
    let accStmts : List MemCopyStmt :=
      if Nat.beq i 0 then
        [mkAssignUse scrAcc (.move { localId := scrBVal, projection := [] })]
      else
        [ mkBinOpStmt scrTmpB .shl
            (.move { localId := scrBVal, projection := [] })
            (usizeConst (8 * i)),
          mkBinOpStmt scrAcc .bitOr
            (.move { localId := scrAcc, projection := [] })
            (.move { localId := scrTmpB, projection := [] }) ]
    match rem with
    | 0 =>
      [{ statements := tagChk ++ accStmts ++
           [mkAssignUse dstLocal (.move { localId := scrAcc, projection := [] })]
         terminator := .baseTerm (.goto nextBb)
         cleanup := false }]
    | _ + 1 =>
      let nextReadStmt :=
        mkBinOpStmt scrTmpA .add
          (.copy { localId := scrOff1, projection := [] })
          (usizeConst (i + 1))
      let blk : MemCopyBlock := {
        statements := tagChk ++ accStmts ++ [nextReadStmt]
        terminator := .readBufRawByte scrBTag scrBVal bufLoc
          (.move { localId := scrTmpA, projection := [] }) (curBb + 1)
        cleanup := false
      }
      blk :: buildReadLeByteBlocks dstLocal bufLoc
        scrOff1 scrTmpA scrTmpB scrAcc scrBTag scrBVal nextBb
        (i + 1) (curBb + 1) rem

/-- Build the remaining `m - 1` sequential byte-write blocks (`i = 1 .. m - 1`)
for `writeLeUsize`. -/
noncomputable def buildWriteLeByteBlocks (bufLoc : LocalId)
    (scrOff1 scrTmpA scrTmpB scrAcc scrBVal : LocalId)
    (nextBb : BasicBlockId) : Nat → Nat → Nat → List MemCopyBlock
  | _, _, 0 => []
  | i, curBb, rem + 1 =>
    let stmts : List MemCopyStmt := [
      mkBinOpStmt scrTmpB .shr
        (.copy { localId := scrAcc, projection := [] }) (usizeConst (8 * i)),
      mkBinOpStmt scrBVal .bitAnd
        (.move { localId := scrTmpB, projection := [] }) (usizeConst 255),
      mkBinOpStmt scrTmpA .add
        (.copy { localId := scrOff1, projection := [] }) (usizeConst i)
    ]
    let targetBb := match rem with | 0 => nextBb | _ + 1 => curBb + 1
    let blk : MemCopyBlock := {
      statements := stmts
      terminator := .writeBufRawByte bufLoc
        (.move { localId := scrTmpA, projection := [] })
        (usizeConst 1)
        (.move { localId := scrBVal, projection := [] })
        targetBb
      cleanup := false
    }
    blk :: buildWriteLeByteBlocks bufLoc
      scrOff1 scrTmpA scrTmpB scrAcc scrBVal nextBb (i + 1) (curBb + 1) rem

/-- Lower a `MemCopyTerm` under `PtrScalarize`, keeping original block IDs
`0 .. numBbs - 1` intact and appending helper blocks at `nextExtraBb ..`. -/
noncomputable def lowerTermForPtrs (decls : List MemCopyLocalDecl)
    (entries : List PtrBackingEntry) (base nextExtraBb : Nat) :
    MemCopyTerm → List MemCopyStmt × MemCopyTerm × List MemCopyBlock
  | .ptrOffsetInbounds d s cntOp elemSize nextBb =>
    let scrBase := base + 3 * entries.length
    let scrTag1 := scrBase
    let scrOff1 := scrBase + 1
    let scrCnt := scrBase + 4
    let scrTmpA := scrBase + 5
    let scrTmpB := scrBase + 6
    match findPtrEntry entries d, findPtrEntry entries s with
    | some (kD, _), some (kS, optBufS) =>
      let offD := base + 3 * kD
      let offS := base + 3 * kS
      let readSrc : List MemCopyStmt := [
        mkLivenessCheckStmt offS,
        mkAssignUse scrTag1 (.copy { localId := offS + 1, projection := [] }),
        mkAssignUse scrOff1 (.copy { localId := offS + 2, projection := [] })
      ]
      let writeDst : List MemCopyStmt := [
        mkLivenessCheckStmt offD,
        mkAssignUse (offD + 1) (.move { localId := scrTag1, projection := [] }),
        mkAssignUse (offD + 2) (.move { localId := scrOff1, projection := [] })
      ]
      match constIsizeValue? cntOp with
      | some z =>
        let delta : Int := z * Int.ofNat elemSize
        if decide (delta < minIsize) || decide (Int.ofNat maxIsize < delta) then
          (readSrc ++ [mkImmediateUbStmt scrTmpA], .baseTerm .unreachable, [])
        else if delta == 0 then
          (readSrc ++ writeDst, .baseTerm (.goto nextBb), [])
        else
          let tagChk :=
            mkSubUncheckedUsize scrTmpA
              (.copy { localId := scrTag1, projection := [] }) (usizeConst 1)
          match optBufS with
          | none => (readSrc ++ [tagChk], .baseTerm .unreachable, [])
          | some bufLoc =>
            match Trusted.MirSemantics.getElem? decls bufLoc with
            | some (.byteBuf bufSize _ _) =>
              if decide (0 < delta) then
                let dNat := delta.toNat
                if !Nat.ble dNat bufSize then
                  (readSrc ++ [tagChk, .bufLivenessCheck bufLoc,
                    mkImmediateUbStmt scrTmpA], .baseTerm .unreachable, [])
                else
                  (readSrc ++ [
                     tagChk,
                     .bufLivenessCheck bufLoc,
                     mkSubUncheckedUsize scrTmpA (usizeConst (bufSize - dNat))
                       (.copy { localId := scrOff1, projection := [] }),
                     mkAddUncheckedUsize scrOff1
                       (.move { localId := scrOff1, projection := [] })
                       (usizeConst dNat)
                   ] ++ writeDst,
                   .baseTerm (.goto nextBb), [])
              else
                let negNat := (Neg.neg delta).toNat
                (readSrc ++ [
                   tagChk,
                   .bufLivenessCheck bufLoc,
                   mkSubUncheckedUsize scrTmpA (usizeConst bufSize)
                     (.copy { localId := scrOff1, projection := [] }),
                   mkSubUncheckedUsize scrOff1
                     (.move { localId := scrOff1, projection := [] })
                     (usizeConst negNat)
                 ] ++ writeDst,
                 .baseTerm (.goto nextBb), [])
            | _ => ([], .baseTerm .unsupported, [])
      | none =>
        let evalCntAndRead := [mkAssignUse scrCnt cntOp] ++ readSrc
        if Nat.beq elemSize 0 then
          (evalCntAndRead ++ writeDst, .baseTerm (.goto nextBb), [])
        else if !Nat.ble elemSize maxIsize then
          let zeroBb : MemCopyBlock := {
            statements := writeDst
            terminator := .baseTerm (.goto nextBb)
            cleanup := false
          }
          let trapBb : MemCopyBlock := {
            statements := []
            terminator := .baseTerm .unreachable
            cleanup := false
          }
          (evalCntAndRead,
           .baseTerm (.switchInt (.move { localId := scrCnt, projection := [] })
             { branches := [(BitVec.ofNat 128 0, nextExtraBb)]
               otherwise := nextExtraBb + 1 }),
           [zeroBb, trapBb])
        else
          let maxCnt := Nat.div maxIsize elemSize
          let cntChk :=
            mkSubUncheckedUsize scrTmpA (usizeConst maxCnt)
              (.copy { localId := scrCnt, projection := [] })
          let zeroBb : MemCopyBlock := {
            statements := writeDst
            terminator := .baseTerm (.goto nextBb)
            cleanup := false
          }
          let nzBb : MemCopyBlock :=
            let tagChk :=
              mkSubUncheckedUsize scrTmpA
                (.copy { localId := scrTag1, projection := [] }) (usizeConst 1)
            match optBufS with
            | none => {
                statements := [tagChk]
                terminator := .baseTerm .unreachable
                cleanup := false
              }
            | some bufLoc =>
              match Trusted.MirSemantics.getElem? decls bufLoc with
              | some (.byteBuf bufSize _ _) => {
                  statements := [
                    tagChk,
                    .bufLivenessCheck bufLoc,
                    mkBinOpStmt scrTmpB .mul
                      (.move { localId := scrCnt, projection := [] })
                      (usizeConst elemSize),
                    mkSubUncheckedUsize scrTmpA (usizeConst bufSize)
                      (.copy { localId := scrOff1, projection := [] }),
                    mkAddUncheckedUsize scrOff1
                      (.move { localId := scrOff1, projection := [] })
                      (.move { localId := scrTmpB, projection := [] }),
                    mkSubUncheckedUsize scrTmpA (usizeConst bufSize)
                      (.copy { localId := scrOff1, projection := [] })
                  ] ++ writeDst
                  terminator := .baseTerm (.goto nextBb)
                  cleanup := false
                }
              | _ => { statements := [], terminator := .baseTerm .unsupported }
          (evalCntAndRead ++ [cntChk],
           .baseTerm (.switchInt (.copy { localId := scrCnt, projection := [] })
             { branches := [(BitVec.ofNat 128 0, nextExtraBb)]
               otherwise := nextExtraBb + 1 }),
           [zeroBb, nzBb])
    | _, _ => ([], .baseTerm .unsupported, [])
  | .checkPtrPairAlign s d _ reqAlignLog2 checkNonNullZero nextBb =>
    let scrBase := base + 3 * entries.length
    let scrTag1 := scrBase
    let scrOff1 := scrBase + 1
    let scrTag2 := scrBase + 2
    let scrOff2 := scrBase + 3
    let scrTmpA := scrBase + 5
    let scrTmpB := scrBase + 6
    match findPtrEntry entries s, findPtrEntry entries d with
    | some (kS, optBufS), some (kD, optBufD) =>
      let offS := base + 3 * kS
      let offD := base + 3 * kD
      let readBoth : List MemCopyStmt := [
        mkLivenessCheckStmt offS,
        mkAssignUse scrTag1 (.copy { localId := offS + 1, projection := [] }),
        mkAssignUse scrOff1 (.copy { localId := offS + 2, projection := [] }),
        mkLivenessCheckStmt offD,
        mkAssignUse scrTag2 (.copy { localId := offD + 1, projection := [] }),
        mkAssignUse scrOff2 (.copy { localId := offD + 2, projection := [] })
      ]
      let alignStmts :=
        mkPtrAlignCheckStmts decls optBufS scrTag1 scrOff1 scrTmpA scrTmpB reqAlignLog2 ++
          mkPtrAlignCheckStmts decls optBufD scrTag2 scrOff2 scrTmpA scrTmpB reqAlignLog2
      let nonNullStmts : List MemCopyStmt :=
        if checkNonNullZero then
          mkPtrNonNullCheckStmts scrTag1 scrOff1 scrTmpA scrTmpB ++
            mkPtrNonNullCheckStmts scrTag2 scrOff2 scrTmpA scrTmpB
        else
          []
      (readBoth ++ alignStmts ++ nonNullStmts, .baseTerm (.goto nextBb), [])
    | _, _ => ([], .baseTerm .unsupported, [])
  | .readLeUsize dstLocal p w requireAligned nextBb =>
    let scrBase := base + 3 * entries.length
    let scrTag1 := scrBase
    let scrOff1 := scrBase + 1
    let scrTmpA := scrBase + 5
    let scrTmpB := scrBase + 6
    let scrAcc := scrBase + 7
    let scrBTag := scrBase + 8
    let scrBVal := scrBase + 9
    match findPtrEntry entries p with
    | some (kP, optBufP) =>
      let offP := base + 3 * kP
      let reqAlign := if requireAligned then w.naturalAlignLog2 else 0
      let pre : List MemCopyStmt := [
        mkLivenessCheckStmt offP,
        mkAssignUse scrTag1 (.copy { localId := offP + 1, projection := [] }),
        mkAssignUse scrOff1 (.copy { localId := offP + 2, projection := [] })
      ] ++ mkPtrAlignCheckStmts decls optBufP scrTag1 scrOff1 scrTmpA scrTmpB reqAlign ++ [
        mkSubUncheckedUsize scrTmpA
          (.copy { localId := scrTag1, projection := [] }) (usizeConst 1)
      ]
      match optBufP with
      | none => (pre, .baseTerm .unreachable, [])
      | some bufLoc =>
        match Trusted.MirSemantics.getElem? decls bufLoc with
        | some (.byteBuf bufSize _ _) =>
          if !Nat.ble w.byteCount bufSize then
            (pre ++ [.bufLivenessCheck bufLoc, mkImmediateUbStmt scrTmpA],
             .baseTerm .unreachable, [])
          else
            let boundsChk :=
              mkSubUncheckedUsize scrTmpA
                (usizeConst (bufSize - w.byteCount))
                (.copy { localId := scrOff1, projection := [] })
            let extra :=
              buildReadLeByteBlocks dstLocal bufLoc
                scrOff1 scrTmpA scrTmpB scrAcc scrBTag scrBVal nextBb
                0 nextExtraBb w.byteCount
            (pre ++ [.bufLivenessCheck bufLoc, boundsChk],
             .readBufRawByte scrBTag scrBVal bufLoc
               (.copy { localId := scrOff1, projection := [] }) nextExtraBb,
             extra)
        | _ => ([], .baseTerm .unsupported, [])
    | none => ([], .baseTerm .unsupported, [])
  | .writeLeUsize p valOp w requireAligned nextBb =>
    let scrBase := base + 3 * entries.length
    let scrTag1 := scrBase
    let scrOff1 := scrBase + 1
    let scrTmpA := scrBase + 5
    let scrTmpB := scrBase + 6
    let scrAcc := scrBase + 7
    let scrBVal := scrBase + 9
    match findPtrEntry entries p with
    | some (kP, optBufP) =>
      let offP := base + 3 * kP
      let reqAlign := if requireAligned then w.naturalAlignLog2 else 0
      let pre : List MemCopyStmt := [
        mkAssignUse scrAcc valOp,
        mkLivenessCheckStmt offP,
        mkAssignUse scrTag1 (.copy { localId := offP + 1, projection := [] }),
        mkAssignUse scrOff1 (.copy { localId := offP + 2, projection := [] })
      ] ++ mkPtrAlignCheckStmts decls optBufP scrTag1 scrOff1 scrTmpA scrTmpB reqAlign ++ [
        mkSubUncheckedUsize scrTmpA
          (.copy { localId := scrTag1, projection := [] }) (usizeConst 1)
      ]
      match optBufP with
      | none => (pre, .baseTerm .unreachable, [])
      | some bufLoc =>
        match Trusted.MirSemantics.getElem? decls bufLoc with
        | some (.byteBuf bufSize _ bufMut) =>
          if !(Mutability.beq bufMut .mut) || !Nat.ble w.byteCount bufSize then
            (pre ++ [.bufLivenessCheck bufLoc, mkImmediateUbStmt scrTmpA],
             .baseTerm .unreachable, [])
          else
            let boundsAndLow : List MemCopyStmt := [
              .bufLivenessCheck bufLoc,
              mkSubUncheckedUsize scrTmpA
                (usizeConst (bufSize - w.byteCount))
                (.copy { localId := scrOff1, projection := [] }),
              mkBinOpStmt scrBVal .bitAnd
                (.copy { localId := scrAcc, projection := [] }) (usizeConst 255)
            ]
            if Nat.beq w.byteCount 1 then
              (pre ++ boundsAndLow,
               .writeBufRawByte bufLoc
                 (.copy { localId := scrOff1, projection := [] })
                 (usizeConst 1)
                 (.move { localId := scrBVal, projection := [] })
                 nextBb,
               [])
            else
              let extra :=
                buildWriteLeByteBlocks bufLoc
                  scrOff1 scrTmpA scrTmpB scrAcc scrBVal nextBb
                  1 nextExtraBb (w.byteCount - 1)
              (pre ++ boundsAndLow,
               .writeBufRawByte bufLoc
                 (.copy { localId := scrOff1, projection := [] })
                 (usizeConst 1)
                 (.move { localId := scrBVal, projection := [] })
                 nextExtraBb,
               extra)
        | _ => ([], .baseTerm .unsupported, [])
    | none => ([], .baseTerm .unsupported, [])
  | .copyNonOverlapping s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb =>
    let scrBase := base + 3 * entries.length
    let scrTag1 := scrBase
    let scrOff1 := scrBase + 1
    let scrTag2 := scrBase + 2
    let scrOff2 := scrBase + 3
    let scrCnt := scrBase + 4
    let scrTmpA := scrBase + 5
    let scrTmpB := scrBase + 6
    let scrAcc := scrBase + 7
    let scrBTag := scrBase + 8
    let scrBVal := scrBase + 9
    let scrCond1 := scrBase + 10
    let scrCond2 := scrBase + 11
    match findPtrEntry entries s, findPtrEntry entries d with
    | some (kS, optBufS), some (kD, optBufD) =>
      let offS := base + 3 * kS
      let offD := base + 3 * kD
      let readArgs : List MemCopyStmt := [
        mkAssignUse scrCnt cntOp,
        mkLivenessCheckStmt offS,
        mkAssignUse scrTag1 (.copy { localId := offS + 1, projection := [] }),
        mkAssignUse scrOff1 (.copy { localId := offS + 2, projection := [] }),
        mkLivenessCheckStmt offD,
        mkAssignUse scrTag2 (.copy { localId := offD + 1, projection := [] }),
        mkAssignUse scrOff2 (.copy { localId := offD + 2, projection := [] })
      ]
      let byteLenStmts : List MemCopyStmt :=
        if Nat.beq elemSize 0 then
          [mkAssignUse scrCnt (usizeConst 0)]
        else if !Nat.ble elemSize maxIsize then
          [mkRequireZeroUsize scrTmpA (.copy { localId := scrCnt, projection := [] })]
        else
          [ mkSubUncheckedUsize scrTmpA
              (usizeConst (Nat.div maxIsize elemSize))
              (.copy { localId := scrCnt, projection := [] }),
            mkBinOpStmt scrCnt .mul
              (.move { localId := scrCnt, projection := [] })
              (usizeConst elemSize) ]
      let alignAndNull : List MemCopyStmt :=
        mkPtrAlignCheckStmts decls optBufS scrTag1 scrOff1 scrTmpA scrTmpB reqAlignLog2 ++
          mkPtrAlignCheckStmts decls optBufD scrTag2 scrOff2 scrTmpA scrTmpB reqAlignLog2 ++
          (if checkNonNullZero then
            mkPtrNonNullCheckStmts scrTag1 scrOff1 scrTmpA scrTmpB ++
              mkPtrNonNullCheckStmts scrTag2 scrOff2 scrTmpA scrTmpB
          else [])
      let header := readArgs ++ byteLenStmts ++ alignAndNull
      match optBufS, optBufD with
      | some bufS, some bufD =>
        match Trusted.MirSemantics.getElem? decls bufS,
            Trusted.MirSemantics.getElem? decls bufD with
        | some (.byteBuf sizeS _ _), some (.byteBuf sizeD _ mutD) =>
          if !(Mutability.beq mutD .mut) then
            let trapBb : MemCopyBlock :=
              { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
            (header,
             .baseTerm (.switchInt (.copy { localId := scrCnt, projection := [] })
               { branches := [(BitVec.ofNat 128 0, nextBb)], otherwise := nextExtraBb }),
             [trapBb])
          else
            let checkBbId := nextExtraBb
            let loopHeadBbId := nextExtraBb + 1
            let loopReadBbId := nextExtraBb + 2
            let loopWriteBbId := nextExtraBb + 3
            let trapBbId := nextExtraBb + 4
            let boundsStmts : List MemCopyStmt := [
              mkSubUncheckedUsize scrTmpA
                (.copy { localId := scrTag1, projection := [] }) (usizeConst 1),
              mkSubUncheckedUsize scrTmpA
                (.copy { localId := scrTag2, projection := [] }) (usizeConst 1),
              .bufLivenessCheck bufS,
              .bufLivenessCheck bufD,
              mkSubUncheckedUsize scrTmpB (usizeConst sizeS)
                (.copy { localId := scrCnt, projection := [] }),
              mkSubUncheckedUsize scrTmpA
                (.move { localId := scrTmpB, projection := [] })
                (.copy { localId := scrOff1, projection := [] }),
              mkSubUncheckedUsize scrTmpB (usizeConst sizeD)
                (.copy { localId := scrCnt, projection := [] }),
              mkSubUncheckedUsize scrTmpA
                (.move { localId := scrTmpB, projection := [] })
                (.copy { localId := scrOff2, projection := [] }),
              mkAssignUse scrAcc (usizeConst 0)
            ]
            let checkBb : MemCopyBlock :=
              if Nat.beq bufS bufD then
                { statements := boundsStmts ++ [
                    mkBinOpStmt scrTmpA .add
                      (.copy { localId := scrOff1, projection := [] })
                      (.copy { localId := scrCnt, projection := [] }),
                    mkBinOpStmt scrCond1 .le
                      (.move { localId := scrTmpA, projection := [] })
                      (.copy { localId := scrOff2, projection := [] }),
                    mkBinOpStmt scrTmpB .add
                      (.copy { localId := scrOff2, projection := [] })
                      (.copy { localId := scrCnt, projection := [] }),
                    mkBinOpStmt scrCond2 .le
                      (.move { localId := scrTmpB, projection := [] })
                      (.copy { localId := scrOff1, projection := [] }),
                    mkBinOpStmt scrCond1 .bitOr
                      (.move { localId := scrCond1, projection := [] })
                      (.move { localId := scrCond2, projection := [] })
                  ]
                  terminator := .baseTerm (.switchInt
                    (.move { localId := scrCond1, projection := [] })
                    { branches := [(BitVec.ofNat 128 1, loopHeadBbId)]
                      otherwise := trapBbId })
                  cleanup := false }
              else
                { statements := boundsStmts
                  terminator := .baseTerm (.goto loopHeadBbId)
                  cleanup := false }
            let loopHeadBb : MemCopyBlock := {
              statements := [
                mkBinOpStmt scrCond1 .lt
                  (.copy { localId := scrAcc, projection := [] })
                  (.copy { localId := scrCnt, projection := [] })
              ]
              terminator := .baseTerm (.switchInt
                (.move { localId := scrCond1, projection := [] })
                { branches := [(BitVec.ofNat 128 1, loopReadBbId)]
                  otherwise := nextBb })
              cleanup := false
            }
            let loopReadBb : MemCopyBlock := {
              statements := [
                mkBinOpStmt scrTmpA .add
                  (.copy { localId := scrOff1, projection := [] })
                  (.copy { localId := scrAcc, projection := [] })
              ]
              terminator := .readBufRawByte scrBTag scrBVal bufS
                (.move { localId := scrTmpA, projection := [] }) loopWriteBbId
              cleanup := false
            }
            let loopWriteBb : MemCopyBlock := {
              statements := [
                mkBinOpStmt scrTmpA .add
                  (.copy { localId := scrOff2, projection := [] })
                  (.copy { localId := scrAcc, projection := [] }),
                mkBinOpStmt scrAcc .add
                  (.move { localId := scrAcc, projection := [] })
                  (usizeConst 1)
              ]
              terminator := .writeBufRawByte bufD
                (.move { localId := scrTmpA, projection := [] })
                (.move { localId := scrBTag, projection := [] })
                (.move { localId := scrBVal, projection := [] })
                loopHeadBbId
              cleanup := false
            }
            let trapBb : MemCopyBlock :=
              { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
            (header,
             .baseTerm (.switchInt (.copy { localId := scrCnt, projection := [] })
               { branches := [(BitVec.ofNat 128 0, nextBb)], otherwise := checkBbId }),
             [checkBb, loopHeadBb, loopReadBb, loopWriteBb, trapBb])
        | _, _ => ([], .baseTerm .unsupported, [])
      | _, _ =>
        let trapBb : MemCopyBlock :=
          { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
        (header,
         .baseTerm (.switchInt (.copy { localId := scrCnt, projection := [] })
           { branches := [(BitVec.ofNat 128 0, nextBb)], otherwise := nextExtraBb }),
         [trapBb])
    | _, _ => ([], .baseTerm .unsupported, [])
  | other => ([], other, [])

noncomputable def lowerBlocksForPtrsLoop (decls : List MemCopyLocalDecl)
    (entries : List PtrBackingEntry) (base : Nat) :
    Nat → List MemCopyBlock → List MemCopyBlock × List MemCopyBlock
  | _, [] => ([], [])
  | nextExtra, bb :: rest =>
    let bodyStmts := listFlatMap (lowerStmtForPtrs decls entries base) bb.statements
    let (termPre, termTgt, extra) :=
      lowerTermForPtrs decls entries base nextExtra bb.terminator
    let bbTgt : MemCopyBlock := {
      bb with
      statements := bodyStmts ++ termPre
      terminator := termTgt
    }
    let tail :=
      lowerBlocksForPtrsLoop decls entries base (nextExtra + extra.length) rest
    (bbTgt :: tail.1, extra ++ tail.2)

noncomputable def applyPtrScalarize (plan : PtrScalarizePlan)
    (pSrc : MemCopyProgram) : Option MemCopyProgram :=
  match Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => none
  | some body =>
    if body.acceptsCallerMem ||
        body.basicBlocks.isEmpty ||
        !Nat.blt body.argumentCount body.locals.length ||
        !memCopyStorageAnnotationsInBounds body ||
        !memCopyBodyLocalsInBounds body ||
        !memCopyBodyTargetsInBounds body ||
        !checkPtrBackingEntriesLoop body.locals body.argumentCount 0
          body.locals plan.entries then
      none
    else if !body.basicBlocks.all (fun bb =>
        bb.statements.all (checkStmtForPtrs body.locals plan.entries) &&
          checkTermForPtrs body.locals plan.entries bb.terminator) then
      none
    else
      let base := body.locals.length
      let lowered :=
        lowerBlocksForPtrsLoop body.locals plan.entries base
          body.basicBlocks.length body.basicBlocks
      let bodyTgt : MemCopyBody := {
        body with
        locals := tombstonePtrDecls body.locals ++
          ptrCompDecls plan.entries.length ++ ptrScratchDecls
        basicBlocks := lowered.1 ++ lowered.2
      }
      match setElem? pSrc.bodies plan.defId bodyTgt with
      | none => none
      | some bodiesTgt => some { pSrc with bodies := bodiesTgt }

/-! ### Pass 4: `BufScalarize` (Single `.byteBuf` Lowering Into Unmodified `Trusted.MirAst`) -/

structure BufScalarizePlan where
  defId : DefId
  bufLocal : LocalId

noncomputable def checkStmtForBuf (decls : List MemCopyLocalDecl)
    (bufLocal : LocalId) : MemCopyStmt → Bool
  | .baseStmt (.storageLive _) | .baseStmt (.storageDead _)
  | .baseStmt .nop | .baseStmt .unsupported => true
  | .baseStmt (.assign dst rval) =>
    if !dst.projection.isEmpty then true
    else
      !Nat.beq dst.localId bufLocal && rvalueUsesOnlyBaseMem decls rval
  | .bufLivenessCheck _ => true
  | _ => false

noncomputable def checkTermForBuf (decls : List MemCopyLocalDecl)
    (bufLocal : LocalId) : MemCopyTerm → Bool
  | .baseTerm (.goto _) | .baseTerm .return_ | .baseTerm .unreachable => true
  | .baseTerm (.switchInt d _) => operandUsesOnlyBaseMem decls d
  | .baseTerm .unwindResume | .baseTerm (.assert _ _ _ _ _)
  | .baseTerm (.call _ _ _ _ _) | .baseTerm .unsupported => true
  | .readBufRawByte td vd b o _ =>
    !Nat.beq td vd &&
      !Nat.beq td bufLocal && !Nat.beq vd bufLocal &&
      operandHasBaseTy decls usizeTy o &&
      match Trusted.MirSemantics.getElem? decls td,
          Trusted.MirSemantics.getElem? decls vd with
      | some (.base t1), some (.base t2) =>
        MirTy.beq t1 usizeTy && MirTy.beq t2 usizeTy &&
          match Trusted.MirSemantics.getElem? decls b with
          | some (.byteBuf _ _ _) => true
          | _ => false
      | _, _ => false
  | .writeBufRawByte b o t v _ =>
    operandHasBaseTy decls usizeTy o &&
      operandHasBaseTy decls usizeTy t &&
      operandHasBaseTy decls usizeTy v &&
      match Trusted.MirSemantics.getElem? decls b with
      | some (.byteBuf _ _ _) => true
      | _ => false
  | _ => false

/-- Shift all `BasicBlockId` jump targets in a `MemCopyTerm` by `+ 1` to account
for the entry buffer-initialization prologue block `bb_0`. -/
noncomputable def shiftMemCopyTermTargets : MemCopyTerm → MemCopyTerm
  | .baseTerm (.goto t) => .baseTerm (.goto (t + 1))
  | .baseTerm (.switchInt d ts) =>
    .baseTerm (.switchInt d {
      otherwise := ts.otherwise + 1
      branches := ts.branches.map (fun br => (br.1, br.2 + 1))
    })
  | .baseTerm (.assert c e m t u) =>
    let u' : UnwindAction :=
      match u with | .cleanup b => .cleanup (b + 1) | other => other
    .baseTerm (.assert c e m (t + 1) u')
  | .baseTerm (.call f args dst t u) =>
    let t' := match t with | none => none | some b => some (b + 1)
    let u' : UnwindAction :=
      match u with | .cleanup b => .cleanup (b + 1) | other => other
    .baseTerm (.call f args dst t' u')
  | .baseTerm other => .baseTerm other
  | .ptrOffsetInbounds d s c e n => .ptrOffsetInbounds d s c e (n + 1)
  | .checkPtrPairAlign s d e a z n => .checkPtrPairAlign s d e a z (n + 1)
  | .readLeUsize d p w r n => .readLeUsize d p w r (n + 1)
  | .writeLeUsize p v w r n => .writeLeUsize p v w r (n + 1)
  | .readPtrLe8 d a r n => .readPtrLe8 d a r (n + 1)
  | .writePtrLe8 a v r n => .writePtrLe8 a v r (n + 1)
  | .copyNonOverlapping s d c e a z n => .copyNonOverlapping s d c e a z (n + 1)
  | .readBufRawByte td vd b o n => .readBufRawByte td vd b o (n + 1)
  | .writeBufRawByte b o t v n => .writeBufRawByte b o t v (n + 1)

noncomputable def lowerStmtForBuf (bufLocal base size : Nat) :
    MemCopyStmt → List MemCopyStmt
  | .baseStmt (.storageLive id) =>
    if Nat.beq id bufLocal then
      mkStorageLiveRange base (1 + 2 * size) ++
        mkZeroUsizeRange (base + 1) (2 * size)
    else
      [.baseStmt (.storageLive id)]
  | .baseStmt (.storageDead id) =>
    if Nat.beq id bufLocal then
      mkStorageDeadRange base (1 + 2 * size)
    else
      [.baseStmt (.storageDead id)]
  | .bufLivenessCheck b =>
    if Nat.beq b bufLocal then [mkLivenessCheckStmt base]
    else [.bufLivenessCheck b]
  | other => [other]

noncomputable def buildReadBufArms (tagDst valDst tagBase valBase shiftedNextBb : Nat) :
    Nat → Nat → Nat → List (BitVec 128 × BasicBlockId) × List MemCopyBlock
  | _, _, 0 => ([], [])
  | idx, armBb, rem + 1 =>
    let arm : MemCopyBlock := {
      statements := [
        mkAssignUse tagDst (.copy { localId := tagBase + idx, projection := [] }),
        mkAssignUse valDst (.copy { localId := valBase + idx, projection := [] })
      ]
      terminator := .baseTerm (.goto shiftedNextBb)
      cleanup := false
    }
    let rest :=
      buildReadBufArms tagDst valDst tagBase valBase shiftedNextBb
        (idx + 1) (armBb + 1) rem
    ((BitVec.ofNat 128 idx, armBb) :: rest.1, arm :: rest.2)

noncomputable def buildWriteBufArms (tagScr valScr tagBase valBase shiftedNextBb : Nat) :
    Nat → Nat → Nat → List (BitVec 128 × BasicBlockId) × List MemCopyBlock
  | _, _, 0 => ([], [])
  | idx, armBb, rem + 1 =>
    let arm : MemCopyBlock := {
      statements := [
        mkAssignUse (tagBase + idx) (.move { localId := tagScr, projection := [] }),
        mkAssignUse (valBase + idx) (.move { localId := valScr, projection := [] })
      ]
      terminator := .baseTerm (.goto shiftedNextBb)
      cleanup := false
    }
    let rest :=
      buildWriteBufArms tagScr valScr tagBase valBase shiftedNextBb
        (idx + 1) (armBb + 1) rem
    ((BitVec.ofNat 128 idx, armBb) :: rest.1, arm :: rest.2)

noncomputable def lowerTermForBuf (bufLocal base size : Nat)
    (mutability : Mutability) (nextExtraBb : Nat) :
    MemCopyTerm → List MemCopyStmt × MemCopyTerm × List MemCopyBlock
  | .readBufRawByte tagDst valDst b offOp nextBb =>
    if Nat.beq b bufLocal then
      let offScr := base + 1 + 2 * size + 1
      let built :=
        buildReadBufArms tagDst valDst (base + 1) (base + 1 + size)
          (nextBb + 1) 0 nextExtraBb size
      let trapBbId := nextExtraBb + size
      let trapBb : MemCopyBlock :=
        { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
      ([mkAssignUse offScr offOp, mkLivenessCheckStmt base],
       .baseTerm (.switchInt (.move { localId := offScr, projection := [] })
         { branches := built.1, otherwise := trapBbId }),
       built.2 ++ [trapBb])
    else
      ([], .readBufRawByte tagDst valDst b offOp (nextBb + 1), [])
  | .writeBufRawByte b offOp tagOp valOp nextBb =>
    if Nat.beq b bufLocal then
      let faultScr := base + 1 + 2 * size
      let offScr := base + 1 + 2 * size + 1
      let tagScr := base + 1 + 2 * size + 2
      let valScr := base + 1 + 2 * size + 3
      let evalArgs : List MemCopyStmt := [
        mkAssignUse offScr offOp,
        mkAssignUse tagScr tagOp,
        mkAssignUse valScr valOp,
        mkLivenessCheckStmt base
      ]
      if !(Mutability.beq mutability .mut) then
        (evalArgs ++ [mkImmediateUbStmt faultScr], .baseTerm .unreachable, [])
      else
        let zeroTagBbId := nextExtraBb
        let dispatchBbId := nextExtraBb + 1
        let armsStartBbId := nextExtraBb + 2
        let trapBbId := armsStartBbId + size
        let built :=
          buildWriteBufArms tagScr valScr (base + 1) (base + 1 + size)
            (nextBb + 1) 0 armsStartBbId size
        let zeroTagBb : MemCopyBlock := {
          statements := [mkAssignUse valScr (usizeConst 0)]
          terminator := .baseTerm (.goto dispatchBbId)
          cleanup := false
        }
        let dispatchBb : MemCopyBlock := {
          statements := []
          terminator := .baseTerm (.switchInt
            (.move { localId := offScr, projection := [] })
            { branches := built.1, otherwise := trapBbId })
          cleanup := false
        }
        let trapBb : MemCopyBlock :=
          { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
        (evalArgs ++ [
           mkBinOpStmt valScr .bitAnd
             (.move { localId := valScr, projection := [] }) (usizeConst 255)
         ],
         .baseTerm (.switchInt (.copy { localId := tagScr, projection := [] })
           { branches := [(BitVec.ofNat 128 0, zeroTagBbId)]
             otherwise := dispatchBbId }),
         [zeroTagBb, dispatchBb] ++ built.2 ++ [trapBb])
    else
      ([], .writeBufRawByte b offOp tagOp valOp (nextBb + 1), [])
  | other => ([], shiftMemCopyTermTargets other, [])

noncomputable def lowerBlocksForBufLoop (bufLocal base size : Nat)
    (mutability : Mutability) :
    Nat → List MemCopyBlock → List MemCopyBlock × List MemCopyBlock
  | _, [] => ([], [])
  | nextExtra, bb :: rest =>
    let bodyStmts := listFlatMap (lowerStmtForBuf bufLocal base size) bb.statements
    let (termPre, termTgt, extra) :=
      lowerTermForBuf bufLocal base size mutability nextExtra bb.terminator
    let bbTgt : MemCopyBlock := {
      bb with
      statements := bodyStmts ++ termPre
      terminator := termTgt
    }
    let tail :=
      lowerBlocksForBufLoop bufLocal base size mutability
        (nextExtra + extra.length) rest
    (bbTgt :: tail.1, extra ++ tail.2)

noncomputable def applyBufScalarize (plan : BufScalarizePlan)
    (pSrc : MemCopyProgram) : Option MemCopyProgram :=
  match Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => none
  | some body =>
    if body.acceptsCallerMem ||
        body.basicBlocks.isEmpty ||
        !Nat.blt body.argumentCount plan.bufLocal ||
        !Nat.blt plan.bufLocal body.locals.length ||
        !memCopyStorageAnnotationsInBounds body ||
        !memCopyBodyLocalsInBounds body ||
        !memCopyBodyTargetsInBounds body then
      none
    else if body.locals.any (fun d =>
        match d with | .ptrLocal => true | _ => false) then
      none
    else
      match Trusted.MirSemantics.getElem? body.locals plan.bufLocal with
      | some (.byteBuf size alignLog2 mutability) =>
        if !Nat.ble size 32 || !Nat.ble alignLog2 30 then
          none
        else if !body.basicBlocks.all (fun bb =>
            bb.statements.all (checkStmtForBuf body.locals plan.bufLocal) &&
              checkTermForBuf body.locals plan.bufLocal bb.terminator) then
          none
        else
          match setElem? body.locals plan.bufLocal (.base .unit) with
          | none => none
          | some localsTombstoned =>
            let base := body.locals.length
            let hasAnnot := memCopyHasStorageAnnotation body plan.bufLocal
            let entryPrologue : MemCopyBlock := {
              statements :=
                if hasAnnot then [] else mkZeroUsizeRange (base + 1) (2 * size)
              terminator := .baseTerm (.goto 1)
              cleanup := false
            }
            let lowered :=
              lowerBlocksForBufLoop plan.bufLocal base size mutability
                (1 + body.basicBlocks.length) body.basicBlocks
            let byteDecls := listReplicate (2 * size) (.base usizeTy)
            let scrDecls := listReplicate 4 (.base usizeTy)
            let bodyTgt : MemCopyBody := {
              body with
              locals := localsTombstoned ++ [.base .unit] ++ byteDecls ++ scrDecls
              basicBlocks := entryPrologue :: (lowered.1 ++ lowered.2)
            }
            match setElem? pSrc.bodies plan.defId bodyTgt with
            | none => none
            | some bodiesTgt => some { pSrc with bodies := bodiesTgt }
      | _ => none

/-! ### Unified `MemCopyOptStep`, `MemCopyOptTrace`, & `Trusted.MirAst` Validator -/

inductive MemCopyOptStep where
  | foldZeroOffsetStmt (bodyId : DefId) (bbIdx : BasicBlockId) (stmtIdx : Nat)
  | foldZeroOffsetTerm (bodyId : DefId) (bbIdx : BasicBlockId)
  | foldGuardedZeroCopy (bodyId : DefId) (bbIdx : BasicBlockId)
  | ptrScalarize (plan : PtrScalarizePlan)
  | bufScalarize (plan : BufScalarizePlan)

abbrev MemCopyOptTrace := List MemCopyOptStep

noncomputable def applyMemCopyOptStep :
    MemCopyOptStep → MemCopyProgram → Option MemCopyProgram
  | .foldZeroOffsetStmt bodyId bbIdx stmtIdx, p =>
    applyFoldZeroOffsetStmt bodyId bbIdx stmtIdx p
  | .foldZeroOffsetTerm bodyId bbIdx, p =>
    applyFoldZeroOffsetTerm bodyId bbIdx p
  | .foldGuardedZeroCopy bodyId bbIdx, p =>
    applyFoldGuardedZeroCopy bodyId bbIdx p
  | .ptrScalarize plan, p => applyPtrScalarize plan p
  | .bufScalarize plan, p => applyBufScalarize plan p

noncomputable def applyMemCopyOptTrace :
    MemCopyOptTrace → MemCopyProgram → Option MemCopyProgram
  | [], p => some p
  | step :: rest, p =>
    match applyMemCopyOptStep step p with
    | some pMid => applyMemCopyOptTrace rest pMid
    | none => none

/-- Decidable certificate validator checking `pSrc --[trace]*--> pFlat` AND
projecting `pFlat` directly onto an unmodified `Trusted.MirAst.Program`
(`pMir`). -/
noncomputable def checkMemCopyToTrustedMir (trace : MemCopyOptTrace)
    (pSrc : MemCopyProgram) (pMir : Program) : Bool :=
  match applyMemCopyOptTrace trace pSrc with
  | none => false
  | some pFlat =>
    match unembedBaseProgram pFlat with
    | some pOut => programEq pOut pMir
    | none => false


