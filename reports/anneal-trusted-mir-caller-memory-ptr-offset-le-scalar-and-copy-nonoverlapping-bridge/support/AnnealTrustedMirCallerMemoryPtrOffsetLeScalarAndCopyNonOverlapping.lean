/-! ## Core Boolean, Natural Number, Option, and List Helpers -/

private theorem bool_and_eq_true : ∀ a b : Bool, (a && b) = true ↔ a = true ∧ b = true
  | true, true => ⟨(fun _ => ⟨rfl, rfl⟩), (fun _ => rfl)⟩
  | true, false => ⟨(fun h => by cases h), (fun h => by cases h.2)⟩
  | false, true => ⟨(fun h => by cases h), (fun h => by cases h.1)⟩
  | false, false => ⟨(fun h => by cases h), (fun h => by cases h.1)⟩

private theorem bool_or_eq_true : ∀ a b : Bool, (a || b) = true ↔ a = true ∨ b = true
  | true, true => ⟨(fun _ => Or.inl rfl), (fun _ => rfl)⟩
  | true, false => ⟨(fun _ => Or.inl rfl), (fun _ => rfl)⟩
  | false, true => ⟨(fun _ => Or.inr rfl), (fun _ => rfl)⟩
  | false, false => ⟨(fun h => by cases h), (fun h => by cases h with | inl h1 => cases h1 | inr h2 => cases h2)⟩

private theorem bool_not_eq_true (a : Bool) : (!a) = true ↔ a = false := by
  cases a <;> constructor <;> intro h <;> first | rfl | cases h

private theorem bool_not_eq_false (a : Bool) : (!a) = false ↔ a = true := by
  cases a <;> constructor <;> intro h <;> first | rfl | cases h

private theorem boolEq_eq (a b : Bool) (h : boolEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem boolEq_refl (a : Bool) : boolEq a a = true := by
  cases a <;> rfl

private theorem nat_beq_eq (a b : Nat) (h : Nat.beq a b = true) : a = b :=
  Nat.eq_of_beq_eq_true h

private theorem nat_beq_refl (a : Nat) : Nat.beq a a = true :=
  Nat.beq_refl a

private theorem nat_beq_false_ne {a b : Nat} (h : Nat.beq a b = false) : a ≠ b := by
  intro heq
  subst heq
  rw [nat_beq_refl] at h
  cases h

private theorem nat_ble_eq_le (a b : Nat) : Nat.ble a b = true ↔ a ≤ b :=
  ⟨Nat.le_of_ble_eq_true, Nat.ble_eq_true_of_le⟩

private theorem nat_blt_eq_lt (a b : Nat) : Nat.blt a b = true ↔ a < b := by
  unfold Nat.blt
  exact nat_ble_eq_le (a + 1) b

private theorem nat_ble_false_gt {a b : Nat} (h : Nat.ble a b = false) : b < a := by
  cases Nat.lt_or_ge b a with
  | inl hlt => exact hlt
  | inr hle =>
    rw [(nat_ble_eq_le a b).mpr hle] at h
    cases h

private theorem nat_blt_false_ge {a b : Nat} (h : Nat.blt a b = false) : b ≤ a := by
  cases Nat.lt_or_ge a b with
  | inl hlt =>
    rw [(nat_blt_eq_lt a b).mpr hlt] at h
    cases h
  | inr hle => exact hle

private theorem nat_le_antisymm {a b : Nat} (h₁ : a ≤ b) (h₂ : b ≤ a) : a = b :=
  Nat.le_antisymm h₁ h₂

private theorem nat_lt_of_add_lt_add_left {k a b : Nat} (h : k + a < k + b) : a < b := by
  induction k with
  | zero =>
    rw [Nat.zero_add, Nat.zero_add] at h
    exact h
  | succ k ih =>
    rw [Nat.succ_add, Nat.succ_add] at h
    exact ih (Nat.lt_of_succ_lt_succ h)

private theorem nat_lt_of_add_lt_add_right {a b k : Nat} (h : a + k < b + k) : a < b := by
  rw [Nat.add_comm a k, Nat.add_comm b k] at h
  exact nat_lt_of_add_lt_add_left h

private theorem nat_add_sub_cancel' (n m : Nat) : (n + m) - n = m := by
  rw [Nat.add_comm]
  exact Nat.add_sub_cancel m n

private theorem optNatEq_eq : ∀ a b : Option Nat, optNatEq a b = true → a = b
  | none, none, _ => rfl
  | none, some _, h => by cases h
  | some _, none, h => by cases h
  | some x, some y, h => by
    rw [nat_beq_eq x y h]

private theorem optNatEq_refl (a : Option Nat) : optNatEq a a = true := by
  cases a
  · rfl
  · exact nat_beq_refl _

private noncomputable def intEq : Int → Int → Bool
  | .ofNat a, .ofNat b => Nat.beq a b
  | .negSucc a, .negSucc b => Nat.beq a b
  | _, _ => false

private theorem intEq_eq : ∀ a b : Int, intEq a b = true → a = b
  | .ofNat a, .ofNat b, h => by rw [nat_beq_eq a b h]
  | .negSucc a, .negSucc b, h => by rw [nat_beq_eq a b h]
  | .ofNat _, .negSucc _, h => by cases h
  | .negSucc _, .ofNat _, h => by cases h

private theorem intEq_refl : ∀ a : Int, intEq a a = true
  | .ofNat a => nat_beq_refl a
  | .negSucc a => nat_beq_refl a

private theorem listRel_eq_of_eq {α : Type} {r : α → α → Bool}
    (hr : ∀ x y : α, r x y = true → x = y) :
    ∀ xs ys : List α, listRel r xs ys = true → xs = ys
  | [], [], _ => rfl
  | [], _ :: _, h => by cases h
  | _ :: _, [], h => by cases h
  | x :: xs, y :: ys, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [hr x y hAnd.1, listRel_eq_of_eq hr xs ys hAnd.2]

private theorem listRel_refl {α : Type} {r : α → α → Bool}
    (hr : ∀ x : α, r x x = true) :
    ∀ xs : List α, listRel r xs xs = true
  | [] => rfl
  | x :: xs => by
    change (r x x && listRel r xs xs) = true
    rw [hr x, listRel_refl hr xs]
    rfl

private theorem listFlatMap_append {α β : Type} (f : α → List β) :
    ∀ xs ys : List α, listFlatMap f (xs ++ ys) = listFlatMap f xs ++ listFlatMap f ys
  | [], ys => rfl
  | x :: xs, ys => by
    change f x ++ listFlatMap f (xs ++ ys) = (f x ++ listFlatMap f xs) ++ listFlatMap f ys
    rw [listFlatMap_append f xs ys, List.append_assoc]

private theorem listFlatMap_eq_nil_of_forall {α β : Type} (f : α → List β) :
    ∀ xs : List α, (∀ x : α, f x = []) → listFlatMap f xs = []
  | [], _ => rfl
  | x :: xs, hf => by
    change f x ++ listFlatMap f xs = []
    rw [hf x, listFlatMap_eq_nil_of_forall f xs hf]
    rfl

private theorem listMapOption_length {α β : Type} (f : α → Option β) :
    ∀ {xs : List α} {ys : List β}, listMapOption f xs = some ys → ys.length = xs.length
  | [], ys, h => by
    cases h
    rfl
  | x :: xs, ys, h => by
    change (match f x, listMapOption f xs with | some y, some ys' => some (y :: ys') | _, _ => none) = some ys at h
    cases hx : f x with
    | none =>
      rw [hx] at h
      cases h
    | some y =>
      cases hxs : listMapOption f xs with
      | none =>
        rw [hx, hxs] at h
        cases h
      | some ys' =>
        rw [hx, hxs] at h
        cases h
        change ys'.length + 1 = xs.length + 1
        rw [listMapOption_length f hxs]

private theorem listMapOption_getElem? {α β : Type} (f : α → Option β) :
    ∀ {xs : List α} {ys : List β} (i : Nat),
      listMapOption f xs = some ys →
      ys[i]? = match xs[i]? with | none => none | some x => f x
  | [], ys, i, h => by
    cases h
    cases i <;> rfl
  | x :: xs, ys, i, h => by
    change (match f x, listMapOption f xs with | some y, some ys' => some (y :: ys') | _, _ => none) = some ys at h
    cases hx : f x with
    | none =>
      rw [hx] at h
      cases h
    | some y =>
      cases hxs : listMapOption f xs with
      | none =>
        rw [hx, hxs] at h
        cases h
      | some ys' =>
        rw [hx, hxs] at h
        cases h
        cases i with
        | zero => exact hx.symm
        | succ k => exact listMapOption_getElem? f k hxs

private theorem getElem?_lt_some {α : Type} :
    ∀ (xs : List α) (i : Nat), i < xs.length → ∃ x : α, xs[i]? = some x
  | [], i, h => False.elim (Nat.not_lt_zero i h)
  | x :: _, 0, _ => ⟨x, rfl⟩
  | _ :: xs, i + 1, h => getElem?_lt_some xs i (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_some_lt {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α), xs[i]? = some x → i < xs.length
  | [], _, _, h => by cases h
  | _ :: _, 0, _, _ => Nat.zero_lt_succ _
  | _ :: xs, i + 1, x, h => Nat.succ_lt_succ (getElem?_some_lt xs i x h)

private theorem getElem?_ge_none {α : Type} :
    ∀ (xs : List α) (i : Nat), xs.length ≤ i → xs[i]? = none
  | [], 0, _ => rfl
  | [], _ + 1, _ => rfl
  | _ :: _, 0, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, i + 1, h => getElem?_ge_none xs i (Nat.le_of_succ_le_succ h)

private theorem getElem?_set_eq {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α), i < xs.length → (xs.set i v)[i]? = some v
  | [], i, _, h => False.elim (Nat.not_lt_zero i h)
  | _ :: _, 0, _, _ => rfl
  | _ :: xs, i + 1, v, h => getElem?_set_eq xs i v (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_set_ne {α : Type} :
    ∀ (xs : List α) (i j : Nat) (v : α), i ≠ j → (xs.set i v)[j]? = xs[j]?
  | [], _, _, _, _ => rfl
  | _ :: _, 0, 0, _, h => False.elim (h rfl)
  | _ :: _, 0, _ + 1, _, _ => rfl
  | _ :: _, _ + 1, 0, _, _ => rfl
  | _ :: xs, i + 1, j + 1, v, h =>
    getElem?_set_ne xs i j v (fun heq => h (congrArg Nat.succ heq))

private theorem set_length {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α), (xs.set i v).length = xs.length
  | [], _, _ => rfl
  | _ :: _, 0, _ => rfl
  | _ :: xs, i + 1, v => by
    change (xs.set i v).length + 1 = xs.length + 1
    rw [set_length xs i v]

private theorem list_map_getElem? {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat), (xs.map f)[i]? = Option.map f xs[i]?
  | [], 0 => rfl
  | [], _ + 1 => rfl
  | _ :: _, 0 => rfl
  | _ :: xs, i + 1 => list_map_getElem? f xs i

private theorem list_take_append_getElem? {α : Type} :
    ∀ (xs : List α) (n : Nat) (x : α),
      xs[n]? = some x → xs.take (n + 1) = xs.take n ++ [x]
  | [], _, _, h => by cases h
  | x₀ :: xs, 0, x, h => by
    cases h
    rfl
  | x₀ :: xs, n + 1, x, h => by
    change x₀ :: (xs.take (n + 1)) = x₀ :: (xs.take n ++ [x])
    rw [list_take_append_getElem? xs n x h]

private theorem list_append_getElem?_left {α : Type} :
    ∀ (xs ys : List α) (i : Nat), i < xs.length → (xs ++ ys)[i]? = xs[i]?
  | [], _, i, h => False.elim (Nat.not_lt_zero i h)
  | _ :: _, _, 0, _ => rfl
  | _ :: xs, ys, i + 1, h => list_append_getElem?_left xs ys i (Nat.lt_of_succ_lt_succ h)

private theorem list_append_getElem?_right {α : Type} :
    ∀ (xs ys : List α) (i : Nat), xs.length ≤ i → (xs ++ ys)[i]? = ys[i - xs.length]?
  | [], ys, 0, _ => rfl
  | [], ys, i + 1, _ => rfl
  | _ :: _, _, 0, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, ys, i + 1, h => by
    change (xs ++ ys)[i]? = ys[(i + 1) - (xs.length + 1)]?
    rw [Nat.succ_sub_succ_eq_sub]
    exact list_append_getElem?_right xs ys i (Nat.le_of_succ_le_succ h)

private theorem list_drop_getElem? {α : Type} :
    ∀ (xs : List α) (k i : Nat), (xs.drop k)[i]? = xs[k + i]?
  | xs, 0, i => by
    rw [Nat.zero_add]
    rfl
  | [], k + 1, i => by
    change ([] : List α)[i]? = ([] : List α)[k + 1 + i]?
    cases i <;> cases (k + 1 + _) <;> rfl
  | _ :: xs, k + 1, i => by
    rw [Nat.succ_add]
    exact list_drop_getElem? xs k i

private theorem list_take_getElem?_lt {α : Type} :
    ∀ (xs : List α) (k i : Nat), i < k → (xs.take k)[i]? = xs[i]?
  | _, 0, i, h => False.elim (Nat.not_lt_zero i h)
  | [], _ + 1, 0, _ => rfl
  | [], _ + 1, _ + 1, _ => rfl
  | _ :: _, _ + 1, 0, _ => rfl
  | _ :: xs, k + 1, i + 1, h => list_take_getElem?_lt xs k i (Nat.lt_of_succ_lt_succ h)

private theorem list_map_length {α β : Type} (f : α → β) :
    ∀ xs : List α, (xs.map f).length = xs.length
  | [] => rfl
  | _ :: xs => by
    change (xs.map f).length + 1 = xs.length + 1
    rw [list_map_length f xs]

private theorem list_all_eq_true {α : Type} (p : α → Bool) :
    ∀ xs : List α, xs.all p = true ↔ ∀ x : α, List.Mem x xs → p x = true
  | [] => ⟨(fun _ _ hx => by cases hx), (fun _ => rfl)⟩
  | x :: xs => by
    change (p x && xs.all p) = true ↔ ∀ y : α, List.Mem y (x :: xs) → p y = true
    rw [bool_and_eq_true, list_all_eq_true p xs]
    constructor
    · intro h y hy
      cases hy with
      | head => exact h.1
      | tail _ hmem => exact h.2 y hmem
    · intro h
      refine ⟨h x (List.Mem.head xs), fun y hy => h y (List.Mem.tail x hy)⟩

private theorem list_all_getElem? {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (i : Nat) (x : α), xs.all p = true → xs[i]? = some x → p x = true
  | [], _, _, _, h => by cases h
  | x :: _, 0, y, hall, hget => by
    cases hget
    exact ((bool_and_eq_true _ _).mp hall).1
  | _ :: xs, i + 1, y, hall, hget =>
    list_all_getElem? p xs i y ((bool_and_eq_true _ _).mp hall).2 hget

private theorem list_any_eq_true {α : Type} (p : α → Bool) :
    ∀ xs : List α, xs.any p = true ↔ ∃ x : α, List.Mem x xs ∧ p x = true
  | [] => ⟨(fun h => by cases h), (fun h => by cases h with | intro _ hx => cases hx.1)⟩
  | x :: xs => by
    change (p x || xs.any p) = true ↔ ∃ y : α, List.Mem y (x :: xs) ∧ p y = true
    rw [bool_or_eq_true, list_any_eq_true p xs]
    constructor
    · intro h
      cases h with
      | inl hx => exact ⟨x, List.Mem.head xs, hx⟩
      | inr hxs =>
        cases hxs with
        | intro y hy => exact ⟨y, List.Mem.tail x hy.1, hy.2⟩
    · intro h
      cases h with
      | intro y hy =>
        cases hy.1 with
        | head => exact Or.inl hy.2
        | tail _ hmem => exact Or.inr ⟨y, hmem, hy.2⟩

private theorem list_any_false_forall {α : Type} (p : α → Bool) :
    ∀ xs : List α, xs.any p = false → ∀ x : α, List.Mem x xs → p x = false
  | [], _, _, hx => by cases hx
  | x :: xs, hany, y, hy => by
    change (p x || xs.any p) = false at hany
    cases hx : p x with
    | true =>
      rw [hx] at hany
      cases hany
    | false =>
      rw [hx] at hany
      cases hy with
      | head => exact hx
      | tail _ hmem => exact list_any_false_forall p xs hany y hmem

private theorem list_any_false_getElem? {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (i : Nat) (x : α), xs.any p = false → xs[i]? = some x → p x = false
  | [], _, _, _, h => by cases h
  | x :: _, 0, _, hany, hget => by
    cases hget
    exact list_any_false_forall p _ hany _ (List.Mem.head _)
  | x :: xs, i + 1, y, hany, hget => by
    have hSub : xs.any p = false := by
      change (p x || xs.any p) = false at hany
      cases hx : p x with
      | true =>
        rw [hx] at hany
        cases hany
      | false =>
        rw [hx] at hany
        exact hany
    exact list_any_false_getElem? p xs i y hSub hget

private theorem list_any_mem_eq_true {α : Type} (p : α → Bool) {xs : List α} {x : α}
    (hmem : List.Mem x xs) (hp : p x = true) : xs.any p = true :=
  (list_any_eq_true p xs).mpr ⟨x, hmem, hp⟩

/-! ## Base Program Step Chains & Equivalence Combinators -/

private theorem stepBase_iff_evalStep (p : Program) (s : State)
    (res : StepResult State TerminalOut) :
    Step p s res ↔ evalStep p 0 s = res := by
  constructor
  · intro h
    cases h with
    | intro c hc =>
      have hc0 : c = 0 := hc.1
      rw [hc0] at hc
      exact hc.2
  · intro h
    exact ⟨0, rfl, h⟩

private theorem evalStep_det {p : Program} {s : State}
    {r₁ r₂ : StepResult State TerminalOut}
    (h₁ : Step p s r₁) (h₂ : Step p s r₂) : r₁ = r₂ := by
  have e₁ := (stepBase_iff_evalStep p s r₁).mp h₁
  have e₂ := (stepBase_iff_evalStep p s r₂).mp h₂
  rw [← e₁, e₂]

private inductive ReachesNBase (p : Program) : Nat → State → State → Prop where
  | zero (s : State) : ReachesNBase p 0 s s
  | succ {n : Nat} {s₁ s₂ s₃ : State} :
      Step p s₁ (.step s₂) →
      ReachesNBase p n s₂ s₃ →
      ReachesNBase p (n + 1) s₁ s₃

private noncomputable def stepChainFromBase (p : Program) : Nat → State → Option State
  | 0, s => some s
  | n + 1, s =>
    match evalStep p 0 s with
    | .step s' => stepChainFromBase p n s'
    | _ => none

private noncomputable def stepChainExecBase (p : Program) (n : Nat) (s : State) : State :=
  match stepChainFromBase p n s with
  | some s' => s'
  | none => s

private theorem reachesNBase_trans {p : Program} :
    ∀ {n m : Nat} {s₁ s₂ s₃ : State},
      ReachesNBase p n s₁ s₂ → ReachesNBase p m s₂ s₃ → ReachesNBase p (n + m) s₁ s₃
  | 0, _, _, _, _, .zero _, h₂ => by
    rw [Nat.zero_add]
    exact h₂
  | _ + 1, _, _, _, _, .succ hStep hRest, h₂ => by
    rw [Nat.succ_add]
    exact .succ hStep (reachesNBase_trans hRest h₂)

private theorem reachesNBase_split_add {p : Program} :
    ∀ {n m : Nat} {s₁ s₃ : State},
      ReachesNBase p (n + m) s₁ s₃ →
      ∃ s₂ : State, ReachesNBase p n s₁ s₂ ∧ ReachesNBase p m s₂ s₃
  | 0, _, s₁, _, h => by
    rw [Nat.zero_add] at h
    exact ⟨s₁, .zero s₁, h⟩
  | _ + 1, _, _, _, h => by
    rw [Nat.succ_add] at h
    cases h with
    | succ hStep hRest =>
      cases reachesNBase_split_add hRest with
      | intro s₂ hs => exact ⟨s₂, .succ hStep hs.1, hs.2⟩

private theorem reachesNBase_det {p : Program} :
    ∀ {n : Nat} {s s₁ s₂ : State},
      ReachesNBase p n s s₁ → ReachesNBase p n s s₂ → s₁ = s₂
  | 0, _, _, _, .zero _, .zero _ => rfl
  | _ + 1, _, _, _, .succ h₁ r₁, .succ h₂ r₂ => by
    have hEq := evalStep_det h₁ h₂
    cases hEq
    exact reachesNBase_det r₁ r₂

private theorem c_reachesBase_head {p : Program} {s₁ s₂ s₃ : State}
    (hStep : Step p s₁ (.step s₂)) (hReach : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction hReach with
  | refl => exact Reaches.tail (Reaches.refl s₁) hStep
  | tail _ hTail ih => exact Reaches.tail ih hTail

private theorem c_reachesBase_trans {p : Program} {s₁ s₂ s₃ : State}
    (h₁ : Reaches p s₁ s₂) (h₂ : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction h₂ with
  | refl => exact h₁
  | tail _ hTail ih => exact Reaches.tail ih hTail

private theorem reachesBase_of_reachesNBase {p : Program} :
    ∀ {n : Nat} {s₁ s₂ : State}, ReachesNBase p n s₁ s₂ → Reaches p s₁ s₂
  | 0, s₁, _, .zero _ => Reaches.refl s₁
  | _ + 1, _, _, .succ hStep hRest =>
    c_reachesBase_head hStep (reachesBase_of_reachesNBase hRest)

private theorem reachesNBase_of_reachesBase {p : Program} {s₁ s₂ : State}
    (h : Reaches p s₁ s₂) : ∃ n : Nat, ReachesNBase p n s₁ s₂ := by
  induction h with
  | refl => exact ⟨0, .zero s₁⟩
  | tail _ hTail ih =>
    cases ih with
    | intro n hn => exact ⟨n + 1, reachesNBase_trans hn (.succ hTail (.zero _))⟩

private theorem reachesNBase_iff_stepChainFromBase (p : Program) :
    ∀ (n : Nat) (s₁ s₂ : State),
      ReachesNBase p n s₁ s₂ ↔ stepChainFromBase p n s₁ = some s₂
  | 0, s₁, _ => by
    constructor
    · intro h
      cases h
      rfl
    · intro h
      cases h
      exact .zero s₁
  | n + 1, s₁, s₂ => by
    constructor
    · intro h
      cases h with
      | succ hStep hRest =>
        have hEval := (stepBase_iff_evalStep p s₁ (.step _)).mp hStep
        change (match evalStep p 0 s₁ with
                | .step s' => stepChainFromBase p n s'
                | _ => none) = some s₂
        rw [hEval]
        exact (reachesNBase_iff_stepChainFromBase p n _ s₂).mp hRest
    · intro h
      change (match evalStep p 0 s₁ with
              | .step s' => stepChainFromBase p n s'
              | _ => none) = some s₂ at h
      cases hEval : evalStep p 0 s₁ with
      | step s' =>
        rw [hEval] at h
        exact .succ ((stepBase_iff_evalStep p s₁ (.step s')).mpr hEval)
          ((reachesNBase_iff_stepChainFromBase p n s' s₂).mpr h)
      | done _ =>
        rw [hEval] at h
        cases h
      | fault _ =>
        rw [hEval] at h
        cases h

private theorem stepChainFromBase_succ_right (p : Program) :
    ∀ (n : Nat) (s sₙ : State),
      stepChainFromBase p n s = some sₙ →
      stepChainFromBase p (n + 1) s =
        match evalStep p 0 sₙ with
        | .step sₙ' => some sₙ'
        | _ => none
  | 0, s, _, h => by
    cases h
    change (match evalStep p 0 s with
            | .step s' => stepChainFromBase p 0 s'
            | _ => none) =
           (match evalStep p 0 s with
            | .step sₙ' => some sₙ'
            | _ => none)
    cases evalStep p 0 s <;> rfl
  | n + 1, s, sₙ, h => by
    change (match evalStep p 0 s with
            | .step s' => stepChainFromBase p n s'
            | _ => none) = some sₙ at h
    cases hEval : evalStep p 0 s with
    | step s' =>
      rw [hEval] at h
      change (match evalStep p 0 s with
              | .step t => stepChainFromBase p (n + 1) t
              | _ => none) = _
      rw [hEval]
      exact stepChainFromBase_succ_right p n s' sₙ h
    | done _ =>
      rw [hEval] at h
      cases h
    | fault _ =>
      rw [hEval] at h
      cases h

private theorem stepChainFromBase_of_trace (p : Program) (trace : Nat → State)
    (hTrace : ∀ k : Nat, Step p (trace k) (.step (trace (k + 1)))) :
    ∀ (n k : Nat), stepChainFromBase p n (trace k) = some (trace (k + n))
  | 0, k => by
    rw [Nat.add_zero]
    rfl
  | n + 1, k => by
    have hEval := (stepBase_iff_evalStep p (trace k) (.step (trace (k + 1)))).mp (hTrace k)
    change (match evalStep p 0 (trace k) with
            | .step s' => stepChainFromBase p n s'
            | _ => none) = some (trace (k + (n + 1)))
    rw [hEval]
    have hShift : k + (n + 1) = (k + 1) + n := by
      rw [Nat.add_assoc, Nat.add_comm 1 n]
    rw [hShift]
    exact stepChainFromBase_of_trace p trace hTrace n (k + 1)

private theorem divergesBase_iff_stepChain (p : Program) (q : Query) :
    Diverges p q ↔
      ∃ s₀ : State, initState p q = .ok s₀ ∧
        ∀ n : Nat, ∃ sₙ : State, stepChainFromBase p n s₀ = some sₙ := by
  constructor
  · intro hDiv
    cases hDiv with
    | intro s₀ hs₀ =>
      cases hs₀.2 with
      | intro trace hTr =>
        refine ⟨s₀, hs₀.1, ?_⟩
        intro n
        have hC := stepChainFromBase_of_trace p trace hTr.2 n 0
        rw [hTr.1, Nat.zero_add] at hC
        exact ⟨trace n, hC⟩
  · intro hChain
    cases hChain with
    | intro s₀ hs₀ =>
      refine ⟨s₀, hs₀.1, (fun k => stepChainExecBase p k s₀), rfl, ?_⟩
      intro n
      cases hs₀.2 n with
      | intro sₙ hsₙ =>
        cases hs₀.2 (n + 1) with
        | intro sₙ₁ hsₙ₁ =>
          have hNext := stepChainFromBase_succ_right p n s₀ sₙ hsₙ
          rw [hsₙ₁] at hNext
          cases hEval : evalStep p 0 sₙ with
          | step t =>
            rw [hEval] at hNext
            cases hNext
            have hExN : stepChainExecBase p n s₀ = sₙ := by
              unfold stepChainExecBase
              rw [hsₙ]
            have hExN1 : stepChainExecBase p (n + 1) s₀ = sₙ₁ := by
              unfold stepChainExecBase
              rw [hsₙ₁]
            dsimp
            rw [hExN, hExN1]
            exact (stepBase_iff_evalStep p sₙ (.step sₙ₁)).mpr hEval
          | done _ =>
            rw [hEval] at hNext
            cases hNext
          | fault _ =>
            rw [hEval] at hNext
            cases hNext

private theorem wellFormedBase_iff_no_fault (p : Program) (q : Query) :
    WellFormed p q ↔ ∀ k : FaultKind, ¬ ReachesResult p q (.fault k) := by
  constructor
  · intro h
    exact h.2
  · intro hNoFault
    refine ⟨?_, hNoFault⟩
    cases hInit : initState p q with
    | error k =>
      have hF : ReachesResult p q (.fault k) := by
        unfold ReachesResult
        rw [hInit]
      exact False.elim (hNoFault k hF)
    | ok s₀ =>
      exact ⟨s₀, rfl, fun _ _ => ⟨0, rfl⟩⟩

private theorem divergesBase_iff_no_terminal_or_fault (p : Program) (q : Query) :
    Diverges p q ↔
      (∃ s₀ : State, initState p q = .ok s₀) ∧
      (∀ out : TerminalOut, ¬ Behavior p q out) ∧
      (∀ k : FaultKind, ¬ ReachesResult p q (.fault k)) := by
  rw [divergesBase_iff_stepChain]
  constructor
  · intro hDiv
    cases hDiv with
    | intro s₀ hs₀ =>
      refine ⟨⟨s₀, hs₀.1⟩, ?_, ?_⟩
      · intro out hBeh
        unfold Behavior ReachesResult at hBeh
        rw [hs₀.1] at hBeh
        cases hBeh with
        | intro sEnd hsEnd =>
          cases reachesNBase_of_reachesBase hsEnd.1 with
          | intro n hnReach =>
            have hChain := (reachesNBase_iff_stepChainFromBase p n s₀ sEnd).mp hnReach
            have hNext := stepChainFromBase_succ_right p n s₀ sEnd hChain
            have hStepEnd := (stepBase_iff_evalStep p sEnd (.done out)).mp hsEnd.2
            rw [hStepEnd] at hNext
            cases hs₀.2 (n + 1) with
            | intro sₙ₁ hsₙ₁ =>
              rw [hsₙ₁] at hNext
              cases hNext
      · intro k hFault
        unfold ReachesResult at hFault
        rw [hs₀.1] at hFault
        cases hFault with
        | intro sEnd hsEnd =>
          cases reachesNBase_of_reachesBase hsEnd.1 with
          | intro n hnReach =>
            have hChain := (reachesNBase_iff_stepChainFromBase p n s₀ sEnd).mp hnReach
            have hNext := stepChainFromBase_succ_right p n s₀ sEnd hChain
            have hStepEnd := (stepBase_iff_evalStep p sEnd (.fault k)).mp hsEnd.2
            rw [hStepEnd] at hNext
            cases hs₀.2 (n + 1) with
            | intro sₙ₁ hsₙ₁ =>
              rw [hsₙ₁] at hNext
              cases hNext
  · intro hCond
    cases hCond.1 with
    | intro s₀ hInit =>
      refine ⟨s₀, hInit, ?_⟩
      intro n
      induction n with
      | zero => exact ⟨s₀, rfl⟩
      | succ k ih =>
        cases ih with
        | intro sₖ hsₖ =>
          have hNext := stepChainFromBase_succ_right p k s₀ sₖ hsₖ
          have hReach : Reaches p s₀ sₖ :=
            reachesBase_of_reachesNBase
              ((reachesNBase_iff_stepChainFromBase p k s₀ sₖ).mpr hsₖ)
          cases hEval : evalStep p 0 sₖ with
          | step sₖ' =>
            rw [hEval] at hNext
            exact ⟨sₖ', hNext⟩
          | done out =>
            have hBeh : Behavior p q out := by
              unfold Behavior ReachesResult
              rw [hInit]
              exact ⟨sₖ, hReach, (stepBase_iff_evalStep p sₖ (.done out)).mpr hEval⟩
            exact False.elim (hCond.2.1 out hBeh)
          | fault fk =>
            have hF : ReachesResult p q (.fault fk) := by
              unfold ReachesResult
              rw [hInit]
              exact ⟨sₖ, hReach, (stepBase_iff_evalStep p sₖ (.fault fk)).mpr hEval⟩
            exact False.elim (hCond.2.2 fk hF)

/-! ## MemCopy Program Step Chains & Equivalence Combinators -/

private theorem stepMemCopy_iff_evalStep (p : MemCopyProgram) (s : MemCopyState)
    (res : StepResult MemCopyState TerminalOut) :
    StepMemCopy p s res ↔ evalStepMemCopy p 0 s = res := by
  constructor
  · intro h
    cases h with
    | intro c hc =>
      have hc0 : c = 0 := hc.1
      rw [hc0] at hc
      exact hc.2
  · intro h
    exact ⟨0, rfl, h⟩

private theorem c_evalStepMemCopy_det {p : MemCopyProgram} {s : MemCopyState}
    {r₁ r₂ : StepResult MemCopyState TerminalOut}
    (h₁ : StepMemCopy p s r₁) (h₂ : StepMemCopy p s r₂) : r₁ = r₂ := by
  have e₁ := (stepMemCopy_iff_evalStep p s r₁).mp h₁
  have e₂ := (stepMemCopy_iff_evalStep p s r₂).mp h₂
  rw [← e₁, e₂]

private inductive ReachesNMemCopy (p : MemCopyProgram) :
    Nat → MemCopyState → MemCopyState → Prop where
  | zero (s : MemCopyState) : ReachesNMemCopy p 0 s s
  | succ {n : Nat} {s₁ s₂ s₃ : MemCopyState} :
      StepMemCopy p s₁ (.step s₂) →
      ReachesNMemCopy p n s₂ s₃ →
      ReachesNMemCopy p (n + 1) s₁ s₃

private noncomputable def ReachesPlusMemCopy (p : MemCopyProgram)
    (s₁ s₂ : MemCopyState) : Prop :=
  ∃ n : Nat, ReachesNMemCopy p (n + 1) s₁ s₂

private theorem reachesNMemCopy_trans {p : MemCopyProgram} :
    ∀ {n m : Nat} {s₁ s₂ s₃ : MemCopyState},
      ReachesNMemCopy p n s₁ s₂ →
      ReachesNMemCopy p m s₂ s₃ →
      ReachesNMemCopy p (n + m) s₁ s₃
  | 0, _, _, _, _, .zero _, h₂ => by
    rw [Nat.zero_add]
    exact h₂
  | _ + 1, _, _, _, _, .succ hStep hRest, h₂ => by
    rw [Nat.succ_add]
    exact .succ hStep (reachesNMemCopy_trans hRest h₂)

private theorem reachesNMemCopy_split_add {p : MemCopyProgram} :
    ∀ {n m : Nat} {s₁ s₃ : MemCopyState},
      ReachesNMemCopy p (n + m) s₁ s₃ →
      ∃ s₂ : MemCopyState,
        ReachesNMemCopy p n s₁ s₂ ∧ ReachesNMemCopy p m s₂ s₃
  | 0, _, s₁, _, h => by
    rw [Nat.zero_add] at h
    exact ⟨s₁, .zero s₁, h⟩
  | _ + 1, _, _, _, h => by
    rw [Nat.succ_add] at h
    cases h with
    | succ hStep hRest =>
      cases reachesNMemCopy_split_add hRest with
      | intro s₂ hs => exact ⟨s₂, .succ hStep hs.1, hs.2⟩

private theorem reachesNMemCopy_det {p : MemCopyProgram} :
    ∀ {n : Nat} {s s₁ s₂ : MemCopyState},
      ReachesNMemCopy p n s s₁ → ReachesNMemCopy p n s s₂ → s₁ = s₂
  | 0, _, _, _, .zero _, .zero _ => rfl
  | _ + 1, _, _, _, .succ h₁ r₁, .succ h₂ r₂ => by
    have hEq := c_evalStepMemCopy_det h₁ h₂
    cases hEq
    exact reachesNMemCopy_det r₁ r₂

private theorem c_reachesMemCopy_head {p : MemCopyProgram} {s₁ s₂ s₃ : MemCopyState}
    (hStep : StepMemCopy p s₁ (.step s₂))
    (hReach : ReachesMemCopy p s₂ s₃) :
    ReachesMemCopy p s₁ s₃ := by
  induction hReach with
  | refl => exact ReachesMemCopy.tail (ReachesMemCopy.refl s₁) hStep
  | tail _ hTail ih => exact ReachesMemCopy.tail ih hTail

private theorem c_reachesMemCopy_trans {p : MemCopyProgram} {s₁ s₂ s₃ : MemCopyState}
    (h₁ : ReachesMemCopy p s₁ s₂) (h₂ : ReachesMemCopy p s₂ s₃) :
    ReachesMemCopy p s₁ s₃ := by
  induction h₂ with
  | refl => exact h₁
  | tail _ hTail ih => exact ReachesMemCopy.tail ih hTail

private theorem reachesMemCopy_of_reachesNMemCopy {p : MemCopyProgram} :
    ∀ {n : Nat} {s₁ s₂ : MemCopyState},
      ReachesNMemCopy p n s₁ s₂ → ReachesMemCopy p s₁ s₂
  | 0, s₁, _, .zero _ => ReachesMemCopy.refl s₁
  | _ + 1, _, _, .succ hStep hRest =>
    c_reachesMemCopy_head hStep (reachesMemCopy_of_reachesNMemCopy hRest)

private theorem reachesMemCopy_of_reachesPlusMemCopy {p : MemCopyProgram}
    {s₁ s₂ : MemCopyState} (h : ReachesPlusMemCopy p s₁ s₂) :
    ReachesMemCopy p s₁ s₂ := by
  cases h with
  | intro _ hn => exact reachesMemCopy_of_reachesNMemCopy hn

private theorem reachesNMemCopy_of_reachesMemCopy {p : MemCopyProgram}
    {s₁ s₂ : MemCopyState} (h : ReachesMemCopy p s₁ s₂) :
    ∃ n : Nat, ReachesNMemCopy p n s₁ s₂ := by
  induction h with
  | refl => exact ⟨0, .zero s₁⟩
  | tail _ hTail ih =>
    cases ih with
    | intro n hn =>
      exact ⟨n + 1, reachesNMemCopy_trans hn (.succ hTail (.zero _))⟩

private theorem reachesNMemCopy_iff_stepChainFromMemCopy (p : MemCopyProgram) :
    ∀ (n : Nat) (s₁ s₂ : MemCopyState),
      ReachesNMemCopy p n s₁ s₂ ↔ stepChainFromMemCopy p n s₁ = some s₂
  | 0, s₁, _ => by
    constructor
    · intro h
      cases h
      rfl
    · intro h
      cases h
      exact .zero s₁
  | n + 1, s₁, s₂ => by
    constructor
    · intro h
      cases h with
      | succ hStep hRest =>
        have hEval := (stepMemCopy_iff_evalStep p s₁ (.step _)).mp hStep
        change (match evalStepMemCopy p 0 s₁ with
                | .step s' => stepChainFromMemCopy p n s'
                | _ => none) = some s₂
        rw [hEval]
        exact (reachesNMemCopy_iff_stepChainFromMemCopy p n _ s₂).mp hRest
    · intro h
      change (match evalStepMemCopy p 0 s₁ with
              | .step s' => stepChainFromMemCopy p n s'
              | _ => none) = some s₂ at h
      cases hEval : evalStepMemCopy p 0 s₁ with
      | step s' =>
        rw [hEval] at h
        have hStep : StepMemCopy p s₁ (.step s') :=
          (stepMemCopy_iff_evalStep p s₁ (.step s')).mpr hEval
        have hRest := (reachesNMemCopy_iff_stepChainFromMemCopy p n s' s₂).mpr h
        exact .succ hStep hRest
      | done _ =>
        rw [hEval] at h
        cases h
      | fault _ =>
        rw [hEval] at h
        cases h

private theorem stepChainFromMemCopy_succ_right (p : MemCopyProgram) :
    ∀ (n : Nat) (s sₙ : MemCopyState),
      stepChainFromMemCopy p n s = some sₙ →
      stepChainFromMemCopy p (n + 1) s =
        match evalStepMemCopy p 0 sₙ with
        | .step sₙ' => some sₙ'
        | _ => none
  | 0, s, _, h => by
    cases h
    change (match evalStepMemCopy p 0 s with
            | .step s' => stepChainFromMemCopy p 0 s'
            | _ => none) =
           (match evalStepMemCopy p 0 s with
            | .step sₙ' => some sₙ'
            | _ => none)
    cases evalStepMemCopy p 0 s <;> rfl
  | n + 1, s, sₙ, h => by
    change (match evalStepMemCopy p 0 s with
            | .step s' => stepChainFromMemCopy p n s'
            | _ => none) = some sₙ at h
    cases hEval : evalStepMemCopy p 0 s with
    | step s' =>
      rw [hEval] at h
      change (match evalStepMemCopy p 0 s with
              | .step t => stepChainFromMemCopy p (n + 1) t
              | _ => none) = _
      rw [hEval]
      exact stepChainFromMemCopy_succ_right p n s' sₙ h
    | done _ =>
      rw [hEval] at h
      cases h
    | fault _ =>
      rw [hEval] at h
      cases h

private theorem reachesNMemCopy_terminal_bound {p : MemCopyProgram}
    {n m : Nat} {s a b : MemCopyState}
    (hA : ReachesNMemCopy p n s a)
    (hTerm : ¬ (∃ s' : MemCopyState, StepMemCopy p a (.step s')))
    (hB : ReachesNMemCopy p m s b) :
    m ≤ n ∧ ReachesNMemCopy p (n - m) b a := by
  cases Nat.lt_or_ge n m with
  | inr hLe =>
    have hSum : n = m + (n - m) := (Nat.add_sub_of_le hLe).symm
    have hA' : ReachesNMemCopy p (m + (n - m)) s a := by
      rw [← hSum]
      exact hA
    cases reachesNMemCopy_split_add hA' with
    | intro c hc =>
      have hcEq : c = b := reachesNMemCopy_det hc.1 hB
      rw [hcEq] at hc
      exact ⟨hLe, hc.2⟩
  | inl hLt =>
    have hDiffPos : 0 < m - n := Nat.sub_pos_of_lt hLt
    have hDecomp : m - n = (m - n - 1) + 1 := (Nat.sub_add_cancel hDiffPos).symm
    have hSum : m = n + (m - n) := (Nat.add_sub_of_le (Nat.le_of_lt hLt)).symm
    have hB' : ReachesNMemCopy p (n + (m - n)) s b := by
      rw [← hSum]
      exact hB
    cases reachesNMemCopy_split_add hB' with
    | intro c hc =>
      have hcEq : c = a := reachesNMemCopy_det hc.1 hA
      have hStepList : ReachesNMemCopy p ((m - n - 1) + 1) a b := by
        rw [← hDecomp, ← hcEq]
        exact hc.2
      cases hStepList with
      | succ hStep _ => exact False.elim (hTerm ⟨_, hStep⟩)

private theorem wellFormedMemCopy_iff_no_fault (p : MemCopyProgram) (q : Query) :
    WellFormedMemCopy p q ↔ ∀ k : FaultKind, ¬ ReachesResultMemCopy p q (.fault k) := by
  constructor
  · intro h
    exact h.2
  · intro hNoFault
    refine ⟨?_, hNoFault⟩
    cases hInit : initStateMemCopy p q with
    | error k =>
      have hF : ReachesResultMemCopy p q (.fault k) := by
        unfold ReachesResultMemCopy
        rw [hInit]
      exact False.elim (hNoFault k hF)
    | ok s₀ =>
      exact ⟨s₀, rfl, fun _ _ => ⟨0, rfl⟩⟩

private theorem divergesMemCopy_iff_no_terminal_or_fault (p : MemCopyProgram) (q : Query) :
    DivergesMemCopy p q ↔
      (∃ s₀ : MemCopyState, initStateMemCopy p q = .ok s₀) ∧
      (∀ out : TerminalOut, ¬ BehaviorMemCopy p q out) ∧
      (∀ k : FaultKind, ¬ ReachesResultMemCopy p q (.fault k)) := by
  constructor
  · intro hDiv
    cases hDiv with
    | intro s₀ hs₀ =>
      refine ⟨⟨s₀, hs₀.1⟩, ?_, ?_⟩
      · intro out hBeh
        unfold BehaviorMemCopy ReachesResultMemCopy at hBeh
        rw [hs₀.1] at hBeh
        cases hBeh with
        | intro sEnd hsEnd =>
          cases reachesNMemCopy_of_reachesMemCopy hsEnd.1 with
          | intro n hnReach =>
            have hChain : stepChainFromMemCopy p n s₀ = some sEnd :=
              (reachesNMemCopy_iff_stepChainFromMemCopy p n s₀ sEnd).mp hnReach
            have hNext := stepChainFromMemCopy_succ_right p n s₀ sEnd hChain
            have hStepEnd := (stepMemCopy_iff_evalStep p sEnd (.done out)).mp hsEnd.2
            rw [hStepEnd] at hNext
            cases hs₀.2 (n + 1) with
            | intro sₙ₁ hsₙ₁ =>
              rw [hsₙ₁] at hNext
              cases hNext
      · intro k hFault
        unfold ReachesResultMemCopy at hFault
        rw [hs₀.1] at hFault
        cases hFault with
        | intro sEnd hsEnd =>
          cases reachesNMemCopy_of_reachesMemCopy hsEnd.1 with
          | intro n hnReach =>
            have hChain : stepChainFromMemCopy p n s₀ = some sEnd :=
              (reachesNMemCopy_iff_stepChainFromMemCopy p n s₀ sEnd).mp hnReach
            have hNext := stepChainFromMemCopy_succ_right p n s₀ sEnd hChain
            have hStepEnd := (stepMemCopy_iff_evalStep p sEnd (.fault k)).mp hsEnd.2
            rw [hStepEnd] at hNext
            cases hs₀.2 (n + 1) with
            | intro sₙ₁ hsₙ₁ =>
              rw [hsₙ₁] at hNext
              cases hNext
  · intro hCond
    cases hCond.1 with
    | intro s₀ hInit =>
      refine ⟨s₀, hInit, ?_⟩
      intro n
      induction n with
      | zero => exact ⟨s₀, rfl⟩
      | succ k ih =>
        cases ih with
        | intro sₖ hsₖ =>
          have hNext := stepChainFromMemCopy_succ_right p k s₀ sₖ hsₖ
          have hReach : ReachesMemCopy p s₀ sₖ :=
            reachesMemCopy_of_reachesNMemCopy
              ((reachesNMemCopy_iff_stepChainFromMemCopy p k s₀ sₖ).mpr hsₖ)
          cases hEval : evalStepMemCopy p 0 sₖ with
          | step sₖ' =>
            rw [hEval] at hNext
            exact ⟨sₖ', hNext⟩
          | done out =>
            have hBeh : BehaviorMemCopy p q out := by
              unfold BehaviorMemCopy ReachesResultMemCopy
              rw [hInit]
              exact ⟨sₖ, hReach, (stepMemCopy_iff_evalStep p sₖ (.done out)).mpr hEval⟩
            exact False.elim (hCond.2.1 out hBeh)
          | fault fk =>
            have hF : ReachesResultMemCopy p q (.fault fk) := by
              unfold ReachesResultMemCopy
              rw [hInit]
              exact ⟨sₖ, hReach, (stepMemCopy_iff_evalStep p sₖ (.fault fk)).mpr hEval⟩
            exact False.elim (hCond.2.2 fk hF)

/-! ## Top-Level MemCopy Semantic Equivalence Combinators -/

private theorem fullSemanticEquivMemCopy_of_outcomes
    (p₁ p₂ : MemCopyProgram)
    (hBeh : ∀ (q : Query) (out : TerminalOut),
      BehaviorMemCopy p₁ q out ↔ BehaviorMemCopy p₂ q out)
    (hFault : ∀ (q : Query) (k : FaultKind),
      ReachesResultMemCopy p₁ q (.fault k) ↔ ReachesResultMemCopy p₂ q (.fault k)) :
    FullSemanticEquivMemCopy p₁ p₂ := by
  have hWf : ∀ q : Query, WellFormedMemCopy p₁ q ↔ WellFormedMemCopy p₂ q := by
    intro q
    rw [wellFormedMemCopy_iff_no_fault p₁ q, wellFormedMemCopy_iff_no_fault p₂ q]
    constructor
    · intro h k hk
      exact h k ((hFault q k).mpr hk)
    · intro h k hk
      exact h k ((hFault q k).mp hk)
  have hDiv : ∀ q : Query, DivergesMemCopy p₁ q ↔ DivergesMemCopy p₂ q := by
    intro q
    rw [divergesMemCopy_iff_no_terminal_or_fault p₁ q,
      divergesMemCopy_iff_no_terminal_or_fault p₂ q]
    constructor
    · intro h
      have hNoFault₂ : ∀ k : FaultKind, ¬ ReachesResultMemCopy p₂ q (.fault k) :=
        fun k hk => h.2.2 k ((hFault q k).mpr hk)
      have hInit₂ : ∃ s₂ : MemCopyState, initStateMemCopy p₂ q = .ok s₂ := by
        cases hI : initStateMemCopy p₂ q with
        | ok s₂ => exact ⟨s₂, rfl⟩
        | error k =>
          have hF : ReachesResultMemCopy p₂ q (.fault k) := by
            unfold ReachesResultMemCopy
            rw [hI]
          exact False.elim (hNoFault₂ k hF)
      exact ⟨hInit₂, fun out hB => h.2.1 out ((hBeh q out).mpr hB), hNoFault₂⟩
    · intro h
      have hNoFault₁ : ∀ k : FaultKind, ¬ ReachesResultMemCopy p₁ q (.fault k) :=
        fun k hk => h.2.2 k ((hFault q k).mp hk)
      have hInit₁ : ∃ s₁ : MemCopyState, initStateMemCopy p₁ q = .ok s₁ := by
        cases hI : initStateMemCopy p₁ q with
        | ok s₁ => exact ⟨s₁, rfl⟩
        | error k =>
          have hF : ReachesResultMemCopy p₁ q (.fault k) := by
            unfold ReachesResultMemCopy
            rw [hI]
          exact False.elim (hNoFault₁ k hF)
      exact ⟨hInit₁, fun out hB => h.2.1 out ((hBeh q out).mp hB), hNoFault₁⟩
  have hPost : ∀ (q : Query) (post : TerminalOut → Prop),
      SatisfiesPostMemCopy p₁ q post ↔ SatisfiesPostMemCopy p₂ q post := by
    intro q post
    unfold SatisfiesPostMemCopy
    constructor
    · intro h
      exact ⟨(hWf q).mp h.1, fun out hb => h.2 out ((hBeh q out).mpr hb)⟩
    · intro h
      exact ⟨(hWf q).mpr h.1, fun out hb => h.2 out ((hBeh q out).mp hb)⟩
  exact ⟨hWf, hBeh, hFault, hDiv, hPost⟩

private theorem fullSemanticEquivMemCopy_refl (p : MemCopyProgram) :
    FullSemanticEquivMemCopy p p :=
  fullSemanticEquivMemCopy_of_outcomes p p (fun _ _ => Iff.rfl) (fun _ _ => Iff.rfl)

private theorem fullSemanticEquivMemCopy_symm {p₁ p₂ : MemCopyProgram}
    (h : FullSemanticEquivMemCopy p₁ p₂) :
    FullSemanticEquivMemCopy p₂ p₁ :=
  fullSemanticEquivMemCopy_of_outcomes p₂ p₁
    (fun q out => (h.2.1 q out).symm)
    (fun q k => (h.2.2.1 q k).symm)

private theorem fullSemanticEquivMemCopy_trans {p₁ p₂ p₃ : MemCopyProgram}
    (h₁₂ : FullSemanticEquivMemCopy p₁ p₂)
    (h₂₃ : FullSemanticEquivMemCopy p₂ p₃) :
    FullSemanticEquivMemCopy p₁ p₃ :=
  fullSemanticEquivMemCopy_of_outcomes p₁ p₃
    (fun q out => Iff.trans (h₁₂.2.1 q out) (h₂₃.2.1 q out))
    (fun q k => Iff.trans (h₁₂.2.2.1 q k) (h₂₃.2.2.1 q k))

private theorem fwd_stutter_reaches_memCopy
    {p₁ p₂ : MemCopyProgram}
    {R : MemCopyState → MemCopyState → Prop}
    {μ : MemCopyState → Nat}
    (hStep : ∀ (s₁ s₂ : MemCopyState), R s₁ s₂ →
      (∀ s₁' : MemCopyState, evalStepMemCopy p₁ 0 s₁ = .step s₁' →
        (R s₁' s₂ ∧ μ s₁' < μ s₁) ∨
        (∃ s₂' : MemCopyState, ReachesPlusMemCopy p₂ s₂ s₂' ∧ R s₁' s₂')) ∧
      (∀ out : TerminalOut, evalStepMemCopy p₁ 0 s₁ = .done out →
        ∃ s₂' : MemCopyState,
          ReachesMemCopy p₂ s₂ s₂' ∧ StepMemCopy p₂ s₂' (.done out)) ∧
      (∀ k : FaultKind, evalStepMemCopy p₁ 0 s₁ = .fault k →
        ∃ s₂' : MemCopyState,
          ReachesMemCopy p₂ s₂ s₂' ∧ StepMemCopy p₂ s₂' (.fault k)))
    {s₁ s₁' : MemCopyState} (hReach : ReachesMemCopy p₁ s₁ s₁') :
    ∀ {s₂ : MemCopyState}, R s₁ s₂ →
      ∃ s₂' : MemCopyState, ReachesMemCopy p₂ s₂ s₂' ∧ R s₁' s₂' := by
  induction hReach with
  | refl =>
    intro s₂ hR
    exact ⟨s₂, ReachesMemCopy.refl s₂, hR⟩
  | tail _ hTail ih =>
    intro s₂ hR
    cases ih hR with
    | intro s₂Mid hs₂Mid =>
      have hEval := (stepMemCopy_iff_evalStep p₁ _ (.step _)).mp hTail
      cases (hStep _ s₂Mid hs₂Mid.2).1 _ hEval with
      | inl hStutter =>
        exact ⟨s₂Mid, hs₂Mid.1, hStutter.1⟩
      | inr hProg =>
        cases hProg with
        | intro s₂' hs₂' =>
          exact ⟨s₂', c_reachesMemCopy_trans hs₂Mid.1
            (reachesMemCopy_of_reachesPlusMemCopy hs₂'.1), hs₂'.2⟩

private theorem arrives_memCopy_det_done {p : MemCopyProgram}
    {s s₁ s₂ : MemCopyState} {out₁ out₂ : TerminalOut}
    (h₁ : ReachesMemCopy p s s₁) (hs₁ : StepMemCopy p s₁ (.done out₁))
    (h₂ : ReachesMemCopy p s s₂) (hs₂ : StepMemCopy p s₂ (.done out₂)) :
    out₁ = out₂ := by
  cases reachesNMemCopy_of_reachesMemCopy h₁ with
  | intro n₁ hn₁ =>
    cases reachesNMemCopy_of_reachesMemCopy h₂ with
    | intro n₂ hn₂ =>
      have hTerm₁ : ¬ (∃ t : MemCopyState, StepMemCopy p s₁ (.step t)) := by
        intro h
        cases h with
        | intro t ht =>
          have hEq := c_evalStepMemCopy_det hs₁ ht
          cases hEq
      have hTerm₂ : ¬ (∃ t : MemCopyState, StepMemCopy p s₂ (.step t)) := by
        intro h
        cases h with
        | intro t ht =>
          have hEq := c_evalStepMemCopy_det hs₂ ht
          cases hEq
      have b₁ := reachesNMemCopy_terminal_bound hn₁ hTerm₁ hn₂
      have b₂ := reachesNMemCopy_terminal_bound hn₂ hTerm₂ hn₁
      have hEqLen : n₁ = n₂ := nat_le_antisymm b₂.1 b₁.1
      rw [hEqLen] at hn₁
      have hSEq : s₁ = s₂ := reachesNMemCopy_det hn₁ hn₂
      rw [hSEq] at hs₁
      have hResEq := c_evalStepMemCopy_det hs₁ hs₂
      cases hResEq
      rfl

private theorem arrives_memCopy_det_fault {p : MemCopyProgram}
    {s s₁ s₂ : MemCopyState} {k₁ k₂ : FaultKind}
