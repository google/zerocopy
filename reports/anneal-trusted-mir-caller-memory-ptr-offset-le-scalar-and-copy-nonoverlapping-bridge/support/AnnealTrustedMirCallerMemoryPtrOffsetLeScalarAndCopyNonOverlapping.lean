                        have hDef := nat_beq_eq _ _ hA2.1
                        have hBlk := nat_beq_eq _ _ hA2.2
                        have hSt := nat_beq_eq _ _ hA1.2
                        unfold evalStepMemCopy at hEval
                        rw [hFr] at hEval
                        dsimp at hEval
                        rw [hDef, hBody] at hEval
                        dsimp at hEval
                        rw [hBlk, hBb] at hEval
                        dsimp at hEval
                        rw [hSt] at hEval
                        rw [mirGetElem?_ge_none bb.statements bb.statements.length (Nat.le_refl _),
                          nat_beq_refl] at hEval
                        dsimp at hEval
                        unfold evalMemCopyTerm at hEval
                        rw [hTerm] at hEval
                        dsimp at hEval
                        cases isZeroOffsetConst_evalOffsetCountOp body.locals frame.locals countOp elemSize hZero with
                        | intro z hz =>
                          rw [hz.1] at hEval
                          dsimp at hEval
                          have hPrefix : ∀ fk : FaultKind,
                              evalStepMemCopy p' 0 s₁ = StepResult.fault fk →
                              ∃ s₂', ReachesMemCopy p' s₁ s₂' ∧ StepMemCopy p' s₂' (.fault fk) :=
                            fun fk hf => ⟨s₁, ReachesMemCopy.refl s₁, (stepMemCopy_iff_evalStep p' s₁ (.fault fk)).mpr hf⟩
                          cases hRead : readPtrLocal body.locals frame.locals srcPtr false with
                          | error fk =>
