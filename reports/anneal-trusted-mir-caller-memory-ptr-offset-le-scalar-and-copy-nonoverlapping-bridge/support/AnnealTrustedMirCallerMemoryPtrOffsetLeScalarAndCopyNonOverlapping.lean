private theorem s3_evalBinOp_usize_shl (a b : Nat) (ha : a < maxUsize) (hb : b < 64) :
    evalBinOp .shl
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (Nat.mod (Nat.shiftLeft a b) maxUsize) }) := by
  have hbU : b < maxUsize := Nat.lt_trans hb (by
    have h7 : 64 = Nat.pow 2 6 := by decide
    rw [h7]
    exact Nat.lt_of_lt_of_le (by decide : Nat.pow 2 6 < Nat.pow 2 7)
