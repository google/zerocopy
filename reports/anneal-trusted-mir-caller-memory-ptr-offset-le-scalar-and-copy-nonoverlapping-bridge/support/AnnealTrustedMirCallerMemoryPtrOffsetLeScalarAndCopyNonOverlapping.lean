/-! ## Section 10: Memory Projection, Preservation, & Arm-Execution Helpers (`s4_*`) -/

private theorem s4c_mirTy_beq_usize_eq (ty : MirTy) (h : MirTy.beq ty usizeTy = true) :
    ty = usizeTy := by
  cases ty with
  | int w s =>
    cases w <;> cases s <;> cases h
    rfl
  | bool | unit | enum _ | rawPtr _ _ | ref _ _ | tuple _ | never | unsupported =>
    cases h

private theorem s4_size_lt_maxUsize {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pack.size < maxUsize :=
  Nat.lt_of_le_of_lt (Nat.le_trans pack.hSizeLe (Nat.le_succ 32)) s4_33_lt_maxUsize

private theorem s4_list_getElem?_mem {α : Type} :
    ∀ (xs : List α) (j : Nat) (x : α),
      Trusted.MirSemantics.getElem? xs j = some x → List.Mem x xs
  | [], _, _, h => by cases h
  | _ :: tl, 0, _, h => by
    cases Option.some.inj h
    exact List.Mem.head tl
  | a :: tl, j + 1, x, h =>
    List.Mem.tail a (s4_list_getElem?_mem tl j x h)

private theorem s4_filter_nil_of_forall_false {α : Type} (p : α → Bool) :
    ∀ xs : List α, (∀ x : α, List.Mem x xs → p x = false) → xs.filter p = []
  | [], _ => rfl
  | x :: xs, h => by
    have hx : p x = false := h x (List.Mem.head xs)
    have hxs : xs.filter p = [] :=
      s4_filter_nil_of_forall_false p xs (fun y hy => h y (List.Mem.tail x hy))
    dsimp [List.filter]
    rw [hx]
    exact hxs

private theorem s4_encodeByte_tNat_lt_maxUsize
    (bytes : List AllocByte) (hWf : s4_AllocBytesWf bytes)
    {j : Nat} {ab : AllocByte} (hGet : Trusted.MirSemantics.getElem? bytes j = some ab) :
    (encodeAllocByte ab).1 < maxUsize :=
  (nat_blt_eq_lt _ _).mp
    ((list_all_eq_true _ bytes).mp hWf ab (s4_list_getElem?_mem bytes j ab hGet))

private theorem s4_findAlloc?_allocId (id : Nat) (a : Allocation) :
    ∀ xs : List Allocation, findAlloc? id xs = some a → a.allocId = id
  | [], h => by dsimp [findAlloc?] at h; cases h
  | x :: xs, h => by
    dsimp [findAlloc?] at h
    cases hEq : Nat.beq x.allocId id with
    | true =>
      rw [hEq] at h
      dsimp at h
      cases Option.some.inj h
      exact nat_beq_eq _ _ hEq
    | false =>
      rw [hEq] at h
      dsimp at h
      exact s4_findAlloc?_allocId id a xs h

private theorem s4_extMem_src_eq_empty {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {m₁ m₂ : CallerMemory} (hMem : s4_MemRel pack m₁ m₂) :
    (if pack.bodySrc.acceptsCallerMem ||
        pack.bodySrc.locals.any (fun d => match d with | .byteBuf _ _ _ => true | _ => false) then
      projectExternalCallerMem m₁
    else m₁) = ⟨[]⟩ := by
  have hAny : pack.bodySrc.locals.any
      (fun d => match d with | .byteBuf _ _ _ => true | _ => false) = true := by
    rw [list_any_eq_true]
    exact ⟨.byteBuf pack.size pack.alignLog2 pack.mutability,
      s4_list_getElem?_mem pack.bodySrc.locals plan.bufLocal _ pack.hBufDecl, rfl⟩
  rw [pack.hAcceptsFalse, hAny]
  dsimp [projectExternalCallerMem]
  have hFilt : m₁.allocations.filter (fun a => Nat.blt a.allocId internalAllocBase) = [] := by
    refine s4_filter_nil_of_forall_false _ m₁.allocations (fun a ha => ?_)
    cases hMem.2 a ha with | intro id h1 =>
    cases h1 with | intro sz h2 =>
    cases h2 with | intro al h3 =>
    cases h3 with | intro mu h4 =>
    have hGe : internalAllocBase ≤ a.allocId := by
      rw [h4.1]; exact Nat.le_add_right internalAllocBase id
    cases hBlt : Nat.blt a.allocId internalAllocBase with
    | false => rfl
    | true =>
      exact False.elim (s4_nat_lt_irrefl a.allocId (Nat.lt_of_lt_of_le ((nat_blt_eq_lt _ _).mp hBlt) hGe))
  rw [hFilt]

private theorem s4_mem_of_mem_filter {α : Type} {p : α → Bool} :
    ∀ {x : α} {xs : List α}, List.Mem x (xs.filter p) → List.Mem x xs ∧ p x = true
  | x, [], h => by
    dsimp [List.filter] at h
    cases h
  | x, y :: ys, h => by
    dsimp [List.filter] at h
    cases hP : p y with
    | true =>
      rw [hP] at h
      dsimp at h
      cases h with
      | head _ => exact ⟨List.Mem.head ys, hP⟩
      | tail _ hTl =>
        have ih := s4_mem_of_mem_filter hTl
        exact ⟨List.Mem.tail y ih.1, ih.2⟩
    | false =>
      rw [hP] at h
      dsimp at h
      have ih := s4_mem_of_mem_filter h
      exact ⟨List.Mem.tail y ih.1, ih.2⟩

private theorem s4_extMem_tgt_eq_empty {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {m₁ m₂ : CallerMemory} (hMem : s4_MemRel pack m₁ m₂) :
    (if pack.bodyTgt.acceptsCallerMem ||
        pack.bodyTgt.locals.any (fun d => match d with | .byteBuf _ _ _ => true | _ => false) then
      projectExternalCallerMem m₂
    else m₂) = ⟨[]⟩ := by
  rw [s4_bodyTgt_acceptsCallerMem pack]
  cases hAny : pack.bodyTgt.locals.any
      (fun d => match d with | .byteBuf _ _ _ => true | _ => false) with
  | true =>
    dsimp [projectExternalCallerMem]
    have hFilt : m₂.allocations.filter (fun a => Nat.blt a.allocId internalAllocBase) = [] := by
      refine s4_filter_nil_of_forall_false _ m₂.allocations (fun a ha => ?_)
      have ha1 : List.Mem a m₁.allocations := by
        rw [hMem.1] at ha
        exact (s4_mem_of_mem_filter ha).1
      cases hMem.2 a ha1 with | intro id h1 =>
      cases h1 with | intro sz h2 =>
      cases h2 with | intro al h3 =>
      cases h3 with | intro mu h4 =>
      have hGe : internalAllocBase ≤ a.allocId := by
        rw [h4.1]; exact Nat.le_add_right internalAllocBase id
      cases hBlt : Nat.blt a.allocId internalAllocBase with
      | false => rfl
      | true =>
        exact False.elim (s4_nat_lt_irrefl a.allocId (Nat.lt_of_lt_of_le ((nat_blt_eq_lt _ _).mp hBlt) hGe))
    rw [hFilt]
  | false =>
    dsimp
    cases m₂ with
    | mk allocs =>
      cases hM2 : allocs with
      | nil => rfl
      | cons a rest =>
        have ha2 : List.Mem a allocs := by rw [hM2]; exact List.Mem.head rest
        have haFilt : List.Mem a (m₁.allocations.filter
            (fun x => !Nat.beq x.allocId (internalAllocBase + plan.bufLocal))) := by
          rw [← hMem.1]; exact ha2
        have ha1 : List.Mem a m₁.allocations := (s4_mem_of_mem_filter haFilt).1
        have haNe : a.allocId ≠ internalAllocBase + plan.bufLocal :=
          nat_beq_false_ne (by
            have hP := (s4_mem_of_mem_filter haFilt).2
            cases hB : Nat.beq a.allocId (internalAllocBase + plan.bufLocal) with
            | false => rfl
            | true => rw [hB] at hP; cases hP)
        cases hMem.2 a ha1 with | intro id h1 =>
        cases h1 with | intro sz h2 =>
        cases h2 with | intro al h3 =>
        cases h3 with | intro mu h4 =>
        have hIdNe : id ≠ plan.bufLocal := fun h => by
          apply haNe
          rw [h4.1, h]
        have hLt : id < pack.bodySrc.locals.length := s4_getElem?_some_lt _ _ _ h4.2.1
        have hTgtDecl := s4_getElem?_bodyTgt_locals_lt pack hLt hIdNe
        rw [h4.2.1] at hTgtDecl
        have hFalse := list_any_false_forall _ pack.bodyTgt.locals hAny _
          (s4_list_getElem?_mem pack.bodyTgt.locals id _ hTgtDecl)
        cases hFalse

private theorem s4_evalMemCopyBaseOperandToSlot_preserves_ge
    {body : MemCopyBody} {slots slots' : List MemCopySlot} {op : Operand}
    {ty : MirTy} {ov : Option Val} {bound j : Nat}
    (hLoc : operandLocalsInBounds bound op = true)
    (hGe : bound ≤ j)
    (hEv : evalMemCopyBaseOperandToSlot body.locals slots op = .ok (ty, ov, slots')) :
    Trusted.MirSemantics.getElem? slots' j = Trusted.MirSemantics.getElem? slots j := by
  cases op with
  | constant c =>
    dsimp [evalMemCopyBaseOperandToSlot] at hEv
    cases hEc : evalConstLit c.ty c.lit with
    | error _ => rw [hEc] at hEv; cases hEv
    | ok _ =>
      rw [hEc] at hEv
      have hEq : slots = slots' := congrArg (fun p => p.2.2) (Except.ok.inj hEv)
      rw [← hEq]
  | copy p =>
    dsimp [evalMemCopyBaseOperandToSlot] at hEv
    cases hP : !p.projection.isEmpty with
    | true => rw [hP] at hEv; cases hEv
    | false =>
      rw [hP] at hEv
      dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? body.locals p.localId with
      | none => rw [hD] at hEv; cases hEv
      | some d =>
        rw [hD] at hEv
        cases d with
        | ptrLocal | byteBuf _ _ _ => cases hEv
        | base _ =>
          cases hS : Trusted.MirSemantics.getElem? slots p.localId with
          | none => rw [hS] at hEv; cases hEv
          | some sl =>
            rw [hS] at hEv
            cases sl with
            | ptrDead | livePtr _ | bufSlot _ => cases hEv
            | baseSlot bs =>
              cases bs with
              | dead => cases hEv
              | live _ =>
                have hEq : slots = slots' := congrArg (fun p => p.2.2) (Except.ok.inj hEv)
                rw [← hEq]
  | move p =>
    dsimp [operandLocalsInBounds] at hLoc
    have hLt : p.localId < bound := (nat_blt_eq_lt _ _).mp hLoc
    have hNe : p.localId ≠ j := fun h =>
      s4_nat_lt_irrefl j (Nat.lt_of_lt_of_le (by rw [← h]; exact hLt) hGe)
    dsimp [evalMemCopyBaseOperandToSlot] at hEv
    cases hP : !p.projection.isEmpty with
    | true => rw [hP] at hEv; cases hEv
    | false =>
      rw [hP] at hEv
      dsimp at hEv
      cases hD : Trusted.MirSemantics.getElem? body.locals p.localId with
      | none => rw [hD] at hEv; cases hEv
      | some d =>
        rw [hD] at hEv
        cases d with
        | ptrLocal | byteBuf _ _ _ => cases hEv
        | base tyD =>
          cases hS : Trusted.MirSemantics.getElem? slots p.localId with
          | none => rw [hS] at hEv; cases hEv
          | some sl =>
            rw [hS] at hEv
            cases sl with
            | ptrDead | livePtr _ | bufSlot _ => cases hEv
            | baseSlot bs =>
              cases bs with
              | dead => cases hEv
              | live _ =>
                dsimp at hEv
                cases hSet : setElem? slots p.localId (.baseSlot (liveUninitSlot tyD)) with
                | none => rw [hSet] at hEv; cases hEv
                | some sm =>
                  rw [hSet] at hEv
                  have hEq : sm = slots' := congrArg (fun p => p.2.2) (Except.ok.inj hEv)
                  rw [← hEq]
                  exact s4_getElem?_setElem?_ne slots p.localId j _ sm hNe hSet

private theorem s4_operandLocalsInBounds_of_usesBase
    {decls : List MemCopyLocalDecl} {op : Operand}
    (hOp : operandUsesOnlyBaseMem decls op = true) :
    operandLocalsInBounds decls.length op = true := by
  cases op with
  | constant _ => rfl
  | copy p | move p =>
    dsimp [operandUsesOnlyBaseMem] at hOp
    have hAnd := (bool_and_eq_true _ _).mp hOp
    cases hD : Trusted.MirSemantics.getElem? decls p.localId with
    | none => rw [hD] at hAnd; cases hAnd.2
    | some _ => exact (nat_blt_eq_lt _ _).mpr (s4_getElem?_some_lt _ _ _ hD)

private theorem s4_evalUsizeOp_preserves_bufSlot
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots slots' : List MemCopySlot} {op : Operand} {n : Nat}
    (hOp : operandHasBaseTy pack.bodySrc.locals usizeTy op = true)
    (hEv : evalUsizeOp pack.bodySrc.locals slots op = .ok (n, slots')) :
    Trusted.MirSemantics.getElem? slots' plan.bufLocal =
      Trusted.MirSemantics.getElem? slots plan.bufLocal := by
  dsimp [evalUsizeOp] at hEv
  cases hB : evalMemCopyBaseOperandToSlot pack.bodySrc.locals slots op with
  | error _ => rw [hB] at hEv; cases hEv
  | ok res =>
    rw [hB] at hEv
    dsimp at hEv
    cases hU : !MirTy.beq res.1 usizeTy with
    | true => rw [hU] at hEv; cases hEv
    | false =>
      rw [hU] at hEv
      dsimp at hEv
      cases hOpt : res.2.1 with
      | none => rw [hOpt] at hEv; cases hEv
      | some v =>
        rw [hOpt] at hEv
        cases v with
        | bool _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => cases hEv
        | scalar sv =>
          dsimp at hEv
          cases hSwf : sv.wf with
          | false => rw [hSwf] at hEv; cases hEv
          | true =>
            rw [hSwf] at hEv
            have hSlEq : res.2.2 = slots' := (Prod.mk.inj (Except.ok.inj hEv)).2
            rw [← hSlEq]
            cases op with
            | constant c =>
              dsimp [evalMemCopyBaseOperandToSlot] at hB
              cases hEc : evalConstLit c.ty c.lit with
              | error _ => rw [hEc] at hB; cases hB
              | ok _ =>
                rw [hEc] at hB
                have hEq : slots = res.2.2 := congrArg (fun p => p.2.2) (Except.ok.inj hB)
                rw [← hEq]
            | copy p =>
              dsimp [evalMemCopyBaseOperandToSlot] at hB
              cases hP : !p.projection.isEmpty with
              | true => rw [hP] at hB; cases hB
              | false =>
                rw [hP] at hB; dsimp at hB
                cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
                | none => rw [hD] at hB; cases hB
                | some d =>
                  rw [hD] at hB
                  cases d with
                  | ptrLocal | byteBuf _ _ _ => cases hB
                  | base _ =>
                    cases hS : Trusted.MirSemantics.getElem? slots p.localId with
                    | none => rw [hS] at hB; cases hB
                    | some sl =>
                      rw [hS] at hB
                      cases sl with
                      | ptrDead | livePtr _ | bufSlot _ => cases hB
                      | baseSlot bs =>
                        cases bs with
                        | dead => cases hB
                        | live _ =>
                          have hEq : slots = res.2.2 := congrArg (fun p => p.2.2) (Except.ok.inj hB)
                          rw [← hEq]
            | move p =>
              dsimp [operandHasBaseTy] at hOp
              have hAnd := (bool_and_eq_true _ _).mp hOp
              have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
              dsimp [evalMemCopyBaseOperandToSlot] at hB
              rw [hNotP] at hB; dsimp at hB
              cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
              | none => rw [hD] at hAnd; cases hAnd.2
              | some d =>
                rw [hD] at hB hAnd
                cases d with
                | ptrLocal | byteBuf _ _ _ => cases hAnd.2
                | base tyD =>
                  have hNe : p.localId ≠ plan.bufLocal := fun h => by
                    rw [h, pack.hBufDecl] at hD; cases hD
                  cases hS : Trusted.MirSemantics.getElem? slots p.localId with
                  | none => rw [hS] at hB; cases hB
                  | some sl =>
                    rw [hS] at hB
                    cases sl with
                    | ptrDead | livePtr _ | bufSlot _ => cases hB
                    | baseSlot bs =>
                      cases bs with
                      | dead => cases hB
                      | live _ =>
                        dsimp at hB
                        cases hSet : setElem? slots p.localId (.baseSlot (liveUninitSlot tyD)) with
                        | none => rw [hSet] at hB; cases hB
                        | some sm =>
                          rw [hSet] at hB
                          have hEq : sm = res.2.2 := congrArg (fun p => p.2.2) (Except.ok.inj hB)
                          rw [← hEq]
                          exact s4_getElem?_setElem?_ne slots p.localId plan.bufLocal _ sm hNe hSet

private theorem s4_writeMemCopyBasePlace_preserves_ge
    {slots slots' : List MemCopySlot} {dst : LocalId} {dstTy : MirTy} {val : Val}
    {bound j : Nat}
    (hLt : dst < bound) (hGe : bound ≤ j)
    (hWr : writeMemCopyBasePlace slots dst dstTy val = .ok slots') :
    Trusted.MirSemantics.getElem? slots' j = Trusted.MirSemantics.getElem? slots j := by
  have hNe : dst ≠ j := fun h =>
    s4_nat_lt_irrefl j (Nat.lt_of_lt_of_le (by rw [← h]; exact hLt) hGe)
  dsimp [writeMemCopyBasePlace] at hWr
  cases hChk : !checkVal val dstTy with
  | true => rw [hChk] at hWr; cases hWr
  | false =>
    rw [hChk] at hWr
    cases hS : Trusted.MirSemantics.getElem? slots dst with
    | none => rw [hS] at hWr; cases hWr
    | some sl =>
      rw [hS] at hWr
      cases sl with
      | ptrDead | livePtr _ | bufSlot _ => cases hWr
      | baseSlot bs =>
        cases bs with
        | dead => cases hWr
        | live _ =>
          dsimp at hWr
          cases hSet : setElem? slots dst (.baseSlot (.live (some val))) with
          | none => rw [hSet] at hWr; cases hWr
          | some sm =>
            rw [hSet] at hWr
            cases Except.ok.inj hWr
            exact s4_getElem?_setElem?_ne slots dst j _ slots' hNe hSet

private theorem s4_reachesPlus_term_rel
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {f₁ f₂ : MemCopyFrame} {m₁' m₂' : CallerMemory}
    {slots₁' slots₂' : List MemCopySlot} {target n : Nat}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hReach : ReachesNMemCopy pTgt (n + 1) { frames := [f₂], mem := m₂' }
      { frames := [{ f₂ with blockIdx := target + 1, stmtIdx := 0, locals := slots₂' }],
        mem := m₂' })
    (hPM' : s4_PrefixMatch pack slots₁' slots₂')
    (hWf' : s4_SlotValWf pack.bodySrc slots₁')
    (hBuf' : s4_BufRel pack slots₁' m₁' slots₂')
    (hMem' : s4_MemRel pack m₁' m₂')
    (hScr' : s4_ScrLive pack slots₂') :
    ∃ s₂' : MemCopyState,
      ReachesPlusMemCopy pTgt { frames := [f₂], mem := m₂' } s₂' ∧
      s4_StateRel pack
        { frames := [{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' }], mem := m₁' }
        s₂' := by
  refine ⟨{ frames := [{ f₂ with blockIdx := target + 1, stmtIdx := 0, locals := slots₂' }],
              mem := m₂' }, s4_reachesPlusMemCopy_of_succ hReach, Or.inl ?_⟩
  refine Or.inr ⟨hSame, hSame₂, rfl, hPM', hWf', hBuf', hMem', hScr', ?_⟩
  cases hBb' : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks target with
  | none => exact True.intro
  | some _ => exact ⟨Nat.zero_le _, rfl⟩

private theorem s4_reachesPlus_term_rel_mem
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {f₁ f₂ : MemCopyFrame} {m₂Init m₁' m₂' : CallerMemory}
    {slots₁' slots₂' : List MemCopySlot} {target n : Nat}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hReach : ReachesNMemCopy pTgt (n + 1) { frames := [f₂], mem := m₂Init }
      { frames := [{ f₂ with blockIdx := target + 1, stmtIdx := 0, locals := slots₂' }],
        mem := m₂' })
    (hPM' : s4_PrefixMatch pack slots₁' slots₂')
    (hWf' : s4_SlotValWf pack.bodySrc slots₁')
    (hBuf' : s4_BufRel pack slots₁' m₁' slots₂')
    (hMem' : s4_MemRel pack m₁' m₂')
    (hScr' : s4_ScrLive pack slots₂') :
    ∃ s₂' : MemCopyState,
      ReachesPlusMemCopy pTgt { frames := [f₂], mem := m₂Init } s₂' ∧
      s4_StateRel pack
        { frames := [{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' }], mem := m₁' }
        s₂' := by
  refine ⟨{ frames := [{ f₂ with blockIdx := target + 1, stmtIdx := 0, locals := slots₂' }],
              mem := m₂' }, s4_reachesPlusMemCopy_of_succ hReach, Or.inl ?_⟩
  refine Or.inr ⟨hSame, hSame₂, rfl, hPM', hWf', hBuf', hMem', hScr', ?_⟩
  cases hBb' : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks target with
  | none => exact True.intro
  | some _ => exact ⟨Nat.zero_le _, rfl⟩

private theorem s4_step_mkAssignUse_readArm
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List MemCopySlot} {mem₁ mem₂ : CallerMemory}
    {dst src : LocalId} {nVal : Nat}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hWf : s4_SlotValWf pack.bodySrc slots₁)
    (hBuf : s4_BufRel pack slots₁ mem₁ slots₂)
    (hScr : s4_ScrLive pack slots₂)
    (hDstDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst = some (.base usizeTy))
    (hDstNe : dst ≠ plan.bufLocal)
    (hSrcGe : pack.bodySrc.locals.length + 1 ≤ src)
    (hSrcLt : src < pack.bodySrc.locals.length + 1 + 2 * pack.size)
    (hSrcLive : Trusted.MirSemantics.getElem? slots₂ src =
      some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 nVal⟩)))))
    (hNLt : nVal < maxUsize)
    (f₂ : MemCopyFrame) (hf₂ : f₂.locals = slots₂) :
    match writeMemCopyBasePlace slots₁ dst usizeTy
        (.scalar ⟨.isize, false, BitVec.ofNat 128 nVal⟩) with
    | .error fk =>
      evalMemCopyStmt pack.bodyTgt f₂ mem₂
        (mkAssignUse dst (.copy { localId := src, projection := [] })) = .fault fk
    | .ok slots₁' =>
      ∃ slots₂' : List MemCopySlot,
        evalMemCopyStmt pack.bodyTgt f₂ mem₂
          (mkAssignUse dst (.copy { localId := src, projection := [] })) =
            stepMemCopyNext f₂ mem₂ slots₂' ∧
        s4_PrefixMatch pack slots₁' slots₂' ∧
        s4_SlotValWf pack.bodySrc slots₁' ∧
        s4_BufRel pack slots₁' mem₁ slots₂' ∧
        s4_ScrLive pack slots₂' ∧
        (∀ j : Nat, pack.bodySrc.locals.length ≤ j →
          Trusted.MirSemantics.getElem? slots₂' j = Trusted.MirSemantics.getElem? slots₂ j) := by
  have hDstLt : dst < pack.bodySrc.locals.length := s4_getElem?_some_lt _ _ _ hDstDecl
  have hDstTgt := s4_getElem?_bodyTgt_locals_lt pack hDstLt hDstNe
  rw [hDstDecl] at hDstTgt
  have hSrcSub : src - (pack.bodySrc.locals.length + 1) < 2 * pack.size :=
    Nat.sub_lt_left_of_lt_add hSrcGe hSrcLt
  have hSrcDecl := s4_getElem?_bodyTgt_locals_byte pack hSrcSub
  rw [Nat.add_sub_of_le hSrcGe] at hSrcDecl
  let v : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 nVal⟩
  have hChk : checkVal v usizeTy = true := s4_checkVal_usize_ofNat hNLt
  have hWr := s4_writeMemCopyBasePlace_prefix pack hPM hWf hBuf hScr hDstDecl hDstNe (val := v)
  dsimp [evalMemCopyStmt, mkAssignUse]
  rw [hDstTgt]
  dsimp [evalMemCopyBaseRvalue, evalMemCopyBaseOperandToSlot]
  rw [hSrcDecl, hf₂, hSrcLive]
  dsimp
  have hBeq : (!MirTy.beq usizeTy usizeTy) = false := rfl
  rw [hBeq]
  dsimp
  cases hW1 : writeMemCopyBasePlace slots₁ dst usizeTy v with
  | error fk =>
    rw [hW1] at hWr
    rw [hWr]
  | ok slots₁' =>
    rw [hW1] at hWr
    cases hWr with | intro slots₂' h2 =>
    refine ⟨slots₂', by rw [h2.1], h2.2.1, h2.2.2.1, h2.2.2.2.1, h2.2.2.2.2, fun j hj => ?_⟩
    exact s4_writeMemCopyBasePlace_preserves_ge hDstLt hj h2.1

private theorem s4_prefixMatch_set_liveArea
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂' : List MemCopySlot} {k : Nat} {s' : MemCopySlot}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hGe : pack.bodySrc.locals.length + 1 ≤ k)
    (hSet : setElem? slots₂ k s' = some slots₂') :
    s4_PrefixMatch pack slots₁ slots₂' := by
  refine ⟨hPM.1, (s4_setElem?_length _ _ _ _ hSet).trans hPM.2.1, ?_⟩
  intro i hi hNeI
  have hNe : k ≠ i := fun h => by
    have hBad : pack.bodySrc.locals.length + 1 ≤ i := by rw [← h]; exact hGe
    exact s4_nat_lt_irrefl pack.bodySrc.locals.length
      (Nat.lt_trans (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) hBad) hi)
  rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet]
  exact hPM.2.2 i hi hNeI

private theorem s4_scrLive_set_liveArea
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₂ slots₂' : List MemCopySlot} {k : Nat} {s' : MemCopySlot}
    (hScr : s4_ScrLive pack slots₂)
    (hLt : k < pack.bodySrc.locals.length + 1 + 2 * pack.size)
    (hSet : setElem? slots₂ k s' = some slots₂') :
    s4_ScrLive pack slots₂' := by
  intro r hr
  have hNe : k ≠ pack.bodySrc.locals.length + 1 + 2 * pack.size + r := fun h => by
    have hGt : k < pack.bodySrc.locals.length + 1 + 2 * pack.size + r :=
      Nat.lt_of_lt_of_le hLt (Nat.le_add_right _ r)
    rw [h] at hGt
    exact s4_nat_lt_irrefl _ hGt
  rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet]
  exact hScr r hr

private theorem s4_prefixMatch_set_scr_public
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂' : List MemCopySlot} {r : Nat} {s' : MemCopySlot}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hSet : setElem? slots₂ (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) s' = some slots₂') :
    s4_PrefixMatch pack slots₁ slots₂' :=
  s4_prefixMatch_set_liveArea pack hPM
    (Nat.le_trans (Nat.le_add_right _ (2 * pack.size)) (Nat.le_add_right _ r)) hSet

/-! ## Section 11: Base & `readBufRawByte` Terminator Simulations (`s4_*`) -/

private theorem s4_sim_term_baseTerm
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {bt : TerminatorKind}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTermSrc : bbSrc.terminator = .baseTerm bt)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hNone₁ : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = none :=
    s4_getElem?_ge_none bbSrc.statements f₁.stmtIdx (by rw [hEnd₁]; exact Nat.le_refl _)
  have hEvSrc := s4_evalStepMemCopy_at_term pSrc pack.bodySrc f₁ m₁ bbSrc
    hBodySrc hBbSrc hNone₁ hEnd₁
  have hLow := s4_lowerBlock_getElem?_termPre pack hBbSrc
  cases hLow with | intro extraStart hL =>
  let base := pack.bodySrc.locals.length
  let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability extraStart bbSrc.terminator
  let bbTgt : MemCopyBlock := {
    bbSrc with
    statements := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
    terminator := termRes.2.1
  }
  have hTermTgt : termRes = ([], shiftMemCopyTermTargets (.baseTerm bt), []) := by
    dsimp [termRes]
    rw [hTermSrc]
    rfl
  have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
    rw [hBbRel]; exact hL.2.1
  have hEnd₂ : f₂.stmtIdx = bbTgt.statements.length := by
    have hPre0 : termRes.1.length = 0 := by rw [hTermTgt]; rfl
    have hOff := hL.2.2.2.1
    rw [hPre0, Nat.add_zero] at hOff
    rw [hLenEq, hEnd₁, ← hL.2.2.1, hOff]
  have hNone₂ : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = none :=
    s4_getElem?_ge_none bbTgt.statements f₂.stmtIdx (by rw [hEnd₂]; exact Nat.le_refl _)
  have hEvTgt := s4_evalStepMemCopy_at_term pTgt pack.bodyTgt f₂ m₂ bbTgt
    hBodyTgt hBbTgt hNone₂ hEnd₂
  have hTermTgtField : bbTgt.terminator = shiftMemCopyTermTargets (.baseTerm bt) := by
    dsimp [bbTgt]; rw [hTermTgt]
  cases bt with
  | goto target =>
    have hJumpTgt : bbTgt.terminator = .baseTerm (.goto (target + 1)) := by
      rw [hTermTgtField]; rfl
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      rw [hEvSrc] at hStep
      dsimp [evalMemCopyTerm] at hStep
      rw [hTermSrc] at hStep
      dsimp [jumpMemCopyBlock] at hStep
      cases StepResult.step.inj hStep
      have hStepTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } =
          .step { frames := [{ f₂ with blockIdx := target + 1, stmtIdx := 0 }], mem := m₂ } := by
        rw [hEvTgt]
        dsimp [evalMemCopyTerm]
        rw [hJumpTgt]
        rfl
      exact s4_reachesPlus_term_rel pack hSame hSame₂
        (s4_reachesNMemCopy_one_step hStepTgt) hPM hWf hBuf hMem hScr
    · intro out hDone
      rw [hEvSrc] at hDone
      dsimp [evalMemCopyTerm] at hDone
      rw [hTermSrc] at hDone
      cases hDone
    · intro k hFault
      rw [hEvSrc] at hFault
      dsimp [evalMemCopyTerm] at hFault
      rw [hTermSrc] at hFault
      cases hFault
  | unreachable =>
    have hUnrTgt : bbTgt.terminator = .baseTerm .unreachable := by
      rw [hTermTgtField]; rfl
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      rw [hEvSrc] at hStep; dsimp [evalMemCopyTerm] at hStep; rw [hTermSrc] at hStep; cases hStep
    · intro out hDone
      rw [hEvSrc] at hDone; dsimp [evalMemCopyTerm] at hDone; rw [hTermSrc] at hDone; cases hDone
    · intro k hFault
      rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault
      have hF : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } = .fault k := by
        rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hUnrTgt]; exact hFault
      exact s4_reachesMemCopy_of_reach_step_fault (ReachesNMemCopy.zero _) hF
  | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      rw [hEvSrc] at hStep; dsimp [evalMemCopyTerm] at hStep; rw [hTermSrc] at hStep; cases hStep
    · intro out hDone
      rw [hEvSrc] at hDone; dsimp [evalMemCopyTerm] at hDone; rw [hTermSrc] at hDone; cases hDone
    · intro k hFault
      rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault
      have hF : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } = .fault k := by
        rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hTermTgtField]; dsimp [shiftMemCopyTermTargets]
        exact hFault
      exact s4_reachesMemCopy_of_reach_step_fault (ReachesNMemCopy.zero _) hF
  | return_ =>
    have hRetTgt : bbTgt.terminator = .baseTerm .return_ := by rw [hTermTgtField]; rfl
    have hPosBuf : 0 < plan.bufLocal := Nat.lt_of_le_of_lt (Nat.zero_le _) pack.hArgLtBuf
    have hZeroLt : 0 < pack.bodySrc.locals.length := Nat.lt_trans hPosBuf pack.hBufLtLoc
    have hZeroNe : (0 : Nat) ≠ plan.bufLocal := Nat.ne_of_lt hPosBuf
    have hD0 := s4_getElem?_bodyTgt_locals_lt pack hZeroLt hZeroNe
    have hS0 := hPM.2.2 0 hZeroLt hZeroNe
    have hExt1 := s4_extMem_src_eq_empty pack hMem
    have hExt2 := s4_extMem_tgt_eq_empty pack hMem
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      rw [hEvSrc] at hStep; dsimp [evalMemCopyTerm] at hStep; rw [hTermSrc] at hStep
      cases hCl : bbSrc.cleanup with
      | true => rw [hCl] at hStep; cases hStep
      | false =>
        rw [hCl] at hStep
        dsimp at hStep
        cases hD0Step : Trusted.MirSemantics.getElem? pack.bodySrc.locals 0 with
        | none =>
          rw [hD0Step] at hStep
          cases hS0Step : Trusted.MirSemantics.getElem? f₁.locals 0 with
          | none => rw [hS0Step] at hStep; cases hStep
          | some sl0 =>
            rw [hS0Step] at hStep
            cases sl0 with
            | ptrDead | livePtr _ | bufSlot _ => cases hStep
            | baseSlot bs0 =>
              cases bs0 with
              | dead => cases hStep
              | live ov0 => cases ov0 <;> cases hStep
        | some d0 =>
          rw [hD0Step] at hStep
          cases d0 with
          | byteBuf _ _ _ => cases hStep
          | base _ =>
            cases hS0Step : Trusted.MirSemantics.getElem? f₁.locals 0 with
            | none => rw [hS0Step] at hStep; cases hStep
            | some sl0 =>
              rw [hS0Step] at hStep
              cases sl0 with
              | ptrDead | livePtr _ | bufSlot _ => cases hStep
              | baseSlot bs0 =>
                cases bs0 with
                | dead => cases hStep
                | live ov0 => cases ov0 <;> cases hStep
          | ptrLocal =>
            cases hS0Step : Trusted.MirSemantics.getElem? f₁.locals 0 with
            | none => rw [hS0Step] at hStep; cases hStep
            | some sl0 =>
              rw [hS0Step] at hStep
              cases sl0 with
              | baseSlot _ | bufSlot _ | ptrDead => cases hStep
              | livePtr opv =>
                cases opv with
                | none => cases hStep
                | some pv =>
                  rw [pack.hAcceptsFalse] at hStep
                  cases hStep
    · intro out hDone
      rw [hEvSrc] at hDone; dsimp [evalMemCopyTerm] at hDone; rw [hTermSrc] at hDone
      have hDoneTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } = .done out := by
        rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hRetTgt]
        cases hCl : bbSrc.cleanup with
        | true => rw [hCl] at hDone; cases hDone
        | false =>
          rw [hCl] at hDone
          dsimp; dsimp at hDone
          rw [hD0, hS0]
          cases hD0C : Trusted.MirSemantics.getElem? pack.bodySrc.locals 0 with
          | none =>
            rw [hD0C] at hDone
            cases hS0C : Trusted.MirSemantics.getElem? f₁.locals 0 with
            | none => rw [hS0C] at hDone; cases hDone
            | some sl0 =>
              rw [hS0C] at hDone
              cases sl0 with
              | ptrDead | livePtr _ | bufSlot _ => cases hDone
              | baseSlot bs0 =>
                cases bs0 with
                | dead => cases hDone
                | live ov0 =>
                  cases ov0 with
                  | none => cases hDone
                  | some retVal =>
                    dsimp; dsimp at hDone
                    change StepResult.done (.returned ⟨retVal,
                      if pack.bodyTgt.acceptsCallerMem ||
                          pack.bodyTgt.locals.any (fun d => match d with | .byteBuf _ _ _ => true | _ => false) then
                        projectExternalCallerMem m₂
                      else m₂⟩) = StepResult.done out
                    change StepResult.done (.returned ⟨retVal,
                      if pack.bodySrc.acceptsCallerMem ||
                          pack.bodySrc.locals.any (fun d => match d with | .byteBuf _ _ _ => true | _ => false) then
                        projectExternalCallerMem m₁
                      else m₁⟩) = StepResult.done out at hDone
                    rw [hExt2]
                    rw [hExt1] at hDone
                    exact hDone
          | some d0 =>
            rw [hD0C] at hDone
            cases d0 with
            | byteBuf _ _ _ => cases hDone
            | base _ =>
              cases hS0C : Trusted.MirSemantics.getElem? f₁.locals 0 with
              | none => rw [hS0C] at hDone; cases hDone
              | some sl0 =>
                rw [hS0C] at hDone
                cases sl0 with
                | ptrDead | livePtr _ | bufSlot _ => cases hDone
                | baseSlot bs0 =>
                  cases bs0 with
                  | dead => cases hDone
                  | live ov0 =>
                    cases ov0 with
                    | none => cases hDone
                    | some retVal =>
                      dsimp; dsimp at hDone
                      change StepResult.done (.returned ⟨retVal,
                        if pack.bodyTgt.acceptsCallerMem ||
                            pack.bodyTgt.locals.any (fun d => match d with | .byteBuf _ _ _ => true | _ => false) then
                          projectExternalCallerMem m₂
                        else m₂⟩) = StepResult.done out
                      change StepResult.done (.returned ⟨retVal,
                        if pack.bodySrc.acceptsCallerMem ||
                            pack.bodySrc.locals.any (fun d => match d with | .byteBuf _ _ _ => true | _ => false) then
                          projectExternalCallerMem m₁
                        else m₁⟩) = StepResult.done out at hDone
                      rw [hExt2]
                      rw [hExt1] at hDone
                      exact hDone
            | ptrLocal =>
              cases hS0C : Trusted.MirSemantics.getElem? f₁.locals 0 with
              | none => rw [hS0C] at hDone; cases hDone
              | some sl0 =>
                rw [hS0C] at hDone
                cases sl0 with
                | baseSlot _ | bufSlot _ | ptrDead => cases hDone
                | livePtr opv =>
                  cases opv with
                  | none => cases hDone
                  | some pv => rw [pack.hAcceptsFalse] at hDone; cases hDone
      exact ⟨{ frames := [f₂], mem := m₂ }, ReachesMemCopy.refl _,
        (stepMemCopy_iff_evalStep pTgt _ (.done out)).mpr hDoneTgt⟩
    · intro k hFault
      rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault
      have hFaultTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } = .fault k := by
        rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hRetTgt]
        cases hCl : bbSrc.cleanup with
        | true => rw [hCl] at hFault; exact hFault
        | false =>
          rw [hCl] at hFault
          dsimp; dsimp at hFault
          rw [hD0, hS0]
          cases hD0C : Trusted.MirSemantics.getElem? pack.bodySrc.locals 0 with
          | none =>
            rw [hD0C] at hFault
            cases hS0C : Trusted.MirSemantics.getElem? f₁.locals 0 with
            | none => rw [hS0C] at hFault; exact hFault
            | some sl0 =>
              rw [hS0C] at hFault
              cases sl0 with
              | ptrDead | livePtr _ | bufSlot _ => exact hFault
              | baseSlot bs0 =>
                cases bs0 with
                | dead => exact hFault
                | live ov0 =>
                  cases ov0 with
                  | none => exact hFault
                  | some _ => dsimp at hFault; cases hFault
          | some d0 =>
            rw [hD0C] at hFault
            cases d0 with
            | byteBuf _ _ _ => exact hFault
            | base _ =>
              cases hS0C : Trusted.MirSemantics.getElem? f₁.locals 0 with
              | none => rw [hS0C] at hFault; exact hFault
              | some sl0 =>
                rw [hS0C] at hFault
                cases sl0 with
                | ptrDead | livePtr _ | bufSlot _ => exact hFault
                | baseSlot bs0 =>
                  cases bs0 with
                  | dead => exact hFault
                  | live ov0 =>
                    cases ov0 with
                    | none => exact hFault
                    | some _ => dsimp at hFault; cases hFault
            | ptrLocal =>
              cases hS0C : Trusted.MirSemantics.getElem? f₁.locals 0 with
              | none => rw [hS0C] at hFault; exact hFault
              | some sl0 =>
                rw [hS0C] at hFault
                cases sl0 with
                | baseSlot _ | bufSlot _ | ptrDead => exact hFault
                | livePtr opv =>
                  cases opv with
                  | none => exact hFault
                  | some _ =>
                    dsimp; dsimp at hFault
                    rw [s4_bodyTgt_acceptsCallerMem pack]
                    rw [pack.hAcceptsFalse] at hFault
                    exact hFault
      exact s4_reachesMemCopy_of_reach_step_fault (ReachesNMemCopy.zero _) hFaultTgt
  | switchInt discr targets =>
    have hChk := s4_bodySrc_block_checks pack hBbSrc
    have hTermChk := hChk.2
    rw [hTermSrc] at hTermChk
    dsimp [checkTermForBuf] at hTermChk
    have hPrim := s4_evalMemCopyPrimitiveOperand_prefix pack hPM hWf hBuf hScr hTermChk
    have hSwTgt : bbTgt.terminator = .baseTerm (.switchInt discr {
        otherwise := targets.otherwise + 1
        branches := targets.branches.map (fun br => (br.1, br.2 + 1)) }) := by
      rw [hTermTgtField]; rfl
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      rw [hEvSrc] at hStep; dsimp [evalMemCopyTerm] at hStep; rw [hTermSrc] at hStep; dsimp at hStep
      cases hOp : evalMemCopyPrimitiveOperand pack.bodySrc.locals f₁.locals discr with
      | error _ => rw [hOp] at hStep; cases hStep
      | ok res =>
        rw [hOp] at hStep hPrim
        cases hPrim with | intro slots₂' hP =>
        dsimp at hStep
        cases hV : res.1 with
        | bool b =>
          rw [hV] at hStep
          dsimp at hStep
          cases hSw : evalBoolSwitchBranches b targets.otherwise targets.branches with
          | error _ => rw [hSw] at hStep; cases hStep
          | ok target =>
            rw [hSw] at hStep
            cases StepResult.step.inj hStep
            have hStepTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } =
                .step { frames := [{ f₂ with blockIdx := target + 1, stmtIdx := 0, locals := slots₂' }],
                        mem := m₂ } := by
              rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hSwTgt]; dsimp; rw [hP.1]
              dsimp; rw [hV]; dsimp
              rw [s4_evalBoolSwitchBranches_shift b targets.otherwise targets.branches, hSw]
              rfl
            exact s4_reachesPlus_term_rel pack hSame hSame₂
              (s4_reachesNMemCopy_one_step hStepTgt) hP.2.1 hP.2.2.1 hP.2.2.2.1 hMem hP.2.2.2.2
        | scalar sv =>
          rw [hV] at hStep
          dsimp at hStep
          cases hSw : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
          | error _ => rw [hSw] at hStep; cases hStep
          | ok target =>
            rw [hSw] at hStep
            cases StepResult.step.inj hStep
            have hStepTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } =
                .step { frames := [{ f₂ with blockIdx := target + 1, stmtIdx := 0, locals := slots₂' }],
                        mem := m₂ } := by
              rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hSwTgt]; dsimp; rw [hP.1]
              dsimp; rw [hV]; dsimp
              rw [s4_evalSwitchBranches_shift sv.width sv.bits targets.otherwise targets.branches, hSw]
              rfl
            exact s4_reachesPlus_term_rel pack hSame hSame₂
              (s4_reachesNMemCopy_one_step hStepTgt) hP.2.1 hP.2.2.1 hP.2.2.2.1 hMem hP.2.2.2.2
        | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ =>
          rw [hV] at hStep; cases hStep
    · intro out hDone
      rw [hEvSrc] at hDone; dsimp [evalMemCopyTerm] at hDone; rw [hTermSrc] at hDone; dsimp at hDone
      cases hOp : evalMemCopyPrimitiveOperand pack.bodySrc.locals f₁.locals discr with
      | error _ => rw [hOp] at hDone; cases hDone
      | ok res =>
        rw [hOp] at hDone
        dsimp at hDone
        cases hR1 : res.1 with
        | bool b =>
          rw [hR1] at hDone; dsimp at hDone
          cases hSw : evalBoolSwitchBranches b targets.otherwise targets.branches with
          | error _ => rw [hSw] at hDone; cases hDone
          | ok _ => rw [hSw] at hDone; cases hDone
        | scalar sv =>
          rw [hR1] at hDone; dsimp at hDone
          cases hSw : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
          | error _ => rw [hSw] at hDone; cases hDone
          | ok _ => rw [hSw] at hDone; cases hDone
        | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ =>
          rw [hR1] at hDone; cases hDone
    · intro k hFault
      rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault; dsimp at hFault
      have hFaultTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } = .fault k := by
        rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hSwTgt]; dsimp
        cases hOp : evalMemCopyPrimitiveOperand pack.bodySrc.locals f₁.locals discr with
        | error k1 =>
          rw [hOp] at hFault hPrim
          rw [hPrim]
          exact hFault
        | ok res =>
          rw [hOp] at hFault hPrim
          cases hPrim with | intro slots₂' hP =>
          rw [hP.1]
          dsimp; dsimp at hFault
          cases hV : res.1 with
          | bool b =>
            rw [hV] at hFault
            dsimp; dsimp at hFault
            rw [s4_evalBoolSwitchBranches_shift b targets.otherwise targets.branches]
            cases hSw : evalBoolSwitchBranches b targets.otherwise targets.branches with
            | ok _ => rw [hSw] at hFault; cases hFault
            | error k2 => rw [hSw] at hFault; exact hFault
          | scalar sv =>
            rw [hV] at hFault
            dsimp; dsimp at hFault
            rw [s4_evalSwitchBranches_shift sv.width sv.bits targets.otherwise targets.branches]
            cases hSw : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
            | ok _ => rw [hSw] at hFault; cases hFault
            | error k2 => rw [hSw] at hFault; exact hFault
          | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ =>
            rw [hV] at hFault; exact hFault
      exact s4_reachesMemCopy_of_reach_step_fault (ReachesNMemCopy.zero _) hFaultTgt

private theorem s4_sim_term_readBuf_other
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {tagDst valDst b nextBb : Nat} {offOp : Operand}
    (hBNe : b ≠ plan.bufLocal)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTermSrc : bbSrc.terminator = .readBufRawByte tagDst valDst b offOp nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hNone₁ : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = none :=
    s4_getElem?_ge_none bbSrc.statements f₁.stmtIdx (by rw [hEnd₁]; exact Nat.le_refl _)
  have hEvSrc := s4_evalStepMemCopy_at_term pSrc pack.bodySrc f₁ m₁ bbSrc
    hBodySrc hBbSrc hNone₁ hEnd₁
  have hLow := s4_lowerBlock_getElem?_termPre pack hBbSrc
  cases hLow with | intro extraStart hL =>
  let base := pack.bodySrc.locals.length
  let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability extraStart bbSrc.terminator
  let bbTgt : MemCopyBlock := {
    bbSrc with
    statements := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
    terminator := termRes.2.1
  }
  have hTermTgt : termRes = ([], .readBufRawByte tagDst valDst b offOp (nextBb + 1), []) := by
    dsimp [termRes]; rw [hTermSrc]; dsimp [lowerTermForBuf]; rw [s4_nat_beq_false hBNe]; rfl
  have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
    rw [hBbRel]; exact hL.2.1
  have hEnd₂ : f₂.stmtIdx = bbTgt.statements.length := by
    have hPre0 : termRes.1.length = 0 := by rw [hTermTgt]; rfl
    have hOff := hL.2.2.2.1
    rw [hPre0, Nat.add_zero] at hOff
    rw [hLenEq, hEnd₁, ← hL.2.2.1, hOff]
  have hNone₂ : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = none :=
    s4_getElem?_ge_none bbTgt.statements f₂.stmtIdx (by rw [hEnd₂]; exact Nat.le_refl _)
  have hEvTgt := s4_evalStepMemCopy_at_term pTgt pack.bodyTgt f₂ m₂ bbTgt
    hBodyTgt hBbTgt hNone₂ hEnd₂
  have hTermTgtField : bbTgt.terminator = .readBufRawByte tagDst valDst b offOp (nextBb + 1) := by
    dsimp [bbTgt]; rw [hTermTgt]
  have hTermChk := (s4_bodySrc_block_checks pack hBbSrc).2
  rw [hTermSrc] at hTermChk
  dsimp [checkTermForBuf] at hTermChk
  have hA1 := (bool_and_eq_true _ _).mp hTermChk
  have hA2 := (bool_and_eq_true _ _).mp hA1.1
  have hA3 := (bool_and_eq_true _ _).mp hA2.1
  have hA4 := (bool_and_eq_true _ _).mp hA3.1
  have hTagNe : tagDst ≠ plan.bufLocal := nat_beq_false_ne (by
    cases hb : Nat.beq tagDst plan.bufLocal with | false => rfl | true => rw [hb] at hA4; cases hA4.2)
  have hValNe : valDst ≠ plan.bufLocal := nat_beq_false_ne (by
    cases hb : Nat.beq valDst plan.bufLocal with | false => rfl | true => rw [hb] at hA3; cases hA3.2)
  have hBaseOp := s4_operandUsesOnlyBaseMem_of_hasBaseTy pack.bodySrc.locals usizeTy offOp hA2.2
  have hTermLoc := s4_bodySrc_term_localsInBounds pack hBbSrc
  rw [hTermSrc] at hTermLoc
  dsimp [memCopyTermLocalsInBounds] at hTermLoc
  have hL1 := (bool_and_eq_true _ _).mp hTermLoc
  have hL2 := (bool_and_eq_true _ _).mp hL1.1
  have hL3 := (bool_and_eq_true _ _).mp hL2.1
  have hTagIn : tagDst < pack.bodySrc.locals.length := (nat_blt_eq_lt _ _).mp hL3.1
  have hValIn : valDst < pack.bodySrc.locals.length := (nat_blt_eq_lt _ _).mp hL3.2
  have hBIn : b < pack.bodySrc.locals.length := (nat_blt_eq_lt _ _).mp hL2.2
  have hDT := s4_getElem?_bodyTgt_locals_lt pack hTagIn hTagNe
  have hDV := s4_getElem?_bodyTgt_locals_lt pack hValIn hValNe
  have hDB := s4_getElem?_bodyTgt_locals_lt pack hBIn hBNe
  have hFindNe : findAlloc? (internalAllocBase + b) m₂.allocations =
      findAlloc? (internalAllocBase + b) m₁.allocations := by
    rw [hMem.1]
    exact s4_findAlloc?_filter_ne (internalAllocBase + plan.bufLocal) (internalAllocBase + b)
      (fun h => hBNe (Nat.add_left_cancel h)) m₁.allocations
  have hOffPref := s4_evalUsizeOp_prefix pack hPM hWf hBuf hScr hBaseOp
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    rw [hEvSrc] at hStep; dsimp [evalMemCopyTerm] at hStep; rw [hTermSrc] at hStep; dsimp at hStep
    cases hTv : Nat.beq tagDst valDst with
    | true => rw [hTv] at hStep; cases hStep
    | false =>
      rw [hTv] at hStep; dsimp at hStep
      cases hT1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals tagDst with
      | none => rw [hT1] at hStep; cases hStep
      | some dT =>
        rw [hT1] at hStep
        cases hV1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals valDst with
        | none => rw [hV1] at hStep; cases dT <;> cases hStep
        | some dV =>
          rw [hV1] at hStep
          cases hB1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
          | none =>
            rw [hB1] at hStep
            cases dT with
            | ptrLocal | byteBuf _ _ _ => cases hStep
            | base _ => cases dV <;> cases hStep
          | some dB =>
            rw [hB1] at hStep
            cases dT with
            | ptrLocal | byteBuf _ _ _ => cases hStep
            | base tTy =>
              cases dV with
              | ptrLocal | byteBuf _ _ _ => cases hStep
              | base vTy =>
                cases dB with
                | ptrLocal | base _ => cases hStep
                | byteBuf sz al mu =>
                  dsimp at hStep
                  cases hBadTy : !(MirTy.beq tTy usizeTy) || !(MirTy.beq vTy usizeTy) with
                  | true => rw [hBadTy] at hStep; cases hStep
                  | false =>
                    rw [hBadTy] at hStep; dsimp at hStep
                    have hTTy : tTy = usizeTy := s4c_mirTy_beq_usize_eq tTy (by
                      cases hb : MirTy.beq tTy usizeTy with
                      | true => rfl
                      | false => rw [hb] at hBadTy; cases hBadTy)
                    have hVTy : vTy = usizeTy := s4c_mirTy_beq_usize_eq vTy (by
                      cases hb1 : MirTy.beq tTy usizeTy with
                      | false => rw [hb1] at hBadTy; cases hBadTy
                      | true =>
                        cases hb2 : MirTy.beq vTy usizeTy with
                        | true => rfl
                        | false => rw [hb1, hb2] at hBadTy; cases hBadTy)
                    have hDeclT : Trusted.MirSemantics.getElem? pack.bodySrc.locals tagDst = some (.base usizeTy) := by
                      rw [hT1, hTTy]
                    have hDeclV : Trusted.MirSemantics.getElem? pack.bodySrc.locals valDst = some (.base usizeTy) := by
                      rw [hV1, hVTy]
                    cases hOff : evalUsizeOp pack.bodySrc.locals f₁.locals offOp with
                    | error _ => rw [hOff] at hStep; cases hStep
                    | ok resOff =>
                      rw [hOff] at hStep hOffPref
                      cases hOffPref.2 with | intro slots₂₁ hP1 =>
                      dsimp at hStep
                      have hS1B := hP1.2.1.2.2 b hBIn hBNe
                      cases hSlB : Trusted.MirSemantics.getElem? resOff.2 b with
                      | none => rw [hSlB] at hStep; cases hStep
                      | some slB =>
                        rw [hSlB] at hStep
                        cases slB with
                        | baseSlot _ | ptrDead | livePtr _ => cases hStep
                        | bufSlot isLB =>
                          cases isLB with
                          | false => cases hStep
                          | true =>
                            cases hFind : findAlloc? (internalAllocBase + b) m₁.allocations with
                            | none => rw [hFind] at hStep; cases hStep
                            | some alloc =>
                              rw [hFind] at hStep; dsimp at hStep
                              cases hLive : !alloc.live with
                              | true => rw [hLive] at hStep; cases hStep
                              | false =>
                                rw [hLive] at hStep; dsimp at hStep
                                cases hByte : Trusted.MirSemantics.getElem? alloc.bytes resOff.1 with
                                | none => rw [hByte] at hStep; cases hStep
                                | some ab =>
                                  rw [hByte] at hStep; dsimp at hStep
                                  cases hWfl : !Nat.blt (encodeAllocByte ab).1 maxUsize with
                                  | true => rw [hWfl] at hStep; cases hStep
                                  | false =>
                                    rw [hWfl] at hStep; dsimp at hStep
                                    have hWrT := s4_writeMemCopyBasePlace_prefix pack hP1.2.1 hP1.2.2.1
                                      hP1.2.2.2.1 hP1.2.2.2.2 hDeclT hTagNe
                                      (val := .scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩)
                                    cases hWT : writeMemCopyBasePlace resOff.2 tagDst usizeTy
                                        (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩) with
                                    | error _ => rw [hWT] at hStep; cases hStep
                                    | ok slotsMid =>
                                      rw [hWT] at hStep hWrT; dsimp at hStep
                                      cases hWrT with | intro slots₂₂ hP2 =>
                                      have hWrV := s4_writeMemCopyBasePlace_prefix pack hP2.2.1 hP2.2.2.1
                                        hP2.2.2.2.1 hP2.2.2.2.2 hDeclV hValNe
                                        (val := .scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩)
                                      cases hWV : writeMemCopyBasePlace slotsMid valDst usizeTy
                                          (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩) with
                                      | error _ => rw [hWV] at hStep; dsimp at hStep; cases hStep
                                      | ok slotsOut =>
                                        rw [hWV] at hStep hWrV; dsimp at hStep
                                        cases hWrV with | intro slots₂₃ hP3 =>
                                        dsimp [jumpMemCopyBlock] at hStep
                                        cases StepResult.step.inj hStep
                                        have hStepTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } =
                                            .step { frames := [{ f₂ with blockIdx := nextBb + 1, stmtIdx := 0, locals := slots₂₃ }],
                                                    mem := m₂ } := by
                                          rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hTermTgtField]; dsimp; rw [hTv]
                                          dsimp; rw [hDT, hT1, hDV, hV1, hDB, hB1]
                                          dsimp; rw [hBadTy]; dsimp; rw [hP1.1]
                                          dsimp; rw [hS1B, hSlB, hFindNe, hFind]; dsimp; rw [hLive]
                                          dsimp; rw [hByte]; dsimp; rw [hWfl]
                                          dsimp; rw [hP2.1]; dsimp; rw [hP3.1]
                                          rfl
                                        exact s4_reachesPlus_term_rel pack hSame hSame₂
                                          (s4_reachesNMemCopy_one_step hStepTgt) hP3.2.1 hP3.2.2.1
                                          hP3.2.2.2.1 hMem hP3.2.2.2.2
  · intro out hDone
    rw [hEvSrc] at hDone; dsimp [evalMemCopyTerm] at hDone; rw [hTermSrc] at hDone; dsimp at hDone
    cases hTv : Nat.beq tagDst valDst with
    | true => rw [hTv] at hDone; cases hDone
    | false =>
      rw [hTv] at hDone; dsimp at hDone
      cases hT1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals tagDst with
      | none => rw [hT1] at hDone; cases hDone
      | some dT =>
        rw [hT1] at hDone
        cases hV1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals valDst with
        | none => rw [hV1] at hDone; cases dT <;> cases hDone
        | some dV =>
          rw [hV1] at hDone
          cases hB1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
          | none =>
            rw [hB1] at hDone
            cases dT with
            | ptrLocal | byteBuf _ _ _ => cases hDone
            | base _ => cases dV <;> cases hDone
          | some dB =>
            rw [hB1] at hDone
            cases dT with
            | ptrLocal | byteBuf _ _ _ => cases hDone
            | base tTy =>
              cases dV with
              | ptrLocal | byteBuf _ _ _ => cases hDone
              | base vTy =>
                cases dB with
                | ptrLocal | base _ => cases hDone
                | byteBuf _ _ _ =>
                  dsimp at hDone
                  cases hBadTy : !(MirTy.beq tTy usizeTy) || !(MirTy.beq vTy usizeTy) with
                  | true => rw [hBadTy] at hDone; cases hDone
                  | false =>
                    rw [hBadTy] at hDone; dsimp at hDone
                    cases hOff : evalUsizeOp pack.bodySrc.locals f₁.locals offOp with
                    | error _ => rw [hOff] at hDone; cases hDone
                    | ok resOff =>
                      rw [hOff] at hDone; dsimp at hDone
                      cases hSlB : Trusted.MirSemantics.getElem? resOff.2 b with
                      | none => rw [hSlB] at hDone; cases hDone
                      | some slB =>
                        rw [hSlB] at hDone
                        cases slB with
                        | baseSlot _ | ptrDead | livePtr _ => cases hDone
                        | bufSlot isLB =>
                          cases isLB with
                          | false => cases hDone
                          | true =>
                            cases hFind : findAlloc? (internalAllocBase + b) m₁.allocations with
                            | none => rw [hFind] at hDone; cases hDone
                            | some alloc =>
                              rw [hFind] at hDone; dsimp at hDone
                              cases hLive : !alloc.live with
                              | true => rw [hLive] at hDone; cases hDone
                              | false =>
                                rw [hLive] at hDone; dsimp at hDone
                                cases hByte : Trusted.MirSemantics.getElem? alloc.bytes resOff.1 with
                                | none => rw [hByte] at hDone; cases hDone
                                | some ab =>
                                  rw [hByte] at hDone; dsimp at hDone
                                  cases hWfl : !Nat.blt (encodeAllocByte ab).1 maxUsize with
                                  | true => rw [hWfl] at hDone; cases hDone
                                  | false =>
                                    rw [hWfl] at hDone; dsimp at hDone
                                    cases hWT : writeMemCopyBasePlace resOff.2 tagDst usizeTy _ with
                                    | error _ => rw [hWT] at hDone; cases hDone
                                    | ok slots2 =>
                                      rw [hWT] at hDone; dsimp at hDone
                                      cases hWV : writeMemCopyBasePlace slots2 valDst usizeTy _ with
                                      | error _ => rw [hWV] at hDone; cases hDone
                                      | ok _ => rw [hWV] at hDone; cases hDone
  · intro k hFault
    rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault; dsimp at hFault
    have hFaultTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } = .fault k := by
      rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hTermTgtField]; dsimp
      cases hTv : Nat.beq tagDst valDst with
      | true => rw [hTv] at hFault; exact hFault
      | false =>
        rw [hTv] at hFault; dsimp; dsimp at hFault
        rw [hDT, hDV, hDB]
        cases hT1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals tagDst with
        | none => rw [hT1] at hFault; exact hFault
        | some dT =>
          rw [hT1] at hFault
          cases hV1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals valDst with
          | none => rw [hV1] at hFault; cases dT <;> exact hFault
          | some dV =>
            rw [hV1] at hFault
            cases hB1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
            | none =>
              rw [hB1] at hFault
              cases dT with
              | ptrLocal | byteBuf _ _ _ => exact hFault
              | base _ => cases dV <;> exact hFault
            | some dB =>
              rw [hB1] at hFault
              cases dT with
              | ptrLocal | byteBuf _ _ _ => exact hFault
              | base tTy =>
                cases dV with
                | ptrLocal | byteBuf _ _ _ => exact hFault
                | base vTy =>
                  cases dB with
                  | ptrLocal | base _ => exact hFault
                  | byteBuf _ _ _ =>
                    dsimp; dsimp at hFault
                    cases hBadTy : !(MirTy.beq tTy usizeTy) || !(MirTy.beq vTy usizeTy) with
                    | true => rw [hBadTy] at hFault; exact hFault
                    | false =>
                      rw [hBadTy] at hFault; dsimp; dsimp at hFault
                      have hTTy : tTy = usizeTy := s4c_mirTy_beq_usize_eq tTy (by
                        cases hb : MirTy.beq tTy usizeTy with
                        | true => rfl
                        | false => rw [hb] at hBadTy; cases hBadTy)
                      have hVTy : vTy = usizeTy := s4c_mirTy_beq_usize_eq vTy (by
                        cases hb1 : MirTy.beq tTy usizeTy with
                        | false => rw [hb1] at hBadTy; cases hBadTy
                        | true =>
                          cases hb2 : MirTy.beq vTy usizeTy with
                          | true => rfl
                          | false => rw [hb1, hb2] at hBadTy; cases hBadTy)
                      have hDeclT : Trusted.MirSemantics.getElem? pack.bodySrc.locals tagDst = some (.base usizeTy) := by
                        rw [hT1, hTTy]
                      have hDeclV : Trusted.MirSemantics.getElem? pack.bodySrc.locals valDst = some (.base usizeTy) := by
                        rw [hV1, hVTy]
                      cases hOff : evalUsizeOp pack.bodySrc.locals f₁.locals offOp with
                      | error k1 =>
                        rw [hOff] at hFault hOffPref
                        rw [hOffPref]; exact hFault
                      | ok resOff =>
                        rw [hOff] at hFault hOffPref
                        cases hOffPref.2 with | intro slots₂₁ hP1 =>
                        rw [hP1.1]; dsimp; dsimp at hFault
                        rw [hP1.2.1.2.2 b hBIn hBNe]
                        cases hSlB : Trusted.MirSemantics.getElem? resOff.2 b with
                        | none => rw [hSlB] at hFault; exact hFault
                        | some slB =>
                          rw [hSlB] at hFault
                          cases slB with
                          | baseSlot _ | ptrDead | livePtr _ => exact hFault
                          | bufSlot isLB =>
                            cases isLB with
                            | false => exact hFault
                            | true =>
                              rw [hFindNe]
                              cases hFind : findAlloc? (internalAllocBase + b) m₁.allocations with
                              | none => rw [hFind] at hFault; exact hFault
                              | some alloc =>
                                rw [hFind] at hFault; dsimp; dsimp at hFault
                                cases hLive : !alloc.live with
                                | true => rw [hLive] at hFault; exact hFault
                                | false =>
                                  rw [hLive] at hFault; dsimp; dsimp at hFault
                                  cases hByte : Trusted.MirSemantics.getElem? alloc.bytes resOff.1 with
                                  | none => rw [hByte] at hFault; exact hFault
                                  | some ab =>
                                    rw [hByte] at hFault; dsimp; dsimp at hFault
                                    cases hWfl : !Nat.blt (encodeAllocByte ab).1 maxUsize with
                                    | true => rw [hWfl] at hFault; exact hFault
                                    | false =>
                                      rw [hWfl] at hFault; dsimp; dsimp at hFault
                                      have hWrT := s4_writeMemCopyBasePlace_prefix pack hP1.2.1 hP1.2.2.1
                                        hP1.2.2.2.1 hP1.2.2.2.2 hDeclT hTagNe
                                        (val := .scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩)
                                      cases hWT : writeMemCopyBasePlace resOff.2 tagDst usizeTy _ with
                                      | error k1 =>
                                        rw [hWT] at hFault hWrT
                                        rw [hWrT]; exact hFault
                                      | ok slotsMid =>
                                        rw [hWT] at hFault hWrT
                                        cases hWrT with | intro slots₂₂ hP2 =>
                                        rw [hP2.1]; dsimp; dsimp at hFault
                                        have hWrV := s4_writeMemCopyBasePlace_prefix pack hP2.2.1 hP2.2.2.1
                                          hP2.2.2.2.1 hP2.2.2.2.2 hDeclV hValNe
                                          (val := .scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩)
                                        cases hWV : writeMemCopyBasePlace slotsMid valDst usizeTy _ with
                                        | ok _ => rw [hWV] at hFault; cases hFault
                                        | error k2 =>
                                          rw [hWV] at hFault hWrV
                                          rw [hWrV]; exact hFault
    exact s4_reachesMemCopy_of_reach_step_fault (ReachesNMemCopy.zero _) hFaultTgt

private theorem s4_evalPrimMoveUsize (localsDecl : List MemCopyLocalDecl)
    (slots slots' : List MemCopySlot) (id n : Nat)
    (hDecl : Trusted.MirSemantics.getElem? localsDecl id = some (.base usizeTy))
    (hSlot : Trusted.MirSemantics.getElem? slots id =
      some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩)))))
    (hSet : setElem? slots id (.baseSlot (.live none)) = some slots') :
    evalMemCopyPrimitiveOperand localsDecl slots (.move { localId := id, projection := [] }) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩, slots') := by
  dsimp [evalMemCopyPrimitiveOperand, evalMemCopyBaseOperandToSlot]
  rw [hDecl, hSlot]
  change (match (match setElem? slots id (MemCopySlot.baseSlot (LocalSlot.live none)) with
      | some slots1 => Except.ok (usizeTy,
          some (Val.scalar { width := IntWidth.isize, signed := false, bits := BitVec.ofNat 128 n }),
          slots1)
      | none => Except.error FaultKind.unsupported) with
    | Except.error k => Except.error k
    | Except.ok (ty, optVal, slots1) =>
      if (!isPrimitiveReadableTy ty) = true then Except.error FaultKind.unsupported
      else
        match optVal with
        | some v => Except.ok (v, slots1)
        | none => Except.error FaultKind.undefined) =
    .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩, slots')
  rw [hSet]
  rfl

private theorem s4_sim_term_readBuf_buf
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {tagDst valDst nextBb : Nat} {offOp : Operand}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTermSrc : bbSrc.terminator = .readBufRawByte tagDst valDst plan.bufLocal offOp nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hNone₁ : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = none :=
    s4_getElem?_ge_none bbSrc.statements f₁.stmtIdx (by rw [hEnd₁]; exact Nat.le_refl _)
  have hEvSrc := s4_evalStepMemCopy_at_term pSrc pack.bodySrc f₁ m₁ bbSrc
    hBodySrc hBbSrc hNone₁ hEnd₁
  have hLow := s4_lowerBlock_getElem?_termPre pack hBbSrc
  cases hLow with | intro extraStart hL =>
  let base := pack.bodySrc.locals.length
  let offScr := base + 1 + 2 * pack.size + 1
  let built := buildReadBufArms tagDst valDst (base + 1) (base + 1 + pack.size)
    (nextBb + 1) 0 extraStart pack.size
  let trapBbId := extraStart + pack.size
  let trapBb : MemCopyBlock :=
    { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
  let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability extraStart bbSrc.terminator
  let bbTgt : MemCopyBlock := {
    bbSrc with
    statements := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
    terminator := termRes.2.1
  }
  have hTermTgt : termRes =
      ([mkAssignUse offScr offOp, mkLivenessCheckStmt base],
       .baseTerm (.switchInt (.move { localId := offScr, projection := [] })
         { branches := built.1, otherwise := trapBbId }),
       built.2 ++ [trapBb]) := by
    dsimp [termRes]; rw [hTermSrc]; dsimp [lowerTermForBuf]; rw [nat_beq_refl]; rfl
  have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
    rw [hBbRel]; exact hL.2.1
  have hOffEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements).length := by
    rw [hLenEq, hEnd₁, ← hL.2.2.1]
  have hEnd₂ : f₂.stmtIdx + 2 = bbTgt.statements.length := by
    have hPre2 : termRes.1.length = 2 := by rw [hTermTgt]; rfl
    rw [hOffEq, ← hL.2.2.2.1, hPre2]
