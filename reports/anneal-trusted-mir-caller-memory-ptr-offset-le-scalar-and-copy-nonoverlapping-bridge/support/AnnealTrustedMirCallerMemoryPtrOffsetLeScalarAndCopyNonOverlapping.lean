          ∃ slots₂',
            ReachesNMemCopy ctx.pTgt nD
                { frames := [fA], mem := mem }
                { frames := [{ fA with stmtIdx := offA + nD, locals := slots₂' }], mem := mem } ∧
            s3_SlotsRel ctx slots₁ slots₂' ∧
            (∀ j' : Nat, j' < 12 → j' ≠ 5 → j' ≠ 6 →
              Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
                Trusted.MirSemantics.getElem? sA (s3_scrBase ctx + j')) := by
      have hOffDLt : pvDst.offsetBytes.toNat < maxUsize := s3x_uint64_toNat_lt_maxUsize pvDst.offsetBytes
      cases optBufD with
      | none =>
        exact s3_exec_mkPtrAlignCheckStmts ctx (mem := mem) none 2 3 reqAlignLog2 tagD pvDst.offsetBytes.toNat pvDst
          hReq (by decide) (by decide) hTagDLt hOffDLt hMatchD rfl True.intro hWf hSA.2.1 hA2 hA3 hBbTgt hWinAlD
      | some bD =>
        exact s3_exec_mkPtrAlignCheckStmts ctx (mem := mem) (some bD) 2 3 reqAlignLog2 tagD pvDst.offsetBytes.toNat pvDst
          hReq (by decide) (by decide) hTagDLt hOffDLt hMatchD rfl (hSpecD bD rfl) hWf hSA.2.1 hA2 hA3 hBbTgt hWinAlD
    cases hAlD : checkPtrAlignMem mem pvDst reqAlignLog2 with
    | error err =>
      rw [hAlD] at hAlDRes
      dsimp at hAlDRes
      dsimp
      cases hAlDRes with | intro nD hnD =>
      cases hnD with | intro sBad hsBad =>
      exact ⟨_, sBad, s3x_reachesN_trans hSA.1 hsBad.1, hsBad.2⟩
    | ok uD =>
      cases uD
      rw [hAlD] at hAlDRes
      dsimp at hAlDRes
      dsimp
      cases hAlDRes with | intro sB hSB =>
      have hReachAB := s3x_reachesN_trans hSA.1 hSB.1
      have hPresD : ∀ j' : Nat, j' < 5 →
          Trusted.MirSemantics.getElem? sB (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') := by
        intro j' hj5
        rw [hSB.2.2 j' (Nat.lt_trans hj5 (by decide : 5 < 12)) (Nat.ne_of_lt hj5) (Nat.ne_of_lt (Nat.lt_trans hj5 (by decide : 5 < 6)))]
