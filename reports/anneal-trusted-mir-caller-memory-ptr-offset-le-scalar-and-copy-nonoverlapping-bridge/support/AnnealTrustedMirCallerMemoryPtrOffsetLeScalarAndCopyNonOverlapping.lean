/-! ## Section 1: Pure Arithmetic, Bitwise, List, & Switch Helpers (`s4_*`) -/

private theorem s4_nat_eq_or_ne (a b : Nat) : a = b ∨ a ≠ b :=
  match h : Nat.beq a b with
  | true => Or.inl (nat_beq_eq a b h)
  | false => Or.inr (nat_beq_false_ne h)

private theorem s4_nat_lt_irrefl (n : Nat) : ¬ (n < n) := Nat.lt_irrefl n

private theorem s4_maxUsize_eq : maxUsize = Nat.pow 2 64 := rfl

private theorem s4_maxUsize_pos : 0 < maxUsize := by
  rw [s4_maxUsize_eq]
  exact Nat.pow_pos (Nat.zero_lt_succ 1)

private theorem s4_256_le_maxUsize : 256 ≤ maxUsize := by
  rw [s4_maxUsize_eq]
  decide

private theorem s4_255_lt_maxUsize : 255 < maxUsize :=
  Nat.lt_of_lt_of_le (Nat.lt_succ_self 255) s4_256_le_maxUsize

private theorem s4_32_lt_maxUsize : 32 < maxUsize := by
  rw [s4_maxUsize_eq]
  decide

private theorem s4_33_lt_maxUsize : 33 < maxUsize := by
  rw [s4_maxUsize_eq]
  decide

private theorem s4_nat_pow2_lt_pow128 : maxUsize < Nat.pow 2 128 := by
  rw [s4_maxUsize_eq]
  decide

private theorem s4_nat_div_add_mod (m n : Nat) : n * Nat.div m n + Nat.mod m n = m :=
  Nat.div_add_mod m n

private theorem s4_nat_mod_one (x : Nat) : Nat.mod x 1 = 0 := Nat.mod_one x

private theorem s4_nat_add_mul_div_right (x y : Nat) {z : Nat} (H : 0 < z) :
    Nat.div (x + y * z) z = Nat.div x z + y := Nat.add_mul_div_right x y H

private theorem s4_nat_add_mul_mod_self_right (x y z : Nat) :
    Nat.mod (x + y * z) z = Nat.mod x z := Nat.add_mul_mod_self_right x y z

private theorem s4_nat_mod_eq_of_lt {a b : Nat} (h : a < b) : Nat.mod a b = a :=
  Nat.mod_eq_of_lt h

private theorem s4_nat_beq_true {a b : Nat} (h : a = b) : Nat.beq a b = true := by
  rw [h]; exact Nat.beq_refl b

private theorem s4_nat_beq_false {a b : Nat} (h : a ≠ b) : Nat.beq a b = false := by
  cases hb : Nat.beq a b with
  | false => rfl
  | true => exact False.elim (h (nat_beq_eq a b hb))

private theorem s4_nat_le_or_lt (a b : Nat) : a ≤ b ∨ b < a := by
  cases Nat.lt_or_ge b a with
  | inl h => exact Or.inr h
  | inr h => exact Or.inl h

private theorem s4_bitVec_beq_eq {w : Nat} {a b : BitVec w} (h : (a == b) = true) : a = b :=
  of_decide_eq_true h

private theorem s4_bitVec_beq_refl {w : Nat} (a : BitVec w) : (a == a) = true :=
  decide_eq_true rfl

private theorem s4_bitVec_eq_of_toNat_eq {w : Nat} {a b : BitVec w} (h : a.toNat = b.toNat) : a = b := by
  cases a with | ofFin fa =>
  cases b with | ofFin fb =>
  cases fa with | mk va la =>
  cases fb with | mk vb lb =>
  dsimp [BitVec.toNat] at h
  subst h
  rfl

private theorem s4_bitwise_and_zero_right (n : Nat) : Nat.bitwise and n 0 = 0 := by
  rw [Nat.bitwise.eq_1]
  cases Nat.decEq n 0 with
  | isTrue h => simp [h]
  | isFalse h => simp only [iff_false_intro h]; rfl

private theorem s4_mod_two_mul (n m : Nat) (hm : 0 < m) :
    Nat.mod n (2 * m) = Nat.mod n 2 + 2 * Nat.mod (Nat.div n 2) m := by
  let q := Nat.div (Nat.div n 2) m
  let r := Nat.mod (Nat.div n 2) m
  have hDiv2 : 2 * Nat.div n 2 + Nat.mod n 2 = n := s4_nat_div_add_mod n 2
  have hDivM : m * q + r = Nat.div n 2 := s4_nat_div_add_mod (Nat.div n 2) m
  have hDecomp : n = (2 * m) * q + (Nat.mod n 2 + 2 * r) := by
    have h1 : n = 2 * Nat.div n 2 + Nat.mod n 2 := hDiv2.symm
    have h2 : 2 * Nat.div n 2 + Nat.mod n 2 = 2 * (m * q + r) + Nat.mod n 2 :=
      congrArg (fun x => 2 * x + Nat.mod n 2) hDivM.symm
    have h3 : 2 * (m * q + r) + Nat.mod n 2 = (2 * m * q + 2 * r) + Nat.mod n 2 := by
      rw [Nat.mul_add, ← Nat.mul_assoc 2 m q]
    have h4 : (2 * m * q + 2 * r) + Nat.mod n 2 = 2 * m * q + (Nat.mod n 2 + 2 * r) := by
      rw [Nat.add_assoc, Nat.add_comm (2 * r) (Nat.mod n 2)]
    exact Eq.trans (Eq.trans h1 h2) (Eq.trans h3 h4)
  have hrLt : r < m := Nat.mod_lt _ hm
  have hn2Lt : Nat.mod n 2 < 2 := Nat.mod_lt n (Nat.zero_lt_succ 1)
  have hRemLt : Nat.mod n 2 + 2 * r < 2 * m := by
    have h2 : 2 * (r + 1) ≤ 2 * m := Nat.mul_le_mul_left 2 hrLt
    rw [Nat.mul_add, Nat.mul_one] at h2
    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_right hn2Lt (2 * r))
      (by rw [Nat.add_comm 2 (2 * r)]; exact h2)
  have hAddMod : Nat.mod ((2 * m) * q + (Nat.mod n 2 + 2 * r)) (2 * m) =
      Nat.mod (Nat.mod n 2 + 2 * r) (2 * m) := by
    rw [Nat.mul_comm (2 * m) q, Nat.add_comm (q * (2 * m)) (Nat.mod n 2 + 2 * r)]
    exact s4_nat_add_mul_mod_self_right (Nat.mod n 2 + 2 * r) q (2 * m)
  have hEq : Nat.mod n (2 * m) = Nat.mod ((2 * m) * q + (Nat.mod n 2 + 2 * r)) (2 * m) :=
    congrArg (fun x => Nat.mod x (2 * m)) hDecomp
  rw [hEq, hAddMod, s4_nat_mod_eq_of_lt hRemLt]

private theorem s4_land_pow2_sub_one : ∀ (k n : Nat),
    Nat.land n (Nat.pow 2 k - 1) = Nat.mod n (Nat.pow 2 k)
  | 0, n => by
    change Nat.bitwise and n 0 = Nat.mod n 1
    rw [s4_bitwise_and_zero_right, s4_nat_mod_one]
  | k + 1, n => by
    cases Nat.decEq n 0 with
    | isTrue hn =>
      rw [hn]
      change Nat.bitwise and 0 (Nat.pow 2 (k + 1) - 1) = Nat.mod 0 (Nat.pow 2 (k + 1))
      rw [Nat.bitwise.eq_1, Nat.zero_mod]
      rfl
    | isFalse hn =>
      have hPowSucc : Nat.pow 2 (k + 1) = 2 * Nat.pow 2 k := by
        change Nat.pow 2 k * 2 = 2 * Nat.pow 2 k
        exact Nat.mul_comm _ 2
      have hSubNe : Nat.pow 2 (k + 1) - 1 ≠ 0 := by
        have hGe2 : 2 ≤ Nat.pow 2 (k + 1) := by
          rw [hPowSucc]
          exact Nat.le_trans (Nat.le_refl 2)
            (Nat.mul_le_mul_left 2 (Nat.pow_pos (Nat.zero_lt_succ 1)))
        intro hEq
        have h0 : 2 - 1 ≤ Nat.pow 2 (k + 1) - 1 := Nat.sub_le_sub_right hGe2 1
        rw [hEq] at h0
        cases h0
      have hOdd : Nat.pow 2 (k + 1) - 1 = 2 * (Nat.pow 2 k - 1) + 1 := by
        rw [hPowSucc]
        have h1 : 1 ≤ Nat.pow 2 k := Nat.pow_pos (Nat.zero_lt_succ 1)
        have hDecomp : Nat.pow 2 k = (Nat.pow 2 k - 1) + 1 := (Nat.sub_add_cancel h1).symm
        rw [hDecomp, Nat.mul_add, Nat.mul_one]
        rfl
      have hDiv : Nat.div (Nat.pow 2 (k + 1) - 1) 2 = Nat.pow 2 k - 1 := by
        have h12 : Nat.div 1 2 = 0 := by decide
        rw [hOdd, Nat.add_comm (2 * (Nat.pow 2 k - 1)) 1, Nat.mul_comm 2 (Nat.pow 2 k - 1),
          s4_nat_add_mul_div_right 1 (Nat.pow 2 k - 1) (Nat.zero_lt_succ 1), h12, Nat.zero_add]
      have hMod : Nat.mod (Nat.pow 2 (k + 1) - 1) 2 = 1 := by
        rw [hOdd, Nat.add_comm (2 * (Nat.pow 2 k - 1)) 1,
          Nat.mul_comm 2 (Nat.pow 2 k - 1), s4_nat_add_mul_mod_self_right]
      have ih := s4_land_pow2_sub_one k (Nat.div n 2)
      change Nat.bitwise and n (Nat.pow 2 (k + 1) - 1) = Nat.mod n (Nat.pow 2 (k + 1))
      rw [Nat.bitwise.eq_1]
      simp only [iff_false_intro hn]
      have hSubNe0 : (Nat.pow 2 (k + 1) - 1 = 0) ↔ False := iff_false_intro hSubNe
      simp only [hSubNe0]
      dsimp
      have hBridge :
          (ite (and (decide (Nat.mod n 2 = 1)) (decide (Nat.mod (Nat.pow 2 (k + 1) - 1) 2 = 1)) = true)
            (Nat.bitwise and (Nat.div n 2) (Nat.div (Nat.pow 2 (k + 1) - 1) 2) +
              Nat.bitwise and (Nat.div n 2) (Nat.div (Nat.pow 2 (k + 1) - 1) 2) + 1)
            (Nat.bitwise and (Nat.div n 2) (Nat.div (Nat.pow 2 (k + 1) - 1) 2) +
              Nat.bitwise and (Nat.div n 2) (Nat.div (Nat.pow 2 (k + 1) - 1) 2))) =
          Nat.mod n (Nat.pow 2 (k + 1)) := by
        rw [hDiv, hMod]
        have hIh2 : Nat.bitwise and (Nat.div n 2) (Nat.pow 2 k - 1) =
            Nat.mod (Nat.div n 2) (Nat.pow 2 k) := ih
        rw [hIh2, hPowSucc, s4_mod_two_mul n (Nat.pow 2 k) (Nat.pow_pos (Nat.zero_lt_succ 1))]
        cases hN2 : Nat.mod n 2 with
        | zero =>
          dsimp
          rw [Nat.two_mul, Nat.zero_add]
        | succ d =>
          have hLt2 : Nat.mod n 2 < 2 := Nat.mod_lt n (Nat.zero_lt_succ 1)
          rw [hN2] at hLt2
          cases d with
          | zero =>
            dsimp
            rw [Nat.two_mul, Nat.add_comm 1 _]
          | succ d2 =>
            exact False.elim (Nat.not_lt_zero _ (Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hLt2)))
      exact hBridge

private theorem s4_land_255_eq_mod_256 (n : Nat) : Nat.land n 255 = Nat.mod n 256 :=
  s4_land_pow2_sub_one 8 n

private theorem s4_bitVec_ofNat_toNat_eq_mod (w n : Nat) :
    (BitVec.ofNat w n).toNat = Nat.mod n (Nat.pow 2 w) := by
  cases Nat.decEq w 0 <;> rfl

private theorem s4_bitVec_ofNat_toNat_of_lt {w n : Nat} (h : n < Nat.pow 2 w) :
    (BitVec.ofNat w n).toNat = n := by
  rw [s4_bitVec_ofNat_toNat_eq_mod]
  exact s4_nat_mod_eq_of_lt h

private theorem s4_truncateBits_isize_of_lt_maxUsize (n : Nat) (hn : n < maxUsize) :
    truncateBits .isize (BitVec.ofNat 128 n) = BitVec.ofNat 128 n := by
  have h128 : n < Nat.pow 2 128 := Nat.lt_trans hn s4_nat_pow2_lt_pow128
  change BitVec.ofNat 128 (BitVec.ofNat 64 (BitVec.ofNat 128 n).toNat).toNat = BitVec.ofNat 128 n
  rw [s4_bitVec_ofNat_toNat_of_lt h128, s4_bitVec_ofNat_toNat_of_lt hn]

private theorem s4_truncateBits_isize_lt_maxUsize (bv : BitVec 128) :
    (truncateBits .isize bv).toNat < maxUsize := by
  change (BitVec.ofNat 128 (BitVec.ofNat 64 bv.toNat).toNat).toNat < maxUsize
  have h64 : (BitVec.ofNat 64 bv.toNat).toNat < maxUsize := by
    rw [s4_bitVec_ofNat_toNat_eq_mod, s4_maxUsize_eq]
    exact Nat.mod_lt _ (Nat.pow_pos (Nat.zero_lt_succ 1))
  have h128 : (BitVec.ofNat 64 bv.toNat).toNat < Nat.pow 2 128 :=
    Nat.lt_trans h64 s4_nat_pow2_lt_pow128
  rw [s4_bitVec_ofNat_toNat_of_lt h128]
  exact h64

private theorem s4_scalarVal_wf_isize_lt_maxUsize (sv : ScalarVal)
    (hw : sv.width = .isize) (hwf : sv.wf = true) : sv.bits.toNat < maxUsize := by
  have hwf' : (truncateBits sv.width sv.bits == sv.bits) = true := hwf
  rw [hw] at hwf'
  have hEq : truncateBits .isize sv.bits = sv.bits := s4_bitVec_beq_eq hwf'
  rw [← hEq]
  exact s4_truncateBits_isize_lt_maxUsize sv.bits

private theorem s4_scalarVal_eq_ofNat (sv : ScalarVal)
    (hw : sv.width = .isize) (hs : sv.signed = false) (hwf : sv.wf = true) :
    sv = ⟨.isize, false, BitVec.ofNat 128 sv.bits.toNat⟩ := by
  have hLt := s4_scalarVal_wf_isize_lt_maxUsize sv hw hwf
  have h128 : BitVec.ofNat 128 sv.bits.toNat = sv.bits := by
    apply s4_bitVec_eq_of_toNat_eq
    exact s4_bitVec_ofNat_toNat_of_lt (Nat.lt_trans hLt s4_nat_pow2_lt_pow128)
  cases sv with | mk w s b =>
  dsimp at hw hs h128
  rw [hw, hs, h128]

private theorem s4_checkVal_usize_iff (v : Val) :
    checkVal v usizeTy = true ↔
      ∃ sv : ScalarVal, v = .scalar sv ∧ sv.width = .isize ∧ sv.signed = false ∧
        sv.wf = true ∧ sv.bits.toNat < maxUsize := by
  constructor
  · intro h
    cases v with
    | scalar sv =>
      unfold checkVal Val.ty? at h
      dsimp at h
      cases hwf : sv.wf with
      | false => rw [hwf] at h; cases h
      | true =>
        rw [hwf] at h
        dsimp at h
        cases hW : sv.width <;> rw [hW] at h
        · cases h
        · cases h
        · cases h
        · cases h
        · cases h
        · cases hS : sv.signed with
          | true => rw [hS] at h; cases h
          | false => exact ⟨sv, rfl, hW, hS, hwf, s4_scalarVal_wf_isize_lt_maxUsize sv hW hwf⟩
    | bool _ | unit | ptr _ | tuple _ | bytes _ => cases h
    | enumVal ety idx =>
      unfold checkVal Val.ty? at h
      dsimp at h
      cases hCond : enumAdmitted ety && Nat.blt idx ety.discriminants.length with
      | false => rw [hCond] at h; cases h
      | true => rw [hCond] at h; cases h
  · intro h
    cases h with | intro sv hsv =>
    rw [hsv.1]
    unfold checkVal Val.ty?
    dsimp
    rw [hsv.2.2.2.1, hsv.2.1, hsv.2.2.1]
    rfl

private theorem s4_checkVal_usize_ofNat {n : Nat} (hn : n < maxUsize) :
    checkVal (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩) usizeTy = true := by
  refine (s4_checkVal_usize_iff _).mpr ⟨⟨.isize, false, BitVec.ofNat 128 n⟩, rfl, rfl, rfl, ?_, ?_⟩
  · change (truncateBits .isize (BitVec.ofNat 128 n) == BitVec.ofNat 128 n) = true
    rw [s4_truncateBits_isize_of_lt_maxUsize n hn]
    exact s4_bitVec_beq_refl _
  · rw [s4_bitVec_ofNat_toNat_of_lt (Nat.lt_trans hn s4_nat_pow2_lt_pow128)]
    exact hn

private theorem s4_evalConstLit_usizeConst {n : Nat} (hn : n < maxUsize) :
    evalConstLit usizeTy (.scalar (BitVec.ofNat 128 n)) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩) := by
  dsimp [evalConstLit, usizeTy]
  rw [s4_truncateBits_isize_of_lt_maxUsize n hn]
  have hNe : (BitVec.ofNat 128 n != BitVec.ofNat 128 n) = false := by
    change (!(BitVec.ofNat 128 n == BitVec.ofNat 128 n)) = false
    rw [s4_bitVec_beq_refl]
    rfl
  rw [hNe]
  rfl

private theorem s4_decodeScalar_usize (n : Nat) (hn : n < maxUsize) :
    decodeScalar ⟨.isize, false, BitVec.ofNat 128 n⟩ = Int.ofNat n := by
  change Int.ofNat (truncateBits .isize (BitVec.ofNat 128 n)).toNat = Int.ofNat n
  rw [s4_truncateBits_isize_of_lt_maxUsize n hn,
    s4_bitVec_ofNat_toNat_of_lt (Nat.lt_trans hn s4_nat_pow2_lt_pow128)]

private theorem s4_evalBinOp_usize_bitAnd_255 (n : Nat) (hn : n < maxUsize) :
    evalBinOp .bitAnd
        (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩)
        (.scalar ⟨.isize, false, BitVec.ofNat 128 255⟩) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 (Nat.mod n 256)⟩) := by
  dsimp [evalBinOp, BinOp.isShift, IntWidth.beq, bvAnd]
  rw [s4_truncateBits_isize_of_lt_maxUsize n hn,
    s4_truncateBits_isize_of_lt_maxUsize 255 s4_255_lt_maxUsize]
  rw [s4_bitVec_ofNat_toNat_of_lt (Nat.lt_trans hn s4_nat_pow2_lt_pow128),
    s4_bitVec_ofNat_toNat_of_lt (Nat.lt_trans s4_255_lt_maxUsize s4_nat_pow2_lt_pow128)]
  have hLand : HAnd.hAnd n 255 = Nat.mod n 256 := s4_land_255_eq_mod_256 n
  rw [hLand]
  have hModLt : Nat.mod n 256 < maxUsize :=
    Nat.lt_of_lt_of_le (Nat.mod_lt n (by decide)) s4_256_le_maxUsize
  rw [s4_truncateBits_isize_of_lt_maxUsize _ hModLt]

private theorem s4_evalBinOp_usize_subUnchecked_zero_one :
    evalBinOp .subUnchecked
        (.scalar ⟨.isize, false, BitVec.ofNat 128 0⟩)
        (.scalar ⟨.isize, false, BitVec.ofNat 128 1⟩) =
      .error .undefined := rfl

private theorem s4_bitVec_ofNat_128_beq_eq {a b : Nat}
    (ha : a < Nat.pow 2 128) (hb : b < Nat.pow 2 128)
    (h : (BitVec.ofNat 128 a == BitVec.ofNat 128 b) = true) : a = b := by
  have hEq : BitVec.ofNat 128 a = BitVec.ofNat 128 b := s4_bitVec_beq_eq h
  have hNat := congrArg BitVec.toNat hEq
  rw [s4_bitVec_ofNat_toNat_of_lt ha, s4_bitVec_ofNat_toNat_of_lt hb] at hNat
  exact hNat

private theorem s4_evalSwitchBranches_singleton_zero (tNat : Nat) (ht : tNat < maxUsize)
    (other zeroBb : BasicBlockId) :
    evalSwitchBranches .isize (BitVec.ofNat 128 tNat) other [(BitVec.ofNat 128 0, zeroBb)] =
      .ok (if Nat.beq tNat 0 then zeroBb else other) := by
  dsimp [evalSwitchBranches]
  have h0 : truncateBits .isize (BitVec.ofNat 128 0) = BitVec.ofNat 128 0 :=
    s4_truncateBits_isize_of_lt_maxUsize 0 s4_maxUsize_pos
  have hT : truncateBits .isize (BitVec.ofNat 128 tNat) = BitVec.ofNat 128 tNat :=
    s4_truncateBits_isize_of_lt_maxUsize tNat ht
  rw [h0, hT]
  have hBne : (BitVec.ofNat 128 0 != BitVec.ofNat 128 0) = false := rfl
  rw [hBne]
  dsimp
  cases s4_nat_eq_or_ne tNat 0 with
  | inl hEq =>
    rw [hEq]
    rfl
  | inr hNe =>
    have hBeqF : (BitVec.ofNat 128 tNat == BitVec.ofNat 128 0) = false := by
      cases hB : BitVec.ofNat 128 tNat == BitVec.ofNat 128 0 with
      | false => rfl
      | true =>
        exact False.elim (hNe (s4_bitVec_ofNat_128_beq_eq
          (Nat.lt_trans ht s4_nat_pow2_lt_pow128)
          (Nat.lt_trans s4_maxUsize_pos s4_nat_pow2_lt_pow128) hB))
    rw [hBeqF]
    have hNatF : Nat.beq tNat 0 = false := by
      cases hB : Nat.beq tNat 0 with
      | false => rfl
      | true => exact False.elim (hNe (nat_beq_eq tNat 0 hB))
    rw [hNatF]
    rfl

private noncomputable def s4_armBranches (idxStart armStart : Nat) :
    Nat → List (BitVec 128 × BasicBlockId)
  | 0 => []
  | rem + 1 =>
    (BitVec.ofNat 128 idxStart, armStart) ::
      s4_armBranches (idxStart + 1) (armStart + 1) rem

private theorem s4_buildReadBufArms_branches (tagDst valDst tagBase valBase shiftedNextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildReadBufArms tagDst valDst tagBase valBase shiftedNextBb idx armBb rem).1 =
        s4_armBranches idx armBb rem
  | 0, _, _ => rfl
  | rem + 1, idx, armBb => by
    change
      (BitVec.ofNat 128 idx, armBb) ::
        (buildReadBufArms tagDst valDst tagBase valBase shiftedNextBb (idx + 1) (armBb + 1) rem).1 =
      (BitVec.ofNat 128 idx, armBb) :: s4_armBranches (idx + 1) (armBb + 1) rem
    rw [s4_buildReadBufArms_branches tagDst valDst tagBase valBase shiftedNextBb rem (idx + 1) (armBb + 1)]

private theorem s4_buildWriteBufArms_branches (tagScr valScr tagBase valBase shiftedNextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildWriteBufArms tagScr valScr tagBase valBase shiftedNextBb idx armBb rem).1 =
        s4_armBranches idx armBb rem
  | 0, _, _ => rfl
  | rem + 1, idx, armBb => by
    change
      (BitVec.ofNat 128 idx, armBb) ::
        (buildWriteBufArms tagScr valScr tagBase valBase shiftedNextBb (idx + 1) (armBb + 1) rem).1 =
      (BitVec.ofNat 128 idx, armBb) :: s4_armBranches (idx + 1) (armBb + 1) rem
    rw [s4_buildWriteBufArms_branches tagScr valScr tagBase valBase shiftedNextBb rem (idx + 1) (armBb + 1)]

private theorem s4_buildReadBufArms_blocks_length (tagDst valDst tagBase valBase shiftedNextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildReadBufArms tagDst valDst tagBase valBase shiftedNextBb idx armBb rem).2.length = rem
  | 0, _, _ => rfl
  | rem + 1, idx, armBb =>
    congrArg Nat.succ
      (s4_buildReadBufArms_blocks_length tagDst valDst tagBase valBase shiftedNextBb rem (idx + 1) (armBb + 1))

private theorem s4_buildWriteBufArms_blocks_length (tagScr valScr tagBase valBase shiftedNextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildWriteBufArms tagScr valScr tagBase valBase shiftedNextBb idx armBb rem).2.length = rem
  | 0, _, _ => rfl
  | rem + 1, idx, armBb =>
    congrArg Nat.succ
      (s4_buildWriteBufArms_blocks_length tagScr valScr tagBase valBase shiftedNextBb rem (idx + 1) (armBb + 1))

private theorem s4_getElem?_buildReadBufArms (tagDst valDst tagBase valBase shiftedNextBb : Nat) :
    ∀ (rem idx armBb k : Nat), k < rem →
      Trusted.MirSemantics.getElem?
        (buildReadBufArms tagDst valDst tagBase valBase shiftedNextBb idx armBb rem).2 k =
      some {
        statements := [
          mkAssignUse tagDst (.copy { localId := tagBase + (idx + k), projection := [] }),
          mkAssignUse valDst (.copy { localId := valBase + (idx + k), projection := [] })
        ]
        terminator := .baseTerm (.goto shiftedNextBb)
        cleanup := false
      }
  | 0, _, _, _, h => nomatch h
  | _ + 1, idx, armBb, 0, _ => by
    rw [Nat.add_zero]
    rfl
  | rem + 1, idx, armBb, k + 1, h => by
    have hk : k < rem := Nat.lt_of_succ_lt_succ h
    have ih := s4_getElem?_buildReadBufArms tagDst valDst tagBase valBase shiftedNextBb
      rem (idx + 1) (armBb + 1) k hk
    have hEq : idx + 1 + k = idx + (k + 1) := by
      rw [Nat.add_assoc idx 1 k, Nat.add_comm 1 k]
    rw [hEq] at ih
    exact ih

private theorem s4_getElem?_buildWriteBufArms (tagScr valScr tagBase valBase shiftedNextBb : Nat) :
    ∀ (rem idx armBb k : Nat), k < rem →
      Trusted.MirSemantics.getElem?
        (buildWriteBufArms tagScr valScr tagBase valBase shiftedNextBb idx armBb rem).2 k =
      some {
        statements := [
          mkAssignUse (tagBase + (idx + k)) (.move { localId := tagScr, projection := [] }),
          mkAssignUse (valBase + (idx + k)) (.move { localId := valScr, projection := [] })
        ]
        terminator := .baseTerm (.goto shiftedNextBb)
        cleanup := false
      }
  | 0, _, _, _, h => nomatch h
  | _ + 1, idx, armBb, 0, _ => by
    rw [Nat.add_zero]
    rfl
  | rem + 1, idx, armBb, k + 1, h => by
    have hk : k < rem := Nat.lt_of_succ_lt_succ h
    have ih := s4_getElem?_buildWriteBufArms tagScr valScr tagBase valBase shiftedNextBb
      rem (idx + 1) (armBb + 1) k hk
    have hEq : idx + 1 + k = idx + (k + 1) := by
      rw [Nat.add_assoc idx 1 k, Nat.add_comm 1 k]
    rw [hEq] at ih
    exact ih

private theorem s4_evalSwitchBranches_armBranches (trapBb : BasicBlockId) (discrIdx : Nat)
    (hDiscr : discrIdx < maxUsize) :
    ∀ (rem idxStart armStart : Nat),
      idxStart + rem ≤ maxUsize →
      evalSwitchBranches .isize (BitVec.ofNat 128 discrIdx) trapBb
          (s4_armBranches idxStart armStart rem) =
        .ok (if Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + rem) then
          armStart + (discrIdx - idxStart)
        else
          trapBb)
  | 0, idxStart, armStart, _ => by
    have hF : (Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + 0)) = false := by
      cases hBle : Nat.ble idxStart discrIdx with
      | false => rfl
      | true =>
        cases hBlt : Nat.blt discrIdx (idxStart + 0) with
        | false => rfl
        | true =>
          have h1 : idxStart ≤ discrIdx := (nat_ble_eq_le _ _).mp hBle
          have h2 : discrIdx < idxStart := by
            rw [Nat.add_zero] at hBlt
            exact (nat_blt_eq_lt _ _).mp hBlt
          exact False.elim (s4_nat_lt_irrefl discrIdx (Nat.lt_of_lt_of_le h2 h1))
    rw [hF]
    rfl
  | rem + 1, idxStart, armStart, hBound => by
    have hIdxLt : idxStart < maxUsize :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hBound
    have hNextBound : (idxStart + 1) + rem ≤ maxUsize := by
      rw [Nat.add_right_comm idxStart 1 rem]
      exact hBound
    have ih := s4_evalSwitchBranches_armBranches trapBb discrIdx hDiscr
      rem (idxStart + 1) (armStart + 1) hNextBound
    have h128Idx : idxStart < Nat.pow 2 128 := Nat.lt_trans hIdxLt s4_nat_pow2_lt_pow128
    have h128Discr : discrIdx < Nat.pow 2 128 := Nat.lt_trans hDiscr s4_nat_pow2_lt_pow128
    have hTruncIdx : truncateBits .isize (BitVec.ofNat 128 idxStart) = BitVec.ofNat 128 idxStart :=
      s4_truncateBits_isize_of_lt_maxUsize idxStart hIdxLt
    have hTruncDiscr : truncateBits .isize (BitVec.ofNat 128 discrIdx) = BitVec.ofNat 128 discrIdx :=
      s4_truncateBits_isize_of_lt_maxUsize discrIdx hDiscr
    have hBneFalse :
        (truncateBits .isize (BitVec.ofNat 128 idxStart) != BitVec.ofNat 128 idxStart) = false := by
      rw [hTruncIdx]
      change (!(BitVec.ofNat 128 idxStart == BitVec.ofNat 128 idxStart)) = false
      rw [s4_bitVec_beq_refl]
      rfl
    have hCons : s4_armBranches idxStart armStart (rem + 1) =
        (BitVec.ofNat 128 idxStart, armStart) ::
          s4_armBranches (idxStart + 1) (armStart + 1) rem := rfl
    rw [hCons]
    change (if (truncateBits .isize (BitVec.ofNat 128 idxStart) != BitVec.ofNat 128 idxStart) = true then
        .error .unsupported
      else if (truncateBits .isize (BitVec.ofNat 128 discrIdx) ==
          truncateBits .isize (BitVec.ofNat 128 idxStart)) = true then
        .ok armStart
      else
        evalSwitchBranches .isize (BitVec.ofNat 128 discrIdx) trapBb
          (s4_armBranches (idxStart + 1) (armStart + 1) rem)) = _
    rw [hBneFalse, hTruncDiscr, hTruncIdx]
    change (if (BitVec.ofNat 128 discrIdx == BitVec.ofNat 128 idxStart) = true then
        .ok armStart
      else
        evalSwitchBranches .isize (BitVec.ofNat 128 discrIdx) trapBb
          (s4_armBranches (idxStart + 1) (armStart + 1) rem)) = _
    cases s4_nat_eq_or_ne discrIdx idxStart with
    | inl hEq =>
      have hBeq : (BitVec.ofNat 128 discrIdx == BitVec.ofNat 128 idxStart) = true := by
        rw [hEq]
        exact s4_bitVec_beq_refl _
      have hCond : (Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + (rem + 1))) = true := by
        rw [hEq]
        have hBle : Nat.ble idxStart idxStart = true := (nat_ble_eq_le _ _).mpr (Nat.le_refl idxStart)
        have hBlt : Nat.blt idxStart (idxStart + (rem + 1)) = true :=
          (nat_blt_eq_lt _ _).mpr (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem))
        rw [hBle, hBlt]
        rfl
      rw [hBeq, hCond, hEq, Nat.sub_self, Nat.add_zero]
      rfl
    | inr hEq =>
      have hBeq : (BitVec.ofNat 128 discrIdx == BitVec.ofNat 128 idxStart) = false := by
        cases hB : BitVec.ofNat 128 discrIdx == BitVec.ofNat 128 idxStart with
        | false => rfl
        | true => exact False.elim (hEq (s4_bitVec_ofNat_128_beq_eq h128Discr h128Idx hB))
      rw [hBeq]
      dsimp
      rw [ih]
      have hTailCond :
          (Nat.ble (idxStart + 1) discrIdx && Nat.blt discrIdx (idxStart + 1 + rem)) =
            (Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + (rem + 1))) := by
        have hRhs : idxStart + 1 + rem = idxStart + (rem + 1) := by
          rw [Nat.add_assoc, Nat.add_comm 1 rem]
        rw [hRhs]
        cases hBle1 : Nat.ble idxStart discrIdx with
        | false =>
          have hNot : ¬ idxStart ≤ discrIdx := fun h => by
            rw [(nat_ble_eq_le _ _).mpr h] at hBle1
            cases hBle1
          have hBle2 : Nat.ble (idxStart + 1) discrIdx = false := by
            cases hB : Nat.ble (idxStart + 1) discrIdx with
            | false => rfl
            | true =>
              exact False.elim (hNot (Nat.le_trans (Nat.le_succ idxStart) ((nat_ble_eq_le _ _).mp hB)))
          rw [hBle2]
        | true =>
          have hLe : idxStart ≤ discrIdx := (nat_ble_eq_le _ _).mp hBle1
          have hLt : idxStart < discrIdx := Nat.lt_of_le_of_ne hLe (fun h => hEq h.symm)
          rw [(nat_ble_eq_le _ _).mpr hLt]
      rw [hTailCond]
      cases hIn : Nat.ble idxStart discrIdx && Nat.blt discrIdx (idxStart + (rem + 1)) with
      | false => rfl
      | true =>
        have hAnd := (bool_and_eq_true _ _).mp hIn
        have hLe : idxStart ≤ discrIdx := (nat_ble_eq_le _ _).mp hAnd.1
        have hLt : idxStart < discrIdx := Nat.lt_of_le_of_ne hLe (fun h => hEq h.symm)
        have hStepEq : armStart + 1 + (discrIdx - (idxStart + 1)) =
            armStart + (discrIdx - idxStart) := by
          have hSub : discrIdx - idxStart = 1 + (discrIdx - (idxStart + 1)) := by
            have hPlus : idxStart + (discrIdx - idxStart) = discrIdx := Nat.add_sub_of_le hLe
            have hPlus2 : idxStart + 1 + (discrIdx - (idxStart + 1)) = discrIdx :=
              Nat.add_sub_of_le hLt
            have hBoth : idxStart + (1 + (discrIdx - (idxStart + 1))) =
                idxStart + (discrIdx - idxStart) := by
              rw [← Nat.add_assoc, hPlus2, hPlus]
            exact (Nat.add_left_cancel hBoth).symm
          rw [hSub, Nat.add_assoc]
        dsimp
        rw [hStepEq]

private theorem s4_evalSwitchBranches_shift (w : IntWidth) (bv : BitVec 128) (otherwise : BasicBlockId) :
    ∀ (branches : List (BitVec 128 × BasicBlockId)),
      evalSwitchBranches w bv (otherwise + 1) (branches.map (fun br => (br.1, br.2 + 1))) =
        match evalSwitchBranches w bv otherwise branches with
        | .ok t => .ok (t + 1)
        | .error k => .error k
  | [] => rfl
  | (caseBits, tgt) :: rest => by
    dsimp [List.map, evalSwitchBranches]
    cases truncateBits w caseBits != caseBits with
    | true => rfl
    | false =>
      dsimp
      cases truncateBits w bv == truncateBits w caseBits with
      | true => rfl
      | false =>
        exact s4_evalSwitchBranches_shift w bv otherwise rest

private theorem s4_evalBoolSwitchBranches_shift (discr : Bool) (otherwise : BasicBlockId) :
    ∀ (branches : List (BitVec 128 × BasicBlockId)),
      evalBoolSwitchBranches discr (otherwise + 1) (branches.map (fun br => (br.1, br.2 + 1))) =
        match evalBoolSwitchBranches discr otherwise branches with
        | .ok t => .ok (t + 1)
        | .error k => .error k
  | [] => rfl
  | (caseBits, tgt) :: rest => by
    dsimp [List.map, evalBoolSwitchBranches]
    cases evalConstLit .bool (.scalar caseBits) with
    | error k => rfl
    | ok v =>
      cases v with
      | scalar _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => rfl
      | bool b =>
        cases b with
        | false =>
          cases discr with
          | false => rfl
          | true => exact s4_evalBoolSwitchBranches_shift true otherwise rest
        | true =>
          cases discr with
          | true => rfl
          | false => exact s4_evalBoolSwitchBranches_shift false otherwise rest

/-! ## Section 2: `List` / `Allocation` / `AllocByte` Helpers -/

private theorem s4_list_append_length {α : Type} (xs ys : List α) :
    (xs ++ ys).length = xs.length + ys.length := by
  induction xs with
  | nil => rw [List.nil_append, List.length_nil, Nat.zero_add]
  | cons a tl ih =>
    rw [List.cons_append, List.length_cons, List.length_cons, ih, Nat.add_right_comm]

private theorem s4_list_all_iff_getElem? {α : Type} (p : α → Bool) (xs : List α) :
    xs.all p = true ↔ ∀ i x, Trusted.MirSemantics.getElem? xs i = some x → p x = true := by
  constructor
  · intro h i x hi
    induction xs generalizing i with
    | nil => cases hi
    | cons a tl ih =>
      have hA := (bool_and_eq_true _ _).mp h
      cases i with
      | zero =>
        rw [← Option.some.inj hi]
        exact hA.1
      | succ k => exact ih hA.2 k hi
  · intro h
    induction xs with
    | nil => rfl
    | cons a tl ih =>
      have ha : p a = true := h 0 a rfl
      change (p a && tl.all p) = true
      rw [ha, ih (fun i y hy => h (i + 1) y hy)]
      rfl

private theorem s4_list_any_append {α : Type} (p : α → Bool) (xs ys : List α) :
    (xs ++ ys).any p = (xs.any p || ys.any p) := by
  induction xs with
  | nil => rfl
  | cons a tl ih =>
    change (p a || (tl ++ ys).any p) = ((p a || tl.any p) || ys.any p)
    rw [ih, Bool.or_assoc]

private theorem s4_list_all_append {α : Type} (p : α → Bool) (xs ys : List α) :
    (xs ++ ys).all p = (xs.all p && ys.all p) := by
  induction xs with
  | nil => rfl
  | cons a tl ih =>
    change (p a && (tl ++ ys).all p) = ((p a && tl.all p) && ys.all p)
    rw [ih, Bool.and_assoc]

private theorem s4_getElem?_lt_some {α : Type} :
    ∀ (xs : List α) (i : Nat), i < xs.length → ∃ x, Trusted.MirSemantics.getElem? xs i = some x
  | [], _, h => nomatch h
  | a :: _, 0, _ => ⟨a, rfl⟩
  | _ :: tl, i + 1, h => s4_getElem?_lt_some tl i (Nat.lt_of_succ_lt_succ h)

private theorem s4_getElem?_some_lt {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α), Trusted.MirSemantics.getElem? xs i = some x → i < xs.length
  | [], _, _, h => by cases h
  | _ :: _, 0, _, _ => Nat.zero_lt_succ _
  | _ :: tl, i + 1, x, h => Nat.succ_lt_succ (s4_getElem?_some_lt tl i x h)

private theorem s4_getElem?_ge_none {α : Type} :
    ∀ (xs : List α) (i : Nat), xs.length ≤ i → Trusted.MirSemantics.getElem? xs i = none
  | [], _, _ => rfl
  | _ :: _, 0, h => nomatch h
  | _ :: tl, i + 1, h => s4_getElem?_ge_none tl i (Nat.le_of_succ_le_succ h)

private theorem s4_getElem?_append_left {α : Type} :
    ∀ (xs ys : List α) (i : Nat), i < xs.length →
      Trusted.MirSemantics.getElem? (xs ++ ys) i = Trusted.MirSemantics.getElem? xs i
  | [], _, _, h => nomatch h
  | _ :: _, _, 0, _ => rfl
  | _ :: tl, ys, i + 1, h => s4_getElem?_append_left tl ys i (Nat.lt_of_succ_lt_succ h)

private theorem s4_getElem?_append_right {α : Type} :
    ∀ (xs ys : List α) (k : Nat),
      Trusted.MirSemantics.getElem? (xs ++ ys) (xs.length + k) =
        Trusted.MirSemantics.getElem? ys k
  | [], ys, k => by rw [List.nil_append, List.length_nil, Nat.zero_add]
  | _ :: tl, ys, k => by
    rw [List.length_cons, Nat.add_right_comm]
    exact s4_getElem?_append_right tl ys k

private theorem s4_setElem?_length {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs_out : List α),
      setElem? xs i v = some xs_out → xs_out.length = xs.length
  | [], _, _, _, h => by cases h
  | _ :: tl, 0, v, xs_out, h => by
    cases Option.some.inj h; rfl
  | a :: tl, i + 1, v, xs_out, h => by
    dsimp [setElem?] at h
    cases hS : setElem? tl i v with
    | none => rw [hS] at h; cases h
    | some tl_out =>
      rw [hS] at h
      cases Option.some.inj h
      exact congrArg Nat.succ (s4_setElem?_length tl i v tl_out hS)

private theorem s4_lt_setElem?_some {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α),
      i < xs.length → ∃ xs_out, setElem? xs i v = some xs_out
  | [], _, _, h => nomatch h
  | _ :: tl, 0, v, _ => ⟨v :: tl, rfl⟩
  | a :: tl, i + 1, v, h => by
    cases s4_lt_setElem?_some tl i v (Nat.lt_of_succ_lt_succ h) with
    | intro tl_out hS =>
      refine ⟨a :: tl_out, ?_⟩
      dsimp [setElem?]
      rw [hS]

private theorem s4_getElem?_setElem?_self {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs_out : List α),
      setElem? xs i v = some xs_out → Trusted.MirSemantics.getElem? xs_out i = some v
  | [], _, _, _, h => by cases h
  | _ :: _, 0, _, xs_out, h => by cases Option.some.inj h; rfl
  | _ :: tl, i + 1, v, xs_out, h => by
    dsimp [setElem?] at h
    cases hS : setElem? tl i v with
    | none => rw [hS] at h; cases h
    | some tl_out =>
      rw [hS] at h
      cases Option.some.inj h
      exact s4_getElem?_setElem?_self tl i v tl_out hS

private theorem s4_getElem?_setElem?_ne {α : Type} :
    ∀ (xs : List α) (i j : Nat) (v : α) (xs_out : List α),
      i ≠ j → setElem? xs i v = some xs_out →
      Trusted.MirSemantics.getElem? xs_out j = Trusted.MirSemantics.getElem? xs j
  | [], _, _, _, _, _, h => by cases h
  | _ :: _, 0, 0, _, _, hNe, _ => False.elim (hNe rfl)
  | _ :: tl, 0, _ + 1, _, xs_out, _, h => by cases Option.some.inj h; rfl
  | _ :: _, _ + 1, 0, _, xs_out, _, h => by
    dsimp [setElem?] at h
    cases hS : setElem? _ _ _ with
    | none => rw [hS] at h; cases h
    | some _ => rw [hS] at h; cases Option.some.inj h; rfl
  | _ :: tl, i + 1, j + 1, v, xs_out, hNe, h => by
    dsimp [setElem?] at h
    cases hS : setElem? tl i v with
    | none => rw [hS] at h; cases h
    | some tl_out =>
      rw [hS] at h
      cases Option.some.inj h
      exact s4_getElem?_setElem?_ne tl i j v tl_out (fun hEq => hNe (congrArg Nat.succ hEq)) hS

private theorem s4_list_length_take_of_le {α : Type} :
    ∀ (xs : List α) (n : Nat), n ≤ xs.length → (xs.take n).length = n
  | _, 0, _ => rfl
  | [], _ + 1, h => nomatch h
  | _ :: tl, n + 1, h => congrArg Nat.succ (s4_list_length_take_of_le tl n (Nat.le_of_succ_le_succ h))

private theorem s4_list_length_drop {α : Type} :
    ∀ (xs : List α) (n : Nat), (xs.drop n).length = xs.length - n
  | xs, 0 => by rw [List.drop_zero, Nat.sub_zero]
  | [], _ + 1 => (Nat.zero_sub _).symm
  | _ :: tl, n + 1 => by
    change (tl.drop n).length = tl.length + 1 - (n + 1)
    rw [s4_list_length_drop tl n, Nat.succ_sub_succ]

private theorem s4_list_getElem?_take_lt {α : Type} :
    ∀ (xs : List α) (n i : Nat), i < n →
      Trusted.MirSemantics.getElem? (xs.take n) i = Trusted.MirSemantics.getElem? xs i
  | _, 0, _, h => nomatch h
  | [], _ + 1, _, _ => rfl
  | _ :: _, _ + 1, 0, _ => rfl
  | _ :: tl, n + 1, i + 1, h => s4_list_getElem?_take_lt tl n i (Nat.lt_of_succ_lt_succ h)

private theorem s4_list_getElem?_drop {α : Type} :
    ∀ (xs : List α) (n i : Nat),
      Trusted.MirSemantics.getElem? (xs.drop n) i = Trusted.MirSemantics.getElem? xs (n + i)
  | xs, 0, i => by rw [List.drop_zero, Nat.zero_add]
  | [], _ + 1, _ => rfl
  | _ :: tl, n + 1, i => by
    rw [Nat.add_right_comm n 1 i]
    exact s4_list_getElem?_drop tl n i

private theorem s4_list_mem_append_mp {α : Type} {x : α} {xs ys : List α} :
    List.Mem x (xs ++ ys) → List.Mem x xs ∨ List.Mem x ys := by
  induction xs with
  | nil => intro h; exact Or.inr h
  | cons a tl ih =>
    intro h
    cases h with
    | head => exact Or.inl (List.Mem.head tl)
    | tail _ hTl =>
      cases ih hTl with
      | inl h1 => exact Or.inl (List.Mem.tail a h1)
      | inr h2 => exact Or.inr h2

private theorem s4_list_mem_of_mem_take {α : Type} {x : α} :
    ∀ {xs : List α} {n : Nat}, List.Mem x (xs.take n) → List.Mem x xs
  | _, 0, h => by cases h
  | [], _ + 1, h => by cases h
  | a :: tl, n + 1, h => by
    cases h with
    | head => exact List.Mem.head tl
    | tail _ hTl => exact List.Mem.tail a (s4_list_mem_of_mem_take hTl)

private theorem s4_list_mem_of_mem_drop {α : Type} {x : α} :
    ∀ {xs : List α} {n : Nat}, List.Mem x (xs.drop n) → List.Mem x xs
  | _, 0, h => h
  | [], _ + 1, h => by cases h
  | a :: tl, n + 1, h => List.Mem.tail a (s4_list_mem_of_mem_drop h)

private theorem s4_list_append_nil {α : Type} (xs : List α) : xs ++ [] = xs := by
  induction xs with
  | nil => rfl
  | cons a tl ih =>
    change a :: (tl ++ []) = a :: tl
    rw [ih]

private theorem s4_list_length_replicate {α : Type} (n : Nat) (x : α) :
    (listReplicate n x).length = n := by
  induction n with
  | zero => rfl
  | succ k ih =>
    change (listReplicate k x).length + 1 = k + 1
    rw [ih]

private theorem s4_getElem?_replicate {α : Type} :
    ∀ (n i : Nat) (x : α), i < n →
      Trusted.MirSemantics.getElem? (listReplicate n x) i = some x
  | 0, _, _, h => nomatch h
  | _ + 1, 0, _, _ => rfl
  | n + 1, i + 1, x, h => s4_getElem?_replicate n i x (Nat.lt_of_succ_lt_succ h)

private theorem s4_getElem?_take_succ {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α),
      Trusted.MirSemantics.getElem? xs i = some x →
      xs.take (i + 1) = xs.take i ++ [x]
  | [], _, _, h => by cases h
  | _ :: _, 0, x, h => by rw [Option.some.inj h]; rfl
  | _ :: tl, i + 1, x, h => by
    have ih := s4_getElem?_take_succ tl i x h
    change _ :: tl.take (i + 1) = (_ :: tl.take i) ++ [x]
    rw [ih]
    rfl

private theorem s4_listFlatMap_cons {α β : Type} (f : α → List β) (x : α) (xs : List α) :
    listFlatMap f (x :: xs) = f x ++ listFlatMap f xs := rfl

private theorem s4_listFlatMap_singleton {α β : Type} (f : α → List β) (x : α) :
    listFlatMap f [x] = f x := by
  rw [s4_listFlatMap_cons]
  exact s4_list_append_nil _

private theorem s4_listFlatMap_take_split {α β : Type} (f : α → List β) {xs : List α}
    {i : Nat} {x : α} (h : Trusted.MirSemantics.getElem? xs i = some x) :
    listFlatMap f (xs.take (i + 1)) = listFlatMap f (xs.take i) ++ f x := by
  rw [s4_getElem?_take_succ xs i x h, listFlatMap_append, s4_listFlatMap_singleton]

private theorem s4_list_take_all {α : Type} : ∀ (xs : List α), xs.take xs.length = xs
  | [] => rfl
  | a :: tl => congrArg (List.cons a) (s4_list_take_all tl)

private theorem s4_list_take_drop_eq {α : Type} (xs : List α) (n : Nat) :
    xs.take n ++ xs.drop n = xs := by
  induction xs generalizing n with
  | nil => cases n <;> rfl
  | cons a tl ih =>
    cases n with
    | zero => rfl
    | succ k =>
      change a :: (tl.take k ++ tl.drop k) = a :: tl
      rw [ih k]

private theorem s4_listFlatMap_split_at {α β : Type} (f : α → List β)
    {xs : List α} {i : Nat} {x : α}
    (h : Trusted.MirSemantics.getElem? xs i = some x) :
    listFlatMap f xs =
      (listFlatMap f (xs.take i) ++ f x) ++ listFlatMap f (xs.drop (i + 1)) := by
  have hSplit : xs = (xs.take i ++ [x]) ++ xs.drop (i + 1) := by
    rw [← s4_getElem?_take_succ xs i x h, s4_list_take_drop_eq]
  have hM := congrArg (listFlatMap f) hSplit
  rw [listFlatMap_append, listFlatMap_append, s4_listFlatMap_singleton] at hM
  exact hM

private theorem s4_getElem?_append_middle_add {α : Type} (xs ys zs : List α) (k : Nat)
    (hk : k < ys.length) :
    Trusted.MirSemantics.getElem? (xs ++ ys ++ zs) (xs.length + k) =
      Trusted.MirSemantics.getElem? ys k := by
  rw [List.append_assoc, s4_getElem?_append_right xs (ys ++ zs) k,
    s4_getElem?_append_left ys zs k hk]

private theorem s4_spliceBytes_length :
    ∀ (oldBytes : List AllocByte) (off : Nat) (newBytes : List AllocByte),
      off + newBytes.length ≤ oldBytes.length →
      (spliceBytes oldBytes off newBytes).length = oldBytes.length := by
  intro oldBytes off newBytes hLe
  dsimp [spliceBytes]
  rw [s4_list_append_length, s4_list_append_length]
  have hTake : (oldBytes.take off).length = off := by
    have hOffLe : off ≤ oldBytes.length := Nat.le_trans (Nat.le_add_right off newBytes.length) hLe
    exact s4_list_length_take_of_le oldBytes off hOffLe
  have hDrop : (oldBytes.drop (off + newBytes.length)).length =
      oldBytes.length - (off + newBytes.length) :=
    s4_list_length_drop oldBytes (off + newBytes.length)
  rw [hTake, hDrop]
  exact Nat.add_sub_of_le hLe

private theorem s4_getElem?_spliceBytes_eq (oldBytes : List AllocByte) (off : Nat) (ab : AllocByte)
    (hOff : off < oldBytes.length) :
    Trusted.MirSemantics.getElem? (spliceBytes oldBytes off [ab]) off = some ab := by
  dsimp [spliceBytes]
  have hTakeLen : (oldBytes.take off).length = off :=
    s4_list_length_take_of_le oldBytes off (Nat.le_of_lt hOff)
  have h := s4_getElem?_append_right (oldBytes.take off) ([ab] ++ oldBytes.drop (off + 1)) 0
  rw [hTakeLen] at h
  have h0 : off + 0 = off := Nat.add_zero off
  rw [h0] at h
  rw [List.append_assoc, h]
  rfl

private theorem s4_getElem?_spliceBytes_ne (oldBytes : List AllocByte) (off j : Nat) (ab : AllocByte)
    (hOff : off < oldBytes.length) (hNe : j ≠ off) :
    Trusted.MirSemantics.getElem? (spliceBytes oldBytes off [ab]) j =
      Trusted.MirSemantics.getElem? oldBytes j := by
  dsimp [spliceBytes]
  cases Nat.lt_or_ge j off with
  | inl hLt =>
    have hTakeLen : (oldBytes.take off).length = off :=
      s4_list_length_take_of_le oldBytes off (Nat.le_of_lt hOff)
    have hjTake : j < (oldBytes.take off).length := by rw [hTakeLen]; exact hLt
    rw [List.append_assoc, s4_getElem?_append_left (oldBytes.take off) _ j hjTake]
    exact s4_list_getElem?_take_lt oldBytes off j hLt
  | inr hGe =>
    have hGt : off < j := Nat.lt_of_le_of_ne hGe hNe.symm
    have hTakeLen : (oldBytes.take off).length = off :=
      s4_list_length_take_of_le oldBytes off (Nat.le_of_lt hOff)
    let d := j - off
    have hdPos : 0 < d := Nat.sub_pos_of_lt hGt
    have hdDecomp : d = (d - 1) + 1 := (Nat.sub_add_cancel hdPos).symm
    have hjEq : j = off + d := (Nat.add_sub_of_le hGe).symm
    have hApp := s4_getElem?_append_right (oldBytes.take off) ([ab] ++ oldBytes.drop (off + 1)) d
    rw [hTakeLen, ← hjEq] at hApp
    rw [List.append_assoc, hApp]
    rw [hdDecomp]
    change Trusted.MirSemantics.getElem? (ab :: oldBytes.drop (off + 1)) (d - 1 + 1) = _
    change Trusted.MirSemantics.getElem? (oldBytes.drop (off + 1)) (d - 1) = _
    rw [s4_list_getElem?_drop]
    have hSum : off + 1 + (d - 1) = off + d := by
      rw [Nat.add_assoc, Nat.add_comm 1 (d - 1), ← hdDecomp]
    rw [hSum, ← hjEq]

private theorem s4_findAlloc?_filter_ne (bufAid aid : AllocId) (hNe : aid ≠ bufAid) :
    ∀ (xs : List Allocation),
      findAlloc? aid (xs.filter (fun a => !Nat.beq a.allocId bufAid)) = findAlloc? aid xs
  | [] => rfl
  | a :: rest => by
    dsimp [List.filter, findAlloc?]
    cases hEqAid : Nat.beq a.allocId aid with
    | true =>
      have haAid : a.allocId = aid := nat_beq_eq _ _ hEqAid
      have hNeBuf : a.allocId ≠ bufAid := by rw [haAid]; exact hNe
      have hB : (!Nat.beq a.allocId bufAid) = true := by
        rw [s4_nat_beq_false hNeBuf]; rfl
      rw [hB]
      dsimp [findAlloc?]
      rw [hEqAid]
      rfl
    | false =>
      cases (!Nat.beq a.allocId bufAid) with
      | false =>
        dsimp
        exact s4_findAlloc?_filter_ne bufAid aid hNe rest
      | true =>
        dsimp [findAlloc?]
        rw [hEqAid]
        exact s4_findAlloc?_filter_ne bufAid aid hNe rest

private theorem s4_updateAlloc?_filter_ne (bufAid aid : AllocId) (newAlloc : Allocation)
    (hNe : aid ≠ bufAid) (hNew : newAlloc.allocId = aid) :
    ∀ (xs : List Allocation),
      Option.map (List.filter (fun a => !Nat.beq a.allocId bufAid))
          (updateAlloc? aid newAlloc xs) =
        updateAlloc? aid newAlloc (xs.filter (fun a => !Nat.beq a.allocId bufAid))
  | [] => rfl
  | a :: rest => by
    dsimp [List.filter, updateAlloc?]
    cases hEqAid : Nat.beq a.allocId aid with
    | true =>
      have haAid : a.allocId = aid := nat_beq_eq _ _ hEqAid
      have hNeBuf : a.allocId ≠ bufAid := by rw [haAid]; exact hNe
      have hB : (!Nat.beq a.allocId bufAid) = true := by rw [s4_nat_beq_false hNeBuf]; rfl
      have hNewB : (!Nat.beq newAlloc.allocId bufAid) = true := by
        rw [hNew, s4_nat_beq_false hNe]; rfl
      rw [hB]
      dsimp [updateAlloc?]
      rw [hEqAid]
      dsimp [Option.map, List.filter]
      rw [hNewB]
    | false =>
      cases hKeep : (!Nat.beq a.allocId bufAid) with
      | false =>
        have ih := s4_updateAlloc?_filter_ne bufAid aid newAlloc hNe hNew rest
        cases hUp : updateAlloc? aid newAlloc rest with
        | none =>
          rw [hUp] at ih
          dsimp at ih
          dsimp
          exact ih
        | some rest' =>
          rw [hUp] at ih
          dsimp [Option.map, List.filter] at ih
          dsimp [Option.map, List.filter]
          rw [hKeep]
          exact ih
      | true =>
        dsimp [updateAlloc?]
        rw [hEqAid]
        have ih := s4_updateAlloc?_filter_ne bufAid aid newAlloc hNe hNew rest
        cases hUp : updateAlloc? aid newAlloc rest with
        | none =>
          rw [hUp] at ih
          dsimp [Option.map] at ih
          dsimp [Option.map]
          rw [← ih]
        | some rest' =>
          rw [hUp] at ih
          dsimp [Option.map] at ih
          dsimp [Option.map]
          rw [← ih]
          dsimp [Option.map, List.filter]
          rw [hKeep]

private theorem s4_updateAlloc?_filter_eq (bufAid : AllocId) (newAlloc : Allocation)
    (hNew : newAlloc.allocId = bufAid) :
    ∀ (xs xs' : List Allocation),
      updateAlloc? bufAid newAlloc xs = some xs' →
      xs'.filter (fun a => !Nat.beq a.allocId bufAid) =
        xs.filter (fun a => !Nat.beq a.allocId bufAid)
  | [], _, h => by cases h
  | a :: rest, xs', h => by
    dsimp [updateAlloc?] at h
    cases hEq : Nat.beq a.allocId bufAid with
    | true =>
      rw [hEq] at h
      cases Option.some.inj h
      dsimp [List.filter]
      rw [hEq, hNew, nat_beq_refl]
      rfl
    | false =>
      rw [hEq] at h
      cases hUp : updateAlloc? bufAid newAlloc rest with
      | none => rw [hUp] at h; cases h
      | some rest' =>
        rw [hUp] at h
        cases Option.some.inj h
        dsimp [List.filter]
        have hKeep : (!Nat.beq a.allocId bufAid) = true := by rw [hEq]; rfl
        rw [hKeep]
        dsimp
        exact congrArg (List.cons a) (s4_updateAlloc?_filter_eq bufAid newAlloc hNew rest rest' hUp)

private theorem s4_findAlloc?_updateAlloc?_self (aid : AllocId) (newAlloc : Allocation)
    (hNew : newAlloc.allocId = aid) :
    ∀ (xs xs' : List Allocation),
      updateAlloc? aid newAlloc xs = some xs' →
      findAlloc? aid xs' = some newAlloc
  | [], _, h => by cases h
  | a :: rest, xs', h => by
    dsimp [updateAlloc?] at h
    cases hEq : Nat.beq a.allocId aid with
    | true =>
      rw [hEq] at h
      cases Option.some.inj h
      dsimp [findAlloc?]
      rw [s4_nat_beq_true hNew]
      rfl
    | false =>
      rw [hEq] at h
      cases hUp : updateAlloc? aid newAlloc rest with
      | none => rw [hUp] at h; cases h
      | some rest' =>
        rw [hUp] at h
        cases Option.some.inj h
        dsimp [findAlloc?]
        rw [hEq]
        exact s4_findAlloc?_updateAlloc?_self aid newAlloc hNew rest rest' hUp

private theorem s4_encodeAllocByte_decodeAllocByte (tNat vNat : Nat) :
    encodeAllocByte (decodeAllocByte tNat vNat) =
      (tNat, if Nat.beq tNat 0 then 0 else Nat.mod vNat 256) := by
  dsimp [decodeAllocByte]
  cases h0 : Nat.beq tNat 0 with
  | true =>
    have ht0 := nat_beq_eq tNat 0 h0
    rw [ht0]
    rfl
  | false =>
    cases h1 : Nat.beq tNat 1 with
    | true =>
      have ht1 := nat_beq_eq tNat 1 h1
      dsimp [encodeAllocByte]
      have hMod : (UInt8.ofNat (Nat.mod vNat 256)).toNat = Nat.mod vNat 256 := by
        have hLt : Nat.mod vNat 256 < 256 := Nat.mod_lt vNat (by decide)
        change (BitVec.ofNat 8 (Nat.mod vNat 256)).toNat = Nat.mod vNat 256
        exact s4_bitVec_ofNat_toNat_of_lt hLt
      rw [hMod, ht1]
    | false =>
      have htNe0 : tNat ≠ 0 := nat_beq_false_ne h0
      have htNe1 : tNat ≠ 1 := nat_beq_false_ne h1
      have htGe2 : 2 ≤ tNat := by
        cases tNat with
        | zero => exact False.elim (htNe0 rfl)
        | succ k =>
          cases k with
          | zero => exact False.elim (htNe1 rfl)
          | succ m => exact Nat.le_add_left 2 m
      dsimp [encodeAllocByte]
      have hMod : (UInt8.ofNat (Nat.mod vNat 256)).toNat = Nat.mod vNat 256 := by
        have hLt : Nat.mod vNat 256 < 256 := Nat.mod_lt vNat (by decide)
        change (BitVec.ofNat 8 (Nat.mod vNat 256)).toNat = Nat.mod vNat 256
        exact s4_bitVec_ofNat_toNat_of_lt hLt
      rw [hMod, Nat.add_sub_of_le htGe2]

private theorem s4_encodeAllocByte_vNat_lt_256 (ab : AllocByte) : (encodeAllocByte ab).2 < 256 := by
  cases ab with
  | uninit => exact by decide
  | init b prov =>
    cases prov with
    | none => exact b.toBitVec.isLt
    | some _ => exact b.toBitVec.isLt

private theorem s4_encodeAllocByte_uninit_wf :
    Nat.blt (encodeAllocByte .uninit).1 maxUsize = true :=
  (nat_blt_eq_lt _ _).mpr s4_maxUsize_pos

private theorem s4_all_replicate_uninit_wf (size : Nat) :
    (listReplicate size AllocByte.uninit).all
      (fun ab => Nat.blt (encodeAllocByte ab).1 maxUsize) = true := by
  induction size with
  | zero => rfl
  | succ k ih =>
    change (Nat.blt (encodeAllocByte .uninit).1 maxUsize &&
      (listReplicate k AllocByte.uninit).all
        (fun ab => Nat.blt (encodeAllocByte ab).1 maxUsize)) = true
    rw [s4_encodeAllocByte_uninit_wf, ih]
    rfl

private theorem s4_all_spliceBytes_wf (oldBytes : List AllocByte) (off : Nat) (ab : AllocByte)
    (hOld : oldBytes.all (fun x => Nat.blt (encodeAllocByte x).1 maxUsize) = true)
    (hAb : (encodeAllocByte ab).1 < maxUsize) :
    (spliceBytes oldBytes off [ab]).all
      (fun x => Nat.blt (encodeAllocByte x).1 maxUsize) = true := by
  rw [list_all_eq_true]
  intro x hx
  dsimp [spliceBytes] at hx
  rw [List.append_assoc] at hx
  cases s4_list_mem_append_mp hx with
  | inl hTake =>
    exact (list_all_eq_true _ oldBytes).mp hOld x (s4_list_mem_of_mem_take hTake)
  | inr hRight =>
    cases hRight with
    | head => exact (nat_blt_eq_lt _ _).mpr hAb
    | tail _ hDrop =>
      exact (list_all_eq_true _ oldBytes).mp hOld x (s4_list_mem_of_mem_drop hDrop)

/-! ## Section 3: `s4_BufScalarizePack` & Structural `applyBufScalarize` Lemmas -/

private structure s4_BufScalarizePack (plan : BufScalarizePlan)
    (pSrc pTgt : MemCopyProgram) : Type where
  bodySrc : MemCopyBody
  size : Nat
  alignLog2 : Nat
  mutability : Mutability
  localsTombstoned : List MemCopyLocalDecl
  bodyTgt : MemCopyBody
  bodiesTgt : List MemCopyBody
  hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId = some bodySrc
  hAcceptsFalse : bodySrc.acceptsCallerMem = false
  hNonEmpty : bodySrc.basicBlocks.isEmpty = false
  hArgLtBuf : bodySrc.argumentCount < plan.bufLocal
  hBufLtLoc : plan.bufLocal < bodySrc.locals.length
  hStorage : memCopyStorageAnnotationsInBounds bodySrc = true
  hLocInBounds : memCopyBodyLocalsInBounds bodySrc = true
  hTgtInBounds : memCopyBodyTargetsInBounds bodySrc = true
  hNoPtrs : bodySrc.locals.any (fun d => match d with | .ptrLocal => true | _ => false) = false
  hBufDecl : Trusted.MirSemantics.getElem? bodySrc.locals plan.bufLocal =
    some (.byteBuf size alignLog2 mutability)
  hSizeLe : size ≤ 32
  hAlignLe : alignLog2 ≤ 30
  hChecks : bodySrc.basicBlocks.all (fun bb =>
    bb.statements.all (checkStmtForBuf bodySrc.locals plan.bufLocal) &&
      checkTermForBuf bodySrc.locals plan.bufLocal bb.terminator) = true
  hTomb : setElem? bodySrc.locals plan.bufLocal (.base .unit) = some localsTombstoned
  hBodyTgt : bodyTgt = {
    bodySrc with
    locals := localsTombstoned ++ [.base .unit] ++
      listReplicate (2 * size) (.base usizeTy) ++ listReplicate 4 (.base usizeTy)
    basicBlocks :=
      let base := bodySrc.locals.length
      let hasAnnot := memCopyHasStorageAnnotation bodySrc plan.bufLocal
      let entryPrologue : MemCopyBlock := {
        statements := if hasAnnot then [] else mkZeroUsizeRange (base + 1) (2 * size)
        terminator := .baseTerm (.goto 1)
        cleanup := false
      }
      let lowered :=
        lowerBlocksForBufLoop plan.bufLocal base size mutability
          (1 + bodySrc.basicBlocks.length) bodySrc.basicBlocks
      entryPrologue :: (lowered.1 ++ lowered.2)
  }
  hBodiesTgt : setElem? pSrc.bodies plan.defId bodyTgt = some bodiesTgt
  hPTgt : pTgt = { pSrc with bodies := bodiesTgt }

private noncomputable def s4_applyBufScalarize_unpack (plan : BufScalarizePlan)
    (pSrc pTgt : MemCopyProgram) (hApp : applyBufScalarize plan pSrc = some pTgt) :
    s4_BufScalarizePack plan pSrc pTgt := by
  unfold applyBufScalarize at hApp
  cases hB : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => rw [hB] at hApp; cases hApp
  | some body =>
    rw [hB] at hApp
    dsimp at hApp
    cases hAcc : body.acceptsCallerMem with
    | true => rw [hAcc] at hApp; cases hApp
    | false =>
      cases hEmpty : body.basicBlocks.isEmpty with
      | true => rw [hAcc, hEmpty] at hApp; cases hApp
      | false =>
        cases hArg : Nat.blt body.argumentCount plan.bufLocal with
        | false => rw [hAcc, hEmpty, hArg] at hApp; cases hApp
        | true =>
          cases hBuf : Nat.blt plan.bufLocal body.locals.length with
          | false => rw [hAcc, hEmpty, hArg, hBuf] at hApp; cases hApp
          | true =>
            cases hSt : memCopyStorageAnnotationsInBounds body with
            | false => rw [hAcc, hEmpty, hArg, hBuf, hSt] at hApp; cases hApp
            | true =>
              cases hLIB : memCopyBodyLocalsInBounds body with
              | false => rw [hAcc, hEmpty, hArg, hBuf, hSt, hLIB] at hApp; cases hApp
              | true =>
                cases hTIB : memCopyBodyTargetsInBounds body with
                | false => rw [hAcc, hEmpty, hArg, hBuf, hSt, hLIB, hTIB] at hApp; cases hApp
                | true =>
                  rw [hAcc, hEmpty, hArg, hBuf, hSt, hLIB, hTIB] at hApp
                  dsimp at hApp
                  let hasPtr := body.locals.any (fun d => match d with | .ptrLocal => true | _ => false)
                  change (if hasPtr = true then none else _) = some pTgt at hApp
                  cases hNoP : hasPtr with
                  | true => rw [hNoP] at hApp; cases hApp
                  | false =>
                    rw [hNoP] at hApp
                    dsimp at hApp
                    cases hDecl : Trusted.MirSemantics.getElem? body.locals plan.bufLocal with
                    | none => rw [hDecl] at hApp; cases hApp
                    | some decl =>
                      rw [hDecl] at hApp
                      cases decl with
                      | base _ | ptrLocal => cases hApp
                      | byteBuf size alignLog2 mutability =>
                        dsimp at hApp
                        cases hSz : Nat.ble size 32 with
                        | false => rw [hSz] at hApp; cases hApp
                        | true =>
                          cases hAl : Nat.ble alignLog2 30 with
                          | false => rw [hSz, hAl] at hApp; cases hApp
                          | true =>
                            rw [hSz, hAl] at hApp
                            dsimp at hApp
                            cases hChk : body.basicBlocks.all (fun bb =>
                                bb.statements.all (checkStmtForBuf body.locals plan.bufLocal) &&
                                  checkTermForBuf body.locals plan.bufLocal bb.terminator) with
                            | false => rw [hChk] at hApp; cases hApp
                            | true =>
                              rw [hChk] at hApp
                              cases hTomb : setElem? body.locals plan.bufLocal (.base .unit) with
                              | none => rw [hTomb] at hApp; cases hApp
                              | some localsTomb =>
                                rw [hTomb] at hApp
                                dsimp at hApp
                                let base := body.locals.length
                                let hasAnnot := memCopyHasStorageAnnotation body plan.bufLocal
                                let entryPrologue : MemCopyBlock := {
                                  statements := if hasAnnot then [] else mkZeroUsizeRange (base + 1) (2 * size)
                                  terminator := .baseTerm (.goto 1)
                                  cleanup := false
                                }
                                let lowered :=
                                  lowerBlocksForBufLoop plan.bufLocal base size mutability
                                    (1 + body.basicBlocks.length) body.basicBlocks
                                let bodyTgt : MemCopyBody := {
                                  body with
                                  acceptsCallerMem := false
                                  locals := localsTomb ++ [.base .unit] ++
                                    listReplicate (2 * size) (.base usizeTy) ++ listReplicate 4 (.base usizeTy)
                                  basicBlocks := entryPrologue :: (lowered.1 ++ lowered.2)
                                }
                                change (match setElem? pSrc.bodies plan.defId bodyTgt with
                                  | none => none
                                  | some bodiesTgt =>
                                    some { pSrc with bodies := bodiesTgt }) = some pTgt at hApp
                                cases hBds : setElem? pSrc.bodies plan.defId bodyTgt with
                                | none => rw [hBds] at hApp; cases hApp
                                | some bodiesTgt =>
                                  rw [hBds] at hApp
                                  have hEqP := Option.some.inj hApp
                                  exact {
                                    bodySrc := body
                                    size := size
                                    alignLog2 := alignLog2
                                    mutability := mutability
                                    localsTombstoned := localsTomb
                                    bodyTgt := bodyTgt
                                    bodiesTgt := bodiesTgt
                                    hBodySrc := hB
                                    hAcceptsFalse := hAcc
                                    hNonEmpty := hEmpty
                                    hArgLtBuf := (nat_blt_eq_lt _ _).mp hArg
                                    hBufLtLoc := (nat_blt_eq_lt _ _).mp hBuf
                                    hStorage := hSt
                                    hLocInBounds := hLIB
                                    hTgtInBounds := hTIB
                                    hNoPtrs := hNoP
                                    hBufDecl := hDecl
                                    hSizeLe := (nat_ble_eq_le _ _).mp hSz
                                    hAlignLe := (nat_ble_eq_le _ _).mp hAl
                                    hChecks := hChk
                                    hTomb := hTomb
                                    hBodyTgt := by rw [hAcc]
                                    hBodiesTgt := hBds
                                    hPTgt := hEqP.symm
                                  }

private theorem s4_getElem?_pTgt_bodies_eq {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pTgt.bodies plan.defId = some pack.bodyTgt := by
  have hBodies := congrArg MemCopyProgram.bodies pack.hPTgt
  rw [hBodies]
  exact s4_getElem?_setElem?_self pSrc.bodies plan.defId pack.bodyTgt pack.bodiesTgt pack.hBodiesTgt

private theorem s4_getElem?_pTgt_bodies_ne {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {id : DefId} (hNe : id ≠ plan.defId) :
    Trusted.MirSemantics.getElem? pTgt.bodies id =
      Trusted.MirSemantics.getElem? pSrc.bodies id := by
  have hBodies := congrArg MemCopyProgram.bodies pack.hPTgt
  rw [hBodies]
  exact s4_getElem?_setElem?_ne pSrc.bodies plan.defId id pack.bodyTgt pack.bodiesTgt hNe.symm pack.hBodiesTgt

private theorem s4_pTgt_entryDefId {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pTgt.entryDefId = pSrc.entryDefId := by rw [pack.hPTgt]

private theorem s4_pTgt_pointerWidthBits {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pTgt.pointerWidthBits = pSrc.pointerWidthBits := by rw [pack.hPTgt]

private theorem s4_pTgt_mirProfileVersion {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pTgt.mirProfileVersion = pSrc.mirProfileVersion := by rw [pack.hPTgt]

private theorem s4_bodyTgt_argumentCount {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pack.bodyTgt.argumentCount = pack.bodySrc.argumentCount := by
  rw [pack.hBodyTgt]

private theorem s4_bodyTgt_acceptsCallerMem {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pack.bodyTgt.acceptsCallerMem = false := by
  rw [pack.hBodyTgt]
  exact pack.hAcceptsFalse

private theorem s4_bodyTgt_isEmpty_false {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pack.bodyTgt.basicBlocks.isEmpty = false := by
  rw [pack.hBodyTgt]
  rfl

private theorem s4_localsTombstoned_length {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pack.localsTombstoned.length = pack.bodySrc.locals.length :=
  s4_setElem?_length pack.bodySrc.locals plan.bufLocal (.base .unit) pack.localsTombstoned pack.hTomb

private theorem s4_bodyTgt_locals_length {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    pack.bodyTgt.locals.length =
      pack.bodySrc.locals.length + 1 + 2 * pack.size + 4 := by
  have hLocs := congrArg MemCopyBody.locals pack.hBodyTgt
  rw [hLocs, s4_list_append_length, s4_list_append_length, s4_list_append_length,
    s4_localsTombstoned_length pack, s4_list_length_replicate, s4_list_length_replicate]
  rfl

private theorem s4_getElem?_bodyTgt_locals_lt {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {i : Nat} (hLt : i < pack.bodySrc.locals.length) (hNe : i ≠ plan.bufLocal) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals i =
      Trusted.MirSemantics.getElem? pack.bodySrc.locals i := by
  have hLocs := congrArg MemCopyBody.locals pack.hBodyTgt
  rw [hLocs, List.append_assoc, List.append_assoc]
  have hLtTomb : i < pack.localsTombstoned.length := by
    rw [s4_localsTombstoned_length pack]; exact hLt
  rw [s4_getElem?_append_left pack.localsTombstoned _ i hLtTomb]
  exact s4_getElem?_setElem?_ne pack.bodySrc.locals plan.bufLocal i (.base .unit)
    pack.localsTombstoned hNe.symm pack.hTomb

private theorem s4_getElem?_bodyTgt_locals_bufLocal {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals plan.bufLocal = some (.base .unit) := by
  have hLocs := congrArg MemCopyBody.locals pack.hBodyTgt
  rw [hLocs, List.append_assoc, List.append_assoc]
  have hLtTomb : plan.bufLocal < pack.localsTombstoned.length := by
    rw [s4_localsTombstoned_length pack]; exact pack.hBufLtLoc
  rw [s4_getElem?_append_left pack.localsTombstoned _ plan.bufLocal hLtTomb]
  exact s4_getElem?_setElem?_self pack.bodySrc.locals plan.bufLocal (.base .unit)
    pack.localsTombstoned pack.hTomb

private theorem s4_getElem?_bodyTgt_locals_liveLoc {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals pack.bodySrc.locals.length =
      some (.base .unit) := by
  have hLocs := congrArg MemCopyBody.locals pack.hBodyTgt
  rw [hLocs, List.append_assoc, List.append_assoc]
  have hL := s4_getElem?_append_right pack.localsTombstoned
    ([MemCopyLocalDecl.base .unit] ++
      (listReplicate (2 * pack.size) (.base usizeTy) ++ listReplicate 4 (.base usizeTy))) 0
  rw [Nat.add_zero, s4_localsTombstoned_length pack] at hL
  exact hL

private theorem s4_getElem?_bodyTgt_locals_byte {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {k : Nat} (hk : k < 2 * pack.size) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals (pack.bodySrc.locals.length + 1 + k) =
      some (.base usizeTy) := by
  have hLocs := congrArg MemCopyBody.locals pack.hBodyTgt
  rw [hLocs, List.append_assoc]
  have hLen1 : (pack.localsTombstoned ++ [MemCopyLocalDecl.base .unit]).length =
      pack.bodySrc.locals.length + 1 := by
    rw [s4_list_append_length, s4_localsTombstoned_length pack]; rfl
  have hApp := s4_getElem?_append_right (pack.localsTombstoned ++ [MemCopyLocalDecl.base .unit])
    (listReplicate (2 * pack.size) (MemCopyLocalDecl.base usizeTy) ++
      listReplicate 4 (MemCopyLocalDecl.base usizeTy)) k
  rw [hLen1] at hApp
  rw [hApp]
  rw [s4_getElem?_append_left (listReplicate (2 * pack.size) (MemCopyLocalDecl.base usizeTy)) _ k
    (by rw [s4_list_length_replicate]; exact hk)]
  exact s4_getElem?_replicate (2 * pack.size) k (MemCopyLocalDecl.base usizeTy) hk

private theorem s4_getElem?_bodyTgt_locals_scr {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {r : Nat} (hr : r < 4) :
    Trusted.MirSemantics.getElem? pack.bodyTgt.locals
        (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) =
      some (.base usizeTy) := by
  have hLocs := congrArg MemCopyBody.locals pack.hBodyTgt
  rw [hLocs]
  have hPref : (pack.localsTombstoned ++ [MemCopyLocalDecl.base .unit] ++
      listReplicate (2 * pack.size) (MemCopyLocalDecl.base usizeTy)).length =
      pack.bodySrc.locals.length + 1 + 2 * pack.size := by
    rw [s4_list_append_length, s4_list_append_length, s4_localsTombstoned_length pack,
      s4_list_length_replicate]; rfl
  have hApp := s4_getElem?_append_right
    (pack.localsTombstoned ++ [MemCopyLocalDecl.base .unit] ++
      listReplicate (2 * pack.size) (MemCopyLocalDecl.base usizeTy))
    (listReplicate 4 (MemCopyLocalDecl.base usizeTy)) r
  rw [hPref] at hApp
  rw [hApp]
  exact s4_getElem?_replicate 4 r (MemCopyLocalDecl.base usizeTy) hr

private theorem s4_noPtrs_bodySrc {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {i : Nat} {d : MemCopyLocalDecl}
    (hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals i = some d) :
    d ≠ .ptrLocal := by
  intro hEq
  have hMem : List.Mem d pack.bodySrc.locals := by
    have hD : ∀ (xs : List MemCopyLocalDecl) (k : Nat),
        Trusted.MirSemantics.getElem? xs k = some d → List.Mem d xs := by
      intro xs k hk
      induction xs generalizing k with
      | nil => cases hk
      | cons a tl ih =>
        cases k with
        | zero => rw [Option.some.inj hk]; exact List.Mem.head tl
        | succ m => exact List.Mem.tail a (ih m hk)
    exact hD pack.bodySrc.locals i hDecl
  have hF := (list_any_eq_true (fun d => match d with | .ptrLocal => true | _ => false)
    pack.bodySrc.locals).mpr ⟨d, hMem, by rw [hEq]⟩
  rw [pack.hNoPtrs] at hF
  cases hF

private theorem s4_bodySrc_block_checks {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bb : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb) :
    bb.statements.all (checkStmtForBuf pack.bodySrc.locals plan.bufLocal) = true ∧
    checkTermForBuf pack.bodySrc.locals plan.bufLocal bb.terminator = true := by
  have hAll := (s4_list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hChecks bbIdx bb hBb
  exact (bool_and_eq_true _ _).mp hAll

private theorem s4_bodySrc_stmt_check {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbIdx sIdx : Nat} {bb : MemCopyBlock} {stmt : MemCopyStmt}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements sIdx = some stmt) :
    checkStmtForBuf pack.bodySrc.locals plan.bufLocal stmt = true :=
  (s4_list_all_iff_getElem? _ bb.statements).mp (s4_bodySrc_block_checks pack hBb).1 sIdx stmt hStmt

private theorem s4_bodySrc_stmt_localsInBounds {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbIdx sIdx : Nat} {bb : MemCopyBlock} {stmt : MemCopyStmt}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements sIdx = some stmt) :
    memCopyStmtLocalsInBounds pack.bodySrc.locals.length stmt = true := by
  have hAll := (s4_list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hLocInBounds bbIdx bb hBb
  have hStmts := ((bool_and_eq_true _ _).mp hAll).1
  exact (s4_list_all_iff_getElem? _ bb.statements).mp hStmts sIdx stmt hStmt

private theorem s4_bodySrc_term_localsInBounds {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bb : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb) :
    memCopyTermLocalsInBounds pack.bodySrc.locals.length bb.terminator = true := by
  have hAll := (s4_list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hLocInBounds bbIdx bb hBb
  exact ((bool_and_eq_true _ _).mp hAll).2

private theorem s4_bodySrc_term_targetsInBounds {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bb : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb) :
    memCopyTermTargetsInBounds pack.bodySrc.basicBlocks.length bb.terminator = true :=
  (s4_list_all_iff_getElem? _ pack.bodySrc.basicBlocks).mp pack.hTgtInBounds bbIdx bb hBb

/-! ## Section 4: Block Lowering & Storage Annotation Properties -/

private theorem s4_lowerBlocksForBufLoop_length (bufLocal base size : Nat) (mutability : Mutability) :
    ∀ (nextExtra : Nat) (bbs : List MemCopyBlock),
      (lowerBlocksForBufLoop bufLocal base size mutability nextExtra bbs).1.length = bbs.length
  | _, [] => rfl
  | _, _ :: rest =>
    congrArg Nat.succ (s4_lowerBlocksForBufLoop_length bufLocal base size mutability _ rest)

private theorem s4_lowerBlocksForBufLoop_spec (bufLocal base size : Nat) (mutability : Mutability) :
    ∀ (bbs : List MemCopyBlock) (nextExtra idx : Nat) (bb : MemCopyBlock),
      Trusted.MirSemantics.getElem? bbs idx = some bb →
      ∃ preExtras postExtras : List MemCopyBlock,
        let termRes := lowerTermForBuf bufLocal base size mutability
          (nextExtra + preExtras.length) bb.terminator
        (lowerBlocksForBufLoop bufLocal base size mutability nextExtra bbs).2 =
          preExtras ++ termRes.2.2 ++ postExtras ∧
        Trusted.MirSemantics.getElem?
            (lowerBlocksForBufLoop bufLocal base size mutability nextExtra bbs).1 idx =
          some {
            bb with
            statements := listFlatMap (lowerStmtForBuf bufLocal base size) bb.statements ++ termRes.1
            terminator := termRes.2.1
          }
  | [], _, _, _, h => by cases h
  | b :: rest, nextExtra, 0, bb, h => by
    rw [← Option.some.inj h]
    refine ⟨[], (lowerBlocksForBufLoop bufLocal base size mutability
      (nextExtra + (lowerTermForBuf bufLocal base size mutability nextExtra b.terminator).2.2.length)
      rest).2, rfl, rfl⟩
  | b :: rest, nextExtra, idx + 1, bb, h => by
    let termB := lowerTermForBuf bufLocal base size mutability nextExtra b.terminator
    cases s4_lowerBlocksForBufLoop_spec bufLocal base size mutability rest
        (nextExtra + termB.2.2.length) idx bb h with
    | intro pre ih1 => cases ih1 with | intro post hPair =>
      refine ⟨termB.2.2 ++ pre, post, ?_⟩
      dsimp [lowerBlocksForBufLoop]
      have hAssoc : nextExtra + termB.2.2.length + pre.length =
          nextExtra + (termB.2.2 ++ pre).length := by
        rw [s4_list_append_length, Nat.add_assoc]
      have hP2 := hPair.2
      rw [hAssoc] at hP2
      have hP1 := hPair.1
      rw [hAssoc] at hP1
      rw [hP1]
      constructor
      · dsimp [termB]
        rw [← List.append_assoc _ (pre ++ _) post, ← List.append_assoc _ pre _]
      · exact hP2

private theorem s4_getElem?_bodyTgt_blocks {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bb : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bb) :
    ∃ extraStart : Nat,
      let base := pack.bodySrc.locals.length
      let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability
        extraStart bb.terminator
      1 + pack.bodySrc.basicBlocks.length ≤ extraStart ∧
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (bbIdx + 1) =
        some {
          bb with
          statements :=
            listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bb.statements ++ termRes.1
          terminator := termRes.2.1
        } ∧
      (∀ k : Nat, k < termRes.2.2.length →
        Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (extraStart + k) =
          Trusted.MirSemantics.getElem? termRes.2.2 k) := by
  have hSpec := s4_lowerBlocksForBufLoop_spec plan.bufLocal pack.bodySrc.locals.length
    pack.size pack.mutability pack.bodySrc.basicBlocks
    (1 + pack.bodySrc.basicBlocks.length) bbIdx bb hBb
  cases hSpec with | intro pre ih1 => cases ih1 with | intro post hPair =>
  refine ⟨1 + pack.bodySrc.basicBlocks.length + pre.length, Nat.le_add_right _ _, ?_, ?_⟩
  · have hBbs := congrArg MemCopyBody.basicBlocks pack.hBodyTgt
    rw [hBbs]
    change Trusted.MirSemantics.getElem?
      ((lowerBlocksForBufLoop plan.bufLocal pack.bodySrc.locals.length pack.size pack.mutability
          (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).1 ++
       (lowerBlocksForBufLoop plan.bufLocal pack.bodySrc.locals.length pack.size pack.mutability
          (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2) bbIdx = _
    have hLt1 : bbIdx < (lowerBlocksForBufLoop plan.bufLocal pack.bodySrc.locals.length
        pack.size pack.mutability (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).1.length := by
      rw [s4_lowerBlocksForBufLoop_length]
      exact s4_getElem?_some_lt pack.bodySrc.basicBlocks bbIdx bb hBb
    rw [s4_getElem?_append_left _ _ bbIdx hLt1]
    exact hPair.2
  · intro k hk
    have hBbs := congrArg MemCopyBody.basicBlocks pack.hBodyTgt
    rw [hBbs]
    have hPos : 1 + pack.bodySrc.basicBlocks.length + pre.length + k =
        (pack.bodySrc.basicBlocks.length + (pre.length + k)) + 1 := by
      rw [Nat.add_comm 1 pack.bodySrc.basicBlocks.length, Nat.add_assoc, Nat.add_assoc,
        Nat.add_comm 1 (pre.length + k), ← Nat.add_assoc]
    rw [hPos]
    change Trusted.MirSemantics.getElem?
      ((lowerBlocksForBufLoop plan.bufLocal pack.bodySrc.locals.length pack.size pack.mutability
          (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).1 ++
       (lowerBlocksForBufLoop plan.bufLocal pack.bodySrc.locals.length pack.size pack.mutability
          (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2)
      (pack.bodySrc.basicBlocks.length + (pre.length + k)) = _
    have hLen1 : (lowerBlocksForBufLoop plan.bufLocal pack.bodySrc.locals.length
        pack.size pack.mutability (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).1.length =
        pack.bodySrc.basicBlocks.length := s4_lowerBlocksForBufLoop_length _ _ _ _ _ _
    have hApp := s4_getElem?_append_right
      (lowerBlocksForBufLoop plan.bufLocal pack.bodySrc.locals.length
        pack.size pack.mutability (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).1
      (lowerBlocksForBufLoop plan.bufLocal pack.bodySrc.locals.length
        pack.size pack.mutability (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2
      (pre.length + k)
    rw [hLen1] at hApp
    rw [hApp, hPair.1]
    exact s4_getElem?_append_middle_add pre _ post k hk

private theorem s4_noStorageMarker_mkZeroUsizeRange (loc : Nat) :
    ∀ (start count : Nat),
      (mkZeroUsizeRange start count).any (memCopyStmtHasStorageMarker loc) = false
  | _, 0 => rfl
  | start, k + 1 => by
    change (false || (mkZeroUsizeRange (start + 1) k).any (memCopyStmtHasStorageMarker loc)) = false
    exact s4_noStorageMarker_mkZeroUsizeRange loc (start + 1) k

