      rw [hRelW3a.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 8 (by decide)
    cases s3x_evalUsizeOp_scr_move ctx sW3a 8 (encodeAllocByte ab).fst (by decide) hTagLt hLenW3a_8 hW3a_8 with
    | intro sW3b hMW8 =>
    have hRelW3b := s3_slotsRel_set_scratch ctx slots₁ sW3a sW3b 8 _ (by decide) hRelW3a hMW8.1
    have hW3b_9 : Trusted.MirSemantics.getElem? sW3b (s3_scrBase ctx + 9) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (encodeAllocByte ab).snd })))) := by
      have hNe59 : s3_scrBase ctx + 5 ≠ s3_scrBase ctx + 9 := fun h => by cases Nat.add_left_cancel h
      have hNe89 : s3_scrBase ctx + 8 ≠ s3_scrBase ctx + 9 := fun h => by cases Nat.add_left_cancel h
      rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe89 hMW8.1, s3_getElem?_setElem?_ne _ _ _ _ _ hNe59 hMW5.1, hW2_9]
    have hLenW3b_9 : s3_scrBase ctx + 9 < sW3b.length := by
      rw [hRelW3b.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 9 (by decide)
    cases s3x_evalUsizeOp_scr_move ctx sW3b 9 (encodeAllocByte ab).snd (by decide) hValLt hLenW3b_9 hW3b_9 with
    | intro sW3c hMW9 =>
    have hRelW3c := s3_slotsRel_set_scratch ctx slots₁ sW3b sW3c 9 _ (by decide) hRelW3b hMW9.1
    have hPresW3c : ∀ j' : Nat, j' < 10 → j' ≠ 5 → j' ≠ 8 → j' ≠ 9 →
        Trusted.MirSemantics.getElem? sW3c (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? sW2 (s3_scrBase ctx + j') := by
      intro j' _ hNe5 hNe8 hNe9
      have hNe5Loc : s3_scrBase ctx + 5 ≠ s3_scrBase ctx + j' := fun h => hNe5 (Nat.add_left_cancel h).symm
      have hNe8Loc : s3_scrBase ctx + 8 ≠ s3_scrBase ctx + j' := fun h => hNe8 (Nat.add_left_cancel h).symm
      have hNe9Loc : s3_scrBase ctx + 9 ≠ s3_scrBase ctx + j' := fun h => hNe9 (Nat.add_left_cancel h).symm
      rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe9Loc hMW9.1]
      rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe8Loc hMW8.1]
      exact s3_getElem?_setElem?_ne _ _ _ _ _ hNe5Loc hMW5.1
    have hW3c_1 : Trusted.MirSemantics.getElem? sW3c (s3_scrBase ctx + 1) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 srcOff })))) := by
      rw [hPresW3c 1 (by decide) (by decide) (by decide) (by decide), hW2_1]
    have hW3c_3 : Trusted.MirSemantics.getElem? sW3c (s3_scrBase ctx + 3) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 dstOff })))) := by
      rw [hPresW3c 3 (by decide) (by decide) (by decide) (by decide), hW2_3]
    have hW3c_4 : Trusted.MirSemantics.getElem? sW3c (s3_scrBase ctx + 4) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 byteLen })))) := by
      rw [hPresW3c 4 (by decide) (by decide) (by decide) (by decide), hW2_4]
    have hW3c_7 : Trusted.MirSemantics.getElem? sW3c (s3_scrBase ctx + 7) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (acc + 1) })))) := by
      rw [hPresW3c 7 (by decide) (by decide) (by decide) (by decide), hSW2.2.2.1]
    let dstCur : Allocation :=
      { dstAlloc0 with bytes := spliceBytes dstAlloc0.bytes dstOff (snap.take acc) }
    have hFindDCur : findAlloc? (internalAllocBase + bufD) memCur.allocations = some dstCur :=
      s3_findAlloc?_update_eq mem0.allocations (internalAllocBase + bufD) dstCur memCur.allocations hAidD hUpCur
    have hDstCurLen : dstCur.bytes.length = dstAlloc0.bytes.length :=
      s3_spliceBytes_length dstAlloc0.bytes dstOff (snap.take acc)
        (Nat.le_trans (Nat.add_le_add_left (s3x_list_take_length_le snap acc) dstOff)
          (Nat.le_trans (Nat.add_le_add_left (Nat.le_of_lt hAccLt) dstOff) hDstBnd))
    have hOffLtCur : dstOff + acc < dstCur.bytes.length := by
      rw [hDstCurLen]; exact hDstIdxLtLen
    have hTermWr := s3x_exec_writeBufRawByte_term ctx (mem := memCur) bufD sizeD alD .mut
      (.move { localId := s3_scrBase ctx + 5, projection := [] })
      (.move { localId := s3_scrBase ctx + 8, projection := [] })
      (.move { localId := s3_scrBase ctx + 9, projection := [] })
      (dstOff + acc) (encodeAllocByte ab).fst (encodeAllocByte ab).snd (extraBase + 1) dstCur
      hDeclD hMW5.2 hMW8.2 hMW9.2 hTagLt hWfCur hRelW3c hBbWrite rfl
      hFindDCur hLiveD0 hMutD0 hOffLtCur
    cases hTermWr with | intro allocsNext hWr =>
    have hStmtLenW2 :
        (MemCopyBlock.mk
          [mkBinOpStmt (s3_scrBase ctx + 5) .add (.copy { localId := s3_scrBase ctx + 3, projection := [] }) (.copy { localId := s3_scrBase ctx + 7, projection := [] }),
           mkBinOpStmt (s3_scrBase ctx + 7) .add (.move { localId := s3_scrBase ctx + 7, projection := [] }) (usizeConst 1)]
          (.writeBufRawByte bufD (.move { localId := s3_scrBase ctx + 5, projection := [] })
            (.move { localId := s3_scrBase ctx + 8, projection := [] }) (.move { localId := s3_scrBase ctx + 9, projection := [] }) (extraBase + 1))
          false).statements.length = 2 := rfl
    rw [hStmtLenW2] at hWr
    have hDecAb : decodeAllocByte (encodeAllocByte ab).fst (encodeAllocByte ab).snd = ab :=
      s3_decodeAllocByte_encodeAllocByte ab
    have hSnapGet : Trusted.MirSemantics.getElem? snap acc = some ab := by
      dsimp [snap]
      rw [s3_take_getElem? (srcAlloc0.bytes.drop srcOff) byteLen acc hAccLt]
      rw [s3x_list_drop_getElem? srcAlloc0.bytes srcOff acc]
      exact hByte0
    have hSnapTakeLen : (snap.take acc).length = acc := by
      apply s3x_list_take_length_min_le
      have h1 : byteLen ≤ (srcAlloc0.bytes.drop srcOff).length := by
        rw [s3_list_drop_length]
        have hSub := Nat.sub_le_sub_right hSrcBnd srcOff
        rw [Nat.add_sub_cancel_left] at hSub
        exact hSub
      have h2 : byteLen ≤ snap.length := by
        dsimp [snap]; rw [s3x_list_take_length_min_le _ _ h1]; exact Nat.le_refl byteLen
      exact Nat.le_trans (Nat.le_of_lt hAccLt) h2
    have hSpliceStep : spliceBytes dstCur.bytes (dstOff + acc) [ab] =
        spliceBytes dstAlloc0.bytes dstOff (snap.take (acc + 1)) := by
      dsimp [dstCur]
      have hDstOffAdd : dstOff + acc = dstOff + (snap.take acc).length := by rw [hSnapTakeLen]
      rw [hDstOffAdd]
      rw [s3_spliceBytes_append_single dstAlloc0.bytes dstOff (snap.take acc) ab
        (by rw [hSnapTakeLen]; exact Nat.le_trans (Nat.add_le_add_left hAcc1Le dstOff) hDstBnd)]
      rw [← s3x_list_take_succ_getElem? snap acc ab hSnapGet]
    let dstNext : Allocation :=
      { dstAlloc0 with bytes := spliceBytes dstAlloc0.bytes dstOff (snap.take (acc + 1)) }
    have hUpStep : updateAlloc? (internalAllocBase + bufD) dstNext memCur.allocations = some allocsNext := by
      have hEq : { dstCur with bytes := spliceBytes dstCur.bytes (dstOff + acc) [decodeAllocByte (encodeAllocByte ab).fst (encodeAllocByte ab).snd] } = dstNext := by
        dsimp [dstNext]; rw [hDecAb, hSpliceStep]
      rw [← hEq]; exact hWr.1
    have hUpNext := s3x_updateAlloc?_trans (internalAllocBase + bufD) dstCur dstNext hAidD
      mem0.allocations memCur.allocations allocsNext hUpCur hUpStep
    have hSumNext : (acc + 1) + rem' = byteLen := by
      rw [Nat.add_assoc, Nat.add_comm 1 rem']; exact hSum
    have hIh := ih (acc + 1) ⟨allocsNext⟩ sW3c hSumNext hUpNext hWr.2.2 hRelW3c hW3c_1 hW3c_3 hW3c_4 hW3c_7
    cases hIh with | intro nRest hRest =>
    cases hRest with | intro slotsOut hSO =>
    cases hSO with | intro memOut hMO =>
    have hReachThis : ReachesNMemCopy ctx.pTgt 7
        { frames := [{ defId := ctx.plan.defId, blockIdx := extraBase + 1, stmtIdx := 0, locals := slotsCur }], mem := memCur }
        { frames := [{ defId := ctx.plan.defId, blockIdx := extraBase + 1, stmtIdx := 0, locals := sW3c }], mem := { allocations := allocsNext } } := by
      have hR1 := s3_reachesN_cons hSH1.1 (s3_reachesN_one hSH2.1)
      have hR2 := s3_reachesN_cons hSR1.1 (s3_reachesN_one hSW0.1)
      have hR3 := s3_reachesN_cons hSW1.1 (s3_reachesN_cons hSW2.1 (s3_reachesN_one hWr.2.1))
      exact s3x_reachesN_trans (s3x_reachesN_trans hR1 hR2) hR3
    have hReachAll := s3x_reachesN_trans hReachThis hMO.2.1
    have hPos : 7 + (nRest + 1) = (7 + nRest) + 1 := (Nat.add_assoc 7 nRest 1).symm
    rw [hPos] at hReachAll
    exact ⟨7 + nRest, slotsOut, memOut, hMO.1, hReachAll, hMO.2.2⟩

private theorem s3x_copy_pair_fst_eq (decls : List MemCopyLocalDecl)
    (entries : List PtrBackingEntry) (extraBase : Nat)
    (s d : LocalId) (cntOp : Operand) (elemSize reqAlignLog2 : Nat)
    (checkNonNullZero : Bool) (nextBb : BasicBlockId)
    (kS kD : Nat) (optBufS optBufD : Option LocalId)
    (hFindS : findPtrEntry entries s = some (kS, optBufS))
    (hFindD : findPtrEntry entries d = some (kD, optBufD))
    (hSpecS : ∀ b, optBufS = some b → ∃ sz al mutab, Trusted.MirSemantics.getElem? decls b = some (.byteBuf sz al mutab) ∧ sz ≤ 32 ∧ al ≤ 30)
    (hSpecD : ∀ b, optBufD = some b → ∃ sz al mutab, Trusted.MirSemantics.getElem? decls b = some (.byteBuf sz al mutab) ∧ sz ≤ 32 ∧ al ≤ 30) :
    let scrBase := decls.length + 3 * entries.length
    let offS := decls.length + 3 * kS
    let offD := decls.length + 3 * kD
    let readArgs : List MemCopyStmt := [
      mkAssignUse (scrBase + 4) cntOp,
      mkLivenessCheckStmt offS,
      mkAssignUse (scrBase + 0) (.copy { localId := offS + 1, projection := [] }),
      mkAssignUse (scrBase + 1) (.copy { localId := offS + 2, projection := [] }),
      mkLivenessCheckStmt offD,
      mkAssignUse (scrBase + 2) (.copy { localId := offD + 1, projection := [] }),
      mkAssignUse (scrBase + 3) (.copy { localId := offD + 2, projection := [] })
    ]
    let byteLenStmts : List MemCopyStmt :=
      if Nat.beq elemSize 0 then
        [mkAssignUse (scrBase + 4) (usizeConst 0)]
      else if !Nat.ble elemSize maxIsize then
        [mkRequireZeroUsize (scrBase + 5) (.copy { localId := scrBase + 4, projection := [] })]
      else
        [mkSubUncheckedUsize (scrBase + 5) (usizeConst (Nat.div maxIsize elemSize)) (.copy { localId := scrBase + 4, projection := [] }),
         mkBinOpStmt (scrBase + 4) .mul (.move { localId := scrBase + 4, projection := [] }) (usizeConst elemSize)]
    let alignAndNull : List MemCopyStmt :=
      mkPtrAlignCheckStmts decls optBufS (scrBase + 0) (scrBase + 1) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
        mkPtrAlignCheckStmts decls optBufD (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
        (if checkNonNullZero then
          mkPtrNonNullCheckStmts (scrBase + 0) (scrBase + 1) (scrBase + 5) (scrBase + 6) ++
            mkPtrNonNullCheckStmts (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6)
        else [])
    (lowerTermForPtrs decls entries decls.length extraBase
      (.copyNonOverlapping s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb)).1 =
      readArgs ++ byteLenStmts ++ alignAndNull := by
  unfold lowerTermForPtrs
  dsimp
  rw [hFindS, hFindD]
  dsimp
  cases optBufS with
  | none =>
    cases optBufD with
    | none => rfl
    | some _ => rfl
  | some bS =>
    cases optBufD with
    | none => rfl
    | some bD =>
      cases hSpecS bS rfl with | intro szS hS =>
      cases hS with | intro alS hS =>
      cases hS with | intro mutS hDeclS =>
      cases hSpecD bD rfl with | intro szD hD =>
      cases hD with | intro alD hD =>
      cases hD with | intro mutD hDeclD =>
      dsimp
      rw [hDeclS.1, hDeclD.1]
      dsimp
      cases Mutability.beq mutD .mut with
      | true => rfl
      | false => rfl

private theorem s3x_copy_pair_snd_fst_eq (decls : List MemCopyLocalDecl)
    (entries : List PtrBackingEntry) (extraBase : Nat)
    (s d : LocalId) (cntOp : Operand) (elemSize reqAlignLog2 : Nat)
    (checkNonNullZero : Bool) (nextBb : BasicBlockId)
    (kS kD : Nat) (optBufS optBufD : Option LocalId)
    (hFindS : findPtrEntry entries s = some (kS, optBufS))
    (hFindD : findPtrEntry entries d = some (kD, optBufD))
    (hSpecS : ∀ b, optBufS = some b → ∃ sz al mutab, Trusted.MirSemantics.getElem? decls b = some (.byteBuf sz al mutab) ∧ sz ≤ 32 ∧ al ≤ 30)
    (hSpecD : ∀ b, optBufD = some b → ∃ sz al mutab, Trusted.MirSemantics.getElem? decls b = some (.byteBuf sz al mutab) ∧ sz ≤ 32 ∧ al ≤ 30) :
    let scrBase := decls.length + 3 * entries.length
    (lowerTermForPtrs decls entries decls.length extraBase
      (.copyNonOverlapping s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb)).2.1 =
      .baseTerm (.switchInt (.copy { localId := scrBase + 4, projection := [] })
        { branches := [(BitVec.ofNat 128 0, nextBb)], otherwise := extraBase }) := by
  unfold lowerTermForPtrs
  dsimp
  rw [hFindS, hFindD]
  dsimp
  cases optBufS with
  | none =>
    cases optBufD with
    | none => rfl
    | some _ => rfl
  | some bS =>
    cases optBufD with
    | none => rfl
    | some bD =>
      cases hSpecS bS rfl with | intro szS hS =>
      cases hS with | intro alS hS =>
      cases hS with | intro mutS hDeclS =>
      cases hSpecD bD rfl with | intro szD hD =>
      cases hD with | intro alD hD =>
      cases hD with | intro mutD hDeclD =>
      dsimp
      rw [hDeclS.1, hDeclD.1]
      dsimp
      cases Mutability.beq mutD .mut with
      | true => rfl
      | false => rfl

private theorem s3x_copy_header_sim (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock} {startIdx : Nat}
    {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (s d : LocalId) (cntOp : Operand) (elemSize reqAlignLog2 : Nat)
    (checkNonNullZero : Bool) (kS kD : Nat) (optBufS optBufD : Option LocalId)
    (hReq : reqAlignLog2 ≤ 30)
    (hCntBaseTy : operandHasBaseTy ctx.bodySrc.locals usizeTy cntOp = true)
    (hFindS : findPtrEntry ctx.plan.entries s = some (kS, optBufS))
    (hFindD : findPtrEntry ctx.plan.entries d = some (kD, optBufD))
    (hSpecS : ∀ b, optBufS = some b →
      ∃ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals b = some (.byteBuf sz al mutab) ∧ sz ≤ 32 ∧ al ≤ 30)
    (hSpecD : ∀ b, optBufD = some b →
      ∃ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals b = some (.byteBuf sz al mutab) ∧ sz ≤ 32 ∧ al ≤ 30)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hWin :
      let scrBase := s3_scrBase ctx
      let offS := ctx.bodySrc.locals.length + 3 * kS
      let offD := ctx.bodySrc.locals.length + 3 * kD
      let readArgs : List MemCopyStmt := [
        mkAssignUse (scrBase + 4) cntOp,
        mkLivenessCheckStmt offS,
        mkAssignUse (scrBase + 0) (.copy { localId := offS + 1, projection := [] }),
        mkAssignUse (scrBase + 1) (.copy { localId := offS + 2, projection := [] }),
        mkLivenessCheckStmt offD,
        mkAssignUse (scrBase + 2) (.copy { localId := offD + 1, projection := [] }),
        mkAssignUse (scrBase + 3) (.copy { localId := offD + 2, projection := [] })
      ]
      let byteLenStmts : List MemCopyStmt :=
        if Nat.beq elemSize 0 then
          [mkAssignUse (scrBase + 4) (usizeConst 0)]
        else if !Nat.ble elemSize maxIsize then
          [mkRequireZeroUsize (scrBase + 5) (.copy { localId := scrBase + 4, projection := [] })]
        else
          [mkSubUncheckedUsize (scrBase + 5) (usizeConst (Nat.div maxIsize elemSize)) (.copy { localId := scrBase + 4, projection := [] }),
           mkBinOpStmt (scrBase + 4) .mul (.move { localId := scrBase + 4, projection := [] }) (usizeConst elemSize)]
      let alignAndNull : List MemCopyStmt :=
        mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (scrBase + 0) (scrBase + 1) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
          mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
          (if checkNonNullZero then
            mkPtrNonNullCheckStmts (scrBase + 0) (scrBase + 1) (scrBase + 5) (scrBase + 6) ++
              mkPtrNonNullCheckStmts (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6)
          else [])
      ∀ (k : Nat) (st : MemCopyStmt),
        Trusted.MirSemantics.getElem? (readArgs ++ byteLenStmts ++ alignAndNull) k = some st →
          Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + k) = some st) :
    let scrBase := s3_scrBase ctx
    let offS := ctx.bodySrc.locals.length + 3 * kS
    let offD := ctx.bodySrc.locals.length + 3 * kD
    let headerLen := ([
      mkAssignUse (scrBase + 4) cntOp,
      mkLivenessCheckStmt offS,
      mkAssignUse (scrBase + 0) (.copy { localId := offS + 1, projection := [] }),
      mkAssignUse (scrBase + 1) (.copy { localId := offS + 2, projection := [] }),
      mkLivenessCheckStmt offD,
      mkAssignUse (scrBase + 2) (.copy { localId := offD + 1, projection := [] }),
      mkAssignUse (scrBase + 3) (.copy { localId := offD + 2, projection := [] })
    ] ++
      (if Nat.beq elemSize 0 then [mkAssignUse (scrBase + 4) (usizeConst 0)]
       else if !Nat.ble elemSize maxIsize then [mkRequireZeroUsize (scrBase + 5) (.copy { localId := scrBase + 4, projection := [] })]
       else [mkSubUncheckedUsize (scrBase + 5) (usizeConst (Nat.div maxIsize elemSize)) (.copy { localId := scrBase + 4, projection := [] }),
             mkBinOpStmt (scrBase + 4) .mul (.move { localId := scrBase + 4, projection := [] }) (usizeConst elemSize)]) ++
      (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (scrBase + 0) (scrBase + 1) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
       mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
       (if checkNonNullZero then
         mkPtrNonNullCheckStmts (scrBase + 0) (scrBase + 1) (scrBase + 5) (scrBase + 6) ++
           mkPtrNonNullCheckStmts (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6)
       else []))).length
    match evalUsizeOp ctx.bodySrc.locals slots₁ cntOp with
    | .error err =>
      ∃ n sBad,
        ReachesNMemCopy ctx.pTgt n
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
            sBad ∧
          evalStepMemCopy ctx.pTgt 0 sBad = .fault err
    | .ok (count, slots₁') =>
      match readPtrLocal ctx.bodySrc.locals slots₁' s false with
      | .error err =>
        ∃ n sBad,
          ReachesNMemCopy ctx.pTgt n
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
              sBad ∧
            evalStepMemCopy ctx.pTgt 0 sBad = .fault err
      | .ok (pvSrc, slots₁'') =>
        match readPtrLocal ctx.bodySrc.locals slots₁'' d false with
        | .error err =>
          ∃ n sBad,
            ReachesNMemCopy ctx.pTgt n
                { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                sBad ∧
              evalStepMemCopy ctx.pTgt 0 sBad = .fault err
        | .ok (pvDst, slots₁''') =>
          let byteLen := elemSize * count
          if !Nat.ble byteLen maxIsize then
            ∃ n sBad,
              ReachesNMemCopy ctx.pTgt n
                  { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                  sBad ∧
                evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined
          else
            match checkPtrAlignMem mem pvSrc reqAlignLog2, checkPtrAlignMem mem pvDst reqAlignLog2 with
            | .error err, _ =>
              ∃ n sBad,
                ReachesNMemCopy ctx.pTgt n
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                    sBad ∧
                  evalStepMemCopy ctx.pTgt 0 sBad = .fault err
            | _, .error err =>
              ∃ n sBad,
                ReachesNMemCopy ctx.pTgt n
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                    sBad ∧
                  evalStepMemCopy ctx.pTgt 0 sBad = .fault err
            | .ok (), .ok () =>
              if checkNonNullZero && (isNullPtr pvSrc || isNullPtr pvDst) then
                ∃ n sBad,
                  ReachesNMemCopy ctx.pTgt n
                      { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                      sBad ∧
                    evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined
              else
                ∃ tagS tagD slots₂',
                  slots₁'' = slots₁' ∧ slots₁''' = slots₁' ∧
                  byteLen ≤ maxIsize ∧
                  tagS < maxUsize ∧ tagD < maxUsize ∧
                  s3_PtrTagMatches optBufS pvSrc tagS ∧
                  s3_PtrTagMatches optBufD pvDst tagD ∧
                  ReachesNMemCopy ctx.pTgt headerLen
                      { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                      { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + headerLen, locals := slots₂' }], mem := mem } ∧
                  s3_MemWf ctx.bodySrc slots₁' mem ∧
                  s3_SlotsRel ctx slots₁' slots₂' ∧
                  Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 0) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagS })))) ∧
                  Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 1) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvSrc.offsetBytes.toNat })))) ∧
                  Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 2) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagD })))) ∧
                  Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 3) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvDst.offsetBytes.toNat })))) ∧
                  Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 4) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 byteLen })))) := by
  intro scrBase offS offD headerLen
  have hWinRB := s3x_window_append_left hWin
  have hWinAlign := s3x_window_append_right hWin
  have hWinRead := s3x_window_append_left hWinRB
  have hWinByte := s3x_window_append_right hWinRB
  have hReadLen : ([
      mkAssignUse (scrBase + 4) cntOp,
      mkLivenessCheckStmt offS,
      mkAssignUse (scrBase + 0) (.copy { localId := offS + 1, projection := [] }),
      mkAssignUse (scrBase + 1) (.copy { localId := offS + 2, projection := [] }),
      mkLivenessCheckStmt offD,
      mkAssignUse (scrBase + 2) (.copy { localId := offD + 1, projection := [] }),
      mkAssignUse (scrBase + 3) (.copy { localId := offD + 2, projection := [] })
    ] : List MemCopyStmt).length = 7 := rfl
  rw [hReadLen] at hWinByte
  have hStmt0 := hWinRead 0 _ rfl
  rw [Nat.add_zero] at hStmt0
  have hStmt1 := hWinRead 1 _ rfl
  have hStmt2 := hWinRead 2 _ rfl
  have hStmt3 := hWinRead 3 _ rfl
  have hStmt4 := hWinRead 4 _ rfl
  have hStmt5 := hWinRead 5 _ rfl
  have hStmt6 := hWinRead 6 _ rfl
  let fStart : MemCopyFrame := { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }
  have hCntExec := s3_evalUsizeOp_assign_scr ctx fStart slots₁ mem 4 cntOp (by decide) hWf hRel hCntBaseTy
  cases hEvCnt : evalUsizeOp ctx.bodySrc.locals slots₁ cntOp with
  | error err =>
    rw [hEvCnt] at hCntExec
    dsimp at hCntExec
    have hFault : evalStepMemCopy ctx.pTgt 0 { frames := [fStart], mem := mem } = .fault err :=
      s3_reachesN_stmt_fault ctx hBbTgt hStmt0 hCntExec
    exact ⟨0, _, ReachesNMemCopy.zero _, hFault⟩
  | ok cPair =>
    rw [hEvCnt] at hCntExec
    cases cPair with | mk count slots₁' =>
    dsimp at hCntExec
    dsimp
    have hCntLt : count < maxUsize := hCntExec.1
    cases hCntExec.2 with | intro s2a hS2a =>
    have hStep0 := s3_reachesN_stmt_step ctx hBbTgt hStmt0 hS2a.1
    have hWf₁ := hS2a.2.2.1
    have hRel₁ := hS2a.2.2.2
    have hReadS := s3_exec_readPtr ctx (bbIdx := bbIdx) (bbTgt := bbTgt) (startIdx := startIdx + 1)
      (mem := mem) s kS 0 1 optBufS false hFindS (by decide) (by decide) (by decide) hWf₁ hRel₁ hBbTgt
      hStmt1 hStmt2 hStmt3
    cases hRpS : readPtrLocal ctx.bodySrc.locals slots₁' s false with
    | error err =>
      rw [hRpS] at hReadS
      dsimp at hReadS
      dsimp
      cases hReadS with | intro nR hnR =>
      cases hnR with | intro sBad hsBad =>
      exact ⟨1 + nR, sBad, s3x_reachesN_trans (s3_reachesN_one hStep0) hsBad.1, hsBad.2⟩
    | ok rpS =>
      rw [hRpS] at hReadS
      cases rpS with | mk pvSrc slots₁'' =>
      dsimp at hReadS
      dsimp
      have hSlotsEq1 : slots₁'' = slots₁' := s3x_readPtrLocal_false_slots hRpS
      cases hReadS with | intro tagS hRS =>
      cases hRS with | intro s2b hS2b =>
      have hTagSLt : tagS < maxUsize := hS2b.2.2.1
      have hMatchS : s3_PtrTagMatches optBufS pvSrc tagS := hS2b.2.1
      have hReach1_4 : ReachesNMemCopy ctx.pTgt 4
          { frames := [fStart], mem := mem }
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 4, locals := s2b }], mem := mem } := by
        have hR := s3_reachesN_cons hStep0 hS2b.2.2.2.1
        have hEq4 : startIdx + 1 + 3 = startIdx + 4 := Nat.add_assoc startIdx 1 3
        rw [hEq4] at hR
        exact hR
      have hS2b_0 := hS2b.2.2.2.2.2.2.1
      have hS2b_1 := hS2b.2.2.2.2.2.2.2.1
      have hS2b_4 : Trusted.MirSemantics.getElem? s2b (s3_scrBase ctx + 4) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 count })))) := by
        rw [hS2b.2.2.2.2.2.2.2.2 4 (by decide) (by decide) (by decide), hS2a.2.1]
      have hStmt4' : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 4) =
          some (mkLivenessCheckStmt offD) := hStmt4
      have hStmt5' : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 4 + 1) =
          some (mkAssignUse (scrBase + 2) (.copy { localId := offD + 1, projection := [] })) := by
        rw [Nat.add_assoc startIdx 4 1]; exact hStmt5
      have hStmt6' : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 4 + 2) =
          some (mkAssignUse (scrBase + 3) (.copy { localId := offD + 2, projection := [] })) := by
        rw [Nat.add_assoc startIdx 4 2]; exact hStmt6
      have hReadD := s3_exec_readPtr ctx (bbIdx := bbIdx) (bbTgt := bbTgt) (startIdx := startIdx + 4)
        (mem := mem) d kD 2 3 optBufD false hFindD (by decide) (by decide) (by decide)
        hS2b.2.2.2.2.1 hS2b.2.2.2.2.2.1 hBbTgt hStmt4' hStmt5' hStmt6'
      cases hRpD : readPtrLocal ctx.bodySrc.locals slots₁'' d false with
      | error err =>
        rw [hRpD] at hReadD
        dsimp at hReadD
        dsimp
        cases hReadD with | intro nR hnR =>
        cases hnR with | intro sBad hsBad =>
        exact ⟨_, sBad, s3x_reachesN_trans hReach1_4 hsBad.1, hsBad.2⟩
      | ok rpD =>
        rw [hRpD] at hReadD
        cases rpD with | mk pvDst slots₁''' =>
        dsimp at hReadD
        dsimp
        have hSlotsEq2 : slots₁''' = slots₁'' := s3x_readPtrLocal_false_slots hRpD
        have hSlotsEq2' : slots₁''' = slots₁' := by rw [hSlotsEq2, hSlotsEq1]
        cases hReadD with | intro tagD hRD =>
        cases hRD with | intro s2c hS2c =>
        have hReach7 : ReachesNMemCopy ctx.pTgt 7
            { frames := [fStart], mem := mem }
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 7, locals := s2c }], mem := mem } := by
          have hR := s3x_reachesN_trans hReach1_4 hS2c.2.2.2.1
          have hEq7 : startIdx + 4 + 3 = startIdx + 7 := Nat.add_assoc startIdx 4 3
          rw [hEq7] at hR
          exact hR
        have hS2c_0 : Trusted.MirSemantics.getElem? s2c (s3_scrBase ctx + 0) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagS })))) := by
          rw [hS2c.2.2.2.2.2.2.2.2 0 (by decide) (by decide) (by decide), Nat.add_zero, hS2b_0]
        have hS2c_1 : Trusted.MirSemantics.getElem? s2c (s3_scrBase ctx + 1) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvSrc.offsetBytes.toNat })))) := by
          rw [hS2c.2.2.2.2.2.2.2.2 1 (by decide) (by decide) (by decide), hS2b_1]
        have hS2c_2 := hS2c.2.2.2.2.2.2.1
        have hS2c_3 := hS2c.2.2.2.2.2.2.2.1
        have hS2c_4 : Trusted.MirSemantics.getElem? s2c (s3_scrBase ctx + 4) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 count })))) := by
          rw [hS2c.2.2.2.2.2.2.2.2 4 (by decide) (by decide) (by decide), hS2b_4]
        have hRel2c : s3_SlotsRel ctx slots₁' s2c := by
          rw [← hSlotsEq2']; exact hS2c.2.2.2.2.2.1
        have hByteExec := s3x_copy_byteLenStmts_sim ctx (bbIdx := bbIdx) (bbTgt := bbTgt) (startIdx := startIdx + 7)
          (mem := mem) count elemSize hCntLt hS2c_4 hRel2c hBbTgt hWinByte
        cases hBleMax : Nat.ble (elemSize * count) maxIsize with
        | false =>
          rw [hBleMax] at hByteExec
          dsimp at hByteExec
          dsimp
          cases hByteExec with | intro nB hnB =>
          cases hnB with | intro sBad hsBad =>
          exact ⟨_, sBad, s3x_reachesN_trans hReach7 hsBad.1, hsBad.2⟩
        | true =>
          rw [hBleMax] at hByteExec
          dsimp at hByteExec
          dsimp
          cases hByteExec with | intro hByteLenLe hBR =>
          cases hBR with | intro s2d hS2d =>
          have hReachB := s3x_reachesN_trans hReach7 hS2d.1
          have hS2d_0 : Trusted.MirSemantics.getElem? s2d (s3_scrBase ctx + 0) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagS })))) := by
            rw [hS2d.2.2.2 0 (by decide), hS2c_0]
          have hS2d_1 : Trusted.MirSemantics.getElem? s2d (s3_scrBase ctx + 1) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvSrc.offsetBytes.toNat })))) := by
            rw [hS2d.2.2.2 1 (by decide), hS2c_1]
          have hS2d_2 : Trusted.MirSemantics.getElem? s2d (s3_scrBase ctx + 2) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagD })))) := by
            rw [hS2d.2.2.2 2 (by decide), hS2c_2]
          have hS2d_3 : Trusted.MirSemantics.getElem? s2d (s3_scrBase ctx + 3) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvDst.offsetBytes.toNat })))) := by
            rw [hS2d.2.2.2 3 (by decide), hS2c_3]
          have hS2d_4 := hS2d.2.2.1
          rw [List.length_append, hReadLen] at hWinAlign
          rw [Nat.add_assoc startIdx 7 _] at hReachB
          have hAlExec := s3x_copy_alignAndNull_sim ctx (bbIdx := bbIdx) (bbTgt := bbTgt) (mem := mem)
            optBufS optBufD reqAlignLog2 tagS tagD pvSrc pvDst checkNonNullZero
            hReq hTagSLt hS2c.2.2.1 hMatchS hS2c.2.1 hSpecS hSpecD hWf₁ hS2d.2.1
            hS2d_0 hS2d_1 hS2d_2 hS2d_3 hBbTgt hWinAlign
          cases hAlS : checkPtrAlignMem mem pvSrc reqAlignLog2 with
          | error err =>
            rw [hAlS] at hAlExec
            dsimp at hAlExec
            dsimp
            cases hAlExec with | intro nA hnA =>
            cases hnA with | intro sBad hsBad =>
            exact ⟨_, sBad, s3x_reachesN_trans hReachB hsBad.1, hsBad.2⟩
          | ok uS =>
            cases uS
            rw [hAlS] at hAlExec
            cases hAlD : checkPtrAlignMem mem pvDst reqAlignLog2 with
            | error err =>
              rw [hAlD] at hAlExec
              dsimp at hAlExec
              dsimp
              cases hAlExec with | intro nA hnA =>
              cases hnA with | intro sBad hsBad =>
              exact ⟨_, sBad, s3x_reachesN_trans hReachB hsBad.1, hsBad.2⟩
            | ok uD =>
              cases uD
              rw [hAlD] at hAlExec
              dsimp at hAlExec
              dsimp
              cases hNN : checkNonNullZero && (isNullPtr pvSrc || isNullPtr pvDst) with
              | true =>
                rw [hNN] at hAlExec
                dsimp at hAlExec
                dsimp
                cases hAlExec with | intro nA hnA =>
                cases hnA with | intro sBad hsBad =>
                exact ⟨_, sBad, s3x_reachesN_trans hReachB hsBad.1, hsBad.2⟩
              | false =>
                rw [hNN] at hAlExec
                dsimp at hAlExec
                dsimp
                cases hAlExec with | intro s2e hS2e =>
                have hLenHdr : headerLen = (7 +
                    (if Nat.beq elemSize 0 then [mkAssignUse (scrBase + 4) (usizeConst 0)]
                     else if !Nat.ble elemSize maxIsize then [mkRequireZeroUsize (scrBase + 5) (.copy { localId := scrBase + 4, projection := [] })]
                     else [mkSubUncheckedUsize (scrBase + 5) (usizeConst (Nat.div maxIsize elemSize)) (.copy { localId := scrBase + 4, projection := [] }),
                           mkBinOpStmt (scrBase + 4) .mul (.move { localId := scrBase + 4, projection := [] }) (usizeConst elemSize)]).length) +
                    (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS scrBase (scrBase + 1) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
                     mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
                     (if checkNonNullZero then
                       mkPtrNonNullCheckStmts scrBase (scrBase + 1) (scrBase + 5) (scrBase + 6) ++
                         mkPtrNonNullCheckStmts (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6)
                     else [])).length := by
                  have hAppLen : ∀ (a b c : List MemCopyStmt), (a ++ b ++ c).length = (a.length + b.length) + c.length :=
                    fun a b c => by rw [List.length_append, List.length_append]
                  have hRaw := hAppLen
                    [ mkAssignUse (scrBase + 4) cntOp,
                      mkLivenessCheckStmt offS,
                      mkAssignUse (scrBase + 0) (.copy { localId := offS + 1, projection := [] }),
                      mkAssignUse (scrBase + 1) (.copy { localId := offS + 2, projection := [] }),
                      mkLivenessCheckStmt offD,
                      mkAssignUse (scrBase + 2) (.copy { localId := offD + 1, projection := [] }),
                      mkAssignUse (scrBase + 3) (.copy { localId := offD + 2, projection := [] }) ]
                    (if Nat.beq elemSize 0 then [mkAssignUse (scrBase + 4) (usizeConst 0)]
                     else if !Nat.ble elemSize maxIsize then [mkRequireZeroUsize (scrBase + 5) (.copy { localId := scrBase + 4, projection := [] })]
                     else [mkSubUncheckedUsize (scrBase + 5) (usizeConst (Nat.div maxIsize elemSize)) (.copy { localId := scrBase + 4, projection := [] }),
                           mkBinOpStmt (scrBase + 4) .mul (.move { localId := scrBase + 4, projection := [] }) (usizeConst elemSize)])
                    (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (scrBase + 0) (scrBase + 1) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
                     mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6) reqAlignLog2 ++
                     (if checkNonNullZero then
                       mkPtrNonNullCheckStmts (scrBase + 0) (scrBase + 1) (scrBase + 5) (scrBase + 6) ++
                         mkPtrNonNullCheckStmts (scrBase + 2) (scrBase + 3) (scrBase + 5) (scrBase + 6)
                     else []))
                  rw [hReadLen] at hRaw
                  exact hRaw
                have hReachAll := s3x_reachesN_trans hReachB hS2e.1
                rw [Nat.add_assoc startIdx _ _, ← hLenHdr] at hReachAll
                have hS2e_0 : Trusted.MirSemantics.getElem? s2e (s3_scrBase ctx + 0) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagS })))) := by
                  rw [hS2e.2.2 0 (by decide), hS2d_0]
                have hS2e_1 : Trusted.MirSemantics.getElem? s2e (s3_scrBase ctx + 1) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvSrc.offsetBytes.toNat })))) := by
                  rw [hS2e.2.2 1 (by decide), hS2d_1]
                have hS2e_2 : Trusted.MirSemantics.getElem? s2e (s3_scrBase ctx + 2) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagD })))) := by
                  rw [hS2e.2.2 2 (by decide), hS2d_2]
                have hS2e_3 : Trusted.MirSemantics.getElem? s2e (s3_scrBase ctx + 3) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvDst.offsetBytes.toNat })))) := by
                  rw [hS2e.2.2 3 (by decide), hS2d_3]
                have hS2e_4 : Trusted.MirSemantics.getElem? s2e (s3_scrBase ctx + 4) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (elemSize * count) })))) := by
                  rw [hS2e.2.2 4 (by decide), hS2d_4]
                exact ⟨tagS, tagD, s2e, hSlotsEq1, hSlotsEq2', hByteLenLe, hTagSLt, hS2c.2.2.1, hMatchS, hS2c.2.1,
                  hReachAll, hWf₁, hS2e.2.1, hS2e_0, hS2e_1, hS2e_2, hS2e_3, hS2e_4⟩

private theorem s3x_copyNonOverlapping_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (s d : LocalId) (cntOp : Operand) (elemSize reqAlignLog2 : Nat)
    (checkNonNullZero : Bool) (nextBb : BasicBlockId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator = .copyNonOverlapping s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb)
    (hStmtLen : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hCheckTerm := s3x_checkTermForPtrs_of_bb ctx hBbSrc
  rw [hTerm] at hCheckTerm
  have hTib := s3x_termTargetsInBounds_of_bb ctx hBbSrc
  rw [hTerm] at hTib
  have hBbNextEx := s3x_bb_of_lt ctx nextBb ((nat_blt_eq_lt _ _).mp hTib)
  cases hBbNextEx with | intro bbNext hBbNext =>
  unfold checkTermForPtrs at hCheckTerm
  dsimp at hCheckTerm
  have hAnd1 := (bool_and_eq_true _ _).mp hCheckTerm
  have hAnd2 := (bool_and_eq_true _ _).mp hAnd1.1
  have hReq : reqAlignLog2 ≤ 30 := (nat_ble_eq_le _ _).mp hAnd2.1
  have hCntBaseTy : operandHasBaseTy ctx.bodySrc.locals usizeTy cntOp = true := hAnd2.2
  have hFindCond := hAnd1.2
  cases hFindS : findPtrEntry ctx.plan.entries s with
  | none => rw [hFindS] at hFindCond; cases hFindCond
  | some sPair =>
    cases hFindD : findPtrEntry ctx.plan.entries d with
    | none => rw [hFindS, hFindD] at hFindCond; cases hFindCond
    | some dPair =>
      cases sPair with | mk kS optBufS =>
      cases dPair with | mk kD optBufD =>
      cases s3_lowerBlock_getElem?_termPre ctx hBbSrc with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      have hTermPair := hBlock.1
      have hBbTgt := hBlock.2.2.1
      have hStmtsLen := hBlock.2.2.2.1
      have hWinPair := hBlock.2.2.2.2.1
      have hExtraWin := hBlock.2.2.2.2.2
      rw [hBbRel] at hBbTgt
      rw [hTerm] at hTermPair hBbTgt hStmtsLen hWinPair
      have hSpecS := (s3x_findPtrEntry_bounds_and_spec ctx s kS optBufS hFindS).2
      have hSpecD := (s3x_findPtrEntry_bounds_and_spec ctx d kD optBufD hFindD).2
      have hPairFst := s3x_copy_pair_fst_eq ctx.bodySrc.locals ctx.plan.entries extraBase
        s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb kS kD optBufS optBufD
        hFindS hFindD hSpecS hSpecD
      have hPairSndFst := s3x_copy_pair_snd_fst_eq ctx.bodySrc.locals ctx.plan.entries extraBase
        s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb kS kD optBufS optBufD
        hFindS hFindD hSpecS hSpecD
      rw [hPairFst] at hBbTgt hStmtsLen hWinPair
      have hWinHdr := s3x_window_of_termWin hWinPair rfl
      have hStartIdx : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length := by
        rw [hIdxEq, hStmtLen]
      let startIdx := s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length
      let f2Start : MemCopyFrame := { defId := ctx.plan.defId, blockIdx := f₂.blockIdx, stmtIdx := startIdx, locals := f₂.locals }
      have hF2Eq : f₂ = f2Start := by
        cases f₂; dsimp at hDef₂ hStartIdx; subst hDef₂ hStartIdx; rfl
      rw [hF2Eq]
      have hSrcEval : evalStepMemCopy ctx.pSrc 0 { frames := [f₁], mem := mem } =
          evalMemCopyTerm ctx.bodySrc bbSrc f₁ mem :=
        s3_step_state_of_term ctx.pSrc f₁ mem ctx.bodySrc bbSrc (by rw [hDef₁]; exact ctx.hBodies) hBbSrc hStmtLen
      have hSrcEq := s3x_memCopyTerm_copy_eval_eq ctx.bodySrc bbSrc f₁ mem s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb hTerm
      rw [hSrcEq] at hSrcEval
      unfold evalMemCopyTerm at hSrcEval
      dsimp at hSrcEval
      have hReqFalse : (!Nat.ble reqAlignLog2 30) = false := by
        rw [s3x_nat_ble_true_of_le hReq]; rfl
      rw [hReqFalse] at hSrcEval
      dsimp at hSrcEval
      have hHdrSim := s3x_copy_header_sim ctx (bbIdx := f₂.blockIdx) (startIdx := startIdx) (mem := mem)
        s d cntOp elemSize reqAlignLog2 checkNonNullZero kS kD optBufS optBufD
        hReq hCntBaseTy hFindS hFindD hSpecS hSpecD hWf hRel hBbTgt hWinHdr
      cases hEvCnt : evalUsizeOp ctx.bodySrc.locals f₁.locals cntOp with
      | error err =>
        rw [hEvCnt] at hSrcEval hHdrSim
        dsimp at hSrcEval hHdrSim
        exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval hHdrSim
      | ok cPair =>
        rw [hEvCnt] at hSrcEval hHdrSim
