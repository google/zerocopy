private theorem s3_evalBinOp_usize_le (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize) :
    evalBinOp .le
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }) =
      .ok (.bool (Nat.ble a b)) := by
  unfold evalBinOp
  dsimp [BinOp.isShift]
  rw [s3_decodeScalar_usize a ha, s3_decodeScalar_usize b hb]
  change Except.ok (Val.bool (decide (Int.ofNat a ≤ Int.ofNat b))) = Except.ok (Val.bool (Nat.ble a b))
  cases hDec : Nat.ble a b with
  | true =>
    have hLe : a ≤ b := (nat_ble_eq_le a b).mp hDec
    have hI : Int.ofNat a ≤ Int.ofNat b := s0_int_ofNat_le_mpr hLe
    rw [decide_eq_true hI]
  | false =>
    have hGt : b < a := nat_ble_false_gt hDec
    have hNot : ¬ (Int.ofNat a ≤ Int.ofNat b) := fun h => Nat.not_lt_of_le (s0_int_ofNat_le_mp h) hGt
    rw [decide_eq_false hNot]

private theorem s3_evalBinOp_usize_lt (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize) :
    evalBinOp .lt
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }) =
      .ok (.bool (Nat.blt a b)) := by
  unfold evalBinOp
  dsimp [BinOp.isShift]
  rw [s3_decodeScalar_usize a ha, s3_decodeScalar_usize b hb]
  change Except.ok (Val.bool (decide (Int.ofNat a < Int.ofNat b))) = Except.ok (Val.bool (Nat.blt a b))
  cases hDec : Nat.blt a b with
  | true =>
    have hLt : a < b := (nat_blt_eq_lt a b).mp hDec
    have hI : Int.ofNat a < Int.ofNat b := s0_int_ofNat_lt_mpr hLt
    rw [decide_eq_true hI]
  | false =>
    have hGe : b ≤ a := nat_blt_false_ge hDec
    have hNot : ¬ (Int.ofNat a < Int.ofNat b) := fun h => Nat.not_le_of_gt (s0_int_ofNat_lt_mp h) hGe
    rw [decide_eq_false hNot]

private theorem s3_evalBinOp_bool_bitOr (a b : Bool) :
    evalBinOp .bitOr (.bool a) (.bool b) = .ok (.bool (a || b)) := rfl

/-! ## Section 3: `AllocByte`, `encodeLeUsize` / `decodeLeUsize`, & `spliceBytes` Helpers -/

private theorem s3_decodeAllocByte_encodeAllocByte :
    ∀ ab : AllocByte,
      decodeAllocByte (encodeAllocByte ab).fst (encodeAllocByte ab).snd = ab
  | .uninit => rfl
  | .init b none => by
    unfold encodeAllocByte decodeAllocByte
    dsimp
    change AllocByte.init (UInt8.ofNat (Nat.mod b.toNat 256)) none = AllocByte.init b none
    have hb : b.toNat < 256 := by
      cases b with
      | ofBitVec bv =>
        cases bv with
        | ofFin fn => exact fn.isLt
    rw [s3_nat_mod_eq_of_lt hb]
    have hB : UInt8.ofNat b.toNat = b := by
      cases b with
      | ofBitVec bv =>
        cases bv with
        | ofFin fn =>
          cases fn with
          | mk v hv =>
            change UInt8.ofBitVec (BitVec.ofFin (Fin.mk (Nat.mod v 256) _)) =
              UInt8.ofBitVec (BitVec.ofFin (Fin.mk v hv))
            exact congrArg UInt8.ofBitVec (congrArg BitVec.ofFin (Fin.eq_of_val_eq (Nat.mod_eq_of_lt hv)))
    rw [hB]
  | .init b (some aid) => by
    unfold encodeAllocByte decodeAllocByte
    dsimp
    have hNe0 : Nat.beq (2 + aid) 0 = false := by rw [Nat.add_comm]; rfl
    have hNe1 : Nat.beq (2 + aid) 1 = false := by
      cases aid with
      | zero => rfl
      | succ aid' => rw [Nat.add_comm]; rfl
    rw [hNe0, hNe1]
    dsimp
    have hSub : 2 + aid - 2 = aid := by
      rw [Nat.add_comm]; exact Nat.add_sub_cancel aid 2
    rw [hSub]
    have hb : b.toNat < 256 := by
      cases b with
      | ofBitVec bv => cases bv with | ofFin fn => exact fn.isLt
    rw [s3_nat_mod_eq_of_lt hb]
    have hB : UInt8.ofNat b.toNat = b := by
      cases b with
      | ofBitVec bv =>
        cases bv with
        | ofFin fn =>
          cases fn with
          | mk v hv =>
            change UInt8.ofBitVec (BitVec.ofFin (Fin.mk (Nat.mod v 256) _)) =
              UInt8.ofBitVec (BitVec.ofFin (Fin.mk v hv))
            exact congrArg UInt8.ofBitVec (congrArg BitVec.ofFin (Fin.eq_of_val_eq (Nat.mod_eq_of_lt hv)))
    rw [hB]

private theorem s3_encodeAllocByte_decodeAllocByte_lt (t v : Nat) (ht : t < maxUsize) :
    (encodeAllocByte (decodeAllocByte t v)).fst < maxUsize := by
  unfold decodeAllocByte
  cases t with
  | zero => exact ht
  | succ t' =>
    cases t' with
    | zero => exact ht
    | succ t'' =>
      have hNe0 : Nat.beq (t'' + 2) 0 = false := rfl
      have hNe1 : Nat.beq (t'' + 2) 1 = false := rfl
      change (encodeAllocByte (if Nat.beq (t'' + 1 + 1) 0 = true then AllocByte.uninit
        else if Nat.beq (t'' + 1 + 1) 1 = true then AllocByte.init (UInt8.ofNat (Nat.mod v 256)) none
        else AllocByte.init (UInt8.ofNat (Nat.mod v 256)) (some (t'' + 1 + 1 - 2)))).fst < maxUsize
      rw [hNe0, hNe1]
      dsimp
      unfold encodeAllocByte
      dsimp
      have hEq : 2 + (t'' + 1 + 1 - 2) = t'' + 1 + 1 := by
        change 2 + (t'' + 2 - 2) = t'' + 2
        rw [Nat.add_sub_cancel, Nat.add_comm]
      rw [hEq]
      exact ht

private theorem s3_encodeAllocByte_none_fst (b : UInt8) :
    (encodeAllocByte (.init b none)).fst = 1 := rfl

private theorem s3_encodeAllocByte_none_snd_lt (b : UInt8) :
    (encodeAllocByte (.init b none)).snd < 256 := by
  unfold encodeAllocByte
  dsimp
  cases b with
  | ofBitVec bv => cases bv with | ofFin fn => exact fn.isLt

private theorem s3_encodeLeBytesAux_length :
    ∀ (prov : Option AllocId) (k n : Nat),
      (encodeLeBytesAux prov k n).length = k
  | _, 0, _ => rfl
  | prov, k + 1, n => by
    change (encodeLeBytesAux prov k (Nat.div n 256)).length + 1 = k + 1
    rw [s3_encodeLeBytesAux_length prov k (Nat.div n 256)]

private theorem s3_encodeLeUsize_length (w : LeWidth) (n : Nat) :
    (encodeLeUsize w n).length = w.byteCount :=
  s3_encodeLeBytesAux_length none w.byteCount n

private theorem s3_nat_div_pow_256 (n i : Nat) :
    Nat.div (Nat.div n 256) (Nat.pow 2 (8 * i)) =
      Nat.div n (Nat.pow 2 (8 * (i + 1))) := by
  have h256 : 256 = Nat.pow 2 8 := by decide
  rw [s3_nat_div_div_eq_div_mul, h256, ← s3_nat_pow_add, Nat.mul_add, Nat.mul_one, Nat.add_comm 8 (8 * i)]

private theorem s3_encodeLeBytesAux_getElem? :
    ∀ (prov : Option AllocId) (k n i : Nat),
      i < k →
      Trusted.MirSemantics.getElem? (encodeLeBytesAux prov k n) i =
        some (.init (UInt8.ofNat (Nat.mod (Nat.div n (Nat.pow 2 (8 * i))) 256)) prov)
  | _, 0, _, _, h => False.elim (Nat.not_lt_zero _ h)
  | prov, _ + 1, n, 0, _ => by
    change some (AllocByte.init (UInt8.ofNat (Nat.mod n 256)) prov) =
      some (AllocByte.init (UInt8.ofNat (Nat.mod (Nat.div n 1) 256)) prov)
    rw [s3_nat_div_one]
  | prov, k + 1, n, i + 1, h => by
    change Trusted.MirSemantics.getElem? (encodeLeBytesAux prov k (Nat.div n 256)) i = _
    rw [s3_encodeLeBytesAux_getElem? prov k (Nat.div n 256) i (Nat.lt_of_succ_lt_succ h)]
    rw [s3_nat_div_pow_256]

private theorem s3_encodeLeUsize_getElem? (w : LeWidth) (n i : Nat) (hi : i < w.byteCount) :
    Trusted.MirSemantics.getElem? (encodeLeUsize w n) i =
      some (.init (UInt8.ofNat (Nat.mod (Nat.shiftRight n (8 * i)) 256)) none) := by
  unfold encodeLeUsize
  rw [s3_encodeLeBytesAux_getElem? none w.byteCount n i hi]
  rw [s3_nat_shiftRight_eq_div_pow]

private theorem s3_decodeLeBytesAux_cons_init_none (b : UInt8) (rest : List AllocByte) :
    decodeLeBytesAux (.init b none :: rest) =
      match decodeLeBytesAux rest with
      | .ok hi => .ok (b.toNat + 256 * hi)
      | .error k => .error k := rfl

private theorem s3_decodeLeBytesAux_concat_init_none :
    ∀ (bs : List AllocByte) (b : UInt8) (acc : Nat),
      decodeLeBytesAux bs = .ok acc →
      decodeLeBytesAux (bs ++ [.init b none]) = .ok (acc + b.toNat * Nat.pow 2 (8 * bs.length))
  | [], b, acc, h => by
    cases h
    change Except.ok (b.toNat + 256 * 0) = Except.ok (0 + b.toNat * 1)
    rw [Nat.mul_zero, Nat.add_zero, Nat.zero_add, Nat.mul_one]
  | .uninit :: _, _, _, h => by cases h
  | .init _ (some _) :: _, _, _, h => by cases h
  | .init b0 none :: rest, b, acc, h => by
    change (match decodeLeBytesAux rest with | Except.ok hi => Except.ok (b0.toNat + 256 * hi) | Except.error k => Except.error k) = Except.ok acc at h
    cases hRest : decodeLeBytesAux rest with
    | error k => rw [hRest] at h; cases h
    | ok hi =>
      rw [hRest] at h; cases h
      have ih := s3_decodeLeBytesAux_concat_init_none rest b hi hRest
      change (match decodeLeBytesAux (rest ++ [.init b none]) with
        | Except.ok hi' => Except.ok (b0.toNat + 256 * hi')
        | Except.error k => Except.error k) = _
      rw [ih]
      dsimp
      have h256 : 256 = Nat.pow 2 8 := by decide
      have hMul : 256 * (hi + b.toNat * Nat.pow 2 (8 * rest.length)) =
          256 * hi + b.toNat * Nat.pow 2 (8 * (rest.length + 1)) := by
        rw [Nat.mul_add]
        exact congrArg (256 * hi + ·) (by
          rw [Nat.mul_comm 256, Nat.mul_assoc, h256, ← s3_nat_pow_add, Nat.mul_add, Nat.mul_one, Nat.add_comm (8 * rest.length) 8])
      change Except.ok (b0.toNat + 256 * (hi + b.toNat * Nat.pow 2 (8 * rest.length))) =
        Except.ok (b0.toNat + 256 * hi + b.toNat * Nat.pow 2 (8 * (rest.length + 1)))
      rw [hMul, Nat.add_assoc]

private theorem s3_decodeLeBytesAux_append_err :
    ∀ (bs₁ bs₂ : List AllocByte) (k : FaultKind),
      decodeLeBytesAux bs₁ = .error k →
      decodeLeBytesAux (bs₁ ++ bs₂) = .error k
  | [], _, _, h => by cases h
  | .uninit :: _, _, _, h => by cases h; rfl
  | .init _ (some _) :: _, _, _, h => by cases h; rfl
  | .init _ none :: rest, bs₂, k, h => by
    change (match decodeLeBytesAux rest with | Except.ok _ => _ | Except.error e => Except.error e) = Except.error k at h
    cases hR : decodeLeBytesAux rest with
    | ok _ => rw [hR] at h; cases h
    | error e =>
      rw [hR] at h; cases h
      change (match decodeLeBytesAux (rest ++ bs₂) with | Except.ok _ => _ | Except.error e' => Except.error e') = Except.error k
      rw [s3_decodeLeBytesAux_append_err rest bs₂ k hR]

private theorem s3_decodeLeBytesAux_concat_non_none :
    ∀ (bs : List AllocByte) (ab : AllocByte),
      (match ab with | .init _ none => False | _ => True) →
      (∃ acc, decodeLeBytesAux bs = .ok acc) →
      decodeLeBytesAux (bs ++ [ab]) = .error .undefined
  | [], .uninit, _, _ => rfl
  | [], .init _ (some _), _, _ => rfl
  | [], .init _ none, hBad, _ => False.elim hBad
  | .uninit :: _, _, _, h => by cases h with | intro _ h1 => cases h1
  | .init _ (some _) :: _, _, _, h => by cases h with | intro _ h1 => cases h1
  | .init _ none :: rest, ab, hBad, h => by
    cases h with
    | intro acc hAcc =>
      change (match decodeLeBytesAux rest with | Except.ok _ => _ | Except.error _ => _) = Except.ok acc at hAcc
      cases hR : decodeLeBytesAux rest with
      | error _ => rw [hR] at hAcc; cases hAcc
      | ok hi =>
        change (match decodeLeBytesAux (rest ++ [ab]) with | Except.ok _ => _ | Except.error _ => _) =
          Except.error FaultKind.undefined
        rw [s3_decodeLeBytesAux_concat_non_none rest ab hBad ⟨hi, hR⟩]

private theorem s3_decodeLeBytesAux_bound :
    ∀ (bs : List AllocByte) (acc : Nat),
      decodeLeBytesAux bs = .ok acc →
      acc < Nat.pow 2 (8 * bs.length)
  | [], acc, h => by cases h; exact Nat.zero_lt_one
  | .uninit :: _, _, h => by cases h
  | .init _ (some _) :: _, _, h => by cases h
  | .init b none :: rest, acc, h => by
    change (match decodeLeBytesAux rest with | Except.ok hi => Except.ok (b.toNat + 256 * hi) | Except.error _ => _) = Except.ok acc at h
    cases hR : decodeLeBytesAux rest with
    | error _ => rw [hR] at h; cases h
    | ok hi =>
      rw [hR] at h; cases h
      have ih := s3_decodeLeBytesAux_bound rest hi hR
      have hb : b.toNat < 256 := by
        cases b with | ofBitVec bv => cases bv with | ofFin fn => exact fn.isLt
      have hPow : Nat.pow 2 (8 * (rest.length + 1)) = 256 * Nat.pow 2 (8 * rest.length) := by
        have h256 : 256 = Nat.pow 2 8 := by decide
        rw [Nat.mul_add, Nat.mul_one, Nat.add_comm (8 * rest.length) 8, s3_nat_pow_add, ← h256]
      change b.toNat + 256 * hi < Nat.pow 2 (8 * (rest.length + 1))
      rw [hPow]
      have hHiLe : hi + 1 ≤ Nat.pow 2 (8 * rest.length) := ih
      have hMulLe : 256 * hi + 256 ≤ 256 * Nat.pow 2 (8 * rest.length) := by
        have hM := Nat.mul_le_mul_left 256 hHiLe
        rw [Nat.mul_add, Nat.mul_one] at hM
        exact hM
      exact Nat.lt_of_lt_of_le (Nat.add_lt_add_right hb (256 * hi)) (by rw [Nat.add_comm]; exact hMulLe)

private theorem s3_spliceBytes_length (old : List AllocByte) (off : Nat) (rep : List AllocByte)
    (hBound : off + rep.length ≤ old.length) :
    (spliceBytes old off rep).length = old.length := by
  unfold spliceBytes
  have hOffLe : off ≤ old.length := Nat.le_trans (Nat.le_add_right _ _) hBound
  rw [List.length_append, List.length_append, s3_take_length_le old off hOffLe, s3_list_drop_length]
  exact s0_nat_add_sub_cancel' hBound

private theorem s3_spliceBytes_getElem?_lt (old : List AllocByte) (off : Nat) (rep : List AllocByte)
    (i : Nat) (hi : i < off) (hBound : off ≤ old.length) :
    Trusted.MirSemantics.getElem? (spliceBytes old off rep) i =
      Trusted.MirSemantics.getElem? old i := by
  unfold spliceBytes
  have hLen : (old.take off).length = off := s3_take_length_le old off hBound
  have hL : i < (old.take off ++ rep).length := by
    rw [List.length_append, hLen]
    exact Nat.lt_of_lt_of_le hi (Nat.le_add_right _ _)
  rw [s3_getElem?_append_left _ _ i hL, s3_getElem?_append_left _ _ i (by rw [hLen]; exact hi)]
  exact s3_take_getElem? old off i hi

private theorem s3_spliceBytes_getElem?_mid (old : List AllocByte) (off : Nat) (rep : List AllocByte)
    (i : Nat) (hi : i < rep.length) (hBound : off ≤ old.length) :
    Trusted.MirSemantics.getElem? (spliceBytes old off rep) (off + i) =
      Trusted.MirSemantics.getElem? rep i := by
  unfold spliceBytes
  have hLen : (old.take off).length = off := s3_take_length_le old off hBound
  have hL : off + i < (old.take off ++ rep).length := by
    rw [List.length_append, hLen]
    exact Nat.add_lt_add_left hi off
  rw [s3_getElem?_append_left _ _ (off + i) hL]
  rw [s3_getElem?_append_right (old.take off) rep (off + i) (by rw [hLen]; exact Nat.le_add_right _ _)]
  rw [hLen, Nat.add_sub_cancel_left]

private theorem s3_spliceBytes_getElem?_ge (old : List AllocByte) (off : Nat) (rep : List AllocByte)
    (j : Nat) (hGe : off + rep.length ≤ j) (hBound : off ≤ old.length) :
    Trusted.MirSemantics.getElem? (spliceBytes old off rep) j =
      Trusted.MirSemantics.getElem? old j := by
  unfold spliceBytes
  have hLen : (old.take off).length = off := s3_take_length_le old off hBound
  have hAppLen : (old.take off ++ rep).length = off + rep.length := by
    rw [List.length_append, hLen]
  rw [s3_getElem?_append_right _ _ j (by rw [hAppLen]; exact hGe), hAppLen]
  rw [s3_drop_getElem?, s0_nat_add_sub_cancel' hGe]

private theorem s3_list_ext_mirGetElem? {α : Type} :
    ∀ (xs ys : List α),
      (∀ i : Nat, Trusted.MirSemantics.getElem? xs i = Trusted.MirSemantics.getElem? ys i) →
      xs = ys
  | [], [], _ => rfl
  | [], _ :: _, h => by have h0 := h 0; cases h0
  | _ :: _, [], h => by have h0 := h 0; cases h0
  | x :: xs, y :: ys, h => by
    have h0 : some x = some y := h 0
    cases h0
    have hTail := s3_list_ext_mirGetElem? xs ys (fun i => h (i + 1))
    rw [hTail]

private theorem s3_spliceBytes_append_single (old : List AllocByte) (off : Nat) (xs : List AllocByte)
    (b : AllocByte) (hBound : off + (xs.length + 1) ≤ old.length) :
    spliceBytes (spliceBytes old off xs) (off + xs.length) [b] =
      spliceBytes old off (xs ++ [b]) := by
  have hOffLe : off ≤ old.length := Nat.le_trans (Nat.le_add_right _ _) hBound
  have hBoundXs : off + xs.length ≤ old.length :=
    Nat.le_trans (Nat.add_le_add_left (Nat.le_succ _) off) hBound
  have hLenMid : (spliceBytes old off xs).length = old.length :=
    s3_spliceBytes_length old off xs hBoundXs
  apply s3_list_ext_mirGetElem?
  intro i
  cases Nat.lt_or_ge i off with
  | inl hiOff =>
    have hiMid : i < off + xs.length := Nat.lt_of_lt_of_le hiOff (Nat.le_add_right _ _)
    rw [s3_spliceBytes_getElem?_lt _ (off + xs.length) [b] i hiMid (by rw [hLenMid]; exact hBoundXs)]
    rw [s3_spliceBytes_getElem?_lt old off xs i hiOff hOffLe]
    rw [s3_spliceBytes_getElem?_lt old off (xs ++ [b]) i hiOff hOffLe]
  | inr hiGeOff =>
    have hk : ∃ k, i = off + k := ⟨i - off, (s0_nat_add_sub_cancel' hiGeOff).symm⟩
    cases hk with
    | intro k hkEq =>
      rw [hkEq]
      cases Nat.lt_or_ge k xs.length with
      | inl hkLt =>
        rw [s3_spliceBytes_getElem?_lt _ (off + xs.length) [b] (off + k)
          (Nat.add_lt_add_left hkLt off) (by rw [hLenMid]; exact hBoundXs)]
        rw [s3_spliceBytes_getElem?_mid old off xs k hkLt hOffLe]
        rw [s3_spliceBytes_getElem?_mid old off (xs ++ [b]) k
          (by rw [List.length_append]; exact Nat.lt_of_lt_of_le hkLt (Nat.le_add_right _ _)) hOffLe]
        rw [s3_getElem?_append_left xs [b] k hkLt]
      | inr hkGe =>
        cases Nat.eq_or_lt_of_le hkGe with
        | inl hkEqLen =>
          rw [← hkEqLen]
          have h0 : off + xs.length = (off + xs.length) + 0 := (Nat.add_zero _).symm
          have hLhs := s3_spliceBytes_getElem?_mid (spliceBytes old off xs) (off + xs.length) [b] 0
            Nat.zero_lt_one (by rw [hLenMid]; exact hBoundXs)
          rw [← h0] at hLhs
          rw [hLhs]
          rw [s3_spliceBytes_getElem?_mid old off (xs ++ [b]) xs.length
            (by rw [List.length_append]; exact Nat.lt_succ_self _) hOffLe]
          rw [s3_getElem?_append_right xs [b] xs.length (Nat.le_refl _), Nat.sub_self]
        | inr hkGt =>
          have hGe1 : off + xs.length + [b].length ≤ off + k := by
            change off + xs.length + 1 ≤ off + k
            rw [Nat.add_assoc]
            exact Nat.add_le_add_left hkGt off
          have hGe2 : off + (xs ++ [b]).length ≤ off + k := by
            rw [List.length_append]
            change off + (xs.length + 1) ≤ off + k
            exact Nat.add_le_add_left hkGt off
          rw [s3_spliceBytes_getElem?_ge _ (off + xs.length) [b] (off + k) hGe1
            (by rw [hLenMid]; exact hBoundXs)]
          rw [s3_spliceBytes_getElem?_ge old off xs (off + k) (Nat.add_le_add_left hkGe off) hOffLe]
          rw [s3_spliceBytes_getElem?_ge old off (xs ++ [b]) (off + k) hGe2 hOffLe]

/-! ## Section 4: `applyPtrScalarize` Unpack & Structural Correspondences -/

private structure s3_PtrCtx where
  plan : PtrScalarizePlan
  pSrc : MemCopyProgram
  pTgt : MemCopyProgram
  bodySrc : MemCopyBody
  bodyTgt : MemCopyBody
  hBodies : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId = some bodySrc
  hNoCaller : bodySrc.acceptsCallerMem = false
  hNonEmpty : bodySrc.basicBlocks.isEmpty = false
  hArgLt : bodySrc.argumentCount < bodySrc.locals.length
  hAnnot : memCopyStorageAnnotationsInBounds bodySrc = true
  hLocalsIb : memCopyBodyLocalsInBounds bodySrc = true
  hTargetsIb : memCopyBodyTargetsInBounds bodySrc = true
  hEntries : checkPtrBackingEntriesLoop bodySrc.locals bodySrc.argumentCount 0
    bodySrc.locals plan.entries = true
  hBlocksCheck : bodySrc.basicBlocks.all (fun bb =>
    bb.statements.all (checkStmtForPtrs bodySrc.locals plan.entries) &&
      checkTermForPtrs bodySrc.locals plan.entries bb.terminator) = true
  hSetBody : setElem? pSrc.bodies plan.defId bodyTgt = some pTgt.bodies
  hBodyTgtEq : bodyTgt = {
    bodySrc with
    locals := tombstonePtrDecls bodySrc.locals ++
      ptrCompDecls plan.entries.length ++ ptrScratchDecls
    basicBlocks :=
      let lowered := lowerBlocksForPtrsLoop bodySrc.locals plan.entries bodySrc.locals.length
        bodySrc.basicBlocks.length bodySrc.basicBlocks
      lowered.1 ++ lowered.2
  }
  hPtgtOther : pTgt.pointerWidthBits = pSrc.pointerWidthBits ∧
    pTgt.mirProfileVersion = pSrc.mirProfileVersion ∧
    pTgt.entryDefId = pSrc.entryDefId

private noncomputable def s3_applyPtrScalarize_unpack (plan : PtrScalarizePlan) (pSrc pTgt : MemCopyProgram)
    (hApp : applyPtrScalarize plan pSrc = some pTgt) :
    s3_PtrCtx := by
  unfold applyPtrScalarize at hApp
  cases hB : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => rw [hB] at hApp; cases hApp
  | some body =>
    rw [hB] at hApp; dsimp at hApp
    cases hPre1 : (body.acceptsCallerMem ||
        body.basicBlocks.isEmpty ||
        !Nat.blt body.argumentCount body.locals.length ||
        !memCopyStorageAnnotationsInBounds body ||
        !memCopyBodyLocalsInBounds body ||
        !memCopyBodyTargetsInBounds body ||
        !checkPtrBackingEntriesLoop body.locals body.argumentCount 0
          body.locals plan.entries) with
    | true => rw [hPre1] at hApp; cases hApp
    | false =>
      rw [hPre1] at hApp; dsimp at hApp
      cases hPre2 : (!body.basicBlocks.all (fun bb =>
          bb.statements.all (checkStmtForPtrs body.locals plan.entries) &&
            checkTermForPtrs body.locals plan.entries bb.terminator)) with
      | true => rw [hPre2] at hApp; cases hApp
      | false =>
        rw [hPre2] at hApp; dsimp at hApp
        cases hSet : setElem? pSrc.bodies plan.defId {
            body with
            locals := tombstonePtrDecls body.locals ++
              ptrCompDecls plan.entries.length ++ ptrScratchDecls
            basicBlocks :=
              (lowerBlocksForPtrsLoop body.locals plan.entries body.locals.length
                body.basicBlocks.length body.basicBlocks).1 ++
              (lowerBlocksForPtrsLoop body.locals plan.entries body.locals.length
                body.basicBlocks.length body.basicBlocks).2
          } with
        | none => rw [hSet] at hApp; cases hApp
        | some bodiesTgt =>
          rw [hSet] at hApp; cases hApp
          have hP1 : ∀ (a b : Bool), (a || b) = false → a = false ∧ b = false := by
            intro a b h; cases a <;> cases b <;> first | exact ⟨rfl, rfl⟩ | cases h
          have h1 := hP1 _ _ hPre1
          have h2 := hP1 _ _ h1.1
          have h3 := hP1 _ _ h2.1
          have h4 := hP1 _ _ h3.1
          have h5 := hP1 _ _ h4.1
          have h6 := hP1 _ _ h5.1
          exact {
            plan := plan
            pSrc := pSrc
            pTgt := { pSrc with bodies := bodiesTgt }
            bodySrc := body
            bodyTgt := {
              body with
              locals := tombstonePtrDecls body.locals ++
                ptrCompDecls plan.entries.length ++ ptrScratchDecls
              basicBlocks :=
                (lowerBlocksForPtrsLoop body.locals plan.entries body.locals.length
                  body.basicBlocks.length body.basicBlocks).1 ++
                (lowerBlocksForPtrsLoop body.locals plan.entries body.locals.length
                  body.basicBlocks.length body.basicBlocks).2
            }
            hBodies := hB
            hNoCaller := h6.1
            hNonEmpty := h6.2
            hArgLt := (nat_blt_eq_lt _ _).mp ((bool_not_eq_false _).mp h5.2)
            hAnnot := (bool_not_eq_false _).mp h4.2
            hLocalsIb := (bool_not_eq_false _).mp h3.2
            hTargetsIb := (bool_not_eq_false _).mp h2.2
            hEntries := (bool_not_eq_false _).mp h1.2
            hBlocksCheck := (bool_not_eq_false _).mp hPre2
            hSetBody := hSet
            hBodyTgtEq := rfl
            hPtgtOther := ⟨rfl, rfl, rfl⟩
          }

private theorem s3_tombstonePtrDecls_length (ds : List MemCopyLocalDecl) :
    (tombstonePtrDecls ds).length = ds.length := by
  induction ds with
  | nil => rfl
  | cons d rest ih =>
    cases d with
    | base _ | byteBuf _ _ _ =>
      change (tombstonePtrDecls rest).length + 1 = rest.length + 1; rw [ih]
    | ptrLocal =>
      change (tombstonePtrDecls rest).length + 1 = rest.length + 1; rw [ih]

private theorem s3_tombstonePtrDecls_getElem? :
    ∀ (ds : List MemCopyLocalDecl) (i : Nat),
      Trusted.MirSemantics.getElem? (tombstonePtrDecls ds) i =
        match Trusted.MirSemantics.getElem? ds i with
        | some .ptrLocal => some (.base .unit)
        | other => other
  | [], _ => rfl
  | d :: _, 0 => by cases d <;> rfl
  | d :: rest, i + 1 => by
    cases d with
    | base _ | byteBuf _ _ _ =>
      change Trusted.MirSemantics.getElem? (tombstonePtrDecls rest) i = _
      exact s3_tombstonePtrDecls_getElem? rest i
    | ptrLocal =>
      change Trusted.MirSemantics.getElem? (tombstonePtrDecls rest) i = _
      exact s3_tombstonePtrDecls_getElem? rest i

private theorem s3_ptrCompDecls_length (n : Nat) :
    (ptrCompDecls n).length = 3 * n := by
  induction n with
  | zero => rfl
  | succ k ih =>
    change (ptrCompDecls k).length + 3 = 3 * (k + 1)
    rw [ih, Nat.mul_add, Nat.mul_one]

private theorem s3_ptrCompDecls_getElem? :
    ∀ (n k : Nat),
      k < n →
      Trusted.MirSemantics.getElem? (ptrCompDecls n) (3 * k) = some (.base .unit) ∧
      Trusted.MirSemantics.getElem? (ptrCompDecls n) (3 * k + 1) = some (.base usizeTy) ∧
      Trusted.MirSemantics.getElem? (ptrCompDecls n) (3 * k + 2) = some (.base usizeTy)
  | 0, _, h => False.elim (Nat.not_lt_zero _ h)
  | _ + 1, 0, _ => ⟨rfl, rfl, rfl⟩
  | n + 1, k + 1, h => by
    have hk := s3_ptrCompDecls_getElem? n k (Nat.lt_of_succ_lt_succ h)
    have hEq0 : 3 * (k + 1) = (3 * k) + 3 := by rw [Nat.mul_add, Nat.mul_one]
    rw [hEq0]
    change Trusted.MirSemantics.getElem? (ptrCompDecls n) (3 * k) = some (MemCopyLocalDecl.base MirTy.unit) ∧
      Trusted.MirSemantics.getElem? (ptrCompDecls n) (3 * k + 1) = some (MemCopyLocalDecl.base usizeTy) ∧
        Trusted.MirSemantics.getElem? (ptrCompDecls n) (3 * k + 2) = some (MemCopyLocalDecl.base usizeTy)
    exact hk

private theorem s3_ptrScratchDecls_length : ptrScratchDecls.length = 12 := rfl

private theorem s3_ptrScratchDecls_getElem?_usize (j : Nat) (hj : j < 10) :
    Trusted.MirSemantics.getElem? ptrScratchDecls j = some (.base usizeTy) := by
  unfold ptrScratchDecls
  rw [s3_getElem?_append_left _ _ j (by rw [s3_listReplicate_length]; exact hj)]
  exact s3_listReplicate_getElem? 10 j (MemCopyLocalDecl.base usizeTy) hj

private theorem s3_ptrScratchDecls_getElem?_cond1 :
    Trusted.MirSemantics.getElem? ptrScratchDecls 10 = some (.base .bool) := rfl

private theorem s3_ptrScratchDecls_getElem?_cond2 :
    Trusted.MirSemantics.getElem? ptrScratchDecls 11 = some (.base .bool) := rfl

private theorem s3_checkPtrBackingEntriesLoop_len_le :
    ∀ (allDecls : List MemCopyLocalDecl) (argCount idx : Nat)
      (tailDecls : List MemCopyLocalDecl) (entries : List PtrBackingEntry),
      checkPtrBackingEntriesLoop allDecls argCount idx tailDecls entries = true →
      (∀ (j : Nat) (e : PtrBackingEntry),
        Trusted.MirSemantics.getElem? entries j = some e →
        e.ptrLocal < idx + tailDecls.length ∧ idx ≤ e.ptrLocal)
  | _, _, _, [], [], _ => fun _ e hGet => by cases hGet
  | _, _, _, [], _ :: _, h => by cases h
  | _, _, _, .ptrLocal :: _, [], h => by cases h
  | allDecls, argCount, idx, .ptrLocal :: restDecls, e :: restEntries, hChk => by
    unfold checkPtrBackingEntriesLoop at hChk
    have h1 := (bool_and_eq_true _ _).mp hChk
    have hRec := s3_checkPtrBackingEntriesLoop_len_le allDecls argCount (idx + 1) restDecls restEntries h1.2
    have hHead := (bool_and_eq_true _ _).mp h1.1
    have hHead2 := (bool_and_eq_true _ _).mp hHead.1
    have hLocEq : e.ptrLocal = idx := nat_beq_eq _ _ hHead2.1
    intro j e' hGet
    cases j with
    | zero =>
      cases hGet
      rw [hLocEq]
      exact ⟨Nat.add_lt_add_left (Nat.zero_lt_succ _) idx, Nat.le_refl _⟩
    | succ j' =>
      have hj := hRec j' e' hGet
      constructor
      · change e'.ptrLocal < idx + (restDecls.length + 1)
        have hL : idx + 1 + restDecls.length = idx + (restDecls.length + 1) := by
          rw [Nat.add_assoc, Nat.add_comm 1 restDecls.length]
        rw [← hL]; exact hj.1
      · exact Nat.le_trans (Nat.le_succ _) hj.2
  | allDecls, argCount, idx, .base _ :: restDecls, entries, hChk => by
    unfold checkPtrBackingEntriesLoop at hChk
    have hRec := s3_checkPtrBackingEntriesLoop_len_le allDecls argCount (idx + 1) restDecls entries hChk
    intro j e' hGet
    have hj := hRec j e' hGet
    constructor
    · change e'.ptrLocal < idx + (restDecls.length + 1)
      have hL : idx + 1 + restDecls.length = idx + (restDecls.length + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 restDecls.length]
      rw [← hL]; exact hj.1
    · exact Nat.le_trans (Nat.le_succ _) hj.2
  | allDecls, argCount, idx, .byteBuf _ _ _ :: restDecls, entries, hChk => by
    unfold checkPtrBackingEntriesLoop at hChk
    have h1 := (bool_and_eq_true _ _).mp hChk
    have hRec := s3_checkPtrBackingEntriesLoop_len_le allDecls argCount (idx + 1) restDecls entries h1.2
    intro j e' hGet
    have hj := hRec j e' hGet
    constructor
    · change e'.ptrLocal < idx + (restDecls.length + 1)
      have hL : idx + 1 + restDecls.length = idx + (restDecls.length + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 restDecls.length]
      rw [← hL]; exact hj.1
    · exact Nat.le_trans (Nat.le_succ _) hj.2

private theorem s3_checkPtrBackingEntriesLoop_spec :
    ∀ (allDecls : List MemCopyLocalDecl) (argCount idx : Nat)
      (tailDecls : List MemCopyLocalDecl) (entries : List PtrBackingEntry),
      checkPtrBackingEntriesLoop allDecls argCount idx tailDecls entries = true →
      (∀ (j : Nat) (e : PtrBackingEntry),
        Trusted.MirSemantics.getElem? entries j = some e →
        argCount < e.ptrLocal ∧
        Trusted.MirSemantics.getElem? tailDecls (e.ptrLocal - idx) = some .ptrLocal ∧
        (match e.backingBuf with
         | none => True
         | some bufLoc =>
           argCount < bufLoc ∧
           ∃ sz al mutab, Trusted.MirSemantics.getElem? allDecls bufLoc = some (.byteBuf sz al mutab) ∧
             sz ≤ 32 ∧ al ≤ 30)) ∧
      (∀ (p : Nat),
        Trusted.MirSemantics.getElem? tailDecls p = some .ptrLocal →
        ∃ (j : Nat) (e : PtrBackingEntry),
          Trusted.MirSemantics.getElem? entries j = some e ∧ e.ptrLocal = idx + p) ∧
      (∀ (p : Nat) (sz al : Nat) (mutab : Mutability),
        Trusted.MirSemantics.getElem? tailDecls p = some (.byteBuf sz al mutab) →
        argCount < idx + p ∧ sz ≤ 32 ∧ al ≤ 30) ∧
      (∀ (j₁ j₂ : Nat) (e₁ e₂ : PtrBackingEntry),
        Trusted.MirSemantics.getElem? entries j₁ = some e₁ →
        Trusted.MirSemantics.getElem? entries j₂ = some e₂ →
        e₁.ptrLocal = e₂.ptrLocal → j₁ = j₂)
  | _, _, _, [], [], _ =>
    ⟨(fun _ _ h => by cases h),
     (fun _ h => by cases h),
     (fun _ _ _ _ h => by cases h),
     (fun _ _ _ _ h => by cases h)⟩
  | _, _, _, [], _ :: _, h => by cases h
  | _, _, _, .ptrLocal :: _, [], h => by cases h
  | allDecls, argCount, idx, .ptrLocal :: restDecls, e :: restEntries, hChk => by
    unfold checkPtrBackingEntriesLoop at hChk
    have h1 := (bool_and_eq_true _ _).mp hChk
    have hRec := s3_checkPtrBackingEntriesLoop_spec allDecls argCount (idx + 1) restDecls restEntries h1.2
    have hRecBnd := s3_checkPtrBackingEntriesLoop_len_le allDecls argCount (idx + 1) restDecls restEntries h1.2
    have hHead := (bool_and_eq_true _ _).mp h1.1
    have hHead2 := (bool_and_eq_true _ _).mp hHead.1
    have hLocEq : e.ptrLocal = idx := nat_beq_eq _ _ hHead2.1
    have hArgLt : argCount < idx := (nat_blt_eq_lt _ _).mp hHead2.2
    have hBufProp : match e.backingBuf with
        | none => True
        | some bufLoc =>
          argCount < bufLoc ∧
          ∃ sz al mutab, Trusted.MirSemantics.getElem? allDecls bufLoc = some (.byteBuf sz al mutab) ∧
            sz ≤ 32 ∧ al ≤ 30 := by
      cases hEb : e.backingBuf with
      | none => exact True.intro
      | some bufLoc =>
        rw [hEb] at hHead
        have hB := (bool_and_eq_true _ _).mp hHead.2
        have hBufLt : argCount < bufLoc := (nat_blt_eq_lt _ _).mp hB.1
        cases hGetB : Trusted.MirSemantics.getElem? allDecls bufLoc with
        | none => rw [hGetB] at hB; cases hB.2
        | some dB =>
          rw [hGetB] at hB
          cases dB with
          | base _ | ptrLocal => cases hB.2
          | byteBuf sz al mutab =>
            have hSzAl := (bool_and_eq_true _ _).mp hB.2
            exact ⟨hBufLt, sz, al, mutab, hGetB, (nat_ble_eq_le _ _).mp hSzAl.1, (nat_ble_eq_le _ _).mp hSzAl.2⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro j e' hGet
      cases j with
      | zero =>
        cases hGet
        rw [hLocEq, Nat.sub_self]
        exact ⟨hArgLt, rfl, hBufProp⟩
      | succ j' =>
        have hJ := hRec.1 j' e' hGet
        have hB := hRecBnd j' e' hGet
        have hPos : 0 < e'.ptrLocal - idx := Nat.sub_pos_of_lt (Nat.lt_of_succ_le hB.2)
        have hEx : ∃ d, e'.ptrLocal - idx = d + 1 := ⟨e'.ptrLocal - idx - 1, (Nat.sub_add_cancel hPos).symm⟩
        cases hEx with
        | intro d hd =>
          have hdEq : d = e'.ptrLocal - (idx + 1) := by
            rw [Nat.sub_add_eq]
            exact (Nat.sub_eq_of_eq_add hd).symm
          refine ⟨hJ.1, ?_, hJ.2.2⟩
          rw [hd, hdEq]
          exact hJ.2.1
    · intro p hp
      cases p with
      | zero => exact ⟨0, e, rfl, hLocEq⟩
      | succ p' =>
        cases hRec.2.1 p' hp with
        | intro j' hj' =>
          cases hj' with
          | intro e' he' =>
            refine ⟨j' + 1, e', he'.1, ?_⟩
            rw [he'.2, Nat.add_assoc, Nat.add_comm 1 p']
    · intro p sz al mutab hp
      cases p with
      | zero => cases hp
      | succ p' =>
        have h := hRec.2.2.1 p' sz al mutab hp
        rw [Nat.add_assoc, Nat.add_comm 1 p'] at h
        exact h
    · intro j₁ j₂ e₁ e₂ h1' h2' hEq
      cases j₁ with
      | zero =>
        cases h1'
        cases j₂ with
        | zero => rfl
        | succ j₂' =>
          have hB := hRecBnd j₂' e₂ h2'
          rw [← hEq, hLocEq] at hB
          exact False.elim (Nat.not_succ_le_self _ hB.2)
      | succ j₁' =>
        cases j₂ with
        | zero =>
          cases h2'
          have hB := hRecBnd j₁' e₁ h1'
          rw [hEq, hLocEq] at hB
          exact False.elim (Nat.not_succ_le_self _ hB.2)
        | succ j₂' =>
          exact congrArg Nat.succ (hRec.2.2.2 j₁' j₂' e₁ e₂ h1' h2' hEq)
  | allDecls, argCount, idx, .base _ :: restDecls, entries, hChk => by
    unfold checkPtrBackingEntriesLoop at hChk
    have hRec := s3_checkPtrBackingEntriesLoop_spec allDecls argCount (idx + 1) restDecls entries hChk
    have hRecBnd := s3_checkPtrBackingEntriesLoop_len_le allDecls argCount (idx + 1) restDecls entries hChk
    refine ⟨?_, ?_, ?_, hRec.2.2.2⟩
    · intro j e hGet
      have hJ := hRec.1 j e hGet
      have hB := hRecBnd j e hGet
      have hPos : 0 < e.ptrLocal - idx := Nat.sub_pos_of_lt (Nat.lt_of_succ_le hB.2)
      have hEx : ∃ d, e.ptrLocal - idx = d + 1 := ⟨e.ptrLocal - idx - 1, (Nat.sub_add_cancel hPos).symm⟩
      cases hEx with
      | intro d hd =>
        have hdEq : d = e.ptrLocal - (idx + 1) := by
          rw [Nat.sub_add_eq]
          exact (Nat.sub_eq_of_eq_add hd).symm
        refine ⟨hJ.1, ?_, hJ.2.2⟩
        rw [hd, hdEq]
        exact hJ.2.1
    · intro p hp
      cases p with
      | zero => cases hp
      | succ p' =>
        cases hRec.2.1 p' hp with
        | intro j' hj' =>
          cases hj' with
          | intro e' he' =>
            refine ⟨j', e', he'.1, ?_⟩
            rw [he'.2, Nat.add_assoc, Nat.add_comm 1 p']
    · intro p sz al mutab hp
      cases p with
      | zero => cases hp
      | succ p' =>
        have h := hRec.2.2.1 p' sz al mutab hp
        rw [Nat.add_assoc, Nat.add_comm 1 p'] at h
        exact h
  | allDecls, argCount, idx, .byteBuf _ _ _ :: restDecls, entries, hChk => by
    unfold checkPtrBackingEntriesLoop at hChk
    have h1 := (bool_and_eq_true _ _).mp hChk
    have hRec := s3_checkPtrBackingEntriesLoop_spec allDecls argCount (idx + 1) restDecls entries h1.2
    have hRecBnd := s3_checkPtrBackingEntriesLoop_len_le allDecls argCount (idx + 1) restDecls entries h1.2
    have hHead := (bool_and_eq_true _ _).mp h1.1
    have hHead2 := (bool_and_eq_true _ _).mp hHead.1
    refine ⟨?_, ?_, ?_, hRec.2.2.2⟩
    · intro j e hGet
      have hJ := hRec.1 j e hGet
      have hB := hRecBnd j e hGet
      have hPos : 0 < e.ptrLocal - idx := Nat.sub_pos_of_lt (Nat.lt_of_succ_le hB.2)
      have hEx : ∃ d, e.ptrLocal - idx = d + 1 := ⟨e.ptrLocal - idx - 1, (Nat.sub_add_cancel hPos).symm⟩
      cases hEx with
      | intro d hd =>
        have hdEq : d = e.ptrLocal - (idx + 1) := by
          rw [Nat.sub_add_eq]
          exact (Nat.sub_eq_of_eq_add hd).symm
        refine ⟨hJ.1, ?_, hJ.2.2⟩
        rw [hd, hdEq]
        exact hJ.2.1
    · intro p hp
      cases p with
      | zero => cases hp
      | succ p' =>
        cases hRec.2.1 p' hp with
        | intro j' hj' =>
          cases hj' with
          | intro e' he' =>
            refine ⟨j', e', he'.1, ?_⟩
            rw [he'.2, Nat.add_assoc, Nat.add_comm 1 p']
    · intro p sz al mutab hp
      cases p with
      | zero =>
        cases hp
        rw [Nat.add_zero]
        exact ⟨(nat_blt_eq_lt _ _).mp hHead2.1, (nat_ble_eq_le _ _).mp hHead2.2, (nat_ble_eq_le _ _).mp hHead.2⟩
      | succ p' =>
        have h := hRec.2.2.1 p' sz al mutab hp
        rw [Nat.add_assoc, Nat.add_comm 1 p'] at h
        exact h

private theorem s3_findPtrEntryAux_iff :
    ∀ (entries : List PtrBackingEntry) (start pLoc k : Nat) (optBuf : Option LocalId),
      (∀ (j₁ j₂ : Nat) (e₁ e₂ : PtrBackingEntry),
        Trusted.MirSemantics.getElem? entries j₁ = some e₁ →
        Trusted.MirSemantics.getElem? entries j₂ = some e₂ →
        e₁.ptrLocal = e₂.ptrLocal → j₁ = j₂) →
      (findPtrEntryAux pLoc start entries = some (k, optBuf) ↔
        start ≤ k ∧ ∃ e, Trusted.MirSemantics.getElem? entries (k - start) = some e ∧
          e.ptrLocal = pLoc ∧ e.backingBuf = optBuf)
  | [], start, pLoc, k, optBuf, _ => by
    constructor
    · intro h; cases h
    · intro h; cases h.2 with | intro e he => cases he.1
  | e :: rest, start, pLoc, k, optBuf, hInj => by
    unfold findPtrEntryAux
    have hInjRest : ∀ (j₁ j₂ : Nat) (e₁ e₂ : PtrBackingEntry),
        Trusted.MirSemantics.getElem? rest j₁ = some e₁ →
        Trusted.MirSemantics.getElem? rest j₂ = some e₂ →
        e₁.ptrLocal = e₂.ptrLocal → j₁ = j₂ := fun j₁ j₂ e₁ e₂ h1 h2 heq =>
      Nat.succ.inj (hInj (j₁ + 1) (j₂ + 1) e₁ e₂ h1 h2 heq)
    cases hEq : Nat.beq e.ptrLocal pLoc with
    | true =>
      have hp : e.ptrLocal = pLoc := nat_beq_eq _ _ hEq
      dsimp
      constructor
      · intro h
        cases h
        exact ⟨Nat.le_refl _, e, by rw [Nat.sub_self]; rfl, hp, rfl⟩
      · intro h
        cases h.2 with
        | intro e' he' =>
          have hKS : k = start := by
            have h0 : k - start = 0 :=
              (hInj 0 (k - start) e e' rfl he'.1 (by rw [hp, he'.2.1])).symm
            have hAdd := s0_nat_add_sub_cancel' h.1
            rw [h0, Nat.add_zero] at hAdd
            exact hAdd.symm
          rw [hKS] at he'
          rw [Nat.sub_self] at he'
          have heEq : e = e' := by cases he'.1; rfl
          rw [hKS, heEq, he'.2.2]
    | false =>
      have hNe : e.ptrLocal ≠ pLoc := nat_beq_false_ne hEq
      dsimp
      have ih := s3_findPtrEntryAux_iff rest (start + 1) pLoc k optBuf hInjRest
      constructor
      · intro h
        have hr := ih.mp h
        have hLt : start < k := hr.1
        have hEx : ∃ d, k - start = d + 1 := ⟨k - start - 1, (Nat.sub_add_cancel (Nat.sub_pos_of_lt hLt)).symm⟩
        cases hEx with
        | intro d hd =>
          have hdEq : d = k - (start + 1) := by
            rw [Nat.sub_add_eq]
            exact (Nat.sub_eq_of_eq_add hd).symm
          refine ⟨Nat.le_of_lt hLt, ?_⟩
          rw [hd, hdEq]
          exact hr.2
      · intro h
        apply ih.mpr
        have hLt : start < k := by
          cases Nat.eq_or_lt_of_le h.1 with
          | inl hEqS =>
            rw [← hEqS, Nat.sub_self] at h
            cases h.2 with | intro e' he' =>
              cases he'.1
              exact False.elim (hNe he'.2.1)
          | inr hL => exact hL
        have hEx : ∃ d, k - start = d + 1 := ⟨k - start - 1, (Nat.sub_add_cancel (Nat.sub_pos_of_lt hLt)).symm⟩
        cases hEx with
        | intro d hd =>
          have hdEq : d = k - (start + 1) := by
            rw [Nat.sub_add_eq]
            exact (Nat.sub_eq_of_eq_add hd).symm
          refine ⟨hLt, ?_⟩
          rw [← hdEq]
          rw [hd] at h
          exact h.2

private theorem s3_findPtrEntry_some_iff (ctx : s3_PtrCtx) (pLoc k : Nat) (optBuf : Option LocalId) :
    findPtrEntry ctx.plan.entries pLoc = some (k, optBuf) ↔
      ∃ e, Trusted.MirSemantics.getElem? ctx.plan.entries k = some e ∧
        e.ptrLocal = pLoc ∧ e.backingBuf = optBuf := by
  have hSpec := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
    ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
  unfold findPtrEntry
  have h := s3_findPtrEntryAux_iff ctx.plan.entries 0 pLoc k optBuf hSpec.2.2.2
  rw [Nat.sub_zero] at h
  exact ⟨fun hp => (h.mp hp).2, fun hEx => h.mpr ⟨Nat.zero_le _, hEx⟩⟩

private theorem s3_findPtrEntry_none_iff (ctx : s3_PtrCtx) (pLoc : Nat) :
    findPtrEntry ctx.plan.entries pLoc = none ↔
      Trusted.MirSemantics.getElem? ctx.bodySrc.locals pLoc ≠ some .ptrLocal := by
  have hSpec := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals ctx.bodySrc.argumentCount 0
    ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
  constructor
  · intro hNone hPtr
    cases hSpec.2.1 pLoc hPtr with
    | intro j hj =>
      cases hj with
      | intro e he =>
        rw [Nat.zero_add] at he
        have hSome := (s3_findPtrEntry_some_iff ctx pLoc j e.backingBuf).mpr ⟨e, he.1, he.2, rfl⟩
        rw [hSome] at hNone
        cases hNone
  · intro hNotPtr
    cases hFind : findPtrEntry ctx.plan.entries pLoc with
    | none => rfl
    | some p =>
      have hEx := (s3_findPtrEntry_some_iff ctx pLoc p.fst p.snd).mp hFind
      cases hEx with
      | intro e he =>
        have h1 := hSpec.1 p.fst e he.1
        rw [Nat.sub_zero, he.2.1] at h1
        exact False.elim (hNotPtr h1.2.1)

private theorem s3_bodyTgt_locals_base (ctx : s3_PtrCtx) (id : Nat) (hid : id < ctx.bodySrc.locals.length) :
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals id =
      match Trusted.MirSemantics.getElem? ctx.bodySrc.locals id with
      | some .ptrLocal => some (.base .unit)
      | other => other := by
  rw [ctx.hBodyTgtEq]; dsimp
  have hTombLen : (tombstonePtrDecls ctx.bodySrc.locals).length = ctx.bodySrc.locals.length :=
    s3_tombstonePtrDecls_length ctx.bodySrc.locals
  have hLeftLen : (tombstonePtrDecls ctx.bodySrc.locals ++ ptrCompDecls ctx.plan.entries.length).length =
      ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length := by
    rw [List.length_append, hTombLen, s3_ptrCompDecls_length]
  rw [s3_getElem?_append_left _ _ id (by rw [hLeftLen]; exact Nat.lt_of_lt_of_le hid (Nat.le_add_right _ _))]
  rw [s3_getElem?_append_left _ _ id (by rw [hTombLen]; exact hid)]
  exact s3_tombstonePtrDecls_getElem? ctx.bodySrc.locals id

private theorem s3_bodyTgt_locals_comp (ctx : s3_PtrCtx) (k : Nat) (hk : k < ctx.plan.entries.length) :
    let off := ctx.bodySrc.locals.length + 3 * k
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals off = some (.base .unit) ∧
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals (off + 1) = some (.base usizeTy) ∧
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals (off + 2) = some (.base usizeTy) := by
  intro off
  rw [ctx.hBodyTgtEq]; dsimp
  have hTombLen : (tombstonePtrDecls ctx.bodySrc.locals).length = ctx.bodySrc.locals.length :=
    s3_tombstonePtrDecls_length ctx.bodySrc.locals
  have hLeftLen : (tombstonePtrDecls ctx.bodySrc.locals ++ ptrCompDecls ctx.plan.entries.length).length =
      ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length := by
    rw [List.length_append, hTombLen, s3_ptrCompDecls_length]
  have hBound : 3 * k + 3 ≤ 3 * ctx.plan.entries.length := by
    have h1 : 3 * (k + 1) ≤ 3 * ctx.plan.entries.length := Nat.mul_le_mul_left 3 hk
    rw [Nat.mul_add, Nat.mul_one] at h1
    exact h1
  have h0 : off < ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length :=
    Nat.add_lt_add_left (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.succ_pos 2)) hBound) _
  have h1 : off + 1 < ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length := by
    change ctx.bodySrc.locals.length + (3 * k + 1) < _
    exact Nat.add_lt_add_left (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 1 < 3) _) hBound) _
  have h2 : off + 2 < ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length := by
    change ctx.bodySrc.locals.length + (3 * k + 2) < _
    exact Nat.add_lt_add_left (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (by decide : 2 < 3) _) hBound) _
  have hSpec := s3_ptrCompDecls_getElem? ctx.plan.entries.length k hk
  refine ⟨?_, ?_, ?_⟩
  · rw [s3_getElem?_append_left _ _ off (by rw [hLeftLen]; exact h0)]
    rw [s3_getElem?_append_right _ _ off (by rw [hTombLen]; exact Nat.le_add_right _ _)]
    rw [hTombLen, Nat.add_sub_cancel_left]
    exact hSpec.1
  · rw [s3_getElem?_append_left _ _ (off + 1) (by rw [hLeftLen]; exact h1)]
    rw [s3_getElem?_append_right _ _ (off + 1) (by rw [hTombLen]; change ctx.bodySrc.locals.length ≤ ctx.bodySrc.locals.length + (3 * k + 1); exact Nat.le_add_right _ _)]
    rw [hTombLen]
    change Trusted.MirSemantics.getElem? (ptrCompDecls ctx.plan.entries.length) (ctx.bodySrc.locals.length + (3 * k + 1) - ctx.bodySrc.locals.length) = _
    rw [Nat.add_sub_cancel_left]
    exact hSpec.2.1
  · rw [s3_getElem?_append_left _ _ (off + 2) (by rw [hLeftLen]; exact h2)]
    rw [s3_getElem?_append_right _ _ (off + 2) (by rw [hTombLen]; change ctx.bodySrc.locals.length ≤ ctx.bodySrc.locals.length + (3 * k + 2); exact Nat.le_add_right _ _)]
    rw [hTombLen]
    change Trusted.MirSemantics.getElem? (ptrCompDecls ctx.plan.entries.length) (ctx.bodySrc.locals.length + (3 * k + 2) - ctx.bodySrc.locals.length) = _
    rw [Nat.add_sub_cancel_left]
    exact hSpec.2.2

private theorem s3_bodyTgt_locals_scratch (ctx : s3_PtrCtx) (j : Nat) (hj : j < 12) :
    let scrBase := ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals (scrBase + j) =
      if Nat.blt j 10 then some (.base usizeTy) else some (.base .bool) := by
  intro scrBase
  rw [ctx.hBodyTgtEq]; dsimp
  have hTombLen : (tombstonePtrDecls ctx.bodySrc.locals).length = ctx.bodySrc.locals.length :=
    s3_tombstonePtrDecls_length ctx.bodySrc.locals
  have hLeftLen : (tombstonePtrDecls ctx.bodySrc.locals ++ ptrCompDecls ctx.plan.entries.length).length = scrBase := by
    rw [List.length_append, hTombLen, s3_ptrCompDecls_length]
  rw [s3_getElem?_append_right _ _ (scrBase + j) (by rw [hLeftLen]; exact Nat.le_add_right _ _)]
  rw [hLeftLen, Nat.add_sub_cancel_left]
  cases hLt : Nat.blt j 10 with
  | true =>
    exact s3_ptrScratchDecls_getElem?_usize j ((nat_blt_eq_lt _ _).mp hLt)
  | false =>
    have hGe : 10 ≤ j := nat_blt_false_ge hLt
    cases Nat.eq_or_lt_of_le hGe with
    | inl h10 => rw [← h10]; exact s3_ptrScratchDecls_getElem?_cond1
    | inr hGt10 =>
      have h11 : j = 11 := nat_le_antisymm (Nat.le_of_lt_succ hj) hGt10
      rw [h11]; exact s3_ptrScratchDecls_getElem?_cond2

private theorem s3_lowerBlocksForPtrsLoop_spec :
    ∀ (decls : List MemCopyLocalDecl) (entries : List PtrBackingEntry)
      (base nextExtra : Nat) (bbs : List MemCopyBlock),
      let res := lowerBlocksForPtrsLoop decls entries base nextExtra bbs
      res.1.length = bbs.length ∧
      (∀ (i : Nat) (bb : MemCopyBlock),
        Trusted.MirSemantics.getElem? bbs i = some bb →
        ∃ (extraBase : Nat) (extraSelf : List MemCopyBlock),
          let pair := lowerTermForPtrs decls entries base extraBase bb.terminator
          nextExtra ≤ extraBase ∧
          pair.2.2 = extraSelf ∧
          Trusted.MirSemantics.getElem? res.1 i = some {
            bb with
            statements := listFlatMap (lowerStmtForPtrs decls entries base) bb.statements ++ pair.1
            terminator := pair.2.1
          } ∧
          (∀ (k : Nat) (eb : MemCopyBlock),
            Trusted.MirSemantics.getElem? extraSelf k = some eb →
            Trusted.MirSemantics.getElem? res.2 (extraBase - nextExtra + k) = some eb))
  | _, _, _, _, [] =>
    ⟨rfl, fun _ _ h => by cases h⟩
  | decls, entries, base, nextExtra, bb :: rest => by
    unfold lowerBlocksForPtrsLoop
    dsimp
    have ih := s3_lowerBlocksForPtrsLoop_spec decls entries base
      (nextExtra + (lowerTermForPtrs decls entries base nextExtra bb.terminator).2.2.length) rest
    constructor
    · change (lowerBlocksForPtrsLoop decls entries base
        (nextExtra + (lowerTermForPtrs decls entries base nextExtra bb.terminator).2.2.length) rest).1.length + 1 =
        rest.length + 1
      rw [ih.1]
    · intro i bb' hGet
      cases i with
      | zero =>
        cases hGet
        refine ⟨nextExtra, (lowerTermForPtrs decls entries base nextExtra bb.terminator).2.2,
          Nat.le_refl _, rfl, rfl, ?_⟩
        intro k eb hEb
        rw [Nat.sub_self, Nat.zero_add]
        rw [s3_getElem?_append_left _ _ k (s3_getElem?_some_lt _ _ _ hEb)]
        exact hEb
      | succ i' =>
        cases ih.2 i' bb' hGet with
        | intro eBase hRest =>
          cases hRest with
          | intro eSelf he =>
            let hE0 := (lowerTermForPtrs decls entries base nextExtra bb.terminator).2.2
            have hLe0 : nextExtra + hE0.length ≤ eBase := he.1
            have hLe : nextExtra ≤ eBase := Nat.le_trans (Nat.le_add_right _ _) hLe0
            refine ⟨eBase, eSelf, hLe, he.2.1, he.2.2.1, ?_⟩
            intro k eb hEb
            have h2 : nextExtra + (hE0.length + (eBase - (nextExtra + hE0.length))) = eBase := by
              rw [← Nat.add_assoc]; exact s0_nat_add_sub_cancel' hLe0
            have h1 : eBase - nextExtra = hE0.length + (eBase - (nextExtra + hE0.length)) :=
              Nat.sub_eq_of_eq_add (by rw [Nat.add_comm]; exact h2.symm)
            have hIdxEq : eBase - nextExtra + k = hE0.length + (eBase - (nextExtra + hE0.length) + k) := by
              rw [h1, Nat.add_assoc]
            rw [hIdxEq]
            change Trusted.MirSemantics.getElem?
                (hE0 ++ (lowerBlocksForPtrsLoop decls entries base (nextExtra + hE0.length) rest).snd)
                (hE0.length + (eBase - (nextExtra + hE0.length) + k)) = some eb
            rw [s3_getElem?_append_right hE0 _ (hE0.length + (eBase - (nextExtra + hE0.length) + k)) (Nat.le_add_right _ _)]
            rw [Nat.add_sub_cancel_left]
            exact he.2.2.2 k eb hEb

private theorem s3_bodyTgt_block_lookup (ctx : s3_PtrCtx) (bbIdx : Nat) (bb : MemCopyBlock)
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bb) :
    ∃ (extraBase : Nat) (extraSelf : List MemCopyBlock),
      let pair := lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length extraBase bb.terminator
      pair.2.2 = extraSelf ∧
      ctx.bodySrc.basicBlocks.length ≤ extraBase ∧
      Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some {
        bb with
        statements := listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) bb.statements ++ pair.1
        terminator := pair.2.1
      } ∧
      (∀ (k : Nat) (eb : MemCopyBlock),
        Trusted.MirSemantics.getElem? extraSelf k = some eb →
        Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks (extraBase + k) = some eb) := by
  have hSpec := s3_lowerBlocksForPtrsLoop_spec ctx.bodySrc.locals ctx.plan.entries
    ctx.bodySrc.locals.length ctx.bodySrc.basicBlocks.length ctx.bodySrc.basicBlocks
  cases hSpec.2 bbIdx bb hBb with
  | intro extraBase hR =>
    cases hR with
    | intro extraSelf hE =>
      have hBbLt : bbIdx < ctx.bodySrc.basicBlocks.length := s3_getElem?_some_lt _ _ _ hBb
      have hL1 : (lowerBlocksForPtrsLoop ctx.bodySrc.locals ctx.plan.entries
          ctx.bodySrc.locals.length ctx.bodySrc.basicBlocks.length ctx.bodySrc.basicBlocks).1.length =
          ctx.bodySrc.basicBlocks.length := hSpec.1
      refine ⟨extraBase, extraSelf, hE.2.1, hE.1, ?_, ?_⟩
      · rw [ctx.hBodyTgtEq]; dsimp
        rw [s3_getElem?_append_left _ _ bbIdx (by rw [hL1]; exact hBbLt)]
        exact hE.2.2.1
      · intro k eb hEb
        rw [ctx.hBodyTgtEq]; dsimp
        rw [s3_getElem?_append_right _ _ (extraBase + k) (by rw [hL1]; exact Nat.le_trans hE.1 (Nat.le_add_right _ _))]
        rw [hL1, s0_nat_sub_add_comm hE.1]
        exact hE.2.2.2 k eb hEb

/-! ## Section 5: Multi-Step `ReachesPlusMemCopy` & Primitive Statement Executors -/

private theorem s3_reachesPlus_to_reaches {p : MemCopyProgram} {s₁ s₂ : MemCopyState}
    (h : ReachesPlusMemCopy p s₁ s₂) : ReachesMemCopy p s₁ s₂ :=
  reachesMemCopy_of_reachesPlusMemCopy h

private theorem s3_step_reachesPlus {p : MemCopyProgram} {s₁ s₂ : MemCopyState}
    (h : evalStepMemCopy p 0 s₁ = .step s₂) : ReachesPlusMemCopy p s₁ s₂ := by
  have hS := (stepMemCopy_iff_evalStep p s₁ (.step s₂)).mpr h
  exact ⟨0, ReachesNMemCopy.succ hS (ReachesNMemCopy.zero s₂)⟩

private theorem s3_reachesPlus_trans {p : MemCopyProgram} {s₁ s₂ s₃ : MemCopyState}
    (h₁ : ReachesPlusMemCopy p s₁ s₂) (h₂ : ReachesMemCopy p s₂ s₃) :
    ReachesPlusMemCopy p s₁ s₃ := by
  cases h₁ with
  | intro n hn =>
    cases reachesNMemCopy_of_reachesMemCopy h₂ with
    | intro m hm =>
      have hTr := reachesNMemCopy_trans hn hm
      have hEq : n + 1 + m = (n + m) + 1 := by
        rw [Nat.add_assoc, Nat.add_comm 1 m, ← Nat.add_assoc]
      rw [hEq] at hTr
      exact ⟨n + m, hTr⟩

private theorem s3_reaches_trans_plus {p : MemCopyProgram} {s₁ s₂ s₃ : MemCopyState}
    (h₁ : ReachesMemCopy p s₁ s₂) (h₂ : ReachesPlusMemCopy p s₂ s₃) :
    ReachesPlusMemCopy p s₁ s₃ := by
  cases reachesNMemCopy_of_reachesMemCopy h₁ with
  | intro n hn =>
    cases h₂ with
    | intro m hm =>
      have hTr := reachesNMemCopy_trans hn hm
      have hEq : n + (m + 1) = (n + m) + 1 := (Nat.add_assoc n m 1).symm
      rw [hEq] at hTr
      exact ⟨n + m, hTr⟩

private theorem s3_step_state_of_stmt (p : MemCopyProgram) (frame : MemCopyFrame) (mem : CallerMemory)
    (body : MemCopyBody) (bb : MemCopyBlock) (stmt : MemCopyStmt)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some stmt) :
    evalStepMemCopy p 0 { frames := [frame], mem := mem } = evalMemCopyStmt body frame mem stmt := by
  unfold evalStepMemCopy
  dsimp
  rw [hBody]; dsimp
  rw [hBb]; dsimp
  rw [hStmt]

private theorem s3_step_state_of_term (p : MemCopyProgram) (frame : MemCopyFrame) (mem : CallerMemory)
    (body : MemCopyBody) (bb : MemCopyBlock)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hIdx : frame.stmtIdx = bb.statements.length) :
    evalStepMemCopy p 0 { frames := [frame], mem := mem } = evalMemCopyTerm body bb frame mem := by
  unfold evalStepMemCopy
  dsimp
  rw [hBody]; dsimp
  rw [hBb]; dsimp
  have hNone : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = none :=
    s3_getElem?_ge_none _ _ (by rw [hIdx]; exact Nat.le_refl _)
  rw [hNone]; dsimp
  rw [hIdx, nat_beq_refl]
  rfl

private theorem s3_exec_one_stmt_ok (p : MemCopyProgram) (defId : DefId) (bbIdx : BasicBlockId)
    (body : MemCopyBody) (bb : MemCopyBlock) (idx : Nat) (stmt : MemCopyStmt)
    (slots slots' : List MemCopySlot) (mem mem' : CallerMemory)
    (hBody : Trusted.MirSemantics.getElem? p.bodies defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements idx = some stmt)
    (hEval : evalMemCopyStmt body { defId := defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots } mem stmt =
      stepMemCopyNext { defId := defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots } mem' slots') :
    ReachesPlusMemCopy p
      { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots }], mem := mem }
      { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots' }], mem := mem' } := by
  apply s3_step_reachesPlus
  rw [s3_step_state_of_stmt p _ mem body bb stmt hBody hBb hStmt]
  exact hEval

private theorem s3_exec_one_stmt_fault (p : MemCopyProgram) (defId : DefId) (bbIdx : BasicBlockId)
    (body : MemCopyBody) (bb : MemCopyBlock) (idx : Nat) (stmt : MemCopyStmt)
    (slots : List MemCopySlot) (mem : CallerMemory) (k : FaultKind)
    (hBody : Trusted.MirSemantics.getElem? p.bodies defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements idx = some stmt)
    (hEval : evalMemCopyStmt body { defId := defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots } mem stmt =
      .fault k) :
    StepMemCopy p { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots }], mem := mem } (.fault k) := by
  apply (stepMemCopy_iff_evalStep p _ (.fault k)).mpr
  rw [s3_step_state_of_stmt p _ mem body bb stmt hBody hBb hStmt]
  exact hEval

private theorem s3_exec_term_fault (p : MemCopyProgram) (defId : DefId) (bbIdx : BasicBlockId)
    (body : MemCopyBody) (bb : MemCopyBlock) (slots : List MemCopySlot) (mem : CallerMemory) (k : FaultKind)
    (hBody : Trusted.MirSemantics.getElem? p.bodies defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx = some bb)
    (hEval : evalMemCopyTerm body bb { defId := defId, blockIdx := bbIdx, stmtIdx := bb.statements.length, locals := slots } mem =
      .fault k) :
    StepMemCopy p
      { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := bb.statements.length, locals := slots }], mem := mem }
      (.fault k) := by
  apply (stepMemCopy_iff_evalStep p _ (.fault k)).mpr
  rw [s3_step_state_of_term p _ mem body bb hBody hBb rfl]
  exact hEval

private theorem s3_exec_term_done (p : MemCopyProgram) (defId : DefId) (bbIdx : BasicBlockId)
    (body : MemCopyBody) (bb : MemCopyBlock) (slots : List MemCopySlot) (mem : CallerMemory) (out : TerminalOut)
    (hBody : Trusted.MirSemantics.getElem? p.bodies defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx = some bb)
    (hEval : evalMemCopyTerm body bb { defId := defId, blockIdx := bbIdx, stmtIdx := bb.statements.length, locals := slots } mem =
      .done out) :
    StepMemCopy p
      { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := bb.statements.length, locals := slots }], mem := mem }
      (.done out) := by
  apply (stepMemCopy_iff_evalStep p _ (.done out)).mpr
  rw [s3_step_state_of_term p _ mem body bb hBody hBb rfl]
  exact hEval

private theorem s3_exec_term_jump (p : MemCopyProgram) (defId : DefId) (bbIdx : BasicBlockId)
    (body : MemCopyBody) (bb : MemCopyBlock) (slots slots' : List MemCopySlot) (mem mem' : CallerMemory)
    (target : BasicBlockId)
    (hBody : Trusted.MirSemantics.getElem? p.bodies defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx = some bb)
    (hEval : evalMemCopyTerm body bb { defId := defId, blockIdx := bbIdx, stmtIdx := bb.statements.length, locals := slots } mem =
      jumpMemCopyBlock { defId := defId, blockIdx := bbIdx, stmtIdx := bb.statements.length, locals := slots } mem' slots' target) :
    ReachesPlusMemCopy p
      { frames := [{ defId := defId, blockIdx := bbIdx, stmtIdx := bb.statements.length, locals := slots }], mem := mem }
      { frames := [{ defId := defId, blockIdx := target, stmtIdx := 0, locals := slots' }], mem := mem' } := by
  apply s3_step_reachesPlus
  rw [s3_step_state_of_term p _ mem body bb hBody hBb rfl]
  exact hEval

private theorem s3_eval_mkLivenessCheckStmt_ok (body : MemCopyBody) (frame : MemCopyFrame) (mem : CallerMemory)
    (liveLoc : LocalId) (ov : Option Val) (slots' : List MemCopySlot)
    (hDecl : Trusted.MirSemantics.getElem? body.locals liveLoc = some (.base .unit))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals liveLoc = some (.baseSlot (.live ov)))
    (hSet : setElem? frame.locals liveLoc (.baseSlot (.live (some .unit))) = some slots') :
    evalMemCopyStmt body frame mem (mkLivenessCheckStmt liveLoc) =
      stepMemCopyNext frame mem slots' := by
  unfold mkLivenessCheckStmt evalMemCopyStmt
  dsimp
  rw [hDecl]; dsimp
  have hRv : evalMemCopyBaseRvalue body.locals frame.locals .unit
      (.use (.constant { ty := .unit, lit := .zeroSized })) = .ok (.unit, frame.locals) := rfl
  rw [hRv]; dsimp
  unfold writeMemCopyBasePlace
  have hChk : checkVal .unit .unit = true := rfl
  rw [hChk]; dsimp
  rw [hSlot]; dsimp
  rw [hSet]

private theorem s3_eval_mkLivenessCheckStmt_dead (body : MemCopyBody) (frame : MemCopyFrame) (mem : CallerMemory)
    (liveLoc : LocalId)
    (hDecl : Trusted.MirSemantics.getElem? body.locals liveLoc = some (.base .unit))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals liveLoc = some (.baseSlot .dead)) :
    evalMemCopyStmt body frame mem (mkLivenessCheckStmt liveLoc) = .fault .undefined := by
  unfold mkLivenessCheckStmt evalMemCopyStmt
  dsimp
  rw [hDecl]; dsimp
  have hRv : evalMemCopyBaseRvalue body.locals frame.locals .unit
      (.use (.constant { ty := .unit, lit := .zeroSized })) = .ok (.unit, frame.locals) := rfl
  rw [hRv]; dsimp
  unfold writeMemCopyBasePlace
  have hChk : checkVal .unit .unit = true := rfl
  rw [hChk]; dsimp
  rw [hSlot]

private theorem s3_eval_mkImmediateUbStmt (body : MemCopyBody) (frame : MemCopyFrame) (mem : CallerMemory)
    (scr : LocalId)
    (hDecl : Trusted.MirSemantics.getElem? body.locals scr = some (.base usizeTy)) :
    evalMemCopyStmt body frame mem (mkImmediateUbStmt scr) = .fault .undefined := by
  unfold mkImmediateUbStmt evalMemCopyStmt
  dsimp
  rw [hDecl]; dsimp
  unfold evalMemCopyBaseRvalue
  dsimp
  have h0 : evalMemCopyPrimitiveOperand body.locals frame.locals (usizeConst 0) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 0 }, frame.locals) := by
    unfold evalMemCopyPrimitiveOperand evalMemCopyBaseOperandToSlot usizeConst
    dsimp
    rw [s3_evalConstLit_usize 0 (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)]
    rfl
  have h1 : evalMemCopyPrimitiveOperand body.locals frame.locals (usizeConst 1) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 1 }, frame.locals) := by
    unfold evalMemCopyPrimitiveOperand evalMemCopyBaseOperandToSlot usizeConst
    dsimp
    rw [s3_evalConstLit_usize 1 (by decide : 1 < maxUsize)]
    rfl
  rw [h0]; dsimp
  rw [h1]; dsimp
  rw [s3_evalBinOp_usize_subUnchecked_err 0 1 (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64) (by decide : 1 < maxUsize) Nat.zero_lt_one]

private theorem s3_eval_mkAssignUse_usizeConst (body : MemCopyBody) (frame : MemCopyFrame) (mem : CallerMemory)
    (dst n : Nat) (ov : Option Val) (slots' : List MemCopySlot)
    (hn : n < maxUsize)
    (hDecl : Trusted.MirSemantics.getElem? body.locals dst = some (.base usizeTy))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals dst = some (.baseSlot (.live ov)))
    (hSet : setElem? frame.locals dst (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))) = some slots') :
    evalMemCopyStmt body frame mem (mkAssignUse dst (usizeConst n)) =
      stepMemCopyNext frame mem slots' := by
  unfold mkAssignUse usizeConst evalMemCopyStmt
  dsimp
  rw [hDecl]; dsimp
  unfold evalMemCopyBaseRvalue evalMemCopyBaseOperandToSlot
  dsimp
  rw [s3_evalConstLit_usize n hn]; dsimp
  have hTy : MirTy.beq usizeTy usizeTy = true := rfl
  rw [hTy]; dsimp
  unfold writeMemCopyBasePlace
  rw [s3_usize_scalar_checkVal n hn]; dsimp
