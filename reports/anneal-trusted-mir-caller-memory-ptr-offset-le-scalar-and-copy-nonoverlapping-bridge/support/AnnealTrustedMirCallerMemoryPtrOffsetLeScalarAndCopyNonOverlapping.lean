/-- Theorem 4: Valid `checkMemCopyToTrustedMir` lowering preserves
well-formedness, observable behavior, faults, divergence, and postconditions
between `MemCopyProgram` and Trusted MIR `Program`. -/
private theorem memAllocScalarize_reduces_to_trusted_mir_slice5
    (trace : MemCopyOptTrace) (pSrc : MemCopyProgram) (pMir : Program)
    (hLower : checkMemCopyToTrustedMir trace pSrc pMir = true) :
    (∀ q : Query, WellFormedMemCopy pSrc q ↔ WellFormed pMir q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorMemCopy pSrc q out ↔ Behavior pMir q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultMemCopy pSrc q (.fault k) ↔
        ReachesResult pMir q (.fault k)) ∧
    (∀ q : Query, DivergesMemCopy pSrc q ↔ Diverges pMir q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostMemCopy pSrc q post ↔ SatisfiesPost pMir q post) :=
  s5_memAllocScalarize_reduces_of_ptrScalarize applyPtrScalarize_sound
    trace pSrc pMir hLower

/-- Theorem 5: Valid `checkMemCopyToTrustedMir` lowering followed by any
`FullSemanticEquivBase` base-MIR optimization pipeline transports all
verification conditions from `pSrc` to `pOpt`. -/
private theorem memCopyPipeline_then_optPipeline_vc_transport_slice5
    (trace : MemCopyOptTrace) (pSrc : MemCopyProgram) (pMir pOpt : Program)
    (hLower : checkMemCopyToTrustedMir trace pSrc pMir = true)
    (hOpt : FullSemanticEquivBase pMir pOpt) :
    (∀ q : Query, WellFormedMemCopy pSrc q ↔ WellFormed pOpt q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorMemCopy pSrc q out ↔ Behavior pOpt q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultMemCopy pSrc q (.fault k) ↔
        ReachesResult pOpt q (.fault k)) ∧
    (∀ q : Query, DivergesMemCopy pSrc q ↔ Diverges pOpt q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostMemCopy pSrc q post ↔ SatisfiesPost pOpt q post) :=
  s5_vc_transport_of_reduces pSrc pMir pOpt
    (memAllocScalarize_reduces_to_trusted_mir_slice5 trace pSrc pMir hLower) hOpt

/-! ## Part III: Five Core Target Theorems Directly Over Unmodified `Trusted.MirSemantics` -/

/-- **Theorem 1 (`memcopy_conservative_extension_exact`):**
Canonical embedding `embedBaseProgram p` of any unmodified
`Trusted.MirAst.Program` into `M_memcopy` preserves exact 1-step operational
behavior (`evalStepMemCopy` = `liftStepResultMemCopy ∘ evalStep`) and exact
bidirectional equivalence (`↔`) across `WellFormed`, `Behavior`,
`ReachesResult (.fault k)`, `Diverges`, and `SatisfiesPost`. -/
theorem memcopy_conservative_extension_exact
    (p : Program) :
    (∀ (c : Choice) (s : State),
      evalStepMemCopy (embedBaseProgram p) c (embedMemCopyState s) =
        liftStepResultMemCopy (evalStep p c s)) ∧
    (∀ q : Query,
      (WellFormedMemCopy (embedBaseProgram p) q ↔ WellFormed p q) ∧
      (∀ out : TerminalOut,
        BehaviorMemCopy (embedBaseProgram p) q out ↔ Behavior p q out) ∧
      (∀ k : FaultKind,
        ReachesResultMemCopy (embedBaseProgram p) q (.fault k) ↔
          ReachesResult p q (.fault k)) ∧
      (DivergesMemCopy (embedBaseProgram p) q ↔ Diverges p q) ∧
      (∀ post : TerminalOut → Prop,
        SatisfiesPostMemCopy (embedBaseProgram p) q post ↔
          SatisfiesPost p q post)) := by
  exact memcopy_conservative_extension_exact_slice1 p

/-- **Theorem 2 (`foldZeroOffset_and_guardedZeroCopy_sound_bidirectional_iff`):**
Statement-level zero-offset folding (`checkFoldZeroOffsetStmt`),
terminator-level zero-offset folding (`checkFoldZeroOffsetTerm`), and
alignment/non-null-guarded zero-length `copy_nonoverlapping` folding
(`checkFoldGuardedZeroCopy`) all preserve full bidirectional semantic
equivalence `FullSemanticEquivMemCopy pSrc pTgt` across all `Query` values
(including external `CallerMemory` invocations). -/
theorem foldZeroOffset_and_guardedZeroCopy_sound_bidirectional_iff :
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (stmtIdx : Nat)
        (pSrc pTgt : MemCopyProgram),
      checkFoldZeroOffsetStmt bodyId bbIdx stmtIdx pSrc pTgt = true →
      FullSemanticEquivMemCopy pSrc pTgt) ∧
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (pSrc pTgt : MemCopyProgram),
      checkFoldZeroOffsetTerm bodyId bbIdx pSrc pTgt = true →
      FullSemanticEquivMemCopy pSrc pTgt) ∧
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (pSrc pTgt : MemCopyProgram),
      checkFoldGuardedZeroCopy bodyId bbIdx pSrc pTgt = true →
      FullSemanticEquivMemCopy pSrc pTgt) := by
  exact foldZeroOffset_and_guardedZeroCopy_sound_bidirectional_iff_slice2

/-- **Theorem 3 (`inboundsOffset_leRoundTrip_and_copyNonOverlapping_laws`):**
Universal algebraic and operational laws of `M_memcopy` pointers, endian
encoding, and `copy_nonoverlapping`:
1. **Zero-Delta `calcInboundsOffset` Identity:** Whenever `count * elemSize = 0`,
   `calcInboundsOffset mem pv count elemSize = .ok { pv with width := .isize }`
   for every `pv` (including `null` and `NonNull::dangling()`) and `mem`.
2. **Wrapping Offset Opposite-Sign Round-Trip:** Applying `calcWrappingOffset`
   with `+count` followed by `-count` for any `count : Int` and `elemSize : Nat`
   recovers `{ pv with width := .isize }` even across out-of-bounds excursions.
3. **Little-Endian Encode/Decode Round-Trip & Provenance Firewall:** For every
   `w : LeWidth` and `n < 2^w.bitWidth`,
   `decodeLeUsize w (encodeLeUsize w n) = .ok n`, whereas `decodeLeUsize` faults
   `.error .undefined` on any byte list of length `w.byteCount` containing
   `.uninit` or `AllocByte.init _ (some aid)` (`ReadPointerAsInt`), while
   `decodePtrLe8 (encodeLeBytesAux prov 8 off)` recovers `{ allocId := prov,
   offsetBytes := UInt64.ofNat off, width := .isize }` for every `off < 2^64`.
4. **Zero-Byte `copy_nonoverlapping` Exact Characterization:** When
   `reqAlignLog2 ≤ 30` and `elemSize * count = 0`,
   `evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2 checkNonNullZero`
   equals `.ok mem` iff both `checkPtrAlignMem mem pvSrc reqAlignLog2 = .ok ()`
   and `checkPtrAlignMem mem pvDst reqAlignLog2 = .ok ()` and
   `¬ (checkNonNullZero = true ∧ (isNullPtr pvSrc = true ∨ isNullPtr pvDst = true))`,
   and otherwise faults `.error .undefined`. -/
theorem inboundsOffset_leRoundTrip_and_copyNonOverlapping_laws :
    (∀ (mem : CallerMemory) (pv : PtrVal) (count : Int) (elemSize : Nat),
      count * Int.ofNat elemSize = 0 →
      calcInboundsOffset mem pv count elemSize =
        .ok { pv with width := .isize }) ∧
    (∀ (pv : PtrVal) (count : Int) (elemSize : Nat),
      calcWrappingOffset (calcWrappingOffset pv count elemSize) (Neg.neg count) elemSize =
        { pv with width := .isize }) ∧
    (∀ (w : LeWidth) (n : Nat),
      n < Nat.pow 2 w.bitWidth →
      decodeLeUsize w (encodeLeUsize w n) = .ok n) ∧
    (∀ (w : LeWidth) (bs : List AllocByte),
      Nat.beq bs.length w.byteCount = true →
      bs.any (fun ab => match ab with | .init _ none => false | _ => true) = true →
      decodeLeUsize w bs = .error .undefined) ∧
    (∀ (prov : Option AllocId) (off : Nat),
      off < maxUsize →
      decodePtrLe8 (encodeLeBytesAux prov 8 off) =
        .ok { allocId := prov, offsetBytes := UInt64.ofNat off, width := .isize }) ∧
    (∀ (mem : CallerMemory) (pvSrc pvDst : PtrVal)
        (count elemSize reqAlignLog2 : Nat) (checkNonNullZero : Bool),
      Nat.ble reqAlignLog2 30 = true →
      elemSize * count = 0 →
      ((evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
          checkNonNullZero = .ok mem ↔
        (checkPtrAlignMem mem pvSrc reqAlignLog2 = .ok () ∧
         checkPtrAlignMem mem pvDst reqAlignLog2 = .ok () ∧
         ¬ (checkNonNullZero = true ∧
            (isNullPtr pvSrc = true ∨ isNullPtr pvDst = true)))) ∧
       (evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
          checkNonNullZero ≠ .ok mem →
        evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
          checkNonNullZero = .error .undefined))) := by
  exact inboundsOffset_leRoundTrip_and_copyNonOverlapping_laws_slice1

/-- **Theorem 4 (`memAllocScalarize_reduces_to_trusted_mir`):**
Any finite `MemCopyOptTrace` certified by
`checkMemCopyToTrustedMir trace pSrc pMir = true` produces an unmodified
`Trusted.MirAst.Program` (`pMir`) whose unmodified `Trusted.MirSemantics`
judgments (`WellFormed`, `Behavior`, `ReachesResult (.fault k)`, `Diverges`,
and `SatisfiesPost`) are bidirectionally equivalent (`↔`) to `M_memcopy` on
`pSrc`. -/
theorem memAllocScalarize_reduces_to_trusted_mir
    (trace : MemCopyOptTrace) (pSrc : MemCopyProgram) (pMir : Program)
    (hLower : checkMemCopyToTrustedMir trace pSrc pMir = true) :
    (∀ q : Query, WellFormedMemCopy pSrc q ↔ WellFormed pMir q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorMemCopy pSrc q out ↔ Behavior pMir q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultMemCopy pSrc q (.fault k) ↔
        ReachesResult pMir q (.fault k)) ∧
    (∀ q : Query, DivergesMemCopy pSrc q ↔ Diverges pMir q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostMemCopy pSrc q post ↔ SatisfiesPost pMir q post) := by
  exact memAllocScalarize_reduces_to_trusted_mir_slice5 trace pSrc pMir hLower

/-- **Theorem 5 (`memCopyPipeline_then_optPipeline_vc_transport`):**
Vertical composition: any certified `MemCopyOptTrace` lowering `pSrc` into
unmodified `Trusted.MirAst.Program` `pMir` followed by any certified
`Trusted.MirSemantics` optimization equivalence `FullSemanticEquivBase pMir pOpt`
transports all five `M_memcopy` verification judgments bidirectionally (`↔`)
onto unmodified `Trusted.MirSemantics` on `pOpt`. -/
theorem memCopyPipeline_then_optPipeline_vc_transport
    (trace : MemCopyOptTrace) (pSrc : MemCopyProgram) (pMir pOpt : Program)
    (hLower : checkMemCopyToTrustedMir trace pSrc pMir = true)
    (hOpt : FullSemanticEquivBase pMir pOpt) :
    (∀ q : Query, WellFormedMemCopy pSrc q ↔ WellFormed pOpt q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorMemCopy pSrc q out ↔ Behavior pOpt q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultMemCopy pSrc q (.fault k) ↔
        ReachesResult pOpt q (.fault k)) ∧
    (∀ q : Query, DivergesMemCopy pSrc q ↔ Diverges pOpt q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostMemCopy pSrc q post ↔ SatisfiesPost pOpt q post) := by
  exact memCopyPipeline_then_optPipeline_vc_transport_slice5
    trace pSrc pMir pOpt hLower hOpt

/-! ## Part IV: Bounded-Fuel Adequacy, Eleven Sharpness Witnesses (`CE1`--`CE11`), & End-to-End `Trusted.MirSemantics` Lowering Witness (`0` `sorry`) -/

noncomputable def execFuelMemCopy (p : MemCopyProgram) :
    Nat → MemCopyState → Option (StepResult MemCopyState TerminalOut)
  | 0, _ => none
  | fuel + 1, s =>
    match evalStepMemCopy p 0 s with
    | .step s' => execFuelMemCopy p fuel s'
    | .done out => some (.done out)
    | .fault k => some (.fault k)

noncomputable def execMemCopy (p : MemCopyProgram) (q : Query) (fuel : Nat) :
    Option (StepResult MemCopyState TerminalOut) :=
  match initStateMemCopy p q with
  | .error k => some (.fault k)
  | .ok s₀ => execFuelMemCopy p fuel s₀

noncomputable def execTreeBase (p : Program) :
    Nat → State → StepResult State TerminalOut
  | 0, s => evalStep p 0 s
  | depth + 1, s =>
    match execTreeBase p depth s with
    | .step s₁ => execTreeBase p depth s₁
    | .done out => .done out
    | .fault k => .fault k

noncomputable def execBase (p : Program) (q : Query) (depth : Nat) :
    StepResult State TerminalOut :=
  match initState p q with
  | .error k => .fault k
  | .ok s₀ => execTreeBase p depth s₀

theorem reachesMemCopy_head {p : MemCopyProgram}
    {s₁ s₂ s₃ : MemCopyState}
    (hStep : StepMemCopy p s₁ (.step s₂))
    (hRest : ReachesMemCopy p s₂ s₃) :
    ReachesMemCopy p s₁ s₃ := by
  induction hRest with
  | refl => exact ReachesMemCopy.tail (ReachesMemCopy.refl s₁) hStep
  | tail _ hLast ih => exact ReachesMemCopy.tail ih hLast

theorem reachesMemCopy_head_det {p : MemCopyProgram}
    {s₁ s₂ s₃ : MemCopyState}
    (hStep : evalStepMemCopy p 0 s₁ = .step s₂)
    (hRest : ReachesMemCopy p s₂ s₃) :
    ReachesMemCopy p s₁ s₃ :=
  reachesMemCopy_head ⟨0, rfl, hStep⟩ hRest

theorem execFuelMemCopy_sound (p : MemCopyProgram) :
    ∀ (fuel : Nat) (s₀ : MemCopyState)
      (res : StepResult MemCopyState TerminalOut),
      execFuelMemCopy p fuel s₀ = some res →
      ∃ s : MemCopyState, ReachesMemCopy p s₀ s ∧ StepMemCopy p s res
  | 0, _, _, h => by cases h
  | fuel + 1, s₀, res, h => by
    unfold execFuelMemCopy at h
    cases hEv : evalStepMemCopy p 0 s₀ with
    | step s₁ =>
      rw [hEv] at h
      let ⟨s, hR, hS⟩ := execFuelMemCopy_sound p fuel s₁ res h
      exact ⟨s, reachesMemCopy_head_det hEv hR, hS⟩
    | done out =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, ReachesMemCopy.refl s₀, ⟨0, rfl, hEv⟩⟩
    | fault k =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, ReachesMemCopy.refl s₀, ⟨0, rfl, hEv⟩⟩

theorem execMemCopy_sound {p : MemCopyProgram} {q : Query} {fuel : Nat}
    {res : StepResult MemCopyState TerminalOut}
    (h : execMemCopy p q fuel = some res) :
    ReachesResultMemCopy p q res := by
  unfold execMemCopy at h
  unfold ReachesResultMemCopy
  cases hInit : initStateMemCopy p q with
  | error k =>
    rw [hInit] at h
    injection h with hEq
    exact hEq.symm
  | ok s₀ =>
    rw [hInit] at h
    exact execFuelMemCopy_sound p fuel s₀ res h

theorem execFuelMemCopy_done_det (p : MemCopyProgram) :
    ∀ (fuel : Nat) (s₀ : MemCopyState) (out : TerminalOut),
      execFuelMemCopy p fuel s₀ = some (.done out) →
      (∀ s : MemCopyState, ReachesMemCopy p s₀ s →
        ∀ k : FaultKind, ¬ StepMemCopy p s (.fault k)) ∧
      (∀ s : MemCopyState, ReachesMemCopy p s₀ s →
        ∀ out' : TerminalOut, StepMemCopy p s (.done out') → out' = out)
  | 0, _, _, h => by cases h
  | fuel + 1, s₀, out, h => by
    unfold execFuelMemCopy at h
    cases hEv : evalStepMemCopy p 0 s₀ with
    | fault _ => rw [hEv] at h; cases h
    | done out₀ =>
      rw [hEv] at h
      injection h with hEq
      injection hEq with hOutEq
      subst hOutEq
      have hOnly0 : ∀ s, ReachesMemCopy p s₀ s → s = s₀ := by
        intro s hR
        induction hR with
        | refl => rfl
        | tail _ hStep ih =>
          subst ih
          let ⟨c, hc, hStepEq⟩ := hStep
          cases hc
          rw [hEv] at hStepEq
          cases hStepEq
      refine ⟨?_, ?_⟩
      · intro s hR k hF
        have hEq := hOnly0 s hR
        subst hEq
        let ⟨c, hc, hFEq⟩ := hF
        cases hc
        rw [hEv] at hFEq
        cases hFEq
      · intro s hR out' hD
        have hEq := hOnly0 s hR
        subst hEq
        let ⟨c, hc, hDEq⟩ := hD
        cases hc
        rw [hEv] at hDEq
        injection hDEq with hO
        exact hO.symm
    | step s₁ =>
      rw [hEv] at h
      let ⟨ihNoF, ihDet⟩ := execFuelMemCopy_done_det p fuel s₁ out h
      have hStepFrom0 :
          ∀ s, ReachesMemCopy p s₀ s → s = s₀ ∨ ReachesMemCopy p s₁ s := by
        intro s hR
        induction hR with
        | refl => exact Or.inl rfl
        | tail _ hSt ih =>
          cases ih with
          | inl hEq0 =>
            subst hEq0
            let ⟨c, hc, hStEq⟩ := hSt
            cases hc
            rw [hEv] at hStEq
            injection hStEq with hEq1
            subst hEq1
            exact Or.inr (ReachesMemCopy.refl s₁)
          | inr hR1 =>
            exact Or.inr (ReachesMemCopy.tail hR1 hSt)
      refine ⟨?_, ?_⟩
      · intro s hR k hF
        cases hStepFrom0 s hR with
        | inl hEq0 =>
          subst hEq0
          let ⟨c, hc, hFEq⟩ := hF
          cases hc
          rw [hEv] at hFEq
          cases hFEq
        | inr hR1 => exact ihNoF s hR1 k hF
      · intro s hR out' hD
        cases hStepFrom0 s hR with
        | inl hEq0 =>
          subst hEq0
          let ⟨c, hc, hDEq⟩ := hD
          cases hc
          rw [hEv] at hDEq
          cases hDEq
        | inr hR1 => exact ihDet s hR1 out' hD

theorem positiveCanaryMemCopy_of_exec {p : MemCopyProgram} {q : Query}
    {fuel : Nat} {out : TerminalOut}
    (h : execMemCopy p q fuel = some (.done out)) :
    WellFormedMemCopy p q ∧ BehaviorMemCopy p q out ∧
      (∀ out' : TerminalOut, BehaviorMemCopy p q out' → out' = out) := by
  have hBeh : BehaviorMemCopy p q out := execMemCopy_sound h
  unfold execMemCopy at h
  cases hInit : initStateMemCopy p q with
  | error _ => rw [hInit] at h; cases h
  | ok s₀ =>
    rw [hInit] at h
    let ⟨hNoF, hDet⟩ := execFuelMemCopy_done_det p fuel s₀ out h
    refine ⟨⟨⟨s₀, hInit, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩, hBeh, ?_⟩
    · intro k hF
      unfold ReachesResultMemCopy at hF
      rw [hInit] at hF
      let ⟨s, hR, hS⟩ := hF
      exact hNoF s hR k hS
    · intro out' hB'
      unfold BehaviorMemCopy ReachesResultMemCopy at hB'
      rw [hInit] at hB'
      let ⟨s, hR, hS⟩ := hB'
      exact hDet s hR out' hS

theorem negativeCanaryMemCopy_of_exec {p : MemCopyProgram} {q : Query}
    {fuel : Nat} {k : FaultKind}
    (h : execMemCopy p q fuel = some (.fault k)) :
    ReachesResultMemCopy p q (.fault k) ∧ ¬ WellFormedMemCopy p q := by
  have hF : ReachesResultMemCopy p q (.fault k) := execMemCopy_sound h
  exact ⟨hF, fun hWf => hWf.2 k hF⟩

theorem reachesBase_trans {p : Program} {s₁ s₂ s₃ : State}
    (h₁ : Reaches p s₁ s₂) (h₂ : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction h₂ with
  | refl => exact h₁
  | tail _ hLast ih => exact Reaches.tail ih hLast

theorem execTreeBase_sound (p : Program) :
    ∀ (depth : Nat) (s₀ : State),
      (∀ s₂ : State, execTreeBase p depth s₀ = .step s₂ → Reaches p s₀ s₂) ∧
      (∀ out : TerminalOut, execTreeBase p depth s₀ = .done out →
        ∃ s : State, Reaches p s₀ s ∧ Step p s (.done out)) ∧
      (∀ k : FaultKind, execTreeBase p depth s₀ = .fault k →
        ∃ s : State, Reaches p s₀ s ∧ Step p s (.fault k))
  | 0, s₀ =>
    ⟨fun _ h => Reaches.tail (Reaches.refl s₀) ⟨0, rfl, h⟩,
     fun _ h => ⟨s₀, Reaches.refl s₀, ⟨0, rfl, h⟩⟩,
     fun _ h => ⟨s₀, Reaches.refl s₀, ⟨0, rfl, h⟩⟩⟩
  | depth + 1, s₀ => by
    let ⟨ihStep₀, ihDone₀, ihFault₀⟩ := execTreeBase_sound p depth s₀
    refine ⟨?_, ?_, ?_⟩
    · intro s₂ h
      unfold execTreeBase at h
      cases hL : execTreeBase p depth s₀ with
      | step s₁ =>
        rw [hL] at h
        exact reachesBase_trans (ihStep₀ s₁ hL)
          ((execTreeBase_sound p depth s₁).1 s₂ h)
      | done _ => rw [hL] at h; cases h
      | fault _ => rw [hL] at h; cases h
    · intro out h
      unfold execTreeBase at h
      cases hL : execTreeBase p depth s₀ with
      | step s₁ =>
        rw [hL] at h
        let ⟨s, hR, hS⟩ := (execTreeBase_sound p depth s₁).2.1 out h
        exact ⟨s, reachesBase_trans (ihStep₀ s₁ hL) hR, hS⟩
      | done out₀ =>
        rw [hL] at h
        injection h with hEq
        subst hEq
        exact ihDone₀ out₀ hL
      | fault _ => rw [hL] at h; cases h
    · intro k h
      unfold execTreeBase at h
      cases hL : execTreeBase p depth s₀ with
      | step s₁ =>
        rw [hL] at h
        let ⟨s, hR, hS⟩ := (execTreeBase_sound p depth s₁).2.2 k h
        exact ⟨s, reachesBase_trans (ihStep₀ s₁ hL) hR, hS⟩
      | done _ => rw [hL] at h; cases h
      | fault k₀ =>
        rw [hL] at h
        injection h with hEq
        subst hEq
        exact ihFault₀ k₀ hL

theorem execBase_done_sound {p : Program} {q : Query} {depth : Nat}
    {out : TerminalOut}
    (h : execBase p q depth = .done out) :
    ReachesResult p q (.done out) := by
  unfold execBase at h
  unfold ReachesResult
  cases hInit : initState p q with
  | error _ => rw [hInit] at h; cases h
  | ok s₀ =>
    rw [hInit] at h
    exact (execTreeBase_sound p depth s₀).2.1 out h

theorem execBase_fault_sound {p : Program} {q : Query} {depth : Nat}
    {k : FaultKind}
    (h : execBase p q depth = .fault k) :
    ReachesResult p q (.fault k) := by
  unfold execBase at h
  unfold ReachesResult
  cases hInit : initState p q with
  | error k₀ =>
    rw [hInit] at h
    injection h with hEq
    exact congrArg StepResult.fault hEq.symm
  | ok s₀ =>
    rw [hInit] at h
    exact (execTreeBase_sound p depth s₀).2.2 k h

