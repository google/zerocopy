                    rw [hAlloc.2.1]; dsimp
                    have hExecBuf := s3d_exec_bufLivenessCheck ctx (bbIdx := extraBase + 1)
                      (bbTgt := nzBb) (idx := 1) (slots₁ := slots₁b) (slots₂ := slots₂d)
                      (mem := mem) bufLoc bufSize bufAl bufMut live hBD hRel4 hAlloc.1 hExtra1 hBufStmt
                    cases hLv : live with
