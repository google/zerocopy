    have h3 := (bool_and_eq_true _ _).mp h2.1
    have h4 := (bool_and_eq_true _ _).mp h3.1
    rw [nat_beq_eq p₁ p₂ h4.1, operandEq_eq v₁ v₂ h4.2,
      leWidthEq_eq w₁ w₂ h3.2, boolEq_eq r₁ r₂ h2.2, nat_beq_eq n₁ n₂ h1.2]
  | .readPtrLe8 d₁ a₁ r₁ n₁, .readPtrLe8 d₂ a₂ r₂ n₂, h => by
