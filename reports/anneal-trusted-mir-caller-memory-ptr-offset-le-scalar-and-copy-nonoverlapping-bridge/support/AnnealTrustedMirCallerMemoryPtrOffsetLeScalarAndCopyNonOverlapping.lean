/-! ## Section 6: Block Lowering Indexing, Reachability, & Statement Simulation API (`s4_*`) -/

private theorem s4_evalStepMemCopy_at_stmt (p : MemCopyProgram) (body : MemCopyBody)
    (frame : MemCopyFrame) (mem : CallerMemory) (bb : MemCopyBlock)
    (stmt : MemCopyStmt)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hStmt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = some stmt) :
    evalStepMemCopy p 0 { frames := [frame], mem := mem } =
      evalMemCopyStmt body frame mem stmt := by
  dsimp [evalStepMemCopy]
  rw [hBody]
  dsimp
  rw [hBb]
  dsimp
  rw [hStmt]

private theorem s4_evalStepMemCopy_at_term (p : MemCopyProgram) (body : MemCopyBody)
    (frame : MemCopyFrame) (mem : CallerMemory) (bb : MemCopyBlock)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hNone : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx = none)
    (hEnd : frame.stmtIdx = bb.statements.length) :
    evalStepMemCopy p 0 { frames := [frame], mem := mem } =
      evalMemCopyTerm body bb frame mem := by
  dsimp [evalStepMemCopy]
  rw [hBody]
  dsimp
  rw [hBb]
  dsimp
  rw [hNone, s4_nat_beq_true hEnd]
  rfl

private theorem s4_reachesNMemCopy_one_step {p : MemCopyProgram}
    {s₀ s₁ : MemCopyState} (h : evalStepMemCopy p 0 s₀ = .step s₁) :
    ReachesNMemCopy p 1 s₀ s₁ :=
  ReachesNMemCopy.succ ((stepMemCopy_iff_evalStep p s₀ (.step s₁)).mpr h)
    (ReachesNMemCopy.zero s₁)

private theorem s4_reachesNMemCopy_succ_head {p : MemCopyProgram} {n : Nat}
    {s₀ s₁ s₂ : MemCopyState}
    (h01 : evalStepMemCopy p 0 s₀ = .step s₁)
    (h12 : ReachesNMemCopy p n s₁ s₂) :
    ReachesNMemCopy p (n + 1) s₀ s₂ :=
  ReachesNMemCopy.succ ((stepMemCopy_iff_evalStep p s₀ (.step s₁)).mpr h01) h12

private theorem s4_reachesPlusMemCopy_of_succ {p : MemCopyProgram} {n : Nat}
    {s₁ s₂ : MemCopyState} (h : ReachesNMemCopy p (n + 1) s₁ s₂) :
    ReachesPlusMemCopy p s₁ s₂ :=
  ⟨n, h⟩

private theorem s4_reachesMemCopy_of_reach_step_fault {p : MemCopyProgram} {n : Nat}
    {s₁ s₂ : MemCopyState} {k : FaultKind}
    (hR : ReachesNMemCopy p n s₁ s₂)
    (hF : evalStepMemCopy p 0 s₂ = .fault k) :
    ∃ s' : MemCopyState, ReachesMemCopy p s₁ s' ∧ StepMemCopy p s' (.fault k) :=
  ⟨s₂, reachesMemCopy_of_reachesNMemCopy hR,
    (stepMemCopy_iff_evalStep p s₂ (.fault k)).mpr hF⟩

private theorem s4_lowerBlock_getElem?_stmt
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bbSrc : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bbSrc)
    {i : Nat} {stmt : MemCopyStmt}
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements i = some stmt) :
    ∃ extraStart : Nat,
      let base := pack.bodySrc.locals.length
      let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability
        extraStart bbSrc.terminator
      let bbTgt : MemCopyBlock := {
        bbSrc with
        statements :=
          listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
        terminator := termRes.2.1
      }
      let off :=
        (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size)
          (bbSrc.statements.take i)).length
      let gen := lowerStmtForBuf plan.bufLocal base pack.size stmt
      1 + pack.bodySrc.basicBlocks.length ≤ extraStart ∧
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (bbIdx + 1) = some bbTgt ∧
      (∀ j : Nat, j < gen.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
          Trusted.MirSemantics.getElem? gen j) ∧
      off + gen.length =
        (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size)
          (bbSrc.statements.take (i + 1))).length ∧
      (∀ k : Nat, k < termRes.2.2.length →
        Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (extraStart + k) =
          Trusted.MirSemantics.getElem? termRes.2.2 k) := by
  cases s4_getElem?_bodyTgt_blocks pack hBb with
  | intro extraStart hSpec =>
    refine ⟨extraStart, hSpec.1, hSpec.2.1, ?_, ?_, hSpec.2.2⟩
    · intro j hj
      let f := lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size
      have hFlat := s4_listFlatMap_split_at f hStmt
      dsimp
      rw [hFlat]
      rw [List.append_assoc (listFlatMap f (bbSrc.statements.take i)) (f stmt) _,
        List.append_assoc (listFlatMap f (bbSrc.statements.take i))
          (f stmt ++ listFlatMap f (bbSrc.statements.drop (i + 1))) _]
      rw [s4_getElem?_append_right (listFlatMap f (bbSrc.statements.take i)) _ j,
        List.append_assoc (f stmt) (listFlatMap f (bbSrc.statements.drop (i + 1))) _,
        s4_getElem?_append_left (f stmt) _ j hj]
    · rw [s4_listFlatMap_take_split _ hStmt, s4_list_append_length]

private theorem s4_lowerBlock_getElem?_termPre
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbIdx : Nat} {bbSrc : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks bbIdx = some bbSrc) :
    ∃ extraStart : Nat,
      let base := pack.bodySrc.locals.length
      let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability
        extraStart bbSrc.terminator
      let bbTgt : MemCopyBlock := {
        bbSrc with
        statements :=
          listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
        terminator := termRes.2.1
      }
      let off :=
        (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements).length
      1 + pack.bodySrc.basicBlocks.length ≤ extraStart ∧
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (bbIdx + 1) = some bbTgt ∧
      off =
        (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size)
          (bbSrc.statements.take bbSrc.statements.length)).length ∧
      off + termRes.1.length = bbTgt.statements.length ∧
      (∀ j : Nat, j < termRes.1.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
          Trusted.MirSemantics.getElem? termRes.1 j) ∧
      (∀ k : Nat, k < termRes.2.2.length →
        Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks (extraStart + k) =
          Trusted.MirSemantics.getElem? termRes.2.2 k) := by
  cases s4_getElem?_bodyTgt_blocks pack hBb with
  | intro extraStart hSpec =>
    refine ⟨extraStart, hSpec.1, hSpec.2.1, ?_, ?_, ?_, hSpec.2.2⟩
    · rw [s4_list_take_all]
    · dsimp
      rw [s4_list_append_length]
    · intro j hj
      dsimp
      rw [s4_getElem?_append_right _ _ j]

private noncomputable def s4_FwdSim
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (f₁ : MemCopyFrame) (m₁ : CallerMemory)
    (f₂ : MemCopyFrame) (m₂ : CallerMemory) : Prop :=
  (∀ s₁', evalStepMemCopy pSrc 0 { frames := [f₁], mem := m₁ } = .step s₁' →
    ∃ s₂', ReachesPlusMemCopy pTgt { frames := [f₂], mem := m₂ } s₂' ∧
      s4_StateRel pack s₁' s₂') ∧
  (∀ out, evalStepMemCopy pSrc 0 { frames := [f₁], mem := m₁ } = .done out →
    ∃ s₂', ReachesMemCopy pTgt { frames := [f₂], mem := m₂ } s₂' ∧
      StepMemCopy pTgt s₂' (.done out)) ∧
  (∀ k, evalStepMemCopy pSrc 0 { frames := [f₁], mem := m₁ } = .fault k →
    ∃ s₂', ReachesMemCopy pTgt { frames := [f₂], mem := m₂ } s₂' ∧
      StepMemCopy pTgt s₂' (.fault k))

private theorem s4_reachesPlus_stmt_rel
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame}
    {m₂Init m₁' m₂' : CallerMemory}
    {slots₁' slots₂' : List MemCopySlot} {genLen n : Nat}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length)
    (hLenNext : f₂.stmtIdx + genLen =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hReach : ReachesNMemCopy pTgt (n + 1) { frames := [f₂], mem := m₂Init }
      { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + genLen, locals := slots₂' }], mem := m₂' })
    (hPM' : s4_PrefixMatch pack slots₁' slots₂')
    (hWf' : s4_SlotValWf pack.bodySrc slots₁')
    (hBuf' : s4_BufRel pack slots₁' m₁' slots₂')
    (hMem' : s4_MemRel pack m₁' m₂')
    (hScr' : s4_ScrLive pack slots₂') :
    ∃ s₂',
      ReachesPlusMemCopy pTgt { frames := [f₂], mem := m₂Init } s₂' ∧
      s4_StateRel pack
        { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], mem := m₁' }
        s₂' := by
  let s₂' : MemCopyState :=
    { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + genLen, locals := slots₂' }], mem := m₂' }
  refine ⟨s₂', ⟨n, hReach⟩, Or.inl (Or.inr ⟨hSame, hSame₂, hBbRel, hPM', hWf', hBuf', hMem', hScr', ?_⟩)⟩
  rw [hBbSrc]
  exact ⟨hLeNext, hLenNext⟩

private theorem s4_sim_stmt_one
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc bbTgt : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {stmtSrc stmtTgt : MemCopyStmt}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmtSrc)
    (hLenNext : f₂.stmtIdx + 1 =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take (f₁.stmtIdx + 1))).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some stmtTgt)
    (hCore :
      (∀ s₁', evalMemCopyStmt pack.bodySrc f₁ m₁ stmtSrc = .step s₁' →
        ∃ slots₁' m₁' slots₂' m₂',
          s₁' = { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], mem := m₁' } ∧
          evalMemCopyStmt pack.bodyTgt f₂ m₂ stmtTgt =
            stepMemCopyNext f₂ m₂' slots₂' ∧
          s4_PrefixMatch pack slots₁' slots₂' ∧
          s4_SlotValWf pack.bodySrc slots₁' ∧
          s4_BufRel pack slots₁' m₁' slots₂' ∧
          s4_MemRel pack m₁' m₂' ∧
          s4_ScrLive pack slots₂') ∧
      (∀ out, evalMemCopyStmt pack.bodySrc f₁ m₁ stmtSrc = .done out → False) ∧
      (∀ k, evalMemCopyStmt pack.bodySrc f₁ m₁ stmtSrc = .fault k →
        evalMemCopyStmt pack.bodyTgt f₂ m₂ stmtTgt = .fault k)) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    s4_getElem?_some_lt bbSrc.statements f₁.stmtIdx stmtSrc hStmtSrc
  have hEvSrc := s4_evalStepMemCopy_at_stmt pSrc pack.bodySrc f₁ m₁ bbSrc stmtSrc
    hBodySrc hBbSrc hStmtSrc
  have hEvTgt := s4_evalStepMemCopy_at_stmt pTgt pack.bodyTgt f₂ m₂ bbTgt stmtTgt
    hBodyTgt hBbTgt hStmtTgt
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    rw [hEvSrc] at hStep
    cases hCore.1 s₁' hStep with | intro slots₁' h1 =>
    cases h1 with | intro m₁' h2 =>
    cases h2 with | intro slots₂' h3 =>
    cases h3 with | intro m₂' h4 =>
    rw [h4.1]
    have hTgtStep : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } =
        stepMemCopyNext f₂ m₂' slots₂' := by
      rw [hEvTgt]
      exact h4.2.1
    exact s4_reachesPlus_stmt_rel pack hSame hSame₂ hBbRel hBbSrc hLeNext hLenNext
      (s4_reachesNMemCopy_one_step hTgtStep)
      h4.2.2.1 h4.2.2.2.1 h4.2.2.2.2.1 h4.2.2.2.2.2.1 h4.2.2.2.2.2.2
  · intro out hDone
    rw [hEvSrc] at hDone
    exact False.elim (hCore.2.1 out hDone)
  · intro k hFault
    rw [hEvSrc] at hFault
    refine ⟨{ frames := [f₂], mem := m₂ }, ReachesMemCopy.refl _, ?_⟩
    rw [stepMemCopy_iff_evalStep, hEvTgt]
    exact hCore.2.2 k hFault

/-! ## Section 7: Invariant Preservation, `Allocation` Updates, & Prefix Evaluators -/

private theorem s4_setElem?_self_eq {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α),
      Trusted.MirSemantics.getElem? xs i = some v →
      setElem? xs i v = some xs
  | [], _, _, h => by cases h
  | _ :: _, 0, _, h => by
    rw [Option.some.inj h]
    rfl
  | a :: tl, i + 1, v, h => by
    dsimp [setElem?]
    rw [s4_setElem?_self_eq tl i v h]

private theorem s4_updateAlloc?_of_findAlloc? (aid : AllocId) (newAlloc : Allocation) :
    ∀ (xs : List Allocation) (old : Allocation),
      findAlloc? aid xs = some old →
      ∃ xs' : List Allocation, updateAlloc? aid newAlloc xs = some xs'
  | [], _, h => by cases h
  | a :: rest, old, h => by
    dsimp [findAlloc?] at h
    dsimp [updateAlloc?]
    cases hEq : Nat.beq a.allocId aid with
    | true => exact ⟨newAlloc :: rest, rfl⟩
    | false =>
      rw [hEq] at h
      cases s4_updateAlloc?_of_findAlloc? aid newAlloc rest old h with
      | intro rest' hUp => exact ⟨a :: rest', by rw [hUp]; rfl⟩

private theorem s4_findAlloc?_updateAlloc?_ne (aid1 aid2 : AllocId) (newAlloc : Allocation)
    (hNe : aid2 ≠ aid1) (hNew : newAlloc.allocId = aid1) :
    ∀ (xs xs' : List Allocation),
      updateAlloc? aid1 newAlloc xs = some xs' →
      findAlloc? aid2 xs' = findAlloc? aid2 xs
  | [], _, h => by cases h
  | a :: rest, xs', h => by
    dsimp [updateAlloc?] at h
    cases hEq1 : Nat.beq a.allocId aid1 with
    | true =>
      rw [hEq1] at h
      cases Option.some.inj h
      have ha1 : a.allocId = aid1 := nat_beq_eq _ _ hEq1
      have hNeA : a.allocId ≠ aid2 := by rw [ha1]; exact hNe.symm
      dsimp [findAlloc?]
      rw [s4_nat_beq_false hNeA, hNew, s4_nat_beq_false hNe.symm]
      rfl
    | false =>
      rw [hEq1] at h
      cases hUp : updateAlloc? aid1 newAlloc rest with
      | none => rw [hUp] at h; cases h
      | some rest' =>
        rw [hUp] at h
        cases Option.some.inj h
        dsimp [findAlloc?]
        cases Nat.beq a.allocId aid2 with
        | true => rfl
        | false => exact s4_findAlloc?_updateAlloc?_ne aid1 aid2 newAlloc hNe hNew rest rest' hUp

private theorem s4_updateAlloc?_mem (aid : AllocId) (newAlloc : Allocation) :
    ∀ (xs xs' : List Allocation) (a : Allocation),
      updateAlloc? aid newAlloc xs = some xs' →
      List.Mem a xs' →
      a = newAlloc ∨ List.Mem a xs
  | [], _, _, h, _ => by cases h
  | hd :: rest, xs', a, h, hMem => by
    dsimp [updateAlloc?] at h
    cases hEq : Nat.beq hd.allocId aid with
    | true =>
      rw [hEq] at h
      cases Option.some.inj h
      cases hMem with
      | head => exact Or.inl rfl
      | tail _ hTl => exact Or.inr (List.Mem.tail hd hTl)
    | false =>
      rw [hEq] at h
      cases hUp : updateAlloc? aid newAlloc rest with
      | none => rw [hUp] at h; cases h
      | some rest' =>
        rw [hUp] at h
        cases Option.some.inj h
        cases hMem with
        | head => exact Or.inr (List.Mem.head rest)
        | tail _ hTl =>
          cases s4_updateAlloc?_mem aid newAlloc rest rest' a hUp hTl with
          | inl hN => exact Or.inl hN
          | inr hM => exact Or.inr (List.Mem.tail hd hM)

private theorem s4b_mirTy_beq_usize_eq (ty : MirTy) (h : MirTy.beq ty usizeTy = true) :
    ty = usizeTy := by
  cases ty with
  | int w s =>
    cases w <;> cases s <;> cases h
    rfl
  | bool | unit | enum _ | rawPtr _ _ | ref _ _ | tuple _ | never | unsupported =>
    cases h

private theorem s4_evalConstLit_usize_lt_maxUsize (c : ConstOperand)
    (hTy : MirTy.beq c.ty usizeTy = true) (sv : ScalarVal)
    (hOk : evalConstLit c.ty c.lit = .ok (.scalar sv)) :
    sv.bits.toNat < maxUsize := by
  rw [s4b_mirTy_beq_usize_eq c.ty hTy] at hOk
  cases hLit : c.lit with
  | zeroSized => rw [hLit] at hOk; cases hOk
  | scalar bits =>
    rw [hLit] at hOk
    dsimp [evalConstLit, usizeTy] at hOk
    cases hNe : truncateBits .isize bits != bits with
    | true => rw [hNe] at hOk; cases hOk
    | false =>
      rw [hNe] at hOk
      cases Except.ok.inj hOk
      exact s4_truncateBits_isize_lt_maxUsize bits

private theorem s4_prefixMatch_set_prefix_other
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List MemCopySlot}
    {k : Nat} {s' : MemCopySlot}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (_hLt : k < pack.bodySrc.locals.length)
    (_hNe : k ≠ plan.bufLocal)
    (hSet1 : setElem? slots₁ k s' = some slots₁')
    (hSet2 : setElem? slots₂ k s' = some slots₂') :
    s4_PrefixMatch pack slots₁' slots₂' := by
  refine ⟨(s4_setElem?_length _ _ _ _ hSet1).trans hPM.1,
    (s4_setElem?_length _ _ _ _ hSet2).trans hPM.2.1, ?_⟩
  intro i hi hNeI
  cases s4_nat_eq_or_ne k i with
  | inl hEq =>
    rw [← hEq, s4_getElem?_setElem?_self _ _ _ _ hSet1,
      s4_getElem?_setElem?_self _ _ _ _ hSet2]
  | inr hNeK =>
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeK hSet1,
      s4_getElem?_setElem?_ne _ _ _ _ _ hNeK hSet2]
    exact hPM.2.2 i hi hNeI

private theorem s4_bufRel_set_prefix_other
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₁' slots₂' : List MemCopySlot} {mem₁ : CallerMemory}
    {k : Nat} {s₁' s₂' : MemCopySlot}
    (hBuf : s4_BufRel pack slots₁ mem₁ slots₂)
    (hLt : k < pack.bodySrc.locals.length)
    (hNe : k ≠ plan.bufLocal)
    (hSet1 : setElem? slots₁ k s₁' = some slots₁')
    (hSet2 : setElem? slots₂ k s₂' = some slots₂') :
    s4_BufRel pack slots₁' mem₁ slots₂' := by
  cases hBuf with | intro isLive h1 =>
  cases h1 with | intro alloc h2 =>
  refine ⟨isLive, alloc, ?_, h2.2.1, h2.2.2.1, h2.2.2.2.1, h2.2.2.2.2.1,
    h2.2.2.2.2.2.1, h2.2.2.2.2.2.2.1, h2.2.2.2.2.2.2.2.1, ?_⟩
  · rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet1]
    exact h2.1
  · have hNeBase : k ≠ pack.bodySrc.locals.length := fun h =>
      s4_nat_lt_irrefl pack.bodySrc.locals.length (by rw [h] at hLt; exact hLt)
    have hNeLiveOff : ∀ j : Nat, k ≠ pack.bodySrc.locals.length + 1 + j := fun j h =>
      s4_nat_lt_irrefl k (Nat.lt_of_lt_of_le hLt
        (by rw [h, Nat.add_assoc]; exact Nat.le_add_right _ _))
    cases isLive with
    | false =>
      dsimp at h2; dsimp
      rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeBase hSet2]
      refine ⟨h2.2.2.2.2.2.2.2.2.1, fun j hj => ?_⟩
      rw [s4_getElem?_setElem?_ne _ _ _ _ _ (hNeLiveOff j) hSet2]
      exact h2.2.2.2.2.2.2.2.2.2 j hj
    | true =>
      dsimp at h2; dsimp
      rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeBase hSet2]
      refine ⟨h2.2.2.2.2.2.2.2.2.1, fun j hj => ?_⟩
      cases h2.2.2.2.2.2.2.2.2.2 j hj with | intro ab hAb =>
      have hNe2 : k ≠ pack.bodySrc.locals.length + 1 + pack.size + j := fun h =>
        s4_nat_lt_irrefl k (Nat.lt_of_lt_of_le hLt
          (by rw [h, Nat.add_assoc, Nat.add_assoc]; exact Nat.le_add_right _ _))
      rw [s4_getElem?_setElem?_ne _ _ _ _ _ (hNeLiveOff j) hSet2,
        s4_getElem?_setElem?_ne _ _ _ _ _ hNe2 hSet2]
      exact ⟨ab, hAb⟩

private theorem s4_scrLive_set_lt_scrBase
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₂ slots₂' : List MemCopySlot} {k : Nat} {s' : MemCopySlot}
    (hScr : s4_ScrLive pack slots₂)
    (hLt : k < pack.bodySrc.locals.length + 1 + 2 * pack.size)
    (hSet : setElem? slots₂ k s' = some slots₂') :
    s4_ScrLive pack slots₂' := by
  intro r hr
  have hNe : k ≠ pack.bodySrc.locals.length + 1 + 2 * pack.size + r := fun h =>
    s4_nat_lt_irrefl k (Nat.lt_of_lt_of_le hLt (by rw [h]; exact Nat.le_add_right _ _))
  rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet]
  exact hScr r hr

private theorem s4_scrLive_set_scr
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₂ slots₂' : List MemCopySlot} {r0 : Nat} {ov0 : Option Val}
    (hScr : s4_ScrLive pack slots₂)
    (hSet : setElem? slots₂ (pack.bodySrc.locals.length + 1 + 2 * pack.size + r0)
      (.baseSlot (.live ov0)) = some slots₂') :
    s4_ScrLive pack slots₂' := by
  intro r hr
  cases s4_nat_eq_or_ne r0 r with
  | inl hEq =>
    rw [← hEq, s4_getElem?_setElem?_self _ _ _ _ hSet]
    exact ⟨ov0, rfl⟩
  | inr hNe =>
    have hNeLoc : pack.bodySrc.locals.length + 1 + 2 * pack.size + r0 ≠
        pack.bodySrc.locals.length + 1 + 2 * pack.size + r := fun h =>
      hNe (Nat.add_left_cancel h)
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hSet]
    exact hScr r hr

private theorem s4_prefixMatch_set_scr
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂' : List MemCopySlot} {r0 : Nat} {s' : MemCopySlot}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hSet : setElem? slots₂ (pack.bodySrc.locals.length + 1 + 2 * pack.size + r0) s' = some slots₂') :
    s4_PrefixMatch pack slots₁ slots₂' := by
  refine ⟨hPM.1, (s4_setElem?_length _ _ _ _ hSet).trans hPM.2.1, ?_⟩
  intro i hi hNeI
  have hNe : pack.bodySrc.locals.length + 1 + 2 * pack.size + r0 ≠ i := fun h =>
    s4_nat_lt_irrefl i (Nat.lt_of_lt_of_le hi
      (by rw [← h, Nat.add_assoc, Nat.add_assoc]; exact Nat.le_add_right _ _))
  rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet]
  exact hPM.2.2 i hi hNeI

private theorem s4_bufRel_set_scr
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ slots₂' : List MemCopySlot} {mem₁ : CallerMemory}
    {r0 : Nat} {s' : MemCopySlot}
    (hBuf : s4_BufRel pack slots₁ mem₁ slots₂)
    (hSet : setElem? slots₂ (pack.bodySrc.locals.length + 1 + 2 * pack.size + r0) s' = some slots₂') :
    s4_BufRel pack slots₁ mem₁ slots₂' := by
  cases hBuf with | intro isLive h1 =>
  cases h1 with | intro alloc h2 =>
  refine ⟨isLive, alloc, h2.1, h2.2.1, h2.2.2.1, h2.2.2.2.1, h2.2.2.2.2.1,
    h2.2.2.2.2.2.1, h2.2.2.2.2.2.2.1, h2.2.2.2.2.2.2.2.1, ?_⟩
  have hNeBase : pack.bodySrc.locals.length + 1 + 2 * pack.size + r0 ≠
      pack.bodySrc.locals.length := fun h => by
    have hGt : pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + 2 * pack.size + r0 := by
      rw [Nat.add_assoc pack.bodySrc.locals.length 1 (2 * pack.size),
        Nat.add_assoc pack.bodySrc.locals.length (1 + 2 * pack.size) r0]
      exact Nat.lt_add_of_pos_right
        (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 0)
          (Nat.le_trans (Nat.le_add_right 1 (2 * pack.size)) (Nat.le_add_right (1 + 2 * pack.size) r0)))
    rw [h] at hGt; exact s4_nat_lt_irrefl _ hGt
  have hNeLt2S : ∀ k : Nat, k < 2 * pack.size →
      pack.bodySrc.locals.length + 1 + 2 * pack.size + r0 ≠
        pack.bodySrc.locals.length + 1 + k := fun k hk h => by
    have hGt : pack.bodySrc.locals.length + 1 + k <
        pack.bodySrc.locals.length + 1 + 2 * pack.size + r0 :=
      Nat.lt_of_lt_of_le (Nat.add_lt_add_left hk _) (Nat.le_add_right _ _)
    rw [h] at hGt; exact s4_nat_lt_irrefl _ hGt
  cases isLive with
  | false =>
    dsimp at h2; dsimp
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeBase hSet]
    refine ⟨h2.2.2.2.2.2.2.2.2.1, fun j hj => ?_⟩
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ (hNeLt2S j hj) hSet]
    exact h2.2.2.2.2.2.2.2.2.2 j hj
  | true =>
    dsimp at h2; dsimp
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeBase hSet]
    refine ⟨h2.2.2.2.2.2.2.2.2.1, fun j hj => ?_⟩
    have hj1 : j < 2 * pack.size := by
      rw [Nat.two_mul]; exact Nat.lt_of_lt_of_le hj (Nat.le_add_right _ _)
    have hj2 : pack.size + j < 2 * pack.size := by
      rw [Nat.two_mul]; exact Nat.add_lt_add_left hj _
    have hNe2 := hNeLt2S (pack.size + j) hj2
    rw [← Nat.add_assoc (pack.bodySrc.locals.length + 1) pack.size j] at hNe2
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ (hNeLt2S j hj1) hSet,
      s4_getElem?_setElem?_ne _ _ _ _ _ hNe2 hSet]
    exact h2.2.2.2.2.2.2.2.2.2 j hj

private theorem s4_intWidth_beq_refl : ∀ w : IntWidth, IntWidth.beq w w = true
  | .i8 | .i16 | .i32 | .i64 | .i128 | .isize => rfl

private theorem s4_natListBeq_refl : ∀ xs : List Nat, natListBeq xs xs = true
  | [] => rfl
  | x :: xs => by
    dsimp [natListBeq]
    rw [nat_beq_refl x, s4_natListBeq_refl xs]
    rfl

private theorem s4b_enumTy_beq_refl (ety : EnumTy) : EnumTy.beq ety ety = true := by
  dsimp [EnumTy.beq]
  rw [nat_beq_refl ety.id, s4_intWidth_beq_refl ety.discrWidth, s4_natListBeq_refl]
  cases ety.discrSigned <;> cases ety.tagRepr with
  | zeroSized => rfl
  | scalar w s =>
    dsimp [EnumTagRepr.beq]
    rw [s4_intWidth_beq_refl w]
    cases s <;> rfl

private theorem s4_liveUninitSlot_wf_in (ty : MirTy) (v : Val)
    (h : MemCopySlot.baseSlot (LocalSlot.live (some v)) = .baseSlot (liveUninitSlot ty)) :
    checkVal v ty = true := by
  dsimp [liveUninitSlot] at h
  cases ty with
  | unit => cases h; rfl
  | enum ety =>
    dsimp at h
    cases hZ : isZstEnumTy ety with
    | false => rw [hZ] at h; cases h
    | true =>
      rw [hZ] at h
      cases h
      unfold isZstEnumTy at hZ
      cases hTag : ety.tagRepr with
      | scalar _ _ => rw [hTag] at hZ; cases hZ
      | zeroSized =>
        rw [hTag] at hZ
        dsimp at hZ
        have hPos : Nat.blt 0 ety.discriminants.length = true := by
          unfold enumAdmitted at hZ
          dsimp at hZ
          cases hD : ety.discriminants with
          | nil => rw [hD] at hZ; cases hZ
          | cons _ _ => rfl
        unfold checkVal Val.ty?
        dsimp
        rw [hZ, hPos]
        dsimp
        exact s4b_enumTy_beq_refl ety
  | int _ _ | bool | rawPtr _ _ | ref _ _ | tuple _ | never | unsupported =>
    cases h

private theorem s4_slotValWf_set_live_uninit
    {bodySrc : MemCopyBody} {slots₁ slots₁' : List MemCopySlot} {k : Nat}
    {decl : MemCopyLocalDecl}
    (hWf : s4_SlotValWf bodySrc slots₁)
    (hDecl : Trusted.MirSemantics.getElem? bodySrc.locals k = some decl)
    (hSet : setElem? slots₁ k (liveUninitMemCopySlot decl) = some slots₁') :
    s4_SlotValWf bodySrc slots₁' := by
  intro i ty v hDi hSi
  cases s4_nat_eq_or_ne k i with
  | inl hEq =>
    rw [← hEq, hDecl] at hDi
    have hD := Option.some.inj hDi
    rw [← hEq, s4_getElem?_setElem?_self _ _ _ _ hSet] at hSi
    have hS := Option.some.inj hSi
    rw [hD] at hS
    exact s4_liveUninitSlot_wf_in ty v hS.symm
  | inr hNe =>
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet] at hSi
    exact hWf i ty v hDi hSi

private theorem s4_slotValWf_set_dead
    {bodySrc : MemCopyBody} {slots₁ slots₁' : List MemCopySlot} {k : Nat}
    {sDead : MemCopySlot}
    (hDead : sDead = .baseSlot .dead ∨ sDead = .ptrDead ∨ sDead = .bufSlot false)
    (hWf : s4_SlotValWf bodySrc slots₁)
    (hSet : setElem? slots₁ k sDead = some slots₁') :
    s4_SlotValWf bodySrc slots₁' := by
  intro i ty v hDi hSi
  cases s4_nat_eq_or_ne k i with
  | inl hEq =>
    rw [← hEq, s4_getElem?_setElem?_self _ _ _ _ hSet] at hSi
    have hSlotEq := Option.some.inj hSi
    cases hDead with
    | inl h => rw [h] at hSlotEq; cases hSlotEq
    | inr h =>
      cases h with
      | inl h1 => rw [h1] at hSlotEq; cases hSlotEq
      | inr h2 => rw [h2] at hSlotEq; cases hSlotEq
  | inr hNe =>
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet] at hSi
    exact hWf i ty v hDi hSi

private theorem s4_slotValWf_set_base_some
    {bodySrc : MemCopyBody} {slots₁ slots₁' : List MemCopySlot}
    {k : Nat} {dstTy : MirTy} {vNew : Val}
    (hWf : s4_SlotValWf bodySrc slots₁)
    (hDecl : Trusted.MirSemantics.getElem? bodySrc.locals k = some (.base dstTy))
    (hChk : checkVal vNew dstTy = true)
    (hSet : setElem? slots₁ k (.baseSlot (.live (some vNew))) = some slots₁') :
    s4_SlotValWf bodySrc slots₁' := by
  intro i ty v hDi hSi
  cases s4_nat_eq_or_ne k i with
  | inl hEq =>
    rw [← hEq, hDecl] at hDi
    cases Option.some.inj hDi
    rw [← hEq, s4_getElem?_setElem?_self _ _ _ _ hSet] at hSi
    cases Option.some.inj hSi
    exact hChk
  | inr hNe =>
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet] at hSi
    exact hWf i ty v hDi hSi

private theorem s4_slotValWf_set_bufSlot
    {bodySrc : MemCopyBody} {slots₁ slots₁' : List MemCopySlot}
    {k : Nat} {b : Bool}
    (hWf : s4_SlotValWf bodySrc slots₁)
    (hSet : setElem? slots₁ k (.bufSlot b) = some slots₁') :
    s4_SlotValWf bodySrc slots₁' := by
  intro i ty v hDi hSi
  cases s4_nat_eq_or_ne k i with
  | inl hEq =>
    rw [← hEq, s4_getElem?_setElem?_self _ _ _ _ hSet] at hSi
    cases hSi
  | inr hNe =>
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSet] at hSi
    exact hWf i ty v hDi hSi

private theorem s4_operandUsesOnlyBaseMem_of_hasBaseTy (decls : List MemCopyLocalDecl)
    (expectedTy : MirTy) (op : Operand)
    (h : operandHasBaseTy decls expectedTy op = true) :
    operandUsesOnlyBaseMem decls op = true := by
  cases op with
  | constant _ => rfl
  | copy p | move p =>
    dsimp [operandHasBaseTy] at h
    have hAnd := (bool_and_eq_true _ _).mp h
    dsimp [operandUsesOnlyBaseMem]
    rw [hAnd.1]
    cases hD : Trusted.MirSemantics.getElem? decls p.localId with
    | none => rw [hD] at hAnd; cases hAnd.2
    | some d =>
      rw [hD] at hAnd
      cases d with
      | base _ => rfl
      | ptrLocal | byteBuf _ _ _ => cases hAnd.2

private theorem s4_evalMemCopyBaseOperandToSlot_prefix
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List MemCopySlot} {mem₁ : CallerMemory} {op : Operand}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hWf : s4_SlotValWf pack.bodySrc slots₁)
    (hBuf : s4_BufRel pack slots₁ mem₁ slots₂)
    (hScr : s4_ScrLive pack slots₂)
    (hOp : operandUsesOnlyBaseMem pack.bodySrc.locals op = true) :
    match evalMemCopyBaseOperandToSlot pack.bodySrc.locals slots₁ op with
    | .error k =>
      evalMemCopyBaseOperandToSlot pack.bodyTgt.locals slots₂ op = .error k
    | .ok (ty, optVal, slots₁') =>
      ∃ slots₂',
        evalMemCopyBaseOperandToSlot pack.bodyTgt.locals slots₂ op = .ok (ty, optVal, slots₂') ∧
        s4_PrefixMatch pack slots₁' slots₂' ∧
        s4_SlotValWf pack.bodySrc slots₁' ∧
        s4_BufRel pack slots₁' mem₁ slots₂' ∧
        s4_ScrLive pack slots₂' := by
  cases op with
  | constant c =>
    dsimp [evalMemCopyBaseOperandToSlot]
    cases evalConstLit c.ty c.lit with
    | error k => rfl
    | ok v => exact ⟨slots₂, rfl, hPM, hWf, hBuf, hScr⟩
  | copy p =>
    dsimp [operandUsesOnlyBaseMem] at hOp
    have hAnd := (bool_and_eq_true _ _).mp hOp
    have hProj : p.projection.isEmpty = true := hAnd.1
    cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
    | none => rw [hD] at hAnd; cases hAnd.2
    | some d =>
      rw [hD] at hAnd
      cases d with
      | ptrLocal | byteBuf _ _ _ => cases hAnd.2
      | base ty =>
        have hLt : p.localId < pack.bodySrc.locals.length :=
          s4_getElem?_some_lt _ _ _ hD
        have hNe : p.localId ≠ plan.bufLocal := fun h => by
          rw [h, pack.hBufDecl] at hD; cases hD
        have hDTgt := s4_getElem?_bodyTgt_locals_lt pack hLt hNe
        rw [hD] at hDTgt
        have hSlEq := hPM.2.2 p.localId hLt hNe
        dsimp [evalMemCopyBaseOperandToSlot]
        have hNotP : (!p.projection.isEmpty) = false := by rw [hProj]; rfl
        rw [hNotP]
        dsimp
        rw [hD, hDTgt, hSlEq]
        cases hS : Trusted.MirSemantics.getElem? slots₁ p.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | ptrDead | livePtr _ | bufSlot _ => rfl
          | baseSlot bs =>
            cases bs with
            | dead => rfl
            | live optVal => exact ⟨slots₂, rfl, hPM, hWf, hBuf, hScr⟩
  | move p =>
    dsimp [operandUsesOnlyBaseMem] at hOp
    have hAnd := (bool_and_eq_true _ _).mp hOp
    have hProj : p.projection.isEmpty = true := hAnd.1
    cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
    | none => rw [hD] at hAnd; cases hAnd.2
    | some d =>
      rw [hD] at hAnd
      cases d with
      | ptrLocal | byteBuf _ _ _ => cases hAnd.2
      | base ty =>
        have hLt : p.localId < pack.bodySrc.locals.length :=
          s4_getElem?_some_lt _ _ _ hD
        have hNe : p.localId ≠ plan.bufLocal := fun h => by
          rw [h, pack.hBufDecl] at hD; cases hD
        have hDTgt := s4_getElem?_bodyTgt_locals_lt pack hLt hNe
        rw [hD] at hDTgt
        have hSlEq := hPM.2.2 p.localId hLt hNe
        dsimp [evalMemCopyBaseOperandToSlot]
        have hNotP : (!p.projection.isEmpty) = false := by rw [hProj]; rfl
        rw [hNotP]
        dsimp
        rw [hD, hDTgt, hSlEq]
        cases hS : Trusted.MirSemantics.getElem? slots₁ p.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | ptrDead | livePtr _ | bufSlot _ => rfl
          | baseSlot bs =>
            cases bs with
            | dead => rfl
            | live optVal =>
              have hLt1 : p.localId < slots₁.length := by rw [hPM.1]; exact hLt
              have hLt2 : p.localId < slots₂.length := by
                rw [hPM.2.1, s4_bodyTgt_locals_length pack]
                exact Nat.lt_of_lt_of_le
                  (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hLt (Nat.le_add_right _ 1)) (Nat.le_add_right _ _))
                  (Nat.le_add_right _ 4)
              cases s4_lt_setElem?_some slots₁ p.localId (.baseSlot (liveUninitSlot ty)) hLt1 with
              | intro slots₁' hSet1 =>
              cases s4_lt_setElem?_some slots₂ p.localId (.baseSlot (liveUninitSlot ty)) hLt2 with
              | intro slots₂' hSet2 =>
              dsimp
              rw [hSet1, hSet2]
              exact ⟨slots₂', rfl,
                s4_prefixMatch_set_prefix_other pack hPM hLt hNe hSet1 hSet2,
                s4_slotValWf_set_live_uninit hWf hD hSet1,
                s4_bufRel_set_prefix_other pack hBuf hLt hNe hSet1 hSet2,
                s4_scrLive_set_lt_scrBase pack hScr
                  (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hLt (Nat.le_add_right _ 1)) (Nat.le_add_right _ _)) hSet2⟩

private theorem s4_evalMemCopyPrimitiveOperand_prefix
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List MemCopySlot} {mem₁ : CallerMemory} {op : Operand}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hWf : s4_SlotValWf pack.bodySrc slots₁)
    (hBuf : s4_BufRel pack slots₁ mem₁ slots₂)
    (hScr : s4_ScrLive pack slots₂)
    (hOp : operandUsesOnlyBaseMem pack.bodySrc.locals op = true) :
    match evalMemCopyPrimitiveOperand pack.bodySrc.locals slots₁ op with
    | .error k =>
      evalMemCopyPrimitiveOperand pack.bodyTgt.locals slots₂ op = .error k
    | .ok (v, slots₁') =>
      ∃ slots₂',
        evalMemCopyPrimitiveOperand pack.bodyTgt.locals slots₂ op = .ok (v, slots₂') ∧
        s4_PrefixMatch pack slots₁' slots₂' ∧
        s4_SlotValWf pack.bodySrc slots₁' ∧
        s4_BufRel pack slots₁' mem₁ slots₂' ∧
        s4_ScrLive pack slots₂' := by
  have hBase := s4_evalMemCopyBaseOperandToSlot_prefix pack hPM hWf hBuf hScr hOp
  dsimp [evalMemCopyPrimitiveOperand]
  cases h1 : evalMemCopyBaseOperandToSlot pack.bodySrc.locals slots₁ op with
  | error k =>
    rw [h1] at hBase
    rw [hBase]
  | ok res =>
    rw [h1] at hBase
    cases hBase with | intro slots₂' h2 =>
    rw [h2.1]
    dsimp
    cases !isPrimitiveReadableTy res.1 with
    | true => rfl
    | false =>
      dsimp
      cases res.2.1 with
      | none => rfl
      | some v => exact ⟨slots₂', rfl, h2.2⟩

private theorem s4_evalUsizeOp_prefix
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List MemCopySlot} {mem₁ : CallerMemory} {op : Operand}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hWf : s4_SlotValWf pack.bodySrc slots₁)
    (hBuf : s4_BufRel pack slots₁ mem₁ slots₂)
    (hScr : s4_ScrLive pack slots₂)
    (hOp : operandUsesOnlyBaseMem pack.bodySrc.locals op = true) :
    match evalUsizeOp pack.bodySrc.locals slots₁ op with
    | .error k =>
      evalUsizeOp pack.bodyTgt.locals slots₂ op = .error k
    | .ok (n, slots₁') =>
      n < maxUsize ∧
      ∃ slots₂',
        evalUsizeOp pack.bodyTgt.locals slots₂ op = .ok (n, slots₂') ∧
        s4_PrefixMatch pack slots₁' slots₂' ∧
        s4_SlotValWf pack.bodySrc slots₁' ∧
        s4_BufRel pack slots₁' mem₁ slots₂' ∧
        s4_ScrLive pack slots₂' := by
  have hBase := s4_evalMemCopyBaseOperandToSlot_prefix pack hPM hWf hBuf hScr hOp
  dsimp [evalUsizeOp]
  cases h1 : evalMemCopyBaseOperandToSlot pack.bodySrc.locals slots₁ op with
  | error k =>
    rw [h1] at hBase
    rw [hBase]
  | ok res =>
    rw [h1] at hBase
    cases hBase with | intro slots₂' h2 =>
    rw [h2.1]
    dsimp
    cases hU : !MirTy.beq res.1 usizeTy with
    | true => rfl
    | false =>
      dsimp
      have hTyEq : MirTy.beq res.1 usizeTy = true := by
        cases hb : MirTy.beq res.1 usizeTy with
        | true => rfl
        | false => rw [hb] at hU; cases hU
      cases hOpt : res.2.1 with
      | none => rfl
      | some v =>
        cases v with
        | bool _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => rfl
        | scalar sv =>
          dsimp
          cases hSwf : sv.wf with
          | false => dsimp
          | true =>
            dsimp
            have hLt : sv.bits.toNat < maxUsize := by
              cases op with
              | constant c =>
                dsimp [evalMemCopyBaseOperandToSlot] at h1
                cases hEv : evalConstLit c.ty c.lit with
                | error _ => rw [hEv] at h1; cases h1
                | ok vc =>
                  rw [hEv] at h1
                  have hCTy : res.1 = c.ty := (congrArg Prod.fst (Except.ok.inj h1)).symm
                  have hCEq : some (.scalar sv) = some vc := by
                    have hp := (congrArg (fun p => p.2.1) (Except.ok.inj h1)).symm
                    exact hOpt.symm.trans hp
                  rw [← hCTy] at hEv
                  rw [← Option.some.inj hCEq] at hEv
                  exact s4_evalConstLit_usize_lt_maxUsize ⟨res.1, c.lit⟩ hTyEq sv hEv
              | copy p =>
                dsimp [operandUsesOnlyBaseMem] at hOp
                have hAnd := (bool_and_eq_true _ _).mp hOp
                cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
                | none => rw [hD] at hAnd; cases hAnd.2
                | some d =>
                  rw [hD] at hAnd
                  cases d with
                  | ptrLocal | byteBuf _ _ _ => cases hAnd.2
                  | base tyD =>
                    have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
                    dsimp [evalMemCopyBaseOperandToSlot] at h1
                    rw [hNotP] at h1
                    dsimp at h1
                    rw [hD] at h1
                    cases hS : Trusted.MirSemantics.getElem? slots₁ p.localId with
                    | none => rw [hS] at h1; cases h1
                    | some sl =>
                      rw [hS] at h1
                      cases sl with
                      | ptrDead | livePtr _ | bufSlot _ => cases h1
                      | baseSlot bs =>
                        cases bs with
                        | dead => cases h1
                        | live optV =>
                          have hFst : tyD = res.1 := congrArg Prod.fst (Except.ok.inj h1)
                          have hTyD : tyD = usizeTy := by
                            rw [hFst]
                            exact s4b_mirTy_beq_usize_eq res.1 hTyEq
                          have hV : optV = some (.scalar sv) :=
                            (congrArg (fun p => p.2.1) (Except.ok.inj h1)).trans hOpt
                          rw [hV] at hS
                          rw [hTyD] at hD
                          have hChk := hWf p.localId usizeTy (.scalar sv) hD hS
                          cases (s4_checkVal_usize_iff _).mp hChk with
                          | intro sv' hsv' =>
                            cases Val.scalar.inj hsv'.1
                            exact hsv'.2.2.2.2
              | move p =>
                dsimp [operandUsesOnlyBaseMem] at hOp
                have hAnd := (bool_and_eq_true _ _).mp hOp
                cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
                | none => rw [hD] at hAnd; cases hAnd.2
                | some d =>
                  rw [hD] at hAnd
                  cases d with
                  | ptrLocal | byteBuf _ _ _ => cases hAnd.2
                  | base tyD =>
                    have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
                    dsimp [evalMemCopyBaseOperandToSlot] at h1
                    rw [hNotP] at h1
                    dsimp at h1
                    rw [hD] at h1
                    cases hS : Trusted.MirSemantics.getElem? slots₁ p.localId with
                    | none => rw [hS] at h1; cases h1
                    | some sl =>
                      rw [hS] at h1
                      cases sl with
                      | ptrDead | livePtr _ | bufSlot _ => cases h1
                      | baseSlot bs =>
                        cases bs with
                        | dead => cases h1
                        | live optV =>
                          have hPair : tyD = res.1 ∧ optV = res.2.1 := by
                            dsimp at h1
                            cases hSetM : setElem? slots₁ p.localId (.baseSlot (liveUninitSlot tyD)) with
                            | none => rw [hSetM] at h1; cases h1
                            | some _ =>
                              rw [hSetM] at h1
                              exact ⟨congrArg Prod.fst (Except.ok.inj h1),
                                congrArg (fun p => p.2.1) (Except.ok.inj h1)⟩
                          have hTyD : tyD = usizeTy := by
                            rw [hPair.1]
                            exact s4b_mirTy_beq_usize_eq res.1 hTyEq
                          have hV : optV = some (.scalar sv) :=
                            hPair.2.trans hOpt
                          rw [hV] at hS
                          rw [hTyD] at hD
                          have hChk := hWf p.localId usizeTy (.scalar sv) hD hS
                          cases (s4_checkVal_usize_iff _).mp hChk with
                          | intro sv' hsv' =>
                            cases Val.scalar.inj hsv'.1
                            exact hsv'.2.2.2.2
            exact ⟨hLt, slots₂', rfl, h2.2⟩

private theorem s4_evalMemCopyBaseRvalue_prefix
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List MemCopySlot} {mem₁ : CallerMemory}
    {dstTy : MirTy} {rval : Rvalue}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hWf : s4_SlotValWf pack.bodySrc slots₁)
    (hBuf : s4_BufRel pack slots₁ mem₁ slots₂)
    (hScr : s4_ScrLive pack slots₂)
    (hRval : rvalueUsesOnlyBaseMem pack.bodySrc.locals rval = true) :
    match evalMemCopyBaseRvalue pack.bodySrc.locals slots₁ dstTy rval with
    | .error k =>
      evalMemCopyBaseRvalue pack.bodyTgt.locals slots₂ dstTy rval = .error k
    | .ok (v, slots₁') =>
      ∃ slots₂',
        evalMemCopyBaseRvalue pack.bodyTgt.locals slots₂ dstTy rval = .ok (v, slots₂') ∧
        s4_PrefixMatch pack slots₁' slots₂' ∧
        s4_SlotValWf pack.bodySrc slots₁' ∧
        s4_BufRel pack slots₁' mem₁ slots₂' ∧
        s4_ScrLive pack slots₂' := by
  cases rval with
  | use op =>
    have hBase := s4_evalMemCopyBaseOperandToSlot_prefix pack hPM hWf hBuf hScr hRval
    dsimp [evalMemCopyBaseRvalue]
    cases h1 : evalMemCopyBaseOperandToSlot pack.bodySrc.locals slots₁ op with
    | error k => rw [h1] at hBase; rw [hBase]
    | ok res =>
      rw [h1] at hBase
      cases hBase with | intro slots₂' h2 =>
      rw [h2.1]
      dsimp
      cases !MirTy.beq res.1 dstTy with
      | true => rfl
      | false =>
        cases res.2.1 with
        | none => rfl
        | some v => exact ⟨slots₂', rfl, h2.2⟩
  | unaryOp uop op =>
    have hPrim := s4_evalMemCopyPrimitiveOperand_prefix pack hPM hWf hBuf hScr hRval
    dsimp [evalMemCopyBaseRvalue]
    cases h1 : evalMemCopyPrimitiveOperand pack.bodySrc.locals slots₁ op with
    | error k => rw [h1] at hPrim; rw [hPrim]
    | ok res =>
      rw [h1] at hPrim
      cases hPrim with | intro slots₂' h2 =>
      rw [h2.1]
      dsimp
      cases evalUnOp uop res.1 with
      | error k => rfl
      | ok v => exact ⟨slots₂', rfl, h2.2⟩
  | binaryOp bop l r =>
    have hOps := (bool_and_eq_true _ _).mp hRval
    have hL := s4_evalMemCopyPrimitiveOperand_prefix pack hPM hWf hBuf hScr hOps.1
    dsimp [evalMemCopyBaseRvalue]
    cases h1 : evalMemCopyPrimitiveOperand pack.bodySrc.locals slots₁ l with
    | error k => rw [h1] at hL; rw [hL]
    | ok resL =>
      rw [h1] at hL
      cases hL with | intro slots₂₁ h2L =>
      rw [h2L.1]
      dsimp
      have hR := s4_evalMemCopyPrimitiveOperand_prefix pack h2L.2.1 h2L.2.2.1 h2L.2.2.2.1 h2L.2.2.2.2 hOps.2
      cases h2 : evalMemCopyPrimitiveOperand pack.bodySrc.locals resL.2 r with
      | error k => rw [h2] at hR; rw [hR]
      | ok resR =>
        rw [h2] at hR
        cases hR with | intro slots₂₂ h2R =>
        rw [h2R.1]
        dsimp
        cases evalBinOp bop resL.1 resR.1 with
        | error k => rfl
        | ok v => exact ⟨slots₂₂, rfl, h2R.2⟩
  | discriminant place =>
    dsimp [rvalueUsesOnlyBaseMem] at hRval
    have hAnd := (bool_and_eq_true _ _).mp hRval
    cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals place.localId with
    | none => rw [hD] at hAnd; cases hAnd.2
    | some d =>
      rw [hD] at hAnd
      cases d with
      | ptrLocal | byteBuf _ _ _ => cases hAnd.2
      | base ty =>
        have hLt : place.localId < pack.bodySrc.locals.length := s4_getElem?_some_lt _ _ _ hD
        have hNe : place.localId ≠ plan.bufLocal := fun h => by
          rw [h, pack.hBufDecl] at hD; cases hD
        have hDTgt := s4_getElem?_bodyTgt_locals_lt pack hLt hNe
        rw [hD] at hDTgt
        have hNotP : (!place.projection.isEmpty) = false := by rw [hAnd.1]; rfl
        dsimp [evalMemCopyBaseRvalue]
        rw [hNotP]
        dsimp
        rw [hD, hDTgt, hPM.2.2 place.localId hLt hNe]
        cases ty with
        | enum ety =>
          cases hS : Trusted.MirSemantics.getElem? slots₁ place.localId with
          | none => rfl
          | some sl =>
            cases sl with
            | ptrDead | livePtr _ | bufSlot _ => rfl
            | baseSlot bs =>
              dsimp
              cases hEA : !enumAdmitted ety with
              | true => dsimp
              | false =>
                dsimp
                cases ety.tagRepr with
                | zeroSized =>
                  cases bs with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none =>
                      cases Trusted.MirSemantics.getElem? ety.discriminants 0 with
                      | none => rfl
                      | some _ => exact ⟨slots₂, rfl, hPM, hWf, hBuf, hScr⟩
                    | some v =>
                      cases v with
                      | enumVal ety' idx =>
                        dsimp
                        cases hCond : (ety.beq ety' && idx.beq 0) with
                        | false => dsimp
                        | true =>
                          dsimp
                          cases hDisc : Trusted.MirSemantics.getElem? ety.discriminants 0 with
                          | none => dsimp
                          | some _ => dsimp; exact ⟨slots₂, rfl, hPM, hWf, hBuf, hScr⟩
                      | scalar _ | bool | unit | ptr _ | tuple _ | bytes _ => rfl
                | scalar _ _ =>
                  cases bs with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none => rfl
                    | some v =>
                      cases v with
                      | enumVal ety' idx =>
                        dsimp
                        cases hCond : (ety.beq ety' && idx.blt ety.discriminants.length) with
                        | false => dsimp
                        | true =>
                          dsimp
                          cases hDisc : Trusted.MirSemantics.getElem? ety.discriminants idx with
                          | none => dsimp
                          | some _ => dsimp; exact ⟨slots₂, rfl, hPM, hWf, hBuf, hScr⟩
                      | scalar _ | bool | unit | ptr _ | tuple _ | bytes _ => rfl
        | int _ _ | bool | unit | rawPtr _ _ | ref _ _ | tuple _ | never | unsupported =>
          rfl
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported => rfl

private theorem s4_writeMemCopyBasePlace_prefix
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {slots₁ slots₂ : List MemCopySlot} {mem₁ : CallerMemory}
    {k : LocalId} {dstTy : MirTy} {val : Val}
    (hPM : s4_PrefixMatch pack slots₁ slots₂)
    (hWf : s4_SlotValWf pack.bodySrc slots₁)
    (hBuf : s4_BufRel pack slots₁ mem₁ slots₂)
    (hScr : s4_ScrLive pack slots₂)
    (hDecl : Trusted.MirSemantics.getElem? pack.bodySrc.locals k = some (.base dstTy))
    (hNe : k ≠ plan.bufLocal) :
    match writeMemCopyBasePlace slots₁ k dstTy val with
    | .error fk =>
      writeMemCopyBasePlace slots₂ k dstTy val = .error fk
    | .ok slots₁' =>
      ∃ slots₂',
        writeMemCopyBasePlace slots₂ k dstTy val = .ok slots₂' ∧
        s4_PrefixMatch pack slots₁' slots₂' ∧
        s4_SlotValWf pack.bodySrc slots₁' ∧
        s4_BufRel pack slots₁' mem₁ slots₂' ∧
        s4_ScrLive pack slots₂' := by
  have hLt : k < pack.bodySrc.locals.length := s4_getElem?_some_lt _ _ _ hDecl
  dsimp [writeMemCopyBasePlace]
  cases hChk : !checkVal val dstTy with
  | true => rfl
  | false =>
    dsimp
    rw [hPM.2.2 k hLt hNe]
    cases hS : Trusted.MirSemantics.getElem? slots₁ k with
    | none => rfl
    | some sl =>
      cases sl with
      | ptrDead | livePtr _ | bufSlot _ => rfl
      | baseSlot bs =>
        cases bs with
        | dead => rfl
        | live _ =>
          have hChkTrue : checkVal val dstTy = true := by
            cases hc : checkVal val dstTy with
            | true => rfl
            | false => rw [hc] at hChk; cases hChk
          have hLt1 : k < slots₁.length := by rw [hPM.1]; exact hLt
          have hLt2 : k < slots₂.length := by
            rw [hPM.2.1, s4_bodyTgt_locals_length pack]
            exact Nat.lt_of_lt_of_le
              (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hLt (Nat.le_add_right _ 1)) (Nat.le_add_right _ _))
              (Nat.le_add_right _ 4)
          cases s4_lt_setElem?_some slots₁ k (.baseSlot (.live (some val))) hLt1 with
          | intro slots₁' hSet1 =>
          cases s4_lt_setElem?_some slots₂ k (.baseSlot (.live (some val))) hLt2 with
          | intro slots₂' hSet2 =>
          dsimp
          rw [hSet1, hSet2]
          exact ⟨slots₂', rfl,
            s4_prefixMatch_set_prefix_other pack hPM hLt hNe hSet1 hSet2,
            s4_slotValWf_set_base_some hWf hDecl hChkTrue hSet1,
            s4_bufRel_set_prefix_other pack hBuf hLt hNe hSet1 hSet2,
            s4_scrLive_set_lt_scrBase pack hScr
              (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hLt (Nat.le_add_right _ 1)) (Nat.le_add_right _ _)) hSet2⟩

/-! ## Section 8: Multi-Step & Single-Step Target Statement Executors -/

private theorem s4_getElem?_bodyTgt_locals_liveArea_base
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {k : Nat} (hk : k < 1 + 2 * pack.size) :
    ∃ ty : MirTy,
      Trusted.MirSemantics.getElem? pack.bodyTgt.locals (pack.bodySrc.locals.length + k) =
        some (.base ty) := by
  cases k with
  | zero =>
    rw [Nat.add_zero]
    exact ⟨.unit, s4_getElem?_bodyTgt_locals_liveLoc pack⟩
  | succ m =>
    have hm : m < 2 * pack.size := by
      rw [Nat.add_comm 1 (2 * pack.size)] at hk
      exact Nat.lt_of_succ_lt_succ hk
    rw [Nat.add_comm m 1, ← Nat.add_assoc]
    exact ⟨usizeTy, s4_getElem?_bodyTgt_locals_byte pack hm⟩

private theorem s4_exec_mkStorageLiveRange_bytes
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bb : MemCopyBlock) (mem : CallerMemory)
    (pref suff : List MemCopyStmt) (start rem : Nat) (slots : List MemCopySlot)
    (hBb : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bb)
    (hStmts : bb.statements = pref ++ mkStorageLiveRange start rem ++ suff)
    (hLen : slots.length = pack.bodyTgt.locals.length)
    (hGe : pack.bodySrc.locals.length + 1 ≤ start)
    (hLeEnd : start + rem ≤ pack.bodySrc.locals.length + 1 + 2 * pack.size) :
    ∃ slots' : List MemCopySlot,
      ReachesNMemCopy pTgt rem
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length, locals := slots }],
          mem := mem }
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length + rem, locals := slots' }],
          mem := mem } ∧
      slots'.length = slots.length ∧
      (∀ i : Nat, i < start →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ i : Nat, start + rem ≤ i →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ k : Nat, k < rem →
        Trusted.MirSemantics.getElem? slots' (start + k) = some (.baseSlot (.live none))) := by
  induction rem generalizing pref start slots with
  | zero =>
    exact ⟨slots, ReachesNMemCopy.zero _, rfl, fun _ _ => rfl, fun _ _ => rfl, fun _ h => nomatch h⟩
  | succ rem ih =>
    let base := pack.bodySrc.locals.length
    have hStartSub : start - (base + 1) < 2 * pack.size := by
      have h1 : start < base + 1 + 2 * pack.size :=
        Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hLeEnd
      exact Nat.sub_lt_left_of_lt_add hGe h1
    have hDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals start = some (.base usizeTy) := by
      have h := s4_getElem?_bodyTgt_locals_byte pack hStartSub
      rw [Nat.add_sub_of_le hGe] at h
      exact h
    have hLtSl : start < slots.length := by
      rw [hLen, s4_bodyTgt_locals_length pack]
      exact Nat.lt_of_lt_of_le
        (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hLeEnd)
        (Nat.le_add_right _ 4)
    cases s4_lt_setElem?_some slots start (.baseSlot (.live none)) hLtSl with
    | intro slots1 hSet =>
    have hStep1 : evalStepMemCopy pTgt 0
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length, locals := slots }],
          mem := mem } =
        .step { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length + 1, locals := slots1 }],
                mem := mem } := by
      dsimp [evalStepMemCopy]
      rw [s4_getElem?_pTgt_bodies_eq pack]
      dsimp
      rw [hBb]
      dsimp
      have hGetSt : Trusted.MirSemantics.getElem? bb.statements pref.length =
          some (.baseStmt (.storageLive start)) := by
        rw [hStmts, List.append_assoc]
        have h := s4_getElem?_append_right pref (mkStorageLiveRange start (rem + 1) ++ suff) 0
        rw [Nat.add_zero] at h
        exact h
      rw [hGetSt]
      dsimp [evalMemCopyStmt]
      rw [hDecl]
      dsimp [liveUninitMemCopySlot, liveUninitSlot, usizeTy]
      rw [hSet]
      rfl
    have hStmtsNext : bb.statements =
        (pref ++ [.baseStmt (.storageLive start)]) ++ mkStorageLiveRange (start + 1) rem ++ suff := by
      rw [hStmts, List.append_assoc pref [.baseStmt (.storageLive start)] _]
      rfl
    have hLen1 : slots1.length = pack.bodyTgt.locals.length := by
      rw [s4_setElem?_length _ _ _ _ hSet, hLen]
    have hRest := ih (pref ++ [.baseStmt (.storageLive start)]) (start + 1) slots1 hStmtsNext hLen1
      (Nat.le_trans hGe (Nat.le_succ start)) (by rw [Nat.add_right_comm]; exact hLeEnd)
    cases hRest with | intro slots' hR =>
    rw [s4_list_append_length] at hR
    dsimp at hR
    rw [Nat.add_assoc pref.length 1 rem, Nat.add_comm 1 rem] at hR
    refine ⟨slots', s4_reachesNMemCopy_succ_head hStep1 hR.1,
      hR.2.1.trans (s4_setElem?_length _ _ _ _ hSet), ?_, ?_, ?_⟩
    · intro i hi
      have hNe : start ≠ i := fun h => by
        have hBad : i < i := by rw [h] at hi; exact hi
        exact s4_nat_lt_irrefl i hBad
      rw [hR.2.2.1 i (Nat.lt_trans hi (Nat.lt_succ_self start)),
        s4_getElem?_setElem?_ne slots start i _ slots1 hNe hSet]
    · intro i hi
      have hLe' : start + 1 + rem ≤ i := by rw [Nat.add_right_comm]; exact hi
      have hNe : start ≠ i := fun h => by
        have hBad : i + (rem + 1) ≤ i := by rw [h] at hi; exact hi
        exact s4_nat_lt_irrefl i (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hBad)
      rw [hR.2.2.2.1 i hLe', s4_getElem?_setElem?_ne slots start i _ slots1 hNe hSet]
    · intro k hk
      cases k with
      | zero =>
        rw [Nat.add_zero, hR.2.2.1 start (Nat.lt_succ_self start),
          s4_getElem?_setElem?_self slots start _ slots1 hSet]
      | succ m =>
        have hEq : start + (m + 1) = start + 1 + m := by
          rw [Nat.add_assoc, Nat.add_comm 1 m]
        rw [hEq]
        exact hR.2.2.2.2 m (Nat.lt_of_succ_lt_succ hk)

private theorem s4_exec_mkStorageLiveRange
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bb : MemCopyBlock) (mem : CallerMemory)
    (pref suff : List MemCopyStmt) (slots : List MemCopySlot)
    (hBb : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bb)
    (hStmts : bb.statements = pref ++ mkStorageLiveRange pack.bodySrc.locals.length (1 + 2 * pack.size) ++ suff)
    (hLen : slots.length = pack.bodyTgt.locals.length) :
    ∃ slots' : List MemCopySlot,
      ReachesNMemCopy pTgt (1 + 2 * pack.size)
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length, locals := slots }],
          mem := mem }
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length + (1 + 2 * pack.size), locals := slots' }],
          mem := mem } ∧
      slots'.length = slots.length ∧
      (∀ i : Nat, i < pack.bodySrc.locals.length →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ i : Nat, pack.bodySrc.locals.length + (1 + 2 * pack.size) ≤ i →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      Trusted.MirSemantics.getElem? slots' pack.bodySrc.locals.length =
        some (.baseSlot (.live (some .unit))) ∧
      (∀ k : Nat, k < 2 * pack.size →
        Trusted.MirSemantics.getElem? slots' (pack.bodySrc.locals.length + 1 + k) =
          some (.baseSlot (.live none))) := by
  let base := pack.bodySrc.locals.length
  have hLtSl : base < slots.length := by
    rw [hLen, s4_bodyTgt_locals_length pack]
    rw [Nat.add_assoc base 1 (2 * pack.size), Nat.add_assoc base (1 + 2 * pack.size) 4]
    exact Nat.lt_add_of_pos_right (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 0)
      (Nat.le_trans (Nat.le_add_right 1 (2 * pack.size)) (Nat.le_add_right _ 4)))
  cases s4_lt_setElem?_some slots base (.baseSlot (.live (some .unit))) hLtSl with
  | intro slots1 hSet1 =>
  have hStep0 : evalStepMemCopy pTgt 0
      { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length, locals := slots }],
        mem := mem } =
      .step { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length + 1, locals := slots1 }],
              mem := mem } := by
    dsimp [evalStepMemCopy]
    rw [s4_getElem?_pTgt_bodies_eq pack]
    dsimp
    rw [hBb]
    dsimp
    have hGetSt : Trusted.MirSemantics.getElem? bb.statements pref.length =
        some (.baseStmt (.storageLive base)) := by
      rw [hStmts, List.append_assoc]
      have h := s4_getElem?_append_right pref (mkStorageLiveRange base (1 + 2 * pack.size) ++ suff) 0
      rw [Nat.add_zero] at h
      rw [h]
      rw [Nat.add_comm 1 (2 * pack.size)]
      rfl
    rw [hGetSt]
    dsimp [evalMemCopyStmt]
    rw [s4_getElem?_bodyTgt_locals_liveLoc pack]
    dsimp [liveUninitMemCopySlot, liveUninitSlot]
    rw [hSet1]
    rfl
  have hStmtsRest : bb.statements =
      (pref ++ [.baseStmt (.storageLive base)]) ++ mkStorageLiveRange (base + 1) (2 * pack.size) ++ suff := by
    rw [hStmts, List.append_assoc pref [.baseStmt (.storageLive base)] _]
    have hDecomp : mkStorageLiveRange base (1 + 2 * pack.size) =
        [.baseStmt (.storageLive base)] ++ mkStorageLiveRange (base + 1) (2 * pack.size) := by
      rw [Nat.add_comm 1 (2 * pack.size)]; rfl
    rw [hDecomp, List.append_assoc]
  have hLen1 : slots1.length = pack.bodyTgt.locals.length := by
    rw [s4_setElem?_length _ _ _ _ hSet1, hLen]
  cases s4_exec_mkStorageLiveRange_bytes pack bbIdx bb mem
      (pref ++ [.baseStmt (.storageLive base)]) suff (base + 1) (2 * pack.size) slots1
      hBb hStmtsRest hLen1 (Nat.le_refl _) (Nat.le_refl _) with
  | intro slots' hR =>
  rw [s4_list_append_length] at hR
  dsimp at hR
  have hAssoc1 : pref.length + 1 + 2 * pack.size = pref.length + (1 + 2 * pack.size) := by
    rw [Nat.add_assoc]
  rw [hAssoc1] at hR
  refine ⟨slots', ?_, hR.2.1.trans (s4_setElem?_length _ _ _ _ hSet1), ?_, ?_, ?_, hR.2.2.2.2⟩
  · have hRN := s4_reachesNMemCopy_succ_head hStep0 hR.1
    rw [Nat.add_comm (2 * pack.size) 1] at hRN
    exact hRN
  · intro i hi
    have hNe : pack.bodySrc.locals.length ≠ i := fun h => by
      have hBad : i < i := by
        have hi' : i < pack.bodySrc.locals.length := hi
        rw [h] at hi'
        exact hi'
      exact s4_nat_lt_irrefl i hBad
    rw [hR.2.2.1 i (Nat.lt_trans hi (Nat.lt_succ_self base)),
      s4_getElem?_setElem?_ne slots base i _ slots1 hNe hSet1]
  · intro i hi
    have hLe' : base + 1 + 2 * pack.size ≤ i := by rw [← Nat.add_assoc] at hi; exact hi
    have hNe : pack.bodySrc.locals.length ≠ i := fun h => by
      have hHi : pack.bodySrc.locals.length + (1 + 2 * pack.size) ≤ i := hi
      rw [h] at hHi
      exact s4_nat_lt_irrefl i (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right
        (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 0) (Nat.le_add_right 1 _))) hHi)
    rw [hR.2.2.2.1 i hLe', s4_getElem?_setElem?_ne slots base i _ slots1 hNe hSet1]
  · rw [hR.2.2.1 base (Nat.lt_succ_self base), s4_getElem?_setElem?_self slots base _ slots1 hSet1]

private theorem s4_exec_mkZeroUsizeRangeGen
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bb : MemCopyBlock) (mem : CallerMemory)
    (pref suff : List MemCopyStmt) (start rem : Nat) (slots : List MemCopySlot)
    (hBb : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bb)
    (hStmts : bb.statements = pref ++ mkZeroUsizeRange start rem ++ suff)
    (hLen : slots.length = pack.bodyTgt.locals.length)
    (hLeEnd : start + rem ≤ pack.bodySrc.locals.length + 1 + 2 * pack.size)
    (hGeStart : pack.bodySrc.locals.length + 1 ≤ start)
    (hLive : ∀ k : Nat, k < rem → ∃ ov : Option Val,
      Trusted.MirSemantics.getElem? slots (start + k) = some (.baseSlot (.live ov))) :
    ∃ slots' : List MemCopySlot,
      ReachesNMemCopy pTgt rem
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length, locals := slots }],
          mem := mem }
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length + rem, locals := slots' }],
          mem := mem } ∧
      slots'.length = slots.length ∧
      (∀ i : Nat, i < start →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ i : Nat, start + rem ≤ i →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ k : Nat, k < rem →
        Trusted.MirSemantics.getElem? slots' (start + k) =
          some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 0⟩))))) := by
  induction rem generalizing pref start slots with
  | zero =>
    exact ⟨slots, ReachesNMemCopy.zero _, rfl, fun _ _ => rfl, fun _ _ => rfl, fun _ h => nomatch h⟩
  | succ rem ih =>
    let base := pack.bodySrc.locals.length
    have hStartSub : start - (base + 1) < 2 * pack.size := by
      have h1 : start < base + 1 + 2 * pack.size :=
        Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hLeEnd
      exact Nat.sub_lt_left_of_lt_add hGeStart h1
    have hDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals start = some (.base usizeTy) := by
      have h := s4_getElem?_bodyTgt_locals_byte pack hStartSub
      rw [Nat.add_sub_of_le hGeStart] at h
      exact h
    have hL0 := hLive 0 (Nat.zero_lt_succ rem)
    rw [Nat.add_zero] at hL0
    cases hL0 with | intro ov hSl0 =>
    have hLtSl : start < slots.length := s4_getElem?_some_lt slots start (.baseSlot (.live ov)) hSl0
    let zeroVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 0⟩
    cases s4_lt_setElem?_some slots start (.baseSlot (.live (some zeroVal))) hLtSl with
    | intro slots1 hSet =>
    have hStep1 : evalStepMemCopy pTgt 0
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length, locals := slots }],
          mem := mem } =
        .step { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length + 1, locals := slots1 }],
                mem := mem } := by
      dsimp [evalStepMemCopy]
      rw [s4_getElem?_pTgt_bodies_eq pack]
      dsimp
      rw [hBb]
      dsimp
      have hGetSt : Trusted.MirSemantics.getElem? bb.statements pref.length =
          some (mkAssignUse start (usizeConst 0)) := by
        rw [hStmts, List.append_assoc]
        have h := s4_getElem?_append_right pref (mkZeroUsizeRange start (rem + 1) ++ suff) 0
        rw [Nat.add_zero] at h
        exact h
      rw [hGetSt]
      dsimp [evalMemCopyStmt, mkAssignUse]
      rw [hDecl]
      dsimp [evalMemCopyBaseRvalue, evalMemCopyBaseOperandToSlot, usizeConst]
      rw [s4_evalConstLit_usizeConst s4_maxUsize_pos]
      dsimp [writeMemCopyBasePlace]
      have hTy : (!usizeTy.beq usizeTy) = false := rfl
      rw [hTy]
      dsimp
      have hNotChk : (!checkVal zeroVal usizeTy) = false := by
        rw [s4_checkVal_usize_ofNat s4_maxUsize_pos]; rfl
      rw [hNotChk]
      dsimp
      rw [hSl0]
      dsimp
      rw [hSet]
      rfl
    have hStmtsNext : bb.statements =
        (pref ++ [mkAssignUse start (usizeConst 0)]) ++ mkZeroUsizeRange (start + 1) rem ++ suff := by
      rw [hStmts, List.append_assoc pref [mkAssignUse start (usizeConst 0)] _]
      rfl
    have hLen1 : slots1.length = pack.bodyTgt.locals.length := by
      rw [s4_setElem?_length slots start _ slots1 hSet, hLen]
    have hLiveNext : ∀ k : Nat, k < rem → ∃ ov' : Option Val,
        Trusted.MirSemantics.getElem? slots1 (start + 1 + k) = some (.baseSlot (.live ov')) := by
      intro k hk
      have hNe : start ≠ start + 1 + k := fun h => by
        have hLe : start + 1 ≤ start + 1 + k := Nat.le_add_right (start + 1) k
        rw [← h] at hLe
        exact s4_nat_lt_irrefl start hLe
      rw [s4_getElem?_setElem?_ne slots start (start + 1 + k) _ slots1 hNe hSet]
      have hPrev := hLive (k + 1) (Nat.succ_lt_succ hk)
      rw [Nat.add_assoc, Nat.add_comm 1 k]
      exact hPrev
    have hRest := ih (pref ++ [mkAssignUse start (usizeConst 0)]) (start + 1) slots1
      hStmtsNext hLen1 (by rw [Nat.add_right_comm]; exact hLeEnd)
      (Nat.le_trans hGeStart (Nat.le_succ start)) hLiveNext
    cases hRest with | intro slots' hR =>
    rw [s4_list_append_length] at hR
    dsimp at hR
    rw [Nat.add_assoc pref.length 1 rem, Nat.add_comm 1 rem] at hR
    refine ⟨slots', s4_reachesNMemCopy_succ_head hStep1 hR.1,
      hR.2.1.trans (s4_setElem?_length slots start _ slots1 hSet), ?_, ?_, ?_⟩
    · intro i hi
      have hNe : start ≠ i := fun h => by
        have hBad : i < i := by rw [h] at hi; exact hi
        exact s4_nat_lt_irrefl i hBad
      rw [hR.2.2.1 i (Nat.lt_trans hi (Nat.lt_succ_self start)),
        s4_getElem?_setElem?_ne slots start i _ slots1 hNe hSet]
    · intro i hi
      have hLe' : start + 1 + rem ≤ i := by rw [Nat.add_right_comm]; exact hi
      have hNe : start ≠ i := fun h => by
        have hBad : i + (rem + 1) ≤ i := by rw [h] at hi; exact hi
        exact s4_nat_lt_irrefl i (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hBad)
      rw [hR.2.2.2.1 i hLe', s4_getElem?_setElem?_ne slots start i _ slots1 hNe hSet]
    · intro k hk
      cases k with
      | zero =>
        rw [Nat.add_zero, hR.2.2.1 start (Nat.lt_succ_self start),
          s4_getElem?_setElem?_self slots start _ slots1 hSet]
      | succ m =>
        have hEq : start + (m + 1) = start + 1 + m := by
          rw [Nat.add_assoc, Nat.add_comm 1 m]
        rw [hEq]
        exact hR.2.2.2.2 m (Nat.lt_of_succ_lt_succ hk)

private theorem s4_exec_mkStorageDeadRange
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (bbIdx : BasicBlockId) (bb : MemCopyBlock) (mem : CallerMemory)
    (pref suff : List MemCopyStmt) (start rem : Nat) (slots : List MemCopySlot)
    (hBb : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks bbIdx = some bb)
    (hStmts : bb.statements = pref ++ mkStorageDeadRange start rem ++ suff)
    (hLen : slots.length = pack.bodyTgt.locals.length)
    (hGe : pack.bodySrc.locals.length ≤ start)
    (hLeEnd : start + rem ≤ pack.bodySrc.locals.length + (1 + 2 * pack.size)) :
    ∃ slots' : List MemCopySlot,
      ReachesNMemCopy pTgt rem
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length, locals := slots }],
          mem := mem }
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length + rem, locals := slots' }],
          mem := mem } ∧
      slots'.length = slots.length ∧
      (∀ i : Nat, i < start →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ i : Nat, start + rem ≤ i →
        Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
      (∀ k : Nat, k < rem →
        Trusted.MirSemantics.getElem? slots' (start + k) = some (.baseSlot .dead)) := by
  induction rem generalizing pref start slots with
  | zero =>
    exact ⟨slots, ReachesNMemCopy.zero _, rfl, fun _ _ => rfl, fun _ _ => rfl, fun _ h => nomatch h⟩
  | succ rem ih =>
    let base := pack.bodySrc.locals.length
    have hPosBase : 0 < base :=
      Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.zero_le _) pack.hArgLtBuf) pack.hBufLtLoc
    have hPosStart : 0 < start := Nat.lt_of_lt_of_le hPosBase hGe
    have hNe0 : Nat.beq start 0 = false := s4_nat_beq_false (Nat.ne_of_gt hPosStart)
    have hSubLt : start - base < 1 + 2 * pack.size := by
      have h1 : start < base + (1 + 2 * pack.size) :=
        Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hLeEnd
      exact Nat.sub_lt_left_of_lt_add hGe h1
    cases s4_getElem?_bodyTgt_locals_liveArea_base pack hSubLt with
    | intro ty hDecl =>
    rw [Nat.add_sub_of_le hGe] at hDecl
    have hLtSl : start < slots.length := by
      rw [hLen, s4_bodyTgt_locals_length pack]
      rw [Nat.add_assoc base 1 (2 * pack.size)]
      exact Nat.lt_of_lt_of_le
        (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hLeEnd)
        (Nat.le_add_right _ 4)
    cases s4_lt_setElem?_some slots start (.baseSlot .dead) hLtSl with
    | intro slots1 hSet =>
    have hStep1 : evalStepMemCopy pTgt 0
        { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length, locals := slots }],
          mem := mem } =
        .step { frames := [{ defId := plan.defId, blockIdx := bbIdx, stmtIdx := pref.length + 1, locals := slots1 }],
                mem := mem } := by
      dsimp [evalStepMemCopy]
      rw [s4_getElem?_pTgt_bodies_eq pack]
      dsimp
      rw [hBb]
      dsimp
      have hGetSt : Trusted.MirSemantics.getElem? bb.statements pref.length =
          some (.baseStmt (.storageDead start)) := by
        rw [hStmts, List.append_assoc]
        have h := s4_getElem?_append_right pref (mkStorageDeadRange start (rem + 1) ++ suff) 0
        rw [Nat.add_zero] at h
        exact h
      rw [hGetSt]
      dsimp [evalMemCopyStmt]
      rw [hNe0]
      dsimp
      rw [hDecl]
      dsimp [deadMemCopySlot]
      rw [hSet]
      rfl
    have hStmtsNext : bb.statements =
        (pref ++ [.baseStmt (.storageDead start)]) ++ mkStorageDeadRange (start + 1) rem ++ suff := by
      rw [hStmts, List.append_assoc pref [.baseStmt (.storageDead start)] _]
      rfl
    have hLen1 : slots1.length = pack.bodyTgt.locals.length := by
      rw [s4_setElem?_length _ _ _ _ hSet, hLen]
    have hRest := ih (pref ++ [.baseStmt (.storageDead start)]) (start + 1) slots1 hStmtsNext hLen1
      (Nat.le_trans hGe (Nat.le_succ start)) (by rw [Nat.add_right_comm]; exact hLeEnd)
    cases hRest with | intro slots' hR =>
    rw [s4_list_append_length] at hR
    dsimp at hR
    rw [Nat.add_assoc pref.length 1 rem, Nat.add_comm 1 rem] at hR
    refine ⟨slots', s4_reachesNMemCopy_succ_head hStep1 hR.1,
      hR.2.1.trans (s4_setElem?_length _ _ _ _ hSet), ?_, ?_, ?_⟩
    · intro i hi
      have hNe : start ≠ i := fun h => by
        have hBad : i < i := by rw [h] at hi; exact hi
        exact s4_nat_lt_irrefl i hBad
      rw [hR.2.2.1 i (Nat.lt_trans hi (Nat.lt_succ_self start)),
        s4_getElem?_setElem?_ne slots start i _ slots1 hNe hSet]
    · intro i hi
      have hLe' : start + 1 + rem ≤ i := by rw [Nat.add_right_comm]; exact hi
      have hNe : start ≠ i := fun h => by
        have hBad : i + (rem + 1) ≤ i := by rw [h] at hi; exact hi
        exact s4_nat_lt_irrefl i (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hBad)
      rw [hR.2.2.2.1 i hLe', s4_getElem?_setElem?_ne slots start i _ slots1 hNe hSet]
    · intro k hk
      cases k with
      | zero =>
        rw [Nat.add_zero, hR.2.2.1 start (Nat.lt_succ_self start),
          s4_getElem?_setElem?_self slots start _ slots1 hSet]
      | succ m =>
        have hEq : start + (m + 1) = start + 1 + m := by
          rw [Nat.add_assoc, Nat.add_comm 1 m]
        rw [hEq]
        exact hR.2.2.2.2 m (Nat.lt_of_succ_lt_succ hk)

private theorem s4_step_mkLivenessCheckStmt_dead
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (frame : MemCopyFrame) (mem : CallerMemory)
    (hSl : Trusted.MirSemantics.getElem? frame.locals pack.bodySrc.locals.length =
      some (.baseSlot .dead)) :
    evalMemCopyStmt pack.bodyTgt frame mem (mkLivenessCheckStmt pack.bodySrc.locals.length) =
      .fault .undefined := by
  dsimp [evalMemCopyStmt, mkLivenessCheckStmt]
  rw [s4_getElem?_bodyTgt_locals_liveLoc pack]
  dsimp [evalMemCopyBaseRvalue, evalMemCopyBaseOperandToSlot, evalConstLit, writeMemCopyBasePlace]
  have hTy : (!MirTy.beq .unit .unit) = false := rfl
  rw [hTy]
  dsimp
  have hChk : (!checkVal .unit .unit) = false := rfl
  rw [hChk]
  dsimp
  rw [hSl]

private theorem s4_step_mkLivenessCheckStmt_live
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (frame : MemCopyFrame) (mem : CallerMemory)
    (hSl : Trusted.MirSemantics.getElem? frame.locals pack.bodySrc.locals.length =
      some (.baseSlot (.live (some .unit)))) :
    evalMemCopyStmt pack.bodyTgt frame mem (mkLivenessCheckStmt pack.bodySrc.locals.length) =
      stepMemCopyNext frame mem frame.locals := by
  dsimp [evalMemCopyStmt, mkLivenessCheckStmt]
  rw [s4_getElem?_bodyTgt_locals_liveLoc pack]
  dsimp [evalMemCopyBaseRvalue, evalMemCopyBaseOperandToSlot, evalConstLit, writeMemCopyBasePlace]
  have hTy : (!MirTy.beq .unit .unit) = false := rfl
  rw [hTy]
  dsimp
  have hChk : (!checkVal .unit .unit) = false := rfl
  rw [hChk]
  dsimp
  rw [hSl]
  dsimp
  rw [s4_setElem?_self_eq frame.locals pack.bodySrc.locals.length _ hSl]

private theorem s4_step_mkImmediateUbStmt
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (frame : MemCopyFrame) (mem : CallerMemory) {r : Nat} (hr : r < 4) :
    evalMemCopyStmt pack.bodyTgt frame mem
        (mkImmediateUbStmt (pack.bodySrc.locals.length + 1 + 2 * pack.size + r)) =
      .fault .undefined := by
  dsimp [evalMemCopyStmt, mkImmediateUbStmt]
  rw [s4_getElem?_bodyTgt_locals_scr pack hr]
  have hEv0 : evalConstLit usizeTy (.scalar (BitVec.ofNat 128 0)) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 0⟩) :=
    s4_evalConstLit_usizeConst s4_maxUsize_pos
  have hEv1 : evalConstLit usizeTy (.scalar (BitVec.ofNat 128 1)) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 1⟩) :=
    s4_evalConstLit_usizeConst (Nat.lt_of_lt_of_le (Nat.succ_lt_succ (Nat.zero_lt_succ 254)) s4_256_le_maxUsize)
  dsimp [usizeTy] at hEv0 hEv1
  have hPrimUsize : (!isPrimitiveReadableTy (.int .isize false)) = false := rfl
  dsimp [evalMemCopyBaseRvalue, evalMemCopyPrimitiveOperand, evalMemCopyBaseOperandToSlot,
    usizeConst, usizeTy]
  rw [hEv0, hEv1]
  dsimp
  rw [hPrimUsize]
  dsimp
  rw [s4_evalBinOp_usize_subUnchecked_zero_one]

private theorem s4_checkVal_usize_nonScalar (v : Val)
    (hNon : ∀ sv : ScalarVal, v ≠ .scalar sv) :
    checkVal v usizeTy = false := by
  cases hC : checkVal v usizeTy with
  | false => rfl
  | true =>
    cases (s4_checkVal_usize_iff v).mp hC with | intro sv hsv =>
    exact False.elim (hNon sv hsv.1)

private theorem s4_step_mkAssignUse_usize_err
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (f₁ f₂ : MemCopyFrame) (mem₁ mem₂ : CallerMemory)
    {dst : LocalId} {op : Operand} {fk : FaultKind}
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals mem₁ f₂.locals)
    (hScr : s4_ScrLive pack f₂.locals)
    (hDstDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some (.base usizeTy))
    (hOp : operandHasBaseTy pack.bodySrc.locals usizeTy op = true)
    (hErr : evalUsizeOp pack.bodySrc.locals f₁.locals op = .error fk) :
    evalMemCopyStmt pack.bodyTgt f₂ mem₂ (mkAssignUse dst op) = .fault fk := by
  have hBaseOp := s4_operandUsesOnlyBaseMem_of_hasBaseTy pack.bodySrc.locals usizeTy op hOp
  have hPrefix := s4_evalMemCopyBaseOperandToSlot_prefix pack hPM hWf hBuf hScr hBaseOp
  have hUsize := s4_evalUsizeOp_prefix pack hPM hWf hBuf hScr hBaseOp
  rw [hErr] at hUsize
  dsimp [evalUsizeOp] at hUsize hErr
  dsimp [evalMemCopyStmt, mkAssignUse]
  rw [hDstDecl]
  dsimp [evalMemCopyBaseRvalue]
  cases hEv1 : evalMemCopyBaseOperandToSlot pack.bodySrc.locals f₁.locals op with
  | error k1 =>
    rw [hEv1] at hPrefix hErr
    rw [hPrefix]
    dsimp
    cases Except.error.inj hErr
    rfl
  | ok res =>
    rw [hEv1] at hPrefix hErr
    cases hPrefix with | intro slots₂' h2 =>
    rw [h2.1]
    dsimp
    have hTyEq : MirTy.beq res.1 usizeTy = true := by
      cases op with
      | constant c =>
        dsimp [operandHasBaseTy] at hOp
        have hAnd := (bool_and_eq_true _ _).mp hOp
        dsimp [evalMemCopyBaseOperandToSlot] at hEv1
        cases hEc : evalConstLit c.ty c.lit with
        | error _ => rw [hEc] at hEv1; cases hEv1
        | ok _ =>
          rw [hEc] at hEv1
          have hFst : c.ty = res.1 := congrArg Prod.fst (Except.ok.inj hEv1)
          rw [← hFst]
          exact hAnd.1
      | copy p =>
        dsimp [operandHasBaseTy] at hOp
        have hAnd := (bool_and_eq_true _ _).mp hOp
        cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
        | none => rw [hD] at hAnd; cases hAnd.2
        | some d =>
          rw [hD] at hAnd
          cases d with
          | ptrLocal | byteBuf _ _ _ => cases hAnd.2
          | base tyD =>
            have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
            dsimp [evalMemCopyBaseOperandToSlot] at hEv1
            rw [hNotP] at hEv1
            dsimp at hEv1
            rw [hD] at hEv1
            cases hS : Trusted.MirSemantics.getElem? f₁.locals p.localId with
            | none => rw [hS] at hEv1; cases hEv1
            | some sl =>
              rw [hS] at hEv1
              cases sl with
              | ptrDead | livePtr _ | bufSlot _ => cases hEv1
              | baseSlot bs =>
                cases bs with
                | dead => cases hEv1
                | live ov =>
                  have hFst : tyD = res.1 := congrArg Prod.fst (Except.ok.inj hEv1)
                  rw [← hFst]
                  exact hAnd.2
      | move p =>
        dsimp [operandHasBaseTy] at hOp
        have hAnd := (bool_and_eq_true _ _).mp hOp
        cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
        | none => rw [hD] at hAnd; cases hAnd.2
        | some d =>
          rw [hD] at hAnd
          cases d with
          | ptrLocal | byteBuf _ _ _ => cases hAnd.2
          | base tyD =>
            have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
            dsimp [evalMemCopyBaseOperandToSlot] at hEv1
            rw [hNotP] at hEv1
            dsimp at hEv1
            rw [hD] at hEv1
            cases hS : Trusted.MirSemantics.getElem? f₁.locals p.localId with
            | none => rw [hS] at hEv1; cases hEv1
            | some sl =>
              rw [hS] at hEv1
              cases sl with
              | ptrDead | livePtr _ | bufSlot _ => cases hEv1
              | baseSlot bs =>
                cases bs with
                | dead => cases hEv1
                | live ov =>
                  have hFst : tyD = res.1 := by
                    dsimp at hEv1
                    cases hSetM : setElem? f₁.locals p.localId (.baseSlot (liveUninitSlot tyD)) with
                    | none => rw [hSetM] at hEv1; cases hEv1
                    | some _ => rw [hSetM] at hEv1; exact congrArg Prod.fst (Except.ok.inj hEv1)
                  rw [← hFst]
                  exact hAnd.2
    have hNotEq : (!MirTy.beq res.1 usizeTy) = false := by rw [hTyEq]; rfl
    rw [hNotEq]
    dsimp at hErr
    rw [hNotEq] at hErr
    dsimp at hErr; dsimp
    cases hOpt : res.2.1 with
    | none =>
      rw [hOpt] at hErr
      cases Except.error.inj hErr
      rfl
    | some v =>
      rw [hOpt] at hErr
      cases v with
      | scalar sv =>
        dsimp at hErr
        cases hSwf : sv.wf with
        | true => rw [hSwf] at hErr; dsimp at hErr; cases hErr
        | false =>
          rw [hSwf] at hErr
          dsimp at hErr
          cases Except.error.inj hErr
          dsimp [writeMemCopyBasePlace]
          have hChkF : checkVal (.scalar sv) usizeTy = false := by
            cases hC : checkVal (.scalar sv) usizeTy with
            | false => rfl
            | true =>
              cases (s4_checkVal_usize_iff _).mp hC with
              | intro sv' hsv' =>
                cases Val.scalar.inj hsv'.1
                have hSwfT := hsv'.2.2.2.1
                rw [hSwf] at hSwfT
                cases hSwfT
          rw [hChkF]
          dsimp
      | bool _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ =>
        dsimp [writeMemCopyBasePlace]
        rw [s4_checkVal_usize_nonScalar _ (fun _ h => by cases h)]
        cases Except.error.inj hErr
        dsimp

private theorem s4_step_mkAssignUse_usize_ok
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (f₁ f₂ : MemCopyFrame) (mem₁ mem₂ : CallerMemory)
    {dst : LocalId} {op : Operand} {n : Nat} {slots₁' : List MemCopySlot} {ovOld : Option Val}
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals mem₁ f₂.locals)
    (hScr : s4_ScrLive pack f₂.locals)
    (hDstDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals dst = some (.base usizeTy))
    (hDstGe : pack.bodySrc.locals.length ≤ dst)
    (hDstLive : Trusted.MirSemantics.getElem? f₂.locals dst = some (.baseSlot (.live ovOld)))
    (hOp : operandHasBaseTy pack.bodySrc.locals usizeTy op = true)
    (hOk : evalUsizeOp pack.bodySrc.locals f₁.locals op = .ok (n, slots₁')) :
    n < maxUsize ∧
    ∃ slots₂Mid slots₂' : List MemCopySlot,
      evalMemCopyBaseOperandToSlot pack.bodyTgt.locals f₂.locals op =
        .ok (usizeTy, some (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩), slots₂Mid) ∧
      setElem? slots₂Mid dst (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 n⟩)))) =
        some slots₂' ∧
      evalMemCopyStmt pack.bodyTgt f₂ mem₂ (mkAssignUse dst op) =
        stepMemCopyNext f₂ mem₂ slots₂' ∧
      s4_PrefixMatch pack slots₁' slots₂Mid ∧
      s4_SlotValWf pack.bodySrc slots₁' ∧
      s4_BufRel pack slots₁' mem₁ slots₂Mid ∧
      s4_ScrLive pack slots₂Mid := by
  have hBaseOp := s4_operandUsesOnlyBaseMem_of_hasBaseTy pack.bodySrc.locals usizeTy op hOp
  have hPrefix := s4_evalMemCopyBaseOperandToSlot_prefix pack hPM hWf hBuf hScr hBaseOp
  have hUsize := s4_evalUsizeOp_prefix pack hPM hWf hBuf hScr hBaseOp
  rw [hOk] at hUsize
  have hNLt : n < maxUsize := hUsize.1
  dsimp [evalUsizeOp] at hOk
  cases hEv1 : evalMemCopyBaseOperandToSlot pack.bodySrc.locals f₁.locals op with
  | error k1 => rw [hEv1] at hOk; cases hOk
  | ok res =>
    rw [hEv1] at hOk hPrefix
    cases hPrefix with | intro slots₂Mid h2 =>
    dsimp at hOk
    cases hU : !MirTy.beq res.1 usizeTy with
    | true => rw [hU] at hOk; cases hOk
    | false =>
      rw [hU] at hOk
      dsimp at hOk
      have hTyEq : res.1 = usizeTy := s4b_mirTy_beq_usize_eq res.1 (by
        cases hb : MirTy.beq res.1 usizeTy with | true => rfl | false => rw [hb] at hU; cases hU)
      cases hOpt : res.2.1 with
      | none => rw [hOpt] at hOk; cases hOk
      | some v =>
        rw [hOpt] at hOk
        cases v with
        | bool _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => cases hOk
        | scalar sv =>
          dsimp at hOk
          cases hSwf : sv.wf with
          | false => rw [hSwf] at hOk; dsimp at hOk; cases hOk
          | true =>
            rw [hSwf] at hOk
            dsimp at hOk
            have hPair := Prod.mk.inj (Except.ok.inj hOk)
            have hNEq : sv.bits.toNat = n := hPair.1
            have hSlEq : res.2.2 = slots₁' := hPair.2
            have hSvEq : sv = ⟨.isize, false, BitVec.ofNat 128 n⟩ := by
              have hChk : checkVal (.scalar sv) usizeTy = true := by
                cases op with
                | constant c =>
                  dsimp [evalMemCopyBaseOperandToSlot] at hEv1
                  cases hEc : evalConstLit c.ty c.lit with
                  | error _ => rw [hEc] at hEv1; cases hEv1
                  | ok vc =>
                    rw [hEc] at hEv1
                    have hT1 : res.1 = c.ty := (congrArg Prod.fst (Except.ok.inj hEv1)).symm
                    have hV1 : vc = .scalar sv := by
                      have hOpt1 := congrArg (fun p => p.2.1) (Except.ok.inj hEv1)
                      exact Option.some.inj (hOpt1.trans hOpt)
                    rw [← hT1, hTyEq] at hEc
                    rw [hV1] at hEc
                    cases hLit : c.lit with
                    | zeroSized => rw [hLit] at hEc; cases hEc
                    | scalar bits =>
                      rw [hLit] at hEc
                      dsimp [evalConstLit, usizeTy] at hEc
                      cases hB : truncateBits .isize bits != bits with
                      | true => rw [hB] at hEc; cases hEc
                      | false =>
                        rw [hB] at hEc
                        have hSc := Val.scalar.inj (Except.ok.inj hEc)
                        have hW := congrArg ScalarVal.width hSc
                        have hS := congrArg ScalarVal.signed hSc
                        refine (s4_checkVal_usize_iff _).mpr ⟨sv, rfl, hW.symm, hS.symm, hSwf, hNEq ▸ hNLt⟩
                | copy p =>
                  dsimp [operandUsesOnlyBaseMem] at hBaseOp
                  have hAnd := (bool_and_eq_true _ _).mp hBaseOp
                  cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
                  | none => rw [hD] at hAnd; cases hAnd.2
                  | some d =>
                    rw [hD] at hAnd
                    cases d with
                    | ptrLocal | byteBuf _ _ _ => cases hAnd.2
                    | base tyD =>
                      have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
                      dsimp [evalMemCopyBaseOperandToSlot] at hEv1
                      rw [hNotP] at hEv1
                      dsimp at hEv1
                      rw [hD] at hEv1
                      cases hS : Trusted.MirSemantics.getElem? f₁.locals p.localId with
                      | none => rw [hS] at hEv1; cases hEv1
                      | some sl =>
                        rw [hS] at hEv1
                        cases sl with
                        | ptrDead | livePtr _ | bufSlot _ => cases hEv1
                        | baseSlot bs =>
                          cases bs with
                          | dead => cases hEv1
                          | live optV =>
                            have hFst : tyD = res.1 := congrArg Prod.fst (Except.ok.inj hEv1)
                            have hTyD : tyD = usizeTy := by
                              rw [hFst]
                              exact hTyEq
                            have hV : optV = some (.scalar sv) :=
                              (congrArg (fun p => p.2.1) (Except.ok.inj hEv1)).trans hOpt
                            rw [hV] at hS
                            rw [hTyD] at hD
                            exact hWf p.localId usizeTy (.scalar sv) hD hS
                | move p =>
                  dsimp [operandUsesOnlyBaseMem] at hBaseOp
                  have hAnd := (bool_and_eq_true _ _).mp hBaseOp
                  cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
                  | none => rw [hD] at hAnd; cases hAnd.2
                  | some d =>
                    rw [hD] at hAnd
                    cases d with
                    | ptrLocal | byteBuf _ _ _ => cases hAnd.2
                    | base tyD =>
                      have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
                      dsimp [evalMemCopyBaseOperandToSlot] at hEv1
                      rw [hNotP] at hEv1
                      dsimp at hEv1
                      rw [hD] at hEv1
                      cases hS : Trusted.MirSemantics.getElem? f₁.locals p.localId with
                      | none => rw [hS] at hEv1; cases hEv1
                      | some sl =>
                        rw [hS] at hEv1
                        cases sl with
                        | ptrDead | livePtr _ | bufSlot _ => cases hEv1
                        | baseSlot bs =>
                          cases bs with
                          | dead => cases hEv1
                          | live optV =>
                            have hPair : tyD = res.1 ∧ optV = res.2.1 := by
                              dsimp at hEv1
                              cases hSetM : setElem? f₁.locals p.localId (.baseSlot (liveUninitSlot tyD)) with
                              | none => rw [hSetM] at hEv1; cases hEv1
                              | some _ =>
                                rw [hSetM] at hEv1
                                exact ⟨congrArg Prod.fst (Except.ok.inj hEv1),
                                  congrArg (fun p => p.2.1) (Except.ok.inj hEv1)⟩
                            have hTyD : tyD = usizeTy := by
                              rw [hPair.1]; exact hTyEq
                            have hV : optV = some (.scalar sv) := hPair.2.trans hOpt
                            rw [hV] at hS
                            rw [hTyD] at hD
                            exact hWf p.localId usizeTy (.scalar sv) hD hS
              have hC := (s4_checkVal_usize_iff _).mp hChk
              cases hC with | intro sv' hsv' =>
              cases Val.scalar.inj hsv'.1
              rw [s4_scalarVal_eq_ofNat sv hsv'.2.1 hsv'.2.2.1 hsv'.2.2.2.1, hNEq]
            have hDstEqMid : Trusted.MirSemantics.getElem? slots₂Mid dst =
                some (.baseSlot (.live ovOld)) := by
              cases op with
              | constant c =>
                dsimp [evalMemCopyBaseOperandToSlot] at hEv1
                have hEv2 := h2.1
                dsimp [evalMemCopyBaseOperandToSlot] at hEv2
                cases hEc : evalConstLit c.ty c.lit with
                | error _ => rw [hEc] at hEv1; cases hEv1
                | ok _ =>
                  rw [hEc] at hEv2
                  have hF : f₂.locals = slots₂Mid := congrArg (fun p => p.2.2) (Except.ok.inj hEv2)
                  rw [← hF]; exact hDstLive
              | copy p =>
                dsimp [operandUsesOnlyBaseMem] at hBaseOp
                have hAnd := (bool_and_eq_true _ _).mp hBaseOp
                have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
                have hEv2 := h2.1
                dsimp [evalMemCopyBaseOperandToSlot] at hEv2
                rw [hNotP] at hEv2
                dsimp at hEv2
                cases hDT : Trusted.MirSemantics.getElem? pack.bodyTgt.locals p.localId with
                | none => rw [hDT] at hEv2; cases hEv2
                | some d =>
                  rw [hDT] at hEv2
                  cases d with
                  | ptrLocal | byteBuf _ _ _ => cases hEv2
                  | base _ =>
                    cases hST : Trusted.MirSemantics.getElem? f₂.locals p.localId with
                    | none => rw [hST] at hEv2; cases hEv2
                    | some sl =>
                      rw [hST] at hEv2
                      cases sl with
                      | ptrDead | livePtr _ | bufSlot _ => cases hEv2
                      | baseSlot bs =>
                        cases bs with
                        | dead => cases hEv2
                        | live _ =>
                          have hF : f₂.locals = slots₂Mid := congrArg (fun p => p.2.2) (Except.ok.inj hEv2)
                          rw [← hF]; exact hDstLive
              | move p =>
                dsimp [operandUsesOnlyBaseMem] at hBaseOp
                have hAnd := (bool_and_eq_true _ _).mp hBaseOp
                have hNotP : (!p.projection.isEmpty) = false := by rw [hAnd.1]; rfl
                have hD : ∃ ty, Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId = some (.base ty) := by
                  cases hGd : Trusted.MirSemantics.getElem? pack.bodySrc.locals p.localId with
                  | none => rw [hGd] at hAnd; cases hAnd.2
                  | some d =>
                    rw [hGd] at hAnd
                    cases d with
                    | ptrLocal | byteBuf _ _ _ => cases hAnd.2
                    | base ty => exact ⟨ty, rfl⟩
                cases hD with | intro tyD hGd =>
                have hLtP := s4_getElem?_some_lt _ _ _ hGd
                have hNeDstP : p.localId ≠ dst := fun h =>
                  s4_nat_lt_irrefl dst (Nat.lt_of_lt_of_le (by rw [← h]; exact hLtP) hDstGe)
                have hEv2 := h2.1
                dsimp [evalMemCopyBaseOperandToSlot] at hEv2
                rw [hNotP] at hEv2
                dsimp at hEv2
                cases hDT : Trusted.MirSemantics.getElem? pack.bodyTgt.locals p.localId with
                | none => rw [hDT] at hEv2; cases hEv2
                | some d =>
                  rw [hDT] at hEv2
                  cases d with
                  | ptrLocal | byteBuf _ _ _ => cases hEv2
                  | base tyD2 =>
                    cases hST : Trusted.MirSemantics.getElem? f₂.locals p.localId with
                    | none => rw [hST] at hEv2; cases hEv2
                    | some sl =>
                      rw [hST] at hEv2
                      cases sl with
                      | ptrDead | livePtr _ | bufSlot _ => cases hEv2
                      | baseSlot bs =>
                        cases bs with
                        | dead => cases hEv2
                        | live _ =>
                          dsimp at hEv2
                          cases hS2 : setElem? f₂.locals p.localId (.baseSlot (liveUninitSlot tyD2)) with
                          | none => rw [hS2] at hEv2; cases hEv2
                          | some s2m =>
                            rw [hS2] at hEv2
                            have hF : s2m = slots₂Mid := congrArg (fun p => p.2.2) (Except.ok.inj hEv2)
                            rw [← hF, s4_getElem?_setElem?_ne _ _ _ _ _ hNeDstP hS2]
                            exact hDstLive
            have hDstLtMid : dst < slots₂Mid.length := s4_getElem?_some_lt _ _ _ hDstEqMid
            let nVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 n⟩
            cases s4_lt_setElem?_some slots₂Mid dst (.baseSlot (.live (some nVal))) hDstLtMid with
            | intro slots₂' hSetDst =>
            have hEvTgt : evalMemCopyBaseOperandToSlot pack.bodyTgt.locals f₂.locals op =
                .ok (usizeTy, some nVal, slots₂Mid) := by
              rw [h2.1, hTyEq, hOpt, hSvEq]
            have hStep : evalMemCopyStmt pack.bodyTgt f₂ mem₂ (mkAssignUse dst op) =
                stepMemCopyNext f₂ mem₂ slots₂' := by
              dsimp [evalMemCopyStmt, mkAssignUse]
              rw [hDstDecl]
              dsimp [evalMemCopyBaseRvalue]
              rw [hEvTgt]
              dsimp
              have hBeq : (!MirTy.beq usizeTy usizeTy) = false := rfl
              rw [hBeq]
              dsimp [writeMemCopyBasePlace]
              have hChkF : (!checkVal nVal usizeTy) = false := by
                rw [s4_checkVal_usize_ofNat hNLt]; rfl
              rw [hChkF]
              dsimp
              rw [hDstEqMid]
              dsimp
              rw [hSetDst]
            rw [← hSlEq]
            exact ⟨hNLt, slots₂Mid, slots₂', hEvTgt, hSetDst, hStep,
              h2.2.1, h2.2.2.1, h2.2.2.2.1, h2.2.2.2.2⟩

private theorem s4_step_mkBinOp_bitAnd_255
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (frame : MemCopyFrame) (mem : CallerMemory) {r : Nat} (hr : r < 4)
    {vNat : Nat} (hv : vNat < maxUsize)
    (hSl : Trusted.MirSemantics.getElem? frame.locals
        (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) =
      some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 vNat⟩))))) :
    ∃ slots' : List MemCopySlot,
      setElem? frame.locals (pack.bodySrc.locals.length + 1 + 2 * pack.size + r)
        (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 (Nat.mod vNat 256)⟩)))) =
        some slots' ∧
      evalMemCopyStmt pack.bodyTgt frame mem
        (mkBinOpStmt (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) .bitAnd
          (.move { localId := pack.bodySrc.locals.length + 1 + 2 * pack.size + r, projection := [] })
          (usizeConst 255)) =
        stepMemCopyNext frame mem slots' := by
  let scr := pack.bodySrc.locals.length + 1 + 2 * pack.size + r
  have hDecl := s4_getElem?_bodyTgt_locals_scr pack hr
  have hLt : scr < frame.locals.length := s4_getElem?_some_lt _ _ _ hSl
  cases s4_lt_setElem?_some frame.locals scr (.baseSlot (.live none)) hLt with
  | intro slotsMid hSetMid =>
  have hMidSl : Trusted.MirSemantics.getElem? slotsMid scr = some (.baseSlot (.live none)) :=
    s4_getElem?_setElem?_self _ _ _ _ hSetMid
  have hLtMid : scr < slotsMid.length := by rw [s4_setElem?_length _ _ _ _ hSetMid]; exact hLt
  let outVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 (Nat.mod vNat 256)⟩
  cases s4_lt_setElem?_some slotsMid scr (.baseSlot (.live (some outVal))) hLtMid with
  | intro slotsOut hSetOut =>
  have hSetEq : setElem? frame.locals scr (.baseSlot (.live (some outVal))) = some slotsOut := by
    have hExt : ∀ (xs xsM xsO : List MemCopySlot) (k : Nat) (sM sO : MemCopySlot),
        setElem? xs k sM = some xsM →
        setElem? xsM k sO = some xsO →
        setElem? xs k sO = some xsO := by
      intro xs xsM xsO k sM sO h1 h2
      induction xs generalizing xsM xsO k with
      | nil => cases h1
      | cons a tl ih =>
        cases k with
        | zero =>
          cases Option.some.inj h1
          cases Option.some.inj h2
          rfl
        | succ m =>
          dsimp [setElem?] at h1
          cases hm : setElem? tl m sM with
          | none => rw [hm] at h1; cases h1
          | some tlM =>
            rw [hm] at h1
            cases Option.some.inj h1
            dsimp [setElem?] at h2
            cases ho : setElem? tlM m sO with
            | none => rw [ho] at h2; cases h2
            | some tlO =>
              rw [ho] at h2
              cases Option.some.inj h2
              dsimp [setElem?]
              rw [ih tlM tlO m hm ho]
    exact hExt frame.locals slotsMid slotsOut scr _ _ hSetMid hSetOut
  refine ⟨slotsOut, hSetEq, ?_⟩
  dsimp [evalMemCopyStmt, mkBinOpStmt]
  rw [hDecl]
  dsimp [evalMemCopyBaseRvalue, evalMemCopyPrimitiveOperand, evalMemCopyBaseOperandToSlot, usizeConst]
  rw [hDecl, hSl]
  dsimp
  have hUninit : liveUninitSlot usizeTy = .live none := rfl
  rw [hUninit]
  have hEv255 : evalConstLit usizeTy (.scalar (BitVec.ofNat 128 255)) =
      .ok (.scalar ⟨.isize, false, BitVec.ofNat 128 255⟩) :=
    s4_evalConstLit_usizeConst s4_255_lt_maxUsize
  dsimp [usizeTy] at hEv255
  rw [hSetMid]
  have hPrimUsize : (!isPrimitiveReadableTy (.int .isize false)) = false := rfl
  dsimp [usizeTy]
  rw [hEv255]
  dsimp
  rw [hPrimUsize]
  dsimp
  rw [s4_evalBinOp_usize_bitAnd_255 vNat hv]
  dsimp [writeMemCopyBasePlace]
  have hModLt : Nat.mod vNat 256 < maxUsize :=
    Nat.lt_of_lt_of_le (Nat.mod_lt vNat (by decide)) s4_256_le_maxUsize
  have hChk : checkVal outVal usizeTy = true := s4_checkVal_usize_ofNat hModLt
  dsimp [usizeTy] at hChk
  have hNotChk : (!checkVal outVal (.int .isize false)) = false := by rw [hChk]; rfl
  rw [hNotChk]
  dsimp
  rw [hMidSl]
  dsimp
  rw [hSetOut]

/-! ## Section 9: Per-Statement Simulation & `s4_stmt_step_sim` -/

private theorem s4_sim_stmt_nop_or_unsupported
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {stmtSrc : MemCopyStmt}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmtSrc)
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals)
    (hKind : stmtSrc = .baseStmt .nop ∨ stmtSrc = .baseStmt .unsupported) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hLow := s4_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hLow with | intro extraStart hL =>
  have hGen1 : lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size stmtSrc = [stmtSrc] := by
    cases hKind with
    | inl h => rw [h]; rfl
    | inr h => rw [h]; rfl
  have hStmtTgt := hL.2.2.1 0 (by rw [hGen1]; exact Nat.zero_lt_succ 0)
  rw [← hLenEq, Nat.add_zero, hGen1] at hStmtTgt
  have hLenNext := hL.2.2.2.1
  rw [← hLenEq, hGen1] at hLenNext
  refine s4_sim_stmt_one pack hSame hSame₂ hBbRel hBbSrc hStmtSrc hLenNext
    hBodySrc hBodyTgt (by rw [hBbRel]; exact hL.2.1) hStmtTgt ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    cases hKind with
    | inl h =>
      rw [h] at hStep
      dsimp [evalMemCopyStmt] at hStep
      cases StepResult.step.inj hStep
      refine ⟨f₁.locals, m₁, f₂.locals, m₂, rfl, ?_, hPM, hWf, hBuf, hMem, hScr⟩
      rw [h]; rfl
    | inr h => rw [h] at hStep; cases hStep
  · intro out hDone
    cases hKind with
    | inl h => rw [h] at hDone; cases hDone
    | inr h => rw [h] at hDone; cases hDone
  · intro k hFault
    cases hKind with
    | inl h => rw [h] at hFault; cases hFault
    | inr h =>
      rw [h] at hFault
      rw [h]
      exact hFault

private theorem s4_sim_stmt_storageLive_buf
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx =
      some (.baseStmt (.storageLive plan.bufLocal)))
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hEvSrc := s4_evalStepMemCopy_at_stmt pSrc pack.bodySrc f₁ m₁ bbSrc
    (.baseStmt (.storageLive plan.bufLocal)) hBodySrc hBbSrc hStmtSrc
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    s4_getElem?_some_lt bbSrc.statements f₁.stmtIdx _ hStmtSrc
  have hLow := s4_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hLow with | intro extraStart hL =>
  let base := pack.bodySrc.locals.length
  let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability
    extraStart bbSrc.terminator
  let bbTgt : MemCopyBlock := {
    bbSrc with
    statements := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
    terminator := termRes.2.1
  }
  have hFlat := s4_listFlatMap_split_at
    (lowerStmtForBuf plan.bufLocal base pack.size) hStmtSrc
  have hGen : lowerStmtForBuf plan.bufLocal base pack.size (.baseStmt (.storageLive plan.bufLocal)) =
      mkStorageLiveRange base (1 + 2 * pack.size) ++ mkZeroUsizeRange (base + 1) (2 * pack.size) := by
    dsimp [lowerStmtForBuf]
    rw [nat_beq_refl]
    rfl
  let pref := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) (bbSrc.statements.take f₁.stmtIdx)
  let suff := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) (bbSrc.statements.drop (f₁.stmtIdx + 1)) ++ termRes.1
  have hStmtsEq1 : bbTgt.statements =
      pref ++ mkStorageLiveRange base (1 + 2 * pack.size) ++ (mkZeroUsizeRange (base + 1) (2 * pack.size) ++ suff) := by
    dsimp [bbTgt, pref, suff]
    rw [hFlat, hGen, List.append_assoc, List.append_assoc, List.append_assoc, List.append_assoc]
  have hLenF2 : f₂.stmtIdx = pref.length := hLenEq
  have hLenNext : f₂.stmtIdx + ((1 + 2 * pack.size) + 2 * pack.size) =
      (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) (bbSrc.statements.take (f₁.stmtIdx + 1))).length := by
    have hL2 := hL.2.2.2.1
    rw [hGen, s4_list_append_length] at hL2
    have hLenLive : (mkStorageLiveRange base (1 + 2 * pack.size)).length = 1 + 2 * pack.size := by
      have : ∀ (s c : Nat), (mkStorageLiveRange s c).length = c := fun s c => by
        induction c generalizing s with | zero => rfl | succ m ihm => exact congrArg Nat.succ (ihm (s + 1))
      exact this _ _
    have hLenZero : (mkZeroUsizeRange (base + 1) (2 * pack.size)).length = 2 * pack.size := by
      have : ∀ (s c : Nat), (mkZeroUsizeRange s c).length = c := fun s c => by
        induction c generalizing s with | zero => rfl | succ m ihm => exact congrArg Nat.succ (ihm (s + 1))
      exact this _ _
    rw [hLenLive, hLenZero] at hL2
    rw [← hLenF2] at hL2
    exact hL2
  have hLenSlots2 : f₂.locals.length = pack.bodyTgt.locals.length := hPM.2.1
  have hExec1 := s4_exec_mkStorageLiveRange pack f₂.blockIdx bbTgt m₂
    pref (mkZeroUsizeRange (base + 1) (2 * pack.size) ++ suff) f₂.locals
    (by rw [hBbRel]; exact hL.2.1) hStmtsEq1 hLenSlots2
  cases hExec1 with | intro slots2Mid hR1 =>
  have hStmtsEq2 : bbTgt.statements =
      (pref ++ mkStorageLiveRange base (1 + 2 * pack.size)) ++ mkZeroUsizeRange (base + 1) (2 * pack.size) ++ suff := by
    rw [hStmtsEq1, ← List.append_assoc]
  have hLenMid : slots2Mid.length = pack.bodyTgt.locals.length := hR1.2.1.trans hLenSlots2
  have hExec2 := s4_exec_mkZeroUsizeRangeGen pack f₂.blockIdx bbTgt m₂
    (pref ++ mkStorageLiveRange base (1 + 2 * pack.size)) suff (base + 1) (2 * pack.size) slots2Mid
    (by rw [hBbRel]; exact hL.2.1) hStmtsEq2 hLenMid (Nat.le_refl _) (Nat.le_refl _)
    (fun k hk => ⟨none, hR1.2.2.2.2.2 k hk⟩)
  cases hExec2 with | intro slots₂' hR2 =>
  have hLenLive : (mkStorageLiveRange base (1 + 2 * pack.size)).length = 1 + 2 * pack.size := by
    have : ∀ (s c : Nat), (mkStorageLiveRange s c).length = c := fun s c => by
      induction c generalizing s with | zero => rfl | succ m ihm => exact congrArg Nat.succ (ihm (s + 1))
    exact this _ _
  rw [s4_list_append_length, hLenLive] at hR2
  have hReachAll : ReachesNMemCopy pTgt ((1 + 2 * pack.size) + 2 * pack.size)
      { frames := [f₂], mem := m₂ }
      { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + ((1 + 2 * pack.size) + 2 * pack.size), locals := slots₂' }],
        mem := m₂ } := by
    have hR1' : ReachesNMemCopy pTgt (1 + 2 * pack.size)
        { frames := [f₂], mem := m₂ }
        { frames := [{ defId := plan.defId, blockIdx := f₂.blockIdx, stmtIdx := pref.length + (1 + 2 * pack.size), locals := slots2Mid }],
          mem := m₂ } := by
      have hF2Eq : f₂ = { defId := plan.defId, blockIdx := f₂.blockIdx, stmtIdx := pref.length, locals := f₂.locals } := by
        cases f₂; dsimp at hSame₂ hLenF2; rw [hSame₂, hLenF2]
      rw [← hF2Eq] at hR1
      exact hR1.1
    have hR2' : ReachesNMemCopy pTgt (2 * pack.size)
        { frames := [{ defId := plan.defId, blockIdx := f₂.blockIdx, stmtIdx := pref.length + (1 + 2 * pack.size), locals := slots2Mid }],
          mem := m₂ }
        { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + ((1 + 2 * pack.size) + 2 * pack.size), locals := slots₂' }],
          mem := m₂ } := by
      have hF2Sub : { defId := plan.defId, blockIdx := f₂.blockIdx, stmtIdx := pref.length + (1 + 2 * pack.size) + 2 * pack.size, locals := slots₂' } =
          { f₂ with stmtIdx := f₂.stmtIdx + ((1 + 2 * pack.size) + 2 * pack.size), locals := slots₂' } := by
        cases f₂; dsimp at hSame₂ hLenF2; rw [hSame₂, hLenF2, Nat.add_assoc]
      rw [hF2Sub] at hR2
      exact hR2.1
    exact reachesNMemCopy_trans hR1' hR2'
  have hStepsPos : ∃ m : Nat, (1 + 2 * pack.size) + 2 * pack.size = m + 1 :=
    ⟨2 * pack.size + 2 * pack.size, by rw [Nat.add_assoc, Nat.add_comm 1 _]⟩
  cases hStepsPos with | intro mSteps hmSteps =>
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    rw [hEvSrc] at hStep
    dsimp [evalMemCopyStmt] at hStep
    rw [pack.hBufDecl] at hStep
    dsimp [liveUninitMemCopySlot] at hStep
    have hLt1 : plan.bufLocal < f₁.locals.length := by rw [hPM.1]; exact pack.hBufLtLoc
    cases s4_lt_setElem?_some f₁.locals plan.bufLocal (.bufSlot true) hLt1 with
    | intro slots₁' hSet1 =>
    rw [hSet1] at hStep
    let aid := internalAllocBase + plan.bufLocal
    let fresh : Allocation := {
      allocId := aid
      alignLog2 := pack.alignLog2
      mutability := pack.mutability
      bytes := listReplicate pack.size .uninit
      live := true
    }
    cases hBuf with | intro _ hB1 =>
    cases hB1 with | intro oldAlloc hB2 =>
    cases s4_updateAlloc?_of_findAlloc? aid fresh m₁.allocations oldAlloc hB2.2.1 with
    | intro allocs₁' hUp1 =>
    rw [hUp1] at hStep
    cases StepResult.step.inj hStep
    have hPM' : s4_PrefixMatch pack slots₁' slots₂' := by
      refine ⟨(s4_setElem?_length _ _ _ _ hSet1).trans hPM.1,
        hR2.2.1.trans hLenMid, ?_⟩
      intro i hi hNe
      rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe.symm hSet1,
        hR2.2.2.1 i (Nat.lt_trans hi (Nat.lt_succ_self base)),
        hR1.2.2.1 i hi]
      exact hPM.2.2 i hi hNe
    have hWf' : s4_SlotValWf pack.bodySrc slots₁' :=
      s4_slotValWf_set_bufSlot hWf hSet1
    have hMem' : s4_MemRel pack ⟨allocs₁'⟩ m₂ := by
      refine ⟨?_, ?_⟩
      · rw [hMem.1]
        exact (s4_updateAlloc?_filter_eq aid fresh rfl m₁.allocations allocs₁' hUp1).symm
      · intro a ha
        cases s4_updateAlloc?_mem aid fresh m₁.allocations allocs₁' a hUp1 ha with
        | inl hEqF =>
          rw [hEqF]
          exact ⟨plan.bufLocal, pack.size, pack.alignLog2, pack.mutability, rfl, pack.hBufDecl,
            s4_all_replicate_uninit_wf pack.size⟩
        | inr hOld => exact hMem.2 a hOld
    have hBuf' : s4_BufRel pack slots₁' ⟨allocs₁'⟩ slots₂' := by
      refine ⟨true, fresh, s4_getElem?_setElem?_self _ _ _ _ hSet1,
        s4_findAlloc?_updateAlloc?_self aid fresh rfl m₁.allocations allocs₁' hUp1,
        rfl, rfl, rfl, rfl, s4_list_length_replicate pack.size AllocByte.uninit,
        s4_all_replicate_uninit_wf pack.size, ?_⟩
      dsimp
      constructor
      · rw [hR2.2.2.1 base (Nat.lt_succ_self base), hR1.2.2.2.2.1]
      · intro j hj
        have hj1 : j < 2 * pack.size := by
          rw [Nat.two_mul]; exact Nat.lt_of_lt_of_le hj (Nat.le_add_right _ _)
        have hj2 : pack.size + j < 2 * pack.size := by
          rw [Nat.two_mul]; exact Nat.add_lt_add_left hj _
        refine ⟨AllocByte.uninit, s4_getElem?_replicate pack.size j AllocByte.uninit hj, ?_, ?_⟩
        · exact hR2.2.2.2.2 j hj1
        · rw [Nat.add_assoc (pack.bodySrc.locals.length + 1) pack.size j]
          exact hR2.2.2.2.2 (pack.size + j) hj2
    have hScr' : s4_ScrLive pack slots₂' := by
      intro r hr
      have hGe2 : base + 1 + 2 * pack.size ≤ base + 1 + 2 * pack.size + r := Nat.le_add_right _ r
      have hGe1 : base + (1 + 2 * pack.size) ≤ base + 1 + 2 * pack.size + r := by
        rw [← Nat.add_assoc]; exact hGe2
      rw [hR2.2.2.2.1 _ hGe2, hR1.2.2.2.1 _ hGe1]
      exact hScr r hr
    exact s4_reachesPlus_stmt_rel pack hSame hSame₂ hBbRel hBbSrc hLeNext hLenNext
      (@Eq.ndrec Nat ((1 + 2 * pack.size) + 2 * pack.size)
        (fun k => ReachesNMemCopy pTgt k { frames := [f₂], mem := m₂ }
          { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + ((1 + 2 * pack.size) + 2 * pack.size), locals := slots₂' }],
            mem := m₂ })
        hReachAll (mSteps + 1) hmSteps)
      hPM' hWf' hBuf' hMem' hScr'
  · intro out hDone
    rw [hEvSrc] at hDone
    dsimp [evalMemCopyStmt] at hDone
    rw [pack.hBufDecl] at hDone
    dsimp [liveUninitMemCopySlot] at hDone
    cases hSet1 : setElem? f₁.locals plan.bufLocal (.bufSlot true) with
    | none => rw [hSet1] at hDone; cases hDone
    | some _ =>
      rw [hSet1] at hDone
      cases hUp1 : updateAlloc? (internalAllocBase + plan.bufLocal) _ m₁.allocations with
      | none => rw [hUp1] at hDone; cases hDone
      | some _ => rw [hUp1] at hDone; cases hDone
  · intro k hFault
    rw [hEvSrc] at hFault
    dsimp [evalMemCopyStmt] at hFault
    rw [pack.hBufDecl] at hFault
    dsimp [liveUninitMemCopySlot] at hFault
    have hLt1 : plan.bufLocal < f₁.locals.length := by rw [hPM.1]; exact pack.hBufLtLoc
    cases s4_lt_setElem?_some f₁.locals plan.bufLocal (.bufSlot true) hLt1 with
    | intro slots₁' hSet1 =>
    rw [hSet1] at hFault
    cases hBuf with | intro _ hB1 =>
    cases hB1 with | intro oldAlloc hB2 =>
    cases s4_updateAlloc?_of_findAlloc? (internalAllocBase + plan.bufLocal) _ m₁.allocations oldAlloc hB2.2.1 with
    | intro allocs₁' hUp1 =>
    rw [hUp1] at hFault
    cases hFault

private theorem s4_sim_stmt_storageLive_other
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {id : LocalId}
    (hNe : id ≠ plan.bufLocal)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx =
      some (.baseStmt (.storageLive id)))
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hLow := s4_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hLow with | intro extraStart hL =>
  have hGen : lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size (.baseStmt (.storageLive id)) =
      [.baseStmt (.storageLive id)] := by
    dsimp [lowerStmtForBuf]; rw [s4_nat_beq_false hNe]; rfl
  have hStmtTgt := hL.2.2.1 0 (by rw [hGen]; exact Nat.zero_lt_succ 0)
  rw [← hLenEq, Nat.add_zero, hGen] at hStmtTgt
  have hLenNext := hL.2.2.2.1
  rw [← hLenEq, hGen] at hLenNext
  have hInB : id < pack.bodySrc.locals.length :=
    (nat_blt_eq_lt _ _).mp (s4_bodySrc_stmt_localsInBounds pack hBbSrc hStmtSrc)
  cases s4_getElem?_lt_some pack.bodySrc.locals id hInB with | intro decl hDecl =>
  have hDeclTgt := s4_getElem?_bodyTgt_locals_lt pack hInB hNe
  rw [hDecl] at hDeclTgt
  have hNotPtr := s4_noPtrs_bodySrc pack hDecl
  have hLt1 : id < f₁.locals.length := by rw [hPM.1]; exact hInB
  have hLt2 : id < f₂.locals.length := by
    rw [hPM.2.1, s4_bodyTgt_locals_length pack]
    exact Nat.lt_of_lt_of_le
      (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hInB (Nat.le_add_right _ 1)) (Nat.le_add_right _ _))
      (Nat.le_add_right _ 4)
  cases s4_lt_setElem?_some f₁.locals id (liveUninitMemCopySlot decl) hLt1 with
  | intro slots₁' hSet1 =>
  cases s4_lt_setElem?_some f₂.locals id (liveUninitMemCopySlot decl) hLt2 with
  | intro slots₂' hSet2 =>
  refine s4_sim_stmt_one pack hSame hSame₂ hBbRel hBbSrc hStmtSrc hLenNext
    hBodySrc hBodyTgt (by rw [hBbRel]; exact hL.2.1) hStmtTgt ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    dsimp [evalMemCopyStmt] at hStep
    rw [hDecl] at hStep
    dsimp at hStep
    rw [hSet1] at hStep
    cases decl with
    | ptrLocal => exact False.elim (hNotPtr rfl)
    | base ty =>
      cases StepResult.step.inj hStep
      refine ⟨slots₁', m₁, slots₂', m₂, rfl, ?_,
        s4_prefixMatch_set_prefix_other pack hPM hInB hNe hSet1 hSet2,
        s4_slotValWf_set_live_uninit hWf hDecl hSet1,
        s4_bufRel_set_prefix_other pack hBuf hInB hNe hSet1 hSet2,
        hMem,
        s4_scrLive_set_lt_scrBase pack hScr
          (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hInB (Nat.le_add_right _ 1)) (Nat.le_add_right _ _)) hSet2⟩
      dsimp [evalMemCopyStmt]
      rw [hDeclTgt]
      dsimp
      rw [hSet2]
    | byteBuf sz al mu =>
      dsimp at hStep
      let aid := internalAllocBase + id
      let fresh : Allocation := {
        allocId := aid
        alignLog2 := al
        mutability := mu
        bytes := listReplicate sz .uninit
        live := true
      }
      cases hUp1 : updateAlloc? aid fresh m₁.allocations with
      | none => rw [hUp1] at hStep; cases hStep
      | some allocs₁' =>
        rw [hUp1] at hStep
        cases StepResult.step.inj hStep
        have hAidNe : aid ≠ internalAllocBase + plan.bufLocal := fun h => hNe (Nat.add_left_cancel h)
        have hUpComm := s4_updateAlloc?_filter_ne (internalAllocBase + plan.bufLocal) aid fresh hAidNe rfl m₁.allocations
        rw [hUp1, ← hMem.1] at hUpComm
        dsimp [Option.map] at hUpComm
        have hMem' : s4_MemRel pack ⟨allocs₁'⟩ ⟨allocs₁'.filter (fun a => !Nat.beq a.allocId (internalAllocBase + plan.bufLocal))⟩ := by
          refine ⟨rfl, fun a ha => ?_⟩
          cases s4_updateAlloc?_mem aid fresh m₁.allocations allocs₁' a hUp1 ha with
          | inl hEqF =>
            rw [hEqF]
            exact ⟨id, sz, al, mu, rfl, hDecl, s4_all_replicate_uninit_wf sz⟩
          | inr hOld => exact hMem.2 a hOld
        have hBuf' : s4_BufRel pack slots₁' ⟨allocs₁'⟩ slots₂' := by
          have hB0 := s4_bufRel_set_prefix_other pack hBuf hInB hNe hSet1 hSet2
          cases hB0 with | intro isLive hb1 =>
          cases hb1 with | intro alloc hb2 =>
          refine ⟨isLive, alloc, hb2.1, ?_, hb2.2.2.1, hb2.2.2.2.1, hb2.2.2.2.2.1,
            hb2.2.2.2.2.2.1, hb2.2.2.2.2.2.2.1, hb2.2.2.2.2.2.2.2.1, hb2.2.2.2.2.2.2.2.2⟩
          rw [s4_findAlloc?_updateAlloc?_ne aid (internalAllocBase + plan.bufLocal) fresh hAidNe.symm rfl
            m₁.allocations allocs₁' hUp1]
          exact hb2.2.1
        refine ⟨slots₁', ⟨allocs₁'⟩, slots₂',
          ⟨allocs₁'.filter (fun a => !Nat.beq a.allocId (internalAllocBase + plan.bufLocal))⟩, rfl, ?_,
          s4_prefixMatch_set_prefix_other pack hPM hInB hNe hSet1 hSet2,
          s4_slotValWf_set_bufSlot hWf hSet1,
          hBuf', hMem',
          s4_scrLive_set_lt_scrBase pack hScr
            (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hInB (Nat.le_add_right _ 1)) (Nat.le_add_right _ _)) hSet2⟩
        dsimp [evalMemCopyStmt]
        rw [hDeclTgt]
        dsimp
        rw [hSet2]
        dsimp
        rw [← hUpComm]
  · intro out hDone
    dsimp [evalMemCopyStmt] at hDone
    rw [hDecl] at hDone
    dsimp at hDone
    rw [hSet1] at hDone
    cases decl with
    | ptrLocal => exact False.elim (hNotPtr rfl)
    | base _ => cases hDone
    | byteBuf sz al mu =>
      dsimp at hDone
      let fresh : Allocation := {
        allocId := internalAllocBase + id
        alignLog2 := al
        mutability := mu
        bytes := listReplicate sz AllocByte.uninit
        live := true
      }
      cases hUp1 : updateAlloc? (internalAllocBase + id) fresh m₁.allocations with
      | none => rw [hUp1] at hDone; cases hDone
      | some _ => rw [hUp1] at hDone; cases hDone
  · intro k hFault
    dsimp [evalMemCopyStmt] at hFault
    rw [hDecl] at hFault
    dsimp at hFault
    rw [hSet1] at hFault
    cases decl with
    | ptrLocal => exact False.elim (hNotPtr rfl)
    | base _ => cases hFault
    | byteBuf sz al mu =>
      dsimp at hFault
      let aid := internalAllocBase + id
      let fresh : Allocation := {
        allocId := aid
        alignLog2 := al
        mutability := mu
        bytes := listReplicate sz .uninit
        live := true
      }
      cases hUp1 : updateAlloc? aid fresh m₁.allocations with
      | some _ => rw [hUp1] at hFault; cases hFault
      | none =>
        rw [hUp1] at hFault
        have hAidNe : aid ≠ internalAllocBase + plan.bufLocal := fun h => hNe (Nat.add_left_cancel h)
        have hUpComm := s4_updateAlloc?_filter_ne (internalAllocBase + plan.bufLocal) aid fresh hAidNe rfl m₁.allocations
        rw [hUp1, ← hMem.1] at hUpComm
        dsimp [evalMemCopyStmt]
        rw [hDeclTgt]
        dsimp
        rw [hSet2]
        dsimp
        rw [← hUpComm]
        exact hFault

private theorem s4_sim_stmt_storageDead_buf
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx =
      some (.baseStmt (.storageDead plan.bufLocal)))
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hEvSrc := s4_evalStepMemCopy_at_stmt pSrc pack.bodySrc f₁ m₁ bbSrc
    (.baseStmt (.storageDead plan.bufLocal)) hBodySrc hBbSrc hStmtSrc
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length :=
    s4_getElem?_some_lt bbSrc.statements f₁.stmtIdx _ hStmtSrc
  have hLow := s4_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hLow with | intro extraStart hL =>
  let base := pack.bodySrc.locals.length
  let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability
    extraStart bbSrc.terminator
  let bbTgt : MemCopyBlock := {
    bbSrc with
    statements := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
    terminator := termRes.2.1
  }
  have hFlat := s4_listFlatMap_split_at
    (lowerStmtForBuf plan.bufLocal base pack.size) hStmtSrc
  have hGen : lowerStmtForBuf plan.bufLocal base pack.size (.baseStmt (.storageDead plan.bufLocal)) =
      mkStorageDeadRange base (1 + 2 * pack.size) := by
    dsimp [lowerStmtForBuf]; rw [nat_beq_refl]; rfl
  let pref := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) (bbSrc.statements.take f₁.stmtIdx)
  let suff := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) (bbSrc.statements.drop (f₁.stmtIdx + 1)) ++ termRes.1
  have hStmtsEq : bbTgt.statements = pref ++ mkStorageDeadRange base (1 + 2 * pack.size) ++ suff := by
    dsimp [bbTgt, pref, suff]
    rw [hFlat, hGen, List.append_assoc, List.append_assoc]
  have hLenNext : f₂.stmtIdx + (1 + 2 * pack.size) =
      (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) (bbSrc.statements.take (f₁.stmtIdx + 1))).length := by
    have hL2 := hL.2.2.2.1
    rw [hGen] at hL2
    have hLenD : (mkStorageDeadRange base (1 + 2 * pack.size)).length = 1 + 2 * pack.size := by
      have : ∀ (s c : Nat), (mkStorageDeadRange s c).length = c := fun s c => by
        induction c generalizing s with | zero => rfl | succ m ihm => exact congrArg Nat.succ (ihm (s + 1))
      exact this _ _
    rw [hLenD, ← hLenEq] at hL2
    exact hL2
  have hExec := s4_exec_mkStorageDeadRange pack f₂.blockIdx bbTgt m₂ pref suff
    base (1 + 2 * pack.size) f₂.locals (by rw [hBbRel]; exact hL.2.1) hStmtsEq hPM.2.1 (Nat.le_refl _) (Nat.le_refl _)
  cases hExec with | intro slots₂' hR =>
  have hReachAll : ReachesNMemCopy pTgt (2 * pack.size + 1)
      { frames := [f₂], mem := m₂ }
      { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + (1 + 2 * pack.size), locals := slots₂' }], mem := m₂ } := by
    have hF2Eq : f₂ = { defId := plan.defId, blockIdx := f₂.blockIdx, stmtIdx := pref.length, locals := f₂.locals } := by
      cases f₂; dsimp at hSame₂ hLenEq; rw [hSame₂, hLenEq]
    have hF2Post : { defId := plan.defId, blockIdx := f₂.blockIdx, stmtIdx := pref.length + (1 + 2 * pack.size), locals := slots₂' } =
        { f₂ with stmtIdx := f₂.stmtIdx + (1 + 2 * pack.size), locals := slots₂' } := by
      cases f₂; dsimp at hSame₂ hLenEq; rw [hSame₂, hLenEq]
    have hR1 := hR.1
    rw [← hF2Eq, hF2Post] at hR1
    rw [Nat.add_comm (2 * pack.size) 1]
    exact hR1
  have hPosBuf : 0 < plan.bufLocal := Nat.lt_of_le_of_lt (Nat.zero_le _) pack.hArgLtBuf
  have hNe0 : Nat.beq plan.bufLocal 0 = false := s4_nat_beq_false (Nat.ne_of_gt hPosBuf)
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    rw [hEvSrc] at hStep
    dsimp [evalMemCopyStmt] at hStep
    rw [hNe0, pack.hBufDecl] at hStep
    dsimp [deadMemCopySlot] at hStep
    have hLt1 : plan.bufLocal < f₁.locals.length := by rw [hPM.1]; exact pack.hBufLtLoc
    cases s4_lt_setElem?_some f₁.locals plan.bufLocal (.bufSlot false) hLt1 with
    | intro slots₁' hSet1 =>
    rw [hSet1] at hStep
    let aid := internalAllocBase + plan.bufLocal
    let deadAlloc : Allocation := {
      allocId := aid
      alignLog2 := pack.alignLog2
      mutability := pack.mutability
      bytes := listReplicate pack.size .uninit
      live := false
    }
    cases hBuf with | intro _ hB1 =>
    cases hB1 with | intro oldAlloc hB2 =>
    cases s4_updateAlloc?_of_findAlloc? aid deadAlloc m₁.allocations oldAlloc hB2.2.1 with
    | intro allocs₁' hUp1 =>
    rw [hUp1] at hStep
    cases StepResult.step.inj hStep
    have hPM' : s4_PrefixMatch pack slots₁' slots₂' := by
      refine ⟨(s4_setElem?_length _ _ _ _ hSet1).trans hPM.1, hR.2.1.trans hPM.2.1, ?_⟩
      intro i hi hNe
      rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe.symm hSet1, hR.2.2.1 i hi]
      exact hPM.2.2 i hi hNe
    have hWf' : s4_SlotValWf pack.bodySrc slots₁' := s4_slotValWf_set_bufSlot hWf hSet1
    have hMem' : s4_MemRel pack ⟨allocs₁'⟩ m₂ := by
      refine ⟨?_, ?_⟩
      · rw [hMem.1]
        exact (s4_updateAlloc?_filter_eq aid deadAlloc rfl m₁.allocations allocs₁' hUp1).symm
      · intro a ha
        cases s4_updateAlloc?_mem aid deadAlloc m₁.allocations allocs₁' a hUp1 ha with
        | inl hEqD =>
          rw [hEqD]
          exact ⟨plan.bufLocal, pack.size, pack.alignLog2, pack.mutability, rfl, pack.hBufDecl,
            s4_all_replicate_uninit_wf pack.size⟩
        | inr hOld => exact hMem.2 a hOld
    have hBuf' : s4_BufRel pack slots₁' ⟨allocs₁'⟩ slots₂' := by
      refine ⟨false, deadAlloc, s4_getElem?_setElem?_self _ _ _ _ hSet1,
        s4_findAlloc?_updateAlloc?_self aid deadAlloc rfl m₁.allocations allocs₁' hUp1,
        rfl, rfl, rfl, rfl, s4_list_length_replicate pack.size AllocByte.uninit,
        s4_all_replicate_uninit_wf pack.size, ?_⟩
      dsimp
      constructor
      · have h0 := hR.2.2.2.2 0 (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 0) (Nat.le_add_right 1 (2 * pack.size)))
        rw [Nat.add_zero] at h0; exact h0
      · intro j hj
        have hJ := hR.2.2.2.2 (1 + j) (Nat.add_lt_add_left hj 1)
        rw [← Nat.add_assoc] at hJ
        exact hJ
    have hScr' : s4_ScrLive pack slots₂' := by
      intro r hr
      have hGe : base + (1 + 2 * pack.size) ≤ base + 1 + 2 * pack.size + r := by
        rw [← Nat.add_assoc]; exact Nat.le_add_right _ r
      rw [hR.2.2.2.1 _ hGe]
      exact hScr r hr
    exact s4_reachesPlus_stmt_rel pack hSame hSame₂ hBbRel hBbSrc hLeNext hLenNext hReachAll
      hPM' hWf' hBuf' hMem' hScr'
  · intro out hDone
    rw [hEvSrc] at hDone
    dsimp [evalMemCopyStmt] at hDone
    rw [hNe0, pack.hBufDecl] at hDone
    dsimp [deadMemCopySlot] at hDone
    cases hSet1 : setElem? f₁.locals plan.bufLocal (.bufSlot false) with
    | none => rw [hSet1] at hDone; cases hDone
    | some _ =>
      rw [hSet1] at hDone
      cases hUp1 : updateAlloc? (internalAllocBase + plan.bufLocal) _ m₁.allocations with
      | none => rw [hUp1] at hDone; cases hDone
      | some _ => rw [hUp1] at hDone; cases hDone
  · intro k hFault
    rw [hEvSrc] at hFault
    dsimp [evalMemCopyStmt] at hFault
    rw [hNe0, pack.hBufDecl] at hFault
    dsimp [deadMemCopySlot] at hFault
    have hLt1 : plan.bufLocal < f₁.locals.length := by rw [hPM.1]; exact pack.hBufLtLoc
    cases s4_lt_setElem?_some f₁.locals plan.bufLocal (.bufSlot false) hLt1 with
    | intro slots₁' hSet1 =>
    rw [hSet1] at hFault
    cases hBuf with | intro _ hB1 =>
    cases hB1 with | intro oldAlloc hB2 =>
    cases s4_updateAlloc?_of_findAlloc? (internalAllocBase + plan.bufLocal) _ m₁.allocations oldAlloc hB2.2.1 with
    | intro allocs₁' hUp1 =>
    rw [hUp1] at hFault
    cases hFault

private theorem s4_sim_stmt_storageDead_other
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {id : LocalId}
    (hNe : id ≠ plan.bufLocal)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx =
      some (.baseStmt (.storageDead id)))
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hLow := s4_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hLow with | intro extraStart hL =>
  have hGen : lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size (.baseStmt (.storageDead id)) =
      [.baseStmt (.storageDead id)] := by
    dsimp [lowerStmtForBuf]; rw [s4_nat_beq_false hNe]; rfl
  have hStmtTgt := hL.2.2.1 0 (by rw [hGen]; exact Nat.zero_lt_succ 0)
  rw [← hLenEq, Nat.add_zero, hGen] at hStmtTgt
  have hLenNext := hL.2.2.2.1
  rw [← hLenEq, hGen] at hLenNext
  have hInB : id < pack.bodySrc.locals.length :=
    (nat_blt_eq_lt _ _).mp (s4_bodySrc_stmt_localsInBounds pack hBbSrc hStmtSrc)
  cases s4_getElem?_lt_some pack.bodySrc.locals id hInB with | intro decl hDecl =>
  have hDeclTgt := s4_getElem?_bodyTgt_locals_lt pack hInB hNe
  rw [hDecl] at hDeclTgt
  have hNotPtr := s4_noPtrs_bodySrc pack hDecl
  have hLt1 : id < f₁.locals.length := by rw [hPM.1]; exact hInB
  have hLt2 : id < f₂.locals.length := by
    rw [hPM.2.1, s4_bodyTgt_locals_length pack]
    exact Nat.lt_of_lt_of_le
      (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hInB (Nat.le_add_right _ 1)) (Nat.le_add_right _ _))
      (Nat.le_add_right _ 4)
  cases s4_lt_setElem?_some f₁.locals id (deadMemCopySlot decl) hLt1 with
  | intro slots₁' hSet1 =>
  cases s4_lt_setElem?_some f₂.locals id (deadMemCopySlot decl) hLt2 with
  | intro slots₂' hSet2 =>
  refine s4_sim_stmt_one pack hSame hSame₂ hBbRel hBbSrc hStmtSrc hLenNext
    hBodySrc hBodyTgt (by rw [hBbRel]; exact hL.2.1) hStmtTgt ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    dsimp [evalMemCopyStmt] at hStep
    cases h0 : Nat.beq id 0 with
    | true => rw [h0] at hStep; cases hStep
    | false =>
      rw [h0, hDecl] at hStep
      dsimp at hStep
      rw [hSet1] at hStep
      cases decl with
      | ptrLocal => exact False.elim (hNotPtr rfl)
      | base _ =>
        cases StepResult.step.inj hStep
        refine ⟨slots₁', m₁, slots₂', m₂, rfl, ?_,
          s4_prefixMatch_set_prefix_other pack hPM hInB hNe hSet1 hSet2,
          s4_slotValWf_set_dead (Or.inl rfl) hWf hSet1,
          s4_bufRel_set_prefix_other pack hBuf hInB hNe hSet1 hSet2,
          hMem,
          s4_scrLive_set_lt_scrBase pack hScr
            (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hInB (Nat.le_add_right _ 1)) (Nat.le_add_right _ _)) hSet2⟩
        dsimp [evalMemCopyStmt]
        rw [h0, hDeclTgt, hSet2]
        rfl
      | byteBuf sz al mu =>
        dsimp at hStep
        let aid := internalAllocBase + id
        let deadAlloc : Allocation := {
          allocId := aid
          alignLog2 := al
          mutability := mu
          bytes := listReplicate sz .uninit
          live := false
        }
        cases hUp1 : updateAlloc? aid deadAlloc m₁.allocations with
        | none => rw [hUp1] at hStep; cases hStep
        | some allocs₁' =>
          rw [hUp1] at hStep
          cases StepResult.step.inj hStep
          have hAidNe : aid ≠ internalAllocBase + plan.bufLocal := fun h => hNe (Nat.add_left_cancel h)
          have hUpComm := s4_updateAlloc?_filter_ne (internalAllocBase + plan.bufLocal) aid deadAlloc hAidNe rfl m₁.allocations
          rw [hUp1, ← hMem.1] at hUpComm
          dsimp [Option.map] at hUpComm
          have hMem' : s4_MemRel pack ⟨allocs₁'⟩ ⟨allocs₁'.filter (fun a => !Nat.beq a.allocId (internalAllocBase + plan.bufLocal))⟩ := by
            refine ⟨rfl, fun a ha => ?_⟩
            cases s4_updateAlloc?_mem aid deadAlloc m₁.allocations allocs₁' a hUp1 ha with
            | inl hEqD =>
              rw [hEqD]
              exact ⟨id, sz, al, mu, rfl, hDecl, s4_all_replicate_uninit_wf sz⟩
            | inr hOld => exact hMem.2 a hOld
          have hBuf' : s4_BufRel pack slots₁' ⟨allocs₁'⟩ slots₂' := by
            have hB0 := s4_bufRel_set_prefix_other pack hBuf hInB hNe hSet1 hSet2
            cases hB0 with | intro isLive hb1 =>
            cases hb1 with | intro alloc hb2 =>
            refine ⟨isLive, alloc, hb2.1, ?_, hb2.2.2.1, hb2.2.2.2.1, hb2.2.2.2.2.1,
              hb2.2.2.2.2.2.1, hb2.2.2.2.2.2.2.1, hb2.2.2.2.2.2.2.2.1, hb2.2.2.2.2.2.2.2.2⟩
            rw [s4_findAlloc?_updateAlloc?_ne aid (internalAllocBase + plan.bufLocal) deadAlloc hAidNe.symm rfl
              m₁.allocations allocs₁' hUp1]
            exact hb2.2.1
          refine ⟨slots₁', ⟨allocs₁'⟩, slots₂',
            ⟨allocs₁'.filter (fun a => !Nat.beq a.allocId (internalAllocBase + plan.bufLocal))⟩, rfl, ?_,
            s4_prefixMatch_set_prefix_other pack hPM hInB hNe hSet1 hSet2,
            s4_slotValWf_set_bufSlot hWf hSet1,
            hBuf', hMem',
            s4_scrLive_set_lt_scrBase pack hScr
              (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hInB (Nat.le_add_right _ 1)) (Nat.le_add_right _ _)) hSet2⟩
          dsimp [evalMemCopyStmt]
          rw [h0, hDeclTgt]
          dsimp
          rw [hSet2]
          dsimp
          rw [← hUpComm]
  · intro out hDone
    dsimp [evalMemCopyStmt] at hDone
    cases h0 : Nat.beq id 0 with
    | true => rw [h0] at hDone; cases hDone
    | false =>
      rw [h0, hDecl, hSet1] at hDone
      cases decl with
      | ptrLocal => exact False.elim (hNotPtr rfl)
      | base _ => cases hDone
      | byteBuf sz al mu =>
        dsimp at hDone
        let deadAlloc : Allocation := {
          allocId := internalAllocBase + id
          alignLog2 := al
          mutability := mu
          bytes := listReplicate sz AllocByte.uninit
          live := false
        }
        cases hUp1 : updateAlloc? (internalAllocBase + id) deadAlloc m₁.allocations with
        | none => rw [hUp1] at hDone; cases hDone
        | some _ => rw [hUp1] at hDone; cases hDone
  · intro k hFault
    dsimp [evalMemCopyStmt] at hFault
    cases h0 : Nat.beq id 0 with
    | true =>
      rw [h0] at hFault
      dsimp [evalMemCopyStmt]
      rw [h0]
      exact hFault
    | false =>
      rw [h0, hDecl, hSet1] at hFault
      cases decl with
      | ptrLocal => exact False.elim (hNotPtr rfl)
      | base _ => cases hFault
      | byteBuf sz al mu =>
        dsimp at hFault
        let aid := internalAllocBase + id
        let deadAlloc : Allocation := {
          allocId := aid
          alignLog2 := al
          mutability := mu
          bytes := listReplicate sz .uninit
          live := false
        }
        cases hUp1 : updateAlloc? aid deadAlloc m₁.allocations with
        | some _ => rw [hUp1] at hFault; cases hFault
        | none =>
          rw [hUp1] at hFault
          have hAidNe : aid ≠ internalAllocBase + plan.bufLocal := fun h => hNe (Nat.add_left_cancel h)
          have hUpComm := s4_updateAlloc?_filter_ne (internalAllocBase + plan.bufLocal) aid deadAlloc hAidNe rfl m₁.allocations
          rw [hUp1, ← hMem.1] at hUpComm
          dsimp [evalMemCopyStmt]
          rw [h0, hDeclTgt]
          dsimp
          rw [hSet2]
          dsimp
          rw [← hUpComm]
          exact hFault

private theorem s4_sim_stmt_assign
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {dst : Place} {rval : Rvalue}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx =
      some (.baseStmt (.assign dst rval)))
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hChk := s4_bodySrc_stmt_check pack hBbSrc hStmtSrc
  have hLow := s4_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hLow with | intro extraStart hL =>
  have hGen : lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size
      (.baseStmt (.assign dst rval)) = [.baseStmt (.assign dst rval)] := rfl
  have hStmtTgt := hL.2.2.1 0 (by rw [hGen]; exact Nat.zero_lt_succ 0)
  rw [← hLenEq, Nat.add_zero, hGen] at hStmtTgt
  have hLenNext := hL.2.2.2.1
  rw [← hLenEq, hGen] at hLenNext
  refine s4_sim_stmt_one pack hSame hSame₂ hBbRel hBbSrc hStmtSrc hLenNext
    hBodySrc hBodyTgt (by rw [hBbRel]; exact hL.2.1) hStmtTgt ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    dsimp [evalMemCopyStmt] at hStep
    cases hProj : !dst.projection.isEmpty with
    | true => rw [hProj] at hStep; cases hStep
    | false =>
      rw [hProj] at hStep
      dsimp [checkStmtForBuf] at hChk
      rw [hProj] at hChk
      dsimp at hChk
      have hAnd := (bool_and_eq_true _ _).mp hChk
      have hNe : dst.localId ≠ plan.bufLocal := nat_beq_false_ne (by
        cases hB : Nat.beq dst.localId plan.bufLocal with
        | false => rfl
        | true => rw [hB] at hAnd; cases hAnd.1)
      have hInB : dst.localId < pack.bodySrc.locals.length := by
        have hLB := s4_bodySrc_stmt_localsInBounds pack hBbSrc hStmtSrc
        dsimp [memCopyStmtLocalsInBounds, baseStmtLocalsInBounds] at hLB
        exact (nat_blt_eq_lt _ _).mp ((bool_and_eq_true _ _).mp hLB).1
      cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst.localId with
      | none => rw [hD] at hStep; cases hStep
      | some d =>
        rw [hD] at hStep
        cases d with
        | ptrLocal | byteBuf _ _ _ => cases hStep
        | base dstTy =>
          dsimp at hStep
          have hDTgt := s4_getElem?_bodyTgt_locals_lt pack hInB hNe
          rw [hD] at hDTgt
          have hRv := s4_evalMemCopyBaseRvalue_prefix pack hPM hWf hBuf hScr (dstTy := dstTy) hAnd.2
          cases hEv : evalMemCopyBaseRvalue pack.bodySrc.locals f₁.locals dstTy rval with
          | error k => rw [hEv] at hStep; cases hStep
          | ok res =>
            rw [hEv] at hStep hRv
            dsimp at hStep
            cases hRv with | intro slots₂₁ hR2 =>
            have hWr := s4_writeMemCopyBasePlace_prefix pack hR2.2.1 hR2.2.2.1 hR2.2.2.2.1 hR2.2.2.2.2 hD hNe
              (val := res.1)
            cases hW : writeMemCopyBasePlace res.2 dst.localId dstTy res.1 with
            | error k => rw [hW] at hStep; cases hStep
            | ok slots₁' =>
              rw [hW] at hStep hWr
              cases hWr with | intro slots₂' hW2 =>
              cases StepResult.step.inj hStep
              refine ⟨slots₁', m₁, slots₂', m₂, rfl, ?_, hW2.2.1, hW2.2.2.1, hW2.2.2.2.1, hMem, hW2.2.2.2.2⟩
              dsimp [evalMemCopyStmt]
              rw [hProj, hDTgt]
              dsimp
              rw [hR2.1]
              dsimp
              rw [hW2.1]
  · intro out hDone
    dsimp [evalMemCopyStmt] at hDone
    cases hProj : !dst.projection.isEmpty with
    | true => rw [hProj] at hDone; cases hDone
    | false =>
      rw [hProj] at hDone
      cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst.localId with
      | none => rw [hD] at hDone; cases hDone
      | some d =>
        rw [hD] at hDone
        cases d with
        | ptrLocal | byteBuf _ _ _ => cases hDone
        | base dstTy =>
          dsimp at hDone
          cases hEv : evalMemCopyBaseRvalue pack.bodySrc.locals f₁.locals dstTy rval with
          | error _ => rw [hEv] at hDone; cases hDone
          | ok res =>
            rw [hEv] at hDone
            dsimp at hDone
            cases hW : writeMemCopyBasePlace res.2 dst.localId dstTy res.1 with
            | error _ => rw [hW] at hDone; cases hDone
            | ok _ => rw [hW] at hDone; cases hDone
  · intro k hFault
    dsimp [evalMemCopyStmt] at hFault
    cases hProj : !dst.projection.isEmpty with
    | true =>
      rw [hProj] at hFault
      dsimp [evalMemCopyStmt]
      rw [hProj]
      exact hFault
    | false =>
      rw [hProj] at hFault
      dsimp [checkStmtForBuf] at hChk
      rw [hProj] at hChk
      dsimp at hChk
      have hAnd := (bool_and_eq_true _ _).mp hChk
      have hNe : dst.localId ≠ plan.bufLocal := nat_beq_false_ne (by
        cases hB : Nat.beq dst.localId plan.bufLocal with
        | false => rfl
        | true => rw [hB] at hAnd; cases hAnd.1)
      have hInB : dst.localId < pack.bodySrc.locals.length := by
        have hLB := s4_bodySrc_stmt_localsInBounds pack hBbSrc hStmtSrc
        dsimp [memCopyStmtLocalsInBounds, baseStmtLocalsInBounds] at hLB
        exact (nat_blt_eq_lt _ _).mp ((bool_and_eq_true _ _).mp hLB).1
      have hDTgt := s4_getElem?_bodyTgt_locals_lt pack hInB hNe
      cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals dst.localId with
      | none =>
        rw [hD] at hFault hDTgt
        dsimp [evalMemCopyStmt]
        rw [hProj, hDTgt]
        exact hFault
      | some d =>
        rw [hD] at hFault hDTgt
        cases d with
        | ptrLocal | byteBuf _ _ _ =>
          dsimp [evalMemCopyStmt]
          rw [hProj, hDTgt]
          exact hFault
        | base dstTy =>
          dsimp at hFault
          have hRv := s4_evalMemCopyBaseRvalue_prefix pack hPM hWf hBuf hScr (dstTy := dstTy) hAnd.2
          cases hEv : evalMemCopyBaseRvalue pack.bodySrc.locals f₁.locals dstTy rval with
          | error k1 =>
            rw [hEv] at hFault hRv
            dsimp [evalMemCopyStmt]
            rw [hProj, hDTgt]
            dsimp
            rw [hRv]
            exact hFault
          | ok res =>
            rw [hEv] at hFault hRv
            dsimp at hFault
            cases hRv with | intro slots₂₁ hR2 =>
            have hWr := s4_writeMemCopyBasePlace_prefix pack hR2.2.1 hR2.2.2.1 hR2.2.2.2.1 hR2.2.2.2.2 hD hNe
              (val := res.1)
            cases hW : writeMemCopyBasePlace res.2 dst.localId dstTy res.1 with
            | ok _ => rw [hW] at hFault; cases hFault
            | error k2 =>
              rw [hW] at hFault hWr
              dsimp [evalMemCopyStmt]
              rw [hProj, hDTgt]
              dsimp
              rw [hR2.1]
              dsimp
              rw [hWr]
              exact hFault

private theorem s4_sim_stmt_bufLivenessCheck_buf
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx =
      some (.bufLivenessCheck plan.bufLocal))
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hLow := s4_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hLow with | intro extraStart hL =>
  have hGen : lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size
      (.bufLivenessCheck plan.bufLocal) = [mkLivenessCheckStmt pack.bodySrc.locals.length] := by
    dsimp [lowerStmtForBuf]; rw [nat_beq_refl]; rfl
  have hStmtTgt := hL.2.2.1 0 (by rw [hGen]; exact Nat.zero_lt_succ 0)
  rw [← hLenEq, Nat.add_zero, hGen] at hStmtTgt
  have hLenNext := hL.2.2.2.1
  rw [← hLenEq, hGen] at hLenNext
  refine s4_sim_stmt_one pack hSame hSame₂ hBbRel hBbSrc hStmtSrc hLenNext
    hBodySrc hBodyTgt (by rw [hBbRel]; exact hL.2.1) hStmtTgt ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    cases hBuf with | intro isLive hB1 =>
    cases hB1 with | intro alloc hB2 =>
    dsimp [evalMemCopyStmt] at hStep
    rw [pack.hBufDecl, hB2.1] at hStep
    cases isLive with
    | false => cases hStep
    | true =>
      cases StepResult.step.inj hStep
      dsimp at hB2
      refine ⟨f₁.locals, m₁, f₂.locals, m₂, rfl,
        s4_step_mkLivenessCheckStmt_live pack f₂ m₂ hB2.2.2.2.2.2.2.2.2.1,
        hPM, hWf, ⟨true, alloc, hB2⟩, hMem, hScr⟩
  · intro out hDone
    cases hBuf with | intro isLive hB1 =>
    cases hB1 with | intro alloc hB2 =>
    dsimp [evalMemCopyStmt] at hDone
    rw [pack.hBufDecl, hB2.1] at hDone
    cases isLive <;> cases hDone
  · intro k hFault
    cases hBuf with | intro isLive hB1 =>
    cases hB1 with | intro alloc hB2 =>
    dsimp [evalMemCopyStmt] at hFault
    rw [pack.hBufDecl, hB2.1] at hFault
    cases isLive with
    | true => cases hFault
    | false =>
      dsimp at hB2
      rw [s4_step_mkLivenessCheckStmt_dead pack f₂ m₂ hB2.2.2.2.2.2.2.2.2.1]
      exact hFault

private theorem s4_sim_stmt_bufLivenessCheck_other
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {b : LocalId}
    (hNe : b ≠ plan.bufLocal)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx =
      some (.bufLivenessCheck b))
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hLow := s4_lowerBlock_getElem?_stmt pack hBbSrc hStmtSrc
  cases hLow with | intro extraStart hL =>
  have hGen : lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size
      (.bufLivenessCheck b) = [.bufLivenessCheck b] := by
    dsimp [lowerStmtForBuf]; rw [s4_nat_beq_false hNe]; rfl
  have hStmtTgt := hL.2.2.1 0 (by rw [hGen]; exact Nat.zero_lt_succ 0)
  rw [← hLenEq, Nat.add_zero, hGen] at hStmtTgt
  have hLenNext := hL.2.2.2.1
  rw [← hLenEq, hGen] at hLenNext
  have hInB : b < pack.bodySrc.locals.length :=
    (nat_blt_eq_lt _ _).mp (s4_bodySrc_stmt_localsInBounds pack hBbSrc hStmtSrc)
  have hDTgt := s4_getElem?_bodyTgt_locals_lt pack hInB hNe
  have hSTgt := hPM.2.2 b hInB hNe
  refine s4_sim_stmt_one pack hSame hSame₂ hBbRel hBbSrc hStmtSrc hLenNext
    hBodySrc hBodyTgt (by rw [hBbRel]; exact hL.2.1) hStmtTgt ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    dsimp [evalMemCopyStmt] at hStep
    cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
    | none => rw [hD] at hStep; cases hStep
    | some d =>
      rw [hD] at hStep
      cases d with
      | base _ | ptrLocal => cases hStep
      | byteBuf _ _ _ =>
        cases hS : Trusted.MirSemantics.getElem? f₁.locals b with
        | none => rw [hS] at hStep; cases hStep
        | some sl =>
          rw [hS] at hStep
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => cases hStep
          | bufSlot isL =>
            cases isL with
            | false => cases hStep
            | true =>
              cases StepResult.step.inj hStep
              refine ⟨f₁.locals, m₁, f₂.locals, m₂, rfl, ?_, hPM, hWf, hBuf, hMem, hScr⟩
              dsimp [evalMemCopyStmt]
              rw [hDTgt, hD, hSTgt, hS]
  · intro out hDone
    dsimp [evalMemCopyStmt] at hDone
    cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
    | none => rw [hD] at hDone; cases hDone
    | some d =>
      rw [hD] at hDone
      cases d with
      | base _ | ptrLocal => cases hDone
      | byteBuf _ _ _ =>
        cases hS : Trusted.MirSemantics.getElem? f₁.locals b with
        | none => rw [hS] at hDone; cases hDone
        | some sl =>
          rw [hS] at hDone
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => cases hDone
          | bufSlot isL => cases isL <;> cases hDone
  · intro k hFault
    dsimp [evalMemCopyStmt]
    dsimp [evalMemCopyStmt] at hFault
    rw [hDTgt, hSTgt]
    cases hD : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
    | none => rw [hD] at hFault; exact hFault
    | some d =>
      rw [hD] at hFault
      cases d with
      | base _ | ptrLocal => exact hFault
      | byteBuf _ _ _ =>
        cases hS : Trusted.MirSemantics.getElem? f₁.locals b with
        | none => rw [hS] at hFault; exact hFault
        | some sl =>
          rw [hS] at hFault
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => exact hFault
          | bufSlot isL =>
            cases isL with
            | true => cases hFault
            | false => exact hFault

private theorem s4_stmt_step_sim
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {stmtSrc : MemCopyStmt}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmtSrc)
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hChk := s4_bodySrc_stmt_check pack hBbSrc hStmtSrc
  cases stmtSrc with
  | baseStmt bs =>
    cases bs with
    | nop =>
      exact s4_sim_stmt_nop_or_unsupported pack hSame hSame₂ hBbRel hBbSrc hStmtSrc
        hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr (Or.inl rfl)
    | unsupported =>
      exact s4_sim_stmt_nop_or_unsupported pack hSame hSame₂ hBbRel hBbSrc hStmtSrc
        hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr (Or.inr rfl)
    | storageLive id =>
      cases s4_nat_eq_or_ne id plan.bufLocal with
      | inl hEq =>
        rw [hEq] at hStmtSrc
        exact s4_sim_stmt_storageLive_buf pack hSame hSame₂ hBbRel hBbSrc hStmtSrc
          hLenEq hBodySrc hPM hWf hBuf hMem hScr
      | inr hNe =>
        exact s4_sim_stmt_storageLive_other pack hNe hSame hSame₂ hBbRel hBbSrc hStmtSrc
          hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
    | storageDead id =>
      cases s4_nat_eq_or_ne id plan.bufLocal with
      | inl hEq =>
        rw [hEq] at hStmtSrc
        exact s4_sim_stmt_storageDead_buf pack hSame hSame₂ hBbRel hBbSrc hStmtSrc
          hLenEq hBodySrc hPM hWf hBuf hMem hScr
      | inr hNe =>
        exact s4_sim_stmt_storageDead_other pack hNe hSame hSame₂ hBbRel hBbSrc hStmtSrc
          hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
    | assign dst rval =>
      exact s4_sim_stmt_assign pack hSame hSame₂ hBbRel hBbSrc hStmtSrc
        hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
  | bufLivenessCheck b =>
    cases s4_nat_eq_or_ne b plan.bufLocal with
    | inl hEq =>
      rw [hEq] at hStmtSrc
      exact s4_sim_stmt_bufLivenessCheck_buf pack hSame hSame₂ hBbRel hBbSrc hStmtSrc
        hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
    | inr hNe =>
      exact s4_sim_stmt_bufLivenessCheck_other pack hNe hSame hSame₂ hBbRel hBbSrc hStmtSrc
        hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
  | mkNullPtr _ | mkDanglingPtr _ _ | addrOfByteBuf _ _ | copyPtr _ _ _ | ptrWrappingOffset _ _ _ _ =>
    cases hChk

