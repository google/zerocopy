              have hReach2 : ReachesNMemCopy ctx.pTgt (3 + 1)
                  { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off, locals := f₂.locals }], mem := mem }
                  { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off + 4, locals := slots₂b }], mem := mem } := by
                have hR := s3d_reachesN_trans hReach1 (s3_reachesN_one hB.1)
                rw [Nat.add_assoc off 3 1] at hR; exact hR
              have hRel2 := hB.2.1
              have hTagSlot2 := (hB.2.2.2 0 (by decide) (by decide)).trans hTagSlot
              have hOffSlot2 := (hB.2.2.2 1 (by decide) (by decide)).trans hOffSlot
              cases s3d_memWf_buf_alloc ctx hBD hWf1 with | intro live hBA =>
              cases hBA with | intro alloc hAlloc =>
              rw [hAlloc.2.1]; dsimp
              have hExecBuf := s3d_exec_bufLivenessCheck ctx (bbIdx := f₁.blockIdx)
                (bbTgt := bbTgt) (idx := off + 4) (slots₁ := slots₁') (slots₂ := slots₂b)
                (mem := mem) bufLoc bufSize bufAl bufMut live hBD hRel2 hAlloc.1 hBbTgt hBufStmt
              cases hLv : live with
              | false =>
                have hAlLive : (!alloc.live) = true := by rw [hAlloc.2.2.1, hLv]; rfl
                rw [s3d_ite_true_cond hAlLive]
                rw [hf₂Eq]
                exact s3_fault_of_reachesN hReach2 (hExecBuf.2 hLv)
              | true =>
                have hAlLive : (!alloc.live) = false := by rw [hAlloc.2.2.1, hLv]; rfl
                rw [s3d_ite_false_cond hAlLive]
                have hReach3 : ReachesNMemCopy ctx.pTgt (3 + 1 + 1)
                    { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off, locals := f₂.locals }], mem := mem }
                    { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off + 5, locals := slots₂b }], mem := mem } := by
                  have hR := s3d_reachesN_trans hReach2 (s3_reachesN_one (hExecBuf.1 hLv))
                  rw [Nat.add_assoc off 4 1] at hR; exact hR
                have hBndExec := s3d_exec_subUnchecked_const_copy_scr ctx (bbIdx := f₁.blockIdx)
                  (bbTgt := bbTgt) (idx := off + 5) (slots₁ := slots₁') (slots₂ := slots₂b)
                  (mem := mem) 5 1 bufSize pv.offsetBytes.toNat
                  (by decide) (by decide) hBufSzLt (s3_u64_toNat_lt _) hOffSlot2 hRel2 hBbTgt hBndStmt
                cases Nat.lt_or_ge bufSize pv.offsetBytes.toNat with
                | inl hGtBuf =>
                  have hBufLen : alloc.bytes.length = bufSize := hAlloc.2.2.2 hLv
                  have hNotOffLe : ¬ (Int.ofNat pv.offsetBytes.toNat ≤ Int.ofNat alloc.bytes.length) := by
                    intro hLe
                    rw [hBufLen] at hLe
                    exact Nat.not_lt_of_le (s0_int_ofNat_le_mp hLe) hGtBuf
                  have hAllF : (decide (0 ≤ (pv.offsetBytes.toNat : Int)) &&
                      decide ((pv.offsetBytes.toNat : Int) ≤ (alloc.bytes.length : Int)) &&
                      decide (0 ≤ (pv.offsetBytes.toNat : Int) + delta) &&
                      decide ((pv.offsetBytes.toNat : Int) + delta ≤ (alloc.bytes.length : Int))) = false := by
                    change (decide (0 ≤ Int.ofNat pv.offsetBytes.toNat) &&
                        decide (Int.ofNat pv.offsetBytes.toNat ≤ Int.ofNat alloc.bytes.length) &&
                        decide (0 ≤ Int.ofNat pv.offsetBytes.toNat + delta) &&
                        decide (Int.ofNat pv.offsetBytes.toNat + delta ≤ Int.ofNat alloc.bytes.length)) = false
                    rw [decide_eq_false hNotOffLe]
                    cases decide (0 ≤ Int.ofNat pv.offsetBytes.toNat) <;>
                      cases decide (0 ≤ Int.ofNat pv.offsetBytes.toNat + delta) <;>
                      cases decide (Int.ofNat pv.offsetBytes.toNat + delta ≤ Int.ofNat alloc.bytes.length) <;> rfl
                  rw [s3d_ite_false_cond hAllF]; dsimp
                  rw [hf₂Eq]
                  exact s3_fault_of_reachesN hReach3 (hBndExec.2 hGtBuf)
                | inr hOffLeBuf =>
                  have hBufLen : alloc.bytes.length = bufSize := hAlloc.2.2.2 hLv
                  cases hBndExec.1 hOffLeBuf with | intro slots₂c hC =>
                  have hReach4 : ReachesNMemCopy ctx.pTgt (3 + 1 + 1 + 1)
                      { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off, locals := f₂.locals }], mem := mem }
                      { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off + 6, locals := slots₂c }], mem := mem } := by
                    have hR := s3d_reachesN_trans hReach3 (s3_reachesN_one hC.1)
                    rw [Nat.add_assoc off 5 1] at hR; exact hR
                  have hRel4 := hC.2.1
                  have hTagSlot4 := (hC.2.2.2 0 (by decide) (by decide)).trans hTagSlot2
                  have hOffSlot4 := (hC.2.2.2 1 (by decide) (by decide)).trans hOffSlot2
                  have hSubExec := s3d_exec_subUnchecked_move_const_scr ctx (bbIdx := f₁.blockIdx)
                    (bbTgt := bbTgt) (idx := off + 6) (slots₁ := slots₁') (slots₂ := slots₂c)
                    (mem := mem) 1 pv.offsetBytes.toNat negNat (by decide) (s3_u64_toNat_lt _)
                    hNegNatLt hOffSlot4 hRel4 hBbTgt hSubStmt
                  cases Nat.lt_or_ge pv.offsetBytes.toNat negNat with
                  | inl hLtNeg =>
                    have hNotNN : ¬ ((0 : Int) ≤ Int.ofNat pv.offsetBytes.toNat + delta) := by
                      intro hNN
                      rw [hDeltaNeg] at hNN
                      exact Nat.not_lt_of_le (s3d_int_nonneg_of_sub_zero _ _ hNN) hLtNeg
                    have hAllF : (decide (0 ≤ (pv.offsetBytes.toNat : Int)) &&
                        decide ((pv.offsetBytes.toNat : Int) ≤ (alloc.bytes.length : Int)) &&
                        decide (0 ≤ (pv.offsetBytes.toNat : Int) + delta) &&
                        decide ((pv.offsetBytes.toNat : Int) + delta ≤ (alloc.bytes.length : Int))) = false := by
                      change (decide (0 ≤ Int.ofNat pv.offsetBytes.toNat) &&
                          decide (Int.ofNat pv.offsetBytes.toNat ≤ Int.ofNat alloc.bytes.length) &&
                          decide (0 ≤ Int.ofNat pv.offsetBytes.toNat + delta) &&
                          decide (Int.ofNat pv.offsetBytes.toNat + delta ≤ Int.ofNat alloc.bytes.length)) = false
                      rw [decide_eq_false hNotNN]
                      cases decide (0 ≤ Int.ofNat pv.offsetBytes.toNat) <;>
                        cases decide (Int.ofNat pv.offsetBytes.toNat ≤ Int.ofNat alloc.bytes.length) <;>
                        cases decide (Int.ofNat pv.offsetBytes.toNat + delta ≤ Int.ofNat alloc.bytes.length) <;> rfl
                    rw [s3d_ite_false_cond hAllF]; dsimp
                    rw [hf₂Eq]
                    exact s3_fault_of_reachesN hReach4 (hSubExec.2 hLtNeg)
                  | inr hNegLeOff =>
                    have hResLeBuf : pv.offsetBytes.toNat - negNat ≤ bufSize :=
                      Nat.le_trans (Nat.sub_le _ _) hOffLeBuf
                    have hResLt : pv.offsetBytes.toNat - negNat < maxUsize :=
                      Nat.lt_of_le_of_lt hResLeBuf hBufSzLt
                    cases hSubExec.1 hNegLeOff with | intro slots₂d hD =>
                    have hReach5 : ReachesNMemCopy ctx.pTgt (3 + 1 + 1 + 1 + 1)
                        { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off, locals := f₂.locals }], mem := mem }
                        { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off + 7, locals := slots₂d }], mem := mem } := by
                      have hR := s3d_reachesN_trans hReach4 (s3_reachesN_one hD.1)
                      rw [Nat.add_assoc off 6 1] at hR; exact hR
                    have hRel5 := hD.2.1
                    have hTagSlot5 := (hD.2.2.2 0 (by decide) (by decide)).trans hTagSlot4
                    have hOffSlot5 := hD.2.2.1
                    have hNewEq : (pv.offsetBytes.toNat : Int) + delta =
                        Int.ofNat (pv.offsetBytes.toNat - negNat) := by
                      change Int.ofNat pv.offsetBytes.toNat + delta = Int.ofNat (pv.offsetBytes.toNat - negNat)
                      rw [hDeltaNeg, s0_int_ofNat_sub hNegLeOff]; rfl
                    have hAllT : (decide (0 ≤ (pv.offsetBytes.toNat : Int)) &&
                        decide ((pv.offsetBytes.toNat : Int) ≤ (alloc.bytes.length : Int)) &&
                        decide (0 ≤ (pv.offsetBytes.toNat : Int) + delta) &&
                        decide ((pv.offsetBytes.toNat : Int) + delta ≤ (alloc.bytes.length : Int))) = true := by
                      rw [hNewEq]
                      change (decide (0 ≤ Int.ofNat pv.offsetBytes.toNat) &&
                          decide (Int.ofNat pv.offsetBytes.toNat ≤ Int.ofNat alloc.bytes.length) &&
                          decide (0 ≤ Int.ofNat (pv.offsetBytes.toNat - negNat)) &&
                          decide (Int.ofNat (pv.offsetBytes.toNat - negNat) ≤ Int.ofNat alloc.bytes.length)) = true
                      rw [hBufLen,
                        decide_eq_true (s0_int_natCast_nonneg _),
                        decide_eq_true (s0_int_ofNat_le_mpr hOffLeBuf),
                        decide_eq_true (s0_int_natCast_nonneg _),
                        decide_eq_true (s0_int_ofNat_le_mpr hResLeBuf)]; rfl
                    rw [s3d_ite_true_cond hAllT]; dsimp
                    rw [hNewEq]
                    have hOffToNat : ({ allocId := some (internalAllocBase + bufLoc), offsetBytes := UInt64.ofNat (Int.ofNat (pv.offsetBytes.toNat - negNat)).toNat } : PtrVal).offsetBytes.toNat = pv.offsetBytes.toNat - negNat :=
                      s3_u64_toNat_ofNat _ hResLt
                    have hMatchD : s3_PtrTagMatches optBufD ({ allocId := some (internalAllocBase + bufLoc), offsetBytes := UInt64.ofNat (Int.ofNat (pv.offsetBytes.toNat - negNat)).toNat } : PtrVal) 1 := by
                      have hM1 : s3_PtrTagMatches optBufS ({ allocId := some (internalAllocBase + bufLoc), offsetBytes := UInt64.ofNat (Int.ofNat (pv.offsetBytes.toNat - negNat)).toNat } : PtrVal) 1 := by
                        rw [hOptS]; exact Or.inr ⟨rfl, rfl⟩
