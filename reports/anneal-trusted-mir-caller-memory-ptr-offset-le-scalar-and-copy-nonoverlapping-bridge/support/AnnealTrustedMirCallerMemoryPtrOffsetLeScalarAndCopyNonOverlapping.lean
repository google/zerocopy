                    rw [← hf₂Eq] at hReach5
                    exact s3d_exec_writeDst_and_goto ctx (bbIdx := f₁.blockIdx) (bbTgt := bbTgt)
                      (startIdx := off + 7) (f₁ := f₁) (f₂Init := f₂) (slots₁ := slots₁')
                      (slots₂ := slots₂d) (mem := mem) (nPre := 7) dstPtr kD 1
                      (pv.offsetBytes.toNat - negNat) optBufD _ nextBb
                      hEqId hDef₁ hDef₂ hFindD (by decide) hResLt rfl hMatchD hOffToNat
                      hTagSlot5 hOffSlot5 hWf1 hRel5 hReach5 hBbTgt hWD0 hWD1 hWD2 hEnd hTermTgt hBbJump

private theorem s3d_ptrOffsetInbounds_runtime_run (ctx : s3_PtrCtx)
    {bbSrc bbTgt bbJump : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    {extraBase off kD kS : Nat} {extraSelf : List MemCopyBlock}
    (dstPtr srcPtr : LocalId) (countOp : Operand) (elemSize : Nat) (nextBb : BasicBlockId)
    (optBufD optBufS : Option LocalId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hTerm : bbSrc.terminator = .ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb)
    (hNoConst : constIsizeValue? countOp = none)
    (hCntBase : operandHasBaseTy ctx.bodySrc.locals usizeTy countOp = true)
    (hFindD : findPtrEntry ctx.plan.entries dstPtr = some (kD, optBufD))
    (hFindS : findPtrEntry ctx.plan.entries srcPtr = some (kS, optBufS))
    (hCompat : checkPtrCopyCompat optBufD optBufS = true)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₁.blockIdx = some bbTgt)
    (hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off, locals := f₂.locals })
    (hPairExtra : (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
        ctx.bodySrc.locals.length extraBase bbSrc.terminator).2.2 = extraSelf)
    (hOffLen : off + (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
        ctx.bodySrc.locals.length extraBase bbSrc.terminator).1.length = bbTgt.statements.length)
    (hTermTgt : bbTgt.terminator = (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
        ctx.bodySrc.locals.length extraBase bbSrc.terminator).2.1)
    (hPreStmts : ∀ j : Nat,
        j < (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
          ctx.bodySrc.locals.length extraBase bbSrc.terminator).1.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
          Trusted.MirSemantics.getElem? (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
            ctx.bodySrc.locals.length extraBase bbSrc.terminator).1 j)
    (hExtraAt : ∀ k : Nat, ∀ eb : MemCopyBlock,
        Trusted.MirSemantics.getElem? extraSelf k = some eb →
        Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks (extraBase + k) = some eb)
    (hBbJump : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks nextBb = some bbJump) :
    match evalMemCopyTerm ctx.bodySrc bbSrc f₁ mem with
    | .step s₁' =>
      ∃ s₂' : MemCopyState,
        ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
        s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂'
    | .done _ => False
    | .fault k =>
      ∃ s₂' : MemCopyState,
        ReachesMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.fault k) := by
  let scrTag1 := s3_scrBase ctx
  let scrOff1 := s3_scrBase ctx + 1
  let scrCnt := s3_scrBase ctx + 4
  let scrTmpA := s3_scrBase ctx + 5
  let scrTmpB := s3_scrBase ctx + 6
  let offD := ctx.bodySrc.locals.length + 3 * kD
  let offS := ctx.bodySrc.locals.length + 3 * kS
  let readSrc : List MemCopyStmt := [
    mkLivenessCheckStmt offS,
    mkAssignUse scrTag1 (.copy { localId := offS + 1, projection := [] }),
    mkAssignUse scrOff1 (.copy { localId := offS + 2, projection := [] })
  ]
  let writeDst : List MemCopyStmt := [
    mkLivenessCheckStmt offD,
    mkAssignUse (offD + 1) (.move { localId := scrTag1, projection := [] }),
    mkAssignUse (offD + 2) (.move { localId := scrOff1, projection := [] })
  ]
  let evalCntAndRead : List MemCopyStmt := [mkAssignUse scrCnt countOp] ++ readSrc
  have hECRLen : evalCntAndRead.length = 4 := rfl
  have hEvalSim := s3_evalUsizeOp_assign_scr ctx f₂ f₁.locals mem 4 countOp (by decide) hWf hRel hCntBase
  have hOffSim := s3_evalOffsetCountOp_usize_iff ctx f₁.locals f₂.locals mem countOp hWf hRel hCntBase
  unfold evalMemCopyTerm; dsimp; rw [hTerm]; dsimp
  cases hEz : Nat.beq elemSize 0 with
  | true =>
    have hE0 : elemSize = 0 := Nat.eq_of_beq_eq_true hEz
    have hPairEq : lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries
        ctx.bodySrc.locals.length extraBase (.ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb) =
        (evalCntAndRead ++ writeDst, .baseTerm (.goto nextBb), []) := by
      unfold lowerTermForPtrs; dsimp
      rw [hFindD, hFindS, hNoConst]; dsimp
      rw [hEz]; rfl
    rw [hTerm] at hOffLen hTermTgt hPreStmts
    rw [hPairEq] at hOffLen hTermTgt hPreStmts
    have hPreLen : (evalCntAndRead ++ writeDst).length = 7 := rfl
    have hStmt0 : Trusted.MirSemantics.getElem? bbTgt.statements off =
        some (mkAssignUse (s3_scrBase ctx + 4) countOp) := by
      have h0 := hPreStmts 0 (by rw [hPreLen]; decide)
      rw [Nat.add_zero] at h0; exact h0
    have hRS0 : Trusted.MirSemantics.getElem? bbTgt.statements (off + 1) =
        some (mkLivenessCheckStmt offS) :=
      hPreStmts 1 (by rw [hPreLen]; decide)
    have hRS1 : Trusted.MirSemantics.getElem? bbTgt.statements ((off + 1) + 1) =
        some (mkAssignUse (s3_scrBase ctx + 0) (.copy { localId := offS + 1, projection := [] })) := by
      rw [Nat.add_assoc]; exact hPreStmts 2 (by rw [hPreLen]; decide)
    have hRS2 : Trusted.MirSemantics.getElem? bbTgt.statements ((off + 1) + 2) =
        some (mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := offS + 2, projection := [] })) := by
      rw [Nat.add_assoc]; exact hPreStmts 3 (by rw [hPreLen]; decide)
    have hWD0 : Trusted.MirSemantics.getElem? bbTgt.statements (off + 4) =
        some (mkLivenessCheckStmt offD) :=
      hPreStmts 4 (by rw [hPreLen]; decide)
    have hWD1 : Trusted.MirSemantics.getElem? bbTgt.statements ((off + 4) + 1) =
        some (mkAssignUse (offD + 1) (.move { localId := s3_scrBase ctx + 0, projection := [] })) := by
      rw [Nat.add_assoc]; exact hPreStmts 5 (by rw [hPreLen]; decide)
    have hWD2 : Trusted.MirSemantics.getElem? bbTgt.statements ((off + 4) + 2) =
        some (mkAssignUse (offD + 2) (.move { localId := s3_scrBase ctx + 1, projection := [] })) := by
      rw [Nat.add_assoc]; exact hPreStmts 6 (by rw [hPreLen]; decide)
    have hEnd : (off + 4) + 3 = bbTgt.statements.length := by
      rw [Nat.add_assoc]; exact hOffLen
    cases hEU : evalUsizeOp ctx.bodySrc.locals f₁.locals countOp with
    | error k1 =>
      rw [hEU] at hEvalSim hOffSim
      cases hEO : evalOffsetCountOp ctx.bodySrc.locals f₁.locals countOp with
      | ok _ => rw [hEO] at hOffSim; exact False.elim hOffSim
      | error k2 =>
        rw [hEO] at hOffSim; dsimp
        rw [hOffSim] at hEvalSim
        have hF0 : evalStepMemCopy ctx.pTgt 0 { frames := [f₂], mem := mem } = .fault k2 := by
          have hSt0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
              some (mkAssignUse (s3_scrBase ctx + 4) countOp) := by
            rw [hf₂Eq]; exact hStmt0
          have hBb2 : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
            rw [hf₂Eq]; exact hBbTgt
          rw [s3_step_state_of_stmt ctx.pTgt f₂ mem ctx.bodyTgt bbTgt _
            (by rw [hf₂Eq]; exact s3_bodyTgt_get ctx) hBb2 hSt0]
          exact hEvalSim
        exact ⟨{ frames := [f₂], mem := mem }, .refl _, (stepMemCopy_iff_evalStep _ _ _).mpr hF0⟩
    | ok pU =>
      rw [hEU] at hEvalSim hOffSim
      cases pU with | mk cntNat slots₁a =>
      cases hEO : evalOffsetCountOp ctx.bodySrc.locals f₁.locals countOp with
      | error _ => rw [hEO] at hOffSim; exact False.elim hOffSim
      | ok pO =>
        rw [hEO] at hOffSim; dsimp
        cases pO with | mk zO slots₁'' =>
        dsimp at hOffSim
        have hzEq : zO = Int.ofNat cntNat := hOffSim.1
        have hs1Eq : slots₁a = slots₁'' := hOffSim.2.1
        rw [← hs1Eq]
        cases hEvalSim.2 with | intro slots₂a hA =>
        have hStep0 : evalStepMemCopy ctx.pTgt 0 { frames := [f₂], mem := mem } =
            .step { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off + 1, locals := slots₂a }], mem := mem } := by
          have hSt0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
              some (mkAssignUse (s3_scrBase ctx + 4) countOp) := by
            rw [hf₂Eq]; exact hStmt0
          have hBb2 : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
            rw [hf₂Eq]; exact hBbTgt
          rw [s3_step_state_of_stmt ctx.pTgt f₂ mem ctx.bodyTgt bbTgt _
            (by rw [hf₂Eq]; exact s3_bodyTgt_get ctx) hBb2 hSt0]
          rw [hA.1]
          unfold stepMemCopyNext
          rw [hf₂Eq]
        have hReach1 := s3_reachesN_one hStep0
        have hWf1 := hA.2.2.1
        have hRel1 := hA.2.2.2
        have hExecS := s3_exec_readPtr ctx (bbIdx := f₁.blockIdx) (bbTgt := bbTgt)
          (startIdx := off + 1) (slots₁ := slots₁a) (slots₂ := slots₂a) (mem := mem)
          srcPtr kS 0 1 optBufS false hFindS (by decide) (by decide) (by decide)
          hWf1 hRel1 hBbTgt hRS0 hRS1 hRS2
        cases hRS : readPtrLocal ctx.bodySrc.locals slots₁a srcPtr false with
        | error k =>
          rw [hRS] at hExecS; dsimp
          cases hExecS with | intro n hB =>
          cases hB with | intro sBad hBad =>
          exact s3_fault_of_reachesN (s3d_reachesN_trans hReach1 hBad.1) hBad.2
        | ok p1 =>
          rw [hRS] at hExecS; dsimp
          cases p1 with | mk pv slots₁b =>
          cases hExecS with | intro tagS hS =>
          cases hS with | intro slots₂b hS =>
          have hReach2 : ReachesNMemCopy ctx.pTgt (1 + 3) { frames := [f₂], mem := mem }
              { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := off + 4, locals := slots₂b }], mem := mem } := by
            have hR := s3d_reachesN_trans hReach1 hS.2.2.2.1
            rw [Nat.add_assoc off 1 3] at hR; exact hR
          have hDeltaZero : zO * Int.ofNat elemSize = 0 := by
            rw [hzEq, hE0]; rfl
          dsimp; rw [s3d_calcInbounds_zero_of_eq mem pv zO elemSize (by exact hDeltaZero)]; dsimp
          exact s3d_exec_writeDst_and_goto ctx (bbIdx := f₁.blockIdx) (bbTgt := bbTgt)
            (startIdx := off + 4) (f₁ := f₁) (f₂Init := f₂) (slots₁ := slots₁b) (slots₂ := slots₂b)
            (mem := mem) (nPre := 1 + 3) dstPtr kD tagS pv.offsetBytes.toNat optBufD
            { allocId := pv.allocId, offsetBytes := pv.offsetBytes } nextBb
            hEqId hDef₁ hDef₂ hFindD hS.2.2.1 (s3_u64_toNat_lt _) rfl
            (s3d_ptrTagMatches_compat hCompat hS.2.1) rfl
            hS.2.2.2.2.2.2.1 hS.2.2.2.2.2.2.2.1 hS.2.2.2.2.1 hS.2.2.2.2.2.1
            hReach2 hBbTgt hWD0 hWD1 hWD2 hEnd hTermTgt hBbJump
  | false =>
    have hEPos : 0 < elemSize := Nat.pos_of_ne_zero (fun h => by subst h; cases hEz)
    cases hBleMax : !Nat.ble elemSize maxIsize with
    | true =>
