private theorem isZeroCopyConst_evalUsizeOp (decls : List MemCopyLocalDecl)
    (slots : List MemCopySlot) (countOp : Operand) (elemSize : Nat)
    (hZero : isZeroCopyConst countOp elemSize = true) :
    ∃ n : Nat,
      evalUsizeOp decls slots countOp = .ok (n, slots) ∧
      elemSize * n = 0 := by
  unfold isZeroCopyConst at hZero
  cases countOp with
  | copy _ | move _ => cases hZero
  | constant c =>
    dsimp at hZero
    cases hTy : !MirTy.beq c.ty usizeTy with
    | true => rw [hTy] at hZero; cases hZero
    | false =>
      rw [hTy] at hZero
      dsimp at hZero
      have hTyEq : c.ty = usizeTy := by
        have hBeq : MirTy.beq c.ty usizeTy = true := (bool_not_eq_false _).mp hTy
        exact mirTy_beq_eq c.ty usizeTy hBeq
      cases hLit : evalConstLit usizeTy c.lit with
      | error _ => rw [hLit] at hZero; cases hZero
      | ok v =>
        rw [hLit] at hZero
        cases v with
        | bool _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => cases hZero
        | scalar sv =>
          dsimp at hZero
          have hAnd := (bool_and_eq_true _ _).mp hZero
          have hMul : elemSize * sv.bits.toNat = 0 := nat_beq_eq _ _ hAnd.2
          refine ⟨sv.bits.toNat, ?_, hMul⟩
          unfold evalUsizeOp evalMemCopyBaseOperandToSlot
          dsimp
          rw [hTyEq, hLit]
          dsimp
          rw [hAnd.1]
          rfl

private theorem copyNonOverlapping_eq_checkPtrPairAlign_eval (body : MemCopyBody)
    (bb : MemCopyBlock) (frame : MemCopyFrame) (mem : CallerMemory)
    (srcPtr dstPtr : LocalId) (countOp : Operand) (elemSize reqAlignLog2 : Nat)
    (checkNonNullZero : Bool) (nextBb : BasicBlockId)
    (hZero : isZeroCopyConst countOp elemSize = true) :
    evalMemCopyTerm body { bb with terminator := .copyNonOverlapping srcPtr dstPtr countOp elemSize reqAlignLog2 checkNonNullZero nextBb } frame mem =
    evalMemCopyTerm body { bb with terminator := .checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero nextBb } frame mem := by
  unfold evalMemCopyTerm
  dsimp
  cases hAlign : !Nat.ble reqAlignLog2 30 with
  | true => rfl
  | false =>
    dsimp
    cases isZeroCopyConst_evalUsizeOp body.locals frame.locals countOp elemSize hZero with
    | intro count hCount =>
      rw [hCount.1]
      dsimp
      cases hSrc : readPtrLocal body.locals frame.locals srcPtr false with
      | error k => rfl
      | ok pSrc =>
        dsimp
        cases hDst : readPtrLocal body.locals pSrc.snd dstPtr false with
        | error k => rfl
        | ok pDst =>
          dsimp
          unfold evalCopyNonOverlapping
          rw [hCount.2, hAlign]
          dsimp
          cases hA1 : checkPtrAlignMem mem pSrc.fst reqAlignLog2 with
          | error k => rfl
          | ok _ =>
            cases hA2 : checkPtrAlignMem mem pDst.fst reqAlignLog2 with
            | error k => rfl
            | ok _ =>
              dsimp
              cases hNull : checkNonNullZero && (isNullPtr pSrc.fst || isNullPtr pDst.fst) with
              | true => rfl
              | false => rfl

private theorem applyFoldGuardedZeroCopy_sound
    (bodyId : DefId) (bbIdx : BasicBlockId)
    (pSrc pMid : MemCopyProgram)
    (hApp : applyFoldGuardedZeroCopy bodyId bbIdx pSrc = some pMid) :
    FullSemanticEquivMemCopy pSrc pMid := by
  unfold applyFoldGuardedZeroCopy at hApp
  cases hBody : Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
  | none => rw [hBody] at hApp; cases hApp
  | some body =>
    rw [hBody] at hApp
    dsimp at hApp
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
    | none => rw [hBb] at hApp; cases hApp
    | some bb =>
      rw [hBb] at hApp
      dsimp at hApp
      cases hTerm : bb.terminator with
      | baseTerm _ | ptrOffsetInbounds _ _ _ _ _ | checkPtrPairAlign _ _ _ _ _ _
      | readLeUsize _ _ _ _ _ | writeLeUsize _ _ _ _ _ | readPtrLe8 _ _ _ _ | writePtrLe8 _ _ _ _
      | readBufRawByte _ _ _ _ _ | writeBufRawByte _ _ _ _ _ =>
        rw [hTerm] at hApp; cases hApp
      | copyNonOverlapping srcPtr dstPtr countOp elemSize reqAlignLog2 checkNonNullZero nextBb =>
        rw [hTerm] at hApp
        dsimp at hApp
        cases hZero : isZeroCopyConst countOp elemSize with
        | false => rw [hZero] at hApp; cases hApp
        | true =>
          rw [hZero] at hApp
          dsimp at hApp
          cases hSetBb : setElem? body.basicBlocks bbIdx
              { bb with
                terminator := MemCopyTerm.checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero nextBb } with
          | none => rw [hSetBb] at hApp; cases hApp
          | some bbs' =>
            rw [hSetBb] at hApp
            dsimp at hApp
            cases hSetB : setElem? pSrc.bodies bodyId { body with basicBlocks := bbs' } with
            | none => rw [hSetB] at hApp; cases hApp
            | some bodies' =>
              rw [hSetB] at hApp
              cases hApp
              have hStor : MemCopyBodyStorageEq body { body with basicBlocks := bbs' } := by
                refine ⟨rfl, rfl, (setElem?_isEmpty _ _ _ _ hSetBb).symm, rfl, rfl, ?_, ?_⟩
                · unfold memCopyStorageAnnotationsInBounds
                  dsimp
                  exact (all_setElem?_preserves _ body.basicBlocks bbIdx bb
                    { bb with terminator := MemCopyTerm.checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero nextBb }
                    bbs' hBb rfl hSetBb).symm
                · intro id
                  unfold memCopyHasStorageAnnotation
                  dsimp
                  exact (any_setElem?_preserves _ body.basicBlocks bbIdx bb
                    { bb with terminator := MemCopyTerm.checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero nextBb }
                    bbs' hBb rfl hSetBb).symm
              refine fullSemanticEquivMemCopy_of_step_sim pSrc
                { pSrc with bodies := bodies' } Eq ?_ ?_
              · intro q
                have hInit : initStateMemCopy pSrc q =
                    initStateMemCopy { pSrc with bodies := bodies' } q := by
                  unfold initStateMemCopy
                  dsimp
                  cases !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
                  | true => rfl
                  | false =>
                    dsimp
                    cases hEntry : Nat.beq pSrc.entryDefId bodyId with
                    | true =>
                      have heq := nat_beq_eq _ _ hEntry
                      subst heq
                      rw [hBody, getElem?_setElem?_eq _ _ _ _ hSetB]
                      exact memCopyBodyStorageEq_init hStor pSrc.entryDefId q
                    | false =>
                      have hne := nat_beq_false_ne hEntry
                      rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetB]
                refine ⟨fun _ => by rw [hInit], fun s₁ hs₁ => ⟨s₁, by rw [← hInit]; exact hs₁, rfl⟩⟩
              · intro s₁ s₂ hR
                subst hR
                have hStepEq : evalStepMemCopy pSrc 0 s₁ =
                    evalStepMemCopy { pSrc with bodies := bodies' } 0 s₁ := by
                  unfold evalStepMemCopy
                  cases s₁.frames with
                  | nil => rfl
                  | cons frame rest =>
                    cases rest with
                    | cons _ _ => rfl
                    | nil =>
                      dsimp
                      cases hDef : Nat.beq frame.defId bodyId with
                      | false =>
                        have hne := nat_beq_false_ne hDef
                        rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetB]
                      | true =>
                        have heqDef := nat_beq_eq _ _ hDef
                        subst heqDef
                        rw [hBody, getElem?_setElem?_eq _ _ _ _ hSetB]
                        dsimp
                        cases hBlk : Nat.beq frame.blockIdx bbIdx with
                        | false =>
                          have hne := nat_beq_false_ne hBlk
                          rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetBb]
                          cases Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
                          | none => rfl
                          | some bbOther =>
                            dsimp
                            cases Trusted.MirSemantics.getElem? bbOther.statements frame.stmtIdx with
                            | some stmtOther => dsimp; exact memCopyBodyStorageEq_evalStmt hStor frame s₁.mem stmtOther
                            | none =>
                              dsimp
                              cases Nat.beq frame.stmtIdx bbOther.statements.length with
                              | true => dsimp; exact memCopyBodyStorageEq_evalTerm hStor bbOther frame s₁.mem
                              | false => rfl
                        | true =>
                          have heqBlk := nat_beq_eq _ _ hBlk
                          subst heqBlk
                          rw [hBb, getElem?_setElem?_eq _ _ _ _ hSetBb]
                          dsimp
                          cases Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
                          | some stmtOther => exact memCopyBodyStorageEq_evalStmt hStor frame s₁.mem stmtOther
                          | none =>
                            cases Nat.beq frame.stmtIdx bb.statements.length with
                            | false => rfl
                            | true =>
                              have hEqTerm : evalMemCopyTerm body bb frame s₁.mem =
                                  evalMemCopyTerm body { bb with terminator := .copyNonOverlapping srcPtr dstPtr countOp elemSize reqAlignLog2 checkNonNullZero nextBb } frame s₁.mem := by
                                cases bb
                                dsimp at hTerm
                                subst hTerm
                                rfl
                              rw [hEqTerm, copyNonOverlapping_eq_checkPtrPairAlign_eval body bb frame s₁.mem
                                srcPtr dstPtr countOp elemSize reqAlignLog2 checkNonNullZero nextBb hZero]
                              exact memCopyBodyStorageEq_evalTerm hStor
                                { bb with terminator := MemCopyTerm.checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero nextBb }
                                frame s₁.mem
                refine ⟨fun s₁' h => ⟨s₁', by rw [← hStepEq]; exact h, rfl⟩,
                  fun out h => by rw [← hStepEq]; exact h,
                  fun k h => by rw [← hStepEq]; exact h⟩

private theorem foldZeroOffset_and_guardedZeroCopy_sound_bidirectional_iff_slice2 :
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (stmtIdx : Nat)
        (pSrc pTgt : MemCopyProgram),
      checkFoldZeroOffsetStmt bodyId bbIdx stmtIdx pSrc pTgt = true →
      FullSemanticEquivMemCopy pSrc pTgt) ∧
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (pSrc pTgt : MemCopyProgram),
      checkFoldZeroOffsetTerm bodyId bbIdx pSrc pTgt = true →
      FullSemanticEquivMemCopy pSrc pTgt) ∧
    (∀ (bodyId : DefId) (bbIdx : BasicBlockId) (pSrc pTgt : MemCopyProgram),
      checkFoldGuardedZeroCopy bodyId bbIdx pSrc pTgt = true →
      FullSemanticEquivMemCopy pSrc pTgt) := by
  refine ⟨?_, ?_, ?_⟩
  · intro bodyId bbIdx stmtIdx pSrc pTgt hChk
    unfold checkFoldZeroOffsetStmt at hChk
    cases hApp : applyFoldZeroOffsetStmt bodyId bbIdx stmtIdx pSrc with
    | none => rw [hApp] at hChk; cases hChk
    | some pMid =>
      rw [hApp] at hChk
      exact fullSemanticEquivMemCopy_trans
        (applyFoldZeroOffsetStmt_sound bodyId bbIdx stmtIdx pSrc pMid hApp)
        (memCopyProgramEq_semEquiv hChk)
  · intro bodyId bbIdx pSrc pTgt hChk
    unfold checkFoldZeroOffsetTerm at hChk
    cases hApp : applyFoldZeroOffsetTerm bodyId bbIdx pSrc with
    | none => rw [hApp] at hChk; cases hChk
    | some pMid =>
      rw [hApp] at hChk
      exact fullSemanticEquivMemCopy_trans
        (applyFoldZeroOffsetTerm_sound bodyId bbIdx pSrc pMid hApp)
        (memCopyProgramEq_semEquiv hChk)
  · intro bodyId bbIdx pSrc pTgt hChk
    unfold checkFoldGuardedZeroCopy at hChk
    cases hApp : applyFoldGuardedZeroCopy bodyId bbIdx pSrc with
    | none => rw [hApp] at hChk; cases hChk
    | some pMid =>
      rw [hApp] at hChk
      exact fullSemanticEquivMemCopy_trans
        (applyFoldGuardedZeroCopy_sound bodyId bbIdx pSrc pMid hApp)
        (memCopyProgramEq_semEquiv hChk)

