private theorem s4_any_mkStorageLiveRange (loc : Nat) :
    ∀ (start count : Nat),
      (mkStorageLiveRange start count).any (memCopyStmtHasStorageMarker loc) =
        (Nat.ble start loc && Nat.blt loc (start + count))
  | start, 0 => by
    cases hBle : Nat.ble start loc with
    | false => rfl
    | true =>
      have hF : Nat.blt loc (start + 0) = false := by
        cases hBlt : Nat.blt loc (start + 0) with
        | false => rfl
        | true =>
          rw [Nat.add_zero] at hBlt
          exact False.elim (s4_nat_lt_irrefl loc
            (Nat.lt_of_lt_of_le ((nat_blt_eq_lt _ _).mp hBlt) ((nat_ble_eq_le _ _).mp hBle)))
      rw [hF]; rfl
  | start, count + 1 => by
    change (Nat.beq start loc ||
        (mkStorageLiveRange (start + 1) count).any (memCopyStmtHasStorageMarker loc)) =
      (Nat.ble start loc && Nat.blt loc (start + (count + 1)))
    rw [s4_any_mkStorageLiveRange loc (start + 1) count]
    have hAssoc : start + 1 + count = start + (count + 1) := by
      rw [Nat.add_assoc, Nat.add_comm 1 count]
    rw [hAssoc]
    cases s4_nat_eq_or_ne start loc with
    | inl hEq =>
      rw [hEq, nat_beq_refl]
      have hT : (Nat.ble loc loc && Nat.blt loc (loc + (count + 1))) = true := by
        rw [(nat_ble_eq_le _ _).mpr (Nat.le_refl loc),
          (nat_blt_eq_lt _ _).mpr (Nat.lt_add_of_pos_right (Nat.zero_lt_succ count))]
        rfl
      rw [hT]; rfl
    | inr hEq =>
      rw [s4_nat_beq_false hEq]
      cases hBle : Nat.ble start loc with
      | false =>
        have hNot : ¬ start ≤ loc := fun h => by rw [(nat_ble_eq_le _ _).mpr h] at hBle; cases hBle
        have hBle2 : Nat.ble (start + 1) loc = false := by
          cases hB : Nat.ble (start + 1) loc with
          | false => rfl
          | true => exact False.elim (hNot (Nat.le_trans (Nat.le_succ start) ((nat_ble_eq_le _ _).mp hB)))
        rw [hBle2]; rfl
      | true =>
        have hLt : start < loc := Nat.lt_of_le_of_ne ((nat_ble_eq_le _ _).mp hBle) hEq
        rw [(nat_ble_eq_le _ _).mpr hLt]; rfl

private theorem s4_any_mkStorageDeadRange (loc : Nat) :
    ∀ (start count : Nat),
      (mkStorageDeadRange start count).any (memCopyStmtHasStorageMarker loc) =
