/-! ## Minimal Constructive Shims for `Trusted.MirAst` + `Trusted.MirSemantics` Scope -/

/-! ### Internal Sugar-Free Bridges to `Init` Arithmetic & `ite` -/

private theorem s0_nat_div_add_mod (a b : Nat) :
    b * Nat.div a b + Nat.mod a b = a :=
  Nat.div_add_mod a b

private theorem s0_nat_mod_lt (a : Nat) {b : Nat} (hb : 0 < b) :
    Nat.mod a b < b :=
  Nat.mod_lt a hb

private theorem s0_nat_mod_eq_of_lt {a b : Nat} (h : a < b) :
    Nat.mod a b = a :=
  Nat.mod_eq_of_lt h

private theorem s0_nat_mod_zero (a : Nat) : Nat.mod a 0 = a :=
  Nat.mod_zero a

private theorem s0_nat_div_eq_of_lt {a b : Nat} (h : a < b) :
    Nat.div a b = 0 :=
  Nat.div_eq_of_lt h

private theorem s0_nat_div_one (n : Nat) : Nat.div n 1 = n :=
  Nat.div_one n

private theorem s0_nat_div_div_eq_div_mul (a b c : Nat) :
    Nat.div (Nat.div a b) c = Nat.div a (b * c) :=
  Nat.div_div_eq_div_mul a b c

private theorem s0_nat_shiftLeft_eq (a b : Nat) :
    Nat.shiftLeft a b = a * Nat.pow 2 b :=
  Nat.shiftLeft_eq a b

private theorem s0_nat_shiftRight_eq_div_pow (m n : Nat) :
    Nat.shiftRight m n = Nat.div m (Nat.pow 2 n) :=
  Nat.shiftRight_eq_div_pow m n

private theorem s0_ite_pos {α : Type} {c : Prop} [d : Decidable c]
    (h : c) (a b : α) : (if c then a else b) = a := by
  cases d with
  | isTrue _ => rfl
  | isFalse hn => exact False.elim (hn h)

private theorem s0_ite_neg {α : Type} {c : Prop} [d : Decidable c]
    (h : ¬ c) (a b : α) : (if c then a else b) = b := by
  cases d with
  | isTrue hp => exact False.elim (h hp)
  | isFalse _ => rfl

/-! ### `Nat` Arithmetic, Order, Division, & Modulo -/

private theorem s0_nat_add_sub_cancel' {n m : Nat} (h : m ≤ n) :
    m + (n - m) = n := by
  rw [Nat.add_comm]
  exact Nat.sub_add_cancel h

private theorem s0_nat_sub_add_comm {n m k : Nat} (h : k ≤ n) :
    (n + m) - k = (n - k) + m := by
  have h1 : ((n + m) - k) + k = ((n - k) + m) + k := by
    rw [Nat.sub_add_cancel (Nat.le_trans h (Nat.le_add_right n m))]
    rw [Nat.add_assoc, Nat.add_comm m k, ← Nat.add_assoc, Nat.sub_add_cancel h]
  exact Nat.add_right_cancel h1

private theorem s0_nat_lt_of_add_lt_add_left :
    ∀ {k m n : Nat}, k + m < k + n → m < n
  | 0, m, n, h => by
    rw [Nat.zero_add, Nat.zero_add] at h
    exact h
  | k + 1, m, n, h => by
    rw [Nat.succ_add, Nat.succ_add] at h
    exact s0_nat_lt_of_add_lt_add_left (Nat.lt_of_succ_lt_succ h)

private theorem s0_nat_lt_of_add_lt_add_right {k m n : Nat} (h : k + n < m + n) :
    k < m := by
  rw [Nat.add_comm k n, Nat.add_comm m n] at h
  exact s0_nat_lt_of_add_lt_add_left h

private theorem s0_nat_add_lt_add_of_le_of_lt {a b c d : Nat}
    (hab : a ≤ b) (hcd : c < d) : a + c < b + d :=
  Nat.lt_of_le_of_lt (Nat.add_le_add_right hab c) (Nat.add_lt_add_left hcd b)

private theorem s0_nat_le_mul_of_pos_right {m : Nat} (n : Nat) (hm : 0 < m) :
    n ≤ n * m :=
  Nat.le_trans (Nat.le_of_eq (Nat.mul_one n).symm) (Nat.mul_le_mul_left n hm)

private theorem s0_nat_pow_add (a m : Nat) :
    ∀ n : Nat, Nat.pow a (m + n) = Nat.pow a m * Nat.pow a n
  | 0 => by
    rw [Nat.add_zero]
    change Nat.pow a m = Nat.pow a m * 1
    exact (Nat.mul_one _).symm
  | n + 1 => by
    rw [← Nat.add_assoc]
    change Nat.pow a (m + n) * a = Nat.pow a m * (Nat.pow a n * a)
    rw [s0_nat_pow_add a m n, Nat.mul_assoc]

private theorem s0_nat_pow_pos {b : Nat} (hb : 0 < b) :
    ∀ k : Nat, 0 < Nat.pow b k
  | 0 => Nat.zero_lt_one
  | k + 1 => Nat.mul_pos (s0_nat_pow_pos hb k) hb

private theorem s0_nat_zero_mul (x : Nat) : 0 * x = 0 := by
  rw [Nat.mul_comm]
  exact Nat.mul_zero x

private theorem s0_nat_div_mod_unique_aux {m q₁ r₁ q₂ r₂ : Nat}
    (hr₁ : r₁ < m) (hEq : m * q₁ + r₁ = m * q₂ + r₂) : ¬ (q₁ < q₂) := by
  intro hLt
  have hLeQ : q₁ + 1 ≤ q₂ := hLt
  have h1 : m * q₁ + r₁ < m * q₁ + m := Nat.add_lt_add_left hr₁ _
  have h2 : m * q₁ + m = m * (q₁ + 1) := by
    rw [Nat.mul_add, Nat.mul_one]
  have h3 : m * (q₁ + 1) ≤ m * q₂ := Nat.mul_le_mul_left m hLeQ
  have h4 : m * q₂ ≤ m * q₂ + r₂ := Nat.le_add_right _ _
  have hStrict : m * q₁ + r₁ < m * q₂ + r₂ :=
    Nat.lt_of_lt_of_le (by rw [← h2]; exact h1) (Nat.le_trans h3 h4)
  rw [hEq] at hStrict
  exact Nat.lt_irrefl _ hStrict

private theorem s0_nat_div_mod_unique {m q₁ r₁ q₂ r₂ : Nat}
    (hr₁ : r₁ < m) (hr₂ : r₂ < m) (hEq : m * q₁ + r₁ = m * q₂ + r₂) :
    q₁ = q₂ ∧ r₁ = r₂ := by
  have hQ : q₁ = q₂ := by
    cases Nat.lt_or_ge q₁ q₂ with
    | inl hLt => exact False.elim (s0_nat_div_mod_unique_aux hr₁ hEq hLt)
    | inr hGe =>
      cases Nat.eq_or_lt_of_le hGe with
      | inl hEqQ => exact hEqQ.symm
      | inr hGt => exact False.elim (s0_nat_div_mod_unique_aux hr₂ hEq.symm hGt)
  subst hQ
  exact ⟨rfl, Nat.add_left_cancel hEq⟩

private theorem s0_nat_mul_add_div {m : Nat} (hm : 0 < m) (x y : Nat) :
    Nat.div (m * x + y) m = x + Nat.div y m := by
  have hDivMod : m * (x + Nat.div y m) + Nat.mod y m =
      m * Nat.div (m * x + y) m + Nat.mod (m * x + y) m := by
    rw [Nat.mul_add, Nat.add_assoc, s0_nat_div_add_mod y m,
      s0_nat_div_add_mod (m * x + y) m]
  exact (s0_nat_div_mod_unique (s0_nat_mod_lt y hm) (s0_nat_mod_lt _ hm) hDivMod).1.symm

private theorem s0_nat_mul_add_mod (m x y : Nat) :
    Nat.mod (m * x + y) m = Nat.mod y m := by
  cases m with
  | zero =>
    rw [s0_nat_zero_mul, Nat.zero_add]
  | succ m0 =>
    have hm : 0 < m0 + 1 := Nat.succ_pos m0
    have hDivMod : (m0 + 1) * (x + Nat.div y (m0 + 1)) + Nat.mod y (m0 + 1) =
        (m0 + 1) * Nat.div ((m0 + 1) * x + y) (m0 + 1) +
          Nat.mod ((m0 + 1) * x + y) (m0 + 1) := by
      rw [Nat.mul_add, Nat.add_assoc, s0_nat_div_add_mod y (m0 + 1),
        s0_nat_div_add_mod ((m0 + 1) * x + y) (m0 + 1)]
    exact (s0_nat_div_mod_unique (s0_nat_mod_lt y hm) (s0_nat_mod_lt _ hm) hDivMod).2.symm

private theorem s0_nat_mod_mod (a n : Nat) :
    Nat.mod (Nat.mod a n) n = Nat.mod a n := by
  cases n with
  | zero =>
    rw [s0_nat_mod_zero, s0_nat_mod_zero]
  | succ n0 =>
    exact s0_nat_mod_eq_of_lt (s0_nat_mod_lt a (Nat.succ_pos n0))

private theorem s0_nat_add_mod (a b n : Nat) :
    Nat.mod (a + b) n = Nat.mod (Nat.mod a n + Nat.mod b n) n := by
  have hDecomp : a + b =
      n * (Nat.div a n + Nat.div b n) + (Nat.mod a n + Nat.mod b n) := by
    rw [Nat.mul_add, Nat.add_assoc]
    rw [← Nat.add_assoc (n * Nat.div b n) (Nat.mod a n) (Nat.mod b n)]
    rw [Nat.add_comm (n * Nat.div b n) (Nat.mod a n)]
    rw [Nat.add_assoc (Nat.mod a n) (n * Nat.div b n) (Nat.mod b n)]
    rw [s0_nat_div_add_mod b n, ← Nat.add_assoc, s0_nat_div_add_mod a n]
  rw [hDecomp]
  exact s0_nat_mul_add_mod n (Nat.div a n + Nat.div b n) (Nat.mod a n + Nat.mod b n)

/-! ### `Nat` Bitwise, Shift, & `testBit` Helpers -/

private theorem s0_nat_zero_or (x : Nat) : Nat.lor 0 x = x := by
  unfold Nat.lor
  rw [Nat.bitwise.eq_def, s0_ite_pos rfl]
  rfl

private theorem s0_nat_bitwise_zero_left (f : Bool → Bool → Bool) (m : Nat) :
    Nat.bitwise f 0 m = if f false true = true then m else 0 := by
  rw [Nat.bitwise.eq_def, s0_ite_pos rfl]

private theorem s0_nat_bitwise_zero_right (f : Bool → Bool → Bool) (n : Nat)
    (_hZero : f false false = false) :
    Nat.bitwise f n 0 = if f true false = true then n else 0 := by
  cases n with
  | zero =>
    rw [s0_nat_bitwise_zero_left]
    cases hFT : f false true <;> cases hTF : f true false <;> rfl
  | succ n0 =>
    rw [Nat.bitwise.eq_def, s0_ite_neg (Nat.succ_ne_zero n0), s0_ite_pos rfl]

private theorem s0_nat_bitwise_succ (f : Bool → Bool → Bool) (n m : Nat)
    (hn : n ≠ 0) (hm : m ≠ 0) :
    Nat.bitwise f n m =
      if f (decide (Nat.mod n 2 = 1)) (decide (Nat.mod m 2 = 1)) = true then
        Nat.bitwise f (Nat.div n 2) (Nat.div m 2) +
          Nat.bitwise f (Nat.div n 2) (Nat.div m 2) + 1
      else
        Nat.bitwise f (Nat.div n 2) (Nat.div m 2) +
          Nat.bitwise f (Nat.div n 2) (Nat.div m 2) := by
  rw [Nat.bitwise.eq_def, s0_ite_neg hn, s0_ite_neg hm]
  rfl

private theorem s0_nat_land_one_eq (k : Nat) :
    Nat.land 1 k = if decide (Nat.mod k 2 = 1) = true then 1 else 0 := by
  cases k with
  | zero =>
    unfold Nat.land
    rw [s0_nat_bitwise_zero_right _ 1 rfl]
    rfl
  | succ k0 =>
    unfold Nat.land
    rw [s0_nat_bitwise_succ Bool.and 1 (k0 + 1)
      (Nat.succ_ne_zero 0) (Nat.succ_ne_zero k0)]
    have hDiv1 : Nat.div 1 2 = 0 := s0_nat_div_eq_of_lt (Nat.succ_lt_succ Nat.zero_lt_one)
    have hMod1 : decide (Nat.mod 1 2 = 1) = true := rfl
    rw [hDiv1, hMod1, s0_nat_bitwise_zero_left]
    cases hMod : decide (Nat.mod (k0 + 1) 2 = 1) <;> rfl

private theorem s0_nat_testBit_eq_decide (m i : Nat) :
    m.testBit i = decide (Nat.mod (Nat.div m (Nat.pow 2 i)) 2 = 1) := by
  unfold Nat.testBit
  change (Nat.land 1 (Nat.shiftRight m i) != 0) = _
  rw [s0_nat_shiftRight_eq_div_pow m i, s0_nat_land_one_eq]
  cases decide (Nat.mod (Nat.div m (Nat.pow 2 i)) 2 = 1) <;> rfl

private theorem s0_nat_zero_testBit (i : Nat) : Nat.testBit 0 i = false := by
  rw [s0_nat_testBit_eq_decide]
  have hDiv : Nat.div 0 (Nat.pow 2 i) = 0 :=
    s0_nat_div_eq_of_lt (s0_nat_pow_pos (Nat.succ_pos 1) i)
  rw [hDiv]
  rfl

private theorem s0_nat_testBit_zero (x : Nat) :
    x.testBit 0 = decide (Nat.mod x 2 = 1) := by
  rw [s0_nat_testBit_eq_decide]
  change decide (Nat.mod (Nat.div x 1) 2 = 1) = decide (Nat.mod x 2 = 1)
  rw [s0_nat_div_one]

private theorem s0_nat_testBit_lt_two_pow {x i : Nat} (h : x < Nat.pow 2 i) :
    x.testBit i = false := by
  rw [s0_nat_testBit_eq_decide, s0_nat_div_eq_of_lt h]
  rfl

private theorem s0_nat_testBit_shiftRight {i j : Nat} (x : Nat) :
    (Nat.shiftRight x i).testBit j = x.testBit (i + j) := by
  rw [s0_nat_testBit_eq_decide, s0_nat_testBit_eq_decide]
  rw [s0_nat_shiftRight_eq_div_pow, s0_nat_div_div_eq_div_mul, s0_nat_pow_add]

private theorem s0_nat_testBit_shiftLeft {i j : Nat} (x : Nat) :
    (Nat.shiftLeft x i).testBit j = (decide (i ≤ j) && x.testBit (j - i)) := by
  rw [s0_nat_testBit_eq_decide, s0_nat_shiftLeft_eq]
  cases Nat.lt_or_ge j i with
  | inl hLt =>
    have hPos : 0 < i - j := Nat.sub_pos_of_lt hLt
    have hDecomp : i = j + ((i - j - 1) + 1) := by
      rw [Nat.sub_add_cancel hPos]
      exact (s0_nat_add_sub_cancel' (Nat.le_of_lt hLt)).symm
    have hPow : Nat.pow 2 i = Nat.pow 2 j * (Nat.pow 2 (i - j - 1) * 2) := by
      change Nat.pow 2 i = Nat.pow 2 j * Nat.pow 2 (i - j - 1 + 1)
      rw [← s0_nat_pow_add, ← hDecomp]
    have hProd : x * Nat.pow 2 i =
        Nat.pow 2 j * (2 * (x * Nat.pow 2 (i - j - 1))) + 0 := by
      rw [hPow, Nat.add_zero, Nat.mul_comm (Nat.pow 2 (i - j - 1)) 2]
      rw [← Nat.mul_assoc x (Nat.pow 2 j) _, Nat.mul_comm x (Nat.pow 2 j)]
      rw [Nat.mul_assoc (Nat.pow 2 j) x _, Nat.mul_comm x (2 * Nat.pow 2 (i - j - 1))]
      rw [Nat.mul_assoc 2 (Nat.pow 2 (i - j - 1)) x, Nat.mul_comm (Nat.pow 2 (i - j - 1)) x]
    have hDiv : Nat.div (x * Nat.pow 2 i) (Nat.pow 2 j) =
        2 * (x * Nat.pow 2 (i - j - 1)) := by
      rw [hProd, s0_nat_mul_add_div (s0_nat_pow_pos (Nat.succ_pos 1) j)]
      have hZ : Nat.div 0 (Nat.pow 2 j) = 0 :=
        s0_nat_div_eq_of_lt (s0_nat_pow_pos (Nat.succ_pos 1) j)
      rw [hZ, Nat.add_zero]
    rw [hDiv]
    have hMod2 : Nat.mod (2 * (x * Nat.pow 2 (i - j - 1)) + 0) 2 = Nat.mod 0 2 :=
      s0_nat_mul_add_mod 2 (x * Nat.pow 2 (i - j - 1)) 0
    rw [Nat.add_zero] at hMod2
    rw [hMod2]
    have hDecF : decide (i ≤ j) = false := decide_eq_false (Nat.not_le_of_gt hLt)
    rw [hDecF]
    rfl
  | inr hGe =>
    have hSumJ : j = i + (j - i) := (s0_nat_add_sub_cancel' hGe).symm
    have hPow : Nat.pow 2 j = Nat.pow 2 i * Nat.pow 2 (j - i) := by
      rw [← s0_nat_pow_add, ← hSumJ]
    have hDivI : Nat.div (x * Nat.pow 2 i) (Nat.pow 2 i) = x := by
      rw [Nat.mul_comm x (Nat.pow 2 i), ← Nat.add_zero (Nat.pow 2 i * x),
        s0_nat_mul_add_div (s0_nat_pow_pos (Nat.succ_pos 1) i)]
      have hZ : Nat.div 0 (Nat.pow 2 i) = 0 :=
        s0_nat_div_eq_of_lt (s0_nat_pow_pos (Nat.succ_pos 1) i)
      rw [hZ, Nat.add_zero]
    rw [hPow, ← s0_nat_div_div_eq_div_mul, hDivI]
    have hDecT : decide (i ≤ j) = true := decide_eq_true hGe
    rw [hDecT, Bool.true_and, s0_nat_testBit_eq_decide]

private theorem s0_nat_testBit_succ (n i : Nat) :
    n.testBit (i + 1) = (Nat.div n 2).testBit i := by
  have h := s0_nat_testBit_shiftRight (i := 1) (j := i) n
  rw [s0_nat_shiftRight_eq_div_pow] at h
  change (Nat.div n 2).testBit i = n.testBit (1 + i) at h
  rw [Nat.add_comm 1 i] at h
  exact h.symm

private theorem s0_nat_mod2_eq_1_of_ne_zero (b : Nat) (hLt : b < 2)
    (hNe : b ≠ 0) : b = 1 := by
  cases b with
  | zero => exact False.elim (hNe rfl)
  | succ b0 =>
    cases b0 with
    | zero => rfl
    | succ b1 =>
      have hBad := Nat.lt_of_succ_lt_succ (Nat.lt_of_succ_lt_succ hLt)
      exact False.elim (Nat.not_lt_zero b1 hBad)

private theorem s0_nat_testBit_two_mul_add (q r : Nat) (hr : r < 2) :
    (q + q + r).testBit 0 = decide (r = 1) := by
  rw [s0_nat_testBit_zero]
  have hMul : q + q = 2 * q := by
    rw [Nat.mul_comm, Nat.mul_two]
  rw [hMul, s0_nat_mul_add_mod, s0_nat_mod_eq_of_lt hr]

private theorem s0_nat_div2_two_mul_add (q r : Nat) (hr : r < 2) :
    Nat.div (q + q + r) 2 = q := by
  have hMul : q + q = 2 * q := by
    rw [Nat.mul_comm, Nat.mul_two]
  rw [hMul, s0_nat_mul_add_div (Nat.succ_pos 1), s0_nat_div_eq_of_lt hr, Nat.add_zero]

private theorem s0_nat_testBit_bitwise (f : Bool → Bool → Bool) (hFF : f false false = false) :
    ∀ (i n m : Nat), (Nat.bitwise f n m).testBit i = f (n.testBit i) (m.testBit i)
  | 0, n, m => by
    cases n with
    | zero =>
      rw [s0_nat_bitwise_zero_left, s0_nat_zero_testBit]
      cases hFT : f false true with
      | true =>
        dsimp
        cases m.testBit 0
        · exact hFF.symm
        · exact hFT.symm
      | false =>
        dsimp
        rw [s0_nat_zero_testBit]
        cases m.testBit 0
        · exact hFF.symm
        · exact hFT.symm
    | succ n0 =>
      cases m with
      | zero =>
        rw [s0_nat_bitwise_zero_right f (n0 + 1) hFF, s0_nat_zero_testBit]
        cases hTF : f true false with
        | true =>
          dsimp
          cases (n0 + 1).testBit 0
          · exact hFF.symm
          · exact hTF.symm
        | false =>
          dsimp
          rw [s0_nat_zero_testBit]
          cases (n0 + 1).testBit 0
          · exact hFF.symm
          · exact hTF.symm
      | succ m0 =>
        rw [s0_nat_bitwise_succ f (n0 + 1) (m0 + 1)
          (Nat.succ_ne_zero n0) (Nat.succ_ne_zero m0)]
        rw [s0_nat_testBit_zero, s0_nat_testBit_zero]
        cases hCond : f (decide (Nat.mod (n0 + 1) 2 = 1))
            (decide (Nat.mod (m0 + 1) 2 = 1)) with
        | true =>
          dsimp
          rw [← s0_nat_testBit_zero
            (Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) +
              Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) + 1)]
          rw [s0_nat_testBit_two_mul_add _ 1 (Nat.succ_lt_succ Nat.zero_lt_one)]
          rw [s0_nat_testBit_zero (m0 + 1), hCond]
          rfl
        | false =>
          dsimp
          have h0 : Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) +
              Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) =
              Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) +
              Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) + 0 :=
            (Nat.add_zero _).symm
          rw [← s0_nat_testBit_zero
            (Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) +
              Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2))]
          rw [h0, s0_nat_testBit_two_mul_add _ 0 (Nat.succ_pos 1)]
          rw [s0_nat_testBit_zero (m0 + 1), hCond]
          rfl
  | i + 1, n, m => by
    cases n with
    | zero =>
      rw [s0_nat_bitwise_zero_left, s0_nat_zero_testBit]
      cases hFT : f false true with
      | true =>
        dsimp
        cases m.testBit (i + 1)
        · exact hFF.symm
        · exact hFT.symm
      | false =>
        dsimp
        rw [s0_nat_zero_testBit]
        cases m.testBit (i + 1)
        · exact hFF.symm
        · exact hFT.symm
    | succ n0 =>
      cases m with
      | zero =>
        rw [s0_nat_bitwise_zero_right f (n0 + 1) hFF, s0_nat_zero_testBit]
        cases hTF : f true false with
        | true =>
          dsimp
          cases (n0 + 1).testBit (i + 1)
          · exact hFF.symm
          · exact hTF.symm
        | false =>
          dsimp
          rw [s0_nat_zero_testBit]
          cases (n0 + 1).testBit (i + 1)
          · exact hFF.symm
          · exact hTF.symm
      | succ m0 =>
        rw [s0_nat_bitwise_succ f (n0 + 1) (m0 + 1)
          (Nat.succ_ne_zero n0) (Nat.succ_ne_zero m0)]
        rw [s0_nat_testBit_succ (n0 + 1) i, s0_nat_testBit_succ (m0 + 1) i]
        cases hCond : f (decide (Nat.mod (n0 + 1) 2 = 1))
            (decide (Nat.mod (m0 + 1) 2 = 1)) with
        | true =>
          dsimp
          rw [s0_nat_testBit_succ _ i,
            s0_nat_div2_two_mul_add _ 1 (Nat.succ_lt_succ Nat.zero_lt_one)]
          exact s0_nat_testBit_bitwise f hFF i _ _
        | false =>
          dsimp
          have h0 : Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) +
              Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) =
              Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) +
              Nat.bitwise f (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) + 0 :=
            (Nat.add_zero _).symm
          rw [h0, s0_nat_testBit_succ _ i, s0_nat_div2_two_mul_add _ 0 (Nat.succ_pos 1)]
          exact s0_nat_testBit_bitwise f hFF i _ _

private theorem s0_nat_testBit_or (x y i : Nat) :
    (Nat.lor x y).testBit i = (x.testBit i || y.testBit i) := by
  unfold Nat.lor
  exact s0_nat_testBit_bitwise Bool.or rfl i x y

private theorem s0_nat_testBit_and (x y i : Nat) :
    (Nat.land x y).testBit i = (x.testBit i && y.testBit i) := by
  unfold Nat.land
  exact s0_nat_testBit_bitwise Bool.and rfl i x y

private theorem s0_nat_lt_two_pow_self : ∀ n : Nat, n < Nat.pow 2 n
  | 0 => Nat.zero_lt_one
  | n + 1 => by
    have ih := s0_nat_lt_two_pow_self n
    have hPow : Nat.pow 2 (n + 1) = Nat.pow 2 n + Nat.pow 2 n := by
      change Nat.pow 2 n * 2 = Nat.pow 2 n + Nat.pow 2 n
      exact Nat.mul_two _
    rw [hPow]
    exact Nat.lt_of_le_of_lt ih
      (Nat.lt_add_of_pos_right (s0_nat_pow_pos (Nat.succ_pos 1) n))

private theorem s0_nat_div2_lt_pow {x k : Nat} (hx : x < Nat.pow 2 (k + 1)) :
    Nat.div x 2 < Nat.pow 2 k := by
  have hPow : Nat.pow 2 (k + 1) = 2 * Nat.pow 2 k := by
    change Nat.pow 2 k * 2 = 2 * Nat.pow 2 k
    exact Nat.mul_comm _ _
  rw [hPow] at hx
  apply Nat.lt_of_not_le
  intro hGe
  have h1 : 2 * Nat.pow 2 k ≤ 2 * Nat.div x 2 := Nat.mul_le_mul_left 2 hGe
  have h2 : 2 * Nat.div x 2 ≤ 2 * Nat.div x 2 + Nat.mod x 2 := Nat.le_add_right _ _
  rw [s0_nat_div_add_mod x 2] at h2
  exact Nat.not_lt_of_le (Nat.le_trans h1 h2) hx

private theorem s0_nat_eq_of_testBit_eq_bound :
    ∀ (k x y : Nat),
      x < Nat.pow 2 k → y < Nat.pow 2 k →
      (∀ i : Nat, x.testBit i = y.testBit i) → x = y
  | 0, x, y, hx, hy, _ => by
    have hx0 : x = 0 := Nat.lt_one_iff.mp hx
    have hy0 : y = 0 := Nat.lt_one_iff.mp hy
    rw [hx0, hy0]
  | k + 1, x, y, hx, hy, hBits => by
    have hDivEq : Nat.div x 2 = Nat.div y 2 := by
      apply s0_nat_eq_of_testBit_eq_bound k (Nat.div x 2) (Nat.div y 2)
        (s0_nat_div2_lt_pow hx) (s0_nat_div2_lt_pow hy)
      intro i
      rw [← s0_nat_testBit_succ x i, ← s0_nat_testBit_succ y i]
      exact hBits (i + 1)
    have hB0 := hBits 0
    rw [s0_nat_testBit_zero, s0_nat_testBit_zero] at hB0
    have hModX := s0_nat_mod_lt x (Nat.succ_pos 1)
    have hModY := s0_nat_mod_lt y (Nat.succ_pos 1)
    have hModEq : Nat.mod x 2 = Nat.mod y 2 := by
      cases hX : Nat.mod x 2 with
      | zero =>
        rw [hX] at hB0
        have hF : decide (Nat.mod y 2 = 1) = false := hB0.symm
        cases hY : Nat.mod y 2 with
        | zero => rfl
        | succ y0 =>
          have hY1 : Nat.mod y 2 = 1 :=
            s0_nat_mod2_eq_1_of_ne_zero _ hModY (by rw [hY]; exact Nat.succ_ne_zero y0)
          rw [hY1] at hF
          cases hF
      | succ x0 =>
        have hX1 : Nat.mod x 2 = 1 :=
          s0_nat_mod2_eq_1_of_ne_zero _ hModX (by rw [hX]; exact Nat.succ_ne_zero x0)
        rw [hX1] at hB0
        have hT : decide (Nat.mod y 2 = 1) = true := hB0.symm
        cases hY : Nat.mod y 2 with
        | zero => rw [hY] at hT; cases hT
        | succ y0 =>
          have hY1 : Nat.mod y 2 = 1 :=
            s0_nat_mod2_eq_1_of_ne_zero _ hModY (by rw [hY]; exact Nat.succ_ne_zero y0)
          rw [← hX, ← hY, hX1, hY1]
    rw [← s0_nat_div_add_mod x 2, ← s0_nat_div_add_mod y 2, hDivEq, hModEq]

private theorem s0_nat_eq_of_testBit_eq {x y : Nat}
    (h : ∀ i : Nat, x.testBit i = y.testBit i) : x = y := by
  have hx : x < Nat.pow 2 (x + y) :=
    Nat.lt_of_lt_of_le (s0_nat_lt_two_pow_self x)
      (by
        cases y with
        | zero => rw [Nat.add_zero]; exact Nat.le_refl _
        | succ y0 =>
          rw [s0_nat_pow_add]
          exact s0_nat_le_mul_of_pos_right _ (s0_nat_pow_pos (Nat.succ_pos 1) _))
  have hy : y < Nat.pow 2 (x + y) :=
    Nat.lt_of_lt_of_le (s0_nat_lt_two_pow_self y)
      (by
        rw [Nat.add_comm, s0_nat_pow_add]
        exact s0_nat_le_mul_of_pos_right _ (s0_nat_pow_pos (Nat.succ_pos 1) _))
  exact s0_nat_eq_of_testBit_eq_bound (x + y) x y hx hy h

private theorem s0_nat_or_lt_two_pow :
    ∀ {x y n : Nat}, x < Nat.pow 2 n → y < Nat.pow 2 n → Nat.lor x y < Nat.pow 2 n
  | x, y, 0, hx, hy => by
    have hx0 : x = 0 := Nat.lt_one_iff.mp hx
    have hy0 : y = 0 := Nat.lt_one_iff.mp hy
    rw [hx0, hy0, s0_nat_zero_or]
    exact Nat.zero_lt_one
  | x, y, n + 1, hx, hy => by
    cases x with
    | zero => rw [s0_nat_zero_or]; exact hy
    | succ x0 =>
      cases y with
      | zero =>
        unfold Nat.lor
        rw [s0_nat_bitwise_zero_right _ (x0 + 1) rfl]
        exact hx
      | succ y0 =>
        unfold Nat.lor
        rw [s0_nat_bitwise_succ Bool.or (x0 + 1) (y0 + 1)
          (Nat.succ_ne_zero x0) (Nat.succ_ne_zero y0)]
        have ih := s0_nat_or_lt_two_pow (s0_nat_div2_lt_pow hx) (s0_nat_div2_lt_pow hy)
        have hPow : Nat.pow 2 (n + 1) = Nat.pow 2 n + Nat.pow 2 n := by
          change Nat.pow 2 n * 2 = Nat.pow 2 n + Nat.pow 2 n
          exact Nat.mul_two _
        cases hCond : decide (Nat.mod (x0 + 1) 2 = 1) ||
            decide (Nat.mod (y0 + 1) 2 = 1) with
        | true =>
          dsimp
          rw [hPow]
          have hLe : Nat.bitwise Bool.or (Nat.div (x0 + 1) 2) (Nat.div (y0 + 1) 2) + 1 ≤
              Nat.pow 2 n := ih
          change Nat.bitwise Bool.or (Nat.div (x0 + 1) 2) (Nat.div (y0 + 1) 2) +
            Nat.bitwise Bool.or (Nat.div (x0 + 1) 2) (Nat.div (y0 + 1) 2) + 1 <
            Nat.pow 2 n + Nat.pow 2 n
          rw [Nat.add_assoc (Nat.bitwise Bool.or (Nat.div (x0 + 1) 2) (Nat.div (y0 + 1) 2)) _ 1]
          rw [Nat.add_comm (Nat.bitwise Bool.or (Nat.div (x0 + 1) 2) (Nat.div (y0 + 1) 2))
            (Nat.bitwise Bool.or (Nat.div (x0 + 1) 2) (Nat.div (y0 + 1) 2) + 1)]
          exact s0_nat_add_lt_add_of_le_of_lt hLe ih
        | false =>
          dsimp
          rw [hPow]
          exact s0_nat_add_lt_add_of_le_of_lt (Nat.le_of_lt ih) ih

private theorem s0_nat_div2_le_of_le_succ {n k : Nat} (_hn : n ≠ 0) (hle : n ≤ k + 1) :
    Nat.div n 2 ≤ k := by
  have hMod : 0 < Nat.div n 2 ∨ Nat.div n 2 = 0 := by
    cases Nat.div n 2 with
    | zero => exact Or.inr rfl
    | succ d => exact Or.inl (Nat.succ_pos d)
  cases hMod with
  | inr hZ => rw [hZ]; exact Nat.zero_le k
  | inl hPos =>
    have h1 : Nat.div n 2 < Nat.div n 2 + Nat.div n 2 := Nat.lt_add_of_pos_right hPos
    have h2 : Nat.div n 2 + Nat.div n 2 ≤ 2 * Nat.div n 2 + Nat.mod n 2 := by
      rw [← Nat.mul_two, Nat.mul_comm (Nat.div n 2) 2]
      exact Nat.le_add_right _ _
    rw [s0_nat_div_add_mod n 2] at h2
    exact Nat.le_of_lt_succ (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le h1 h2) hle)

private theorem s0_nat_and_le_left_bound :
    ∀ (k n m : Nat), n ≤ k → Nat.land n m ≤ n
  | _, 0, m, _ => by
    unfold Nat.land
    rw [s0_nat_bitwise_zero_left]
    exact Nat.le_refl 0
  | 0, n + 1, _, hle => False.elim (Nat.not_lt_zero n hle)
  | k + 1, n0 + 1, m, hle => by
    cases m with
    | zero =>
      unfold Nat.land
      rw [s0_nat_bitwise_zero_right _ (n0 + 1) rfl]
      exact Nat.zero_le _
    | succ m0 =>
      unfold Nat.land
      rw [s0_nat_bitwise_succ Bool.and (n0 + 1) (m0 + 1)
        (Nat.succ_ne_zero n0) (Nat.succ_ne_zero m0)]
      have ih := s0_nat_and_le_left_bound k (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2)
        (s0_nat_div2_le_of_le_succ (Nat.succ_ne_zero n0) hle)
      have hTwo : Nat.bitwise Bool.and (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) +
            Nat.bitwise Bool.and (Nat.div (n0 + 1) 2) (Nat.div (m0 + 1) 2) ≤
          2 * Nat.div (n0 + 1) 2 := by
        rw [← Nat.mul_two, Nat.mul_comm _ 2]
        exact Nat.mul_le_mul_left 2 ih
      cases hCond : decide (Nat.mod (n0 + 1) 2 = 1) &&
          decide (Nat.mod (m0 + 1) 2 = 1) with
      | false =>
        dsimp
        have hDecomp : 2 * Nat.div (n0 + 1) 2 ≤ n0 + 1 := by
          have hBase := Nat.le_add_right (2 * Nat.div (n0 + 1) 2) (Nat.mod (n0 + 1) 2)
          rw [s0_nat_div_add_mod (n0 + 1) 2] at hBase
          exact hBase
        exact Nat.le_trans hTwo hDecomp
      | true =>
        dsimp
        have hModN : decide (Nat.mod (n0 + 1) 2 = 1) = true := by
          cases hX : decide (Nat.mod (n0 + 1) 2 = 1) with
          | true => rfl
          | false => rw [hX, Bool.false_and] at hCond; cases hCond
        have hModEq : Nat.mod (n0 + 1) 2 = 1 := of_decide_eq_true hModN
        have hDecomp : 2 * Nat.div (n0 + 1) 2 + 1 = n0 + 1 := by
          have hSum := s0_nat_div_add_mod (n0 + 1) 2
          rw [hModEq] at hSum
          exact hSum
        exact Nat.le_trans (Nat.add_le_add_right hTwo 1) (Nat.le_of_eq hDecomp)

private theorem s0_nat_and_le_left {n m : Nat} : Nat.land n m ≤ n :=
  s0_nat_and_le_left_bound n n m (Nat.le_refl n)

private theorem s0_nat_pow_two_sub_one_eq (n : Nat) :
    Nat.pow 2 (n + 1) - 1 = (Nat.pow 2 n - 1) + (Nat.pow 2 n - 1) + 1 := by
  have hPos : 1 ≤ Nat.pow 2 n := s0_nat_pow_pos (Nat.succ_pos 1) n
  have hDecomp : Nat.pow 2 n = (Nat.pow 2 n - 1) + 1 := (Nat.sub_add_cancel hPos).symm
  have hPow : Nat.pow 2 (n + 1) = Nat.pow 2 n + Nat.pow 2 n := by
    change Nat.pow 2 n * 2 = Nat.pow 2 n + Nat.pow 2 n
    exact Nat.mul_two _
  rw [hPow, hDecomp]
  let A := Nat.pow 2 n - 1
  change (A + 1) + (A + 1) - 1 = A + A + 1
  rw [← Nat.add_assoc (A + 1) A 1, Nat.add_sub_cancel,
    Nat.add_assoc A 1 A, Nat.add_comm 1 A, ← Nat.add_assoc A A 1]

private theorem s0_nat_pow_two_sub_one_testBit :
    ∀ (n i : Nat), (Nat.pow 2 n - 1).testBit i = decide (i < n)
  | 0, i => by
    change (0 : Nat).testBit i = decide (i < 0)
    rw [s0_nat_zero_testBit]
    have hNot : ¬ (i < 0) := Nat.not_lt_zero i
    rw [decide_eq_false hNot]
  | n + 1, 0 => by
    rw [s0_nat_pow_two_sub_one_eq, s0_nat_testBit_two_mul_add _ 1 (Nat.succ_lt_succ Nat.zero_lt_one)]
    have hLt : 0 < n + 1 := Nat.succ_pos n
    rw [decide_eq_true hLt]
    rfl
  | n + 1, i + 1 => by
    rw [s0_nat_pow_two_sub_one_eq, s0_nat_testBit_succ,
      s0_nat_div2_two_mul_add _ 1 (Nat.succ_lt_succ Nat.zero_lt_one),
      s0_nat_pow_two_sub_one_testBit n i]
    cases hDec : Nat.blt i n with
    | true =>
      have hLt : i < n := Nat.le_of_ble_eq_true hDec
      rw [decide_eq_true hLt, decide_eq_true (Nat.succ_lt_succ hLt)]
    | false =>
      have hNot : ¬ (i < n) := by
        intro hLt
        have hT : Nat.blt i n = true := Nat.ble_eq_true_of_le hLt
        rw [hT] at hDec
        cases hDec
      have hNotS : ¬ (i + 1 < n + 1) := fun h => hNot (Nat.lt_of_succ_lt_succ h)
      rw [decide_eq_false hNot, decide_eq_false hNotS]

private theorem s0_nat_mod_pow_two_testBit_lt (x n i : Nat) (hLt : i < n) :
    (Nat.mod x (Nat.pow 2 n)).testBit i = x.testBit i := by
  have hDiffPos : 0 < n - i := Nat.sub_pos_of_lt hLt
  let k := n - i - 1
  have hDecompN : n = i + (k + 1) := by
    have hk : k + 1 = n - i := Nat.sub_add_cancel hDiffPos
    rw [hk]
    exact (s0_nat_add_sub_cancel' (Nat.le_of_lt hLt)).symm
  let P := Nat.pow 2 i
  let Q := Nat.pow 2 k
  have hPowN : Nat.pow 2 n = P * (2 * Q) := by
    rw [hDecompN, s0_nat_pow_add]
    change P * (Q * 2) = P * (2 * Q)
    rw [Nat.mul_comm Q 2]
  have hXDecomp :
      x = P * (2 * (Q * Nat.div x (Nat.pow 2 n))) + Nat.mod x (Nat.pow 2 n) := by
    have h1 : P * (2 * (Q * Nat.div x (Nat.pow 2 n))) =
        Nat.pow 2 n * Nat.div x (Nat.pow 2 n) := by
      rw [← Nat.mul_assoc 2 Q (Nat.div x (Nat.pow 2 n)),
        ← Nat.mul_assoc P (2 * Q) (Nat.div x (Nat.pow 2 n)), ← hPowN]
    rw [h1, s0_nat_div_add_mod]
  have hDivP : Nat.div x P =
      2 * (Q * Nat.div x (Nat.pow 2 n)) + Nat.div (Nat.mod x (Nat.pow 2 n)) P := by
    have hS := s0_nat_mul_add_div (s0_nat_pow_pos (Nat.succ_pos 1) i)
      (2 * (Q * Nat.div x (Nat.pow 2 n))) (Nat.mod x (Nat.pow 2 n))
    rw [← hXDecomp] at hS
    exact hS
  rw [s0_nat_testBit_eq_decide, s0_nat_testBit_eq_decide]
  change decide (Nat.mod (Nat.div (Nat.mod x (Nat.pow 2 n)) P) 2 = 1) =
    decide (Nat.mod (Nat.div x P) 2 = 1)
  rw [hDivP, s0_nat_mul_add_mod]

private theorem s0_nat_and_two_pow_sub_one_eq_mod (x n : Nat) :
    Nat.land x (Nat.pow 2 n - 1) = Nat.mod x (Nat.pow 2 n) := by
  apply s0_nat_eq_of_testBit_eq
  intro i
  rw [s0_nat_testBit_and, s0_nat_pow_two_sub_one_testBit]
  cases Nat.lt_or_ge i n with
  | inl hLt =>
    rw [decide_eq_true hLt, Bool.and_true, s0_nat_mod_pow_two_testBit_lt x n i hLt]
  | inr hGe =>
    have hNot : ¬ (i < n) := Nat.not_lt_of_ge hGe
    rw [decide_eq_false hNot, Bool.and_false]
    have hPowLe : Nat.pow 2 n ≤ Nat.pow 2 i := by
      have hSum : i = n + (i - n) := (s0_nat_add_sub_cancel' hGe).symm
      rw [hSum, s0_nat_pow_add]
      exact s0_nat_le_mul_of_pos_right _ (s0_nat_pow_pos (Nat.succ_pos 1) _)
    have hModLt : Nat.mod x (Nat.pow 2 n) < Nat.pow 2 i :=
      Nat.lt_of_lt_of_le (s0_nat_mod_lt x (s0_nat_pow_pos (Nat.succ_pos 1) n)) hPowLe
    exact (s0_nat_testBit_lt_two_pow hModLt).symm

/-! ### `Int` Representation via `Int.subNatNat`, Order, & Subtraction -/

private theorem s0_int_subNatNat_zero (n : Nat) :
    Int.subNatNat n 0 = Int.ofNat n := by
  unfold Int.subNatNat
  rw [Nat.zero_sub]
  rfl

private theorem s0_int_subNatNat_of_le {p q : Nat} (h : q ≤ p) :
    Int.subNatNat p q = Int.ofNat (p - q) := by
  unfold Int.subNatNat
  rw [Nat.sub_eq_zero_of_le h]

private theorem s0_int_subNatNat_of_lt {p q : Nat} (h : p < q) :
    Int.subNatNat p q = Int.negSucc (q - p - 1) := by
  unfold Int.subNatNat
  have hPos : 0 < q - p := Nat.sub_pos_of_lt h
  have hSub : q - p = (q - p - 1) + 1 := (Nat.sub_add_cancel hPos).symm
  rw [hSub]
  rfl

private theorem s0_int_subNatNat_eq_iff (p₁ q₁ p₂ q₂ : Nat) :
    Int.subNatNat p₁ q₁ = Int.subNatNat p₂ q₂ ↔ p₁ + q₂ = p₂ + q₁ := by
  cases Nat.lt_or_ge p₁ q₁ with
  | inl h₁ =>
    rw [s0_int_subNatNat_of_lt h₁]
    cases Nat.lt_or_ge p₂ q₂ with
    | inl h₂ =>
      rw [s0_int_subNatNat_of_lt h₂]
      constructor
      · intro hEq
        have hk := Int.negSucc.inj hEq
        have hPos₁ : 0 < q₁ - p₁ := Nat.sub_pos_of_lt h₁
        have hPos₂ : 0 < q₂ - p₂ := Nat.sub_pos_of_lt h₂
        have hDiff : q₁ - p₁ = q₂ - p₂ := by
          rw [← Nat.sub_add_cancel hPos₁, ← Nat.sub_add_cancel hPos₂, hk]
        have h1 : p₁ + q₂ = p₁ + p₂ + (q₂ - p₂) := by
          rw [Nat.add_assoc, s0_nat_add_sub_cancel' (Nat.le_of_lt h₂)]
        have h2 : p₂ + q₁ = p₁ + p₂ + (q₁ - p₁) := by
          rw [Nat.add_comm p₁ p₂, Nat.add_assoc, s0_nat_add_sub_cancel' (Nat.le_of_lt h₁)]
        rw [h1, h2, hDiff]
      · intro hSum
        have hDiff : q₁ - p₁ = q₂ - p₂ := by
          apply Nat.add_right_cancel (m := p₁ + p₂)
          have h1 : q₁ - p₁ + (p₁ + p₂) = p₂ + q₁ := by
            rw [← Nat.add_assoc (q₁ - p₁) p₁ p₂,
              Nat.sub_add_cancel (Nat.le_of_lt h₁), Nat.add_comm]
          have h2 : q₂ - p₂ + (p₁ + p₂) = p₁ + q₂ := by
            rw [Nat.add_comm p₁ p₂, ← Nat.add_assoc (q₂ - p₂) p₂ p₁,
              Nat.sub_add_cancel (Nat.le_of_lt h₂), Nat.add_comm]
          rw [h1, h2, hSum]
        rw [hDiff]
    | inr h₂ =>
      rw [s0_int_subNatNat_of_le h₂]
      constructor
      · intro hEq; cases hEq
      · intro hSum
        have hBad := s0_nat_add_lt_add_of_le_of_lt h₂ h₁
        rw [Nat.add_comm q₂ p₁, Nat.add_comm p₂ q₁] at hBad
        rw [hSum, Nat.add_comm q₁ p₂] at hBad
        exact False.elim (Nat.lt_irrefl _ hBad)
  | inr h₁ =>
    rw [s0_int_subNatNat_of_le h₁]
    cases Nat.lt_or_ge p₂ q₂ with
    | inl h₂ =>
      rw [s0_int_subNatNat_of_lt h₂]
      constructor
      · intro hEq; cases hEq
      · intro hSum
        have hBad := s0_nat_add_lt_add_of_le_of_lt h₁ h₂
        rw [Nat.add_comm q₁ p₂, Nat.add_comm p₁ q₂] at hBad
        rw [Nat.add_comm q₂ p₁, hSum] at hBad
        exact False.elim (Nat.lt_irrefl _ hBad)
    | inr h₂ =>
      rw [s0_int_subNatNat_of_le h₂]
      constructor
      · intro hEq
        have hd := Int.ofNat.inj hEq
        have h1 : p₁ + q₂ = (p₁ - q₁) + (q₁ + q₂) := by
          rw [← Nat.add_assoc, Nat.sub_add_cancel h₁]
        have h2 : p₂ + q₁ = (p₂ - q₂) + (q₁ + q₂) := by
          rw [Nat.add_comm q₁ q₂, ← Nat.add_assoc, Nat.sub_add_cancel h₂]
        rw [h1, h2, hd]
      · intro hSum
        have hd : p₁ - q₁ = p₂ - q₂ := by
          apply Nat.add_right_cancel (m := q₁ + q₂)
          have h1 : (p₁ - q₁) + (q₁ + q₂) = p₁ + q₂ := by
            rw [← Nat.add_assoc, Nat.sub_add_cancel h₁]
          have h2 : (p₂ - q₂) + (q₁ + q₂) = p₂ + q₁ := by
            rw [Nat.add_comm q₁ q₂, ← Nat.add_assoc, Nat.sub_add_cancel h₂]
          rw [h1, h2, hSum]
        rw [hd]

private theorem s0_int_subNatNat_nonneg_iff (p q : Nat) :
    (Int.subNatNat p q).NonNeg ↔ q ≤ p := by
  cases Nat.lt_or_ge p q with
  | inl hLt =>
    rw [s0_int_subNatNat_of_lt hLt]
    constructor
    · intro hNN; cases hNN
    · intro hLe; exact False.elim (Nat.not_lt_of_le hLe hLt)
  | inr hGe =>
    rw [s0_int_subNatNat_of_le hGe]
    exact ⟨fun _ => hGe, fun _ => Int.NonNeg.mk _⟩

private theorem s0_int_neg_subNatNat (p q : Nat) :
    Neg.neg (Int.subNatNat p q) = Int.subNatNat q p := by
  cases Nat.lt_or_ge p q with
  | inl hLt =>
    rw [s0_int_subNatNat_of_lt hLt, s0_int_subNatNat_of_le (Nat.le_of_lt hLt)]
    change Int.ofNat (q - p - 1 + 1) = Int.ofNat (q - p)
    rw [Nat.sub_add_cancel (Nat.sub_pos_of_lt hLt)]
  | inr hGe =>
    rw [s0_int_subNatNat_of_le hGe]
    cases hDiff : p - q with
    | zero =>
      have hpq : p = q := Nat.le_antisymm (Nat.le_of_sub_eq_zero hDiff) hGe
      subst hpq
      rw [s0_int_subNatNat_of_le (Nat.le_refl _), Nat.sub_self]
      rfl
    | succ k =>
      have hLt : q < p := by
        have h1 : q + (k + 1) = p := by
          rw [← hDiff]
          exact s0_nat_add_sub_cancel' hGe
        rw [← h1]
        exact Nat.lt_add_of_pos_right (Nat.succ_pos k)
      rw [s0_int_subNatNat_of_lt hLt]
      have hk : p - q - 1 = k := by rw [hDiff]; rfl
      rw [hk]
      rfl

private theorem s0_int_subNatNat_add_subNatNat (p₁ q₁ p₂ q₂ : Nat) :
    Int.subNatNat p₁ q₁ + Int.subNatNat p₂ q₂ =
      Int.subNatNat (p₁ + p₂) (q₁ + q₂) := by
  cases Nat.lt_or_ge p₁ q₁ with
  | inl h₁ =>
    rw [s0_int_subNatNat_of_lt h₁]
    have hD₁ : q₁ - p₁ - 1 + 1 = q₁ - p₁ := Nat.sub_add_cancel (Nat.sub_pos_of_lt h₁)
    cases Nat.lt_or_ge p₂ q₂ with
    | inl h₂ =>
      rw [s0_int_subNatNat_of_lt h₂]
      have hD₂ : q₂ - p₂ - 1 + 1 = q₂ - p₂ := Nat.sub_add_cancel (Nat.sub_pos_of_lt h₂)
      change Int.negSucc ((q₁ - p₁ - 1 + (q₂ - p₂ - 1)) + 1) =
        Int.subNatNat (p₁ + p₂) (q₁ + q₂)
      have hSumLt : p₁ + p₂ < q₁ + q₂ :=
        s0_nat_add_lt_add_of_le_of_lt (Nat.le_of_lt h₁) h₂
      rw [s0_int_subNatNat_of_lt hSumLt]
      have hEq : (q₁ - p₁ - 1 + (q₂ - p₂ - 1)) + 1 = (q₁ + q₂) - (p₁ + p₂) - 1 := by
        apply Nat.add_right_cancel (m := 1 + (p₁ + p₂))
        have hL : (q₁ - p₁ - 1 + (q₂ - p₂ - 1)) + 1 + (1 + (p₁ + p₂)) =
            (q₁ - p₁ - 1 + 1) + (q₂ - p₂ - 1 + 1) + (p₁ + p₂) := by
          rw [Nat.add_assoc (q₁ - p₁ - 1) (q₂ - p₂ - 1) 1]
          rw [← Nat.add_assoc (q₁ - p₁ - 1 + (q₂ - p₂ - 1 + 1)) 1 (p₁ + p₂)]
          rw [Nat.add_assoc (q₁ - p₁ - 1) (q₂ - p₂ - 1 + 1) 1]
          rw [Nat.add_comm (q₂ - p₂ - 1 + 1) 1]
          rw [← Nat.add_assoc (q₁ - p₁ - 1) 1 (q₂ - p₂ - 1 + 1)]
        have hL2 : (q₁ - p₁) + (q₂ - p₂) + (p₁ + p₂) = q₁ + q₂ := by
          rw [Nat.add_assoc (q₁ - p₁) (q₂ - p₂) (p₁ + p₂)]
          rw [Nat.add_comm p₁ p₂, ← Nat.add_assoc (q₂ - p₂) p₂ p₁,
            Nat.sub_add_cancel (Nat.le_of_lt h₂)]
          rw [Nat.add_comm q₂ p₁, ← Nat.add_assoc (q₁ - p₁) p₁ q₂,
            Nat.sub_add_cancel (Nat.le_of_lt h₁)]
        rw [hL, hD₁, hD₂, hL2]
        have hPosSum : 0 < (q₁ + q₂) - (p₁ + p₂) := Nat.sub_pos_of_lt hSumLt
        rw [← Nat.add_assoc _ 1 (p₁ + p₂), Nat.sub_add_cancel hPosSum,
          Nat.sub_add_cancel (Nat.le_of_lt hSumLt)]
      rw [hEq]
    | inr h₂ =>
      rw [s0_int_subNatNat_of_le h₂]
      change Int.subNatNat (p₂ - q₂) (q₁ - p₁ - 1 + 1) =
        Int.subNatNat (p₁ + p₂) (q₁ + q₂)
      rw [hD₁]
      apply (s0_int_subNatNat_eq_iff _ _ _ _).mpr
      have h1 : (p₂ - q₂) + (q₁ + q₂) = p₂ + q₁ := by
        rw [Nat.add_comm q₁ q₂, ← Nat.add_assoc, Nat.sub_add_cancel h₂]
      have h2 : (p₁ + p₂) + (q₁ - p₁) = p₂ + q₁ := by
        rw [Nat.add_comm p₁ p₂, Nat.add_assoc, s0_nat_add_sub_cancel' (Nat.le_of_lt h₁)]
      rw [h1, h2]
  | inr h₁ =>
    rw [s0_int_subNatNat_of_le h₁]
    cases Nat.lt_or_ge p₂ q₂ with
    | inl h₂ =>
      rw [s0_int_subNatNat_of_lt h₂]
      have hD₂ : q₂ - p₂ - 1 + 1 = q₂ - p₂ := Nat.sub_add_cancel (Nat.sub_pos_of_lt h₂)
      change Int.subNatNat (p₁ - q₁) (q₂ - p₂ - 1 + 1) =
        Int.subNatNat (p₁ + p₂) (q₁ + q₂)
      rw [hD₂]
      apply (s0_int_subNatNat_eq_iff _ _ _ _).mpr
      have h1 : (p₁ - q₁) + (q₁ + q₂) = p₁ + q₂ := by
        rw [← Nat.add_assoc, Nat.sub_add_cancel h₁]
      have h2 : (p₁ + p₂) + (q₂ - p₂) = p₁ + q₂ := by
        rw [Nat.add_assoc, s0_nat_add_sub_cancel' (Nat.le_of_lt h₂)]
      rw [h1, h2]
    | inr h₂ =>
      rw [s0_int_subNatNat_of_le h₂]
      change Int.ofNat ((p₁ - q₁) + (p₂ - q₂)) =
        Int.subNatNat (p₁ + p₂) (q₁ + q₂)
      rw [← s0_int_subNatNat_zero ((p₁ - q₁) + (p₂ - q₂))]
      apply (s0_int_subNatNat_eq_iff _ _ _ _).mpr
      rw [Nat.add_assoc (p₁ - q₁) (p₂ - q₂) (q₁ + q₂)]
      rw [Nat.add_comm q₁ q₂, ← Nat.add_assoc (p₂ - q₂) q₂ q₁,
        Nat.sub_add_cancel h₂]
      rw [Nat.add_comm p₂ q₁, ← Nat.add_assoc (p₁ - q₁) q₁ p₂,
        Nat.sub_add_cancel h₁, Nat.add_zero]

private theorem s0_int_exists_subNatNat :
    ∀ z : Int, ∃ p q : Nat, z = Int.subNatNat p q
  | .ofNat n => ⟨n, 0, (s0_int_subNatNat_zero n).symm⟩
  | .negSucc k => ⟨0, k + 1, by rw [s0_int_subNatNat_of_lt (Nat.succ_pos k)]; rfl⟩

private theorem s0_int_add_comm (a b : Int) : a + b = b + a := by
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          rw [hza, hzb, s0_int_subNatNat_add_subNatNat,
            s0_int_subNatNat_add_subNatNat, Nat.add_comm pa pb,
            Nat.add_comm qa qb]

private theorem s0_int_zero_add (a : Int) : (0 : Int) + a = a := by
  cases a with
  | ofNat n =>
    change Int.ofNat (0 + n) = Int.ofNat n
    rw [Nat.zero_add]
  | negSucc k =>
    change Int.subNatNat 0 (k + 1) = Int.negSucc k
    rw [s0_int_subNatNat_of_lt (Nat.succ_pos k)]
    rfl

private theorem s0_int_natCast_nonneg (n : Nat) : (0 : Int) ≤ Int.ofNat n := by
  change (Int.ofNat n - (0 : Int)).NonNeg
  exact Int.NonNeg.mk n

private theorem s0_int_not_lt_mpr {a b : Int} (h : b ≤ a) : ¬ (a < b) := by
  intro hLt
  change (a - b).NonNeg at h
  change (b - (a + 1)).NonNeg at hLt
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          rw [hza, hzb] at h hLt
          change (Int.subNatNat pa qa + Neg.neg (Int.subNatNat pb qb)).NonNeg at h
          change (Int.subNatNat pb qb +
            Neg.neg (Int.subNatNat pa qa + Int.ofNat 1)).NonNeg at hLt
          rw [← s0_int_subNatNat_zero 1] at hLt
          rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat] at h
          rw [s0_int_subNatNat_add_subNatNat, s0_int_neg_subNatNat,
            s0_int_subNatNat_add_subNatNat] at hLt
          have h1 := (s0_int_subNatNat_nonneg_iff _ _).mp h
          have h2 := (s0_int_subNatNat_nonneg_iff _ _).mp hLt
          rw [Nat.add_zero] at h2
          have h3 : (qa + pb) + (qb + (pa + 1)) ≤ (pa + qb) + (pb + qa) :=
            Nat.add_le_add h1 h2
          have hL : (qa + pb) + (qb + (pa + 1)) = ((pa + qb) + (pb + qa)) + 1 := by
            rw [← Nat.add_assoc qb pa 1, ← Nat.add_assoc (qa + pb) (qb + pa) 1]
            rw [Nat.add_comm qb pa, Nat.add_assoc qa pb (pa + qb)]
            rw [Nat.add_comm pb (pa + qb), ← Nat.add_assoc qa (pa + qb) pb]
            rw [Nat.add_comm qa (pa + qb), Nat.add_assoc (pa + qb) qa pb]
            rw [Nat.add_comm qa pb]
          rw [hL] at h3
          exact Nat.not_succ_le_self _ h3

private theorem s0_int_ofNat_le_mp {m n : Nat} (h : Int.ofNat m ≤ Int.ofNat n) :
    m ≤ n := by
  change (Int.ofNat n + Neg.neg (Int.ofNat m)).NonNeg at h
  rw [← s0_int_subNatNat_zero n, ← s0_int_subNatNat_zero m] at h
  rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat,
    Nat.add_zero, Nat.zero_add] at h
  exact (s0_int_subNatNat_nonneg_iff n m).mp h

private theorem s0_int_ofNat_le_mpr {m n : Nat} (h : m ≤ n) :
    Int.ofNat m ≤ Int.ofNat n := by
  change (Int.ofNat n + Neg.neg (Int.ofNat m)).NonNeg
  rw [← s0_int_subNatNat_zero n, ← s0_int_subNatNat_zero m]
  rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat,
    Nat.add_zero, Nat.zero_add]
  exact (s0_int_subNatNat_nonneg_iff n m).mpr h

private theorem s0_int_ofNat_lt_mp {m n : Nat} (h : Int.ofNat m < Int.ofNat n) :
    m < n := by
  change (Int.ofNat n + Neg.neg (Int.ofNat m + Int.ofNat 1)).NonNeg at h
  rw [← s0_int_subNatNat_zero n, ← s0_int_subNatNat_zero m,
    ← s0_int_subNatNat_zero 1] at h
  rw [s0_int_subNatNat_add_subNatNat, s0_int_neg_subNatNat,
    s0_int_subNatNat_add_subNatNat, Nat.add_zero, Nat.add_zero,
    Nat.zero_add] at h
  exact (s0_int_subNatNat_nonneg_iff n (m + 1)).mp h

private theorem s0_int_ofNat_lt_mpr {m n : Nat} (h : m < n) :
    Int.ofNat m < Int.ofNat n := by
  change (Int.ofNat n + Neg.neg (Int.ofNat m + Int.ofNat 1)).NonNeg
  rw [← s0_int_subNatNat_zero n, ← s0_int_subNatNat_zero m,
    ← s0_int_subNatNat_zero 1]
  rw [s0_int_subNatNat_add_subNatNat, s0_int_neg_subNatNat,
    s0_int_subNatNat_add_subNatNat, Nat.add_zero, Nat.add_zero,
    Nat.zero_add]
  exact (s0_int_subNatNat_nonneg_iff n (m + 1)).mpr h

private theorem s0_int_ofNat_sub {m n : Nat} (h : m ≤ n) :
    Int.ofNat (n - m) = Int.ofNat n - Int.ofNat m := by
  change Int.ofNat (n - m) = Int.ofNat n + Neg.neg (Int.ofNat m)
  rw [← s0_int_subNatNat_zero (n - m), ← s0_int_subNatNat_zero n,
    ← s0_int_subNatNat_zero m]
  rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat,
    Nat.add_zero, Nat.zero_add]
  apply (s0_int_subNatNat_eq_iff _ _ _ _).mpr
  rw [Nat.add_zero, Nat.sub_add_cancel h]

private theorem s0_int_sub_lt_iff_mpr {a b c : Int} (h : a < c + b) :
    a - b < c := by
  change ((c + b) - (a + 1)).NonNeg at h
  change (c - ((a - b) + 1)).NonNeg
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          cases s0_int_exists_subNatNat c with
          | intro pc hc =>
            cases hc with
            | intro qc hzc =>
              rw [hza, hzb, hzc] at h
              rw [hza, hzb, hzc]
              change ((Int.subNatNat pc qc + Int.subNatNat pb qb) +
                Neg.neg (Int.subNatNat pa qa + Int.ofNat 1)).NonNeg at h
              change (Int.subNatNat pc qc +
                Neg.neg (Int.subNatNat pa qa + Neg.neg (Int.subNatNat pb qb) +
                  Int.ofNat 1)).NonNeg
              rw [← s0_int_subNatNat_zero 1] at h
              rw [← s0_int_subNatNat_zero 1]
              rw [s0_int_subNatNat_add_subNatNat, s0_int_subNatNat_add_subNatNat,
                s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat,
                Nat.add_zero] at h
              rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat,
                s0_int_subNatNat_add_subNatNat, s0_int_neg_subNatNat,
                s0_int_subNatNat_add_subNatNat, Nat.add_zero]
              have hN := (s0_int_subNatNat_nonneg_iff _ _).mp h
              apply (s0_int_subNatNat_nonneg_iff _ _).mpr
              have hEqL : qc + (pa + qb + 1) = qc + qb + (pa + 1) := by
                rw [Nat.add_comm pa qb, Nat.add_assoc qb pa 1,
                  ← Nat.add_assoc qc qb (pa + 1)]
              have hEqR : pc + (qa + pb) = pc + pb + qa := by
                rw [Nat.add_comm qa pb, ← Nat.add_assoc pc pb qa]
              rw [hEqL, hEqR]
              exact hN

private theorem s0_int_natAbs_ofNat (m : Nat) : Int.natAbs (Int.ofNat m) = m := rfl

private theorem s0_int_natAbs_natCast (m : Nat) : Int.natAbs (m : Int) = m := rfl

private theorem s0_nat_testBit_bitwise_args {f : Bool → Bool → Bool}
    (hFF : f false false = false) (n m i : Nat) :
    (Nat.bitwise f n m).testBit i = f (n.testBit i) (m.testBit i) :=
  s0_nat_testBit_bitwise f hFF i n m

private theorem s0_int_toNat_of_nonneg : ∀ {a : Int}, (0 : Int) ≤ a → Int.ofNat a.toNat = a
  | .ofNat _ => fun _ => rfl
  | .negSucc _ => fun h => by
    change (Int.negSucc _ - (0 : Int)).NonNeg at h
    cases h

private theorem s0_int_le_of_not_gt {a b : Int} (h : ¬ (b < a)) : a ≤ b := by
  change (b - a).NonNeg
  change ¬ ((a - (b + 1)).NonNeg) at h
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          rw [hza, hzb] at h
          rw [hza, hzb]
          change (Int.subNatNat pb qb + Neg.neg (Int.subNatNat pa qa)).NonNeg
          change ¬ ((Int.subNatNat pa qa +
            Neg.neg (Int.subNatNat pb qb + Int.ofNat 1)).NonNeg) at h
          rw [← s0_int_subNatNat_zero 1] at h
          rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat]
          rw [s0_int_subNatNat_add_subNatNat, s0_int_neg_subNatNat,
            s0_int_subNatNat_add_subNatNat, Nat.add_zero] at h
          apply (s0_int_subNatNat_nonneg_iff _ _).mpr
          cases Nat.lt_or_ge (pb + qa) (qb + pa) with
          | inl hLt =>
            have hNat : qa + (pb + 1) ≤ pa + qb := by
              have hS : (pb + qa) + 1 ≤ qb + pa := hLt
              have hL : qa + (pb + 1) = (pb + qa) + 1 := by
                rw [Nat.add_comm pb qa, Nat.add_assoc qa pb 1]
              have hR : pa + qb = qb + pa := Nat.add_comm pa qb
              rw [hL, hR]
              exact hS
            exact False.elim (h ((s0_int_subNatNat_nonneg_iff _ _).mpr hNat))
          | inr hGe => exact hGe

private theorem s0_int_le_of_lt {a b : Int} (h : a < b) : a ≤ b := by
  change (b - a).NonNeg
  change (b - (a + 1)).NonNeg at h
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          rw [hza, hzb] at h
          rw [hza, hzb]
          change (Int.subNatNat pb qb + Neg.neg (Int.subNatNat pa qa)).NonNeg
          change (Int.subNatNat pb qb +
            Neg.neg (Int.subNatNat pa qa + Int.ofNat 1)).NonNeg at h
          rw [← s0_int_subNatNat_zero 1] at h
          rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat]
          rw [s0_int_subNatNat_add_subNatNat, s0_int_neg_subNatNat,
            s0_int_subNatNat_add_subNatNat, Nat.add_zero] at h
          have hLe := (s0_int_subNatNat_nonneg_iff _ _).mp h
          apply (s0_int_subNatNat_nonneg_iff _ _).mpr
          exact Nat.le_trans (Nat.add_le_add_left (Nat.le_succ pa) qb) hLe

private theorem s0_int_neg_pos_of_neg {a : Int} (h : a < 0) : (0 : Int) < Neg.neg a := by
  cases a with
  | ofNat _ => cases h
  | negSucc k =>
    change (0 : Int) < Int.ofNat (k + 1)
    exact s0_int_ofNat_lt_mpr (Nat.succ_pos k)

private theorem s0_int_neg_le_neg {a b : Int} (h : a ≤ b) : Neg.neg b ≤ Neg.neg a := by
  change (b - a).NonNeg at h
  change (Neg.neg a - Neg.neg b).NonNeg
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          rw [hza, hzb] at h
          rw [hza, hzb]
          change (Int.subNatNat pb qb + Neg.neg (Int.subNatNat pa qa)).NonNeg at h
          change (Neg.neg (Int.subNatNat pa qa) +
            Neg.neg (Neg.neg (Int.subNatNat pb qb))).NonNeg
          rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat] at h
          rw [s0_int_neg_subNatNat, s0_int_neg_subNatNat, s0_int_neg_subNatNat,
            s0_int_subNatNat_add_subNatNat]
          have hLe := (s0_int_subNatNat_nonneg_iff _ _).mp h
          apply (s0_int_subNatNat_nonneg_iff _ _).mpr
          rw [Nat.add_comm pb qa, Nat.add_comm qb pa] at hLe
          exact hLe

private theorem s0_int_add_le_add_right {a b : Int} (h : a ≤ b) (c : Int) :
    a + c ≤ b + c := by
  change (b - a).NonNeg at h
  change ((b + c) - (a + c)).NonNeg
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          cases s0_int_exists_subNatNat c with
          | intro pc hc =>
            cases hc with
            | intro qc hzc =>
              rw [hza, hzb] at h
              rw [hza, hzb, hzc]
              change (Int.subNatNat pb qb +
                Neg.neg (Int.subNatNat pa qa)).NonNeg at h
              change ((Int.subNatNat pb qb + Int.subNatNat pc qc) +
                Neg.neg (Int.subNatNat pa qa + Int.subNatNat pc qc)).NonNeg
              rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat] at h
              rw [s0_int_subNatNat_add_subNatNat, s0_int_subNatNat_add_subNatNat,
                s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat]
              have hLe := (s0_int_subNatNat_nonneg_iff _ _).mp h
              apply (s0_int_subNatNat_nonneg_iff _ _).mpr
              have hAdd := Nat.add_le_add_right hLe (pc + qc)
              have hL : (qb + pa) + (pc + qc) = (qb + qc) + (pa + pc) := by
                rw [Nat.add_assoc qb pa (pc + qc), Nat.add_comm pa (pc + qc),
                  Nat.add_comm pc qc, Nat.add_assoc qc pc pa,
                  ← Nat.add_assoc qb qc (pc + pa), Nat.add_comm pc pa]
              have hR : (pb + qa) + (pc + qc) = (pb + pc) + (qa + qc) := by
                rw [Nat.add_assoc pb qa (pc + qc), Nat.add_comm qa (pc + qc),
                  Nat.add_assoc pc qc qa, ← Nat.add_assoc pb pc (qc + qa),
                  Nat.add_comm qc qa]
              rw [hL, hR] at hAdd
              exact hAdd

private theorem s0_int_sub_add_cancel (a b : Int) : (a - b) + b = a := by
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          rw [hza, hzb]
          change (Int.subNatNat pa qa + Neg.neg (Int.subNatNat pb qb)) +
            Int.subNatNat pb qb = Int.subNatNat pa qa
          rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat,
            s0_int_subNatNat_add_subNatNat]
          apply (s0_int_subNatNat_eq_iff _ _ _ _).mpr
          have hL : ((pa + qb) + pb) + qa = (pa + qa) + (pb + qb) := by
            rw [Nat.add_assoc pa qb pb, Nat.add_assoc pa (qb + pb) qa,
              Nat.add_comm (qb + pb) qa, ← Nat.add_assoc pa qa (qb + pb),
              Nat.add_comm qb pb]
          have hR : pa + ((qa + pb) + qb) = (pa + qa) + (pb + qb) := by
            rw [← Nat.add_assoc pa (qa + pb) qb, ← Nat.add_assoc pa qa pb,
              Nat.add_assoc (pa + qa) pb qb]
          rw [hL, hR]

private theorem s0_int_negSucc_lt_zero (k : Nat) : Int.negSucc k < 0 := by
  change ((0 : Int) - (Int.negSucc k + 1)).NonNeg
  change (Int.subNatNat 0 0 +
    Neg.neg (Int.subNatNat 0 (k + 1) + Int.subNatNat 1 0)).NonNeg
  rw [s0_int_subNatNat_add_subNatNat, s0_int_neg_subNatNat,
    s0_int_subNatNat_add_subNatNat]
  apply (s0_int_subNatNat_nonneg_iff _ _).mpr
  exact Nat.succ_le_succ (Nat.zero_le (Nat.add 0 k))

private theorem s0_int_neg_neg : ∀ a : Int, Neg.neg (Neg.neg a) = a
  | .ofNat 0 => rfl
  | .ofNat (_ + 1) => rfl
  | .negSucc _ => rfl

private theorem s0_int_zero_mul : ∀ a : Int, (0 : Int) * a = 0
  | .ofNat n => by
    change Int.ofNat (0 * n) = Int.ofNat 0
    rw [Nat.zero_mul]
  | .negSucc k => by
    change Int.negOfNat (0 * k.succ) = Int.ofNat 0
    rw [Nat.zero_mul]; rfl

private theorem s0_int_le_trans {a b c : Int} (hab : a ≤ b) (hbc : b ≤ c) : a ≤ c := by
  change (b - a).NonNeg at hab
  change (c - b).NonNeg at hbc
  change (c - a).NonNeg
  cases s0_int_exists_subNatNat a with
  | intro pa ha =>
    cases ha with
    | intro qa hza =>
      cases s0_int_exists_subNatNat b with
      | intro pb hb =>
        cases hb with
        | intro qb hzb =>
          cases s0_int_exists_subNatNat c with
          | intro pc hc =>
            cases hc with
            | intro qc hzc =>
              rw [hza, hzb] at hab
              rw [hzb, hzc] at hbc
              rw [hza, hzc]
              change (Int.subNatNat pb qb +
                Neg.neg (Int.subNatNat pa qa)).NonNeg at hab
              change (Int.subNatNat pc qc +
                Neg.neg (Int.subNatNat pb qb)).NonNeg at hbc
              change (Int.subNatNat pc qc +
                Neg.neg (Int.subNatNat pa qa)).NonNeg
              rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat] at hab
              rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat] at hbc
              rw [s0_int_neg_subNatNat, s0_int_subNatNat_add_subNatNat]
              have h1 := (s0_int_subNatNat_nonneg_iff _ _).mp hab
              have h2 := (s0_int_subNatNat_nonneg_iff _ _).mp hbc
              apply (s0_int_subNatNat_nonneg_iff _ _).mpr
              have hSum := Nat.add_le_add h1 h2
              have hL : (qb + pa) + (qc + pb) = (qc + pa) + (qb + pb) := by
                rw [Nat.add_assoc qb pa (qc + pb), Nat.add_comm pa (qc + pb),
                  ← Nat.add_assoc qb (qc + pb) pa, Nat.add_comm qb (qc + pb),
                  Nat.add_assoc qc pb qb, Nat.add_assoc qc (pb + qb) pa,
                  Nat.add_comm (pb + qb) pa, ← Nat.add_assoc qc pa (pb + qb),
                  Nat.add_comm pb qb]
              have hR : (pb + qa) + (pc + qb) = (pc + qa) + (qb + pb) := by
                rw [Nat.add_assoc pb qa (pc + qb), Nat.add_comm qa (pc + qb),
                  ← Nat.add_assoc pb (pc + qb) qa, Nat.add_comm pb (pc + qb),
                  Nat.add_assoc pc qb pb, Nat.add_assoc pc (qb + pb) qa,
                  Nat.add_comm (qb + pb) qa, ← Nat.add_assoc pc qa (qb + pb)]
              rw [hL, hR] at hSum
              exact Nat.le_of_add_le_add_right hSum

