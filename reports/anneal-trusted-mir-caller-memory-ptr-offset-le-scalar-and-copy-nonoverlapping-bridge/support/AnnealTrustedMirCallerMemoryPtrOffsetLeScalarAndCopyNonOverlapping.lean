/-! ## Section 1: Block Lowering Indexing, Multi-Step Helpers, & `s3_FwdStepSim` -/

private theorem s3c_nat_beq_false_of_ne {a b : Nat} (h : a ≠ b) : Nat.beq a b = false := by
  cases hEq : Nat.beq a b with
  | false => rfl
  | true => exact False.elim (h (nat_beq_eq _ _ hEq))

private theorem s3c_ne_add_two (a : Nat) : a ≠ a + 2 := by
  intro h
  have hLe : a + 2 ≤ a := Nat.le_of_eq h.symm
  exact Nat.not_lt_of_le hLe (Nat.lt_add_of_pos_right (Nat.succ_pos 1))

private theorem s3c_scr_ne_comp (ctx : s3_PtrCtx) {k r j : Nat}
    (hB : ctx.bodySrc.locals.length + 3 * k + r < s3_scrBase ctx) :
    s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * k + r := by
  intro h
  exact Nat.not_lt_of_le (Nat.le_add_right (s3_scrBase ctx) j) (by rw [h]; exact hB)

private theorem s3c_scr_ne_comp0 (ctx : s3_PtrCtx) {k j : Nat}
    (hB : ctx.bodySrc.locals.length + 3 * k < s3_scrBase ctx) :
    s3_scrBase ctx + j ≠ ctx.bodySrc.locals.length + 3 * k := by
  intro h
  exact Nat.not_lt_of_le (Nat.le_add_right (s3_scrBase ctx) j) (by rw [h]; exact hB)

private theorem s3c_nat_eq_or_ne (a b : Nat) : a = b ∨ a ≠ b :=
  match hEq : Nat.beq a b with
  | true => Or.inl (nat_beq_eq _ _ hEq)
  | false => Or.inr (nat_beq_false_ne hEq)

private theorem s3c_listFlatMap_append {α β : Type} (f : α → List β) :
    ∀ (xs ys : List α), listFlatMap f (xs ++ ys) = listFlatMap f xs ++ listFlatMap f ys
  | [], _ => rfl
  | x :: xs, ys => by
    change f x ++ listFlatMap f (xs ++ ys) = (f x ++ listFlatMap f xs) ++ listFlatMap f ys
    rw [s3c_listFlatMap_append f xs ys, List.append_assoc]

private theorem s3c_listFlatMap_singleton {α β : Type} (f : α → List β) (x : α) :
    listFlatMap f [x] = f x := by
  change f x ++ [] = f x
  rw [List.append_nil]

private theorem s3c_list_take_drop_eq {α : Type} :
    ∀ (xs : List α) (n : Nat), xs.take n ++ xs.drop n = xs
  | [], 0 => rfl
  | [], _ + 1 => rfl
  | _ :: _, 0 => rfl
  | x :: xs, n + 1 => by
    change x :: (xs.take n ++ xs.drop n) = x :: xs
    rw [s3c_list_take_drop_eq xs n]

private theorem s3c_list_take_succ_of_getElem? {α : Type} :
    ∀ {xs : List α} {i : Nat} {x : α},
      Trusted.MirSemantics.getElem? xs i = some x →
      xs.take i ++ [x] = xs.take (i + 1)
  | [], _, _, h => by cases h
  | x :: _, 0, _, h => by cases h; rfl
  | x :: xs, i + 1, y, h => by
    have ih := s3c_list_take_succ_of_getElem? (xs := xs) (i := i) (x := y) h
    change x :: (xs.take i ++ [y]) = x :: xs.take (i + 1)
    rw [ih]

private theorem s3c_listFlatMap_split_at {α β : Type} (f : α → List β) {xs : List α}
    {i : Nat} {x : α} (h : Trusted.MirSemantics.getElem? xs i = some x) :
    listFlatMap f xs =
      listFlatMap f (xs.take i) ++ f x ++ listFlatMap f (xs.drop (i + 1)) := by
  have hSplit : xs = xs.take i ++ [x] ++ xs.drop (i + 1) := by
    rw [s3c_list_take_succ_of_getElem? h, s3c_list_take_drop_eq]
  have hStep := congrArg (listFlatMap f) hSplit
  rw [s3c_listFlatMap_append, s3c_listFlatMap_append, s3c_listFlatMap_singleton] at hStep
  exact hStep

private theorem s3c_listFlatMap_take_succ {α β : Type} (f : α → List β) {xs : List α}
    {i : Nat} {x : α} (h : Trusted.MirSemantics.getElem? xs i = some x) :
    (listFlatMap f (xs.take i)).length + (f x).length =
      (listFlatMap f (xs.take (i + 1))).length := by
  rw [← s3c_list_take_succ_of_getElem? h, s3c_listFlatMap_append,
    s3c_listFlatMap_singleton, List.length_append]

private theorem s3c_list_take_all {α : Type} :
    ∀ (xs : List α), xs.take xs.length = xs
  | [] => rfl
  | x :: xs => by
    change x :: xs.take xs.length = x :: xs
    rw [s3c_list_take_all xs]

private theorem s3_bodyTgt_get (ctx : s3_PtrCtx) :
    Trusted.MirSemantics.getElem? ctx.pTgt.bodies ctx.plan.defId = some ctx.bodyTgt :=
  s3_getElem?_setElem?_eq ctx.pSrc.bodies ctx.plan.defId ctx.bodyTgt ctx.pTgt.bodies ctx.hSetBody

private theorem s3_lowerBlock_getElem?_stmt (ctx : s3_PtrCtx)
    {bbIdx : Nat} {bbSrc : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bbSrc)
    {i : Nat} {stmt : MemCopyStmt}
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements i = some stmt) :
    ∃ (extraBase : Nat) (extraSelf : List MemCopyBlock),
      let pair := lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
        extraBase bbSrc.terminator
      let bbTgt : MemCopyBlock := {
        bbSrc with
        statements := listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries
          ctx.bodySrc.locals.length) bbSrc.statements ++ pair.1
        terminator := pair.2.1
      }
      let off := s3_loweredStmtIdx ctx bbSrc.statements i
      let gen := lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length stmt
      pair.2.2 = extraSelf ∧
      ctx.bodySrc.basicBlocks.length ≤ extraBase ∧
      Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt ∧
      (∀ j : Nat, j < gen.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
          Trusted.MirSemantics.getElem? gen j) ∧
      off + gen.length = s3_loweredStmtIdx ctx bbSrc.statements (i + 1) := by
  cases s3_bodyTgt_block_lookup ctx bbIdx bbSrc hBb with
  | intro extraBase hR =>
    cases hR with
    | intro extraSelf hSpec =>
      refine ⟨extraBase, extraSelf, hSpec.1, hSpec.2.1, hSpec.2.2.1, ?_, ?_⟩
      · intro j hj
        let f := lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
        have hFlat := s3c_listFlatMap_split_at f hStmt
        dsimp
        change Trusted.MirSemantics.getElem?
            (listFlatMap f bbSrc.statements ++
              (lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
                extraBase bbSrc.terminator).1)
            ((listFlatMap f (bbSrc.statements.take i)).length + j) = _
        rw [hFlat]
        rw [List.append_assoc (listFlatMap f (bbSrc.statements.take i)) (f stmt) _,
          List.append_assoc (listFlatMap f (bbSrc.statements.take i))
            (f stmt ++ listFlatMap f (bbSrc.statements.drop (i + 1))) _]
        rw [s3_getElem?_append_right (listFlatMap f (bbSrc.statements.take i)) _
            ((listFlatMap f (bbSrc.statements.take i)).length + j) (Nat.le_add_right _ _)]
        rw [Nat.add_sub_cancel_left]
        rw [List.append_assoc (f stmt) (listFlatMap f (bbSrc.statements.drop (i + 1))) _]
        exact s3_getElem?_append_left (f stmt) _ j hj
      · unfold s3_loweredStmtIdx
        exact s3c_listFlatMap_take_succ
          (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length) hStmt

private theorem s3_lowerBlock_getElem?_termPre (ctx : s3_PtrCtx)
    {bbIdx : Nat} {bbSrc : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bbSrc) :
    ∃ (extraBase : Nat) (extraSelf : List MemCopyBlock),
      let pair := lowerTermForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
        extraBase bbSrc.terminator
      let bbTgt : MemCopyBlock := {
        bbSrc with
        statements := listFlatMap (lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries
          ctx.bodySrc.locals.length) bbSrc.statements ++ pair.1
        terminator := pair.2.1
      }
      let off := s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length
      pair.2.2 = extraSelf ∧
      ctx.bodySrc.basicBlocks.length ≤ extraBase ∧
      Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt ∧
      off + pair.1.length = bbTgt.statements.length ∧
      (∀ j : Nat, j < pair.1.length →
        Trusted.MirSemantics.getElem? bbTgt.statements (off + j) =
          Trusted.MirSemantics.getElem? pair.1 j) ∧
      (∀ (k : Nat) (eb : MemCopyBlock),
        Trusted.MirSemantics.getElem? extraSelf k = some eb →
        Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks (extraBase + k) = some eb) := by
  cases s3_bodyTgt_block_lookup ctx bbIdx bbSrc hBb with
  | intro extraBase hR =>
    cases hR with
    | intro extraSelf hSpec =>
      refine ⟨extraBase, extraSelf, hSpec.1, hSpec.2.1, hSpec.2.2.1, ?_, ?_, hSpec.2.2.2⟩
      · dsimp
        unfold s3_loweredStmtIdx
        rw [s3c_list_take_all, List.length_append]
      · intro j hj
        dsimp
        unfold s3_loweredStmtIdx
        rw [s3c_list_take_all]
        rw [s3_getElem?_append_right _ _ _ (Nat.le_add_right _ _), Nat.add_sub_cancel_left]

private theorem s3_reachesN_one {p : MemCopyProgram} {s₁ s₂ : MemCopyState}
    (h : evalStepMemCopy p 0 s₁ = .step s₂) : ReachesNMemCopy p 1 s₁ s₂ :=
  .succ ((stepMemCopy_iff_evalStep p s₁ (.step s₂)).mpr h) (.zero s₂)

private theorem s3_reachesN_cons {p : MemCopyProgram} {n : Nat} {s₀ s₁ s₂ : MemCopyState}
    (h01 : evalStepMemCopy p 0 s₀ = .step s₁) (h12 : ReachesNMemCopy p n s₁ s₂) :
    ReachesNMemCopy p (n + 1) s₀ s₂ :=
  .succ ((stepMemCopy_iff_evalStep p s₀ (.step s₁)).mpr h01) h12

private theorem s3_reachesPlus_of_reachesN_succ {p : MemCopyProgram} {n : Nat} {s₁ s₂ : MemCopyState}
    (h : ReachesNMemCopy p (n + 1) s₁ s₂) : ReachesPlusMemCopy p s₁ s₂ :=
  ⟨n, h⟩

private theorem s3_fault_of_reachesN {p : MemCopyProgram} {n : Nat} {s₁ s₂ : MemCopyState} {k : FaultKind}
    (hR : ReachesNMemCopy p n s₁ s₂) (hF : evalStepMemCopy p 0 s₂ = .fault k) :
    ∃ s' : MemCopyState, ReachesMemCopy p s₁ s' ∧ StepMemCopy p s' (.fault k) :=
  ⟨s₂, reachesMemCopy_of_reachesNMemCopy hR, (stepMemCopy_iff_evalStep p s₂ (.fault k)).mpr hF⟩

private theorem s3_done_of_reachesN {p : MemCopyProgram} {n : Nat} {s₁ s₂ : MemCopyState} {out : TerminalOut}
    (hR : ReachesNMemCopy p n s₁ s₂) (hD : evalStepMemCopy p 0 s₂ = .done out) :
    ∃ s' : MemCopyState, ReachesMemCopy p s₁ s' ∧ StepMemCopy p s' (.done out) :=
  ⟨s₂, reachesMemCopy_of_reachesNMemCopy hR, (stepMemCopy_iff_evalStep p s₂ (.done out)).mpr hD⟩

private theorem s3_reachesN_stmt_step (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {stmt : MemCopyStmt} {slots slots' : List MemCopySlot} {mem mem' : CallerMemory}
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx = some stmt)
    (hEval : evalMemCopyStmt ctx.bodyTgt { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots } mem stmt =
      stepMemCopyNext { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots } mem' slots') :
    evalStepMemCopy ctx.pTgt 0 { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots }], mem := mem } =
      .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots' }], mem := mem' } := by
  rw [s3_step_state_of_stmt ctx.pTgt _ mem ctx.bodyTgt bbTgt stmt (s3_bodyTgt_get ctx) hBbTgt hStmt]
  exact hEval

private theorem s3_reachesN_stmt_fault (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {stmt : MemCopyStmt} {slots : List MemCopySlot} {mem : CallerMemory} {k : FaultKind}
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx = some stmt)
    (hEval : evalMemCopyStmt ctx.bodyTgt { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots } mem stmt =
      .fault k) :
    evalStepMemCopy ctx.pTgt 0 { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots }], mem := mem } =
      .fault k := by
  rw [s3_step_state_of_stmt ctx.pTgt _ mem ctx.bodyTgt bbTgt stmt (s3_bodyTgt_get ctx) hBbTgt hStmt]
  exact hEval

private noncomputable def s3_FwdStepSim (ctx : s3_PtrCtx) (f₁ : MemCopyFrame) (m₁ : CallerMemory)
    (f₂ : MemCopyFrame) (m₂ : CallerMemory) : Prop :=
  (∀ s₁', evalStepMemCopy ctx.pSrc 0 { frames := [f₁], mem := m₁ } = .step s₁' →
    ∃ s₂', ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := m₂ } s₂' ∧
      s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂') ∧
  (∀ out, evalStepMemCopy ctx.pSrc 0 { frames := [f₁], mem := m₁ } = .done out →
    ∃ s₂', ReachesMemCopy ctx.pTgt { frames := [f₂], mem := m₂ } s₂' ∧
      StepMemCopy ctx.pTgt s₂' (.done out)) ∧
  (∀ k, evalStepMemCopy ctx.pSrc 0 { frames := [f₁], mem := m₁ } = .fault k →
    ∃ s₂', ReachesMemCopy ctx.pTgt { frames := [f₂], mem := m₂ } s₂' ∧
      StepMemCopy ctx.pTgt s₂' (.fault k))

private theorem s3_reachesPlus_stmt_rel (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁' m₂Init m₂' : CallerMemory}
    {slots₁' slots₂' : List MemCopySlot} {genLen n : Nat}
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length)
    (hIdxNext : f₂.stmtIdx + genLen = s3_loweredStmtIdx ctx bbSrc.statements (f₁.stmtIdx + 1))
    (hReach : ReachesNMemCopy ctx.pTgt (n + 1) { frames := [f₂], mem := m₂Init }
      { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + genLen, locals := slots₂' }], mem := m₂' })
    (hMemEq : m₁' = m₂')
    (hWf' : s3_MemWf ctx.bodySrc slots₁' m₁')
    (hRel' : s3_SlotsRel ctx slots₁' slots₂') :
    ∃ s₂', ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := m₂Init } s₂' ∧
      s3_SimRel ctx ctx.pSrc ctx.pTgt
        { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], mem := m₁' } s₂' := by
  let s₂' : MemCopyState :=
    { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + genLen, locals := slots₂' }], mem := m₂' }
  refine ⟨s₂', ⟨n, hReach⟩, ?_⟩
  unfold s3_SimRel
  rw [hEqId]
  dsimp
  refine ⟨{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' },
      { f₂ with stmtIdx := f₂.stmtIdx + genLen, locals := slots₂' }, m₁', bbSrc,
      rfl, (by rw [hMemEq]), hDef₁, hDef₂, hBbRel, hBbSrc, hLeNext, hIdxNext, hWf', hRel'⟩

private theorem s3_reachesPlus_jump_rel (ctx : s3_PtrCtx)
    {f₁ f₂ : MemCopyFrame} {m₁' m₂Init m₂' : CallerMemory}
    {slots₁' slots₂' : List MemCopySlot} {target : BasicBlockId} {bbTarget : MemCopyBlock} {n : Nat}
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbTarget : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks target = some bbTarget)
    (hReach : ReachesNMemCopy ctx.pTgt (n + 1) { frames := [f₂], mem := m₂Init }
      { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], mem := m₂' })
    (hMemEq : m₁' = m₂')
    (hWf' : s3_MemWf ctx.bodySrc slots₁' m₁')
    (hRel' : s3_SlotsRel ctx slots₁' slots₂') :
    ∃ s₂', ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := m₂Init } s₂' ∧
      s3_SimRel ctx ctx.pSrc ctx.pTgt
        { frames := [{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' }], mem := m₁' } s₂' := by
  let s₂' : MemCopyState :=
    { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }], mem := m₂' }
  refine ⟨s₂', ⟨n, hReach⟩, ?_⟩
  unfold s3_SimRel
  rw [hEqId]
  dsimp
  refine ⟨{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' },
      { f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }, m₁', bbTarget,
      rfl, (by rw [hMemEq]), hDef₁, hDef₂, rfl, hBbTarget, Nat.zero_le _, rfl, hWf', hRel'⟩

private theorem s3_sim_stmt_one (ctx : s3_PtrCtx)
    {bbSrc bbTgt : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    {stmtSrc stmtTgt : MemCopyStmt}
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmtSrc)
    (hIdxNext : f₂.stmtIdx + 1 = s3_loweredStmtIdx ctx bbSrc.statements (f₁.stmtIdx + 1))
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt)
    (hStmtTgt : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = some stmtTgt)
    (hCore :
      (∀ s₁', evalMemCopyStmt ctx.bodySrc f₁ mem stmtSrc = .step s₁' →
        ∃ slots₁' slots₂' mem',
          s₁' = { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], mem := mem' } ∧
          evalMemCopyStmt ctx.bodyTgt f₂ mem stmtTgt = stepMemCopyNext f₂ mem' slots₂' ∧
          s3_MemWf ctx.bodySrc slots₁' mem' ∧
          s3_SlotsRel ctx slots₁' slots₂') ∧
      (∀ out, evalMemCopyStmt ctx.bodySrc f₁ mem stmtSrc = .done out → False) ∧
      (∀ k, evalMemCopyStmt ctx.bodySrc f₁ mem stmtSrc = .fault k →
        evalMemCopyStmt ctx.bodyTgt f₂ mem stmtTgt = .fault k)) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hBodySrc : Trusted.MirSemantics.getElem? ctx.pSrc.bodies f₁.defId = some ctx.bodySrc := by
    rw [hDef₁]; exact ctx.hBodies
  have hBodyTgt : Trusted.MirSemantics.getElem? ctx.pTgt.bodies f₂.defId = some ctx.bodyTgt := by
    rw [hDef₂]; exact s3_bodyTgt_get ctx
  have hEvSrc := s3_step_state_of_stmt ctx.pSrc f₁ mem ctx.bodySrc bbSrc stmtSrc hBodySrc hBbSrc hStmtSrc
  have hEvTgt := s3_step_state_of_stmt ctx.pTgt f₂ mem ctx.bodyTgt bbTgt stmtTgt hBodyTgt hBbTgt hStmtTgt
  have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length := s3_getElem?_some_lt _ _ _ hStmtSrc
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    rw [hEvSrc] at hStep
    cases hCore.1 s₁' hStep with | intro slots₁' h1 =>
    cases h1 with | intro slots₂' h2 =>
    cases h2 with | intro mem' h3 =>
    rw [h3.1]
    have hTgtStep : evalStepMemCopy ctx.pTgt 0 { frames := [f₂], mem := mem } =
        .step { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂' }], mem := mem' } := by
      rw [hEvTgt]; exact h3.2.1
    exact s3_reachesPlus_stmt_rel ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hLeNext hIdxNext
      (s3_reachesN_one hTgtStep) rfl h3.2.2.1 h3.2.2.2
  · intro out hDone
    rw [hEvSrc] at hDone
    exact False.elim (hCore.2.1 out hDone)
  · intro k hFault
    rw [hEvSrc] at hFault
    refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
    rw [stepMemCopy_iff_evalStep, hEvTgt]
    exact hCore.2.2 k hFault

/-! ## Section 2: Scratch Evaluation, Pointer-Component Read/Write, Alignment & Non-Null Gadgets -/

private theorem s3c_usize_decl (ctx : s3_PtrCtx) (j : Nat) (hj : j < 10) :
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals (s3_scrBase ctx + j) = some (.base usizeTy) := by
  have hS := s3_bodyTgt_locals_scratch ctx j (Nat.lt_trans hj (by decide))
  have hB : Nat.blt j 10 = true := (nat_blt_eq_lt _ _).mpr hj
  rw [hB] at hS
  exact hS

private theorem s3c_bool_decl (ctx : s3_PtrCtx) (j : Nat) (hj10 : 10 ≤ j) (hj12 : j < 12) :
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals (s3_scrBase ctx + j) = some (.base .bool) := by
  have hS := s3_bodyTgt_locals_scratch ctx j hj12
  have hB : Nat.blt j 10 = false := by
    cases h : Nat.blt j 10 with
    | false => rfl
    | true => exact False.elim (Nat.not_lt_of_le hj10 ((nat_blt_eq_lt _ _).mp h))
  rw [hB] at hS
  exact hS

private theorem s3_evalPrimOp_usizeConst (decls : List MemCopyLocalDecl) (slots : List MemCopySlot)
    (n : Nat) (hn : n < maxUsize) :
    evalMemCopyPrimitiveOperand decls slots (usizeConst n) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }, slots) := by
  unfold evalMemCopyPrimitiveOperand evalMemCopyBaseOperandToSlot usizeConst
  dsimp
  rw [s3_evalConstLit_usize n hn]
  rfl

private theorem s3_evalPrimOp_scr_copy (ctx : s3_PtrCtx) (slots : List MemCopySlot)
    (j n : Nat) (hj : j < 10)
    (hSlot : Trusted.MirSemantics.getElem? slots (s3_scrBase ctx + j) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }))))) :
    evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots (.copy { localId := s3_scrBase ctx + j, projection := [] }) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }, slots) := by
  unfold evalMemCopyPrimitiveOperand evalMemCopyBaseOperandToSlot
  dsimp
  rw [s3c_usize_decl ctx j hj, hSlot]
  rfl

private theorem s3_evalPrimOp_scr_move (ctx : s3_PtrCtx) (slots : List MemCopySlot)
    (j n : Nat) (hj : j < 10) (hLen : s3_scrBase ctx + j < slots.length)
    (hSlot : Trusted.MirSemantics.getElem? slots (s3_scrBase ctx + j) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }))))) :
    ∃ slots',
      setElem? slots (s3_scrBase ctx + j) (.baseSlot (.live none)) = some slots' ∧
      evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots (.move { localId := s3_scrBase ctx + j, projection := [] }) =
        .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }, slots') := by
  cases s3_setElem?_some_of_lt slots (s3_scrBase ctx + j) (.baseSlot (.live none)) hLen with
  | intro slots' hSet =>
    refine ⟨slots', hSet, ?_⟩
    unfold evalMemCopyPrimitiveOperand evalMemCopyBaseOperandToSlot
    dsimp
    rw [s3c_usize_decl ctx j hj, hSlot]
    dsimp [liveUninitSlot, usizeTy]
    rw [hSet]
    rfl

private theorem s3_exec_mkAssignUse_usize_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (jDst n : Nat) (hj : jDst < 10) (hn : n < maxUsize)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkAssignUse (s3_scrBase ctx + jDst) (usizeConst n))) :
    ∃ slots₂',
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }], mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))) ∧
      (∀ j' : Nat, j' < 12 → j' ≠ jDst →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
  have hj12 : jDst < 12 := Nat.lt_trans hj (by decide)
  cases hRel.2.2.2.2.2 jDst hj12 with | intro ov hOv =>
  have hLt : s3_scrBase ctx + jDst < slots₂.length := by
    rw [hRel.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jDst hj12
  let valSlot : MemCopySlot := .baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))
  cases s3_setElem?_some_of_lt slots₂ (s3_scrBase ctx + jDst) valSlot hLt with | intro slots₂' hSet =>
  refine ⟨slots₂', ?_, ?_, s3_getElem?_setElem?_eq _ _ _ _ hSet, ?_⟩
  · exact s3_reachesN_stmt_step ctx hBbTgt hStmt
      (s3_eval_mkAssignUse_usizeConst ctx.bodyTgt _ mem (s3_scrBase ctx + jDst) n ov slots₂' hn
        (s3c_usize_decl ctx jDst hj) hOv hSet)
  · exact s3_slotsRel_set_scratch ctx slots₁ slots₂ slots₂' jDst _ hj12 hRel hSet
  · intro j' _ hNe
    have hNeLoc : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + j' := fun h => hNe (Nat.add_left_cancel h).symm
    exact s3_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hSet

private theorem s3_exec_mkBinOpStmt_usize_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {slots₁ slots₂ slotsA slotsB : List MemCopySlot} {mem : CallerMemory}
    (jDst : Nat) (bop : BinOp) (lhs rhs : Operand) (vl vr : Val) (vresNat : Nat)
    (hj : jDst < 10) (hv : vresNat < maxUsize)
    (hL : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ lhs = .ok (vl, slotsA))
    (hR : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slotsA rhs = .ok (vr, slotsB))
    (hBin : evalBinOp bop vl vr = .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 vresNat }))
    (hRelB : s3_SlotsRel ctx slots₁ slotsB)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkBinOpStmt (s3_scrBase ctx + jDst) bop lhs rhs)) :
    ∃ slots₂',
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }], mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 vresNat })))) ∧
      (∀ j' : Nat, j' < 12 → j' ≠ jDst →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slotsB (s3_scrBase ctx + j')) := by
  have hj12 : jDst < 12 := Nat.lt_trans hj (by decide)
  cases hRelB.2.2.2.2.2 jDst hj12 with | intro ov hOv =>
  have hLt : s3_scrBase ctx + jDst < slotsB.length := by
    rw [hRelB.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jDst hj12
  let valSlot : MemCopySlot := .baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 vresNat })))
  cases s3_setElem?_some_of_lt slotsB (s3_scrBase ctx + jDst) valSlot hLt with | intro slots₂' hSet =>
  refine ⟨slots₂', ?_, ?_, s3_getElem?_setElem?_eq _ _ _ _ hSet, ?_⟩
  · exact s3_reachesN_stmt_step ctx hBbTgt hStmt
      (s3_eval_mkBinOpStmt_ok ctx.bodyTgt _ mem (s3_scrBase ctx + jDst) usizeTy bop lhs rhs
        vl vr _ ov slotsA slotsB slots₂' (s3c_usize_decl ctx jDst hj) hL hR hBin
        (s3_usize_scalar_checkVal vresNat hv) hOv hSet)
  · exact s3_slotsRel_set_scratch ctx slots₁ slotsB slots₂' jDst _ hj12 hRelB hSet
  · intro j' _ hNe
    have hNeLoc : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + j' := fun h => hNe (Nat.add_left_cancel h).symm
    exact s3_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hSet

private theorem s3_exec_mkBinOpStmt_bool_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {slots₁ slots₂ slotsA slotsB : List MemCopySlot} {mem : CallerMemory}
    (jDst : Nat) (bop : BinOp) (lhs rhs : Operand) (vl vr : Val) (bres : Bool)
    (hj10 : 10 ≤ jDst) (hj12 : jDst < 12)
    (hL : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ lhs = .ok (vl, slotsA))
    (hR : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slotsA rhs = .ok (vr, slotsB))
    (hBin : evalBinOp bop vl vr = .ok (.bool bres))
    (hRelB : s3_SlotsRel ctx slots₁ slotsB)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkBinOpStmt (s3_scrBase ctx + jDst) bop lhs rhs)) :
    ∃ slots₂',
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }], mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
        some (.baseSlot (.live (some (.bool bres)))) ∧
      (∀ j' : Nat, j' < 12 → j' ≠ jDst →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slotsB (s3_scrBase ctx + j')) := by
  cases hRelB.2.2.2.2.2 jDst hj12 with | intro ov hOv =>
  have hLt : s3_scrBase ctx + jDst < slotsB.length := by
    rw [hRelB.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jDst hj12
  cases s3_setElem?_some_of_lt slotsB (s3_scrBase ctx + jDst) (.baseSlot (.live (some (.bool bres)))) hLt with
  | intro slots₂' hSet =>
    refine ⟨slots₂', ?_, ?_, s3_getElem?_setElem?_eq _ _ _ _ hSet, ?_⟩
    · exact s3_reachesN_stmt_step ctx hBbTgt hStmt
        (s3_eval_mkBinOpStmt_ok ctx.bodyTgt _ mem (s3_scrBase ctx + jDst) .bool bop lhs rhs
          vl vr (.bool bres) ov slotsA slotsB slots₂' (s3c_bool_decl ctx jDst hj10 hj12) hL hR hBin
          rfl hOv hSet)
    · exact s3_slotsRel_set_scratch ctx slots₁ slotsB slots₂' jDst _ hj12 hRelB hSet
    · intro j' _ hNe
      have hNeLoc : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + j' := fun h => hNe (Nat.add_left_cancel h).symm
      exact s3_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hSet

private theorem s3_exec_mkSubUncheckedUsize_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {slots₁ slots₂ slotsA slotsB : List MemCopySlot} {mem : CallerMemory}
    (jDst : Nat) (lhs rhs : Operand) (a b : Nat)
    (hj : jDst < 10) (ha : a < maxUsize) (hb : b < maxUsize)
    (hL : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ lhs =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a }, slotsA))
    (hR : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slotsA rhs =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }, slotsB))
    (hRelB : s3_SlotsRel ctx slots₁ slotsB)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkSubUncheckedUsize (s3_scrBase ctx + jDst) lhs rhs)) :
    (b ≤ a →
      ∃ slots₂',
        evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
          .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }], mem := mem } ∧
        s3_SlotsRel ctx slots₁ slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a - b) })))) ∧
        (∀ j' : Nat, j' < 12 → j' ≠ jDst →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slotsB (s3_scrBase ctx + j'))) ∧
    (a < b →
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
        .fault .undefined) := by
  constructor
  · intro hLe
    have hDiffLt : a - b < maxUsize := Nat.lt_of_le_of_lt (Nat.sub_le _ _) ha
    exact s3_exec_mkBinOpStmt_usize_scr ctx jDst .subUnchecked lhs rhs _ _ (a - b)
      hj hDiffLt hL hR (s3_evalBinOp_usize_subUnchecked_ok a b ha hLe) hRelB hBbTgt hStmt
  · intro hLt
    exact s3_reachesN_stmt_fault ctx hBbTgt hStmt
      (s3_eval_mkBinOpStmt_err ctx.bodyTgt _ mem (s3_scrBase ctx + jDst) usizeTy .subUnchecked lhs rhs
        _ _ slotsA slotsB .undefined (s3c_usize_decl ctx jDst hj) hL hR
        (s3_evalBinOp_usize_subUnchecked_err a b ha hb hLt))

private theorem s3_exec_mkAddUncheckedUsize_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {slots₁ slots₂ slotsA slotsB : List MemCopySlot} {mem : CallerMemory}
    (jDst : Nat) (lhs rhs : Operand) (a b : Nat)
    (hj : jDst < 10) (hSum : a + b < maxUsize)
    (hL : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ lhs =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a }, slotsA))
    (hR : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slotsA rhs =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }, slotsB))
    (hRelB : s3_SlotsRel ctx slots₁ slotsB)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkAddUncheckedUsize (s3_scrBase ctx + jDst) lhs rhs)) :
    ∃ slots₂',
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }], mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (a + b) })))) ∧
      (∀ j' : Nat, j' < 12 → j' ≠ jDst →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slotsB (s3_scrBase ctx + j')) :=
  s3_exec_mkBinOpStmt_usize_scr ctx jDst .addUnchecked lhs rhs _ _ (a + b)
    hj hSum hL hR (s3_evalBinOp_usize_addUnchecked_ok a b hSum) hRelB hBbTgt hStmt

private theorem s3_exec_mkRequireZeroUsize_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {slots₁ slots₂ slotsA : List MemCopySlot} {mem : CallerMemory}
    (jDst : Nat) (op : Operand) (v : Nat)
    (hj : jDst < 10) (hv : v < maxUsize)
    (hOp : evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots₂ op =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 v }, slotsA))
    (hRelA : s3_SlotsRel ctx slots₁ slotsA)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkRequireZeroUsize (s3_scrBase ctx + jDst) op)) :
    (v = 0 →
      ∃ slots₂',
        evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
          .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }], mem := mem } ∧
        s3_SlotsRel ctx slots₁ slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 0 })))) ∧
        (∀ j' : Nat, j' < 12 → j' ≠ jDst →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slotsA (s3_scrBase ctx + j'))) ∧
    (0 < v →
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
        .fault .undefined) := by
  constructor
  · intro hv0
    rw [hv0] at hOp
    have hj12 : jDst < 12 := Nat.lt_trans hj (by decide)
    cases hRelA.2.2.2.2.2 jDst hj12 with | intro ov hOv =>
    have hLt : s3_scrBase ctx + jDst < slotsA.length := by
      rw [hRelA.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jDst hj12
    cases s3_setElem?_some_of_lt slotsA (s3_scrBase ctx + jDst)
        (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 0 })))) hLt with
    | intro slots₂' hSet =>
      refine ⟨slots₂', ?_, ?_, s3_getElem?_setElem?_eq _ _ _ _ hSet, ?_⟩
      · exact s3_reachesN_stmt_step ctx hBbTgt hStmt
          (s3_eval_mkRequireZeroUsize_ok ctx.bodyTgt _ mem (s3_scrBase ctx + jDst) op slotsA slots₂' ov
            (s3c_usize_decl ctx jDst hj) hOp hOv hSet)
      · exact s3_slotsRel_set_scratch ctx slots₁ slotsA slots₂' jDst _ hj12 hRelA hSet
      · intro j' _ hNe
        have hNeLoc : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + j' := fun h => hNe (Nat.add_left_cancel h).symm
        exact s3_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hSet
  · intro hvPos
    exact s3_reachesN_stmt_fault ctx hBbTgt hStmt
      (s3_eval_mkRequireZeroUsize_err ctx.bodyTgt _ mem (s3_scrBase ctx + jDst) op v slotsA
        hvPos hv (s3c_usize_decl ctx jDst hj) hOp)

private theorem s3c_findPtrEntry_some (ctx : s3_PtrCtx) (p : LocalId) (k : Nat) (optBuf : Option LocalId)
    (hFind : findPtrEntry ctx.plan.entries p = some (k, optBuf)) :
    ∃ e : PtrBackingEntry,
      Trusted.MirSemantics.getElem? ctx.plan.entries k = some e ∧
      e.ptrLocal = p ∧ e.backingBuf = optBuf :=
  (s3_findPtrEntry_some_iff ctx p k optBuf).mp hFind

private theorem s3c_ptrTagMatches_lt_maxUsize {optBuf : Option LocalId} {pv : PtrVal} {tagVal : Nat}
    (h : s3_PtrTagMatches optBuf pv tagVal) : tagVal < maxUsize := by
  cases optBuf with
  | none =>
    unfold s3_PtrTagMatches at h
    rw [h.2]
    exact s3_nat_pow_pos 2 (Nat.succ_pos 1) 64
  | some _ =>
    unfold s3_PtrTagMatches at h
    cases h with
    | inl h0 => rw [h0.2]; exact s3_nat_pow_pos 2 (Nat.succ_pos 1) 64
    | inr h1 => rw [h1.2]; exact (by decide : 1 < maxUsize)

private theorem s3c_slotsRel_refresh_comp0 (ctx : s3_PtrCtx)
    (slots₁ slots₂ s2a : List MemCopySlot) (kS : Nat) (eS : PtrBackingEntry)
    (optPv : Option PtrVal)
    (hK : Trusted.MirSemantics.getElem? ctx.plan.entries kS = some eS)
    (hLive : Trusted.MirSemantics.getElem? slots₁ eS.ptrLocal = some (.livePtr optPv))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hS2a : setElem? slots₂ (ctx.bodySrc.locals.length + 3 * kS) (.baseSlot (.live (some .unit))) = some s2a) :
    s3_SlotsRel ctx slots₁ s2a := by
  have hEB := s3_ptrEntry_bounds ctx kS eS hK
  have hB0 := s3_compOffset_bounds ctx kS 0 hEB.2.2.2 (Nat.succ_pos 2)
  rw [Nat.add_zero] at hB0
  have hL2a : s2a.length = ctx.bodyTgt.locals.length := by
    rw [s3_setElem?_length _ _ _ _ hS2a]; exact hRel.2.1
  refine ⟨hRel.1, hL2a, ?_, ?_, ?_, ?_⟩
  · intro id ty hD
    have hNe : ctx.bodySrc.locals.length + 3 * kS ≠ id := fun h =>
      Nat.not_lt_of_le (by rw [← h]; exact hB0.1) (s3_getElem?_some_lt _ _ _ hD)
    rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe hS2a]; exact hRel.2.2.1 id ty hD
  · intro bLoc sz al mutab hB
    have hNe : ctx.bodySrc.locals.length + 3 * kS ≠ bLoc := fun h =>
      Nat.not_lt_of_le (by rw [← h]; exact hB0.1) (s3_getElem?_some_lt _ _ _ hB)
    rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe hS2a]; exact hRel.2.2.2.1 bLoc sz al mutab hB
  · intro k' e' hK'
    have hOrig := hRel.2.2.2.2.1 k' e' hK'
    cases s3c_nat_eq_or_ne kS k' with
    | inl hEqK =>
      rw [← hEqK, hK] at hK'; cases hK'; rw [← hEqK] at hOrig; rw [← hEqK]
      unfold s3_PtrSlotEntryRel; unfold s3_PtrSlotEntryRel at hOrig
      rw [hLive] at hOrig; rw [hLive]
      have hNe1 : ctx.bodySrc.locals.length + 3 * kS ≠ ctx.bodySrc.locals.length + 3 * kS + 1 :=
        Nat.ne_of_lt (Nat.lt_succ_self _)
      have hNe2 : ctx.bodySrc.locals.length + 3 * kS ≠ ctx.bodySrc.locals.length + 3 * kS + 2 :=
        s3c_ne_add_two _
      cases optPv with
      | none =>
        dsimp at hOrig; dsimp
        refine ⟨⟨some .unit, s3_getElem?_setElem?_eq _ _ _ _ hS2a⟩, ?_, ?_⟩
        · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe1 hS2a]; exact hOrig.2.1
        · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe2 hS2a]; exact hOrig.2.2
      | some pv =>
        dsimp at hOrig; dsimp
        cases hOrig with | intro tagVal hT =>
        cases hT with | intro ov hOv =>
        refine ⟨tagVal, some .unit, hOv.1, hOv.2.1, s3_getElem?_setElem?_eq _ _ _ _ hS2a, ?_, ?_⟩
        · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe1 hS2a]; exact hOv.2.2.2.1
        · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe2 hS2a]; exact hOv.2.2.2.2
    | inr hNeK =>
      have hNeOff : ∀ r', r' < 3 →
          ctx.bodySrc.locals.length + 3 * kS ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun r' hr' h =>
        hNeK (s3_compOffset_inj ctx.bodySrc.locals.length kS k' 0 r' (Nat.succ_pos 2) hr' (by rw [Nat.add_zero]; exact h)).1
      have hNe0 : ctx.bodySrc.locals.length + 3 * kS ≠ ctx.bodySrc.locals.length + 3 * k' := by
        have h0 := hNeOff 0 (Nat.succ_pos 2); rw [Nat.add_zero] at h0; exact h0
      unfold s3_PtrSlotEntryRel; unfold s3_PtrSlotEntryRel at hOrig
      cases hP : Trusted.MirSemantics.getElem? slots₁ e'.ptrLocal with
      | none => rw [hP] at hOrig; exact False.elim hOrig
      | some slP =>
        rw [hP] at hOrig
        cases slP with
        | baseSlot _ | bufSlot _ => exact False.elim hOrig
        | ptrDead =>
          dsimp at hOrig; dsimp
          rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe0 hS2a,
              s3_getElem?_setElem?_ne _ _ _ _ _ (hNeOff 1 (by decide)) hS2a,
              s3_getElem?_setElem?_ne _ _ _ _ _ (hNeOff 2 (by decide)) hS2a]
          exact hOrig
        | livePtr optPv' =>
          cases optPv' with
          | none =>
            dsimp at hOrig; dsimp
            cases hOrig.1 with | intro ov hOv =>
            refine ⟨⟨ov, ?_⟩, ?_, ?_⟩
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe0 hS2a]; exact hOv
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ (hNeOff 1 (by decide)) hS2a]; exact hOrig.2.1
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ (hNeOff 2 (by decide)) hS2a]; exact hOrig.2.2
          | some pv' =>
            dsimp at hOrig; dsimp
            cases hOrig with | intro tagVal hT =>
            cases hT with | intro ov hOv =>
            refine ⟨tagVal, ov, hOv.1, hOv.2.1, ?_, ?_, ?_⟩
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe0 hS2a]; exact hOv.2.2.1
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ (hNeOff 1 (by decide)) hS2a]; exact hOv.2.2.2.1
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ (hNeOff 2 (by decide)) hS2a]; exact hOv.2.2.2.2
  · intro j hj
    have hNeScr : ctx.bodySrc.locals.length + 3 * kS ≠ s3_scrBase ctx + j := fun h =>
      Nat.not_lt_of_le (Nat.le_add_right (s3_scrBase ctx) j) (by rw [← h]; exact hB0.2)
    cases hRel.2.2.2.2.2 j hj with | intro ov hOv =>
    refine ⟨ov, ?_⟩
    rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeScr hS2a]; exact hOv

private theorem s3c_slotsRel_move_ptr_to_scr (ctx : s3_PtrCtx)
    (slots₁ slots₁' s2a s2b0 s2b1 s2c0 s2c1 : List MemCopySlot)
    (kS jTag jOff : Nat) (eS : PtrBackingEntry) (tagVal offVal : Nat)
    (hK : Trusted.MirSemantics.getElem? ctx.plan.entries kS = some eS)
    (hjTag : jTag < 10) (hjOff : jOff < 10) (hjNe : jTag ≠ jOff)
    (hRelA : s3_SlotsRel ctx slots₁ s2a)
    (hS1 : setElem? slots₁ eS.ptrLocal (.livePtr none) = some slots₁')
    (hS2a : Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * kS) = some (.baseSlot (.live (some .unit))))
    (hS2b0 : setElem? s2a (ctx.bodySrc.locals.length + 3 * kS + 1) (.baseSlot (.live none)) = some s2b0)
    (hS2b1 : setElem? s2b0 (s3_scrBase ctx + jTag)
      (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) = some s2b1)
    (hS2c0 : setElem? s2b1 (ctx.bodySrc.locals.length + 3 * kS + 2) (.baseSlot (.live none)) = some s2c0)
    (hS2c1 : setElem? s2c0 (s3_scrBase ctx + jOff)
      (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))) = some s2c1) :
    s3_SlotsRel ctx slots₁' s2c1 ∧
    Trusted.MirSemantics.getElem? s2c1 (s3_scrBase ctx + jTag) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) ∧
    Trusted.MirSemantics.getElem? s2c1 (s3_scrBase ctx + jOff) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))) ∧
    (∀ j' : Nat, j' < 12 → j' ≠ jTag → j' ≠ jOff →
      Trusted.MirSemantics.getElem? s2c1 (s3_scrBase ctx + j') =
        Trusted.MirSemantics.getElem? s2a (s3_scrBase ctx + j')) := by
  have hEB := s3_ptrEntry_bounds ctx kS eS hK
  have hB0 := s3_compOffset_bounds ctx kS 0 hEB.2.2.2 (Nat.succ_pos 2)
  have hB1 := s3_compOffset_bounds ctx kS 1 hEB.2.2.2 (by decide)
  have hB2 := s3_compOffset_bounds ctx kS 2 hEB.2.2.2 (by decide)
  rw [Nat.add_zero] at hB0
  have hjTag12 : jTag < 12 := Nat.lt_trans hjTag (by decide)
  have hjOff12 : jOff < 12 := Nat.lt_trans hjOff (by decide)
  have hLenC1 : s2c1.length = ctx.bodyTgt.locals.length := by
    rw [s3_setElem?_length _ _ _ _ hS2c1, s3_setElem?_length _ _ _ _ hS2c0,
        s3_setElem?_length _ _ _ _ hS2b1, s3_setElem?_length _ _ _ _ hS2b0]
    exact hRelA.2.1
  have hPresLt : ∀ x, x < ctx.bodySrc.locals.length →
      Trusted.MirSemantics.getElem? s2c1 x = Trusted.MirSemantics.getElem? s2a x := by
    intro x hx
    have hN1 : ctx.bodySrc.locals.length + 3 * kS + 1 ≠ x := fun h => Nat.not_lt_of_le (by rw [← h]; exact hB1.1) hx
    have hN2 : ctx.bodySrc.locals.length + 3 * kS + 2 ≠ x := fun h => Nat.not_lt_of_le (by rw [← h]; exact hB2.1) hx
    have hNt : s3_scrBase ctx + jTag ≠ x := fun h =>
      Nat.not_lt_of_le (Nat.le_trans (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)) (by rw [← h]; exact Nat.le_refl _)) hx
    have hNo : s3_scrBase ctx + jOff ≠ x := fun h =>
      Nat.not_lt_of_le (Nat.le_trans (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)) (by rw [← h]; exact Nat.le_refl _)) hx
    rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNo hS2c1,
        s3_getElem?_setElem?_ne _ _ _ _ _ hN2 hS2c0,
        s3_getElem?_setElem?_ne _ _ _ _ _ hNt hS2b1,
        s3_getElem?_setElem?_ne _ _ _ _ _ hN1 hS2b0]
  have hPresOtherScr : ∀ j' : Nat, j' ≠ jTag → j' ≠ jOff →
      Trusted.MirSemantics.getElem? s2c1 (s3_scrBase ctx + j') =
        Trusted.MirSemantics.getElem? s2a (s3_scrBase ctx + j') := by
    intro j' hNjT hNjO
    have hN1 : ctx.bodySrc.locals.length + 3 * kS + 1 ≠ s3_scrBase ctx + j' := fun h =>
      Nat.not_lt_of_le (Nat.le_add_right (s3_scrBase ctx) j') (by rw [← h]; exact hB1.2)
    have hN2 : ctx.bodySrc.locals.length + 3 * kS + 2 ≠ s3_scrBase ctx + j' := fun h =>
      Nat.not_lt_of_le (Nat.le_add_right (s3_scrBase ctx) j') (by rw [← h]; exact hB2.2)
    have hNt : s3_scrBase ctx + jTag ≠ s3_scrBase ctx + j' := fun h => hNjT (Nat.add_left_cancel h).symm
    have hNo : s3_scrBase ctx + jOff ≠ s3_scrBase ctx + j' := fun h => hNjO (Nat.add_left_cancel h).symm
    rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNo hS2c1,
        s3_getElem?_setElem?_ne _ _ _ _ _ hN2 hS2c0,
        s3_getElem?_setElem?_ne _ _ _ _ _ hNt hS2b1,
        s3_getElem?_setElem?_ne _ _ _ _ _ hN1 hS2b0]
  have hScrTagEq : Trusted.MirSemantics.getElem? s2c1 (s3_scrBase ctx + jTag) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) := by
    have hNo : s3_scrBase ctx + jOff ≠ s3_scrBase ctx + jTag := fun h => hjNe (Nat.add_left_cancel h).symm
    have hN2 : ctx.bodySrc.locals.length + 3 * kS + 2 ≠ s3_scrBase ctx + jTag := fun h =>
      Nat.not_lt_of_le (Nat.le_add_right (s3_scrBase ctx) jTag) (by rw [← h]; exact hB2.2)
    rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNo hS2c1,
        s3_getElem?_setElem?_ne _ _ _ _ _ hN2 hS2c0,
        s3_getElem?_setElem?_eq _ _ _ _ hS2b1]
  have hScrOffEq : Trusted.MirSemantics.getElem? s2c1 (s3_scrBase ctx + jOff) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))) :=
    s3_getElem?_setElem?_eq _ _ _ _ hS2c1
  refine ⟨⟨?_, hLenC1, ?_, ?_, ?_, ?_⟩, hScrTagEq, hScrOffEq, fun j' _ h1 h2 => hPresOtherScr j' h1 h2⟩
  · rw [s3_setElem?_length _ _ _ _ hS1]; exact hRelA.1
  · intro id ty hD
    have hIdLt := s3_getElem?_some_lt _ _ _ hD
    have hNeP : eS.ptrLocal ≠ id := fun h => by rw [h, hD] at hEB; cases hEB.2.2.1
    rw [hPresLt id hIdLt, s3_getElem?_setElem?_ne _ _ _ _ _ hNeP hS1]; exact hRelA.2.2.1 id ty hD
  · intro bLoc sz al mutab hB
    have hBLt := s3_getElem?_some_lt _ _ _ hB
    have hNeP : eS.ptrLocal ≠ bLoc := fun h => by rw [h, hB] at hEB; cases hEB.2.2.1
    rw [hPresLt bLoc hBLt, s3_getElem?_setElem?_ne _ _ _ _ _ hNeP hS1]; exact hRelA.2.2.2.1 bLoc sz al mutab hB
  · intro k' e' hK'
    cases s3c_nat_eq_or_ne kS k' with
    | inl hEqK =>
      rw [← hEqK, hK] at hK'; cases hK'; rw [← hEqK]
      unfold s3_PtrSlotEntryRel
      rw [s3_getElem?_setElem?_eq _ _ _ _ hS1]
      have hN1_0 : ctx.bodySrc.locals.length + 3 * kS + 1 ≠ ctx.bodySrc.locals.length + 3 * kS :=
        (Nat.ne_of_lt (Nat.lt_succ_self _)).symm
      have hN2_0 : ctx.bodySrc.locals.length + 3 * kS + 2 ≠ ctx.bodySrc.locals.length + 3 * kS :=
        (s3c_ne_add_two _).symm
      have hN2_1 : ctx.bodySrc.locals.length + 3 * kS + 2 ≠ ctx.bodySrc.locals.length + 3 * kS + 1 :=
        (Nat.ne_of_lt (Nat.lt_succ_self _)).symm
      have hNt_0 := s3c_scr_ne_comp0 ctx (j := jTag) hB0.2
      have hNo_0 := s3c_scr_ne_comp0 ctx (j := jOff) hB0.2
      have hNt_1 := s3c_scr_ne_comp ctx (j := jTag) hB1.2
      have hNo_1 := s3c_scr_ne_comp ctx (j := jOff) hB1.2
      have hNo_2 := s3c_scr_ne_comp ctx (j := jOff) hB2.2
      refine ⟨⟨some .unit, ?_⟩, ?_, ?_⟩
      · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNo_0 hS2c1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hN2_0 hS2c0,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNt_0 hS2b1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hN1_0 hS2b0, hS2a]
      · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNo_1 hS2c1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hN2_1 hS2c0,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNt_1 hS2b1,
            s3_getElem?_setElem?_eq _ _ _ _ hS2b0]
      · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNo_2 hS2c1,
            s3_getElem?_setElem?_eq _ _ _ _ hS2c0]
    | inr hNeK =>
      have hNeP : eS.ptrLocal ≠ e'.ptrLocal := fun h => hNeK (s3_ptrEntry_inj ctx kS k' eS e' hK hK' h)
      have hPresComp : ∀ r', r' < 3 →
          Trusted.MirSemantics.getElem? s2c1 (ctx.bodySrc.locals.length + 3 * k' + r') =
            Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * k' + r') := by
        intro r' hr'
        have hK'B := s3_compOffset_bounds ctx k' r' (s3_ptrEntry_bounds ctx k' e' hK').2.2.2 hr'
        have hN1 : ctx.bodySrc.locals.length + 3 * kS + 1 ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun h =>
          hNeK (s3_compOffset_inj ctx.bodySrc.locals.length kS k' 1 r' (by decide) hr' h).1
        have hN2 : ctx.bodySrc.locals.length + 3 * kS + 2 ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun h =>
          hNeK (s3_compOffset_inj ctx.bodySrc.locals.length kS k' 2 r' (by decide) hr' h).1
        have hNt : s3_scrBase ctx + jTag ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun h =>
          Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [h]; exact hK'B.2)
        have hNo : s3_scrBase ctx + jOff ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun h =>
          Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [h]; exact hK'B.2)
        rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNo hS2c1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hN2 hS2c0,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNt hS2b1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hN1 hS2b0]
      have hPres0 : Trusted.MirSemantics.getElem? s2c1 (ctx.bodySrc.locals.length + 3 * k') =
          Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * k') := by
        have h0 := hPresComp 0 (Nat.succ_pos 2); rw [Nat.add_zero] at h0; exact h0
      have hOrig := hRelA.2.2.2.2.1 k' e' hK'
      unfold s3_PtrSlotEntryRel; unfold s3_PtrSlotEntryRel at hOrig
      rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeP hS1]
      cases hP : Trusted.MirSemantics.getElem? slots₁ e'.ptrLocal with
      | none => rw [hP] at hOrig; exact False.elim hOrig
      | some slP =>
        rw [hP] at hOrig
        cases slP with
        | baseSlot _ | bufSlot _ => exact False.elim hOrig
        | ptrDead =>
          dsimp at hOrig; dsimp
          rw [hPres0, hPresComp 1 (by decide), hPresComp 2 (by decide)]; exact hOrig
        | livePtr optPv' =>
          cases optPv' with
          | none =>
            dsimp at hOrig; dsimp
            cases hOrig.1 with | intro ov hOv =>
            refine ⟨⟨ov, ?_⟩, ?_, ?_⟩
            · rw [hPres0]; exact hOv
            · rw [hPresComp 1 (by decide)]; exact hOrig.2.1
            · rw [hPresComp 2 (by decide)]; exact hOrig.2.2
          | some pv' =>
            dsimp at hOrig; dsimp
            cases hOrig with | intro tv hT =>
            cases hT with | intro ov hOv =>
            refine ⟨tv, ov, hOv.1, hOv.2.1, ?_, ?_, ?_⟩
            · rw [hPres0]; exact hOv.2.2.1
            · rw [hPresComp 1 (by decide)]; exact hOv.2.2.2.1
            · rw [hPresComp 2 (by decide)]; exact hOv.2.2.2.2
  · intro j hj
    cases s3c_nat_eq_or_ne j jTag with
    | inl hEq => rw [hEq]; exact ⟨_, hScrTagEq⟩
    | inr hNjT =>
      cases s3c_nat_eq_or_ne j jOff with
      | inl hEq => rw [hEq]; exact ⟨_, hScrOffEq⟩
      | inr hNjO =>
        cases hRelA.2.2.2.2.2 j hj with | intro ov hOv =>
        refine ⟨ov, ?_⟩
        rw [hPresOtherScr j hNjT hNjO]; exact hOv

private theorem s3c_eval_mkAssignUse_readComp (ctx : s3_PtrCtx) (frame : MemCopyFrame) (mem : CallerMemory)
    (srcLoc dstLoc : LocalId) (n : Nat) (isMove : Bool)
    (slotsA slotsB : List MemCopySlot) (ovDst : Option Val)
    (hn : n < maxUsize)
    (hDeclSrc : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals srcLoc = some (.base usizeTy))
    (hDeclDst : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals dstLoc = some (.base usizeTy))
    (hSlotSrc : Trusted.MirSemantics.getElem? frame.locals srcLoc =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))))
    (hAfterSrc : if isMove then setElem? frame.locals srcLoc (.baseSlot (.live none)) = some slotsA else slotsA = frame.locals)
    (hSlotDst : Trusted.MirSemantics.getElem? slotsA dstLoc = some (.baseSlot (.live ovDst)))
    (hSetDst : setElem? slotsA dstLoc
      (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))) = some slotsB) :
    evalMemCopyStmt ctx.bodyTgt frame mem
      (mkAssignUse dstLoc (if isMove then .move { localId := srcLoc, projection := [] }
        else .copy { localId := srcLoc, projection := [] })) =
      stepMemCopyNext frame mem slotsB := by
  have hChk : checkVal (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }) usizeTy = true :=
    s3_usize_scalar_checkVal n hn
  have hLu : liveUninitSlot usizeTy = .live none := rfl
  have hBeq : MirTy.beq usizeTy usizeTy = true := rfl
  cases isMove with
  | false =>
    dsimp at hAfterSrc
    rw [hAfterSrc] at hSlotDst hSetDst
    unfold mkAssignUse evalMemCopyStmt
    dsimp
    rw [hDeclDst]; dsimp
    unfold evalMemCopyBaseRvalue evalMemCopyBaseOperandToSlot
    dsimp
    rw [hDeclSrc, hSlotSrc]; dsimp; rw [hBeq]; dsimp
    unfold writeMemCopyBasePlace
    rw [hChk]; dsimp
    rw [hSlotDst]; dsimp
    rw [hSetDst]
  | true =>
    dsimp at hAfterSrc
    unfold mkAssignUse evalMemCopyStmt
    dsimp
    rw [hDeclDst]; dsimp
    unfold evalMemCopyBaseRvalue evalMemCopyBaseOperandToSlot
    dsimp
    rw [hDeclSrc, hSlotSrc]; dsimp; rw [hLu, hAfterSrc]; dsimp; rw [hBeq]; dsimp
    unfold writeMemCopyBasePlace
    rw [hChk]; dsimp
    rw [hSlotDst]; dsimp
    rw [hSetDst]

private theorem s3c_eval_mkAssignUse_readComp_none (ctx : s3_PtrCtx) (frame : MemCopyFrame) (mem : CallerMemory)
    (srcLoc dstLoc : LocalId) (isMove : Bool) (slotsA : List MemCopySlot)
    (hDeclSrc : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals srcLoc = some (.base usizeTy))
    (hDeclDst : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals dstLoc = some (.base usizeTy))
    (hSlotSrc : Trusted.MirSemantics.getElem? frame.locals srcLoc = some (.baseSlot (.live none)))
    (hAfterSrc : if isMove then setElem? frame.locals srcLoc (.baseSlot (.live none)) = some slotsA else slotsA = frame.locals) :
    evalMemCopyStmt ctx.bodyTgt frame mem
      (mkAssignUse dstLoc (if isMove then .move { localId := srcLoc, projection := [] }
        else .copy { localId := srcLoc, projection := [] })) =
      .fault .undefined := by
  have hLu : liveUninitSlot usizeTy = .live none := rfl
  have hBeq : MirTy.beq usizeTy usizeTy = true := rfl
  cases isMove with
  | false =>
    unfold mkAssignUse evalMemCopyStmt
    dsimp
    rw [hDeclDst]; dsimp
    unfold evalMemCopyBaseRvalue evalMemCopyBaseOperandToSlot
    dsimp
    rw [hDeclSrc, hSlotSrc]; dsimp; rw [hBeq]; rfl
  | true =>
    dsimp at hAfterSrc
    unfold mkAssignUse evalMemCopyStmt
    dsimp
    rw [hDeclDst]; dsimp
    unfold evalMemCopyBaseRvalue evalMemCopyBaseOperandToSlot
    dsimp
    rw [hDeclSrc, hSlotSrc]; dsimp; rw [hLu, hAfterSrc]; dsimp; rw [hBeq]; rfl

private theorem s3_exec_readPtr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {startIdx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (pLoc : LocalId) (kS jTag jOff : Nat) (optBuf : Option LocalId) (isMove : Bool)
    (hFind : findPtrEntry ctx.plan.entries pLoc = some (kS, optBuf))
    (hjTag : jTag < 10) (hjOff : jOff < 10) (hjNe : jTag ≠ jOff)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hS0 : Trusted.MirSemantics.getElem? bbTgt.statements startIdx =
      some (mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kS)))
    (hS1 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 1) =
      some (mkAssignUse (s3_scrBase ctx + jTag)
        (if isMove then .move { localId := ctx.bodySrc.locals.length + 3 * kS + 1, projection := [] }
         else .copy { localId := ctx.bodySrc.locals.length + 3 * kS + 1, projection := [] })))
    (hS2 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 2) =
      some (mkAssignUse (s3_scrBase ctx + jOff)
        (if isMove then .move { localId := ctx.bodySrc.locals.length + 3 * kS + 2, projection := [] }
         else .copy { localId := ctx.bodySrc.locals.length + 3 * kS + 2, projection := [] }))) :
    match readPtrLocal ctx.bodySrc.locals slots₁ pLoc isMove with
    | .error err =>
      ∃ (n : Nat) (sBad : MemCopyState),
        ReachesNMemCopy ctx.pTgt n
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          sBad ∧
        evalStepMemCopy ctx.pTgt 0 sBad = .fault err
    | .ok (pv, slots₁') =>
      ∃ (tagVal : Nat) (slots₂' : List MemCopySlot),
        pv.width = .isize ∧
        s3_PtrTagMatches optBuf pv tagVal ∧
        tagVal < maxUsize ∧
        ReachesNMemCopy ctx.pTgt 3
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := slots₂' }], mem := mem } ∧
        s3_MemWf ctx.bodySrc slots₁' mem ∧
        s3_SlotsRel ctx slots₁' slots₂' ∧
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jTag) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) ∧
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jOff) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) ∧
        (∀ j' : Nat, j' < 12 → j' ≠ jTag → j' ≠ jOff →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
  cases s3c_findPtrEntry_some ctx pLoc kS optBuf hFind with | intro eS hES =>
  have hEB := s3_ptrEntry_bounds ctx kS eS hES.1
  have hCompDecls := s3_bodyTgt_locals_comp ctx kS hEB.2.2.2
  have hOrig := hRel.2.2.2.2.1 kS eS hES.1
  have hjTag12 : jTag < 12 := Nat.lt_trans hjTag (by decide)
  have hjOff12 : jOff < 12 := Nat.lt_trans hjOff (by decide)
  have hB0 := s3_compOffset_bounds ctx kS 0 hEB.2.2.2 (Nat.succ_pos 2)
  have hB1 := s3_compOffset_bounds ctx kS 1 hEB.2.2.2 (by decide)
  have hB2 := s3_compOffset_bounds ctx kS 2 hEB.2.2.2 (by decide)
  rw [Nat.add_zero] at hB0
  have hLtComp0 : ctx.bodySrc.locals.length + 3 * kS < slots₂.length := by
    rw [hRel.2.1, s3_bodyTgt_locals_length]
    exact Nat.lt_of_lt_of_le hB0.2 (Nat.le_add_right _ _)
  unfold readPtrLocal
  rw [hES.2.1] at hEB
  rw [hEB.2.2.1]
  unfold s3_PtrSlotEntryRel at hOrig
  rw [hES.2.1] at hOrig
  cases hSlotP : Trusted.MirSemantics.getElem? slots₁ pLoc with
  | none => rw [hSlotP] at hOrig; exact False.elim hOrig
  | some slP =>
    rw [hSlotP] at hOrig
    cases slP with
    | baseSlot _ | bufSlot _ => exact False.elim hOrig
    | ptrDead =>
      dsimp at hOrig; dsimp
      refine ⟨0, _, .zero _, ?_⟩
      exact s3_reachesN_stmt_fault ctx hBbTgt hS0
        (s3_eval_mkLivenessCheckStmt_dead ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kS)
          hCompDecls.1 hOrig.1)
    | livePtr optPv =>
      cases optPv with
      | none =>
        dsimp at hOrig; dsimp
        cases hOrig.1 with | intro ov0 hOv0 =>
        cases s3_setElem?_some_of_lt slots₂ (ctx.bodySrc.locals.length + 3 * kS) (.baseSlot (.live (some .unit))) hLtComp0 with
        | intro s2a hS2a =>
          have hStep0 : evalStepMemCopy ctx.pTgt 0
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem } =
              .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } :=
            s3_reachesN_stmt_step ctx hBbTgt hS0
              (s3_eval_mkLivenessCheckStmt_ok ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kS) ov0 s2a
                hCompDecls.1 hOv0 hS2a)
          have hNe01 : ctx.bodySrc.locals.length + 3 * kS ≠ ctx.bodySrc.locals.length + 3 * kS + 1 :=
            Nat.ne_of_lt (Nat.lt_succ_self _)
          have hS2a1 : Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * kS + 1) = some (.baseSlot (.live none)) := by
            rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe01 hS2a]; exact hOrig.2.1
          have hLtComp1 : ctx.bodySrc.locals.length + 3 * kS + 1 < s2a.length := by
            rw [s3_setElem?_length _ _ _ _ hS2a, hRel.2.1, s3_bodyTgt_locals_length]
            exact Nat.lt_of_lt_of_le hB1.2 (Nat.le_add_right _ _)
          have hAfterSrc : ∃ sA, if isMove then setElem? s2a (ctx.bodySrc.locals.length + 3 * kS + 1) (.baseSlot (.live none)) = some sA else sA = s2a := by
            cases isMove with
            | false => exact ⟨s2a, rfl⟩
            | true => exact s3_setElem?_some_of_lt _ _ _ hLtComp1
          cases hAfterSrc with | intro sA hA =>
          have hFault1 : evalStepMemCopy ctx.pTgt 0
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } =
              .fault .undefined :=
            s3_reachesN_stmt_fault ctx hBbTgt hS1
              (s3c_eval_mkAssignUse_readComp_none ctx _ mem _ _ isMove sA
                hCompDecls.2.1 (s3c_usize_decl ctx jTag hjTag) hS2a1 hA)
          exact ⟨1, _, s3_reachesN_one hStep0, hFault1⟩
      | some pv =>
        dsimp at hOrig; dsimp
        cases hOrig with | intro tagVal hT =>
        cases hT with | intro ov0 hOv =>
        have hTagMatch : s3_PtrTagMatches optBuf pv tagVal := by
          rw [← hES.2.2]; exact hOv.2.1
        have hTagLt : tagVal < maxUsize := s3c_ptrTagMatches_lt_maxUsize hTagMatch
        have hOffLt : pv.offsetBytes.toNat < maxUsize := s3_u64_toNat_lt pv.offsetBytes
        cases s3_setElem?_some_of_lt slots₂ (ctx.bodySrc.locals.length + 3 * kS) (.baseSlot (.live (some .unit))) hLtComp0 with
        | intro s2a hS2a =>
          have hStep0 : evalStepMemCopy ctx.pTgt 0
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem } =
              .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } :=
            s3_reachesN_stmt_step ctx hBbTgt hS0
              (s3_eval_mkLivenessCheckStmt_ok ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kS) ov0 s2a
                hCompDecls.1 hOv.2.2.1 hS2a)
          have hLiveA : s3_SlotsRel ctx slots₁ s2a :=
            s3c_slotsRel_refresh_comp0 ctx slots₁ slots₂ s2a kS eS (some pv) hES.1
              (by rw [hES.2.1]; exact hSlotP) hRel hS2a
          have hNe01 : ctx.bodySrc.locals.length + 3 * kS ≠ ctx.bodySrc.locals.length + 3 * kS + 1 :=
            Nat.ne_of_lt (Nat.lt_succ_self _)
          have hS2a1 : Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * kS + 1) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) := by
            rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe01 hS2a]; exact hOv.2.2.2.1
          have hNe02 : ctx.bodySrc.locals.length + 3 * kS ≠ ctx.bodySrc.locals.length + 3 * kS + 2 :=
            s3c_ne_add_two _
          have hS2a2 : Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * kS + 2) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) := by
            rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe02 hS2a]; exact hOv.2.2.2.2
          have hPresScrA : ∀ j', j' < 12 →
              Trusted.MirSemantics.getElem? s2a (s3_scrBase ctx + j') =
                Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') := by
            intro j' _
            have hNe : ctx.bodySrc.locals.length + 3 * kS ≠ s3_scrBase ctx + j' := fun h =>
              Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB0.2)
            exact s3_getElem?_setElem?_ne _ _ _ _ _ hNe hS2a
          cases isMove with
          | false =>
            dsimp
            cases hLiveA.2.2.2.2.2 jTag hjTag12 with | intro ovTag hOvTag =>
            have hLtTag : s3_scrBase ctx + jTag < s2a.length := by rw [hLiveA.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jTag hjTag12
            cases s3_setElem?_some_of_lt s2a (s3_scrBase ctx + jTag)
                (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) hLtTag with
            | intro s2b hS2b =>
              have hStep1 : evalStepMemCopy ctx.pTgt 0
                  { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } =
                  .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := s2b }], mem := mem } :=
                s3_reachesN_stmt_step ctx hBbTgt hS1
                  (s3c_eval_mkAssignUse_readComp ctx _ mem _ _ tagVal false s2a s2b ovTag hTagLt
                    hCompDecls.2.1 (s3c_usize_decl ctx jTag hjTag) hS2a1 rfl hOvTag hS2b)
              have hLiveB := s3_slotsRel_set_scratch ctx slots₁ s2a s2b jTag _ hjTag12 hLiveA hS2b
              have hNeTag2 := s3c_scr_ne_comp ctx (j := jTag) hB2.2
              have hS2b2 : Trusted.MirSemantics.getElem? s2b (ctx.bodySrc.locals.length + 3 * kS + 2) =
                  some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) := by
                rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeTag2 hS2b]; exact hS2a2
              cases hLiveB.2.2.2.2.2 jOff hjOff12 with | intro ovOff hOvOff =>
              have hLtOff : s3_scrBase ctx + jOff < s2b.length := by rw [hLiveB.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jOff hjOff12
              cases s3_setElem?_some_of_lt s2b (s3_scrBase ctx + jOff)
                  (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) hLtOff with
              | intro s2c hS2c =>
                have hStep2 : evalStepMemCopy ctx.pTgt 0
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := s2b }], mem := mem } =
                    .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2c }], mem := mem } :=
                  s3_reachesN_stmt_step ctx hBbTgt hS2
                    (s3c_eval_mkAssignUse_readComp ctx _ mem _ _ pv.offsetBytes.toNat false s2b s2c ovOff hOffLt
                      hCompDecls.2.2 (s3c_usize_decl ctx jOff hjOff) hS2b2 rfl hOvOff hS2c)
                have hLiveC := s3_slotsRel_set_scratch ctx slots₁ s2b s2c jOff _ hjOff12 hLiveB hS2c
                have hNeTagOff : s3_scrBase ctx + jOff ≠ s3_scrBase ctx + jTag := fun h => hjNe (Nat.add_left_cancel h).symm
                have hReach3 : ReachesNMemCopy ctx.pTgt 3
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2c }], mem := mem } :=
                  s3_reachesN_cons hStep0 (s3_reachesN_cons hStep1 (s3_reachesN_one hStep2))
                refine ⟨tagVal, s2c, hOv.1, hTagMatch, hTagLt, hReach3, hWf, hLiveC, ?_, s3_getElem?_setElem?_eq _ _ _ _ hS2c, ?_⟩
                · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeTagOff hS2c]; exact s3_getElem?_setElem?_eq _ _ _ _ hS2b
                · intro j' hj' h1 h2
                  have hNo1 : s3_scrBase ctx + jTag ≠ s3_scrBase ctx + j' := fun h => h1 (Nat.add_left_cancel h).symm
                  have hNo2 : s3_scrBase ctx + jOff ≠ s3_scrBase ctx + j' := fun h => h2 (Nat.add_left_cancel h).symm
                  rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNo2 hS2c, s3_getElem?_setElem?_ne _ _ _ _ _ hNo1 hS2b, hPresScrA j' hj']
          | true =>
            dsimp
            have hLtP : pLoc < slots₁.length := by rw [hRel.1]; exact s3_getElem?_some_lt _ _ _ hEB.2.2.1
            cases s3_setElem?_some_of_lt slots₁ pLoc (.livePtr none) hLtP with | intro slots₁' hS1' =>
            rw [hS1']; dsimp
            have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals pLoc ≠ some (.byteBuf sz al mutab) :=
              fun _ _ _ h => by rw [hEB.2.2.1] at h; cases h
            have hBaseOk : ∀ ty' v', Trusted.MirSemantics.getElem? ctx.bodySrc.locals pLoc = some (.base ty') →
                MemCopySlot.livePtr none = .baseSlot (.live (some v')) → checkVal v' ty' = true :=
              fun _ _ _ h => by cases h
            have hWf' := s3_memWf_set_nonBuf ctx.bodySrc slots₁ slots₁' mem pLoc (.livePtr none) hWf hNotBuf hBaseOk hS1'
            have hLtComp1 : ctx.bodySrc.locals.length + 3 * kS + 1 < s2a.length := by
              rw [hLiveA.2.1, s3_bodyTgt_locals_length]
              exact Nat.lt_of_lt_of_le hB1.2 (Nat.le_add_right _ _)
            cases s3_setElem?_some_of_lt s2a (ctx.bodySrc.locals.length + 3 * kS + 1) (.baseSlot (.live none)) hLtComp1 with
            | intro s2b0 hS2b0 =>
              have hLtTag : s3_scrBase ctx + jTag < s2b0.length := by
                rw [s3_setElem?_length _ _ _ _ hS2b0, hLiveA.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jTag hjTag12
              have hNeC1T : ctx.bodySrc.locals.length + 3 * kS + 1 ≠ s3_scrBase ctx + jTag := fun h =>
                Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB1.2)
              cases hLiveA.2.2.2.2.2 jTag hjTag12 with | intro ovTag hOvTag =>
              have hOvTag0 : Trusted.MirSemantics.getElem? s2b0 (s3_scrBase ctx + jTag) = some (.baseSlot (.live ovTag)) := by
                rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeC1T hS2b0]; exact hOvTag
              cases s3_setElem?_some_of_lt s2b0 (s3_scrBase ctx + jTag)
                  (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) hLtTag with
              | intro s2b1 hS2b1 =>
                have hStep1 : evalStepMemCopy ctx.pTgt 0
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } =
                    .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := s2b1 }], mem := mem } :=
                  s3_reachesN_stmt_step ctx hBbTgt hS1
                    (s3c_eval_mkAssignUse_readComp ctx _ mem _ _ tagVal true s2b0 s2b1 ovTag hTagLt
                      hCompDecls.2.1 (s3c_usize_decl ctx jTag hjTag) hS2a1 hS2b0 hOvTag0 hS2b1)
                have hLtComp2 : ctx.bodySrc.locals.length + 3 * kS + 2 < s2b1.length := by
                  rw [s3_setElem?_length _ _ _ _ hS2b1, s3_setElem?_length _ _ _ _ hS2b0, hLiveA.2.1, s3_bodyTgt_locals_length]
                  exact Nat.lt_of_lt_of_le hB2.2 (Nat.le_add_right _ _)
                have hNeC12 : ctx.bodySrc.locals.length + 3 * kS + 1 ≠ ctx.bodySrc.locals.length + 3 * kS + 2 :=
                  Nat.ne_of_lt (Nat.lt_succ_self _)
                have hNeTag2 : s3_scrBase ctx + jTag ≠ ctx.bodySrc.locals.length + 3 * kS + 2 := by
                  intro h
                  have hB2' := hB2.2
                  rw [← h] at hB2'
                  exact Nat.not_lt_of_le (Nat.le_add_right (s3_scrBase ctx) jTag) hB2'
                have hS2b1_2 : Trusted.MirSemantics.getElem? s2b1 (ctx.bodySrc.locals.length + 3 * kS + 2) =
                    some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) := by
                  rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeTag2 hS2b1,
                      s3_getElem?_setElem?_ne _ _ _ _ _ hNeC12 hS2b0]; exact hS2a2
                cases s3_setElem?_some_of_lt s2b1 (ctx.bodySrc.locals.length + 3 * kS + 2) (.baseSlot (.live none)) hLtComp2 with
                | intro s2c0 hS2c0 =>
                  have hLtOff : s3_scrBase ctx + jOff < s2c0.length := by
                    rw [s3_setElem?_length _ _ _ _ hS2c0, s3_setElem?_length _ _ _ _ hS2b1,
                        s3_setElem?_length _ _ _ _ hS2b0, hLiveA.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jOff hjOff12
                  have hNeC1O : ctx.bodySrc.locals.length + 3 * kS + 1 ≠ s3_scrBase ctx + jOff := fun h =>
                    Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB1.2)
                  have hNeTagOff : s3_scrBase ctx + jTag ≠ s3_scrBase ctx + jOff := fun h => hjNe (Nat.add_left_cancel h)
                  have hNeC2O : ctx.bodySrc.locals.length + 3 * kS + 2 ≠ s3_scrBase ctx + jOff := fun h =>
                    Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB2.2)
                  cases hLiveA.2.2.2.2.2 jOff hjOff12 with | intro ovOff hOvOff =>
                  have hOvOff0 : Trusted.MirSemantics.getElem? s2c0 (s3_scrBase ctx + jOff) = some (.baseSlot (.live ovOff)) := by
                    rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeC2O hS2c0,
                        s3_getElem?_setElem?_ne _ _ _ _ _ hNeTagOff hS2b1,
                        s3_getElem?_setElem?_ne _ _ _ _ _ hNeC1O hS2b0]; exact hOvOff
                  cases s3_setElem?_some_of_lt s2c0 (s3_scrBase ctx + jOff)
                      (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) hLtOff with
                  | intro s2c1 hS2c1 =>
                    have hStep2 : evalStepMemCopy ctx.pTgt 0
                        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := s2b1 }], mem := mem } =
                        .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2c1 }], mem := mem } :=
                      s3_reachesN_stmt_step ctx hBbTgt hS2
                        (s3c_eval_mkAssignUse_readComp ctx _ mem _ _ pv.offsetBytes.toNat true s2c0 s2c1 ovOff hOffLt
                          hCompDecls.2.2 (s3c_usize_decl ctx jOff hjOff) hS2b1_2 hS2c0 hOvOff0 hS2c1)
                    have hRes := s3c_slotsRel_move_ptr_to_scr ctx slots₁ slots₁' s2a s2b0 s2b1 s2c0 s2c1
                      kS jTag jOff eS tagVal pv.offsetBytes.toNat hES.1 hjTag hjOff hjNe hLiveA
                      (by rw [hES.2.1]; exact hS1')
                      (s3_getElem?_setElem?_eq _ _ _ _ hS2a) hS2b0 hS2b1 hS2c0 hS2c1
                    have hReach3 : ReachesNMemCopy ctx.pTgt 3
                        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2c1 }], mem := mem } :=
                      s3_reachesN_cons hStep0 (s3_reachesN_cons hStep1 (s3_reachesN_one hStep2))
                    refine ⟨tagVal, s2c1, hOv.1, hTagMatch, hTagLt, hReach3, hWf', hRes.1, hRes.2.1, hRes.2.2.1, ?_⟩
                    intro j' hj' h1 h2
                    rw [hRes.2.2.2 j' hj' h1 h2, hPresScrA j' hj']

private theorem s3c_slotsRel_writePtr_scr (ctx : s3_PtrCtx)
    (slots₁ slots₁' s2a s2b0 s2b1 s2c0 s2c1 : List MemCopySlot)
    (kD : Nat) (eD : PtrBackingEntry) (jTag jOff tagVal offVal : Nat) (pv' : PtrVal)
    (hK : Trusted.MirSemantics.getElem? ctx.plan.entries kD = some eD)
    (hjTag : jTag < 10) (hjOff : jOff < 10) (_hjNe : jTag ≠ jOff)
    (hWidth : pv'.width = .isize) (hMatch : s3_PtrTagMatches eD.backingBuf pv' tagVal)
    (hOffEq : pv'.offsetBytes.toNat = offVal)
    (hRelA : s3_SlotsRel ctx slots₁ s2a)
    (hS1 : setElem? slots₁ eD.ptrLocal (.livePtr (some pv')) = some slots₁')
    (hS2a : Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * kD) = some (.baseSlot (.live (some .unit))))
    (hS2b0 : setElem? s2a (s3_scrBase ctx + jTag) (.baseSlot (.live none)) = some s2b0)
    (hS2b1 : setElem? s2b0 (ctx.bodySrc.locals.length + 3 * kD + 1)
      (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) = some s2b1)
    (hS2c0 : setElem? s2b1 (s3_scrBase ctx + jOff) (.baseSlot (.live none)) = some s2c0)
    (hS2c1 : setElem? s2c0 (ctx.bodySrc.locals.length + 3 * kD + 2)
      (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))) = some s2c1) :
    s3_SlotsRel ctx slots₁' s2c1 := by
  have hEB := s3_ptrEntry_bounds ctx kD eD hK
  have hB0 := s3_compOffset_bounds ctx kD 0 hEB.2.2.2 (Nat.succ_pos 2)
  have hB1 := s3_compOffset_bounds ctx kD 1 hEB.2.2.2 (by decide)
  have hB2 := s3_compOffset_bounds ctx kD 2 hEB.2.2.2 (by decide)
  rw [Nat.add_zero] at hB0
  have hjTag12 : jTag < 12 := Nat.lt_trans hjTag (by decide)
  have hjOff12 : jOff < 12 := Nat.lt_trans hjOff (by decide)
  have hLenC1 : s2c1.length = ctx.bodyTgt.locals.length := by
    rw [s3_setElem?_length _ _ _ _ hS2c1, s3_setElem?_length _ _ _ _ hS2c0,
        s3_setElem?_length _ _ _ _ hS2b1, s3_setElem?_length _ _ _ _ hS2b0]
    exact hRelA.2.1
  have hPresLt : ∀ x, x < ctx.bodySrc.locals.length →
      Trusted.MirSemantics.getElem? s2c1 x = Trusted.MirSemantics.getElem? s2a x := by
    intro x hx
    have hN1 : ctx.bodySrc.locals.length + 3 * kD + 1 ≠ x := fun h => Nat.not_lt_of_le (by rw [← h]; exact hB1.1) hx
    have hN2 : ctx.bodySrc.locals.length + 3 * kD + 2 ≠ x := fun h => Nat.not_lt_of_le (by rw [← h]; exact hB2.1) hx
    have hNt : s3_scrBase ctx + jTag ≠ x := fun h =>
      Nat.not_lt_of_le (Nat.le_trans (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)) (by rw [← h]; exact Nat.le_refl _)) hx
    have hNo : s3_scrBase ctx + jOff ≠ x := fun h =>
      Nat.not_lt_of_le (Nat.le_trans (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)) (by rw [← h]; exact Nat.le_refl _)) hx
    rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2 hS2c1,
        s3_getElem?_setElem?_ne _ _ _ _ _ hNo hS2c0,
        s3_getElem?_setElem?_ne _ _ _ _ _ hN1 hS2b1,
        s3_getElem?_setElem?_ne _ _ _ _ _ hNt hS2b0]
  refine ⟨?_, hLenC1, ?_, ?_, ?_, ?_⟩
  · rw [s3_setElem?_length _ _ _ _ hS1]; exact hRelA.1
  · intro id ty hD
    have hNeP : eD.ptrLocal ≠ id := fun h => by rw [h, hD] at hEB; cases hEB.2.2.1
    rw [hPresLt id (s3_getElem?_some_lt _ _ _ hD), s3_getElem?_setElem?_ne _ _ _ _ _ hNeP hS1]; exact hRelA.2.2.1 id ty hD
  · intro bLoc sz al mutab hB
    have hNeP : eD.ptrLocal ≠ bLoc := fun h => by rw [h, hB] at hEB; cases hEB.2.2.1
    rw [hPresLt bLoc (s3_getElem?_some_lt _ _ _ hB), s3_getElem?_setElem?_ne _ _ _ _ _ hNeP hS1]; exact hRelA.2.2.2.1 bLoc sz al mutab hB
  · intro k' e' hK'
    cases s3c_nat_eq_or_ne kD k' with
    | inl hEqK =>
      rw [← hEqK, hK] at hK'; cases hK'; rw [← hEqK]
      unfold s3_PtrSlotEntryRel
      rw [s3_getElem?_setElem?_eq _ _ _ _ hS1]
      have hN1_0 : ctx.bodySrc.locals.length + 3 * kD + 1 ≠ ctx.bodySrc.locals.length + 3 * kD :=
        (Nat.ne_of_lt (Nat.lt_succ_self _)).symm
      have hN2_0 : ctx.bodySrc.locals.length + 3 * kD + 2 ≠ ctx.bodySrc.locals.length + 3 * kD :=
        (s3c_ne_add_two _).symm
      have hN2_1 : ctx.bodySrc.locals.length + 3 * kD + 2 ≠ ctx.bodySrc.locals.length + 3 * kD + 1 :=
        (Nat.ne_of_lt (Nat.lt_succ_self _)).symm
      have hNt_0 := s3c_scr_ne_comp0 ctx (j := jTag) hB0.2
      have hNo_0 := s3c_scr_ne_comp0 ctx (j := jOff) hB0.2
      have hNt_1 := s3c_scr_ne_comp ctx (j := jTag) hB1.2
      have hNo_1 := s3c_scr_ne_comp ctx (j := jOff) hB1.2
      refine ⟨tagVal, some .unit, hWidth, hMatch, ?_, ?_, ?_⟩
      · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2_0 hS2c1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNo_0 hS2c0,
            s3_getElem?_setElem?_ne _ _ _ _ _ hN1_0 hS2b1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNt_0 hS2b0, hS2a]
      · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2_1 hS2c1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNo_1 hS2c0,
            s3_getElem?_setElem?_eq _ _ _ _ hS2b1]
      · rw [s3_getElem?_setElem?_eq _ _ _ _ hS2c1, ← hOffEq]
    | inr hNeK =>
      have hNeP : eD.ptrLocal ≠ e'.ptrLocal := fun h => hNeK (s3_ptrEntry_inj ctx kD k' eD e' hK hK' h)
      have hPresComp : ∀ r', r' < 3 →
          Trusted.MirSemantics.getElem? s2c1 (ctx.bodySrc.locals.length + 3 * k' + r') =
            Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * k' + r') := by
        intro r' hr'
        have hK'B := s3_compOffset_bounds ctx k' r' (s3_ptrEntry_bounds ctx k' e' hK').2.2.2 hr'
        have hN1 : ctx.bodySrc.locals.length + 3 * kD + 1 ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun h =>
          hNeK (s3_compOffset_inj ctx.bodySrc.locals.length kD k' 1 r' (by decide) hr' h).1
        have hN2 : ctx.bodySrc.locals.length + 3 * kD + 2 ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun h =>
          hNeK (s3_compOffset_inj ctx.bodySrc.locals.length kD k' 2 r' (by decide) hr' h).1
        have hNt : s3_scrBase ctx + jTag ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun h =>
          Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [h]; exact hK'B.2)
        have hNo : s3_scrBase ctx + jOff ≠ ctx.bodySrc.locals.length + 3 * k' + r' := fun h =>
          Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [h]; exact hK'B.2)
        rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2 hS2c1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNo hS2c0,
            s3_getElem?_setElem?_ne _ _ _ _ _ hN1 hS2b1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNt hS2b0]
      have hPres0 : Trusted.MirSemantics.getElem? s2c1 (ctx.bodySrc.locals.length + 3 * k') =
          Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * k') := by
        have h0 := hPresComp 0 (Nat.succ_pos 2); rw [Nat.add_zero] at h0; exact h0
      have hOrig := hRelA.2.2.2.2.1 k' e' hK'
      unfold s3_PtrSlotEntryRel; unfold s3_PtrSlotEntryRel at hOrig
      rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeP hS1]
      cases hP : Trusted.MirSemantics.getElem? slots₁ e'.ptrLocal with
      | none => rw [hP] at hOrig; exact False.elim hOrig
      | some slP =>
        rw [hP] at hOrig
        cases slP with
        | baseSlot _ | bufSlot _ => exact False.elim hOrig
        | ptrDead =>
          dsimp at hOrig; dsimp
          rw [hPres0, hPresComp 1 (by decide), hPresComp 2 (by decide)]; exact hOrig
        | livePtr optPv' =>
          cases optPv' with
          | none =>
            dsimp at hOrig; dsimp
            cases hOrig.1 with | intro ov hOv =>
            refine ⟨⟨ov, ?_⟩, ?_, ?_⟩
            · rw [hPres0]; exact hOv
            · rw [hPresComp 1 (by decide)]; exact hOrig.2.1
            · rw [hPresComp 2 (by decide)]; exact hOrig.2.2
          | some pv'' =>
            dsimp at hOrig; dsimp
            cases hOrig with | intro tv hT =>
            cases hT with | intro ov hOv =>
            refine ⟨tv, ov, hOv.1, hOv.2.1, ?_, ?_, ?_⟩
            · rw [hPres0]; exact hOv.2.2.1
            · rw [hPresComp 1 (by decide)]; exact hOv.2.2.2.1
            · rw [hPresComp 2 (by decide)]; exact hOv.2.2.2.2
  · intro j hj
    have hN2 : ctx.bodySrc.locals.length + 3 * kD + 2 ≠ s3_scrBase ctx + j := fun h =>
      Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB2.2)
    have hN1 : ctx.bodySrc.locals.length + 3 * kD + 1 ≠ s3_scrBase ctx + j := fun h =>
      Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB1.2)
    cases s3c_nat_eq_or_ne j jOff with
    | inl hEq =>
      rw [hEq]
      refine ⟨none, ?_⟩
      rw [s3_getElem?_setElem?_ne _ _ _ _ _ (by rw [← hEq]; exact hN2) hS2c1,
          s3_getElem?_setElem?_eq _ _ _ _ hS2c0]
    | inr hNjO =>
      have hNo : s3_scrBase ctx + jOff ≠ s3_scrBase ctx + j := fun h => hNjO (Nat.add_left_cancel h).symm
      cases s3c_nat_eq_or_ne j jTag with
      | inl hEq =>
        rw [hEq]
        refine ⟨none, ?_⟩
        rw [s3_getElem?_setElem?_ne _ _ _ _ _ (by rw [← hEq]; exact hN2) hS2c1,
            s3_getElem?_setElem?_ne _ _ _ _ _ (by rw [← hEq]; exact hNo) hS2c0,
            s3_getElem?_setElem?_ne _ _ _ _ _ (by rw [← hEq]; exact hN1) hS2b1,
            s3_getElem?_setElem?_eq _ _ _ _ hS2b0]
      | inr hNjT =>
        have hNt : s3_scrBase ctx + jTag ≠ s3_scrBase ctx + j := fun h => hNjT (Nat.add_left_cancel h).symm
        cases hRelA.2.2.2.2.2 j hj with | intro ov hOv =>
        refine ⟨ov, ?_⟩
        rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2 hS2c1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNo hS2c0,
            s3_getElem?_setElem?_ne _ _ _ _ _ hN1 hS2b1,
            s3_getElem?_setElem?_ne _ _ _ _ _ hNt hS2b0]
        exact hOv

private theorem s3_exec_writePtr_const (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {startIdx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (dPtr : LocalId) (kD : Nat) (optBufD : Option LocalId) (tagVal offVal : Nat) (pv' : PtrVal)
    (hFind : findPtrEntry ctx.plan.entries dPtr = some (kD, optBufD))
    (ht : tagVal < maxUsize) (ho : offVal < maxUsize)
    (hWidth : pv'.width = .isize) (hMatch : s3_PtrTagMatches optBufD pv' tagVal)
    (hOffEq : pv'.offsetBytes.toNat = offVal)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hS0 : Trusted.MirSemantics.getElem? bbTgt.statements startIdx =
      some (mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kD)))
    (hS1 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 1) =
      some (mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 1) (usizeConst tagVal)))
    (hS2 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 2) =
      some (mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 2) (usizeConst offVal))) :
    match writePtrLocal ctx.bodySrc.locals slots₁ dPtr pv' with
    | .error err =>
      evalStepMemCopy ctx.pTgt 0
        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem } =
        .fault err
    | .ok slots₁' =>
      ∃ slots₂' : List MemCopySlot,
        ReachesNMemCopy ctx.pTgt 3
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := slots₂' }], mem := mem } ∧
        s3_MemWf ctx.bodySrc slots₁' mem ∧
        s3_SlotsRel ctx slots₁' slots₂' ∧
        (∀ j' : Nat, j' < 12 →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
  cases s3c_findPtrEntry_some ctx dPtr kD optBufD hFind with | intro eD hED =>
  have hEB := s3_ptrEntry_bounds ctx kD eD hED.1
  have hCompDecls := s3_bodyTgt_locals_comp ctx kD hEB.2.2.2
  have hOrig := hRel.2.2.2.2.1 kD eD hED.1
  have hB0 := s3_compOffset_bounds ctx kD 0 hEB.2.2.2 (Nat.succ_pos 2)
  have hB1 := s3_compOffset_bounds ctx kD 1 hEB.2.2.2 (by decide)
  have hB2 := s3_compOffset_bounds ctx kD 2 hEB.2.2.2 (by decide)
  rw [Nat.add_zero] at hB0
  unfold writePtrLocal
  rw [hED.2.1] at hEB
  rw [hEB.2.2.1]
  unfold s3_PtrSlotEntryRel at hOrig
  rw [hED.2.1] at hOrig
  cases hSlotD : Trusted.MirSemantics.getElem? slots₁ dPtr with
  | none => rw [hSlotD] at hOrig; exact False.elim hOrig
  | some slD =>
    rw [hSlotD] at hOrig
    cases slD with
    | baseSlot _ | bufSlot _ => exact False.elim hOrig
    | ptrDead =>
      dsimp at hOrig; dsimp
      exact s3_reachesN_stmt_fault ctx hBbTgt hS0
        (s3_eval_mkLivenessCheckStmt_dead ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kD)
          hCompDecls.1 hOrig.1)
    | livePtr optPvOld =>
      have hOv0Ex : ∃ ov0, Trusted.MirSemantics.getElem? slots₂ (ctx.bodySrc.locals.length + 3 * kD) = some (.baseSlot (.live ov0)) := by
        cases optPvOld with
        | none => exact hOrig.1
        | some pvOld =>
          cases hOrig with | intro _ hT =>
          cases hT with | intro ov0 hOv0 => exact ⟨ov0, hOv0.2.2.1⟩
      have hOv1Ex : ∃ ov1, Trusted.MirSemantics.getElem? slots₂ (ctx.bodySrc.locals.length + 3 * kD + 1) = some (.baseSlot (.live ov1)) := by
        cases optPvOld with
        | none => exact ⟨none, hOrig.2.1⟩
        | some pvOld =>
          cases hOrig with | intro tv hT =>
          cases hT with | intro _ hOv0 => exact ⟨_, hOv0.2.2.2.1⟩
      have hOv2Ex : ∃ ov2, Trusted.MirSemantics.getElem? slots₂ (ctx.bodySrc.locals.length + 3 * kD + 2) = some (.baseSlot (.live ov2)) := by
        cases optPvOld with
        | none => exact ⟨none, hOrig.2.2⟩
        | some pvOld =>
          cases hOrig with | intro _ hT =>
          cases hT with | intro _ hOv0 => exact ⟨_, hOv0.2.2.2.2⟩
      cases hOv0Ex with | intro ov0 hOv0 =>
      cases hOv1Ex with | intro ov1 hOv1 =>
      cases hOv2Ex with | intro ov2 hOv2 =>
      have hPvEq : { pv' with width := .isize } = pv' := by
        cases pv'; dsimp at hWidth; rw [hWidth]
      rw [hPvEq]
      have hLtD : dPtr < slots₁.length := by rw [hRel.1]; exact s3_getElem?_some_lt _ _ _ hEB.2.2.1
      cases s3_setElem?_some_of_lt slots₁ dPtr (.livePtr (some pv')) hLtD with | intro slots₁' hSet1 =>
      rw [hSet1]; dsimp
      have hLtC0 : ctx.bodySrc.locals.length + 3 * kD < slots₂.length := by
        rw [hRel.2.1, s3_bodyTgt_locals_length]; exact Nat.lt_of_lt_of_le hB0.2 (Nat.le_add_right _ _)
      cases s3_setElem?_some_of_lt slots₂ (ctx.bodySrc.locals.length + 3 * kD) (.baseSlot (.live (some .unit))) hLtC0 with
      | intro s2a hS2a =>
        have hStep0 : evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem } =
            .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } :=
          s3_reachesN_stmt_step ctx hBbTgt hS0
            (s3_eval_mkLivenessCheckStmt_ok ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kD) ov0 s2a
              hCompDecls.1 hOv0 hS2a)
        have hN01 : ctx.bodySrc.locals.length + 3 * kD ≠ ctx.bodySrc.locals.length + 3 * kD + 1 := Nat.ne_of_lt (Nat.lt_succ_self _)
        have hN02 : ctx.bodySrc.locals.length + 3 * kD ≠ ctx.bodySrc.locals.length + 3 * kD + 2 :=
          s3c_ne_add_two _
        have hN12 : ctx.bodySrc.locals.length + 3 * kD + 1 ≠ ctx.bodySrc.locals.length + 3 * kD + 2 := Nat.ne_of_lt (Nat.lt_succ_self _)
        have hOv1' : Trusted.MirSemantics.getElem? s2a (ctx.bodySrc.locals.length + 3 * kD + 1) = some (.baseSlot (.live ov1)) := by
          rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN01 hS2a]; exact hOv1
        have hLtC1 : ctx.bodySrc.locals.length + 3 * kD + 1 < s2a.length := by
          rw [s3_setElem?_length _ _ _ _ hS2a, hRel.2.1, s3_bodyTgt_locals_length]
          exact Nat.lt_of_lt_of_le hB1.2 (Nat.le_add_right _ _)
        cases s3_setElem?_some_of_lt s2a (ctx.bodySrc.locals.length + 3 * kD + 1)
            (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) hLtC1 with
        | intro s2b hS2b =>
          have hStep1 : evalStepMemCopy ctx.pTgt 0
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } =
              .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := s2b }], mem := mem } :=
            s3_reachesN_stmt_step ctx hBbTgt hS1
              (s3_eval_mkAssignUse_usizeConst ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kD + 1) tagVal ov1 s2b
                ht hCompDecls.2.1 hOv1' hS2b)
          have hOv2' : Trusted.MirSemantics.getElem? s2b (ctx.bodySrc.locals.length + 3 * kD + 2) = some (.baseSlot (.live ov2)) := by
            rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN12 hS2b,
                s3_getElem?_setElem?_ne _ _ _ _ _ hN02 hS2a]; exact hOv2
          have hLtC2 : ctx.bodySrc.locals.length + 3 * kD + 2 < s2b.length := by
            rw [s3_setElem?_length _ _ _ _ hS2b, s3_setElem?_length _ _ _ _ hS2a, hRel.2.1, s3_bodyTgt_locals_length]
            exact Nat.lt_of_lt_of_le hB2.2 (Nat.le_add_right _ _)
          cases s3_setElem?_some_of_lt s2b (ctx.bodySrc.locals.length + 3 * kD + 2)
              (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))) hLtC2 with
          | intro s2c hS2c =>
            have hStep2 : evalStepMemCopy ctx.pTgt 0
                { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := s2b }], mem := mem } =
                .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2c }], mem := mem } :=
              s3_reachesN_stmt_step ctx hBbTgt hS2
                (s3_eval_mkAssignUse_usizeConst ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kD + 2) offVal ov2 s2c
                  ho hCompDecls.2.2 hOv2' hS2c)
            have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals dPtr ≠ some (.byteBuf sz al mutab) :=
              fun _ _ _ h => by rw [hEB.2.2.1] at h; cases h
            have hBaseOk : ∀ ty' v', Trusted.MirSemantics.getElem? ctx.bodySrc.locals dPtr = some (.base ty') →
                MemCopySlot.livePtr (some pv') = .baseSlot (.live (some v')) → checkVal v' ty' = true :=
              fun _ _ _ h => by cases h
            have hWf' := s3_memWf_set_nonBuf ctx.bodySrc slots₁ slots₁' mem dPtr (.livePtr (some pv')) hWf hNotBuf hBaseOk hSet1
            have hRelEntry : s3_PtrSlotEntryRel ctx.bodySrc.locals.length kD eD slots₁' s2c := by
              unfold s3_PtrSlotEntryRel
              rw [hED.2.1, s3_getElem?_setElem?_eq _ _ _ _ hSet1]
              refine ⟨tagVal, some .unit, hWidth, ?_, ?_, ?_, ?_⟩
              · rw [hED.2.2]; exact hMatch
              · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN02.symm hS2c,
                    s3_getElem?_setElem?_ne _ _ _ _ _ hN01.symm hS2b,
                    s3_getElem?_setElem?_eq _ _ _ _ hS2a]
              · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN12.symm hS2c,
                    s3_getElem?_setElem?_eq _ _ _ _ hS2b]
              · rw [s3_getElem?_setElem?_eq _ _ _ _ hS2c, ← hOffEq]
            have hRel' := s3_slotsRel_set_ptr ctx slots₁ slots₂ slots₁' s2a s2b s2c kD eD
              (.livePtr (some pv')) _ _ _ hED.1 hRel (by rw [hED.2.1]; exact hSet1) hS2a hS2b hS2c hRelEntry
            have hReach3 : ReachesNMemCopy ctx.pTgt 3
                { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2c }], mem := mem } :=
              s3_reachesN_cons hStep0 (s3_reachesN_cons hStep1 (s3_reachesN_one hStep2))
            refine ⟨s2c, hReach3, hWf', hRel', ?_⟩
            intro j' _
            have hNe0 : ctx.bodySrc.locals.length + 3 * kD ≠ s3_scrBase ctx + j' := fun h =>
              Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB0.2)
            have hNe1 : ctx.bodySrc.locals.length + 3 * kD + 1 ≠ s3_scrBase ctx + j' := fun h =>
              Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB1.2)
            have hNe2 : ctx.bodySrc.locals.length + 3 * kD + 2 ≠ s3_scrBase ctx + j' := fun h =>
              Nat.not_lt_of_le (Nat.le_add_right _ _) (by rw [← h]; exact hB2.2)
            rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe2 hS2c,
                s3_getElem?_setElem?_ne _ _ _ _ _ hNe1 hS2b,
                s3_getElem?_setElem?_ne _ _ _ _ _ hNe0 hS2a]

private theorem s3_exec_writePtr_from_scr (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {startIdx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (dPtr : LocalId) (kD jTag jOff : Nat) (optBufD : Option LocalId) (tagVal offVal : Nat) (pv' : PtrVal)
    (hFind : findPtrEntry ctx.plan.entries dPtr = some (kD, optBufD))
    (hjTag : jTag < 10) (hjOff : jOff < 10) (hjNe : jTag ≠ jOff)
    (ht : tagVal < maxUsize) (ho : offVal < maxUsize)
    (hWidth : pv'.width = .isize) (hMatch : s3_PtrTagMatches optBufD pv' tagVal)
    (hOffEq : pv'.offsetBytes.toNat = offVal)
    (hTagSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jTag) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))))
    (hOffSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jOff) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))))
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hS0 : Trusted.MirSemantics.getElem? bbTgt.statements startIdx =
      some (mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kD)))
    (hS1 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 1) =
      some (mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 1)
        (.move { localId := s3_scrBase ctx + jTag, projection := [] })))
    (hS2 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 2) =
      some (mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 2)
        (.move { localId := s3_scrBase ctx + jOff, projection := [] }))) :
    match writePtrLocal ctx.bodySrc.locals slots₁ dPtr pv' with
    | .error err =>
      evalStepMemCopy ctx.pTgt 0
        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem } =
        .fault err
    | .ok slots₁' =>
      ∃ slots₂' : List MemCopySlot,
        ReachesNMemCopy ctx.pTgt 3
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := slots₂' }], mem := mem } ∧
        s3_MemWf ctx.bodySrc slots₁' mem ∧
        s3_SlotsRel ctx slots₁' slots₂' := by
  cases s3c_findPtrEntry_some ctx dPtr kD optBufD hFind with | intro eD hED =>
  have hEB := s3_ptrEntry_bounds ctx kD eD hED.1
  have hCompDecls := s3_bodyTgt_locals_comp ctx kD hEB.2.2.2
  have hOrig := hRel.2.2.2.2.1 kD eD hED.1
  have hB0 := s3_compOffset_bounds ctx kD 0 hEB.2.2.2 (Nat.succ_pos 2)
  have hB1 := s3_compOffset_bounds ctx kD 1 hEB.2.2.2 (by decide)
  have hB2 := s3_compOffset_bounds ctx kD 2 hEB.2.2.2 (by decide)
  rw [Nat.add_zero] at hB0
  have hjTag12 : jTag < 12 := Nat.lt_trans hjTag (by decide)
  have hjOff12 : jOff < 12 := Nat.lt_trans hjOff (by decide)
  unfold writePtrLocal
  rw [hED.2.1] at hEB
  rw [hEB.2.2.1]
  unfold s3_PtrSlotEntryRel at hOrig
  rw [hED.2.1] at hOrig
  cases hSlotD : Trusted.MirSemantics.getElem? slots₁ dPtr with
  | none => rw [hSlotD] at hOrig; exact False.elim hOrig
  | some slD =>
    rw [hSlotD] at hOrig
    cases slD with
    | baseSlot _ | bufSlot _ => exact False.elim hOrig
    | ptrDead =>
      dsimp at hOrig; dsimp
      exact s3_reachesN_stmt_fault ctx hBbTgt hS0
        (s3_eval_mkLivenessCheckStmt_dead ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kD)
          hCompDecls.1 hOrig.1)
    | livePtr optPvOld =>
      have hOv0Ex : ∃ ov0, Trusted.MirSemantics.getElem? slots₂ (ctx.bodySrc.locals.length + 3 * kD) = some (.baseSlot (.live ov0)) := by
        cases optPvOld with
        | none => exact hOrig.1
        | some _ => cases hOrig with | intro _ hT => cases hT with | intro ov0 hOv0 => exact ⟨ov0, hOv0.2.2.1⟩
      have hOv1Ex : ∃ ov1, Trusted.MirSemantics.getElem? slots₂ (ctx.bodySrc.locals.length + 3 * kD + 1) = some (.baseSlot (.live ov1)) := by
        cases optPvOld with
        | none => exact ⟨none, hOrig.2.1⟩
        | some _ => cases hOrig with | intro _ hT => cases hT with | intro _ hOv0 => exact ⟨_, hOv0.2.2.2.1⟩
      have hOv2Ex : ∃ ov2, Trusted.MirSemantics.getElem? slots₂ (ctx.bodySrc.locals.length + 3 * kD + 2) = some (.baseSlot (.live ov2)) := by
        cases optPvOld with
        | none => exact ⟨none, hOrig.2.2⟩
        | some _ => cases hOrig with | intro _ hT => cases hT with | intro _ hOv0 => exact ⟨_, hOv0.2.2.2.2⟩
      cases hOv0Ex with | intro ov0 hOv0 =>
      cases hOv1Ex with | intro ov1 hOv1 =>
      cases hOv2Ex with | intro ov2 hOv2 =>
      have hPvEq : { pv' with width := .isize } = pv' := by
        cases pv'; dsimp at hWidth; rw [hWidth]
      rw [hPvEq]
      have hLtD : dPtr < slots₁.length := by rw [hRel.1]; exact s3_getElem?_some_lt _ _ _ hEB.2.2.1
      cases s3_setElem?_some_of_lt slots₁ dPtr (.livePtr (some pv')) hLtD with | intro slots₁' hSet1 =>
      rw [hSet1]; dsimp
      have hLtC0 : ctx.bodySrc.locals.length + 3 * kD < slots₂.length := by
        rw [hRel.2.1, s3_bodyTgt_locals_length]; exact Nat.lt_of_lt_of_le hB0.2 (Nat.le_add_right _ _)
      cases s3_setElem?_some_of_lt slots₂ (ctx.bodySrc.locals.length + 3 * kD) (.baseSlot (.live (some .unit))) hLtC0 with
      | intro s2a hS2a =>
        have hStep0 : evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem } =
            .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } :=
          s3_reachesN_stmt_step ctx hBbTgt hS0
            (s3_eval_mkLivenessCheckStmt_ok ctx.bodyTgt _ mem (ctx.bodySrc.locals.length + 3 * kD) ov0 s2a
              hCompDecls.1 hOv0 hS2a)
        have hLiveA : s3_SlotsRel ctx slots₁ s2a :=
          s3c_slotsRel_refresh_comp0 ctx slots₁ slots₂ s2a kD eD optPvOld hED.1
            (by rw [hED.2.1]; exact hSlotD) hRel hS2a
        have hNe0T := (s3c_scr_ne_comp0 ctx (j := jTag) hB0.2).symm
        have hNe0O := (s3c_scr_ne_comp0 ctx (j := jOff) hB0.2).symm
        have hNe01 : ctx.bodySrc.locals.length + 3 * kD ≠ ctx.bodySrc.locals.length + 3 * kD + 1 := Nat.ne_of_lt (Nat.lt_succ_self _)
        have hNe02 : ctx.bodySrc.locals.length + 3 * kD ≠ ctx.bodySrc.locals.length + 3 * kD + 2 :=
          s3c_ne_add_two _
        have hNeT1 := s3c_scr_ne_comp ctx (j := jTag) hB1.2
        have hNeO2 := s3c_scr_ne_comp ctx (j := jOff) hB2.2
        have hTagA : Trusted.MirSemantics.getElem? s2a (s3_scrBase ctx + jTag) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) := by
          rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe0T hS2a]; exact hTagSlot
        have hLtTagA : s3_scrBase ctx + jTag < s2a.length := by rw [hLiveA.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jTag hjTag12
        cases s3_setElem?_some_of_lt s2a (s3_scrBase ctx + jTag) (.baseSlot (.live none)) hLtTagA with
        | intro s2b0 hS2b0 =>
          have hOv1' : Trusted.MirSemantics.getElem? s2b0 (ctx.bodySrc.locals.length + 3 * kD + 1) = some (.baseSlot (.live ov1)) := by
            rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeT1 hS2b0, s3_getElem?_setElem?_ne _ _ _ _ _ hNe01 hS2a]; exact hOv1
          have hLtC1 : ctx.bodySrc.locals.length + 3 * kD + 1 < s2b0.length := by
            rw [s3_setElem?_length _ _ _ _ hS2b0, hLiveA.2.1, s3_bodyTgt_locals_length]
            exact Nat.lt_of_lt_of_le hB1.2 (Nat.le_add_right _ _)
          cases s3_setElem?_some_of_lt s2b0 (ctx.bodySrc.locals.length + 3 * kD + 1)
              (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) hLtC1 with
          | intro s2b1 hS2b1 =>
            have hStep1 : evalStepMemCopy ctx.pTgt 0
                { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } =
                .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := s2b1 }], mem := mem } :=
              s3_reachesN_stmt_step ctx hBbTgt hS1
                (s3c_eval_mkAssignUse_readComp ctx _ mem _ _ tagVal true s2b0 s2b1 ov1 ht
                  (s3c_usize_decl ctx jTag hjTag) hCompDecls.2.1 hTagA hS2b0 hOv1' hS2b1)
            have hNeTO : s3_scrBase ctx + jTag ≠ s3_scrBase ctx + jOff := fun h => hjNe (Nat.add_left_cancel h)
            have hNe1O := (s3c_scr_ne_comp ctx (j := jOff) hB1.2).symm
            have hOffB1 : Trusted.MirSemantics.getElem? s2b1 (s3_scrBase ctx + jOff) =
                some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))) := by
              rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe1O hS2b1,
                  s3_getElem?_setElem?_ne _ _ _ _ _ hNeTO hS2b0,
                  s3_getElem?_setElem?_ne _ _ _ _ _ hNe0O hS2a]; exact hOffSlot
            have hLtOffB1 : s3_scrBase ctx + jOff < s2b1.length := by
              rw [s3_setElem?_length _ _ _ _ hS2b1, s3_setElem?_length _ _ _ _ hS2b0, hLiveA.2.1]
              exact s3_scrLoc_lt_bodyTgt ctx jOff hjOff12
            cases s3_setElem?_some_of_lt s2b1 (s3_scrBase ctx + jOff) (.baseSlot (.live none)) hLtOffB1 with
            | intro s2c0 hS2c0 =>
              have hNe12 : ctx.bodySrc.locals.length + 3 * kD + 1 ≠ ctx.bodySrc.locals.length + 3 * kD + 2 :=
                Nat.ne_of_lt (Nat.lt_succ_self _)
              have hNeT2 := s3c_scr_ne_comp ctx (j := jTag) hB2.2
              have hOv2' : Trusted.MirSemantics.getElem? s2c0 (ctx.bodySrc.locals.length + 3 * kD + 2) = some (.baseSlot (.live ov2)) := by
                rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNeO2 hS2c0,
                    s3_getElem?_setElem?_ne _ _ _ _ _ hNe12 hS2b1,
                    s3_getElem?_setElem?_ne _ _ _ _ _ hNeT2 hS2b0,
                    s3_getElem?_setElem?_ne _ _ _ _ _ hNe02 hS2a]; exact hOv2
              have hLtC2 : ctx.bodySrc.locals.length + 3 * kD + 2 < s2c0.length := by
                rw [s3_setElem?_length _ _ _ _ hS2c0, s3_setElem?_length _ _ _ _ hS2b1,
                    s3_setElem?_length _ _ _ _ hS2b0, hLiveA.2.1, s3_bodyTgt_locals_length]
                exact Nat.lt_of_lt_of_le hB2.2 (Nat.le_add_right _ _)
              cases s3_setElem?_some_of_lt s2c0 (ctx.bodySrc.locals.length + 3 * kD + 2)
                  (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))) hLtC2 with
              | intro s2c1 hS2c1 =>
                have hStep2 : evalStepMemCopy ctx.pTgt 0
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := s2b1 }], mem := mem } =
                    .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2c1 }], mem := mem } :=
                  s3_reachesN_stmt_step ctx hBbTgt hS2
                    (s3c_eval_mkAssignUse_readComp ctx _ mem _ _ offVal true s2c0 s2c1 ov2 ho
                      (s3c_usize_decl ctx jOff hjOff) hCompDecls.2.2 hOffB1 hS2c0 hOv2' hS2c1)
                have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals dPtr ≠ some (.byteBuf sz al mutab) :=
                  fun _ _ _ h => by rw [hEB.2.2.1] at h; cases h
                have hBaseOk : ∀ ty' v', Trusted.MirSemantics.getElem? ctx.bodySrc.locals dPtr = some (.base ty') →
                    MemCopySlot.livePtr (some pv') = .baseSlot (.live (some v')) → checkVal v' ty' = true :=
                  fun _ _ _ h => by cases h
                have hWf' := s3_memWf_set_nonBuf ctx.bodySrc slots₁ slots₁' mem dPtr (.livePtr (some pv')) hWf hNotBuf hBaseOk hSet1
                have hRel' := s3c_slotsRel_writePtr_scr ctx slots₁ slots₁' s2a s2b0 s2b1 s2c0 s2c1
                  kD eD jTag jOff tagVal offVal pv' hED.1 hjTag hjOff hjNe hWidth
                  (by rw [← hED.2.2] at hMatch; exact hMatch) hOffEq hLiveA
                  (by rw [hED.2.1]; exact hSet1) (s3_getElem?_setElem?_eq _ _ _ _ hS2a) hS2b0 hS2b1 hS2c0 hS2c1
                have hReach3 : ReachesNMemCopy ctx.pTgt 3
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
                    { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2c1 }], mem := mem } :=
                  s3_reachesN_cons hStep0 (s3_reachesN_cons hStep1 (s3_reachesN_one hStep2))
                exact ⟨s2c1, hReach3, hWf', hRel'⟩

private theorem s3c_pow2_le30_lt_maxUsize (a : Nat) (ha : a ≤ 30) : Nat.pow 2 a < maxUsize := by
  have h1 : Nat.pow 2 a ≤ Nat.pow 2 30 := s3_nat_pow_two_mono ha
  have h2 : Nat.pow 2 30 < Nat.pow 2 64 := by decide
  exact Nat.lt_of_le_of_lt h1 h2

private theorem s3_exec_mkPtrAlignCheckStmts (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {startIdx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (optBuf : Option LocalId) (jTag jOff reqAlignLog2 tagVal offVal : Nat) (pv : PtrVal)
    (hReq : reqAlignLog2 ≤ 30)
    (hjTag : jTag < 5) (hjOff : jOff < 5)
    (ht : tagVal < maxUsize) (ho : offVal < maxUsize)
    (hMatch : s3_PtrTagMatches optBuf pv tagVal) (hOffEq : pv.offsetBytes.toNat = offVal)
    (hOptBufSpec : match optBuf with
      | none => True
      | some bLoc => ∃ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals bLoc = some (.byteBuf sz al mutab) ∧
          sz ≤ 32 ∧ al ≤ 30)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem) (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hTagSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jTag) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))))
    (hOffSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jOff) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))))
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmts : ∀ k s,
      Trusted.MirSemantics.getElem?
        (mkPtrAlignCheckStmts ctx.bodySrc.locals optBuf (s3_scrBase ctx + jTag) (s3_scrBase ctx + jOff)
          (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2) k = some s →
      Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + k) = some s) :
    match checkPtrAlignMem mem pv reqAlignLog2 with
    | .error err =>
      ∃ (n : Nat) (sBad : MemCopyState),
        ReachesNMemCopy ctx.pTgt n
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          sBad ∧
        evalStepMemCopy ctx.pTgt 0 sBad = .fault err
    | .ok () =>
      let nStmts := (mkPtrAlignCheckStmts ctx.bodySrc.locals optBuf (s3_scrBase ctx + jTag) (s3_scrBase ctx + jOff)
        (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length
      ∃ slots₂' : List MemCopySlot,
        ReachesNMemCopy ctx.pTgt nStmts
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + nStmts, locals := slots₂' }], mem := mem } ∧
        s3_SlotsRel ctx slots₁ slots₂' ∧
        (∀ j' : Nat, j' < 12 → j' ≠ 5 → j' ≠ 6 →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
  have hjTag10 : jTag < 10 := Nat.lt_trans hjTag (by decide)
  have hjOff10 : jOff < 10 := Nat.lt_trans hjOff (by decide)
  have hNeO5 : jOff ≠ 5 := Nat.ne_of_lt hjOff
  have hNeO6 : jOff ≠ 6 := Nat.ne_of_lt (Nat.lt_trans hjOff (Nat.lt_succ_self 5))
  have hNeT5 : jTag ≠ 5 := Nat.ne_of_lt hjTag
  have hNeT6 : jTag ≠ 6 := Nat.ne_of_lt (Nat.lt_trans hjTag (Nat.lt_succ_self 5))
  have hReqBytesPos : 0 < Nat.pow 2 reqAlignLog2 := s3_nat_pow_pos 2 (Nat.succ_pos 1) reqAlignLog2
  have hMaskLt : Nat.pow 2 reqAlignLog2 - 1 < maxUsize :=
    Nat.lt_of_le_of_lt (Nat.sub_le _ _) (s3c_pow2_le30_lt_maxUsize reqAlignLog2 hReq)
  have hS0 : Trusted.MirSemantics.getElem? bbTgt.statements startIdx =
      some (mkBinOpStmt (s3_scrBase ctx + 6) .bitAnd
        (.copy { localId := s3_scrBase ctx + jOff, projection := [] }) (usizeConst (Nat.pow 2 reqAlignLog2 - 1))) := by
    have h := hStmts 0 _ (by unfold mkPtrAlignCheckStmts; rfl)
    rw [Nat.add_zero] at h; exact h
  have hS1 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 1) =
      some (mkRequireZeroUsize (s3_scrBase ctx + 5) (.move { localId := s3_scrBase ctx + 6, projection := [] })) :=
    hStmts 1 _ (by unfold mkPtrAlignCheckStmts; rfl)
  have hLandVal : Nat.land offVal (Nat.pow 2 reqAlignLog2 - 1) = Nat.mod offVal (Nat.pow 2 reqAlignLog2) :=
    s3_nat_land_pow2_sub_one offVal reqAlignLog2
  have hModLt : Nat.mod offVal (Nat.pow 2 reqAlignLog2) < maxUsize :=
    Nat.lt_trans (s3_nat_mod_lt_of_pos hReqBytesPos) (s3c_pow2_le30_lt_maxUsize reqAlignLog2 hReq)
  have hL0 := s3_evalPrimOp_scr_copy ctx slots₂ jOff offVal hjOff10 hOffSlot
  have hR0 := s3_evalPrimOp_usizeConst ctx.bodyTgt.locals slots₂ (Nat.pow 2 reqAlignLog2 - 1) hMaskLt
  have hStep0Res := s3_exec_mkBinOpStmt_usize_scr ctx (mem := mem) 6 .bitAnd
    (.copy { localId := s3_scrBase ctx + jOff, projection := [] }) (usizeConst (Nat.pow 2 reqAlignLog2 - 1))
    _ _ (Nat.land offVal (Nat.pow 2 reqAlignLog2 - 1)) (by decide)
    (by rw [hLandVal]; exact hModLt) hL0 hR0
    (s3_evalBinOp_usize_bitAnd offVal (Nat.pow 2 reqAlignLog2 - 1) ho hMaskLt)
    hRel hBbTgt hS0
  cases hStep0Res with | intro s2a hS2a =>
  have hLt6 : s3_scrBase ctx + 6 < s2a.length := by rw [hS2a.2.1.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 6 (by decide)
  cases s3_evalPrimOp_scr_move ctx s2a 6 (Nat.land offVal (Nat.pow 2 reqAlignLog2 - 1)) (by decide) hLt6 hS2a.2.2.1 with
  | intro s2aMove hMove6 =>
    have hRelMove := s3_slotsRel_set_scratch ctx slots₁ s2a s2aMove 6 none (by decide) hS2a.2.1 hMove6.1
    have hReq0Res := s3_exec_mkRequireZeroUsize_scr ctx (mem := mem) 5 (.move { localId := s3_scrBase ctx + 6, projection := [] })
      (Nat.land offVal (Nat.pow 2 reqAlignLog2 - 1)) (by decide)
      (by rw [hLandVal]; exact hModLt) hMove6.2 hRelMove hBbTgt hS1
    have hCheckBle : (!Nat.ble reqAlignLog2 30) = false := by
      rw [(nat_ble_eq_le reqAlignLog2 30).mpr hReq]; rfl
    unfold checkPtrAlignMem
    rw [hCheckBle]; dsimp
    cases hOffAl : Nat.beq (Nat.mod pv.offsetBytes.toNat (Nat.pow 2 reqAlignLog2)) 0 with
    | false =>
      have hModNe : Nat.mod offVal (Nat.pow 2 reqAlignLog2) ≠ 0 := by
        rw [← hOffEq]; exact nat_beq_false_ne hOffAl
      have hPosLand : 0 < Nat.land offVal (Nat.pow 2 reqAlignLog2 - 1) := by
        rw [hLandVal]; exact Nat.pos_of_ne_zero hModNe
      have hFault1 := hReq0Res.2 hPosLand
      dsimp
      cases pv.allocId with
      | none => dsimp; exact ⟨1, _, s3_reachesN_one hS2a.1, hFault1⟩
      | some aid =>
        dsimp
        cases findAlloc? aid mem.allocations with
        | none => dsimp; exact ⟨1, _, s3_reachesN_one hS2a.1, hFault1⟩
        | some alloc =>
          dsimp
          rw [Bool.and_false]
          dsimp
          exact ⟨1, _, s3_reachesN_one hS2a.1, hFault1⟩
    | true =>
      have hLandZero : Nat.land offVal (Nat.pow 2 reqAlignLog2 - 1) = 0 := by
        rw [hLandVal, ← hOffEq]; exact nat_beq_eq _ _ hOffAl
      cases hReq0Res.1 hLandZero with | intro s2b hS2b =>
      have hPres2b : ∀ j' : Nat, j' < 12 → j' ≠ 5 → j' ≠ 6 →
          Trusted.MirSemantics.getElem? s2b (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') := by
        intro j' hj' h5 h6
        have hNe6 : s3_scrBase ctx + 6 ≠ s3_scrBase ctx + j' := fun h => h6 (Nat.add_left_cancel h).symm
        rw [hS2b.2.2.2 j' hj' h5, s3_getElem?_setElem?_ne _ _ _ _ _ hNe6 hMove6.1, hS2a.2.2.2 j' hj' h6]
      cases optBuf with
      | none =>
        unfold s3_PtrTagMatches at hMatch
        rw [hMatch.1]; dsimp
        have hLenEq : (mkPtrAlignCheckStmts ctx.bodySrc.locals none (s3_scrBase ctx + jTag) (s3_scrBase ctx + jOff)
            (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length = 2 := rfl
        rw [hLenEq]
        exact ⟨s2b, s3_reachesN_cons hS2a.1 (s3_reachesN_one hS2b.1), hS2b.2.1, hPres2b⟩
      | some bLoc =>
        cases hOptBufSpec with | intro sz hBS =>
        cases hBS with | intro al hBA =>
        cases hBA with | intro mutab hBM =>
        have hDeclB := hBM.1
        cases hBle : Nat.ble reqAlignLog2 al with
        | true =>
          have hLenEq : (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bLoc) (s3_scrBase ctx + jTag) (s3_scrBase ctx + jOff)
              (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length = 2 := by
            unfold mkPtrAlignCheckStmts; dsimp; rw [hDeclB]; dsimp; rw [hBle]; rfl
          unfold s3_PtrTagMatches at hMatch
          cases hMatch with
          | inl h0 =>
            rw [h0.1]; dsimp
            rw [hLenEq]
            exact ⟨s2b, s3_reachesN_cons hS2a.1 (s3_reachesN_one hS2b.1), hS2b.2.1, hPres2b⟩
          | inr h1 =>
            rw [h1.1]; dsimp
            cases hWf.2.1 bLoc sz al mutab hDeclB with | intro _ hBA2 =>
            cases hBA2 with | intro alloc hAlloc =>
            rw [hAlloc.2.1]; dsimp; rw [hAlloc.2.2.2.1, hBle]; dsimp
            rw [hLenEq]
            exact ⟨s2b, s3_reachesN_cons hS2a.1 (s3_reachesN_one hS2b.1), hS2b.2.1, hPres2b⟩
        | false =>
          have hLenEq : (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bLoc) (s3_scrBase ctx + jTag) (s3_scrBase ctx + jOff)
              (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length = 3 := by
            unfold mkPtrAlignCheckStmts; dsimp; rw [hDeclB]; dsimp; rw [hBle]; rfl
          have hS2 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 2) =
              some (mkRequireZeroUsize (s3_scrBase ctx + 5) (.copy { localId := s3_scrBase ctx + jTag, projection := [] })) :=
            hStmts 2 _ (by unfold mkPtrAlignCheckStmts; dsimp; rw [hDeclB]; dsimp; rw [hBle]; rfl)
          have hTagSlotB : Trusted.MirSemantics.getElem? s2b (s3_scrBase ctx + jTag) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) := by
            rw [hPres2b jTag (Nat.lt_trans hjTag (by decide)) hNeT5 hNeT6]; exact hTagSlot
          have hReqTag := s3_exec_mkRequireZeroUsize_scr ctx (mem := mem) 5 (.copy { localId := s3_scrBase ctx + jTag, projection := [] })
            tagVal (by decide) ht (s3_evalPrimOp_scr_copy ctx s2b jTag tagVal hjTag10 hTagSlotB) hS2b.2.1 hBbTgt hS2
          unfold s3_PtrTagMatches at hMatch
          cases hMatch with
          | inl h0 =>
            rw [h0.1]; dsimp
            rw [hLenEq]
            cases hReqTag.1 h0.2 with | intro s2c hS2c =>
            refine ⟨s2c, s3_reachesN_cons hS2a.1 (s3_reachesN_cons hS2b.1 (s3_reachesN_one hS2c.1)), hS2c.2.1, ?_⟩
            intro j' hj' h5 h6
            rw [hS2c.2.2.2 j' hj' h5, hPres2b j' hj' h5 h6]
          | inr h1 =>
            rw [h1.1]; dsimp
            cases hWf.2.1 bLoc sz al mutab hDeclB with | intro _ hBA2 =>
            cases hBA2 with | intro alloc hAlloc =>
            rw [hAlloc.2.1]; dsimp; rw [hAlloc.2.2.2.1, hBle]; dsimp
            have hPosTag : 0 < tagVal := by rw [h1.2]; exact Nat.zero_lt_one
            exact ⟨2, _, s3_reachesN_cons hS2a.1 (s3_reachesN_one hS2b.1), hReqTag.2 hPosTag⟩

private theorem s3c_nat_or_lt_pow2 :
    ∀ (k a b : Nat), a < Nat.pow 2 k → b < Nat.pow 2 k → Nat.lor a b < Nat.pow 2 k
  | 0, a, b, ha, hb => by
    have ha0 : a = 0 := Nat.lt_one_iff.mp ha
    have hb0 : b = 0 := Nat.lt_one_iff.mp hb
    rw [ha0, hb0]; exact Nat.zero_lt_one
  | k + 1, a, b, ha, hb => by
    have hPow : Nat.pow 2 (k + 1) = 2 * Nat.pow 2 k := by
      change Nat.pow 2 k * 2 = 2 * Nat.pow 2 k; exact Nat.mul_comm _ _
    have haDiv : Nat.div a 2 < Nat.pow 2 k := (Nat.div_lt_iff_lt_mul (Nat.succ_pos 1)).mpr (by rw [Nat.mul_comm, ← hPow]; exact ha)
    have hbDiv : Nat.div b 2 < Nat.pow 2 k := (Nat.div_lt_iff_lt_mul (Nat.succ_pos 1)).mpr (by rw [Nat.mul_comm, ← hPow]; exact hb)
    have ih := s3c_nat_or_lt_pow2 k (Nat.div a 2) (Nat.div b 2) haDiv hbDiv
    have hDivEq : Nat.div (Nat.lor a b) 2 = Nat.lor (Nat.div a 2) (Nat.div b 2) := by
      apply s0_nat_eq_of_testBit_eq
      intro i
      have hSR (x : Nat) : (Nat.div x 2).testBit i = x.testBit (i + 1) := by
        have h := @s0_nat_testBit_shiftRight 1 i x
        rw [s0_nat_shiftRight_eq_div_pow] at h
        change (Nat.div x 2).testBit i = x.testBit (1 + i) at h
        rw [Nat.add_comm] at h
        exact h
      have hLor1 : (Nat.lor a b).testBit (i + 1) = (a.testBit (i + 1) || b.testBit (i + 1)) :=
        @s0_nat_testBit_bitwise_args or rfl a b (i + 1)
      have hLor2 : (Nat.lor (Nat.div a 2) (Nat.div b 2)).testBit i =
          ((Nat.div a 2).testBit i || (Nat.div b 2).testBit i) :=
        @s0_nat_testBit_bitwise_args or rfl (Nat.div a 2) (Nat.div b 2) i
      rw [hSR (Nat.lor a b), hLor1, hLor2, hSR a, hSR b]
    have hDecomp : 2 * Nat.div (Nat.lor a b) 2 + Nat.mod (Nat.lor a b) 2 = Nat.lor a b :=
      Nat.div_add_mod (Nat.lor a b) 2
    rw [hDivEq] at hDecomp
    have hMod : Nat.mod (Nat.lor a b) 2 < 2 := Nat.mod_lt _ (Nat.succ_pos 1)
    have hMulLe : 2 * Nat.lor (Nat.div a 2) (Nat.div b 2) + 2 ≤ 2 * Nat.pow 2 k := by
      have hM : 2 * (Nat.lor (Nat.div a 2) (Nat.div b 2) + 1) ≤ 2 * Nat.pow 2 k :=
        Nat.mul_le_mul_left 2 ih
      rw [Nat.mul_add, Nat.mul_one] at hM; exact hM
    rw [← hDecomp, hPow]
    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hMod _) hMulLe

private theorem s3c_nat_or_lt_maxUsize {a b : Nat} (ha : a < maxUsize) (hb : b < maxUsize) :
    Nat.lor a b < maxUsize :=
  s3c_nat_or_lt_pow2 64 a b ha hb

private theorem s3_exec_mkPtrNonNullCheckStmts (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {startIdx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (optBuf : Option LocalId) (jTag jOff tagVal offVal : Nat) (pv : PtrVal)
    (hjTag : jTag < 5) (hjOff : jOff < 5)
    (ht : tagVal < maxUsize) (ho : offVal < maxUsize)
    (hMatch : s3_PtrTagMatches optBuf pv tagVal) (hOffEq : pv.offsetBytes.toNat = offVal)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hTagSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jTag) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))))
    (hOffSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + jOff) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 offVal })))))
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hS0 : Trusted.MirSemantics.getElem? bbTgt.statements startIdx =
      some (mkBinOpStmt (s3_scrBase ctx + 6) .bitOr
        (.copy { localId := s3_scrBase ctx + jTag, projection := [] })
        (.copy { localId := s3_scrBase ctx + jOff, projection := [] })))
    (hS1 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 1) =
      some (mkSubUncheckedUsize (s3_scrBase ctx + 5)
        (.move { localId := s3_scrBase ctx + 6, projection := [] }) (usizeConst 1))) :
    match isNullPtr pv with
    | true =>
      ∃ (sBad : MemCopyState),
        ReachesNMemCopy ctx.pTgt 1
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          sBad ∧
        evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined
    | false =>
      ∃ slots₂' : List MemCopySlot,
        ReachesNMemCopy ctx.pTgt 2
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 2, locals := slots₂' }], mem := mem } ∧
        s3_SlotsRel ctx slots₁ slots₂' ∧
        (∀ j' : Nat, j' < 12 → j' ≠ 5 → j' ≠ 6 →
          Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
            Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
  have hjTag10 : jTag < 10 := Nat.lt_trans hjTag (by decide)
  have hjOff10 : jOff < 10 := Nat.lt_trans hjOff (by decide)
  have hLorLt : Nat.lor tagVal offVal < maxUsize := s3c_nat_or_lt_maxUsize ht ho
  have hL0 := s3_evalPrimOp_scr_copy ctx slots₂ jTag tagVal hjTag10 hTagSlot
  have hR0 := s3_evalPrimOp_scr_copy ctx slots₂ jOff offVal hjOff10 hOffSlot
  have hStep0Res := s3_exec_mkBinOpStmt_usize_scr ctx (mem := mem) 6 .bitOr
    (.copy { localId := s3_scrBase ctx + jTag, projection := [] })
    (.copy { localId := s3_scrBase ctx + jOff, projection := [] })
    _ _ (Nat.lor tagVal offVal) (by decide) hLorLt hL0 hR0
    (s3_evalBinOp_usize_bitOr tagVal offVal ht ho) hRel hBbTgt hS0
  cases hStep0Res with | intro s2a hS2a =>
  have hLt6 : s3_scrBase ctx + 6 < s2a.length := by rw [hS2a.2.1.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 6 (by decide)
  cases s3_evalPrimOp_scr_move ctx s2a 6 (Nat.lor tagVal offVal) (by decide) hLt6 hS2a.2.2.1 with
  | intro s2aMove hMove6 =>
    have hRelMove := s3_slotsRel_set_scratch ctx slots₁ s2a s2aMove 6 none (by decide) hS2a.2.1 hMove6.1
    have hR1 := s3_evalPrimOp_usizeConst ctx.bodyTgt.locals s2aMove 1 (by decide : 1 < maxUsize)
    have hSubRes := s3_exec_mkSubUncheckedUsize_scr ctx (mem := mem) 5
      (.move { localId := s3_scrBase ctx + 6, projection := [] }) (usizeConst 1)
      (Nat.lor tagVal offVal) 1 (by decide) hLorLt (by decide : 1 < maxUsize)
      hMove6.2 hR1 hRelMove hBbTgt hS1
    unfold isNullPtr
    cases hAid : pv.allocId with
    | some aid =>
      dsimp
      have hTag1 : tagVal = 1 := by
        unfold s3_PtrTagMatches at hMatch
        cases optBuf with
        | none => rw [hAid] at hMatch; cases hMatch.1
        | some _ =>
          cases hMatch with
          | inl h0 => rw [hAid] at h0; cases h0.1
          | inr h1 => exact h1.2
      have hGe1 : 1 ≤ Nat.lor tagVal offVal := by
        apply Nat.pos_of_ne_zero
        intro hZ
        have hBoth := (s3_nat_lor_eq_zero_iff tagVal offVal).mp hZ
        rw [hTag1] at hBoth
        cases hBoth.1
      cases hSubRes.1 hGe1 with | intro s2b hS2b =>
      refine ⟨s2b, s3_reachesN_cons hS2a.1 (s3_reachesN_one hS2b.1), hS2b.2.1, ?_⟩
      intro j' hj' h5 h6
      have hNe6 : s3_scrBase ctx + 6 ≠ s3_scrBase ctx + j' := fun h => h6 (Nat.add_left_cancel h).symm
      rw [hS2b.2.2.2 j' hj' h5, s3_getElem?_setElem?_ne _ _ _ _ _ hNe6 hMove6.1, hS2a.2.2.2 j' hj' h6]
    | none =>
      have hTag0 : tagVal = 0 := by
        unfold s3_PtrTagMatches at hMatch
        cases optBuf with
        | none => exact hMatch.2
        | some _ =>
          cases hMatch with
          | inl h0 => exact h0.2
          | inr h1 => rw [hAid] at h1; cases h1.1
      rw [hOffEq]
      cases hOffZ : Nat.beq offVal 0 with
      | true =>
        have hO0 : offVal = 0 := nat_beq_eq _ _ hOffZ
        have hLor0 : Nat.lor tagVal offVal = 0 := (s3_nat_lor_eq_zero_iff tagVal offVal).mpr ⟨hTag0, hO0⟩
        have hLt1 : Nat.lor tagVal offVal < 1 := by rw [hLor0]; exact Nat.zero_lt_one
        exact ⟨_, s3_reachesN_one hS2a.1, hSubRes.2 hLt1⟩
      | false =>
        have hONe : offVal ≠ 0 := nat_beq_false_ne hOffZ
        have hGe1 : 1 ≤ Nat.lor tagVal offVal := by
          apply Nat.pos_of_ne_zero
          intro hZ
          exact hONe ((s3_nat_lor_eq_zero_iff tagVal offVal).mp hZ).2
        cases hSubRes.1 hGe1 with | intro s2b hS2b =>
        refine ⟨s2b, s3_reachesN_cons hS2a.1 (s3_reachesN_one hS2b.1), hS2b.2.1, ?_⟩
        intro j' hj' h5 h6
        have hNe6 : s3_scrBase ctx + 6 ≠ s3_scrBase ctx + j' := fun h => h6 (Nat.add_left_cancel h).symm
        rw [hS2b.2.2.2 j' hj' h5, s3_getElem?_setElem?_ne _ _ _ _ _ hNe6 hMove6.1, hS2a.2.2.2 j' hj' h6]

