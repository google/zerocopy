private theorem s3_usize_scalar_checkVal (n : Nat) (hn : n < maxUsize) :
    checkVal (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }) usizeTy = true := by
  unfold checkVal usizeTy Val.ty?
  dsimp
  rw [s3_usize_scalar_wf n hn]
  rfl

private theorem s3_evalConstLit_usize_lt128 (n : Nat) (hn : n < maxUsize) :
    n < Nat.pow 2 128 := by
  have h65 : Nat.pow 2 64 < Nat.pow 2 65 :=
    s3_nat_lt_two_mul_self (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)
  exact Nat.lt_trans hn (Nat.lt_of_lt_of_le h65 (s3_nat_pow_two_mono (a := 65) (b := 128) (by decide)))

private theorem s3_truncateBits_isize (n : Nat) (hn : n < Nat.pow 2 128) :
    truncateBits .isize (BitVec.ofNat 128 n) = BitVec.ofNat 128 (Nat.mod n maxUsize) := by
  unfold truncateBits bvExtractLsb bvExtractLsb' bvZeroExtend
  dsimp
  have hBW : IntWidth.isize.bitWidth - 1 + 1 = 64 := rfl
  rw [s3_bitvec_toNat_ofNat_lt n hn, hBW]
  rfl

private theorem s3_nat_mod_mul_right_mod (n a b : Nat) :
    Nat.mod (Nat.mod n (a * b)) a = Nat.mod n a := by
  have h1 : Nat.mod (a * b * Nat.div n (a * b) + Nat.mod n (a * b)) a = Nat.mod n a := by
    rw [s3_nat_div_add_mod]
  rw [Nat.mul_assoc, s3_nat_mul_add_mod] at h1
  exact h1

private theorem s3_truncateScalar_isize_ofNat (n : Nat) :
    truncateScalar .isize false (Int.ofNat n) =
      .ok ({ width := .isize, signed := false, bits := BitVec.ofNat 128 (Nat.mod n maxUsize) },
           BitVec.ofNat 128 (Nat.mod n maxUsize) != BitVec.ofNat 128 (Nat.mod n (Nat.pow 2 128))) := by
  unfold truncateScalar
  dsimp
  have hm : 0 < maxUsize := s3_nat_pow_pos 2 (Nat.succ_pos 1) 64
  have h128Pos : 0 < Nat.pow 2 128 := s3_nat_pow_pos 2 (Nat.succ_pos 1) 128
  have hN128 : Nat.mod n (Nat.pow 2 128) < Nat.pow 2 128 := s3_nat_mod_lt n h128Pos
  unfold bvOfInt
  dsimp
  have hEm : (intEmod (Int.ofNat n) (Int.ofNat (Nat.pow 2 128))).toNat = Nat.mod n (Nat.pow 2 128) := rfl
  change Except.ok (({ width := IntWidth.isize, signed := false, bits := truncateBits IntWidth.isize (BitVec.ofNat 128 (intEmod (Int.ofNat n) (Int.ofNat (Nat.pow 2 128))).toNat) } : ScalarVal), truncateBits IntWidth.isize (BitVec.ofNat 128 (intEmod (Int.ofNat n) (Int.ofNat (Nat.pow 2 128))).toNat) != BitVec.ofNat 128 (intEmod (Int.ofNat n) (Int.ofNat (Nat.pow 2 128))).toNat) = Except.ok (({ width := IntWidth.isize, signed := false, bits := BitVec.ofNat 128 (Nat.mod n maxUsize) } : ScalarVal), BitVec.ofNat 128 (Nat.mod n maxUsize) != BitVec.ofNat 128 (Nat.mod n (Nat.pow 2 128)))
  rw [hEm]
  rw [s3_truncateBits_isize _ hN128]
  have hModEq : Nat.mod (Nat.mod n (Nat.pow 2 128)) maxUsize = Nat.mod n maxUsize := by
    have hPow128 : Nat.pow 2 128 = maxUsize * maxUsize := by
      change Nat.pow 2 (64 + 64) = Nat.pow 2 64 * Nat.pow 2 64
      exact s3_nat_pow_add 2 64 64
    rw [hPow128]
    exact s3_nat_mod_mul_right_mod n maxUsize maxUsize
  rw [hModEq]

private theorem s3_truncateScalar_isize_ofNat_lt (n : Nat) (hn : n < maxUsize) :
    truncateScalar .isize false (Int.ofNat n) =
      .ok ({ width := .isize, signed := false, bits := BitVec.ofNat 128 n }, false) := by
  rw [s3_truncateScalar_isize_ofNat n]
  rw [s3_nat_mod_eq_of_lt hn, s3_nat_mod_eq_of_lt (s3_evalConstLit_usize_lt128 n hn)]
  have hBne : (BitVec.ofNat 128 n != BitVec.ofNat 128 n) = false := by
    change (!(BitVec.ofNat 128 n == BitVec.ofNat 128 n)) = false
    rw [BEq.refl]
    rfl
  rw [hBne]

private theorem s3_pow2_128_eq : maxUsize < Nat.pow 2 128 := by
  have h65 : Nat.pow 2 64 < Nat.pow 2 65 :=
    s3_nat_lt_two_mul_self (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)
  exact Nat.lt_of_lt_of_le h65 (s3_nat_pow_two_mono (a := 65) (b := 128) (by decide))

private theorem s3_pow2_64_lt_pow2_127 : Nat.pow 2 64 < Nat.pow 2 127 := by
