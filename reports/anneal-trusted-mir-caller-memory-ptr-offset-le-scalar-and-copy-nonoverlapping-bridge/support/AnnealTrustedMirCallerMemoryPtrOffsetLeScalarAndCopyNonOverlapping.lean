private theorem terminatorEq_eq : ∀ a b : TerminatorKind, terminatorEq a b = true → a = b
  | .goto t₁, .goto t₂, h => by rw [nat_beq_eq t₁ t₂ h]
  | .switchInt d₁ ts₁, .switchInt d₂ ts₂, h => by
    have hAnd := (bool_and_eq_true _ _).mp h
    rw [operandEq_eq d₁ d₂ hAnd.1, switchTargetsEq_eq ts₁ ts₂ hAnd.2]
  | .return_, .return_, _ => rfl
  | .unreachable, .unreachable, _ => rfl
  | .unwindResume, .unwindResume, _ => rfl
  | .unsupported, .unsupported, _ => rfl
  | .assert c₁ e₁ m₁ t₁ u₁, .assert c₂ e₂ m₂ t₂ u₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
    have h2 := (bool_and_eq_true _ _).mp h1.1
    have h3 := (bool_and_eq_true _ _).mp h2.1
    have h4 := (bool_and_eq_true _ _).mp h3.1
    rw [operandEq_eq c₁ c₂ h4.1, boolEq_eq e₁ e₂ h4.2,
      assertKindEq_eq m₁ m₂ h3.2, nat_beq_eq t₁ t₂ h2.2, unwindActionEq_eq u₁ u₂ h1.2]
  | .call f₁ a₁ d₁ t₁ u₁, .call f₂ a₂ d₂ t₂ u₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
    have h2 := (bool_and_eq_true _ _).mp h1.1
    have h3 := (bool_and_eq_true _ _).mp h2.1
    have h4 := (bool_and_eq_true _ _).mp h3.1
    rw [nat_beq_eq f₁ f₂ h4.1, listRel_eq_of_eq operandEq_eq a₁ a₂ h4.2,
      placeEq_eq d₁ d₂ h3.2, optNatEq_eq t₁ t₂ h2.2, unwindActionEq_eq u₁ u₂ h1.2]
  | .goto _, .switchInt _ _, h | .goto _, .return_, h | .goto _, .unreachable, h
  | .goto _, .unwindResume, h | .goto _, .assert _ _ _ _ _, h | .goto _, .call _ _ _ _ _, h
  | .goto _, .unsupported, h
  | .switchInt _ _, .goto _, h | .switchInt _ _, .return_, h | .switchInt _ _, .unreachable, h
  | .switchInt _ _, .unwindResume, h | .switchInt _ _, .assert _ _ _ _ _, h
  | .switchInt _ _, .call _ _ _ _ _, h | .switchInt _ _, .unsupported, h
  | .return_, .goto _, h | .return_, .switchInt _ _, h | .return_, .unreachable, h
  | .return_, .unwindResume, h | .return_, .assert _ _ _ _ _, h | .return_, .call _ _ _ _ _, h
  | .return_, .unsupported, h
  | .unreachable, .goto _, h | .unreachable, .switchInt _ _, h | .unreachable, .return_, h
  | .unreachable, .unwindResume, h | .unreachable, .assert _ _ _ _ _, h
  | .unreachable, .call _ _ _ _ _, h | .unreachable, .unsupported, h
  | .unwindResume, .goto _, h | .unwindResume, .switchInt _ _, h | .unwindResume, .return_, h
  | .unwindResume, .unreachable, h | .unwindResume, .assert _ _ _ _ _, h
  | .unwindResume, .call _ _ _ _ _, h | .unwindResume, .unsupported, h
  | .assert _ _ _ _ _, .goto _, h | .assert _ _ _ _ _, .switchInt _ _, h
  | .assert _ _ _ _ _, .return_, h | .assert _ _ _ _ _, .unreachable, h
  | .assert _ _ _ _ _, .unwindResume, h | .assert _ _ _ _ _, .call _ _ _ _ _, h
  | .assert _ _ _ _ _, .unsupported, h
  | .call _ _ _ _ _, .goto _, h | .call _ _ _ _ _, .switchInt _ _, h
  | .call _ _ _ _ _, .return_, h | .call _ _ _ _ _, .unreachable, h
  | .call _ _ _ _ _, .unwindResume, h | .call _ _ _ _ _, .assert _ _ _ _ _, h
  | .call _ _ _ _ _, .unsupported, h
  | .unsupported, .goto _, h | .unsupported, .switchInt _ _, h | .unsupported, .return_, h
  | .unsupported, .unreachable, h | .unsupported, .unwindResume, h
  | .unsupported, .assert _ _ _ _ _, h | .unsupported, .call _ _ _ _ _, h => by cases h

private theorem leWidthEq_eq (a b : LeWidth) (h : leWidthEq a b = true) : a = b := by
