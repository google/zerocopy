        | true =>
          rw [hNullS] at hNNResS
          dsimp at hNNResS
          dsimp
          cases hNNResS with | intro sBad hsBad =>
          exact ⟨_, sBad, s3x_reachesN_trans hReachAB hsBad.1, hsBad.2⟩
        | false =>
          rw [hNullS] at hNNResS
          dsimp at hNNResS
          cases hNNResS with | intro sC hSC =>
          have hReachABC := s3x_reachesN_trans hReachAB hSC.1
          have hPresNS : ∀ j' : Nat, j' < 5 →
              Trusted.MirSemantics.getElem? sC (s3_scrBase ctx + j') =
                Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') := by
            intro j' hj5
            rw [hSC.2.2 j' (Nat.lt_trans hj5 (by decide : 5 < 12)) (Nat.ne_of_lt hj5) (Nat.ne_of_lt (Nat.lt_trans hj5 (by decide : 5 < 6)))]
            exact hPresD j' hj5
          have hC2 : Trusted.MirSemantics.getElem? sC (s3_scrBase ctx + 2) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagD })))) := by
            rw [hPresNS 2 (by decide), hS2]
          have hC3 : Trusted.MirSemantics.getElem? sC (s3_scrBase ctx + 3) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvDst.offsetBytes.toNat })))) := by
            rw [hPresNS 3 (by decide), hS3]
          have hLenNNS : (mkPtrNonNullCheckStmts (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6)).length = 2 := rfl
          rw [hLenNNS] at hWinNND
          have hNND0 := hWinNND 0 _ rfl
          rw [Nat.add_zero] at hNND0
          have hNND1 := hWinNND 1 _ rfl
          have hNNResD := s3_exec_mkPtrNonNullCheckStmts ctx (mem := mem) optBufD 2 3 tagD pvDst.offsetBytes.toNat pvDst
            (by decide) (by decide) hTagDLt (s3x_uint64_toNat_lt_maxUsize pvDst.offsetBytes)
            hMatchD rfl hSC.2.1 hC2 hC3 hBbTgt hNND0 hNND1
          cases hNullD : isNullPtr pvDst with
          | true =>
            rw [hNullD] at hNNResD
            dsimp at hNNResD
            dsimp
            cases hNNResD with | intro sBad hsBad =>
            exact ⟨_, sBad, s3x_reachesN_trans hReachABC hsBad.1, hsBad.2⟩
          | false =>
            rw [hNullD] at hNNResD
            dsimp at hNNResD
            dsimp
            cases hNNResD with | intro sD hSD =>
            have hReachABCD := s3x_reachesN_trans hReachABC hSD.1
            have hPresND : ∀ j' : Nat, j' < 5 →
                Trusted.MirSemantics.getElem? sD (s3_scrBase ctx + j') =
                  Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j') := by
              intro j' hj5
              rw [hSD.2.2 j' (Nat.lt_trans hj5 (by decide : 5 < 12)) (Nat.ne_of_lt hj5) (Nat.ne_of_lt (Nat.lt_trans hj5 (by decide : 5 < 6)))]
              exact hPresNS j' hj5
            have hLenAlNN : (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2 ++
                mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2 ++
                (mkPtrNonNullCheckStmts (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) ++
                 mkPtrNonNullCheckStmts (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6))).length =
                (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length +
                (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length +
                2 + 2 := by
              rw [List.length_append, List.length_append, List.length_append]; rfl
            rw [hLenAlNN, ← Nat.add_assoc startIdx _ 2, ← Nat.add_assoc startIdx _ 2,
                ← Nat.add_assoc startIdx _ _]
            exact ⟨sD, hReachABCD, hSD.2.1, hPresND⟩

private theorem s3x_copy_checkBb_sim (ctx : s3_PtrCtx)
    {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (bufS bufD : LocalId) (sizeS alS : Nat) (mutS : Mutability) (sizeD alD : Nat)
    (extraBase nextBb tagS tagD byteLen : Nat) (pvSrc pvDst : PtrVal)
    (hDeclS : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufS = some (.byteBuf sizeS alS mutS))
    (hSizeSLe : sizeS ≤ 32)
    (hDeclD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufD = some (.byteBuf sizeD alD .mut))
    (hSizeDLe : sizeD ≤ 32)
    (hByteLenLe : byteLen ≤ maxIsize)
    (hTagSLt : tagS < maxUsize) (hTagDLt : tagD < maxUsize)
    (hMatchS : s3_PtrTagMatches (some bufS) pvSrc tagS)
    (hMatchD : s3_PtrTagMatches (some bufD) pvDst tagD)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hS0 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 0) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagS })))))
    (hS1 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 1) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvSrc.offsetBytes.toNat })))))
    (hS2 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 2) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagD })))))
    (hS3 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 3) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvDst.offsetBytes.toNat })))))
    (hS4 : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 4) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 byteLen })))))
    (hExtraWin : ∀ (k : Nat) (eb : MemCopyBlock),
      Trusted.MirSemantics.getElem?
        (let boundsStmts : List MemCopyStmt := [
          mkSubUncheckedUsize (s3_scrBase ctx + 5) (.copy { localId := s3_scrBase ctx + 0, projection := [] }) (usizeConst 1),
          mkSubUncheckedUsize (s3_scrBase ctx + 5) (.copy { localId := s3_scrBase ctx + 2, projection := [] }) (usizeConst 1),
          .bufLivenessCheck bufS,
          .bufLivenessCheck bufD,
          mkSubUncheckedUsize (s3_scrBase ctx + 6) (usizeConst sizeS) (.copy { localId := s3_scrBase ctx + 4, projection := [] }),
          mkSubUncheckedUsize (s3_scrBase ctx + 5) (.move { localId := s3_scrBase ctx + 6, projection := [] }) (.copy { localId := s3_scrBase ctx + 1, projection := [] }),
          mkSubUncheckedUsize (s3_scrBase ctx + 6) (usizeConst sizeD) (.copy { localId := s3_scrBase ctx + 4, projection := [] }),
          mkSubUncheckedUsize (s3_scrBase ctx + 5) (.move { localId := s3_scrBase ctx + 6, projection := [] }) (.copy { localId := s3_scrBase ctx + 3, projection := [] }),
          mkAssignUse (s3_scrBase ctx + 7) (usizeConst 0)
        ]
        let checkBb : MemCopyBlock :=
          if Nat.beq bufS bufD then
            { statements := boundsStmts ++ [
                mkBinOpStmt (s3_scrBase ctx + 5) .add (.copy { localId := s3_scrBase ctx + 1, projection := [] }) (.copy { localId := s3_scrBase ctx + 4, projection := [] }),
                mkBinOpStmt (s3_scrBase ctx + 10) .le (.move { localId := s3_scrBase ctx + 5, projection := [] }) (.copy { localId := s3_scrBase ctx + 3, projection := [] }),
                mkBinOpStmt (s3_scrBase ctx + 6) .add (.copy { localId := s3_scrBase ctx + 3, projection := [] }) (.copy { localId := s3_scrBase ctx + 4, projection := [] }),
                mkBinOpStmt (s3_scrBase ctx + 11) .le (.move { localId := s3_scrBase ctx + 6, projection := [] }) (.copy { localId := s3_scrBase ctx + 1, projection := [] }),
                mkBinOpStmt (s3_scrBase ctx + 10) .bitOr (.move { localId := s3_scrBase ctx + 10, projection := [] }) (.move { localId := s3_scrBase ctx + 11, projection := [] })
              ]
              terminator := .baseTerm (.switchInt (.move { localId := s3_scrBase ctx + 10, projection := [] })
                { branches := [(BitVec.ofNat 128 1, extraBase + 1)], otherwise := extraBase + 4 })
              cleanup := false }
          else
            { statements := boundsStmts, terminator := .baseTerm (.goto (extraBase + 1)), cleanup := false }
        let loopHeadBb : MemCopyBlock := {
          statements := [mkBinOpStmt (s3_scrBase ctx + 10) .lt (.copy { localId := s3_scrBase ctx + 7, projection := [] }) (.copy { localId := s3_scrBase ctx + 4, projection := [] })]
          terminator := .baseTerm (.switchInt (.move { localId := s3_scrBase ctx + 10, projection := [] })
            { branches := [(BitVec.ofNat 128 1, extraBase + 2)], otherwise := nextBb })
          cleanup := false }
        let loopReadBb : MemCopyBlock := {
          statements := [mkBinOpStmt (s3_scrBase ctx + 5) .add (.copy { localId := s3_scrBase ctx + 1, projection := [] }) (.copy { localId := s3_scrBase ctx + 7, projection := [] })]
          terminator := .readBufRawByte (s3_scrBase ctx + 8) (s3_scrBase ctx + 9) bufS (.move { localId := s3_scrBase ctx + 5, projection := [] }) (extraBase + 3)
          cleanup := false }
        let loopWriteBb : MemCopyBlock := {
          statements := [
            mkBinOpStmt (s3_scrBase ctx + 5) .add (.copy { localId := s3_scrBase ctx + 3, projection := [] }) (.copy { localId := s3_scrBase ctx + 7, projection := [] }),
            mkBinOpStmt (s3_scrBase ctx + 7) .add (.move { localId := s3_scrBase ctx + 7, projection := [] }) (usizeConst 1)
          ]
          terminator := .writeBufRawByte bufD (.move { localId := s3_scrBase ctx + 5, projection := [] })
            (.move { localId := s3_scrBase ctx + 8, projection := [] }) (.move { localId := s3_scrBase ctx + 9, projection := [] }) (extraBase + 1)
          cleanup := false }
        let trapBb : MemCopyBlock := { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
        [checkBb, loopHeadBb, loopReadBb, loopWriteBb, trapBb]) k = some eb →
        Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks (extraBase + k) = some eb) :
    match pvSrc.allocId, pvDst.allocId with
    | some srcAid, some dstAid =>
      match findAlloc? srcAid mem.allocations, findAlloc? dstAid mem.allocations with
      | some srcAlloc, some dstAlloc =>
        let srcOff := pvSrc.offsetBytes.toNat
        let dstOff := pvDst.offsetBytes.toNat
        let nonOverlap : Bool :=
          !Nat.beq srcAid dstAid || Nat.ble (srcOff + byteLen) dstOff || Nat.ble (dstOff + byteLen) srcOff
        if !srcAlloc.live || !dstAlloc.live || !(Mutability.beq dstAlloc.mutability .mut) ||
            !Nat.ble (srcOff + byteLen) srcAlloc.bytes.length ||
            !Nat.ble (dstOff + byteLen) dstAlloc.bytes.length || !nonOverlap then
          ∃ n sBad,
            ReachesNMemCopy ctx.pTgt n
                { frames := [{ defId := ctx.plan.defId, blockIdx := extraBase, stmtIdx := 0, locals := slots₂ }], mem := mem }
                sBad ∧
              evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined
        else
          srcAid = internalAllocBase + bufS ∧
          dstAid = internalAllocBase + bufD ∧
          srcAlloc.live = true ∧ dstAlloc.live = true ∧ dstAlloc.mutability = .mut ∧
          srcAlloc.bytes.length = sizeS ∧ dstAlloc.bytes.length = sizeD ∧
          srcOff + byteLen ≤ srcAlloc.bytes.length ∧
          dstOff + byteLen ≤ dstAlloc.bytes.length ∧
          (bufS ≠ bufD ∨ (srcOff + byteLen ≤ dstOff ∨ dstOff + byteLen ≤ srcOff)) ∧
          ∃ n slots₂',
            ReachesNMemCopy ctx.pTgt (n + 1)
                { frames := [{ defId := ctx.plan.defId, blockIdx := extraBase, stmtIdx := 0, locals := slots₂ }], mem := mem }
                { frames := [{ defId := ctx.plan.defId, blockIdx := extraBase + 1, stmtIdx := 0, locals := slots₂' }], mem := mem } ∧
            s3_SlotsRel ctx slots₁ slots₂' ∧
            Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 1) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 srcOff })))) ∧
            Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 3) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 dstOff })))) ∧
            Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 4) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 byteLen })))) ∧
            Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 7) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 0 }))))
      | _, _ =>
        ∃ n sBad,
          ReachesNMemCopy ctx.pTgt n
              { frames := [{ defId := ctx.plan.defId, blockIdx := extraBase, stmtIdx := 0, locals := slots₂ }], mem := mem }
              sBad ∧
            evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined
    | _, _ =>
      ∃ n sBad,
        ReachesNMemCopy ctx.pTgt n
            { frames := [{ defId := ctx.plan.defId, blockIdx := extraBase, stmtIdx := 0, locals := slots₂ }], mem := mem }
            sBad ∧
          evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined := by
  have hBbCheck := hExtraWin 0 _ rfl
  rw [Nat.add_zero] at hBbCheck
  have hBbTrap := hExtraWin 4 _ rfl
  have hByteLenLt : byteLen < maxUsize := Nat.lt_of_le_of_lt hByteLenLe s3x_maxIsize_lt_maxUsize
  have hSizeSLt : sizeS < maxUsize := Nat.lt_of_le_of_lt hSizeSLe (by decide : 32 < maxUsize)
  have hSizeDLt : sizeD < maxUsize := Nat.lt_of_le_of_lt hSizeDLe (by decide : 32 < maxUsize)
  have hOffSLt : pvSrc.offsetBytes.toNat < maxUsize := s3x_uint64_toNat_lt_maxUsize pvSrc.offsetBytes
  have hOffDLt : pvDst.offsetBytes.toNat < maxUsize := s3x_uint64_toNat_lt_maxUsize pvDst.offsetBytes
  let boundsStmts : List MemCopyStmt := [
    mkSubUncheckedUsize (s3_scrBase ctx + 5) (.copy { localId := s3_scrBase ctx + 0, projection := [] }) (usizeConst 1),
    mkSubUncheckedUsize (s3_scrBase ctx + 5) (.copy { localId := s3_scrBase ctx + 2, projection := [] }) (usizeConst 1),
