  | .baseStmt _, .bufLivenessCheck _, h | .baseStmt _, .mkNullPtr _, h
  | .baseStmt _, .mkDanglingPtr _ _, h | .baseStmt _, .addrOfByteBuf _ _, h
  | .baseStmt _, .copyPtr _ _ _, h | .baseStmt _, .ptrWrappingOffset _ _ _ _, h
  | .bufLivenessCheck _, .baseStmt _, h | .bufLivenessCheck _, .mkNullPtr _, h
  | .bufLivenessCheck _, .mkDanglingPtr _ _, h | .bufLivenessCheck _, .addrOfByteBuf _ _, h
  | .bufLivenessCheck _, .copyPtr _ _ _, h | .bufLivenessCheck _, .ptrWrappingOffset _ _ _ _, h
  | .mkNullPtr _, .baseStmt _, h | .mkNullPtr _, .bufLivenessCheck _, h
  | .mkNullPtr _, .mkDanglingPtr _ _, h | .mkNullPtr _, .addrOfByteBuf _ _, h
  | .mkNullPtr _, .copyPtr _ _ _, h | .mkNullPtr _, .ptrWrappingOffset _ _ _ _, h
