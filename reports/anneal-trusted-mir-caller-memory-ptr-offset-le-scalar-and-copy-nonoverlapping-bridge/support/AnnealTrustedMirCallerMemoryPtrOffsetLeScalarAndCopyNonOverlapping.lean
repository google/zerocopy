private theorem getElem?_setElem?_eq {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs' : List α),
      setElem? xs i v = some xs' →
      Trusted.MirSemantics.getElem? xs' i = some v
  | [], _, _, _, h => by cases h
  | _ :: _, 0, _, _, h => by cases h; rfl
  | x :: xs, i + 1, v, xs', h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys =>
      rw [hRec] at h
      cases h
      exact getElem?_setElem?_eq xs i v ys hRec

private theorem getElem?_setElem?_ne {α : Type} :
    ∀ (xs : List α) (i j : Nat) (v : α) (xs' : List α),
      i ≠ j →
      setElem? xs i v = some xs' →
      Trusted.MirSemantics.getElem? xs' j = Trusted.MirSemantics.getElem? xs j
  | [], _, _, _, _, _, h => by cases h
  | _ :: _, 0, 0, _, _, hne, _ => False.elim (hne rfl)
  | _ :: _, 0, _ + 1, _, _, _, h => by cases h; rfl
  | x :: xs, i + 1, 0, v, xs', _, h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys => rw [hRec] at h; cases h; rfl
  | x :: xs, i + 1, j + 1, v, xs', hne, h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys =>
      rw [hRec] at h
      cases h
      exact getElem?_setElem?_ne xs i j v ys (fun eq => hne (congrArg Nat.succ eq)) hRec

private theorem setElem?_length {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs' : List α),
      setElem? xs i v = some xs' → xs'.length = xs.length
  | [], _, _, _, h => by cases h
  | _ :: _, 0, _, _, h => by cases h; rfl
  | x :: xs, i + 1, v, xs', h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys =>
      rw [hRec] at h
      cases h
      change ys.length + 1 = xs.length + 1
      rw [setElem?_length xs i v ys hRec]

private theorem setElem?_isEmpty {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs' : List α),
      setElem? xs i v = some xs' → xs'.isEmpty = xs.isEmpty
  | [], _, _, _, h => by cases h
  | _ :: _, 0, _, _, h => by cases h; rfl
  | x :: xs, i + 1, v, xs', h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys => rw [hRec] at h; cases h; rfl

private theorem any_setElem?_preserves {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (i : Nat) (oldV newV : α) (xs' : List α),
      Trusted.MirSemantics.getElem? xs i = some oldV →
      p newV = p oldV →
      setElem? xs i newV = some xs' →
      xs'.any p = xs.any p
  | [], _, _, _, _, hGet, _, _ => by cases hGet
  | x :: xs, 0, oldV, newV, xs', hGet, hp, hSet => by
    cases hGet; cases hSet
    change (p newV || xs.any p) = (p x || xs.any p)
    rw [hp]
  | x :: xs, i + 1, oldV, newV, xs', hGet, hp, hSet => by
    change (match setElem? xs i newV with | some ys => some (x :: ys) | none => none) = some xs' at hSet
    cases hRec : setElem? xs i newV with
    | none => rw [hRec] at hSet; cases hSet
    | some ys =>
      rw [hRec] at hSet
      cases hSet
      change (p x || ys.any p) = (p x || xs.any p)
      rw [any_setElem?_preserves p xs i oldV newV ys hGet hp hRec]

private theorem all_setElem?_preserves {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (i : Nat) (oldV newV : α) (xs' : List α),
      Trusted.MirSemantics.getElem? xs i = some oldV →
      p newV = p oldV →
      setElem? xs i newV = some xs' →
      xs'.all p = xs.all p
  | [], _, _, _, _, hGet, _, _ => by cases hGet
  | x :: xs, 0, oldV, newV, xs', hGet, hp, hSet => by
    cases hGet; cases hSet
    change (p newV && xs.all p) = (p x && xs.all p)
    rw [hp]
  | x :: xs, i + 1, oldV, newV, xs', hGet, hp, hSet => by
    change (match setElem? xs i newV with | some ys => some (x :: ys) | none => none) = some xs' at hSet
    cases hRec : setElem? xs i newV with
    | none => rw [hRec] at hSet; cases hSet
    | some ys =>
      rw [hRec] at hSet
      cases hSet
      change (p x && ys.all p) = (p x && xs.all p)
      rw [all_setElem?_preserves p xs i oldV newV ys hGet hp hRec]

private theorem int_beq_eq_zero (z : Int) (h : (z == (0 : Int)) = true) : z = 0 := by
  cases hDec : Int.decEq z 0 with
  | isTrue hEq => exact hEq
  | isFalse _ =>
    have hBeq : (z == (0 : Int)) = false := by
      change (@decide (z = 0) (Int.decEq z 0)) = false
      unfold decide
      rw [hDec]
    rw [hBeq] at h
    cases h

private theorem isZeroOffsetConst_evalOffsetCountOp (decls : List MemCopyLocalDecl)
    (slots : List MemCopySlot) (countOp : Operand) (elemSize : Nat)
    (hZero : isZeroOffsetConst countOp elemSize = true) :
    ∃ z : Int,
      evalOffsetCountOp decls slots countOp = .ok (z, slots) ∧
      z * Int.ofNat elemSize = 0 := by
  unfold isZeroOffsetConst at hZero
  cases countOp with
  | copy _ | move _ => cases hZero
  | constant c =>
    dsimp at hZero
    cases hTy : (!(MirTy.beq c.ty usizeTy) && !(MirTy.beq c.ty isizeTy)) with
    | true => rw [hTy] at hZero; cases hZero
    | false =>
      rw [hTy] at hZero
      dsimp at hZero
      cases hLit : evalConstLit c.ty c.lit with
      | error _ => rw [hLit] at hZero; cases hZero
      | ok v =>
        rw [hLit] at hZero
        cases v with
        | bool _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => cases hZero
        | scalar sv =>
          dsimp at hZero
          have hAnd := (bool_and_eq_true _ _).mp hZero
          refine ⟨decodeScalar sv, ?_, int_beq_eq_zero _ hAnd.2⟩
          unfold evalOffsetCountOp evalMemCopyBaseOperandToSlot
          dsimp
          rw [hLit]
          dsimp
          rw [hTy]
          dsimp
          rw [hAnd.1]
          rfl

private theorem intEmod_ofNat_lt (a m : Nat) (hm : 0 < m) (ha : a < m) :
    (intEmod (Int.ofNat a) (Int.ofNat m)).toNat = a := by
  unfold intEmod
  dsimp
  have hMod : Nat.mod a (Int.ofNat m).natAbs = a := Nat.mod_eq_of_lt ha
  have _ := hm
  change Int.toNat (Int.ofNat (Nat.mod a (Int.ofNat m).natAbs)) = a
  rw [hMod]
  rfl

private theorem calcWrappingOffset_zero (pv : PtrVal) (z : Int) (elemSize : Nat)
    (hz : z * Int.ofNat elemSize = 0) :
    calcWrappingOffset pv z elemSize = { pv with width := .isize } := by
  unfold calcWrappingOffset
  rw [hz]
  cases pv with
  | mk aid off w =>
    dsimp
    have hMod : (intEmod (Int.ofNat off.toNat + 0) (Int.ofNat maxUsize)).toNat = off.toNat := by
      have hZ : Int.ofNat off.toNat + 0 = Int.ofNat off.toNat := by rfl
      rw [hZ]
      exact intEmod_ofNat_lt off.toNat maxUsize (by decide) off.toBitVec.isLt
    change PtrVal.mk aid
        (UInt64.ofNat (intEmod (Int.ofNat off.toNat + 0) (Int.ofNat maxUsize)).toNat) .isize =
      PtrVal.mk aid off .isize
    rw [hMod]
    have hU : UInt64.ofNat off.toNat = off := by
      cases off with
      | ofBitVec bv =>
        cases bv with
        | ofFin fb =>
          cases fb with
          | mk v hv =>
            exact congrArg (fun f => UInt64.ofBitVec (BitVec.ofFin f)) (Fin.eq_of_val_eq (Nat.mod_eq_of_lt hv))
    rw [hU]

private theorem writePtrLocal_with_isize (decls : List MemCopyLocalDecl)
    (slots : List MemCopySlot) (dstPtr : LocalId) (pv : PtrVal) :
    writePtrLocal decls slots dstPtr { pv with width := .isize } =
    writePtrLocal decls slots dstPtr pv := by
  unfold writePtrLocal
  rfl

private theorem ptrWrappingOffset_eq_copyPtr_eval (body : MemCopyBody)
    (frame : MemCopyFrame) (mem : CallerMemory) (dstPtr srcPtr : LocalId)
    (countOp : Operand) (elemSize : Nat)
    (hZero : isZeroOffsetConst countOp elemSize = true) :
    evalMemCopyStmt body frame mem (.ptrWrappingOffset dstPtr srcPtr countOp elemSize) =
    evalMemCopyStmt body frame mem (.copyPtr dstPtr srcPtr false) := by
  cases isZeroOffsetConst_evalOffsetCountOp body.locals frame.locals countOp elemSize hZero with
  | intro z hz =>
    unfold evalMemCopyStmt
    dsimp
    rw [hz.1]
    dsimp
    cases hRead : readPtrLocal body.locals frame.locals srcPtr false with
    | error k => rfl
    | ok pair =>
      dsimp
      rw [calcWrappingOffset_zero pair.fst z elemSize hz.2,
        writePtrLocal_with_isize body.locals pair.snd dstPtr pair.fst]

private theorem mirGetElem?_some_lt {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α), Trusted.MirSemantics.getElem? xs i = some x → i < xs.length
  | [], _, _, h => by cases h
  | _ :: _, 0, _, _ => Nat.zero_lt_succ _
  | _ :: xs, i + 1, x, h => Nat.succ_lt_succ (mirGetElem?_some_lt xs i x h)

private theorem mirGetElem?_lt_some {α : Type} :
    ∀ (xs : List α) (i : Nat), i < xs.length → ∃ x : α, Trusted.MirSemantics.getElem? xs i = some x
  | [], i, h => False.elim (Nat.not_lt_zero i h)
  | x :: _, 0, _ => ⟨x, rfl⟩
  | _ :: xs, i + 1, h => mirGetElem?_lt_some xs i (Nat.lt_of_succ_lt_succ h)

private theorem mirGetElem?_ge_none {α : Type} :
    ∀ (xs : List α) (i : Nat), xs.length ≤ i → Trusted.MirSemantics.getElem? xs i = none
  | [], 0, _ => rfl
  | [], _ + 1, _ => rfl
  | _ :: _, 0, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, i + 1, h => mirGetElem?_ge_none xs i (Nat.le_of_succ_le_succ h)

private theorem getElem?_append_lt {α : Type} :
    ∀ (xs ys : List α) (i : Nat), i < xs.length →
      Trusted.MirSemantics.getElem? (xs ++ ys) i = Trusted.MirSemantics.getElem? xs i
  | [], _, i, h => False.elim (Nat.not_lt_zero i h)
  | _ :: _, _, 0, _ => rfl
  | _ :: xs, ys, i + 1, h =>
    getElem?_append_lt xs ys i (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_append_eq_length {α : Type} :
    ∀ (xs : List α) (y : α),
      Trusted.MirSemantics.getElem? (xs ++ [y]) xs.length = some y
  | [], _ => rfl
  | _ :: xs, y => getElem?_append_eq_length xs y

private theorem getElem?_append_gt {α : Type} :
    ∀ (xs : List α) (y : α) (i : Nat), xs.length + 1 ≤ i →
      Trusted.MirSemantics.getElem? (xs ++ [y]) i = none
  | [], _, 0, h => False.elim (Nat.not_lt_zero _ h)
  | [], _, _ + 1, _ => rfl
  | _ :: _, _, 0, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, y, i + 1, h =>
    getElem?_append_gt xs y i (Nat.le_of_succ_le_succ h)

private theorem list_append_singleton_length {α : Type} (xs : List α) (y : α) :
    (xs ++ [y]).length = xs.length + 1 := by
  induction xs with
  | nil => rfl
  | cons _ xs ih =>
    change (xs ++ [y]).length + 1 = (xs.length + 1) + 1
    rw [ih]

private noncomputable def MemCopyBodyStorageEq (a b : MemCopyBody) : Prop :=
  a.argumentCount = b.argumentCount ∧
  a.locals = b.locals ∧
  a.basicBlocks.isEmpty = b.basicBlocks.isEmpty ∧
  a.isUnsafe = b.isUnsafe ∧
  a.acceptsCallerMem = b.acceptsCallerMem ∧
  memCopyStorageAnnotationsInBounds a = memCopyStorageAnnotationsInBounds b ∧
  (∀ id : LocalId, memCopyHasStorageAnnotation a id = memCopyHasStorageAnnotation b id)

private theorem memCopyBodyStorageEq_initLocals {a b : MemCopyBody}
    (h : MemCopyBodyStorageEq a b) (args : List Val) :
    ∀ (idx : Nat) (decls : List MemCopyLocalDecl),
      initMemCopyLocalsLoop a args idx decls = initMemCopyLocalsLoop b args idx decls
  | _, [] => rfl
  | idx, _ :: ds => by
    unfold initMemCopyLocalsLoop
    rw [h.1, h.2.2.2.2.2.2 idx, memCopyBodyStorageEq_initLocals h args (idx + 1) ds]

private theorem memCopyBodyStorageEq_buildAllocs {a b : MemCopyBody}
    (h : MemCopyBodyStorageEq a b) :
    ∀ (idx : Nat) (decls : List MemCopyLocalDecl),
      buildInternalBufAllocs a idx decls = buildInternalBufAllocs b idx decls
  | _, [] => rfl
  | idx, .base _ :: ds => memCopyBodyStorageEq_buildAllocs h (idx + 1) ds
  | idx, .ptrLocal :: ds => memCopyBodyStorageEq_buildAllocs h (idx + 1) ds
  | idx, .byteBuf _ _ _ :: ds => by
    unfold buildInternalBufAllocs
    rw [h.2.2.2.2.2.2 idx, memCopyBodyStorageEq_buildAllocs h (idx + 1) ds]

private theorem memCopyBodyStorageEq_evalStmt {a b : MemCopyBody}
    (h : MemCopyBodyStorageEq a b) (frame : MemCopyFrame) (mem : CallerMemory) (stmt : MemCopyStmt) :
    evalMemCopyStmt a frame mem stmt = evalMemCopyStmt b frame mem stmt := by
  unfold evalMemCopyStmt
  rw [h.2.1]

private theorem memCopyBodyStorageEq_evalTerm {a b : MemCopyBody}
    (h : MemCopyBodyStorageEq a b) (bb : MemCopyBlock) (frame : MemCopyFrame) (mem : CallerMemory) :
    evalMemCopyTerm a bb frame mem = evalMemCopyTerm b bb frame mem := by
  unfold evalMemCopyTerm
  rw [h.2.1, h.2.2.2.2.1]

private theorem memCopyBodyStorageEq_init {a b : MemCopyBody}
    (h : MemCopyBodyStorageEq a b) (entryDefId : DefId) (q : Query) :
    ((if (!a.acceptsCallerMem && !q.callerMem.allocations.isEmpty) = true then Except.error FaultKind.unsupported
    else if (a.acceptsCallerMem && !wfExternalCallerMem q.callerMem) = true then Except.error FaultKind.unsupported
    else if a.basicBlocks.isEmpty = true then Except.error FaultKind.unsupported
    else if (!Nat.blt a.argumentCount a.locals.length) = true then Except.error FaultKind.unsupported
    else if (!memCopyStorageAnnotationsInBounds a) = true then Except.error FaultKind.unsupported
    else if (!allMemCopyLocalsSupported a.argumentCount a.acceptsCallerMem 0 a.locals) = true then Except.error FaultKind.unsupported
    else if (!checkMemCopyArgsMatch a.acceptsCallerMem q.callerMem q.args (List.take a.argumentCount (List.drop 1 a.locals))) = true then Except.error FaultKind.unsupported
    else Except.ok { frames := [{ defId := entryDefId, blockIdx := 0, stmtIdx := 0, locals := initMemCopyLocalsLoop a q.args 0 a.locals }], mem := { allocations := q.callerMem.allocations ++ buildInternalBufAllocs a 0 a.locals } }) : Except FaultKind MemCopyState) =
    (if (!b.acceptsCallerMem && !q.callerMem.allocations.isEmpty) = true then Except.error FaultKind.unsupported
    else if (b.acceptsCallerMem && !wfExternalCallerMem q.callerMem) = true then Except.error FaultKind.unsupported
    else if b.basicBlocks.isEmpty = true then Except.error FaultKind.unsupported
    else if (!Nat.blt b.argumentCount b.locals.length) = true then Except.error FaultKind.unsupported
    else if (!memCopyStorageAnnotationsInBounds b) = true then Except.error FaultKind.unsupported
    else if (!allMemCopyLocalsSupported b.argumentCount b.acceptsCallerMem 0 b.locals) = true then Except.error FaultKind.unsupported
    else if (!checkMemCopyArgsMatch b.acceptsCallerMem q.callerMem q.args (List.take b.argumentCount (List.drop 1 b.locals))) = true then Except.error FaultKind.unsupported
    else Except.ok { frames := [{ defId := entryDefId, blockIdx := 0, stmtIdx := 0, locals := initMemCopyLocalsLoop b q.args 0 b.locals }], mem := { allocations := q.callerMem.allocations ++ buildInternalBufAllocs b 0 b.locals } }) := by
  rw [h.1, h.2.1, h.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2.1,
    memCopyBodyStorageEq_initLocals h q.args 0 b.locals,
    memCopyBodyStorageEq_buildAllocs h 0 b.locals]

private theorem list_all_append_singleton {α : Type} (p : α → Bool) (xs : List α) (y : α)
    (hy : p y = true) : (xs ++ [y]).all p = xs.all p := by
  induction xs with
  | nil =>
    change (p y && true) = true
    rw [hy]
    rfl
  | cons x xs ih =>
    change (p x && (xs ++ [y]).all p) = (p x && xs.all p)
    rw [ih]

private theorem list_any_append_singleton {α : Type} (p : α → Bool) (xs : List α) (y : α)
    (hy : p y = false) : (xs ++ [y]).any p = xs.any p := by
  induction xs with
  | nil =>
    change (p y || false) = false
    rw [hy]
    rfl
  | cons x xs ih =>
    change (p x || (xs ++ [y]).any p) = (p x || xs.any p)
    rw [ih]

private theorem applyFoldZeroOffsetStmt_sound
    (bodyId : DefId) (bbIdx : BasicBlockId) (stmtIdx : Nat)
    (pSrc pMid : MemCopyProgram)
    (hApp : applyFoldZeroOffsetStmt bodyId bbIdx stmtIdx pSrc = some pMid) :
    FullSemanticEquivMemCopy pSrc pMid := by
  unfold applyFoldZeroOffsetStmt at hApp
  cases hBody : Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
  | none => rw [hBody] at hApp; cases hApp
  | some body =>
    rw [hBody] at hApp
    dsimp at hApp
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
    | none => rw [hBb] at hApp; cases hApp
    | some bb =>
      rw [hBb] at hApp
      dsimp at hApp
      cases hStmt : Trusted.MirSemantics.getElem? bb.statements stmtIdx with
      | none => rw [hStmt] at hApp; cases hApp
      | some stmt =>
        rw [hStmt] at hApp
        cases stmt with
        | baseStmt _ | copyPtr _ _ _ | bufLivenessCheck _ | mkNullPtr _
        | mkDanglingPtr _ | addrOfByteBuf _ _ =>
          cases hApp
        | ptrWrappingOffset dstPtr srcPtr countOp elemSize =>
          dsimp at hApp
          cases hZero : isZeroOffsetConst countOp elemSize with
          | false => rw [hZero] at hApp; cases hApp
          | true =>
            rw [hZero] at hApp
            dsimp at hApp
            cases hSetSt : setElem? bb.statements stmtIdx (.copyPtr dstPtr srcPtr false) with
            | none => rw [hSetSt] at hApp; cases hApp
            | some stmts' =>
              rw [hSetSt] at hApp
              dsimp at hApp
              cases hSetBb : setElem? body.basicBlocks bbIdx { bb with statements := stmts' } with
              | none => rw [hSetBb] at hApp; cases hApp
              | some bbs' =>
                rw [hSetBb] at hApp
                dsimp at hApp
                cases hSetB : setElem? pSrc.bodies bodyId { body with basicBlocks := bbs' } with
                | none => rw [hSetB] at hApp; cases hApp
                | some bodies' =>
                  rw [hSetB] at hApp
                  cases hApp
                  have hStor : MemCopyBodyStorageEq body { body with basicBlocks := bbs' } := by
                    refine ⟨rfl, rfl, (setElem?_isEmpty _ _ _ _ hSetBb).symm, rfl, rfl, ?_, ?_⟩
                    · unfold memCopyStorageAnnotationsInBounds
                      dsimp
                      have hBlkP : (stmts'.all (fun stmt => match stmt with
                          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id body.locals.length
                          | _ => true)) =
                          (bb.statements.all (fun stmt => match stmt with
                          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id body.locals.length
                          | _ => true)) :=
                        all_setElem?_preserves _ bb.statements stmtIdx
                          (.ptrWrappingOffset dstPtr srcPtr countOp elemSize) (.copyPtr dstPtr srcPtr false)
                          stmts' hStmt rfl hSetSt
                      exact (all_setElem?_preserves _ body.basicBlocks bbIdx bb { bb with statements := stmts' }
                        bbs' hBb hBlkP hSetBb).symm
                    · intro id
                      unfold memCopyHasStorageAnnotation
                      dsimp
                      have hBlkP : stmts'.any (memCopyStmtHasStorageMarker id) =
                          bb.statements.any (memCopyStmtHasStorageMarker id) :=
                        any_setElem?_preserves (memCopyStmtHasStorageMarker id) bb.statements stmtIdx
                          (.ptrWrappingOffset dstPtr srcPtr countOp elemSize) (.copyPtr dstPtr srcPtr false)
                          stmts' hStmt rfl hSetSt
                      exact (any_setElem?_preserves _ body.basicBlocks bbIdx bb { bb with statements := stmts' }
                        bbs' hBb hBlkP hSetBb).symm
                  refine fullSemanticEquivMemCopy_of_step_sim pSrc
                    { pSrc with bodies := bodies' } Eq ?_ ?_
                  · intro q
                    have hInit : initStateMemCopy pSrc q =
                        initStateMemCopy { pSrc with bodies := bodies' } q := by
                      unfold initStateMemCopy
                      dsimp
                      cases !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
                      | true => rfl
                      | false =>
                        dsimp
                        cases hEntry : Nat.beq pSrc.entryDefId bodyId with
                        | true =>
                          have heq := nat_beq_eq _ _ hEntry
                          subst heq
                          rw [hBody, getElem?_setElem?_eq _ _ _ _ hSetB]
                          exact memCopyBodyStorageEq_init hStor pSrc.entryDefId q
                        | false =>
                          have hne := nat_beq_false_ne hEntry
                          rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetB]
                    refine ⟨fun _ => by rw [hInit], fun s₁ hs₁ => ⟨s₁, by rw [← hInit]; exact hs₁, rfl⟩⟩
                  · intro s₁ s₂ hR
                    subst hR
                    have hStepEq : evalStepMemCopy pSrc 0 s₁ =
                        evalStepMemCopy { pSrc with bodies := bodies' } 0 s₁ := by
                      unfold evalStepMemCopy
                      cases s₁.frames with
                      | nil => rfl
                      | cons frame rest =>
                        cases rest with
                        | cons _ _ => rfl
                        | nil =>
                          dsimp
                          cases hDef : Nat.beq frame.defId bodyId with
                          | false =>
                            have hne := nat_beq_false_ne hDef
                            rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetB]
                          | true =>
                            have heqDef := nat_beq_eq _ _ hDef
                            subst heqDef
                            rw [hBody, getElem?_setElem?_eq _ _ _ _ hSetB]
                            dsimp
                            cases hBlk : Nat.beq frame.blockIdx bbIdx with
                            | false =>
                              have hne := nat_beq_false_ne hBlk
                              rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetBb]
                              cases Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
                              | none => rfl
                              | some bbOther =>
                                dsimp
                                cases Trusted.MirSemantics.getElem? bbOther.statements frame.stmtIdx with
                                | some stmtOther => dsimp; exact memCopyBodyStorageEq_evalStmt hStor frame s₁.mem stmtOther
                                | none =>
                                  dsimp
                                  cases Nat.beq frame.stmtIdx bbOther.statements.length with
                                  | true => dsimp; exact memCopyBodyStorageEq_evalTerm hStor bbOther frame s₁.mem
                                  | false => rfl
                            | true =>
                              have heqBlk := nat_beq_eq _ _ hBlk
                              subst heqBlk
                              rw [hBb, getElem?_setElem?_eq _ _ _ _ hSetBb]
                              dsimp
                              rw [setElem?_length _ _ _ _ hSetSt]
                              cases hSt : Nat.beq frame.stmtIdx stmtIdx with
                              | false =>
                                have hne := nat_beq_false_ne hSt
                                rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetSt]
                                cases Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
                                | some stmtOther => exact memCopyBodyStorageEq_evalStmt hStor frame s₁.mem stmtOther
                                | none =>
                                  cases Nat.beq frame.stmtIdx bb.statements.length with
                                  | true => exact memCopyBodyStorageEq_evalTerm hStor bb frame s₁.mem
                                  | false => rfl
                              | true =>
                                have heqSt := nat_beq_eq _ _ hSt
                                subst heqSt
                                rw [hStmt, getElem?_setElem?_eq _ _ _ _ hSetSt]
                                dsimp
                                rw [← memCopyBodyStorageEq_evalStmt hStor frame s₁.mem (.copyPtr dstPtr srcPtr false)]
                                exact ptrWrappingOffset_eq_copyPtr_eval body frame s₁.mem
                                  dstPtr srcPtr countOp elemSize hZero
                    refine ⟨fun s₁' h => ⟨s₁', by rw [← hStepEq]; exact h, rfl⟩,
                      fun out h => by rw [← hStepEq]; exact h,
                      fun k h => by rw [← hStepEq]; exact h⟩

private noncomputable def MemCopyStmtIdxWf (p : MemCopyProgram) (s : MemCopyState) : Prop :=
  match s.frames with
  | [frame] =>
    match Trusted.MirSemantics.getElem? p.bodies frame.defId with
    | some body =>
      match Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
      | some bb => frame.stmtIdx ≤ bb.statements.length
      | none => True
    | none => True
  | _ => True

private theorem memCopyStmtIdxWf_init (p : MemCopyProgram) (q : Query) (s : MemCopyState)
    (hInit : initStateMemCopy p q = .ok s) : MemCopyStmtIdxWf p s := by
  unfold initStateMemCopy at hInit
  cases hPW : !Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1 with
  | true => rw [hPW] at hInit; cases hInit
  | false =>
    rw [hPW] at hInit
    dsimp at hInit
    cases hEntry : Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
    | none => rw [hEntry] at hInit; cases hInit
    | some body =>
      rw [hEntry] at hInit
      dsimp at hInit
      cases hC1 : !body.acceptsCallerMem && !q.callerMem.allocations.isEmpty with
      | true => rw [hC1] at hInit; cases hInit
      | false =>
        rw [hC1] at hInit; dsimp at hInit
        cases hC2 : body.acceptsCallerMem && !wfExternalCallerMem q.callerMem with
        | true => rw [hC2] at hInit; cases hInit
        | false =>
          rw [hC2] at hInit; dsimp at hInit
          cases hC3 : body.basicBlocks.isEmpty with
          | true => rw [hC3] at hInit; cases hInit
          | false =>
            rw [hC3] at hInit; dsimp at hInit
            cases hC4 : !Nat.blt body.argumentCount body.locals.length with
            | true => rw [hC4] at hInit; cases hInit
            | false =>
              rw [hC4] at hInit; dsimp at hInit
              cases hC5 : !memCopyStorageAnnotationsInBounds body with
              | true => rw [hC5] at hInit; cases hInit
              | false =>
                rw [hC5] at hInit; dsimp at hInit
                cases hC6 : !allMemCopyLocalsSupported body.argumentCount body.acceptsCallerMem 0 body.locals with
                | true => rw [hC6] at hInit; cases hInit
                | false =>
                  rw [hC6] at hInit; dsimp at hInit
                  cases hC7 : !checkMemCopyArgsMatch body.acceptsCallerMem q.callerMem q.args
                      (List.take body.argumentCount (List.drop 1 body.locals)) with
                  | true => rw [hC7] at hInit; cases hInit
                  | false =>
                    rw [hC7] at hInit; dsimp at hInit
                    cases hInit
                    unfold MemCopyStmtIdxWf
                    dsimp
                    rw [hEntry]
                    dsimp
                    cases Trusted.MirSemantics.getElem? body.basicBlocks 0 with
                    | none => exact True.intro
                    | some bb => exact Nat.zero_le _

private theorem stepMemCopyNext_wf (p : MemCopyProgram) (frame : MemCopyFrame)
    (body : MemCopyBody) (bb : MemCopyBlock) (mem : CallerMemory) (slots' : List MemCopySlot)
    (s' : MemCopyState)
    (hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId = some body)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx = some bb)
    (hLt : frame.stmtIdx < bb.statements.length)
    (hStep : stepMemCopyNext frame mem slots' = .step s') :
    MemCopyStmtIdxWf p s' := by
  unfold stepMemCopyNext at hStep
  cases hStep
  unfold MemCopyStmtIdxWf
  dsimp
  rw [hBody]
  dsimp
  rw [hBb]
  exact hLt

private theorem jumpMemCopyBlock_wf (p : MemCopyProgram) (frame : MemCopyFrame)
    (mem : CallerMemory) (slots' : List MemCopySlot) (target : BasicBlockId) (s' : MemCopyState)
    (hStep : jumpMemCopyBlock frame mem slots' target = .step s') :
    MemCopyStmtIdxWf p s' := by
  unfold jumpMemCopyBlock at hStep
  cases hStep
  unfold MemCopyStmtIdxWf
  dsimp
  cases Trusted.MirSemantics.getElem? p.bodies frame.defId with
  | none => exact True.intro
  | some body =>
    dsimp
    cases Trusted.MirSemantics.getElem? body.basicBlocks target with
    | none => exact True.intro
    | some _ => exact Nat.zero_le _

private theorem bool_guard_step (b : Bool) (k : FaultKind)
    (res : StepResult MemCopyState TerminalOut) (s' : MemCopyState)
    (h : (if b = true then StepResult.fault k else res) = .step s') :
    b = false ∧ res = .step s' := by
  cases b with
  | true => cases h
  | false => exact ⟨rfl, h⟩

private theorem memCopyStmtIdxWf_step_frame (p : MemCopyProgram) (frame : MemCopyFrame)
    (mem : CallerMemory) (s' : MemCopyState)
    (hStep : (match Trusted.MirSemantics.getElem? p.bodies frame.defId with
      | none => StepResult.fault FaultKind.unsupported
      | some body =>
        match Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
        | none => StepResult.fault FaultKind.unsupported
        | some bb =>
          match Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
          | some stmt => evalMemCopyStmt body frame mem stmt
          | none =>
            if frame.stmtIdx.beq bb.statements.length = true then evalMemCopyTerm body bb frame mem
            else StepResult.fault FaultKind.unsupported) = .step s') :
    MemCopyStmtIdxWf p s' := by
  cases hBody : Trusted.MirSemantics.getElem? p.bodies frame.defId with
  | none => rw [hBody] at hStep; cases hStep
  | some body =>
    rw [hBody] at hStep
    dsimp at hStep
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
    | none => rw [hBb] at hStep; cases hStep
    | some bb =>
      rw [hBb] at hStep
      dsimp at hStep
      cases hSt : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
      | some stmt =>
        have hLt : frame.stmtIdx < bb.statements.length := mirGetElem?_some_lt _ _ _ hSt
        rw [hSt] at hStep
        dsimp at hStep
        unfold evalMemCopyStmt at hStep
        cases stmt with
        | baseStmt bs =>
          dsimp at hStep
          cases bs with
          | nop => dsimp at hStep; exact stepMemCopyNext_wf p frame body bb mem _ s' hBody hBb hLt hStep
          | unsupported => dsimp at hStep; cases hStep
          | storageLive id =>
            dsimp at hStep
            cases hDecl : Trusted.MirSemantics.getElem? body.locals id with
            | none => rw [hDecl] at hStep; cases hStep
            | some decl =>
              rw [hDecl] at hStep; dsimp at hStep
              cases hSlots : setElem? frame.locals id (liveUninitMemCopySlot decl) with
              | none => rw [hSlots] at hStep; cases hStep
              | some slots' =>
                rw [hSlots] at hStep; dsimp at hStep
                cases decl with
                | base _ | ptrLocal =>
                  dsimp at hStep
                  exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hStep
                | byteBuf sz al mutab =>
                  dsimp at hStep
                  cases hAl : updateAlloc? (internalAllocBase + id)
                      { allocId := internalAllocBase + id, alignLog2 := al, mutability := mutab,
                        bytes := listReplicate sz .uninit } mem.allocations with
                  | none => rw [hAl] at hStep; cases hStep
                  | some allocs' =>
                    rw [hAl] at hStep; dsimp at hStep
                    exact stepMemCopyNext_wf p frame body bb { allocations := allocs' } slots' s' hBody hBb hLt hStep
          | storageDead id =>
            dsimp at hStep
            have hNz := (bool_guard_step (Nat.beq id 0) .unsupported _ s' hStep).2
            cases hD : Trusted.MirSemantics.getElem? body.locals id with
            | none =>
              rw [hD] at hNz; dsimp at hNz
              cases hSlots : setElem? frame.locals id (MemCopySlot.baseSlot LocalSlot.dead) with
              | none => rw [hSlots] at hNz; cases hNz
              | some slots' =>
                rw [hSlots] at hNz; dsimp at hNz
                exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hNz
            | some decl =>
              rw [hD] at hNz; dsimp at hNz
              cases hSlots : setElem? frame.locals id (deadMemCopySlot decl) with
              | none => rw [hSlots] at hNz; cases hNz
              | some slots' =>
                rw [hSlots] at hNz; dsimp at hNz
                cases decl with
                | base _ | ptrLocal =>
                  dsimp at hNz
                  exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hNz
                | byteBuf sz al mutab =>
                  dsimp at hNz
                  cases hAl : updateAlloc? (internalAllocBase + id)
                      { allocId := internalAllocBase + id, alignLog2 := al, mutability := mutab,
                        bytes := listReplicate sz .uninit, live := false } mem.allocations with
                  | none => rw [hAl] at hNz; cases hNz
                  | some allocs' =>
                    rw [hAl] at hNz; dsimp at hNz
                    exact stepMemCopyNext_wf p frame body bb { allocations := allocs' } slots' s' hBody hBb hLt hNz
          | assign dst rval =>
            dsimp at hStep
            have hEmpty := (bool_guard_step (!dst.projection.isEmpty) .unsupported _ s' hStep).2
            cases hD : Trusted.MirSemantics.getElem? body.locals dst.localId with
            | none => rw [hD] at hEmpty; cases hEmpty
            | some decl =>
              rw [hD] at hEmpty
              cases decl with
              | byteBuf _ _ _ | ptrLocal => cases hEmpty
              | base dstTy =>
                dsimp at hEmpty
                cases hRval : evalMemCopyBaseRvalue body.locals frame.locals dstTy rval with
                | error k => rw [hRval] at hEmpty; cases hEmpty
                | ok pRval =>
                  rw [hRval] at hEmpty; dsimp at hEmpty
                  cases hWr : writeMemCopyBasePlace pRval.snd dst.localId dstTy pRval.fst with
                  | error k => rw [hWr] at hEmpty; cases hEmpty
                  | ok slots' =>
                    rw [hWr] at hEmpty; dsimp at hEmpty
                    exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hEmpty
        | copyPtr dstPtr srcPtr allowNull =>
          dsimp at hStep
          cases hPtr : readPtrLocal body.locals frame.locals srcPtr allowNull with
          | error k => rw [hPtr] at hStep; cases hStep
          | ok pPtr =>
            rw [hPtr] at hStep; dsimp at hStep
            cases hWr : writePtrLocal body.locals pPtr.snd dstPtr pPtr.fst with
            | error k => rw [hWr] at hStep; cases hStep
            | ok slots' =>
              rw [hWr] at hStep; dsimp at hStep
              exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hStep
        | ptrWrappingOffset dstPtr srcPtr countOp elemSize =>
          dsimp at hStep
          cases hCnt : evalOffsetCountOp body.locals frame.locals countOp with
          | error k => rw [hCnt] at hStep; cases hStep
          | ok pCnt =>
            rw [hCnt] at hStep; dsimp at hStep
            cases hPtr : readPtrLocal body.locals pCnt.snd srcPtr false with
            | error k => rw [hPtr] at hStep; cases hStep
            | ok pPtr =>
              rw [hPtr] at hStep; dsimp at hStep
              cases hWr : writePtrLocal body.locals pPtr.snd dstPtr (calcWrappingOffset pPtr.fst pCnt.fst elemSize) with
              | error k => rw [hWr] at hStep; cases hStep
              | ok slots' =>
                rw [hWr] at hStep; dsimp at hStep
                exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hStep
        | bufLivenessCheck bufLocal =>
          dsimp at hStep
          cases hD : Trusted.MirSemantics.getElem? body.locals bufLocal with
          | none =>
            cases hS : Trusted.MirSemantics.getElem? frame.locals bufLocal <;>
              (rw [hD, hS] at hStep; cases hStep)
          | some decl =>
            cases hS : Trusted.MirSemantics.getElem? frame.locals bufLocal with
            | none => cases decl <;> (rw [hD, hS] at hStep; cases hStep)
            | some sl =>
              rw [hD, hS] at hStep
              cases decl with
              | base _ | ptrLocal => cases sl <;> cases hStep
              | byteBuf _ _ _ =>
                cases sl with
                | baseSlot _ | livePtr _ | ptrDead => cases hStep
                | bufSlot b =>
                  cases b with
                  | false => cases hStep
                  | true => dsimp at hStep; exact stepMemCopyNext_wf p frame body bb mem frame.locals s' hBody hBb hLt hStep
        | mkNullPtr dstPtr =>
          dsimp at hStep
          cases hWr : writePtrLocal body.locals frame.locals dstPtr { allocId := none, offsetBytes := 0 } with
          | error k => rw [hWr] at hStep; cases hStep
          | ok slots' =>
            rw [hWr] at hStep; dsimp at hStep
            exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hStep
        | mkDanglingPtr dstPtr alignLog2 =>
          dsimp at hStep
          have hAl := (bool_guard_step (!Nat.ble alignLog2 30) .unsupported _ s' hStep).2
          cases hWr : writePtrLocal body.locals frame.locals dstPtr { allocId := none, offsetBytes := UInt64.ofNat (Nat.pow 2 alignLog2) } with
          | error k => rw [hWr] at hAl; cases hAl
          | ok slots' =>
            rw [hWr] at hAl; dsimp at hAl
            exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hAl
        | addrOfByteBuf dstPtr bufLocal =>
          dsimp at hStep
          cases hD : Trusted.MirSemantics.getElem? body.locals bufLocal with
          | none =>
            cases hS : Trusted.MirSemantics.getElem? frame.locals bufLocal <;>
              (rw [hD, hS] at hStep; cases hStep)
          | some decl =>
            cases hS : Trusted.MirSemantics.getElem? frame.locals bufLocal with
            | none => cases decl <;> (rw [hD, hS] at hStep; cases hStep)
            | some sl =>
              rw [hD, hS] at hStep
              cases decl with
              | base _ | ptrLocal => cases sl <;> cases hStep
              | byteBuf _ _ _ =>
                cases sl with
                | baseSlot _ | livePtr _ | ptrDead => cases hStep
                | bufSlot b =>
                  cases b with
                  | false =>
                    cases hDst : Trusted.MirSemantics.getElem? body.locals dstPtr with
                    | none => rw [hDst] at hStep; cases hStep
                    | some d => cases d <;> (rw [hDst] at hStep; cases hStep)
                  | true =>
                    dsimp at hStep
                    cases hWr : writePtrLocal body.locals frame.locals dstPtr
                        { allocId := some (internalAllocBase + bufLocal), offsetBytes := 0 } with
                    | error k => rw [hWr] at hStep; cases hStep
                    | ok slots' =>
                      rw [hWr] at hStep; dsimp at hStep
                      exact stepMemCopyNext_wf p frame body bb mem slots' s' hBody hBb hLt hStep
      | none =>
        rw [hSt] at hStep; dsimp at hStep
        cases hLen : frame.stmtIdx.beq bb.statements.length with
        | false => rw [hLen] at hStep; cases hStep
        | true =>
          rw [hLen] at hStep; dsimp at hStep
          unfold evalMemCopyTerm at hStep
          cases bb with
          | mk bbStmts bbTerm bbClean =>
            dsimp at hStep
            cases bbTerm with
            | baseTerm t =>
              cases t with
              | goto target => dsimp at hStep; exact jumpMemCopyBlock_wf p frame mem frame.locals target s' hStep
              | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
                dsimp at hStep; cases hStep
              | return_ =>
                dsimp at hStep
                have hC := (bool_guard_step bbClean .unsupported _ s' hStep).2
                cases hD0 : Trusted.MirSemantics.getElem? body.locals 0 with
                | none =>
                  cases hS0 : Trusted.MirSemantics.getElem? frame.locals 0 with
                  | none => rw [hD0, hS0] at hC; cases hC
                  | some sl =>
                    rw [hD0, hS0] at hC
                    cases sl with
                    | ptrDead | livePtr _ | bufSlot _ => cases hC
                    | baseSlot ls => cases ls with | dead => cases hC | live ov => cases ov <;> cases hC
                | some d0 =>
                  cases hS0 : Trusted.MirSemantics.getElem? frame.locals 0 with
                  | none => cases d0 <;> (rw [hD0, hS0] at hC; cases hC)
                  | some sl =>
                    rw [hD0, hS0] at hC
                    cases d0 with
                    | byteBuf _ _ _ => cases sl <;> cases hC
                    | base _ =>
                      cases sl with
                      | ptrDead | livePtr _ | bufSlot _ => cases hC
                      | baseSlot ls => cases ls with | dead => cases hC | live ov => cases ov <;> cases hC
                    | ptrLocal =>
                      cases sl with
                      | baseSlot _ | ptrDead | bufSlot _ => cases hC
                      | livePtr ov =>
                        cases ov with
                        | none => cases hC
                        | some pv =>
                          dsimp at hC
                          have hAcc := (bool_guard_step (!body.acceptsCallerMem) .unsupported _ s' hC).2
                          cases hAid : pv.allocId with
                          | none => rw [hAid] at hAcc; cases hAcc
                          | some aid =>
                            rw [hAid] at hAcc; dsimp at hAcc
                            have hInb := (bool_guard_step (!Nat.blt aid internalAllocBase) .undefined _ s' hAcc).2
                            cases hInb
              | switchInt discr targets =>
                dsimp at hStep
                cases hDiscr : evalMemCopyPrimitiveOperand body.locals frame.locals discr with
                | error k => rw [hDiscr] at hStep; cases hStep
                | ok pDiscr =>
                  rw [hDiscr] at hStep; dsimp at hStep
                  cases pDiscr with
                  | mk dv sls =>
                    dsimp at hStep
                    cases dv with
                    | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => cases hStep
                    | scalar sv =>
                      dsimp at hStep
                      cases hTgt : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
                      | error k => rw [hTgt] at hStep; cases hStep
                      | ok target =>
                        rw [hTgt] at hStep; dsimp at hStep
                        exact jumpMemCopyBlock_wf p frame mem sls target s' hStep
                    | bool bv =>
                      dsimp at hStep
                      cases hTgt : evalBoolSwitchBranches bv targets.otherwise targets.branches with
                      | error k => rw [hTgt] at hStep; cases hStep
                      | ok target =>
                        rw [hTgt] at hStep; dsimp at hStep
                        exact jumpMemCopyBlock_wf p frame mem sls target s' hStep
            | ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb =>
              dsimp at hStep
              cases hCnt : evalOffsetCountOp body.locals frame.locals countOp with
              | error k => rw [hCnt] at hStep; cases hStep
              | ok pCnt =>
                rw [hCnt] at hStep; dsimp at hStep
                cases hPtr : readPtrLocal body.locals pCnt.snd srcPtr false with
                | error k => rw [hPtr] at hStep; cases hStep
                | ok pPtr =>
                  rw [hPtr] at hStep; dsimp at hStep
                  cases hInb : calcInboundsOffset mem pPtr.fst pCnt.fst elemSize with
                  | error k => rw [hInb] at hStep; cases hStep
                  | ok pv' =>
                    rw [hInb] at hStep; dsimp at hStep
                    cases hWr : writePtrLocal body.locals pPtr.snd dstPtr pv' with
                    | error k => rw [hWr] at hStep; cases hStep
                    | ok slots' =>
                      rw [hWr] at hStep; dsimp at hStep
                      exact jumpMemCopyBlock_wf p frame mem slots' nextBb s' hStep
            | checkPtrPairAlign srcPtr dstPtr _ reqAlignLog2 checkNonNullZero nextBb =>
              dsimp at hStep
              have hAl := (bool_guard_step (!Nat.ble reqAlignLog2 30) .unsupported _ s' hStep).2
              cases hSrc : readPtrLocal body.locals frame.locals srcPtr false with
              | error k => rw [hSrc] at hAl; cases hAl
              | ok pSrc =>
                rw [hSrc] at hAl; dsimp at hAl
                cases hDst : readPtrLocal body.locals pSrc.snd dstPtr false with
                | error k => rw [hDst] at hAl; cases hAl
                | ok pDst =>
                  rw [hDst] at hAl; dsimp at hAl
                  cases hA1 : checkPtrAlignMem mem pSrc.fst reqAlignLog2 with
                  | error k => rw [hA1] at hAl; cases hAl
                  | ok _ =>
                    cases hA2 : checkPtrAlignMem mem pDst.fst reqAlignLog2 with
                    | error k => rw [hA1, hA2] at hAl; cases hAl
                    | ok _ =>
                      rw [hA1, hA2] at hAl; dsimp at hAl
                      have hNull := (bool_guard_step _ .undefined _ s' hAl).2
                      exact jumpMemCopyBlock_wf p frame mem pDst.snd nextBb s' hNull
            | copyNonOverlapping srcPtr dstPtr countOp elemSize reqAlignLog2 checkNonNullZero nextBb =>
              dsimp at hStep
              have hAl := (bool_guard_step (!Nat.ble reqAlignLog2 30) .unsupported _ s' hStep).2
              cases hCnt : evalUsizeOp body.locals frame.locals countOp with
              | error k => rw [hCnt] at hAl; cases hAl
              | ok pCnt =>
                rw [hCnt] at hAl; dsimp at hAl
                cases hSrc : readPtrLocal body.locals pCnt.snd srcPtr false with
                | error k => rw [hSrc] at hAl; cases hAl
                | ok pSrc =>
                  rw [hSrc] at hAl; dsimp at hAl
                  cases hDst : readPtrLocal body.locals pSrc.snd dstPtr false with
                  | error k => rw [hDst] at hAl; cases hAl
                  | ok pDst =>
                    rw [hDst] at hAl; dsimp at hAl
                    cases hMem : evalCopyNonOverlapping mem pSrc.fst pDst.fst pCnt.fst elemSize reqAlignLog2 checkNonNullZero with
                    | error k => rw [hMem] at hAl; cases hAl
                    | ok mem' =>
                      rw [hMem] at hAl; dsimp at hAl
                      exact jumpMemCopyBlock_wf p frame mem' pDst.snd nextBb s' hAl
            | readLeUsize dstLocal ptrLocal w requireAligned nextBb =>
              dsimp at hStep
              cases hD : Trusted.MirSemantics.getElem? body.locals dstLocal with
              | none => rw [hD] at hStep; cases hStep
              | some decl =>
                rw [hD] at hStep
                cases decl with
                | byteBuf _ _ _ | ptrLocal => cases hStep
                | base dstTy =>
                  dsimp at hStep
                  have hTy := (bool_guard_step (!(MirTy.beq dstTy usizeTy)) .unsupported _ s' hStep).2
                  cases hPtr : readPtrLocal body.locals frame.locals ptrLocal false with
                  | error k => rw [hPtr] at hTy; cases hTy
                  | ok pPtr =>
                    rw [hPtr] at hTy; dsimp at hTy
                    cases hBs : readMemSlice mem pPtr.fst w.byteCount (if requireAligned = true then w.naturalAlignLog2 else 0) with
                    | error k => rw [hBs] at hTy; cases hTy
                    | ok bs =>
                      rw [hBs] at hTy; dsimp at hTy
                      cases hDec : decodeLeUsize w bs with
                      | error k => rw [hDec] at hTy; cases hTy
                      | ok valNat =>
                        rw [hDec] at hTy; dsimp at hTy
                        cases hWr : writeMemCopyBasePlace pPtr.snd dstLocal usizeTy
                            (Val.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 valNat }) with
                        | error k => rw [hWr] at hTy; cases hTy
                        | ok slots' =>
                          rw [hWr] at hTy; dsimp at hTy
                          exact jumpMemCopyBlock_wf p frame mem slots' nextBb s' hTy
            | writeLeUsize ptrLocal valOp w requireAligned nextBb =>
              dsimp at hStep
              cases hVal : evalUsizeOp body.locals frame.locals valOp with
              | error k => rw [hVal] at hStep; cases hStep
              | ok pVal =>
                rw [hVal] at hStep; dsimp at hStep
                cases hPtr : readPtrLocal body.locals pVal.snd ptrLocal false with
                | error k => rw [hPtr] at hStep; cases hStep
                | ok pPtr =>
                  rw [hPtr] at hStep; dsimp at hStep
                  cases hWr : writeMemSlice mem pPtr.fst (encodeLeUsize w pVal.fst) (if requireAligned = true then w.naturalAlignLog2 else 0) with
                  | error k => rw [hWr] at hStep; cases hStep
                  | ok mem' =>
                    rw [hWr] at hStep; dsimp at hStep
                    exact jumpMemCopyBlock_wf p frame mem' pPtr.snd nextBb s' hStep
            | readPtrLe8 dstPtr addrPtr requireAligned nextBb =>
              dsimp at hStep
              cases hD : Trusted.MirSemantics.getElem? body.locals dstPtr with
              | none => rw [hD] at hStep; cases hStep
              | some decl =>
                rw [hD] at hStep
                cases decl with
                | base _ | byteBuf _ _ _ => cases hStep
                | ptrLocal =>
                  dsimp at hStep
                  cases hPtr : readPtrLocal body.locals frame.locals addrPtr false with
                  | error k => rw [hPtr] at hStep; cases hStep
                  | ok pPtr =>
                    rw [hPtr] at hStep; dsimp at hStep
                    cases hBs : readMemSlice mem pPtr.fst 8 (if requireAligned = true then 3 else 0) with
                    | error k => rw [hBs] at hStep; cases hStep
                    | ok bs =>
                      rw [hBs] at hStep; dsimp at hStep
                      cases hDec : decodePtrLe8 bs with
                      | error k => rw [hDec] at hStep; cases hStep
                      | ok pvOut =>
                        rw [hDec] at hStep; dsimp at hStep
                        cases hWr : writePtrLocal body.locals pPtr.snd dstPtr pvOut with
                        | error k => rw [hWr] at hStep; cases hStep
                        | ok slots' =>
                          rw [hWr] at hStep; dsimp at hStep
                          exact jumpMemCopyBlock_wf p frame mem slots' nextBb s' hStep
            | writePtrLe8 addrPtr valPtr requireAligned nextBb =>
              dsimp at hStep
              cases hAddr : readPtrLocal body.locals frame.locals addrPtr false with
              | error k => rw [hAddr] at hStep; cases hStep
              | ok pAddr =>
                rw [hAddr] at hStep; dsimp at hStep
                cases hVal : readPtrLocal body.locals pAddr.snd valPtr false with
                | error k => rw [hVal] at hStep; cases hStep
                | ok pVal =>
                  rw [hVal] at hStep; dsimp at hStep
                  cases hWr : writeMemSlice mem pAddr.fst (encodeLeBytesAux pVal.fst.allocId 8 pVal.fst.offsetBytes.toNat) (if requireAligned = true then 3 else 0) with
                  | error k => rw [hWr] at hStep; cases hStep
                  | ok mem' =>
                    rw [hWr] at hStep; dsimp at hStep
                    exact jumpMemCopyBlock_wf p frame mem' pVal.snd nextBb s' hStep
            | readBufRawByte tagDst valDst bufLocal offOp nextBb =>
              dsimp at hStep
              have hNe := (bool_guard_step (Nat.beq tagDst valDst) .unsupported _ s' hStep).2
              cases hDT : Trusted.MirSemantics.getElem? body.locals tagDst with
              | none =>
                cases hDV : Trusted.MirSemantics.getElem? body.locals valDst <;>
                  cases hDB : Trusted.MirSemantics.getElem? body.locals bufLocal <;>
                  (rw [hDT, hDV, hDB] at hNe; cases hNe)
              | some dt =>
                cases hDV : Trusted.MirSemantics.getElem? body.locals valDst with
                | none =>
                  cases hDB : Trusted.MirSemantics.getElem? body.locals bufLocal <;>
                    (cases dt <;> (rw [hDT, hDV, hDB] at hNe; cases hNe))
                | some dv =>
                  cases hDB : Trusted.MirSemantics.getElem? body.locals bufLocal with
                  | none =>
                    cases dt <;> cases dv <;> (rw [hDT, hDV, hDB] at hNe; cases hNe)
                  | some db =>
                    rw [hDT, hDV, hDB] at hNe
                    cases dt with
                    | byteBuf _ _ _ | ptrLocal => cases dv <;> cases db <;> cases hNe
                    | base tTy =>
                      cases dv with
                      | byteBuf _ _ _ | ptrLocal => cases db <;> cases hNe
                      | base vTy =>
                        cases db with
                        | base _ | ptrLocal => cases hNe
                        | byteBuf _ _ _ =>
                          dsimp at hNe
                          have hTy := (bool_guard_step (!(MirTy.beq tTy usizeTy) || !(MirTy.beq vTy usizeTy)) .unsupported _ s' hNe).2
                          cases hOff : evalUsizeOp body.locals frame.locals offOp with
                          | error k => rw [hOff] at hTy; cases hTy
                          | ok pOff =>
                            rw [hOff] at hTy; dsimp at hTy
                            cases hS : Trusted.MirSemantics.getElem? pOff.snd bufLocal with
                            | none => rw [hS] at hTy; cases hTy
                            | some sl =>
                              rw [hS] at hTy
                              cases sl with
                              | baseSlot _ | livePtr _ | ptrDead => cases hTy
                              | bufSlot b =>
                                cases b with
                                | false => cases hTy
                                | true =>
                                  dsimp at hTy
                                  cases hAlloc : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                                  | none => rw [hAlloc] at hTy; cases hTy
                                  | some alloc =>
                                    rw [hAlloc] at hTy; dsimp at hTy
                                    have hLive := (bool_guard_step (!alloc.live) .undefined _ s' hTy).2
                                    cases hAb : Trusted.MirSemantics.getElem? alloc.bytes pOff.fst with
                                    | none => rw [hAb] at hLive; cases hLive
                                    | some ab =>
                                      rw [hAb] at hLive; dsimp at hLive
                                      have hLt := (bool_guard_step (!Nat.blt (encodeAllocByte ab).fst maxUsize) .unsupported _ s' hLive).2
                                      cases hW1 : writeMemCopyBasePlace pOff.snd tagDst usizeTy
                                          (Val.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (encodeAllocByte ab).fst }) with
                                      | error k => rw [hW1] at hLt; cases hLt
                                      | ok slots₂ =>
                                        rw [hW1] at hLt; dsimp at hLt
                                        cases hW2 : writeMemCopyBasePlace slots₂ valDst usizeTy
                                            (Val.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (encodeAllocByte ab).snd }) with
                                        | error k => rw [hW2] at hLt; cases hLt
                                        | ok slots₃ =>
                                          rw [hW2] at hLt; dsimp at hLt
                                          exact jumpMemCopyBlock_wf p frame mem slots₃ nextBb s' hLt
            | writeBufRawByte bufLocal offOp tagOp valOp nextBb =>
              dsimp at hStep
              cases hDB : Trusted.MirSemantics.getElem? body.locals bufLocal with
              | none => rw [hDB] at hStep; cases hStep
              | some decl =>
                rw [hDB] at hStep
                cases decl with
                | base _ | ptrLocal => cases hStep
                | byteBuf _ _ _ =>
                  dsimp at hStep
                  cases hOff : evalUsizeOp body.locals frame.locals offOp with
                  | error k => rw [hOff] at hStep; cases hStep
                  | ok pOff =>
                    rw [hOff] at hStep; dsimp at hStep
                    cases hTag : evalUsizeOp body.locals pOff.snd tagOp with
                    | error k => rw [hTag] at hStep; cases hStep
                    | ok pTag =>
                      rw [hTag] at hStep; dsimp at hStep
                      cases hVal : evalUsizeOp body.locals pTag.snd valOp with
                      | error k => rw [hVal] at hStep; cases hStep
                      | ok pVal =>
                        rw [hVal] at hStep; dsimp at hStep
                        cases hS : Trusted.MirSemantics.getElem? pVal.snd bufLocal with
                        | none => rw [hS] at hStep; cases hStep
                        | some sl =>
                          rw [hS] at hStep
                          cases sl with
                          | baseSlot _ | livePtr _ | ptrDead => cases hStep
                          | bufSlot b =>
                            cases b with
                            | false => cases hStep
                            | true =>
                              dsimp at hStep
                              cases hAlloc : findAlloc? (internalAllocBase + bufLocal) mem.allocations with
                              | none => rw [hAlloc] at hStep; cases hStep
                              | some alloc =>
                                rw [hAlloc] at hStep; dsimp at hStep
                                have hOk := (bool_guard_step (!alloc.live || !(Mutability.beq alloc.mutability .mut) || !Nat.blt pOff.fst alloc.bytes.length) .undefined _ s' hStep).2
                                cases hUpd : updateAlloc? (internalAllocBase + bufLocal)
                                    { allocId := alloc.allocId, alignLog2 := alloc.alignLog2, mutability := alloc.mutability,
                                      bytes := spliceBytes alloc.bytes pOff.fst [decodeAllocByte pTag.fst pVal.fst], live := alloc.live }
                                    mem.allocations with
                                | none => rw [hUpd] at hOk; cases hOk
                                | some allocs' =>
                                  rw [hUpd] at hOk; dsimp at hOk
                                  exact jumpMemCopyBlock_wf p frame ⟨allocs'⟩ pVal.snd nextBb s' hOk

private theorem memCopyStmtIdxWf_step (p : MemCopyProgram) (s s' : MemCopyState)
    (hStep : evalStepMemCopy p 0 s = .step s') :
    MemCopyStmtIdxWf p s' := by
  unfold evalStepMemCopy at hStep
  cases s with
  | mk frames mem =>
    dsimp at hStep
    cases frames with
    | nil => cases hStep
    | cons frame rest =>
      cases rest with
      | cons _ _ => cases hStep
      | nil =>
        dsimp at hStep
        exact memCopyStmtIdxWf_step_frame p frame mem s' hStep

private theorem applyFoldZeroOffsetTerm_sound
    (bodyId : DefId) (bbIdx : BasicBlockId)
    (pSrc pMid : MemCopyProgram)
    (hApp : applyFoldZeroOffsetTerm bodyId bbIdx pSrc = some pMid) :
    FullSemanticEquivMemCopy pSrc pMid := by
  unfold applyFoldZeroOffsetTerm at hApp
  cases hBody : Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
  | none => rw [hBody] at hApp; cases hApp
  | some body =>
    rw [hBody] at hApp
    dsimp at hApp
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
    | none => rw [hBb] at hApp; cases hApp
    | some bb =>
      rw [hBb] at hApp
      dsimp at hApp
      cases hTerm : bb.terminator with
      | baseTerm _ | checkPtrPairAlign _ _ _ _ _ _ | copyNonOverlapping _ _ _ _ _ _ _
      | readLeUsize _ _ _ _ _ | writeLeUsize _ _ _ _ _ | readPtrLe8 _ _ _ _ | writePtrLe8 _ _ _ _
      | readBufRawByte _ _ _ _ _ | writeBufRawByte _ _ _ _ _ =>
        rw [hTerm] at hApp; cases hApp
      | ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb =>
        rw [hTerm] at hApp
        dsimp at hApp
        cases hZero : isZeroOffsetConst countOp elemSize with
        | false => rw [hZero] at hApp; cases hApp
        | true =>
          rw [hZero] at hApp
          dsimp at hApp
          cases hSetBb : setElem? body.basicBlocks bbIdx
              { bb with
                statements := bb.statements ++ [MemCopyStmt.copyPtr dstPtr srcPtr false],
                terminator := MemCopyTerm.baseTerm (.goto nextBb) } with
          | none => rw [hSetBb] at hApp; cases hApp
          | some bbs' =>
            rw [hSetBb] at hApp
            dsimp at hApp
            cases hSetB : setElem? pSrc.bodies bodyId { body with basicBlocks := bbs' } with
            | none => rw [hSetB] at hApp; cases hApp
            | some bodies' =>
              rw [hSetB] at hApp
              cases hApp
              let p' := { pSrc with bodies := bodies' }
              have hStor : MemCopyBodyStorageEq body { body with basicBlocks := bbs' } := by
                refine ⟨rfl, rfl, (setElem?_isEmpty _ _ _ _ hSetBb).symm, rfl, rfl, ?_, ?_⟩
                · unfold memCopyStorageAnnotationsInBounds
                  dsimp
                  have hBlkP := list_all_append_singleton
                    (fun stmt => match stmt with
                      | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id body.locals.length
                      | _ => true)
                    bb.statements (MemCopyStmt.copyPtr dstPtr srcPtr false) rfl
                  exact (all_setElem?_preserves _ body.basicBlocks bbIdx bb
                    { statements := bb.statements ++ [MemCopyStmt.copyPtr dstPtr srcPtr false],
                      terminator := MemCopyTerm.baseTerm (.goto nextBb),
                      cleanup := bb.cleanup }
                    bbs' hBb hBlkP hSetBb).symm
                · intro id
                  unfold memCopyHasStorageAnnotation
                  dsimp
                  have hBlkP := list_any_append_singleton (memCopyStmtHasStorageMarker id)
                    bb.statements (MemCopyStmt.copyPtr dstPtr srcPtr false) rfl
                  exact (any_setElem?_preserves _ body.basicBlocks bbIdx bb
                    { statements := bb.statements ++ [MemCopyStmt.copyPtr dstPtr srcPtr false],
                      terminator := MemCopyTerm.baseTerm (.goto nextBb),
                      cleanup := bb.cleanup }
                    bbs' hBb hBlkP hSetBb).symm
              refine fullSemanticEquivMemCopy_of_fwd_stutter_sim pSrc p'
                (fun s₁ s₂ => s₁ = s₂ ∧ MemCopyStmtIdxWf pSrc s₁) (fun _ => 0) ?_ ?_
              · intro q
                have hInit : initStateMemCopy pSrc q = initStateMemCopy p' q := by
                  unfold initStateMemCopy
                  dsimp [p']
                  cases !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
                  | true => rfl
                  | false =>
                    dsimp
                    cases hEntry : Nat.beq pSrc.entryDefId bodyId with
                    | true =>
                      have heq := nat_beq_eq _ _ hEntry
                      subst heq
                      rw [hBody, getElem?_setElem?_eq _ _ _ _ hSetB]
                      exact memCopyBodyStorageEq_init hStor pSrc.entryDefId q
                    | false =>
                      have hne := nat_beq_false_ne hEntry
                      rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetB]
                refine ⟨fun _ => by rw [hInit],
                  fun s₁ hs₁ => ⟨s₁, by rw [← hInit]; exact hs₁, rfl, memCopyStmtIdxWf_init pSrc q s₁ hs₁⟩⟩
              · intro s₁ s₂ hR
                have hEqS := hR.1
                have hWf := hR.2
                subst hEqS
                have hNormalEq :
                    (¬ (∃ frame : MemCopyFrame, s₁.frames = [frame] ∧ frame.defId = bodyId ∧
                      frame.blockIdx = bbIdx ∧ frame.stmtIdx = bb.statements.length)) →
                    evalStepMemCopy pSrc 0 s₁ = evalStepMemCopy p' 0 s₁ := by
                  intro hNotAt
                  unfold evalStepMemCopy
                  cases hFr : s₁.frames with
                  | nil => rfl
                  | cons frame rest =>
                    cases rest with
                    | cons _ _ => rfl
                    | nil =>
                      dsimp [p']
                      cases hDef : Nat.beq frame.defId bodyId with
                      | false =>
                        have hne := nat_beq_false_ne hDef
                        rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetB]
                      | true =>
                        have heqDef := nat_beq_eq _ _ hDef
                        subst heqDef
                        rw [hBody, getElem?_setElem?_eq _ _ _ _ hSetB]
                        dsimp
                        cases hBlk : Nat.beq frame.blockIdx bbIdx with
                        | false =>
                          have hne := nat_beq_false_ne hBlk
                          rw [getElem?_setElem?_ne _ _ _ _ _ (fun h => hne h.symm) hSetBb]
                          cases Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
                          | none => rfl
                          | some bbOther =>
                            dsimp
                            cases Trusted.MirSemantics.getElem? bbOther.statements frame.stmtIdx with
                            | some stmtOther => dsimp; exact memCopyBodyStorageEq_evalStmt hStor frame s₁.mem stmtOther
                            | none =>
                              dsimp
                              cases Nat.beq frame.stmtIdx bbOther.statements.length with
                              | true => dsimp; exact memCopyBodyStorageEq_evalTerm hStor bbOther frame s₁.mem
                              | false => rfl
                        | true =>
                          have heqBlk := nat_beq_eq _ _ hBlk
                          subst heqBlk
                          rw [hBb, getElem?_setElem?_eq _ _ _ _ hSetBb]
                          dsimp
                          cases Nat.lt_or_ge frame.stmtIdx bb.statements.length with
                          | inl hLt =>
                            rw [getElem?_append_lt _ _ _ hLt]
                            cases hStLook : Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
                            | some stmtOther => dsimp; exact memCopyBodyStorageEq_evalStmt hStor frame s₁.mem stmtOther
                            | none =>
                              have hGe : bb.statements.length ≤ frame.stmtIdx := by
                                cases hLen : Nat.ble bb.statements.length frame.stmtIdx with
                                | true => exact (nat_ble_eq_le _ _).mp hLen
                                | false =>
                                  cases mirGetElem?_lt_some bb.statements frame.stmtIdx (nat_ble_false_gt hLen) with
                                  | intro _ hSome => rw [hSome] at hStLook; cases hStLook
                              exact False.elim (Nat.not_le_of_gt hLt hGe)
                          | inr hGe =>
                            have hLe : frame.stmtIdx ≤ bb.statements.length := by
                              unfold MemCopyStmtIdxWf at hWf
                              rw [hFr] at hWf
                              dsimp at hWf
                              rw [hBody] at hWf
                              dsimp at hWf
                              rw [hBb] at hWf
                              exact hWf
                            exact False.elim (hNotAt ⟨frame, hFr, rfl, rfl, nat_le_antisymm hLe hGe⟩)
                refine ⟨?_, ?_, ?_⟩
                · intro s₁' hEval
                  have hWf' : MemCopyStmtIdxWf pSrc s₁' := memCopyStmtIdxWf_step pSrc s₁ s₁' hEval
                  cases hAt : (match s₁.frames with
                    | [frame] => Nat.beq frame.defId bodyId && Nat.beq frame.blockIdx bbIdx &&
                        Nat.beq frame.stmtIdx bb.statements.length
                    | _ => false) with
                  | false =>
                    have hNotAt : ¬ (∃ frame : MemCopyFrame, s₁.frames = [frame] ∧ frame.defId = bodyId ∧
                        frame.blockIdx = bbIdx ∧ frame.stmtIdx = bb.statements.length) := by
                      intro hex
                      cases hex with
                      | intro fr hfr =>
                        rw [hfr.1] at hAt
                        dsimp at hAt
                        rw [hfr.2.1, hfr.2.2.1, hfr.2.2.2, nat_beq_refl, nat_beq_refl, nat_beq_refl] at hAt
                        cases hAt
                    rw [hNormalEq hNotAt] at hEval
                    have hStep₂ := (stepMemCopy_iff_evalStep p' s₁ (.step s₁')).mpr hEval
                    exact Or.inr ⟨s₁', ⟨0, .succ hStep₂ (.zero s₁')⟩, rfl, hWf'⟩
                  | true =>
                    cases hFr : s₁.frames with
                    | nil => rw [hFr] at hAt; cases hAt
                    | cons frame rest =>
                      cases rest with
                      | cons _ _ => rw [hFr] at hAt; cases hAt
                      | nil =>
                        rw [hFr] at hAt
                        have hA1 := (bool_and_eq_true _ _).mp hAt
                        have hA2 := (bool_and_eq_true _ _).mp hA1.1
                        have hDef := nat_beq_eq _ _ hA2.1
                        have hBlk := nat_beq_eq _ _ hA2.2
                        have hSt := nat_beq_eq _ _ hA1.2
                        unfold evalStepMemCopy at hEval
                        rw [hFr] at hEval
                        dsimp at hEval
                        rw [hDef, hBody] at hEval
                        dsimp at hEval
                        rw [hBlk, hBb] at hEval
                        dsimp at hEval
                        rw [hSt] at hEval
                        rw [mirGetElem?_ge_none bb.statements bb.statements.length (Nat.le_refl _),
                          nat_beq_refl] at hEval
                        dsimp at hEval
                        unfold evalMemCopyTerm at hEval
                        rw [hTerm] at hEval
                        dsimp at hEval
                        cases isZeroOffsetConst_evalOffsetCountOp body.locals frame.locals countOp elemSize hZero with
                        | intro z hz =>
                          rw [hz.1] at hEval
                          dsimp at hEval
                          cases hRead : readPtrLocal body.locals frame.locals srcPtr false with
                          | error k => rw [hRead] at hEval; cases hEval
                          | ok pair =>
                            rw [hRead] at hEval
                            dsimp at hEval
                            have hInb : calcInboundsOffset s₁.mem pair.fst z elemSize =
                                .ok { pair.fst with width := .isize } :=
                              inboundsOffset_leRoundTrip_and_copyNonOverlapping_laws_slice1.1 s₁.mem pair.fst z elemSize hz.2
                            rw [hInb] at hEval
                            dsimp at hEval
                            rw [writePtrLocal_with_isize] at hEval
                            cases hWr : writePtrLocal body.locals pair.snd dstPtr pair.fst with
                            | error k => rw [hWr] at hEval; cases hEval
                            | ok slots₃ =>
                              rw [hWr] at hEval
                              dsimp at hEval
                              have hStep1Eval : evalStepMemCopy p' 0 s₁ =
                                  stepMemCopyNext frame s₁.mem slots₃ := by
                                unfold evalStepMemCopy
                                rw [hFr]
                                dsimp [p']
                                rw [hDef, getElem?_setElem?_eq _ _ _ _ hSetB]
                                dsimp
                                rw [hBlk, getElem?_setElem?_eq _ _ _ _ hSetBb]
                                dsimp
                                rw [hSt, getElem?_append_eq_length bb.statements (MemCopyStmt.copyPtr dstPtr srcPtr false)]
                                dsimp
                                rw [← memCopyBodyStorageEq_evalStmt hStor frame s₁.mem (MemCopyStmt.copyPtr dstPtr srcPtr false)]
                                unfold evalMemCopyStmt
                                dsimp
                                rw [hRead]
                                dsimp
                                rw [hWr]
                              cases hStep1Res : stepMemCopyNext frame s₁.mem slots₃ with
                              | fault k => unfold stepMemCopyNext at hStep1Res; cases hStep1Res
                              | done out => unfold stepMemCopyNext at hStep1Res; cases hStep1Res
                              | step sMid =>
                                rw [hStep1Res] at hStep1Eval
                                have hStep1 : StepMemCopy p' s₁ (.step sMid) :=
                                  (stepMemCopy_iff_evalStep p' s₁ (.step sMid)).mpr hStep1Eval
                                have hStep2Eval : evalStepMemCopy p' 0 sMid = .step s₁' := by
                                  unfold stepMemCopyNext at hStep1Res
                                  cases hStep1Res
                                  unfold evalStepMemCopy
                                  dsimp [p']
                                  rw [hDef, getElem?_setElem?_eq _ _ _ _ hSetB]
                                  dsimp
                                  rw [hBlk, getElem?_setElem?_eq _ _ _ _ hSetBb]
                                  dsimp
                                  rw [hSt]
                                  rw [mirGetElem?_ge_none (bb.statements ++ [MemCopyStmt.copyPtr dstPtr srcPtr false])
                                    (bb.statements.length + 1) (by rw [list_append_singleton_length]; exact Nat.le_refl _)]
                                  rw [list_append_singleton_length, nat_beq_refl]
                                  dsimp
                                  rw [← memCopyBodyStorageEq_evalTerm hStor
                                    { statements := bb.statements ++ [MemCopyStmt.copyPtr dstPtr srcPtr false],
                                      terminator := MemCopyTerm.baseTerm (.goto nextBb), cleanup := bb.cleanup }
                                    { defId := bodyId, blockIdx := bbIdx, stmtIdx := bb.statements.length + 1, locals := slots₃ }
                                    s₁.mem]
                                  unfold evalMemCopyTerm
                                  dsimp
                                  unfold jumpMemCopyBlock at hEval
                                  rw [← hDef]
                                  exact hEval
                                have hStep2 : StepMemCopy p' sMid (.step s₁') :=
                                  (stepMemCopy_iff_evalStep p' sMid (.step s₁')).mpr hStep2Eval
                                exact Or.inr ⟨s₁', ⟨1, .succ hStep1 (.succ hStep2 (.zero s₁'))⟩, rfl, hWf'⟩
                · intro out hEval
                  cases hAt : (match s₁.frames with
                    | [frame] => Nat.beq frame.defId bodyId && Nat.beq frame.blockIdx bbIdx &&
                        Nat.beq frame.stmtIdx bb.statements.length
                    | _ => false) with
                  | false =>
                    have hNotAt : ¬ (∃ frame : MemCopyFrame, s₁.frames = [frame] ∧ frame.defId = bodyId ∧
                        frame.blockIdx = bbIdx ∧ frame.stmtIdx = bb.statements.length) := by
                      intro hex
                      cases hex with
                      | intro fr hfr =>
                        rw [hfr.1] at hAt
                        dsimp at hAt
                        rw [hfr.2.1, hfr.2.2.1, hfr.2.2.2, nat_beq_refl, nat_beq_refl, nat_beq_refl] at hAt
                        cases hAt
                    rw [hNormalEq hNotAt] at hEval
                    exact ⟨s₁, ReachesMemCopy.refl s₁, (stepMemCopy_iff_evalStep p' s₁ (.done out)).mpr hEval⟩
                  | true =>
                    cases hFr : s₁.frames with
                    | nil => rw [hFr] at hAt; cases hAt
                    | cons frame rest =>
                      cases rest with
                      | cons _ _ => rw [hFr] at hAt; cases hAt
                      | nil =>
                        rw [hFr] at hAt
                        have hA1 := (bool_and_eq_true _ _).mp hAt
                        have hA2 := (bool_and_eq_true _ _).mp hA1.1
                        have hDef := nat_beq_eq _ _ hA2.1
                        have hBlk := nat_beq_eq _ _ hA2.2
                        have hSt := nat_beq_eq _ _ hA1.2
                        unfold evalStepMemCopy at hEval
                        rw [hFr] at hEval
                        dsimp at hEval
                        rw [hDef, hBody] at hEval
                        dsimp at hEval
                        rw [hBlk, hBb] at hEval
                        dsimp at hEval
                        rw [hSt] at hEval
                        rw [mirGetElem?_ge_none bb.statements bb.statements.length (Nat.le_refl _),
                          nat_beq_refl] at hEval
                        dsimp at hEval
                        unfold evalMemCopyTerm at hEval
                        rw [hTerm] at hEval
                        dsimp at hEval
                        cases isZeroOffsetConst_evalOffsetCountOp body.locals frame.locals countOp elemSize hZero with
                        | intro z hz =>
                          rw [hz.1] at hEval
                          dsimp at hEval
                          cases hRead : readPtrLocal body.locals frame.locals srcPtr false with
                          | error k => rw [hRead] at hEval; cases hEval
                          | ok pair =>
                            rw [hRead] at hEval
                            dsimp at hEval
                            have hInb : calcInboundsOffset s₁.mem pair.fst z elemSize =
                                .ok { pair.fst with width := .isize } :=
                              inboundsOffset_leRoundTrip_and_copyNonOverlapping_laws_slice1.1 s₁.mem pair.fst z elemSize hz.2
                            rw [hInb] at hEval
                            dsimp at hEval
                            rw [writePtrLocal_with_isize] at hEval
                            cases hWr : writePtrLocal body.locals pair.snd dstPtr pair.fst with
                            | error k => rw [hWr] at hEval; cases hEval
                            | ok slots₃ =>
                              rw [hWr] at hEval
                              unfold jumpMemCopyBlock at hEval
                              cases hEval
                · intro k hEval
                  cases hAt : (match s₁.frames with
                    | [frame] => Nat.beq frame.defId bodyId && Nat.beq frame.blockIdx bbIdx &&
                        Nat.beq frame.stmtIdx bb.statements.length
                    | _ => false) with
                  | false =>
                    have hNotAt : ¬ (∃ frame : MemCopyFrame, s₁.frames = [frame] ∧ frame.defId = bodyId ∧
                        frame.blockIdx = bbIdx ∧ frame.stmtIdx = bb.statements.length) := by
                      intro hex
                      cases hex with
                      | intro fr hfr =>
                        rw [hfr.1] at hAt
                        dsimp at hAt
                        rw [hfr.2.1, hfr.2.2.1, hfr.2.2.2, nat_beq_refl, nat_beq_refl, nat_beq_refl] at hAt
                        cases hAt
                    rw [hNormalEq hNotAt] at hEval
                    exact ⟨s₁, ReachesMemCopy.refl s₁, (stepMemCopy_iff_evalStep p' s₁ (.fault k)).mpr hEval⟩
                  | true =>
                    cases hFr : s₁.frames with
                    | nil => rw [hFr] at hAt; cases hAt
                    | cons frame rest =>
                      cases rest with
                      | cons _ _ => rw [hFr] at hAt; cases hAt
                      | nil =>
                        rw [hFr] at hAt
                        have hA1 := (bool_and_eq_true _ _).mp hAt
