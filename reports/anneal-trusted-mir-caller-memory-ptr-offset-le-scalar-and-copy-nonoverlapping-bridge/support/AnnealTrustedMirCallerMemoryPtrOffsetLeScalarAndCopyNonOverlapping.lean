  | .remByZero, .unsupported, h
  | .boundsCheck, .overflow _, h | .boundsCheck, .overflowNeg, h
  | .boundsCheck, .divByZero, h | .boundsCheck, .remByZero, h
  | .boundsCheck, .misalignedPtrDeref, h | .boundsCheck, .nullPtrDeref, h
  | .boundsCheck, .unsupported, h
  | .misalignedPtrDeref, .overflow _, h | .misalignedPtrDeref, .overflowNeg, h
  | .misalignedPtrDeref, .divByZero, h | .misalignedPtrDeref, .remByZero, h
