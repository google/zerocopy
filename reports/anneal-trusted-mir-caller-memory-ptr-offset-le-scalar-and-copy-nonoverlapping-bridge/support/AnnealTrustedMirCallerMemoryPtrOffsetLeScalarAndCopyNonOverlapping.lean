  unfold evalBinOp evalShiftOp
  dsimp [BinOp.isShift, BinOp.isUnchecked, IntWidth.bitWidth]
  rw [s3_decodeScalar_usize a ha, s3_decodeScalar_usize b hbU]
  have hEm : intEmod (Int.ofNat b) (Int.ofNat 64) = Int.ofNat b :=
    s3_intEmod_nonneg_of_lt b 64 (by decide) hb
  change (match truncateScalar IntWidth.isize false (intShiftLeft (Int.ofNat a) (intEmod (Int.ofNat b) (Int.ofNat 64)).toNat) with
    | Except.error k => Except.error k
    | Except.ok (res, _) =>
      if ((intEmod (Int.ofNat b) (Int.ofNat 64) != Int.ofNat b) && false) = true then Except.error FaultKind.undefined
      else Except.ok (Val.scalar res)) = _
  rw [hEm]
  change (match truncateScalar IntWidth.isize false (Int.ofNat (Nat.shiftLeft a b)) with
    | Except.error k => Except.error k
    | Except.ok (res, _) =>
      if ((Int.ofNat b != Int.ofNat b) && false) = true then Except.error FaultKind.undefined
      else Except.ok (Val.scalar res)) = _
  rw [s3_truncateScalar_isize_ofNat (Nat.shiftLeft a b)]
  dsimp
  exact s3_shift_ite_false _ _ _

private theorem s3_evalBinOp_usize_shr (a b : Nat) (ha : a < maxUsize) (hb : b < 64) :
    evalBinOp .shr
