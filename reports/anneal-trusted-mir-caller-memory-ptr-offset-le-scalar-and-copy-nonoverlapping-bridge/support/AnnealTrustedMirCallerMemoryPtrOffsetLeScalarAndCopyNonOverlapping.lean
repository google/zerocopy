            rw [hSrcSlBuf, hB2.2.1] at h; dsimp at h; rw [hNotLiveF] at h; dsimp at h
            rw [hByteGet] at h; dsimp at h; rw [hWflFalse] at h; dsimp at h; rw [hWT] at h; cases h
          · intro _ h
            rw [hEvSrc] at h; dsimp [evalMemCopyTerm] at h; rw [hTermSrc] at h; dsimp at h; rw [hTv] at h; dsimp at h
            rw [hDeclT, hDeclV, pack.hBufDecl] at h; dsimp at h; rw [hEvOff] at h; dsimp at h
            rw [hSrcSlBuf, hB2.2.1] at h; dsimp at h; rw [hNotLiveF] at h; dsimp at h
            rw [hByteGet] at h; dsimp at h; rw [hWflFalse] at h; dsimp at h; rw [hWT] at h; cases h
          · intro k hFault
            rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault; dsimp at hFault; rw [hTv] at hFault; dsimp at hFault
            rw [hDeclT, hDeclV, pack.hBufDecl] at hFault; dsimp at hFault; rw [hEvOff] at hFault; dsimp at hFault
            rw [hSrcSlBuf, hB2.2.1] at hFault; dsimp at hFault; rw [hNotLiveF] at hFault; dsimp at hFault
            rw [hByteGet] at hFault; dsimp at hFault; rw [hWflFalse] at hFault; dsimp at hFault; rw [hWT] at hFault
            cases StepResult.fault.inj hFault
            exact s4_reachesMemCopy_of_reach_step_fault hR3 hF0
        | ok slotsMid =>
          rw [hWT] at hArmStmt0
          cases hArmStmt0 with | intro slots₂₃ hA0 =>
          have hStepArm0 : evalStepMemCopy pTgt 0 { frames := [fArm0], mem := m₂ } =
              .step { frames := [{ fArm0 with stmtIdx := 1, locals := slots₂₃ }], mem := m₂ } := by
            rw [s4_evalStepMemCopy_at_stmt pTgt pack.bodyTgt fArm0 m₂ armBb _ hBodyTgt hArmBb rfl]
            exact hA0.1
          have hR4 : ReachesNMemCopy pTgt 4 { frames := [f₂], mem := m₂ }
              { frames := [{ fArm0 with stmtIdx := 1, locals := slots₂₃ }], mem := m₂ } :=
            reachesNMemCopy_trans hR3 (s4_reachesNMemCopy_one_step hStepArm0)
          let fArm1 : MemCopyFrame := { fArm0 with stmtIdx := 1, locals := slots₂₃ }
          have hValKeep : Trusted.MirSemantics.getElem? slots₂₃ (base + 1 + pack.size + resOff.1) =
              some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩)))) := by
            rw [hA0.2.2.2.2.2 (base + 1 + pack.size + resOff.1)
              (Nat.le_trans (Nat.le_add_right _ 1) hValGe)]
            exact hAb.2.2
          have hArmStmt1 := s4_step_mkAssignUse_readArm pack (mem₂ := m₂) hA0.2.1 hA0.2.2.1 hA0.2.2.2.1 hA0.2.2.2.2.1
            hDeclV hValNe hValGe hValLt hValKeep hVNatLt fArm1 rfl
          cases hWV : writeMemCopyBasePlace slotsMid valDst usizeTy
              (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩) with
          | error kV =>
            rw [hWV] at hArmStmt1
            have hF1 : evalStepMemCopy pTgt 0 { frames := [fArm1], mem := m₂ } = .fault kV := by
              rw [s4_evalStepMemCopy_at_stmt pTgt pack.bodyTgt fArm1 m₂ armBb _ hBodyTgt hArmBb rfl]
              exact hArmStmt1
            refine ⟨?_, ?_, ?_⟩
            · intro _ h
              rw [hEvSrc] at h; dsimp [evalMemCopyTerm] at h; rw [hTermSrc] at h; dsimp at h; rw [hTv] at h; dsimp at h
              rw [hDeclT, hDeclV, pack.hBufDecl] at h; dsimp at h; rw [hEvOff] at h; dsimp at h
              rw [hSrcSlBuf, hB2.2.1] at h; dsimp at h; rw [hNotLiveF] at h; dsimp at h
              rw [hByteGet] at h; dsimp at h; rw [hWflFalse] at h; dsimp at h; rw [hWT] at h; dsimp at h
              rw [hWV] at h; cases h
            · intro _ h
              rw [hEvSrc] at h; dsimp [evalMemCopyTerm] at h; rw [hTermSrc] at h; dsimp at h; rw [hTv] at h; dsimp at h
              rw [hDeclT, hDeclV, pack.hBufDecl] at h; dsimp at h; rw [hEvOff] at h; dsimp at h
              rw [hSrcSlBuf, hB2.2.1] at h; dsimp at h; rw [hNotLiveF] at h; dsimp at h
              rw [hByteGet] at h; dsimp at h; rw [hWflFalse] at h; dsimp at h; rw [hWT] at h; dsimp at h
              rw [hWV] at h; cases h
            · intro k hFault
              rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault; dsimp at hFault; rw [hTv] at hFault; dsimp at hFault
              rw [hDeclT, hDeclV, pack.hBufDecl] at hFault; dsimp at hFault; rw [hEvOff] at hFault; dsimp at hFault
              rw [hSrcSlBuf, hB2.2.1] at hFault; dsimp at hFault; rw [hNotLiveF] at hFault; dsimp at hFault
              rw [hByteGet] at hFault; dsimp at hFault; rw [hWflFalse] at hFault; dsimp at hFault; rw [hWT] at hFault; dsimp at hFault
              rw [hWV] at hFault
              cases StepResult.fault.inj hFault
              exact s4_reachesMemCopy_of_reach_step_fault hR4 hF1
          | ok slotsOut =>
            rw [hWV] at hArmStmt1
            cases hArmStmt1 with | intro slots₂₄ hA1 =>
            have hStepArm1 : evalStepMemCopy pTgt 0 { frames := [fArm1], mem := m₂ } =
                .step { frames := [{ fArm1 with stmtIdx := 2, locals := slots₂₄ }], mem := m₂ } := by
              rw [s4_evalStepMemCopy_at_stmt pTgt pack.bodyTgt fArm1 m₂ armBb _ hBodyTgt hArmBb rfl]
              exact hA1.1
            let fArm2 : MemCopyFrame := { fArm1 with stmtIdx := 2, locals := slots₂₄ }
            have hStepArm2 : evalStepMemCopy pTgt 0 { frames := [fArm2], mem := m₂ } =
                .step { frames := [{ f₂ with blockIdx := nextBb + 1, stmtIdx := 0, locals := slots₂₄ }], mem := m₂ } := by
              rw [s4_evalStepMemCopy_at_term pTgt pack.bodyTgt fArm2 m₂ armBb hBodyTgt hArmBb rfl rfl]
              rfl
            have hR6 : ReachesNMemCopy pTgt 6 { frames := [f₂], mem := m₂ }
                { frames := [{ f₂ with blockIdx := nextBb + 1, stmtIdx := 0, locals := slots₂₄ }], mem := m₂ } :=
              reachesNMemCopy_trans (reachesNMemCopy_trans hR4 (s4_reachesNMemCopy_one_step hStepArm1))
                (s4_reachesNMemCopy_one_step hStepArm2)
            refine ⟨?_, ?_, ?_⟩
            · intro s₁' hStep
              rw [hEvSrc] at hStep; dsimp [evalMemCopyTerm] at hStep; rw [hTermSrc] at hStep; dsimp at hStep; rw [hTv] at hStep; dsimp at hStep
              rw [hDeclT, hDeclV, pack.hBufDecl] at hStep; dsimp at hStep; rw [hEvOff] at hStep; dsimp at hStep
              rw [hSrcSlBuf, hB2.2.1] at hStep; dsimp at hStep; rw [hNotLiveF] at hStep; dsimp at hStep
              rw [hByteGet] at hStep; dsimp at hStep; rw [hWflFalse] at hStep; dsimp at hStep; rw [hWT] at hStep; dsimp at hStep
              rw [hWV] at hStep; dsimp [jumpMemCopyBlock] at hStep
              cases StepResult.step.inj hStep
              exact s4_reachesPlus_term_rel pack hSame hSame₂ hR6
                hA1.2.1 hA1.2.2.1 hA1.2.2.2.1 hMem hA1.2.2.2.2.1
            · intro out hDone
              rw [hEvSrc] at hDone; dsimp [evalMemCopyTerm] at hDone; rw [hTermSrc] at hDone; dsimp at hDone; rw [hTv] at hDone; dsimp at hDone
              rw [hDeclT, hDeclV, pack.hBufDecl] at hDone; dsimp at hDone; rw [hEvOff] at hDone; dsimp at hDone
              rw [hSrcSlBuf, hB2.2.1] at hDone; dsimp at hDone; rw [hNotLiveF] at hDone; dsimp at hDone
              rw [hByteGet] at hDone; dsimp at hDone; rw [hWflFalse] at hDone; dsimp at hDone; rw [hWT] at hDone; dsimp at hDone
              rw [hWV] at hDone; cases hDone
            · intro k hFault
              rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault; dsimp at hFault; rw [hTv] at hFault; dsimp at hFault
              rw [hDeclT, hDeclV, pack.hBufDecl] at hFault; dsimp at hFault; rw [hEvOff] at hFault; dsimp at hFault
              rw [hSrcSlBuf, hB2.2.1] at hFault; dsimp at hFault; rw [hNotLiveF] at hFault; dsimp at hFault
              rw [hByteGet] at hFault; dsimp at hFault; rw [hWflFalse] at hFault; dsimp at hFault; rw [hWT] at hFault; dsimp at hFault
              rw [hWV] at hFault; cases hFault


