private theorem s3_evalBinOp_usize_add (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize) :
    evalBinOp .add
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 a })
      (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 b }) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (Nat.mod (a + b) maxUsize) }) := by
  unfold evalBinOp evalArithOp
  dsimp [BinOp.isShift, BinOp.isUnchecked]
  rw [s3_decodeScalar_usize a ha, s3_decodeScalar_usize b hb]
  change (match truncateScalar IntWidth.isize false (Int.ofNat (a + b)) with
    | Except.error k => Except.error k
    | Except.ok (val, lossy) =>
      if ((decide (Int.ofNat (a + b) < 0) || decide (Int.ofNat (a + b) ≥ HPow.hPow (2 : Int) 128) || lossy) &&
          decide (false = true)) = true then Except.error FaultKind.undefined
      else Except.ok (Val.scalar val)) = _
  rw [s3_truncateScalar_isize_ofNat (a + b)]
  dsimp
  exact s3_arith_ite_unchecked_false _ _ _

private theorem s3_evalBinOp_usize_mul (a b : Nat) (ha : a < maxUsize) (hb : b < maxUsize) :
    evalBinOp .mul
