private theorem s3_nat_testBit_lor (x y i : Nat) : (Nat.lor x y).testBit i = (x.testBit i || y.testBit i) := s0_nat_testBit_or x y i
private theorem s3_nat_testBit_shiftRight (x i j : Nat) : (Nat.shiftRight x i).testBit j = x.testBit (i + j) := s0_nat_testBit_shiftRight x
private theorem s3_nat_testBit_shiftLeft (x i j : Nat) : (Nat.shiftLeft x i).testBit j = (decide (j ≥ i) && x.testBit (j - i)) := s0_nat_testBit_shiftLeft x

private theorem s3_list_drop_length {α : Type} :
    ∀ (xs : List α) (n : Nat), (xs.drop n).length = xs.length - n
  | [], n => by rw [List.drop_nil]; exact (Nat.zero_sub n).symm
  | xs, 0 => by change xs.length = xs.length - 0; exact (Nat.sub_zero _).symm
  | _ :: xs, n + 1 => by
    change (xs.drop n).length = (xs.length + 1) - (n + 1)
    rw [Nat.succ_sub_succ]
    exact s3_list_drop_length xs n

private theorem s3_getElem?_cons_zero {α : Type} (x : α) (xs : List α) :
    Trusted.MirSemantics.getElem? (x :: xs) 0 = some x := rfl

private theorem s3_getElem?_cons_succ {α : Type} (x : α) (xs : List α) (i : Nat) :
    Trusted.MirSemantics.getElem? (x :: xs) (i + 1) = Trusted.MirSemantics.getElem? xs i := rfl

private theorem s3_getElem?_lt_some {α : Type} :
    ∀ (xs : List α) (i : Nat),
      i < xs.length → ∃ v, Trusted.MirSemantics.getElem? xs i = some v
  | [], _, h => False.elim (Nat.not_lt_zero _ h)
  | x :: _, 0, _ => ⟨x, rfl⟩
  | _ :: xs, i + 1, h => s3_getElem?_lt_some xs i (Nat.lt_of_succ_lt_succ h)

private theorem s3_getElem?_some_lt {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α),
      Trusted.MirSemantics.getElem? xs i = some v → i < xs.length
  | [], _, _, h => by cases h
  | _ :: _, 0, _, _ => Nat.zero_lt_succ _
  | _ :: xs, i + 1, v, h =>
    Nat.succ_lt_succ (s3_getElem?_some_lt xs i v h)

private theorem s3_getElem?_ge_none {α : Type} :
    ∀ (xs : List α) (i : Nat),
      xs.length ≤ i → Trusted.MirSemantics.getElem? xs i = none
  | [], _, _ => rfl
  | _ :: _, 0, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, i + 1, h =>
    s3_getElem?_ge_none xs i (Nat.le_of_succ_le_succ h)

private theorem s3_getElem?_setElem?_eq {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs' : List α),
      setElem? xs i v = some xs' →
      Trusted.MirSemantics.getElem? xs' i = some v
  | [], _, _, _, h => by cases h
  | _ :: _, 0, _, _, h => by cases h; rfl
  | x :: xs, i + 1, v, xs', h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys =>
      rw [hRec] at h; cases h
      exact s3_getElem?_setElem?_eq xs i v ys hRec

private theorem s3_getElem?_setElem?_ne {α : Type} :
    ∀ (xs : List α) (i j : Nat) (v : α) (xs' : List α),
      i ≠ j →
      setElem? xs i v = some xs' →
      Trusted.MirSemantics.getElem? xs' j = Trusted.MirSemantics.getElem? xs j
  | [], _, _, _, _, _, h => by cases h
  | _ :: _, 0, 0, _, _, hne, _ => False.elim (hne rfl)
  | _ :: _, 0, _ + 1, _, _, _, h => by cases h; rfl
  | x :: xs, i + 1, 0, v, xs', _, h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys => rw [hRec] at h; cases h; rfl
  | x :: xs, i + 1, j + 1, v, xs', hne, h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys =>
      rw [hRec] at h; cases h
      exact s3_getElem?_setElem?_ne xs i j v ys (fun eq => hne (congrArg Nat.succ eq)) hRec

private theorem s3_setElem?_length {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α) (xs' : List α),
      setElem? xs i v = some xs' → xs'.length = xs.length
  | [], _, _, _, h => by cases h
  | _ :: _, 0, _, _, h => by cases h; rfl
  | x :: xs, i + 1, v, xs', h => by
    change (match setElem? xs i v with | some ys => some (x :: ys) | none => none) = some xs' at h
    cases hRec : setElem? xs i v with
    | none => rw [hRec] at h; cases h
    | some ys =>
      rw [hRec] at h; cases h
      change ys.length + 1 = xs.length + 1
      rw [s3_setElem?_length xs i v ys hRec]

private theorem s3_setElem?_some_of_lt {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α),
      i < xs.length → ∃ xs', setElem? xs i v = some xs'
  | [], _, _, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, 0, v, _ => ⟨v :: xs, rfl⟩
  | x :: xs, i + 1, v, h => by
    cases s3_setElem?_some_of_lt xs i v (Nat.lt_of_succ_lt_succ h) with
    | intro ys hys =>
      refine ⟨x :: ys, ?_⟩
      change (match setElem? xs i v with | some zs => some (x :: zs) | none => none) = some (x :: ys)
      rw [hys]

private theorem s3_getElem?_append_left {α : Type} :
    ∀ (xs ys : List α) (i : Nat),
      i < xs.length →
      Trusted.MirSemantics.getElem? (xs ++ ys) i = Trusted.MirSemantics.getElem? xs i
  | [], _, _, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: _, _, 0, _ => rfl
  | _ :: xs, ys, i + 1, h =>
    s3_getElem?_append_left xs ys i (Nat.lt_of_succ_lt_succ h)

private theorem s3_getElem?_append_right {α : Type} :
    ∀ (xs ys : List α) (i : Nat),
      xs.length ≤ i →
      Trusted.MirSemantics.getElem? (xs ++ ys) i =
        Trusted.MirSemantics.getElem? ys (i - xs.length)
  | [], ys, i, _ => by
    change Trusted.MirSemantics.getElem? ys i = Trusted.MirSemantics.getElem? ys (i - 0)
    rw [Nat.sub_zero]
  | _ :: _, _, 0, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, ys, i + 1, h => by
    change Trusted.MirSemantics.getElem? (xs ++ ys) i =
      Trusted.MirSemantics.getElem? ys (i + 1 - (xs.length + 1))
    rw [Nat.succ_sub_succ]
    exact s3_getElem?_append_right xs ys i (Nat.le_of_succ_le_succ h)

private theorem s3_listReplicate_length {α : Type} (n : Nat) (v : α) :
    (listReplicate n v).length = n := by
  induction n with
  | zero => rfl
  | succ k ih =>
    change (listReplicate k v).length + 1 = k + 1
    rw [ih]

private theorem s3_listReplicate_getElem? {α : Type} :
    ∀ (n i : Nat) (v : α),
      i < n → Trusted.MirSemantics.getElem? (listReplicate n v) i = some v
  | 0, _, _, h => False.elim (Nat.not_lt_zero _ h)
  | _ + 1, 0, _, _ => rfl
  | n + 1, i + 1, v, h =>
    s3_listReplicate_getElem? n i v (Nat.lt_of_succ_lt_succ h)

private theorem s3_take_succ {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α),
      Trusted.MirSemantics.getElem? xs i = some x →
      xs.take (i + 1) = xs.take i ++ [x]
  | [], _, _, h => by cases h
  | a :: _, 0, x, h => by cases h; rfl
  | a :: xs, i + 1, x, h => by
    change a :: xs.take (i + 1) = a :: (xs.take i ++ [x])
    rw [s3_take_succ xs i x h]

private theorem s3_take_all {α : Type} :
    ∀ (xs : List α), xs.take xs.length = xs
  | [] => rfl
  | a :: xs => by
    change a :: xs.take xs.length = a :: xs
    rw [s3_take_all xs]

private theorem s3_take_length_le {α : Type} :
    ∀ (xs : List α) (n : Nat),
      n ≤ xs.length → (xs.take n).length = n
  | _, 0, _ => rfl
  | [], _ + 1, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, n + 1, h => by
    change (xs.take n).length + 1 = n + 1
    rw [s3_take_length_le xs n (Nat.le_of_succ_le_succ h)]

private theorem s3_drop_getElem? {α : Type} :
    ∀ (xs : List α) (n i : Nat),
      Trusted.MirSemantics.getElem? (xs.drop n) i =
        Trusted.MirSemantics.getElem? xs (n + i)
  | xs, 0, i => by
    change Trusted.MirSemantics.getElem? xs i = Trusted.MirSemantics.getElem? xs (0 + i)
    rw [Nat.zero_add]
  | [], _ + 1, _ => rfl
  | x :: xs, n + 1, i => by
    have h1 : Trusted.MirSemantics.getElem? (List.drop (n + 1) (x :: xs)) i =
        Trusted.MirSemantics.getElem? (xs.drop n) i := rfl
    have h2 : Trusted.MirSemantics.getElem? (x :: xs) ((n + 1) + i) =
        Trusted.MirSemantics.getElem? xs (n + i) := by
      rw [Nat.succ_add]
      rfl
    rw [h1, h2]
    exact s3_drop_getElem? xs n i

private theorem s3_take_getElem? {α : Type} :
    ∀ (xs : List α) (n i : Nat),
      i < n →
      Trusted.MirSemantics.getElem? (xs.take n) i =
        Trusted.MirSemantics.getElem? xs i
  | _, 0, _, h => False.elim (Nat.not_lt_zero _ h)
  | [], _ + 1, _, _ => rfl
  | _ :: _, _ + 1, 0, _ => rfl
  | _ :: xs, n + 1, i + 1, h =>
    s3_take_getElem? xs n i (Nat.lt_of_succ_lt_succ h)

private theorem s3_listFlatMap_cons {α β : Type} (f : α → List β) (x : α) (xs : List α) :
    listFlatMap f (x :: xs) = f x ++ listFlatMap f xs := rfl

private theorem s3_listFlatMap_nil {α β : Type} (f : α → List β) :
    listFlatMap f [] = [] := rfl

private theorem s3_listFlatMap_singleton {α β : Type} (f : α → List β) (x : α) :
    listFlatMap f [x] = f x := by
  change f x ++ [] = f x
  exact List.append_nil _

private theorem s3_listFlatMap_take_succ {α β : Type} (f : α → List β) (xs : List α)
    (i : Nat) (x : α) (h : Trusted.MirSemantics.getElem? xs i = some x) :
    listFlatMap f (xs.take (i + 1)) = listFlatMap f (xs.take i) ++ f x := by
  rw [s3_take_succ xs i x h, listFlatMap_append, s3_listFlatMap_singleton]

private theorem s3_list_all_getElem? {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (i : Nat) (x : α),
      xs.all p = true →
      Trusted.MirSemantics.getElem? xs i = some x →
      p x = true
  | [], _, _, _, h => by cases h
  | x :: xs, 0, v, hAll, hGet => by
    cases hGet
    change (p x && xs.all p) = true at hAll
    exact ((bool_and_eq_true _ _).mp hAll).1
  | x :: xs, i + 1, v, hAll, hGet => by
    change (p x && xs.all p) = true at hAll
    exact s3_list_all_getElem? p xs i v ((bool_and_eq_true _ _).mp hAll).2 hGet

private theorem s3_list_any_eq_false_getElem? {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (i : Nat) (x : α),
      xs.any p = false →
      Trusted.MirSemantics.getElem? xs i = some x →
      p x = false
  | [], _, _, _, h => by cases h
  | x :: xs, 0, v, hAny, hGet => by
    cases hGet
    change (p x || xs.any p) = false at hAny
    cases hx : p x with
    | false => rfl
    | true => rw [hx] at hAny; cases hAny
  | x :: xs, i + 1, v, hAny, hGet => by
    change (p x || xs.any p) = false at hAny
    cases hx : p x with
    | true => rw [hx] at hAny; cases hAny
    | false =>
      rw [hx, Bool.false_or] at hAny
      exact s3_list_any_eq_false_getElem? p xs i v hAny hGet

private theorem s3_nat_pow_pos (b : Nat) (hb : 0 < b) : ∀ k : Nat, 0 < Nat.pow b k
  | 0 => Nat.zero_lt_one
  | k + 1 => Nat.mul_pos (s3_nat_pow_pos b hb k) hb

private theorem s3_nat_pow_two_mono_add (a : Nat) :
    ∀ d : Nat, Nat.pow 2 a ≤ Nat.pow 2 (a + d)
  | 0 => Nat.le_refl _
  | d + 1 => by
    have hStep : Nat.pow 2 (a + d) ≤ Nat.pow 2 (a + (d + 1)) := by
      change Nat.pow 2 (a + d) ≤ Nat.pow 2 (a + d) * 2
      exact s0_nat_le_mul_of_pos_right _ (Nat.succ_pos 1)
    exact Nat.le_trans (s3_nat_pow_two_mono_add a d) hStep

private theorem s3_nat_pow_two_mono {a b : Nat} (h : a ≤ b) :
    Nat.pow 2 a ≤ Nat.pow 2 b := by
  have hk : ∃ d, b = a + d := ⟨b - a, (s0_nat_add_sub_cancel' h).symm⟩
  cases hk with
  | intro d hd =>
    rw [hd]
    exact s3_nat_pow_two_mono_add a d

private theorem s3_nat_mod_two_pow_div_two (n k : Nat) :
    Nat.mod (Nat.div n 2) (Nat.pow 2 k) = Nat.div (Nat.mod n (Nat.pow 2 (k + 1))) 2 := by
  have hMod : Nat.mod n (Nat.pow 2 (k + 1)) =
      Nat.mod n 2 + 2 * Nat.mod (Nat.div n 2) (Nat.pow 2 k) := by
    have hEq := s3_nat_div_add_mod n 2
    have hD := s3_nat_div_add_mod (Nat.div n 2) (Nat.pow 2 k)
    have hDecomp : n = (2 * Nat.pow 2 k) * Nat.div (Nat.div n 2) (Nat.pow 2 k) +
        (Nat.mod n 2 + 2 * Nat.mod (Nat.div n 2) (Nat.pow 2 k)) := by
      have hStep1 : 2 * Nat.div n 2 + Nat.mod n 2 =
          2 * (Nat.pow 2 k * Nat.div (Nat.div n 2) (Nat.pow 2 k) +
            Nat.mod (Nat.div n 2) (Nat.pow 2 k)) + Nat.mod n 2 := by
        exact congrArg (fun x => 2 * x + Nat.mod n 2) hD.symm
      have hStep2 : 2 * (Nat.pow 2 k * Nat.div (Nat.div n 2) (Nat.pow 2 k) +
            Nat.mod (Nat.div n 2) (Nat.pow 2 k)) + Nat.mod n 2 =
          (2 * Nat.pow 2 k) * Nat.div (Nat.div n 2) (Nat.pow 2 k) +
            (Nat.mod n 2 + 2 * Nat.mod (Nat.div n 2) (Nat.pow 2 k)) := by
        rw [Nat.mul_add, Nat.mul_assoc, Nat.add_assoc, Nat.add_comm (2 * Nat.mod (Nat.div n 2) (Nat.pow 2 k)) (Nat.mod n 2)]
      exact hEq.symm.trans (hStep1.trans hStep2)
    have hLt1 : Nat.mod n 2 < 2 := s3_nat_mod_lt _ (Nat.succ_pos 1)
    have hLt2 : Nat.mod (Nat.div n 2) (Nat.pow 2 k) < Nat.pow 2 k :=
      s3_nat_mod_lt _ (s3_nat_pow_pos 2 (Nat.succ_pos 1) k)
    have hBound : Nat.mod n 2 + 2 * Nat.mod (Nat.div n 2) (Nat.pow 2 k) < Nat.pow 2 (k + 1) := by
      have hPow : Nat.pow 2 (k + 1) = 2 * Nat.pow 2 k := by
        change Nat.pow 2 k * 2 = 2 * Nat.pow 2 k
        exact Nat.mul_comm _ _
      rw [hPow]
      have hMulLe : 2 * Nat.mod (Nat.div n 2) (Nat.pow 2 k) + 2 ≤ 2 * Nat.pow 2 k := by
        have hSucc : Nat.mod (Nat.div n 2) (Nat.pow 2 k) + 1 ≤ Nat.pow 2 k := hLt2
        have hM := Nat.mul_le_mul_left 2 hSucc
        rw [Nat.mul_add, Nat.mul_one] at hM
        exact hM
      exact Nat.lt_of_lt_of_le (Nat.add_lt_add_right hLt1 _) (by rw [Nat.add_comm]; exact hMulLe)
    have hPow : Nat.pow 2 (k + 1) = 2 * Nat.pow 2 k := by
      change Nat.pow 2 k * 2 = 2 * Nat.pow 2 k
      exact Nat.mul_comm _ _
    have hLhs : Nat.mod n (Nat.pow 2 (k + 1)) =
        Nat.mod ((Nat.mod n 2 + 2 * Nat.mod (Nat.div n 2) (Nat.pow 2 k)) +
          (2 * Nat.pow 2 k) * Nat.div (Nat.div n 2) (Nat.pow 2 k)) (2 * Nat.pow 2 k) := by
      rw [hPow, Nat.add_comm (Nat.mod n 2 + _), ← hDecomp]
    rw [hLhs, s3_nat_add_mul_mod_self_left]
    rw [← hPow]
    exact Nat.mod_eq_of_lt hBound
  rw [hMod, Nat.add_comm]
  rw [s3_nat_mul_add_div (Nat.succ_pos 1)]
  have hZero : Nat.div (Nat.mod n 2) 2 = 0 :=
    s3_nat_div_eq_of_lt (s3_nat_mod_lt _ (Nat.succ_pos 1))
  rw [hZero, Nat.add_zero]

private theorem s3_nat_div_eq_div_add_lt {a b m : Nat} (hb : b < m) (hm : 0 < m) :
    Nat.div (a * m + b) m = a := by
  rw [Nat.mul_comm a m, s3_nat_mul_add_div hm]
  rw [s3_nat_div_eq_of_lt hb, Nat.add_zero]

private theorem s3_nat_mod_add_mul_lt {a b m : Nat} (hb : b < m) :
    Nat.mod (a * m + b) m = b := by
  rw [Nat.mul_comm a m, s3_nat_mul_add_mod]
  exact Nat.mod_eq_of_lt hb

private theorem s3_nat_land_pow2_sub_one (n k : Nat) :
    Nat.land n (Nat.pow 2 k - 1) = Nat.mod n (Nat.pow 2 k) :=
  s0_nat_and_two_pow_sub_one_eq_mod n k

private theorem s3_nat_lor_eq_zero_iff (a b : Nat) :
    Nat.lor a b = 0 ↔ a = 0 ∧ b = 0 := by
  constructor
  · intro h
    constructor
    · apply s0_nat_eq_of_testBit_eq
      intro i
      have hB : (Nat.lor a b).testBit i = (0 : Nat).testBit i := by rw [h]
      rw [s3_nat_testBit_lor, s0_nat_zero_testBit] at hB
      cases ha : a.testBit i with
      | false => change false = (0 : Nat).testBit i; rw [s0_nat_zero_testBit]
      | true => rw [ha] at hB; cases hB
    · apply s0_nat_eq_of_testBit_eq
      intro i
      have hB : (Nat.lor a b).testBit i = (0 : Nat).testBit i := by rw [h]
      rw [s3_nat_testBit_lor, s0_nat_zero_testBit] at hB
      cases hb : b.testBit i with
      | false => change false = (0 : Nat).testBit i; rw [s0_nat_zero_testBit]
      | true => rw [hb, Bool.or_true] at hB; cases hB
  · intro h
    rw [h.1, h.2]
    exact s0_nat_zero_or 0

private theorem s3_nat_shiftLeft_eq (m n : Nat) : Nat.shiftLeft m n = m * Nat.pow 2 n := Nat.shiftLeft_eq m n

private theorem s3_nat_shiftLeft_zero (b : Nat) : Nat.shiftLeft b 0 = b := by
  rw [s3_nat_shiftLeft_eq]
  exact Nat.mul_one b

private theorem s3_nat_testBit_div2 (n i : Nat) :
    (Nat.div n 2).testBit i = n.testBit (i + 1) := by
  have h := s3_nat_testBit_shiftRight n 1 i
  have hSr : Nat.shiftRight n 1 = Nat.div n 2 := by
    rw [s3_nat_shiftRight_eq_div_pow]
  rw [hSr, Nat.add_comm] at h
  exact h

private theorem s3_nat_testBit_add_two_mul (r m i : Nat) (hr : r < 2) :
    (r + 2 * m).testBit (i + 1) = m.testBit i := by
  rw [← s3_nat_testBit_div2 (r + 2 * m) i]
  rw [Nat.add_comm r (2 * m), s3_nat_mul_add_div (Nat.succ_pos 1), s3_nat_div_eq_of_lt hr, Nat.add_zero]

private theorem s3_nat_mod_eq_of_lt {a b : Nat} (h : a < b) : Nat.mod a b = a := Nat.mod_eq_of_lt h

private theorem s3_nat_testBit_add_two_mul_zero (r m : Nat) (_hr : r < 2) :
    (r + 2 * m).testBit 0 = r.testBit 0 := by
  rw [s3_nat_testBit_zero, s3_nat_testBit_zero]
  rw [Nat.add_comm r (2 * m), s3_nat_mul_add_mod]

private theorem s3_nat_lor_shiftLeft_eq_add :
    ∀ (k a b : Nat),
      a < Nat.pow 2 k →
      Nat.lor a (Nat.shiftLeft b k) = a + b * Nat.pow 2 k
  | 0, a, b, ha => by
    have ha0 : a = 0 := Nat.lt_one_iff.mp ha
    rw [ha0]
    change Nat.lor 0 (Nat.shiftLeft b 0) = 0 + b * 1
    rw [s3_nat_zero_lor, Nat.zero_add, Nat.mul_one, s3_nat_shiftLeft_zero]
  | k + 1, a, b, ha => by
    have hMod2 : Nat.mod a 2 < 2 := Nat.mod_lt a (Nat.succ_pos 1)
    have hDivLt : Nat.div a 2 < Nat.pow 2 k := by
      have hMul : 2 * Nat.div a 2 + Nat.mod a 2 = a := Nat.div_add_mod a 2
      have hPow : Nat.pow 2 (k + 1) = 2 * Nat.pow 2 k := by
        change Nat.pow 2 k * 2 = 2 * Nat.pow 2 k; exact Nat.mul_comm _ _
      rw [hPow] at ha
      apply Nat.lt_of_not_le
      intro hGe
      have h1 : 2 * Nat.pow 2 k ≤ 2 * Nat.div a 2 := Nat.mul_le_mul_left 2 hGe
      have h2 : 2 * Nat.div a 2 ≤ 2 * Nat.div a 2 + Nat.mod a 2 := Nat.le_add_right _ _
      rw [hMul] at h2
      exact Nat.not_lt_of_le (Nat.le_trans h1 h2) ha
    have ih := s3_nat_lor_shiftLeft_eq_add k (Nat.div a 2) b hDivLt
    have hSum : Nat.mod a 2 + 2 * (Nat.div a 2 + b * Nat.pow 2 k) = a + b * Nat.pow 2 (k + 1) := by
      have h1 : Nat.mod a 2 + 2 * Nat.div a 2 = a := by
        rw [Nat.add_comm]; exact Nat.div_add_mod a 2
      have hPow : 2 * (b * Nat.pow 2 k) = b * Nat.pow 2 (k + 1) := by
        have hP : Nat.pow 2 (k + 1) = 2 * Nat.pow 2 k := by
          change Nat.pow 2 k * 2 = 2 * Nat.pow 2 k; exact Nat.mul_comm _ _
        rw [hP, ← Nat.mul_assoc, Nat.mul_comm 2 b, Nat.mul_assoc]
      rw [Nat.mul_add, ← Nat.add_assoc, h1, hPow]
    rw [← hSum]
    apply s0_nat_eq_of_testBit_eq
    intro i
    cases i with
    | zero =>
      rw [s3_nat_testBit_lor, s3_nat_testBit_add_two_mul_zero _ _ hMod2]
      have hSh : (Nat.shiftLeft b (k + 1)).testBit 0 = false := by
        rw [s3_nat_testBit_shiftLeft]
        rfl
      rw [hSh, Bool.or_false, s3_nat_testBit_zero, s3_nat_testBit_zero]
      rw [s3_nat_mod_mod]
    | succ j =>
      rw [s3_nat_testBit_lor, s3_nat_testBit_add_two_mul _ _ j hMod2]
      rw [← ih, s3_nat_testBit_lor, s3_nat_testBit_div2]
      have hSh : (Nat.shiftLeft b (k + 1)).testBit (j + 1) = (Nat.shiftLeft b k).testBit j := by
        rw [s3_nat_testBit_shiftLeft, s3_nat_testBit_shiftLeft]
        cases hDec : decide (j + 1 ≥ k + 1) with
        | true =>
          have hj : j ≥ k := Nat.le_of_succ_le_succ (of_decide_eq_true hDec)
          rw [decide_eq_true hj, Bool.true_and, Bool.true_and, Nat.succ_sub_succ]
        | false =>
          have hj : ¬ (j ≥ k) := fun hk =>
            by have : decide (j + 1 ≥ k + 1) = true := decide_eq_true (Nat.succ_le_succ hk)
               rw [this] at hDec; cases hDec
          rw [decide_eq_false hj, Bool.false_and, Bool.false_and]
      rw [hSh]

private theorem s3_nat_div_pow_lt_of_lt_mul {a b c : Nat} (hb : 0 < b) (h : a < b * c) :
    Nat.div a b < c :=
  (Nat.div_lt_iff_lt_mul hb).mpr (by rw [Nat.mul_comm]; exact h)

private theorem s3_nat_mod_lt_of_pos {a b : Nat} (hb : 0 < b) : Nat.mod a b < b :=
  Nat.mod_lt a hb

private theorem s3_u8_toNat_ofNat_lt (n : Nat) (hn : n < 256) :
    (UInt8.ofNat n).toNat = n := by
  change Nat.mod n 256 = n
  exact Nat.mod_eq_of_lt hn

private theorem s3_u64_ofNat_toNat (u : UInt64) : UInt64.ofNat u.toNat = u := by
  cases u with
  | ofBitVec bv =>
    cases bv with
    | ofFin fn =>
      cases fn with
      | mk v hv =>
        change UInt64.ofBitVec (BitVec.ofFin (Fin.mk (Nat.mod v maxUsize) _)) =
          UInt64.ofBitVec (BitVec.ofFin (Fin.mk v hv))
        exact congrArg UInt64.ofBitVec (congrArg BitVec.ofFin (Fin.eq_of_val_eq (Nat.mod_eq_of_lt hv)))

private theorem s3_u64_toNat_lt (u : UInt64) : u.toNat < maxUsize := by
  cases u with
  | ofBitVec bv =>
    cases bv with
    | ofFin fn => exact fn.isLt

private theorem s3_u64_toNat_ofNat (n : Nat) (hn : n < maxUsize) :
    (UInt64.ofNat n).toNat = n := by
  change Nat.mod n maxUsize = n
  exact Nat.mod_eq_of_lt hn

private theorem s3_bitvec_ofNat_toNat {n : Nat} (b : BitVec n) :
    BitVec.ofNat n b.toNat = b := by
  cases b with
  | ofFin fn =>
    cases fn with
    | mk v hv =>
      change BitVec.ofFin (Fin.mk (Nat.mod v (Nat.pow 2 n)) _) = BitVec.ofFin (Fin.mk v hv)
      exact congrArg BitVec.ofFin (Fin.eq_of_val_eq (Nat.mod_eq_of_lt hv))

private theorem s3_bitvec_toNat_ofNat_lt {n : Nat} (x : Nat) (hx : x < Nat.pow 2 n) :
    (BitVec.ofNat n x).toNat = x := by
  change Nat.mod x (Nat.pow 2 n) = x
  exact Nat.mod_eq_of_lt hx

private theorem s3_maxIsize_lt_maxUsize : maxIsize < maxUsize := by
  have h1 : maxIsize ≤ Nat.pow 2 63 := Nat.sub_le _ _
  have h2 : Nat.pow 2 63 < Nat.pow 2 64 :=
    s3_nat_lt_two_mul_self (s3_nat_pow_pos 2 (Nat.succ_pos 1) 63)
  exact Nat.lt_of_le_of_lt h1 h2

private theorem s3_usize_scalar_wf (n : Nat) (hn : n < maxUsize) :
    ({ width := .isize, signed := false, bits := BitVec.ofNat 128 n } : ScalarVal).wf = true := by
  unfold ScalarVal.wf truncateBits bvExtractLsb bvExtractLsb' bvZeroExtend
  have h128 : maxUsize < Nat.pow 2 128 := by
    have h65 : Nat.pow 2 64 < Nat.pow 2 65 :=
      s3_nat_lt_two_mul_self (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)
    exact Nat.lt_of_lt_of_le h65 (s3_nat_pow_two_mono (a := 65) (b := 128) (by decide))
  have hn128 : n < Nat.pow 2 128 := Nat.lt_trans hn h128
  have hMod : (BitVec.ofNat 128 n).toNat = n := s3_bitvec_toNat_ofNat_lt n hn128
  have hSh : Nat.shiftRight n 0 = n := by
    rw [s3_nat_shiftRight_eq_div_pow]; exact s3_nat_div_one n
  have hBW : IntWidth.isize.bitWidth - 1 - 0 + 1 = 64 := rfl
  have hLow : (BitVec.ofNat 64 (Nat.shiftRight (BitVec.ofNat 128 n).toNat 0)).toNat = n := by
    rw [hMod, hSh]
    exact s3_bitvec_toNat_ofNat_lt n hn
  change (BitVec.ofNat 128 (BitVec.ofNat (IntWidth.isize.bitWidth - 1 - 0 + 1) (Nat.shiftRight (BitVec.ofNat 128 n).toNat 0)).toNat ==
    BitVec.ofNat 128 n) = true
  rw [hBW, hLow]
  exact BEq.refl _

private theorem s3_decodeScalar_usize (n : Nat) (hn : n < maxUsize) :
    decodeScalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n } = Int.ofNat n := by
  unfold decodeScalar
  dsimp
  have h128 : maxUsize < Nat.pow 2 128 := by
    have h65 : Nat.pow 2 64 < Nat.pow 2 65 :=
      s3_nat_lt_two_mul_self (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)
    exact Nat.lt_of_lt_of_le h65 (s3_nat_pow_two_mono (a := 65) (b := 128) (by decide))
  have hn128 : n < Nat.pow 2 128 := Nat.lt_trans hn h128
  unfold truncateBits bvExtractLsb bvExtractLsb' bvZeroExtend
  dsimp
  have hBW : IntWidth.isize.bitWidth - 1 + 1 = 64 := rfl
  rw [s3_bitvec_toNat_ofNat_lt n hn128, hBW, s3_bitvec_toNat_ofNat_lt n hn, s3_bitvec_toNat_ofNat_lt n hn128]

private theorem s3_evalConstLit_usize (n : Nat) (hn : n < maxUsize) :
    evalConstLit usizeTy (.scalar (BitVec.ofNat 128 n)) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }) := by
  unfold evalConstLit usizeTy
  dsimp
  have hTr : truncateBits .isize (BitVec.ofNat 128 n) = BitVec.ofNat 128 n := by
    unfold truncateBits bvExtractLsb bvExtractLsb' bvZeroExtend
    dsimp
    have h128 : maxUsize < Nat.pow 2 128 := by
      have h65 : Nat.pow 2 64 < Nat.pow 2 65 :=
        s3_nat_lt_two_mul_self (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)
      exact Nat.lt_of_lt_of_le h65 (s3_nat_pow_two_mono (a := 65) (b := 128) (by decide))
    have hn128 : n < Nat.pow 2 128 := Nat.lt_trans hn h128
    have hBW : IntWidth.isize.bitWidth - 1 + 1 = 64 := rfl
    rw [s3_bitvec_toNat_ofNat_lt n hn128, hBW, s3_bitvec_toNat_ofNat_lt n hn]
  rw [hTr]
  have hNe : (BitVec.ofNat 128 n != BitVec.ofNat 128 n) = false := by
    change (!(BitVec.ofNat 128 n == BitVec.ofNat 128 n)) = false
    rw [BEq.refl]
    rfl
  rw [hNe]
  rfl

private theorem s3_evalConstLit_unit :
    evalConstLit .unit .zeroSized = .ok .unit := rfl

private theorem s3_intEmod_nonneg_of_lt (n m : Nat) (_hm : 0 < m) (hn : n < m) :
    intEmod (Int.ofNat n) (Int.ofNat m) = Int.ofNat n := by
  change Int.ofNat (Nat.mod n m) = Int.ofNat n
  rw [s3_nat_mod_eq_of_lt hn]

private theorem s3_intEmod_ofNat (n m : Nat) :
    intEmod (Int.ofNat n) (Int.ofNat m) = Int.ofNat (Nat.mod n m) := rfl

private theorem s3_intEmod_toNat_lt (z : Int) (m : Nat) (hm : 0 < m) :
    (intEmod z (Int.ofNat m)).toNat < m := by
  cases z with
  | ofNat n =>
    change Nat.mod n m < m
    exact Nat.mod_lt n hm
  | negSucc n =>
    unfold intEmod
    dsimp
    have hModLt : Nat.mod n m < m := Nat.mod_lt n hm
    have hSuccLe : Nat.succ (Nat.mod n m) ≤ m := hModLt
    have hSub : Int.subNatNat m (Nat.succ (Nat.mod n m)) =
        Int.ofNat (m - Nat.succ (Nat.mod n m)) := by
      unfold Int.subNatNat
      have hEq : Nat.succ (Nat.mod n m) - m = 0 := Nat.sub_eq_zero_of_le hSuccLe
      rw [hEq]
    change (Int.subNatNat m (Nat.succ (Nat.mod n m))).toNat < m
    rw [hSub]
    change m - Nat.succ (Nat.mod n m) < m
    exact Nat.sub_lt hm (Nat.succ_pos _)

private theorem s3_intEmod_add_right (a : Int) (b : Nat) (m : Nat) (hm : 0 < m) :
    (intEmod (a + Int.ofNat b) (Int.ofNat m)).toNat =
      Nat.mod ((intEmod a (Int.ofNat m)).toNat + Nat.mod b m) m := by
  cases a with
  | ofNat x =>
    change Nat.mod (x + b) m = Nat.mod (Nat.mod x m + Nat.mod b m) m
    exact s3_nat_add_mod x b m
  | negSucc x =>
    have hNegEmod : ∀ (k : Nat),
        (intEmod (Int.negSucc k) (Int.ofNat m)).toNat = m - (Nat.mod k m + 1) := by
      intro k
      unfold intEmod Int.subNatNat
      dsimp
      have hModLt : Nat.mod k m < m := s3_nat_mod_lt k hm
      have hZ : Nat.succ (Nat.mod k m) - m = 0 := Nat.sub_eq_zero_of_le hModLt
      change (match Nat.succ (Nat.mod k m) - m with | 0 => Int.ofNat (m - Nat.succ (Nat.mod k m)) | k' + 1 => Int.negSucc k').toNat = m - (Nat.mod k m + 1)
      rw [hZ]
      rfl
    rw [hNegEmod x]
    have hxDecomp : x = m * Nat.div x m + Nat.mod x m := (s3_nat_div_add_mod x m).symm
    have hbDecomp : b = m * Nat.div b m + Nat.mod b m := (s3_nat_div_add_mod b m).symm
    have hxModLt : Nat.mod x m < m := s3_nat_mod_lt x hm
    have hbModLt : Nat.mod b m < m := s3_nat_mod_lt b hm
    have hNegAdd : Int.negSucc x + Int.ofNat b = Int.subNatNat b (x + 1) := by
      rw [s0_int_add_comm]; rfl
    cases Nat.lt_or_ge b (x + 1) with
    | inl hLt =>
      have hLe : b ≤ x := Nat.le_of_lt_succ hLt
      have hSubNat : Int.subNatNat b (x + 1) = Int.negSucc (x - b) := by
        unfold Int.subNatNat
        have hB : b - (x + 1) = 0 := Nat.sub_eq_zero_of_le (Nat.le_of_lt hLt)
        have hPos : 0 < x + 1 - b := Nat.sub_pos_of_lt hLt
        have hEx : ∃ k, x + 1 - b = k + 1 := ⟨x + 1 - b - 1, (Nat.sub_add_cancel hPos).symm⟩
        cases hEx with
        | intro k hk =>
          rw [hB, hk]
          have hkEq : k = x - b := by
            have h1 : x + 1 - b = (x - b) + 1 := s0_nat_sub_add_comm hLe
            rw [hk] at h1
            exact Nat.succ.inj h1
          rw [hkEq]
      rw [hNegAdd, hSubNat, hNegEmod (x - b)]
      cases Nat.lt_or_ge (Nat.mod b m) (Nat.mod x m + 1) with
      | inl hModLt =>
        have hModLe : Nat.mod b m ≤ Nat.mod x m := Nat.le_of_lt_succ hModLt
        have hDivLe : Nat.div b m ≤ Nat.div x m := by
          apply Nat.le_of_not_lt
          intro hGt
          have h1 : m * (Nat.div x m + 1) ≤ m * Nat.div b m := Nat.mul_le_mul_left m hGt
          rw [Nat.mul_add, Nat.mul_one] at h1
          have h2 : m * Nat.div x m + Nat.mod x m < m * (Nat.div x m) + m :=
            Nat.add_lt_add_left hxModLt _
          have h3 : m * Nat.div b m ≤ m * Nat.div b m + Nat.mod b m := Nat.le_add_right _ _
          have h4 : x < b := by
            have h2' : m * Nat.div x m + Nat.mod x m < m * Nat.div b m + Nat.mod b m :=
              Nat.lt_of_lt_of_le h2 (Nat.le_trans h1 h3)
            rw [← hxDecomp, ← hbDecomp] at h2'
            exact h2'
          exact Nat.not_lt_of_le hLe h4
        have hXB : x - b = m * (Nat.div x m - Nat.div b m) + (Nat.mod x m - Nat.mod b m) := by
          have h1 : m * Nat.div x m = m * Nat.div b m + m * (Nat.div x m - Nat.div b m) := by
            rw [← Nat.mul_add, s0_nat_add_sub_cancel' hDivLe]
          have h2 : Nat.mod x m = Nat.mod b m + (Nat.mod x m - Nat.mod b m) :=
            (s0_nat_add_sub_cancel' hModLe).symm
          have hSum : b + (m * (Nat.div x m - Nat.div b m) + (Nat.mod x m - Nat.mod b m)) = x := by
            have hSub : (m * Nat.div b m + Nat.mod b m) +
                (m * (Nat.div x m - Nat.div b m) + (Nat.mod x m - Nat.mod b m)) = x := by
              rw [Nat.add_assoc, Nat.add_comm (Nat.mod b m), ← Nat.add_assoc (m * Nat.div b m)]
              rw [← Nat.add_assoc (m * Nat.div b m) (m * (Nat.div x m - Nat.div b m))]
              rw [← h1, Nat.add_assoc, Nat.add_comm (Nat.mod x m - Nat.mod b m), ← h2, ← hxDecomp]
            rw [← hbDecomp] at hSub
            exact hSub
          exact (Nat.sub_eq_of_eq_add (by rw [Nat.add_comm]; exact hSum.symm))
        have hSubLt : Nat.mod x m - Nat.mod b m < m :=
          Nat.lt_of_le_of_lt (Nat.sub_le _ _) hxModLt
        rw [hXB, s3_nat_mul_add_mod, s3_nat_mod_eq_of_lt hSubLt]
        have hRhsLt : m - (Nat.mod x m + 1) + Nat.mod b m < m := by
          have hAdd1 : Nat.mod x m + 1 ≤ m := hxModLt
          have h1 : m - (Nat.mod x m + 1) + Nat.mod b m + (Nat.mod x m + 1) =
              m + Nat.mod b m := by
            rw [Nat.add_assoc, Nat.add_comm (Nat.mod b m), ← Nat.add_assoc, Nat.sub_add_cancel hAdd1]
          have h2 : m + Nat.mod b m < m + (Nat.mod x m + 1) := Nat.add_lt_add_left hModLt m
          rw [← h1] at h2
          exact s0_nat_lt_of_add_lt_add_right h2
        rw [s3_nat_mod_eq_of_lt hRhsLt]
        have hX1 : Nat.mod x m - Nat.mod b m + 1 = Nat.mod x m + 1 - Nat.mod b m :=
          (s0_nat_sub_add_comm hModLe).symm
        rw [hX1]
        have hSumEq : m - (Nat.mod x m + 1 - Nat.mod b m) + (Nat.mod x m + 1) =
            m - (Nat.mod x m + 1) + Nat.mod b m + (Nat.mod x m + 1) := by
          have hLeM : Nat.mod x m + 1 - Nat.mod b m ≤ m :=
            Nat.le_trans (Nat.sub_le _ _) hxModLt
          have hLeX1 : Nat.mod b m ≤ Nat.mod x m + 1 := Nat.le_of_lt hModLt
          have hA : m - (Nat.mod x m + 1 - Nat.mod b m) + (Nat.mod x m + 1 - Nat.mod b m) + Nat.mod b m =
              m + Nat.mod b m := by
            rw [Nat.sub_add_cancel hLeM]
          have hB : Nat.mod x m + 1 - Nat.mod b m + Nat.mod b m = Nat.mod x m + 1 :=
            Nat.sub_add_cancel hLeX1
          rw [Nat.add_assoc] at hA
          rw [hB] at hA
          rw [hA]
          rw [Nat.add_assoc, Nat.add_comm (Nat.mod b m), ← Nat.add_assoc, Nat.sub_add_cancel hxModLt]
        exact Nat.add_right_cancel hSumEq
      | inr hModGe =>
        have hDivLt : Nat.div b m < Nat.div x m := by
          apply Nat.lt_of_not_le
          intro hGe
          have h1 : m * Nat.div x m ≤ m * Nat.div b m := Nat.mul_le_mul_left m hGe
          have hLtM : Nat.mod x m < Nat.mod b m := Nat.lt_of_succ_le hModGe
          have h2 : x < b := by
            have hL := s0_nat_add_lt_add_of_le_of_lt h1 hLtM
            rw [← hxDecomp, ← hbDecomp] at hL
            exact hL
          exact Nat.not_lt_of_le hLe h2
        have hDivSubPos : 0 < Nat.div x m - Nat.div b m := Nat.sub_pos_of_lt hDivLt
        have hXB : x - b = m * (Nat.div x m - Nat.div b m - 1) + (m + Nat.mod x m - Nat.mod b m) := by
          have h1 : m * Nat.div x m = m * Nat.div b m + m * (Nat.div x m - Nat.div b m - 1) + m := by
            have hd : Nat.div x m = Nat.div b m + (Nat.div x m - Nat.div b m - 1) + 1 := by
              rw [Nat.add_assoc, Nat.sub_add_cancel hDivSubPos, s0_nat_add_sub_cancel' (Nat.le_of_lt hDivLt)]
            have hMul : m * (Nat.div b m + (Nat.div x m - Nat.div b m - 1) + 1) =
                m * Nat.div b m + m * (Nat.div x m - Nat.div b m - 1) + m := by
              rw [Nat.mul_add, Nat.mul_add, Nat.mul_one]
            rw [← hd] at hMul
            exact hMul
          have hBLe : Nat.mod b m ≤ m + Nat.mod x m :=
            Nat.le_trans (Nat.le_of_lt hbModLt) (Nat.le_add_right _ _)
          have hSum : b + (m * (Nat.div x m - Nat.div b m - 1) + (m + Nat.mod x m - Nat.mod b m)) = x := by
            have hSub : (m * Nat.div b m + Nat.mod b m) +
                (m * (Nat.div x m - Nat.div b m - 1) + (m + Nat.mod x m - Nat.mod b m)) = x := by
              rw [Nat.add_assoc, Nat.add_comm (Nat.mod b m), ← Nat.add_assoc (m * Nat.div b m)]
              rw [← Nat.add_assoc (m * Nat.div b m) (m * (Nat.div x m - Nat.div b m - 1))]
              rw [Nat.add_assoc (m * Nat.div b m + m * (Nat.div x m - Nat.div b m - 1))]
              rw [Nat.sub_add_cancel hBLe]
              rw [← Nat.add_assoc, ← h1, ← hxDecomp]
            rw [← hbDecomp] at hSub
            exact hSub
          exact Nat.sub_eq_of_eq_add (by rw [Nat.add_comm]; exact hSum.symm)
        have hRemLt : m + Nat.mod x m - Nat.mod b m < m := by
          have hBLe : Nat.mod b m ≤ m + Nat.mod x m :=
            Nat.le_trans (Nat.le_of_lt hbModLt) (Nat.le_add_right _ _)
          have h2 : m + Nat.mod x m < m + Nat.mod b m :=
            Nat.add_lt_add_left (Nat.lt_of_succ_le hModGe) m
          have hL : m + Nat.mod x m - Nat.mod b m + Nat.mod b m = m + Nat.mod x m :=
            Nat.sub_add_cancel hBLe
          rw [← hL] at h2
          exact s0_nat_lt_of_add_lt_add_right h2
        rw [hXB, s3_nat_mul_add_mod, s3_nat_mod_eq_of_lt hRemLt]
        have hRhsEq : m - (Nat.mod x m + 1) + Nat.mod b m = m + (Nat.mod b m - (Nat.mod x m + 1)) := by
          have h1 : m - (Nat.mod x m + 1) + Nat.mod b m + (Nat.mod x m + 1) =
              m + Nat.mod b m := by
            rw [Nat.add_assoc, Nat.add_comm (Nat.mod b m), ← Nat.add_assoc, Nat.sub_add_cancel hxModLt]
          have h2 : m + (Nat.mod b m - (Nat.mod x m + 1)) + (Nat.mod x m + 1) =
              m + Nat.mod b m := by
            rw [Nat.add_assoc, Nat.sub_add_cancel hModGe]
          exact Nat.add_right_cancel (by rw [h1, h2])
        rw [hRhsEq, s3_nat_add_mod_left]
        have hDiffLt : Nat.mod b m - (Nat.mod x m + 1) < m :=
          Nat.lt_of_le_of_lt (Nat.sub_le _ _) hbModLt
        rw [s3_nat_mod_eq_of_lt hDiffLt]
        have hBLe : Nat.mod b m ≤ m + Nat.mod x m :=
          Nat.le_trans (Nat.le_of_lt hbModLt) (Nat.le_add_right _ _)
        have hLeM : m + Nat.mod x m - Nat.mod b m + 1 ≤ m := by
          have hL : m + Nat.mod x m - Nat.mod b m + 1 + Nat.mod b m = m + (Nat.mod x m + 1) := by
            rw [Nat.add_assoc, Nat.add_comm 1, ← Nat.add_assoc, Nat.sub_add_cancel hBLe, Nat.add_assoc]
          have hR : m + (Nat.mod x m + 1) ≤ m + Nat.mod b m := Nat.add_le_add_left hModGe m
          rw [← hL] at hR
          exact Nat.le_of_add_le_add_right hR
        have hFinal : m - (m + Nat.mod x m - Nat.mod b m + 1) + (Nat.mod x m + 1) +
            (m + Nat.mod x m - Nat.mod b m + 1) =
            Nat.mod b m + (m + Nat.mod x m - Nat.mod b m + 1) := by
          rw [Nat.add_assoc, Nat.add_comm (Nat.mod x m + 1), ← Nat.add_assoc, Nat.sub_add_cancel hLeM]
          have hL2 : Nat.mod b m + (m + Nat.mod x m - Nat.mod b m + 1) =
              m + (Nat.mod x m + 1) := by
            rw [← Nat.add_assoc, Nat.add_comm (Nat.mod b m), Nat.sub_add_cancel hBLe, Nat.add_assoc]
          rw [hL2]
        apply Nat.add_right_cancel (m := Nat.mod x m + 1)
        rw [Nat.sub_add_cancel hModGe]
        exact Nat.add_right_cancel hFinal
    | inr hGe =>
      have hSubNat : Int.subNatNat b (x + 1) = Int.ofNat (b - (x + 1)) := by
        unfold Int.subNatNat
        have hZ : (x + 1) - b = 0 := Nat.sub_eq_zero_of_le hGe
        rw [hZ]
      rw [hNegAdd, hSubNat]
      change Nat.mod (b - (x + 1)) m = Nat.mod (m - (Nat.mod x m + 1) + Nat.mod b m) m
      cases Nat.lt_or_ge (Nat.mod b m) (Nat.mod x m + 1) with
      | inl hModLt =>
        have hDivLt : Nat.div x m < Nat.div b m := by
          apply Nat.lt_of_not_le
          intro hDivGe
          have h1 : m * Nat.div b m ≤ m * Nat.div x m := Nat.mul_le_mul_left m hDivGe
          have h2 : m * Nat.div b m + Nat.mod b m < m * Nat.div x m + (Nat.mod x m + 1) :=
            s0_nat_add_lt_add_of_le_of_lt h1 hModLt
          have h3 : b < x + 1 := by
            rw [← hbDecomp, ← Nat.add_assoc, ← hxDecomp] at h2
            exact h2
          exact Nat.not_lt_of_le hGe h3
        have hDivSubPos : 0 < Nat.div b m - Nat.div x m := Nat.sub_pos_of_lt hDivLt
        have hBX : b - (x + 1) =
            m * (Nat.div b m - Nat.div x m - 1) + (m - (Nat.mod x m + 1) + Nat.mod b m) := by
          have hd : Nat.div b m = Nat.div x m + (Nat.div b m - Nat.div x m - 1) + 1 := by
            rw [Nat.add_assoc, Nat.sub_add_cancel hDivSubPos, s0_nat_add_sub_cancel' (Nat.le_of_lt hDivLt)]
          have hSum : (x + 1) + (m * (Nat.div b m - Nat.div x m - 1) + (m - (Nat.mod x m + 1) + Nat.mod b m)) = b := by
            have hM : m * (Nat.div x m + (Nat.div b m - Nat.div x m - 1)) + m = m * Nat.div b m := by
              have hRight : m * (Nat.div x m + (Nat.div b m - Nat.div x m - 1) + 1) =
                  m * (Nat.div x m + (Nat.div b m - Nat.div x m - 1)) + m := by
                rw [Nat.mul_add, Nat.mul_one]
              rw [← hd] at hRight
              exact hRight.symm
            have hInner :
                m * (Nat.div b m - Nat.div x m - 1) + (m - (Nat.mod x m + 1)) + Nat.mod b m + (Nat.mod x m + 1) =
                  m * (Nat.div b m - Nat.div x m - 1) + m + Nat.mod b m := by
              rw [Nat.add_assoc (m * (Nat.div b m - Nat.div x m - 1) + (m - (Nat.mod x m + 1))) (Nat.mod b m) (Nat.mod x m + 1)]
              rw [Nat.add_comm (Nat.mod b m) (Nat.mod x m + 1)]
              rw [← Nat.add_assoc (m * (Nat.div b m - Nat.div x m - 1) + (m - (Nat.mod x m + 1)))]
              rw [Nat.add_assoc (m * (Nat.div b m - Nat.div x m - 1)) (m - (Nat.mod x m + 1)) (Nat.mod x m + 1)]
              rw [Nat.sub_add_cancel hxModLt]
            have hSub : ((m * Nat.div x m + Nat.mod x m) + 1) +
                (m * (Nat.div b m - Nat.div x m - 1) + (m - (Nat.mod x m + 1) + Nat.mod b m)) = b := by
              rw [Nat.add_assoc (m * Nat.div x m), Nat.add_assoc]
              rw [Nat.add_comm (Nat.mod x m + 1)]
              rw [← Nat.add_assoc (m * (Nat.div b m - Nat.div x m - 1))]
              rw [hInner]
              rw [← Nat.add_assoc, ← Nat.add_assoc, ← Nat.mul_add]
              rw [hM, ← hbDecomp]
            rw [← hxDecomp] at hSub
            exact hSub
          exact Nat.sub_eq_of_eq_add (by rw [Nat.add_comm]; exact hSum.symm)
        rw [hBX, s3_nat_mul_add_mod]
      | inr hModGe =>
        have hDivLe : Nat.div x m ≤ Nat.div b m := by
          apply Nat.le_of_not_lt
          intro hDivGt
          have h1 : m * (Nat.div b m + 1) ≤ m * Nat.div x m := Nat.mul_le_mul_left m hDivGt
          rw [Nat.mul_add, Nat.mul_one] at h1
          have h2 : b < m * Nat.div b m + m := by
            have h2' := Nat.add_lt_add_left hbModLt (m * Nat.div b m)
            rw [← hbDecomp] at h2'
            exact h2'
          have h3 : m * Nat.div x m ≤ x + 1 :=
            Nat.le_trans (Nat.le_add_right _ (Nat.mod x m)) (by rw [← hxDecomp]; exact Nat.le_succ _)
          exact Nat.not_lt_of_le hGe (Nat.lt_of_lt_of_le h2 (Nat.le_trans h1 h3))
        have hBX : b - (x + 1) =
            m * (Nat.div b m - Nat.div x m) + (Nat.mod b m - (Nat.mod x m + 1)) := by
          have hSum : (x + 1) + (m * (Nat.div b m - Nat.div x m) + (Nat.mod b m - (Nat.mod x m + 1))) = b := by
            have hSub : ((m * Nat.div x m + Nat.mod x m) + 1) +
                (m * (Nat.div b m - Nat.div x m) + (Nat.mod b m - (Nat.mod x m + 1))) = b := by
              rw [Nat.add_assoc (m * Nat.div x m), Nat.add_assoc, Nat.add_comm (Nat.mod x m + 1)]
              rw [Nat.add_assoc (m * (Nat.div b m - Nat.div x m)) (Nat.mod b m - (Nat.mod x m + 1)) (Nat.mod x m + 1)]
              rw [Nat.sub_add_cancel hModGe, ← Nat.add_assoc, ← Nat.mul_add, s0_nat_add_sub_cancel' hDivLe, ← hbDecomp]
            rw [← hxDecomp] at hSub
            exact hSub
          exact Nat.sub_eq_of_eq_add (by rw [Nat.add_comm]; exact hSum.symm)
        have hRhsEq : m - (Nat.mod x m + 1) + Nat.mod b m = m + (Nat.mod b m - (Nat.mod x m + 1)) := by
          have h1 : m - (Nat.mod x m + 1) + Nat.mod b m + (Nat.mod x m + 1) =
              m + Nat.mod b m := by
            rw [Nat.add_assoc, Nat.add_comm (Nat.mod b m), ← Nat.add_assoc, Nat.sub_add_cancel hxModLt]
          have h2 : m + (Nat.mod b m - (Nat.mod x m + 1)) + (Nat.mod x m + 1) =
              m + Nat.mod b m := by
            rw [Nat.add_assoc, Nat.sub_add_cancel hModGe]
          exact Nat.add_right_cancel (by rw [h1, h2])
        rw [hBX, s3_nat_mul_add_mod, hRhsEq, s3_nat_add_mod_left]

private theorem s3_intEmod_add_left (b : Nat) (a : Int) (m : Nat) (hm : 0 < m) :
    (intEmod (Int.ofNat b + a) (Int.ofNat m)).toNat =
      Nat.mod (Nat.mod b m + (intEmod a (Int.ofNat m)).toNat) m := by
  rw [s0_int_add_comm (Int.ofNat b) a, Nat.add_comm (Nat.mod b m)]
  exact s3_intEmod_add_right a b m hm

