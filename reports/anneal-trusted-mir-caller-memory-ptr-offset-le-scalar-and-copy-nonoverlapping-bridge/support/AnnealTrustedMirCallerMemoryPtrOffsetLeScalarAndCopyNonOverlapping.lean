        have hLen0 : (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2 ++
            mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2 ++ []).length =
            (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufS (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length +
            (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufD (s3_scrBase ctx + 2) (s3_scrBase ctx + 3) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlignLog2).length := by
          rw [List.length_append, List.length_append]; rfl
        rw [hLen0, ← Nat.add_assoc]
        exact ⟨sB, hReachAB, hSB.2.1, hPresD⟩
      | true =>
        dsimp [alignAndNull] at hWinNNAll
        dsimp [alignAndNull]
        rw [List.length_append] at hWinNNAll
        rw [← Nat.add_assoc startIdx _ _] at hWinNNAll
        have hWinNNS := s3x_window_append_left hWinNNAll
        have hWinNND := s3x_window_append_right hWinNNAll
        have hB0 : Trusted.MirSemantics.getElem? sB (s3_scrBase ctx + 0) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagS })))) := by
          rw [hPresD 0 (by decide), hS0]
        have hB1 : Trusted.MirSemantics.getElem? sB (s3_scrBase ctx + 1) =
            some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pvSrc.offsetBytes.toNat })))) := by
          rw [hPresD 1 (by decide), hS1]
        have hNNS0 := hWinNNS 0 _ rfl
        rw [Nat.add_zero] at hNNS0
        have hNNS1 := hWinNNS 1 _ rfl
        have hNNResS := s3_exec_mkPtrNonNullCheckStmts ctx (mem := mem) optBufS 0 1 tagS pvSrc.offsetBytes.toNat pvSrc
