        rw [hLorEq] at hBinOr
        have hStep3Res := s3_exec_mkBinOpStmt_usize_scr ctx (mem := mem) 7 .bitOr
          (.move { localId := s3_scrBase ctx + 7, projection := [] })
          (.move { localId := s3_scrBase ctx + 6, projection := [] })
          _ _ (acc + b.toNat * Nat.pow 2 (8 * (i0 + 1))) (by decide) hAccNextLtMax
          hM7.2 hM6.2 hBinOr hRelM6 hBbTgt hS3
        cases hStep3Res with | intro s2d hS2d =>
        refine ⟨s2d,
          s3_reachesN_cons hS2a.1 (s3_reachesN_cons hS2b.1 (s3_reachesN_cons hS2c.1 (s3_reachesN_one hS2d.1))),
          hDecNext, hAccNextLtMax, hS2d.2.1, ?_, hS2d.2.2.1⟩
        have hNe71 : s3_scrBase ctx + 7 ≠ s3_scrBase ctx + 1 := by
          intro h; cases Nat.add_left_cancel h
        have hNe61 : s3_scrBase ctx + 6 ≠ s3_scrBase ctx + 1 := by
          intro h; cases Nat.add_left_cancel h
        rw [hS2d.2.2.2 1 (by decide) (by decide),
          s3_getElem?_setElem?_ne _ _ _ _ _ hNe61 hM6.1,
          s3_getElem?_setElem?_ne _ _ _ _ _ hNe71 hM7.1, hOffC]

private theorem s3x_readLe_loop_sim (ctx : s3_PtrCtx)
    {dstLocal bufLoc : LocalId} {w : LeWidth} {nextBb : BasicBlockId}
    {a : Allocation} {slots₁ : List MemCopySlot} {mem : CallerMemory}
    (off : Nat)
    (hDeclDst : Trusted.MirSemantics.getElem? ctx.bodySrc.locals dstLocal = some (.base usizeTy))
    (hDeclBuf : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc = some (.byteBuf a.bytes.length a.alignLog2 a.mutability))
    (hAlloc : findAlloc? (internalAllocBase + bufLoc) mem.allocations = some a)
    (hLive : a.live = true)
    (hLenBound : off + w.byteCount ≤ a.bytes.length)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem) :
    ∀ (rem i curBb acc : Nat) (slots₂ : List MemCopySlot) (abCur : AllocByte),
      i + rem + 1 = w.byteCount →
      decodeLeBytesAux ((a.bytes.drop off).take i) = .ok acc →
      Trusted.MirSemantics.getElem? a.bytes (off + i) = some abCur →
      s3_SlotsRel ctx slots₁ slots₂ →
      Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 1) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 off })))) →
      Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 8) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (encodeAllocByte abCur).fst })))) →
      Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 9) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (encodeAllocByte abCur).snd })))) →
      (0 < i → Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 7) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 acc }))))) →
      (∀ (k : Nat) (eb : MemCopyBlock),
        Trusted.MirSemantics.getElem?
          (buildReadLeByteBlocks dstLocal bufLoc (s3_scrBase ctx + 1) (s3_scrBase ctx + 5)
            (s3_scrBase ctx + 6) (s3_scrBase ctx + 7) (s3_scrBase ctx + 8) (s3_scrBase ctx + 9)
            nextBb i curBb (rem + 1)) k = some eb →
        Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks (curBb + k) = some eb) →
      match decodeLeBytesAux ((a.bytes.drop off).take w.byteCount) with
      | .error err =>
        ∃ (n : Nat) (sBad : MemCopyState),
          ReachesNMemCopy ctx.pTgt n
            { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 0, locals := slots₂ }], mem := mem }
            sBad ∧
          evalStepMemCopy ctx.pTgt 0 sBad = .fault err
      | .ok valNat =>
        match writeMemCopyBasePlace slots₁ dstLocal usizeTy
            (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 valNat }) with
        | .error k =>
          ∃ (n : Nat) (sFault : MemCopyState),
            ReachesNMemCopy ctx.pTgt n
              { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 0, locals := slots₂ }], mem := mem }
              sFault ∧
            evalStepMemCopy ctx.pTgt 0 sFault = .fault k
        | .ok slots₁' =>
          ∃ (n : Nat) (slots₂' : List MemCopySlot),
            ReachesNMemCopy ctx.pTgt (n + 1)
              { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 0, locals := slots₂ }], mem := mem }
              { frames := [{ defId := ctx.plan.defId, blockIdx := nextBb, stmtIdx := 0, locals := slots₂' }], mem := mem } ∧
            s3_MemWf ctx.bodySrc slots₁' mem ∧
            s3_SlotsRel ctx slots₁' slots₂'
  | rem, i, curBb, acc, slots₂, abCur, hSum, hAccOk, hCur, hRel, hOffSlot, hTagSlot, hValSlot, hAccSlot, hBlocks => by
    have hiLtW : i < w.byteCount := by
      rw [← hSum, Nat.add_assoc]
      exact Nat.lt_add_of_pos_right (Nat.succ_pos rem)
    have hPrefLe : i ≤ (a.bytes.drop off).length := by
      rw [s3_list_drop_length]
      have hSub := Nat.sub_le_sub_right hLenBound off
      rw [Nat.add_sub_cancel_left] at hSub
      exact Nat.le_trans (Nat.le_of_lt hiLtW) hSub
    have hLenPref : ((a.bytes.drop off).take i).length = i :=
      s3x_list_take_length_min_le (a.bytes.drop off) i hPrefLe
    let tagChk : List MemCopyStmt := [
      mkSubUncheckedUsize (s3_scrBase ctx + 5)
        (.copy { localId := s3_scrBase ctx + 8, projection := [] }) (usizeConst 1),
      mkSubUncheckedUsize (s3_scrBase ctx + 5)
        (usizeConst 1) (.move { localId := s3_scrBase ctx + 8, projection := [] })
    ]
    let accStmts : List MemCopyStmt :=
      if Nat.beq i 0 then
        [mkAssignUse (s3_scrBase ctx + 7) (.move { localId := s3_scrBase ctx + 9, projection := [] })]
      else
        [mkBinOpStmt (s3_scrBase ctx + 6) .shl
           (.move { localId := s3_scrBase ctx + 9, projection := [] }) (usizeConst (8 * i)),
         mkBinOpStmt (s3_scrBase ctx + 7) .bitOr
           (.move { localId := s3_scrBase ctx + 7, projection := [] })
           (.move { localId := s3_scrBase ctx + 6, projection := [] })]
    let blkCur : MemCopyBlock :=
      match rem with
      | 0 =>
        { statements := tagChk ++ accStmts ++
            [mkAssignUse dstLocal (.move { localId := s3_scrBase ctx + 7, projection := [] })]
          terminator := .baseTerm (.goto nextBb)
          cleanup := false }
      | _ + 1 =>
        { statements := tagChk ++ accStmts ++ [
            mkBinOpStmt (s3_scrBase ctx + 5) .add
              (.copy { localId := s3_scrBase ctx + 1, projection := [] }) (usizeConst (i + 1))
          ]
          terminator := .readBufRawByte (s3_scrBase ctx + 8) (s3_scrBase ctx + 9) bufLoc
            (.move { localId := s3_scrBase ctx + 5, projection := [] }) (curBb + 1)
          cleanup := false }
    have hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks curBb = some blkCur := by
      cases rem with
      | zero => have h0 := hBlocks 0 _ rfl; rw [Nat.add_zero] at h0; exact h0
      | succ rem' => have h0 := hBlocks 0 _ rfl; rw [Nat.add_zero] at h0; exact h0
    have hTagLt : (encodeAllocByte abCur).fst < maxUsize := by
      cases hWf.2.1 bufLoc a.bytes.length a.alignLog2 a.mutability hDeclBuf with
      | intro live hBuf =>
        cases hBuf with
        | intro a' ha' =>
          rw [hAlloc] at ha'
          have haEq : a' = a := by cases ha'.2.1; rfl
          rw [haEq] at ha'
          exact ha'.2.2.2.2.2.2 (off + i) abCur hCur
    have hS0 : Trusted.MirSemantics.getElem? blkCur.statements 0 =
        some (mkSubUncheckedUsize (s3_scrBase ctx + 5)
          (.copy { localId := s3_scrBase ctx + 8, projection := [] }) (usizeConst 1)) := by
      cases rem <;> rfl
    have hS1 : Trusted.MirSemantics.getElem? blkCur.statements 1 =
        some (mkSubUncheckedUsize (s3_scrBase ctx + 5)
          (usizeConst 1) (.move { localId := s3_scrBase ctx + 8, projection := [] })) := by
      cases rem <;> rfl
    have hStmtsAcc : ∀ k s,
        Trusted.MirSemantics.getElem? accStmts k = some s →
        Trusted.MirSemantics.getElem? blkCur.statements (2 + k) = some s := by
      intro k s hk
      cases rem with
      | zero =>
        cases hi0 : Nat.beq i 0 with
        | true => dsimp [accStmts] at hk; rw [hi0] at hk; dsimp at hk; cases k with | zero => cases hk; dsimp [blkCur, tagChk, accStmts]; rw [hi0]; rfl | succ _ => cases hk
        | false =>
          dsimp [accStmts] at hk; rw [hi0] at hk; dsimp at hk
          cases k with
          | zero => cases hk; dsimp [blkCur, tagChk, accStmts]; rw [hi0]; rfl
          | succ k1 =>
            cases k1 with
            | zero => cases hk; dsimp [blkCur, tagChk, accStmts]; rw [hi0]; rfl
            | succ _ => cases hk
      | succ rem' =>
        cases hi0 : Nat.beq i 0 with
        | true => dsimp [accStmts] at hk; rw [hi0] at hk; dsimp at hk; cases k with | zero => cases hk; dsimp [blkCur, tagChk, accStmts]; rw [hi0]; rfl | succ _ => cases hk
        | false =>
          dsimp [accStmts] at hk; rw [hi0] at hk; dsimp at hk
          cases k with
          | zero => cases hk; dsimp [blkCur, tagChk, accStmts]; rw [hi0]; rfl
          | succ k1 =>
            cases k1 with
            | zero => cases hk; dsimp [blkCur, tagChk, accStmts]; rw [hi0]; rfl
            | succ _ => cases hk
    have hAccStep := s3x_readLe_tagChk_acc_ok ctx off i acc w a abCur hiLtW hAccOk hLenPref hCur
      hOffSlot hTagSlot hValSlot hAccSlot hWf hRel hTagLt hBbTgt hS0 hS1 hStmtsAcc
    cases abCur with
    | uninit =>
      rw [s3x_decodeLeBytesAux_bad_prefix a.bytes off i rem acc .uninit w hSum hAccOk hCur (fun _ h => by cases h)]
      exact hAccStep
    | init b optAid =>
      cases optAid with
      | some aid =>
        rw [s3x_decodeLeBytesAux_bad_prefix a.bytes off i rem acc (.init b (some aid)) w hSum hAccOk hCur (fun _ h => by cases h)]
        exact hAccStep
      | none =>
        dsimp at hAccStep
        cases hAccStep with | intro s2a hS2a =>
        let acc' := acc + b.toNat * Nat.pow 2 (8 * i)
        let nSteps := if Nat.beq i 0 then 3 else 4
        cases rem with
        | zero =>
          let blk0 : MemCopyBlock := {
            statements := tagChk ++ accStmts ++
              [mkAssignUse dstLocal (.move { localId := s3_scrBase ctx + 7, projection := [] })]
            terminator := .baseTerm (.goto nextBb)
            cleanup := false
          }
          have hBb0 : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks curBb = some blk0 := hBbTgt
          have hW : i + 1 = w.byteCount := hSum
          have hDecFull : decodeLeBytesAux ((a.bytes.drop off).take w.byteCount) = .ok acc' := by
            rw [← hW]; exact hS2a.2.1
          rw [hDecFull]
          dsimp
          have hSLast : Trusted.MirSemantics.getElem? blk0.statements nSteps =
              some (mkAssignUse dstLocal (.move { localId := s3_scrBase ctx + 7, projection := [] })) := by
            cases hi0 : Nat.beq i 0 with
            | true => dsimp [blk0, tagChk, accStmts, nSteps]; rw [hi0]; rfl
            | false => dsimp [blk0, tagChk, accStmts, nSteps]; rw [hi0]; rfl
          have hSLen : nSteps + 1 = blk0.statements.length := by
            cases hi0 : Nat.beq i 0 with
            | true => dsimp [blk0, tagChk, accStmts, nSteps]; rw [hi0]; rfl
            | false => dsimp [blk0, tagChk, accStmts, nSteps]; rw [hi0]; rfl
          have hStLast := s3x_exec_mkAssignUse_dst_move_scr ctx (mem := mem) dstLocal 7 acc'
            (by decide) hS2a.2.2.1 hDeclDst hWf hS2a.2.2.2.1 hS2a.2.2.2.2.2 hBb0 hSLast
          dsimp at hStLast
          cases hWBase : writeMemCopyBasePlace slots₁ dstLocal usizeTy
              (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 acc' }) with
          | error k =>
            rw [hWBase] at hStLast
            exact ⟨nSteps, _, hS2a.1, hStLast⟩
          | ok slots₁' =>
            rw [hWBase] at hStLast
            cases hStLast with | intro s2b hS2b =>
            have hGo := s3x_exec_goto_term ctx (mem := mem) (slots₂ := s2b) nextBb
              hBb0 rfl
            rw [← hSLen] at hGo
            refine ⟨nSteps + 1, s2b, ?_, hS2b.2.1, hS2b.2.2⟩
            have hR : ReachesNMemCopy ctx.pTgt (nSteps + 2)
                { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 0, locals := slots₂ }], mem := mem }
                { frames := [{ defId := ctx.plan.defId, blockIdx := nextBb, stmtIdx := 0, locals := s2b }], mem := mem } :=
              s3x_reachesN_trans hS2a.1 (s3_reachesN_cons hS2b.1 (s3_reachesN_one hGo))
            exact hR
        | succ rem' =>
          let blkS : MemCopyBlock := {
            statements := tagChk ++ accStmts ++ [
              mkBinOpStmt (s3_scrBase ctx + 5) .add
                (.copy { localId := s3_scrBase ctx + 1, projection := [] }) (usizeConst (i + 1))
            ]
            terminator := .readBufRawByte (s3_scrBase ctx + 8) (s3_scrBase ctx + 9) bufLoc
              (.move { localId := s3_scrBase ctx + 5, projection := [] }) (curBb + 1)
            cleanup := false
          }
          have hBbS : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks curBb = some blkS := hBbTgt
          have hSNext : Trusted.MirSemantics.getElem? blkS.statements nSteps =
              some (mkBinOpStmt (s3_scrBase ctx + 5) .add
                (.copy { localId := s3_scrBase ctx + 1, projection := [] }) (usizeConst (i + 1))) := by
            cases hi0 : Nat.beq i 0 with
            | true => dsimp [blkS, tagChk, accStmts, nSteps]; rw [hi0]; rfl
            | false => dsimp [blkS, tagChk, accStmts, nSteps]; rw [hi0]; rfl
          have hSLen : nSteps + 1 = blkS.statements.length := by
            cases hi0 : Nat.beq i 0 with
            | true => dsimp [blkS, tagChk, accStmts, nSteps]; rw [hi0]; rfl
            | false => dsimp [blkS, tagChk, accStmts, nSteps]; rw [hi0]; rfl
          have hOffPlusNextLe : off + (i + 1) < a.bytes.length := by
            have hSub : i + 1 + (rem' + 1) ≤ w.byteCount := by
              rw [← hSum, Nat.add_assoc i 1 (rem' + 1), Nat.add_comm 1 (rem' + 1), ← Nat.add_assoc]
              exact Nat.le_refl _
            have hI1 : off + (i + 1) + (rem' + 1) ≤ a.bytes.length := by
              rw [Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hSub off) hLenBound
            exact Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.succ_pos rem')) hI1
          have hSzBound : a.bytes.length ≤ 32 := by
            have hLoop := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals
              ctx.bodySrc.argumentCount 0 ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
            have hPB := hLoop.2.2.1 bufLoc a.bytes.length a.alignLog2 a.mutability hDeclBuf
            exact hPB.2.1
          have hOffPlusLtMax : off + (i + 1) < maxUsize :=
            Nat.lt_of_lt_of_le hOffPlusNextLe (Nat.le_trans hSzBound (by decide : 32 ≤ maxUsize))
          have hOffLtMax : off < maxUsize :=
            Nat.lt_of_le_of_lt (Nat.le_add_right off (i + 1)) hOffPlusLtMax
          have hI1LtMax : i + 1 < maxUsize :=
            Nat.lt_of_le_of_lt (Nat.le_add_left (i + 1) off) hOffPlusLtMax
          have hBinAdd := s3_evalBinOp_usize_add off (i + 1) hOffLtMax hI1LtMax
          rw [s3x_nat_mod_eq_of_lt hOffPlusLtMax] at hBinAdd
          have hAddRes := s3_exec_mkBinOpStmt_usize_scr ctx (mem := mem) 5 .add
            (.copy { localId := s3_scrBase ctx + 1, projection := [] }) (usizeConst (i + 1))
            _ _ (off + (i + 1)) (by decide) hOffPlusLtMax
            (s3_evalPrimOp_scr_copy ctx s2a 1 off (by decide) hS2a.2.2.2.2.1)
            (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals s2a (i + 1) hI1LtMax)
            hBinAdd
            hS2a.2.2.2.1 hBbS hSNext
          cases hAddRes with | intro s2b hS2b =>
          have hNextByteEx := s3_getElem?_lt_some a.bytes (off + (i + 1)) hOffPlusNextLe
          cases hNextByteEx with | intro abNext hNextByte =>
          have hLt5 : s3_scrBase ctx + 5 < s2b.length := by
            rw [hS2b.2.1.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 5 (by decide)
          cases s3x_evalUsizeOp_scr_move ctx s2b 5 (off + (i + 1)) (by decide) hOffPlusLtMax hLt5 hS2b.2.2.1 with
          | intro s2bM hM5 =>
          have hRelM5 := s3_slotsRel_set_scratch ctx slots₁ s2b s2bM 5 none (by decide) hS2b.2.1 hM5.1
          have hReadTerm := s3x_exec_readBufRawByte_term ctx bufLoc a.bytes.length a.alignLog2 a.mutability
            (.move { localId := s3_scrBase ctx + 5, projection := [] }) (off + (i + 1)) (curBb + 1)
            a abNext hDeclBuf hM5.2 hWf hRelM5 hBbS rfl hAlloc hLive hNextByte
          cases hReadTerm with | intro s2c hS2c =>
          rw [← hSLen] at hS2c
          have hSumNext : (i + 1) + rem' + 1 = w.byteCount := by
            rw [Nat.add_assoc (i + 1) rem' 1, Nat.add_assoc i 1 (rem' + 1),
              Nat.add_comm 1 (rem' + 1), ← Nat.add_assoc]
            exact hSum
          have hOffC : Trusted.MirSemantics.getElem? s2c (s3_scrBase ctx + 1) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 off })))) := by
            have hNe51 : s3_scrBase ctx + 5 ≠ s3_scrBase ctx + 1 := by
              intro h; cases Nat.add_left_cancel h
            rw [hS2c.2.2.2.2 1 (by decide) (by decide) (by decide),
              s3_getElem?_setElem?_ne _ _ _ _ _ hNe51 hM5.1,
              hS2b.2.2.2 1 (by decide) (by decide), hS2a.2.2.2.2.1]
          have hAccC : 0 < i + 1 → Trusted.MirSemantics.getElem? s2c (s3_scrBase ctx + 7) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 acc' })))) := by
            intro _
            have hNe57 : s3_scrBase ctx + 5 ≠ s3_scrBase ctx + 7 := by
              intro h; cases Nat.add_left_cancel h
            have hAccA : Trusted.MirSemantics.getElem? s2a (s3_scrBase ctx + 7) =
                some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 acc' })))) :=
              hS2a.2.2.2.2.2
            rw [hS2c.2.2.2.2 7 (by decide) (by decide) (by decide),
              s3_getElem?_setElem?_ne _ _ _ _ _ hNe57 hM5.1,
              hS2b.2.2.2 7 (by decide) (by decide), hAccA]
          have hBlocksNext : ∀ (k : Nat) (eb : MemCopyBlock),
              Trusted.MirSemantics.getElem?
                (buildReadLeByteBlocks dstLocal bufLoc (s3_scrBase ctx + 1) (s3_scrBase ctx + 5)
                  (s3_scrBase ctx + 6) (s3_scrBase ctx + 7) (s3_scrBase ctx + 8) (s3_scrBase ctx + 9)
                  nextBb (i + 1) (curBb + 1) (rem' + 1)) k = some eb →
              Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks ((curBb + 1) + k) = some eb := by
            intro k eb hk
            have hStep1 := hBlocks (k + 1) eb (by exact hk)
            rw [Nat.add_comm k 1, ← Nat.add_assoc] at hStep1
            exact hStep1
          have hRec := s3x_readLe_loop_sim ctx off hDeclDst hDeclBuf hAlloc hLive hLenBound hWf
            rem' (i + 1) (curBb + 1) acc' s2c abNext hSumNext hS2a.2.1 hNextByte hS2c.2.1
            hOffC hS2c.2.2.1 hS2c.2.2.2.1 hAccC hBlocksNext
          have hPrefReach : ReachesNMemCopy ctx.pTgt (nSteps + 2)
              { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 0, locals := slots₂ }], mem := mem }
              { frames := [{ defId := ctx.plan.defId, blockIdx := curBb + 1, stmtIdx := 0, locals := s2c }], mem := mem } :=
            s3x_reachesN_trans hS2a.1 (s3_reachesN_cons hS2b.1 (s3_reachesN_one hS2c.1))
          cases hDec : decodeLeBytesAux ((a.bytes.drop off).take w.byteCount) with
          | error err =>
            dsimp
            rw [hDec] at hRec
            dsimp at hRec
            cases hRec with | intro nR hnR =>
            cases hnR with | intro sFault hsFault =>
            exact ⟨(nSteps + 2) + nR, sFault, s3x_reachesN_trans hPrefReach hsFault.1, hsFault.2⟩
          | ok valNat =>
            dsimp
            rw [hDec] at hRec
            dsimp at hRec
            cases hWBase : writeMemCopyBasePlace slots₁ dstLocal usizeTy
                (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 valNat }) with
            | error err =>
              dsimp
              rw [hWBase] at hRec
              dsimp at hRec
              cases hRec with | intro nR hnR =>
              cases hnR with | intro sFault hsFault =>
              exact ⟨(nSteps + 2) + nR, sFault, s3x_reachesN_trans hPrefReach hsFault.1, hsFault.2⟩
            | ok slots₁' =>
              dsimp
              rw [hWBase] at hRec
              dsimp at hRec
              cases hRec with | intro nR hnR =>
              cases hnR with | intro s2Out hsOut =>
              refine ⟨(nSteps + 2) + nR, s2Out, ?_, hsOut.2.1, hsOut.2.2⟩
              have hStepsAssoc : (nSteps + 2) + (nR + 1) = ((nSteps + 2) + nR) + 1 :=
                (Nat.add_assoc (nSteps + 2) nR 1).symm
              rw [← hStepsAssoc]
              exact s3x_reachesN_trans hPrefReach hsOut.1

private theorem s3x_readLeUsize_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (dstLocal p : LocalId) (w : LeWidth) (requireAligned : Bool) (nextBb : BasicBlockId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator = .readLeUsize dstLocal p w requireAligned nextBb)
    (hStmtLen : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hCheckTerm := s3x_checkTermForPtrs_of_bb ctx hBbSrc
  rw [hTerm] at hCheckTerm
  have hTib := s3x_termTargetsInBounds_of_bb ctx hBbSrc
  rw [hTerm] at hTib
  have hBbNextEx := s3x_bb_of_lt ctx nextBb ((nat_blt_eq_lt _ _).mp hTib)
  cases hBbNextEx with | intro bbNext hBbNext =>
  unfold checkTermForPtrs at hCheckTerm
  dsimp at hCheckTerm
  cases hDeclDst : Trusted.MirSemantics.getElem? ctx.bodySrc.locals dstLocal with
  | none => rw [hDeclDst] at hCheckTerm; cases hCheckTerm
  | some dDst =>
    rw [hDeclDst] at hCheckTerm
    cases dDst with
    | byteBuf _ _ _ | ptrLocal => cases hCheckTerm
    | base dstTy =>
      cases hFind : findPtrEntry ctx.plan.entries p with
      | none => rw [hFind] at hCheckTerm; cases hCheckTerm
      | some pPair =>
        rw [hFind] at hCheckTerm
        have hDstUsize : dstTy = usizeTy := s3x_mirTy_beq_usize_eq dstTy hCheckTerm
        subst hDstUsize
        cases pPair with | mk kP optBufP =>
        cases s3_lowerBlock_getElem?_termPre ctx hBbSrc with | intro extraBase hEx =>
        cases hEx with | intro extraSelf hBlock =>
        have hTermPair := hBlock.1
        have hBbTgt := hBlock.2.2.1
        have hStmtsLen := hBlock.2.2.2.1
        have hWinPair := hBlock.2.2.2.2.1
        have hExtraWin := hBlock.2.2.2.2.2
        rw [hBbRel] at hBbTgt
        rw [hTerm] at hTermPair hBbTgt hStmtsLen hWinPair
        unfold lowerTermForPtrs at hTermPair hBbTgt hStmtsLen hWinPair
        dsimp at hTermPair hBbTgt hStmtsLen hWinPair
        rw [hFind] at hTermPair hBbTgt hStmtsLen hWinPair
        dsimp at hTermPair hBbTgt hStmtsLen hWinPair
        have hStartIdx : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length := by
          rw [hIdxEq, hStmtLen]
        let startIdx := s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length
        have hReq : (if requireAligned then w.naturalAlignLog2 else 0) ≤ 30 := by
          cases requireAligned with
          | false => exact Nat.zero_le 30
          | true => exact Nat.le_trans (s3x_leWidth_align_le3 w) (by decide)
        have hSrcEval : evalStepMemCopy ctx.pSrc 0 { frames := [f₁], mem := mem } =
            evalMemCopyTerm ctx.bodySrc bbSrc f₁ mem :=
          s3_step_state_of_term ctx.pSrc f₁ mem ctx.bodySrc bbSrc (by rw [hDef₁]; exact ctx.hBodies) hBbSrc hStmtLen
        have hSrcEq := s3x_memCopyTerm_readLe_eval_eq ctx.bodySrc bbSrc f₁ mem dstLocal p w requireAligned nextBb hTerm
        rw [hSrcEq] at hSrcEval
        unfold evalMemCopyTerm at hSrcEval
        dsimp at hSrcEval
        rw [hDeclDst] at hSrcEval
        dsimp [usizeTy, MirTy.beq, IntWidth.beq] at hSrcEval
        have hStartEq : f₁.stmtIdx = bbSrc.statements.length := hStmtLen
        let f2Start : MemCopyFrame := { defId := ctx.plan.defId, blockIdx := f₂.blockIdx, stmtIdx := startIdx, locals := f₂.locals }
        have hF2Eq : f₂ = f2Start := by
          cases f₂; dsimp at hDef₂ hStartIdx; subst hDef₂ hStartIdx; rfl
        rw [hF2Eq]
        cases optBufP with
        | none =>
          dsimp at hTermPair hBbTgt hWinPair
          have hPairWin := s3x_window_of_termWin hWinPair rfl
          have hTagRead := s3x_ptrTagRead_sim ctx (mem := mem) p kP none
            (if requireAligned then w.naturalAlignLog2 else 0) hFind hReq hWf hRel hBbTgt hPairWin
          cases hRp : readPtrLocal ctx.bodySrc.locals f₁.locals p false with
          | error err =>
            rw [hRp] at hSrcEval hTagRead
            dsimp at hTagRead
            exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval hTagRead
          | ok rp =>
            rw [hRp] at hSrcEval hTagRead
            dsimp at hTagRead
            cases rp with | mk pv slots₁' =>
            dsimp at hSrcEval hTagRead
            rw [hTagRead.1] at hSrcEval
            cases hAl : checkPtrAlignMem mem pv (if requireAligned then w.naturalAlignLog2 else 0) with
            | error err =>
              rw [hAl] at hTagRead
              dsimp at hTagRead
              have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error err := by
                unfold readMemSlice; rw [hAl]
              rw [hRmErr] at hSrcEval
              exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval hTagRead.2
            | ok u =>
              cases u
              rw [hAl] at hTagRead
              dsimp at hTagRead
              have hPvNone : pv.allocId = none :=
                s3x_pv_allocId_none_of_findNone ctx p kP hFind hRel hRp
              have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                unfold readMemSlice; rw [hAl, hPvNone]
              rw [hRmErr] at hSrcEval
              exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval hTagRead.2
        | some bufLoc =>
          have hBufSpec := (s3x_findPtrEntry_bounds_and_spec ctx p kP (some bufLoc) hFind).2 bufLoc rfl
          cases hBufSpec with | intro sz hSz =>
          cases hSz with | intro al hAlSpec =>
          cases hAlSpec with | intro mutab hDeclBufSpec =>
          have hDeclBuf := hDeclBufSpec.1
          dsimp at hTermPair hBbTgt hStmtsLen hWinPair
          rw [hDeclBuf] at hTermPair hBbTgt hStmtsLen hWinPair
          dsimp at hTermPair hBbTgt hStmtsLen hWinPair
          cases hLeSz : !Nat.ble w.byteCount sz with
          | true =>
            rw [hLeSz] at hTermPair hBbTgt hStmtsLen hWinPair
            dsimp at hTermPair hBbTgt hStmtsLen hWinPair
            have hPairWin := s3x_window_of_termWin hWinPair rfl
            have hSplitWin := s3x_window_cons3_split hPairWin
            have hWinLeft := hSplitWin.1
            have hTagRead' := s3x_ptrTagRead_sim ctx (startIdx := startIdx) (mem := mem) p kP (some bufLoc)
              (if requireAligned then w.naturalAlignLog2 else 0) hFind hReq hWf hRel hBbTgt hWinLeft
            cases hRp : readPtrLocal ctx.bodySrc.locals f₁.locals p false with
            | error err =>
              rw [hRp] at hSrcEval hTagRead'
              dsimp at hTagRead'
              exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval hTagRead'
            | ok rp =>
              rw [hRp] at hSrcEval hTagRead'
              dsimp at hTagRead'
              cases rp with | mk pv slots₁' =>
              dsimp at hSrcEval hTagRead'
              rw [hTagRead'.1] at hSrcEval
              cases hAl : checkPtrAlignMem mem pv (if requireAligned then w.naturalAlignLog2 else 0) with
              | error err =>
                rw [hAl] at hTagRead'
                dsimp at hTagRead'
                have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error err := by
                  unfold readMemSlice; rw [hAl]
                rw [hRmErr] at hSrcEval
                exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval hTagRead'.2
              | ok u =>
                cases u
                rw [hAl] at hTagRead'
                dsimp at hTagRead'
                cases hPvId : pv.allocId with
                | none =>
                  rw [hPvId] at hTagRead'
                  dsimp at hTagRead'
                  have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                    unfold readMemSlice; rw [hAl, hPvId]
                  rw [hRmErr] at hSrcEval
                  exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval hTagRead'.2
                | some aid =>
                  rw [hPvId] at hTagRead'
                  dsimp at hTagRead'
                  have hAidEq := hTagRead'.2.1
                  subst hAidEq
                  cases hTagRead'.2.2 with | intro s2a hS2a =>
                  have hTailWin := hSplitWin.2
                  have hLenPre : ([
                    mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kP),
                    mkAssignUse (s3_scrBase ctx) (.copy { localId := ctx.bodySrc.locals.length + 3 * kP + 1, projection := [] }),
                    mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := ctx.bodySrc.locals.length + 3 * kP + 2, projection := [] })
                  ] ++ mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc) (s3_scrBase ctx) (s3_scrBase ctx + 1)
                         (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) (if requireAligned then w.naturalAlignLog2 else 0) ++ [
                    mkSubUncheckedUsize (s3_scrBase ctx + 5)
                      (.copy { localId := s3_scrBase ctx, projection := [] }) (usizeConst 1)
                  ]).length = 3 + (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc) (s3_scrBase ctx) (s3_scrBase ctx + 1)
                         (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) (if requireAligned then w.naturalAlignLog2 else 0)).length + 1 := by
                    rw [List.length_append, List.length_append]; rfl
                  unfold s3_scrBase at hLenPre
                  rw [hLenPre] at hTailWin
                  have hBufStmt := hTailWin 0 (MemCopyStmt.bufLivenessCheck bufLoc) rfl
                  rw [Nat.add_zero] at hBufStmt
                  have hUbStmt := hTailWin 1 (mkImmediateUbStmt (s3_scrBase ctx + 5)) rfl
                  have hLiveRes := s3x_exec_bufLivenessCheck ctx (mem := mem) bufLoc sz al mutab
                    hDeclBuf hWf hS2a.2.1 hBbTgt hBufStmt
                  cases hLiveRes with | intro live hLiveEx =>
                  cases hLiveEx with | intro a ha =>
                  have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                    unfold readMemSlice
                    rw [hAl, hPvId]
                    dsimp
                    rw [ha.1]
                    dsimp
                    cases live with
                    | false => rw [ha.2.1]; rfl
                    | true =>
                      rw [ha.2.1, ha.2.2.2.2.1 rfl]
                      have hSzLt : sz < w.byteCount := nat_ble_false_gt ((bool_not_eq_true _).mp hLeSz)
                      have hNotLe : Nat.ble (pv.offsetBytes.toNat + w.byteCount) sz = false := by
                        cases hB : Nat.ble (pv.offsetBytes.toNat + w.byteCount) sz with
                        | false => rfl
                        | true =>
                          have hLe' := Nat.le_trans (Nat.le_add_left _ _) ((nat_ble_eq_le _ _).mp hB)
                          exact False.elim (Nat.not_lt_of_le hLe' hSzLt)
                      rw [hNotLe]; rfl
                  rw [hRmErr] at hSrcEval
                  cases live with
                  | false =>
                    exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
                      ⟨_, _, hS2a.1, ha.2.2.2.2.2.2 rfl⟩
                  | true =>
                    have hStepLive := ha.2.2.2.2.2.1 rfl
                    have hUbStep := s3x_exec_immediateUb ctx (mem := mem) (slots₂ := s2a) 5 (by decide) hBbTgt hUbStmt
                    exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
                      ⟨_, _, s3x_reachesN_trans hS2a.1 (s3_reachesN_one hStepLive), hUbStep⟩
          | false =>
            rw [hLeSz] at hTermPair hBbTgt hStmtsLen hWinPair
            dsimp at hTermPair hBbTgt hStmtsLen hWinPair
            have hWLeSz : w.byteCount ≤ sz := (nat_ble_eq_le _ _).mp ((bool_not_eq_false _).mp hLeSz)
            have hPairWin := s3x_window_of_termWin hWinPair rfl
            have hSplitWin := s3x_window_cons3_split hPairWin
            have hWinLeft := hSplitWin.1
            have hTagRead' := s3x_ptrTagRead_sim ctx (startIdx := startIdx) (mem := mem) p kP (some bufLoc)
              (if requireAligned then w.naturalAlignLog2 else 0) hFind hReq hWf hRel hBbTgt hWinLeft
            cases hRp : readPtrLocal ctx.bodySrc.locals f₁.locals p false with
            | error err =>
              rw [hRp] at hSrcEval hTagRead'
              dsimp at hTagRead'
              exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval hTagRead'
            | ok rp =>
              rw [hRp] at hSrcEval hTagRead'
              dsimp at hTagRead'
              cases rp with | mk pv slots₁' =>
              dsimp at hSrcEval hTagRead'
              rw [hTagRead'.1] at hSrcEval
              cases hAl : checkPtrAlignMem mem pv (if requireAligned then w.naturalAlignLog2 else 0) with
              | error err =>
                rw [hAl] at hTagRead'
                dsimp at hTagRead'
                have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error err := by
                  unfold readMemSlice; rw [hAl]
                rw [hRmErr] at hSrcEval
                exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval hTagRead'.2
              | ok u =>
                cases u
                rw [hAl] at hTagRead'
                dsimp at hTagRead'
                cases hPvId : pv.allocId with
                | none =>
                  rw [hPvId] at hTagRead'
                  dsimp at hTagRead'
                  have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                    unfold readMemSlice; rw [hAl, hPvId]
                  rw [hRmErr] at hSrcEval
                  exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval hTagRead'.2
                | some aid =>
                  rw [hPvId] at hTagRead'
                  dsimp at hTagRead'
                  have hAidEq := hTagRead'.2.1
                  subst hAidEq
                  cases hTagRead'.2.2 with | intro s2a hS2a =>
                  have hTailWin := hSplitWin.2
                  have hLenPre : ([
                    mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kP),
                    mkAssignUse (s3_scrBase ctx) (.copy { localId := ctx.bodySrc.locals.length + 3 * kP + 1, projection := [] }),
                    mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := ctx.bodySrc.locals.length + 3 * kP + 2, projection := [] })
                  ] ++ mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc) (s3_scrBase ctx) (s3_scrBase ctx + 1)
                         (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) (if requireAligned then w.naturalAlignLog2 else 0) ++ [
                    mkSubUncheckedUsize (s3_scrBase ctx + 5)
                      (.copy { localId := s3_scrBase ctx, projection := [] }) (usizeConst 1)
                  ]).length = 3 + (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc) (s3_scrBase ctx) (s3_scrBase ctx + 1)
                         (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) (if requireAligned then w.naturalAlignLog2 else 0)).length + 1 := by
                    rw [List.length_append, List.length_append]; rfl
                  unfold s3_scrBase at hLenPre
                  rw [hLenPre] at hTailWin
                  have hBufStmt := hTailWin 0 (MemCopyStmt.bufLivenessCheck bufLoc) rfl
                  rw [Nat.add_zero] at hBufStmt
                  have hBndStmt := hTailWin 1
                    (mkSubUncheckedUsize (s3_scrBase ctx + 5)
                      (usizeConst (sz - w.byteCount))
                      (.copy { localId := s3_scrBase ctx + 1, projection := [] })) rfl
                  have hStmtEnd := hStmtsLen.symm
                  have hTailLen :
                      (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc)
                            (ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length)
                            (ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length + 1)
                            (ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length + 5)
                            (ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length + 6)
                            (if requireAligned then w.naturalAlignLog2 else 0) ++
                          [mkSubUncheckedUsize (ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length + 5)
                            (.copy { localId := ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length, projection := [] })
                            (usizeConst 1)] ++
                          [MemCopyStmt.bufLivenessCheck bufLoc,
                           mkSubUncheckedUsize (ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length + 5)
                             (usizeConst (sz - w.byteCount))
                             (.copy { localId := ctx.bodySrc.locals.length + 3 * ctx.plan.entries.length + 1, projection := [] })]).length +
                        1 + 1 + 1 =
                        (3 + (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc) (s3_scrBase ctx) (s3_scrBase ctx + 1)
                          (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) (if requireAligned then w.naturalAlignLog2 else 0)).length + 1) + 2 := by
                    rw [List.length_append, List.length_append]
                    have hA : (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc)
                        (s3_scrBase ctx) (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6)
                        (if requireAligned then w.naturalAlignLog2 else 0)).length + 1 + 2 + 1 + 1 + 1 =
                        (3 + (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc) (s3_scrBase ctx) (s3_scrBase ctx + 1)
                          (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) (if requireAligned then w.naturalAlignLog2 else 0)).length + 1) + 2 := by
                      rw [Nat.add_assoc _ 1 2, Nat.add_comm _ 3, Nat.add_assoc ((3 + _) + 1) 1 1]
                      rfl
                    exact hA
                  rw [hTailLen, ← Nat.add_assoc] at hStmtEnd
                  have hLiveRes := s3x_exec_bufLivenessCheck ctx (mem := mem) bufLoc sz al mutab
                    hDeclBuf hWf hS2a.2.1 hBbTgt hBufStmt
                  cases hLiveRes with | intro live hLiveEx =>
                  cases hLiveEx with | intro a ha =>
                  cases live with
                  | false =>
                    have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                      unfold readMemSlice; rw [hAl, hPvId]; dsimp; rw [ha.1]; dsimp; rw [ha.2.1]; rfl
                    rw [hRmErr] at hSrcEval
                    exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
                      ⟨_, _, hS2a.1, ha.2.2.2.2.2.2 rfl⟩
                  | true =>
                    have hALen : a.bytes.length = sz := ha.2.2.2.2.1 rfl
                    have hStepLive := ha.2.2.2.2.2.1 rfl
                    have hReachLive := s3x_reachesN_trans hS2a.1 (s3_reachesN_one hStepLive)
                    have hDiffLtMax : sz - w.byteCount < maxUsize :=
                      Nat.lt_of_le_of_lt (Nat.sub_le _ _)
                        (Nat.lt_of_le_of_lt hDeclBufSpec.2.1 (by decide : 32 < maxUsize))
                    have hOffLtMax : pv.offsetBytes.toNat < maxUsize := s3x_uint64_toNat_lt_maxUsize pv.offsetBytes
                    have hSubBnd := s3_exec_mkSubUncheckedUsize_scr ctx (mem := mem)
                      (idx := startIdx + (3 + _ + 1) + 1) 5
                      (usizeConst (sz - w.byteCount))
                      (.copy { localId := s3_scrBase ctx + 1, projection := [] })
                      (sz - w.byteCount) pv.offsetBytes.toNat (by decide) hDiffLtMax hOffLtMax
                      (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals s2a (sz - w.byteCount) hDiffLtMax)
                      (s3_evalPrimOp_scr_copy ctx s2a 1 pv.offsetBytes.toNat (by decide) hS2a.2.2.1)
                      hS2a.2.1 hBbTgt hBndStmt
                    cases hInBnd : Nat.ble (pv.offsetBytes.toNat + w.byteCount) a.bytes.length with
                    | false =>
                      have hLtGt : a.bytes.length < pv.offsetBytes.toNat + w.byteCount := nat_ble_false_gt hInBnd
                      have hDiffLtOff : sz - w.byteCount < pv.offsetBytes.toNat := by
                        rw [hALen] at hLtGt
                        exact s3x_nat_sub_lt_of_lt_add hWLeSz hLtGt
                      have hRmErr : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                        unfold readMemSlice; rw [hAl, hPvId]; dsimp; rw [ha.1]; dsimp; rw [ha.2.1, hInBnd]; rfl
                      rw [hRmErr] at hSrcEval
                      exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
                        ⟨_, _, hReachLive, hSubBnd.2 hDiffLtOff⟩
                    | true =>
                      have hOffPlusLe : pv.offsetBytes.toNat + w.byteCount ≤ a.bytes.length :=
                        (nat_ble_eq_le _ _).mp hInBnd
                      have hOffLeDiff : pv.offsetBytes.toNat ≤ sz - w.byteCount := by
                        rw [hALen] at hOffPlusLe
                        have hSub := Nat.sub_le_sub_right hOffPlusLe w.byteCount
                        rw [Nat.add_sub_cancel] at hSub
                        exact hSub
                      cases hSubBnd.1 hOffLeDiff with | intro s2b hS2b =>
                      have hOffB : Trusted.MirSemantics.getElem? s2b (s3_scrBase ctx + 1) =
                          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) := by
                        rw [hS2b.2.2.2 1 (by decide) (by decide)]; exact hS2a.2.2.1
                      have hOffPlus0 : pv.offsetBytes.toNat + 0 < a.bytes.length := by
                        rw [Nat.add_zero]
                        exact Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (s3x_leWidth_pos w)) hOffPlusLe
                      cases s3_getElem?_lt_some a.bytes (pv.offsetBytes.toNat + 0) hOffPlus0 with | intro ab0 hByte0 =>
                      have hTermRead := s3x_exec_readBufRawByte_term ctx (mem := mem) bufLoc sz al mutab
                        (.copy { localId := s3_scrBase ctx + 1, projection := [] }) pv.offsetBytes.toNat extraBase
                        a ab0 hDeclBuf
                        (s3x_evalUsizeOp_scr_copy ctx s2b 1 pv.offsetBytes.toNat (by decide) hOffLtMax hOffB)
                        hWf hS2b.2.1 hBbTgt rfl ha.1 (ha.2.1) (by rw [Nat.add_zero] at hByte0; exact hByte0)
                      cases hTermRead with | intro s2c hS2c =>
                      rw [hStmtEnd] at hS2c
                      have hOffC : Trusted.MirSemantics.getElem? s2c (s3_scrBase ctx + 1) =
                          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) := by
                        rw [hS2c.2.2.2.2 1 (by decide) (by decide) (by decide)]; exact hOffB
                      have hWPos : ∃ rem, rem + 1 = w.byteCount :=
                        ⟨w.byteCount - 1, Nat.sub_add_cancel (s3x_leWidth_pos w)⟩
                      cases hWPos with | intro rem hRem =>
                      have hLoopBlocks : ∀ (k : Nat) (eb : MemCopyBlock),
                          Trusted.MirSemantics.getElem?
                            (buildReadLeByteBlocks dstLocal bufLoc (s3_scrBase ctx + 1) (s3_scrBase ctx + 5)
                              (s3_scrBase ctx + 6) (s3_scrBase ctx + 7) (s3_scrBase ctx + 8) (s3_scrBase ctx + 9)
                              nextBb 0 extraBase (rem + 1)) k = some eb →
                          Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks (extraBase + k) = some eb := by
                        intro k eb hk
                        rw [hRem] at hk
                        rw [← hTermPair] at hExtraWin
                        exact hExtraWin k eb hk
                      have hAcc0 : decodeLeBytesAux ((a.bytes.drop pv.offsetBytes.toNat).take 0) = .ok 0 := rfl
                      have hDeclBufLen : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc =
                          some (.byteBuf a.bytes.length al mutab) := by
                        rw [hALen]; exact hDeclBuf
                      rw [← ha.2.2.1, ← ha.2.2.2.1] at hDeclBufLen
                      have hLoopSim := s3x_readLe_loop_sim ctx pv.offsetBytes.toNat hDeclDst hDeclBufLen
                        ha.1 (ha.2.1) hOffPlusLe hWf rem 0 extraBase 0 s2c ab0
                        (by rw [Nat.zero_add]; exact hRem) hAcc0 hByte0 hS2c.2.1
                        hOffC hS2c.2.2.1 hS2c.2.2.2.1 (fun h => False.elim (Nat.not_lt_zero 0 h)) hLoopBlocks
                      have hRmOk : readMemSlice mem pv w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) =
                          .ok ((a.bytes.drop pv.offsetBytes.toNat).take w.byteCount) := by
                        unfold readMemSlice; rw [hAl, hPvId]; dsimp; rw [ha.1]; dsimp; rw [ha.2.1, hInBnd]; rfl
                      have hDecEq : decodeLeUsize w ((a.bytes.drop pv.offsetBytes.toNat).take w.byteCount) =
                          decodeLeBytesAux ((a.bytes.drop pv.offsetBytes.toNat).take w.byteCount) := by
                        apply s3x_decodeLeUsize_eq
                        apply s3x_list_take_length_min_le
                        rw [s3_list_drop_length]
                        have hSub := Nat.sub_le_sub_right hOffPlusLe pv.offsetBytes.toNat
                        rw [Nat.add_sub_cancel_left] at hSub
                        exact hSub
                      rw [hRmOk] at hSrcEval
                      dsimp at hSrcEval
                      rw [hDecEq] at hSrcEval
                      have hPrefToExtra :=
                        s3x_reachesN_trans (s3x_reachesN_trans hReachLive (s3_reachesN_one hS2b.1)) (s3_reachesN_one hS2c.1)
                      cases hDec : decodeLeBytesAux ((a.bytes.drop pv.offsetBytes.toNat).take w.byteCount) with
                      | error err =>
                        rw [hDec] at hSrcEval hLoopSim
                        cases hLoopSim with | intro nL hnL =>
                        cases hnL with | intro sFault hsFault =>
                        exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval
                          ⟨_, _, s3x_reachesN_trans hPrefToExtra hsFault.1, hsFault.2⟩
                      | ok valNat =>
                        rw [hDec] at hSrcEval hLoopSim
                        dsimp at hSrcEval hLoopSim
                        have hU : MirTy.int IntWidth.isize false = usizeTy := rfl
                        rw [hU] at hSrcEval
                        cases hWBase : writeMemCopyBasePlace f₁.locals dstLocal usizeTy
                            (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 valNat }) with
                        | error err =>
                          rw [hWBase] at hSrcEval hLoopSim
                          dsimp at hSrcEval hLoopSim
                          cases hLoopSim with | intro nL hnL =>
                          cases hnL with | intro sFault hsFault =>
                          exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval
                            ⟨_, _, s3x_reachesN_trans hPrefToExtra hsFault.1, hsFault.2⟩
                        | ok slots₁' =>
                          rw [hWBase] at hSrcEval hLoopSim
                          dsimp at hSrcEval hLoopSim
                          cases hLoopSim with | intro nL hnL =>
                          cases hnL with | intro s2Out hsOut =>
                          have hReachAll := s3x_reachesN_trans hPrefToExtra hsOut.1
                          have hStepPos : ∀ (aN bN : Nat) (sA sB : MemCopyState),
                              ReachesNMemCopy ctx.pTgt (aN + (bN + 1)) sA sB →
                              ReachesNMemCopy ctx.pTgt ((aN + bN) + 1) sA sB := by
                            intro aN bN sA sB hR; rw [Nat.add_assoc]; exact hR
                          exact s3x_fwdStepSim_of_jump ctx hEqId hDef₁ rfl hBbNext hSrcEval (hStepPos _ _ _ _ hReachAll) hsOut.2.1 hsOut.2.2


/-! ## Section 4: `writeLeUsize` Terminator Simulation (`s3x_writeLeUsize_sim`) -/

private theorem s3x_writeLe_byte_eq (w : LeWidth) (valNat i : Nat) (_hi : i < w.byteCount) :
    decodeAllocByte 1 (Nat.land (Nat.shiftRight valNat (8 * i)) 255) =
      .init (UInt8.ofNat (Nat.mod (Nat.div valNat (Nat.pow 2 (8 * i))) 256)) none := by
  have hLand : Nat.land (Nat.shiftRight valNat (8 * i)) 255 =
      Nat.mod (Nat.shiftRight valNat (8 * i)) 256 :=
    s3_nat_land_pow2_sub_one (Nat.shiftRight valNat (8 * i)) 8
  have hModLt : Nat.mod (Nat.shiftRight valNat (8 * i)) 256 < 256 :=
    Nat.mod_lt _ (by decide : 0 < 256)
  rw [hLand]
  unfold decodeAllocByte
  have hNe0 : Nat.beq 1 0 = false := rfl
  have hEq1 : Nat.beq 1 1 = true := rfl
  rw [hNe0, hEq1]
  dsimp
  change AllocByte.init (UInt8.ofNat (Nat.mod (Nat.mod (Nat.shiftRight valNat (8 * i)) 256) 256)) none =
    .init (UInt8.ofNat (Nat.mod (Nat.div valNat (Nat.pow 2 (8 * i))) 256)) none
  rw [s3x_nat_mod_eq_of_lt hModLt, s3x_nat_shiftRight_eq]

private theorem s3x_encodeLeUsize_one (valNat : Nat) :
    encodeLeBytesAux none 1 valNat =
      [decodeAllocByte 1 (Nat.land valNat 255)] := by
  have hLand : Nat.land valNat 255 = Nat.mod valNat 256 :=
    s3_nat_land_pow2_sub_one valNat 8
  have hModLt : Nat.mod valNat 256 < 256 := Nat.mod_lt _ (by decide : 0 < 256)
  rw [hLand]
  unfold encodeLeBytesAux decodeAllocByte
  have hNe0 : Nat.beq 1 0 = false := rfl
  have hEq1 : Nat.beq 1 1 = true := rfl
  rw [hNe0, hEq1]
  dsimp
  rw [s3x_nat_mod_eq_of_lt hModLt]
  rfl

private theorem s3x_writeLe_loop_sim (ctx : s3_PtrCtx)
    {bufLoc : LocalId} {w : LeWidth} {nextBb : BasicBlockId}
    {a0 : Allocation} {slots₁ : List MemCopySlot} {mem0 : CallerMemory}
    (off valNat : Nat)
    (hValLt : valNat < maxUsize)
    (hDeclBuf : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc =
      some (.byteBuf a0.bytes.length a0.alignLog2 .mut))
    (hAlloc0 : findAlloc? (internalAllocBase + bufLoc) mem0.allocations = some a0)
    (hLive0 : a0.live = true)
    (hMut0 : a0.mutability = .mut)
    (hLenBound : off + w.byteCount ≤ a0.bytes.length)
    (hSzBound : a0.bytes.length ≤ 32) :
    ∀ (rem i curBb : Nat) (memCur : CallerMemory) (aCur : Allocation) (slots₂ : List MemCopySlot),
      0 < i →
      i + rem + 1 = w.byteCount →
      aCur = { a0 with bytes := spliceBytes a0.bytes off ((encodeLeUsize w valNat).take i) } →
      updateAlloc? (internalAllocBase + bufLoc) aCur mem0.allocations = some memCur.allocations →
      findAlloc? (internalAllocBase + bufLoc) memCur.allocations = some aCur →
      s3_MemWf ctx.bodySrc slots₁ memCur →
      s3_SlotsRel ctx slots₁ slots₂ →
      Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 1) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 off })))) →
      Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 7) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 valNat })))) →
      (∀ (k : Nat) (eb : MemCopyBlock),
        Trusted.MirSemantics.getElem?
          (buildWriteLeByteBlocks bufLoc (s3_scrBase ctx + 1) (s3_scrBase ctx + 5)
            (s3_scrBase ctx + 6) (s3_scrBase ctx + 7) (s3_scrBase ctx + 9)
            nextBb i curBb (rem + 1)) k = some eb →
        Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks (curBb + k) = some eb) →
      ∃ (allocsOut : List Allocation) (slots₂' : List MemCopySlot),
        updateAlloc? (internalAllocBase + bufLoc)
          { a0 with bytes := spliceBytes a0.bytes off (encodeLeUsize w valNat) }
          mem0.allocations = some allocsOut ∧
        ReachesNMemCopy ctx.pTgt (4 * (rem + 1))
          { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 0, locals := slots₂ }], mem := memCur }
          { frames := [{ defId := ctx.plan.defId, blockIdx := nextBb, stmtIdx := 0, locals := slots₂' }], mem := ⟨allocsOut⟩ } ∧
        s3_MemWf ctx.bodySrc slots₁ ⟨allocsOut⟩ ∧
        s3_SlotsRel ctx slots₁ slots₂'
  | rem, i, curBb, memCur, aCur, slots₂, hiPos, hSum, haCurEq, hUpCur, hFindCur, hWfCur, hRel, hOffSlot, hAccSlot, hBlocks => by
    have hiLtW : i < w.byteCount := by
      rw [← hSum, Nat.add_assoc]
      exact Nat.lt_add_of_pos_right (Nat.succ_pos rem)
    have hShift64 : 8 * i < 64 := s3x_eight_mul_lt64 (Nat.lt_of_lt_of_le hiLtW (s3x_leWidth_le8 w))
    have hEncLen : (encodeLeUsize w valNat).length = w.byteCount := s3_encodeLeUsize_length w valNat
    have hiLeEnc : i ≤ (encodeLeUsize w valNat).length := by rw [hEncLen]; exact Nat.le_of_lt hiLtW
    have hTakeLen : ((encodeLeUsize w valNat).take i).length = i :=
      s3x_list_take_length_min_le (encodeLeUsize w valNat) i hiLeEnc
    have haCurLive : aCur.live = true := by rw [haCurEq]; exact hLive0
    have haCurMut : aCur.mutability = .mut := by rw [haCurEq]; exact hMut0
    have hOffPlusILe : off + i ≤ a0.bytes.length :=
      Nat.le_trans (Nat.add_le_add_left (Nat.le_of_lt hiLtW) off) hLenBound
    have haCurLen : aCur.bytes.length = a0.bytes.length := by
      rw [haCurEq]
      dsimp
      apply s3_spliceBytes_length
      rw [hTakeLen]
      exact hOffPlusILe
    have hOffPlusILt : off + i < aCur.bytes.length := by
      rw [haCurLen]
      have hSub : i + (rem + 1) = w.byteCount := by rw [← hSum, Nat.add_assoc]
      have hLe : off + i + (rem + 1) ≤ a0.bytes.length := by
        rw [Nat.add_assoc, hSub]; exact hLenBound
      exact Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.succ_pos rem)) hLe
    have hOffPlusILtMax : off + i < maxUsize :=
      Nat.lt_of_lt_of_le (by rw [← haCurLen]; exact hOffPlusILt) (Nat.le_trans hSzBound (by decide : 32 ≤ maxUsize))
    have hOffLtMax : off < maxUsize :=
      Nat.lt_of_le_of_lt (Nat.le_add_right off i) hOffPlusILtMax
    have hILtMax : i < maxUsize :=
      Nat.lt_of_le_of_lt (Nat.le_add_left i off) hOffPlusILtMax
    have hShiftLtMax : Nat.shiftRight valNat (8 * i) < maxUsize := by
      rw [s3x_nat_shiftRight_eq]
      exact Nat.lt_of_le_of_lt (Nat.div_le_self _ _) hValLt
    have hLandVal : Nat.land (Nat.shiftRight valNat (8 * i)) 255 =
        Nat.mod (Nat.shiftRight valNat (8 * i)) 256 :=
      s3_nat_land_pow2_sub_one (Nat.shiftRight valNat (8 * i)) 8
    have hByteLt256 : Nat.land (Nat.shiftRight valNat (8 * i)) 255 < 256 := by
      rw [hLandVal]; exact Nat.mod_lt _ (by decide : 0 < 256)
    have hByteLtMax : Nat.land (Nat.shiftRight valNat (8 * i)) 255 < maxUsize :=
      Nat.lt_trans hByteLt256 (by decide : 256 < maxUsize)
    let targetBb := match rem with | 0 => nextBb | _ + 1 => curBb + 1
    let blk : MemCopyBlock := {
      statements := [
        mkBinOpStmt (s3_scrBase ctx + 6) .shr
          (.copy { localId := s3_scrBase ctx + 7, projection := [] }) (usizeConst (8 * i)),
        mkBinOpStmt (s3_scrBase ctx + 9) .bitAnd
          (.move { localId := s3_scrBase ctx + 6, projection := [] }) (usizeConst 255),
        mkBinOpStmt (s3_scrBase ctx + 5) .add
          (.copy { localId := s3_scrBase ctx + 1, projection := [] }) (usizeConst i)
      ]
      terminator := .writeBufRawByte bufLoc
        (.move { localId := s3_scrBase ctx + 5, projection := [] })
        (usizeConst 1)
        (.move { localId := s3_scrBase ctx + 9, projection := [] })
        targetBb
      cleanup := false
    }
    have hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks curBb = some blk := by
      have h0 := hBlocks 0 _ rfl
      rw [Nat.add_zero] at h0
      exact h0
    have hBinShr := s3_evalBinOp_usize_shr valNat (8 * i) hValLt hShift64
    have hShrStep := s3_exec_mkBinOpStmt_usize_scr ctx (mem := memCur) (idx := 0) 6 .shr
      (.copy { localId := s3_scrBase ctx + 7, projection := [] }) (usizeConst (8 * i))
      _ _ (Nat.shiftRight valNat (8 * i)) (by decide) hShiftLtMax
      (s3_evalPrimOp_scr_copy ctx slots₂ 7 valNat (by decide) hAccSlot)
      (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals slots₂ (8 * i) (Nat.lt_trans hShift64 (by decide : 64 < maxUsize)))
      hBinShr hRel hBbTgt rfl
    cases hShrStep with | intro s2a hS2a =>
    have hLt6 : s3_scrBase ctx + 6 < s2a.length := by
      rw [hS2a.2.1.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 6 (by decide)
    cases s3_evalPrimOp_scr_move ctx s2a 6 (Nat.shiftRight valNat (8 * i)) (by decide) hLt6 hS2a.2.2.1 with
    | intro s2aM hM6 =>
    have hRelM6 := s3_slotsRel_set_scratch ctx slots₁ s2a s2aM 6 none (by decide) hS2a.2.1 hM6.1
    have hBinAnd := s3_evalBinOp_usize_bitAnd (Nat.shiftRight valNat (8 * i)) 255 hShiftLtMax (by decide : 255 < maxUsize)
    have hAndStep := s3_exec_mkBinOpStmt_usize_scr ctx (mem := memCur) (idx := 1) 9 .bitAnd
      (.move { localId := s3_scrBase ctx + 6, projection := [] }) (usizeConst 255)
      _ _ (Nat.land (Nat.shiftRight valNat (8 * i)) 255) (by decide) hByteLtMax
      hM6.2 (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals s2aM 255 (by decide : 255 < maxUsize))
      hBinAnd hRelM6 hBbTgt rfl
    cases hAndStep with | intro s2b hS2b =>
    have hOffB : Trusted.MirSemantics.getElem? s2b (s3_scrBase ctx + 1) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 off })))) := by
      have hNe61 : s3_scrBase ctx + 6 ≠ s3_scrBase ctx + 1 := by intro h; cases Nat.add_left_cancel h
      rw [hS2b.2.2.2 1 (by decide) (by decide), s3_getElem?_setElem?_ne _ _ _ _ _ hNe61 hM6.1,
        hS2a.2.2.2 1 (by decide) (by decide), hOffSlot]
    have hAccB : Trusted.MirSemantics.getElem? s2b (s3_scrBase ctx + 7) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 valNat })))) := by
      have hNe67 : s3_scrBase ctx + 6 ≠ s3_scrBase ctx + 7 := by intro h; cases Nat.add_left_cancel h
      rw [hS2b.2.2.2 7 (by decide) (by decide), s3_getElem?_setElem?_ne _ _ _ _ _ hNe67 hM6.1,
        hS2a.2.2.2 7 (by decide) (by decide), hAccSlot]
    have hBinAdd := s3_evalBinOp_usize_add off i hOffLtMax hILtMax
    rw [s3x_nat_mod_eq_of_lt hOffPlusILtMax] at hBinAdd
    have hAddStep := s3_exec_mkBinOpStmt_usize_scr ctx (mem := memCur) (idx := 2) 5 .add
      (.copy { localId := s3_scrBase ctx + 1, projection := [] }) (usizeConst i)
      _ _ (off + i) (by decide) hOffPlusILtMax
      (s3_evalPrimOp_scr_copy ctx s2b 1 off (by decide) hOffB)
      (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals s2b i hILtMax)
      hBinAdd
      hS2b.2.1 hBbTgt rfl
    cases hAddStep with | intro s2c hS2c =>
    have hLt5 : s3_scrBase ctx + 5 < s2c.length := by
      rw [hS2c.2.1.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 5 (by decide)
    cases s3x_evalUsizeOp_scr_move ctx s2c 5 (off + i) (by decide) hOffPlusILtMax hLt5 hS2c.2.2.1 with
    | intro s2cM5 hM5 =>
    have hRelM5 := s3_slotsRel_set_scratch ctx slots₁ s2c s2cM5 5 none (by decide) hS2c.2.1 hM5.1
    have hTag1 : evalUsizeOp ctx.bodyTgt.locals s2cM5 (usizeConst 1) = .ok (1, s2cM5) :=
      s3x_evalUsizeOp_usizeConst ctx.bodyTgt.locals s2cM5 1 (by decide : 1 < maxUsize)
    have hVal9C : Trusted.MirSemantics.getElem? s2cM5 (s3_scrBase ctx + 9) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (Nat.land (Nat.shiftRight valNat (8 * i)) 255) })))) := by
      have hNe59 : s3_scrBase ctx + 5 ≠ s3_scrBase ctx + 9 := by intro h; cases Nat.add_left_cancel h
      rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe59 hM5.1, hS2c.2.2.2 9 (by decide) (by decide), hS2b.2.2.1]
    have hLt9 : s3_scrBase ctx + 9 < s2cM5.length := by
      rw [hRelM5.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 9 (by decide)
    cases s3x_evalUsizeOp_scr_move ctx s2cM5 9 (Nat.land (Nat.shiftRight valNat (8 * i)) 255)
        (by decide) hByteLtMax hLt9 hVal9C with | intro s2cM9 hM9 =>
    have hRelM9 := s3_slotsRel_set_scratch ctx slots₁ s2cM5 s2cM9 9 none (by decide) hRelM5 hM9.1
    have hDeclBufCur : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc =
        some (.byteBuf a0.bytes.length a0.alignLog2 .mut) := hDeclBuf
    have hWriteTerm := s3x_exec_writeBufRawByte_term ctx (mem := memCur) bufLoc a0.bytes.length a0.alignLog2 .mut
      (.move { localId := s3_scrBase ctx + 5, projection := [] }) (usizeConst 1)
      (.move { localId := s3_scrBase ctx + 9, projection := [] })
      (off + i) 1 (Nat.land (Nat.shiftRight valNat (8 * i)) 255) targetBb aCur
      hDeclBufCur hM5.2 hTag1 hM9.2 (by decide : 1 < maxUsize) hWfCur hRelM9 hBbTgt rfl
      hFindCur haCurLive haCurMut hOffPlusILt
    cases hWriteTerm with | intro allocsNext hWrNext =>
    let abNext := decodeAllocByte 1 (Nat.land (Nat.shiftRight valNat (8 * i)) 255)
    let aNext : Allocation := { aCur with bytes := spliceBytes aCur.bytes (off + i) [abNext] }
    have hEncI : Trusted.MirSemantics.getElem? (encodeLeUsize w valNat) i = some abNext := by
      rw [s3_encodeLeUsize_getElem? w valNat i hiLtW, s3x_nat_shiftRight_eq]
      rw [← s3x_writeLe_byte_eq w valNat i hiLtW]
    have hSpliceMerge : spliceBytes aCur.bytes (off + i) [abNext] =
        spliceBytes a0.bytes off ((encodeLeUsize w valNat).take (i + 1)) := by
      rw [haCurEq]
      dsimp
      have hBoundStep : off + (((encodeLeUsize w valNat).take i).length + 1) ≤ a0.bytes.length := by
        rw [hTakeLen]
        have hSub : i + 1 + rem = w.byteCount := by
          rw [← hSum, Nat.add_assoc, Nat.add_comm 1 rem, ← Nat.add_assoc]
        have hLe : off + (i + 1 + rem) ≤ a0.bytes.length := by rw [hSub]; exact hLenBound
        exact Nat.le_trans (Nat.add_le_add_left (Nat.le_add_right _ rem) off) hLe
      have hSpliceApp := s3_spliceBytes_append_single a0.bytes off ((encodeLeUsize w valNat).take i) abNext hBoundStep
      rw [hTakeLen] at hSpliceApp
      rw [hSpliceApp]
      rw [← s3x_list_take_succ_getElem? (encodeLeUsize w valNat) i abNext hEncI]
    have haNextEq : aNext = { a0 with bytes := spliceBytes a0.bytes off ((encodeLeUsize w valNat).take (i + 1)) } := by
      have hFlds : { aCur with bytes := spliceBytes aCur.bytes (off + i) [abNext] } =
          { a0 with bytes := spliceBytes a0.bytes off ((encodeLeUsize w valNat).take (i + 1)) } := by
        rw [hSpliceMerge, haCurEq]
      exact hFlds
    have haCurAid : aCur.allocId = internalAllocBase + bufLoc := by
      rw [haCurEq]
      exact s3x_findAlloc?_allocId mem0.allocations (internalAllocBase + bufLoc) a0 hAlloc0
    have haNextAid : aNext.allocId = internalAllocBase + bufLoc := by
      rw [haNextEq]
      exact s3x_findAlloc?_allocId mem0.allocations (internalAllocBase + bufLoc) a0 hAlloc0
    have hUp0Next : updateAlloc? (internalAllocBase + bufLoc) aNext mem0.allocations = some allocsNext :=
      s3x_updateAlloc?_idem mem0.allocations memCur.allocations allocsNext
        (internalAllocBase + bufLoc) aCur aNext haCurAid hUpCur hWrNext.1
    have hFindNext : findAlloc? (internalAllocBase + bufLoc) allocsNext = some aNext :=
      s3_findAlloc?_update_eq memCur.allocations (internalAllocBase + bufLoc) aNext allocsNext haNextAid hWrNext.1
    have hReach4 : ReachesNMemCopy ctx.pTgt 4
        { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 0, locals := slots₂ }], mem := memCur }
        { frames := [{ defId := ctx.plan.defId, blockIdx := targetBb, stmtIdx := 0, locals := s2cM9 }], mem := ⟨allocsNext⟩ } := by
      have hStep4 : evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 3, locals := s2c }], mem := memCur } =
          .step { frames := [{ defId := ctx.plan.defId, blockIdx := targetBb, stmtIdx := 0, locals := s2cM9 }], mem := ⟨allocsNext⟩ } :=
        hWrNext.2.1
      exact s3_reachesN_cons hS2a.1 (s3_reachesN_cons hS2b.1 (s3_reachesN_cons hS2c.1 (s3_reachesN_one hStep4)))
    cases rem with
    | zero =>
      have hFull : i + 1 = w.byteCount := by
        rw [Nat.add_zero] at hSum; exact hSum
      have hTakeAll : (encodeLeUsize w valNat).take w.byteCount = encodeLeUsize w valNat := by
        rw [← hEncLen]; exact s3x_list_take_all _
      rw [hFull, hTakeAll] at haNextEq
      rw [haNextEq] at hUp0Next
      dsimp [targetBb] at hReach4
      exact ⟨allocsNext, s2cM9, hUp0Next, hReach4, hWrNext.2.2, hRelM9⟩
    | succ rem' =>
      have hSumNext : (i + 1) + rem' + 1 = w.byteCount := by
        rw [← hSum, Nat.add_assoc i 1 rem', Nat.add_comm 1 rem', ← Nat.add_assoc]
      have hOffNext : Trusted.MirSemantics.getElem? s2cM9 (s3_scrBase ctx + 1) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 off })))) := by
        have hNe91 : s3_scrBase ctx + 9 ≠ s3_scrBase ctx + 1 := by intro h; cases Nat.add_left_cancel h
        have hNe51 : s3_scrBase ctx + 5 ≠ s3_scrBase ctx + 1 := by intro h; cases Nat.add_left_cancel h
        rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe91 hM9.1,
          s3_getElem?_setElem?_ne _ _ _ _ _ hNe51 hM5.1,
          hS2c.2.2.2 1 (by decide) (by decide), hOffB]
      have hAccNext : Trusted.MirSemantics.getElem? s2cM9 (s3_scrBase ctx + 7) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 valNat })))) := by
        have hNe97 : s3_scrBase ctx + 9 ≠ s3_scrBase ctx + 7 := by intro h; cases Nat.add_left_cancel h
        have hNe57 : s3_scrBase ctx + 5 ≠ s3_scrBase ctx + 7 := by intro h; cases Nat.add_left_cancel h
        rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe97 hM9.1,
          s3_getElem?_setElem?_ne _ _ _ _ _ hNe57 hM5.1,
          hS2c.2.2.2 7 (by decide) (by decide), hAccB]
      have hBlocksNext : ∀ (k : Nat) (eb : MemCopyBlock),
          Trusted.MirSemantics.getElem?
            (buildWriteLeByteBlocks bufLoc (s3_scrBase ctx + 1) (s3_scrBase ctx + 5)
              (s3_scrBase ctx + 6) (s3_scrBase ctx + 7) (s3_scrBase ctx + 9)
              nextBb (i + 1) (curBb + 1) (rem' + 1)) k = some eb →
          Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks ((curBb + 1) + k) = some eb := by
        intro k eb hk
        have hStep1 := hBlocks (k + 1) eb (by exact hk)
        have hIdx : curBb + (k + 1) = (curBb + 1) + k := by
          rw [Nat.add_assoc, Nat.add_comm k 1, ← Nat.add_assoc]
        rw [hIdx] at hStep1
        exact hStep1
      have hRec := s3x_writeLe_loop_sim ctx off valNat hValLt hDeclBuf hAlloc0 hLive0 hMut0 hLenBound hSzBound
        rem' (i + 1) (curBb + 1) ⟨allocsNext⟩ aNext s2cM9 (Nat.succ_pos i) hSumNext haNextEq hUp0Next hFindNext
        hWrNext.2.2 hRelM9 hOffNext hAccNext hBlocksNext
      cases hRec with | intro allocsOut hOut =>
      cases hOut with | intro slots₂' hRest =>
      refine ⟨allocsOut, slots₂', hRest.1, ?_, hRest.2.2.1, hRest.2.2.2⟩
      have hStepsEq : 4 + 4 * (rem' + 1) = 4 * (rem' + 1 + 1) := by
        rw [Nat.add_comm 4 (4 * (rem' + 1)), Nat.mul_add 4 (rem' + 1) 1, Nat.mul_one]
      have hReachAll : ReachesNMemCopy ctx.pTgt (4 + 4 * (rem' + 1))
          { frames := [{ defId := ctx.plan.defId, blockIdx := curBb, stmtIdx := 0, locals := slots₂ }], mem := memCur }
          { frames := [{ defId := ctx.plan.defId, blockIdx := nextBb, stmtIdx := 0, locals := slots₂' }],
            mem := ⟨allocsOut⟩ } :=
        s3x_reachesN_trans hReach4 hRest.2.1
      rw [hStepsEq] at hReachAll
      exact hReachAll

private theorem s3x_writeLeUsize_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (p : LocalId) (valOp : Operand) (w : LeWidth) (requireAligned : Bool) (nextBb : BasicBlockId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTerm : bbSrc.terminator = .writeLeUsize p valOp w requireAligned nextBb)
    (hStmtLen : f₁.stmtIdx = bbSrc.statements.length)
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hCheckTerm := s3x_checkTermForPtrs_of_bb ctx hBbSrc
  rw [hTerm] at hCheckTerm
  have hTib := s3x_termTargetsInBounds_of_bb ctx hBbSrc
  rw [hTerm] at hTib
  have hBbNextEx := s3x_bb_of_lt ctx nextBb ((nat_blt_eq_lt _ _).mp hTib)
  cases hBbNextEx with | intro bbNext hBbNext =>
  unfold checkTermForPtrs at hCheckTerm
  have hAnd := (bool_and_eq_true _ _).mp hCheckTerm
  have hValOpTy := hAnd.1
  have hFindEx := hAnd.2
  cases hFind : findPtrEntry ctx.plan.entries p with
  | none => rw [hFind] at hFindEx; cases hFindEx
  | some pPair =>
    cases pPair with | mk kP optBufP =>
    cases s3_lowerBlock_getElem?_termPre ctx hBbSrc with | intro extraBase hEx =>
    cases hEx with | intro extraSelf hBlock =>
    have hTermPair := hBlock.1
    have hBbTgt := hBlock.2.2.1
    have hStmtsLen := hBlock.2.2.2.1
    have hWinPair := hBlock.2.2.2.2.1
    have hExtraWin := hBlock.2.2.2.2.2
    rw [hBbRel] at hBbTgt
    rw [hTerm] at hTermPair hBbTgt hStmtsLen hWinPair
    unfold lowerTermForPtrs at hTermPair hBbTgt hStmtsLen hWinPair
    dsimp at hTermPair hBbTgt hStmtsLen hWinPair
    rw [hFind] at hTermPair hBbTgt hStmtsLen hWinPair
    dsimp at hTermPair hBbTgt hStmtsLen hWinPair
    have hStartIdx : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length := by
      rw [hIdxEq, hStmtLen]
    let startIdx := s3_loweredStmtIdx ctx bbSrc.statements bbSrc.statements.length
    let f2Start : MemCopyFrame := { defId := ctx.plan.defId, blockIdx := f₂.blockIdx, stmtIdx := startIdx, locals := f₂.locals }
    have hF2Eq : f₂ = f2Start := by
      cases f₂; dsimp at hDef₂ hStartIdx; subst hDef₂ hStartIdx; rfl
    rw [hF2Eq]
    have hReq : (if requireAligned then w.naturalAlignLog2 else 0) ≤ 30 := by
      cases requireAligned with
      | false => exact Nat.zero_le 30
      | true => exact Nat.le_trans (s3x_leWidth_align_le3 w) (by decide)
    have hSrcEval : evalStepMemCopy ctx.pSrc 0 { frames := [f₁], mem := mem } =
        evalMemCopyTerm ctx.bodySrc bbSrc f₁ mem :=
      s3_step_state_of_term ctx.pSrc f₁ mem ctx.bodySrc bbSrc (by rw [hDef₁]; exact ctx.hBodies) hBbSrc hStmtLen
    have hSrcEq := s3x_memCopyTerm_writeLe_eval_eq ctx.bodySrc bbSrc f₁ mem p valOp w requireAligned nextBb hTerm
    rw [hSrcEq] at hSrcEval
    unfold evalMemCopyTerm at hSrcEval
    dsimp at hSrcEval
    have hWinAll := s3x_window_of_termWin hWinPair rfl
    have hS0 := hWinAll 0 (mkAssignUse (s3_scrBase ctx + 7) valOp) (by
      cases optBufP with
      | none => rfl
      | some bufLoc =>
        cases (s3x_findPtrEntry_bounds_and_spec ctx p kP (some bufLoc) hFind).2 bufLoc rfl with
        | intro sz hSz => cases hSz with | intro al hAl => cases hAl with | intro bufMut hDeclBufSpec =>
        dsimp; rw [hDeclBufSpec.1]; dsimp
        cases hCond : !(Mutability.beq bufMut .mut) || !Nat.ble w.byteCount sz with
        | true => rfl
        | false => cases hW1 : Nat.beq w.byteCount 1 <;> rfl)
    rw [Nat.add_zero] at hS0
    have hAssignVal := s3_evalUsizeOp_assign_scr ctx f2Start f₁.locals mem 7 valOp (by decide) hWf hRel hValOpTy
    cases hEvVal : evalUsizeOp ctx.bodySrc.locals f₁.locals valOp with
    | error kErr =>
      rw [hEvVal] at hSrcEval hAssignVal
      dsimp at hSrcEval hAssignVal
      have hStep0 : evalStepMemCopy ctx.pTgt 0 { frames := [f2Start], mem := mem } = .fault kErr :=
        s3_reachesN_stmt_fault ctx hBbTgt hS0 hAssignVal
      exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem kErr hSrcEval ⟨0, _, .zero _, hStep0⟩
    | ok vp =>
      rw [hEvVal] at hSrcEval hAssignVal
      dsimp at hAssignVal
      cases vp with | mk valNat slots₁ =>
      dsimp at hSrcEval hAssignVal
      cases hAssignVal with | intro hValLt hAs =>
      cases hAs with | intro s2a hS2a =>
      have hStep0 : evalStepMemCopy ctx.pTgt 0 { frames := [f2Start], mem := mem } =
          .step { frames := [{ f2Start with stmtIdx := startIdx + 1, locals := s2a }], mem := mem } :=
        s3_reachesN_stmt_step ctx hBbTgt hS0 hS2a.1
      have hReach0 : ReachesNMemCopy ctx.pTgt 1 { frames := [f2Start], mem := mem }
          { frames := [{ defId := ctx.plan.defId, blockIdx := f₂.blockIdx, stmtIdx := startIdx + 1, locals := s2a }], mem := mem } := by
        have hEq : { f2Start with stmtIdx := startIdx + 1, locals := s2a } =
            { defId := ctx.plan.defId, blockIdx := f₂.blockIdx, stmtIdx := startIdx + 1, locals := s2a } := by
          cases f₂; dsimp at hDef₂; subst hDef₂; rfl
        rw [← hEq]
        exact s3_reachesN_one hStep0
      cases optBufP with
      | none =>
        dsimp at hTermPair hBbTgt hStmtsLen hWinPair
        have hWinRest := s3x_window_append_right (a := [mkAssignUse (s3_scrBase ctx + 7) valOp]) hWinAll
        have hTagRead := s3x_ptrTagRead_sim ctx (startIdx := startIdx + 1) (mem := mem)
          p kP none (if requireAligned then w.naturalAlignLog2 else 0) hFind hReq
          hS2a.2.2.1 hS2a.2.2.2 hBbTgt hWinRest
        cases hRp : readPtrLocal ctx.bodySrc.locals slots₁ p false with
        | error err =>
          rw [hRp] at hSrcEval hTagRead
          dsimp at hTagRead
          cases hTagRead with | intro nR hnR =>
          cases hnR with | intro sFault hsFault =>
          exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval
            ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
        | ok rp =>
          rw [hRp] at hSrcEval hTagRead
          dsimp at hTagRead
          cases rp with | mk pv slots₁' =>
          dsimp at hSrcEval hTagRead
          rw [hTagRead.1] at hSrcEval
          cases hAl : checkPtrAlignMem mem pv (if requireAligned then w.naturalAlignLog2 else 0) with
          | error err =>
            rw [hAl] at hTagRead
            dsimp at hTagRead
            have hWmErr : writeMemSlice mem pv (encodeLeUsize w valNat) (if requireAligned then w.naturalAlignLog2 else 0) = .error err := by
              unfold writeMemSlice; rw [hAl]
            rw [hWmErr] at hSrcEval
            cases hTagRead.2 with | intro nR hnR =>
            cases hnR with | intro sFault hsFault =>
            exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval
              ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
          | ok u =>
            cases u
            rw [hAl] at hTagRead
            dsimp at hTagRead
            have hPvNone : pv.allocId = none :=
              s3x_pv_allocId_none_of_findNone ctx p kP hFind hS2a.2.2.2 hRp
            have hWmErr : writeMemSlice mem pv (encodeLeUsize w valNat) (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
              unfold writeMemSlice; rw [hAl, hPvNone]
            rw [hWmErr] at hSrcEval
            cases hTagRead.2 with | intro nR hnR =>
            cases hnR with | intro sFault hsFault =>
            exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
              ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
      | some bufLoc =>
        have hBufSpec := (s3x_findPtrEntry_bounds_and_spec ctx p kP (some bufLoc) hFind).2 bufLoc rfl
        cases hBufSpec with | intro sz hSz =>
        cases hSz with | intro al hAlSpec =>
        cases hAlSpec with | intro bufMut hDeclBufSpec =>
        have hDeclBuf := hDeclBufSpec.1
        dsimp at hTermPair hBbTgt hStmtsLen hWinPair
        rw [hDeclBuf] at hTermPair hBbTgt hStmtsLen hWinPair
        dsimp at hTermPair hBbTgt hStmtsLen hWinPair
        cases hCond : !(Mutability.beq bufMut .mut) || !Nat.ble w.byteCount sz with
        | true =>
          rw [hCond] at hTermPair hBbTgt hStmtsLen hWinPair
          dsimp at hTermPair hBbTgt hStmtsLen hWinPair
          have hWinAllT := hWinAll
          dsimp at hWinAllT
          rw [hDeclBuf] at hWinAllT
          dsimp at hWinAllT
          rw [hCond] at hWinAllT
          dsimp at hWinAllT
          have hWinRest := s3x_window_append_right (a := [mkAssignUse (s3_scrBase ctx + 7) valOp]) hWinAllT
          have hSplitWin := s3x_window_cons3_split hWinRest
          have hWinTag := hSplitWin.1
          have hTagRead' := s3x_ptrTagRead_sim ctx (startIdx := startIdx + 1) (mem := mem)
            p kP (some bufLoc) (if requireAligned then w.naturalAlignLog2 else 0) hFind hReq
            hS2a.2.2.1 hS2a.2.2.2 hBbTgt hWinTag
          cases hRp : readPtrLocal ctx.bodySrc.locals slots₁ p false with
          | error err =>
            rw [hRp] at hSrcEval hTagRead'
            dsimp at hTagRead'
            cases hTagRead' with | intro nR hnR =>
            cases hnR with | intro sFault hsFault =>
            exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval
              ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
          | ok rp =>
            rw [hRp] at hSrcEval hTagRead'
            dsimp at hTagRead'
            cases rp with | mk pv slots₁' =>
            dsimp at hSrcEval hTagRead'
            rw [hTagRead'.1] at hSrcEval
            cases hAl : checkPtrAlignMem mem pv (if requireAligned then w.naturalAlignLog2 else 0) with
            | error err =>
              rw [hAl] at hTagRead'
              dsimp at hTagRead'
              have hWmErr : writeMemSlice mem pv (encodeLeUsize w valNat) (if requireAligned then w.naturalAlignLog2 else 0) = .error err := by
                unfold writeMemSlice; rw [hAl]
              rw [hWmErr] at hSrcEval
              cases hTagRead'.2 with | intro nR hnR =>
              cases hnR with | intro sFault hsFault =>
              exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval
                ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
            | ok u =>
              cases u
              rw [hAl] at hTagRead'
              dsimp at hTagRead'
              cases hPvId : pv.allocId with
              | none =>
                rw [hPvId] at hTagRead'
                dsimp at hTagRead'
                have hWmErr : writeMemSlice mem pv (encodeLeUsize w valNat) (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                  unfold writeMemSlice; rw [hAl, hPvId]
                rw [hWmErr] at hSrcEval
                cases hTagRead'.2 with | intro nR hnR =>
                cases hnR with | intro sFault hsFault =>
                exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
                  ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
              | some aid =>
                rw [hPvId] at hTagRead'
                dsimp at hTagRead'
                have hAidEq := hTagRead'.2.1
                subst hAidEq
                cases hTagRead'.2.2 with | intro s2b hS2b =>
                have hTailWin := hSplitWin.2
                have hLenPre : ([
                  mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kP),
                  mkAssignUse (s3_scrBase ctx) (.copy { localId := ctx.bodySrc.locals.length + 3 * kP + 1, projection := [] }),
                  mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := ctx.bodySrc.locals.length + 3 * kP + 2, projection := [] })
                ] ++ mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc) (s3_scrBase ctx) (s3_scrBase ctx + 1)
                       (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) (if requireAligned then w.naturalAlignLog2 else 0) ++ [
                  mkSubUncheckedUsize (s3_scrBase ctx + 5)
                    (.copy { localId := s3_scrBase ctx, projection := [] }) (usizeConst 1)
                ]).length = 3 + (mkPtrAlignCheckStmts ctx.bodySrc.locals (some bufLoc) (s3_scrBase ctx) (s3_scrBase ctx + 1)
                       (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) (if requireAligned then w.naturalAlignLog2 else 0)).length + 1 := by
                  rw [List.length_append, List.length_append]; rfl
                unfold s3_scrBase at hLenPre
                rw [hLenPre] at hTailWin
                have hBufStmt := hTailWin 0 (MemCopyStmt.bufLivenessCheck bufLoc) rfl
                dsimp at hBufStmt; rw [Nat.add_zero] at hBufStmt
                have hUbStmt := hTailWin 1 (mkImmediateUbStmt (s3_scrBase ctx + 5)) rfl
                dsimp at hUbStmt
                have hLiveRes := s3x_exec_bufLivenessCheck ctx (mem := mem) bufLoc sz al bufMut
                  hDeclBuf hS2a.2.2.1 hS2b.2.1 hBbTgt hBufStmt
                cases hLiveRes with | intro live hLiveEx =>
                cases hLiveEx with | intro a ha =>
                have hWmErr : writeMemSlice mem pv (encodeLeUsize w valNat) (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                  unfold writeMemSlice
                  rw [hAl, hPvId]
                  dsimp
                  rw [ha.1]
                  dsimp
                  cases live with
                  | false => rw [ha.2.1]; rfl
                  | true =>
                    rw [ha.2.1, ha.2.2.2.1, ha.2.2.2.2.1 rfl, s3_encodeLeUsize_length]
                    cases (bool_or_eq_true _ _).mp hCond with
                    | inl hNotMut => rw [hNotMut]; rfl
                    | inr hNotBle =>
                      have hSzLt : sz < w.byteCount := nat_ble_false_gt ((bool_not_eq_true _).mp hNotBle)
                      have hNotLe : Nat.ble (pv.offsetBytes.toNat + w.byteCount) sz = false := by
                        cases hB : Nat.ble (pv.offsetBytes.toNat + w.byteCount) sz with
                        | false => rfl
                        | true =>
                          have hLe' := Nat.le_trans (Nat.le_add_left _ _) ((nat_ble_eq_le _ _).mp hB)
                          exact False.elim (Nat.not_lt_of_le hLe' hSzLt)
                      rw [hNotLe]
                      cases Mutability.beq bufMut .mut <;> rfl
                rw [hWmErr] at hSrcEval
                have hReachPre := s3x_reachesN_trans hReach0 hS2b.1
                cases live with
                | false =>
                  exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
                    ⟨_, _, hReachPre, ha.2.2.2.2.2.2 rfl⟩
                | true =>
                  have hStepLive := ha.2.2.2.2.2.1 rfl
                  have hUbStep := s3x_exec_immediateUb ctx (mem := mem) (slots₂ := s2b) 5 (by decide) hBbTgt hUbStmt
                  exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
                    ⟨_, _, s3x_reachesN_trans hReachPre (s3_reachesN_one hStepLive), hUbStep⟩
        | false =>
          rw [hCond] at hTermPair hBbTgt hStmtsLen hWinPair
          dsimp at hTermPair hBbTgt hStmtsLen hWinPair
          have hNotMutFalse : (!(Mutability.beq bufMut .mut)) = false := by
            cases hM : Mutability.beq bufMut .mut with
            | true => rfl
            | false => rw [hM] at hCond; cases hCond
          have hMutEq : bufMut = .mut := s3x_mutability_beq_mut bufMut ((bool_not_eq_false _).mp hNotMutFalse)
          have hNotBleFalse : (!Nat.ble w.byteCount sz) = false := by
            rw [hNotMutFalse] at hCond; exact hCond
          have hWLeSz : w.byteCount ≤ sz := (nat_ble_eq_le _ _).mp ((bool_not_eq_false _).mp hNotBleFalse)
          have hWinAllF := hWinAll
          dsimp at hWinAllF
          rw [hDeclBuf] at hWinAllF
          dsimp at hWinAllF
          rw [hCond] at hWinAllF
          dsimp at hWinAllF
          have hWinSame := s3x_window_if_fst_same _ _ _ _ _ _ hWinAllF
          have hWinRest := s3x_window_append_right (a := [mkAssignUse (s3_scrBase ctx + 7) valOp]) hWinSame
          have hSplitWin := s3x_window_cons3_split hWinRest
          have hWinTag := hSplitWin.1
          have hTailWin := hSplitWin.2
          have hTagRead' := s3x_ptrTagRead_sim ctx (startIdx := startIdx + 1) (mem := mem)
            p kP (some bufLoc) (if requireAligned then w.naturalAlignLog2 else 0) hFind hReq
            hS2a.2.2.1 hS2a.2.2.2 hBbTgt hWinTag
          cases hRp : readPtrLocal ctx.bodySrc.locals slots₁ p false with
          | error err =>
            rw [hRp] at hSrcEval hTagRead'
            dsimp at hTagRead'
            cases hTagRead' with | intro nR hnR =>
            cases hnR with | intro sFault hsFault =>
            exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval
              ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
          | ok rp =>
            rw [hRp] at hSrcEval hTagRead'
            dsimp at hTagRead'
            cases rp with | mk pv slots₁' =>
            dsimp at hSrcEval hTagRead'
            rw [hTagRead'.1] at hSrcEval
            cases hAl : checkPtrAlignMem mem pv (if requireAligned then w.naturalAlignLog2 else 0) with
            | error err =>
              rw [hAl] at hTagRead'
              dsimp at hTagRead'
              have hWmErr : writeMemSlice mem pv (encodeLeUsize w valNat) (if requireAligned then w.naturalAlignLog2 else 0) = .error err := by
                unfold writeMemSlice; rw [hAl]
              rw [hWmErr] at hSrcEval
              cases hTagRead'.2 with | intro nR hnR =>
              cases hnR with | intro sFault hsFault =>
              exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem err hSrcEval
                ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
            | ok u =>
              cases u
              rw [hAl] at hTagRead'
              dsimp at hTagRead'
              cases hPvId : pv.allocId with
              | none =>
                rw [hPvId] at hTagRead'
                dsimp at hTagRead'
                have hWmErr : writeMemSlice mem pv (encodeLeUsize w valNat) (if requireAligned then w.naturalAlignLog2 else 0) = .error .undefined := by
                  unfold writeMemSlice; rw [hAl, hPvId]
                rw [hWmErr] at hSrcEval
                cases hTagRead'.2 with | intro nR hnR =>
                cases hnR with | intro sFault hsFault =>
                exact s3x_fwdStepSim_of_fault ctx f₁ f2Start mem .undefined hSrcEval
                  ⟨1 + nR, sFault, s3x_reachesN_trans hReach0 hsFault.1, hsFault.2⟩
              | some aid =>
                rw [hPvId] at hTagRead'
                dsimp at hTagRead'
