      cases hBle : Nat.ble start loc with
      | false =>
        have hNot : ¬ start ≤ loc := fun h => by rw [(nat_ble_eq_le _ _).mpr h] at hBle; cases hBle
        have hBle2 : Nat.ble (start + 1) loc = false := by
          cases hB : Nat.ble (start + 1) loc with
          | false => rfl
          | true => exact False.elim (hNot (Nat.le_trans (Nat.le_succ start) ((nat_ble_eq_le _ _).mp hB)))
        rw [hBle2]; rfl
      | true =>
        have hLt : start < loc := Nat.lt_of_le_of_ne ((nat_ble_eq_le _ _).mp hBle) hEq
        rw [(nat_ble_eq_le _ _).mpr hLt]; rfl

private theorem s4_lowerStmtForBuf_any_storageMarker (bufLocal base size loc : Nat)
    (stmt : MemCopyStmt)
    (hBound : match stmt with
      | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => id < base
      | _ => True) :
    (lowerStmtForBuf bufLocal base size stmt).any (memCopyStmtHasStorageMarker loc) =
      if Nat.ble base loc && Nat.blt loc (base + (1 + 2 * size)) then
        memCopyStmtHasStorageMarker bufLocal stmt
      else if Nat.beq loc bufLocal then
        false
      else
        memCopyStmtHasStorageMarker loc stmt := by
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop | unsupported | assign _ _ =>
      cases Nat.ble base loc && Nat.blt loc (base + (1 + 2 * size)) <;>
        cases Nat.beq loc bufLocal <;> rfl
    | storageLive id =>
      dsimp [lowerStmtForBuf]
      have hIdLt : id < base := hBound
      cases s4_nat_eq_or_ne id bufLocal with
      | inl hId =>
        rw [s4_nat_beq_true hId]
        dsimp
        rw [s4_list_any_append, s4_any_mkStorageLiveRange loc base (1 + 2 * size),
          s4_noStorageMarker_mkZeroUsizeRange loc (base + 1) (2 * size)]
        have hOrF : ∀ b : Bool, (b || false) = b := fun b => by cases b <;> rfl
        rw [hOrF]
        have hM : memCopyStmtHasStorageMarker bufLocal (.baseStmt (.storageLive id)) = true :=
          s4_nat_beq_true hId
        rw [hM]
        cases hIn : Nat.ble base loc && Nat.blt loc (base + (1 + 2 * size)) with
        | true => rfl
        | false =>
          dsimp
          cases hEqLoc : Nat.beq loc bufLocal with
          | true => rfl
          | false =>
            have hId2 : Nat.beq id loc = false := by
              cases hB : Nat.beq id loc with
              | false => rfl
              | true =>
                have hEq1 := nat_beq_eq _ _ hB
                rw [hId] at hEq1
                rw [s4_nat_beq_true hEq1.symm] at hEqLoc
                cases hEqLoc
            exact hId2.symm
      | inr hId =>
        rw [s4_nat_beq_false hId]
        dsimp
        have hM1 : memCopyStmtHasStorageMarker bufLocal (.baseStmt (.storageLive id)) = false :=
          s4_nat_beq_false hId
        rw [hM1]
        change (Nat.beq id loc || false) = _
        have hOrF : (Nat.beq id loc || false) = Nat.beq id loc := by cases Nat.beq id loc <;> rfl
        rw [hOrF]
        cases hIn : Nat.ble base loc && Nat.blt loc (base + (1 + 2 * size)) with
        | true =>
          have hAnd := (bool_and_eq_true _ _).mp hIn
          have hGe : base ≤ loc := (nat_ble_eq_le _ _).mp hAnd.1
          exact s4_nat_beq_false (fun hEq =>
            s4_nat_lt_irrefl loc (Nat.lt_of_lt_of_le (by rw [← hEq]; exact hIdLt) hGe))
        | false =>
          dsimp
          cases hEqLoc : Nat.beq loc bufLocal with
          | true =>
            have hLocEq := nat_beq_eq _ _ hEqLoc
            exact s4_nat_beq_false (fun hEq => hId (hEq.trans hLocEq))
          | false => rfl
    | storageDead id =>
      dsimp [lowerStmtForBuf]
      have hIdLt : id < base := hBound
      cases s4_nat_eq_or_ne id bufLocal with
      | inl hId =>
        rw [s4_nat_beq_true hId]
        dsimp
        rw [s4_any_mkStorageDeadRange loc base (1 + 2 * size)]
        have hM : memCopyStmtHasStorageMarker bufLocal (.baseStmt (.storageDead id)) = true :=
          s4_nat_beq_true hId
        rw [hM]
        cases hIn : Nat.ble base loc && Nat.blt loc (base + (1 + 2 * size)) with
        | true => rfl
        | false =>
          dsimp
          cases hEqLoc : Nat.beq loc bufLocal with
          | true => rfl
          | false =>
            have hId2 : Nat.beq id loc = false := by
              cases hB : Nat.beq id loc with
              | false => rfl
              | true =>
                have hEq1 := nat_beq_eq _ _ hB
                rw [hId] at hEq1
                rw [s4_nat_beq_true hEq1.symm] at hEqLoc
                cases hEqLoc
            exact hId2.symm
      | inr hId =>
        rw [s4_nat_beq_false hId]
        dsimp
        have hM1 : memCopyStmtHasStorageMarker bufLocal (.baseStmt (.storageDead id)) = false :=
          s4_nat_beq_false hId
        rw [hM1]
        change (Nat.beq id loc || false) = _
        have hOrF : (Nat.beq id loc || false) = Nat.beq id loc := by cases Nat.beq id loc <;> rfl
        rw [hOrF]
        cases hIn : Nat.ble base loc && Nat.blt loc (base + (1 + 2 * size)) with
        | true =>
          have hAnd := (bool_and_eq_true _ _).mp hIn
          have hGe : base ≤ loc := (nat_ble_eq_le _ _).mp hAnd.1
          exact s4_nat_beq_false (fun hEq =>
            s4_nat_lt_irrefl loc (Nat.lt_of_lt_of_le (by rw [← hEq]; exact hIdLt) hGe))
        | false =>
          dsimp
          cases hEqLoc : Nat.beq loc bufLocal with
          | true =>
            have hLocEq := nat_beq_eq _ _ hEqLoc
            exact s4_nat_beq_false (fun hEq => hId (hEq.trans hLocEq))
          | false => rfl
  | bufLivenessCheck b =>
    dsimp [lowerStmtForBuf]
    cases Nat.beq b bufLocal <;>
      (dsimp; cases Nat.ble base loc && Nat.blt loc (base + (1 + 2 * size)) <;>
        cases Nat.beq loc bufLocal <;> rfl)
  | mkNullPtr _ | mkDanglingPtr _ _ | addrOfByteBuf _ _ | copyPtr _ _ _ | ptrWrappingOffset _ _ _ _ =>
    cases Nat.ble base loc && Nat.blt loc (base + (1 + 2 * size)) <;>
      cases Nat.beq loc bufLocal <;> rfl

private theorem s4_buildReadBufArms_noStorageMarker (loc tagDst valDst tagBase valBase nextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildReadBufArms tagDst valDst tagBase valBase nextBb idx armBb rem).2.any
        (fun b => b.statements.any (memCopyStmtHasStorageMarker loc)) = false
  | 0, _, _ => rfl
  | rem + 1, idx, armBb => by
    change (false ||
      (buildReadBufArms tagDst valDst tagBase valBase nextBb (idx + 1) (armBb + 1) rem).2.any
        (fun b => b.statements.any (memCopyStmtHasStorageMarker loc))) = false
    exact s4_buildReadBufArms_noStorageMarker loc tagDst valDst tagBase valBase nextBb rem (idx + 1) (armBb + 1)

private theorem s4_buildWriteBufArms_noStorageMarker (loc tagScr valScr tagBase valBase nextBb : Nat) :
    ∀ (rem idx armBb : Nat),
      (buildWriteBufArms tagScr valScr tagBase valBase nextBb idx armBb rem).2.any
        (fun b => b.statements.any (memCopyStmtHasStorageMarker loc)) = false
  | 0, _, _ => rfl
  | rem + 1, idx, armBb => by
    change (false ||
      (buildWriteBufArms tagScr valScr tagBase valBase nextBb (idx + 1) (armBb + 1) rem).2.any
        (fun b => b.statements.any (memCopyStmtHasStorageMarker loc))) = false
    exact s4_buildWriteBufArms_noStorageMarker loc tagScr valScr tagBase valBase nextBb rem (idx + 1) (armBb + 1)

private theorem s4_lowerTermForBuf_noStorageMarker (bufLocal base size : Nat)
    (mutability : Mutability) (nextExtra loc : Nat) (term : MemCopyTerm) :
    (lowerTermForBuf bufLocal base size mutability nextExtra term).1.any
        (memCopyStmtHasStorageMarker loc) = false ∧
    (lowerTermForBuf bufLocal base size mutability nextExtra term).2.2.any
        (fun b => b.statements.any (memCopyStmtHasStorageMarker loc)) = false := by
  cases term with
  | baseTerm _ | ptrOffsetInbounds _ _ _ _ _ | checkPtrPairAlign _ _ _ _ _ _
  | readLeUsize _ _ _ _ _ | writeLeUsize _ _ _ _ _ | readPtrLe8 _ _ _ _ | writePtrLe8 _ _ _ _
  | copyNonOverlapping _ _ _ _ _ _ _ =>
    exact ⟨rfl, rfl⟩
  | readBufRawByte tagDst valDst b offOp nextBb =>
    dsimp [lowerTermForBuf]
    cases Nat.beq b bufLocal with
    | false => exact ⟨rfl, rfl⟩
    | true =>
      dsimp
      constructor
      · rfl
      · rw [s4_list_any_append,
          s4_buildReadBufArms_noStorageMarker loc tagDst valDst (base + 1) (base + 1 + size)
            (nextBb + 1) size 0 _]
        rfl
  | writeBufRawByte b offOp tagOp valOp nextBb =>
    dsimp [lowerTermForBuf]
    cases Nat.beq b bufLocal with
    | false => exact ⟨rfl, rfl⟩
    | true =>
      dsimp
      cases !(Mutability.beq mutability .mut) with
      | true => exact ⟨rfl, rfl⟩
      | false =>
        dsimp
        constructor
        · rfl
        · rw [s4_list_any_append,
            s4_buildWriteBufArms_noStorageMarker loc (base + 1 + 2 * size + 2)
              (base + 1 + 2 * size + 3) (base + 1) (base + 1 + size) (nextBb + 1) size 0 (nextExtra + 2)]
          rfl

private theorem s4_lowerBlocksForBufLoop_extras_noStorageMarker (bufLocal base size : Nat)
    (mutability : Mutability) (loc : Nat) :
    ∀ (nextExtra : Nat) (bbs : List MemCopyBlock),
      (lowerBlocksForBufLoop bufLocal base size mutability nextExtra bbs).2.any
        (fun b => b.statements.any (memCopyStmtHasStorageMarker loc)) = false
  | _, [] => rfl
  | nextExtra, bb :: rest => by
    dsimp [lowerBlocksForBufLoop]
    rw [s4_list_any_append,
      (s4_lowerTermForBuf_noStorageMarker bufLocal base size mutability nextExtra loc bb.terminator).2,
      s4_lowerBlocksForBufLoop_extras_noStorageMarker bufLocal base size mutability loc _ rest]
    rfl

private theorem s4_memCopyHasStorageAnnotation_bodyTgt_iff {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) (loc : Nat) :
    memCopyHasStorageAnnotation pack.bodyTgt loc =
      if Nat.ble pack.bodySrc.locals.length loc &&
          Nat.blt loc (pack.bodySrc.locals.length + (1 + 2 * pack.size)) then
        memCopyHasStorageAnnotation pack.bodySrc plan.bufLocal
      else if Nat.beq loc plan.bufLocal then
        false
      else
        memCopyHasStorageAnnotation pack.bodySrc loc := by
  unfold memCopyHasStorageAnnotation
  have hBbs := congrArg MemCopyBody.basicBlocks pack.hBodyTgt
  rw [hBbs]
  dsimp
  let base := pack.bodySrc.locals.length
  have hProl : (if memCopyHasStorageAnnotation pack.bodySrc plan.bufLocal = true then []
      else mkZeroUsizeRange (base + 1) (2 * pack.size)).any (memCopyStmtHasStorageMarker loc) = false := by
    cases memCopyHasStorageAnnotation pack.bodySrc plan.bufLocal with
    | true => rfl
    | false => exact s4_noStorageMarker_mkZeroUsizeRange loc (base + 1) (2 * pack.size)
  have hTailF : ∀ b : Bool, (b || false) = b := fun b => by cases b <;> rfl
  have hFHead : ∀ b : Bool, (false || b) = b := fun b => by cases b <;> rfl
  change ((if memCopyHasStorageAnnotation pack.bodySrc plan.bufLocal = true then []
      else mkZeroUsizeRange (base + 1) (2 * pack.size)).any (memCopyStmtHasStorageMarker loc) ||
      ((lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability
          (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).1 ++
       (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability
          (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2).any
        (fun bb => bb.statements.any (memCopyStmtHasStorageMarker loc))) = _
  rw [hProl, hFHead, s4_list_any_append,
    s4_lowerBlocksForBufLoop_extras_noStorageMarker plan.bufLocal base pack.size pack.mutability
      loc (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks,
    hTailF]
  have hLoop : ∀ (nextExtra : Nat) (bbs : List MemCopyBlock),
      bbs.all (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id base
        | _ => true)) = true →
      (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability nextExtra bbs).1.any
          (fun bb => bb.statements.any (memCopyStmtHasStorageMarker loc)) =
        if Nat.ble base loc && Nat.blt loc (base + (1 + 2 * pack.size)) then
          bbs.any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker plan.bufLocal))
        else if Nat.beq loc plan.bufLocal then
          false
        else
          bbs.any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker loc)) := by
    intro nextExtra bbs hBbs
    induction bbs generalizing nextExtra with
    | nil =>
      dsimp [lowerBlocksForBufLoop]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + 2 * pack.size)) <;>
        cases Nat.beq loc plan.bufLocal <;> rfl
    | cons b tl ih =>
      have hBbsAnd := (bool_and_eq_true _ _).mp hBbs
      dsimp only [lowerBlocksForBufLoop]
      change (((listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) b.statements ++
          (lowerTermForBuf plan.bufLocal base pack.size pack.mutability nextExtra b.terminator).1).any
          (memCopyStmtHasStorageMarker loc)) ||
        (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability
          (nextExtra + (lowerTermForBuf plan.bufLocal base pack.size pack.mutability nextExtra b.terminator).2.2.length)
          tl).1.any (fun bb => bb.statements.any (memCopyStmtHasStorageMarker loc))) = _
      rw [s4_list_any_append,
        (s4_lowerTermForBuf_noStorageMarker plan.bufLocal base pack.size pack.mutability nextExtra loc b.terminator).1,
        hTailF]
      have hStmts : ∀ (stmts : List MemCopyStmt),
          stmts.all (fun stmt =>
            match stmt with
            | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id base
            | _ => true) = true →
          (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) stmts).any
              (memCopyStmtHasStorageMarker loc) =
            if Nat.ble base loc && Nat.blt loc (base + (1 + 2 * pack.size)) then
              stmts.any (memCopyStmtHasStorageMarker plan.bufLocal)
            else if Nat.beq loc plan.bufLocal then
              false
            else
              stmts.any (memCopyStmtHasStorageMarker loc) := by
        intro stmts hS
        induction stmts with
        | nil =>
          cases Nat.ble base loc && Nat.blt loc (base + (1 + 2 * pack.size)) <;>
            cases Nat.beq loc plan.bufLocal <;> rfl
        | cons st sTl ihSt =>
          have hSAnd := (bool_and_eq_true _ _).mp hS
          rw [s4_listFlatMap_cons, s4_list_any_append, s4_lowerStmtForBuf_any_storageMarker,
            ihSt hSAnd.2]
          · cases Nat.ble base loc && Nat.blt loc (base + (1 + 2 * pack.size)) with
            | true => rfl
            | false => cases Nat.beq loc plan.bufLocal <;> rfl
          · cases st with
            | baseStmt bs =>
              cases bs with
              | storageLive id => exact (nat_blt_eq_lt _ _).mp hSAnd.1
              | storageDead id => exact (nat_blt_eq_lt _ _).mp hSAnd.1
              | nop | unsupported | assign _ _ => exact True.intro
            | _ => exact True.intro
      rw [hStmts b.statements hBbsAnd.1, ih _ hBbsAnd.2]
      cases Nat.ble base loc && Nat.blt loc (base + (1 + 2 * pack.size)) with
      | true => rfl
      | false => cases Nat.beq loc plan.bufLocal <;> rfl
  exact hLoop (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks pack.hStorage

private theorem s4_memCopyHasStorageAnnotation_bodyTgt_prefix {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {i : Nat} (hLt : i < pack.bodySrc.locals.length) (hNe : i ≠ plan.bufLocal) :
    memCopyHasStorageAnnotation pack.bodyTgt i =
      memCopyHasStorageAnnotation pack.bodySrc i := by
  rw [s4_memCopyHasStorageAnnotation_bodyTgt_iff pack i]
  have hOut : (Nat.ble pack.bodySrc.locals.length i &&
      Nat.blt i (pack.bodySrc.locals.length + (1 + 2 * pack.size))) = false := by
    cases hBle : Nat.ble pack.bodySrc.locals.length i with
    | false => rfl
    | true =>
      exact False.elim (s4_nat_lt_irrefl i (Nat.lt_of_lt_of_le hLt ((nat_ble_eq_le _ _).mp hBle)))
  rw [hOut, s4_nat_beq_false hNe]
  rfl

private theorem s4_memCopyHasStorageAnnotation_bodyTgt_liveArea {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    {k : Nat} (hk : k < 1 + 2 * pack.size) :
    memCopyHasStorageAnnotation pack.bodyTgt (pack.bodySrc.locals.length + k) =
      memCopyHasStorageAnnotation pack.bodySrc plan.bufLocal := by
  rw [s4_memCopyHasStorageAnnotation_bodyTgt_iff pack (pack.bodySrc.locals.length + k)]
  have hIn : (Nat.ble pack.bodySrc.locals.length (pack.bodySrc.locals.length + k) &&
      Nat.blt (pack.bodySrc.locals.length + k)
        (pack.bodySrc.locals.length + (1 + 2 * pack.size))) = true := by
    rw [(nat_ble_eq_le _ _).mpr (Nat.le_add_right _ _),
      (nat_blt_eq_lt _ _).mpr (Nat.add_lt_add_left hk _)]
    rfl
  rw [hIn]
  rfl

private theorem s4_memCopyHasStorageAnnotation_bodyTgt_scr {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (r : Nat) :
    memCopyHasStorageAnnotation pack.bodyTgt
      (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) = false := by
  rw [s4_memCopyHasStorageAnnotation_bodyTgt_iff]
  have hGe : pack.bodySrc.locals.length + (1 + 2 * pack.size) ≤
      pack.bodySrc.locals.length + 1 + 2 * pack.size + r := by
    rw [Nat.add_assoc pack.bodySrc.locals.length 1 (2 * pack.size)]
    exact Nat.le_add_right _ _
  have hOut1 : Nat.blt (pack.bodySrc.locals.length + 1 + 2 * pack.size + r)
      (pack.bodySrc.locals.length + (1 + 2 * pack.size)) = false := by
    cases hB : Nat.blt (pack.bodySrc.locals.length + 1 + 2 * pack.size + r)
        (pack.bodySrc.locals.length + (1 + 2 * pack.size)) with
    | false => rfl
    | true =>
      exact False.elim (s4_nat_lt_irrefl _ (Nat.lt_of_lt_of_le ((nat_blt_eq_lt _ _).mp hB) hGe))
  have hAndF : (Nat.ble pack.bodySrc.locals.length
        (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) &&
      Nat.blt (pack.bodySrc.locals.length + 1 + 2 * pack.size + r)
        (pack.bodySrc.locals.length + (1 + 2 * pack.size))) = false := by
    rw [hOut1]
    cases Nat.ble pack.bodySrc.locals.length (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) <;> rfl
  have hGtBase : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 1 + 2 * pack.size + r :=
    Nat.le_trans (Nat.le_add_right _ (1 + 2 * pack.size)) hGe
  have hNe : pack.bodySrc.locals.length + 1 + 2 * pack.size + r ≠ plan.bufLocal := fun hEq => by
    have hLt : plan.bufLocal < pack.bodySrc.locals.length + 1 + 2 * pack.size + r :=
      Nat.lt_of_lt_of_le pack.hBufLtLoc hGtBase
    rw [hEq] at hLt
    exact s4_nat_lt_irrefl _ hLt
  have hSrcFalse : memCopyHasStorageAnnotation pack.bodySrc
      (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) = false := by
    unfold memCopyHasStorageAnnotation
    cases hAny : pack.bodySrc.basicBlocks.any (fun bb =>
        bb.statements.any (memCopyStmtHasStorageMarker
          (pack.bodySrc.locals.length + 1 + 2 * pack.size + r))) with
    | false => rfl
    | true =>
      cases (list_any_eq_true _ _).mp hAny with | intro bb hBb =>
      cases (list_any_eq_true _ _).mp hBb.2 with | intro st hSt =>
      have hAll := (list_all_eq_true _ _).mp pack.hStorage bb hBb.1
      have hS := (list_all_eq_true _ _).mp hAll st hSt.1
      cases hK : st with
      | baseStmt bs =>
        rw [hK] at hS hSt
        cases hBs : bs with
        | storageLive id | storageDead id =>
          rw [hBs] at hS hSt
          have hIdLt : id < pack.bodySrc.locals.length := (nat_blt_eq_lt _ _).mp hS
          have hEq : id = pack.bodySrc.locals.length + 1 + 2 * pack.size + r :=
            nat_beq_eq _ _ hSt.2
          exact False.elim (s4_nat_lt_irrefl id (Nat.lt_of_lt_of_le hIdLt (by rw [hEq]; exact hGtBase)))
        | nop | unsupported | assign _ _ =>
          rw [hBs] at hSt; cases hSt.2
      | bufLivenessCheck _ | mkNullPtr _ | mkDanglingPtr _ _ | addrOfByteBuf _ _
      | copyPtr _ _ _ | ptrWrappingOffset _ _ _ _ =>
        rw [hK] at hSt; cases hSt.2
  rw [hAndF, s4_nat_beq_false hNe]
  exact hSrcFalse

private theorem s4_memCopyStorageAnnotationsInBounds_bodyTgt {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    memCopyStorageAnnotationsInBounds pack.bodyTgt = true := by
  unfold memCopyStorageAnnotationsInBounds
  rw [s4_bodyTgt_locals_length pack]
  let n := pack.bodySrc.locals.length + 1 + 2 * pack.size + 4
  let base := pack.bodySrc.locals.length
  have hBaseLeN : base + (1 + 2 * pack.size) ≤ n := by
    change base + (1 + 2 * pack.size) ≤ base + 1 + 2 * pack.size + 4
    rw [Nat.add_assoc base 1 (2 * pack.size)]
    exact Nat.le_add_right _ 4
  have hStLt : ∀ (stmt : MemCopyStmt),
      (match stmt with
       | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => id < base
       | _ => True) →
      (lowerStmtForBuf plan.bufLocal base pack.size stmt).all (fun s =>
        match s with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
        | _ => true) = true := by
    intro stmt hB
    cases stmt with
    | baseStmt bs =>
      cases bs with
      | nop | unsupported | assign _ _ => rfl
      | storageLive id =>
        dsimp [lowerStmtForBuf]
        cases Nat.beq id plan.bufLocal with
        | false =>
          dsimp
          rw [(nat_blt_eq_lt _ _).mpr (Nat.lt_of_lt_of_le hB
            (Nat.le_trans (Nat.le_add_right base (1 + 2 * pack.size)) hBaseLeN))]
          rfl
        | true =>
          dsimp
          rw [s4_list_all_append, bool_and_eq_true]
          constructor
          · have hRng : ∀ (start cnt : Nat), start + cnt ≤ n →
                (mkStorageLiveRange start cnt).all (fun s =>
                  match s with
                  | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
                  | _ => true) = true := by
              intro start cnt hLe
              induction cnt generalizing start with
              | zero => rfl
              | succ k ih =>
                change (Nat.blt start n && (mkStorageLiveRange (start + 1) k).all _) = true
                have hLt1 : start < n := Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ k)) hLe
                have hLe2 : (start + 1) + k ≤ n := by rw [Nat.add_right_comm]; exact hLe
                rw [(nat_blt_eq_lt _ _).mpr hLt1, ih (start + 1) hLe2]
                rfl
            exact hRng base (1 + 2 * pack.size) hBaseLeN
          · have hZ : ∀ (start cnt : Nat),
                (mkZeroUsizeRange start cnt).all (fun s =>
                  match s with
                  | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
                  | _ => true) = true := by
              intro start cnt
              induction cnt generalizing start with
              | zero => rfl
              | succ k ih => exact ih (start + 1)
            exact hZ (base + 1) (2 * pack.size)
      | storageDead id =>
        dsimp [lowerStmtForBuf]
        cases Nat.beq id plan.bufLocal with
        | false =>
          dsimp
          rw [(nat_blt_eq_lt _ _).mpr (Nat.lt_of_lt_of_le hB
            (Nat.le_trans (Nat.le_add_right base (1 + 2 * pack.size)) hBaseLeN))]
          rfl
        | true =>
          dsimp
          have hRng : ∀ (start cnt : Nat), start + cnt ≤ n →
              (mkStorageDeadRange start cnt).all (fun s =>
                match s with
                | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
                | _ => true) = true := by
            intro start cnt hLe
            induction cnt generalizing start with
            | zero => rfl
            | succ k ih =>
              change (Nat.blt start n && (mkStorageDeadRange (start + 1) k).all _) = true
              have hLt1 : start < n := Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ k)) hLe
              have hLe2 : (start + 1) + k ≤ n := by rw [Nat.add_right_comm]; exact hLe
              rw [(nat_blt_eq_lt _ _).mpr hLt1, ih (start + 1) hLe2]
              rfl
          exact hRng base (1 + 2 * pack.size) hBaseLeN
    | bufLivenessCheck b =>
      dsimp [lowerStmtForBuf]
      cases Nat.beq b plan.bufLocal <;> rfl
    | mkNullPtr _ | mkDanglingPtr _ _ | addrOfByteBuf _ _ | copyPtr _ _ _ | ptrWrappingOffset _ _ _ _ =>
      rfl
  have hZeroAll : ∀ (start cnt : Nat),
      (mkZeroUsizeRange start cnt).all (fun s =>
        match s with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
        | _ => true) = true := by
    intro start cnt
    induction cnt generalizing start with
    | zero => rfl
    | succ k ih => exact ih (start + 1)
  have hBbs := congrArg MemCopyBody.basicBlocks pack.hBodyTgt
  rw [hBbs]
  dsimp [List.all]
  have hProl : (if memCopyHasStorageAnnotation pack.bodySrc plan.bufLocal = true then []
      else mkZeroUsizeRange (base + 1) (2 * pack.size)).all (fun s =>
        match s with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
        | _ => true) = true := by
    cases memCopyHasStorageAnnotation pack.bodySrc plan.bufLocal with
    | true => rfl
    | false => exact hZeroAll (base + 1) (2 * pack.size)
  have hExtras : (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability
      (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2.all (fun bb =>
        bb.statements.all (fun s =>
          match s with
          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
          | _ => true)) = true := by
    rw [list_all_eq_true]
    intro bb hBb
    rw [list_all_eq_true]
    intro st hSt
    have hNo := s4_lowerBlocksForBufLoop_extras_noStorageMarker plan.bufLocal base pack.size
      pack.mutability 0 (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks
    cases st with
    | baseStmt bs =>
      cases bs with
      | nop | unsupported | assign _ _ => rfl
      | storageLive id =>
        have hNoId := s4_lowerBlocksForBufLoop_extras_noStorageMarker plan.bufLocal base pack.size
          pack.mutability id (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks
        cases hAny : (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability
            (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2.any
              (fun b => b.statements.any (memCopyStmtHasStorageMarker id)) with
        | true => rw [hAny] at hNoId; cases hNoId
        | false =>
          have hT : (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability
              (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2.any
                (fun b => b.statements.any (memCopyStmtHasStorageMarker id)) = true :=
            (list_any_eq_true _ _).mpr ⟨bb, hBb, (list_any_eq_true _ _).mpr ⟨.baseStmt (.storageLive id), hSt, nat_beq_refl id⟩⟩
          rw [hT] at hAny; cases hAny
      | storageDead id =>
        have hNoId := s4_lowerBlocksForBufLoop_extras_noStorageMarker plan.bufLocal base pack.size
          pack.mutability id (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks
        cases hAny : (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability
            (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2.any
              (fun b => b.statements.any (memCopyStmtHasStorageMarker id)) with
        | true => rw [hAny] at hNoId; cases hNoId
        | false =>
          have hT : (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability
              (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks).2.any
                (fun b => b.statements.any (memCopyStmtHasStorageMarker id)) = true :=
            (list_any_eq_true _ _).mpr ⟨bb, hBb, (list_any_eq_true _ _).mpr ⟨.baseStmt (.storageDead id), hSt, nat_beq_refl id⟩⟩
          rw [hT] at hAny; cases hAny
    | _ => rfl
  have hMain : ∀ (nextExtra : Nat) (bbs : List MemCopyBlock),
      bbs.all (fun bb => bb.statements.all (fun stmt =>
        match stmt with
        | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id base
        | _ => true)) = true →
      (lowerBlocksForBufLoop plan.bufLocal base pack.size pack.mutability nextExtra bbs).1.all
        (fun bb => bb.statements.all (fun s =>
          match s with
          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
          | _ => true)) = true := by
    intro nextExtra bbs hBbs
    induction bbs generalizing nextExtra with
    | nil => rfl
    | cons b tl ih =>
      have hHead := (bool_and_eq_true _ _).mp hBbs
      dsimp [lowerBlocksForBufLoop]
      rw [bool_and_eq_true]
      constructor
      · rw [s4_list_all_append, bool_and_eq_true]
        constructor
        · rw [list_all_eq_true]
          intro s hs
          have hFlat : ∀ (stmts : List MemCopyStmt),
              stmts.all (fun stmt =>
                match stmt with
                | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id base
                | _ => true) = true →
              (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) stmts).all
                (fun s => match s with
                  | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
                  | _ => true) = true := by
            intro stmts hStmts
            induction stmts with
            | nil => rfl
            | cons st sTl ihSt =>
              have hS := (bool_and_eq_true _ _).mp hStmts
              rw [s4_listFlatMap_cons, s4_list_all_append, bool_and_eq_true]
              refine ⟨hStLt st ?_, ihSt hS.2⟩
              cases st with
              | baseStmt bs =>
                cases bs with
                | storageLive id | storageDead id => exact (nat_blt_eq_lt _ _).mp hS.1
                | nop | unsupported | assign _ _ => exact True.intro
              | _ => exact True.intro
          exact (list_all_eq_true _ _).mp (hFlat b.statements hHead.1) s hs
        · rw [list_all_eq_true]
          intro s hs
          cases s with
          | baseStmt bs =>
            cases bs with
            | nop | unsupported | assign _ _ => rfl
            | storageLive id =>
              have hNo := (s4_lowerTermForBuf_noStorageMarker plan.bufLocal base pack.size
                pack.mutability nextExtra id b.terminator).1
              have hT := (list_any_eq_true (memCopyStmtHasStorageMarker id) _).mpr
                ⟨MemCopyStmt.baseStmt (.storageLive id), hs, nat_beq_refl id⟩
              rw [hT] at hNo; cases hNo
            | storageDead id =>
              have hNo := (s4_lowerTermForBuf_noStorageMarker plan.bufLocal base pack.size
                pack.mutability nextExtra id b.terminator).1
              have hT := (list_any_eq_true (memCopyStmtHasStorageMarker id) _).mpr
                ⟨MemCopyStmt.baseStmt (.storageDead id), hs, nat_beq_refl id⟩
              rw [hT] at hNo; cases hNo
          | _ => rfl
      · exact ih _ hHead.2
  dsimp [base, n] at hProl hMain hExtras
  rw [bool_and_eq_true]
  constructor
  · exact hProl
  · rw [s4_list_all_append, bool_and_eq_true]
    exact ⟨hMain (1 + pack.bodySrc.basicBlocks.length) pack.bodySrc.basicBlocks pack.hStorage, hExtras⟩

/-! ## Section 5: `s4_StateRel`, `s4_ReachableInv`, & `initStateMemCopy` + `entryPrologue` -/

private theorem s4_allMemCopyLocalsSupported_bodyTgt_iff {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    allMemCopyLocalsSupported pack.bodyTgt.argumentCount pack.bodyTgt.acceptsCallerMem 0
        pack.bodyTgt.locals =
      allMemCopyLocalsSupported pack.bodySrc.argumentCount pack.bodySrc.acceptsCallerMem 0
        pack.bodySrc.locals := by
  rw [s4_bodyTgt_argumentCount pack, s4_bodyTgt_acceptsCallerMem pack, pack.hAcceptsFalse]
  have hTailAll : ∀ (idx : Nat) (extra : List MemCopyLocalDecl),
      (∀ d : MemCopyLocalDecl, List.Mem d extra →
        d = .base .unit ∨ d = .base usizeTy) →
      allMemCopyLocalsSupported pack.bodySrc.argumentCount false idx extra = true := by
    intro idx extra hMem
    induction extra generalizing idx with
    | nil => rfl
    | cons d tl ih =>
      dsimp [allMemCopyLocalsSupported]
      have hD : isSupportedMemCopyLocalDecl pack.bodySrc.argumentCount false idx d = true := by
        cases hMem d (List.Mem.head tl) with
        | inl hU => rw [hU]; rfl
        | inr hUs => rw [hUs]; rfl
      rw [hD, ih (idx + 1) (fun x hx => hMem x (List.Mem.tail d hx))]
      rfl
  have hApp : ∀ (xs ys : List MemCopyLocalDecl) (idx : Nat),
      allMemCopyLocalsSupported pack.bodySrc.argumentCount false idx (xs ++ ys) =
        (allMemCopyLocalsSupported pack.bodySrc.argumentCount false idx xs &&
         allMemCopyLocalsSupported pack.bodySrc.argumentCount false (idx + xs.length) ys) := by
    intro xs ys idx
    induction xs generalizing idx with
    | nil =>
      change allMemCopyLocalsSupported pack.bodySrc.argumentCount false idx ys =
        (true && allMemCopyLocalsSupported pack.bodySrc.argumentCount false (idx + 0) ys)
      rw [Nat.add_zero]
      rfl
    | cons a tl ih =>
      dsimp [allMemCopyLocalsSupported]
      rw [ih (idx + 1)]
      have hIdx : idx + 1 + tl.length = idx + (a :: tl).length := by
        rw [List.length_cons, Nat.add_right_comm idx 1 tl.length, Nat.add_assoc idx tl.length 1]
      rw [hIdx, Bool.and_assoc]
      rfl
  have hLocs := congrArg MemCopyBody.locals pack.hBodyTgt
  rw [hLocs, List.append_assoc, List.append_assoc, hApp, hApp, hApp]
  have hUnit : allMemCopyLocalsSupported pack.bodySrc.argumentCount false
      (0 + pack.localsTombstoned.length) [MemCopyLocalDecl.base .unit] = true := rfl
  have hBytes : allMemCopyLocalsSupported pack.bodySrc.argumentCount false
      (0 + pack.localsTombstoned.length + [MemCopyLocalDecl.base .unit].length)
      (listReplicate (2 * pack.size) (MemCopyLocalDecl.base usizeTy)) = true := by
    refine hTailAll _ _ (fun d hd => ?_)
    have hEq : d = .base usizeTy := by
      have : ∀ (n : Nat) (x : MemCopyLocalDecl), List.Mem d (listReplicate n x) → d = x := by
        intro n x hm
        induction n with
        | zero => cases hm
        | succ k ihk =>
          cases hm with
          | head => rfl
          | tail _ ht => exact ihk ht
      exact this _ _ hd
    exact Or.inr hEq
  have hScrs : allMemCopyLocalsSupported pack.bodySrc.argumentCount false
      (0 + pack.localsTombstoned.length + [MemCopyLocalDecl.base .unit].length +
        (listReplicate (2 * pack.size) (MemCopyLocalDecl.base usizeTy)).length)
      (listReplicate 4 (MemCopyLocalDecl.base usizeTy)) = true := by
    refine hTailAll _ _ (fun d hd => ?_)
    have hEq : d = .base usizeTy := by
      have : ∀ (n : Nat) (x : MemCopyLocalDecl), List.Mem d (listReplicate n x) → d = x := by
        intro n x hm
        induction n with
        | zero => cases hm
        | succ k ihk =>
          cases hm with
          | head => rfl
          | tail _ ht => exact ihk ht
      exact this _ _ hd
    exact Or.inr hEq
  rw [hUnit, hBytes, hScrs]
  have hAndT : ∀ b : Bool, (b && (true && (true && true))) = b := fun b => by cases b <;> rfl
  rw [hAndT]
  have hTombEq : ∀ (xs ts : List MemCopyLocalDecl) (idx k : Nat),
      setElem? xs k (.base .unit) = some ts →
      k < xs.length →
      (match Trusted.MirSemantics.getElem? xs k with
       | some (.byteBuf sz al _) => Nat.ble pack.bodySrc.argumentCount (idx + k) = false ∨
           (Nat.blt pack.bodySrc.argumentCount (idx + k) && Nat.ble sz maxIsize && Nat.ble al 30) = true
       | _ => False) →
      idx + k = plan.bufLocal →
      pack.bodySrc.argumentCount < plan.bufLocal →
      allMemCopyLocalsSupported pack.bodySrc.argumentCount false idx ts =
        allMemCopyLocalsSupported pack.bodySrc.argumentCount false idx xs := by
    intro xs
    induction xs with
    | nil => intro _ _ _ hSet; cases hSet
    | cons a tl ih =>
      intro ts idx k hSet hKLt hDecl hSum hArg
      cases k with
      | zero =>
        cases hSet
        dsimp [allMemCopyLocalsSupported]
        rw [Nat.add_zero] at hSum hDecl
        dsimp [Trusted.MirSemantics.getElem?] at hDecl
        cases a with
        | base _ | ptrLocal => cases hDecl
        | byteBuf sz al mu =>
          have h1 : isSupportedMemCopyLocalDecl pack.bodySrc.argumentCount false idx (.base .unit) = true := rfl
          have h2 : isSupportedMemCopyLocalDecl pack.bodySrc.argumentCount false idx (.byteBuf sz al mu) = true := by
            dsimp [isSupportedMemCopyLocalDecl]
            cases hDecl with
            | inl hFalse =>
              rw [(nat_ble_eq_le _ _).mpr (Nat.le_of_lt (by rw [hSum]; exact hArg))] at hFalse
              cases hFalse
            | inr hTrue => exact hTrue
          rw [h1, h2]
      | succ m =>
        dsimp [setElem?] at hSet
        cases hUp : setElem? tl m (.base .unit) with
        | none => rw [hUp] at hSet; cases hSet
        | some ts' =>
          rw [hUp] at hSet
          cases hSet
          dsimp [allMemCopyLocalsSupported]
          have hSum' : (idx + 1) + m = plan.bufLocal := by
            rw [Nat.add_right_comm]; exact hSum
          have hDecl' : match Trusted.MirSemantics.getElem? tl m with
              | some (.byteBuf sz al _) => Nat.ble pack.bodySrc.argumentCount ((idx + 1) + m) = false ∨
                  (Nat.blt pack.bodySrc.argumentCount ((idx + 1) + m) && Nat.ble sz maxIsize && Nat.ble al 30) = true
              | _ => False := by
            rw [Nat.add_right_comm]; exact hDecl
          have hNext := ih ts' (idx + 1) m hUp (Nat.lt_of_succ_lt_succ hKLt) hDecl' hSum' hArg
          rw [hNext]
  refine hTombEq pack.bodySrc.locals pack.localsTombstoned 0 plan.bufLocal pack.hTomb pack.hBufLtLoc ?_
    (Nat.zero_add _) pack.hArgLtBuf
  rw [pack.hBufDecl, Nat.zero_add]
  right
  have hSzMax : pack.size ≤ maxIsize := by
    have h32 : 32 ≤ maxIsize := by decide
    exact Nat.le_trans pack.hSizeLe h32
  rw [(nat_blt_eq_lt _ _).mpr pack.hArgLtBuf, (nat_ble_eq_le _ _).mpr hSzMax,
    (nat_ble_eq_le _ _).mpr pack.hAlignLe]
  rfl

private theorem s4_paramDecls_bodyTgt_eq {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    (pack.bodyTgt.locals.drop 1).take pack.bodyTgt.argumentCount =
      (pack.bodySrc.locals.drop 1).take pack.bodySrc.argumentCount := by
  rw [s4_bodyTgt_argumentCount pack]
  have hEq : ∀ i : Nat, i < pack.bodySrc.argumentCount →
      Trusted.MirSemantics.getElem? ((pack.bodyTgt.locals.drop 1).take pack.bodySrc.argumentCount) i =
      Trusted.MirSemantics.getElem? ((pack.bodySrc.locals.drop 1).take pack.bodySrc.argumentCount) i := by
    intro i hi
    rw [s4_list_getElem?_take_lt _ _ _ hi, s4_list_getElem?_take_lt _ _ _ hi,
      s4_list_getElem?_drop, s4_list_getElem?_drop]
    have hLt : 1 + i < pack.bodySrc.locals.length := by
      have h1 : 1 + i < 1 + pack.bodySrc.argumentCount := Nat.add_lt_add_left hi 1
      have h2 : 1 + pack.bodySrc.argumentCount ≤ pack.bodySrc.locals.length :=
        Nat.le_trans (by rw [Nat.add_comm 1 pack.bodySrc.argumentCount]; exact pack.hArgLtBuf)
          (Nat.le_of_lt pack.hBufLtLoc)
      exact Nat.lt_of_lt_of_le h1 h2
    have hNe : 1 + i ≠ plan.bufLocal := fun h => by
      have hLtBuf : 1 + i ≤ pack.bodySrc.argumentCount := by
        rw [Nat.add_comm 1 i]; exact hi
      have hBad := Nat.lt_of_le_of_lt hLtBuf pack.hArgLtBuf
      rw [h] at hBad
      exact s4_nat_lt_irrefl plan.bufLocal hBad
    exact s4_getElem?_bodyTgt_locals_lt pack hLt hNe
  have hLenTgt : ((pack.bodyTgt.locals.drop 1).take pack.bodySrc.argumentCount).length =
      pack.bodySrc.argumentCount := by
    refine s4_list_length_take_of_le _ _ ?_
    rw [s4_list_length_drop, s4_bodyTgt_locals_length pack]
    have h1 : pack.bodySrc.argumentCount + 1 ≤ pack.bodySrc.locals.length :=
      Nat.le_trans pack.hArgLtBuf (Nat.le_of_lt pack.hBufLtLoc)
    have h2 : pack.bodySrc.locals.length ≤ pack.bodySrc.locals.length + 1 + 2 * pack.size + 4 :=
      Nat.le_trans (Nat.le_add_right _ _) (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
    exact Nat.le_sub_of_add_le (Nat.le_trans h1 h2)
  have hLenSrc : ((pack.bodySrc.locals.drop 1).take pack.bodySrc.argumentCount).length =
      pack.bodySrc.argumentCount := by
    refine s4_list_length_take_of_le _ _ ?_
    rw [s4_list_length_drop]
    have h1 : pack.bodySrc.argumentCount + 1 ≤ pack.bodySrc.locals.length :=
      Nat.le_trans pack.hArgLtBuf (Nat.le_of_lt pack.hBufLtLoc)
    exact Nat.le_sub_of_add_le h1
  have hListExt : ∀ (xs ys : List MemCopyLocalDecl),
      xs.length = ys.length →
      (∀ i : Nat, i < xs.length →
        Trusted.MirSemantics.getElem? xs i = Trusted.MirSemantics.getElem? ys i) →
      xs = ys := by
    intro xs
    induction xs with
    | nil =>
      intro ys hLen _
      cases ys with
      | nil => rfl
      | cons _ _ => cases hLen
    | cons a tl ih =>
      intro ys hLen hGet
      cases ys with
      | nil => cases hLen
      | cons b tl2 =>
        have h0 := hGet 0 (Nat.zero_lt_succ tl.length)
        have ha : a = b := Option.some.inj h0
        rw [ha]
        refine congrArg (List.cons b) (ih tl2 (Nat.succ.inj hLen) (fun i hi => hGet (i + 1) (Nat.succ_lt_succ hi)))
  refine hListExt _ _ (by rw [hLenTgt, hLenSrc]) (fun i hi => hEq i (by rw [hLenTgt] at hi; exact hi))

private noncomputable def s4_PrefixMatch {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (slots₁ slots₂ : List MemCopySlot) : Prop :=
  slots₁.length = pack.bodySrc.locals.length ∧
  slots₂.length = pack.bodyTgt.locals.length ∧
  ∀ i : Nat, i < pack.bodySrc.locals.length → i ≠ plan.bufLocal →
    Trusted.MirSemantics.getElem? slots₂ i = Trusted.MirSemantics.getElem? slots₁ i

private noncomputable def s4_SlotValWf (bodySrc : MemCopyBody) (slots₁ : List MemCopySlot) : Prop :=
  ∀ (i : Nat) (ty : MirTy) (v : Val),
    Trusted.MirSemantics.getElem? bodySrc.locals i = some (.base ty) →
    Trusted.MirSemantics.getElem? slots₁ i = some (.baseSlot (.live (some v))) →
    checkVal v ty = true

private noncomputable def s4_AllocBytesWf (bytes : List AllocByte) : Prop :=
  bytes.all (fun ab => Nat.blt (encodeAllocByte ab).1 maxUsize) = true

private noncomputable def s4_BufRel {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (slots₁ : List MemCopySlot) (mem₁ : CallerMemory) (slots₂ : List MemCopySlot) : Prop :=
  let base := pack.bodySrc.locals.length
  ∃ (isLive : Bool) (alloc : Allocation),
    Trusted.MirSemantics.getElem? slots₁ plan.bufLocal = some (.bufSlot isLive) ∧
    findAlloc? (internalAllocBase + plan.bufLocal) mem₁.allocations = some alloc ∧
    alloc.allocId = internalAllocBase + plan.bufLocal ∧
    alloc.alignLog2 = pack.alignLog2 ∧
    alloc.mutability = pack.mutability ∧
    alloc.live = isLive ∧
    alloc.bytes.length = pack.size ∧
    s4_AllocBytesWf alloc.bytes ∧
    (if isLive = true then
      Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot (.live (some .unit))) ∧
      ∀ j : Nat, j < pack.size →
        ∃ ab : AllocByte,
          Trusted.MirSemantics.getElem? alloc.bytes j = some ab ∧
          Trusted.MirSemantics.getElem? slots₂ (base + 1 + j) =
            some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩)))) ∧
          Trusted.MirSemantics.getElem? slots₂ (base + 1 + pack.size + j) =
            some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩))))
    else
      Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot .dead) ∧
      ∀ j : Nat, j < 2 * pack.size →
        Trusted.MirSemantics.getElem? slots₂ (base + 1 + j) = some (.baseSlot .dead))

private noncomputable def s4_MemRel {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (mem₁ mem₂ : CallerMemory) : Prop :=
  let bufAid := internalAllocBase + plan.bufLocal
  mem₂.allocations = mem₁.allocations.filter (fun a => !Nat.beq a.allocId bufAid) ∧
  ∀ a : Allocation, List.Mem a mem₁.allocations →
    ∃ (id sz al : Nat) (mu : Mutability),
      a.allocId = internalAllocBase + id ∧
      Trusted.MirSemantics.getElem? pack.bodySrc.locals id = some (.byteBuf sz al mu) ∧
      s4_AllocBytesWf a.bytes

private noncomputable def s4_ScrLive {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (slots₂ : List MemCopySlot) : Prop :=
  ∀ r : Nat, r < 4 →
    ∃ ov : Option Val,
      Trusted.MirSemantics.getElem? slots₂
        (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) =
          some (.baseSlot (.live ov))

private noncomputable def s4_CoreRel {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (s₁ s₂ : MemCopyState) : Prop :=
  match s₁.frames, s₂.frames with
  | [f₁], [f₂] =>
    (f₁.defId ≠ plan.defId ∧ s₂ = s₁) ∨
    (f₁.defId = plan.defId ∧
     f₂.defId = plan.defId ∧
     f₂.blockIdx = f₁.blockIdx + 1 ∧
     s4_PrefixMatch pack f₁.locals f₂.locals ∧
     s4_SlotValWf pack.bodySrc f₁.locals ∧
     s4_BufRel pack f₁.locals s₁.mem f₂.locals ∧
     s4_MemRel pack s₁.mem s₂.mem ∧
     s4_ScrLive pack f₂.locals ∧
     match Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx with
     | none => True
     | some bb =>
       f₁.stmtIdx ≤ bb.statements.length ∧
       f₂.stmtIdx = (listFlatMap
         (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
         (bb.statements.take f₁.stmtIdx)).length)
  | _, _ => False

private noncomputable def s4_StateRel {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (s₁ s₂ : MemCopyState) : Prop :=
  s4_CoreRel pack s₁ s₂ ∨
  ∃ s₂Post : MemCopyState, ReachesMemCopy pTgt s₂ s₂Post ∧ s4_CoreRel pack s₁ s₂Post

private noncomputable def s4_ReachableInv {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (s₁ : MemCopyState) : Prop :=
  match s₁.frames with
  | [f₁] =>
    f₁.defId = plan.defId →
    ∃ bb : MemCopyBlock,
      Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bb
  | _ => False

private theorem s4_initStateMemCopy_err_iff {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (q : Query) (k : FaultKind) :
    initStateMemCopy pSrc q = .error k ↔ initStateMemCopy pTgt q = .error k := by
  cases s4_nat_eq_or_ne pSrc.entryDefId plan.defId with
  | inr hNe =>
    have hEq : initStateMemCopy pTgt q = initStateMemCopy pSrc q := by
      unfold initStateMemCopy
      rw [s4_pTgt_pointerWidthBits pack, s4_pTgt_mirProfileVersion pack,
        s4_pTgt_entryDefId pack, s4_getElem?_pTgt_bodies_ne pack hNe]
    rw [hEq]
  | inl hDef =>
    unfold initStateMemCopy
    rw [s4_pTgt_pointerWidthBits pack, s4_pTgt_mirProfileVersion pack,
      s4_pTgt_entryDefId pack, hDef, s4_getElem?_pTgt_bodies_eq pack, pack.hBodySrc]
    dsimp
    rw [s4_allMemCopyLocalsSupported_bodyTgt_iff pack, s4_bodyTgt_acceptsCallerMem pack,
      pack.hAcceptsFalse, s4_bodyTgt_isEmpty_false pack, pack.hNonEmpty]
    have hArgSrc : Nat.blt pack.bodySrc.argumentCount pack.bodySrc.locals.length = true :=
      (nat_blt_eq_lt _ _).mpr (Nat.lt_trans pack.hArgLtBuf pack.hBufLtLoc)
    have hArgTgt : Nat.blt pack.bodyTgt.argumentCount pack.bodyTgt.locals.length = true := by
      rw [s4_bodyTgt_argumentCount pack, s4_bodyTgt_locals_length pack]
      have hPos : 0 < 1 + 2 * pack.size + 4 := by
        rw [Nat.add_assoc]; exact Nat.zero_lt_succ _
      have hTailLt : pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + 2 * pack.size + 4 := by
        rw [Nat.add_assoc pack.bodySrc.locals.length 1 (2 * pack.size),
          Nat.add_assoc pack.bodySrc.locals.length (1 + 2 * pack.size) 4]
        exact Nat.lt_add_of_pos_right hPos
      exact (nat_blt_eq_lt _ _).mpr (Nat.lt_trans (Nat.lt_trans pack.hArgLtBuf pack.hBufLtLoc) hTailLt)
    rw [hArgSrc, hArgTgt, pack.hStorage, s4_memCopyStorageAnnotationsInBounds_bodyTgt pack,
      s4_paramDecls_bodyTgt_eq pack]
    dsimp
    cases !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
    | true => exact Iff.rfl
    | false =>
      dsimp
      cases !q.callerMem.allocations.isEmpty with
      | true => exact Iff.rfl
      | false =>
        dsimp
        cases !allMemCopyLocalsSupported pack.bodySrc.argumentCount false 0 pack.bodySrc.locals with
        | true => exact Iff.rfl
        | false =>
          dsimp
          cases !checkMemCopyArgsMatch false q.callerMem q.args
              ((pack.bodySrc.locals.drop 1).take pack.bodySrc.argumentCount) with
          | true => exact Iff.rfl
          | false =>
            dsimp
            constructor <;> (intro h; cases h)

private theorem s4_initMemCopyLocalsLoop_length (body : MemCopyBody) (args : List Val) :
    ∀ (idx : Nat) (decls : List MemCopyLocalDecl),
      (initMemCopyLocalsLoop body args idx decls).length = decls.length
  | _, [] => rfl
  | idx, _ :: tl =>
    congrArg Nat.succ (s4_initMemCopyLocalsLoop_length body args (idx + 1) tl)

private theorem s4_getElem?_initMemCopyLocalsLoop (body : MemCopyBody) (args : List Val) :
    ∀ (decls : List MemCopyLocalDecl) (baseIdx i : Nat) (d : MemCopyLocalDecl),
      Trusted.MirSemantics.getElem? decls i = some d →
      Trusted.MirSemantics.getElem? (initMemCopyLocalsLoop body args baseIdx decls) i =
        some (
          let idx := baseIdx + i
          if Nat.beq idx 0 then
            liveUninitMemCopySlot d
          else if Nat.ble idx body.argumentCount then
            match Trusted.MirSemantics.getElem? args (idx - 1), d with
            | some (.ptr pv), .ptrLocal => .livePtr (some pv)
            | some v, .base _ => .baseSlot (.live (some v))
            | _, _ => deadMemCopySlot d
          else if memCopyHasStorageAnnotation body idx then
            deadMemCopySlot d
          else
            liveUninitMemCopySlot d)
  | [], _, _, _, h => by cases h
  | a :: _, baseIdx, 0, d, h => by
    rw [← Option.some.inj h, Nat.add_zero]
    rfl
  | _ :: tl, baseIdx, i + 1, d, h => by
    have ih := s4_getElem?_initMemCopyLocalsLoop body args tl (baseIdx + 1) i d h
    have hAssoc : baseIdx + 1 + i = baseIdx + (i + 1) := by
      rw [Nat.add_assoc, Nat.add_comm 1 i]
    rw [hAssoc] at ih
    exact ih

private theorem s4_buildInternalBufAllocs_filter_buf (bodySrc bodyTgt : MemCopyBody)
    (bufLocal : LocalId) (base : Nat)
    (hLen : bodySrc.locals.length = base)
    (hDiff : ∀ idx : Nat, idx < base → idx ≠ bufLocal →
      Trusted.MirSemantics.getElem? bodyTgt.locals idx =
        Trusted.MirSemantics.getElem? bodySrc.locals idx ∧
      memCopyHasStorageAnnotation bodyTgt idx = memCopyHasStorageAnnotation bodySrc idx)
    (hBufTgt : Trusted.MirSemantics.getElem? bodyTgt.locals bufLocal = some (.base .unit))
    (hTail : ∀ idx : Nat, base ≤ idx →
      match Trusted.MirSemantics.getElem? bodyTgt.locals idx with
      | none => True
      | some (.byteBuf _ _ _) => False
      | some _ => True) :
    buildInternalBufAllocs bodyTgt 0 bodyTgt.locals =
      (buildInternalBufAllocs bodySrc 0 bodySrc.locals).filter
        (fun a => !Nat.beq a.allocId (internalAllocBase + bufLocal)) := by
  have hDropFilter : ∀ (idx : Nat) (xs ys : List MemCopyLocalDecl),
      xs = bodySrc.locals.drop idx →
      ys = bodyTgt.locals.drop idx →
      idx ≤ base →
      buildInternalBufAllocs bodyTgt idx ys =
        (buildInternalBufAllocs bodySrc idx xs).filter
          (fun a => !Nat.beq a.allocId (internalAllocBase + bufLocal)) := by
    intro idx xs ys hXs hYs hLe
    induction xs generalizing idx ys with
    | nil =>
      have hBase : idx = base := by
        have hGe : bodySrc.locals.length ≤ idx := by
          cases Nat.lt_or_ge idx bodySrc.locals.length with
          | inr h => exact h
          | inl hLt =>
            cases s4_getElem?_lt_some bodySrc.locals idx hLt with | intro d hd =>
            have hD := s4_list_getElem?_drop bodySrc.locals idx 0
            rw [Nat.add_zero, ← hXs] at hD
            rw [hd] at hD
            cases hD
        rw [hLen] at hGe
        exact Nat.le_antisymm hLe hGe
      have hTailEmpty : ∀ (k : Nat) (zs : List MemCopyLocalDecl),
          zs = bodyTgt.locals.drop (base + k) →
          buildInternalBufAllocs bodyTgt (base + k) zs = [] := by
        intro k zs hZs
        induction zs generalizing k with
        | nil => rfl
        | cons z ztl ihZ =>
          have hGet : Trusted.MirSemantics.getElem? bodyTgt.locals (base + k) = some z := by
            have hD := s4_list_getElem?_drop bodyTgt.locals (base + k) 0
            rw [Nat.add_zero, ← hZs] at hD
            exact hD.symm
          have hT := hTail (base + k) (Nat.le_add_right _ _)
          rw [hGet] at hT
          cases z with
          | byteBuf _ _ _ => cases hT
          | base _ | ptrLocal =>
            dsimp [buildInternalBufAllocs]
            refine ihZ (k + 1) ?_
            have hD : (bodyTgt.locals.drop (base + k)).drop 1 =
                bodyTgt.locals.drop (base + (k + 1)) := by
              have hStep : ∀ (l : List MemCopyLocalDecl) (m : Nat),
                  (l.drop m).drop 1 = l.drop (m + 1) := by
                intro l m
                induction l generalizing m with
                | nil => cases m <;> rfl
                | cons _ _ ihl => cases m with | zero => rfl | succ m' => exact ihl m'
              rw [hStep, Nat.add_assoc]
            rw [← hZs] at hD
            dsimp [List.drop] at hD
            exact hD
      rw [hBase] at hYs
      have hZ := hTailEmpty 0 ys (by rw [Nat.add_zero]; exact hYs)
      rw [Nat.add_zero] at hZ
      rw [hBase]
      exact hZ
    | cons x xtl ih =>
      have hIdxLt : idx < base := by
        have hD : Trusted.MirSemantics.getElem? bodySrc.locals idx = some x := by
          have := s4_list_getElem?_drop bodySrc.locals idx 0
          rw [Nat.add_zero, ← hXs] at this
          exact this.symm
        rw [← hLen]
        exact s4_getElem?_some_lt bodySrc.locals idx x hD
      have hDropStep : ∀ (l : List MemCopyLocalDecl) (m : Nat),
          (l.drop m).drop 1 = l.drop (m + 1) := by
        intro l m
        induction l generalizing m with
        | nil => cases m <;> rfl
        | cons _ _ ihl => cases m with | zero => rfl | succ m' => exact ihl m'
      have hxSrc : Trusted.MirSemantics.getElem? bodySrc.locals idx = some x := by
        have := s4_list_getElem?_drop bodySrc.locals idx 0
        rw [Nat.add_zero, ← hXs] at this
        exact this.symm
      cases s4_nat_eq_or_ne idx bufLocal with
      | inl hEq =>
        have hyTgt : Trusted.MirSemantics.getElem? bodyTgt.locals idx = some (.base .unit) := by
          rw [hEq]; exact hBufTgt
        have hYCons : ∃ ytl, ys = (.base .unit) :: ytl := by
          have hD := s4_list_getElem?_drop bodyTgt.locals idx 0
          rw [Nat.add_zero, hyTgt] at hD
          rw [← hYs] at hD
          cases ys with
          | nil => cases hD
          | cons y₀ ytl => exact ⟨ytl, by rw [Option.some.inj hD]⟩
        cases hYCons with | intro ytl hYsEq =>
        have hYtl : ytl = bodyTgt.locals.drop (idx + 1) := by
          have hSt := hDropStep bodyTgt.locals idx
          rw [← hYs, hYsEq] at hSt
          dsimp [List.drop] at hSt
          exact hSt
        have hXtl : xtl = bodySrc.locals.drop (idx + 1) := by
          have hSt := hDropStep bodySrc.locals idx
          rw [← hXs] at hSt
          dsimp [List.drop] at hSt
          exact hSt
        rw [hYsEq]
        dsimp [buildInternalBufAllocs]
        rw [ih (idx + 1) ytl hXtl hYtl hIdxLt]
        cases x with
        | base _ | ptrLocal => rfl
        | byteBuf _ _ _ =>
          dsimp [buildInternalBufAllocs, List.filter]
          rw [hEq, nat_beq_refl]
          rfl
      | inr hNe =>
        have hD := hDiff idx hIdxLt hNe
        have hyTgt : Trusted.MirSemantics.getElem? bodyTgt.locals idx = some x := by
          rw [hD.1, hxSrc]
        have hYCons : ∃ ytl, ys = x :: ytl := by
          have hDr := s4_list_getElem?_drop bodyTgt.locals idx 0
          rw [Nat.add_zero, hyTgt] at hDr
          rw [← hYs] at hDr
          cases ys with
          | nil => cases hDr
          | cons y₀ ytl => exact ⟨ytl, by rw [Option.some.inj hDr]⟩
        cases hYCons with | intro ytl hYsEq =>
        have hYtl : ytl = bodyTgt.locals.drop (idx + 1) := by
          have hSt := hDropStep bodyTgt.locals idx
          rw [← hYs, hYsEq] at hSt
          dsimp [List.drop] at hSt
          exact hSt
        have hXtl : xtl = bodySrc.locals.drop (idx + 1) := by
          have hSt := hDropStep bodySrc.locals idx
          rw [← hXs] at hSt
          dsimp [List.drop] at hSt
          exact hSt
        rw [hYsEq]
        cases x with
        | base _ | ptrLocal =>
          dsimp [buildInternalBufAllocs]
          exact ih (idx + 1) ytl hXtl hYtl hIdxLt
        | byteBuf sz al mu =>
          dsimp [buildInternalBufAllocs]
          have hAidNe : internalAllocBase + idx ≠ internalAllocBase + bufLocal := fun h =>
            hNe (Nat.add_left_cancel h)
          dsimp [List.filter]
          rw [s4_nat_beq_false hAidNe, hD.2]
          exact congrArg (List.cons _) (ih (idx + 1) ytl hXtl hYtl hIdxLt)
  exact hDropFilter 0 bodySrc.locals bodyTgt.locals rfl rfl (Nat.zero_le _)

private theorem s4_buildInternalBufAllocs_find {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt) :
    ∀ (idx : Nat) (decls : List MemCopyLocalDecl),
      decls = pack.bodySrc.locals.drop idx →
      idx ≤ plan.bufLocal →
      findAlloc? (internalAllocBase + plan.bufLocal)
          (buildInternalBufAllocs pack.bodySrc idx decls) =
        some {
          allocId := internalAllocBase + plan.bufLocal
          alignLog2 := pack.alignLog2
          mutability := pack.mutability
          bytes := listReplicate pack.size .uninit
          live := !memCopyHasStorageAnnotation pack.bodySrc plan.bufLocal
        } := by
  intro idx decls hDecls hLe
  induction decls generalizing idx with
  | nil =>
    have hGe : pack.bodySrc.locals.length ≤ idx := by
      cases Nat.lt_or_ge idx pack.bodySrc.locals.length with
      | inr h => exact h
      | inl hLt =>
        cases s4_getElem?_lt_some pack.bodySrc.locals idx hLt with | intro d hd =>
        have hD := s4_list_getElem?_drop pack.bodySrc.locals idx 0
        rw [Nat.add_zero, ← hDecls, hd] at hD
        cases hD
    exact False.elim (s4_nat_lt_irrefl plan.bufLocal (Nat.lt_of_lt_of_le pack.hBufLtLoc (Nat.le_trans hGe hLe)))
  | cons d tl ih =>
    have hDropStep : ∀ (l : List MemCopyLocalDecl) (m : Nat),
        (l.drop m).drop 1 = l.drop (m + 1) := by
      intro l m
      induction l generalizing m with
      | nil => cases m <;> rfl
      | cons _ _ ihl => cases m with | zero => rfl | succ m' => exact ihl m'
    have hTl : tl = pack.bodySrc.locals.drop (idx + 1) := by
      have hSt := hDropStep pack.bodySrc.locals idx
      rw [← hDecls] at hSt
      dsimp [List.drop] at hSt
      exact hSt
    cases s4_nat_eq_or_ne idx plan.bufLocal with
    | inl hEq =>
      have hGet : Trusted.MirSemantics.getElem? pack.bodySrc.locals plan.bufLocal = some d := by
        have hD := s4_list_getElem?_drop pack.bodySrc.locals idx 0
        rw [Nat.add_zero, ← hDecls, hEq] at hD
        exact hD.symm
      rw [pack.hBufDecl] at hGet
      rw [← Option.some.inj hGet, hEq]
      dsimp [buildInternalBufAllocs, findAlloc?]
      rw [nat_beq_refl]
      rfl
    | inr hNe =>
      have hLt : idx + 1 ≤ plan.bufLocal := Nat.lt_of_le_of_ne hLe hNe
      cases d with
      | base _ | ptrLocal =>
        dsimp [buildInternalBufAllocs]
        exact ih (idx + 1) hTl hLt
      | byteBuf _ _ _ =>
        dsimp [buildInternalBufAllocs, findAlloc?]
        have hAidNe : internalAllocBase + idx ≠ internalAllocBase + plan.bufLocal := fun h =>
          hNe (Nat.add_left_cancel h)
        rw [s4_nat_beq_false hAidNe]
        exact ih (idx + 1) hTl hLt

private theorem s4_buildInternalBufAllocs_mem (bodySrc : MemCopyBody) :
    ∀ (idx : Nat) (decls : List MemCopyLocalDecl) (a : Allocation),
      decls = bodySrc.locals.drop idx →
      List.Mem a (buildInternalBufAllocs bodySrc idx decls) →
      ∃ (id sz al : Nat) (mu : Mutability),
        a.allocId = internalAllocBase + id ∧
        Trusted.MirSemantics.getElem? bodySrc.locals id = some (.byteBuf sz al mu) ∧
        s4_AllocBytesWf a.bytes := by
  intro idx decls a hDecls hMem
  have hDropStep : ∀ (l : List MemCopyLocalDecl) (m : Nat),
      (l.drop m).drop 1 = l.drop (m + 1) := by
    intro l m
    induction l generalizing m with
    | nil => cases m <;> rfl
    | cons _ _ ihl => cases m with | zero => rfl | succ m' => exact ihl m'
  induction decls generalizing idx with
  | nil => cases hMem
  | cons d tl ih =>
    have hTl : tl = bodySrc.locals.drop (idx + 1) := by
      have hSt := hDropStep bodySrc.locals idx
      rw [← hDecls] at hSt
      dsimp [List.drop] at hSt
      exact hSt
    cases d with
    | base _ | ptrLocal =>
      dsimp [buildInternalBufAllocs] at hMem
      exact ih (idx + 1) hTl hMem
    | byteBuf sz al mu =>
      dsimp [buildInternalBufAllocs] at hMem
      cases hMem with
      | head =>
        have hGet : Trusted.MirSemantics.getElem? bodySrc.locals idx = some (.byteBuf sz al mu) := by
          have hD := s4_list_getElem?_drop bodySrc.locals idx 0
          rw [Nat.add_zero, ← hDecls] at hD
          exact hD.symm
        exact ⟨idx, sz, al, mu, rfl, hGet, s4_all_replicate_uninit_wf sz⟩
      | tail _ hTail =>
        exact ih (idx + 1) hTl hTail

private theorem s4_run_zeroUsizeRange {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (mem : CallerMemory) (pref : List MemCopyStmt) (start : Nat) :
    ∀ (rem : Nat) (slots : List MemCopySlot),
      let base := pack.bodySrc.locals.length
      let prologue : MemCopyBlock := {
        statements := pref ++ mkZeroUsizeRange start rem
        terminator := .baseTerm (.goto 1)
        cleanup := false
      }
      Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks 0 = some prologue →
      slots.length = pack.bodyTgt.locals.length →
      start + rem ≤ base + 1 + 2 * pack.size →
      base + 1 ≤ start →
      (∀ k : Nat, k < rem → ∃ ov : Option Val,
        Trusted.MirSemantics.getElem? slots (start + k) = some (.baseSlot (.live ov))) →
      ∃ slots' : List MemCopySlot,
        ReachesNMemCopy pTgt rem
          { frames := [{ defId := plan.defId, blockIdx := 0, stmtIdx := pref.length, locals := slots }],
            mem := mem }
          { frames := [{ defId := plan.defId, blockIdx := 0, stmtIdx := pref.length + rem, locals := slots' }],
            mem := mem } ∧
        slots'.length = slots.length ∧
        (∀ i : Nat, i < start → Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
        (∀ i : Nat, start + rem ≤ i → Trusted.MirSemantics.getElem? slots' i = Trusted.MirSemantics.getElem? slots i) ∧
        (∀ k : Nat, k < rem →
          Trusted.MirSemantics.getElem? slots' (start + k) =
            some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 0⟩)))))
  | 0, slots, _, _, _, _, _ => by
    refine ⟨slots, ReachesNMemCopy.zero _, rfl, fun _ _ => rfl, fun _ _ => rfl, fun _ h => nomatch h⟩
  | rem + 1, slots, hBb, hLen, hLeEnd, hGeStart, hLive => by
    let base := pack.bodySrc.locals.length
    have hStartSub : start - (base + 1) < 2 * pack.size := by
      have h1 : start < base + 1 + 2 * pack.size :=
        Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hLeEnd
      exact Nat.sub_lt_left_of_lt_add hGeStart h1
    have hDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals start = some (.base usizeTy) := by
      have h := s4_getElem?_bodyTgt_locals_byte pack hStartSub
      rw [Nat.add_sub_of_le hGeStart] at h
      exact h
    have hL0 := hLive 0 (Nat.zero_lt_succ rem)
    rw [Nat.add_zero] at hL0
    cases hL0 with | intro ov hSl0 =>
    have hLtSl : start < slots.length := s4_getElem?_some_lt slots start (.baseSlot (.live ov)) hSl0
    let zeroVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 0⟩
    cases hSet : setElem? slots start (.baseSlot (.live (some zeroVal))) with
    | none =>
      cases s4_lt_setElem?_some slots start (.baseSlot (.live (some zeroVal))) hLtSl with
      | intro _ hs => rw [hs] at hSet; cases hSet
    | some slots1 =>
      have hStep1 : evalStepMemCopy pTgt 0
          { frames := [{ defId := plan.defId, blockIdx := 0, stmtIdx := pref.length, locals := slots }],
            mem := mem } =
          .step { frames := [{ defId := plan.defId, blockIdx := 0, stmtIdx := pref.length + 1, locals := slots1 }],
                  mem := mem } := by
        dsimp [evalStepMemCopy]
        rw [s4_getElem?_pTgt_bodies_eq pack]
        dsimp
        rw [hBb]
        dsimp
        have hGetSt : Trusted.MirSemantics.getElem? (pref ++ mkZeroUsizeRange start (rem + 1)) pref.length =
            some (mkAssignUse start (usizeConst 0)) := by
          have h := s4_getElem?_append_right pref (mkZeroUsizeRange start (rem + 1)) 0
          rw [Nat.add_zero] at h
          exact h
        rw [hGetSt]
        dsimp [evalMemCopyStmt, mkAssignUse]
        rw [hDecl]
        dsimp [evalMemCopyBaseRvalue, evalMemCopyBaseOperandToSlot, usizeConst]
        rw [s4_evalConstLit_usizeConst s4_maxUsize_pos]
        dsimp [writeMemCopyBasePlace]
        have hTy : (!usizeTy.beq usizeTy) = false := rfl
        rw [hTy]
        dsimp
        have hNotChk : (!checkVal zeroVal usizeTy) = false := by
          rw [s4_checkVal_usize_ofNat s4_maxUsize_pos]; rfl
        rw [hNotChk]
        dsimp
        rw [hSl0]
        dsimp
        rw [hSet]
        rfl
      have hPrefNext : pref ++ mkZeroUsizeRange start (rem + 1) =
          (pref ++ [mkAssignUse start (usizeConst 0)]) ++ mkZeroUsizeRange (start + 1) rem := by
        rw [List.append_assoc]; rfl
      have hBbNext : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks 0 =
          some {
            statements := (pref ++ [mkAssignUse start (usizeConst 0)]) ++ mkZeroUsizeRange (start + 1) rem
            terminator := .baseTerm (.goto 1)
            cleanup := false
          } := by
        rw [← hPrefNext]; exact hBb
      have hLen1 : slots1.length = pack.bodyTgt.locals.length := by
        rw [s4_setElem?_length slots start _ slots1 hSet, hLen]
      have hLiveNext : ∀ k : Nat, k < rem → ∃ ov' : Option Val,
          Trusted.MirSemantics.getElem? slots1 (start + 1 + k) = some (.baseSlot (.live ov')) := by
        intro k hk
        have hNe : start ≠ start + 1 + k := fun h => by
          have hLe : start + 1 ≤ start + 1 + k := Nat.le_add_right (start + 1) k
          rw [← h] at hLe
          exact s4_nat_lt_irrefl start hLe
        rw [s4_getElem?_setElem?_ne slots start (start + 1 + k) _ slots1 hNe hSet]
        have hPrev := hLive (k + 1) (Nat.succ_lt_succ hk)
        rw [Nat.add_assoc, Nat.add_comm 1 k]
        exact hPrev
      have hRest := s4_run_zeroUsizeRange pack mem (pref ++ [mkAssignUse start (usizeConst 0)])
        (start + 1) rem slots1 hBbNext hLen1
        (by rw [Nat.add_right_comm]; exact hLeEnd)
        (Nat.le_trans hGeStart (Nat.le_succ start)) hLiveNext
      cases hRest with | intro slots' hR =>
      rw [s4_list_append_length] at hR
      dsimp at hR
      have hAssoc1 : pref.length + 1 + rem = pref.length + (rem + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 rem]
      rw [hAssoc1] at hR
      refine ⟨slots', ReachesNMemCopy.succ ((stepMemCopy_iff_evalStep pTgt _ _).mpr hStep1) hR.1,
        hR.2.1.trans (s4_setElem?_length slots start _ slots1 hSet), ?_, ?_, ?_⟩
      · intro i hi
        have hNe : start ≠ i := fun h => by
          have hBad : i < i := by rw [h] at hi; exact hi
          exact s4_nat_lt_irrefl i hBad
        rw [hR.2.2.1 i (Nat.lt_trans hi (Nat.lt_succ_self start)),
          s4_getElem?_setElem?_ne slots start i _ slots1 hNe hSet]
      · intro i hi
        have hLe' : start + 1 + rem ≤ i := by rw [Nat.add_right_comm]; exact hi
        have hNe : start ≠ i := fun h => by
          have hBad : i + (rem + 1) ≤ i := by rw [h] at hi; exact hi
          exact s4_nat_lt_irrefl i (Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem)) hBad)
        rw [hR.2.2.2.1 i hLe', s4_getElem?_setElem?_ne slots start i _ slots1 hNe hSet]
      · intro k hk
        cases k with
        | zero =>
          rw [Nat.add_zero]
          rw [hR.2.2.1 start (Nat.lt_succ_self start),
            s4_getElem?_setElem?_self slots start _ slots1 hSet]
        | succ m =>
          have hm : m < rem := Nat.lt_of_succ_lt_succ hk
          have hEq : start + (m + 1) = start + 1 + m := by
            rw [Nat.add_assoc, Nat.add_comm 1 m]
          rw [hEq]
          exact hR.2.2.2.2 m hm

private theorem s4_nat_lt_of_add_lt_add_left : ∀ (k a b : Nat), k + a < k + b → a < b
  | 0, a, b, h => by rw [Nat.zero_add, Nat.zero_add] at h; exact h
  | k + 1, a, b, h => by
    rw [Nat.succ_add, Nat.succ_add] at h
    exact s4_nat_lt_of_add_lt_add_left k a b (Nat.lt_of_succ_lt_succ h)

private theorem s4a_enumTy_beq_refl (ety : EnumTy) : EnumTy.beq ety ety = true := by
  have hInt : ∀ w : IntWidth, IntWidth.beq w w = true := fun w => by cases w <;> rfl
  have hBool : ∀ b : Bool, (b == b) = true := fun b => by cases b <;> rfl
  have hTag : ∀ t : EnumTagRepr, EnumTagRepr.beq t t = true := fun t => by
    cases t with
    | zeroSized => rfl
    | scalar w s => dsimp [EnumTagRepr.beq]; rw [hInt w, hBool s]; rfl
  have hList : ∀ xs : List Nat, natListBeq xs xs = true := fun xs => by
    induction xs with
    | nil => rfl
    | cons a tl ih => dsimp [natListBeq]; rw [nat_beq_refl a, ih]; rfl
  dsimp [EnumTy.beq]
  rw [nat_beq_refl ety.id, hInt ety.discrWidth, hBool ety.discrSigned,
    hTag ety.tagRepr, hList ety.discriminants]
  rfl

private theorem s4_liveUninitSlot_wf (ty : MirTy) (v : Val)
    (h : MemCopySlot.baseSlot (LocalSlot.live (some v)) = liveUninitMemCopySlot (.base ty)) :
    checkVal v ty = true := by
  dsimp [liveUninitMemCopySlot, liveUninitSlot] at h
  cases ty with
  | unit => cases h; rfl
  | enum ety =>
    dsimp at h
    cases hZ : isZstEnumTy ety with
    | false => rw [hZ] at h; cases h
    | true =>
      rw [hZ] at h
      cases h
      unfold isZstEnumTy at hZ
      cases hTag : ety.tagRepr with
      | scalar _ _ => rw [hTag] at hZ; cases hZ
      | zeroSized =>
        rw [hTag] at hZ
        dsimp at hZ
        have hPos : Nat.blt 0 ety.discriminants.length = true := by
          unfold enumAdmitted at hZ
          dsimp at hZ
          cases hD : ety.discriminants with
          | nil => rw [hD] at hZ; cases hZ
          | cons _ _ => rfl
        unfold checkVal Val.ty?
        dsimp
        rw [hZ, hPos]
        dsimp
        exact s4a_enumTy_beq_refl ety
  | int _ _ | bool | rawPtr _ _ | ref _ _ | tuple _ | never | unsupported =>
    cases h

private theorem s4_initStateMemCopy_ok_rel {plan : BufScalarizePlan}
    {pSrc pTgt : MemCopyProgram} (pack : s4_BufScalarizePack plan pSrc pTgt)
    (q : Query) (s₁ : MemCopyState) (hInit : initStateMemCopy pSrc q = .ok s₁) :
    ∃ s₂ : MemCopyState, initStateMemCopy pTgt q = .ok s₂ ∧ s4_StateRel pack s₁ s₂ := by
  cases s4_nat_eq_or_ne pSrc.entryDefId plan.defId with
  | inr hNe =>
    have hEq : initStateMemCopy pTgt q = initStateMemCopy pSrc q := by
      unfold initStateMemCopy
      rw [s4_pTgt_pointerWidthBits pack, s4_pTgt_mirProfileVersion pack,
        s4_pTgt_entryDefId pack, s4_getElem?_pTgt_bodies_ne pack hNe]
    rw [hEq, hInit]
    refine ⟨s₁, rfl, Or.inl ?_⟩
    unfold initStateMemCopy at hInit
    cases hMeta : !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
    | true => rw [hMeta] at hInit; cases hInit
    | false =>
      rw [hMeta] at hInit
      dsimp at hInit
      cases hB : Trusted.MirSemantics.getElem? pSrc.bodies pSrc.entryDefId with
      | none => rw [hB] at hInit; cases hInit
      | some body =>
        rw [hB] at hInit
        dsimp at hInit
        cases hC1 : !body.acceptsCallerMem && !q.callerMem.allocations.isEmpty with
        | true => rw [hC1] at hInit; cases hInit
        | false =>
          rw [hC1] at hInit
          cases hC2 : body.acceptsCallerMem && !wfExternalCallerMem q.callerMem with
          | true => rw [hC2] at hInit; cases hInit
          | false =>
            rw [hC2] at hInit
            cases hC3 : body.basicBlocks.isEmpty with
            | true => rw [hC3] at hInit; cases hInit
            | false =>
              rw [hC3] at hInit
              cases hC4 : !Nat.blt body.argumentCount body.locals.length with
              | true => rw [hC4] at hInit; cases hInit
              | false =>
                rw [hC4] at hInit
                cases hC5 : !memCopyStorageAnnotationsInBounds body with
                | true => rw [hC5] at hInit; cases hInit
                | false =>
                  rw [hC5] at hInit
                  cases hC6 : !allMemCopyLocalsSupported body.argumentCount body.acceptsCallerMem 0 body.locals with
                  | true => rw [hC6] at hInit; cases hInit
                  | false =>
                    rw [hC6] at hInit
                    dsimp at hInit
                    cases hC7 : !checkMemCopyArgsMatch body.acceptsCallerMem q.callerMem q.args ((body.locals.drop 1).take body.argumentCount) with
                    | true => rw [hC7] at hInit; cases hInit
                    | false =>
                      rw [hC7] at hInit
                      dsimp at hInit
                      rw [← Except.ok.inj hInit]
                      exact Or.inl ⟨hNe, rfl⟩
  | inl hDef =>
    unfold initStateMemCopy at hInit
    unfold initStateMemCopy
    rw [s4_pTgt_pointerWidthBits pack, s4_pTgt_mirProfileVersion pack,
      s4_pTgt_entryDefId pack, hDef, s4_getElem?_pTgt_bodies_eq pack]
    rw [hDef, pack.hBodySrc] at hInit
    dsimp at hInit; dsimp
    rw [pack.hAcceptsFalse, pack.hNonEmpty] at hInit
    rw [s4_allMemCopyLocalsSupported_bodyTgt_iff pack, pack.hAcceptsFalse,
      s4_bodyTgt_acceptsCallerMem pack, s4_bodyTgt_isEmpty_false pack]
    cases hMeta : !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
    | true => rw [hMeta] at hInit; cases hInit
    | false =>
      rw [hMeta] at hInit
      dsimp at hInit; dsimp
      cases hQMem : !q.callerMem.allocations.isEmpty with
      | true => rw [hQMem] at hInit; cases hInit
      | false =>
        rw [hQMem] at hInit
        have hArgSrc : Nat.blt pack.bodySrc.argumentCount pack.bodySrc.locals.length = true :=
          (nat_blt_eq_lt _ _).mpr (Nat.lt_trans pack.hArgLtBuf pack.hBufLtLoc)
        have hArgTgt : Nat.blt pack.bodyTgt.argumentCount pack.bodyTgt.locals.length = true := by
          rw [s4_bodyTgt_argumentCount pack, s4_bodyTgt_locals_length pack]
          have hPos : 0 < 1 + 2 * pack.size + 4 := by
            rw [Nat.add_assoc]; exact Nat.zero_lt_succ _
          have hTailLt : pack.bodySrc.locals.length < pack.bodySrc.locals.length + 1 + 2 * pack.size + 4 := by
            rw [Nat.add_assoc pack.bodySrc.locals.length 1 (2 * pack.size),
              Nat.add_assoc pack.bodySrc.locals.length (1 + 2 * pack.size) 4]
            exact Nat.lt_add_of_pos_right hPos
          exact (nat_blt_eq_lt _ _).mpr (Nat.lt_trans (Nat.lt_trans pack.hArgLtBuf pack.hBufLtLoc) hTailLt)
        rw [hArgSrc, pack.hStorage] at hInit
        rw [hArgTgt, s4_memCopyStorageAnnotationsInBounds_bodyTgt pack,
          s4_paramDecls_bodyTgt_eq pack]
        dsimp at hInit; dsimp
        cases hSupp : allMemCopyLocalsSupported pack.bodySrc.argumentCount false 0 pack.bodySrc.locals with
        | false => rw [hSupp] at hInit; cases hInit
        | true =>
          rw [hSupp] at hInit
          dsimp at hInit
          cases hChk : checkMemCopyArgsMatch false q.callerMem q.args
              ((pack.bodySrc.locals.drop 1).take pack.bodySrc.argumentCount) with
          | false => rw [hChk] at hInit; cases hInit
          | true =>
            rw [hChk] at hInit
            dsimp at hInit
            have hQEmpty : q.callerMem.allocations = [] := by
              cases hL : q.callerMem.allocations with
              | nil => rfl
              | cons _ _ => rw [hL] at hQMem; cases hQMem
            let f₁ : MemCopyFrame := {
              defId := plan.defId
              blockIdx := 0
              stmtIdx := 0
              locals := initMemCopyLocalsLoop pack.bodySrc q.args 0 pack.bodySrc.locals
            }
            let mem₁ : CallerMemory := ⟨q.callerMem.allocations ++ buildInternalBufAllocs pack.bodySrc 0 pack.bodySrc.locals⟩
            have hS1 : ({ frames := [f₁], mem := mem₁ } : MemCopyState) = s₁ := Except.ok.inj hInit
            let f₂Init : MemCopyFrame := {
              defId := plan.defId
              blockIdx := 0
              stmtIdx := 0
              locals := initMemCopyLocalsLoop pack.bodyTgt q.args 0 pack.bodyTgt.locals
            }
            let mem₂ : CallerMemory := ⟨q.callerMem.allocations ++ buildInternalBufAllocs pack.bodyTgt 0 pack.bodyTgt.locals⟩
            let s₂Init : MemCopyState := { frames := [f₂Init], mem := mem₂ }
            refine ⟨s₂Init, rfl, Or.inr ?_⟩
            have hMemRel : s4_MemRel pack mem₁ mem₂ := by
              dsimp [s4_MemRel, mem₁, mem₂]
              rw [hQEmpty]
              constructor
              · refine s4_buildInternalBufAllocs_filter_buf pack.bodySrc pack.bodyTgt plan.bufLocal
                  pack.bodySrc.locals.length rfl
                  (fun idx hLt hNe => ⟨s4_getElem?_bodyTgt_locals_lt pack hLt hNe,
                    s4_memCopyHasStorageAnnotation_bodyTgt_prefix pack hLt hNe⟩)
                  (s4_getElem?_bodyTgt_locals_bufLocal pack)
                  (fun idx hGe => ?_)
                cases Nat.lt_or_ge idx pack.bodyTgt.locals.length with
                | inr hGeLen => rw [s4_getElem?_ge_none pack.bodyTgt.locals idx hGeLen]; exact True.intro
