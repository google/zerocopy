private theorem memCopyBlockEq_eq (a b : MemCopyBlock) (h : memCopyBlockEq a b = true) : a = b := by
  cases a with
  | mk sa ta ca =>
    cases b with
    | mk sb tb cb =>
      have h1 := (bool_and_eq_true _ _).mp h
      have h2 := (bool_and_eq_true _ _).mp h1.1
      rw [boolEq_eq ca cb h2.1, listRel_eq_of_eq memCopyStmtEq_eq sa sb h2.2,
        memCopyTermEq_eq ta tb h1.2]

private noncomputable def MemCopyBodyStepEq (a b : MemCopyBody) : Prop :=
  a.argumentCount = b.argumentCount ∧
  a.locals = b.locals ∧
  a.basicBlocks = b.basicBlocks ∧
  a.isUnsafe = b.isUnsafe ∧
  a.acceptsCallerMem = b.acceptsCallerMem

private theorem memCopyBodyEq_stepEq {a b : MemCopyBody} (h : memCopyBodyEq a b = true) :
    MemCopyBodyStepEq a b := by
  unfold memCopyBodyEq at h
  have h1 := (bool_and_eq_true _ _).mp h
  have h2 := (bool_and_eq_true _ _).mp h1.1
  have h3 := (bool_and_eq_true _ _).mp h2.1
  have h4 := (bool_and_eq_true _ _).mp h3.1
  have h5 := (bool_and_eq_true _ _).mp h4.1
  exact ⟨nat_beq_eq _ _ h5.1,
    listRel_eq_of_eq memCopyLocalDeclEq_eq _ _ h5.2,
    listRel_eq_of_eq memCopyBlockEq_eq _ _ h4.2,
    boolEq_eq _ _ h3.2,
    boolEq_eq _ _ h1.2⟩

private theorem memCopyBodyStepEq_hasStorageAnnotation {a b : MemCopyBody}
    (h : MemCopyBodyStepEq a b) (id : LocalId) :
    memCopyHasStorageAnnotation a id = memCopyHasStorageAnnotation b id := by
  unfold memCopyHasStorageAnnotation
  rw [h.2.2.1]

private theorem memCopyBodyStepEq_storageInBounds {a b : MemCopyBody}
    (h : MemCopyBodyStepEq a b) :
    memCopyStorageAnnotationsInBounds a = memCopyStorageAnnotationsInBounds b := by
  unfold memCopyStorageAnnotationsInBounds
  rw [h.2.1, h.2.2.1]

private theorem memCopyBodyStepEq_initLocals {a b : MemCopyBody}
    (h : MemCopyBodyStepEq a b) (args : List Val) :
    ∀ (idx : Nat) (decls : List MemCopyLocalDecl),
      initMemCopyLocalsLoop a args idx decls = initMemCopyLocalsLoop b args idx decls
  | _, [] => rfl
  | idx, d :: ds => by
    unfold initMemCopyLocalsLoop
    rw [h.1, memCopyBodyStepEq_hasStorageAnnotation h idx, memCopyBodyStepEq_initLocals h args (idx + 1) ds]

private theorem memCopyBodyStepEq_buildAllocs {a b : MemCopyBody}
    (h : MemCopyBodyStepEq a b) :
    ∀ (idx : Nat) (decls : List MemCopyLocalDecl),
      buildInternalBufAllocs a idx decls = buildInternalBufAllocs b idx decls
  | _, [] => rfl
  | idx, .base _ :: ds => memCopyBodyStepEq_buildAllocs h (idx + 1) ds
  | idx, .ptrLocal :: ds => memCopyBodyStepEq_buildAllocs h (idx + 1) ds
  | idx, .byteBuf _ _ _ :: ds => by
    unfold buildInternalBufAllocs
    rw [memCopyBodyStepEq_hasStorageAnnotation h idx, memCopyBodyStepEq_buildAllocs h (idx + 1) ds]

private theorem memCopyBodyStepEq_evalStmt {a b : MemCopyBody}
    (h : MemCopyBodyStepEq a b) (frame : MemCopyFrame) (mem : CallerMemory) (stmt : MemCopyStmt) :
    evalMemCopyStmt a frame mem stmt = evalMemCopyStmt b frame mem stmt := by
  cases a with
  | mk acA locA bbsA unsA idA accA =>
    cases b with
    | mk acB locB bbsB unsB idB accB =>
      dsimp [MemCopyBodyStepEq] at h
      have hac := h.1; subst hac
      have hloc := h.2.1; subst hloc
      have hbbs := h.2.2.1; subst hbbs
      have huns := h.2.2.2.1; subst huns
      have hacc := h.2.2.2.2; subst hacc
      cases stmt <;> rfl

private theorem memCopyBodyStepEq_evalTerm {a b : MemCopyBody}
    (h : MemCopyBodyStepEq a b) (bb : MemCopyBlock) (frame : MemCopyFrame) (mem : CallerMemory) :
    evalMemCopyTerm a bb frame mem = evalMemCopyTerm b bb frame mem := by
  cases a with
  | mk acA locA bbsA unsA idA accA =>
    cases b with
    | mk acB locB bbsB unsB idB accB =>
      dsimp [MemCopyBodyStepEq] at h
      have hac := h.1; subst hac
      have hloc := h.2.1; subst hloc
      have hbbs := h.2.2.1; subst hbbs
      have huns := h.2.2.2.1; subst huns
      have hacc := h.2.2.2.2; subst hacc
      cases bb.terminator <;> rfl

private theorem listRel_bodies_getElem? :
    ∀ (bs₁ bs₂ : List MemCopyBody) (i : Nat),
      listRel memCopyBodyEq bs₁ bs₂ = true →
      match Trusted.MirSemantics.getElem? bs₁ i, Trusted.MirSemantics.getElem? bs₂ i with
      | none, none => True
      | some a, some b => MemCopyBodyStepEq a b
      | _, _ => False
  | [], [], _, _ => trivial
  | [], _ :: _, _, h => by cases h
  | _ :: _, [], _, h => by cases h
  | a :: as, b :: bs, 0, h =>
    memCopyBodyEq_stepEq ((bool_and_eq_true _ _).mp h).1
  | _ :: as, _ :: bs, i + 1, h =>
    listRel_bodies_getElem? as bs i ((bool_and_eq_true _ _).mp h).2

private theorem memCopyProgramEq_semEquiv {p₁ p₂ : MemCopyProgram}
    (hEq : memCopyProgramEq p₁ p₂ = true) :
    FullSemanticEquivMemCopy p₁ p₂ := by
  unfold memCopyProgramEq at hEq
  have h1 := (bool_and_eq_true _ _).mp hEq
  have h2 := (bool_and_eq_true _ _).mp h1.1
  have h3 := (bool_and_eq_true _ _).mp h2.1
  have h4 := (bool_and_eq_true _ _).mp h3.1
  have hBodies := h4.1
  have hEntry := nat_beq_eq _ _ h4.2
  have hPtr := nat_beq_eq _ _ h3.2
  have hVer := nat_beq_eq _ _ h2.2
  refine fullSemanticEquivMemCopy_of_step_sim p₁ p₂ Eq ?_ ?_
  · intro q
    have hInitEq : initStateMemCopy p₁ q = initStateMemCopy p₂ q := by
      unfold initStateMemCopy
      rw [hPtr, hVer, hEntry]
      cases !Nat.beq p₂.pointerWidthBits 64 || !Nat.beq p₂.mirProfileVersion 1 with
      | true => rfl
      | false =>
        dsimp
        have hAt := listRel_bodies_getElem? p₁.bodies p₂.bodies p₂.entryDefId hBodies
        cases hB₁ : Trusted.MirSemantics.getElem? p₁.bodies p₂.entryDefId with
        | none =>
          cases hB₂ : Trusted.MirSemantics.getElem? p₂.bodies p₂.entryDefId with
          | none => rfl
          | some _ => rw [hB₁, hB₂] at hAt; exact False.elim hAt
        | some b₁ =>
          cases hB₂ : Trusted.MirSemantics.getElem? p₂.bodies p₂.entryDefId with
          | none => rw [hB₁, hB₂] at hAt; exact False.elim hAt
          | some b₂ =>
            rw [hB₁, hB₂] at hAt
            dsimp
            rw [hAt.1, hAt.2.1, hAt.2.2.1, hAt.2.2.2.2,
              memCopyBodyStepEq_storageInBounds hAt,
              memCopyBodyStepEq_initLocals hAt q.args 0 b₂.locals,
              memCopyBodyStepEq_buildAllocs hAt 0 b₂.locals]
    refine ⟨fun k => by rw [hInitEq], fun s₁ hs₁ => ⟨s₁, by rw [← hInitEq]; exact hs₁, rfl⟩⟩
  · intro s₁ s₂ hR
    subst hR
    have hStepEq : evalStepMemCopy p₁ 0 s₁ = evalStepMemCopy p₂ 0 s₁ := by
      unfold evalStepMemCopy
      cases s₁.frames with
      | nil => rfl
      | cons frame rest =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          have hAt := listRel_bodies_getElem? p₁.bodies p₂.bodies frame.defId hBodies
          cases hB₁ : Trusted.MirSemantics.getElem? p₁.bodies frame.defId with
          | none =>
            cases hB₂ : Trusted.MirSemantics.getElem? p₂.bodies frame.defId with
            | none => rfl
            | some _ => rw [hB₁, hB₂] at hAt; exact False.elim hAt
          | some b₁ =>
            cases hB₂ : Trusted.MirSemantics.getElem? p₂.bodies frame.defId with
            | none => rw [hB₁, hB₂] at hAt; exact False.elim hAt
            | some b₂ =>
              rw [hB₁, hB₂] at hAt
              dsimp
              rw [hAt.2.2.1]
              cases Trusted.MirSemantics.getElem? b₂.basicBlocks frame.blockIdx with
              | none => rfl
              | some bb =>
                dsimp
                cases Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
                | some stmt => exact memCopyBodyStepEq_evalStmt hAt frame s₁.mem stmt
                | none =>
                  cases Nat.beq frame.stmtIdx bb.statements.length with
                  | true => exact memCopyBodyStepEq_evalTerm hAt bb frame s₁.mem
                  | false => rfl
    refine ⟨fun s₁' h => ⟨s₁', by rw [← hStepEq]; exact h, rfl⟩,
      fun out h => by rw [← hStepEq]; exact h,
      fun k h => by rw [← hStepEq]; exact h⟩

