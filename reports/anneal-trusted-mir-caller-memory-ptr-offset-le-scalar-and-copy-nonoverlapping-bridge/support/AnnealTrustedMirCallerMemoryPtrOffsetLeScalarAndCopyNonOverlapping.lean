                have hSub : n - (k + 1) ≤ n - 1 := Nat.sub_le_sub_left (Nat.succ_le_succ (Nat.zero_le k)) n
                have hN1 : n - 1 ≤ nB := Nat.sub_le_of_le_add hN
                exact Nat.le_trans hSub hN1
              cases ihN (μ s₁') (n - (k + 1)) s₁' s₂Mid s₂' fk hRemLe (Nat.le_refl _) hs₂Mid.2 hB.2 hFault with
              | intro s₁'' hs₁'' =>
                have hS := (stepMemCopy_iff_evalStep p₁ s₁ (.step s₁')).mpr hEval
                exact ⟨s₁'', c_reachesMemCopy_head hS hs₁''.1, hs₁''.2⟩

private theorem fullSemanticEquivMemCopy_of_fwd_stutter_sim
    (p₁ p₂ : MemCopyProgram)
    (R : MemCopyState → MemCopyState → Prop)
    (μ : MemCopyState → Nat)
    (hInit : ∀ q : Query,
      (∀ k : FaultKind, initStateMemCopy p₁ q = .error k ↔ initStateMemCopy p₂ q = .error k) ∧
      (∀ s₁ : MemCopyState, initStateMemCopy p₁ q = .ok s₁ →
        ∃ s₂ : MemCopyState, initStateMemCopy p₂ q = .ok s₂ ∧ R s₁ s₂))
    (hStep : ∀ (s₁ s₂ : MemCopyState), R s₁ s₂ →
      (∀ s₁' : MemCopyState, evalStepMemCopy p₁ 0 s₁ = .step s₁' →
        (R s₁' s₂ ∧ μ s₁' < μ s₁) ∨
        (∃ s₂' : MemCopyState, ReachesPlusMemCopy p₂ s₂ s₂' ∧ R s₁' s₂')) ∧
      (∀ out : TerminalOut, evalStepMemCopy p₁ 0 s₁ = .done out →
        ∃ s₂' : MemCopyState,
          ReachesMemCopy p₂ s₂ s₂' ∧ StepMemCopy p₂ s₂' (.done out)) ∧
      (∀ k : FaultKind, evalStepMemCopy p₁ 0 s₁ = .fault k →
        ∃ s₂' : MemCopyState,
          ReachesMemCopy p₂ s₂ s₂' ∧ StepMemCopy p₂ s₂' (.fault k))) :
    FullSemanticEquivMemCopy p₁ p₂ := by
  refine fullSemanticEquivMemCopy_of_outcomes p₁ p₂ ?_ ?_
  · intro q out
    unfold BehaviorMemCopy ReachesResultMemCopy
    cases hI₁ : initStateMemCopy p₁ q with
    | error k₁ =>
      have hI₂ := ((hInit q).1 k₁).mp hI₁
      rw [hI₂]
    | ok s₁ =>
      cases (hInit q).2 s₁ hI₁ with
      | intro s₂ hs₂ =>
        rw [hs₂.1]
        constructor
        · intro h
          cases h with
          | intro s₁' hs₁' =>
            cases fwd_stutter_reaches_memCopy hStep hs₁'.1 hs₂.2 with
            | intro s₂Mid hs₂Mid =>
              have hEval := (stepMemCopy_iff_evalStep p₁ s₁' (.done out)).mp hs₁'.2
              cases (hStep s₁' s₂Mid hs₂Mid.2).2.1 out hEval with
              | intro s₂' hs₂' =>
                exact ⟨s₂', c_reachesMemCopy_trans hs₂Mid.1 hs₂'.1, hs₂'.2⟩
        · intro h
          cases h with
          | intro s₂' hs₂' =>
            cases reachesNMemCopy_of_reachesMemCopy hs₂'.1 with
            | intro n hn =>
              exact bwd_stutter_memCopy_done_aux hStep n (μ s₁) n s₁ s₂ s₂' out
                (Nat.le_refl n) (Nat.le_refl (μ s₁)) hs₂.2 hn hs₂'.2
  · intro q k
    unfold ReachesResultMemCopy
    cases hI₁ : initStateMemCopy p₁ q with
    | error k₁ =>
      have hI₂ := ((hInit q).1 k₁).mp hI₁
      rw [hI₂]
    | ok s₁ =>
      cases (hInit q).2 s₁ hI₁ with
      | intro s₂ hs₂ =>
        rw [hs₂.1]
        constructor
        · intro h
          cases h with
          | intro s₁' hs₁' =>
            cases fwd_stutter_reaches_memCopy hStep hs₁'.1 hs₂.2 with
            | intro s₂Mid hs₂Mid =>
              have hEval := (stepMemCopy_iff_evalStep p₁ s₁' (.fault k)).mp hs₁'.2
              cases (hStep s₁' s₂Mid hs₂Mid.2).2.2 k hEval with
              | intro s₂' hs₂' =>
                exact ⟨s₂', c_reachesMemCopy_trans hs₂Mid.1 hs₂'.1, hs₂'.2⟩
        · intro h
          cases h with
          | intro s₂' hs₂' =>
            cases reachesNMemCopy_of_reachesMemCopy hs₂'.1 with
            | intro n hn =>
              exact bwd_stutter_memCopy_fault_aux hStep n (μ s₁) n s₁ s₂ s₂' k
                (Nat.le_refl n) (Nat.le_refl (μ s₁)) hs₂.2 hn hs₂'.2

private theorem fullSemanticEquivMemCopy_of_step_sim
    (p₁ p₂ : MemCopyProgram)
    (R : MemCopyState → MemCopyState → Prop)
    (hInit : ∀ q : Query,
      (∀ k : FaultKind, initStateMemCopy p₁ q = .error k ↔ initStateMemCopy p₂ q = .error k) ∧
      (∀ s₁ : MemCopyState, initStateMemCopy p₁ q = .ok s₁ →
        ∃ s₂ : MemCopyState, initStateMemCopy p₂ q = .ok s₂ ∧ R s₁ s₂))
    (hStep : ∀ (s₁ s₂ : MemCopyState), R s₁ s₂ →
      (∀ s₁' : MemCopyState, evalStepMemCopy p₁ 0 s₁ = .step s₁' →
        ∃ s₂' : MemCopyState, evalStepMemCopy p₂ 0 s₂ = .step s₂' ∧ R s₁' s₂') ∧
      (∀ out : TerminalOut, evalStepMemCopy p₁ 0 s₁ = .done out →
        evalStepMemCopy p₂ 0 s₂ = .done out) ∧
      (∀ k : FaultKind, evalStepMemCopy p₁ 0 s₁ = .fault k →
        evalStepMemCopy p₂ 0 s₂ = .fault k)) :
    FullSemanticEquivMemCopy p₁ p₂ := by
  refine fullSemanticEquivMemCopy_of_fwd_stutter_sim p₁ p₂ R (fun _ => 0) hInit ?_
  intro s₁ s₂ hR
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hEval
    cases (hStep s₁ s₂ hR).1 s₁' hEval with
    | intro s₂' hs₂' =>
      have hStep₂ : StepMemCopy p₂ s₂ (.step s₂') :=
        (stepMemCopy_iff_evalStep p₂ s₂ (.step s₂')).mpr hs₂'.1
      exact Or.inr ⟨s₂', ⟨0, .succ hStep₂ (.zero s₂')⟩, hs₂'.2⟩
  · intro out hEval
    have hDone := (hStep s₁ s₂ hR).2.1 out hEval
    exact ⟨s₂, ReachesMemCopy.refl s₂,
      (stepMemCopy_iff_evalStep p₂ s₂ (.done out)).mpr hDone⟩
  · intro k hEval
    have hFault := (hStep s₁ s₂ hR).2.2 k hEval
    exact ⟨s₂, ReachesMemCopy.refl s₂,
      (stepMemCopy_iff_evalStep p₂ s₂ (.fault k)).mpr hFault⟩

