/-! ## Part A: Conservative Extension (`M_memcopy` over Base MIR) -/

private theorem getElem?_map {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat),
      Trusted.MirSemantics.getElem? (xs.map f) i =
        Option.map f (Trusted.MirSemantics.getElem? xs i)
  | [], 0 => rfl
  | [], _ + 1 => rfl
  | _ :: _, 0 => rfl
  | _ :: xs, i + 1 => getElem?_map f xs i

private theorem setElem?_map {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat) (v : α),
      Trusted.MirSemantics.setElem? (xs.map f) i (f v) =
        Option.map (List.map f) (Trusted.MirSemantics.setElem? xs i v)
  | [], 0, _ => rfl
  | [], _ + 1, _ => rfl
  | _ :: _, 0, _ => rfl
  | x :: xs, i + 1, v => by
    change (match Trusted.MirSemantics.setElem? (xs.map f) i (f v) with
            | some xs' => some (f x :: xs')
            | none => none) =
           Option.map (List.map f)
             (match Trusted.MirSemantics.setElem? xs i v with
              | some xs' => some (x :: xs')
              | none => none)
    rw [setElem?_map f xs i v]
    cases Trusted.MirSemantics.setElem? xs i v <;> rfl

private theorem evalMemCopyBaseOperandToSlot_map_base :
    ∀ (tys : List MirTy) (slots : List LocalSlot) (op : Operand),
      evalMemCopyBaseOperandToSlot (tys.map MemCopyLocalDecl.base)
          (slots.map MemCopySlot.baseSlot) op =
        match evalOperandToSlot tys slots op with
        | .error k => .error k
        | .ok (ty, optVal, slots') => .ok (ty, optVal, slots'.map MemCopySlot.baseSlot)
  | tys, slots, .copy place => by
    unfold evalMemCopyBaseOperandToSlot evalOperandToSlot
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases Trusted.MirSemantics.getElem? slots place.localId with
        | none => rfl
        | some sl => cases sl <;> rfl
  | tys, slots, .move place => by
    unfold evalMemCopyBaseOperandToSlot evalOperandToSlot
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases Trusted.MirSemantics.getElem? slots place.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | live _ =>
            dsimp
            rw [setElem?_map MemCopySlot.baseSlot slots place.localId (liveUninitSlot ty)]
            cases Trusted.MirSemantics.setElem? slots place.localId (liveUninitSlot ty) <;> rfl
  | _, _, .constant c => by
    unfold evalMemCopyBaseOperandToSlot evalOperandToSlot
    dsimp
    cases evalConstLit c.ty c.lit <;> rfl

private theorem evalMemCopyPrimitiveOperand_map_base (tys : List MirTy)
    (slots : List LocalSlot) (op : Operand) :
    evalMemCopyPrimitiveOperand (tys.map MemCopyLocalDecl.base)
        (slots.map MemCopySlot.baseSlot) op =
      match evalPrimitiveOperand tys slots op with
      | .error k => .error k
      | .ok (v, slots') => .ok (v, slots'.map MemCopySlot.baseSlot) := by
  unfold evalMemCopyPrimitiveOperand evalPrimitiveOperand
  rw [evalMemCopyBaseOperandToSlot_map_base]
  cases evalOperandToSlot tys slots op with
  | error _ => rfl
  | ok p1 =>
    cases p1 with
    | mk ty p2 =>
      cases p2 with
      | mk ov slots₁ =>
        dsimp
        cases isPrimitiveReadableTy ty with
        | false => rfl
        | true => cases ov <;> rfl

private theorem evalMemCopyBaseRvalue_map_base (tys : List MirTy)
    (slots : List LocalSlot) (dstTy : MirTy) (rv : Rvalue) :
    evalMemCopyBaseRvalue (tys.map MemCopyLocalDecl.base)
        (slots.map MemCopySlot.baseSlot) dstTy rv =
      match evalRvalue tys slots dstTy rv with
      | .error k => .error k
      | .ok (v, slots') => .ok (v, slots'.map MemCopySlot.baseSlot) := by
  cases rv with
  | use op =>
    unfold evalMemCopyBaseRvalue evalRvalue
    dsimp
    rw [evalMemCopyBaseOperandToSlot_map_base]
    cases evalOperandToSlot tys slots op with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk srcTy p2 =>
        cases p2 with
        | mk ov slots₁ =>
          dsimp
          cases MirTy.beq srcTy dstTy with
          | false => rfl
          | true => cases ov <;> rfl
  | binaryOp op lhs rhs =>
    unfold evalMemCopyBaseRvalue evalRvalue
    dsimp
    rw [evalMemCopyPrimitiveOperand_map_base]
    cases evalPrimitiveOperand tys slots lhs with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk lVal slots₁ =>
        dsimp
        rw [evalMemCopyPrimitiveOperand_map_base]
        cases evalPrimitiveOperand tys slots₁ rhs with
        | error _ => rfl
        | ok p2 =>
          cases p2 with
          | mk rVal slots₂ =>
            dsimp
            cases evalBinOp op lVal rVal <;> rfl
  | unaryOp op opnd =>
    unfold evalMemCopyBaseRvalue evalRvalue
    dsimp
    rw [evalMemCopyPrimitiveOperand_map_base]
    cases evalPrimitiveOperand tys slots opnd with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk v slots₁ =>
        dsimp
        cases evalUnOp op v <;> rfl
  | discriminant place =>
    unfold evalMemCopyBaseRvalue evalRvalue
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases ty with
        | bool | int _ _ | unit | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported => rfl
        | enum ety =>
          cases Trusted.MirSemantics.getElem? slots place.localId with
          | none => rfl
          | some slot =>
            dsimp
            cases enumAdmitted ety with
            | false => rfl
            | true =>
              dsimp
              cases ety with
              | mk eid edw eds etr ediscs =>
                dsimp
                cases etr with
                | zeroSized =>
                  cases slot with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none =>
                      dsimp
                      cases Trusted.MirSemantics.getElem? ediscs 0 <;> rfl
                    | some val =>
                      cases val with
                      | bool _ | scalar _ | unit | ptr _ | tuple _ | bytes _ => rfl
                      | enumVal ety' v =>
                        dsimp
                        cases (EnumTy.beq ⟨eid, edw, eds, .zeroSized, ediscs⟩ ety' && Nat.beq v 0) with
                        | false => rfl
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? ediscs 0 <;> rfl
                | scalar tw ts =>
                  cases slot with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none => rfl
                    | some val =>
                      cases val with
                      | bool _ | scalar _ | unit | ptr _ | tuple _ | bytes _ => rfl
                      | enumVal ety' v =>
                        dsimp
                        cases (EnumTy.beq ⟨eid, edw, eds, .scalar tw ts, ediscs⟩ ety' &&
                            Nat.blt v ediscs.length) with
                        | false => rfl
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? ediscs v <;> rfl
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported => rfl

private theorem writeMemCopyBasePlace_map_base (slots : List LocalSlot)
    (dstLocalId : LocalId) (dstTy : MirTy) (val : Val) :
    writeMemCopyBasePlace (slots.map MemCopySlot.baseSlot) dstLocalId dstTy val =
      match writePlace slots dstLocalId dstTy val with
      | .error k => .error k
      | .ok slots' => .ok (slots'.map MemCopySlot.baseSlot) := by
  unfold writeMemCopyBasePlace writePlace
  cases checkVal val dstTy with
  | false => rfl
  | true =>
    dsimp
    rw [getElem?_map]
    cases Trusted.MirSemantics.getElem? slots dstLocalId with
    | none => rfl
    | some sl =>
      cases sl with
      | dead => rfl
      | live _ =>
        dsimp
        rw [setElem?_map MemCopySlot.baseSlot slots dstLocalId (.live (some val))]
        cases Trusted.MirSemantics.setElem? slots dstLocalId (.live (some val)) <;> rfl

private theorem embedBaseBody_hasInternalBufs_false (locals : List MirTy) :
    (locals.map MemCopyLocalDecl.base).any (fun lt =>
      match lt with
      | .byteBuf _ _ _ => true
      | _ => false) = false := by
  induction locals with
  | nil => rfl
  | cons _ xs ih =>
    change (false || (xs.map MemCopyLocalDecl.base).any _) = false
    exact ih

private theorem buildInternalBufAllocs_embedBase (body : Body) :
    ∀ (locals : List MirTy) (i : Nat),
      buildInternalBufAllocs (embedBaseBody body) i (locals.map MemCopyLocalDecl.base) = []
  | [], _ => rfl
  | _ :: xs, i => buildInternalBufAllocs_embedBase body xs (i + 1)

private theorem evalMemCopyStmt_embedBase (body : Body) (frame : FrameState)
    (callerMem : CallerMemory) (stmt : StatementKind) :
    evalMemCopyStmt (embedBaseBody body) (embedMemCopyFrame frame) callerMem
        (.baseStmt stmt) =
      liftStepResultMemCopy (evalStatement body frame callerMem stmt) := by
  cases stmt with
  | nop => rfl
  | unsupported => rfl
  | storageLive localId =>
    unfold evalMemCopyStmt evalStatement embedBaseBody embedMemCopyFrame
    dsimp
    rw [getElem?_map]
    cases Trusted.MirSemantics.getElem? body.locals localId with
    | none => rfl
    | some localTy =>
      dsimp [liveUninitMemCopySlot, stepMemCopyNext, liftStepResultMemCopy,
        embedMemCopyState, embedMemCopyFrame]
      rw [setElem?_map MemCopySlot.baseSlot frame.locals localId (liveUninitSlot localTy)]
      cases Trusted.MirSemantics.setElem? frame.locals localId (liveUninitSlot localTy) <;> rfl
  | storageDead localId =>
    unfold evalMemCopyStmt evalStatement embedBaseBody embedMemCopyFrame
    dsimp
    cases Nat.beq localId 0 with
    | true => rfl
    | false =>
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? body.locals localId with
      | none =>
        dsimp [stepMemCopyNext, liftStepResultMemCopy, embedMemCopyState, embedMemCopyFrame]
        rw [setElem?_map MemCopySlot.baseSlot frame.locals localId .dead]
        cases Trusted.MirSemantics.setElem? frame.locals localId .dead <;> rfl
      | some _ =>
        dsimp [deadMemCopySlot, stepMemCopyNext, liftStepResultMemCopy,
          embedMemCopyState, embedMemCopyFrame]
        rw [setElem?_map MemCopySlot.baseSlot frame.locals localId .dead]
        cases Trusted.MirSemantics.setElem? frame.locals localId .dead <;> rfl
  | assign dst rvalue =>
    unfold evalMemCopyStmt evalStatement embedBaseBody embedMemCopyFrame
    dsimp
    cases dst.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? body.locals dst.localId with
      | none => rfl
      | some dstTy =>
        dsimp
        rw [evalMemCopyBaseRvalue_map_base]
        cases evalRvalue body.locals frame.locals dstTy rvalue with
        | error _ => rfl
        | ok p1 =>
          cases p1 with
          | mk val localsAfterRval =>
            dsimp
            rw [writeMemCopyBasePlace_map_base]
            cases writePlace localsAfterRval dst.localId dstTy val <;> rfl

private theorem list_any_map_false {α β : Type} (f : α → β) (p : β → Bool)
    (hp : ∀ x : α, p (f x) = false) : ∀ xs : List α, (xs.map f).any p = false
  | [] => rfl
  | x :: xs => by
    change (p (f x) || (xs.map f).any p) = false
    rw [hp x, list_any_map_false f p hp xs]
    rfl

private theorem evalMemCopyTerm_embedBase (body : Body) (bb : BasicBlock)
    (frame : FrameState) (callerMem : CallerMemory) :
    evalMemCopyTerm (embedBaseBody body) (embedBaseBlock bb)
        (embedMemCopyFrame frame) callerMem =
      liftStepResultMemCopy (evalTerminator body bb frame callerMem) := by
  unfold evalMemCopyTerm evalTerminator embedBaseBody embedBaseBlock embedMemCopyFrame
  dsimp
  cases bb.terminator with
  | goto _ => rfl
  | return_ =>
    dsimp
    cases bb.cleanup with
    | true => rfl
    | false =>
      dsimp
      rw [list_any_map_false MemCopyLocalDecl.base _ (fun _ => rfl)]
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? body.locals 0 with
      | none =>
        cases Trusted.MirSemantics.getElem? frame.locals 0 with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | live ov => cases ov <;> rfl
      | some _ =>
        cases Trusted.MirSemantics.getElem? frame.locals 0 with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | live ov => cases ov <;> rfl
  | unreachable => rfl
  | switchInt discr targets =>
    dsimp
    rw [evalMemCopyPrimitiveOperand_map_base]
    cases evalPrimitiveOperand body.locals frame.locals discr with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk discrVal localsAfterDiscr =>
        dsimp
        cases discrVal with
        | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => rfl
        | scalar sv =>
          dsimp
          cases evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches <;> rfl
        | bool b =>
          dsimp
          cases evalBoolSwitchBranches b targets.otherwise targets.branches <;> rfl
  | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported => rfl

private theorem evalStepMemCopy_embedBaseProgram (p : Program) (c : Choice) (s : State) :
    evalStepMemCopy (embedBaseProgram p) c (embedMemCopyState s) =
      liftStepResultMemCopy (evalStep p c s) := by
  cases s with
  | mk frames callerMem =>
    cases frames with
    | nil => rfl
    | cons frame rest =>
      cases rest with
      | cons _ _ => rfl
      | nil =>
        unfold evalStepMemCopy evalStep embedBaseProgram embedMemCopyState
        dsimp [List.map, embedMemCopyFrame]
        rw [getElem?_map]
        cases Trusted.MirSemantics.getElem? p.bodies frame.defId with
        | none => rfl
        | some body =>
          dsimp
          unfold embedBaseBody
          dsimp
          rw [getElem?_map]
          cases Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
          | none => rfl
          | some bb =>
            dsimp [embedBaseBlock]
            rw [getElem?_map]
            cases Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
            | some stmt => exact evalMemCopyStmt_embedBase body frame callerMem stmt
            | none =>
              rw [list_map_length]
              cases Nat.beq frame.stmtIdx bb.statements.length with
              | true => exact evalMemCopyTerm_embedBase body bb frame callerMem
              | false => rfl

private theorem memCopyHasStorageAnnotation_embedBase (body : Body) (id : LocalId) :
    memCopyHasStorageAnnotation (embedBaseBody body) id = hasStorageAnnotation body id := by
  unfold memCopyHasStorageAnnotation hasStorageAnnotation embedBaseBody
  dsimp
  have hAux : ∀ blocks : List BasicBlock,
      (blocks.map embedBaseBlock).any (fun bb =>
        bb.statements.any (memCopyStmtHasStorageMarker id)) =
      blocks.any (fun bb => bb.statements.any (stmtHasStorageMarker id)) := by
    intro blocks
    induction blocks with
    | nil => rfl
    | cons bb rest ih =>
      have hSt : (bb.statements.map MemCopyStmt.baseStmt).any (memCopyStmtHasStorageMarker id) =
          bb.statements.any (stmtHasStorageMarker id) := by
        induction bb.statements with
        | nil => rfl
        | cons st sts ihs =>
          have h1 : memCopyStmtHasStorageMarker id (.baseStmt st) = stmtHasStorageMarker id st := rfl
          change (memCopyStmtHasStorageMarker id (.baseStmt st) ||
              (sts.map MemCopyStmt.baseStmt).any (memCopyStmtHasStorageMarker id)) =
            (stmtHasStorageMarker id st || sts.any (stmtHasStorageMarker id))
          rw [h1, ihs]
      change ((bb.statements.map MemCopyStmt.baseStmt).any (memCopyStmtHasStorageMarker id) ||
          (rest.map embedBaseBlock).any (fun bb =>
            bb.statements.any (memCopyStmtHasStorageMarker id))) =
        (bb.statements.any (stmtHasStorageMarker id) ||
          rest.any (fun bb => bb.statements.any (stmtHasStorageMarker id)))
      rw [hSt, ih]
  exact hAux body.basicBlocks

private theorem memCopyStmtBound_embedBase (n : Nat) (st : StatementKind) :
    (match MemCopyStmt.baseStmt st with
     | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
     | _ => true) =
    (match st with
     | .storageLive id | .storageDead id => Nat.blt id n
     | _ => true) := by
  cases st <;> rfl

private theorem memCopyStorageAnnotationsInBounds_embedBase (body : Body) :
    memCopyStorageAnnotationsInBounds (embedBaseBody body) = storageAnnotationsInBounds body := by
  unfold memCopyStorageAnnotationsInBounds storageAnnotationsInBounds embedBaseBody
  dsimp
  rw [list_map_length]
  have hAux : ∀ (n : Nat) (blocks : List BasicBlock),
      (blocks.map embedBaseBlock).all (fun bb =>
        bb.statements.all (fun stmt =>
          match stmt with
          | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
          | _ => true)) =
      blocks.all (fun bb =>
        bb.statements.all (fun stmt =>
          match stmt with
          | .storageLive id | .storageDead id => Nat.blt id n
          | _ => true)) := by
    intro n blocks
    induction blocks with
    | nil => rfl
    | cons bb rest ih =>
      have hSt : (bb.statements.map MemCopyStmt.baseStmt).all (fun stmt =>
            match stmt with
            | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
            | _ => true) =
          bb.statements.all (fun stmt =>
            match stmt with
            | .storageLive id | .storageDead id => Nat.blt id n
            | _ => true) := by
        induction bb.statements with
        | nil => rfl
        | cons st sts ihs =>
          change ((match MemCopyStmt.baseStmt st with
              | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
              | _ => true) &&
              (sts.map MemCopyStmt.baseStmt).all (fun stmt =>
                match stmt with
                | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
                | _ => true)) =
            ((match st with
              | .storageLive id | .storageDead id => Nat.blt id n
              | _ => true) &&
              sts.all (fun stmt =>
                match stmt with
                | .storageLive id | .storageDead id => Nat.blt id n
                | _ => true))
          rw [memCopyStmtBound_embedBase n st, ihs]
      change ((bb.statements.map MemCopyStmt.baseStmt).all (fun stmt =>
            match stmt with
            | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
            | _ => true) &&
          (rest.map embedBaseBlock).all (fun bb =>
            bb.statements.all (fun stmt =>
              match stmt with
              | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id n
              | _ => true))) =
        (bb.statements.all (fun stmt =>
            match stmt with
            | .storageLive id | .storageDead id => Nat.blt id n
            | _ => true) &&
          rest.all (fun bb =>
            bb.statements.all (fun stmt =>
              match stmt with
              | .storageLive id | .storageDead id => Nat.blt id n
              | _ => true)))
      rw [hSt, ih]
  exact hAux body.locals.length body.basicBlocks

private theorem allMemCopyLocalsSupported_embedBase (argCount : Nat) :
    ∀ (idx : Nat) (locals : List MirTy),
      allMemCopyLocalsSupported argCount false idx (locals.map MemCopyLocalDecl.base) =
        locals.all isSupportedScalarOrUnitTy
  | _, [] => rfl
  | idx, ty :: rest => by
    change (isSupportedScalarOrUnitTy ty &&
        allMemCopyLocalsSupported argCount false (idx + 1) (rest.map MemCopyLocalDecl.base)) =
      (isSupportedScalarOrUnitTy ty && rest.all isSupportedScalarOrUnitTy)
    rw [allMemCopyLocalsSupported_embedBase argCount (idx + 1) rest]

private theorem checkMemCopyArgsMatch_embedBase (extMem : CallerMemory) :
    ∀ (args : List Val) (tys : List MirTy),
      checkMemCopyArgsMatch false extMem args (tys.map MemCopyLocalDecl.base) =
        checkArgsMatch args tys
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | v :: vs, ty :: ts => by
    change (checkVal v ty && checkMemCopyArgsMatch false extMem vs (ts.map MemCopyLocalDecl.base)) =
      (checkVal v ty && checkArgsMatch vs ts)
    rw [checkMemCopyArgsMatch_embedBase extMem vs ts]

private theorem initMemCopyLocalsLoop_embedBase (body : Body) (args : List Val) :
    ∀ (idx : Nat) (tys : List MirTy),
      initMemCopyLocalsLoop (embedBaseBody body) args idx (tys.map MemCopyLocalDecl.base) =
        (initLocalsLoop body args idx tys).map MemCopySlot.baseSlot
  | _, [] => rfl
  | idx, ty :: rest => by
    have hHas := memCopyHasStorageAnnotation_embedBase body idx
    have hRec := initMemCopyLocalsLoop_embedBase body args (idx + 1) rest
    change (if Nat.beq idx 0 then
          liveUninitMemCopySlot (.base ty)
        else if Nat.ble idx body.argumentCount then
          match Trusted.MirSemantics.getElem? args (idx - 1), MemCopyLocalDecl.base ty with
          | some (.ptr pv), .ptrLocal => .livePtr (some pv)
          | some v, .base _ => .baseSlot (.live (some v))
          | _, _ => deadMemCopySlot (.base ty)
        else if memCopyHasStorageAnnotation (embedBaseBody body) idx then
          deadMemCopySlot (.base ty)
        else
          liveUninitMemCopySlot (.base ty)) ::
          initMemCopyLocalsLoop (embedBaseBody body) args (idx + 1)
            (rest.map MemCopyLocalDecl.base) =
      MemCopySlot.baseSlot (if Nat.beq idx 0 then
          liveUninitSlot ty
        else if Nat.ble idx body.argumentCount then
          match Trusted.MirSemantics.getElem? args (idx - 1) with
          | some v => .live (some v)
          | none => .dead
        else if hasStorageAnnotation body idx then
          .dead
        else
          liveUninitSlot ty) ::
        (initLocalsLoop body args (idx + 1) rest).map MemCopySlot.baseSlot
    rw [hRec, hHas]
    cases Nat.beq idx 0 with
    | true => rfl
    | false =>
      dsimp [deadMemCopySlot, liveUninitMemCopySlot]
      cases Nat.ble idx body.argumentCount with
      | true =>
        cases Trusted.MirSemantics.getElem? args (idx - 1) with
        | none => rfl
        | some v => cases v <;> rfl
      | false =>
        cases hasStorageAnnotation body idx <;> rfl

private theorem list_drop_map {α β : Type} (f : α → β) :
    ∀ (xs : List α) (k : Nat), (xs.map f).drop k = (xs.drop k).map f
  | _, 0 => rfl
  | [], _ + 1 => rfl
  | _ :: xs, k + 1 => list_drop_map f xs k

private theorem list_take_map {α β : Type} (f : α → β) :
    ∀ (xs : List α) (k : Nat), (xs.map f).take k = (xs.take k).map f
  | _, 0 => rfl
  | [], _ + 1 => rfl
  | _ :: xs, k + 1 => by
    change f _ :: (xs.map f).take k = f _ :: (xs.take k).map f
    rw [list_take_map f xs k]

private theorem list_map_isEmpty {α β : Type} (f : α → β) :
    ∀ xs : List α, (xs.map f).isEmpty = xs.isEmpty
  | [] => rfl
  | _ :: _ => rfl

private theorem initStateMemCopy_embedBaseProgram (p : Program) (q : Query) :
    initStateMemCopy (embedBaseProgram p) q =
      match initState p q with
      | .error k => .error k
      | .ok s => .ok (embedMemCopyState s) := by
  unfold initStateMemCopy initState embedBaseProgram
  dsimp
  cases !Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1 with
  | true => rfl
  | false =>
    dsimp
    rw [getElem?_map]
    cases !q.callerMem.allocations.isEmpty with
    | true =>
      dsimp
      cases Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
      | none => rfl
      | some body => dsimp [embedBaseBody]
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
      | none => rfl
      | some body =>
        dsimp [embedBaseBody]
        rw [list_map_length, list_map_isEmpty]
        cases body.basicBlocks.isEmpty with
        | true => rfl
        | false =>
          dsimp
          cases !Nat.blt body.argumentCount body.locals.length with
          | true => rfl
          | false =>
            dsimp
            have hBounds := memCopyStorageAnnotationsInBounds_embedBase body
            change (if !memCopyStorageAnnotationsInBounds (embedBaseBody body) then
                Except.error FaultKind.unsupported
              else if !allMemCopyLocalsSupported body.argumentCount false 0
                  (List.map MemCopyLocalDecl.base body.locals) then
                Except.error FaultKind.unsupported
              else if !checkMemCopyArgsMatch false q.callerMem q.args
                  (List.take body.argumentCount (List.drop 1 (List.map MemCopyLocalDecl.base body.locals))) then
                Except.error FaultKind.unsupported
              else
                Except.ok ({
                  frames := [{
                    defId := p.entryDefId
                    blockIdx := 0
                    stmtIdx := 0
                    locals := initMemCopyLocalsLoop (embedBaseBody body) q.args 0
                      (List.map MemCopyLocalDecl.base body.locals)
                  }]
                  mem := {
                    allocations := q.callerMem.allocations ++
                      buildInternalBufAllocs (embedBaseBody body) 0
                        (List.map MemCopyLocalDecl.base body.locals)
                  }
                } : MemCopyState)) = _
            rw [hBounds, allMemCopyLocalsSupported_embedBase, list_drop_map, list_take_map,
              checkMemCopyArgsMatch_embedBase]
            cases storageAnnotationsInBounds body with
            | false => rfl
            | true =>
              dsimp
              cases body.locals.all isSupportedScalarOrUnitTy with
              | false => rfl
              | true =>
                dsimp
                cases checkArgsMatch q.args ((body.locals.drop 1).take body.argumentCount) with
                | false => rfl
                | true =>
                  dsimp
                  rw [initMemCopyLocalsLoop_embedBase, buildInternalBufAllocs_embedBase,
                    List.append_nil]
                  rfl

private theorem reachesMemCopy_embedBase_fwd (p : Program) {s₁ s₂ : State}
    (h : Reaches p s₁ s₂) :
    ReachesMemCopy (embedBaseProgram p) (embedMemCopyState s₁) (embedMemCopyState s₂) := by
  induction h with
  | refl => exact ReachesMemCopy.refl _
  | @tail s₂ s₃ _ hStep ih =>
    have hEval := (stepBase_iff_evalStep p s₂ (.step s₃)).mp hStep
    have hMc : evalStepMemCopy (embedBaseProgram p) 0 (embedMemCopyState s₂) =
        .step (embedMemCopyState s₃) := by
      rw [evalStepMemCopy_embedBaseProgram, hEval]
      rfl
    exact ReachesMemCopy.tail ih ((stepMemCopy_iff_evalStep _ _ _).mpr hMc)

private theorem reachesMemCopy_embedBase_bwd (p : Program) {s₁ : State} {s₂' : MemCopyState}
    (h : ReachesMemCopy (embedBaseProgram p) (embedMemCopyState s₁) s₂') :
    ∃ s₂ : State, s₂' = embedMemCopyState s₂ ∧ Reaches p s₁ s₂ := by
  induction h with
  | refl => exact ⟨s₁, rfl, Reaches.refl s₁⟩
  | tail _ hStep ih =>
    cases ih with
    | intro sMid hsMid =>
      cases hsMid with
      | intro hEqState hReach =>
        rw [hEqState] at hStep
        have hEval := (stepMemCopy_iff_evalStep (embedBaseProgram p)
          (embedMemCopyState sMid) (.step _)).mp hStep
        rw [evalStepMemCopy_embedBaseProgram] at hEval
        cases hBase : evalStep p 0 sMid with
        | done _ =>
          rw [hBase] at hEval
          cases hEval
        | fault _ =>
          rw [hBase] at hEval
          cases hEval
        | step sNext =>
          rw [hBase] at hEval
          cases hEval
          exact ⟨sNext, rfl, Reaches.tail hReach ((stepBase_iff_evalStep p sMid (.step sNext)).mpr hBase)⟩

private theorem reachesResultMemCopy_embedBase_done (p : Program) (q : Query)
    (out : TerminalOut) :
    ReachesResultMemCopy (embedBaseProgram p) q (.done out) ↔
      ReachesResult p q (.done out) := by
  unfold ReachesResultMemCopy ReachesResult
  rw [initStateMemCopy_embedBaseProgram]
  cases initState p q with
  | error k =>
    constructor <;> intro h <;> cases h
  | ok s₀ =>
    constructor
    · intro h
      cases h with
      | intro s' hs' =>
        cases reachesMemCopy_embedBase_bwd p hs'.1 with
        | intro s hs =>
          rw [hs.1] at hs'
          have hEval := (stepMemCopy_iff_evalStep (embedBaseProgram p)
            (embedMemCopyState s) (.done out)).mp hs'.2
          rw [evalStepMemCopy_embedBaseProgram] at hEval
          cases hBase : evalStep p 0 s with
          | step _ => rw [hBase] at hEval; cases hEval
          | fault _ => rw [hBase] at hEval; cases hEval
          | done out' =>
            rw [hBase] at hEval
            cases hEval
            exact ⟨s, hs.2, (stepBase_iff_evalStep p s (.done out)).mpr hBase⟩
    · intro h
      cases h with
      | intro s hs =>
        have hEval := (stepBase_iff_evalStep p s (.done out)).mp hs.2
        have hMc : evalStepMemCopy (embedBaseProgram p) 0 (embedMemCopyState s) = .done out := by
          rw [evalStepMemCopy_embedBaseProgram, hEval]
          rfl
        exact ⟨embedMemCopyState s, reachesMemCopy_embedBase_fwd p hs.1,
          (stepMemCopy_iff_evalStep _ _ _).mpr hMc⟩

private theorem reachesResultMemCopy_embedBase_fault (p : Program) (q : Query)
    (k : FaultKind) :
    ReachesResultMemCopy (embedBaseProgram p) q (.fault k) ↔
      ReachesResult p q (.fault k) := by
  unfold ReachesResultMemCopy ReachesResult
  rw [initStateMemCopy_embedBaseProgram]
  cases hInit : initState p q with
  | error k₀ =>
    dsimp
    constructor <;> intro h <;> cases h <;> rfl
  | ok s₀ =>
    constructor
    · intro h
      cases h with
      | intro s' hs' =>
        cases reachesMemCopy_embedBase_bwd p hs'.1 with
        | intro s hs =>
          rw [hs.1] at hs'
          have hEval := (stepMemCopy_iff_evalStep (embedBaseProgram p)
            (embedMemCopyState s) (.fault k)).mp hs'.2
          rw [evalStepMemCopy_embedBaseProgram] at hEval
          cases hBase : evalStep p 0 s with
          | step _ => rw [hBase] at hEval; cases hEval
          | done _ => rw [hBase] at hEval; cases hEval
          | fault k' =>
            rw [hBase] at hEval
            cases hEval
            exact ⟨s, hs.2, (stepBase_iff_evalStep p s (.fault k)).mpr hBase⟩
    · intro h
      cases h with
      | intro s hs =>
        have hEval := (stepBase_iff_evalStep p s (.fault k)).mp hs.2
        have hMc : evalStepMemCopy (embedBaseProgram p) 0 (embedMemCopyState s) = .fault k := by
          rw [evalStepMemCopy_embedBaseProgram, hEval]
          rfl
        exact ⟨embedMemCopyState s, reachesMemCopy_embedBase_fwd p hs.1,
          (stepMemCopy_iff_evalStep _ _ _).mpr hMc⟩

private theorem memcopy_conservative_extension_exact_slice1
    (p : Program) :
    (∀ (c : Choice) (s : State),
      evalStepMemCopy (embedBaseProgram p) c (embedMemCopyState s) =
        liftStepResultMemCopy (evalStep p c s)) ∧
    (∀ q : Query,
      (WellFormedMemCopy (embedBaseProgram p) q ↔ WellFormed p q) ∧
      (∀ out : TerminalOut,
        BehaviorMemCopy (embedBaseProgram p) q out ↔ Behavior p q out) ∧
      (∀ k : FaultKind,
        ReachesResultMemCopy (embedBaseProgram p) q (.fault k) ↔
          ReachesResult p q (.fault k)) ∧
      (DivergesMemCopy (embedBaseProgram p) q ↔ Diverges p q) ∧
      (∀ post : TerminalOut → Prop,
        SatisfiesPostMemCopy (embedBaseProgram p) q post ↔
          SatisfiesPost p q post)) := by
  refine ⟨evalStepMemCopy_embedBaseProgram p, ?_⟩
  intro q
  have hBeh : ∀ out : TerminalOut,
      BehaviorMemCopy (embedBaseProgram p) q out ↔ Behavior p q out :=
    fun out => reachesResultMemCopy_embedBase_done p q out
  have hFault : ∀ k : FaultKind,
      ReachesResultMemCopy (embedBaseProgram p) q (.fault k) ↔
        ReachesResult p q (.fault k) :=
    fun k => reachesResultMemCopy_embedBase_fault p q k
  have hWf : WellFormedMemCopy (embedBaseProgram p) q ↔ WellFormed p q := by
    rw [wellFormedMemCopy_iff_no_fault (embedBaseProgram p) q, wellFormedBase_iff_no_fault p q]
    constructor
    · intro h k hk
      exact h k ((hFault k).mpr hk)
    · intro h k hk
      exact h k ((hFault k).mp hk)
  have hDiv : DivergesMemCopy (embedBaseProgram p) q ↔ Diverges p q := by
    rw [divergesMemCopy_iff_no_terminal_or_fault (embedBaseProgram p) q,
      divergesBase_iff_no_terminal_or_fault p q]
    constructor
    · intro h
      have hNoFaultB : ∀ k : FaultKind, ¬ ReachesResult p q (.fault k) :=
        fun k hk => h.2.2 k ((hFault k).mpr hk)
      have hInitB : ∃ s₀ : State, initState p q = .ok s₀ := by
        cases hI : initState p q with
        | ok s₀ => exact ⟨s₀, rfl⟩
        | error k =>
          have hF : ReachesResult p q (.fault k) := by
            unfold ReachesResult
            rw [hI]
          exact False.elim (hNoFaultB k hF)
      exact ⟨hInitB, fun out hB => h.2.1 out ((hBeh out).mpr hB), hNoFaultB⟩
    · intro h
      have hNoFaultM : ∀ k : FaultKind, ¬ ReachesResultMemCopy (embedBaseProgram p) q (.fault k) :=
        fun k hk => h.2.2 k ((hFault k).mp hk)
      have hInitM : ∃ s₀ : MemCopyState, initStateMemCopy (embedBaseProgram p) q = .ok s₀ := by
        cases hI : initStateMemCopy (embedBaseProgram p) q with
        | ok s₀ => exact ⟨s₀, rfl⟩
        | error k =>
          have hF : ReachesResultMemCopy (embedBaseProgram p) q (.fault k) := by
            unfold ReachesResultMemCopy
            rw [hI]
          exact False.elim (hNoFaultM k hF)
      exact ⟨hInitM, fun out hB => h.2.1 out ((hBeh out).mp hB), hNoFaultM⟩
  have hPost : ∀ post : TerminalOut → Prop,
      SatisfiesPostMemCopy (embedBaseProgram p) q post ↔ SatisfiesPost p q post := by
    intro post
    unfold SatisfiesPostMemCopy SatisfiesPost
    constructor
    · intro h
      exact ⟨hWf.mp h.1, fun out hb => h.2 out ((hBeh out).mpr hb)⟩
    · intro h
      exact ⟨hWf.mpr h.1, fun out hb => h.2 out ((hBeh out).mp hb)⟩
  exact ⟨hWf, hBeh, hFault, hDiv, hPost⟩

/-! ## Part B: Exact Operational Laws (Theorem 3) -/

private theorem int_zero_lt_neg_pos (k : Nat) (hk : 0 < k) :
    ¬ ((0 : Int) < Neg.neg (Int.ofNat k)) := by
  cases k with
  | zero => exact False.elim (Nat.lt_irrefl 0 hk)
  | succ m =>
    intro hlt
    change (0 : Int) < Int.negSucc m at hlt
    cases hlt

private theorem int_ofNat_lt_zero (n : Nat) : ¬ (Int.ofNat n < (0 : Int)) := by
  intro hlt
  cases hlt

private theorem nat_sub_add_comm_local {a b c : Nat} (h : b ≤ a) :
    (a - b) + c = (a + c) - b := by
  have h1 : (a - b) + c + b = (a + c) - b + b := by
    rw [Nat.sub_add_cancel (Nat.le_trans h (Nat.le_add_right a c))]
    rw [Nat.add_assoc, Nat.add_comm c b, ← Nat.add_assoc, Nat.sub_add_cancel h]
  exact Nat.add_right_cancel h1

private theorem int_subNatNat_of_le {a b : Nat} (h : b ≤ a) :
    Int.subNatNat a b = Int.ofNat (a - b) := by
  unfold Int.subNatNat
  rw [Nat.sub_eq_zero_of_le h]

private theorem int_subNatNat_of_lt {a b : Nat} (h : a < b) :
    Int.subNatNat a b = Int.negSucc (b - a - 1) := by
  unfold Int.subNatNat
  have hPos : 0 < b - a := Nat.sub_pos_of_lt h
  have hSub : b - a = (b - a - 1) + 1 := (Nat.sub_add_cancel hPos).symm
  rw [hSub]
  rfl

private theorem int_ofNat_lt {a b : Nat} (h : a < b) : Int.ofNat a < Int.ofNat b := by
  change Int.NonNeg (Int.subNatNat b (a + 1))
  rw [int_subNatNat_of_le h]
  exact Int.NonNeg.mk (b - (a + 1))

private theorem int_lt_ofNat {a b : Nat} (h : Int.ofNat a < Int.ofNat b) : a < b := by
  change Int.NonNeg (Int.subNatNat b (a + 1)) at h
  cases Nat.lt_or_ge a b with
  | inl hlt => exact hlt
  | inr hle =>
    have hLt : b < a + 1 := Nat.lt_succ_of_le hle
    rw [int_subNatNat_of_lt hLt] at h
    cases h

private theorem int_subNatNat_add_ofNat (a b k : Nat) :
    Int.subNatNat a b + Int.ofNat k = Int.subNatNat (a + k) b := by
  cases Nat.lt_or_ge a b with
  | inr hle =>
    rw [int_subNatNat_of_le hle, int_subNatNat_of_le (Nat.le_trans hle (Nat.le_add_right a k))]
    change Int.ofNat ((a - b) + k) = Int.ofNat ((a + k) - b)
    rw [nat_sub_add_comm_local hle]
  | inl hlt =>
    rw [int_subNatNat_of_lt hlt]
    have hPos : 0 < b - a := Nat.sub_pos_of_lt hlt
    have hSub : (b - a - 1) + 1 = b - a := Nat.sub_add_cancel hPos
    change Int.subNatNat k ((b - a - 1) + 1) = Int.subNatNat (a + k) b
    rw [hSub]
    cases Nat.lt_or_ge (a + k) b with
    | inl hlt2 =>
      have hkLt : k < b - a := by
        have h1 : k + a < (b - a) + a := by
          rw [Nat.sub_add_cancel (Nat.le_of_lt hlt), Nat.add_comm k a]
          exact hlt2
        exact nat_lt_of_add_lt_add_right h1
      rw [int_subNatNat_of_lt hkLt, int_subNatNat_of_lt hlt2]
      have hDiff : (b - a) - k = b - (a + k) := by
        rw [Nat.sub_sub]
      rw [hDiff]
    | inr hle2 =>
      have hkLe : b - a ≤ k := by
        cases Nat.lt_or_ge k (b - a) with
        | inr hk => exact hk
        | inl hkLt =>
          have h1 : a + k < a + (b - a) := Nat.add_lt_add_left hkLt a
          rw [Nat.add_comm a (b - a), Nat.sub_add_cancel (Nat.le_of_lt hlt)] at h1
          exact False.elim (Nat.not_lt_of_ge hle2 h1)
      rw [int_subNatNat_of_le hkLe, int_subNatNat_of_le hle2]
      have hDiff : k - (b - a) = (a + k) - b := by
        have h1 : k - (b - a) + b = (a + k) - b + b := by
          rw [Nat.sub_add_cancel hle2]
          have hBa : b = (b - a) + a := (Nat.sub_add_cancel (Nat.le_of_lt hlt)).symm
          have hStep1 : k - (b - a) + b = k - (b - a) + ((b - a) + a) :=
            congrArg (Nat.add (k - (b - a))) hBa
          have hStep2 : k - (b - a) + ((b - a) + a) = (k - (b - a) + (b - a)) + a :=
            (Nat.add_assoc _ _ _).symm
          rw [hStep1, hStep2, Nat.sub_add_cancel hkLe, Nat.add_comm k a]
        exact Nat.add_right_cancel h1
      rw [hDiff]

private theorem int_subNatNat_add_negSucc (a b k : Nat) :
    Int.subNatNat a b + Int.negSucc k = Int.subNatNat a (b + (k + 1)) := by
  cases Nat.lt_or_ge a b with
  | inl hlt =>
    rw [int_subNatNat_of_lt hlt, int_subNatNat_of_lt (Nat.lt_of_lt_of_le hlt (Nat.le_add_right b (k + 1)))]
    have hPos : 0 < b - a := Nat.sub_pos_of_lt hlt
    change Int.negSucc ((b - a - 1) + k + 1) = Int.negSucc (b + (k + 1) - a - 1)
    rw [Nat.add_assoc (b - a - 1) k 1, Nat.add_comm k 1, ← Nat.add_assoc (b - a - 1) 1 k]
    rw [Nat.sub_add_cancel hPos, ← nat_sub_add_comm_local (Nat.le_of_lt hlt)]
    rw [Nat.add_comm 1 k, ← Nat.add_assoc (b - a) k 1, Nat.add_sub_cancel ((b - a) + k) 1]
  | inr hle =>
    rw [int_subNatNat_of_le hle]
    change Int.subNatNat (a - b) (k + 1) = Int.subNatNat a (b + (k + 1))
    cases Nat.lt_or_ge a (b + (k + 1)) with
    | inl hlt2 =>
      have hkLt : a - b < k + 1 := by
        have h1 : (a - b) + b < (b + (k + 1)) := by
          rw [Nat.sub_add_cancel hle]
          exact hlt2
        rw [Nat.add_comm b (k + 1)] at h1
        exact nat_lt_of_add_lt_add_right h1
      rw [int_subNatNat_of_lt hkLt, int_subNatNat_of_lt hlt2]
      have hDiff : (k + 1) - (a - b) = (b + (k + 1)) - a := by
        have h1 : ((k + 1) - (a - b)) + a = ((b + (k + 1)) - a) + a := by
          rw [Nat.sub_add_cancel (Nat.le_of_lt hlt2)]
          have haEq : a = (a - b) + b := (Nat.sub_add_cancel hle).symm
          have hStep1 : ((k + 1) - (a - b)) + a = ((k + 1) - (a - b)) + ((a - b) + b) :=
            congrArg (Nat.add ((k + 1) - (a - b))) haEq
          have hStep2 : ((k + 1) - (a - b)) + ((a - b) + b) = (((k + 1) - (a - b)) + (a - b)) + b :=
            (Nat.add_assoc _ _ _).symm
          rw [hStep1, hStep2, Nat.sub_add_cancel (Nat.le_of_lt hkLt), Nat.add_comm (k + 1) b]
        exact Nat.add_right_cancel h1
      rw [hDiff]
    | inr hle2 =>
      have hkLe : k + 1 ≤ a - b := by
        cases Nat.lt_or_ge (a - b) (k + 1) with
        | inr hk => exact hk
        | inl hkLt =>
          have h1 : (a - b) + b < (k + 1) + b := Nat.add_lt_add_right hkLt b
          rw [Nat.sub_add_cancel hle, Nat.add_comm (k + 1) b] at h1
          exact False.elim (Nat.not_lt_of_ge hle2 h1)
      rw [int_subNatNat_of_le hkLe, int_subNatNat_of_le hle2]
      rw [Nat.sub_sub]

private theorem int_eq_subNatNat :
    ∀ z : Int, ∃ a b : Nat, z = Int.subNatNat a b
  | .ofNat n => ⟨n, 0, by rw [int_subNatNat_of_le (Nat.zero_le n), Nat.sub_zero]⟩
  | .negSucc k => ⟨0, k + 1, by rw [int_subNatNat_of_lt (Nat.zero_lt_succ k)]; rfl⟩

private theorem int_add_assoc (x y z : Int) : (x + y) + z = x + (y + z) := by
  cases int_eq_subNatNat x with
  | intro a ha =>
    cases ha with
    | intro b hxb =>
      rw [hxb]
      cases y with
      | ofNat cy =>
        rw [int_subNatNat_add_ofNat]
        cases z with
        | ofNat cz =>
          rw [int_subNatNat_add_ofNat]
          change Int.subNatNat (a + cy + cz) b = Int.subNatNat a b + Int.ofNat (cy + cz)
          rw [int_subNatNat_add_ofNat, Nat.add_assoc]
        | negSucc kz =>
          rw [int_subNatNat_add_negSucc]
          change Int.subNatNat (a + cy) (b + (kz + 1)) = Int.subNatNat a b + Int.subNatNat cy (kz + 1)
          cases Nat.lt_or_ge cy (kz + 1) with
          | inl hlt =>
            rw [int_subNatNat_of_lt hlt, int_subNatNat_add_negSucc]
            have hPos : 0 < (kz + 1) - cy := Nat.sub_pos_of_lt hlt
            rw [Nat.sub_add_cancel hPos]
            cases Nat.lt_or_ge (a + cy) (b + (kz + 1)) with
            | inl hlt2 =>
              have hlt3 : a < b + ((kz + 1) - cy) := by
                have h1 : a + cy < b + ((kz + 1) - cy) + cy := by
                  rw [Nat.add_assoc b ((kz + 1) - cy) cy, Nat.sub_add_cancel (Nat.le_of_lt hlt)]
                  exact hlt2
                exact nat_lt_of_add_lt_add_right h1
              rw [int_subNatNat_of_lt hlt2, int_subNatNat_of_lt hlt3]
              have hDiff : (b + (kz + 1)) - (a + cy) = (b + ((kz + 1) - cy)) - a := by
                have h1 : ((b + (kz + 1)) - (a + cy)) + (a + cy) = ((b + ((kz + 1) - cy)) - a) + (a + cy) := by
                  rw [Nat.sub_add_cancel (Nat.le_of_lt hlt2)]
                  rw [← Nat.add_assoc ((b + ((kz + 1) - cy)) - a) a cy]
                  rw [Nat.sub_add_cancel (Nat.le_of_lt hlt3)]
                  rw [Nat.add_assoc b ((kz + 1) - cy) cy, Nat.sub_add_cancel (Nat.le_of_lt hlt)]
                exact Nat.add_right_cancel h1
              rw [hDiff]
            | inr hle2 =>
              have hle3 : b + ((kz + 1) - cy) ≤ a := by
                cases Nat.lt_or_ge a (b + ((kz + 1) - cy)) with
                | inr hok => exact hok
                | inl hbad =>
                  have h1 : a + cy < b + ((kz + 1) - cy) + cy := Nat.add_lt_add_right hbad cy
                  rw [Nat.add_assoc b ((kz + 1) - cy) cy, Nat.sub_add_cancel (Nat.le_of_lt hlt)] at h1
                  exact False.elim (Nat.not_lt_of_ge hle2 h1)
              rw [int_subNatNat_of_le hle2, int_subNatNat_of_le hle3]
              have hDiff : (a + cy) - (b + (kz + 1)) = a - (b + ((kz + 1) - cy)) := by
                have h1 : ((a + cy) - (b + (kz + 1))) + (b + (kz + 1)) = (a - (b + ((kz + 1) - cy))) + (b + (kz + 1)) := by
                  rw [Nat.sub_add_cancel hle2]
                  have hB : b + (kz + 1) = (b + ((kz + 1) - cy)) + cy := by
                    rw [Nat.add_assoc, Nat.sub_add_cancel (Nat.le_of_lt hlt)]
                  have hStep1 : (a - (b + ((kz + 1) - cy))) + (b + (kz + 1)) =
                      (a - (b + ((kz + 1) - cy))) + ((b + ((kz + 1) - cy)) + cy) :=
                    congrArg (Nat.add (a - (b + ((kz + 1) - cy)))) hB
                  rw [hStep1, ← Nat.add_assoc, Nat.sub_add_cancel hle3]
                exact Nat.add_right_cancel h1
              rw [hDiff]
          | inr hle =>
            rw [int_subNatNat_of_le hle, int_subNatNat_add_ofNat]
            cases Nat.lt_or_ge (a + cy) (b + (kz + 1)) with
            | inl hlt2 =>
              have hlt3 : a + (cy - (kz + 1)) < b := by
                have h1 : a + (cy - (kz + 1)) + (kz + 1) < b + (kz + 1) := by
                  rw [Nat.add_assoc, Nat.sub_add_cancel hle]
                  exact hlt2
                exact nat_lt_of_add_lt_add_right h1
              rw [int_subNatNat_of_lt hlt2, int_subNatNat_of_lt hlt3]
              have hDiff : (b + (kz + 1)) - (a + cy) = b - (a + (cy - (kz + 1))) := by
                have h1 : ((b + (kz + 1)) - (a + cy)) + (a + cy) = (b - (a + (cy - (kz + 1)))) + (a + cy) := by
                  rw [Nat.sub_add_cancel (Nat.le_of_lt hlt2)]
                  have hCy : a + cy = (a + (cy - (kz + 1))) + (kz + 1) := by
                    rw [Nat.add_assoc, Nat.sub_add_cancel hle]
                  have hStep1 : (b - (a + (cy - (kz + 1)))) + (a + cy) =
                      (b - (a + (cy - (kz + 1)))) + ((a + (cy - (kz + 1))) + (kz + 1)) :=
                    congrArg (Nat.add (b - (a + (cy - (kz + 1))))) hCy
                  rw [hStep1, ← Nat.add_assoc (b - (a + (cy - (kz + 1)))) (a + (cy - (kz + 1))) (kz + 1)]
                  rw [Nat.sub_add_cancel (Nat.le_of_lt hlt3)]
                exact Nat.add_right_cancel h1
              rw [hDiff]
            | inr hle2 =>
              have hle3 : b ≤ a + (cy - (kz + 1)) := by
                cases Nat.lt_or_ge (a + (cy - (kz + 1))) b with
                | inr hok => exact hok
                | inl hbad =>
                  have h1 : a + (cy - (kz + 1)) + (kz + 1) < b + (kz + 1) := Nat.add_lt_add_right hbad (kz + 1)
                  rw [Nat.add_assoc, Nat.sub_add_cancel hle] at h1
                  exact False.elim (Nat.not_lt_of_ge hle2 h1)
              rw [int_subNatNat_of_le hle2, int_subNatNat_of_le hle3]
              have hDiff : (a + cy) - (b + (kz + 1)) = (a + (cy - (kz + 1))) - b := by
                have h1 : ((a + cy) - (b + (kz + 1))) + (b + (kz + 1)) = ((a + (cy - (kz + 1))) - b) + (b + (kz + 1)) := by
                  rw [Nat.sub_add_cancel hle2]
                  rw [← Nat.add_assoc ((a + (cy - (kz + 1))) - b) b (kz + 1)]
                  rw [Nat.sub_add_cancel hle3, Nat.add_assoc, Nat.sub_add_cancel hle]
                exact Nat.add_right_cancel h1
              rw [hDiff]
      | negSucc ky =>
        rw [int_subNatNat_add_negSucc]
        cases z with
        | ofNat cz =>
          rw [int_subNatNat_add_ofNat]
          change Int.subNatNat (a + cz) (b + (ky + 1)) = Int.subNatNat a b + Int.subNatNat cz (ky + 1)
          cases Nat.lt_or_ge cz (ky + 1) with
          | inl hlt =>
            rw [int_subNatNat_of_lt hlt, int_subNatNat_add_negSucc]
            have hPos : 0 < (ky + 1) - cz := Nat.sub_pos_of_lt hlt
            rw [Nat.sub_add_cancel hPos]
            cases Nat.lt_or_ge (a + cz) (b + (ky + 1)) with
            | inl hlt2 =>
              have hlt3 : a < b + ((ky + 1) - cz) := by
                have h1 : a + cz < b + ((ky + 1) - cz) + cz := by
                  rw [Nat.add_assoc b ((ky + 1) - cz) cz, Nat.sub_add_cancel (Nat.le_of_lt hlt)]
                  exact hlt2
                exact nat_lt_of_add_lt_add_right h1
              rw [int_subNatNat_of_lt hlt2, int_subNatNat_of_lt hlt3]
              have hDiff : (b + (ky + 1)) - (a + cz) = (b + ((ky + 1) - cz)) - a := by
                have h1 : ((b + (ky + 1)) - (a + cz)) + (a + cz) = ((b + ((ky + 1) - cz)) - a) + (a + cz) := by
                  rw [Nat.sub_add_cancel (Nat.le_of_lt hlt2)]
                  rw [← Nat.add_assoc ((b + ((ky + 1) - cz)) - a) a cz, Nat.sub_add_cancel (Nat.le_of_lt hlt3)]
                  rw [Nat.add_assoc b ((ky + 1) - cz) cz, Nat.sub_add_cancel (Nat.le_of_lt hlt)]
                exact Nat.add_right_cancel h1
              rw [hDiff]
            | inr hle2 =>
              have hle3 : b + ((ky + 1) - cz) ≤ a := by
                cases Nat.lt_or_ge a (b + ((ky + 1) - cz)) with
                | inr hok => exact hok
                | inl hbad =>
                  have h1 : a + cz < b + ((ky + 1) - cz) + cz := Nat.add_lt_add_right hbad cz
                  rw [Nat.add_assoc b ((ky + 1) - cz) cz, Nat.sub_add_cancel (Nat.le_of_lt hlt)] at h1
                  exact False.elim (Nat.not_lt_of_ge hle2 h1)
              rw [int_subNatNat_of_le hle2, int_subNatNat_of_le hle3]
              have hDiff : (a + cz) - (b + (ky + 1)) = a - (b + ((ky + 1) - cz)) := by
                have h1 : ((a + cz) - (b + (ky + 1))) + (b + (ky + 1)) = (a - (b + ((ky + 1) - cz))) + (b + (ky + 1)) := by
                  rw [Nat.sub_add_cancel hle2]
                  have hB : b + (ky + 1) = (b + ((ky + 1) - cz)) + cz := by
                    rw [Nat.add_assoc, Nat.sub_add_cancel (Nat.le_of_lt hlt)]
                  have hStep1 : (a - (b + ((ky + 1) - cz))) + (b + (ky + 1)) =
                      (a - (b + ((ky + 1) - cz))) + ((b + ((ky + 1) - cz)) + cz) :=
                    congrArg (Nat.add (a - (b + ((ky + 1) - cz)))) hB
                  rw [hStep1, ← Nat.add_assoc, Nat.sub_add_cancel hle3]
                exact Nat.add_right_cancel h1
              rw [hDiff]
          | inr hle =>
            rw [int_subNatNat_of_le hle, int_subNatNat_add_ofNat]
            cases Nat.lt_or_ge (a + cz) (b + (ky + 1)) with
            | inl hlt2 =>
              have hlt3 : a + (cz - (ky + 1)) < b := by
                have h1 : a + (cz - (ky + 1)) + (ky + 1) < b + (ky + 1) := by
                  rw [Nat.add_assoc, Nat.sub_add_cancel hle]
                  exact hlt2
                exact nat_lt_of_add_lt_add_right h1
              rw [int_subNatNat_of_lt hlt2, int_subNatNat_of_lt hlt3]
              have hDiff : (b + (ky + 1)) - (a + cz) = b - (a + (cz - (ky + 1))) := by
                have h1 : ((b + (ky + 1)) - (a + cz)) + (a + cz) = (b - (a + (cz - (ky + 1)))) + (a + cz) := by
                  rw [Nat.sub_add_cancel (Nat.le_of_lt hlt2)]
                  have hCz : a + cz = (a + (cz - (ky + 1))) + (ky + 1) := by
                    rw [Nat.add_assoc, Nat.sub_add_cancel hle]
                  have hStep1 : (b - (a + (cz - (ky + 1)))) + (a + cz) =
                      (b - (a + (cz - (ky + 1)))) + ((a + (cz - (ky + 1))) + (ky + 1)) :=
                    congrArg (Nat.add (b - (a + (cz - (ky + 1))))) hCz
                  rw [hStep1, ← Nat.add_assoc (b - (a + (cz - (ky + 1)))) (a + (cz - (ky + 1))) (ky + 1)]
                  rw [Nat.sub_add_cancel (Nat.le_of_lt hlt3)]
                exact Nat.add_right_cancel h1
              rw [hDiff]
            | inr hle2 =>
              have hle3 : b ≤ a + (cz - (ky + 1)) := by
                cases Nat.lt_or_ge (a + (cz - (ky + 1))) b with
                | inr hok => exact hok
                | inl hbad =>
                  have h1 : a + (cz - (ky + 1)) + (ky + 1) < b + (ky + 1) := Nat.add_lt_add_right hbad (ky + 1)
                  rw [Nat.add_assoc, Nat.sub_add_cancel hle] at h1
                  exact False.elim (Nat.not_lt_of_ge hle2 h1)
              rw [int_subNatNat_of_le hle2, int_subNatNat_of_le hle3]
              have hDiff : (a + cz) - (b + (ky + 1)) = (a + (cz - (ky + 1))) - b := by
                have h1 : ((a + cz) - (b + (ky + 1))) + (b + (ky + 1)) = ((a + (cz - (ky + 1))) - b) + (b + (ky + 1)) := by
                  rw [Nat.sub_add_cancel hle2]
                  rw [← Nat.add_assoc ((a + (cz - (ky + 1))) - b) b (ky + 1)]
                  rw [Nat.sub_add_cancel hle3, Nat.add_assoc, Nat.sub_add_cancel hle]
                exact Nat.add_right_cancel h1
              rw [hDiff]
        | negSucc kz =>
          rw [int_subNatNat_add_negSucc]
          have hSumNeg : Int.negSucc ky + Int.negSucc kz = Int.negSucc (ky + kz + 1) := rfl
          rw [hSumNeg, int_subNatNat_add_negSucc, Nat.add_assoc b (ky + 1) (kz + 1)]
          have hK : (ky + 1) + (kz + 1) = (ky + kz + 1) + 1 := by
            rw [← Nat.add_assoc (ky + 1) kz 1, Nat.add_assoc ky 1 kz, Nat.add_comm 1 kz,
              ← Nat.add_assoc ky kz 1]
          rw [← Nat.add_assoc b (ky + 1) (kz + 1)]
          have hB : b + ((ky + 1) + (kz + 1)) = b + ((ky + kz + 1) + 1) := congrArg (Nat.add b) hK
          change Int.subNatNat a (b + (ky + 1) + (kz + 1)) = Int.subNatNat a (b + ((ky + kz + 1) + 1))
          rw [Nat.add_assoc b (ky + 1) (kz + 1), hB]

private theorem int_add_comm (x y : Int) : x + y = y + x := by
  cases x with
  | ofNat a =>
    cases y with
    | ofNat b => exact congrArg Int.ofNat (Nat.add_comm a b)
    | negSucc b => rfl
  | negSucc a =>
    cases y with
    | ofNat b => rfl
    | negSucc b =>
      change Int.negSucc (a + b + 1) = Int.negSucc (b + a + 1)
      rw [Nat.add_comm a b]

private theorem int_add_right_neg (x : Int) : x + Neg.neg x = 0 := by
  cases x with
  | ofNat n =>
    cases n with
    | zero => rfl
    | succ m =>
      change Int.subNatNat (m + 1) (m + 1) = 0
      rw [int_subNatNat_of_le (Nat.le_refl _), Nat.sub_self]
      rfl
  | negSucc k =>
    change Int.subNatNat (k + 1) (k + 1) = 0
    rw [int_subNatNat_of_le (Nat.le_refl _), Nat.sub_self]
    rfl

private theorem int_toNat_of_nonneg {z : Int} (h : (0 : Int) ≤ z) : Int.ofNat z.toNat = z := by
  cases z with
  | ofNat n => rfl
  | negSucc n => cases h

private theorem int_zero_mul (z : Int) : (0 : Int) * z = 0 := by
  cases z with
  | ofNat n =>
    change Int.ofNat (0 * n) = 0
    rw [Nat.zero_mul]
    rfl
  | negSucc n =>
    change Int.negOfNat (0 * (n + 1)) = 0
    rw [Nat.zero_mul]
    rfl

private theorem int_add_zero (x : Int) : x + 0 = x := by
  cases x with
  | ofNat _ => rfl
  | negSucc _ => rfl

private theorem int_neg_mul (a b : Int) : (Neg.neg a) * b = Neg.neg (a * b) := by
  cases a with
  | ofNat n =>
    cases n with
    | zero =>
      have hNeg0 : Neg.neg (Int.ofNat 0) = (0 : Int) := rfl
      have hOf0 : Int.ofNat 0 = (0 : Int) := rfl
      rw [hNeg0, hOf0, int_zero_mul]
      rfl
    | succ m =>
      cases b with
      | ofNat k => cases k <;> rfl
      | negSucc k => rfl
  | negSucc n =>
    cases b with
    | ofNat k => cases k <;> rfl
    | negSucc k => rfl

private theorem uint64_toNat_ofNat (n : Nat) :
    (UInt64.ofNat n).toNat = Nat.mod n maxUsize := rfl

private theorem uint8_toNat_ofNat (n : Nat) :
    (UInt8.ofNat n).toNat = Nat.mod n 256 := rfl

private theorem nat_mod_eq_of_lt {a b : Nat} (h : a < b) : Nat.mod a b = a :=
  Nat.mod_eq_of_lt h

private theorem nat_div_add_mod (n d : Nat) : d * Nat.div n d + Nat.mod n d = n :=
  Nat.div_add_mod n d

private theorem nat_add_mul_mod_self_right (x y z : Nat) :
    Nat.mod (x + y * z) z = Nat.mod x z :=
  Nat.add_mul_mod_self_right x y z

private theorem uint64_ofNat_toNat (u : UInt64) : UInt64.ofNat u.toNat = u := by
  cases u with
  | ofBitVec bv =>
    cases bv with
    | ofFin fin =>
      cases fin with
      | mk val hlt =>
        apply congrArg UInt64.ofBitVec
        apply congrArg BitVec.ofFin
        apply Fin.eq_of_val_eq
        change Nat.mod val (Nat.pow 2 64) = val
        exact nat_mod_eq_of_lt hlt

private theorem calcInboundsOffset_zero (mem : CallerMemory) (pv : PtrVal)
    (count : Int) (elemSize : Nat) (hZero : count * Int.ofNat elemSize = 0) :
    calcInboundsOffset mem pv count elemSize = .ok { pv with width := .isize } := by
  unfold calcInboundsOffset
  dsimp
  have hZero' : count * (elemSize : Int) = 0 := hZero
  rw [hZero']
  unfold minIsize maxIsize
  have hPos : 0 < Nat.pow 2 63 := @Nat.pow_pos 2 63 (by decide)
  have hMinF : decide ((0 : Int) < Neg.neg (Int.ofNat (Nat.pow 2 63))) = false :=
    decide_eq_false (int_zero_lt_neg_pos (Nat.pow 2 63) hPos)
  have hMaxF : decide (Int.ofNat (Nat.pow 2 63 - 1) < (0 : Int)) = false :=
    decide_eq_false (int_ofNat_lt_zero (Nat.pow 2 63 - 1))
  change (if decide ((0 : Int) < Neg.neg (Int.ofNat (Nat.pow 2 63))) ||
        decide (Int.ofNat (Nat.pow 2 63 - 1) < (0 : Int)) then
      Except.error FaultKind.undefined
    else if ((0 : Int) == 0) = true then
      Except.ok { pv with width := .isize }
    else _) = _
  rw [hMinF, hMaxF]
  rfl

private theorem uint64_toNat_lt_maxUsize (u : UInt64) : u.toNat < maxUsize :=
  u.toBitVec.isLt

private theorem int_subNatNat_add_neg (r k : Nat) :
    Int.ofNat r + Neg.neg (Int.ofNat (r + (k + 1))) = Int.negSucc k := by
  change Int.subNatNat r (r + (k + 1)) = Int.negSucc k
  unfold Int.subNatNat
  rw [nat_add_sub_cancel']

private theorem int_negSucc_mul_ofNat (qn m : Nat) :
    Int.negSucc qn * Int.ofNat m = Neg.neg (Int.ofNat ((qn + 1) * m)) := by
  have h1 : Int.negSucc qn = Neg.neg (Int.ofNat (qn + 1)) := rfl
  rw [h1, int_neg_mul]
  rfl

private theorem intEmod_decomp (a : Int) (m : Nat) (hm : 0 < m) :
    ∃ (r : Nat) (q : Int), r < m ∧ intEmod a (Int.ofNat m) = Int.ofNat r ∧
      a = Int.ofNat r + q * Int.ofNat m := by
  cases a with
  | ofNat k =>
    refine ⟨Nat.mod k m, Int.ofNat (Nat.div k m), Nat.mod_lt k hm, rfl, ?_⟩
    change Int.ofNat k = Int.ofNat (Nat.mod k m + Nat.div k m * m)
    rw [Nat.add_comm, Nat.mul_comm (Nat.div k m) m, nat_div_add_mod]
  | negSucc k =>
    let r0 : Nat := Nat.mod k m
    have hr0Lt : r0 < m := Nat.mod_lt k hm
    have hr0SuccLe : r0 + 1 ≤ m := hr0Lt
    let r : Nat := m - (r0 + 1)
    have hrLt : r < m := Nat.sub_lt hm (Nat.zero_lt_succ r0)
    have hEmod : intEmod (Int.negSucc k) (Int.ofNat m) = Int.ofNat r := by
      change Int.subNatNat m (r0 + 1) = Int.ofNat r
      unfold Int.subNatNat
      rw [Nat.sub_eq_zero_of_le hr0SuccLe]
    refine ⟨r, Int.negSucc (Nat.div k m), hrLt, hEmod, ?_⟩
    rw [int_negSucc_mul_ofNat]
    have hrEq : r + (r0 + 1) = m := Nat.sub_add_cancel hr0SuccLe
    have hDivMod : Nat.div k m * m + r0 = k := by
      rw [Nat.mul_comm (Nat.div k m) m, nat_div_add_mod]
    have hMulEq : (Nat.div k m + 1) * m = r + (k + 1) := by
      have h1 : (Nat.div k m + 1) * m = Nat.div k m * m + m := Nat.succ_mul _ m
      have h2 : Nat.div k m * m + m = Nat.div k m * m + (r + (r0 + 1)) :=
        congrArg (Nat.add (Nat.div k m * m)) hrEq.symm
      rw [h1, h2, Nat.add_comm (Nat.div k m * m) (r + (r0 + 1))]
      rw [Nat.add_assoc r (r0 + 1) (Nat.div k m * m)]
      rw [Nat.add_comm (r0 + 1) (Nat.div k m * m)]
      rw [← Nat.add_assoc (Nat.div k m * m) r0 1, hDivMod]
    rw [hMulEq, int_subNatNat_add_neg]

private theorem intEmod_eq_of_decomp (a : Int) (r m : Nat) (q : Int)
    (hm : 0 < m) (hr : r < m) (hEq : a = Int.ofNat r + q * Int.ofNat m) :
    intEmod a (Int.ofNat m) = Int.ofNat r := by
  rw [hEq]
  cases q with
  | ofNat qn =>
    change Int.ofNat (Nat.mod (r + qn * m) m) = Int.ofNat r
    rw [nat_add_mul_mod_self_right, nat_mod_eq_of_lt hr]
  | negSucc qn =>
    rw [int_negSucc_mul_ofNat]
    have hrSuccLe : r + 1 ≤ m := hr
    have hrEq : r + ((m - (r + 1)) + 1) = m := by
      have hC : m - (r + 1) + (r + 1) = m := Nat.sub_add_cancel hrSuccLe
      rw [Nat.add_comm r ((m - (r + 1)) + 1), Nat.add_assoc, Nat.add_comm 1 r]
      exact hC
    have hkLt : m - (r + 1) < m := Nat.sub_lt hm (Nat.zero_lt_succ r)
    let k : Nat := m - (r + 1) + qn * m
    have hMulEq : (qn + 1) * m = r + (k + 1) := by
      have h1 : (qn + 1) * m = qn * m + m := Nat.succ_mul qn m
      have h2 : qn * m + m = qn * m + (r + ((m - (r + 1)) + 1)) :=
        congrArg (Nat.add (qn * m)) hrEq.symm
      rw [h1, h2, Nat.add_comm (qn * m) (r + ((m - (r + 1)) + 1))]
      rw [Nat.add_assoc r ((m - (r + 1)) + 1) (qn * m)]
      rw [Nat.add_comm ((m - (r + 1)) + 1) (qn * m)]
      rw [← Nat.add_assoc (qn * m) (m - (r + 1)) 1]
      rw [Nat.add_comm (qn * m) (m - (r + 1))]
    rw [hMulEq, int_subNatNat_add_neg]
    change Int.subNatNat m (Nat.mod (m - (r + 1) + qn * m) m + 1) = Int.ofNat r
    rw [nat_add_mul_mod_self_right, nat_mod_eq_of_lt hkLt]
    have hSub1 : m - (r + 1) + 1 = m - r := by
      have hSum : m - (r + 1) + (r + 1) = m := Nat.sub_add_cancel hrSuccLe
      have hA : (m - (r + 1) + 1) + r = m := by
        rw [Nat.add_assoc, Nat.add_comm 1 r]
        exact hSum
      exact Nat.add_right_cancel (Eq.trans hA (Nat.sub_add_cancel (Nat.le_of_lt hr)).symm)
    rw [hSub1]
    unfold Int.subNatNat
    have hLe : m - r ≤ m := Nat.sub_le m r
    rw [Nat.sub_eq_zero_of_le hLe]
    have hSub2 : m - (m - r) = r := by
      have h2 : (m - (m - r)) + (m - r) = r + (m - r) := by
        rw [Nat.sub_add_cancel (Nat.sub_le m r), Nat.add_comm r (m - r),
          Nat.sub_add_cancel (Nat.le_of_lt hr)]
      exact Nat.add_right_cancel h2
    exact congrArg Int.ofNat hSub2

private theorem calcWrappingOffset_roundtrip (pv : PtrVal) (count : Int) (elemSize : Nat) :
    calcWrappingOffset (calcWrappingOffset pv count elemSize) (Neg.neg count) elemSize =
      { pv with width := .isize } := by
  unfold calcWrappingOffset
  dsimp
  let mNat : Nat := maxUsize
  have hmPos : 0 < mNat := @Nat.pow_pos 2 64 (by decide)
  let m : Int := Int.ofNat mNat
  let x : Int := Int.ofNat pv.offsetBytes.toNat
  let d : Int := count * Int.ofNat elemSize
  have hDec1 := intEmod_decomp (x + d) mNat hmPos
  cases hDec1 with
  | intro r₁ hr₁ =>
    cases hr₁ with
    | intro q₁ hq₁ =>
      have hU64ToNat : (UInt64.ofNat (intEmod (x + d) m).toNat).toNat = r₁ := by
        rw [hq₁.2.1]
        change (UInt64.ofNat r₁).toNat = r₁
        rw [uint64_toNat_ofNat]
        exact nat_mod_eq_of_lt hq₁.1
      have hNegMul : (Neg.neg count) * Int.ofNat elemSize = Neg.neg d :=
        int_neg_mul count (Int.ofNat elemSize)
      have hDecomp2 : Int.ofNat (UInt64.ofNat (intEmod (x + d) m).toNat).toNat +
          (Neg.neg count) * Int.ofNat elemSize =
          x + (Neg.neg q₁) * m := by
        rw [hU64ToNat, hNegMul]
        have hXd : Int.ofNat r₁ = (x + d) + Neg.neg (q₁ * m) := by
          rw [hq₁.2.2, int_add_assoc, int_add_right_neg, int_add_zero]
        rw [hXd, int_add_assoc x d (Neg.neg (q₁ * m)), int_add_assoc x (d + Neg.neg (q₁ * m)) (Neg.neg d)]
        rw [int_add_comm d (Neg.neg (q₁ * m)), int_add_assoc (Neg.neg (q₁ * m)) d (Neg.neg d)]
        rw [int_add_right_neg, int_add_zero, int_neg_mul]
      have hMod2 : intEmod (Int.ofNat (UInt64.ofNat (intEmod (x + d) m).toNat).toNat +
          (Neg.neg count) * Int.ofNat elemSize) m = x :=
        intEmod_eq_of_decomp _ pv.offsetBytes.toNat mNat (Neg.neg q₁) hmPos
          (uint64_toNat_lt_maxUsize pv.offsetBytes) hDecomp2
      change { pv with
          offsetBytes := UInt64.ofNat (intEmod (Int.ofNat (UInt64.ofNat (intEmod (x + d) m).toNat).toNat +
            (Neg.neg count) * Int.ofNat elemSize) m).toNat
          width := .isize } = { pv with width := .isize }
      rw [hMod2]
      have hToNatX : x.toNat = pv.offsetBytes.toNat := rfl
      rw [hToNatX, uint64_ofNat_toNat]

private theorem encodeLeBytesAux_length (prov : Option AllocId) :
    ∀ (k n : Nat), (encodeLeBytesAux prov k n).length = k
  | 0, _ => rfl
  | k + 1, n => by
    change (encodeLeBytesAux prov k (Nat.div n 256)).length + 1 = k + 1
    rw [encodeLeBytesAux_length prov k (Nat.div n 256)]

private theorem uint8_ofNat_mod256_toNat (n : Nat) :
    (UInt8.ofNat (Nat.mod n 256)).toNat = Nat.mod n 256 := by
  rw [uint8_toNat_ofNat]
  have hLt : Nat.mod n 256 < 256 := Nat.mod_lt n (by decide : 0 < 256)
  exact Nat.mod_eq_of_lt hLt

private theorem nat_pow_add (a m : Nat) : ∀ n : Nat, Nat.pow a (m + n) = Nat.pow a m * Nat.pow a n
  | 0 => by
    change Nat.pow a m = Nat.pow a m * 1
    rw [Nat.mul_one]
  | n + 1 => by
    change Nat.pow a (m + n) * a = Nat.pow a m * (Nat.pow a n * a)
    rw [nat_pow_add a m n, Nat.mul_assoc]

private theorem pow2_8_succ (k : Nat) :
    Nat.pow 2 (8 * (k + 1)) = Nat.pow 2 (8 * k) * 256 := by
  rw [Nat.mul_succ, nat_pow_add]

private theorem nat_div_lt_of_lt_mul {n q d : Nat} (hd : 0 < d) (h : n < q * d) :
    Nat.div n d < q := by
  exact (Nat.div_lt_iff_lt_mul hd).mpr h

private theorem decodeLeBytesAux_encodeLeBytesAux :
    ∀ (k n : Nat), n < Nat.pow 2 (8 * k) →
      decodeLeBytesAux (encodeLeBytesAux none k n) = .ok n
  | 0, n, hn => by
    have h1 : Nat.pow 2 (8 * 0) = 1 := rfl
    rw [h1] at hn
    cases n with
    | zero => rfl
    | succ m => exact False.elim (Nat.not_lt_zero m (Nat.lt_of_succ_lt_succ hn))
  | k + 1, n, hn => by
    rw [pow2_8_succ] at hn
    have hDivLt : Nat.div n 256 < Nat.pow 2 (8 * k) :=
      nat_div_lt_of_lt_mul (by decide : 0 < 256) hn
    have ih := decodeLeBytesAux_encodeLeBytesAux k (Nat.div n 256) hDivLt
    unfold encodeLeBytesAux decodeLeBytesAux
    rw [ih]
    dsimp
    rw [uint8_ofNat_mod256_toNat n, Nat.add_comm, nat_div_add_mod]

private theorem decodeLeUsize_encodeLeUsize (w : LeWidth) (n : Nat)
    (hn : n < Nat.pow 2 w.bitWidth) :
    decodeLeUsize w (encodeLeUsize w n) = .ok n := by
  cases w with
  | b1 =>
    unfold decodeLeUsize encodeLeUsize
    rw [encodeLeBytesAux_length]
    dsimp [LeWidth.byteCount]
    exact decodeLeBytesAux_encodeLeBytesAux 1 n hn
  | b2 =>
    unfold decodeLeUsize encodeLeUsize
    rw [encodeLeBytesAux_length]
    dsimp [LeWidth.byteCount]
    exact decodeLeBytesAux_encodeLeBytesAux 2 n hn
  | b4 =>
    unfold decodeLeUsize encodeLeUsize
    rw [encodeLeBytesAux_length]
    dsimp [LeWidth.byteCount]
    exact decodeLeBytesAux_encodeLeBytesAux 4 n hn
  | b8 =>
    unfold decodeLeUsize encodeLeUsize
    rw [encodeLeBytesAux_length]
    dsimp [LeWidth.byteCount]
    exact decodeLeBytesAux_encodeLeBytesAux 8 n hn

private theorem decodeLeBytesAux_any_bad :
    ∀ bs : List AllocByte,
      bs.any (fun ab => match ab with | .init _ none => false | _ => true) = true →
      decodeLeBytesAux bs = .error .undefined
  | [], h => by cases h
  | .uninit :: _, _ => rfl
  | .init _ (some _) :: _, _ => rfl
  | .init _ none :: rest, h => by
    change (false || rest.any (fun ab => match ab with | .init _ none => false | _ => true)) = true at h
    have hRest : rest.any (fun ab => match ab with | .init _ none => false | _ => true) = true := h
    have ih := decodeLeBytesAux_any_bad rest hRest
    unfold decodeLeBytesAux
    rw [ih]

private theorem decodeLeUsize_any_bad (w : LeWidth) (bs : List AllocByte)
    (hLen : Nat.beq bs.length w.byteCount = true)
    (hAny : bs.any (fun ab => match ab with | .init _ none => false | _ => true) = true) :
    decodeLeUsize w bs = .error .undefined := by
  unfold decodeLeUsize
  rw [hLen]
  exact decodeLeBytesAux_any_bad bs hAny

private theorem decodePtrBytesAux_encodeLeBytesAux (prov : Option AllocId) :
    ∀ (k n : Nat), n < Nat.pow 2 (8 * k) →
      decodePtrBytesAux prov (encodeLeBytesAux prov k n) = .ok n
  | 0, n, hn => by
    have h1 : Nat.pow 2 (8 * 0) = 1 := rfl
    rw [h1] at hn
    cases n with
    | zero => rfl
    | succ m => exact False.elim (Nat.not_lt_zero m (Nat.lt_of_succ_lt_succ hn))
  | k + 1, n, hn => by
    rw [pow2_8_succ] at hn
    have hDivLt : Nat.div n 256 < Nat.pow 2 (8 * k) :=
      nat_div_lt_of_lt_mul (by decide : 0 < 256) hn
    have ih := decodePtrBytesAux_encodeLeBytesAux prov k (Nat.div n 256) hDivLt
    unfold encodeLeBytesAux decodePtrBytesAux
    rw [optNatEq_refl prov, ih]
    dsimp
    rw [uint8_ofNat_mod256_toNat n, Nat.add_comm, nat_div_add_mod]

private theorem decodePtrLe8_encodeLeBytesAux (prov : Option AllocId) (off : Nat)
    (hoff : off < maxUsize) :
    decodePtrLe8 (encodeLeBytesAux prov 8 off) =
      .ok { allocId := prov, offsetBytes := UInt64.ofNat off, width := .isize } := by
  unfold decodePtrLe8
  rw [encodeLeBytesAux_length]
  dsimp
  have hDec := decodePtrBytesAux_encodeLeBytesAux prov 8 off hoff
  change (match decodePtrBytesAux prov (encodeLeBytesAux prov 8 off) with
    | .ok offNat => Except.ok ({ allocId := prov, offsetBytes := UInt64.ofNat offNat, width := .isize } : PtrVal)
    | .error k => Except.error k) = _
  rw [hDec]

private theorem checkPtrAlignMem_le30_cases (mem : CallerMemory) (pv : PtrVal)
    (reqAlignLog2 : Nat) (hLe : Nat.ble reqAlignLog2 30 = true) :
    checkPtrAlignMem mem pv reqAlignLog2 = .ok () ∨
    checkPtrAlignMem mem pv reqAlignLog2 = .error .undefined := by
  unfold checkPtrAlignMem
  rw [hLe]
  dsimp
  cases pv.allocId with
  | none =>
    dsimp
    cases Nat.beq (Nat.mod pv.offsetBytes.toNat (Nat.pow 2 reqAlignLog2)) 0 with
    | true => exact Or.inl rfl
    | false => exact Or.inr rfl
  | some aid =>
    dsimp
    cases findAlloc? aid mem.allocations with
    | none => exact Or.inr rfl
    | some alloc =>
      dsimp
      cases (Nat.ble reqAlignLog2 alloc.alignLog2 &&
          Nat.beq (Nat.mod pv.offsetBytes.toNat (Nat.pow 2 reqAlignLog2)) 0) with
      | true => exact Or.inl rfl
      | false => exact Or.inr rfl

private theorem evalCopyNonOverlapping_zero_laws (mem : CallerMemory) (pvSrc pvDst : PtrVal)
    (count elemSize reqAlignLog2 : Nat) (checkNonNullZero : Bool)
    (hAlign : Nat.ble reqAlignLog2 30 = true)
    (hZero : elemSize * count = 0) :
    ((evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
        checkNonNullZero = .ok mem ↔
      (checkPtrAlignMem mem pvSrc reqAlignLog2 = .ok () ∧
       checkPtrAlignMem mem pvDst reqAlignLog2 = .ok () ∧
       ¬ (checkNonNullZero = true ∧
          (isNullPtr pvSrc = true ∨ isNullPtr pvDst = true)))) ∧
     (evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
        checkNonNullZero ≠ .ok mem →
      evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
        checkNonNullZero = .error .undefined)) := by
  unfold evalCopyNonOverlapping
  dsimp
  rw [hAlign, hZero]
  have hBle0 : Nat.ble 0 maxIsize = true := Nat.ble_eq_true_of_le (Nat.zero_le maxIsize)
  rw [hBle0]
  dsimp
  have hSrcCases := checkPtrAlignMem_le30_cases mem pvSrc reqAlignLog2 hAlign
  have hDstCases := checkPtrAlignMem_le30_cases mem pvDst reqAlignLog2 hAlign
  cases hSrcCases with
  | inr hSrcUndef =>
    rw [hSrcUndef]
    dsimp
    refine ⟨?_, fun _ => rfl⟩
    constructor
    · intro hOk; cases hOk
    · intro h; cases h.1
  | inl hSrcOk =>
    rw [hSrcOk]
    cases hDstCases with
    | inr hDstUndef =>
      rw [hDstUndef]
      dsimp
      refine ⟨?_, fun _ => rfl⟩
      constructor
      · intro hOk; cases hOk
      · intro h; cases h.2.1
    | inl hDstOk =>
      rw [hDstOk]
      dsimp
      cases hChk : (checkNonNullZero && (isNullPtr pvSrc || isNullPtr pvDst)) with
      | true =>
        dsimp
        have hAnd := (bool_and_eq_true _ _).mp hChk
        have hOr := (bool_or_eq_true _ _).mp hAnd.2
        refine ⟨?_, fun _ => rfl⟩
        constructor
        · intro hOk; cases hOk
        · intro h; exact False.elim (h.2.2 ⟨hAnd.1, hOr⟩)
      | false =>
        dsimp
        refine ⟨?_, fun hNe => False.elim (hNe rfl)⟩
        constructor
        · intro _
          refine ⟨rfl, rfl, ?_⟩
          intro hBad
          have hTrue : (checkNonNullZero && (isNullPtr pvSrc || isNullPtr pvDst)) = true :=
            (bool_and_eq_true _ _).mpr ⟨hBad.1, (bool_or_eq_true _ _).mpr hBad.2⟩
          rw [hTrue] at hChk
          cases hChk
        · intro _; rfl

private theorem inboundsOffset_leRoundTrip_and_copyNonOverlapping_laws_slice1 :
    (∀ (mem : CallerMemory) (pv : PtrVal) (count : Int) (elemSize : Nat),
      count * Int.ofNat elemSize = 0 →
      calcInboundsOffset mem pv count elemSize =
        .ok { pv with width := .isize }) ∧
    (∀ (pv : PtrVal) (count : Int) (elemSize : Nat),
      calcWrappingOffset (calcWrappingOffset pv count elemSize) (Neg.neg count) elemSize =
        { pv with width := .isize }) ∧
    (∀ (w : LeWidth) (n : Nat),
      n < Nat.pow 2 w.bitWidth →
      decodeLeUsize w (encodeLeUsize w n) = .ok n) ∧
    (∀ (w : LeWidth) (bs : List AllocByte),
      Nat.beq bs.length w.byteCount = true →
      bs.any (fun ab => match ab with | .init _ none => false | _ => true) = true →
      decodeLeUsize w bs = .error .undefined) ∧
    (∀ (prov : Option AllocId) (off : Nat),
      off < maxUsize →
      decodePtrLe8 (encodeLeBytesAux prov 8 off) =
        .ok { allocId := prov, offsetBytes := UInt64.ofNat off, width := .isize }) ∧
    (∀ (mem : CallerMemory) (pvSrc pvDst : PtrVal)
        (count elemSize reqAlignLog2 : Nat) (checkNonNullZero : Bool),
      Nat.ble reqAlignLog2 30 = true →
      elemSize * count = 0 →
      ((evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
          checkNonNullZero = .ok mem ↔
        (checkPtrAlignMem mem pvSrc reqAlignLog2 = .ok () ∧
         checkPtrAlignMem mem pvDst reqAlignLog2 = .ok () ∧
         ¬ (checkNonNullZero = true ∧
            (isNullPtr pvSrc = true ∨ isNullPtr pvDst = true)))) ∧
       (evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
          checkNonNullZero ≠ .ok mem →
        evalCopyNonOverlapping mem pvSrc pvDst count elemSize reqAlignLog2
          checkNonNullZero = .error .undefined))) :=
  ⟨calcInboundsOffset_zero, calcWrappingOffset_roundtrip,
   decodeLeUsize_encodeLeUsize, decodeLeUsize_any_bad,
   decodePtrLe8_encodeLeBytesAux, evalCopyNonOverlapping_zero_laws⟩

