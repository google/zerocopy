private theorem s3_eval_mkRequireZeroUsize_ok (body : MemCopyBody) (frame : MemCopyFrame) (mem : CallerMemory)
    (scr : LocalId) (op : Operand) (slots₁ slots' : List MemCopySlot) (ov : Option Val)
