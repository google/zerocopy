private theorem s4_step_mkAssignUse_scrToByte
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (frame : MemCopyFrame) (mem : CallerMemory)
    {k r nVal : Nat} (hk : k < 2 * pack.size) (hr : r < 4) (hn : nVal < maxUsize)
    {ovOld : Option Val}
    (hDstLive : Trusted.MirSemantics.getElem? frame.locals (pack.bodySrc.locals.length + 1 + k) =
      some (.baseSlot (.live ovOld)))
    (hSrcLive : Trusted.MirSemantics.getElem? frame.locals
        (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) =
      some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 nVal⟩))))) :
    ∃ (slotsMid slotsOut : List MemCopySlot),
      setElem? frame.locals (pack.bodySrc.locals.length + 1 + 2 * pack.size + r)
        (.baseSlot (.live none)) = some slotsMid ∧
      setElem? slotsMid (pack.bodySrc.locals.length + 1 + k)
        (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 nVal⟩)))) = some slotsOut ∧
      evalMemCopyStmt pack.bodyTgt frame mem
        (mkAssignUse (pack.bodySrc.locals.length + 1 + k)
          (.move { localId := pack.bodySrc.locals.length + 1 + 2 * pack.size + r, projection := [] })) =
        stepMemCopyNext frame mem slotsOut := by
  let dst := pack.bodySrc.locals.length + 1 + k
  let src := pack.bodySrc.locals.length + 1 + 2 * pack.size + r
  have hDstDecl := s4_getElem?_bodyTgt_locals_byte pack hk
  have hSrcDecl := s4_getElem?_bodyTgt_locals_scr pack hr
  have hSrcLt : src < frame.locals.length := s4_getElem?_some_lt _ _ _ hSrcLive
  have hDstLt : dst < frame.locals.length := s4_getElem?_some_lt _ _ _ hDstLive
  have hNe : src ≠ dst := fun h => by
    have hGt : dst < src := Nat.lt_of_lt_of_le (Nat.add_lt_add_left hk _) (Nat.le_add_right _ r)
    rw [h] at hGt
    exact s4_nat_lt_irrefl _ hGt
  cases s4_lt_setElem?_some frame.locals src (.baseSlot (.live none)) hSrcLt with
  | intro slotsMid hSetMid =>
  have hDstLtMid : dst < slotsMid.length := by rw [s4_setElem?_length _ _ _ _ hSetMid]; exact hDstLt
  let outVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 nVal⟩
  cases s4_lt_setElem?_some slotsMid dst (.baseSlot (.live (some outVal))) hDstLtMid with
  | intro slotsOut hSetOut =>
  refine ⟨slotsMid, slotsOut, hSetMid, hSetOut, ?_⟩
  dsimp [evalMemCopyStmt, mkAssignUse]
  rw [hDstDecl]
  dsimp [evalMemCopyBaseRvalue, evalMemCopyBaseOperandToSlot]
  have hUninit : liveUninitSlot usizeTy = .live none := rfl
  rw [hSrcDecl, hSrcLive]
  dsimp
  rw [hUninit, hSetMid]
  dsimp
  have hBeq : (!MirTy.beq usizeTy usizeTy) = false := rfl
  rw [hBeq]
  dsimp [writeMemCopyBasePlace]
  have hChk : (!checkVal outVal usizeTy) = false := by
    rw [s4_checkVal_usize_ofNat hn]; rfl
  rw [hChk]
  dsimp
  have hDstMid : Trusted.MirSemantics.getElem? slotsMid dst = some (.baseSlot (.live ovOld)) := by
    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNe hSetMid]
    exact hDstLive
  rw [hDstMid]
  dsimp
  rw [hSetOut]

private theorem s4_step_mkAssignUse_usize_const_scr
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    (frame : MemCopyFrame) (mem : CallerMemory)
    {r nVal : Nat} (hr : r < 4) (hn : nVal < maxUsize) {ovOld : Option Val}
    (hLive : Trusted.MirSemantics.getElem? frame.locals
        (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) =
      some (.baseSlot (.live ovOld))) :
    ∃ slotsOut : List MemCopySlot,
      setElem? frame.locals (pack.bodySrc.locals.length + 1 + 2 * pack.size + r)
        (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 nVal⟩)))) = some slotsOut ∧
      evalMemCopyStmt pack.bodyTgt frame mem
        (mkAssignUse (pack.bodySrc.locals.length + 1 + 2 * pack.size + r) (usizeConst nVal)) =
        stepMemCopyNext frame mem slotsOut := by
  let dst := pack.bodySrc.locals.length + 1 + 2 * pack.size + r
  have hDstDecl := s4_getElem?_bodyTgt_locals_scr pack hr
  have hDstLt : dst < frame.locals.length := s4_getElem?_some_lt _ _ _ hLive
  let outVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 nVal⟩
  cases s4_lt_setElem?_some frame.locals dst (.baseSlot (.live (some outVal))) hDstLt with
  | intro slotsOut hSetOut =>
  refine ⟨slotsOut, hSetOut, ?_⟩
  dsimp [evalMemCopyStmt, mkAssignUse]
  rw [hDstDecl]
  dsimp [evalMemCopyBaseRvalue, evalMemCopyBaseOperandToSlot, usizeConst]
  rw [s4_evalConstLit_usizeConst hn]
  dsimp
  have hBeq : (!MirTy.beq usizeTy usizeTy) = false := rfl
  rw [hBeq]
  dsimp [writeMemCopyBasePlace]
  have hChk : (!checkVal outVal usizeTy) = false := by
    rw [s4_checkVal_usize_ofNat hn]; rfl
  rw [hChk]
  dsimp
  rw [hLive]
  dsimp
  rw [hSetOut]

private theorem s4_findAlloc?_mem (aid : AllocId) (alloc : Allocation) :
    ∀ xs : List Allocation, findAlloc? aid xs = some alloc → List.Mem alloc xs
  | [], h => by cases h
  | a :: tl, h => by
    dsimp [findAlloc?] at h
    cases hEq : Nat.beq a.allocId aid with
    | true =>
      rw [hEq] at h
      cases Option.some.inj h
      exact List.Mem.head _
    | false =>
      rw [hEq] at h
      exact List.Mem.tail _ (s4_findAlloc?_mem aid alloc tl h)

private theorem s4_sim_term_writeBuf_other
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {b nextBb : Nat} {offOp tagOp valOp : Operand}
    (hBNe : b ≠ plan.bufLocal)
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTermSrc : bbSrc.terminator = .writeBufRawByte b offOp tagOp valOp nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hNone₁ : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = none :=
    s4_getElem?_ge_none bbSrc.statements f₁.stmtIdx (by rw [hEnd₁]; exact Nat.le_refl _)
  have hEvSrc := s4_evalStepMemCopy_at_term pSrc pack.bodySrc f₁ m₁ bbSrc
    hBodySrc hBbSrc hNone₁ hEnd₁
  have hLow := s4_lowerBlock_getElem?_termPre pack hBbSrc
  cases hLow with | intro extraStart hL =>
  let base := pack.bodySrc.locals.length
  let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability extraStart bbSrc.terminator
  let bbTgt : MemCopyBlock := {
    bbSrc with
    statements := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
    terminator := termRes.2.1
  }
  have hTermTgt : termRes = ([], .writeBufRawByte b offOp tagOp valOp (nextBb + 1), []) := by
    dsimp [termRes]; rw [hTermSrc]; dsimp [lowerTermForBuf]; rw [s4_nat_beq_false hBNe]; rfl
  have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
    rw [hBbRel]; exact hL.2.1
  have hEnd₂ : f₂.stmtIdx = bbTgt.statements.length := by
    have hPre0 : termRes.1.length = 0 := by rw [hTermTgt]; rfl
    have hOff := hL.2.2.2.1
    rw [hPre0, Nat.add_zero] at hOff
    rw [hLenEq, hEnd₁, ← hL.2.2.1, hOff]
  have hNone₂ : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx = none :=
    s4_getElem?_ge_none bbTgt.statements f₂.stmtIdx (by rw [hEnd₂]; exact Nat.le_refl _)
  have hEvTgt := s4_evalStepMemCopy_at_term pTgt pack.bodyTgt f₂ m₂ bbTgt
    hBodyTgt hBbTgt hNone₂ hEnd₂
  have hTermTgtField : bbTgt.terminator = .writeBufRawByte b offOp tagOp valOp (nextBb + 1) := by
    dsimp [bbTgt]; rw [hTermTgt]
  have hTermChk := (s4_bodySrc_block_checks pack hBbSrc).2
  rw [hTermSrc] at hTermChk
  dsimp [checkTermForBuf] at hTermChk
  have hA1 := (bool_and_eq_true _ _).mp hTermChk
  have hA2 := (bool_and_eq_true _ _).mp hA1.1
  have hA3 := (bool_and_eq_true _ _).mp hA2.1
  have hOpOff := s4_operandUsesOnlyBaseMem_of_hasBaseTy pack.bodySrc.locals usizeTy offOp hA3.1
  have hOpTag := s4_operandUsesOnlyBaseMem_of_hasBaseTy pack.bodySrc.locals usizeTy tagOp hA3.2
  have hOpVal := s4_operandUsesOnlyBaseMem_of_hasBaseTy pack.bodySrc.locals usizeTy valOp hA2.2
  have hTermLoc := s4_bodySrc_term_localsInBounds pack hBbSrc
  rw [hTermSrc] at hTermLoc
  dsimp [memCopyTermLocalsInBounds] at hTermLoc
  have hL1 := (bool_and_eq_true _ _).mp hTermLoc
  have hL2 := (bool_and_eq_true _ _).mp hL1.1
  have hL3 := (bool_and_eq_true _ _).mp hL2.1
  have hBIn : b < pack.bodySrc.locals.length := (nat_blt_eq_lt _ _).mp hL3.1
  have hDB := s4_getElem?_bodyTgt_locals_lt pack hBIn hBNe
  have hAidNe : internalAllocBase + b ≠ internalAllocBase + plan.bufLocal := fun h =>
    hBNe (Nat.add_left_cancel h)
  have hFindNe : findAlloc? (internalAllocBase + b) m₂.allocations =
      findAlloc? (internalAllocBase + b) m₁.allocations := by
    rw [hMem.1]
    exact s4_findAlloc?_filter_ne (internalAllocBase + plan.bufLocal) (internalAllocBase + b)
      hAidNe m₁.allocations
  have hOffPref := s4_evalUsizeOp_prefix pack hPM hWf hBuf hScr hOpOff
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep
    rw [hEvSrc] at hStep; dsimp [evalMemCopyTerm] at hStep; rw [hTermSrc] at hStep; dsimp at hStep
    cases hB1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
    | none => rw [hB1] at hStep; cases hStep
    | some dB =>
      rw [hB1] at hStep
      cases dB with
      | ptrLocal | base _ => cases hStep
      | byteBuf sz al mu =>
        cases hOff : evalUsizeOp pack.bodySrc.locals f₁.locals offOp with
        | error _ => rw [hOff] at hStep; cases hStep
        | ok resOff =>
          rw [hOff] at hStep hOffPref
          cases hOffPref.2 with | intro slots₂₁ hP1 =>
          dsimp at hStep
          have hTagPref := s4_evalUsizeOp_prefix pack hP1.2.1 hP1.2.2.1 hP1.2.2.2.1 hP1.2.2.2.2 hOpTag
          cases hTag : evalUsizeOp pack.bodySrc.locals resOff.2 tagOp with
          | error _ => rw [hTag] at hStep; cases hStep
          | ok resTag =>
            rw [hTag] at hStep hTagPref
            cases hTagPref.2 with | intro slots₂₂ hP2 =>
            dsimp at hStep
            have hValPref := s4_evalUsizeOp_prefix pack hP2.2.1 hP2.2.2.1 hP2.2.2.2.1 hP2.2.2.2.2 hOpVal
            cases hVal : evalUsizeOp pack.bodySrc.locals resTag.2 valOp with
            | error _ => rw [hVal] at hStep; cases hStep
            | ok resVal =>
              rw [hVal] at hStep hValPref
              cases hValPref.2 with | intro slots₂₃ hP3 =>
              dsimp at hStep
              have hS3B := hP3.2.1.2.2 b hBIn hBNe
              cases hSlB : Trusted.MirSemantics.getElem? resVal.2 b with
              | none => rw [hSlB] at hStep; cases hStep
              | some slB =>
                rw [hSlB] at hStep
                cases slB with
                | baseSlot _ | ptrDead | livePtr _ => cases hStep
                | bufSlot isLB =>
                  cases isLB with
                  | false => cases hStep
                  | true =>
                    cases hFind : findAlloc? (internalAllocBase + b) m₁.allocations with
                    | none => rw [hFind] at hStep; cases hStep
                    | some alloc =>
                      rw [hFind] at hStep; dsimp at hStep
                      cases hBad : !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
                          !Nat.blt resOff.1 alloc.bytes.length with
                      | true => rw [hBad] at hStep; cases hStep
                      | false =>
                        rw [hBad] at hStep; dsimp at hStep
                        let ab := decodeAllocByte resTag.1 resVal.1
                        let updated : Allocation :=
                          { alloc with bytes := spliceBytes alloc.bytes resOff.1 [ab] }
                        cases hUp1 : updateAlloc? (internalAllocBase + b) updated m₁.allocations with
                        | none => rw [hUp1] at hStep; cases hStep
                        | some allocs₁' =>
                          rw [hUp1] at hStep
                          dsimp [jumpMemCopyBlock] at hStep
                          cases StepResult.step.inj hStep
                          have hUpComm := s4_updateAlloc?_filter_ne (internalAllocBase + plan.bufLocal)
                            (internalAllocBase + b) updated hAidNe
                            (s4_findAlloc?_allocId (internalAllocBase + b) alloc m₁.allocations hFind) m₁.allocations
                          rw [hUp1, ← hMem.1] at hUpComm
                          dsimp [Option.map] at hUpComm
                          cases hUp2 : updateAlloc? (internalAllocBase + b) updated m₂.allocations with
                          | none => rw [hUp2] at hUpComm; cases hUpComm
                          | some allocs₂' =>
                            rw [hUp2] at hUpComm
                            have hAlEq : allocs₂' = allocs₁'.filter
                                (fun a => !Nat.beq a.allocId (internalAllocBase + plan.bufLocal)) :=
                              (Option.some.inj hUpComm).symm
                            have hTagWf : (encodeAllocByte ab).1 < maxUsize := by
                              dsimp [ab]
                              rw [s4_encodeAllocByte_decodeAllocByte]
                              exact hTagPref.1
                            have hAllocMem : List.Mem alloc m₁.allocations :=
                              s4_findAlloc?_mem (internalAllocBase + b) alloc m₁.allocations hFind
                            have hAllocInfo := hMem.2 alloc hAllocMem
                            have hMem' : s4_MemRel pack ⟨allocs₁'⟩ ⟨allocs₂'⟩ := by
                              refine ⟨hAlEq, fun a ha => ?_⟩
                              cases s4_updateAlloc?_mem (internalAllocBase + b) updated
                                  m₁.allocations allocs₁' a hUp1 ha with
                              | inl hEqU =>
                                cases hAllocInfo with | intro id0 hAi1 =>
                                cases hAi1 with | intro sz0 hAi2 =>
                                cases hAi2 with | intro al0 hAi3 =>
                                cases hAi3 with | intro mu0 hAi4 =>
                                rw [hEqU]
                                exact ⟨id0, sz0, al0, mu0, hAi4.1, hAi4.2.1,
                                  s4_all_spliceBytes_wf alloc.bytes resOff.1 ab hAi4.2.2 hTagWf⟩
                              | inr hOld => exact hMem.2 a hOld
                            have hBuf' : s4_BufRel pack resVal.2 ⟨allocs₁'⟩ slots₂₃ := by
                              cases hP3.2.2.2.1 with | intro isL0 hBuf0 =>
                              cases hBuf0 with | intro bufAl hBuf1 =>
                              have hFindBuf' : findAlloc? (internalAllocBase + plan.bufLocal) allocs₁' =
                                  some bufAl := by
                                rw [s4_findAlloc?_updateAlloc?_ne (internalAllocBase + b)
                                  (internalAllocBase + plan.bufLocal) updated hAidNe.symm
                                  (s4_findAlloc?_allocId (internalAllocBase + b) alloc m₁.allocations hFind)
                                  m₁.allocations allocs₁' hUp1]
                                exact hBuf1.2.1
                              exact ⟨isL0, bufAl, hBuf1.1, hFindBuf', hBuf1.2.2⟩
                            have hStepTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } =
                                .step { frames := [{ f₂ with blockIdx := nextBb + 1, stmtIdx := 0, locals := slots₂₃ }],
                                        mem := ⟨allocs₂'⟩ } := by
                              rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hTermTgtField]; dsimp
                              rw [hDB, hB1]; dsimp
                              rw [hP1.1]; dsimp
                              rw [hP2.1]; dsimp
                              rw [hP3.1]; dsimp
                              rw [hS3B, hSlB, hFindNe, hFind]; dsimp; rw [hBad]; dsimp
                              rw [hUp2]; rfl
                            exact s4_reachesPlus_term_rel_mem pack hSame hSame₂
                              (s4_reachesNMemCopy_one_step hStepTgt) hP3.2.1 hP3.2.2.1
                              hBuf' hMem' hP3.2.2.2.2
  · intro out hDone
    rw [hEvSrc] at hDone; dsimp [evalMemCopyTerm] at hDone; rw [hTermSrc] at hDone; dsimp at hDone
    cases hB1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
    | none => rw [hB1] at hDone; cases hDone
    | some dB =>
      rw [hB1] at hDone
      cases dB with
      | ptrLocal | base _ => cases hDone
      | byteBuf _ _ _ =>
        cases hOff : evalUsizeOp pack.bodySrc.locals f₁.locals offOp with
        | error _ => rw [hOff] at hDone; cases hDone
        | ok resOff =>
          rw [hOff] at hDone; dsimp at hDone
          cases hTag : evalUsizeOp pack.bodySrc.locals resOff.2 tagOp with
          | error _ => rw [hTag] at hDone; cases hDone
          | ok resTag =>
            rw [hTag] at hDone; dsimp at hDone
            cases hVal : evalUsizeOp pack.bodySrc.locals resTag.2 valOp with
            | error _ => rw [hVal] at hDone; cases hDone
            | ok resVal =>
              rw [hVal] at hDone; dsimp at hDone
              cases hSlB : Trusted.MirSemantics.getElem? resVal.2 b with
              | none => rw [hSlB] at hDone; cases hDone
              | some slB =>
                rw [hSlB] at hDone
                cases slB with
                | baseSlot _ | ptrDead | livePtr _ => cases hDone
                | bufSlot isLB =>
                  cases isLB with
                  | false => cases hDone
                  | true =>
                    cases hFind : findAlloc? (internalAllocBase + b) m₁.allocations with
                    | none => rw [hFind] at hDone; cases hDone
                    | some alloc =>
                      rw [hFind] at hDone; dsimp at hDone
                      cases hBad : !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
                          !Nat.blt resOff.1 alloc.bytes.length with
                      | true => rw [hBad] at hDone; cases hDone
                      | false =>
                        rw [hBad] at hDone; dsimp at hDone
                        cases hUp : updateAlloc? (internalAllocBase + b) _ m₁.allocations with
                        | none => rw [hUp] at hDone; cases hDone
                        | some _ => rw [hUp] at hDone; cases hDone
  · intro k hFault
    rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault; dsimp at hFault
    have hFaultTgt : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } = .fault k := by
      rw [hEvTgt]; dsimp [evalMemCopyTerm]; rw [hTermTgtField]; dsimp; rw [hDB]
      cases hB1 : Trusted.MirSemantics.getElem? pack.bodySrc.locals b with
      | none => rw [hB1] at hFault; exact hFault
      | some dB =>
        rw [hB1] at hFault
        cases dB with
        | ptrLocal | base _ => exact hFault
        | byteBuf sz al mu =>
          cases hOff : evalUsizeOp pack.bodySrc.locals f₁.locals offOp with
          | error k1 =>
            rw [hOff] at hFault hOffPref
            rw [hOffPref]; exact hFault
          | ok resOff =>
            rw [hOff] at hFault hOffPref
            cases hOffPref.2 with | intro slots₂₁ hP1 =>
            rw [hP1.1]; dsimp; dsimp at hFault
            have hTagPref := s4_evalUsizeOp_prefix pack hP1.2.1 hP1.2.2.1 hP1.2.2.2.1 hP1.2.2.2.2 hOpTag
            cases hTag : evalUsizeOp pack.bodySrc.locals resOff.2 tagOp with
            | error k2 =>
              rw [hTag] at hFault hTagPref
              rw [hTagPref]; exact hFault
            | ok resTag =>
              rw [hTag] at hFault hTagPref
              cases hTagPref.2 with | intro slots₂₂ hP2 =>
              rw [hP2.1]; dsimp; dsimp at hFault
              have hValPref := s4_evalUsizeOp_prefix pack hP2.2.1 hP2.2.2.1 hP2.2.2.2.1 hP2.2.2.2.2 hOpVal
              cases hVal : evalUsizeOp pack.bodySrc.locals resTag.2 valOp with
              | error k3 =>
                rw [hVal] at hFault hValPref
                rw [hValPref]; exact hFault
              | ok resVal =>
                rw [hVal] at hFault hValPref
                cases hValPref.2 with | intro slots₂₃ hP3 =>
                rw [hP3.1]; dsimp; dsimp at hFault
                rw [hP3.2.1.2.2 b hBIn hBNe]
                cases hSlB : Trusted.MirSemantics.getElem? resVal.2 b with
                | none => rw [hSlB] at hFault; exact hFault
                | some slB =>
                  rw [hSlB] at hFault
                  cases slB with
                  | baseSlot _ | ptrDead | livePtr _ => exact hFault
                  | bufSlot isLB =>
                    cases isLB with
                    | false => exact hFault
                    | true =>
                      rw [hFindNe]
                      cases hFind : findAlloc? (internalAllocBase + b) m₁.allocations with
                      | none => rw [hFind] at hFault; exact hFault
                      | some alloc =>
                        rw [hFind] at hFault; dsimp at hFault
                        cases hBad : !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
                            !Nat.blt resOff.1 alloc.bytes.length with
                        | true => rw [hBad] at hFault; dsimp at hFault; dsimp; rw [hBad]; exact hFault
                        | false =>
                          rw [hBad] at hFault; dsimp at hFault; dsimp; rw [hBad]; dsimp
                          let ab := decodeAllocByte resTag.1 resVal.1
                          let updated : Allocation :=
                            { alloc with bytes := spliceBytes alloc.bytes resOff.1 [ab] }
                          have hUpComm := s4_updateAlloc?_filter_ne (internalAllocBase + plan.bufLocal)
                            (internalAllocBase + b) updated hAidNe
                            (s4_findAlloc?_allocId (internalAllocBase + b) alloc m₁.allocations hFind) m₁.allocations
                          rw [← hMem.1] at hUpComm
                          cases hUp1 : updateAlloc? (internalAllocBase + b) updated m₁.allocations with
                          | none =>
                            rw [hUp1] at hFault hUpComm
                            dsimp [Option.map] at hUpComm
                            cases hUp2 : updateAlloc? (internalAllocBase + b) updated m₂.allocations with
                            | none => exact hFault
                            | some _ => rw [hUp2] at hUpComm; cases hUpComm
                          | some allocs₁' =>
                            rw [hUp1] at hFault; cases hFault
    exact s4_reachesMemCopy_of_reach_step_fault (ReachesNMemCopy.zero _) hFaultTgt

private theorem s4_sim_term_writeBuf_buf
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    {nextBb : Nat} {offOp tagOp valOp : Operand}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hTermSrc : bbSrc.terminator = .writeBufRawByte plan.bufLocal offOp tagOp valOp nextBb)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hNone₁ : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = none :=
    s4_getElem?_ge_none bbSrc.statements f₁.stmtIdx (by rw [hEnd₁]; exact Nat.le_refl _)
  have hEvSrc := s4_evalStepMemCopy_at_term pSrc pack.bodySrc f₁ m₁ bbSrc
    hBodySrc hBbSrc hNone₁ hEnd₁
  have hLow := s4_lowerBlock_getElem?_termPre pack hBbSrc
  cases hLow with | intro extraStart hL =>
  let base := pack.bodySrc.locals.length
  let scrBase := base + 1 + 2 * pack.size
  let faultScr := scrBase + 0
  let offScr := scrBase + 1
  let tagScr := scrBase + 2
  let valScr := scrBase + 3
  let termRes := lowerTermForBuf plan.bufLocal base pack.size pack.mutability extraStart bbSrc.terminator
  let bbTgt : MemCopyBlock := {
    bbSrc with
    statements := listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements ++ termRes.1
    terminator := termRes.2.1
  }
  have hBbTgt : Trusted.MirSemantics.getElem? pack.bodyTgt.basicBlocks f₂.blockIdx = some bbTgt := by
    rw [hBbRel]; exact hL.2.1
  have hPreEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal base pack.size) bbSrc.statements).length := by
    rw [hLenEq, hEnd₁, ← hL.2.2.1]
  have hTermTgtUnfold : termRes =
      (let evalArgs := [
         mkAssignUse offScr offOp,
         mkAssignUse tagScr tagOp,
         mkAssignUse valScr valOp,
         mkLivenessCheckStmt base
       ]
       if !(Mutability.beq pack.mutability .mut) then
         (evalArgs ++ [mkImmediateUbStmt faultScr], .baseTerm .unreachable, [])
       else
         let zeroTagBbId := extraStart
         let dispatchBbId := extraStart + 1
         let armsStartBbId := extraStart + 2
         let trapBbId := armsStartBbId + pack.size
         let built := buildWriteBufArms tagScr valScr (base + 1) (base + 1 + pack.size)
           (nextBb + 1) 0 armsStartBbId pack.size
         let zeroTagBb : MemCopyBlock := {
           statements := [mkAssignUse valScr (usizeConst 0)]
           terminator := .baseTerm (.goto dispatchBbId)
           cleanup := false
         }
         let dispatchBb : MemCopyBlock := {
           statements := []
           terminator := .baseTerm (.switchInt
             (.move { localId := offScr, projection := [] })
             { branches := built.1, otherwise := trapBbId })
           cleanup := false
         }
         let trapBb : MemCopyBlock :=
           { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
         (evalArgs ++ [
            mkBinOpStmt valScr .bitAnd
              (.move { localId := valScr, projection := [] }) (usizeConst 255)
          ],
          .baseTerm (.switchInt (.copy { localId := tagScr, projection := [] })
            { branches := [(BitVec.ofNat 128 0, zeroTagBbId)]
              otherwise := dispatchBbId }),
          [zeroTagBb, dispatchBb] ++ built.2 ++ [trapBb])) := by
    dsimp [termRes]; rw [hTermSrc]; dsimp [lowerTermForBuf]; rw [nat_beq_refl plan.bufLocal]; rfl
  have hTermChk := (s4_bodySrc_block_checks pack hBbSrc).2
  rw [hTermSrc] at hTermChk
  dsimp [checkTermForBuf] at hTermChk
  have hA1 := (bool_and_eq_true _ _).mp hTermChk
  have hA2 := (bool_and_eq_true _ _).mp hA1.1
  have hA3 := (bool_and_eq_true _ _).mp hA2.1
  have hOffDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals offScr = some (.base usizeTy) :=
    s4_getElem?_bodyTgt_locals_scr pack (Nat.succ_lt_succ (Nat.zero_lt_succ 2))
  have hTagDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals tagScr = some (.base usizeTy) :=
    s4_getElem?_bodyTgt_locals_scr pack (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 1)))
  have hValDecl : Trusted.MirSemantics.getElem? pack.bodyTgt.locals valScr = some (.base usizeTy) :=
    s4_getElem?_bodyTgt_locals_scr pack (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 0))))
  have hOffGe : base ≤ offScr := by
    dsimp [offScr]
    exact Nat.le_trans (Nat.le_add_right _ 1)
      (Nat.le_trans (Nat.le_add_right _ (2 * pack.size)) (Nat.le_add_right _ 1))
  have hTagGe : base ≤ tagScr := by
    dsimp [tagScr]
    exact Nat.le_trans (Nat.le_add_right _ 1)
      (Nat.le_trans (Nat.le_add_right _ (2 * pack.size)) (Nat.le_add_right _ 2))
  have hValGe : base ≤ valScr := by
    dsimp [valScr]
    exact Nat.le_trans (Nat.le_add_right _ 1)
      (Nat.le_trans (Nat.le_add_right _ (2 * pack.size)) (Nat.le_add_right _ 3))
  have hGetStmt : ∀ (k : Nat) (s : MemCopyStmt) (rest : List MemCopyStmt),
      termRes.1 =
        mkAssignUse offScr offOp :: mkAssignUse tagScr tagOp :: mkAssignUse valScr valOp ::
          mkLivenessCheckStmt base :: rest →
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + k) =
        Trusted.MirSemantics.getElem?
          (mkAssignUse offScr offOp :: mkAssignUse tagScr tagOp :: mkAssignUse valScr valOp ::
            mkLivenessCheckStmt base :: rest) k := by
    intro k s rest hEq
    dsimp [bbTgt]
    rw [hEq, hPreEq]
    exact s4_getElem?_append_right _ _ k
  have hTermStmtPre : ∀ (k : Nat),
      Trusted.MirSemantics.getElem?
        (mkAssignUse offScr offOp :: mkAssignUse tagScr tagOp :: mkAssignUse valScr valOp ::
          mkLivenessCheckStmt base :: (if !(Mutability.beq pack.mutability .mut) then
            [mkImmediateUbStmt faultScr] else [mkBinOpStmt valScr .bitAnd
              (.move { localId := valScr, projection := [] }) (usizeConst 255)])) k =
      Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + k) := by
    intro k
    have hEq : termRes.1 =
        mkAssignUse offScr offOp :: mkAssignUse tagScr tagOp :: mkAssignUse valScr valOp ::
          mkLivenessCheckStmt base :: (if !(Mutability.beq pack.mutability .mut) then
            [mkImmediateUbStmt faultScr] else [mkBinOpStmt valScr .bitAnd
              (.move { localId := valScr, projection := [] }) (usizeConst 255)]) := by
      rw [hTermTgtUnfold]
      cases !(Mutability.beq pack.mutability .mut) <;> rfl
    dsimp [bbTgt]
    rw [hEq, hPreEq, s4_getElem?_append_right _ _ k]
  have hSt0 : Trusted.MirSemantics.getElem? bbTgt.statements f₂.stmtIdx =
      some (mkAssignUse offScr offOp) := by
    have h := hTermStmtPre 0
    rw [Nat.add_zero] at h
    exact h.symm
  have hSt1 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 1) =
      some (mkAssignUse tagScr tagOp) := (hTermStmtPre 1).symm
  have hSt2 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 2) =
      some (mkAssignUse valScr valOp) := (hTermStmtPre 2).symm
  have hSt3 : Trusted.MirSemantics.getElem? bbTgt.statements (f₂.stmtIdx + 3) =
      some (mkLivenessCheckStmt base) := (hTermStmtPre 3).symm
  cases hScr 1 (Nat.succ_lt_succ (Nat.zero_lt_succ 2)) with | intro ovOff hOffLive =>
  cases hEvOff : evalUsizeOp pack.bodySrc.locals f₁.locals offOp with
  | error kErr =>
    have hF0 : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } = .fault kErr := by
      rw [s4_evalStepMemCopy_at_stmt pTgt pack.bodyTgt f₂ m₂ bbTgt _ hBodyTgt hBbTgt hSt0]
      exact s4_step_mkAssignUse_usize_err pack f₁ f₂ m₁ m₂ hPM hWf hBuf hScr hOffDecl hA3.1 hEvOff
    refine ⟨?_, ?_, ?_⟩
    · intro _ h
      rw [hEvSrc] at h; dsimp [evalMemCopyTerm] at h; rw [hTermSrc] at h; dsimp at h; rw [pack.hBufDecl] at h
      dsimp at h; rw [hEvOff] at h; cases h
    · intro _ h
      rw [hEvSrc] at h; dsimp [evalMemCopyTerm] at h; rw [hTermSrc] at h; dsimp at h; rw [pack.hBufDecl] at h
      dsimp at h; rw [hEvOff] at h; cases h
    · intro k hFault
      rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault; dsimp at hFault; rw [pack.hBufDecl] at hFault
      dsimp at hFault; rw [hEvOff] at hFault
      cases StepResult.fault.inj hFault
      exact s4_reachesMemCopy_of_reach_step_fault (ReachesNMemCopy.zero _) hF0
  | ok resOff =>
    have hOk0 := s4_step_mkAssignUse_usize_ok pack f₁ f₂ m₁ m₂ hPM hWf hBuf hScr
      hOffDecl hOffGe hOffLive hA3.1 hEvOff
    cases hOk0.2 with | intro slots₂₀Mid hOk0a =>
    cases hOk0a with | intro slots₂₁ hOk0b =>
    have hOffLt := hOk0.1
    have hSetOff := hOk0b.2.1
    have hPM₁ := s4_prefixMatch_set_scr_public pack hOk0b.2.2.2.1 hSetOff
    have hWf₁ := hOk0b.2.2.2.2.1
    have hBuf₁ := s4_bufRel_set_scr pack hOk0b.2.2.2.2.2.1 hSetOff
    have hScr₁ := s4_scrLive_set_scr pack hOk0b.2.2.2.2.2.2 hSetOff
      (ov0 := some (.scalar ⟨.isize, false, BitVec.ofNat 128 resOff.1⟩))
    have hStep0 : evalStepMemCopy pTgt 0 { frames := [f₂], mem := m₂ } =
        .step { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂₁ }], mem := m₂ } := by
      rw [s4_evalStepMemCopy_at_stmt pTgt pack.bodyTgt f₂ m₂ bbTgt _ hBodyTgt hBbTgt hSt0]
      exact hOk0b.2.2.1
    let f₂₁ : MemCopyFrame := { f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂₁ }
    let f₁₁ : MemCopyFrame := { f₁ with locals := resOff.2 }
    have hR1 : ReachesNMemCopy pTgt 1 { frames := [f₂], mem := m₂ } { frames := [f₂₁], mem := m₂ } :=
      s4_reachesNMemCopy_one_step hStep0
    cases hScr₁ 2 (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 1))) with | intro ovTag hTagLive =>
    cases hEvTag : evalUsizeOp pack.bodySrc.locals resOff.2 tagOp with
    | error kErr =>
      have hF1 : evalStepMemCopy pTgt 0 { frames := [f₂₁], mem := m₂ } = .fault kErr := by
        rw [s4_evalStepMemCopy_at_stmt pTgt pack.bodyTgt f₂₁ m₂ bbTgt _ hBodyTgt hBbTgt hSt1]
        exact s4_step_mkAssignUse_usize_err pack f₁₁ f₂₁ m₁ m₂ hPM₁ hWf₁ hBuf₁ hScr₁ hTagDecl hA3.2 hEvTag
      refine ⟨?_, ?_, ?_⟩
      · intro _ h
        rw [hEvSrc] at h; dsimp [evalMemCopyTerm] at h; rw [hTermSrc] at h; dsimp at h; rw [pack.hBufDecl] at h
        dsimp at h; rw [hEvOff] at h; dsimp at h; rw [hEvTag] at h; cases h
