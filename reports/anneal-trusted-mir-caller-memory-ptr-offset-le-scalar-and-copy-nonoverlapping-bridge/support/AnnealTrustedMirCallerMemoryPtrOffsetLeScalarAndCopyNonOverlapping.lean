private theorem memCopyLocalDeclEq_eq : ∀ a b : MemCopyLocalDecl, memCopyLocalDeclEq a b = true → a = b
  | .base t₁, .base t₂, h => by rw [mirTy_beq_eq t₁ t₂ h]
  | .byteBuf s₁ a₁ m₁, .byteBuf s₂ a₂ m₂, h => by
    have h1 := (bool_and_eq_true _ _).mp h
    have h2 := (bool_and_eq_true _ _).mp h1.1
    rw [nat_beq_eq s₁ s₂ h2.1, nat_beq_eq a₁ a₂ h2.2, mutability_beq_eq m₁ m₂ h1.2]
