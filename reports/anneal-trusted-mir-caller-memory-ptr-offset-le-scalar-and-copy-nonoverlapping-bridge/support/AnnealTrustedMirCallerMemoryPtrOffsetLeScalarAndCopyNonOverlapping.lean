private theorem s3x_exec_switchInt_cnt_term (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {slots₂ : List MemCopySlot} {mem : CallerMemory}
    (cntVal : Nat) (nextBb altBb : BasicBlockId)
    (hCntLt : cntVal < maxUsize)
    (hSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 4) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 cntVal })))))
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hTerm : bbTgt.terminator = .baseTerm (.switchInt
      (.copy { localId := s3_scrBase ctx + 4, projection := [] })
      { branches := [(BitVec.ofNat 128 0, nextBb)], otherwise := altBb })) :
    evalStepMemCopy ctx.pTgt 0
        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ }], mem := mem } =
      .step {
          frames := [{
            defId := ctx.plan.defId,
            blockIdx := if Nat.beq cntVal 0 then nextBb else altBb,
            stmtIdx := 0,
            locals := slots₂
          }],
          mem := mem } := by
  rw [s3_step_state_of_term ctx.pTgt _ mem ctx.bodyTgt bbTgt (s3_bodyTgt_get ctx) hBbTgt rfl]
  have hTgtEq : evalMemCopyTerm ctx.bodyTgt bbTgt
        { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem =
      evalMemCopyTerm ctx.bodyTgt
        { bbTgt with terminator := .baseTerm (.switchInt
          (.copy { localId := s3_scrBase ctx + 4, projection := [] })
          { branches := [(BitVec.ofNat 128 0, nextBb)], otherwise := altBb }) }
        { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem := by
    cases bbTgt; dsimp at hTerm; subst hTerm; rfl
  rw [hTgtEq]
  unfold evalMemCopyTerm
  dsimp
  rw [s3_evalPrimOp_scr_copy ctx slots₂ 4 cntVal (by decide) hSlot]; dsimp
  have hCntTr : truncateBits .isize (BitVec.ofNat 128 cntVal) = BitVec.ofNat 128 cntVal := by
    have hT := s3_truncateBits_isize cntVal (s3_evalConstLit_usize_lt128 cntVal hCntLt)
    rw [s3x_nat_mod_eq_of_lt hCntLt] at hT
    exact hT
  have hSwEq : evalSwitchBranches .isize (BitVec.ofNat 128 cntVal) altBb [(BitVec.ofNat 128 0, nextBb)] =
      .ok (if Nat.beq cntVal 0 then nextBb else altBb) := by
    cases hZ : Nat.beq cntVal 0 with
    | true =>
      have hEq0 : cntVal = 0 := nat_beq_eq _ _ hZ
      rw [hEq0]; rfl
    | false =>
      have hNe0 : cntVal ≠ 0 := nat_beq_false_ne hZ
      have hBvNe : BitVec.ofNat 128 cntVal ≠ BitVec.ofNat 128 0 := by
        intro hEq
        have hTo := congrArg BitVec.toNat hEq
        rw [s3_bitvec_toNat_ofNat_lt cntVal (s3_evalConstLit_usize_lt128 cntVal hCntLt),
          s3_bitvec_toNat_ofNat_lt 0 (by decide : 0 < Nat.pow 2 128)] at hTo
        exact hNe0 hTo
      have hRed : evalSwitchBranches .isize (BitVec.ofNat 128 cntVal) altBb [(BitVec.ofNat 128 0, nextBb)] =
          if (truncateBits .isize (BitVec.ofNat 128 cntVal) == BitVec.ofNat 128 0) then .ok nextBb else .ok altBb := rfl
      rw [hRed, hCntTr, s3x_bitVec128_beq_false hBvNe]
      rfl
  rw [hSwEq]
  cases Nat.beq cntVal 0 with
  | true => rfl
  | false => rfl

private theorem s3x_exec_switchInt_bool_term (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (b : Bool) (tTrue tFalse : BasicBlockId)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hSlot : Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + 10) =
      some (.baseSlot (.live (some (.bool b)))))
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hTerm : bbTgt.terminator = .baseTerm (.switchInt
      (.move { localId := s3_scrBase ctx + 10, projection := [] })
      { branches := [(BitVec.ofNat 128 1, tTrue)], otherwise := tFalse })) :
    ∃ slots₂' : List MemCopySlot,
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ }], mem := mem } =
        .step {
            frames := [{
              defId := ctx.plan.defId,
              blockIdx := if b then tTrue else tFalse,
              stmtIdx := 0,
              locals := slots₂'
            }],
            mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      (∀ j' : Nat, j' < 12 → j' ≠ 10 →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j')) := by
  have hLen10 : s3_scrBase ctx + 10 < slots₂.length := by
    rw [hRel.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 10 (by decide)
  cases s3x_evalPrimOp_bool_scr_move ctx slots₂ 10 b (Nat.le_refl 10) (by decide) hLen10 hSlot with
  | intro slots₂' hMove =>
    have hRel' := s3_slotsRel_set_scratch ctx slots₁ slots₂ slots₂' 10 none (by decide) hRel hMove.1
    refine ⟨slots₂', ?_, hRel', ?_⟩
    · rw [s3_step_state_of_term ctx.pTgt _ mem ctx.bodyTgt bbTgt (s3_bodyTgt_get ctx) hBbTgt rfl]
      have hTgtEq : evalMemCopyTerm ctx.bodyTgt bbTgt
            { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem =
          evalMemCopyTerm ctx.bodyTgt
            { bbTgt with terminator := .baseTerm (.switchInt
              (.move { localId := s3_scrBase ctx + 10, projection := [] })
              { branches := [(BitVec.ofNat 128 1, tTrue)], otherwise := tFalse }) }
            { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem := by
        cases bbTgt; dsimp at hTerm; subst hTerm; rfl
      rw [hTgtEq]
      unfold evalMemCopyTerm
      dsimp
      rw [hMove.2]; dsimp
      have hSwBool : evalBoolSwitchBranches b tFalse [(BitVec.ofNat 128 1, tTrue)] =
          .ok (if b then tTrue else tFalse) := by
        cases b with
        | true => rfl
        | false => rfl
      rw [hSwBool]
      cases b with
      | true => rfl
      | false => rfl
    · intro j' _ hj10
      have hNe : s3_scrBase ctx + 10 ≠ s3_scrBase ctx + j' := fun h => hj10 (Nat.add_left_cancel h).symm
      exact s3_getElem?_setElem?_ne _ _ _ _ _ hNe hMove.1

private theorem s3x_evalBaseOp_scr_move (ctx : s3_PtrCtx) (slots : List MemCopySlot)
    (j n : Nat) (hj : j < 10) (hLen : s3_scrBase ctx + j < slots.length)
    (hSlot : Trusted.MirSemantics.getElem? slots (s3_scrBase ctx + j) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }))))) :
    ∃ slots',
      setElem? slots (s3_scrBase ctx + j) (.baseSlot (.live none)) = some slots' ∧
      evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots
        (.move { localId := s3_scrBase ctx + j, projection := [] }) =
        .ok (usizeTy, some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }), slots') := by
  cases s3_setElem?_some_of_lt slots (s3_scrBase ctx + j) (.baseSlot (.live none)) hLen with
  | intro slots' hSet =>
    refine ⟨slots', hSet, ?_⟩
    unfold evalMemCopyBaseOperandToSlot
    dsimp
    rw [s3x_scr_usize_decl ctx j hj, hSlot]
    dsimp [liveUninitSlot, usizeTy]
    rw [hSet]

private theorem s3x_exec_mkAssignUse_usize_op_scr (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock} {idx : Nat}
    {slots₁ slots₂ slotsA : List MemCopySlot} {mem : CallerMemory}
    (jDst : Nat) (op : Operand) (n : Nat)
    (hj : jDst < 10) (hn : n < maxUsize)
    (hOp : evalMemCopyBaseOperandToSlot ctx.bodyTgt.locals slots₂ op =
      .ok (usizeTy, some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }), slotsA))
    (hRelA : s3_SlotsRel ctx slots₁ slotsA)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkAssignUse (s3_scrBase ctx + jDst) op)) :
    ∃ slots₂',
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂' }], mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + jDst) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))) ∧
      (∀ j' : Nat, j' < 12 → j' ≠ jDst →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slotsA (s3_scrBase ctx + j')) := by
  have hj12 : jDst < 12 := Nat.lt_trans hj (by decide)
  cases hRelA.2.2.2.2.2 jDst hj12 with | intro ov hOv =>
  have hLt : s3_scrBase ctx + jDst < slotsA.length := by
    rw [hRelA.2.1]; exact s3_scrLoc_lt_bodyTgt ctx jDst hj12
  let valSlot : MemCopySlot :=
    .baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n })))
  cases s3_setElem?_some_of_lt slotsA (s3_scrBase ctx + jDst) valSlot hLt with | intro slots₂' hSet =>
  have hRval : evalMemCopyBaseRvalue ctx.bodyTgt.locals slots₂ usizeTy (.use op) =
      .ok (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }, slotsA) := by
    unfold evalMemCopyBaseRvalue
    dsimp
    rw [hOp]; dsimp
    have hBeq : MirTy.beq usizeTy usizeTy = true := rfl
    rw [hBeq]; rfl
  refine ⟨slots₂', ?_, ?_, s3_getElem?_setElem?_eq _ _ _ _ hSet, ?_⟩
  · exact s3_reachesN_stmt_step ctx hBbTgt hStmt
      (s3_eval_mkAssignUse_ok ctx.bodyTgt _ mem (s3_scrBase ctx + jDst) usizeTy op _ ov slotsA slots₂'
        (s3x_scr_usize_decl ctx jDst hj) hRval (s3_usize_scalar_checkVal n hn) hOv hSet)
  · exact s3_slotsRel_set_scratch ctx slots₁ slotsA slots₂' jDst _ hj12 hRelA hSet
  · intro j' _ hNe
    have hNeLoc : s3_scrBase ctx + jDst ≠ s3_scrBase ctx + j' := fun h => hNe (Nat.add_left_cancel h).symm
    exact s3_getElem?_setElem?_ne _ _ _ _ _ hNeLoc hSet

private theorem s3x_evalUsizeOp_scr_move (ctx : s3_PtrCtx) (slots : List MemCopySlot)
    (j n : Nat) (hj : j < 10) (hn : n < maxUsize) (hLen : s3_scrBase ctx + j < slots.length)
    (hSlot : Trusted.MirSemantics.getElem? slots (s3_scrBase ctx + j) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }))))) :
    ∃ slots',
      setElem? slots (s3_scrBase ctx + j) (.baseSlot (.live none)) = some slots' ∧
      evalUsizeOp ctx.bodyTgt.locals slots
        (.move { localId := s3_scrBase ctx + j, projection := [] }) =
        .ok (n, slots') := by
  cases s3_setElem?_some_of_lt slots (s3_scrBase ctx + j) (.baseSlot (.live none)) hLen with
  | intro slots' hSet =>
    refine ⟨slots', hSet, ?_⟩
    unfold evalUsizeOp evalMemCopyBaseOperandToSlot
    dsimp
    rw [s3x_scr_usize_decl ctx j hj, hSlot]
    dsimp
    have hLive : liveUninitSlot usizeTy = .live none := rfl
    rw [hLive, hSet]
    dsimp
    have hTyEq : (!(MirTy.beq usizeTy usizeTy)) = false := rfl
    rw [hTyEq]
    dsimp
    rw [s3_usize_scalar_wf n hn]
    dsimp
    rw [s3_bitvec_toNat_ofNat_lt n (s3_evalConstLit_usize_lt128 n hn)]

private theorem s3x_evalUsizeOp_scr_copy (ctx : s3_PtrCtx) (slots : List MemCopySlot)
    (j n : Nat) (hj : j < 10) (hn : n < maxUsize)
    (hSlot : Trusted.MirSemantics.getElem? slots (s3_scrBase ctx + j) =
      some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 n }))))) :
    evalUsizeOp ctx.bodyTgt.locals slots
      (.copy { localId := s3_scrBase ctx + j, projection := [] }) =
      .ok (n, slots) := by
  unfold evalUsizeOp evalMemCopyBaseOperandToSlot
  dsimp
  rw [s3x_scr_usize_decl ctx j hj, hSlot]
  dsimp [usizeTy, MirTy.beq, IntWidth.beq]
  rw [s3_usize_scalar_wf n hn]; dsimp
  rw [s3_bitvec_toNat_ofNat_lt n (s3_evalConstLit_usize_lt128 n hn)]

private theorem s3x_evalUsizeOp_usizeConst (decls : List MemCopyLocalDecl)
    (slots : List MemCopySlot) (n : Nat) (hn : n < maxUsize) :
    evalUsizeOp decls slots (usizeConst n) = .ok (n, slots) := by
  unfold evalUsizeOp evalMemCopyBaseOperandToSlot usizeConst
  dsimp
  rw [s3_evalConstLit_usize n hn]
  dsimp [usizeTy, MirTy.beq, IntWidth.beq]
  rw [s3_usize_scalar_wf n hn]; dsimp
  rw [s3_bitvec_toNat_ofNat_lt n (s3_evalConstLit_usize_lt128 n hn)]

private theorem s3x_uint64_toNat_lt_maxUsize (u : UInt64) : u.toNat < maxUsize := by
  cases u with
  | ofBitVec bv =>
    cases bv with
    | ofFin fn => exact fn.isLt

private theorem s3x_reachesN_trans {p : MemCopyProgram} :
    ∀ {n₁ n₂ : Nat} {s₀ s₁ s₂ : MemCopyState},
      ReachesNMemCopy p n₁ s₀ s₁ →
      ReachesNMemCopy p n₂ s₁ s₂ →
      ReachesNMemCopy p (n₁ + n₂) s₀ s₂
  | 0, _, _, _, _, .zero _, h₂ => by
    rw [Nat.zero_add]; exact h₂
  | n₁ + 1, n₂, s₀, s₁, s₂, .succ hStep hRest, h₂ => by
    rw [Nat.succ_add]
    exact .succ hStep (s3x_reachesN_trans hRest h₂)

private theorem s3x_fwdStepSim_of_fault (ctx : s3_PtrCtx) (f₁ f₂ : MemCopyFrame)
    (mem : CallerMemory) (kErr : FaultKind)
    (hSrc : evalStepMemCopy ctx.pSrc 0 { frames := [f₁], mem := mem } = .fault kErr)
    (hTgt : ∃ (n : Nat) (sBad : MemCopyState),
      ReachesNMemCopy ctx.pTgt n { frames := [f₂], mem := mem } sBad ∧
      evalStepMemCopy ctx.pTgt 0 sBad = .fault kErr) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hS; rw [hSrc] at hS; cases hS
  · intro out hD; rw [hSrc] at hD; cases hD
  · intro k hF; rw [hSrc] at hF; cases hF
    cases hTgt with | intro n hn =>
    cases hn with | intro sBad hs =>
    exact s3_fault_of_reachesN hs.1 hs.2

private theorem s3x_fwdStepSim_of_jump (ctx : s3_PtrCtx) {f₁ f₂ : MemCopyFrame}
    {mem mem' : CallerMemory} {slots₁' slots₂' : List MemCopySlot}
    {nextBb : BasicBlockId} {bbNext : MemCopyBlock} {n : Nat}
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbNext : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks nextBb = some bbNext)
    (hSrc : evalStepMemCopy ctx.pSrc 0 { frames := [f₁], mem := mem } =
      jumpMemCopyBlock f₁ mem' slots₁' nextBb)
    (hReach : ReachesNMemCopy ctx.pTgt (n + 1) { frames := [f₂], mem := mem }
      { frames := [{ f₂ with blockIdx := nextBb, stmtIdx := 0, locals := slots₂' }], mem := mem' })
    (hWf' : s3_MemWf ctx.bodySrc slots₁' mem')
    (hRel' : s3_SlotsRel ctx slots₁' slots₂') :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hS; rw [hSrc] at hS; cases hS
    exact s3_reachesPlus_jump_rel ctx hEqId hDef₁ hDef₂ hBbNext hReach rfl hWf' hRel'
  · intro out hD; rw [hSrc] at hD; cases hD
  · intro k hF; rw [hSrc] at hF; cases hF

private theorem s3x_mutability_beq_mut (m : Mutability) (h : Mutability.beq m .mut = true) :
    m = .mut := by
  cases m
  · cases h
  · rfl

private theorem s3x_decodeLeBytesAux_bad_prefix (xs : List AllocByte)
    (off i rem acc : Nat) (abCur : AllocByte) (w : LeWidth)
    (hSum : i + rem + 1 = w.byteCount)
    (hAccOk : decodeLeBytesAux ((xs.drop off).take i) = .ok acc)
    (hCur : Trusted.MirSemantics.getElem? xs (off + i) = some abCur)
    (hBad : ∀ b : UInt8, abCur ≠ .init b none) :
    decodeLeBytesAux ((xs.drop off).take w.byteCount) = .error .undefined := by
  have hSplit : w.byteCount = (i + 1) + rem := by
    rw [← hSum, Nat.add_assoc, Nat.add_comm rem 1, ← Nat.add_assoc]
  rw [hSplit, s3x_take_split (xs.drop off) (i + 1) rem]
  rw [s3x_drop_take_succ xs off i abCur hCur]
  cases abCur with
  | uninit =>
    exact s3_decodeLeBytesAux_append_err ((xs.drop off).take i ++ [.uninit]) _ .undefined
      (s3_decodeLeBytesAux_concat_non_none ((xs.drop off).take i) .uninit True.intro ⟨acc, hAccOk⟩)
  | init b opt =>
    cases opt with
    | none => exact False.elim (hBad b rfl)
    | some aid =>
      exact s3_decodeLeBytesAux_append_err ((xs.drop off).take i ++ [.init b (some aid)]) _ .undefined
        (s3_decodeLeBytesAux_concat_non_none ((xs.drop off).take i) (.init b (some aid)) True.intro ⟨acc, hAccOk⟩)

private theorem s3x_optBuf_spec_of_find (ctx : s3_PtrCtx) (p : LocalId) (k : Nat) :
    ∀ optBuf : Option LocalId,
      findPtrEntry ctx.plan.entries p = some (k, optBuf) →
      match optBuf with
      | none => True
      | some bLoc =>
        ∃ sz al mutab,
          Trusted.MirSemantics.getElem? ctx.bodySrc.locals bLoc = some (.byteBuf sz al mutab) ∧
          sz ≤ 32 ∧ al ≤ 30
  | none, _ => True.intro
  | some bLoc, hFind => (s3x_findPtrEntry_bounds_and_spec ctx p k (some bLoc) hFind).2 bLoc rfl

private theorem s3x_ptrTagRead_sim (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {startIdx : Nat} {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (p : LocalId) (kP : Nat) (optBufP : Option LocalId) (reqAlign : Nat)
    (hFind : findPtrEntry ctx.plan.entries p = some (kP, optBufP))
    (hReq : reqAlign ≤ 30)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hWin :
      let offP := ctx.bodySrc.locals.length + 3 * kP
      let prefixStmts := [
        mkLivenessCheckStmt offP,
        mkAssignUse (s3_scrBase ctx) (.copy { localId := offP + 1, projection := [] }),
        mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := offP + 2, projection := [] })
      ] ++ mkPtrAlignCheckStmts ctx.bodySrc.locals optBufP (s3_scrBase ctx) (s3_scrBase ctx + 1)
             (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlign ++ [
        mkSubUncheckedUsize (s3_scrBase ctx + 5)
          (.copy { localId := s3_scrBase ctx, projection := [] }) (usizeConst 1)
      ]
      ∀ k s, Trusted.MirSemantics.getElem? prefixStmts k = some s →
        Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + k) = some s) :
    let alignLen := (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufP (s3_scrBase ctx)
      (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlign).length
    match readPtrLocal ctx.bodySrc.locals slots₁ p false with
    | .error k =>
      ∃ (n : Nat) (sBad : MemCopyState),
        ReachesNMemCopy ctx.pTgt n
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
          sBad ∧
        evalStepMemCopy ctx.pTgt 0 sBad = .fault k
    | .ok (pv, slots₁') =>
      slots₁' = slots₁ ∧
      match checkPtrAlignMem mem pv reqAlign with
      | .error k =>
        ∃ (n : Nat) (sBad : MemCopyState),
          ReachesNMemCopy ctx.pTgt n
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
            sBad ∧
          evalStepMemCopy ctx.pTgt 0 sBad = .fault k
      | .ok () =>
        match optBufP, pv.allocId with
        | some bufLoc, some aid =>
          aid = internalAllocBase + bufLoc ∧
          ∃ slots₂' : List MemCopySlot,
            ReachesNMemCopy ctx.pTgt (3 + alignLen + 1)
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + (3 + alignLen + 1), locals := slots₂' }], mem := mem } ∧
            s3_SlotsRel ctx slots₁ slots₂' ∧
            Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 1) =
              some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) ∧
            (∀ j' : Nat, j' < 12 → j' ≠ 0 → j' ≠ 1 → j' ≠ 5 → j' ≠ 6 →
              Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
                Trusted.MirSemantics.getElem? slots₂ (s3_scrBase ctx + j'))
        | _, _ =>
          ∃ (n : Nat) (sBad : MemCopyState),
            ReachesNMemCopy ctx.pTgt n
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx, locals := slots₂ }], mem := mem }
              sBad ∧
            evalStepMemCopy ctx.pTgt 0 sBad = .fault .undefined := by
  intro alignLen
  let offP := ctx.bodySrc.locals.length + 3 * kP
  let readStmts := [
    mkLivenessCheckStmt offP,
    mkAssignUse (s3_scrBase ctx) (.copy { localId := offP + 1, projection := [] }),
    mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := offP + 2, projection := [] })
  ]
  let alignStmts := mkPtrAlignCheckStmts ctx.bodySrc.locals optBufP (s3_scrBase ctx)
    (s3_scrBase ctx + 1) (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlign
  let tagStmts := [
    mkSubUncheckedUsize (s3_scrBase ctx + 5)
      (.copy { localId := s3_scrBase ctx, projection := [] }) (usizeConst 1)
  ]
  have hWinLeft : ∀ k s, Trusted.MirSemantics.getElem? (readStmts ++ alignStmts) k = some s →
      Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + k) = some s :=
    s3x_window_append_left hWin
  have hWinRead : ∀ k s, Trusted.MirSemantics.getElem? readStmts k = some s →
      Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + k) = some s :=
    s3x_window_append_left hWinLeft
  have hWinAlign : ∀ k s, Trusted.MirSemantics.getElem? alignStmts k = some s →
      Trusted.MirSemantics.getElem? bbTgt.statements ((startIdx + 3) + k) = some s :=
    s3x_window_append_right (a := readStmts) hWinLeft
  have hWinTag : ∀ k s, Trusted.MirSemantics.getElem? tagStmts k = some s →
      Trusted.MirSemantics.getElem? bbTgt.statements ((startIdx + (readStmts ++ alignStmts).length) + k) = some s :=
    s3x_window_append_right (a := readStmts ++ alignStmts) hWin
  have hS0 : Trusted.MirSemantics.getElem? bbTgt.statements startIdx =
      some (mkLivenessCheckStmt offP) := by
    have h := hWinRead 0 _ rfl; rw [Nat.add_zero] at h; exact h
  have hS1 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 1) =
      some (mkAssignUse (s3_scrBase ctx + 0) (.copy { localId := offP + 1, projection := [] })) :=
    hWinRead 1 _ rfl
  have hS2 : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + 2) =
      some (mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := offP + 2, projection := [] })) :=
    hWinRead 2 _ rfl
  have hReadRes := s3_exec_readPtr ctx (mem := mem) p kP 0 1 optBufP false hFind
    (by decide) (by decide) (by decide) hWf hRel hBbTgt hS0 hS1 hS2
  cases hRp : readPtrLocal ctx.bodySrc.locals slots₁ p false with
  | error err => rw [hRp] at hReadRes; exact hReadRes
  | ok rp =>
    rw [hRp] at hReadRes
    cases rp with | mk pv slots₁' =>
    dsimp at hReadRes
    cases hReadRes with | intro tagVal hTv =>
    cases hTv with | intro s2a hS2a =>
    have hSlEq : slots₁' = slots₁ := s3x_readPtrLocal_false_slots hRp
    rw [hSlEq] at hS2a
    refine ⟨hSlEq, ?_⟩
    have hOffLtMax : pv.offsetBytes.toNat < maxUsize := s3x_uint64_toNat_lt_maxUsize pv.offsetBytes
    have hAlignRes :
        match checkPtrAlignMem mem pv reqAlign with
        | .error err =>
          ∃ (n : Nat) (sBad : MemCopyState),
            ReachesNMemCopy ctx.pTgt n
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2a }], mem := mem }
              sBad ∧
            evalStepMemCopy ctx.pTgt 0 sBad = .fault err
        | .ok () =>
          let nStmts := (mkPtrAlignCheckStmts ctx.bodySrc.locals optBufP (s3_scrBase ctx) (s3_scrBase ctx + 1)
            (s3_scrBase ctx + 5) (s3_scrBase ctx + 6) reqAlign).length
          ∃ slots₂' : List MemCopySlot,
            ReachesNMemCopy ctx.pTgt nStmts
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := startIdx + 3, locals := s2a }], mem := mem }
              { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := (startIdx + 3) + nStmts, locals := slots₂' }], mem := mem } ∧
            s3_SlotsRel ctx slots₁ slots₂' ∧
            (∀ j' : Nat, j' < 12 → j' ≠ 5 → j' ≠ 6 →
              Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
                Trusted.MirSemantics.getElem? s2a (s3_scrBase ctx + j')) := by
      cases optBufP with
      | none =>
        exact s3_exec_mkPtrAlignCheckStmts ctx (mem := mem) (startIdx := startIdx + 3)
          none 0 1 reqAlign tagVal pv.offsetBytes.toNat pv hReq (by decide) (by decide)
          hS2a.2.2.1 hOffLtMax hS2a.2.1 rfl True.intro
          hWf hS2a.2.2.2.2.2.1 hS2a.2.2.2.2.2.2.1 hS2a.2.2.2.2.2.2.2.1 hBbTgt hWinAlign
      | some bLoc =>
        exact s3_exec_mkPtrAlignCheckStmts ctx (mem := mem) (startIdx := startIdx + 3)
          (some bLoc) 0 1 reqAlign tagVal pv.offsetBytes.toNat pv hReq (by decide) (by decide)
          hS2a.2.2.1 hOffLtMax hS2a.2.1 rfl
          ((s3x_findPtrEntry_bounds_and_spec ctx p kP (some bLoc) hFind).2 bLoc rfl)
          hWf hS2a.2.2.2.2.2.1 hS2a.2.2.2.2.2.2.1 hS2a.2.2.2.2.2.2.2.1 hBbTgt hWinAlign
    cases hAl : checkPtrAlignMem mem pv reqAlign with
    | error err =>
      rw [hAl] at hAlignRes
      cases hAlignRes with | intro nA hnA =>
      cases hnA with | intro sBad hsBad =>
      exact ⟨3 + nA, sBad, s3x_reachesN_trans hS2a.2.2.2.1 hsBad.1, hsBad.2⟩
    | ok _ =>
      rw [hAl] at hAlignRes
      dsimp at hAlignRes
      cases hAlignRes with | intro s2b hS2b =>
      have hPreAlLen : (readStmts ++ alignStmts).length = 3 + alignLen := by
        rw [List.length_append]; rfl
      have hTagAt : Trusted.MirSemantics.getElem? bbTgt.statements (startIdx + (3 + alignLen)) =
          some (mkSubUncheckedUsize (s3_scrBase ctx + 5)
            (.copy { localId := s3_scrBase ctx, projection := [] }) (usizeConst 1)) := by
        have h := hWinTag 0 _ rfl
        rw [Nat.add_zero, hPreAlLen] at h
        exact h
      have hTagSlotB : Trusted.MirSemantics.getElem? s2b (s3_scrBase ctx) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 tagVal })))) := by
        have h0 := hS2b.2.2 0 (by decide) (by decide) (by decide)
        rw [Nat.add_zero] at h0
        rw [h0]; exact hS2a.2.2.2.2.2.2.1
      have hOffSlotB : Trusted.MirSemantics.getElem? s2b (s3_scrBase ctx + 1) =
          some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 pv.offsetBytes.toNat })))) := by
        rw [hS2b.2.2 1 (by decide) (by decide) (by decide)]
        exact hS2a.2.2.2.2.2.2.2.1
      have hSubTag := s3_exec_mkSubUncheckedUsize_scr ctx (mem := mem) (idx := startIdx + (3 + alignLen))
        5 (.copy { localId := s3_scrBase ctx, projection := [] }) (usizeConst 1) tagVal 1
        (by decide) hS2a.2.2.1 (by decide : 1 < maxUsize)
        (s3_evalPrimOp_scr_copy ctx s2b 0 tagVal (by decide) hTagSlotB)
        (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals s2b 1 (by decide : 1 < maxUsize))
        hS2b.2.1 hBbTgt hTagAt
      have hMatch := s3x_ptrTagMatches_elim hS2a.2.1
      cases optBufP with
      | none =>
        dsimp at hMatch
        rw [hMatch.2] at hSubTag
        rw [hMatch.1]
        dsimp
        have hAddAssoc : startIdx + 3 + alignLen = startIdx + (3 + alignLen) := Nat.add_assoc _ _ _
        rw [← hAddAssoc] at hSubTag
        exact ⟨3 + alignLen, _, s3x_reachesN_trans hS2a.2.2.2.1 hS2b.1, hSubTag.2 Nat.zero_lt_one⟩
      | some bufLoc =>
        dsimp at hMatch
        cases hMatch with
        | inl hNone =>
          rw [hNone.2] at hSubTag
          rw [hNone.1]
          dsimp
          have hAddAssoc : startIdx + 3 + alignLen = startIdx + (3 + alignLen) := Nat.add_assoc _ _ _
          rw [← hAddAssoc] at hSubTag
          exact ⟨3 + alignLen, _, s3x_reachesN_trans hS2a.2.2.2.1 hS2b.1, hSubTag.2 Nat.zero_lt_one⟩
        | inr hSome =>
          rw [hSome.2] at hSubTag
          rw [hSome.1]
          dsimp
          cases hSubTag.1 (Nat.le_refl 1) with | intro s2c hS2c =>
          refine ⟨rfl, s2c, ?_, hS2c.2.1, ?_, ?_⟩
          · have hBaseReach := s3x_reachesN_trans hS2a.2.2.2.1 hS2b.1
            have hAddAssoc : startIdx + 3 + alignLen = startIdx + (3 + alignLen) := Nat.add_assoc _ _ _
            have hNextAssoc : startIdx + (3 + alignLen) + 1 = startIdx + (3 + alignLen + 1) := by
              rw [Nat.add_assoc]
            rw [hAddAssoc] at hBaseReach
            rw [← hNextAssoc]
            exact s3x_reachesN_trans hBaseReach (s3_reachesN_one hS2c.1)
          · rw [hS2c.2.2.2 1 (by decide) (by decide)]; exact hOffSlotB
          · intro j' hj' h0 h1 h5 h6
            rw [hS2c.2.2.2 j' hj' h5, hS2b.2.2 j' hj' h5 h6, hS2a.2.2.2.2.2.2.2.2 j' hj' h0 h1]

/-! ## Section 3: `readLeUsize` Terminator Simulation (`s3x_readLeUsize_sim`) -/

private theorem s3x_leWidth_pos : ∀ w : LeWidth, 0 < w.byteCount
  | .b1 | .b2 | .b4 | .b8 => Nat.succ_pos _

private theorem s3x_leWidth_le8 : ∀ w : LeWidth, w.byteCount ≤ 8
  | .b1 | .b2 | .b4 | .b8 => by decide

private theorem s3x_leWidth_align_le3 : ∀ w : LeWidth, w.naturalAlignLog2 ≤ 3
  | .b1 | .b2 | .b4 | .b8 => by decide

private theorem s3x_eight_mul_lt64 {i : Nat} (hi : i < 8) : 8 * i < 64 := by
  have hMul : 8 * (i + 1) ≤ 8 * 8 := Nat.mul_le_mul_left 8 hi
  rw [Nat.mul_add, Nat.mul_one] at hMul
  exact Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (by decide : 0 < 8)) hMul

private theorem s3x_pow2_8_mul_le_maxUsize {k : Nat} (hk : k ≤ 8) :
    Nat.pow 2 (8 * k) ≤ maxUsize := by
  have hMul : 8 * k ≤ 8 * 8 := Nat.mul_le_mul_left 8 hk
  exact s3_nat_pow_two_mono hMul

private theorem s3x_decodeLeUsize_eq (w : LeWidth) (bs : List AllocByte)
    (hLen : bs.length = w.byteCount) :
    decodeLeUsize w bs = decodeLeBytesAux bs := by
  unfold decodeLeUsize
  rw [hLen, nat_beq_refl]
  rfl

private theorem s3x_uint8_toNat_lt256 (b : UInt8) : b.toNat < 256 := by
  cases b with
  | ofBitVec bv =>
    cases bv with
    | ofFin fn => exact fn.isLt

private theorem s3x_exec_mkAssignUse_dst_move_scr (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock} {idx : Nat}
    {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (dstLocal : LocalId) (jSrc : Nat) (vNat : Nat)
    (hj : jSrc < 10) (_hv : vNat < maxUsize)
    (hDeclDst : Trusted.MirSemantics.getElem? ctx.bodySrc.locals dstLocal = some (.base usizeTy))
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
