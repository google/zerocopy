/-! ## Section 1: Context Helpers, Window Indexing, & Allocation Bridges -/

private theorem s3x_nat_eq_or_ne (a b : Nat) : a = b ∨ a ≠ b :=
  match hEq : Nat.beq a b with
  | true => Or.inl (nat_beq_eq _ _ hEq)
  | false => Or.inr (nat_beq_false_ne hEq)

private theorem s3x_bitVec128_beq_true (a : BitVec 128) : (a == a) = true := by
  cases hDec : BitVec.decEq a a with
  | isTrue _ =>
    change (@decide (a = a) (BitVec.decEq a a)) = true
    unfold decide
    rw [hDec]
  | isFalse hne => exact False.elim (hne rfl)

private theorem s3x_bitVec128_beq_false {a b : BitVec 128} (hne : a ≠ b) :
    (a == b) = false := by
  cases hDec : BitVec.decEq a b with
  | isTrue hEq => exact False.elim (hne hEq)
  | isFalse _ =>
    change (@decide (a = b) (BitVec.decEq a b)) = false
    unfold decide
    rw [hDec]

private theorem s3x_nat_div_lt_iff_lt_mul {k x y : Nat} (hk : 0 < k) :
    Nat.div x k < y ↔ x < y * k :=
  Nat.div_lt_iff_lt_mul hk

private theorem s3x_nat_mul_le_of_le_div {x y k : Nat} (_hk : 0 < k)
    (h : x ≤ Nat.div y k) : k * x ≤ y := by
  have h1 : k * x ≤ k * Nat.div y k := Nat.mul_le_mul_left k h
  have h2 : k * Nat.div y k ≤ k * Nat.div y k + Nat.mod y k :=
    Nat.le_add_right _ _
  have hMod : k * Nat.div y k + Nat.mod y k = y := Nat.div_add_mod y k
  rw [hMod] at h2
  exact Nat.le_trans h1 h2

private theorem s3x_nat_mod_eq_of_lt {a b : Nat} (h : a < b) : Nat.mod a b = a :=
  Nat.mod_eq_of_lt h

private theorem s3x_nat_shiftLeft_eq (a b : Nat) : Nat.shiftLeft a b = a * Nat.pow 2 b :=
  Nat.shiftLeft_eq a b

private theorem s3x_nat_shiftRight_eq (m n : Nat) :
    Nat.shiftRight m n = Nat.div m (Nat.pow 2 n) :=
  s0_nat_shiftRight_eq_div_pow m n

private theorem s3x_nat_pow_add (a m n : Nat) : Nat.pow a (m + n) = Nat.pow a m * Nat.pow a n :=
  s0_nat_pow_add a m n

private theorem s3x_nat_sub_lt_of_lt_add {a b c : Nat} (hCa : c ≤ a) (h : a < b + c) :
    a - c < b := by
  cases Nat.lt_or_ge (a - c) b with
  | inl hLt => exact hLt
  | inr hGe =>
    have h1 : b + c ≤ (a - c) + c := Nat.add_le_add_right hGe c
    rw [Nat.sub_add_cancel hCa] at h1
    exact False.elim (Nat.not_lt_of_le h1 h)

private theorem s3x_checkTermForPtrs_of_bb (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbSrc : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bbSrc) :
    checkTermForPtrs ctx.bodySrc.locals ctx.plan.entries bbSrc.terminator = true := by
  have hAll := s3_list_all_getElem? _ ctx.bodySrc.basicBlocks bbIdx bbSrc
    ctx.hBlocksCheck hBb
  exact ((bool_and_eq_true _ _).mp hAll).2

private theorem s3x_termTargetsInBounds_of_bb (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbSrc : MemCopyBlock}
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bbSrc) :
    memCopyTermTargetsInBounds ctx.bodySrc.basicBlocks.length bbSrc.terminator = true :=
  s3_list_all_getElem? _ ctx.bodySrc.basicBlocks bbIdx bbSrc ctx.hTargetsIb hBb

private theorem s3x_bb_of_lt (ctx : s3_PtrCtx) (bbIdx : BasicBlockId)
    (hLt : bbIdx < ctx.bodySrc.basicBlocks.length) :
    ∃ bb, Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bb :=
  s3_getElem?_lt_some ctx.bodySrc.basicBlocks bbIdx hLt

private theorem s3x_findPtrEntry_bounds_and_spec (ctx : s3_PtrCtx) (p : LocalId)
    (k : Nat) (optBuf : Option LocalId)
    (hFind : findPtrEntry ctx.plan.entries p = some (k, optBuf)) :
    (k < ctx.plan.entries.length) ∧
    (∀ bLoc : LocalId, optBuf = some bLoc →
      ∃ sz al mutab,
        Trusted.MirSemantics.getElem? ctx.bodySrc.locals bLoc = some (.byteBuf sz al mutab) ∧
        sz ≤ 32 ∧ al ≤ 30) := by
  have hSpec := (s3_findPtrEntry_some_iff ctx p k optBuf).mp hFind
  cases hSpec with
  | intro e he =>
    have hLoop := s3_checkPtrBackingEntriesLoop_spec ctx.bodySrc.locals
      ctx.bodySrc.argumentCount 0 ctx.bodySrc.locals ctx.plan.entries ctx.hEntries
    have hEB := hLoop.1 k e he.1
    have hKLen := s3_getElem?_some_lt _ _ _ he.1
    refine ⟨hKLen, ?_⟩
    intro bLoc hEq
    have hSpecBuf := hEB.2.2
    rw [he.2.2, hEq] at hSpecBuf
    exact hSpecBuf.2

private theorem s3x_bodyTgt_locals_byteBuf (ctx : s3_PtrCtx) (bufLoc : LocalId)
    (sz al : Nat) (mutab : Mutability)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc = some (.byteBuf sz al mutab)) :
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals bufLoc = some (.byteBuf sz al mutab) := by
  have hLt : bufLoc < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
  rw [s3_bodyTgt_locals_base ctx bufLoc hLt, hDecl]

private theorem s3x_bodyTgt_locals_base (ctx : s3_PtrCtx) (id : LocalId) (ty : MirTy)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty)) :
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals id = some (.base ty) := by
  have hLt : id < ctx.bodySrc.locals.length := s3_getElem?_some_lt _ _ _ hDecl
  rw [s3_bodyTgt_locals_base ctx id hLt, hDecl]

private theorem s3x_readPtrLocal_false_slots {decls : List MemCopyLocalDecl}
    {slots slots' : List MemCopySlot} {p : LocalId} {pv : PtrVal}
    (h : readPtrLocal decls slots p false = .ok (pv, slots')) :
    slots' = slots := by
  unfold readPtrLocal at h
  cases hD : Trusted.MirSemantics.getElem? decls p with
  | none => rw [hD] at h; cases h
  | some d =>
    rw [hD] at h
    cases d with
    | base _ | byteBuf _ _ _ => cases h
    | ptrLocal =>
      cases hS : Trusted.MirSemantics.getElem? slots p with
      | none => rw [hS] at h; cases h
      | some sl =>
        rw [hS] at h
        cases sl with
        | baseSlot _ | bufSlot _ | ptrDead => cases h
        | livePtr optPv =>
          cases optPv with
          | none => cases h
          | some _ => cases h; rfl

private theorem s3x_ptrTagMatches_elim {optBuf : Option LocalId} {pv : PtrVal}
    {tagVal : Nat} (h : s3_PtrTagMatches optBuf pv tagVal) :
    match optBuf with
    | none => pv.allocId = none ∧ tagVal = 0
    | some bufLoc =>
      (pv.allocId = none ∧ tagVal = 0) ∨
      (pv.allocId = some (internalAllocBase + bufLoc) ∧ tagVal = 1) := by
  cases optBuf <;> exact h

private theorem s3x_window_append_left {α : Type} {xs a b : List α} {base : Nat}
    (hWin : ∀ k x, Trusted.MirSemantics.getElem? (a ++ b) k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x) :
    ∀ k x, Trusted.MirSemantics.getElem? a k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x := by
  intro k x hk
  have hLt : k < a.length := s3_getElem?_some_lt a k x hk
  apply hWin
  rw [s3_getElem?_append_left a b k hLt]
  exact hk

private theorem s3x_window_append_right {α : Type} {xs a b : List α} {base : Nat}
    (hWin : ∀ k x, Trusted.MirSemantics.getElem? (a ++ b) k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x) :
    ∀ k x, Trusted.MirSemantics.getElem? b k = some x →
      Trusted.MirSemantics.getElem? xs ((base + a.length) + k) = some x := by
  intro k x hk
  rw [Nat.add_assoc]
  apply hWin (a.length + k) x
  rw [s3_getElem?_append_right a b (a.length + k) (Nat.le_add_right _ _),
    Nat.add_sub_cancel_left]
  exact hk

private theorem s3x_window_of_termWin {α : Type} {xs L : List α} {base n : Nat}
    (hWin : ∀ k, k < n →
      Trusted.MirSemantics.getElem? xs (base + k) = Trusted.MirSemantics.getElem? L k)
    (hLen : L.length = n) :
    ∀ k x, Trusted.MirSemantics.getElem? L k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x := by
  intro k x hk
  have hLt : k < n := by rw [← hLen]; exact s3_getElem?_some_lt L k x hk
  rw [hWin k hLt]
  exact hk

private theorem s3x_mirTy_beq_usize_eq (ty : MirTy) (h : MirTy.beq ty usizeTy = true) :
    ty = usizeTy := by
  cases ty with
  | int w s =>
    cases w <;> cases s <;> cases h
    rfl
  | _ => cases h

private theorem s3x_pv_allocId_none_of_findNone (ctx : s3_PtrCtx) {slots₁ slots₂ : List MemCopySlot}
    (p : LocalId) (kP : Nat) {pv : PtrVal} {slots₁' : List MemCopySlot}
    (hFind : findPtrEntry ctx.plan.entries p = some (kP, none))
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hRp : readPtrLocal ctx.bodySrc.locals slots₁ p false = .ok (pv, slots₁')) :
    pv.allocId = none := by
  cases (s3_findPtrEntry_some_iff ctx p kP none).mp hFind with | intro e hE =>
  have hOrig := hRel.2.2.2.2.1 kP e hE.1
  unfold s3_PtrSlotEntryRel at hOrig
  rw [hE.2.1] at hOrig
  unfold readPtrLocal at hRp
  cases hPslot : Trusted.MirSemantics.getElem? slots₁ p with
  | none => rw [hPslot] at hOrig; exact False.elim hOrig
  | some sl =>
    rw [hPslot] at hOrig hRp
    cases sl with
    | baseSlot _ => exact False.elim hOrig
    | bufSlot _ => exact False.elim hOrig
    | ptrDead =>
      cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p with
      | none => rw [hD] at hRp; cases hRp
      | some dP => rw [hD] at hRp; cases dP <;> cases hRp
    | livePtr optPv =>
      cases optPv with
      | none =>
        cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p with
        | none => rw [hD] at hRp; cases hRp
        | some dP => rw [hD] at hRp; cases dP <;> cases hRp
      | some pv0 =>
        cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals p with
        | none => rw [hD] at hRp; cases hRp
        | some dP =>
          rw [hD] at hRp
          cases dP with
          | base _ | byteBuf _ _ _ => cases hRp
          | ptrLocal =>
            cases hRp
            dsimp at hOrig
            cases hOrig with | intro tv hTv =>
            cases hTv with | intro ov hOv =>
            have hTM := hOv.2.1
            rw [hE.2.2] at hTM
            exact (s3x_ptrTagMatches_elim hTM).1

private theorem s3x_window_cons3_split {α : Type} {xs : List α} {base : Nat}
    {s0 s1 s2 : α} {mid₁ mid₂ tail : List α}
    (hWin : ∀ k x, Trusted.MirSemantics.getElem? (s0 :: s1 :: s2 :: ((mid₁ ++ mid₂) ++ tail)) k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x) :
    (∀ k x, Trusted.MirSemantics.getElem? (([s0, s1, s2] ++ mid₁) ++ mid₂) k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x) ∧
    (∀ k x, Trusted.MirSemantics.getElem? tail k = some x →
      Trusted.MirSemantics.getElem? xs ((base + (([s0, s1, s2] ++ mid₁) ++ mid₂).length) + k) = some x) := by
  have hApp : ∀ k x, Trusted.MirSemantics.getElem? ((([s0, s1, s2] ++ mid₁) ++ mid₂) ++ tail) k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x := hWin
  exact ⟨s3x_window_append_left hApp, s3x_window_append_right hApp⟩

private theorem s3x_if_fst_length_same {α β γ : Type} (c : Bool)
    (L : List α) (t₁ t₂ : β) (e₁ e₂ : γ) :
    (if c then (L, t₁, e₁) else (L, t₂, e₂)).1.length = L.length := by
  cases c <;> rfl

private theorem s3x_window_if_fst_same {α β γ : Type} {xs : List α} {base : Nat}
    (c : Bool) (L : List α) (t₁ t₂ : β) (e₁ e₂ : γ)
    (hWin : ∀ k x, Trusted.MirSemantics.getElem? (if c then (L, t₁, e₁) else (L, t₂, e₂)).1 k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x) :
    ∀ k x, Trusted.MirSemantics.getElem? L k = some x →
      Trusted.MirSemantics.getElem? xs (base + k) = some x := by
  intro k x hk
  apply hWin k x
  cases c <;> exact hk

private theorem s3x_updateAlloc?_some_of_findAlloc? :
    ∀ (allocs : List Allocation) (aid : AllocId) (oldA newA : Allocation),
      findAlloc? aid allocs = some oldA →
      ∃ allocs', updateAlloc? aid newA allocs = some allocs'
  | [], _, _, _, h => by cases h
  | a :: rest, aid, oldA, newA, h => by
    unfold findAlloc? at h
    unfold updateAlloc?
    cases hEq : Nat.beq a.allocId aid with
    | true => exact ⟨newA :: rest, rfl⟩
    | false =>
      rw [hEq] at h
      cases s3x_updateAlloc?_some_of_findAlloc? rest aid oldA newA h with
      | intro rest' hRec =>
        rw [hRec]
        exact ⟨a :: rest', rfl⟩

private theorem s3x_updateAlloc?_idem :
    ∀ (allocs allocs₁ allocs₂ : List Allocation) (aid : AllocId) (a₁ a₂ : Allocation),
      a₁.allocId = aid →
      updateAlloc? aid a₁ allocs = some allocs₁ →
      updateAlloc? aid a₂ allocs₁ = some allocs₂ →
      updateAlloc? aid a₂ allocs = some allocs₂
  | [], _, _, _, _, _, _, h₁, _ => by cases h₁
  | a :: rest, allocs₁, allocs₂, aid, a₁, a₂, hAid, h₁, h₂ => by
    unfold updateAlloc? at h₁
    unfold updateAlloc?
    cases hEq : Nat.beq a.allocId aid with
    | true =>
      rw [hEq] at h₁
      cases h₁
      unfold updateAlloc? at h₂
      have hT : Nat.beq a₁.allocId aid = true := by rw [hAid]; exact nat_beq_refl aid
      rw [hT] at h₂
      exact h₂
    | false =>
      rw [hEq] at h₁
      cases hR1 : updateAlloc? aid a₁ rest with
      | none => rw [hR1] at h₁; cases h₁
      | some r1 =>
        rw [hR1] at h₁
        cases h₁
        unfold updateAlloc? at h₂
        rw [hEq] at h₂
        cases hR2 : updateAlloc? aid a₂ r1 with
        | none => rw [hR2] at h₂; cases h₂
        | some r2 =>
          rw [hR2] at h₂
          dsimp at h₂
          cases h₂
          dsimp
          rw [s3x_updateAlloc?_idem rest r1 r2 aid a₁ a₂ hAid hR1 hR2]

private theorem s3x_list_take_succ_getElem? {α : Type} :
    ∀ (xs : List α) (i : Nat) (x : α),
      Trusted.MirSemantics.getElem? xs i = some x →
      xs.take (i + 1) = xs.take i ++ [x]
  | [], _, _, h => by cases h
  | x :: _, 0, _, h => by cases h; rfl
  | y :: xs, i + 1, x, h => by
    have ih := s3x_list_take_succ_getElem? xs i x h
    change y :: xs.take (i + 1) = y :: (xs.take i ++ [x])
    rw [ih]

private theorem s3x_list_take_all {α : Type} :
    ∀ (xs : List α), xs.take xs.length = xs
  | [] => rfl
  | x :: xs => by
    change x :: xs.take xs.length = x :: xs
    rw [s3x_list_take_all xs]

private theorem s3x_list_drop_take_getElem? {α : Type} :
    ∀ (xs : List α) (off rem : Nat) (ab : α),
      Trusted.MirSemantics.getElem? xs off = some ab →
      (xs.drop off).take (rem + 1) = ab :: (xs.drop (off + 1)).take rem
  | [], _, _, _, h => by cases h
  | x :: _, 0, rem, _, h => by cases h; rfl
  | _ :: xs, off + 1, rem, ab, h =>
    s3x_list_drop_take_getElem? xs off rem ab h

private theorem s3x_list_take_length_min_le {α : Type} :
    ∀ (xs : List α) (n : Nat), n ≤ xs.length → (xs.take n).length = n
  | _, 0, _ => rfl
  | [], n + 1, h => False.elim (Nat.not_lt_zero n h)
  | _ :: xs, n + 1, h => by
    change (xs.take n).length + 1 = n + 1
    rw [s3x_list_take_length_min_le xs n (Nat.le_of_succ_le_succ h)]

private theorem s3x_list_take_length_le {α : Type} :
    ∀ (xs : List α) (n : Nat), (xs.take n).length ≤ n
  | [], 0 => Nat.le_refl 0
  | [], n + 1 => Nat.zero_le (n + 1)
  | _ :: _, 0 => Nat.le_refl 0
  | _ :: xs, n + 1 => Nat.succ_le_succ (s3x_list_take_length_le xs n)

private theorem s3x_list_drop_getElem? {α : Type} :
    ∀ (xs : List α) (d k : Nat),
      Trusted.MirSemantics.getElem? (xs.drop d) k = Trusted.MirSemantics.getElem? xs (d + k)
  | [], 0, _ => rfl
  | [], _ + 1, _ => rfl
  | _ :: _, 0, k => by rw [Nat.zero_add]; rfl
  | _ :: xs, d + 1, k => by
    change Trusted.MirSemantics.getElem? (xs.drop d) k =
      Trusted.MirSemantics.getElem? (_ :: xs) ((d + 1) + k)
    rw [Nat.add_right_comm d 1 k]
    change Trusted.MirSemantics.getElem? (xs.drop d) k = Trusted.MirSemantics.getElem? xs (d + k)
    exact s3x_list_drop_getElem? xs d k

private theorem s3x_take_split {α : Type} :
    ∀ (xs : List α) (a b : Nat), xs.take (a + b) = xs.take a ++ (xs.drop a).take b
  | xs, 0, b => by
    rw [Nat.zero_add]
    rfl
  | [], a + 1, b => by
    cases b <;> rfl
  | x :: xs, a + 1, b => by
    rw [Nat.add_assoc, Nat.add_comm 1 b, ← Nat.add_assoc]
    change x :: xs.take (a + b) = x :: (xs.take a ++ (xs.drop a).take b)
    rw [s3x_take_split xs a b]

private theorem s3x_drop_take_succ {α : Type} (xs : List α) (off i : Nat) (x : α)
    (h : Trusted.MirSemantics.getElem? xs (off + i) = some x) :
    (xs.drop off).take (i + 1) = (xs.drop off).take i ++ [x] :=
  s3x_list_take_succ_getElem? (xs.drop off) i x (by rw [s3_drop_getElem?]; exact h)

private theorem s3x_list_drop_take_length_le {α : Type} :
    ∀ (xs : List α) (off n : Nat),
      off + n ≤ xs.length →
      ((xs.drop off).take n).length = n
  | [], 0, 0, _ => rfl
  | [], 0, n + 1, h => by
    rw [Nat.zero_add] at h
    exact False.elim (Nat.not_lt_zero n h)
  | [], off + 1, n, h => by
    rw [Nat.add_assoc, Nat.add_comm 1 n, ← Nat.add_assoc] at h
    exact False.elim (Nat.not_lt_zero _ h)
  | _ :: _, 0, 0, _ => rfl
  | _ :: xs, 0, n + 1, h => by
    rw [Nat.zero_add] at h
    change ((xs.take n).length) + 1 = n + 1
    rw [s3x_list_take_length_min_le xs n (Nat.le_of_succ_le_succ h)]
  | _ :: xs, off + 1, n, h => by
    have hLe : off + n ≤ xs.length := by
      have h1 : (off + n) + 1 ≤ xs.length + 1 := by
        rw [Nat.add_assoc, Nat.add_comm n 1, ← Nat.add_assoc]
        exact h
      exact Nat.le_of_succ_le_succ h1
    exact s3x_list_drop_take_length_le xs off n hLe

private theorem s3x_memCopyTerm_readLe_eval_eq (body : MemCopyBody) (bb : MemCopyBlock)
    (f : MemCopyFrame) (mem : CallerMemory) (dstLocal p : LocalId) (w : LeWidth)
    (reqAlign : Bool) (nextBb : BasicBlockId)
    (hTerm : bb.terminator = .readLeUsize dstLocal p w reqAlign nextBb) :
    evalMemCopyTerm body bb f mem =
      evalMemCopyTerm body { bb with terminator := .readLeUsize dstLocal p w reqAlign nextBb } f mem := by
  cases bb
  dsimp at hTerm
  subst hTerm
  rfl

private theorem s3x_memCopyTerm_writeLe_eval_eq (body : MemCopyBody) (bb : MemCopyBlock)
    (f : MemCopyFrame) (mem : CallerMemory) (p : LocalId) (valOp : Operand)
    (w : LeWidth) (reqAlign : Bool) (nextBb : BasicBlockId)
    (hTerm : bb.terminator = .writeLeUsize p valOp w reqAlign nextBb) :
    evalMemCopyTerm body bb f mem =
      evalMemCopyTerm body { bb with terminator := .writeLeUsize p valOp w reqAlign nextBb } f mem := by
  cases bb
  dsimp at hTerm
  subst hTerm
  rfl

private theorem s3x_memCopyTerm_copy_eval_eq (body : MemCopyBody) (bb : MemCopyBlock)
    (f : MemCopyFrame) (mem : CallerMemory) (s d : LocalId) (cntOp : Operand)
    (elemSize reqAlignLog2 : Nat) (checkNonNullZero : Bool) (nextBb : BasicBlockId)
    (hTerm : bb.terminator = .copyNonOverlapping s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb) :
    evalMemCopyTerm body bb f mem =
      evalMemCopyTerm body
        { bb with terminator := .copyNonOverlapping s d cntOp elemSize reqAlignLog2 checkNonNullZero nextBb }
        f mem := by
  cases bb
  dsimp at hTerm
  subst hTerm
  rfl

/-! ## Section 2: Shared Gadget Executors (`bufLivenessCheck`, Raw Byte I/O, & `switchInt`) -/

private theorem s3x_exec_bufLivenessCheck (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock} {idx : Nat}
    {slots₁ slots₂ : List MemCopySlot} {mem : CallerMemory}
    (bufLoc sz al : Nat) (mutab : Mutability)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc = some (.byteBuf sz al mutab))
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRel : s3_SlotsRel ctx slots₁ slots₂)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx = some (.bufLivenessCheck bufLoc)) :
    ∃ (live : Bool) (a : Allocation),
      findAlloc? (internalAllocBase + bufLoc) mem.allocations = some a ∧
      a.live = live ∧
      a.alignLog2 = al ∧
      a.mutability = mutab ∧
      (live = true → a.bytes.length = sz) ∧
      (live = true →
        evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
          .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots₂ }], mem := mem }) ∧
      (live = false →
        evalStepMemCopy ctx.pTgt 0
            { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
          .fault .undefined) := by
  cases hWf.2.1 bufLoc sz al mutab hDecl with
  | intro live hA =>
    cases hA with
    | intro a ha =>
      have hSlot₂ : Trusted.MirSemantics.getElem? slots₂ bufLoc = some (.bufSlot live) := by
        rw [hRel.2.2.2.1 bufLoc sz al mutab hDecl]
        exact ha.1
      have hDeclTgt := s3x_bodyTgt_locals_byteBuf ctx bufLoc sz al mutab hDecl
      refine ⟨live, a, ha.2.1, ha.2.2.1, ha.2.2.2.1, ha.2.2.2.2.1, ha.2.2.2.2.2.1, ?_, ?_⟩
      · intro hLive
        rw [hLive] at hSlot₂
        apply s3_reachesN_stmt_step ctx hBbTgt hStmt
        unfold evalMemCopyStmt
        dsimp
        rw [hDeclTgt, hSlot₂]
      · intro hDead
        rw [hDead] at hSlot₂
        apply s3_reachesN_stmt_fault ctx hBbTgt hStmt
        unfold evalMemCopyStmt
        dsimp
        rw [hDeclTgt, hSlot₂]

private theorem s3x_exec_immediateUb (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock} {idx : Nat}
    {slots₂ : List MemCopySlot} {mem : CallerMemory} (jScr : Nat)
    (hj : jScr < 10)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx =
      some (mkImmediateUbStmt (s3_scrBase ctx + jScr))) :
    evalStepMemCopy ctx.pTgt 0
        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots₂ }], mem := mem } =
      .fault .undefined := by
  have hS := s3_bodyTgt_locals_scratch ctx jScr (Nat.lt_trans hj (by decide))
  have hB : Nat.blt jScr 10 = true := (nat_blt_eq_lt _ _).mpr hj
  rw [hB] at hS
  exact s3_reachesN_stmt_fault ctx hBbTgt hStmt
    (s3_eval_mkImmediateUbStmt ctx.bodyTgt _ mem (s3_scrBase ctx + jScr) hS)

private theorem s3x_scr_usize_decl (ctx : s3_PtrCtx) (j : Nat) (hj : j < 10) :
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals (s3_scrBase ctx + j) = some (.base usizeTy) := by
  have hS := s3_bodyTgt_locals_scratch ctx j (Nat.lt_trans hj (by decide))
  have hB : Nat.blt j 10 = true := (nat_blt_eq_lt _ _).mpr hj
  rw [hB] at hS
  exact hS

private theorem s3x_scr_bool_decl (ctx : s3_PtrCtx) (j : Nat) (hj10 : 10 ≤ j) (hj12 : j < 12) :
    Trusted.MirSemantics.getElem? ctx.bodyTgt.locals (s3_scrBase ctx + j) = some (.base .bool) := by
  have hS := s3_bodyTgt_locals_scratch ctx j hj12
  have hB : Nat.blt j 10 = false := by
    cases h : Nat.blt j 10 with
    | false => rfl
    | true => exact False.elim (Nat.not_lt_of_le hj10 ((nat_blt_eq_lt _ _).mp h))
  rw [hB] at hS
  exact hS

private theorem s3x_evalPrimOp_bool_scr_move (ctx : s3_PtrCtx) (slots : List MemCopySlot)
    (j : Nat) (b : Bool) (hj10 : 10 ≤ j) (hj12 : j < 12)
    (hLen : s3_scrBase ctx + j < slots.length)
    (hSlot : Trusted.MirSemantics.getElem? slots (s3_scrBase ctx + j) =
      some (.baseSlot (.live (some (.bool b))))) :
    ∃ slots',
      setElem? slots (s3_scrBase ctx + j) (.baseSlot (.live none)) = some slots' ∧
      evalMemCopyPrimitiveOperand ctx.bodyTgt.locals slots
        (.move { localId := s3_scrBase ctx + j, projection := [] }) =
        .ok (.bool b, slots') := by
  cases s3_setElem?_some_of_lt slots (s3_scrBase ctx + j) (.baseSlot (.live none)) hLen with
  | intro slots' hSet =>
    refine ⟨slots', hSet, ?_⟩
    unfold evalMemCopyPrimitiveOperand evalMemCopyBaseOperandToSlot
    dsimp
    rw [s3x_scr_bool_decl ctx j hj10 hj12, hSlot]
    dsimp [liveUninitSlot]
    rw [hSet]
    rfl

private theorem s3x_allocByte_encode_snd_lt (ab : AllocByte) :
    (encodeAllocByte ab).snd < 256 := by
  cases ab with
  | uninit => exact Nat.succ_pos _
  | init b opt =>
    unfold encodeAllocByte
    cases b with
    | ofBitVec bv =>
      cases bv with
      | ofFin fn =>
        cases opt <;> exact fn.isLt

private theorem s3x_exec_readBufRawByte_term (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {slots₁ slots₂ slotsA : List MemCopySlot} {mem : CallerMemory}
    (bufLoc sz al : Nat) (mutab : Mutability)
    (offOp : Operand) (off : Nat) (targetBb : BasicBlockId)
    (a : Allocation) (ab : AllocByte)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc = some (.byteBuf sz al mutab))
    (hOff : evalUsizeOp ctx.bodyTgt.locals slots₂ offOp = .ok (off, slotsA))
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRelA : s3_SlotsRel ctx slots₁ slotsA)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hTerm : bbTgt.terminator =
      .readBufRawByte (s3_scrBase ctx + 8) (s3_scrBase ctx + 9) bufLoc offOp targetBb)
    (hAlloc : findAlloc? (internalAllocBase + bufLoc) mem.allocations = some a)
    (hLive : a.live = true)
    (hByte : Trusted.MirSemantics.getElem? a.bytes off = some ab) :
    ∃ slots₂' : List MemCopySlot,
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := targetBb, stmtIdx := 0, locals := slots₂' }], mem := mem } ∧
      s3_SlotsRel ctx slots₁ slots₂' ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 8) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (encodeAllocByte ab).fst })))) ∧
      Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + 9) =
        some (.baseSlot (.live (some (.scalar { width := .isize, signed := false, bits := BitVec.ofNat 128 (encodeAllocByte ab).snd })))) ∧
      (∀ j' : Nat, j' < 12 → j' ≠ 8 → j' ≠ 9 →
        Trusted.MirSemantics.getElem? slots₂' (s3_scrBase ctx + j') =
          Trusted.MirSemantics.getElem? slotsA (s3_scrBase ctx + j')) := by
  cases hWf.2.1 bufLoc sz al mutab hDecl with
  | intro live hBuf =>
    cases hBuf with
    | intro a' ha' =>
      rw [hAlloc] at ha'
      have haEq : a' = a := by cases ha'.2.1; rfl
      rw [haEq] at ha'
      have hLiveBool : live = true := by rw [← ha'.2.2.1]; exact hLive
      rw [hLiveBool] at ha'
      have hTagLt : (encodeAllocByte ab).fst < maxUsize := ha'.2.2.2.2.2.2 off ab hByte
      have hValLt : (encodeAllocByte ab).snd < maxUsize :=
        Nat.lt_trans (s3x_allocByte_encode_snd_lt ab) (by decide : 256 < maxUsize)
      have hSlotBuf : Trusted.MirSemantics.getElem? slotsA bufLoc = some (.bufSlot true) := by
        rw [hRelA.2.2.2.1 bufLoc sz al mutab hDecl]
        exact ha'.1
      have hNe89 : Nat.beq (s3_scrBase ctx + 8) (s3_scrBase ctx + 9) = false := by
        cases hEq : Nat.beq (s3_scrBase ctx + 8) (s3_scrBase ctx + 9) with
        | false => rfl
        | true =>
          have hE := nat_beq_eq _ _ hEq
          have h89 : (8 : Nat) = 9 := Nat.add_left_cancel hE
          cases h89
      have hLt8 : s3_scrBase ctx + 8 < slotsA.length := by
        rw [hRelA.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 8 (by decide)
      let tVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).fst⟩
      let vVal : Val := .scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).snd⟩
      cases s3_setElem?_some_of_lt slotsA (s3_scrBase ctx + 8) (.baseSlot (.live (some tVal))) hLt8 with
      | intro slotsB hSetB =>
        have hRelB : s3_SlotsRel ctx slots₁ slotsB :=
          s3_slotsRel_set_scratch ctx slots₁ slotsA slotsB 8 _ (by decide) hRelA hSetB
        have hLt9 : s3_scrBase ctx + 9 < slotsB.length := by
          rw [hRelB.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 9 (by decide)
        cases s3_setElem?_some_of_lt slotsB (s3_scrBase ctx + 9) (.baseSlot (.live (some vVal))) hLt9 with
        | intro slotsC hSetC =>
          have hRelC : s3_SlotsRel ctx slots₁ slotsC :=
            s3_slotsRel_set_scratch ctx slots₁ slotsB slotsC 9 _ (by decide) hRelB hSetC
          have hW1 : writeMemCopyBasePlace slotsA (s3_scrBase ctx + 8) usizeTy tVal = .ok slotsB := by
            unfold writeMemCopyBasePlace
            rw [s3_usize_scalar_checkVal _ hTagLt]; dsimp
            cases hRelA.2.2.2.2.2 8 (by decide) with | intro ov hOv =>
            rw [hOv]; dsimp; rw [hSetB]
          have hW2 : writeMemCopyBasePlace slotsB (s3_scrBase ctx + 9) usizeTy vVal = .ok slotsC := by
            unfold writeMemCopyBasePlace
            rw [s3_usize_scalar_checkVal _ hValLt]; dsimp
            cases hRelB.2.2.2.2.2 9 (by decide) with | intro ov hOv =>
            rw [hOv]; dsimp; rw [hSetC]
          refine ⟨slotsC, ?_, hRelC, ?_, s3_getElem?_setElem?_eq _ _ _ _ hSetC, ?_⟩
          · rw [s3_step_state_of_term ctx.pTgt _ mem ctx.bodyTgt bbTgt (s3_bodyTgt_get ctx) hBbTgt rfl]
            have hTgtEq : evalMemCopyTerm ctx.bodyTgt bbTgt
                  { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem =
                evalMemCopyTerm ctx.bodyTgt
                  { bbTgt with terminator := .readBufRawByte (s3_scrBase ctx + 8) (s3_scrBase ctx + 9) bufLoc offOp targetBb }
                  { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem := by
              cases bbTgt; dsimp at hTerm; subst hTerm; rfl
            rw [hTgtEq]
            unfold evalMemCopyTerm
            dsimp
            rw [hNe89]; dsimp
            rw [s3x_scr_usize_decl ctx 8 (by decide), s3x_scr_usize_decl ctx 9 (by decide),
              s3x_bodyTgt_locals_byteBuf ctx bufLoc sz al mutab hDecl]; dsimp
            have hTyEq : (!(MirTy.beq usizeTy usizeTy) || !(MirTy.beq usizeTy usizeTy)) = false := rfl
            rw [hTyEq]; dsimp
            rw [hOff]; dsimp
            rw [hSlotBuf, hAlloc]; dsimp
            rw [hLive]; dsimp
            rw [hByte]; dsimp
            have hTagBlt : Nat.blt (encodeAllocByte ab).fst maxUsize = true :=
              (nat_blt_eq_lt _ _).mpr hTagLt
            rw [hTagBlt]; dsimp
            rw [hW1]; dsimp
            rw [hW2]; dsimp
            rfl
          · have hNe89L : s3_scrBase ctx + 9 ≠ s3_scrBase ctx + 8 := by
              intro h; cases Nat.add_left_cancel h
            rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe89L hSetC]
            exact s3_getElem?_setElem?_eq _ _ _ _ hSetB
          · intro j' _ hj8 hj9
            have hNe9 : s3_scrBase ctx + 9 ≠ s3_scrBase ctx + j' := fun h => hj9 (Nat.add_left_cancel h).symm
            have hNe8 : s3_scrBase ctx + 8 ≠ s3_scrBase ctx + j' := fun h => hj8 (Nat.add_left_cancel h).symm
            rw [s3_getElem?_setElem?_ne _ _ _ _ _ hNe9 hSetC,
              s3_getElem?_setElem?_ne _ _ _ _ _ hNe8 hSetB]

private theorem s3x_findAlloc?_allocId :
    ∀ (allocs : List Allocation) (aid : AllocId) (a : Allocation),
      findAlloc? aid allocs = some a → a.allocId = aid
  | [], _, _, h => by cases h
  | x :: xs, aid, a, h => by
    unfold findAlloc? at h
    cases hEq : Nat.beq x.allocId aid with
    | true => rw [hEq] at h; cases h; exact nat_beq_eq _ _ hEq
    | false => rw [hEq] at h; exact s3x_findAlloc?_allocId xs aid a h

private theorem s3x_exec_writeBufRawByte_term (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {slots₁ slots₂ slotsA slotsB slotsC : List MemCopySlot} {mem : CallerMemory}
    (bufLoc sz al : Nat) (mutab : Mutability)
    (offOp tagOp valOp : Operand) (off tNat vNat : Nat) (targetBb : BasicBlockId)
    (a : Allocation)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodySrc.locals bufLoc = some (.byteBuf sz al mutab))
    (hOff : evalUsizeOp ctx.bodyTgt.locals slots₂ offOp = .ok (off, slotsA))
    (hTag : evalUsizeOp ctx.bodyTgt.locals slotsA tagOp = .ok (tNat, slotsB))
    (hVal : evalUsizeOp ctx.bodyTgt.locals slotsB valOp = .ok (vNat, slotsC))
    (hTagLt : tNat < maxUsize)
    (hWf : s3_MemWf ctx.bodySrc slots₁ mem)
    (hRelC : s3_SlotsRel ctx slots₁ slotsC)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hTerm : bbTgt.terminator = .writeBufRawByte bufLoc offOp tagOp valOp targetBb)
    (hAlloc : findAlloc? (internalAllocBase + bufLoc) mem.allocations = some a)
    (hLive : a.live = true)
    (hMut : a.mutability = .mut)
    (hOffLt : off < a.bytes.length) :
    let ab := decodeAllocByte tNat vNat
    let updated : Allocation := { a with bytes := spliceBytes a.bytes off [ab] }
    ∃ allocs' : List Allocation,
      updateAlloc? (internalAllocBase + bufLoc) updated mem.allocations = some allocs' ∧
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := targetBb, stmtIdx := 0, locals := slotsC }], mem := ⟨allocs'⟩ } ∧
      s3_MemWf ctx.bodySrc slots₁ ⟨allocs'⟩ := by
  intro ab updated
  cases hWf.2.1 bufLoc sz al mutab hDecl with
  | intro live hBuf =>
    cases hBuf with
    | intro a' ha' =>
      rw [hAlloc] at ha'
      have haEq : a' = a := by cases ha'.2.1; rfl
      rw [haEq] at ha'
      have hLiveBool : live = true := by rw [← ha'.2.2.1]; exact hLive
      rw [hLiveBool] at ha'
      have hSlotBuf : Trusted.MirSemantics.getElem? slotsC bufLoc = some (.bufSlot true) := by
        rw [hRelC.2.2.2.1 bufLoc sz al mutab hDecl]
        exact ha'.1
      have haAid : a.allocId = internalAllocBase + bufLoc :=
        s3x_findAlloc?_allocId mem.allocations (internalAllocBase + bufLoc) a hAlloc
      have hUpAid : updated.allocId = internalAllocBase + bufLoc := haAid
      cases s3x_updateAlloc?_some_of_findAlloc? mem.allocations (internalAllocBase + bufLoc) a updated hAlloc with
      | intro allocs' hUp =>
        refine ⟨allocs', hUp, ?_, ?_⟩
        · rw [s3_step_state_of_term ctx.pTgt _ mem ctx.bodyTgt bbTgt (s3_bodyTgt_get ctx) hBbTgt rfl]
          have hTgtEq : evalMemCopyTerm ctx.bodyTgt bbTgt
                { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem =
              evalMemCopyTerm ctx.bodyTgt
                { bbTgt with terminator := .writeBufRawByte bufLoc offOp tagOp valOp targetBb }
                { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem := by
            cases bbTgt; dsimp at hTerm; subst hTerm; rfl
          rw [hTgtEq]
          unfold evalMemCopyTerm
          dsimp
          rw [s3x_bodyTgt_locals_byteBuf ctx bufLoc sz al mutab hDecl]; dsimp
          rw [hOff]; dsimp
          rw [hTag]; dsimp
          rw [hVal]; dsimp
          rw [hSlotBuf, hAlloc]; dsimp
          have hLiveF : (!a.live) = false := by rw [hLive]; rfl
          have hMutF : (!(Mutability.beq a.mutability .mut)) = false := by rw [hMut]; rfl
          have hOffF : (!(Nat.blt off a.bytes.length)) = false := by
            rw [(nat_blt_eq_lt _ _).mpr hOffLt]; rfl
          rw [hLiveF, hMutF, hOffF]; dsimp
          change (match updateAlloc? (internalAllocBase + bufLoc) updated mem.allocations with
            | some allocs' => jumpMemCopyBlock _ ⟨allocs'⟩ slotsC targetBb
            | none => .fault .unsupported) = _
          rw [hUp]
          rfl
        · have hBoundSing : s3_AllocBytesTagBounded [ab] := by
            intro idx ab' hIdx
            cases idx with
            | zero =>
              cases hIdx
              exact s3_encodeAllocByte_decodeAllocByte_lt tNat vNat hTagLt
            | succ idx' => cases hIdx
          have hBoundNew : s3_AllocBytesTagBounded updated.bytes :=
            s3_allocBytesTagBounded_spliceBytes a.bytes [ab] off ha'.2.2.2.2.2.2 hBoundSing
          have hLenNew : updated.bytes.length = a.bytes.length :=
            s3_spliceBytes_length a.bytes off [ab] hOffLt
          exact s3_memWf_updateAlloc_sameShape ctx.bodySrc slots₁ mem bufLoc updated allocs' a
            sz al mutab hWf hDecl hAlloc hUpAid hUp ⟨rfl, rfl, rfl, hLenNew, hBoundNew⟩

private theorem s3x_exec_goto_term (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {slots₂ : List MemCopySlot} {mem : CallerMemory} (targetBb : BasicBlockId)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hTerm : bbTgt.terminator = .baseTerm (.goto targetBb)) :
    evalStepMemCopy ctx.pTgt 0
        { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ }], mem := mem } =
      .step { frames := [{ defId := ctx.plan.defId, blockIdx := targetBb, stmtIdx := 0, locals := slots₂ }], mem := mem } := by
  rw [s3_step_state_of_term ctx.pTgt _ mem ctx.bodyTgt bbTgt (s3_bodyTgt_get ctx) hBbTgt rfl]
  have hTgtEq : evalMemCopyTerm ctx.bodyTgt bbTgt
        { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem =
      evalMemCopyTerm ctx.bodyTgt { bbTgt with terminator := .baseTerm (.goto targetBb) }
        { defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := bbTgt.statements.length, locals := slots₂ } mem := by
    cases bbTgt; dsimp at hTerm; subst hTerm; rfl
  rw [hTgtEq]
  rfl

private theorem s3x_exec_unreachable_term (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {slots₂ : List MemCopySlot} {mem : CallerMemory}
