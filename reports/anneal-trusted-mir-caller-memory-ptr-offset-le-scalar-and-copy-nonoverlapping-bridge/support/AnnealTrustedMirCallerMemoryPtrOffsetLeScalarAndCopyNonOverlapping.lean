                  have hFlt := s4_updateAlloc?_filter_eq (internalAllocBase + plan.bufLocal)
                    updated hB2.2.2.1 m₁.allocations allocs₁' hUp1
                  have hAlEq : m₂.allocations = allocs₁'.filter
                      (fun a => !Nat.beq a.allocId (internalAllocBase + plan.bufLocal)) := by
                    rw [hMem.1, hFlt]
                  refine ⟨hAlEq, fun a ha => ?_⟩
                  cases s4_updateAlloc?_mem (internalAllocBase + plan.bufLocal) updated
                      m₁.allocations allocs₁' a hUp1 ha with
                  | inl hEqU =>
                    have hAllocMem := s4_findAlloc?_mem (internalAllocBase + plan.bufLocal)
                      alloc m₁.allocations hB2.2.1
                    cases hMem.2 alloc hAllocMem with | intro id0 hAi1 =>
                    cases hAi1 with | intro sz0 hAi2 =>
                    cases hAi2 with | intro al0 hAi3 =>
                    cases hAi3 with | intro mu0 hAi4 =>
                    rw [hEqU]
                    exact ⟨id0, sz0, al0, mu0, hAi4.1, hAi4.2.1,
                      s4_all_spliceBytes_wf alloc.bytes resOff.1 ab hAi4.2.2 hTagWf⟩
                  | inr hOld => exact hMem.2 a hOld
                have hFindBuf' : findAlloc? (internalAllocBase + plan.bufLocal) allocs₁' = some updated := by
                  have hIdUp : updated.allocId = internalAllocBase + plan.bufLocal := hB2.2.2.1
                  exact s4_findAlloc?_updateAlloc?_self (internalAllocBase + plan.bufLocal)
                    updated hIdUp m₁.allocations allocs₁' hUp1
                have hBytesWfUp : s4_AllocBytesWf updated.bytes :=
                  s4_all_spliceBytes_wf alloc.bytes resOff.1 ab hB2.2.2.2.2.2.2.2.1 hTagWf
                have hLenUp : updated.bytes.length = pack.size := by
                  dsimp [updated]
                  rw [s4_spliceBytes_length alloc.bytes resOff.1 [ab]
                    (by rw [hB2.2.2.2.2.2.2.1]; exact hOffLtSz), hB2.2.2.2.2.2.2.1]
                have hEncTag : (encodeAllocByte ab).1 = resTag.1 := by
                  dsimp [ab]; rw [s4_encodeAllocByte_decodeAllocByte]
                have hEncVal : (encodeAllocByte ab).2 = vNorm := by
                  dsimp [ab, vNorm]
                  rw [s4_encodeAllocByte_decodeAllocByte]
                have hBufFinal : s4_BufRel pack resVal.2 ⟨allocs₁'⟩ slotsA1Out := by
                  refine ⟨true, updated, hB2.1, hFindBuf', hB2.2.2.1, hB2.2.2.2.1, hB2.2.2.2.2.1,
                    hB2.2.2.2.2.2.1, hLenUp, hBytesWfUp, ?_, ?_⟩
                  · have hNeTB_Base : base + 1 + resOff.1 ≠ base := fun h => by
                      have h1 : base < base + 1 + resOff.1 := by
                        rw [Nat.add_assoc]
                        exact Nat.lt_add_of_pos_right (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 0) (Nat.le_add_right 1 _))
                      rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                    have hNeVB_Base : base + 1 + pack.size + resOff.1 ≠ base := fun h => by
                      have h1 : base < base + 1 + pack.size + resOff.1 := by
                        rw [Nat.add_assoc, Nat.add_assoc]
                        exact Nat.lt_add_of_pos_right (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 0) (Nat.le_add_right 1 _))
                      rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                    have hNeTS_Base : tagScr ≠ base := fun h => by
                      have h1 : base < tagScr := by
                        dsimp [tagScr, scrBase]; rw [Nat.add_assoc base 1 (2 * pack.size), Nat.add_assoc]
                        exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)
                      rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                    have hNeVS_Base : valScr ≠ base := fun h => by
                      have h1 : base < valScr := by
                        dsimp [valScr, scrBase]; rw [Nat.add_assoc base 1 (2 * pack.size), Nat.add_assoc]
                        exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)
                      rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                    rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeVB_Base hArm1Set,
                      s4_getElem?_setElem?_ne _ _ _ _ _ hNeVS_Base hArm1b.1,
                      s4_getElem?_setElem?_ne _ _ _ _ _ hNeTB_Base hArm0b.2.1,
                      s4_getElem?_setElem?_ne _ _ _ _ _ hNeTS_Base hArm0b.1]
                    exact hBD.2.2.2.2.2.2.2.2.1
                  · intro j hj
                    cases s4_nat_eq_or_ne j resOff.1 with
                    | inl hEq =>
                      rw [hEq]
                      have hGByte : Trusted.MirSemantics.getElem? updated.bytes resOff.1 = some ab :=
                        s4_getElem?_spliceBytes_eq alloc.bytes resOff.1 ab
                          (by rw [hB2.2.2.2.2.2.2.1]; exact hOffLtSz)
                      have hNeVB_TB : base + 1 + pack.size + resOff.1 ≠ base + 1 + resOff.1 :=
                        hNeTagByteValByte.symm
                      have hNeVS_TB : valScr ≠ base + 1 + resOff.1 := hNeTagByteValScr.symm
                      have hGTB : Trusted.MirSemantics.getElem? slotsA1Out (base + 1 + resOff.1) =
                          some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).1⟩)))) := by
                        rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeVB_TB hArm1Set,
                          s4_getElem?_setElem?_ne _ _ _ _ _ hNeVS_TB hArm1b.1,
                          s4_getElem?_setElem?_self _ _ _ _ hArm0b.2.1, hEncTag]
                      have hGVB : Trusted.MirSemantics.getElem? slotsA1Out (base + 1 + pack.size + resOff.1) =
                          some (.baseSlot (.live (some (.scalar ⟨.isize, false, BitVec.ofNat 128 (encodeAllocByte ab).2⟩)))) := by
                        rw [s4_getElem?_setElem?_self _ _ _ _ hArm1Set, hEncVal]
                      exact ⟨ab, hGByte, hGTB, hGVB⟩
                    | inr hNe =>
                      have hGByte : Trusted.MirSemantics.getElem? updated.bytes j =
                          Trusted.MirSemantics.getElem? alloc.bytes j :=
                        s4_getElem?_spliceBytes_ne alloc.bytes resOff.1 j ab
                          (by rw [hB2.2.2.2.2.2.2.1]; exact hOffLtSz) hNe
                      have hAllocEq : allocD = alloc := by
                        have hF1 := hB2.2.1
                        have hF2 := hBD.2.1
                        rw [hF1] at hF2
                        exact (Option.some.inj hF2).symm
                      cases hBD.2.2.2.2.2.2.2.2.2 j hj with | intro abJ hAbJ =>
                      rw [hAllocEq] at hAbJ
                      have hNeTB_J : base + 1 + resOff.1 ≠ base + 1 + j := fun h =>
                        hNe.symm (Nat.add_left_cancel h)
                      have hNeVB_J : base + 1 + pack.size + resOff.1 ≠ base + 1 + j := fun h => by
                        have h1 : base + 1 + j < base + 1 + pack.size + resOff.1 := by
                          rw [Nat.add_assoc (base + 1) pack.size resOff.1]
                          exact Nat.add_lt_add_left (Nat.lt_of_lt_of_le hj (Nat.le_add_right _ _)) _
                        rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                      have hNeTS_J : tagScr ≠ base + 1 + j := fun h => by
                        have h1 : base + 1 + j < tagScr := by
                          have h2 := Nat.add_lt_add_left
                            (Nat.lt_of_lt_of_le hj (Nat.le_trans (Nat.le_add_right pack.size pack.size) (by rw [← Nat.two_mul]; exact Nat.le_refl _)))
                            (base + 1)
                          exact Nat.lt_of_lt_of_le h2 (Nat.le_add_right _ 2)
                        rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                      have hNeVS_J : valScr ≠ base + 1 + j := fun h => by
                        have h1 : base + 1 + j < valScr := by
                          have h2 := Nat.add_lt_add_left
                            (Nat.lt_of_lt_of_le hj (Nat.le_trans (Nat.le_add_right pack.size pack.size) (by rw [← Nat.two_mul]; exact Nat.le_refl _)))
                            (base + 1)
                          exact Nat.lt_of_lt_of_le h2 (Nat.le_add_right _ 3)
                        rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                      have hNeTB_VJ : base + 1 + resOff.1 ≠ base + 1 + pack.size + j := fun h => by
                        have h1 : base + 1 + resOff.1 < base + 1 + pack.size + j := by
                          rw [Nat.add_assoc (base + 1) pack.size j]
                          exact Nat.add_lt_add_left (Nat.lt_of_lt_of_le hOffLtSz (Nat.le_add_right _ _)) _
                        rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                      have hNeVB_VJ : base + 1 + pack.size + resOff.1 ≠ base + 1 + pack.size + j := fun h =>
                        hNe.symm (Nat.add_left_cancel h)
                      have hNeTS_VJ : tagScr ≠ base + 1 + pack.size + j := fun h => by
                        have h1 : base + 1 + pack.size + j < tagScr := by
                          have h2 : base + 1 + (pack.size + j) < base + 1 + (2 * pack.size) := by
                            rw [Nat.two_mul]
                            exact Nat.add_lt_add_left (Nat.add_lt_add_left hj pack.size) _
                          rw [← Nat.add_assoc (base + 1) pack.size j] at h2
                          exact Nat.lt_of_lt_of_le h2 (Nat.le_add_right _ 2)
                        rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                      have hNeVS_VJ : valScr ≠ base + 1 + pack.size + j := fun h => by
                        have h1 : base + 1 + pack.size + j < valScr := by
                          have h2 : base + 1 + (pack.size + j) < base + 1 + (2 * pack.size) := by
                            rw [Nat.two_mul]
                            exact Nat.add_lt_add_left (Nat.add_lt_add_left hj pack.size) _
                          rw [← Nat.add_assoc (base + 1) pack.size j] at h2
                          exact Nat.lt_of_lt_of_le h2 (Nat.le_add_right _ 3)
                        rw [h] at h1; exact s4_nat_lt_irrefl _ h1
                      refine ⟨abJ, by rw [hGByte]; exact hAbJ.1, ?_, ?_⟩
                      · rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeVB_J hArm1Set,
                          s4_getElem?_setElem?_ne _ _ _ _ _ hNeVS_J hArm1b.1,
                          s4_getElem?_setElem?_ne _ _ _ _ _ hNeTB_J hArm0b.2.1,
                          s4_getElem?_setElem?_ne _ _ _ _ _ hNeTS_J hArm0b.1]
                        exact hAbJ.2.1
                      · rw [s4_getElem?_setElem?_ne _ _ _ _ _ hNeVB_VJ hArm1Set,
                          s4_getElem?_setElem?_ne _ _ _ _ _ hNeVS_VJ hArm1b.1,
                          s4_getElem?_setElem?_ne _ _ _ _ _ hNeTB_VJ hArm0b.2.1,
                          s4_getElem?_setElem?_ne _ _ _ _ _ hNeTS_VJ hArm0b.1]
                        exact hAbJ.2.2
                exact s4_reachesPlus_term_rel pack hSame hSame₂ hRArmFinal
                  hPMFinal hWf₃ hBufFinal hMemFinal hScrFinal
              · intro out hDone
                rw [hEvSrc] at hDone; dsimp [evalMemCopyTerm] at hDone; rw [hTermSrc] at hDone; dsimp at hDone; rw [pack.hBufDecl] at hDone
                dsimp at hDone; rw [hEvOff] at hDone; dsimp at hDone; rw [hEvTag] at hDone
                dsimp at hDone; rw [hEvVal] at hDone; dsimp at hDone; rw [hSrcSlBuf, hB2.2.1] at hDone
                dsimp at hDone; rw [hNotLiveF, hAllocNotMutF, hOffInLen] at hDone
                dsimp at hDone
                cases hUp : updateAlloc? (internalAllocBase + plan.bufLocal) _ m₁.allocations with
                | none => rw [hUp] at hDone; cases hDone
                | some _ => rw [hUp] at hDone; cases hDone
              · intro k hFault
                rw [hEvSrc] at hFault; dsimp [evalMemCopyTerm] at hFault; rw [hTermSrc] at hFault; dsimp at hFault; rw [pack.hBufDecl] at hFault
                dsimp at hFault; rw [hEvOff] at hFault; dsimp at hFault; rw [hEvTag] at hFault
                dsimp at hFault; rw [hEvVal] at hFault; dsimp at hFault; rw [hSrcSlBuf, hB2.2.1] at hFault
                dsimp at hFault; rw [hNotLiveF, hAllocNotMutF, hOffInLen] at hFault
                dsimp at hFault
                have hUpEx := s4_updateAlloc?_of_findAlloc? (internalAllocBase + plan.bufLocal)
                  { alloc with bytes := spliceBytes alloc.bytes resOff.1 [decodeAllocByte resTag.1 resVal.1] }
                  m₁.allocations alloc hB2.2.1
                cases hUpEx with | intro allocs₁' hUp1 =>
                rw [hUp1] at hFault; cases hFault

private theorem s4_term_step_sim
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {m₁ m₂ : CallerMemory}
    (hSame : f₁.defId = plan.defId) (hSame₂ : f₂.defId = plan.defId)
    (hBbRel : f₂.blockIdx = f₁.blockIdx + 1)
    (hBbSrc : Trusted.MirSemantics.getElem? pack.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hEnd₁ : f₁.stmtIdx = bbSrc.statements.length)
    (hLenEq : f₂.stmtIdx =
      (listFlatMap (lowerStmtForBuf plan.bufLocal pack.bodySrc.locals.length pack.size)
        (bbSrc.statements.take f₁.stmtIdx)).length)
    (hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc)
    (hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt)
    (hPM : s4_PrefixMatch pack f₁.locals f₂.locals)
    (hWf : s4_SlotValWf pack.bodySrc f₁.locals)
    (hBuf : s4_BufRel pack f₁.locals m₁ f₂.locals)
    (hMem : s4_MemRel pack m₁ m₂)
    (hScr : s4_ScrLive pack f₂.locals) :
    s4_FwdSim pack f₁ m₁ f₂ m₂ := by
  have hChk := (s4_bodySrc_block_checks pack hBbSrc).2
  cases hTerm : bbSrc.terminator with
  | baseTerm bt =>
    exact s4_sim_term_baseTerm pack hSame hSame₂ hBbRel hBbSrc hTerm hEnd₁ hLenEq
      hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
  | readBufRawByte tagDst valDst b offOp nextBb =>
    cases s4_nat_eq_or_ne b plan.bufLocal with
    | inl hEq =>
      rw [hEq] at hTerm
      exact s4_sim_term_readBuf_buf pack hSame hSame₂ hBbRel hBbSrc hTerm hEnd₁ hLenEq
        hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
    | inr hNe =>
      exact s4_sim_term_readBuf_other pack hNe hSame hSame₂ hBbRel hBbSrc hTerm hEnd₁ hLenEq
        hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
  | writeBufRawByte b offOp tagOp valOp nextBb =>
    cases s4_nat_eq_or_ne b plan.bufLocal with
    | inl hEq =>
      rw [hEq] at hTerm
      exact s4_sim_term_writeBuf_buf pack hSame hSame₂ hBbRel hBbSrc hTerm hEnd₁ hLenEq
        hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
    | inr hNe =>
      exact s4_sim_term_writeBuf_other pack hNe hSame hSame₂ hBbRel hBbSrc hTerm hEnd₁ hLenEq
        hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
  | ptrOffsetInbounds _ _ _ _ _ | checkPtrPairAlign _ _ _ _ _ _
  | readLeUsize _ _ _ _ _ | writeLeUsize _ _ _ _ _
  | readPtrLe8 _ _ _ _ | writePtrLe8 _ _ _ _
  | copyNonOverlapping _ _ _ _ _ _ _ =>
    rw [hTerm] at hChk; cases hChk

/-! ## Section 13: Top-Level Soundness (`applyBufScalarize_sound`) -/

private theorem s4_evalMemCopyStmt_preserves
    (body : MemCopyBody) (f₁ : MemCopyFrame) (m₁ : CallerMemory) (stmt : MemCopyStmt)
    {s₁' : MemCopyState}
    (hStep : evalMemCopyStmt body f₁ m₁ stmt = .step s₁') :
    ∃ f₁' : MemCopyFrame,
      s₁'.frames = [f₁'] ∧ f₁'.defId = f₁.defId ∧ f₁'.blockIdx = f₁.blockIdx := by
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop =>
      cases StepResult.step.inj hStep
      exact ⟨_, rfl, rfl, rfl⟩
    | unsupported => cases hStep
    | storageLive id =>
      dsimp [evalMemCopyStmt] at hStep
      cases hD : Trusted.MirSemantics.getElem? body.locals id with
      | none => rw [hD] at hStep; cases hStep
      | some decl =>
        rw [hD] at hStep; dsimp at hStep
        cases hS : setElem? f₁.locals id (liveUninitMemCopySlot decl) with
        | none => rw [hS] at hStep; cases hStep
        | some slots' =>
          rw [hS] at hStep
          cases decl with
          | ptrLocal | base _ =>
            cases StepResult.step.inj hStep
            exact ⟨_, rfl, rfl, rfl⟩
          | byteBuf _ _ _ =>
            dsimp at hStep
            cases hU : updateAlloc? _ _ m₁.allocations with
            | none => rw [hU] at hStep; cases hStep
            | some _ =>
              rw [hU] at hStep
              cases StepResult.step.inj hStep
              exact ⟨_, rfl, rfl, rfl⟩
    | storageDead id =>
      dsimp [evalMemCopyStmt] at hStep
      cases hZero : Nat.beq id 0 with
      | true => rw [hZero] at hStep; cases hStep
      | false =>
        rw [hZero] at hStep; dsimp at hStep
        cases hS : setElem? f₁.locals id _ with
        | none => rw [hS] at hStep; cases hStep
        | some slots' =>
          rw [hS] at hStep; dsimp at hStep
          cases hD : Trusted.MirSemantics.getElem? body.locals id with
          | none =>
            rw [hD] at hStep
            cases StepResult.step.inj hStep
            exact ⟨_, rfl, rfl, rfl⟩
          | some decl =>
            rw [hD] at hStep
            cases decl with
            | ptrLocal | base _ =>
              cases StepResult.step.inj hStep
              exact ⟨_, rfl, rfl, rfl⟩
            | byteBuf size alignLog2 mutability =>
              dsimp at hStep
              cases hU : updateAlloc? (internalAllocBase + id)
                  { allocId := internalAllocBase + id, alignLog2 := alignLog2,
                    mutability := mutability, bytes := listReplicate size .uninit, live := false }
                  m₁.allocations with
              | none => rw [hU] at hStep; cases hStep
              | some _ =>
                rw [hU] at hStep
                cases StepResult.step.inj hStep
                exact ⟨_, rfl, rfl, rfl⟩
    | assign dst rval =>
      dsimp [evalMemCopyStmt] at hStep
      cases hPr : !dst.projection.isEmpty with
      | true => rw [hPr] at hStep; cases hStep
      | false =>
        rw [hPr] at hStep; dsimp at hStep
        cases hD : Trusted.MirSemantics.getElem? body.locals dst.localId with
        | none => rw [hD] at hStep; cases hStep
        | some decl =>
          rw [hD] at hStep
          cases decl with
          | ptrLocal | byteBuf _ _ _ => cases hStep
          | base dstTy =>
            dsimp at hStep
            cases hRv : evalMemCopyBaseRvalue body.locals f₁.locals dstTy rval with
            | error _ => rw [hRv] at hStep; cases hStep
            | ok res =>
              rw [hRv] at hStep; dsimp at hStep
              cases hWr : writeMemCopyBasePlace res.2 dst.localId dstTy res.1 with
              | error _ => rw [hWr] at hStep; cases hStep
              | ok _ =>
                rw [hWr] at hStep
                cases StepResult.step.inj hStep
                exact ⟨_, rfl, rfl, rfl⟩
  | bufLivenessCheck b =>
    dsimp [evalMemCopyStmt] at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals b with
    | none => rw [hD] at hStep; cases hStep
    | some decl =>
      rw [hD] at hStep
      cases decl with
      | ptrLocal | base _ => cases hStep
      | byteBuf _ _ _ =>
        cases hS : Trusted.MirSemantics.getElem? f₁.locals b with
        | none => rw [hS] at hStep; cases hStep
        | some sl =>
          rw [hS] at hStep
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => cases hStep
          | bufSlot isL =>
            cases isL with
            | false => cases hStep
            | true =>
              cases StepResult.step.inj hStep
              exact ⟨_, rfl, rfl, rfl⟩
  | mkNullPtr dstPtr =>
    dsimp [evalMemCopyStmt] at hStep
    cases hWr : writePtrLocal body.locals f₁.locals dstPtr _ with
    | error _ => rw [hWr] at hStep; cases hStep
    | ok _ =>
      rw [hWr] at hStep
      cases StepResult.step.inj hStep
      exact ⟨_, rfl, rfl, rfl⟩
  | mkDanglingPtr dstPtr alignLog2 =>
    dsimp [evalMemCopyStmt] at hStep
    cases hAl : !Nat.ble alignLog2 30 with
    | true => rw [hAl] at hStep; cases hStep
    | false =>
      rw [hAl] at hStep; dsimp at hStep
      cases hWr : writePtrLocal body.locals f₁.locals dstPtr _ with
      | error _ => rw [hWr] at hStep; cases hStep
      | ok _ =>
        rw [hWr] at hStep
        cases StepResult.step.inj hStep
        exact ⟨_, rfl, rfl, rfl⟩
  | addrOfByteBuf dstPtr b =>
    dsimp [evalMemCopyStmt] at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals b with
    | none => rw [hD] at hStep; cases hStep
    | some decl =>
      rw [hD] at hStep
      cases decl with
      | ptrLocal | base _ => cases hStep
      | byteBuf _ _ _ =>
        cases hS : Trusted.MirSemantics.getElem? f₁.locals b with
        | none => rw [hS] at hStep; cases hStep
        | some sl =>
          rw [hS] at hStep
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => cases hStep
          | bufSlot isL =>
            cases isL with
            | false =>
              cases hDP : Trusted.MirSemantics.getElem? body.locals dstPtr with
              | none => rw [hDP] at hStep; cases hStep
              | some d => rw [hDP] at hStep; cases d <;> cases hStep
            | true =>
              cases hWr : writePtrLocal body.locals f₁.locals dstPtr _ with
              | error _ => rw [hWr] at hStep; cases hStep
              | ok _ =>
                rw [hWr] at hStep
                cases StepResult.step.inj hStep
                exact ⟨_, rfl, rfl, rfl⟩
  | copyPtr dstPtr srcPtr allowDangling =>
    dsimp [evalMemCopyStmt] at hStep
    cases hRd : readPtrLocal body.locals f₁.locals srcPtr allowDangling with
    | error _ => rw [hRd] at hStep; cases hStep
    | ok res =>
      rw [hRd] at hStep; dsimp at hStep
      cases hWr : writePtrLocal body.locals res.2 dstPtr res.1 with
      | error _ => rw [hWr] at hStep; cases hStep
      | ok _ =>
        rw [hWr] at hStep
        cases StepResult.step.inj hStep
        exact ⟨_, rfl, rfl, rfl⟩
  | ptrWrappingOffset dstPtr srcPtr countOp elemSize =>
    dsimp [evalMemCopyStmt] at hStep
    cases hEv : evalOffsetCountOp body.locals f₁.locals countOp with
    | error _ => rw [hEv] at hStep; cases hStep
    | ok res1 =>
      rw [hEv] at hStep; dsimp at hStep
      cases hRd : readPtrLocal body.locals res1.2 srcPtr false with
      | error _ => rw [hRd] at hStep; cases hStep
      | ok res2 =>
        rw [hRd] at hStep; dsimp at hStep
        cases hWr : writePtrLocal body.locals res2.2 dstPtr _ with
        | error _ => rw [hWr] at hStep; cases hStep
        | ok _ =>
          rw [hWr] at hStep
          cases StepResult.step.inj hStep
          exact ⟨_, rfl, rfl, rfl⟩

private theorem s4_evalSwitchBranches_in_bounds (w : IntWidth) (bits : BitVec 128)
    (otherwise : BasicBlockId) (branches : List (BitVec 128 × BasicBlockId))
    (n : Nat) (target : BasicBlockId)
    (hOk : evalSwitchBranches w bits otherwise branches = .ok target)
    (hIn : Nat.blt otherwise n = true ∧
      branches.all (fun p => Nat.blt p.2 n) = true) :
    target < n := by
  induction branches with
  | nil =>
    dsimp [evalSwitchBranches] at hOk
    rw [← Except.ok.inj hOk]
    exact (nat_blt_eq_lt _ _).mp hIn.1
  | cons p tl ih =>
    dsimp [evalSwitchBranches] at hOk
    dsimp [List.all] at hIn
    have hP := (bool_and_eq_true _ _).mp hIn.2
    cases hBad : (truncateBits w p.1 != p.1) with
    | true => rw [hBad] at hOk; cases hOk
    | false =>
      rw [hBad] at hOk
      dsimp at hOk
      cases hEq : (truncateBits w bits == truncateBits w p.1) with
      | true =>
        rw [hEq] at hOk
        cases Except.ok.inj hOk
        exact (nat_blt_eq_lt _ _).mp hP.1
      | false =>
        rw [hEq] at hOk
        exact ih hOk ⟨hIn.1, hP.2⟩

private theorem s4_evalBoolSwitchBranches_in_bounds (b : Bool)
    (otherwise : BasicBlockId) (branches : List (BitVec 128 × BasicBlockId))
    (n : Nat) (target : BasicBlockId)
    (hOk : evalBoolSwitchBranches b otherwise branches = .ok target)
    (hIn : Nat.blt otherwise n = true ∧
      branches.all (fun p => Nat.blt p.2 n) = true) :
    target < n := by
  induction branches with
  | nil =>
    dsimp [evalBoolSwitchBranches] at hOk
    rw [← Except.ok.inj hOk]
    exact (nat_blt_eq_lt _ _).mp hIn.1
  | cons p tl ih =>
    dsimp [evalBoolSwitchBranches] at hOk
    dsimp [List.all] at hIn
    have hP := (bool_and_eq_true _ _).mp hIn.2
    cases hEc : evalConstLit .bool (.scalar p.1) with
    | error _ => rw [hEc] at hOk; cases hOk
    | ok v =>
      rw [hEc] at hOk
      cases v with
      | bool bv =>
        cases bv with
        | false =>
          dsimp at hOk
          cases hB : !b with
          | true =>
            rw [hB] at hOk
            cases Except.ok.inj hOk
            exact (nat_blt_eq_lt _ _).mp hP.1
          | false =>
            rw [hB] at hOk
            dsimp at hOk
            exact ih hOk ⟨hIn.1, hP.2⟩
        | true =>
          dsimp at hOk
          cases hB : b with
          | true =>
            rw [hB] at hOk
            cases Except.ok.inj hOk
            exact (nat_blt_eq_lt _ _).mp hP.1
          | false =>
            rw [hB] at hOk
            dsimp at hOk
            rw [hB] at ih
            exact ih hOk ⟨hIn.1, hP.2⟩
      | scalar _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => cases hOk

private theorem s4_evalMemCopyTerm_preserves
    (body : MemCopyBody) (bb : MemCopyBlock) (f₁ : MemCopyFrame) (m₁ : CallerMemory)
    {s₁' : MemCopyState}
    (hStep : evalMemCopyTerm body bb f₁ m₁ = .step s₁') :
    ∃ f₁' : MemCopyFrame,
      s₁'.frames = [f₁'] ∧
      f₁'.defId = f₁.defId ∧
      (memCopyTermTargetsInBounds body.basicBlocks.length bb.terminator = true →
        f₁'.blockIdx < body.basicBlocks.length) := by
  dsimp [evalMemCopyTerm] at hStep
  cases hT : bb.terminator with
  | baseTerm bt =>
    rw [hT] at hStep
    cases bt with
    | goto target =>
      cases StepResult.step.inj hStep
      exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
    | return_ =>
      dsimp at hStep
      cases hCl : bb.cleanup with
      | true => rw [hCl] at hStep; cases hStep
      | false =>
        rw [hCl] at hStep; dsimp at hStep
        cases hD0 : Trusted.MirSemantics.getElem? body.locals 0 with
        | none =>
          rw [hD0] at hStep
          cases hS0 : Trusted.MirSemantics.getElem? f₁.locals 0 with
          | none => rw [hS0] at hStep; cases hStep
          | some sl0 =>
            rw [hS0] at hStep
            cases sl0 with
            | ptrDead | livePtr _ | bufSlot _ => cases hStep
            | baseSlot bs0 =>
              cases bs0 with
              | dead => cases hStep
              | live ov0 => cases ov0 <;> cases hStep
        | some d0 =>
          rw [hD0] at hStep
          cases d0 with
          | byteBuf _ _ _ => cases hStep
          | base _ =>
            cases hS0 : Trusted.MirSemantics.getElem? f₁.locals 0 with
            | none => rw [hS0] at hStep; cases hStep
            | some sl0 =>
              rw [hS0] at hStep
              cases sl0 with
              | ptrDead | livePtr _ | bufSlot _ => cases hStep
              | baseSlot bs0 =>
                cases bs0 with
                | dead => cases hStep
                | live ov0 => cases ov0 <;> cases hStep
          | ptrLocal =>
            cases hS0 : Trusted.MirSemantics.getElem? f₁.locals 0 with
            | none => rw [hS0] at hStep; cases hStep
            | some sl0 =>
              rw [hS0] at hStep
              cases sl0 with
              | baseSlot _ | bufSlot _ | ptrDead => cases hStep
              | livePtr opv =>
                cases opv with
                | none => cases hStep
                | some pv =>
                  cases hAc : !body.acceptsCallerMem with
                  | true => rw [hAc] at hStep; cases hStep
                  | false =>
                    rw [hAc] at hStep; dsimp at hStep
                    cases hAid : pv.allocId with
                    | none => rw [hAid] at hStep; cases hStep
                    | some aid =>
                      rw [hAid] at hStep; dsimp at hStep
                      cases hBl : !Nat.blt aid internalAllocBase with
                      | true => rw [hBl] at hStep; cases hStep
                      | false => rw [hBl] at hStep; cases hStep
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported => cases hStep
    | switchInt discr targets =>
      dsimp at hStep
      cases hOp : evalMemCopyPrimitiveOperand body.locals f₁.locals discr with
      | error _ => rw [hOp] at hStep; cases hStep
      | ok res =>
        rw [hOp] at hStep; dsimp at hStep
        cases hV : res.1 with
        | bool b =>
          rw [hV] at hStep; dsimp at hStep
          cases hSw : evalBoolSwitchBranches b targets.otherwise targets.branches with
          | error _ => rw [hSw] at hStep; cases hStep
          | ok target =>
            rw [hSw] at hStep
            cases StepResult.step.inj hStep
            refine ⟨_, rfl, rfl, fun hIn => ?_⟩
            dsimp [memCopyTermTargetsInBounds] at hIn
            exact s4_evalBoolSwitchBranches_in_bounds b targets.otherwise targets.branches
              body.basicBlocks.length target hSw ((bool_and_eq_true _ _).mp hIn)
        | scalar sv =>
          rw [hV] at hStep; dsimp at hStep
          cases hSw : evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
          | error _ => rw [hSw] at hStep; cases hStep
          | ok target =>
            rw [hSw] at hStep
            cases StepResult.step.inj hStep
            refine ⟨_, rfl, rfl, fun hIn => ?_⟩
            dsimp [memCopyTermTargetsInBounds] at hIn
            exact s4_evalSwitchBranches_in_bounds sv.width sv.bits targets.otherwise targets.branches
              body.basicBlocks.length target hSw ((bool_and_eq_true _ _).mp hIn)
        | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ =>
          rw [hV] at hStep; cases hStep
  | ptrOffsetInbounds dstPtr srcPtr countOp elemSize nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hEv : evalOffsetCountOp body.locals f₁.locals countOp with
    | error _ => rw [hEv] at hStep; cases hStep
    | ok r1 =>
      rw [hEv] at hStep; dsimp at hStep
      cases hRd : readPtrLocal body.locals r1.2 srcPtr false with
      | error _ => rw [hRd] at hStep; cases hStep
      | ok r2 =>
        rw [hRd] at hStep; dsimp at hStep
        cases hInb : calcInboundsOffset m₁ r2.1 r1.1 elemSize with
        | error _ => rw [hInb] at hStep; cases hStep
        | ok pvOut =>
          rw [hInb] at hStep; dsimp at hStep
          cases hWr : writePtrLocal body.locals r2.2 dstPtr pvOut with
          | error _ => rw [hWr] at hStep; cases hStep
          | ok _ =>
            rw [hWr] at hStep
            cases StepResult.step.inj hStep
            exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
  | checkPtrPairAlign srcPtr dstPtr elemSize reqAlignLog2 checkNonNullZero nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hAl : !Nat.ble reqAlignLog2 30 with
    | true => rw [hAl] at hStep; cases hStep
    | false =>
      rw [hAl] at hStep; dsimp at hStep
      cases hR1 : readPtrLocal body.locals f₁.locals srcPtr false with
      | error _ => rw [hR1] at hStep; cases hStep
      | ok r1 =>
        rw [hR1] at hStep; dsimp at hStep
        cases hR2 : readPtrLocal body.locals r1.2 dstPtr false with
        | error _ => rw [hR2] at hStep; cases hStep
        | ok r2 =>
          rw [hR2] at hStep; dsimp at hStep
          cases hC1 : checkPtrAlignMem m₁ r1.1 reqAlignLog2 with
          | error _ => rw [hC1] at hStep; cases hStep
          | ok _ =>
            rw [hC1] at hStep
            cases hC2 : checkPtrAlignMem m₁ r2.1 reqAlignLog2 with
            | error _ => rw [hC2] at hStep; cases hStep
            | ok _ =>
              rw [hC2] at hStep; dsimp at hStep
              cases hNull : checkNonNullZero && (isNullPtr r1.1 || isNullPtr r2.1) with
              | true => rw [hNull] at hStep; cases hStep
              | false =>
                rw [hNull] at hStep; dsimp at hStep
                cases StepResult.step.inj hStep
                exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
  | readLeUsize dstLocal ptrLocal w requireAligned nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dstLocal with
    | none => rw [hD] at hStep; cases hStep
    | some d =>
      rw [hD] at hStep
      cases d with
      | ptrLocal | byteBuf _ _ _ => cases hStep
      | base dstTy =>
        dsimp at hStep
        cases hTy : !(MirTy.beq dstTy usizeTy) with
        | true => rw [hTy] at hStep; cases hStep
        | false =>
          rw [hTy] at hStep; dsimp at hStep
          cases hRd : readPtrLocal body.locals f₁.locals ptrLocal false with
          | error _ => rw [hRd] at hStep; cases hStep
          | ok r1 =>
            rw [hRd] at hStep; dsimp at hStep
            cases hRm : readMemSlice m₁ r1.1 w.byteCount (if requireAligned then w.naturalAlignLog2 else 0) with
            | error _ => rw [hRm] at hStep; cases hStep
            | ok bs =>
              rw [hRm] at hStep; dsimp at hStep
              cases hDec : decodeLeUsize w bs with
              | error _ => rw [hDec] at hStep; cases hStep
              | ok valNat =>
                rw [hDec] at hStep; dsimp at hStep
                cases hWr : writeMemCopyBasePlace r1.2 dstLocal usizeTy _ with
                | error _ => rw [hWr] at hStep; cases hStep
                | ok _ =>
                  rw [hWr] at hStep
                  cases StepResult.step.inj hStep
                  exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
  | writeLeUsize ptrLocal valOp w requireAligned nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hEv : evalUsizeOp body.locals f₁.locals valOp with
    | error _ => rw [hEv] at hStep; cases hStep
    | ok r1 =>
      rw [hEv] at hStep; dsimp at hStep
      cases hRd : readPtrLocal body.locals r1.2 ptrLocal false with
      | error _ => rw [hRd] at hStep; cases hStep
      | ok r2 =>
        rw [hRd] at hStep; dsimp at hStep
        cases hWm : writeMemSlice m₁ r2.1 (encodeLeUsize w r1.1)
            (if requireAligned then w.naturalAlignLog2 else 0) with
        | error _ => rw [hWm] at hStep; cases hStep
        | ok _ =>
          rw [hWm] at hStep
          cases StepResult.step.inj hStep
          exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
  | readPtrLe8 dstPtr addrPtr requireAligned nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hD : Trusted.MirSemantics.getElem? body.locals dstPtr with
    | none => rw [hD] at hStep; cases hStep
    | some d =>
      rw [hD] at hStep
      cases d with
      | base _ | byteBuf _ _ _ => cases hStep
      | ptrLocal =>
        cases hRd : readPtrLocal body.locals f₁.locals addrPtr false with
        | error _ => rw [hRd] at hStep; cases hStep
        | ok r1 =>
          rw [hRd] at hStep; dsimp at hStep
          cases hRm : readMemSlice m₁ r1.1 8 (if requireAligned then 3 else 0) with
          | error _ => rw [hRm] at hStep; cases hStep
          | ok bs =>
            rw [hRm] at hStep; dsimp at hStep
            cases hDec : decodePtrLe8 bs with
            | error _ => rw [hDec] at hStep; cases hStep
            | ok pvOut =>
              rw [hDec] at hStep; dsimp at hStep
              cases hWr : writePtrLocal body.locals r1.2 dstPtr pvOut with
              | error _ => rw [hWr] at hStep; cases hStep
              | ok _ =>
                rw [hWr] at hStep
                cases StepResult.step.inj hStep
                exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
  | writePtrLe8 addrPtr valPtr requireAligned nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hR1 : readPtrLocal body.locals f₁.locals addrPtr false with
    | error _ => rw [hR1] at hStep; cases hStep
    | ok r1 =>
      rw [hR1] at hStep; dsimp at hStep
      cases hR2 : readPtrLocal body.locals r1.2 valPtr false with
      | error _ => rw [hR2] at hStep; cases hStep
      | ok r2 =>
        rw [hR2] at hStep; dsimp at hStep
        cases hWm : writeMemSlice m₁ r1.1 _ (if requireAligned then 3 else 0) with
        | error _ => rw [hWm] at hStep; cases hStep
        | ok _ =>
          rw [hWm] at hStep
          cases StepResult.step.inj hStep
          exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
  | copyNonOverlapping srcPtr dstPtr countOp elemSize reqAlign checkNonNullZero nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hAl : !Nat.ble reqAlign 30 with
    | true => rw [hAl] at hStep; cases hStep
    | false =>
      rw [hAl] at hStep; dsimp at hStep
      cases hEv : evalUsizeOp body.locals f₁.locals countOp with
      | error _ => rw [hEv] at hStep; cases hStep
      | ok r1 =>
        rw [hEv] at hStep; dsimp at hStep
        cases hR2 : readPtrLocal body.locals r1.2 srcPtr false with
        | error _ => rw [hR2] at hStep; cases hStep
        | ok r2 =>
          rw [hR2] at hStep; dsimp at hStep
          cases hR3 : readPtrLocal body.locals r2.2 dstPtr false with
          | error _ => rw [hR3] at hStep; cases hStep
          | ok r3 =>
            rw [hR3] at hStep; dsimp at hStep
            cases hCno : evalCopyNonOverlapping m₁ r2.1 r3.1 r1.1 elemSize reqAlign checkNonNullZero with
            | error _ => rw [hCno] at hStep; cases hStep
            | ok _ =>
              rw [hCno] at hStep
              cases StepResult.step.inj hStep
              exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
  | readBufRawByte tagDst valDst b offOp nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hTv : Nat.beq tagDst valDst with
    | true => rw [hTv] at hStep; cases hStep
    | false =>
      rw [hTv] at hStep; dsimp at hStep
      cases hDT : Trusted.MirSemantics.getElem? body.locals tagDst with
      | none => rw [hDT] at hStep; cases hStep
      | some dT =>
        rw [hDT] at hStep
        cases dT with
        | ptrLocal | byteBuf _ _ _ => dsimp at hStep; cases hStep
        | base tTy =>
          cases hDV : Trusted.MirSemantics.getElem? body.locals valDst with
          | none => rw [hDV] at hStep; dsimp at hStep; cases hStep
          | some dV =>
            rw [hDV] at hStep
            cases dV with
            | ptrLocal | byteBuf _ _ _ => dsimp at hStep; cases hStep
            | base vTy =>
              cases hDB : Trusted.MirSemantics.getElem? body.locals b with
              | none => rw [hDB] at hStep; cases hStep
              | some dB =>
                rw [hDB] at hStep
                cases dB with
                | ptrLocal | base _ => cases hStep
                | byteBuf _ _ _ =>
                  dsimp at hStep
                  cases hTy : !(MirTy.beq tTy usizeTy) || !(MirTy.beq vTy usizeTy) with
                  | true => rw [hTy] at hStep; cases hStep
                  | false =>
                    rw [hTy] at hStep; dsimp at hStep
                    cases hEv : evalUsizeOp body.locals f₁.locals offOp with
                    | error _ => rw [hEv] at hStep; cases hStep
                    | ok r1 =>
                      rw [hEv] at hStep; dsimp at hStep
                      cases hSl : Trusted.MirSemantics.getElem? r1.2 b with
                      | none => rw [hSl] at hStep; cases hStep
                      | some sl =>
                        rw [hSl] at hStep
                        cases sl with
                        | baseSlot _ | ptrDead | livePtr _ => cases hStep
                        | bufSlot isL =>
                          cases isL with
                          | false => cases hStep
                          | true =>
                            cases hFd : findAlloc? (internalAllocBase + b) m₁.allocations with
                            | none => rw [hFd] at hStep; cases hStep
                            | some alloc =>
                              rw [hFd] at hStep; dsimp at hStep
                              cases hLv : !alloc.live with
                              | true => rw [hLv] at hStep; cases hStep
                              | false =>
                                rw [hLv] at hStep; dsimp at hStep
                                cases hBy : Trusted.MirSemantics.getElem? alloc.bytes r1.1 with
                                | none => rw [hBy] at hStep; cases hStep
                                | some ab =>
                                  rw [hBy] at hStep; dsimp at hStep
                                  cases hWf : !Nat.blt (encodeAllocByte ab).1 maxUsize with
                                  | true => rw [hWf] at hStep; cases hStep
                                  | false =>
                                    rw [hWf] at hStep; dsimp at hStep
                                    cases hW1 : writeMemCopyBasePlace r1.2 tagDst usizeTy _ with
                                    | error _ => rw [hW1] at hStep; cases hStep
                                    | ok sl2 =>
                                      rw [hW1] at hStep; dsimp at hStep
                                      cases hW2 : writeMemCopyBasePlace sl2 valDst usizeTy _ with
                                      | error _ => rw [hW2] at hStep; cases hStep
                                      | ok _ =>
                                        rw [hW2] at hStep
                                        cases StepResult.step.inj hStep
                                        exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩
  | writeBufRawByte b offOp tagOp valOp nextBb =>
    rw [hT] at hStep; dsimp at hStep
    cases hDB : Trusted.MirSemantics.getElem? body.locals b with
    | none => rw [hDB] at hStep; cases hStep
    | some dB =>
      rw [hDB] at hStep
      cases dB with
      | ptrLocal | base _ => cases hStep
      | byteBuf _ _ _ =>
        cases hE1 : evalUsizeOp body.locals f₁.locals offOp with
        | error _ => rw [hE1] at hStep; cases hStep
        | ok r1 =>
          rw [hE1] at hStep; dsimp at hStep
          cases hE2 : evalUsizeOp body.locals r1.2 tagOp with
          | error _ => rw [hE2] at hStep; cases hStep
          | ok r2 =>
            rw [hE2] at hStep; dsimp at hStep
            cases hE3 : evalUsizeOp body.locals r2.2 valOp with
            | error _ => rw [hE3] at hStep; cases hStep
            | ok r3 =>
              rw [hE3] at hStep; dsimp at hStep
              cases hSl : Trusted.MirSemantics.getElem? r3.2 b with
              | none => rw [hSl] at hStep; cases hStep
              | some sl =>
                rw [hSl] at hStep
                cases sl with
                | baseSlot _ | ptrDead | livePtr _ => cases hStep
                | bufSlot isL =>
                  cases isL with
                  | false => cases hStep
                  | true =>
                    cases hFd : findAlloc? (internalAllocBase + b) m₁.allocations with
                    | none => rw [hFd] at hStep; cases hStep
                    | some alloc =>
                      rw [hFd] at hStep; dsimp at hStep
                      cases hBad : !alloc.live || !(Mutability.beq alloc.mutability .mut) ||
                          !Nat.blt r1.1 alloc.bytes.length with
                      | true => rw [hBad] at hStep; cases hStep
                      | false =>
                        rw [hBad] at hStep; dsimp at hStep
                        cases hUp : updateAlloc? (internalAllocBase + b) _ m₁.allocations with
                        | none => rw [hUp] at hStep; cases hStep
                        | some _ =>
                          rw [hUp] at hStep
                          cases StepResult.step.inj hStep
                          exact ⟨_, rfl, rfl, fun hIn => (nat_blt_eq_lt _ _).mp hIn⟩

private theorem s4_evalStepMemCopy_preserves_defId
    (p : MemCopyProgram) (f₁ : MemCopyFrame) (m₁ : CallerMemory) {s₁' : MemCopyState}
    (hStep : evalStepMemCopy p 0 { frames := [f₁], mem := m₁ } = .step s₁') :
    ∃ f₁' : MemCopyFrame, s₁'.frames = [f₁'] ∧ f₁'.defId = f₁.defId := by
  dsimp [evalStepMemCopy] at hStep
  cases hB : Trusted.MirSemantics.getElem? p.bodies f₁.defId with
  | none => rw [hB] at hStep; cases hStep
  | some body =>
    rw [hB] at hStep; dsimp at hStep
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
    | none => rw [hBb] at hStep; cases hStep
    | some bb =>
      rw [hBb] at hStep; dsimp at hStep
      cases hSt : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
      | some stmt =>
        rw [hSt] at hStep
        cases s4_evalMemCopyStmt_preserves body f₁ m₁ stmt hStep with
        | intro f₁' hF => exact ⟨f₁', hF.1, hF.2.1⟩
      | none =>
        rw [hSt] at hStep
        cases hEqLen : Nat.beq f₁.stmtIdx bb.statements.length with
        | false => rw [hEqLen] at hStep; cases hStep
        | true =>
          rw [hEqLen] at hStep
          cases s4_evalMemCopyTerm_preserves body bb f₁ m₁ hStep with
          | intro f₁' hF => exact ⟨f₁', hF.1, hF.2.1⟩

private theorem s4_scalarize_step_sim
    {plan : BufScalarizePlan} {pSrc pTgt : MemCopyProgram}
    (pack : s4_BufScalarizePack plan pSrc pTgt)
    {s₁ s₂ : MemCopyState}
    (hRel : s4_StateRel pack s₁ s₂)
    (hInv : s4_ReachableInv pack s₁) :
    (∀ s₁', evalStepMemCopy pSrc 0 s₁ = .step s₁' →
      ∃ s₂', ReachesPlusMemCopy pTgt s₂ s₂' ∧
        s4_StateRel pack s₁' s₂' ∧ s4_ReachableInv pack s₁') ∧
    (∀ out, evalStepMemCopy pSrc 0 s₁ = .done out →
      ∃ s₂', ReachesMemCopy pTgt s₂ s₂' ∧ StepMemCopy pTgt s₂' (.done out)) ∧
    (∀ k, evalStepMemCopy pSrc 0 s₁ = .fault k →
      ∃ s₂', ReachesMemCopy pTgt s₂ s₂' ∧ StepMemCopy pTgt s₂' (.fault k)) := by
  have hCoreSim : ∀ s₂C, s4_CoreRel pack s₁ s₂C →
      (∀ s₁', evalStepMemCopy pSrc 0 s₁ = .step s₁' →
        ∃ s₂', ReachesPlusMemCopy pTgt s₂C s₂' ∧
          s4_StateRel pack s₁' s₂' ∧ s4_ReachableInv pack s₁') ∧
      (∀ out, evalStepMemCopy pSrc 0 s₁ = .done out →
        ∃ s₂', ReachesMemCopy pTgt s₂C s₂' ∧ StepMemCopy pTgt s₂' (.done out)) ∧
      (∀ k, evalStepMemCopy pSrc 0 s₁ = .fault k →
        ∃ s₂', ReachesMemCopy pTgt s₂C s₂' ∧ StepMemCopy pTgt s₂' (.fault k)) := by
    intro s₂C hCore
    cases s₁ with | mk fs₁ m₁ =>
    cases s₂C with | mk fs₂ m₂ =>
    dsimp [s4_CoreRel] at hCore
    cases fs₁ with
    | nil => cases hCore
    | cons f₁ tl₁ =>
      cases tl₁ with
      | cons _ _ => cases hCore
      | nil =>
        cases fs₂ with
        | nil => cases hCore
        | cons f₂ tl₂ =>
          cases tl₂ with
          | cons _ _ => cases hCore
          | nil =>
            dsimp [s4_ReachableInv] at hInv
            cases hCore with
            | inl hNe =>
              have hDefNe : f₁.defId ≠ plan.defId := hNe.1
              have hSEq : ({ frames := [f₂], mem := m₂ } : MemCopyState) = { frames := [f₁], mem := m₁ } := hNe.2
              rw [hSEq]
              have hEvalEq : evalStepMemCopy pTgt 0 { frames := [f₁], mem := m₁ } =
                  evalStepMemCopy pSrc 0 { frames := [f₁], mem := m₁ } := by
                change (match Trusted.MirSemantics.getElem? pTgt.bodies f₁.defId with
                    | none => StepResult.fault FaultKind.unsupported
                    | some body =>
                      match Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
                      | none => StepResult.fault FaultKind.unsupported
                      | some bb =>
                        match Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
                        | some stmt => evalMemCopyStmt body f₁ m₁ stmt
                        | none =>
                          if Nat.beq f₁.stmtIdx bb.statements.length then
                            evalMemCopyTerm body bb f₁ m₁
                          else
                            StepResult.fault FaultKind.unsupported) =
                  (match Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId with
                    | none => StepResult.fault FaultKind.unsupported
                    | some body =>
                      match Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
                      | none => StepResult.fault FaultKind.unsupported
                      | some bb =>
                        match Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
                        | some stmt => evalMemCopyStmt body f₁ m₁ stmt
                        | none =>
                          if Nat.beq f₁.stmtIdx bb.statements.length then
                            evalMemCopyTerm body bb f₁ m₁
                          else
                            StepResult.fault FaultKind.unsupported)
                rw [s4_getElem?_pTgt_bodies_ne pack hDefNe]
              refine ⟨?_, ?_, ?_⟩
              · intro s₁' hStepEv
                have hStepTgt : evalStepMemCopy pTgt 0 { frames := [f₁], mem := m₁ } = .step s₁' := by
                  rw [hEvalEq]; exact hStepEv
                cases s4_evalStepMemCopy_preserves_defId pSrc f₁ m₁ hStepEv with
                | intro f₁' hF1' =>
                  have hS1' : s₁' = { frames := [f₁'], mem := s₁'.mem } := by
                    cases s₁' with | mk fs1' cm1' =>
                    dsimp at hF1'; rw [hF1'.1]
                  refine ⟨s₁', s4_reachesPlusMemCopy_of_succ (s4_reachesNMemCopy_one_step hStepTgt),
                    Or.inl ?_, ?_⟩
                  · rw [hS1']; dsimp [s4_CoreRel]
                    exact Or.inl ⟨by rw [hF1'.2]; exact hDefNe, rfl⟩
                  · rw [hS1']; dsimp [s4_ReachableInv]
                    intro hBad
                    rw [hF1'.2] at hBad
                    exact False.elim (hDefNe hBad)
              · intro out hDone
                refine ⟨{ frames := [f₁], mem := m₁ }, ReachesMemCopy.refl _, ?_⟩
                rw [stepMemCopy_iff_evalStep, hEvalEq]
                exact hDone
              · intro k hFault
                refine ⟨{ frames := [f₁], mem := m₁ }, ReachesMemCopy.refl _, ?_⟩
                rw [stepMemCopy_iff_evalStep, hEvalEq]
                exact hFault
            | inr hSamePack =>
              have hSame := hSamePack.1
              have hSame₂ := hSamePack.2.1
              have hBbRel := hSamePack.2.2.1
              have hPM := hSamePack.2.2.2.1
              have hWf := hSamePack.2.2.2.2.1
              have hBuf := hSamePack.2.2.2.2.2.1
              have hMem := hSamePack.2.2.2.2.2.2.1
              have hScr := hSamePack.2.2.2.2.2.2.2.1
              have hBlockInfo := hSamePack.2.2.2.2.2.2.2.2
              have hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some pack.bodySrc := by
                rw [hSame]; exact pack.hBodySrc
              have hBodyTgt : Trusted.MirSemantics.getElem? pTgt.bodies f₂.defId = some pack.bodyTgt := by
                rw [hSame₂]; exact s4_getElem?_pTgt_bodies_eq pack
              cases hInv hSame with
              | intro bbSrc hBbSrc =>
                rw [hBbSrc] at hBlockInfo
                have hStmtLe := hBlockInfo.1
                have hLenEq := hBlockInfo.2
                cases Nat.decLt f₁.stmtIdx bbSrc.statements.length with
                | isTrue hLt =>
                  cases s4_getElem?_lt_some bbSrc.statements f₁.stmtIdx hLt with
                  | intro stmt hStmtSrc =>
                    have hSim := s4_stmt_step_sim pack hSame hSame₂ hBbRel hBbSrc hStmtSrc
                      hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
                    refine ⟨?_, ?_, ?_⟩
                    · intro s₁' hStepEv
                      cases hSim.1 s₁' hStepEv with | intro s₂' hs₂' =>
                      refine ⟨s₂', hs₂'.1, hs₂'.2, ?_⟩
                      have hStepStmt : evalMemCopyStmt pack.bodySrc f₁ m₁ stmt = .step s₁' := by
                        rw [s4_evalStepMemCopy_at_stmt pSrc pack.bodySrc f₁ m₁ bbSrc stmt
                          hBodySrc hBbSrc hStmtSrc] at hStepEv
                        exact hStepEv
                      cases s4_evalMemCopyStmt_preserves pack.bodySrc f₁ m₁ stmt hStepStmt with
                      | intro f₁' hF1' =>
                        cases s₁' with | mk fs1' cm1' =>
                        dsimp at hF1'; rw [hF1'.1]
                        dsimp [s4_ReachableInv]
                        intro _
                        rw [hF1'.2.2]
                        exact ⟨bbSrc, hBbSrc⟩
                    · intro out hDone
                      exact hSim.2.1 out hDone
                    · intro k hFault
                      exact hSim.2.2 k hFault
                | isFalse hNotLt =>
                  have hEnd₁ : f₁.stmtIdx = bbSrc.statements.length :=
                    Nat.le_antisymm hStmtLe (Nat.le_of_not_lt hNotLt)
                  have hSim := s4_term_step_sim pack hSame hSame₂ hBbRel hBbSrc hEnd₁
                    hLenEq hBodySrc hBodyTgt hPM hWf hBuf hMem hScr
                  refine ⟨?_, ?_, ?_⟩
                  · intro s₁' hStepEv
                    cases hSim.1 s₁' hStepEv with | intro s₂' hs₂' =>
                    refine ⟨s₂', hs₂'.1, hs₂'.2, ?_⟩
                    have hNone : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = none :=
                      s4_getElem?_ge_none bbSrc.statements f₁.stmtIdx (by rw [hEnd₁]; exact Nat.le_refl _)
                    have hStepTerm : evalMemCopyTerm pack.bodySrc bbSrc f₁ m₁ = .step s₁' := by
                      rw [s4_evalStepMemCopy_at_term pSrc pack.bodySrc f₁ m₁ bbSrc
                        hBodySrc hBbSrc hNone hEnd₁] at hStepEv
                      exact hStepEv
                    cases s4_evalMemCopyTerm_preserves pack.bodySrc bbSrc f₁ m₁ hStepTerm with
                    | intro f₁' hF1' =>
                      cases s₁' with | mk fs1' cm1' =>
                      dsimp at hF1'; rw [hF1'.1]
                      dsimp [s4_ReachableInv]
                      intro _
                      have hLtTgt := hF1'.2.2 (s4_bodySrc_term_targetsInBounds pack hBbSrc)
                      exact s4_getElem?_lt_some pack.bodySrc.basicBlocks f₁'.blockIdx hLtTgt
                  · intro out hDone
                    exact hSim.2.1 out hDone
                  · intro k hFault
                    exact hSim.2.2 k hFault
  cases hRel with
  | inl hCore => exact hCoreSim s₂ hCore
  | inr hStutter =>
    cases hStutter with | intro s₂Post hPost =>
    have hCoreS := hCoreSim s₂Post hPost.2
    refine ⟨?_, ?_, ?_⟩
    · intro s₁' hStep
      cases hCoreS.1 s₁' hStep with | intro s₂' hs₂' =>
      cases hs₂'.1 with | intro nPlus hReachPlus =>
      cases reachesNMemCopy_of_reachesMemCopy hPost.1 with | intro nPre hPre =>
      exact ⟨s₂', ⟨nPre + nPlus, by rw [Nat.add_assoc]; exact reachesNMemCopy_trans hPre hReachPlus⟩, hs₂'.2⟩
    · intro out hDone
      cases hCoreS.2.1 out hDone with | intro s₂' hs₂' =>
      exact ⟨s₂', c_reachesMemCopy_trans hPost.1 hs₂'.1, hs₂'.2⟩
    · intro k hFault
      cases hCoreS.2.2 k hFault with | intro s₂' hs₂' =>
      exact ⟨s₂', c_reachesMemCopy_trans hPost.1 hs₂'.1, hs₂'.2⟩

private theorem applyBufScalarize_sound (plan : BufScalarizePlan)
    (pSrc pTgt : MemCopyProgram)
    (hApp : applyBufScalarize plan pSrc = some pTgt) :
    FullSemanticEquivMemCopy pSrc pTgt := by
  let pack := s4_applyBufScalarize_unpack plan pSrc pTgt hApp
  refine fullSemanticEquivMemCopy_of_fwd_stutter_sim pSrc pTgt
    (fun s₁ s₂ => s4_StateRel pack s₁ s₂ ∧ s4_ReachableInv pack s₁)
    (fun _ => 0)
    (fun q => ⟨fun k => s4_initStateMemCopy_err_iff pack q k, fun s₁ hInit => ?_⟩)
    (fun s₁ s₂ hPair =>
      have hSim := s4_scalarize_step_sim pack hPair.1 hPair.2
      ⟨fun s₁' hEv => Or.inr (hSim.1 s₁' hEv), hSim.2.1, hSim.2.2⟩)
  · cases s4_initStateMemCopy_ok_rel pack q s₁ hInit with
    | intro s₂ hs₂ =>
      refine ⟨s₂, hs₂.1, hs₂.2, ?_⟩
      unfold initStateMemCopy at hInit
      cases hMeta : !Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1 with
      | true => rw [hMeta] at hInit; cases hInit
      | false =>
        rw [hMeta] at hInit; dsimp at hInit
        cases hB : Trusted.MirSemantics.getElem? pSrc.bodies pSrc.entryDefId with
        | none => rw [hB] at hInit; cases hInit
        | some body =>
          rw [hB] at hInit; dsimp at hInit
          cases hC1 : !body.acceptsCallerMem && !q.callerMem.allocations.isEmpty with
          | true => rw [hC1] at hInit; cases hInit
          | false =>
            rw [hC1] at hInit
            cases hC2 : body.acceptsCallerMem && !wfExternalCallerMem q.callerMem with
            | true => rw [hC2] at hInit; cases hInit
            | false =>
              rw [hC2] at hInit
              cases hEmpty : body.basicBlocks.isEmpty with
              | true => rw [hEmpty] at hInit; cases hInit
              | false =>
                rw [hEmpty] at hInit
                cases hArg : !Nat.blt body.argumentCount body.locals.length with
                | true => rw [hArg] at hInit; cases hInit
                | false =>
                  rw [hArg] at hInit
                  cases hSt : !memCopyStorageAnnotationsInBounds body with
                  | true => rw [hSt] at hInit; cases hInit
                  | false =>
                    rw [hSt] at hInit
                    cases hSup : !allMemCopyLocalsSupported body.argumentCount body.acceptsCallerMem 0 body.locals with
                    | true => rw [hSup] at hInit; cases hInit
                    | false =>
                      rw [hSup] at hInit; dsimp at hInit
                      cases hChkA : !checkMemCopyArgsMatch body.acceptsCallerMem q.callerMem q.args
                          ((body.locals.drop 1).take body.argumentCount) with
                      | true => rw [hChkA] at hInit; cases hInit
                      | false =>
                        rw [hChkA] at hInit
                        rw [← Except.ok.inj hInit]
                        dsimp [s4_ReachableInv]
                        intro _
                        have hPos : 0 < pack.bodySrc.basicBlocks.length := by
                          cases hL : pack.bodySrc.basicBlocks with
                          | nil =>
                            have hEm := pack.hNonEmpty
                            rw [hL] at hEm
                            cases hEm
                          | cons _ _ => exact Nat.zero_lt_succ _
                        exact s4_getElem?_lt_some pack.bodySrc.basicBlocks 0 hPos

