private theorem s3c_nat_beq_0_of_pos {x : Nat} (hx : 0 < x) : Nat.beq x 0 = false :=
  s3c_nat_beq_false_of_ne (Nat.ne_of_gt hx)

private theorem s3c_getElem?_some_of_lt {α : Type} :
    ∀ {xs : List α} {i : Nat}, i < xs.length → ∃ x, Trusted.MirSemantics.getElem? xs i = some x
  | [], _, h => False.elim (Nat.not_lt_zero _ h)
  | x :: _, 0, _ => ⟨x, rfl⟩
  | _ :: xs, i + 1, h =>
    s3c_getElem?_some_of_lt (xs := xs) (i := i) (Nat.lt_of_succ_lt_succ (n := i) (m := xs.length) h)

private theorem s3c_allocBytesTagBounded_replicate_uninit :
    ∀ sz : Nat, s3_AllocBytesTagBounded (listReplicate sz .uninit)
  | 0, _, _, h => by cases h
  | _ + 1, 0, _, h => by
    cases h
    unfold encodeAllocByte
    exact s3_nat_pow_pos 2 (Nat.succ_pos 1) 64
  | sz + 1, idx + 1, ab, h =>
    s3c_allocBytesTagBounded_replicate_uninit sz idx ab h

private theorem s3c_enumTagRepr_beq_refl : ∀ r : EnumTagRepr, EnumTagRepr.beq r r = true
  | .zeroSized => rfl
  | .scalar w s => by cases w <;> cases s <;> rfl

private theorem s3c_intWidth_beq_refl : ∀ w : IntWidth, IntWidth.beq w w = true
  | .i8 | .i16 | .i32 | .i64 | .i128 | .isize => rfl

private theorem s3c_bool_beq_refl : ∀ a : Bool, (a == a) = true
  | true => rfl
  | false => rfl

private theorem s3c_natListBeq_refl : ∀ xs : List Nat, natListBeq xs xs = true
  | [] => rfl
  | x :: xs => by
    change (Nat.beq x x && natListBeq xs xs) = true
    rw [nat_beq_refl, s3c_natListBeq_refl xs]
    rfl

private theorem s3c_enumTy_beq_refl (ety : EnumTy) : EnumTy.beq ety ety = true := by
  change (Nat.beq ety.id ety.id && IntWidth.beq ety.discrWidth ety.discrWidth &&
      (ety.discrSigned == ety.discrSigned) && EnumTagRepr.beq ety.tagRepr ety.tagRepr &&
      natListBeq ety.discriminants ety.discriminants) = true
  rw [nat_beq_refl, s3c_intWidth_beq_refl, s3c_bool_beq_refl, s3c_enumTagRepr_beq_refl, s3c_natListBeq_refl]
  rfl

private theorem s3c_liveUninitSlot_checkVal (ty : MirTy) (v : Val)
    (h : liveUninitSlot ty = .live (some v)) : checkVal v ty = true := by
  cases ty with
  | unit => cases h; rfl
  | enum ety =>
    unfold liveUninitSlot at h
    dsimp at h
    cases hZst : isZstEnumTy ety with
    | false => rw [hZst] at h; cases h
    | true =>
      rw [hZst] at h; cases h
      unfold isZstEnumTy at hZst
      cases hRepr : ety.tagRepr with
      | scalar _ _ => rw [hRepr] at hZst; cases hZst
      | zeroSized =>
        rw [hRepr] at hZst
        dsimp at hZst
        have hAdm := hZst
        unfold enumAdmitted at hZst
        have h1 := (bool_and_eq_true _ _).mp hZst
        have h2 := (bool_and_eq_true _ _).mp h1.1
        have h3 := (bool_and_eq_true _ _).mp h2.1
        have h4 := (bool_and_eq_true _ _).mp h3.1
        have hNonEmpty := (bool_not_eq_true _).mp h4.1
        have hPosLen : 0 < ety.discriminants.length := by
          cases hDs : ety.discriminants with
          | nil => rw [hDs] at hNonEmpty; cases hNonEmpty
          | cons _ _ => exact Nat.succ_pos _
        unfold checkVal Val.ty?; dsimp
        rw [hAdm, (nat_blt_eq_lt _ _).mpr hPosLen]; dsimp
        exact s3c_enumTy_beq_refl ety
  | bool | int _ _ | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported => cases h

private theorem s3c_ptrTagMatches_compat {bDst bSrc : Option LocalId} {pv : PtrVal} {tagVal : Nat}
    (hCompat : checkPtrCopyCompat bDst bSrc = true)
    (hMatch : s3_PtrTagMatches bSrc pv tagVal) :
    s3_PtrTagMatches bDst pv tagVal := by
  unfold checkPtrCopyCompat at hCompat
  cases bSrc with
  | none =>
    unfold s3_PtrTagMatches at hMatch
    cases bDst with
    | none => exact hMatch
    | some _ => exact Or.inl hMatch
  | some bufS =>
    have hEq := optNatEq_eq _ _ hCompat
    rw [hEq]
    exact hMatch

private theorem s3c_nat_mul_mod_right (a b m : Nat) :
    Nat.mod (a * Nat.mod b m) m = Nat.mod (a * b) m := by
  have hD : Nat.div b m * m + Nat.mod b m = b := by
    rw [Nat.mul_comm (Nat.div b m) m]; exact Nat.div_add_mod b m
  have hEq : m * (a * Nat.div b m) + a * Nat.mod b m = a * b := by
    rw [Nat.mul_left_comm m a (Nat.div b m), Nat.mul_comm m (Nat.div b m), ← Nat.mul_add, hD]
  rw [← hEq]
  have hModAdd : Nat.mod (m * (a * Nat.div b m) + a * Nat.mod b m) m = Nat.mod (a * Nat.mod b m) m :=
    s0_nat_mul_add_mod m (a * Nat.div b m) (a * Nat.mod b m)
  exact hModAdd.symm

private theorem s3c_calcWrappingOffset_offsetBytes_toNat (pv : PtrVal) (z : Int) (elemSize : Nat) :
    (calcWrappingOffset pv z elemSize).offsetBytes.toNat =
      Nat.mod (pv.offsetBytes.toNat +
        (intEmod (z * Int.ofNat elemSize) (Int.ofNat maxUsize)).toNat) maxUsize := by
  unfold calcWrappingOffset; dsimp
  change (UInt64.ofNat (intEmod (Int.ofNat pv.offsetBytes.toNat + z * Int.ofNat elemSize) (Int.ofNat maxUsize)).toNat).toNat =
    Nat.mod (pv.offsetBytes.toNat + (intEmod (z * Int.ofNat elemSize) (Int.ofNat maxUsize)).toNat) maxUsize
  have hmPos : 0 < maxUsize := s3_nat_pow_pos 2 (Nat.succ_pos 1) 64
  have hLt := s3_intEmod_toNat_lt (Int.ofNat pv.offsetBytes.toNat + z * Int.ofNat elemSize) maxUsize hmPos
  rw [s3_u64_toNat_ofNat _ hLt]
  rw [s3_intEmod_add_left pv.offsetBytes.toNat (z * Int.ofNat elemSize) maxUsize hmPos]
  have hMod : Nat.mod pv.offsetBytes.toNat maxUsize = pv.offsetBytes.toNat :=
    Nat.mod_eq_of_lt (s3_u64_toNat_lt pv.offsetBytes)
  rw [hMod]

private theorem s3c_evalMemCopyStmt_ne_done (body : MemCopyBody) (f : MemCopyFrame) (mem : CallerMemory)
    (stmt : MemCopyStmt) (out : TerminalOut) :
    evalMemCopyStmt body f mem stmt = .done out → False := by
  intro h
  cases stmt with
  | baseStmt sk =>
    cases sk with
    | nop => unfold evalMemCopyStmt stepMemCopyNext at h; cases h
    | unsupported => unfold evalMemCopyStmt at h; cases h
    | storageLive id =>
      unfold evalMemCopyStmt at h; dsimp at h
      cases hD : Trusted.MirSemantics.getElem? body.locals id with
      | none => rw [hD] at h; cases h
      | some d =>
        rw [hD] at h; dsimp at h
        cases hS : setElem? f.locals id (liveUninitMemCopySlot d) with
        | none => rw [hS] at h; cases h
        | some s' =>
          rw [hS] at h; dsimp at h
          cases d with
          | base _ | ptrLocal => unfold stepMemCopyNext at h; cases h
          | byteBuf sz al mutab =>
            dsimp at h
            cases hU : updateAlloc? (internalAllocBase + id) _ mem.allocations with
            | none => rw [hU] at h; cases h
            | some _ => rw [hU] at h; cases h
    | storageDead id =>
      unfold evalMemCopyStmt at h; dsimp at h
      cases hZ : Nat.beq id 0 with
      | true => rw [hZ] at h; cases h
      | false =>
        rw [hZ] at h; dsimp at h
        cases hS : setElem? f.locals id _ with
        | none => rw [hS] at h; cases h
        | some s' =>
          rw [hS] at h; dsimp at h
          cases hD : Trusted.MirSemantics.getElem? body.locals id with
          | none => rw [hD] at h; cases h
          | some d =>
            rw [hD] at h
            cases d with
            | base _ | ptrLocal => unfold stepMemCopyNext at h; cases h
            | byteBuf sz al mutab =>
              dsimp at h
              cases hU : updateAlloc? (internalAllocBase + id) _ mem.allocations with
              | none => rw [hU] at h; cases h
              | some _ => rw [hU] at h; cases h
    | assign dst rval =>
      unfold evalMemCopyStmt at h; dsimp at h
      cases hP : !dst.projection.isEmpty with
      | true => rw [hP] at h; cases h
      | false =>
        rw [hP] at h; dsimp at h
        cases hD : Trusted.MirSemantics.getElem? body.locals dst.localId with
        | none => rw [hD] at h; cases h
        | some d =>
          rw [hD] at h
          cases d with
          | byteBuf _ _ _ | ptrLocal => cases h
          | base dstTy =>
            dsimp at h
            cases hRv : evalMemCopyBaseRvalue body.locals f.locals dstTy rval with
            | error _ => rw [hRv] at h; cases h
            | ok res =>
              rw [hRv] at h; dsimp at h
              cases hWr : writeMemCopyBasePlace res.2 dst.localId dstTy res.1 with
              | error _ => rw [hWr] at h; cases h
              | ok _ => rw [hWr] at h; cases h
  | bufLivenessCheck b =>
    unfold evalMemCopyStmt at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals b with
    | none => rw [hD] at h; cases h
    | some d =>
      rw [hD] at h
      cases d with
      | base _ | ptrLocal => cases h
      | byteBuf _ _ _ =>
        cases hSl : Trusted.MirSemantics.getElem? f.locals b with
        | none => rw [hSl] at h; cases h
        | some sl =>
          rw [hSl] at h
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => cases h
          | bufSlot bLive => cases bLive <;> cases h
  | mkNullPtr _ =>
    unfold evalMemCopyStmt at h; dsimp at h
    cases hWr : writePtrLocal body.locals f.locals _ _ with
    | error _ => rw [hWr] at h; cases h
    | ok _ => rw [hWr] at h; unfold stepMemCopyNext at h; cases h
  | mkDanglingPtr _ al =>
    unfold evalMemCopyStmt at h; dsimp at h
    cases hBle : !Nat.ble al 30 with
    | true => rw [hBle] at h; cases h
    | false =>
      rw [hBle] at h; dsimp at h
      cases hWr : writePtrLocal body.locals f.locals _ _ with
      | error _ => rw [hWr] at h; cases h
      | ok _ => rw [hWr] at h; unfold stepMemCopyNext at h; cases h
  | addrOfByteBuf _ b =>
    unfold evalMemCopyStmt at h; dsimp at h
    cases hD : Trusted.MirSemantics.getElem? body.locals b with
    | none => rw [hD] at h; cases h
    | some d =>
      rw [hD] at h
      cases d with
      | base _ | ptrLocal => cases h
      | byteBuf _ _ _ =>
        cases hSl : Trusted.MirSemantics.getElem? f.locals b with
        | none => rw [hSl] at h; cases h
        | some sl =>
          rw [hSl] at h
          cases sl with
          | baseSlot _ | ptrDead | livePtr _ => cases h
          | bufSlot bLive =>
            cases bLive with
            | false =>
              dsimp at h
              cases hD2 : Trusted.MirSemantics.getElem? body.locals _ with
              | none => rw [hD2] at h; cases h
              | some d2 => rw [hD2] at h; cases d2 <;> cases h
            | true =>
              dsimp at h
              cases hWr : writePtrLocal body.locals f.locals _ _ with
              | error _ => rw [hWr] at h; cases h
              | ok _ => rw [hWr] at h; unfold stepMemCopyNext at h; cases h
  | copyPtr _ s isMove =>
    unfold evalMemCopyStmt at h; dsimp at h
    cases hRd : readPtrLocal body.locals f.locals s isMove with
    | error _ => rw [hRd] at h; cases h
    | ok _ =>
      rw [hRd] at h; dsimp at h
      cases hWr : writePtrLocal body.locals _ _ _ with
      | error _ => rw [hWr] at h; cases h
      | ok _ => rw [hWr] at h; unfold stepMemCopyNext at h; cases h
  | ptrWrappingOffset _ s cntOp _ =>
    unfold evalMemCopyStmt at h; dsimp at h
    cases hOc : evalOffsetCountOp body.locals f.locals cntOp with
    | error _ => rw [hOc] at h; cases h
    | ok _ =>
      rw [hOc] at h; dsimp at h
      cases hRd : readPtrLocal body.locals _ s false with
      | error _ => rw [hRd] at h; cases h
      | ok _ =>
        rw [hRd] at h; dsimp at h
        cases hWr : writePtrLocal body.locals _ _ _ with
        | error _ => rw [hWr] at h; cases h
        | ok _ => rw [hWr] at h; unfold stepMemCopyNext at h; cases h

private theorem s3c_fwdStepSim_of_stmt_multi (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} {stmt : MemCopyStmt}
    (hDef₁ : f₁.defId = ctx.plan.defId)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmtSrc : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some stmt)
    (hStepProp : ∀ s₁', evalMemCopyStmt ctx.bodySrc f₁ mem stmt = .step s₁' →
      ∃ s₂', ReachesPlusMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
        s3_SimRel ctx ctx.pSrc ctx.pTgt s₁' s₂')
    (hFaultProp : ∀ k, evalMemCopyStmt ctx.bodySrc f₁ mem stmt = .fault k →
      ∃ s₂', ReachesMemCopy ctx.pTgt { frames := [f₂], mem := mem } s₂' ∧
        StepMemCopy ctx.pTgt s₂' (.fault k)) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hBodySrc : Trusted.MirSemantics.getElem? ctx.pSrc.bodies f₁.defId = some ctx.bodySrc := by
    rw [hDef₁]; exact ctx.hBodies
  have hEvSrc := s3_step_state_of_stmt ctx.pSrc f₁ mem ctx.bodySrc bbSrc stmt hBodySrc hBbSrc hStmtSrc
  refine ⟨?_, ?_, ?_⟩
  · intro s₁' hStep; rw [hEvSrc] at hStep; exact hStepProp s₁' hStep
  · intro out hDone; rw [hEvSrc] at hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
  · intro k hFault; rw [hEvSrc] at hFault; exact hFaultProp k hFault

private theorem s3c_storageAnnot_in_bounds (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {i : Nat} {id : LocalId}
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks fIdx = some bbSrc) :
    (Trusted.MirSemantics.getElem? bbSrc.statements i = some (.baseStmt (.storageLive id)) →
      id < ctx.bodySrc.locals.length) ∧
    (Trusted.MirSemantics.getElem? bbSrc.statements i = some (.baseStmt (.storageDead id)) →
      id < ctx.bodySrc.locals.length) := by
  have hAll := ctx.hAnnot
  unfold memCopyStorageAnnotationsInBounds at hAll
  have hBbPred := s3_list_all_getElem? _ ctx.bodySrc.basicBlocks fIdx bbSrc hAll hBb
  constructor
  · intro hSt
    have hP := s3_list_all_getElem? _ bbSrc.statements i _ hBbPred hSt
    exact (nat_blt_eq_lt _ _).mp hP
  · intro hSt
    have hP := s3_list_all_getElem? _ bbSrc.statements i _ hBbPred hSt
    exact (nat_blt_eq_lt _ _).mp hP

private theorem s3c_blockStmt_check (ctx : s3_PtrCtx)
    {bbIdx : BasicBlockId} {bbSrc : MemCopyBlock} {i : Nat} {stmt : MemCopyStmt}
    (hBb : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks bbIdx = some bbSrc)
    (hSt : Trusted.MirSemantics.getElem? bbSrc.statements i = some stmt) :
    checkStmtForPtrs ctx.bodySrc.locals ctx.plan.entries stmt = true := by
  have hBbPred := s3_list_all_getElem? _ ctx.bodySrc.basicBlocks bbIdx bbSrc ctx.hBlocksCheck hBb
  have hStAll := ((bool_and_eq_true _ _).mp hBbPred).1
  exact s3_list_all_getElem? _ bbSrc.statements i stmt hStAll hSt

private theorem s3c_eval_storageLive_base (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {slots : List MemCopySlot} {mem : CallerMemory}
    (loc : LocalId) (ty : MirTy)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals loc = some (.base ty))
    (hLen : loc < slots.length)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx = some (.baseStmt (.storageLive loc))) :
    ∃ slots',
      setElem? slots loc (.baseSlot (liveUninitSlot ty)) = some slots' ∧
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots' }], mem := mem } := by
  cases s3_setElem?_some_of_lt slots loc (.baseSlot (liveUninitSlot ty)) hLen with | intro slots' hSet =>
  refine ⟨slots', hSet, ?_⟩
  apply s3_reachesN_stmt_step ctx hBbTgt hStmt
  unfold evalMemCopyStmt
  dsimp
  rw [hDecl]; dsimp
  change (match setElem? slots loc (.baseSlot (liveUninitSlot ty)) with
    | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
    | some slots' => stepMemCopyNext _ mem slots') = _
  rw [hSet]

private theorem s3c_eval_storageDead_base (ctx : s3_PtrCtx) {bbIdx : BasicBlockId} {bbTgt : MemCopyBlock}
    {idx : Nat} {slots : List MemCopySlot} {mem : CallerMemory}
    (loc : LocalId) (ty : MirTy) (hPos : 0 < loc)
    (hDecl : Trusted.MirSemantics.getElem? ctx.bodyTgt.locals loc = some (.base ty))
    (hLen : loc < slots.length)
    (hBbTgt : Trusted.MirSemantics.getElem? ctx.bodyTgt.basicBlocks bbIdx = some bbTgt)
    (hStmt : Trusted.MirSemantics.getElem? bbTgt.statements idx = some (.baseStmt (.storageDead loc))) :
    ∃ slots',
      setElem? slots loc (.baseSlot .dead) = some slots' ∧
      evalStepMemCopy ctx.pTgt 0
          { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx, locals := slots }], mem := mem } =
        .step { frames := [{ defId := ctx.plan.defId, blockIdx := bbIdx, stmtIdx := idx + 1, locals := slots' }], mem := mem } := by
  cases s3_setElem?_some_of_lt slots loc (.baseSlot .dead) hLen with | intro slots' hSet =>
  refine ⟨slots', hSet, ?_⟩
  apply s3_reachesN_stmt_step ctx hBbTgt hStmt
  unfold evalMemCopyStmt
  dsimp
  rw [s3c_nat_beq_0_of_pos hPos]; dsimp
  rw [hDecl]; dsimp
  change (match setElem? slots loc (.baseSlot .dead) with
    | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
    | some slots' => stepMemCopyNext _ mem slots') = _
  rw [hSet]

private theorem s3c_stmt_storageLive_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} (id : LocalId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.storageLive id)))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hidLt : id < ctx.bodySrc.locals.length := (s3c_storageAnnot_in_bounds ctx hBbSrc).1 hStmt
  cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
  cases hEx with | intro extraSelf hBlock =>
  have hBbTgt := hBlock.2.2.1
  have hGetSt := hBlock.2.2.2.1
  have hIdxNext := hBlock.2.2.2.2
  rw [← hIdxEq] at hGetSt hIdxNext
  cases hFind : findPtrEntry ctx.plan.entries id with
  | some p =>
    cases p with | mk k optBuf =>
    cases s3c_findPtrEntry_some ctx id k optBuf hFind with | intro e hE =>
    have hEB := s3_ptrEntry_bounds ctx k e hE.1
    have hComp := s3_bodyTgt_locals_comp ctx k hEB.2.2.2
    have hB0 := s3_compOffset_bounds ctx k 0 hEB.2.2.2 (Nat.succ_pos 2)
    have hB1 := s3_compOffset_bounds ctx k 1 hEB.2.2.2 (by decide)
    have hB2 := s3_compOffset_bounds ctx k 2 hEB.2.2.2 (by decide)
    rw [Nat.add_zero] at hB0
    have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
        (.baseStmt (.storageLive id)) =
        [.baseStmt (.storageLive (ctx.bodySrc.locals.length + 3 * k)),
         .baseStmt (.storageLive (ctx.bodySrc.locals.length + 3 * k + 1)),
         .baseStmt (.storageLive (ctx.bodySrc.locals.length + 3 * k + 2))] := by
      unfold lowerStmtForPtrs; dsimp; rw [hFind]; rfl
    rw [hGenEq] at hGetSt hIdxNext
    have hS0 := hGetSt 0 (show 0 < 3 from by decide)
    rw [Nat.add_zero] at hS0
    have hS1 := hGetSt 1 (show 1 < 3 from by decide)
    have hS2 := hGetSt 2 (show 2 < 3 from by decide)
    have hLuU : liveUninitSlot .unit = .live (some .unit) := rfl
    have hLuZ : liveUninitSlot usizeTy = .live none := rfl
    have hLtC0 : ctx.bodySrc.locals.length + 3 * k < f₂.locals.length := by
      rw [hRel.2.1, s3_bodyTgt_locals_length]; exact Nat.lt_of_lt_of_le hB0.2 (Nat.le_add_right _ _)
    cases s3c_eval_storageLive_base ctx (ctx.bodySrc.locals.length + 3 * k) .unit hComp.1 hLtC0 hBbTgt hS0 with
    | intro s2a hS2a =>
      rw [hLuU] at hS2a
      have hLtC1 : ctx.bodySrc.locals.length + 3 * k + 1 < s2a.length := by
        rw [s3_setElem?_length _ _ _ _ hS2a.1, hRel.2.1, s3_bodyTgt_locals_length]
        exact Nat.lt_of_lt_of_le hB1.2 (Nat.le_add_right _ _)
      cases s3c_eval_storageLive_base ctx (ctx.bodySrc.locals.length + 3 * k + 1) usizeTy hComp.2.1 hLtC1 hBbTgt hS1 with
      | intro s2b hS2b =>
        rw [hLuZ] at hS2b
        have hLtC2 : ctx.bodySrc.locals.length + 3 * k + 2 < s2b.length := by
          rw [s3_setElem?_length _ _ _ _ hS2b.1, s3_setElem?_length _ _ _ _ hS2a.1, hRel.2.1, s3_bodyTgt_locals_length]
          exact Nat.lt_of_lt_of_le hB2.2 (Nat.le_add_right _ _)
        cases s3c_eval_storageLive_base ctx (ctx.bodySrc.locals.length + 3 * k + 2) usizeTy hComp.2.2 hLtC2 hBbTgt hS2 with
        | intro s2c hS2c =>
          rw [hLuZ] at hS2c
          have hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals } := by
            cases f₂; dsimp at hDef₂; rw [hDef₂, hBbRel]
          have hReach3 : ReachesNMemCopy ctx.pTgt 3 { frames := [f₂], mem := mem }
              { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 3, locals := s2c }], mem := mem } := by
            rw [hf₂Eq]
            exact s3_reachesN_cons hS2a.2 (s3_reachesN_cons hS2b.2 (s3_reachesN_one hS2c.2))
          have hLt1 : id < f₁.locals.length := by rw [hRel.1]; exact hidLt
          cases s3_setElem?_some_of_lt f₁.locals id (.livePtr none) hLt1 with | intro slots₁' hSet1 =>
          have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals id ≠ some (.byteBuf sz al mutab) :=
            fun _ _ _ h => by rw [hE.2.1] at hEB; rw [h] at hEB; cases hEB.2.2.1
          have hBaseOk : ∀ ty v, Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty) →
              MemCopySlot.livePtr none = .baseSlot (.live (some v)) → checkVal v ty = true :=
            fun _ _ _ h => by cases h
          have hWf' := s3_memWf_set_nonBuf ctx.bodySrc f₁.locals slots₁' mem id (.livePtr none) hWf hNotBuf hBaseOk hSet1
          have hN1_0 : ctx.bodySrc.locals.length + 3 * k + 1 ≠ ctx.bodySrc.locals.length + 3 * k :=
            (Nat.ne_of_lt (Nat.lt_succ_self _)).symm
          have hN2_0 : ctx.bodySrc.locals.length + 3 * k + 2 ≠ ctx.bodySrc.locals.length + 3 * k :=
            (s3c_ne_add_two _).symm
          have hN2_1 : ctx.bodySrc.locals.length + 3 * k + 2 ≠ ctx.bodySrc.locals.length + 3 * k + 1 :=
            (Nat.ne_of_lt (Nat.lt_succ_self _)).symm
          have hEntryRel : s3_PtrSlotEntryRel ctx.bodySrc.locals.length k e slots₁' s2c := by
            unfold s3_PtrSlotEntryRel
            rw [hE.2.1, s3_getElem?_setElem?_eq _ _ _ _ hSet1]; dsimp
            refine ⟨⟨some .unit, ?_⟩, ?_, ?_⟩
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2_0 hS2c.1,
                  s3_getElem?_setElem?_ne _ _ _ _ _ hN1_0 hS2b.1,
                  s3_getElem?_setElem?_eq _ _ _ _ hS2a.1]
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2_1 hS2c.1,
                  s3_getElem?_setElem?_eq _ _ _ _ hS2b.1]
            · rw [s3_getElem?_setElem?_eq _ _ _ _ hS2c.1]
          have hRel' := s3_slotsRel_set_ptr ctx f₁.locals f₂.locals slots₁' s2a s2b s2c k e
            (.livePtr none) (.baseSlot (.live (some .unit))) (.baseSlot (.live none)) (.baseSlot (.live none))
            hE.1 hRel (by rw [hE.2.1]; exact hSet1) hS2a.1 hS2b.1 hS2c.1 hEntryRel
          apply s3c_fwdStepSim_of_stmt_multi ctx hDef₁ hBbSrc hStmt
          · intro s₁' hStep
            unfold evalMemCopyStmt at hStep; dsimp at hStep
            rw [hE.2.1] at hEB
            rw [hEB.2.2.1] at hStep; dsimp at hStep
            change (match setElem? f₁.locals id (.livePtr none) with
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
              | some slots' => stepMemCopyNext f₁ mem slots') = .step s₁' at hStep
            rw [hSet1] at hStep; cases hStep
            have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length := s3_getElem?_some_lt _ _ _ hStmt
            exact s3_reachesPlus_stmt_rel ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hLeNext hIdxNext hReach3 rfl hWf' hRel'
          · intro kFault hFault
            unfold evalMemCopyStmt at hFault; dsimp at hFault
            rw [hE.2.1] at hEB
            rw [hEB.2.2.1] at hFault; dsimp at hFault
            change (match setElem? f₁.locals id (.livePtr none) with
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
              | some slots' => stepMemCopyNext f₁ mem slots') = .fault kFault at hFault
            rw [hSet1] at hFault; cases hFault
  | none =>
    have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
        (.baseStmt (.storageLive id)) = [.baseStmt (.storageLive id)] := by
      unfold lowerStmtForPtrs; dsimp; rw [hFind]
    rw [hGenEq] at hGetSt hIdxNext
    have hStmtTgt := hGetSt 0 (show 0 < 1 from by decide)
    rw [Nat.add_zero] at hStmtTgt
    rw [hBbRel] at hBbTgt
    have hNotPtr := (s3_findPtrEntry_none_iff ctx id).mp hFind
    have hDeclTgt := s3_bodyTgt_locals_base ctx id hidLt
    cases s3c_getElem?_some_of_lt hidLt with | intro decl hDeclSrc =>
    rw [hDeclSrc] at hDeclTgt
    cases decl with
    | ptrLocal => exact False.elim (hNotPtr hDeclSrc)
    | base ty =>
      apply s3_sim_stmt_one ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxNext hBbTgt hStmtTgt
      have hLt1 : id < f₁.locals.length := by rw [hRel.1]; exact hidLt
      have hLt2 : id < f₂.locals.length := by
        rw [hRel.2.1, s3_bodyTgt_locals_length]
        exact Nat.lt_of_lt_of_le hidLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
      cases s3_setElem?_some_of_lt f₁.locals id (.baseSlot (liveUninitSlot ty)) hLt1 with | intro slots₁' hS1 =>
      cases s3_setElem?_some_of_lt f₂.locals id (.baseSlot (liveUninitSlot ty)) hLt2 with | intro slots₂' hS2 =>
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep
        unfold evalMemCopyStmt at hStep; dsimp at hStep
        rw [hDeclSrc] at hStep; dsimp at hStep
        change (match setElem? f₁.locals id (.baseSlot (liveUninitSlot ty)) with
          | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
          | some slots' => stepMemCopyNext f₁ mem slots') = .step s₁' at hStep
        rw [hS1] at hStep; cases hStep
        have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals id ≠ some (.byteBuf sz al mutab) :=
          fun _ _ _ h => by rw [hDeclSrc] at h; cases h
        have hBaseOk : ∀ ty' v', Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty') →
            MemCopySlot.baseSlot (liveUninitSlot ty) = .baseSlot (.live (some v')) → checkVal v' ty' = true := by
          intro ty' v' hD' hEqL
          rw [hDeclSrc] at hD'; cases hD'
          exact s3c_liveUninitSlot_checkVal ty v' (MemCopySlot.baseSlot.inj hEqL)
        have hWf' := s3_memWf_set_nonBuf ctx.bodySrc f₁.locals slots₁' mem id (.baseSlot (liveUninitSlot ty)) hWf hNotBuf hBaseOk hS1
        have hRel' := s3_slotsRel_set_base ctx f₁.locals f₂.locals slots₁' slots₂' id ty _ hDeclSrc hRel hS1 hS2
        refine ⟨slots₁', slots₂', mem, rfl, ?_, hWf', hRel'⟩
        unfold evalMemCopyStmt; dsimp
        rw [hDeclTgt]; dsimp
        change (match setElem? f₂.locals id (.baseSlot (liveUninitSlot ty)) with
          | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
          | some slots' => stepMemCopyNext f₂ mem slots') = _
        rw [hS2]
      · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
      · intro kFault hFault
        unfold evalMemCopyStmt at hFault; dsimp at hFault
        rw [hDeclSrc] at hFault; dsimp at hFault
        change (match setElem? f₁.locals id (.baseSlot (liveUninitSlot ty)) with
          | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
          | some slots' => stepMemCopyNext f₁ mem slots') = .fault kFault at hFault
        rw [hS1] at hFault; cases hFault
    | byteBuf sz al mutab =>
      apply s3_sim_stmt_one ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxNext hBbTgt hStmtTgt
      have hLt1 : id < f₁.locals.length := by rw [hRel.1]; exact hidLt
      have hLt2 : id < f₂.locals.length := by
        rw [hRel.2.1, s3_bodyTgt_locals_length]
        exact Nat.lt_of_lt_of_le hidLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
      cases s3_setElem?_some_of_lt f₁.locals id (.bufSlot true) hLt1 with | intro slots₁' hS1 =>
      cases s3_setElem?_some_of_lt f₂.locals id (.bufSlot true) hLt2 with | intro slots₂' hS2 =>
      let fresh : Allocation := {
        allocId := internalAllocBase + id
        alignLog2 := al
        mutability := mutab
        bytes := listReplicate sz .uninit
        live := true
      }
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep
        unfold evalMemCopyStmt at hStep; dsimp at hStep
        rw [hDeclSrc] at hStep; dsimp at hStep
        change (match setElem? f₁.locals id (.bufSlot true) with
          | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
          | some slots' =>
            match updateAlloc? (internalAllocBase + id) fresh mem.allocations with
            | some allocs' => stepMemCopyNext f₁ ⟨allocs'⟩ slots'
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)) = .step s₁' at hStep
        rw [hS1] at hStep; dsimp at hStep
        cases hUp : updateAlloc? (internalAllocBase + id) fresh mem.allocations with
        | none => rw [hUp] at hStep; cases hStep
        | some allocs' =>
          rw [hUp] at hStep; cases hStep
          have hNew : fresh.live = true ∧ fresh.alignLog2 = al ∧ fresh.mutability = mutab ∧
              (true = true → fresh.bytes.length = sz) ∧ s3_AllocBytesTagBounded fresh.bytes :=
            ⟨rfl, rfl, rfl, (fun _ => s3_listReplicate_length sz AllocByte.uninit), s3c_allocBytesTagBounded_replicate_uninit sz⟩
          have hWf' := s3_memWf_set_bufSlot ctx.bodySrc f₁.locals slots₁' mem id true allocs' fresh sz al mutab
            hWf hDeclSrc hS1 rfl hUp hNew
          have hRel' := s3_slotsRel_set_buf ctx f₁.locals f₂.locals slots₁' slots₂' id sz al mutab (.bufSlot true)
            hDeclSrc hRel hS1 hS2
          refine ⟨slots₁', slots₂', ⟨allocs'⟩, rfl, ?_, hWf', hRel'⟩
          unfold evalMemCopyStmt; dsimp
          rw [hDeclTgt]; dsimp
          change (match setElem? f₂.locals id (.bufSlot true) with
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
            | some slots' =>
              match updateAlloc? (internalAllocBase + id) fresh mem.allocations with
              | some allocs' => stepMemCopyNext f₂ ⟨allocs'⟩ slots'
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)) = _
          rw [hS2]; dsimp; rw [hUp]
      · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
      · intro kFault hFault
        unfold evalMemCopyStmt at hFault; dsimp at hFault
        rw [hDeclSrc] at hFault; dsimp at hFault
        change (match setElem? f₁.locals id (.bufSlot true) with
          | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
          | some slots' =>
            match updateAlloc? (internalAllocBase + id) fresh mem.allocations with
            | some allocs' => stepMemCopyNext f₁ ⟨allocs'⟩ slots'
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)) = .fault kFault at hFault
        rw [hS1] at hFault; dsimp at hFault
        cases hUp : updateAlloc? (internalAllocBase + id) fresh mem.allocations with
        | none =>
          rw [hUp] at hFault; cases hFault
          unfold evalMemCopyStmt; dsimp
          rw [hDeclTgt]; dsimp
          change (match setElem? f₂.locals id (.bufSlot true) with
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
            | some slots' =>
              match updateAlloc? (internalAllocBase + id) fresh mem.allocations with
              | some allocs' => stepMemCopyNext f₂ ⟨allocs'⟩ slots'
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)) = _
          rw [hS2]; dsimp; rw [hUp]
        | some allocs' => rw [hUp] at hFault; cases hFault

private theorem s3c_stmt_storageDead_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} (id : LocalId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.storageDead id)))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hidLt : id < ctx.bodySrc.locals.length := (s3c_storageAnnot_in_bounds ctx hBbSrc).2 hStmt
  cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
  cases hEx with | intro extraSelf hBlock =>
  have hBbTgt := hBlock.2.2.1
  have hGetSt := hBlock.2.2.2.1
  have hIdxNext := hBlock.2.2.2.2
  rw [← hIdxEq] at hGetSt hIdxNext
  cases hFind : findPtrEntry ctx.plan.entries id with
  | some p =>
    cases p with | mk k optBuf =>
    cases s3c_findPtrEntry_some ctx id k optBuf hFind with | intro e hE =>
    have hEB := s3_ptrEntry_bounds ctx k e hE.1
    have hComp := s3_bodyTgt_locals_comp ctx k hEB.2.2.2
    have hB0 := s3_compOffset_bounds ctx k 0 hEB.2.2.2 (Nat.succ_pos 2)
    have hB1 := s3_compOffset_bounds ctx k 1 hEB.2.2.2 (by decide)
    have hB2 := s3_compOffset_bounds ctx k 2 hEB.2.2.2 (by decide)
    rw [Nat.add_zero] at hB0
    have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
        (.baseStmt (.storageDead id)) =
        [.baseStmt (.storageDead (ctx.bodySrc.locals.length + 3 * k)),
         .baseStmt (.storageDead (ctx.bodySrc.locals.length + 3 * k + 1)),
         .baseStmt (.storageDead (ctx.bodySrc.locals.length + 3 * k + 2))] := by
      unfold lowerStmtForPtrs; dsimp; rw [hFind]; rfl
    rw [hGenEq] at hGetSt hIdxNext
    have hS0 := hGetSt 0 (show 0 < 3 from by decide)
    rw [Nat.add_zero] at hS0
    have hS1 := hGetSt 1 (show 1 < 3 from by decide)
    have hS2 := hGetSt 2 (show 2 < 3 from by decide)
    have hPos0 : 0 < ctx.bodySrc.locals.length + 3 * k := Nat.lt_of_lt_of_le (Nat.lt_of_le_of_lt (Nat.zero_le _) ctx.hArgLt) hB0.1
    have hPos1 : 0 < ctx.bodySrc.locals.length + 3 * k + 1 := Nat.succ_pos _
    have hPos2 : 0 < ctx.bodySrc.locals.length + 3 * k + 2 := Nat.succ_pos _
    have hPosId : 0 < id := by rw [← hE.2.1]; exact Nat.lt_of_le_of_lt (Nat.zero_le _) hEB.1
    have hLtC0 : ctx.bodySrc.locals.length + 3 * k < f₂.locals.length := by
      rw [hRel.2.1, s3_bodyTgt_locals_length]; exact Nat.lt_of_lt_of_le hB0.2 (Nat.le_add_right _ _)
    cases s3c_eval_storageDead_base ctx (ctx.bodySrc.locals.length + 3 * k) .unit hPos0 hComp.1 hLtC0 hBbTgt hS0 with
    | intro s2a hS2a =>
      have hLtC1 : ctx.bodySrc.locals.length + 3 * k + 1 < s2a.length := by
        rw [s3_setElem?_length _ _ _ _ hS2a.1, hRel.2.1, s3_bodyTgt_locals_length]
        exact Nat.lt_of_lt_of_le hB1.2 (Nat.le_add_right _ _)
      cases s3c_eval_storageDead_base ctx (ctx.bodySrc.locals.length + 3 * k + 1) usizeTy hPos1 hComp.2.1 hLtC1 hBbTgt hS1 with
      | intro s2b hS2b =>
        have hLtC2 : ctx.bodySrc.locals.length + 3 * k + 2 < s2b.length := by
          rw [s3_setElem?_length _ _ _ _ hS2b.1, s3_setElem?_length _ _ _ _ hS2a.1, hRel.2.1, s3_bodyTgt_locals_length]
          exact Nat.lt_of_lt_of_le hB2.2 (Nat.le_add_right _ _)
        cases s3c_eval_storageDead_base ctx (ctx.bodySrc.locals.length + 3 * k + 2) usizeTy hPos2 hComp.2.2 hLtC2 hBbTgt hS2 with
        | intro s2c hS2c =>
          have hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals } := by
            cases f₂; dsimp at hDef₂; rw [hDef₂, hBbRel]
          have hReach3 : ReachesNMemCopy ctx.pTgt 3 { frames := [f₂], mem := mem }
              { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 3, locals := s2c }], mem := mem } := by
            rw [hf₂Eq]
            exact s3_reachesN_cons hS2a.2 (s3_reachesN_cons hS2b.2 (s3_reachesN_one hS2c.2))
          have hLt1 : id < f₁.locals.length := by rw [hRel.1]; exact hidLt
          cases s3_setElem?_some_of_lt f₁.locals id .ptrDead hLt1 with | intro slots₁' hSet1 =>
          have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals id ≠ some (.byteBuf sz al mutab) :=
            fun _ _ _ h => by rw [hE.2.1] at hEB; rw [h] at hEB; cases hEB.2.2.1
          have hBaseOk : ∀ ty v, Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty) →
              MemCopySlot.ptrDead = .baseSlot (.live (some v)) → checkVal v ty = true :=
            fun _ _ _ h => by cases h
          have hWf' := s3_memWf_set_nonBuf ctx.bodySrc f₁.locals slots₁' mem id .ptrDead hWf hNotBuf hBaseOk hSet1
          have hN1_0 : ctx.bodySrc.locals.length + 3 * k + 1 ≠ ctx.bodySrc.locals.length + 3 * k :=
            (Nat.ne_of_lt (Nat.lt_succ_self _)).symm
          have hN2_0 : ctx.bodySrc.locals.length + 3 * k + 2 ≠ ctx.bodySrc.locals.length + 3 * k :=
            (s3c_ne_add_two _).symm
          have hN2_1 : ctx.bodySrc.locals.length + 3 * k + 2 ≠ ctx.bodySrc.locals.length + 3 * k + 1 :=
            (Nat.ne_of_lt (Nat.lt_succ_self _)).symm
          have hEntryRel : s3_PtrSlotEntryRel ctx.bodySrc.locals.length k e slots₁' s2c := by
            unfold s3_PtrSlotEntryRel
            rw [hE.2.1, s3_getElem?_setElem?_eq _ _ _ _ hSet1]; dsimp
            refine ⟨?_, ?_, ?_⟩
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2_0 hS2c.1,
                  s3_getElem?_setElem?_ne _ _ _ _ _ hN1_0 hS2b.1,
                  s3_getElem?_setElem?_eq _ _ _ _ hS2a.1]
            · rw [s3_getElem?_setElem?_ne _ _ _ _ _ hN2_1 hS2c.1,
                  s3_getElem?_setElem?_eq _ _ _ _ hS2b.1]
            · rw [s3_getElem?_setElem?_eq _ _ _ _ hS2c.1]
          have hRel' := s3_slotsRel_set_ptr ctx f₁.locals f₂.locals slots₁' s2a s2b s2c k e
            .ptrDead (.baseSlot .dead) (.baseSlot .dead) (.baseSlot .dead)
            hE.1 hRel (by rw [hE.2.1]; exact hSet1) hS2a.1 hS2b.1 hS2c.1 hEntryRel
          apply s3c_fwdStepSim_of_stmt_multi ctx hDef₁ hBbSrc hStmt
          · intro s₁' hStep
            unfold evalMemCopyStmt at hStep; dsimp at hStep
            rw [s3c_nat_beq_0_of_pos hPosId] at hStep; dsimp at hStep
            rw [hE.2.1] at hEB
            rw [hEB.2.2.1] at hStep; dsimp at hStep
            change (match setElem? f₁.locals id .ptrDead with
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
              | some slots' => stepMemCopyNext f₁ mem slots') = .step s₁' at hStep
            rw [hSet1] at hStep; cases hStep
            have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length := s3_getElem?_some_lt _ _ _ hStmt
            exact s3_reachesPlus_stmt_rel ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hLeNext hIdxNext hReach3 rfl hWf' hRel'
          · intro kFault hFault
            unfold evalMemCopyStmt at hFault; dsimp at hFault
            rw [s3c_nat_beq_0_of_pos hPosId] at hFault; dsimp at hFault
            rw [hE.2.1] at hEB
            rw [hEB.2.2.1] at hFault; dsimp at hFault
            change (match setElem? f₁.locals id .ptrDead with
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
              | some slots' => stepMemCopyNext f₁ mem slots') = .fault kFault at hFault
            rw [hSet1] at hFault; cases hFault
  | none =>
    have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
        (.baseStmt (.storageDead id)) = [.baseStmt (.storageDead id)] := by
      unfold lowerStmtForPtrs; dsimp; rw [hFind]
    rw [hGenEq] at hGetSt hIdxNext
    have hStmtTgt := hGetSt 0 (show 0 < 1 from by decide)
    rw [Nat.add_zero] at hStmtTgt
    rw [hBbRel] at hBbTgt
    apply s3_sim_stmt_one ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxNext hBbTgt hStmtTgt
    cases hZ : Nat.beq id 0 with
    | true =>
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep; unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hZ] at hStep; cases hStep
      · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
      · intro kFault hFault
        unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hZ] at hFault; cases hFault
        unfold evalMemCopyStmt; dsimp; rw [hZ]; rfl
    | false =>
      have hNotPtr := (s3_findPtrEntry_none_iff ctx id).mp hFind
      have hDeclTgt := s3_bodyTgt_locals_base ctx id hidLt
      cases s3c_getElem?_some_of_lt hidLt with | intro decl hDeclSrc =>
      rw [hDeclSrc] at hDeclTgt
      cases decl with
      | ptrLocal => exact False.elim (hNotPtr hDeclSrc)
      | base ty =>
        have hLt1 : id < f₁.locals.length := by rw [hRel.1]; exact hidLt
        have hLt2 : id < f₂.locals.length := by
          rw [hRel.2.1, s3_bodyTgt_locals_length]
          exact Nat.lt_of_lt_of_le hidLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
        cases s3_setElem?_some_of_lt f₁.locals id (.baseSlot .dead) hLt1 with | intro slots₁' hS1 =>
        cases s3_setElem?_some_of_lt f₂.locals id (.baseSlot .dead) hLt2 with | intro slots₂' hS2 =>
        refine ⟨?_, ?_, ?_⟩
        · intro s₁' hStep
          unfold evalMemCopyStmt at hStep; dsimp at hStep
          rw [hZ] at hStep; dsimp at hStep
          rw [hDeclSrc] at hStep; dsimp at hStep
          change (match setElem? f₁.locals id (.baseSlot .dead) with
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
            | some slots' => stepMemCopyNext f₁ mem slots') = .step s₁' at hStep
          rw [hS1] at hStep; cases hStep
          have hNotBuf : ∀ sz al mutab, Trusted.MirSemantics.getElem? ctx.bodySrc.locals id ≠ some (.byteBuf sz al mutab) :=
            fun _ _ _ h => by rw [hDeclSrc] at h; cases h
          have hBaseOk : ∀ ty' v', Trusted.MirSemantics.getElem? ctx.bodySrc.locals id = some (.base ty') →
              MemCopySlot.baseSlot .dead = .baseSlot (.live (some v')) → checkVal v' ty' = true :=
            fun _ _ _ h => by cases h
          have hWf' := s3_memWf_set_nonBuf ctx.bodySrc f₁.locals slots₁' mem id (.baseSlot .dead) hWf hNotBuf hBaseOk hS1
          have hRel' := s3_slotsRel_set_base ctx f₁.locals f₂.locals slots₁' slots₂' id ty _ hDeclSrc hRel hS1 hS2
          refine ⟨slots₁', slots₂', mem, rfl, ?_, hWf', hRel'⟩
          unfold evalMemCopyStmt; dsimp
          rw [hZ]; dsimp; rw [hDeclTgt]; dsimp
          change (match setElem? f₂.locals id (.baseSlot .dead) with
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
            | some slots' => stepMemCopyNext f₂ mem slots') = _
          rw [hS2]
        · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
        · intro kFault hFault
          unfold evalMemCopyStmt at hFault; dsimp at hFault
          rw [hZ] at hFault; dsimp at hFault
          rw [hDeclSrc] at hFault; dsimp at hFault
          change (match setElem? f₁.locals id (.baseSlot .dead) with
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
            | some slots' => stepMemCopyNext f₁ mem slots') = .fault kFault at hFault
          rw [hS1] at hFault; cases hFault
      | byteBuf sz al mutab =>
        have hLt1 : id < f₁.locals.length := by rw [hRel.1]; exact hidLt
        have hLt2 : id < f₂.locals.length := by
          rw [hRel.2.1, s3_bodyTgt_locals_length]
          exact Nat.lt_of_lt_of_le hidLt (Nat.le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _))
        cases s3_setElem?_some_of_lt f₁.locals id (.bufSlot false) hLt1 with | intro slots₁' hS1 =>
        cases s3_setElem?_some_of_lt f₂.locals id (.bufSlot false) hLt2 with | intro slots₂' hS2 =>
        let deadA : Allocation := {
          allocId := internalAllocBase + id
          alignLog2 := al
          mutability := mutab
          bytes := listReplicate sz .uninit
          live := false
        }
        refine ⟨?_, ?_, ?_⟩
        · intro s₁' hStep
          unfold evalMemCopyStmt at hStep; dsimp at hStep
          rw [hZ] at hStep; dsimp at hStep
          rw [hDeclSrc] at hStep; dsimp at hStep
          change (match setElem? f₁.locals id (.bufSlot false) with
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
            | some slots' =>
              match updateAlloc? (internalAllocBase + id) deadA mem.allocations with
              | some allocs' => stepMemCopyNext f₁ ⟨allocs'⟩ slots'
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)) = .step s₁' at hStep
          rw [hS1] at hStep; dsimp at hStep
          cases hUp : updateAlloc? (internalAllocBase + id) deadA mem.allocations with
          | none => rw [hUp] at hStep; cases hStep
          | some allocs' =>
            rw [hUp] at hStep; cases hStep
            have hNew : deadA.live = false ∧ deadA.alignLog2 = al ∧ deadA.mutability = mutab ∧
                (false = true → deadA.bytes.length = sz) ∧ s3_AllocBytesTagBounded deadA.bytes :=
              ⟨rfl, rfl, rfl, (fun h => by cases h), s3c_allocBytesTagBounded_replicate_uninit sz⟩
            have hWf' := s3_memWf_set_bufSlot ctx.bodySrc f₁.locals slots₁' mem id false allocs' deadA sz al mutab
              hWf hDeclSrc hS1 rfl hUp hNew
            have hRel' := s3_slotsRel_set_buf ctx f₁.locals f₂.locals slots₁' slots₂' id sz al mutab (.bufSlot false)
              hDeclSrc hRel hS1 hS2
            refine ⟨slots₁', slots₂', ⟨allocs'⟩, rfl, ?_, hWf', hRel'⟩
            unfold evalMemCopyStmt; dsimp
            rw [hZ]; dsimp; rw [hDeclTgt]; dsimp
            change (match setElem? f₂.locals id (.bufSlot false) with
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
              | some slots' =>
                match updateAlloc? (internalAllocBase + id) deadA mem.allocations with
                | some allocs' => stepMemCopyNext f₂ ⟨allocs'⟩ slots'
                | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)) = _
            rw [hS2]; dsimp; rw [hUp]
        · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
        · intro kFault hFault
          unfold evalMemCopyStmt at hFault; dsimp at hFault
          rw [hZ] at hFault; dsimp at hFault
          rw [hDeclSrc] at hFault; dsimp at hFault
          change (match setElem? f₁.locals id (.bufSlot false) with
            | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
            | some slots' =>
              match updateAlloc? (internalAllocBase + id) deadA mem.allocations with
              | some allocs' => stepMemCopyNext f₁ ⟨allocs'⟩ slots'
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)) = .fault kFault at hFault
          rw [hS1] at hFault; dsimp at hFault
          cases hUp : updateAlloc? (internalAllocBase + id) deadA mem.allocations with
          | none =>
            rw [hUp] at hFault; cases hFault
            unfold evalMemCopyStmt; dsimp
            rw [hZ]; dsimp; rw [hDeclTgt]; dsimp
            change (match setElem? f₂.locals id (.bufSlot false) with
              | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)
              | some slots' =>
                match updateAlloc? (internalAllocBase + id) deadA mem.allocations with
                | some allocs' => stepMemCopyNext f₂ ⟨allocs'⟩ slots'
                | none => (StepResult.fault FaultKind.unsupported : StepResult MemCopyState TerminalOut)) = _
            rw [hS2]; dsimp; rw [hUp]
          | some allocs' => rw [hUp] at hFault; cases hFault

private theorem s3c_stmt_assign_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (dst : Place) (rval : Rvalue)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.baseStmt (.assign dst rval)))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3c_blockStmt_check ctx hBbSrc hStmt
  cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
  cases hEx with | intro extraSelf hBlock =>
  have hBbTgt := hBlock.2.2.1
  have hGetSt := hBlock.2.2.2.1
  have hIdxNext := hBlock.2.2.2.2
  rw [hBbRel] at hBbTgt
  rw [← hIdxEq] at hGetSt hIdxNext
  have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
      (.baseStmt (.assign dst rval)) = [.baseStmt (.assign dst rval)] := rfl
  rw [hGenEq] at hGetSt hIdxNext
  have hStmtTgt := hGetSt 0 (show 0 < 1 from by decide)
  rw [Nat.add_zero] at hStmtTgt
  apply s3_sim_stmt_one ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxNext hBbTgt hStmtTgt
  cases hProj : !dst.projection.isEmpty with
    | true =>
      refine ⟨?_, ?_, ?_⟩
      · intro s₁' hStep; unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hProj] at hStep; cases hStep
      · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
      · intro kFault hFault
        unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hProj] at hFault; cases hFault
        unfold evalMemCopyStmt; dsimp; rw [hProj]; rfl
    | false =>
      unfold checkStmtForPtrs at hChk
      dsimp at hChk
      rw [hProj] at hChk; dsimp at hChk
      cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals dst.localId with
      | none => rw [hD] at hChk; cases hChk
      | some d =>
        rw [hD] at hChk
        cases d with
        | byteBuf _ _ _ | ptrLocal => cases hChk
        | base dstTy =>
          have hDeclTgt := s3_bodyTgt_locals_base ctx dst.localId (s3_getElem?_some_lt _ _ _ hD)
          rw [hD] at hDeclTgt
          have hRvSim := s3_evalBaseRvalue_sim ctx f₁.locals f₂.locals mem dstTy rval hWf hRel hChk
          cases hRv1 : evalMemCopyBaseRvalue ctx.bodySrc.locals f₁.locals dstTy rval with
          | error k1 =>
            rw [hRv1] at hRvSim
            cases hRv2 : evalMemCopyBaseRvalue ctx.bodyTgt.locals f₂.locals dstTy rval with
            | ok _ => rw [hRv2] at hRvSim; exact False.elim hRvSim
            | error k2 =>
              rw [hRv2] at hRvSim
              refine ⟨?_, ?_, ?_⟩
              · intro s₁' hStep; unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hProj] at hStep; dsimp at hStep
                rw [hD] at hStep; dsimp at hStep; rw [hRv1] at hStep; cases hStep
              · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
              · intro kFault hFault
                unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hProj] at hFault; dsimp at hFault
                rw [hD] at hFault; dsimp at hFault; rw [hRv1] at hFault; cases hFault
                rw [hRvSim]
                unfold evalMemCopyStmt; dsimp; rw [hProj]; dsimp; rw [hDeclTgt]; dsimp; rw [hRv2]
          | ok res1 =>
            rw [hRv1] at hRvSim
            cases hRv2 : evalMemCopyBaseRvalue ctx.bodyTgt.locals f₂.locals dstTy rval with
            | error _ => rw [hRv2] at hRvSim; exact False.elim hRvSim
            | ok res2 =>
              rw [hRv2] at hRvSim
              cases res1 with | mk v1 slots₁' =>
              cases res2 with | mk v2 slots₂' =>
              dsimp at hRvSim
              have hWrSim := s3_writeBasePlace_sim ctx slots₁' slots₂' mem dst.localId dstTy v1 hD hRvSim.2.1 hRvSim.2.2
              cases hWr1 : writeMemCopyBasePlace slots₁' dst.localId dstTy v1 with
              | error kw1 =>
                rw [hWr1] at hWrSim
                cases hWr2 : writeMemCopyBasePlace slots₂' dst.localId dstTy v2 with
                | ok slotDummy =>
                  have hWr2' := hWr2; rw [← hRvSim.1] at hWr2'; rw [hWr2'] at hWrSim; exact False.elim hWrSim
                | error kw2 =>
                  have hWr2' := hWr2; rw [← hRvSim.1] at hWr2'; rw [hWr2'] at hWrSim
                  refine ⟨?_, ?_, ?_⟩
                  · intro s₁' hStep; unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hProj] at hStep; dsimp at hStep
                    rw [hD] at hStep; dsimp at hStep; rw [hRv1] at hStep; dsimp at hStep; rw [hWr1] at hStep; cases hStep
                  · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
                  · intro kFault hFault
                    unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hProj] at hFault; dsimp at hFault
                    rw [hD] at hFault; dsimp at hFault; rw [hRv1] at hFault; dsimp at hFault; rw [hWr1] at hFault; cases hFault
                    rw [hWrSim]
                    unfold evalMemCopyStmt; dsimp; rw [hProj]; dsimp; rw [hDeclTgt]; dsimp; rw [hRv2]; dsimp; rw [hWr2]
              | ok slots₁'' =>
                rw [hWr1] at hWrSim
                cases hWr2 : writeMemCopyBasePlace slots₂' dst.localId dstTy v2 with
                | error errDummy =>
                  have hWr2' := hWr2; rw [← hRvSim.1] at hWr2'; rw [hWr2'] at hWrSim; exact False.elim hWrSim
                | ok slots₂'' =>
                  have hWr2' := hWr2; rw [← hRvSim.1] at hWr2'; rw [hWr2'] at hWrSim
                  refine ⟨?_, ?_, ?_⟩
                  · intro s₁' hStep
                    unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hProj] at hStep; dsimp at hStep
                    rw [hD] at hStep; dsimp at hStep; rw [hRv1] at hStep; dsimp at hStep; rw [hWr1] at hStep; cases hStep
                    refine ⟨slots₁'', slots₂'', mem, rfl, ?_, hWrSim.1, hWrSim.2⟩
                    unfold evalMemCopyStmt; dsimp; rw [hProj]; dsimp; rw [hDeclTgt]; dsimp; rw [hRv2]; dsimp; rw [hWr2]
                  · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
                  · intro kFault hFault
                    unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hProj] at hFault; dsimp at hFault
                    rw [hD] at hFault; dsimp at hFault; rw [hRv1] at hFault; dsimp at hFault; rw [hWr1] at hFault; cases hFault

private theorem s3c_stmt_bufLivenessCheck_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} (b : LocalId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.bufLivenessCheck b))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3c_blockStmt_check ctx hBbSrc hStmt
  unfold checkStmtForPtrs at hChk
  dsimp at hChk
  cases hD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals b with
  | none => rw [hD] at hChk; cases hChk
  | some d =>
    rw [hD] at hChk
    cases d with
    | base _ | ptrLocal => cases hChk
    | byteBuf sz al mutab =>
      have hDeclTgt := s3_bodyTgt_locals_base ctx b (s3_getElem?_some_lt _ _ _ hD)
      rw [hD] at hDeclTgt
      cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      have hBbTgt := hBlock.2.2.1
      have hGetSt := hBlock.2.2.2.1
      have hIdxNext := hBlock.2.2.2.2
      rw [hBbRel] at hBbTgt
      rw [← hIdxEq] at hGetSt hIdxNext
      have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
          (.bufLivenessCheck b) = [.bufLivenessCheck b] := rfl
      rw [hGenEq] at hGetSt hIdxNext
      have hStmtTgt := hGetSt 0 (show 0 < 1 from by decide)
      rw [Nat.add_zero] at hStmtTgt
      apply s3_sim_stmt_one ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hStmt hIdxNext hBbTgt hStmtTgt
      cases hWf.2.1 b sz al mutab hD with | intro live hB =>
      cases hB with | intro alloc hAlloc =>
      have hSl1 := hAlloc.1
      have hSl2 : Trusted.MirSemantics.getElem? f₂.locals b = some (.bufSlot live) := by
        rw [hRel.2.2.2.1 b sz al mutab hD]; exact hSl1
      cases live with
      | true =>
        refine ⟨?_, ?_, ?_⟩
        · intro s₁' hStep
          unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hD, hSl1] at hStep; cases hStep
          refine ⟨f₁.locals, f₂.locals, mem, rfl, ?_, hWf, hRel⟩
          unfold evalMemCopyStmt; dsimp; rw [hDeclTgt, hSl2]
        · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
        · intro kFault hFault; unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hD, hSl1] at hFault; cases hFault
      | false =>
        refine ⟨?_, ?_, ?_⟩
        · intro s₁' hStep; unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hD, hSl1] at hStep; cases hStep
        · intro out hDone; exact False.elim (s3c_evalMemCopyStmt_ne_done _ _ _ _ _ hDone)
        · intro kFault hFault
          unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hD, hSl1] at hFault; cases hFault
          unfold evalMemCopyStmt; dsimp; rw [hDeclTgt, hSl2]

private theorem s3c_stmt_mkNullPtr_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} (d : LocalId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.mkNullPtr d))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3c_blockStmt_check ctx hBbSrc hStmt
  unfold checkStmtForPtrs at hChk
  dsimp at hChk
  cases hFind : findPtrEntry ctx.plan.entries d with
  | none => rw [hFind] at hChk; cases hChk
  | some p =>
    cases p with | mk kD optBufD =>
    cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
    cases hEx with | intro extraSelf hBlock =>
    have hBbTgt := hBlock.2.2.1
    have hGetSt := hBlock.2.2.2.1
    have hIdxNext := hBlock.2.2.2.2
    rw [← hIdxEq] at hGetSt hIdxNext
    have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length (.mkNullPtr d) =
        [ mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kD),
          mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 1) (usizeConst 0),
          mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 2) (usizeConst 0) ] := by
      unfold lowerStmtForPtrs; dsimp; rw [hFind]
    rw [hGenEq] at hGetSt hIdxNext
    have hS0 := hGetSt 0 (show 0 < 3 from by decide)
    rw [Nat.add_zero] at hS0
    have hS1 := hGetSt 1 (show 1 < 3 from by decide)
    have hS2 := hGetSt 2 (show 2 < 3 from by decide)
    let pv0 : PtrVal := { allocId := none, offsetBytes := 0, width := .isize }
    have hMatch0 : s3_PtrTagMatches optBufD pv0 0 := by
      unfold s3_PtrTagMatches; cases optBufD with | none => exact ⟨rfl, rfl⟩ | some _ => exact Or.inl ⟨rfl, rfl⟩
    have hPosM : 0 < maxUsize := s3_nat_pow_pos 2 (Nat.succ_pos 1) 64
    have hExec := s3_exec_writePtr_const ctx d kD optBufD 0 0 pv0 hFind hPosM hPosM rfl hMatch0 rfl
      hWf hRel hBbTgt hS0 hS1 hS2
    have hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals } := by
      cases f₂; dsimp at hDef₂; rw [hDef₂, hBbRel]
    apply s3c_fwdStepSim_of_stmt_multi ctx hDef₁ hBbSrc hStmt
    · intro s₁' hStep
      unfold evalMemCopyStmt at hStep; dsimp at hStep
      cases hWr : writePtrLocal ctx.bodySrc.locals f₁.locals d pv0 with
      | error _ => rw [hWr] at hStep; cases hStep
      | ok slots₁' =>
        rw [hWr] at hStep hExec; cases hStep
        cases hExec with | intro slots₂' hW =>
        have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length := s3_getElem?_some_lt _ _ _ hStmt
        have hReach3 : ReachesNMemCopy ctx.pTgt 3 { frames := [f₂], mem := mem }
            { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂' }], mem := mem } := by
          rw [hf₂Eq]; exact hW.1
        exact s3_reachesPlus_stmt_rel ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hLeNext hIdxNext hReach3 rfl hW.2.1 hW.2.2.1
    · intro kFault hFault
      unfold evalMemCopyStmt at hFault; dsimp at hFault
      cases hWr : writePtrLocal ctx.bodySrc.locals f₁.locals d pv0 with
      | ok _ => rw [hWr] at hFault; cases hFault
      | error err =>
        rw [hWr] at hFault hExec; cases hFault
        refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
        rw [stepMemCopy_iff_evalStep, hf₂Eq]
        exact hExec

private theorem s3c_stmt_mkDanglingPtr_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} (d : LocalId) (al : Nat)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.mkDanglingPtr d al))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3c_blockStmt_check ctx hBbSrc hStmt
  unfold checkStmtForPtrs at hChk
  dsimp at hChk
  have hAnd := (bool_and_eq_true _ _).mp hChk
  have hAlLe : al ≤ 30 := (nat_ble_eq_le al 30).mp hAnd.1
  have hNotBle : (!Nat.ble al 30) = false := by rw [hAnd.1]; rfl
  have hAlLt : Nat.pow 2 al < maxUsize := s3c_pow2_le30_lt_maxUsize al hAlLe
  cases hFind : findPtrEntry ctx.plan.entries d with
  | none => rw [hFind] at hAnd; cases hAnd.2
  | some p =>
    cases p with | mk kD optBufD =>
    cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
    cases hEx with | intro extraSelf hBlock =>
    have hBbTgt := hBlock.2.2.1
    have hGetSt := hBlock.2.2.2.1
    have hIdxNext := hBlock.2.2.2.2
    rw [← hIdxEq] at hGetSt hIdxNext
    have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length (.mkDanglingPtr d al) =
        [ mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kD),
          mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 1) (usizeConst 0),
          mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 2) (usizeConst (Nat.pow 2 al)) ] := by
      unfold lowerStmtForPtrs; dsimp; rw [hFind]
    rw [hGenEq] at hGetSt hIdxNext
    have hS0 := hGetSt 0 (show 0 < 3 from by decide)
    rw [Nat.add_zero] at hS0
    have hS1 := hGetSt 1 (show 1 < 3 from by decide)
    have hS2 := hGetSt 2 (show 2 < 3 from by decide)
    let pv : PtrVal := { allocId := none, offsetBytes := UInt64.ofNat (Nat.pow 2 al), width := .isize }
    have hMatch : s3_PtrTagMatches optBufD pv 0 := by
      unfold s3_PtrTagMatches; cases optBufD with | none => exact ⟨rfl, rfl⟩ | some _ => exact Or.inl ⟨rfl, rfl⟩
    have hOffEq : pv.offsetBytes.toNat = Nat.pow 2 al := s3_u64_toNat_ofNat _ hAlLt
    have hPosM : 0 < maxUsize := s3_nat_pow_pos 2 (Nat.succ_pos 1) 64
    have hExec := s3_exec_writePtr_const ctx d kD optBufD 0 (Nat.pow 2 al) pv hFind hPosM hAlLt rfl hMatch hOffEq
      hWf hRel hBbTgt hS0 hS1 hS2
    have hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals } := by
      cases f₂; dsimp at hDef₂; rw [hDef₂, hBbRel]
    apply s3c_fwdStepSim_of_stmt_multi ctx hDef₁ hBbSrc hStmt
    · intro s₁' hStep
      unfold evalMemCopyStmt at hStep; dsimp at hStep
      rw [hNotBle] at hStep; dsimp at hStep
      change (match writePtrLocal ctx.bodySrc.locals f₁.locals d pv with
        | .ok slots' => stepMemCopyNext f₁ mem slots'
        | .error k => StepResult.fault k) = .step s₁' at hStep
      cases hWr : writePtrLocal ctx.bodySrc.locals f₁.locals d pv with
      | error _ => rw [hWr] at hStep; cases hStep
      | ok slots₁' =>
        rw [hWr] at hStep hExec; cases hStep
        cases hExec with | intro slots₂' hW =>
        have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length := s3_getElem?_some_lt _ _ _ hStmt
        have hReach3 : ReachesNMemCopy ctx.pTgt 3 { frames := [f₂], mem := mem }
            { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 3, locals := slots₂' }], mem := mem } := by
          rw [hf₂Eq]; exact hW.1
        exact s3_reachesPlus_stmt_rel ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hLeNext hIdxNext hReach3 rfl hW.2.1 hW.2.2.1
    · intro kFault hFault
      unfold evalMemCopyStmt at hFault; dsimp at hFault
      rw [hNotBle] at hFault; dsimp at hFault
      change (match writePtrLocal ctx.bodySrc.locals f₁.locals d pv with
        | .ok slots' => stepMemCopyNext f₁ mem slots'
        | .error k => StepResult.fault k) = .fault kFault at hFault
      cases hWr : writePtrLocal ctx.bodySrc.locals f₁.locals d pv with
      | ok _ => rw [hWr] at hFault; cases hFault
      | error err =>
        rw [hWr] at hFault hExec; cases hFault
        refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
        rw [stepMemCopy_iff_evalStep, hf₂Eq]
        exact hExec

private theorem s3c_stmt_addrOfByteBuf_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory} (d b : LocalId)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.addrOfByteBuf d b))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3c_blockStmt_check ctx hBbSrc hStmt
  unfold checkStmtForPtrs at hChk
  dsimp at hChk
  cases hFind : findPtrEntry ctx.plan.entries d with
  | none => rw [hFind] at hChk; cases hChk
  | some p =>
    cases p with | mk kD optBufD =>
    rw [hFind] at hChk
    cases optBufD with
    | none => cases hChk
    | some bDst =>
      cases hDeclB : Trusted.MirSemantics.getElem? ctx.bodySrc.locals b with
      | none => rw [hDeclB] at hChk; cases hChk
      | some dB =>
        rw [hDeclB] at hChk
        cases dB with
        | base _ | ptrLocal => cases hChk
        | byteBuf sz al mutab =>
          have hBeqB : bDst = b := nat_beq_eq _ _ hChk
          rw [hBeqB] at hFind
          cases s3c_findPtrEntry_some ctx d kD (some b) hFind with | intro eD hED =>
          have hEB := s3_ptrEntry_bounds ctx kD eD hED.1
          have hDeclD : Trusted.MirSemantics.getElem? ctx.bodySrc.locals d = some .ptrLocal := by
            rw [← hED.2.1]; exact hEB.2.2.1
          have hDeclBTgt := s3_bodyTgt_locals_base ctx b (s3_getElem?_some_lt _ _ _ hDeclB)
          rw [hDeclB] at hDeclBTgt
          cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
          cases hEx with | intro extraSelf hBlock =>
          have hBbTgt := hBlock.2.2.1
          have hGetSt := hBlock.2.2.2.1
          have hIdxNext := hBlock.2.2.2.2
          rw [← hIdxEq] at hGetSt hIdxNext
          have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
              (.addrOfByteBuf d b) =
              [ .bufLivenessCheck b,
                mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kD),
                mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 1) (usizeConst 1),
                mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 2) (usizeConst 0) ] := by
            unfold lowerStmtForPtrs; dsimp; rw [hFind]
          rw [hGenEq] at hGetSt hIdxNext
          have hS0 := hGetSt 0 (show 0 < 4 from by decide)
          rw [Nat.add_zero] at hS0
          have hS1 := hGetSt 1 (show 1 < 4 from by decide)
          have hS2 := hGetSt 2 (show 2 < 4 from by decide)
          have hS3 := hGetSt 3 (show 3 < 4 from by decide)
          cases hWf.2.1 b sz al mutab hDeclB with | intro live hB =>
          cases hB with | intro alloc hAlloc =>
          have hSl1 := hAlloc.1
          have hSl2 : Trusted.MirSemantics.getElem? f₂.locals b = some (.bufSlot live) := by
            rw [hRel.2.2.2.1 b sz al mutab hDeclB]; exact hSl1
          have hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals } := by
            cases f₂; dsimp at hDef₂; rw [hDef₂, hBbRel]
          apply s3c_fwdStepSim_of_stmt_multi ctx hDef₁ hBbSrc hStmt
          · intro s₁' hStep
            cases live with
            | false =>
              unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hDeclB, hSl1] at hStep; dsimp at hStep
              rw [hDeclD] at hStep; cases hStep
            | true =>
              let pv : PtrVal := { allocId := some (internalAllocBase + b), offsetBytes := 0, width := .isize }
              unfold evalMemCopyStmt at hStep; dsimp at hStep; rw [hDeclB, hSl1] at hStep; dsimp at hStep
              have hStep0 : evalStepMemCopy ctx.pTgt 0
                  { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals }], mem := mem } =
                  .step { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx + 1, locals := f₂.locals }], mem := mem } := by
                apply s3_reachesN_stmt_step ctx hBbTgt hS0
                unfold evalMemCopyStmt; dsimp; rw [hDeclBTgt, hSl2]
              have hExec := s3_exec_writePtr_const ctx (bbIdx := f₁.blockIdx) (startIdx := f₂.stmtIdx + 1)
                d kD (some b) 1 0 pv hFind (by decide : 1 < maxUsize) (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)
                rfl (Or.inr ⟨rfl, rfl⟩) rfl hWf hRel hBbTgt hS1 hS2 hS3
              cases hWr : writePtrLocal ctx.bodySrc.locals f₁.locals d pv with
              | error _ => rw [hWr] at hStep; cases hStep
              | ok slots₁' =>
                rw [hWr] at hStep hExec; cases hStep
                cases hExec with | intro slots₂' hW =>
                have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length := s3_getElem?_some_lt _ _ _ hStmt
                have hReach4 : ReachesNMemCopy ctx.pTgt 4 { frames := [f₂], mem := mem }
                    { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 4, locals := slots₂' }], mem := mem } := by
                  rw [hf₂Eq]
                  exact s3_reachesN_cons hStep0 hW.1
                exact s3_reachesPlus_stmt_rel ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hLeNext hIdxNext hReach4 rfl hW.2.1 hW.2.2.1
          · intro kFault hFault
            cases live with
            | false =>
              unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hDeclB, hSl1] at hFault; dsimp at hFault
              rw [hDeclD] at hFault; cases hFault
              refine ⟨{ frames := [f₂], mem := mem }, .refl _, ?_⟩
              rw [stepMemCopy_iff_evalStep, hf₂Eq]
              apply s3_reachesN_stmt_fault ctx hBbTgt hS0
              unfold evalMemCopyStmt; dsimp; rw [hDeclBTgt, hSl2]
            | true =>
              let pv : PtrVal := { allocId := some (internalAllocBase + b), offsetBytes := 0, width := .isize }
              unfold evalMemCopyStmt at hFault; dsimp at hFault; rw [hDeclB, hSl1] at hFault; dsimp at hFault
              have hStep0 : evalStepMemCopy ctx.pTgt 0
                  { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals }], mem := mem } =
                  .step { frames := [{ defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx + 1, locals := f₂.locals }], mem := mem } := by
                apply s3_reachesN_stmt_step ctx hBbTgt hS0
                unfold evalMemCopyStmt; dsimp; rw [hDeclBTgt, hSl2]
              have hExec := s3_exec_writePtr_const ctx (bbIdx := f₁.blockIdx) (startIdx := f₂.stmtIdx + 1)
                d kD (some b) 1 0 pv hFind (by decide : 1 < maxUsize) (s3_nat_pow_pos 2 (Nat.succ_pos 1) 64)
                rfl (Or.inr ⟨rfl, rfl⟩) rfl hWf hRel hBbTgt hS1 hS2 hS3
              cases hWr : writePtrLocal ctx.bodySrc.locals f₁.locals d pv with
              | ok _ => rw [hWr] at hFault; cases hFault
              | error err =>
                rw [hWr] at hFault hExec; cases hFault
                rw [hf₂Eq]
                exact s3_fault_of_reachesN (s3_reachesN_one hStep0) hExec

private theorem s3c_stmt_copyPtr_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (d s : LocalId) (isMove : Bool)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.copyPtr d s isMove))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3c_blockStmt_check ctx hBbSrc hStmt
  unfold checkStmtForPtrs at hChk
  dsimp at hChk
  cases hFindD : findPtrEntry ctx.plan.entries d with
  | none => rw [hFindD] at hChk; cases hChk
  | some pD =>
    cases pD with | mk kD bD =>
    cases hFindS : findPtrEntry ctx.plan.entries s with
    | none => rw [hFindD, hFindS] at hChk; cases hChk
    | some pS =>
      cases pS with | mk kS bS =>
      rw [hFindD, hFindS] at hChk; dsimp at hChk
      cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      have hBbTgt := hBlock.2.2.1
      have hGetSt := hBlock.2.2.2.1
      have hIdxNext := hBlock.2.2.2.2
      rw [← hIdxEq] at hGetSt hIdxNext
      have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
          (.copyPtr d s isMove) =
          [ mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kS),
            mkAssignUse (s3_scrBase ctx)
              (if isMove then .move { localId := ctx.bodySrc.locals.length + 3 * kS + 1, projection := [] }
               else .copy { localId := ctx.bodySrc.locals.length + 3 * kS + 1, projection := [] }),
            mkAssignUse (s3_scrBase ctx + 1)
              (if isMove then .move { localId := ctx.bodySrc.locals.length + 3 * kS + 2, projection := [] }
               else .copy { localId := ctx.bodySrc.locals.length + 3 * kS + 2, projection := [] }),
            mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kD),
            mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 1) (.move { localId := s3_scrBase ctx, projection := [] }),
            mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 2) (.move { localId := s3_scrBase ctx + 1, projection := [] }) ] := by
        unfold lowerStmtForPtrs; dsimp; rw [hFindD, hFindS]; rfl
      rw [hGenEq] at hGetSt hIdxNext
      have hS0 := hGetSt 0 (show 0 < 6 from by decide)
      rw [Nat.add_zero] at hS0
      have hS1 := hGetSt 1 (show 1 < 6 from by decide)
      have hS2 := hGetSt 2 (show 2 < 6 from by decide)
      have hS3 := hGetSt 3 (show 3 < 6 from by decide)
      have hS4 := hGetSt 4 (show 4 < 6 from by decide)
      have hS5 := hGetSt 5 (show 5 < 6 from by decide)
      have hRead := s3_exec_readPtr ctx s kS 0 1 bS isMove hFindS (by decide) (by decide) (by decide)
        hWf hRel hBbTgt hS0 hS1 hS2
      have hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals } := by
        cases f₂; dsimp at hDef₂; rw [hDef₂, hBbRel]
      apply s3c_fwdStepSim_of_stmt_multi ctx hDef₁ hBbSrc hStmt
      · intro s₁' hStep
        unfold evalMemCopyStmt at hStep; dsimp at hStep
        cases hRd : readPtrLocal ctx.bodySrc.locals f₁.locals s isMove with
        | error _ => rw [hRd] at hStep; cases hStep
        | ok pR =>
          rw [hRd] at hStep hRead; dsimp at hStep
          cases pR with | mk pv slots₁' =>
          cases hRead with | intro tagVal hR =>
          cases hR with | intro s2a hRA =>
          have hMatchD := s3c_ptrTagMatches_compat hChk hRA.2.1
          have hWrite := s3_exec_writePtr_from_scr ctx (bbIdx := f₁.blockIdx) (startIdx := f₂.stmtIdx + 3)
            d kD 0 1 bD tagVal pv.offsetBytes.toNat pv hFindD (by decide) (by decide) (by decide)
            hRA.2.2.1 (s3_u64_toNat_lt pv.offsetBytes) hRA.1 hMatchD rfl
            hRA.2.2.2.2.2.2.1 hRA.2.2.2.2.2.2.2.1 hRA.2.2.2.2.1 hRA.2.2.2.2.2.1 hBbTgt hS3 hS4 hS5
          cases hWr : writePtrLocal ctx.bodySrc.locals slots₁' d pv with
          | error _ => rw [hWr] at hStep; cases hStep
          | ok slots₁'' =>
            rw [hWr] at hStep hWrite; cases hStep
            cases hWrite with | intro slots₂' hW =>
            have hLeNext : f₁.stmtIdx + 1 ≤ bbSrc.statements.length := s3_getElem?_some_lt _ _ _ hStmt
            have hReach6 : ReachesNMemCopy ctx.pTgt 6 { frames := [f₂], mem := mem }
                { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 6, locals := slots₂' }], mem := mem } := by
              rw [hf₂Eq]
              exact reachesNMemCopy_trans hRA.2.2.2.1 hW.1
            exact s3_reachesPlus_stmt_rel ctx hEqId hDef₁ hDef₂ hBbRel hBbSrc hLeNext hIdxNext hReach6 rfl hW.2.1 hW.2.2
      · intro kFault hFault
        unfold evalMemCopyStmt at hFault; dsimp at hFault
        cases hRd : readPtrLocal ctx.bodySrc.locals f₁.locals s isMove with
        | error err =>
          rw [hRd] at hFault hRead; cases hFault
          cases hRead with | intro n hBad =>
          cases hBad with | intro sBad hB =>
          rw [hf₂Eq]
          exact s3_fault_of_reachesN hB.1 hB.2
        | ok pR =>
          rw [hRd] at hFault hRead; dsimp at hFault
          cases pR with | mk pv slots₁' =>
          cases hRead with | intro tagVal hR =>
          cases hR with | intro s2a hRA =>
          have hMatchD := s3c_ptrTagMatches_compat hChk hRA.2.1
          have hWrite := s3_exec_writePtr_from_scr ctx (bbIdx := f₁.blockIdx) (startIdx := f₂.stmtIdx + 3)
            d kD 0 1 bD tagVal pv.offsetBytes.toNat pv hFindD (by decide) (by decide) (by decide)
            hRA.2.2.1 (s3_u64_toNat_lt pv.offsetBytes) hRA.1 hMatchD rfl
            hRA.2.2.2.2.2.2.1 hRA.2.2.2.2.2.2.2.1 hRA.2.2.2.2.1 hRA.2.2.2.2.2.1 hBbTgt hS3 hS4 hS5
          cases hWr : writePtrLocal ctx.bodySrc.locals slots₁' d pv with
          | ok _ => rw [hWr] at hFault; cases hFault
          | error err =>
            rw [hWr] at hFault hWrite; cases hFault
            rw [hf₂Eq]
            exact s3_fault_of_reachesN hRA.2.2.2.1 hWrite

private theorem s3c_stmt_ptrWrappingOffset_sim (ctx : s3_PtrCtx)
    {bbSrc : MemCopyBlock} {f₁ f₂ : MemCopyFrame} {mem : CallerMemory}
    (d s : LocalId) (cntOp : Operand) (elemSize : Nat)
    (hEqId : Nat.beq ctx.plan.defId ctx.pSrc.entryDefId = true)
    (hDef₁ : f₁.defId = ctx.plan.defId) (hDef₂ : f₂.defId = ctx.plan.defId)
    (hBbRel : f₁.blockIdx = f₂.blockIdx)
    (hBbSrc : Trusted.MirSemantics.getElem? ctx.bodySrc.basicBlocks f₁.blockIdx = some bbSrc)
    (hStmt : Trusted.MirSemantics.getElem? bbSrc.statements f₁.stmtIdx = some (.ptrWrappingOffset d s cntOp elemSize))
    (hIdxEq : f₂.stmtIdx = s3_loweredStmtIdx ctx bbSrc.statements f₁.stmtIdx)
    (hWf : s3_MemWf ctx.bodySrc f₁.locals mem)
    (hRel : s3_SlotsRel ctx f₁.locals f₂.locals) :
    s3_FwdStepSim ctx f₁ mem f₂ mem := by
  have hChk := s3c_blockStmt_check ctx hBbSrc hStmt
  unfold checkStmtForPtrs at hChk
  dsimp at hChk
  have hAnd0 := (bool_and_eq_true _ _).mp hChk
  have hOpChk := hAnd0.1
  have hPtrsChk := hAnd0.2
  cases hFindD : findPtrEntry ctx.plan.entries d with
  | none => rw [hFindD] at hPtrsChk; cases hPtrsChk
  | some pD =>
    cases pD with | mk kD bD =>
    cases hFindS : findPtrEntry ctx.plan.entries s with
    | none => rw [hFindD, hFindS] at hPtrsChk; cases hPtrsChk
    | some pS =>
      cases pS with | mk kS bS =>
      rw [hFindD, hFindS] at hPtrsChk; dsimp at hPtrsChk
      cases s3_lowerBlock_getElem?_stmt ctx hBbSrc hStmt with | intro extraBase hEx =>
      cases hEx with | intro extraSelf hBlock =>
      have hBbTgt := hBlock.2.2.1
      have hGetSt := hBlock.2.2.2.1
      have hIdxNext := hBlock.2.2.2.2
      rw [← hIdxEq] at hGetSt hIdxNext
      have hf₂Eq : f₂ = { defId := ctx.plan.defId, blockIdx := f₁.blockIdx, stmtIdx := f₂.stmtIdx, locals := f₂.locals } := by
        cases f₂; dsimp at hDef₂; rw [hDef₂, hBbRel]
      have hmPos : 0 < maxUsize := s3_nat_pow_pos 2 (Nat.succ_pos 1) 64
      cases hConst : constIsizeValue? cntOp with
      | some z =>
        let deltaMod : Nat := (intEmod (z * Int.ofNat elemSize) (Int.ofNat maxUsize)).toNat
        have hDeltaLt : deltaMod < maxUsize := s3_intEmod_toNat_lt _ maxUsize hmPos
        have hGenEq : lowerStmtForPtrs ctx.bodySrc.locals ctx.plan.entries ctx.bodySrc.locals.length
            (.ptrWrappingOffset d s cntOp elemSize) =
            [ mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kS),
              mkAssignUse (s3_scrBase ctx) (.copy { localId := ctx.bodySrc.locals.length + 3 * kS + 1, projection := [] }),
              mkAssignUse (s3_scrBase ctx + 1) (.copy { localId := ctx.bodySrc.locals.length + 3 * kS + 2, projection := [] }),
              mkBinOpStmt (s3_scrBase ctx + 1) .add (.move { localId := s3_scrBase ctx + 1, projection := [] }) (usizeConst deltaMod),
              mkLivenessCheckStmt (ctx.bodySrc.locals.length + 3 * kD),
              mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 1) (.move { localId := s3_scrBase ctx, projection := [] }),
              mkAssignUse (ctx.bodySrc.locals.length + 3 * kD + 2) (.move { localId := s3_scrBase ctx + 1, projection := [] }) ] := by
          unfold lowerStmtForPtrs; dsimp; rw [hFindD, hFindS, hConst]; rfl
        rw [hGenEq] at hGetSt hIdxNext
        have hS0 := hGetSt 0 (show 0 < 7 from by decide)
        rw [Nat.add_zero] at hS0
        have hS1 := hGetSt 1 (show 1 < 7 from by decide)
        have hS2 := hGetSt 2 (show 2 < 7 from by decide)
        have hS3 := hGetSt 3 (show 3 < 7 from by decide)
        have hS4 := hGetSt 4 (show 4 < 7 from by decide)
        have hS5 := hGetSt 5 (show 5 < 7 from by decide)
        have hS6 := hGetSt 6 (show 6 < 7 from by decide)
        have hEvCnt := s3_evalOffsetCountOp_const_ok ctx.bodySrc.locals f₁.locals cntOp z hConst
        have hRead := s3_exec_readPtr ctx s kS 0 1 bS false hFindS (by decide) (by decide) (by decide)
          hWf hRel hBbTgt hS0 hS1 hS2
        apply s3c_fwdStepSim_of_stmt_multi ctx hDef₁ hBbSrc hStmt
        · intro s₁' hStep
          unfold evalMemCopyStmt at hStep; dsimp at hStep
          rw [hEvCnt] at hStep; dsimp at hStep
          cases hRd : readPtrLocal ctx.bodySrc.locals f₁.locals s false with
          | error _ => rw [hRd] at hStep; cases hStep
          | ok pR =>
            rw [hRd] at hStep hRead; dsimp at hStep
            cases pR with | mk pv slots₁' =>
            cases hRead with | intro tagVal hR =>
            cases hR with | intro s2a hRA =>
            have hLt1 : s3_scrBase ctx + 1 < s2a.length := by
              rw [hRA.2.2.2.2.2.1.2.1]; exact s3_scrLoc_lt_bodyTgt ctx 1 (by decide)
            cases s3_evalPrimOp_scr_move ctx s2a 1 pv.offsetBytes.toNat (by decide) hLt1 hRA.2.2.2.2.2.2.2.1 with
            | intro s2aMove hMove1 =>
              have hRelMove := s3_slotsRel_set_scratch ctx slots₁' s2a s2aMove 1 none (by decide)
                hRA.2.2.2.2.2.1 hMove1.1
              let sumMod : Nat := Nat.mod (pv.offsetBytes.toNat + deltaMod) maxUsize
              have hSumLt : sumMod < maxUsize := s3_nat_mod_lt_of_pos hmPos
              have hR3 := s3_evalPrimOp_usizeConst ctx.bodyTgt.locals s2aMove deltaMod hDeltaLt
              have hStep3Res := s3_exec_mkBinOpStmt_usize_scr ctx (mem := mem) 1 .add
                (.move { localId := s3_scrBase ctx + 1, projection := [] }) (usizeConst deltaMod)
                _ _ sumMod (by decide) hSumLt hMove1.2 hR3
                (s3_evalBinOp_usize_add pv.offsetBytes.toNat deltaMod (s3_u64_toNat_lt pv.offsetBytes) hDeltaLt)
