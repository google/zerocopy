                    rw [hSome.1]; dsimp
                    rw [hSome.2] at hTagSlot3
                    have hExecSub := s3_exec_mkSubUncheckedUsize_scr ctx (bbIdx := extraBase + 1)
                      (bbTgt := nzBb) (idx := 0) (slots₁ := slots₁b) (slots₂ := slots₂c)
                      (mem := mem) 5 (.copy { localId := s3_scrBase ctx + 0, projection := [] }) (usizeConst 1) 1 1
                      (by decide) (by decide) (by decide)
                      (s3_evalPrimOp_scr_copy ctx slots₂c 0 1 (by decide) hTagSlot3)
                      (s3_evalPrimOp_usizeConst ctx.bodyTgt.locals slots₂c 1 (by decide))
                      hRel3 hExtra1 hTagStmt
                    cases hExecSub.1 (Nat.le_refl 1) with | intro slots₂d hD =>
