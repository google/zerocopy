import ToyHyper.Noninterference

/-!
# Determinization (Resolution of Nondeterminism) and Secrecy

Terminology note: throughout this module, "determinization" means **resolving
nondeterminism** by choosing one output per input (also called a scheduler,
strategy, or uniformization), which shrinks the trace set. It does **not** mean
the automata-theoretic subset construction, which preserves the trace set.

This module models choice-indexed presentations of nondeterministic
specifications as `SpecOf f`, where `out = f lowIn highIn c` for some `c : C`.
It distinguishes properties of a **choice presentation** `f` from properties of
the underlying trace-set specification `SpecOf f`:
- On the XOR presentation `xorSpecFn (_ h c => xor h c)`, every
  secret-independent choice function `g : Unit → Bool` breaks `GNI`, and every
  `GNI`-preserving choice function `r : Unit → Bool → Bool` must depend on
  `highIn` (`¬ SecretIndependent r`). Yet `SpecOf xorSpecFn = SpecOf constLowSpecFn = fullIOSystem`,
  every `GNI` determinization of `xorSpecFn` is a constant system whose
  observable behavior does not depend on `highIn`, and the exact same
  constant-false system is obtained via a secret-independent choice on the
  `constLowSpecFn` presentation.
- On arbitrary (possibly partial) systems, `GNI S ∧ Deterministic S ↔ ObsDet S ∧ RectangularDomain S`,
  specializing to `GNI S ↔ ObsDet S` under `AcceptanceIgnoresHigh S` or
  `InputTotal S`, and to `GNI (ofFn g) ↔ SecretIndependent g` on function graphs.
- For any choice presentation `f`, `SpecOf f` admits an input-total `GNI`
  refinement (deterministic or not — determinism is free in this single-step
  model) iff there exists a choice function `r : L → H → C` making the resolved
  output secret-independent, equivalently (for `[Nonempty H]`) iff some public
  function `g : L → O` has its graph inside `SpecOf f` for every secret.
-/

namespace Toy.Hyper

universe u v w z

/-- The trace-set specification generated by a choice-parameterized
presentation `f : L → H → C → O`: a trace `(l, h, o)` is allowed iff there
exists some choice `c : C` with `o = f l h c`. Distinct presentations `f₁, f₂`
can denote the exact same trace set (see `specOf_xor_eq_specOf_constLow`). -/
def SpecOf {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) : System (IOTrace L H O) :=
  fun t => ∃ c : C, t.lowOut = f t.lowIn t.highIn c

/-- Resolving the nondeterministic choice of presentation `f` with a (possibly
secret-dependent) choice function `r : L → H → C`, yielding a deterministic,
input-total trace-inclusion refinement of `SpecOf f`. -/
def determinize {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) (r : L → H → C) : System (IOTrace L H O) :=
  ofFn (fun l h => f l h (r l h))

/-- Resolving the nondeterministic choice of presentation `f` with a
secret-independent choice function `g : L → C` depending only on `lowIn`. -/
def secretIndepDeterminize {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) (g : L → C) : System (IOTrace L H O) :=
  determinize f (fun l _ => g l)

/-! ## Concrete Presentations and Definition Examples -/

/-- One-time-pad-style presentation `out = xor highIn c` of `fullIOSystem` on a
single secret bit and a single nondeterministic choice bit. -/
def xorSpecFn : Unit → Bool → Bool → Bool :=
  fun _ h c => xor h c

/-- Always-leaking presentation `out = highIn` ignoring the choice `c`. -/
def leakSpecFn : Unit → Bool → Unit → Bool :=
  fun _ h _ => h

/-- Secret-independent choice presentation `out = c` of `fullIOSystem` ignoring
`highIn`. -/
def constLowSpecFn : Unit → Bool → Bool → Bool :=
  fun _ _ c => c

/-- Non-`GNI` presentation `out = c && highIn` (`out ∈ {false, highIn}`):
violates `GNI` (since `true` is achievable only when `highIn = true`), yet
admits a deterministic `GNI` refinement via `c = false`. -/
def falseOrHighFn : Unit → Bool → Bool → Bool :=
  fun _ h c => c && h

/-- Non-empty partial deterministic refinement of `SpecOf leakSpecFn` that only
accepts `highIn = false`. -/
def singleFalseTraceSystem : System (IOTrace Unit Bool Bool) :=
  fun t => t = ⟨(), false, false⟩

/-- Presentation with an empty choice space (so `SpecOf emptyChoiceSpecFn` is
empty and not input-total). -/
def emptyChoiceSpecFn : Unit → Bool → Empty → Bool :=
  fun _ _ c => c.elim

/-- Positive example for `SpecOf`: `((), true, false)` is allowed by
`SpecOf xorSpecFn` via choice `c = true`. -/
theorem specOf_pos_example : SpecOf xorSpecFn ⟨(), true, false⟩ :=
  ⟨true, rfl⟩

/-- Negative example for `SpecOf`: `((), true, false)` is rejected by
`SpecOf leakSpecFn`. -/
theorem specOf_neg_example : ¬ SpecOf leakSpecFn ⟨(), true, false⟩ := by
  intro ⟨_, h⟩
  cases h

/-- Positive example for `determinize`: resolving `xorSpecFn` with `r _ h = h`
produces `false` on `highIn = true`. -/
theorem determinize_pos_example :
    determinize xorSpecFn (fun _ h => h) ⟨(), true, false⟩ :=
  rfl

/-- Negative example for `determinize`: resolving `xorSpecFn` with `r _ h = h`
never produces `true` on `highIn = true`. -/
theorem determinize_neg_example :
    ¬ determinize xorSpecFn (fun _ h => h) ⟨(), true, true⟩ := by
  intro h
  cases h

/-- Positive example for `secretIndepDeterminize`: fixing `g _ = false` on
`xorSpecFn` produces `true` on `highIn = true`. -/
theorem secretIndepDeterminize_pos_example :
    secretIndepDeterminize xorSpecFn (fun _ => false) ⟨(), true, true⟩ :=
  rfl

/-- Negative example for `secretIndepDeterminize`: fixing `g _ = false` on
`xorSpecFn` rejects output `false` on `highIn = true`. -/
theorem secretIndepDeterminize_neg_example :
    ¬ secretIndepDeterminize xorSpecFn (fun _ => false) ⟨(), true, false⟩ := by
  intro h
  cases h

/-! ## Structural Lemmas for `determinize` and Choice Presentations -/

theorem determinize_refines_specOf
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) (r : L → H → C) :
    Refines (determinize f r) (SpecOf f) := by
  intro t ht
  exact ⟨r t.lowIn t.highIn, ht⟩

theorem determinize_deterministic
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) (r : L → H → C) :
    Deterministic (determinize f r) := by
  intro t₁ t₂ ht₁ ht₂ hLo hHi
  change t₁.lowOut = f t₁.lowIn t₁.highIn (r t₁.lowIn t₁.highIn) at ht₁
  change t₂.lowOut = f t₂.lowIn t₂.highIn (r t₂.lowIn t₂.highIn) at ht₂
  rw [ht₁, ht₂, hLo, hHi]

theorem determinize_inputTotal
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) (r : L → H → C) :
    InputTotal (determinize f r) := by
  intro l h
  exact ⟨f l h (r l h), rfl⟩

theorem secretIndepDeterminize_refines_specOf
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) (g : L → C) :
    Refines (secretIndepDeterminize f g) (SpecOf f) :=
  determinize_refines_specOf f (fun l _ => g l)

/-- `InputTotal (SpecOf f)` does not depend on `f`: it holds iff some choice
function `L → H → C` exists at all. -/
theorem inputTotal_specOf_iff_nonempty_choiceFn
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) :
    InputTotal (SpecOf f) ↔ Nonempty (L → H → C) := by
  constructor
  · intro hTot
    have hC : ∀ (_ : L) (_ : H), ∃ _c : C, True := by
      intro l h
      rcases hTot l h with ⟨_, c, _⟩
      exact ⟨c, trivial⟩
    exact ⟨fun l h => Classical.choose (hC l h)⟩
  · rintro ⟨r⟩ l h
    exact ⟨f l h (r l h), r l h, rfl⟩

/-! ## Presentation-Dependence Boundary Theorems for `xorSpecFn` -/

/-- `SpecOf xorSpecFn` denotes the exact same trace set as `fullIOSystem`. -/
theorem specOf_xor_eq_full : SpecOf xorSpecFn = fullIOSystem := by
  funext t
  apply propext
  constructor
  · intro _; trivial
  · intro _
    refine ⟨xor t.highIn t.lowOut, ?_⟩
    show t.lowOut = xor t.highIn (xor t.highIn t.lowOut)
    cases t.highIn <;> cases t.lowOut <;> rfl

/-- `SpecOf constLowSpecFn` also denotes `fullIOSystem`. -/
theorem specOf_constLow_eq_full : SpecOf constLowSpecFn = fullIOSystem := by
  funext t
  apply propext
  constructor
  · intro _; trivial
  · intro _; exact ⟨t.lowOut, rfl⟩

/-- `xorSpecFn` and `constLowSpecFn` are two distinct choice presentations of
the exact same trace-set specification. -/
theorem specOf_xor_eq_specOf_constLow : SpecOf xorSpecFn = SpecOf constLowSpecFn :=
  specOf_xor_eq_full.trans specOf_constLow_eq_full.symm

/-- The refinement-paradox counterexample `leakHighSystem` coincides with the
secret-independent determinization `g _ = false` of `xorSpecFn`. -/
theorem leakHigh_eq_secretIndep_xor :
    leakHighSystem = secretIndepDeterminize xorSpecFn (fun _ => false) := by
  funext t
  apply propext
  show (t.lowOut = t.highIn) ↔ (t.lowOut = xor t.highIn false)
  cases t.highIn <;> exact Iff.rfl

/-- The exact same leaking system `leakHighSystem` is a secret-dependent
determinization of `constLowSpecFn`. -/
theorem leakHigh_eq_secretDep_constLow :
    leakHighSystem = determinize constLowSpecFn (fun _ h => h) :=
  rfl

/-- The "secret-dependent" secure determinization `r _ h = h` of `xorSpecFn` is
extensionally equal to the constant-false system `constFalseIOSystem`. -/
theorem xor_secretDependent_determinization_eq_constFalse :
    determinize xorSpecFn (fun _ h => h) = constFalseIOSystem := by
  funext t
  apply propext
  show (t.lowOut = xor t.highIn t.highIn) ↔ (t.lowOut = false)
  cases t.highIn <;> exact Iff.rfl

/-- The secret-independent determinization `r _ _ = false` of `constLowSpecFn`
is also `constFalseIOSystem`. -/
theorem constLow_secretIndependent_determinization_eq_constFalse :
    determinize constLowSpecFn (fun _ _ => false) = constFalseIOSystem :=
  rfl

/-- The secure system obtained by secret-dependent choice `r _ h = h` on
`xorSpecFn` is literally identical to the one obtained by secret-independent
choice `r _ _ = false` on `constLowSpecFn`. -/
theorem same_secure_refinement_two_presentations :
    determinize xorSpecFn (fun _ h => h) = determinize constLowSpecFn (fun _ _ => false) :=
  xor_secretDependent_determinization_eq_constFalse.trans
    constLow_secretIndependent_determinization_eq_constFalse.symm

/-- Every `GNI`-satisfying determinization of `xorSpecFn` is a constant system
`ofFn (fun _ _ => b)`: its observable behavior does not depend on `highIn` at
all, even though the choice index `r` relative to `xorSpecFn` does. -/
theorem xor_gni_determinization_is_constant
    (r : Unit → Bool → Bool) (hGNI : GNI (determinize xorSpecFn r)) :
    ∃ b : Bool, determinize xorSpecFn r = ofFn (fun _ _ => b) := by
  have h0 : determinize xorSpecFn r ⟨(), false, xor false (r () false)⟩ := rfl
  have h1 : determinize xorSpecFn r ⟨(), true, xor true (r () true)⟩ := rfl
  rcases hGNI ⟨(), false, xor false (r () false)⟩ ⟨(), true, xor true (r () true)⟩ h0 h1 with
    ⟨t₃, hS₃, hHi, _, hOut⟩
  have hS₃' : t₃.lowOut = xor t₃.highIn (r () t₃.highIn) := hS₃
  rw [hOut, hHi] at hS₃'
  have hKey : xor true (r () true) = xor false (r () false) := hS₃'
  refine ⟨xor false (r () false), ?_⟩
  funext t
  apply propext
  show (t.lowOut = xor t.highIn (r () t.highIn)) ↔ (t.lowOut = xor false (r () false))
  cases hh : t.highIn
  · exact Iff.rfl
  · rw [hKey]

/-! ## Secret-Independent Choice Failure on the XOR Presentation -/

/-- On the XOR choice presentation `xorSpecFn (_ h c => xor h c)`,
`SpecOf xorSpecFn` (which equals `fullIOSystem`) satisfies `GNI` and
`InputTotal`, yet *every* secret-independent choice function `g : Unit → Bool`
yields a deterministic, input-total refinement (`lowOut = highIn` or
`lowOut = !highIn`) that violates `GNI`. -/
theorem secretIndepDeterminize_fails_gni_on_xorPresentation :
    GNI (SpecOf xorSpecFn) ∧
    InputTotal (SpecOf xorSpecFn) ∧
    (∀ g : Unit → Bool,
      Refines (secretIndepDeterminize xorSpecFn g) (SpecOf xorSpecFn) ∧
      Deterministic (secretIndepDeterminize xorSpecFn g) ∧
      InputTotal (secretIndepDeterminize xorSpecFn g) ∧
      ¬ GNI (secretIndepDeterminize xorSpecFn g)) := by
  refine ⟨?_, ?_, ?_⟩
  · intro t₁ t₂ _ _
    refine ⟨⟨t₂.lowIn, t₁.highIn, t₂.lowOut⟩, ?_, rfl, rfl, rfl⟩
    refine ⟨xor t₁.highIn t₂.lowOut, ?_⟩
    cases t₁.highIn <;> cases t₂.lowOut <;> rfl
  · intro _ h
    exact ⟨h, false, by cases h <;> rfl⟩
  · intro g
    refine ⟨secretIndepDeterminize_refines_specOf xorSpecFn g,
      determinize_deterministic xorSpecFn (fun l _ => g l),
      determinize_inputTotal xorSpecFn (fun l _ => g l), ?_⟩
    intro hGNI
    have h0 : secretIndepDeterminize xorSpecFn g ⟨(), false, xor false (g ())⟩ := rfl
    have h1 : secretIndepDeterminize xorSpecFn g ⟨(), true, xor true (g ())⟩ := rfl
    rcases hGNI ⟨(), false, xor false (g ())⟩ ⟨(), true, xor true (g ())⟩ h0 h1 with
      ⟨t₃, hS₃, hHi, _, hOut⟩
    change t₃.lowOut = xor t₃.highIn (g t₃.lowIn) at hS₃
    rw [hOut, hHi] at hS₃
    cases hG : g () <;> simp [hG] at hS₃

/-- Corollary (equivalent restatement of the last conjunct of
`secretIndepDeterminize_fails_gni_on_xorPresentation`): on the presentation
`xorSpecFn`, every choice function `r : Unit → Bool → Bool` whose
determinization satisfies `GNI` fails `SecretIndependent r`. This constrains
the choice index `r` relative to `xorSpecFn`, not the resulting system (which
is constant by `xor_gni_determinization_is_constant`). -/
theorem xorPresentation_gni_choice_not_secretIndependent
    (r : Unit → Bool → Bool)
    (hGNI : GNI (determinize xorSpecFn r)) :
    ¬ SecretIndependent r := by
  intro hSI
  have hr : r = fun l _ => r l false := by
    funext l h
    exact hSI l h false
  have hEq : determinize xorSpecFn (fun l _ => r l false) = determinize xorSpecFn r :=
    congrArg (determinize xorSpecFn) hr.symm
  apply (secretIndepDeterminize_fails_gni_on_xorPresentation.2.2 (fun l => r l false)).2.2.2
  show GNI (determinize xorSpecFn (fun l _ => r l false))
  rw [hEq]
  exact hGNI

/-- Non-vacuity witness for `xorPresentation_gni_choice_not_secretIndependent`:
`r _ h = h` satisfies `GNI (determinize xorSpecFn r)`. -/
theorem xorPresentation_gni_choice_nonvacuity :
    GNI (determinize xorSpecFn (fun _ h => h)) := by
  intro t₁ t₂ _ ht₂
  change t₂.lowOut = xor t₂.highIn t₂.highIn at ht₂
  refine ⟨⟨t₂.lowIn, t₁.highIn, t₂.lowOut⟩, ?_, rfl, rfl, rfl⟩
  change t₂.lowOut = xor t₁.highIn t₁.highIn
  rw [ht₂]
  cases t₁.highIn <;> cases t₂.highIn <;> rfl

/-- Tightness counterexample for `hGNI` in
`xorPresentation_gni_choice_not_secretIndependent`: `r _ _ = false` violates
`GNI` and is `SecretIndependent`. -/
theorem xorPresentation_gni_choice_counterexample_no_gni :
    ¬ GNI (determinize xorSpecFn (fun _ _ => false)) ∧
    SecretIndependent (fun (_ : Unit) (_ : Bool) => false) :=
  ⟨(secretIndepDeterminize_fails_gni_on_xorPresentation.2.2 (fun _ => false)).2.2.2,
   fun _ _ _ => rfl⟩

/-- Positive control (same trace set, alternative presentation): presenting the
exact same trace set `fullIOSystem` as `constLowSpecFn (_ _ c => c)` admits a
secret-independent choice function `r _ _ = false` yielding a `GNI`-satisfying
refinement (literally `constFalseIOSystem`). -/
theorem constLowPresentation_admits_secretIndep_gni_choice :
    SpecOf constLowSpecFn = SpecOf xorSpecFn ∧
    GNI (SpecOf constLowSpecFn) ∧
    SecretIndependent (fun (_ : Unit) (_ : Bool) => false) ∧
    Refines (determinize constLowSpecFn (fun _ _ => false)) (SpecOf constLowSpecFn) ∧
    GNI (determinize constLowSpecFn (fun _ _ => false)) := by
  refine ⟨specOf_xor_eq_specOf_constLow.symm, ?_, fun _ _ _ => rfl,
    determinize_refines_specOf constLowSpecFn _, ?_⟩
  · intro t₁ t₂ _ _
    exact ⟨⟨t₂.lowIn, t₁.highIn, t₂.lowOut⟩, ⟨t₂.lowOut, rfl⟩, rfl, rfl, rfl⟩
  · intro t₁ t₂ _ ht₂
    change t₂.lowOut = false at ht₂
    exact ⟨⟨t₂.lowIn, t₁.highIn, t₂.lowOut⟩, ht₂, rfl, rfl, rfl⟩

/-- Positive control (same XOR presentation, secret-dependent choice): allowing
the choice index on `xorSpecFn` to depend on `highIn` (`r _ h = h`) yields a
deterministic, input-total, `GNI`-satisfying refinement (again equal to
`constFalseIOSystem`). -/
theorem xorPresentation_admits_secretDependent_gni_choice :
    Refines (determinize xorSpecFn (fun _ h => h)) (SpecOf xorSpecFn) ∧
    Deterministic (determinize xorSpecFn (fun _ h => h)) ∧
    InputTotal (determinize xorSpecFn (fun _ h => h)) ∧
    GNI (determinize xorSpecFn (fun _ h => h)) :=
  ⟨determinize_refines_specOf xorSpecFn (fun _ h => h),
   determinize_deterministic xorSpecFn (fun _ h => h),
   determinize_inputTotal xorSpecFn (fun _ h => h),
   xorPresentation_gni_choice_nonvacuity⟩

/-- Summary boundary theorem: secret-dependence of the choice function is a
property of the presentation `f`, not of the trace-set specification `SpecOf f`. -/
theorem secret_dependence_is_presentation_dependent :
    SpecOf xorSpecFn = SpecOf constLowSpecFn ∧
    (∀ r : Unit → Bool → Bool, GNI (determinize xorSpecFn r) → ¬ SecretIndependent r) ∧
    (∃ r : Unit → Bool → Bool, SecretIndependent r ∧ GNI (determinize constLowSpecFn r)) :=
  ⟨specOf_xor_eq_specOf_constLow,
   xorPresentation_gni_choice_not_secretIndependent,
   ⟨fun _ _ => false, fun _ _ _ => rfl,
    constLowPresentation_admits_secretIndep_gni_choice.2.2.2.2⟩⟩

/-! ## `GNI` vs. `ObsDet` on Deterministic Implementations -/

/-- Hypothesis-free exact characterization for arbitrary (possibly partial)
single-step systems: `GNI S ∧ Deterministic S` holds iff
`ObsDet S ∧ RectangularDomain S` holds. The three minimal-hypothesis
directional implications are `gni_imp_rectangularDomain`,
`obsDet_of_gni_of_deterministic`, and `gni_of_obsDet_of_rectangularDomain`
(together with `obsDet_imp_deterministic`). -/
theorem gni_and_deterministic_iff_obsDet_and_rectangularDomain
    {L : Type u} {H : Type v} {O : Type w}
    (S : System (IOTrace L H O)) :
    GNI S ∧ Deterministic S ↔ ObsDet S ∧ RectangularDomain S := by
  exact ⟨fun ⟨hG, hD⟩ => ⟨obsDet_of_gni_of_deterministic hD hG, gni_imp_rectangularDomain hG⟩,
    fun ⟨hO, hR⟩ => ⟨gni_of_obsDet_of_rectangularDomain hO hR, obsDet_imp_deterministic hO⟩⟩

/-- Conditional corollary of `gni_and_deterministic_iff_obsDet_and_rectangularDomain`:
for any functionally deterministic system `S`, `GNI S ↔ ObsDet S ∧ RectangularDomain S`. -/
theorem gni_iff_obsDet_and_rectangularDomain_of_deterministic
    {L : Type u} {H : Type v} {O : Type w}
    {S : System (IOTrace L H O)}
    (hDet : Deterministic S) :
    GNI S ↔ ObsDet S ∧ RectangularDomain S := by
  exact ⟨fun hG => ⟨obsDet_of_gni_of_deterministic hDet hG, gni_imp_rectangularDomain hG⟩,
    fun ⟨hO, hR⟩ => gni_of_obsDet_of_rectangularDomain hO hR⟩

/-- Equivalence between the hypothesis-free form and the conditional form
(using `obsDet_imp_deterministic`). -/
theorem gni_and_det_iff_equiv_conditional
    {L : Type u} {H : Type v} {O : Type w}
    (S : System (IOTrace L H O)) :
    (Deterministic S → (GNI S ↔ ObsDet S ∧ RectangularDomain S)) ↔
    (GNI S ∧ Deterministic S ↔ ObsDet S ∧ RectangularDomain S) := by
  constructor
  · intro h
    exact ⟨fun hg => (h hg.2).mp hg.1,
      fun ho => ⟨(h (obsDet_imp_deterministic ho.1)).mpr ho, obsDet_imp_deterministic ho.1⟩⟩
  · intro h hDet
    exact ⟨fun hg => h.mp ⟨hg, hDet⟩, fun ho => (h.mpr ho).1⟩

/-- Non-vacuity witnesses for `gni_and_deterministic_iff_obsDet_and_rectangularDomain`
(and its conditional corollary) on genuinely **partial** deterministic systems:
`echoLowHighFalseSystem` satisfies both sides while failing `InputTotal`, and
`diagonalPartialSystem` is deterministic and refutes both sides. -/
theorem gni_obsDet_rectangularDomain_nonvacuity :
    (Deterministic echoLowHighFalseSystem ∧
      ¬ InputTotal echoLowHighFalseSystem ∧
      (GNI echoLowHighFalseSystem ∧ Deterministic echoLowHighFalseSystem) ∧
      (ObsDet echoLowHighFalseSystem ∧ RectangularDomain echoLowHighFalseSystem)) ∧
    (Deterministic diagonalPartialSystem ∧
      ¬ InputTotal diagonalPartialSystem ∧
      ¬ (GNI diagonalPartialSystem ∧ Deterministic diagonalPartialSystem) ∧
      ¬ (ObsDet diagonalPartialSystem ∧ RectangularDomain diagonalPartialSystem)) := by
  have hE := gni_and_rectangularDomain_allow_secret_filtered_acceptance
  have hDetDiag : Deterministic diagonalPartialSystem := by
    intro t₁ t₂ ht₁ ht₂ _ _
    exact ht₁.2.trans ht₂.2.symm
  have hNotTotDiag : ¬ InputTotal diagonalPartialSystem := by
    intro hTot
    rcases hTot true false with ⟨_, hEq, _⟩
    cases hEq
  have hNotGniDiag : ¬ GNI diagonalPartialSystem := fun hG =>
    rectangularDomain_neg_example (gni_imp_rectangularDomain hG)
  exact ⟨⟨hE.1, hE.2.2.2.2.1, ⟨hE.2.2.2.1, hE.1⟩, ⟨hE.2.1, hE.2.2.1⟩⟩,
    ⟨hDetDiag, hNotTotDiag, fun h => hNotGniDiag h.1, fun h => rectangularDomain_neg_example h.2⟩⟩

/-- Tightness witness for `Deterministic S` in
`gni_iff_obsDet_and_rectangularDomain_of_deterministic` (and showing
`Deterministic S` cannot be omitted from the left-hand side of
`gni_and_deterministic_iff_obsDet_and_rectangularDomain`): `fullIOSystem` is
nondeterministic, satisfies `GNI`, and violates `ObsDet ∧ RectangularDomain`. -/
theorem gni_obsDet_rectangularDomain_counterexample_no_det :
    ¬ Deterministic fullIOSystem ∧
    GNI fullIOSystem ∧
    ¬ (ObsDet fullIOSystem ∧ RectangularDomain fullIOSystem) := by
  refine ⟨deterministic_neg_example, gni_pos_example, ?_⟩
  intro ⟨hOD, _⟩
  have hEq := hOD ⟨(), false, false⟩ ⟨(), false, true⟩ trivial trivial rfl
  cases hEq

/-- Corollary under `AcceptanceIgnoresHigh` (strictly weaker than `InputTotal`):
for any deterministic system whose acceptance ignores `highIn`, `GNI S ↔ ObsDet S`. -/
theorem gni_iff_obsDet_of_deterministic_acceptanceIgnoresHigh
    {L : Type u} {H : Type v} {O : Type w}
    {S : System (IOTrace L H O)}
    (hDet : Deterministic S) (hA : AcceptanceIgnoresHigh S) :
    GNI S ↔ ObsDet S := by
  exact ⟨obsDet_of_gni_of_deterministic hDet,
    fun hO => gni_of_obsDet_of_rectangularDomain hO (acceptanceIgnoresHigh_imp_rectangularDomain hA)⟩

/-- Corollary for total deterministic implementations: for any deterministic,
input-total single-step system `S`, generalized noninterference is equivalent
to observational determinism. -/
theorem gni_iff_obsDet_of_deterministic_inputTotal
    {L : Type u} {H : Type v} {O : Type w}
    {S : System (IOTrace L H O)}
    (hDet : Deterministic S) (hTot : InputTotal S) :
    GNI S ↔ ObsDet S := by
  exact ⟨obsDet_of_gni_of_deterministic hDet,
    fun hO => gni_of_obsDet_of_rectangularDomain hO (inputTotal_imp_rectangularDomain hTot)⟩

/-- Non-vacuity witnesses for `gni_iff_obsDet_of_deterministic_inputTotal`:
`echoLowSystem` is deterministic and input-total with both sides true
(`GNI`, `ObsDet`, `RectangularDomain`), while `leakHighSystem` is deterministic
and input-total with both sides false (`¬ GNI`, `¬ ObsDet`). -/
theorem gni_obsDet_total_nonvacuity :
    (Deterministic echoLowSystem ∧
      InputTotal echoLowSystem ∧
      GNI echoLowSystem ∧
      ObsDet echoLowSystem ∧
      RectangularDomain echoLowSystem) ∧
    (Deterministic leakHighSystem ∧
      InputTotal leakHighSystem ∧
      ¬ GNI leakHighSystem ∧
      ¬ ObsDet leakHighSystem) := by
  have hDetE : Deterministic echoLowSystem := obsDet_imp_deterministic obsDet_pos_example
  have hTotE : InputTotal echoLowSystem := fun l _ => ⟨l, rfl⟩
  have hDomE : RectangularDomain echoLowSystem := inputTotal_imp_rectangularDomain hTotE
  have hGniE : GNI echoLowSystem := gni_of_obsDet_of_rectangularDomain obsDet_pos_example hDomE
  exact ⟨⟨hDetE, hTotE, hGniE, obsDet_pos_example, hDomE⟩,
    ⟨deterministic_pos_example, inputTotal_pos_example, gni_neg_example, obsDet_neg_example⟩⟩

/-- Tightness counterexample for `hDet` in
`gni_iff_obsDet_of_deterministic_inputTotal`: `fullIOSystem` is input-total,
fails `Deterministic`, satisfies `GNI`, and violates `ObsDet`. -/
theorem gni_obsDet_total_counterexample_no_det :
    InputTotal fullIOSystem ∧
    ¬ Deterministic fullIOSystem ∧
    GNI fullIOSystem ∧
    ¬ ObsDet fullIOSystem := by
  refine ⟨fun _ _ => ⟨false, trivial⟩, deterministic_neg_example, gni_pos_example, ?_⟩
  intro hOD
  have hEq := hOD ⟨(), false, false⟩ ⟨(), false, true⟩ trivial trivial rfl
  cases hEq

/-- Tightness counterexample for `hTot` in
`gni_iff_obsDet_of_deterministic_inputTotal`: `diagonalPartialSystem` is
deterministic, fails `InputTotal` (acceptance depends jointly on `lowIn` and
`highIn`), satisfies `ObsDet`, and violates `GNI`. -/
theorem gni_obsDet_total_counterexample_no_inputTotal :
    Deterministic diagonalPartialSystem ∧
    ¬ InputTotal diagonalPartialSystem ∧
    ObsDet diagonalPartialSystem ∧
    ¬ GNI diagonalPartialSystem := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro t₁ t₂ ht₁ ht₂ _ _
    exact ht₁.2.trans ht₂.2.symm
  · intro hTot
    rcases hTot true false with ⟨_, hEq, _⟩
    cases hEq
  · intro t₁ t₂ ht₁ ht₂ _
    exact ht₁.2.trans ht₂.2.symm
  · intro hGNI
    exact rectangularDomain_neg_example (gni_imp_rectangularDomain hGNI)

/-! ## Function-Graph Characterization (`ofFn` and `determinize`) -/

/-- For a total function `g : L → H → O`, `ObsDet (ofFn g)` is equivalent to
`SecretIndependent g`. -/
theorem obsDet_ofFn_iff_secretIndependent
    {L : Type u} {H : Type v} {O : Type w}
    (g : L → H → O) :
    ObsDet (ofFn g) ↔ SecretIndependent g := by
  constructor
  · intro hOD l h₁ h₂
    exact hOD ⟨l, h₁, g l h₁⟩ ⟨l, h₂, g l h₂⟩ rfl rfl rfl
  · intro hSI t₁ t₂ h₁ h₂ hLo
    change t₁.lowOut = g t₁.lowIn t₁.highIn at h₁
    change t₂.lowOut = g t₂.lowIn t₂.highIn at h₂
    rw [h₁, h₂, hLo]
    exact hSI _ _ _

/-- Function-graph characterization (corollary of
`gni_iff_obsDet_of_deterministic_inputTotal` for `ofFn g`): the graph of a
total function `g : L → H → O` satisfies `GNI` iff `g` is independent of
`highIn`. -/
theorem gni_ofFn_iff_secretIndependent
    {L : Type u} {H : Type v} {O : Type w}
    (g : L → H → O) :
    GNI (ofFn g) ↔ SecretIndependent g := by
  have hDet : Deterministic (ofFn g) := by
    intro t₁ t₂ h₁ h₂ hL hH
    change t₁.lowOut = g t₁.lowIn t₁.highIn at h₁
    change t₂.lowOut = g t₂.lowIn t₂.highIn at h₂
    rw [h₁, h₂, hL, hH]
  have hTot : InputTotal (ofFn g) := fun l h => ⟨g l h, rfl⟩
  exact (gni_iff_obsDet_of_deterministic_inputTotal hDet hTot).trans
    (obsDet_ofFn_iff_secretIndependent g)

/-- Non-vacuity witness for `gni_ofFn_iff_secretIndependent`: both sides hold
for `fun (l : Bool) (_ : Bool) => l` (`echoLowSystem`) and both sides fail for
`fun (_ : Unit) (h : Bool) => h` (`leakHighSystem`). -/
theorem gni_ofFn_iff_secretIndependent_nonvacuity :
    (GNI (ofFn (fun (l : Bool) (_ : Bool) => l)) ∧
      SecretIndependent (fun (l : Bool) (_ : Bool) => l)) ∧
    (¬ GNI (ofFn (fun (_ : Unit) (h : Bool) => h)) ∧
      ¬ SecretIndependent (fun (_ : Unit) (h : Bool) => h)) :=
  ⟨⟨gni_obsDet_total_nonvacuity.1.2.2.1, secretIndependent_pos_example⟩,
   ⟨gni_neg_example, secretIndependent_neg_example⟩⟩

/-- Instance of `gni_ofFn_iff_secretIndependent` for `determinize f r`:
`determinize f r` satisfies `GNI` iff the **resolved output**
`fun l h => f l h (r l h)` is secret-independent (not `r` itself). -/
theorem determinize_gni_iff_resolvedOutput_secretIndependent
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) (r : L → H → C) :
    GNI (determinize f r) ↔ SecretIndependent (fun l h => f l h (r l h)) :=
  gni_ofFn_iff_secretIndependent (fun l h => f l h (r l h))

/-- Instance of `gni_ofFn_iff_secretIndependent` for `secretIndepDeterminize f g`:
`secretIndepDeterminize f g` satisfies `GNI` iff `fun l h => f l h (g l)` is
secret-independent. -/
theorem secretIndepDeterminize_gni_iff_resolvedOutput_secretIndependent
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) (g : L → C) :
    GNI (secretIndepDeterminize f g) ↔ SecretIndependent (fun l h => f l h (g l)) :=
  gni_ofFn_iff_secretIndependent (fun l h => f l h (g l))

/-! ## Existence of Input-Total `GNI` Refinements and Presentation-Free Equivalents -/

/-- Minimal existence characterization (without `Deterministic S'`): for any
choice presentation `f : L → H → C → O`, `SpecOf f` admits an input-total `GNI`
refinement `S'` (deterministic or nondeterministic) iff there exists a choice
function `r : L → H → C` making the resolved output `fun l h => f l h (r l h)`
secret-independent. Requiring `S'` to be deterministic adds no constraint in
this single-step model (see `exists_inputTotal_gni_refinement_iff_det`). -/
theorem exists_inputTotal_gni_refinement_iff_exists_choice
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) :
    (∃ S' : System (IOTrace L H O),
      Refines S' (SpecOf f) ∧ InputTotal S' ∧ GNI S') ↔
    (∃ r : L → H → C, SecretIndependent (fun l h => f l h (r l h))) := by
  constructor
  · rintro ⟨S', hRef, hTot, hGNI⟩
    by_cases hH : Nonempty H
    · rcases hH with ⟨h₀⟩
      have hGNI' := (gni_iff_low_view_compatible_with_every_secret S').1 hGNI
      let o₀ : L → O := fun l => Classical.choose (hTot l h₀)
      have ho₀ : ∀ l, S' ⟨l, h₀, o₀ l⟩ := fun l => Classical.choose_spec (hTot l h₀)
      have hc : ∀ l h, ∃ c, o₀ l = f l h c := by
        intro l h
        rcases hTot l h with ⟨o, ho⟩
        exact hRef _ (hGNI' ⟨l, h, o⟩ ⟨l, h₀, o₀ l⟩ ho (ho₀ l))
      refine ⟨fun l h => Classical.choose (hc l h), fun l h₁ h₂ => ?_⟩
      show f l h₁ (Classical.choose (hc l h₁)) = f l h₂ (Classical.choose (hc l h₂))
      rw [← Classical.choose_spec (hc l h₁), ← Classical.choose_spec (hc l h₂)]
    · exact ⟨fun _ h => False.elim (hH ⟨h⟩), fun _ h _ => False.elim (hH ⟨h⟩)⟩
  · rintro ⟨r, hSI⟩
    exact ⟨determinize f r, determinize_refines_specOf f r, determinize_inputTotal f r,
      (gni_ofFn_iff_secretIndependent (fun l h => f l h (r l h))).2 hSI⟩

/-- Deterministic corollary of `exists_inputTotal_gni_refinement_iff_exists_choice`:
`SpecOf f` admits a deterministic, input-total `GNI` refinement iff such a
choice function `r` exists. -/
theorem exists_det_inputTotal_gni_refinement_iff
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) :
    (∃ S' : System (IOTrace L H O),
      Refines S' (SpecOf f) ∧ Deterministic S' ∧ InputTotal S' ∧ GNI S') ↔
    (∃ r : L → H → C, SecretIndependent (fun l h => f l h (r l h))) := by
  constructor
  · rintro ⟨S', hRef, _, hTot, hGNI⟩
    exact (exists_inputTotal_gni_refinement_iff_exists_choice f).1 ⟨S', hRef, hTot, hGNI⟩
  · rintro ⟨r, hSI⟩
    exact ⟨determinize f r, determinize_refines_specOf f r, determinize_deterministic f r,
      determinize_inputTotal f r,
      (gni_ofFn_iff_secretIndependent (fun l h => f l h (r l h))).2 hSI⟩

/-- Determinism is free for single-step input-total `GNI` refinements:
`SpecOf f` admits a deterministic input-total `GNI` refinement iff it admits
*any* input-total `GNI` refinement. -/
theorem exists_inputTotal_gni_refinement_iff_det
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) :
    (∃ S' : System (IOTrace L H O),
      Refines S' (SpecOf f) ∧ Deterministic S' ∧ InputTotal S' ∧ GNI S') ↔
    (∃ S' : System (IOTrace L H O),
      Refines S' (SpecOf f) ∧ InputTotal S' ∧ GNI S') :=
  (exists_det_inputTotal_gni_refinement_iff f).trans
    (exists_inputTotal_gni_refinement_iff_exists_choice f).symm

/-- Choice-free reading of the right-hand side of
`exists_inputTotal_gni_refinement_iff_exists_choice` (no `[Nonempty H]` needed):
for every `l` and witness secret `_h₀ : H`, the per-secret output sets
`{f l h c | c}` share a common element `o`. -/
theorem exists_choice_iff_common_output
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O) :
    (∃ r : L → H → C, SecretIndependent (fun l h => f l h (r l h))) ↔
    (∀ l, ∀ _h₀ : H, ∃ o, ∀ h, ∃ c, f l h c = o) := by
  constructor
  · rintro ⟨r, hSI⟩ l h₀
    exact ⟨f l h₀ (r l h₀), fun h => ⟨r l h, hSI l h h₀⟩⟩
  · intro hC
    by_cases hH : Nonempty H
    · rcases hH with ⟨h₀⟩
      have hEx : ∀ l h, ∃ c, f l h c = Classical.choose (hC l h₀) :=
        fun l h => Classical.choose_spec (hC l h₀) h
      refine ⟨fun l h => Classical.choose (hEx l h), ?_⟩
      intro l h₁ h₂
      show f l h₁ (Classical.choose (hEx l h₁)) = f l h₂ (Classical.choose (hEx l h₂))
      rw [Classical.choose_spec (hEx l h₁), Classical.choose_spec (hEx l h₂)]
    · exact ⟨fun _ h => False.elim (hH ⟨h⟩), fun _ h _ => False.elim (hH ⟨h⟩)⟩

/-- Presentation-free trace-set reading (for nonempty secret type `H`):
there exists a choice function `r` making `f l h (r l h)` secret-independent
iff there exists a public-only function `g : L → O` whose graph lies inside
`SpecOf f` for every secret `h`. -/
theorem exists_choice_iff_exists_low_function
    {L : Type u} {H : Type v} {C : Type w} {O : Type z} [Nonempty H]
    (f : L → H → C → O) :
    (∃ r : L → H → C, SecretIndependent (fun l h => f l h (r l h))) ↔
    (∃ g : L → O, ∀ l h, SpecOf f ⟨l, h, g l⟩) := by
  constructor
  · rintro ⟨r, hSI⟩
    have h₀ : H := Classical.choice inferInstance
    refine ⟨fun l => f l h₀ (r l h₀), fun l h => ⟨r l h, ?_⟩⟩
    exact hSI l h₀ h
  · rintro ⟨g, hg⟩
    refine ⟨fun l h => Classical.choose (hg l h), fun l h₁ h₂ => ?_⟩
    have e₁ : g l = f l h₁ (Classical.choose (hg l h₁)) := Classical.choose_spec (hg l h₁)
    have e₂ : g l = f l h₂ (Classical.choose (hg l h₂)) := Classical.choose_spec (hg l h₂)
    exact e₁.symm.trans e₂

/-- Edge case showing `[Nonempty H]` is necessary in
`exists_choice_iff_exists_low_function`: when `H` and `O` are `Empty` and
`L = Unit`, a choice function `r` (and input-total `GNI` refinement) exists
vacuously, while no `g : Unit → Empty` exists. -/
theorem emptyHigh_no_low_function_edge_case :
    let f : Unit → Empty → Empty → Empty := fun _ h _ => h
    (∃ r : Unit → Empty → Empty, SecretIndependent (fun l h => f l h (r l h))) ∧
    ¬ (∃ g : Unit → Empty, ∀ l h, SpecOf f ⟨l, h, g l⟩) :=
  ⟨⟨fun _ h => h, fun _ h => h.elim⟩, fun ⟨g, _⟩ => (g ()).elim⟩

/-- Non-vacuity and refutation witnesses for
`exists_inputTotal_gni_refinement_iff_exists_choice`: `xorSpecFn` satisfies
both sides (via `determinize xorSpecFn (fun _ h => h)` and `r _ h = h`), while
`leakSpecFn` refutes both sides (admitting no input-total `GNI` refinement and
no choice function making the output secret-independent). -/
theorem exists_inputTotal_gni_refinement_nonvacuity :
    ((∃ S' : System (IOTrace Unit Bool Bool),
        Refines S' (SpecOf xorSpecFn) ∧ Deterministic S' ∧ InputTotal S' ∧ GNI S') ∧
      (∃ r : Unit → Bool → Bool,
        SecretIndependent (fun l h => xorSpecFn l h (r l h)))) ∧
    (¬ (∃ S' : System (IOTrace Unit Bool Bool),
        Refines S' (SpecOf leakSpecFn) ∧ InputTotal S' ∧ GNI S') ∧
      ¬ (∃ r : Unit → Bool → Unit,
        SecretIndependent (fun l h => leakSpecFn l h (r l h)))) := by
  refine ⟨⟨⟨determinize xorSpecFn (fun _ h => h),
      xorPresentation_admits_secretDependent_gni_choice⟩,
    ⟨fun _ h => h, fun _ h₁ h₂ => by cases h₁ <;> cases h₂ <;> rfl⟩⟩, ?_, ?_⟩
  · rintro ⟨S', hRef, hTot, hGNI⟩
    rcases hTot () false with ⟨o₀, h₀⟩
    rcases hTot () true with ⟨o₁, h₁⟩
    rcases hRef _ h₀ with ⟨_, ho₀⟩
    rcases hRef _ h₁ with ⟨_, ho₁⟩
    change o₀ = false at ho₀
    change o₁ = true at ho₁
    subst ho₀; subst ho₁
    rcases hGNI ⟨(), false, false⟩ ⟨(), true, true⟩ h₀ h₁ with ⟨t₃, hS₃, hHi, _, hOut⟩
    rcases hRef _ hS₃ with ⟨_, hEq⟩
    change t₃.lowOut = t₃.highIn at hEq
    rw [hOut, hHi] at hEq
    cases hEq
  · intro ⟨r, hSI⟩
    have hEq := hSI () false true
    cases hEq

/-- Boundary lemma: `InputTotal S'` cannot be dropped from the existential on
the left-hand side of `exists_inputTotal_gni_refinement_iff_exists_choice` or
`exists_det_inputTotal_gni_refinement_iff`, even if `S'` is required to be
nonempty. `singleFalseTraceSystem` is a nonempty deterministic `GNI` refinement
of `SpecOf leakSpecFn`, yet no choice function makes `leakSpecFn`
secret-independent. -/
theorem partial_det_gni_refinement_exists_without_choice :
    (∃ t, singleFalseTraceSystem t) ∧
    Refines singleFalseTraceSystem (SpecOf leakSpecFn) ∧
    Deterministic singleFalseTraceSystem ∧
    GNI singleFalseTraceSystem ∧
    ¬ InputTotal singleFalseTraceSystem ∧
    ¬ (∃ r : Unit → Bool → Unit,
      SecretIndependent (fun l h => leakSpecFn l h (r l h))) := by
  refine ⟨⟨⟨(), false, false⟩, rfl⟩, ?_, ?_, ?_, ?_, ?_⟩
  · intro t ht
    subst ht
    exact ⟨(), rfl⟩
  · intro t₁ t₂ ht₁ ht₂ _ _
    subst ht₁; subst ht₂; rfl
  · intro t₁ t₂ ht₁ ht₂
    subst ht₁; subst ht₂
    exact ⟨⟨(), false, false⟩, rfl, rfl, rfl, rfl⟩
  · intro hTot
    rcases hTot () true with ⟨_, ht⟩
    cases ht
  · intro ⟨r, hSI⟩
    have hEq := hSI () false true
    cases hEq

/-- Boundary lemma backing the non-claim that `GNI (SpecOf f)` is not necessary
for a deterministic `GNI` refinement to exist: `SpecOf falseOrHighFn` violates
`GNI` yet admits `determinize falseOrHighFn (fun _ _ => false)` (which is
`GNI` and uses a secret-independent choice). -/
theorem nonGNI_spec_with_secure_determinization :
    ¬ GNI (SpecOf falseOrHighFn) ∧
    Refines (determinize falseOrHighFn (fun _ _ => false)) (SpecOf falseOrHighFn) ∧
    Deterministic (determinize falseOrHighFn (fun _ _ => false)) ∧
    InputTotal (determinize falseOrHighFn (fun _ _ => false)) ∧
    GNI (determinize falseOrHighFn (fun _ _ => false)) ∧
    SecretIndependent (fun (_ : Unit) (_ : Bool) => false) := by
  refine ⟨?_, determinize_refines_specOf _ _, determinize_deterministic _ _,
    determinize_inputTotal _ _, ?_, fun _ _ _ => rfl⟩
  · intro hG
    have h1 : SpecOf falseOrHighFn ⟨(), false, false⟩ := ⟨false, rfl⟩
    have h2 : SpecOf falseOrHighFn ⟨(), true, true⟩ := ⟨true, rfl⟩
    rcases hG _ _ h1 h2 with ⟨t₃, ⟨c, hc⟩, hH, _, hO⟩
    rw [hO, hH] at hc
    cases c <;> simp [falseOrHighFn] at hc
  · intro t₁ t₂ _ h₂
    refine ⟨⟨t₂.lowIn, t₁.highIn, t₂.lowOut⟩, ?_, rfl, rfl, rfl⟩
    show t₂.lowOut = (false && t₁.highIn)
    have h₂' : t₂.lowOut = (false && t₂.highIn) := h₂
    rw [h₂']; rfl

/-! ## Existence Corollary for Input-Total `GNI` Presentations -/

/-- Single-step existence corollary (instance `S' := SpecOf f` of the forward
direction of `exists_inputTotal_gni_refinement_iff_exists_choice`): if
`SpecOf f` satisfies `GNI` and `InputTotal` (the latter is independent of `f`
and equivalent to `Nonempty (L → H → C)` by
`inputTotal_specOf_iff_nonempty_choiceFn`), then there exists a choice function
`r : L → H → C` such that `determinize f r` satisfies `GNI`. Every
`determinize f r` automatically satisfies `Refines`, `Deterministic`, and
`InputTotal` (`determinize_refines_specOf`, `determinize_deterministic`,
`determinize_inputTotal`). -/
theorem gni_inputTotal_spec_admits_det_gni_refinement
    {L : Type u} {H : Type v} {C : Type w} {O : Type z}
    (f : L → H → C → O)
    (hGNI : GNI (SpecOf f))
    (hTot : InputTotal (SpecOf f)) :
    ∃ r : L → H → C, GNI (determinize f r) := by
  by_cases hH : Nonempty H
  · rcases hH with ⟨h₀⟩
    have hEx : ∀ l h, ∃ c : C, f l h c = Classical.choose (hTot l h₀) := by
      intro l h
      have h₂ : SpecOf f ⟨l, h₀, Classical.choose (hTot l h₀)⟩ :=
        Classical.choose_spec (hTot l h₀)
      rcases hTot l h with ⟨o₁, h₁⟩
      rcases hGNI ⟨l, h, o₁⟩ ⟨l, h₀, Classical.choose (hTot l h₀)⟩ h₁ h₂ with
        ⟨t₃, ⟨c, hc⟩, hHi, hLo, hOut⟩
      rw [hOut, hLo, hHi] at hc
      exact ⟨c, hc.symm⟩
    let r : L → H → C := fun l h => Classical.choose (hEx l h)
    refine ⟨r, ?_⟩
    intro t₁ t₂ _ ht₂
    change t₂.lowOut = f t₂.lowIn t₂.highIn (r t₂.lowIn t₂.highIn) at ht₂
    refine ⟨⟨t₂.lowIn, t₁.highIn, t₂.lowOut⟩, ?_, rfl, rfl, rfl⟩
    change t₂.lowOut = f t₂.lowIn t₁.highIn (r t₂.lowIn t₁.highIn)
    have hr₁ : f t₂.lowIn t₁.highIn (r t₂.lowIn t₁.highIn) =
        Classical.choose (hTot t₂.lowIn h₀) :=
      Classical.choose_spec (hEx t₂.lowIn t₁.highIn)
    have hr₂ : f t₂.lowIn t₂.highIn (r t₂.lowIn t₂.highIn) =
        Classical.choose (hTot t₂.lowIn h₀) :=
      Classical.choose_spec (hEx t₂.lowIn t₂.highIn)
    rw [ht₂, hr₂, hr₁]
  · let r : L → H → C := fun _ h => False.elim (hH ⟨h⟩)
    refine ⟨r, ?_⟩
    intro t₁ _ _ _
    exact False.elim (hH ⟨t₁.highIn⟩)

/-- Non-vacuity witness for `gni_inputTotal_spec_admits_det_gni_refinement`:
`xorSpecFn` satisfies both `GNI (SpecOf xorSpecFn)` and
`InputTotal (SpecOf xorSpecFn)`. -/
theorem gni_inputTotal_spec_admits_nonvacuity :
    GNI (SpecOf xorSpecFn) ∧ InputTotal (SpecOf xorSpecFn) :=
  ⟨secretIndepDeterminize_fails_gni_on_xorPresentation.1,
   secretIndepDeterminize_fails_gni_on_xorPresentation.2.1⟩

/-- Tightness counterexample for `hGNI` in
`gni_inputTotal_spec_admits_det_gni_refinement`: `leakSpecFn` is input-total,
violates `GNI`, and admits no `GNI` determinization. -/
theorem gni_inputTotal_spec_counterexample_no_gni :
    InputTotal (SpecOf leakSpecFn) ∧
    ¬ GNI (SpecOf leakSpecFn) ∧
    ¬ (∃ r : Unit → Bool → Unit, GNI (determinize leakSpecFn r)) := by
  refine ⟨fun _ h => ⟨h, (), rfl⟩, ?_, ?_⟩
  · intro hGNI
    have h0 : SpecOf leakSpecFn ⟨(), false, false⟩ := ⟨(), rfl⟩
    have h1 : SpecOf leakSpecFn ⟨(), true, true⟩ := ⟨(), rfl⟩
    rcases hGNI ⟨(), false, false⟩ ⟨(), true, true⟩ h0 h1 with ⟨t₃, ⟨_, hc⟩, hHi, _, hOut⟩
    rw [hOut, hHi] at hc
    cases hc
  · intro ⟨r, hGNI⟩
    have h0 : determinize leakSpecFn r ⟨(), false, false⟩ := rfl
    have h1 : determinize leakSpecFn r ⟨(), true, true⟩ := rfl
    rcases hGNI ⟨(), false, false⟩ ⟨(), true, true⟩ h0 h1 with ⟨t₃, hS₃, hHi, _, hOut⟩
    change t₃.lowOut = t₃.highIn at hS₃
    rw [hOut, hHi] at hS₃
    cases hS₃

/-- Tightness counterexample for `hTot` in
`gni_inputTotal_spec_admits_det_gni_refinement`: `emptyChoiceSpecFn` vacuously
satisfies `GNI`, violates `InputTotal`, and admits no choice function `r`. -/
theorem gni_inputTotal_spec_counterexample_no_inputTotal :
    GNI (SpecOf emptyChoiceSpecFn) ∧
    ¬ InputTotal (SpecOf emptyChoiceSpecFn) ∧
    ¬ (∃ r : Unit → Bool → Empty, GNI (determinize emptyChoiceSpecFn r)) := by
  refine ⟨?_, ?_, ?_⟩
  · intro _ _ ⟨c, _⟩ _
    exact c.elim
  · intro hTot
    rcases hTot () false with ⟨_, c, _⟩
    exact c.elim
  · intro ⟨r, _⟩
    exact (r () false).elim

end Toy.Hyper
