// MIR for `diverges` before SimplifyCfg-initial

fn diverges() -> ! {
    let mut _0: !;
    let mut _1: ();

    bb0: {
        goto -> bb1;
    }

    bb1: {
        falseUnwind -> [real: bb2, unwind: bb4];
    }

    bb2: {
        _1 = const ();
        goto -> bb1;
    }

    bb3: {
        return;
    }

    bb4 (cleanup): {
        resume;
    }
}
