// MIR for `diverges` before SimplifyCfg-post-analysis

fn diverges() -> ! {
    let mut _0: !;
    let mut _1: ();

    bb0: {
        goto -> bb1;
    }

    bb1: {
        goto -> bb2;
    }

    bb2: {
        _1 = const ();
        goto -> bb1;
    }

    bb3 (cleanup): {
        resume;
    }
}
