// MIR for `dynamic_branch` before SimplifyCfg-initial

fn dynamic_branch(_1: bool) -> () {
    debug x => _1;
    let mut _0: ();
    let mut _2: bool;
    let _3: ();

    bb0: {
        StorageLive(_2);
        _2 = copy _1;
        switchInt(move _2) -> [0: bb2, otherwise: bb1];
    }

    bb1: {
        StorageLive(_3);
        _3 = marker() -> [return: bb3, unwind: bb6];
    }

    bb2: {
        goto -> bb4;
    }

    bb3: {
        StorageDead(_3);
        _0 = const ();
        goto -> bb5;
    }

    bb4: {
        _0 = const ();
        goto -> bb5;
    }

    bb5: {
        StorageDead(_2);
        return;
    }

    bb6 (cleanup): {
        resume;
    }
}
