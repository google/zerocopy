+/// Decodes the contiguous leading prefix of completed operations from a
+/// partial GraphQL response before a resource-limit error.
+pub(super) fn decode_partial_batch_prefix<O: BatchedOperation>(
+    operations: &[O],
+    response: &Value,
+) -> Vec<O::Output> {
+    let Some(data) = response.get("data").and_then(Value::as_object) else {
+        return Vec::new();
+    };
+    let mut outputs = Vec::new();
+    for (index, operation) in operations.iter().enumerate() {
+        let alias = format!("op{index}");
+        let Some(entry) = data.get(&alias) else {
+            break;
+        };
+        if entry.is_null() {
+            break;
+        }
+        match operation.decode(entry.clone()) {
+            Ok(output) => outputs.push(output),
+            Err(_) => break,
+        }
+    }
+    outputs
+}
