/home/opam/anneal-sail-output/proof-development/check-06/Controls.lean:78:29: error: unsolved goals
s : SequentialState RegisterType
h1 : s.regs.get? Register.x1 = none
⊢ (match throwThe (Sail.Error exception) Sail.Error.Unreachable s with
    | EStateM.Result.ok a s =>
      match
        (match s.regs.get? Register.x2 with
          | some s => EStateM.pure s
          | x => throwThe (Sail.Error exception) Sail.Error.Unreachable)
          s with
      | EStateM.Result.ok a_1 s =>
        EStateM.Result.ok (ExecutionResult.Retire_Success ())
          { regs := s.regs.insert Register.x3 (a + a_1), mem := s.mem, tags := s.tags, cycleCount := s.cycleCount,
            sailOutput := s.sailOutput }
      | EStateM.Result.error e s => EStateM.Result.error e s
    | EStateM.Result.error e s => EStateM.Result.error e s) =
    EStateM.Result.error Sail.Error.Unreachable s
