theorem AnnealSail.execute_add_full_state : ∀ (a b : BitVec 64) (s : SequentialState RegisterType),
  s.regs.get? Register.x1 = some a →
    s.regs.get? Register.x2 = some b →
      EStateM.run
          (interpretSailEffects
            (Functions.execute (instruction.RTYPE (regidx.Regidx 2, regidx.Regidx 1, regidx.Regidx 3, rop.ADD))))
          s =
        EStateM.Result.ok (ExecutionResult.Retire_Success ())
          { regs := s.regs.insert Register.x3 (a + b), mem := s.mem, tags := s.tags, cycleCount := s.cycleCount,
            sailOutput := s.sailOutput } :=
fun a b s h1 h2 =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          EStateM.run (interpretSailEffects _a) s =
            EStateM.Result.ok (ExecutionResult.Retire_Success ())
              { regs := s.regs.insert Register.x3 (a + b), mem := s.mem, tags := s.tags, cycleCount := s.cycleCount,
                sailOutput := s.sailOutput })
        execute_add_effects))
    (Eq.mpr
      (id
        (congrFun'
          (congrArg Eq
            (Eq.trans
              (congrFun'
                (congrArg
                  (bind do
                    let __do_lift ← get
                    match __do_lift.regs.get? Register.x1 with
                      | some s => pure s
                      | x => throw Sail.Error.Unreachable)
                  (funext fun res =>
                    Eq.trans
                      (congrArg
                        (bind do
                          let __do_lift ← get
                          match __do_lift.regs.get? Register.x2 with
                            | some s => pure s
                            | x => throw Sail.Error.Unreachable)
                        (funext fun res_1 =>
                          bind_pure_comp (fun a => ExecutionResult.Retire_Success ())
                            (modifyGet fun s =>
                              (PUnit.unit,
                                { regs := s.regs.insert Register.x3 (res + res_1), mem := s.mem, tags := s.tags,
                                  cycleCount := s.cycleCount, sailOutput := s.sailOutput }))))
                      (bind_assoc get
                        (fun __do_lift =>
                          match __do_lift.regs.get? Register.x2 with
                          | some s => pure s
                          | x => throw Sail.Error.Unreachable)
                        fun res_1 =>
                        (fun a => ExecutionResult.Retire_Success ()) <$>
                          modifyGet fun s =>
                            (PUnit.unit,
                              { regs := s.regs.insert Register.x3 (res + res_1), mem := s.mem, tags := s.tags,
                                cycleCount := s.cycleCount, sailOutput := s.sailOutput }))))
                s)
              (congrFun
                (bind_assoc get
                  (fun __do_lift =>
                    match __do_lift.regs.get? Register.x1 with
                    | some s => pure s
                    | x => throw Sail.Error.Unreachable)
                  fun res => do
                  let x ← get
                  let res_1 ←
                    match x.regs.get? Register.x2 with
                      | some s => pure s
                      | x => throw Sail.Error.Unreachable
                  (fun a => ExecutionResult.Retire_Success ()) <$>
                      modifyGet fun s =>
                        (PUnit.unit,
                          { regs := s.regs.insert Register.x3 (res + res_1), mem := s.mem, tags := s.tags,
                            cycleCount := s.cycleCount, sailOutput := s.sailOutput }))
                s)))
          (EStateM.Result.ok (ExecutionResult.Retire_Success ())
            { regs := s.regs.insert Register.x3 (a + b), mem := s.mem, tags := s.tags, cycleCount := s.cycleCount,
              sailOutput := s.sailOutput })))
      sorry)
