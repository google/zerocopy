(set-logic QF_AUFBV)
(set-option :produce-proofs true)
(declare-const before (Array (_ BitVec 8) (_ BitVec 8)))
(declare-const changed (_ BitVec 8))
(declare-const framed (_ BitVec 8))
(declare-const value (_ BitVec 8))
(assert (not (= changed framed)))
(assert (not (= (select (store before changed value) framed) (select before framed))))
(check-sat)
(get-proof)
