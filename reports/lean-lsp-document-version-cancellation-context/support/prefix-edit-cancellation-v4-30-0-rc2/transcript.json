          "version": 1,
          "text": "import Lean\nopen Lean Elab Command\nrun_cmd do\n  let p := \"markers.txt\"\n  let old ← liftIO <| IO.FS.readFile p <|> pure \"\"\n  liftIO <| IO.FS.writeFile p (old ++ \"A\\n\")\ndef generated : Nat := 1\nrun_cmd do\n  let p := \"markers.txt\"\n  let old ← liftIO <| IO.FS.readFile p <|> pure \"\"\n  liftIO <| IO.FS.writeFile p (old ++ \"B1\\n\")\ntheorem target : generated = 1 := by decide\nrun_cmd do\n  let p := \"markers.txt\"\n  let old ← liftIO <| IO.FS.readFile p <|> pure \"\"\n  liftIO <| IO.FS.writeFile p (old ++ \"C1\\n\")\n"
