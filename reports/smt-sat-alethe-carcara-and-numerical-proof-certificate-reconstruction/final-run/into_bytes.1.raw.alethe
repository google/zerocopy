(
(assume a0 (and (<= 0 (! (select source 0) :named @p_1)) (< @p_1 256)))
(assume a1 (and (<= 0 (! (select source 1) :named @p_2)) (< @p_2 256)))
(assume a2 (and (<= 0 (! (select current 0) :named @p_3)) (< @p_3 256)))
(assume a3 (and (<= 0 (! (select current 1) :named @p_4)) (< @p_4 256)))
(assume a4 (and (<= 0 replacement) (< replacement 256)))
(assume a5 (or (= changed 0) (= changed 1)))
(assume a6 (or (= framed 0) (= framed 1)))
(assume a7 (! (select source_init 0) :named @p_5))
(assume a8 (! (select source_read 0) :named @p_6))
(assume a9 (! (select source_init 1) :named @p_7))
(assume a10 (! (select source_read 1) :named @p_8))
(assume a11 (! (not (! (and @p_5 @p_6 @p_7 @p_8) :named @p_9)) :named @p_10))
(step t0 (cl @p_9) :rule and_intro :premises (a7 a8 a9 a10))
(step t1 (cl) :rule resolution :premises (t0 a11))
)
