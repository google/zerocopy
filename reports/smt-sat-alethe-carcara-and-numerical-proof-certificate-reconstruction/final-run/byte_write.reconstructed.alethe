(
(assume a0 (and (<= 0 (select source 0)) (< (select source 0) 256)))
(assume a1 (and (<= 0 (select source 1)) (< (select source 1) 256)))
(assume a2 (and (<= 0 (select current 0)) (< (select current 0) 256)))
(assume a3 (and (<= 0 (select current 1)) (< (select current 1) 256)))
(assume a4 (and (<= 0 replacement) (< replacement 256)))
(assume a5 (or (= changed 0) (= changed 1)))
(assume a6 (or (= framed 0) (= framed 1)))
(assume a7 (select write_authority changed))
(assume a8 (not (= changed framed)))
(assume a9 (not (and (= (select (store source changed replacement) changed) replacement) (select (store source_init changed true) changed) (= (select (store source changed replacement) framed) (select source framed)) (= (select (store source_init changed true) framed) (select source_init framed)))))
(step t0 (cl (= (select (store source changed replacement) changed) replacement)) :rule arrays_idx)
(step t1 (cl (= (select (store source_init changed true) changed) true)) :rule arrays_idx)
(step t2 (cl (= true (select (store source_init changed true) changed))) :rule symm :premises (t1))
(step t3 (cl true) :rule true)
(step t4 (cl (select (store source_init changed true) changed)) :rule eq_mp :premises (t3 t2))
(step t5 (cl (= (select (store source changed replacement) framed) (select source framed))) :rule arrays_row :premises (a8))
(step t6 (cl (= (select (store source_init changed true) framed) (select source_init framed))) :rule arrays_row :premises (a8))
(step t7 (cl (and (= (select (store source changed replacement) changed) replacement) (select (store source_init changed true) changed) (= (select (store source changed replacement) framed) (select source framed)) (= (select (store source_init changed true) framed) (select source_init framed)))) :rule and_intro :premises (t0 t4 t5 t6))
(step t8 (cl) :rule resolution :premises (t7 a9))
)
