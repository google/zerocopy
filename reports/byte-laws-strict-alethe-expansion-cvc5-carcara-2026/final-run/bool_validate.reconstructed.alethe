(
(assume a0 (and (<= 0 (select source 0)) (< (select source 0) 256)))
(assume a1 (and (<= 0 (select source 1)) (< (select source 1) 256)))
(assume a2 (and (<= 0 (select current 0)) (< (select current 0) 256)))
(assume a3 (and (<= 0 (select current 1)) (< (select current 1) 256)))
(assume a4 (and (<= 0 replacement) (< replacement 256)))
(assume a5 (or (= changed 0) (= changed 1)))
(assume a6 (or (= framed 0) (= framed 1)))
(assume a7 (select source_init 0))
(assume a8 (select source_read 0))
(assume a9 (select current_init 0))
(assume a10 (select current_read 0))
(assume a11 (= (select source 0) (select current 0)))
(assume a12 (not (>= (select source 0) 2)))
(assume a13 (not (and (select current_init 0) (select current_read 0) (not (>= (select current 0) 2)))))
(step t0 (cl (= (>= (select source 0) 2) (>= (select current 0) 2))) :rule cong :premises (a11))
(step t1 (cl (= (not (>= (select source 0) 2)) (not (>= (select current 0) 2)))) :rule cong :premises (t0))
(step t2 (cl (not (>= (select current 0) 2))) :rule eq_mp :premises (a12 t1))
(step t3 (cl (and (select current_init 0) (select current_read 0) (not (>= (select current 0) 2)))) :rule and_intro :premises (a9 a10 t2))
(step t4 (cl) :rule resolution :premises (t3 a13))
)
