/-! ## Slice 4: Finite `EnumScalarizeTrace` Soundness & End-to-End VC Transport (`Theorems 4 & 5`) -/

/-- (a) Soundness of finite `EnumScalarizeTrace` execution in `M_enum` by
induction on `trace`, chaining `applyEnumScalarize_sound` with
`fullSemanticEquivEnum_trans`. -/
private theorem applyEnumScalarizeTrace_sound :
    ∀ (trace : EnumScalarizeTrace) (pSrc pFlat : EnumProgram),
      applyEnumScalarizeTrace trace pSrc = some pFlat →
      FullSemanticEquivEnum pSrc pFlat
  | [], pSrc, pFlat, h => by
    dsimp [applyEnumScalarizeTrace] at h
    injection h with heq
    rw [← heq]
    exact fullSemanticEquivEnum_refl pSrc
  | plan :: rest, pSrc, pFlat, h => by
    dsimp [applyEnumScalarizeTrace] at h
    cases hApp : applyEnumScalarize plan pSrc with
    | none => rw [hApp] at h; cases h
    | some pMid =>
      rw [hApp] at h
      exact fullSemanticEquivEnum_trans
        (applyEnumScalarize_sound plan pSrc pMid hApp)
        (applyEnumScalarizeTrace_sound rest pMid pFlat h)

/-- (b) Any finite `EnumScalarizeTrace` certified by
`checkEnumScalarizeToTrustedMir trace pSrc pMir = true` produces an unmodified
`Trusted.MirAst.Program` (`pMir`) whose unmodified `Trusted.MirSemantics`
judgments are bidirectionally equivalent (`↔`) to `M_enum` on `pSrc`. -/
private theorem enumScalarizeTrace_reduces_to_trusted_mir_slice4
    (trace : EnumScalarizeTrace) (pSrc : EnumProgram) (pMir : Program)
    (hLower : checkEnumScalarizeToTrustedMir trace pSrc pMir = true) :
    (∀ q : Query, WellFormedEnum pSrc q ↔ WellFormed pMir q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorEnum pSrc q out ↔ Behavior pMir q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultEnum pSrc q (.fault k) ↔
        ReachesResult pMir q (.fault k)) ∧
    (∀ q : Query, DivergesEnum pSrc q ↔ Diverges pMir q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostEnum pSrc q post ↔ SatisfiesPost pMir q post) := by
  unfold checkEnumScalarizeToTrustedMir at hLower
  cases hTr : applyEnumScalarizeTrace trace pSrc with
  | none => rw [hTr] at hLower; cases hLower
  | some pFlat =>
    rw [hTr] at hLower
    dsimp at hLower
    cases hUn : unembedBaseProgram pFlat with
    | none => rw [hUn] at hLower; cases hLower
    | some pOut =>
      rw [hUn] at hLower
      dsimp at hLower
      have hEqMir : pOut = pMir := programEq_eq hLower
      subst hEqMir
      have hFlatEq : pFlat = embedBaseProgram pOut :=
        unembedBaseProgram_eq_embed hUn
      have hEqvEnum : FullSemanticEquivEnum pSrc (embedBaseProgram pOut) := by
        rw [← hFlatEq]
        exact applyEnumScalarizeTrace_sound trace pSrc pFlat hTr
      have hExt := (enum_conservative_extension_exact_slice1 pOut).2
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · intro q; exact (hEqvEnum.1 q).trans (hExt q).1
      · intro q out; exact (hEqvEnum.2.1 q out).trans ((hExt q).2.1 out)
      · intro q k; exact (hEqvEnum.2.2.1 q k).trans ((hExt q).2.2.1 k)
      · intro q; exact (hEqvEnum.2.2.2.1 q).trans (hExt q).2.2.2.1
      · intro q post; exact (hEqvEnum.2.2.2.2 q post).trans ((hExt q).2.2.2.2 post)

/-- (c) Vertical composition: `UnreachableEnumBranching` followed by
`EnumScalarizeTrace` into unmodified `Trusted.MirAst.Program` `pMir` followed by
any certified `Trusted.MirSemantics` optimization pipeline
`FullSemanticEquivBase pMir pOpt` transports `M_enum` verification conditions on
`pSrc` bidirectionally (`↔`) onto unmodified `Trusted.MirSemantics` on `pOpt`. -/
private theorem enumPipeline_then_optPipeline_vc_transport_slice4
    (bodyId : DefId) (trace : EnumScalarizeTrace)
    (pSrc pBranched : EnumProgram) (pMir pOpt : Program)
    (hBranch : checkUnreachableEnumBranching bodyId pSrc pBranched = true)
    (hLower : checkEnumScalarizeToTrustedMir trace pBranched pMir = true)
    (hOpt : FullSemanticEquivBase pMir pOpt) :
    (∀ q : Query, WellFormedEnum pSrc q ↔ WellFormed pOpt q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorEnum pSrc q out ↔ Behavior pOpt q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultEnum pSrc q (.fault k) ↔
        ReachesResult pOpt q (.fault k)) ∧
    (∀ q : Query, DivergesEnum pSrc q ↔ Diverges pOpt q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostEnum pSrc q post ↔ SatisfiesPost pOpt q post) := by
  have hBrEq :=
    unreachableEnumBranching_sound_bidirectional_iff_slice2 bodyId pSrc pBranched hBranch
  have hLowEq :=
    enumScalarizeTrace_reduces_to_trusted_mir_slice4 trace pBranched pMir hLower
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro q; exact ((hBrEq.1 q).trans (hLowEq.1 q)).trans (hOpt.1 q)
  · intro q out; exact ((hBrEq.2.1 q out).trans (hLowEq.2.1 q out)).trans (hOpt.2.1 q out)
  · intro q k; exact ((hBrEq.2.2.1 q k).trans (hLowEq.2.2.1 q k)).trans (hOpt.2.2.1 q k)
  · intro q; exact ((hBrEq.2.2.2.1 q).trans (hLowEq.2.2.2.1 q)).trans (hOpt.2.2.2.1 q)
  · intro q post; exact ((hBrEq.2.2.2.2 q post).trans (hLowEq.2.2.2.2 q post)).trans (hOpt.2.2.2.2 q post)

/-! ## Part III: Five Core Target Theorems Directly Over Unmodified `Trusted.MirSemantics` -/

/-- **Theorem 1 (`enum_conservative_extension_exact`):**
Canonical embedding `embedBaseProgram p` of any unmodified
`Trusted.MirAst.Program` into `M_enum` preserves exact 1-step operational
behavior (`evalStepEnum` = `liftStepResultEnum ∘ evalStep`) and exact
bidirectional equivalence (`↔`) across `WellFormed`, `Behavior`,
`ReachesResult (.fault k)`, `Diverges`, and `SatisfiesPost`. -/
theorem enum_conservative_extension_exact
    (p : Program) :
    (∀ (c : Choice) (s : State),
      evalStepEnum (embedBaseProgram p) c (embedEnumState s) =
        liftStepResultEnum (evalStep p c s)) ∧
    (∀ q : Query,
      (WellFormedEnum (embedBaseProgram p) q ↔ WellFormed p q) ∧
      (∀ out : TerminalOut,
        BehaviorEnum (embedBaseProgram p) q out ↔ Behavior p q out) ∧
      (∀ k : FaultKind,
        ReachesResultEnum (embedBaseProgram p) q (.fault k) ↔
          ReachesResult p q (.fault k)) ∧
      (DivergesEnum (embedBaseProgram p) q ↔ Diverges p q) ∧
      (∀ post : TerminalOut → Prop,
        SatisfiesPostEnum (embedBaseProgram p) q post ↔
          SatisfiesPost p q post)) := by
  exact enum_conservative_extension_exact_slice1 p

/-- **Theorem 2 (`wrappingNiche_partition_and_writeOrder_iff`):**
For any `ed : AdtEnumDef` with `adtEnumDefAdmitted ed = true` and niche layout
`ed.layout = .niche tagW untagged nStart nLast nStartBits tagRange nicheField uRange`:
1. **Exact Modular Partition:** For every `tagW`-bit scalar `bits`
   (`truncateBits tagW bits = bits`), `wrappingRangeContains tagRange bits = true`
   holds iff EITHER `Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart)`
   (a niche variant tag) OR `wrappingRangeContains uRange bits = true` (a valid
   `untagged` payload), and the two cases are mutually exclusive.
2. **Niche Tag Round-Trip:** For every inhabited niche variant `v` with
   `nStart ≤ v ≤ nLast`, `writeAdtDiscriminant ed v (.liveNiche b extras)` steps
   to `.ok sl'` whose `decodeNicheVariant` decodes back to `.ok v`.
3. **Exact `SetDiscriminant(untagged)` Write-Order UB Characterization:**
   `writeAdtDiscriminant ed untagged (.liveNiche nicheBits extras)` succeeds
   (is `.ok _`) iff `nicheBits = some bits` with `truncateBits tagW bits = bits`
   and `wrappingRangeContains uRange bits = true`; whenever `nicheBits = none`
   (`Uninit`) or `nicheBits = some bits` encodes any niche variant `v ∈ [nStart, nLast]`
   (or lies outside `tagRange` with `truncateBits tagW bits = bits`),
   `writeAdtDiscriminant` deterministically returns `.error .undefined`
   (`InvalidNichedEnumVariantWritten` / `InvalidUninitBytes`). -/
theorem wrappingNiche_partition_and_writeOrder_iff
    (ed : AdtEnumDef) (tagW : IntWidth)
    (untagged nStart nLast : Nat) (nStartBits : BitVec 128)
    (tagRange : WrappingRange128) (nicheField : Nat)
    (uRange : WrappingRange128)
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .niche tagW untagged nStart nLast nStartBits
      tagRange nicheField uRange) :
    (∀ bits : BitVec 128,
      truncateBits tagW bits = bits →
      ((wrappingRangeContains tagRange bits = true ↔
          (Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = true ∨
            wrappingRangeContains uRange bits = true)) ∧
       ¬ (Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = true ∧
            wrappingRangeContains uRange bits = true))) ∧
    (∀ (v : Nat) (vd : VariantDef) (b : Option (BitVec 128))
        (extras : List (Option Val)),
      nStart ≤ v → v ≤ nLast →
      Trusted.MirSemantics.getElem? ed.variants v = some vd →
      variantIsUninhabited vd = false →
      ∃ bits' : BitVec 128,
        writeAdtDiscriminant ed v (.liveNiche b extras) =
          .ok (.liveNiche (some bits') extras) ∧
        decodeNicheVariant ed tagW untagged nStart nLast nStartBits tagRange
          (some bits') = .ok v) ∧
    (∀ (nicheBits : Option (BitVec 128)) (extras : List (Option Val)),
      ((∃ sl' : EnumSlot,
          writeAdtDiscriminant ed untagged (.liveNiche nicheBits extras) = .ok sl') ↔
        (∃ bits : BitVec 128,
          nicheBits = some bits ∧
          truncateBits tagW bits = bits ∧
          wrappingRangeContains uRange bits = true)) ∧
      ((nicheBits = none ∨
        ∃ bits : BitVec 128,
          nicheBits = some bits ∧
          truncateBits tagW bits = bits ∧
          wrappingRangeContains uRange bits = false) →
        writeAdtDiscriminant ed untagged (.liveNiche nicheBits extras) =
          .error .undefined)) := by
  exact wrappingNiche_partition_and_writeOrder_iff_slice2
    ed tagW untagged nStart nLast nStartBits tagRange nicheField uRange hAdm hLay

/-- **Theorem 3 (`unreachableEnumBranching_sound_bidirectional_iff`):**
Any transformation certified by `checkUnreachableEnumBranching bodyId pSrc pTgt = true`
preserves full bidirectional semantic equivalence `FullSemanticEquivEnum pSrc pTgt`. -/
theorem unreachableEnumBranching_sound_bidirectional_iff
    (bodyId : DefId) (pSrc pTgt : EnumProgram)
    (hCheck : checkUnreachableEnumBranching bodyId pSrc pTgt = true) :
    FullSemanticEquivEnum pSrc pTgt := by
  exact unreachableEnumBranching_sound_bidirectional_iff_slice2 bodyId pSrc pTgt hCheck

/-- **Theorem 4 (`enumScalarizeTrace_reduces_to_trusted_mir`):**
Any finite `EnumScalarizeTrace` certified by
`checkEnumScalarizeToTrustedMir trace pSrc pMir = true` produces an unmodified
`Trusted.MirAst.Program` (`pMir`) whose unmodified `Trusted.MirSemantics`
judgments (`WellFormed`, `Behavior`, `ReachesResult (.fault k)`, `Diverges`, and
`SatisfiesPost`) are bidirectionally equivalent (`↔`) to `M_enum` on `pSrc`. -/
theorem enumScalarizeTrace_reduces_to_trusted_mir
    (trace : EnumScalarizeTrace) (pSrc : EnumProgram) (pMir : Program)
    (hLower : checkEnumScalarizeToTrustedMir trace pSrc pMir = true) :
    (∀ q : Query, WellFormedEnum pSrc q ↔ WellFormed pMir q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorEnum pSrc q out ↔ Behavior pMir q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultEnum pSrc q (.fault k) ↔
        ReachesResult pMir q (.fault k)) ∧
    (∀ q : Query, DivergesEnum pSrc q ↔ Diverges pMir q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostEnum pSrc q post ↔ SatisfiesPost pMir q post) := by
  exact enumScalarizeTrace_reduces_to_trusted_mir_slice4 trace pSrc pMir hLower

/-- **Theorem 5 (`enumPipeline_then_optPipeline_vc_transport`):**
Vertical composition: `UnreachableEnumBranching` followed by `EnumScalarizeTrace`
into unmodified `Trusted.MirAst.Program` `pMir` followed by any certified
`Trusted.MirSemantics` optimization pipeline `FullSemanticEquivBase pMir pOpt`
transports `M_enum` verification conditions on `pSrc` bidirectionally (`↔`) onto
unmodified `Trusted.MirSemantics` on `pOpt`. -/
theorem enumPipeline_then_optPipeline_vc_transport
    (bodyId : DefId) (trace : EnumScalarizeTrace)
    (pSrc pBranched : EnumProgram) (pMir pOpt : Program)
    (hBranch : checkUnreachableEnumBranching bodyId pSrc pBranched = true)
    (hLower : checkEnumScalarizeToTrustedMir trace pBranched pMir = true)
    (hOpt : FullSemanticEquivBase pMir pOpt) :
    (∀ q : Query, WellFormedEnum pSrc q ↔ WellFormed pOpt q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorEnum pSrc q out ↔ Behavior pOpt q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultEnum pSrc q (.fault k) ↔
        ReachesResult pOpt q (.fault k)) ∧
    (∀ q : Query, DivergesEnum pSrc q ↔ Diverges pOpt q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostEnum pSrc q post ↔ SatisfiesPost pOpt q post) := by
  exact enumPipeline_then_optPipeline_vc_transport_slice4
    bodyId trace pSrc pBranched pMir pOpt hBranch hLower hOpt

/-! ## Part IV: Bounded-Fuel Adequacy, Ten Sharpness Counterexamples (`CE1`--`CE10`), & End-to-End `Trusted.MirSemantics` Lowering Witness (`0` `sorry`) -/

/-- Bounded-fuel executor for `M_enum`. -/
noncomputable def execFuelEnum (p : EnumProgram) :
    Nat → EnumState → Option (StepResult EnumState TerminalOut)
  | 0, _ => none
  | fuel + 1, s =>
    match evalStepEnum p 0 s with
    | .step s' => execFuelEnum p fuel s'
    | .done out => some (.done out)
    | .fault k => some (.fault k)

noncomputable def execEnum (p : EnumProgram) (q : Query) (fuel : Nat) :
    Option (StepResult EnumState TerminalOut) :=
  match initStateEnum p q with
  | .error k => some (.fault k)
  | .ok s₀ => execFuelEnum p fuel s₀

/-- Bounded-fuel executor for unmodified `Trusted.MirSemantics`. -/
noncomputable def execFuelBase (p : Program) :
    Nat → State → Option (StepResult State TerminalOut)
  | 0, _ => none
  | fuel + 1, s =>
    match evalStep p 0 s with
    | .step s' => execFuelBase p fuel s'
    | .done out => some (.done out)
    | .fault k => some (.fault k)

noncomputable def execBase (p : Program) (q : Query) (fuel : Nat) :
    Option (StepResult State TerminalOut) :=
  match initState p q with
  | .error k => some (.fault k)
  | .ok s₀ => execFuelBase p fuel s₀

theorem reachesEnum_head {p : EnumProgram} {s₁ s₂ s₃ : EnumState}
    (hStep : StepEnum p s₁ (.step s₂)) (hRest : ReachesEnum p s₂ s₃) :
    ReachesEnum p s₁ s₃ := by
  induction hRest with
  | refl => exact ReachesEnum.tail (ReachesEnum.refl s₁) hStep
  | tail _ hLast ih => exact ReachesEnum.tail ih hLast

theorem reachesEnum_head_det {p : EnumProgram} {s₁ s₂ s₃ : EnumState}
    (hStep : evalStepEnum p 0 s₁ = .step s₂) (hRest : ReachesEnum p s₂ s₃) :
    ReachesEnum p s₁ s₃ :=
  reachesEnum_head ⟨0, rfl, hStep⟩ hRest

theorem execFuelEnum_sound (p : EnumProgram) :
    ∀ (fuel : Nat) (s₀ : EnumState) (res : StepResult EnumState TerminalOut),
      execFuelEnum p fuel s₀ = some res →
      ∃ s : EnumState, ReachesEnum p s₀ s ∧ StepEnum p s res
  | 0, _, _, h => by cases h
  | fuel + 1, s₀, res, h => by
    unfold execFuelEnum at h
    cases hEv : evalStepEnum p 0 s₀ with
    | step s₁ =>
      rw [hEv] at h
      let ⟨s, hR, hS⟩ := execFuelEnum_sound p fuel s₁ res h
      exact ⟨s, reachesEnum_head_det hEv hR, hS⟩
    | done out =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, ReachesEnum.refl s₀, ⟨0, rfl, hEv⟩⟩
    | fault k =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, ReachesEnum.refl s₀, ⟨0, rfl, hEv⟩⟩

theorem execEnum_sound {p : EnumProgram} {q : Query} {fuel : Nat}
    {res : StepResult EnumState TerminalOut}
    (h : execEnum p q fuel = some res) :
    ReachesResultEnum p q res := by
  unfold execEnum at h
  unfold ReachesResultEnum
  cases hInit : initStateEnum p q with
  | error k =>
    rw [hInit] at h
    injection h with hEq
    exact hEq.symm
  | ok s₀ =>
    rw [hInit] at h
    exact execFuelEnum_sound p fuel s₀ res h

theorem execFuelEnum_done_det (p : EnumProgram) :
    ∀ (fuel : Nat) (s₀ : EnumState) (out : TerminalOut),
      execFuelEnum p fuel s₀ = some (.done out) →
      (∀ s : EnumState, ReachesEnum p s₀ s →
        ∀ k : FaultKind, ¬ StepEnum p s (.fault k)) ∧
      (∀ s : EnumState, ReachesEnum p s₀ s →
        ∀ out' : TerminalOut, StepEnum p s (.done out') → out' = out)
  | 0, _, _, h => by cases h
  | fuel + 1, s₀, out, h => by
    unfold execFuelEnum at h
    cases hEv : evalStepEnum p 0 s₀ with
    | fault _ => rw [hEv] at h; cases h
    | done out₀ =>
      rw [hEv] at h
      injection h with hEq
      injection hEq with hOutEq
      subst hOutEq
      have hOnly0 : ∀ s, ReachesEnum p s₀ s → s = s₀ := by
        intro s hR
        induction hR with
        | refl => rfl
        | tail _ hStep ih =>
          subst ih
          let ⟨c, hc, hStepEq⟩ := hStep
          cases hc
          rw [hEv] at hStepEq
          cases hStepEq
      refine ⟨?_, ?_⟩
      · intro s hR k hF
        have hEq := hOnly0 s hR
        subst hEq
        let ⟨c, hc, hFEq⟩ := hF
        cases hc
        rw [hEv] at hFEq
        cases hFEq
      · intro s hR out' hD
        have hEq := hOnly0 s hR
        subst hEq
        let ⟨c, hc, hDEq⟩ := hD
        cases hc
        rw [hEv] at hDEq
        injection hDEq with hO
        exact hO.symm
    | step s₁ =>
      rw [hEv] at h
      let ⟨ihNoF, ihDet⟩ := execFuelEnum_done_det p fuel s₁ out h
      have hStepFrom0 : ∀ s, ReachesEnum p s₀ s → s = s₀ ∨ ReachesEnum p s₁ s := by
        intro s hR
        induction hR with
        | refl => exact Or.inl rfl
        | tail _ hSt ih =>
          cases ih with
          | inl hEq0 =>
            subst hEq0
            let ⟨c, hc, hStEq⟩ := hSt
            cases hc
            rw [hEv] at hStEq
            injection hStEq with hEq1
            subst hEq1
            exact Or.inr (ReachesEnum.refl s₁)
          | inr hR1 =>
            exact Or.inr (ReachesEnum.tail hR1 hSt)
      refine ⟨?_, ?_⟩
      · intro s hR k hF
        cases hStepFrom0 s hR with
        | inl hEq0 =>
          subst hEq0
          let ⟨c, hc, hFEq⟩ := hF
          cases hc
          rw [hEv] at hFEq
          cases hFEq
        | inr hR1 => exact ihNoF s hR1 k hF
      · intro s hR out' hD
        cases hStepFrom0 s hR with
        | inl hEq0 =>
          subst hEq0
          let ⟨c, hc, hDEq⟩ := hD
          cases hc
          rw [hEv] at hDEq
          cases hDEq
        | inr hR1 => exact ihDet s hR1 out' hD

theorem positiveCanaryEnum_of_exec {p : EnumProgram} {q : Query} {fuel : Nat}
    {out : TerminalOut} (h : execEnum p q fuel = some (.done out)) :
    WellFormedEnum p q ∧ BehaviorEnum p q out ∧
      (∀ out' : TerminalOut, BehaviorEnum p q out' → out' = out) := by
  have hBeh : BehaviorEnum p q out := execEnum_sound h
  unfold execEnum at h
  cases hInit : initStateEnum p q with
  | error _ => rw [hInit] at h; cases h
  | ok s₀ =>
    rw [hInit] at h
    let ⟨hNoF, hDet⟩ := execFuelEnum_done_det p fuel s₀ out h
    refine ⟨⟨⟨s₀, hInit, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩, hBeh, ?_⟩
    · intro k hF
      unfold ReachesResultEnum at hF
      rw [hInit] at hF
      let ⟨s, hR, hS⟩ := hF
      exact hNoF s hR k hS
    · intro out' hB'
      unfold BehaviorEnum ReachesResultEnum at hB'
      rw [hInit] at hB'
      let ⟨s, hR, hS⟩ := hB'
      exact hDet s hR out' hS

theorem negativeCanaryEnum_of_exec {p : EnumProgram} {q : Query} {fuel : Nat}
    {k : FaultKind} (h : execEnum p q fuel = some (.fault k)) :
    ReachesResultEnum p q (.fault k) ∧ ¬ WellFormedEnum p q := by
  have hF : ReachesResultEnum p q (.fault k) := execEnum_sound h
  exact ⟨hF, fun hWf => hWf.2 k hF⟩

theorem reachesBase_head {p : Program} {s₁ s₂ s₃ : State}
    (hStep : Step p s₁ (.step s₂)) (hRest : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction hRest with
  | refl => exact Reaches.tail (Reaches.refl s₁) hStep
  | tail _ hLast ih => exact Reaches.tail ih hLast

theorem execFuelBase_sound (p : Program) :
    ∀ (fuel : Nat) (s₀ : State) (res : StepResult State TerminalOut),
      execFuelBase p fuel s₀ = some res →
      ∃ s : State, Reaches p s₀ s ∧ Step p s res
  | 0, _, _, h => by cases h
  | fuel + 1, s₀, res, h => by
    unfold execFuelBase at h
    cases hEv : evalStep p 0 s₀ with
    | step s₁ =>
      rw [hEv] at h
      let ⟨s, hR, hS⟩ := execFuelBase_sound p fuel s₁ res h
      exact ⟨s, reachesBase_head ⟨0, rfl, hEv⟩ hR, hS⟩
    | done out =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, Reaches.refl s₀, ⟨0, rfl, hEv⟩⟩
    | fault k =>
      rw [hEv] at h
      injection h with hEq
      subst hEq
      exact ⟨s₀, Reaches.refl s₀, ⟨0, rfl, hEv⟩⟩

theorem execBase_sound {p : Program} {q : Query} {fuel : Nat}
    {res : StepResult State TerminalOut}
    (h : execBase p q fuel = some res) :
    ReachesResult p q res := by
  unfold execBase at h
  unfold ReachesResult
  cases hInit : initState p q with
  | error k =>
    rw [hInit] at h
    injection h with hEq
    exact hEq.symm
  | ok s₀ =>
    rw [hInit] at h
    exact execFuelBase_sound p fuel s₀ res h

