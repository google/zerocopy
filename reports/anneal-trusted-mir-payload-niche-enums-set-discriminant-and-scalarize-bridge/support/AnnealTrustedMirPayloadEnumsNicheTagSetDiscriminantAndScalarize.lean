                have hPreEnd : PrefixSlotsAgree base plan.enumLocal s1End s2End := by
                  refine ⟨(setElem?_length hSet1End).trans hPreMid.1,
                          by rw [setElem?_length hSet2]; exact hPreMid.2.1, ?_⟩
                  intro j hjLt hjNe
                  rw [setElem?_getElem?_ne hSet2
                        (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt (Nat.le_add_right base 2))),
                      setElem?_getElem?_ne hSet1End hjNe]
                  exact hPreMid.2.2 j hjLt hjNe
                have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveNiche (some tBits) extras) s2End := by
                  refine ⟨(setElem?_length hSet2).trans hMatchMid.1,
                          tagW, untagged, nStart, nLast, nStartBits, tagRange, nicheField, uRange, uVd,
                          hLay, huGet, hexLen, ?_,
                          (fun b hb => by injection hb with hbEq; subst hbEq; exact hTFit),
                          setElem?_getElem?_same hSet2,
                          ⟨oD, ?_⟩, ⟨oG, ?_⟩, ?_⟩
                  · rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_lt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ 1)))]
                    exact hLiveSlot
                  · rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_gt (Nat.add_lt_add_left (Nat.lt_succ_self 2) base))]
                    exact hSlotDiff
                  · rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_gt (Nat.add_lt_add_left (Nat.lt_trans (Nat.lt_succ_self 2) (Nat.lt_succ_self 3)) base))]
                    exact hSlotGuard
                  · intro ei ov hei
                    rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_gt
                      (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 2))) base)
                        (Nat.le_add_right (base + 5) ei)))]
                    exact hSlotExtras ei ov hei
                have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
                  (hF2Idx.trans (congrArg List.length hPreEq)) hPreEnd
                  (setElem?_getElem?_same hSet1End) hMatchEnd
                  (fun _ _ _ h => by cases h)
                dsimp [lowerEnumStmt] at hPost
                rw [nat_beq_refl] at hPost; dsimp at hPost
                rw [hLay, hvGet] at hPost; dsimp at hPost
                rw [huGet] at hPost; dsimp at hPost
                rw [hUninh, hBU, hInN] at hPost; dsimp at hPost
                rw [list_append_length, hEvalLen] at hPost
                dsimp [List.length] at hPost
                rw [← Nat.add_assoc f₂.stmtIdx (2 * ops.length) 2,
                    hF2Idx] at hPost
                have hAr2 : preStmts.length + 2 * ops.length + 1 + 1 =
                    preStmts.length + 2 * ops.length + 2 :=
                  Nat.add_assoc (preStmts.length + 2 * ops.length) 1 1
                rw [hAr2] at hStepTag
                exact simStep1 hEv1 hStepTag hPost
              | false =>
                rw [hInN] at hStTail; dsimp at hStTail
                have hStUnsup : bbTgt.statements = preL ++ (EnumStmt.baseStmt .unsupported) :: postStmts := by
                  rw [hStTail, List.append_assoc]; rfl
                have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
                    (.aggregateEnum plan.enumLocal v ops) = .fault .unsupported := by
                  unfold evalEnumStmt; dsimp
                  rw [hOpsNoM]; dsimp
                  rw [ctx.hEnumDecl]; dsimp
                  rw [ctx.hEdGet]; dsimp
                  rw [ctx.hEdAdm, hvGet]; dsimp
                  rw [hEvOps]; dsimp
                  rw [hSl1Mid]; dsimp
                  rw [hUninh]; dsimp
                  cases hFsCase : vd.fields with
                  | nil =>
                    rw [hFsCase] at hValsLen
                    cases vals with
                    | cons _ _ => cases hValsLen
                    | nil =>
                      unfold writeAdtFieldsSeq; dsimp
                      unfold writeAdtDiscriminant; dsimp
                      rw [ctx.hEdAdm, hvGet]; dsimp
                      rw [hUninh, hLay]; dsimp
                      rw [hBU, hInN]; rfl
                  | cons fTy0 restFs =>
                    rw [hFsCase] at hValsLen hScrMid
                    cases vals with
                    | nil => cases hValsLen
                    | cons v0 restVs =>
                      have hChk0 : checkVal v0 fTy0 = true := (hScrMid 0 fTy0 v0 rfl rfl).1
                      unfold writeAdtFieldsSeq writeAdtField; dsimp
                      rw [ctx.hEdAdm, hChk0, hLay]; dsimp
                      rw [hBU, hInN]; rfl
                have hStepUnsup : evalStepEnum pOut 0
                    { frames := [{ f₂ with stmtIdx := preStmts.length + 2 * ops.length + 1, locals := s2Mid }],
                      callerMem := cm } = .fault .unsupported := by
                  rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2 * ops.length + 1, locals := s2Mid })
                        hB2 hBB2 hStUnsup hPreLLen.symm, hStepEqDefs]
                  rfl
                exact simFault0 hEv1 hStepUnsup

