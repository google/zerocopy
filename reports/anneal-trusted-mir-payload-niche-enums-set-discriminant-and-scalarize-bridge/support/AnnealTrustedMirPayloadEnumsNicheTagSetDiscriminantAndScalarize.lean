              cases tag with
              | none => exact ⟨_, hTagSlot⟩
              | some vt => exact ⟨_, hTagSlot⟩
            let ⟨ovT, hTagSlotPay⟩ := hTagInPay
            let ⟨s2End, hSetTag⟩ := setElem?_some_of_lt s2Pay (base + 2)
              (.baseSlot (.live (some (.enumVal ety v)))) (getElem?_some_lt hTagSlotPay)
            let ⟨hEvCL, hChkTag⟩ := directTagEnumTy_evalConstLit ctx.hEdAdm hLay hvGet
            have hStepTag : evalStepEnum pOut 0
                { frames := [{ f₂ with stmtIdx := preStmts.length + 2 * ops.length + 1 + vd.fields.length, locals := s2Pay }],
                  callerMem := cm } =
                .step { frames := [{ f₂ with stmtIdx := preStmts.length + 2 * ops.length + 1 + vd.fields.length + 1, locals := s2End }],
                        callerMem := cm } := by
              rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2 * ops.length + 1 + vd.fields.length, locals := s2Pay })
                    hB2 hBB2 hStTag hPreMvLen.symm, hStepEqDefs]
              dsimp [stTag, cOp]
              unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot writeEnumBasePlace
              dsimp
              rw [hDeclTag, hEvCL]; dsimp
              rw [mirTy_beq_refl (.enum ety)]; dsimp
              rw [hChkTag, hTagSlotPay]; dsimp
              rw [hSetTag]
            have hPreEnd : PrefixSlotsAgree base plan.enumLocal s1End s2End := by
              refine ⟨(setElem?_length hSet1End).trans hPreMid.1,
                      by rw [setElem?_length hSetTag, hLenPay]; exact hPreMid.2.1, ?_⟩
              intro j hjLt hjNe
              have hjLt2 : j < base + 2 := Nat.lt_of_lt_of_le hjLt (Nat.le_add_right base 2)
              rw [setElem?_getElem?_ne hSetTag (s3d2_ne_of_lt hjLt2),
                  hOutMv j ⟨Or.inl (Nat.lt_trans hjLt2 hTagLtP), Or.inl (Nat.lt_trans hjLt2 hTagLtS)⟩,
                  setElem?_getElem?_ne hSet1End hjNe]
              exact hPreMid.2.2 j hjLt hjNe
            have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveDirect (some v) vfs') s2End := by
              refine ⟨(setElem?_length hSetTag).trans (hLenPay.trans hMatchMid.1),
                      tagW, tagS, hLay, (setElem?_length hSetVfs).trans hvfsLen,
                      ?_,
                      (fun vx hvx => by injection hvx with hEq; subst hEq; exact getElem?_some_lt hvGet),
                      setElem?_getElem?_same hSetTag, ?_⟩
              · have hbLt2 : base < base + 2 := Nat.lt_add_of_pos_right (Nat.zero_lt_succ 1)
                rw [setElem?_getElem?_ne hSetTag (s3d2_ne_of_lt hbLt2),
                    hOutMv base ⟨Or.inl (Nat.lt_trans hbLt2 hTagLtP), Or.inl (Nat.lt_trans hbLt2 hTagLtS)⟩]
                exact hLiveSlot
              · intro vx vdx fsx hvx hfsx
                cases hEqV : Nat.beq vx v with
                | true =>
                  have hvxEq : vx = v := nat_beq_eq hEqV; subst hvxEq
                  rw [hvGet] at hvx; injection hvx with hvdEq; subst hvdEq
                  rw [setElem?_getElem?_same hSetVfs] at hfsx
                  injection hfsx with hfsEq; subst hfsEq
                  refine ⟨hfs'Len.trans hfsLen, ?_⟩
                  intro fx ovx hfx
                  have hfxLt : fx < vd.fields.length := by
                    rw [← hfsLen, ← hfs'Len]; exact getElem?_some_lt hfx
                  let ⟨valF, hValF⟩ := getElem?_some_of_lt vals fx (by rw [hValsLen]; exact hfxLt)
                  have hfsAtF := hfs'Suf fx valF hValF
                  rw [Nat.zero_add] at hfsAtF
                  rw [hfsAtF] at hfx; injection hfx with hovEq; subst hovEq
                  let locX := base + 3 + directVariantFieldOffset ctx.ed.variants vx + fx
                  have hlt2 : base + 2 < locX :=
                    Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_succ_self 2) base)
                      (Nat.le_trans (Nat.le_add_right (base + 3) _) (Nat.le_add_right _ fx))
                  rw [setElem?_getElem?_ne hSetTag (s3d2_ne_of_gt hlt2)]
                  exact hPayMv fx valF hfxLt hValF
                | false =>
                  have hvxNe : vx ≠ v := nat_ne_of_beq_false hEqV
                  rw [setElem?_getElem?_ne hSetVfs hvxNe] at hfsx
                  let ⟨hfsxLen, hFsxSlot⟩ := hVfsAt vx vdx fsx hvx hfsx
                  refine ⟨hfsxLen, ?_⟩
                  intro fx ovx hfx
                  have hfxLt : fx < vdx.fields.length := by rw [← hfsxLen]; exact getElem?_some_lt hfx
                  let locX := base + 3 + directVariantFieldOffset ctx.ed.variants vx + fx
                  have hlt2 : base + 2 < locX :=
                    Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_succ_self 2) base)
                      (Nat.le_trans (Nat.le_add_right (base + 3) _) (Nat.le_add_right _ fx))
                  have hDisjX : locX < pBase ∨ pBase + vd.fields.length ≤ locX := by
                    cases Nat.lt_or_ge vx v with
                    | inl hvLt =>
                      have hOffLe : directVariantFieldOffset ctx.ed.variants vx + vdx.fields.length ≤ vOff := by
                        have hSplit : ∀ (vs : List VariantDef) (a b : Nat) (vda : VariantDef),
                            a < b → Trusted.MirSemantics.getElem? vs a = some vda →
                            directVariantFieldOffset vs a + vda.fields.length ≤
                              directVariantFieldOffset vs b := by
                          intro vs
                          induction vs with
                          | nil => intro _ _ _ _ hg; cases hg
                          | cons hd tl ih =>
                            intro a b vda hab hg
                            cases b with
                            | zero => exact False.elim (Nat.not_lt_zero a hab)
                            | succ b' =>
                              cases a with
                              | zero =>
                                injection hg with hEq; subst hEq
                                dsimp [directVariantFieldOffset]
                                rw [Nat.zero_add]
                                exact Nat.le_add_right _ _
                              | succ a' =>
                                dsimp [directVariantFieldOffset]
                                rw [Nat.add_assoc]
                                exact Nat.add_le_add_left (ih a' b' vda (Nat.lt_of_succ_lt_succ hab) hg) _
                        exact hSplit ctx.ed.variants vx v vdx hvLt hvx
                      apply Or.inl
                      dsimp [locX, pBase]
                      rw [Nat.add_assoc (base + 3) _ fx]
                      exact Nat.add_lt_add_left
                        (Nat.lt_of_lt_of_le (Nat.add_lt_add_left hfxLt _) hOffLe) (base + 3)
                    | inr hvGe =>
                      have hvGt : v < vx :=
                        Nat.lt_of_le_of_ne hvGe (fun h => hvxNe h.symm)
                      have hOffGe : vOff + vd.fields.length ≤ directVariantFieldOffset ctx.ed.variants vx := by
                        have hSplit : ∀ (vs : List VariantDef) (a b : Nat) (vda : VariantDef),
                            a < b → Trusted.MirSemantics.getElem? vs a = some vda →
                            directVariantFieldOffset vs a + vda.fields.length ≤
                              directVariantFieldOffset vs b := by
                          intro vs
                          induction vs with
                          | nil => intro _ _ _ _ hg; cases hg
                          | cons hd tl ih =>
                            intro a b vda hab hg
                            cases b with
                            | zero => exact False.elim (Nat.not_lt_zero a hab)
                            | succ b' =>
                              cases a with
                              | zero =>
                                injection hg with hEq; subst hEq
                                dsimp [directVariantFieldOffset]
                                rw [Nat.zero_add]
                                exact Nat.le_add_right _ _
                              | succ a' =>
                                dsimp [directVariantFieldOffset]
                                rw [Nat.add_assoc]
                                exact Nat.add_le_add_left (ih a' b' vda (Nat.lt_of_succ_lt_succ hab) hg) _
                        exact hSplit ctx.ed.variants v vx vd hvGt hvGet
                      apply Or.inr
                      dsimp [locX, pBase]
                      rw [Nat.add_assoc (base + 3) vOff vd.fields.length,
                          Nat.add_assoc (base + 3) _ fx]
                      exact Nat.add_le_add_left
                        (Nat.le_trans hOffGe (Nat.le_add_right _ fx)) (base + 3)
                  have hLtScrX : locX < sBase := by
                    have hOffXLt : directVariantFieldOffset ctx.ed.variants vx + fx < allFs.length :=
                      Nat.lt_of_lt_of_le (Nat.add_lt_add_left hfxLt _)
                        (directVariantFieldOffset_bound ctx.ed.variants hvx)
                    dsimp [locX, sBase]
                    rw [Nat.add_assoc (base + 3) _ fx]
                    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hOffXLt (base + 3))
                      (Nat.le_add_right _ vOff)
                  rw [setElem?_getElem?_ne hSetTag (s3d2_ne_of_gt hlt2),
                      hOutMv locX ⟨hDisjX, Or.inl hLtScrX⟩]
                  exact hFsxSlot fx ovx hfx
            have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
              (hF2Idx.trans (congrArg List.length hPreEq)) hPreEnd
              (setElem?_getElem?_same hSet1End) hMatchEnd
              (fun vx _ vdx hsl hvx => by
                injection hsl with htEq _
                injection htEq with hvEq; subst hvEq
                rw [hvGet] at hvx; injection hvx with hvdEq; subst hvdEq
                exact hUninh)
            dsimp [lowerEnumStmt] at hPost
            rw [nat_beq_refl] at hPost; dsimp at hPost
            rw [hLay, hvGet] at hPost; dsimp at hPost
            rw [hUninh] at hPost; dsimp at hPost
            rw [list_append_length, list_append_length, list_append_length, hEvalLen, hMvLen] at hPost
            dsimp [List.length] at hPost
            rw [← Nat.add_assoc (2 * ops.length + 1) vd.fields.length 1,
                ← Nat.add_assoc f₂.stmtIdx (2 * ops.length + 1 + vd.fields.length) 1,
                ← Nat.add_assoc f₂.stmtIdx (2 * ops.length + 1) vd.fields.length,
                ← Nat.add_assoc f₂.stmtIdx (2 * ops.length) 1,
                hF2Idx] at hPost
            exact simStep1 hEv1 hStepTag hPost
  | niche tagW untagged nStart nLast nStartBits tagRange nicheField uRange =>
    let ⟨_, _, _, ⟨uVd, huGet, _, huNF⟩, hZstProp, _, _, hURFit, _⟩ :=
