                      mkMoveScratchToNicheUntagged_no_marker]
                  rfl
                · intro i hi
                  rw [list_any_append, list_any_append,
                      mkEvalOpsToScratch_marker_false_of_lt vScrBase ops
                        (Nat.lt_of_lt_of_le (Nat.add_lt_add_left hi base) hSGe),
                      mkMoveScratchToNicheUntagged_no_marker]
                  rfl
              | false =>
                dsimp
                cases (Nat.ble nStart v && Nat.ble v nLast) <;> (
                  dsimp
                  rw [list_all_append, mkEvalOpsToScratch_inBounds _ vScrBase ops hSLe]
                  dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.all, stmtAnnInBounds]
                  refine ⟨rfl, ?_, ?_⟩
                  · intro j hj
                    rw [list_any_append,
                        mkEvalOpsToScratch_marker_false_of_lt vScrBase ops
                          (Nat.lt_of_lt_of_le hj (Nat.le_trans (Nat.le_add_right base _) hSGe))]
                    rfl
                  · intro i hi
                    rw [list_any_append,
                        mkEvalOpsToScratch_marker_false_of_lt vScrBase ops
                          (Nat.lt_of_lt_of_le (Nat.add_lt_add_left hi base) hSGe)]
                    rfl)

private theorem buildNicheDispatchArms_annotations (ed : AdtEnumDef)
    (discrDst : LocalId) (targets : SwitchTargets) (nStart auxBase : Nat)
    (cleanup : Bool) (lim : Nat) :
    ∀ (k : Nat),
      (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k).2.all
        (fun bb => bb.statements.all (stmtAnnInBounds lim)) = true ∧
      (∀ q, (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k).2.any
        (fun bb => bb.statements.any (enumStmtHasStorageMarker q)) = false)
  | 0 => ⟨rfl, fun _ => rfl⟩
  | i + 1 => by
    let ⟨ihAll, ihAny⟩ :=
      buildNicheDispatchArms_annotations ed discrDst targets nStart auxBase cleanup lim i
    dsimp [buildNicheDispatchArms]
    refine ⟨?_, ?_⟩
    · rw [list_all_append, ihAll]
      dsimp [List.all]
      cases Trusted.MirSemantics.getElem? ed.variants (nStart + i) with
      | none => rfl
      | some vd =>
        dsimp
        cases variantIsUninhabited vd <;> rfl
    · intro q
      rw [list_any_append, ihAny q]
      dsimp [List.any]
      cases Trusted.MirSemantics.getElem? ed.variants (nStart + i) with
      | none => rfl
      | some vd =>
        dsimp
        cases variantIsUninhabited vd <;> rfl

private theorem listFlatMap_lowerEnumStmt_annotations
    {decls : List EnumLocalDecl} {enumLocal base : Nat}
    {ed : AdtEnumDef} {compTys : List MirTy}
    (hEnumLt : enumLocal < base)
    (hAdm : adtEnumDefAdmitted ed = true)
    (hComp : scalarizedEnumComponentTys ed = some compTys) :
    ∀ (stmts : List EnumStmt),
      stmts.all (stmtAnnInBounds base) = true →
      stmts.all (checkStmtForEnumLocal decls enumLocal ed) = true →
      (listFlatMap (lowerEnumStmt enumLocal base compTys.length ed) stmts).all
        (stmtAnnInBounds (base + compTys.length)) = true ∧
      (∀ j, j < base →
        (listFlatMap (lowerEnumStmt enumLocal base compTys.length ed) stmts).any
          (enumStmtHasStorageMarker j) = stmts.any (enumStmtHasStorageMarker j)) ∧
      (∀ i, i < nonScratchCompCount ed →
        (listFlatMap (lowerEnumStmt enumLocal base compTys.length ed) stmts).any
          (enumStmtHasStorageMarker (base + i)) =
          stmts.any (enumStmtHasStorageMarker enumLocal))
  | [], _, _ => ⟨rfl, fun _ _ => rfl, fun _ _ => rfl⟩
  | st :: rest, hAnn, hChk => by
    dsimp [List.all] at hAnn hChk
    let ⟨hA0, hAR⟩ := bool_and_true hAnn
    let ⟨hC0, hCR⟩ := bool_and_true hChk
    let ⟨hStAll, hStJ, hStI⟩ :=
      lowerEnumStmt_annotations hEnumLt hAdm hComp hA0 hC0
    let ⟨ihAll, ihJ, ihI⟩ :=
      listFlatMap_lowerEnumStmt_annotations hEnumLt hAdm hComp rest hAR hCR
    dsimp [listFlatMap, List.any]
    refine ⟨?_, ?_, ?_⟩
    · rw [list_all_append, hStAll, ihAll]; rfl
    · intro j hj
      rw [list_any_append, hStJ j hj, ihJ j hj]
    · intro i hi
      rw [list_any_append, hStI i hi, ihI i hi]

private theorem lowerEnumBlock_annotations
    {decls : List EnumLocalDecl} {enumLocal base : Nat}
    {ed : AdtEnumDef} {compTys : List MirTy}
    (hEnumLt : enumLocal < base)
    (hAdm : adtEnumDefAdmitted ed = true)
    (hComp : scalarizedEnumComponentTys ed = some compTys)
    (nextAuxBb : BasicBlockId) (bb : EnumBlock)
    (hAnn : bb.statements.all (stmtAnnInBounds base) = true)
    (hChk : bb.statements.all (checkStmtForEnumLocal decls enumLocal ed) = true) :
    let res := lowerEnumBlock enumLocal base compTys.length ed nextAuxBb bb
    res.1.statements.all (stmtAnnInBounds (base + compTys.length)) = true ∧
    res.2.all (fun b => b.statements.all (stmtAnnInBounds (base + compTys.length))) = true ∧
    (∀ j, j < base →
      res.1.statements.any (enumStmtHasStorageMarker j) =
        bb.statements.any (enumStmtHasStorageMarker j) ∧
      res.2.any (fun b => b.statements.any (enumStmtHasStorageMarker j)) = false) ∧
    (∀ i, i < nonScratchCompCount ed →
      res.1.statements.any (enumStmtHasStorageMarker (base + i)) =
        bb.statements.any (enumStmtHasStorageMarker enumLocal) ∧
      res.2.any (fun b => b.statements.any (enumStmtHasStorageMarker (base + i))) = false) := by
  let ⟨hSAll, hSJ, hSI⟩ :=
    listFlatMap_lowerEnumStmt_annotations hEnumLt hAdm hComp bb.statements hAnn hChk
  have hOrFalse : ∀ b : Bool, (b || false) = b := fun b => by cases b <;> rfl
  have hAndTrue : ∀ b : Bool, (b && true) = b := fun b => by cases b <;> rfl
  dsimp [lowerEnumBlock]
  cases bb.terminator with
  | baseTerm _ =>
    exact ⟨hSAll, rfl, fun j hj => ⟨hSJ j hj, rfl⟩, fun i hi => ⟨hSI i hi, rfl⟩⟩
  | switchDiscr discrDst eLoc targets =>
    dsimp
    cases (!Nat.beq eLoc enumLocal) with
    | true =>
      dsimp
      exact ⟨hSAll, rfl, fun j hj => ⟨hSJ j hj, rfl⟩, fun i hi => ⟨hSI i hi, rfl⟩⟩
    | false =>
      dsimp
      cases ed.layout with
      | empty =>
        dsimp
        rw [list_all_append, hSAll]
        dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.all, stmtAnnInBounds]
        refine ⟨rfl, rfl, ?_, ?_⟩
        · intro j hj; rw [list_any_append, hSJ j hj]; dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]; exact ⟨hOrFalse _, rfl⟩
        · intro i hi; rw [list_any_append, hSI i hi]; dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]; exact ⟨hOrFalse _, rfl⟩
      | single =>
        dsimp
        cases Trusted.MirSemantics.getElem? ed.variants 0 with
        | none => exact ⟨hSAll, rfl, fun j hj => ⟨hSJ j hj, rfl⟩, fun i hi => ⟨hSI i hi, rfl⟩⟩
        | some vd₀ =>
          dsimp
          cases variantIsUninhabited vd₀ <;> (
            dsimp
            rw [list_all_append, hSAll]
            dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.all, stmtAnnInBounds]
            refine ⟨rfl, rfl, ?_, ?_⟩
            · intro j hj; rw [list_any_append, hSJ j hj]; dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]; exact ⟨hOrFalse _, rfl⟩
            · intro i hi; rw [list_any_append, hSI i hi]; dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]; exact ⟨hOrFalse _, rfl⟩)
      | direct _ _ =>
        dsimp
        rw [list_all_append, hSAll]
        dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.all, stmtAnnInBounds]
        refine ⟨rfl, rfl, ?_, ?_⟩
        · intro j hj; rw [list_any_append, hSJ j hj]; dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]; exact ⟨hOrFalse _, rfl⟩
        · intro i hi; rw [list_any_append, hSI i hi]; dsimp [mkLivenessCheckStmt, mkImmediateUbStmt, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]; exact ⟨hOrFalse _, rfl⟩
      | niche tagW untagged nStart nLast nStartBits tagRange _ _ =>
        dsimp
        let k := nLast - nStart + 1
        let ⟨hArmsAll, hArmsAny⟩ := buildNicheDispatchArms_annotations
          ed discrDst targets nStart nextAuxBb bb.cleanup (base + compTys.length) k
        refine ⟨?_, ?_, ?_, ?_⟩
        · rw [list_all_append, hSAll]
          dsimp [mkLivenessCheckStmt, mkWrappingRangeCheckStmts, List.all, stmtAnnInBounds]
          rfl
        · rw [list_all_append, hArmsAll]
          dsimp [List.all]
          cases Trusted.MirSemantics.getElem? ed.variants untagged <;> rfl
        · intro j hj
          refine ⟨?_, ?_⟩
          · rw [list_any_append, hSJ j hj]
            dsimp [mkLivenessCheckStmt, mkWrappingRangeCheckStmts, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]
            exact hOrFalse _
          · rw [list_any_append, hArmsAny j]
            dsimp [List.any]
            cases Trusted.MirSemantics.getElem? ed.variants untagged <;> rfl
        · intro i hi
          refine ⟨?_, ?_⟩
          · rw [list_any_append, hSI i hi]
            dsimp [mkLivenessCheckStmt, mkWrappingRangeCheckStmts, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]
            exact hOrFalse _
          · rw [list_any_append, hArmsAny (base + i)]
            dsimp [List.any]
            cases Trusted.MirSemantics.getElem? ed.variants untagged <;> rfl

private theorem lowerEnumBlocksLoop_annotations
    {decls : List EnumLocalDecl} {enumLocal base : Nat}
    {ed : AdtEnumDef} {compTys : List MirTy}
    (hEnumLt : enumLocal < base)
    (hAdm : adtEnumDefAdmitted ed = true)
    (hComp : scalarizedEnumComponentTys ed = some compTys) :
    ∀ (nextAuxBb : BasicBlockId) (bbs : List EnumBlock),
      bbs.all (fun bb => bb.statements.all (stmtAnnInBounds base)) = true →
      bbs.all (fun bb =>
        bb.statements.all (checkStmtForEnumLocal decls enumLocal ed) &&
          checkTermForEnumLocal decls enumLocal ed bb.terminator) = true →
      let res := lowerEnumBlocksLoop enumLocal base compTys.length ed nextAuxBb bbs
      res.1.all (fun b => b.statements.all (stmtAnnInBounds (base + compTys.length))) = true ∧
      res.2.all (fun b => b.statements.all (stmtAnnInBounds (base + compTys.length))) = true ∧
      (∀ j, j < base →
        res.1.any (fun b => b.statements.any (enumStmtHasStorageMarker j)) =
          bbs.any (fun b => b.statements.any (enumStmtHasStorageMarker j)) ∧
        res.2.any (fun b => b.statements.any (enumStmtHasStorageMarker j)) = false) ∧
      (∀ i, i < nonScratchCompCount ed →
        res.1.any (fun b => b.statements.any (enumStmtHasStorageMarker (base + i))) =
          bbs.any (fun b => b.statements.any (enumStmtHasStorageMarker enumLocal)) ∧
        res.2.any (fun b => b.statements.any (enumStmtHasStorageMarker (base + i))) = false)
  | _, [], _, _ => ⟨rfl, rfl, fun _ _ => ⟨rfl, rfl⟩, fun _ _ => ⟨rfl, rfl⟩⟩
  | nextAuxBb, bb :: rest, hAnnBbs, hChkBbs => by
    dsimp [List.all] at hAnnBbs hChkBbs
    let ⟨hAnn0, hAnnR⟩ := bool_and_true hAnnBbs
    let ⟨hChk0Both, hChkR⟩ := bool_and_true hChkBbs
    let ⟨hChk0, _⟩ := bool_and_true hChk0Both
    let ⟨h1All, h2All, hJ0, hI0⟩ :=
      lowerEnumBlock_annotations hEnumLt hAdm hComp nextAuxBb bb hAnn0 hChk0
    let ⟨ih1All, ih2All, ihJ, ihI⟩ :=
      lowerEnumBlocksLoop_annotations hEnumLt hAdm hComp
        (nextAuxBb + (lowerEnumBlock enumLocal base compTys.length ed nextAuxBb bb).2.length)
        rest hAnnR hChkR
    dsimp [lowerEnumBlocksLoop, List.all, List.any]
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [h1All, ih1All]; rfl
    · rw [list_all_append, h2All, ih2All]; rfl
    · intro j hj
      rw [(hJ0 j hj).1, (ihJ j hj).1, list_any_append, (hJ0 j hj).2, (ihJ j hj).2]
      exact ⟨rfl, rfl⟩
    · intro i hi
      rw [(hI0 i hi).1, (ihI i hi).1, list_any_append, (hI0 i hi).2, (ihI i hi).2]
      exact ⟨rfl, rfl⟩

/-! ### 4. `SlotMatchesComp`, `ScalarizeCtx`, & Initial-State / `StorageLive` Matching -/

private noncomputable def SlotMatchesComp (ed : AdtEnumDef) (base : Nat)
    (compTys : List MirTy) (sl : EnumSlot) (slots₂ : List EnumSlot) : Prop :=
  slots₂.length = base + compTys.length ∧
  match sl with
  | .enumDead =>
    Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot .dead)
  | .liveEmpty =>
    ed.layout = .empty ∧
    Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot (.live (some .unit)))
  | .liveSingle fs =>
    ed.layout = .single ∧
    ∃ vd₀,
      Trusted.MirSemantics.getElem? ed.variants 0 = some vd₀ ∧
      fs.length = vd₀.fields.length ∧
      Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot (.live (some .unit))) ∧
      (∀ f ov, Trusted.MirSemantics.getElem? fs f = some ov →
        Trusted.MirSemantics.getElem? slots₂ (base + 2 + f) = some (.baseSlot (.live ov)))
  | .liveDirect tag vfs =>
    ∃ tagW tagS,
      ed.layout = .direct tagW tagS ∧
      vfs.length = ed.variants.length ∧
      Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot (.live (some .unit))) ∧
      (∀ v, tag = some v → v < ed.variants.length) ∧
      Trusted.MirSemantics.getElem? slots₂ (base + 2) =
        some (.baseSlot (.live (match tag with
          | none => none
          | some v => some (.enumVal (directTagEnumTy ed tagW tagS) v)))) ∧
      (∀ v vd fs,
        Trusted.MirSemantics.getElem? ed.variants v = some vd →
        Trusted.MirSemantics.getElem? vfs v = some fs →
        fs.length = vd.fields.length ∧
        ∀ f ov, Trusted.MirSemantics.getElem? fs f = some ov →
          Trusted.MirSemantics.getElem? slots₂
            (base + 3 + directVariantFieldOffset ed.variants v + f) =
            some (.baseSlot (.live ov)))
  | .liveNiche nb extras =>
    ∃ tagW untagged nStart nLast nStartBits tagRange nicheField uRange uVd,
      ed.layout = .niche tagW untagged nStart nLast nStartBits tagRange nicheField uRange ∧
      Trusted.MirSemantics.getElem? ed.variants untagged = some uVd ∧
      extras.length = (nicheExtraFieldTysAux nicheField 0 uVd.fields).length ∧
      Trusted.MirSemantics.getElem? slots₂ base = some (.baseSlot (.live (some .unit))) ∧
      (∀ b, nb = some b → truncateBits tagW b = b) ∧
      Trusted.MirSemantics.getElem? slots₂ (base + 2) =
        some (.baseSlot (.live (NicheOptVal tagW nb))) ∧
      (∃ oD, Trusted.MirSemantics.getElem? slots₂ (base + 3) = some (.baseSlot (.live oD))) ∧
      (∃ oG, Trusted.MirSemantics.getElem? slots₂ (base + 4) = some (.baseSlot (.live oG))) ∧
      (∀ eIdx ov, Trusted.MirSemantics.getElem? extras eIdx = some ov →
        Trusted.MirSemantics.getElem? slots₂ (base + 5 + eIdx) =
          some (.baseSlot (.live ov)))
  | .baseSlot _ => False

private theorem slotMatchesComp_congr_ge_base {ed : AdtEnumDef} {base : Nat}
    {compTys : List MirTy} {sl : EnumSlot} {slots₂ slots₂' : List EnumSlot}
    (hM : SlotMatchesComp ed base compTys sl slots₂)
    (hLen : slots₂'.length = slots₂.length)
    (hEq : ∀ k, base ≤ k →
      Trusted.MirSemantics.getElem? slots₂' k = Trusted.MirSemantics.getElem? slots₂ k) :
    SlotMatchesComp ed base compTys sl slots₂' := by
  refine ⟨hLen.trans hM.1, ?_⟩
  have hAt : ∀ off, Trusted.MirSemantics.getElem? slots₂' (base + off) =
      Trusted.MirSemantics.getElem? slots₂ (base + off) :=
    fun off => hEq (base + off) (Nat.le_add_right base off)
  have hAt0 : Trusted.MirSemantics.getElem? slots₂' base =
      Trusted.MirSemantics.getElem? slots₂ base := hEq base (Nat.le_refl base)
  cases sl with
  | baseSlot _ => exact hM.2
  | enumDead => rw [hAt0]; exact hM.2
  | liveEmpty => exact ⟨hM.2.1, by rw [hAt0]; exact hM.2.2⟩
  | liveSingle fs =>
    let ⟨hL, vd₀, hv0, hfsL, hB0, hFs⟩ := hM.2
    refine ⟨hL, vd₀, hv0, hfsL, by rw [hAt0]; exact hB0, ?_⟩
    intro f ov hf
    rw [Nat.add_assoc base 2 f, hAt (2 + f), ← Nat.add_assoc base 2 f]
    exact hFs f ov hf
  | liveDirect tag vfs =>
    let ⟨tW, tS, hL, hvL, hB0, hTagB, hTagS, hVfs⟩ := hM.2
    refine ⟨tW, tS, hL, hvL, by rw [hAt0]; exact hB0, hTagB,
            by rw [hAt 2]; exact hTagS, ?_⟩
    intro v vd fs hv hfs
    let ⟨hLenFs, hF⟩ := hVfs v vd fs hv hfs
    refine ⟨hLenFs, ?_⟩
    intro f ov hf
    have hAr : base + 3 + directVariantFieldOffset ed.variants v + f =
        base + (3 + directVariantFieldOffset ed.variants v + f) := by
      rw [Nat.add_assoc base 3 _, Nat.add_assoc base _ f]
    rw [hAr, hAt _, ← hAr]
    exact hF f ov hf
  | liveNiche nb extras =>
    let ⟨tW, u, ns, nl, nsb, tr, nf, ur, uVd, hL, hu, hexL, hB0, hNbF, hN, hD, hG, hEx⟩ := hM.2
    refine ⟨tW, u, ns, nl, nsb, tr, nf, ur, uVd, hL, hu, hexL,
            by rw [hAt0]; exact hB0, hNbF,
            by rw [hAt 2]; exact hN,
            by rw [hAt 3]; exact hD,
            by rw [hAt 4]; exact hG, ?_⟩
    intro eIdx ov he
    rw [Nat.add_assoc base 5 eIdx, hAt (5 + eIdx), ← Nat.add_assoc base 5 eIdx]
    exact hEx eIdx ov he

private theorem liveUninitEnumSlot_matches_liveComp
    {eds : List AdtEnumDef} {eIdx : Nat} {ed : AdtEnumDef}
    {base : Nat} {compTys : List MirTy} {slots₂ : List EnumSlot}
    (hEdGet : Trusted.MirSemantics.getElem? eds eIdx = some ed)
    (hAdm : adtEnumDefAdmitted ed = true)
    (hComp : scalarizedEnumComponentTys ed = some compTys)
    (hLen2 : slots₂.length = base + compTys.length)
    (hLiveNonScr : ∀ i ty,
      i < nonScratchCompCount ed →
      Trusted.MirSemantics.getElem? compTys i = some ty →
      Trusted.MirSemantics.getElem? slots₂ (base + i) =
        some (.baseSlot (.live (initFieldOptVal ty)))) :
    ∃ sl : EnumSlot,
      liveUninitEnumSlot eds (.adtEnum eIdx) = some sl ∧
      SlotMatchesComp ed base compTys sl slots₂ := by
  unfold liveUninitEnumSlot
  dsimp
  rw [hEdGet]
  dsimp
  rw [hAdm]
  dsimp
  unfold scalarizedEnumComponentTys at hComp
  unfold nonScratchCompCount at hLiveNonScr
  cases hLay : ed.layout with
  | empty =>
    rw [hLay] at hComp hLiveNonScr
    injection hComp with hCEq; subst hCEq
    dsimp
    refine ⟨.liveEmpty, rfl, hLen2, hLay, ?_⟩
    have h0 := hLiveNonScr 0 .unit (Nat.zero_lt_succ 1) rfl
    rw [Nat.add_zero] at h0
    exact h0
  | single =>
    rw [hLay] at hComp hLiveNonScr
    dsimp at hComp hLiveNonScr
    dsimp
    cases hv0 : Trusted.MirSemantics.getElem? ed.variants 0 with
    | none => rw [hv0] at hComp; cases hComp
    | some vd₀ =>
      rw [hv0] at hComp hLiveNonScr
      dsimp at hLiveNonScr
      injection hComp with hCEq; subst hCEq
      dsimp
      refine ⟨.liveSingle (vd₀.fields.map initFieldOptVal), rfl, hLen2, hLay,
              vd₀, hv0, list_map_length initFieldOptVal vd₀.fields, ?_, ?_⟩
      · have h0 := hLiveNonScr 0 .unit
          (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) (Nat.le_add_right 2 _)) rfl
        rw [Nat.add_zero] at h0
        exact h0
      · intro f ov hf
        rw [getElem?_map] at hf
        cases hfTy : Trusted.MirSemantics.getElem? vd₀.fields f with
        | none => rw [hfTy] at hf; cases hf
        | some fTy =>
          rw [hfTy] at hf
          injection hf with hovEq; subst hovEq
          have hfLt : f < vd₀.fields.length := getElem?_some_lt hfTy
          have hCompAt : Trusted.MirSemantics.getElem?
              ([MirTy.unit, .int .i32 false] ++ vd₀.fields ++ vd₀.fields) (2 + f) = some fTy := by
            have hL1 : 2 + f < ([MirTy.unit, .int .i32 false] ++ vd₀.fields).length := by
              rw [list_append_length]; dsimp [List.length]; exact Nat.add_lt_add_left hfLt 2
            rw [getElem?_append_left hL1]
            change Trusted.MirSemantics.getElem?
              ([MirTy.unit, .int .i32 false] ++ vd₀.fields)
              ([MirTy.unit, .int .i32 false].length + f) = some fTy
            rw [getElem?_append_right [MirTy.unit, .int .i32 false] vd₀.fields f]
            exact hfTy
          rw [Nat.add_assoc base 2 f]
          exact hLiveNonScr (2 + f) fTy (Nat.add_lt_add_left hfLt 2) hCompAt
  | direct tagW tagS =>
    rw [hLay] at hComp hLiveNonScr
    dsimp at hLiveNonScr
    injection hComp with hCEq; subst hCEq
    dsimp
    let ety := directTagEnumTy ed tagW tagS
    let allFs := flattenAllVariantFieldTys ed
    refine ⟨.liveDirect none (ed.variants.map (fun vd => vd.fields.map initFieldOptVal)),
            rfl, hLen2, tagW, tagS, hLay, list_map_length _ ed.variants,
            ?_, (fun _ h => by cases h), ?_, ?_⟩
    · have h0 := hLiveNonScr 0 .unit
        (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 2) (Nat.le_add_right 3 _)) rfl
      rw [Nat.add_zero] at h0
      exact h0
    · have h2Lt : 2 < 3 + allFs.length :=
        Nat.lt_of_lt_of_le (Nat.lt_succ_self 2) (Nat.le_add_right 3 _)
      have h2Comp : Trusted.MirSemantics.getElem?
          ([MirTy.unit, .int .i32 false, .enum ety] ++ allFs ++ allFs) 2 =
          some (.enum ety) := by
        have hL2 : 2 < ([MirTy.unit, .int .i32 false, .enum ety] ++ allFs).length := by
          rw [list_append_length]; dsimp [List.length]; exact h2Lt
        have hL0 : 2 < [MirTy.unit, .int .i32 false, .enum ety].length := Nat.lt_succ_self 2
        rw [getElem?_append_left hL2, getElem?_append_left hL0]
        rfl
      have h2 := hLiveNonScr 2 (.enum ety) h2Lt h2Comp
      have hNotZst : initFieldOptVal (.enum ety) = none := rfl
      rw [hNotZst] at h2
      exact h2
    · intro v vd fs hv hfs
      rw [getElem?_map, hv] at hfs
      injection hfs with hfsEq; subst hfsEq
      refine ⟨list_map_length initFieldOptVal vd.fields, ?_⟩
      intro f ov hf
      rw [getElem?_map] at hf
      cases hfTy : Trusted.MirSemantics.getElem? vd.fields f with
      | none => rw [hfTy] at hf; cases hf
      | some fTy =>
        rw [hfTy] at hf
        injection hf with hovEq; subst hovEq
        have hfLt : f < vd.fields.length := getElem?_some_lt hfTy
        have hOffLt : directVariantFieldOffset ed.variants v + f < allFs.length :=
          Nat.lt_of_lt_of_le (Nat.add_lt_add_left hfLt _)
            (directVariantFieldOffset_bound ed.variants hv)
        have hIdxLt : 3 + (directVariantFieldOffset ed.variants v + f) < 3 + allFs.length :=
          Nat.add_lt_add_left hOffLt 3
        have hAllAt : Trusted.MirSemantics.getElem? allFs
            (directVariantFieldOffset ed.variants v + f) = some fTy :=
          directVariantFieldOffset_lookup ed.variants hv hfTy
        have hCompAt : Trusted.MirSemantics.getElem?
            ([MirTy.unit, .int .i32 false, .enum ety] ++ allFs ++ allFs)
            (3 + (directVariantFieldOffset ed.variants v + f)) = some fTy := by
          have hL1 : 3 + (directVariantFieldOffset ed.variants v + f) <
              ([MirTy.unit, .int .i32 false, .enum ety] ++ allFs).length := by
            rw [list_append_length]; dsimp [List.length]; exact hIdxLt
          rw [getElem?_append_left hL1]
          change Trusted.MirSemantics.getElem?
            ([MirTy.unit, .int .i32 false, .enum ety] ++ allFs)
            ([MirTy.unit, .int .i32 false, .enum ety].length +
              (directVariantFieldOffset ed.variants v + f)) = some fTy
          rw [getElem?_append_right [MirTy.unit, .int .i32 false, .enum ety] allFs _]
          exact hAllAt
        have hAr : base + 3 + directVariantFieldOffset ed.variants v + f =
            base + (3 + (directVariantFieldOffset ed.variants v + f)) := by
          rw [Nat.add_assoc base 3 _, Nat.add_assoc base _ f, Nat.add_assoc 3 _ f]
        rw [hAr]
        exact hLiveNonScr _ fTy hIdxLt hCompAt
  | niche tagW untagged nStart nLast nStartBits tagRange nicheField uRange =>
    rw [hLay] at hComp hLiveNonScr
    dsimp at hComp hLiveNonScr
    dsimp
    cases hu : Trusted.MirSemantics.getElem? ed.variants untagged with
    | none => rw [hu] at hComp; cases hComp
    | some uVd =>
      rw [hu] at hComp hLiveNonScr
      dsimp at hLiveNonScr
      injection hComp with hCEq; subst hCEq
      dsimp
      let extras := nicheExtraFieldTysAux nicheField 0 uVd.fields
      let allFs := flattenAllVariantFieldTys ed
      let hdr : List MirTy :=
        [.unit, .int .i32 false, .int tagW false, .int tagW false, .int tagW false]
      have hHdrGet : ∀ i, i < 5 →
          Trusted.MirSemantics.getElem? (hdr ++ extras ++ allFs) i =
            Trusted.MirSemantics.getElem? hdr i := by
        intro i hi
        have hL1 : i < (hdr ++ extras).length := by
          rw [list_append_length]; dsimp [hdr, List.length]
          exact Nat.lt_of_lt_of_le hi (Nat.le_add_right 5 _)
        have hL0 : i < hdr.length := hi
        rw [getElem?_append_left hL1, getElem?_append_left hL0]
      have h0Lt5 : 0 < 5 := Nat.zero_lt_succ 4
      have h2Lt5 : 2 < 5 := Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 2))
      have h3Lt5 : 3 < 5 := Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 1)))
      have h4Lt5 : 4 < 5 := Nat.lt_succ_self 4
      refine ⟨.liveNiche none (initNicheExtraFieldsAux nicheField 0 uVd.fields),
              rfl, hLen2, tagW, untagged, nStart, nLast, nStartBits, tagRange,
              nicheField, uRange, uVd, hLay, hu, ?_, ?_,
              (fun _ h => by cases h), ?_, ?_, ?_, ?_⟩
      · rw [initNicheExtraFieldsAux_eq_map, list_map_length]
      · have h0 := hLiveNonScr 0 .unit
          (Nat.lt_of_lt_of_le h0Lt5 (Nat.le_add_right 5 _)) (hHdrGet 0 h0Lt5)
        rw [Nat.add_zero] at h0
        exact h0
      · exact hLiveNonScr 2 (.int tagW false)
          (Nat.lt_of_lt_of_le h2Lt5 (Nat.le_add_right 5 _))
          (hHdrGet 2 h2Lt5)
      · exact ⟨none, hLiveNonScr 3 (.int tagW false)
          (Nat.lt_of_lt_of_le h3Lt5 (Nat.le_add_right 5 _))
          (hHdrGet 3 h3Lt5)⟩
      · exact ⟨none, hLiveNonScr 4 (.int tagW false)
          (Nat.lt_of_lt_of_le h4Lt5 (Nat.le_add_right 5 _))
          (hHdrGet 4 h4Lt5)⟩
      · intro eIdx ov he
        rw [initNicheExtraFieldsAux_eq_map, getElem?_map] at he
        cases heTy : Trusted.MirSemantics.getElem? extras eIdx with
        | none => rw [heTy] at he; cases he
        | some eTy =>
          rw [heTy] at he
          injection he with hovEq; subst hovEq
          have heLt : eIdx < extras.length := getElem?_some_lt heTy
          have hIdxLt : 5 + eIdx < 5 + extras.length := Nat.add_lt_add_left heLt 5
          have hCompAt : Trusted.MirSemantics.getElem? (hdr ++ extras ++ allFs) (5 + eIdx) =
              some eTy := by
            have hL1 : 5 + eIdx < (hdr ++ extras).length := by
              rw [list_append_length]; dsimp [hdr, List.length]; exact hIdxLt
            rw [getElem?_append_left hL1]
            change Trusted.MirSemantics.getElem? (hdr ++ extras) (hdr.length + eIdx) = some eTy
            rw [getElem?_append_right hdr extras eIdx]
            exact heTy
          rw [Nat.add_assoc base 5 eIdx]
          exact hLiveNonScr (5 + eIdx) eTy hIdxLt hCompAt

/-! ### 5. `ScalarizeCtx`, `ScalarizeStateRel`, & `initStateEnum` Equivalence -/

private structure ScalarizeCtx (plan : EnumScalarizePlan) (pSrc pOut : EnumProgram) where
  body : EnumBody
  eIdx : Nat
  ed : AdtEnumDef
  compTys : List MirTy
  localsTombstoned : List EnumLocalDecl
  bodiesTgt : List EnumBody
  hAllEdsAdm : pSrc.enumDefs.all adtEnumDefAdmitted = true
  hBodySrc : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId = some body
  hBBNonEmpty : body.basicBlocks.isEmpty = false
  hArgLtEnum : body.argumentCount < plan.enumLocal
  hEnumLtBase : plan.enumLocal < body.locals.length
  hAnnInBnd : enumStorageAnnotationsInBounds body = true
  hLocInBnd : enumBodyLocalsInBounds body = true
  hTgtInBnd : enumBodyTargetsInBounds body = true
  hEnumDecl : Trusted.MirSemantics.getElem? body.locals plan.enumLocal = some (.adtEnum eIdx)
  hEdGet : Trusted.MirSemantics.getElem? pSrc.enumDefs eIdx = some ed
  hEdAdm : adtEnumDefAdmitted ed = true
  hBodyChk : body.basicBlocks.all (fun bb =>
    bb.statements.all (checkStmtForEnumLocal body.locals plan.enumLocal ed) &&
      checkTermForEnumLocal body.locals plan.enumLocal ed bb.terminator) = true
  hComp : scalarizedEnumComponentTys ed = some compTys
  hSetLoc : setElem? body.locals plan.enumLocal (.base .unit) = some localsTombstoned
  hSetBody : setElem? pSrc.bodies plan.defId {
    body with
    locals := localsTombstoned ++ compTys.map EnumLocalDecl.base
    basicBlocks :=
      let lowered := lowerEnumBlocksLoop plan.enumLocal body.locals.length compTys.length ed
        body.basicBlocks.length body.basicBlocks
      lowered.1 ++ lowered.2
  } = some bodiesTgt
  hPOut : pOut = {
    pSrc with
    enumDefs :=
      if bodiesTgt.any (fun b => b.locals.any isAdtEnumDecl) then pSrc.enumDefs else []
    bodies := bodiesTgt
  }

private noncomputable def scalarizeTargetBody {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) : EnumBody :=
  let lowered := lowerEnumBlocksLoop plan.enumLocal ctx.body.locals.length ctx.compTys.length
    ctx.ed ctx.body.basicBlocks.length ctx.body.basicBlocks
  { ctx.body with
    locals := ctx.localsTombstoned ++ ctx.compTys.map EnumLocalDecl.base
    basicBlocks := lowered.1 ++ lowered.2 }

private theorem applyEnumScalarize_unpack {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (hApp : applyEnumScalarize plan pSrc = some pOut) :
    Nonempty (ScalarizeCtx plan pSrc pOut) := by
  unfold applyEnumScalarize at hApp
  cases hEds : (!pSrc.enumDefs.all adtEnumDefAdmitted) with
  | true => rw [hEds] at hApp; cases hApp
  | false =>
    rw [hEds] at hApp; dsimp at hApp
    cases hB : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
    | none => rw [hB] at hApp; cases hApp
    | some body =>
      rw [hB] at hApp; dsimp at hApp
      cases hG : (body.basicBlocks.isEmpty ||
          !Nat.blt body.argumentCount plan.enumLocal ||
          !Nat.blt plan.enumLocal body.locals.length ||
          !enumStorageAnnotationsInBounds body ||
          !enumBodyLocalsInBounds body ||
          !enumBodyTargetsInBounds body) with
      | true => rw [hG] at hApp; cases hApp
      | false =>
        rw [hG] at hApp; dsimp at hApp
        let ⟨hG5, hTgtB⟩ := bool_or_false hG
        let ⟨hG4, hLocB⟩ := bool_or_false hG5
        let ⟨hG3, hAnnB⟩ := bool_or_false hG4
        let ⟨hG2, hELtB⟩ := bool_or_false hG3
        let ⟨hBBN, hArgB⟩ := bool_or_false hG2
        cases hED : Trusted.MirSemantics.getElem? body.locals plan.enumLocal with
        | none => rw [hED] at hApp; cases hApp
        | some declE =>
          rw [hED] at hApp
          cases declE with
          | base _ => dsimp at hApp; cases hApp
          | adtEnum eIdx =>
            dsimp at hApp
            cases hEdG : Trusted.MirSemantics.getElem? pSrc.enumDefs eIdx with
            | none => rw [hEdG] at hApp; cases hApp
            | some ed =>
              rw [hEdG] at hApp; dsimp at hApp
              cases hAdmB : (!adtEnumDefAdmitted ed) with
              | true => rw [hAdmB] at hApp; cases hApp
              | false =>
                rw [hAdmB] at hApp; dsimp at hApp
                cases hChkB : (!body.basicBlocks.all (fun bb =>
                    bb.statements.all (checkStmtForEnumLocal body.locals plan.enumLocal ed) &&
                      checkTermForEnumLocal body.locals plan.enumLocal ed bb.terminator)) with
                | true => rw [hChkB] at hApp; cases hApp
                | false =>
                  rw [hChkB] at hApp; dsimp at hApp
                  cases hComp : scalarizedEnumComponentTys ed with
                  | none => rw [hComp] at hApp; cases hApp
                  | some compTys =>
                    rw [hComp] at hApp
                    cases hSetL : setElem? body.locals plan.enumLocal (.base .unit) with
                    | none => rw [hSetL] at hApp; cases hApp
                    | some localsTombstoned =>
                      rw [hSetL] at hApp; dsimp at hApp
                      cases hSetB : setElem? pSrc.bodies plan.defId {
                          body with
                          locals := localsTombstoned ++ compTys.map EnumLocalDecl.base
                          basicBlocks :=
                            let lowered := lowerEnumBlocksLoop plan.enumLocal body.locals.length
                              compTys.length ed body.basicBlocks.length body.basicBlocks
                            lowered.1 ++ lowered.2 } with
                      | none => rw [hSetB] at hApp; cases hApp
                      | some bodiesTgt =>
                        rw [hSetB] at hApp; dsimp at hApp
                        injection hApp with hOutEq
                        exact ⟨{
                          body, eIdx, ed, compTys, localsTombstoned, bodiesTgt
                          hAllEdsAdm := bool_not_false hEds
                          hBodySrc := hB
                          hBBNonEmpty := hBBN
                          hArgLtEnum := nat_blt_lt (bool_not_false hArgB)
                          hEnumLtBase := nat_blt_lt (bool_not_false hELtB)
                          hAnnInBnd := bool_not_false hAnnB
                          hLocInBnd := bool_not_false hLocB
                          hTgtInBnd := bool_not_false hTgtB
                          hEnumDecl := hED
                          hEdGet := hEdG
                          hEdAdm := bool_not_false hAdmB
                          hBodyChk := bool_not_false hChkB
                          hComp := hComp
                          hSetLoc := hSetL
                          hSetBody := hSetB
                          hPOut := hOutEq.symm
                        }⟩

private theorem scalarizeCtx_enumDefs_step_eq {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {defId : DefId} {b : EnumBody}
    (hb : Trusted.MirSemantics.getElem? pOut.bodies defId = some b) :
    (∀ f cm st, evalEnumStmt pOut.enumDefs b f cm st = evalEnumStmt pSrc.enumDefs b f cm st) ∧
    (∀ bb f cm, evalEnumTerminator pOut.enumDefs b bb f cm = evalEnumTerminator pSrc.enumDefs b bb f cm) ∧
    (∀ idx decls, decls = b.locals →
      allEnumLocalsSupported pOut.enumDefs b.argumentCount idx decls =
        allEnumLocalsSupported pSrc.enumDefs b.argumentCount idx decls) ∧
    (∀ args idx decls, decls = b.locals →
      initEnumLocalsLoop pOut.enumDefs b args idx decls =
        initEnumLocalsLoop pSrc.enumDefs b args idx decls) := by
  have hbTgt : Trusted.MirSemantics.getElem? ctx.bodiesTgt defId = some b := by
    rw [ctx.hPOut] at hb; exact hb
  rw [ctx.hPOut]
  dsimp
  cases hStill : ctx.bodiesTgt.any (fun b => b.locals.any isAdtEnumDecl) with
  | true =>
    dsimp
    exact ⟨fun _ _ _ => rfl, fun _ _ _ => rfl, fun _ _ _ => rfl, fun _ _ _ _ => rfl⟩
  | false =>
    dsimp
    have hBNoAdt : b.locals.any isAdtEnumDecl = false :=
      list_any_false_getElem? (p := fun b : EnumBody => b.locals.any isAdtEnumDecl) hStill hbTgt
    refine ⟨fun f cm st => evalEnumStmt_congr_no_adtEnum pSrc.enumDefs b f cm st hBNoAdt,
            fun bb f cm => evalEnumTerminator_congr_no_adtEnum pSrc.enumDefs b bb f cm hBNoAdt,
            fun idx decls hd => by
              subst hd
              exact allEnumLocalsSupported_congr_no_adtEnum pSrc.enumDefs b.argumentCount idx b.locals hBNoAdt,
            fun args idx decls hd => by
              subst hd
              exact initEnumLocalsLoop_congr_no_adtEnum pSrc.enumDefs b args idx b.locals hBNoAdt⟩

private noncomputable def ScalarizeStateRel {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) (s₁ s₂ : EnumState) : Prop :=
  s₁.callerMem = s₂.callerMem ∧
  ∃ f₁ f₂ : EnumFrame,
    s₁.frames = [f₁] ∧
    s₂.frames = [f₂] ∧
    f₂.defId = f₁.defId ∧
    if f₁.defId = plan.defId then
      ∃ bb : EnumBlock,
        Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb ∧
        f₂.blockIdx = f₁.blockIdx ∧
        f₁.stmtIdx ≤ bb.statements.length ∧
        f₂.stmtIdx = (listFlatMap
          (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
          (bb.statements.take f₁.stmtIdx)).length ∧
        PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals ∧
        ∃ sl : EnumSlot,
          Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl ∧
          SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals
    else
      f₂ = f₁

private theorem scalarizeCtx_target_decl_lookup {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) :
    let base := ctx.body.locals.length
    let bodyTgt := scalarizeTargetBody ctx
    bodyTgt.locals.length = base + ctx.compTys.length ∧
    Trusted.MirSemantics.getElem? bodyTgt.locals plan.enumLocal = some (.base .unit) ∧
    (∀ j, j < base → j ≠ plan.enumLocal →
      Trusted.MirSemantics.getElem? bodyTgt.locals j =
        Trusted.MirSemantics.getElem? ctx.body.locals j) ∧
    (∀ i ty, Trusted.MirSemantics.getElem? ctx.compTys i = some ty →
      Trusted.MirSemantics.getElem? bodyTgt.locals (base + i) = some (.base ty)) := by
  dsimp [scalarizeTargetBody]
  have hTombLen : ctx.localsTombstoned.length = ctx.body.locals.length :=
    setElem?_length ctx.hSetLoc
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [list_append_length, list_map_length, hTombLen]
  · have hLtT : plan.enumLocal < ctx.localsTombstoned.length := by
      rw [hTombLen]; exact ctx.hEnumLtBase
    rw [getElem?_append_left hLtT]
    exact setElem?_getElem?_same ctx.hSetLoc
  · intro j hjLt hjNe
    have hjLtT : j < ctx.localsTombstoned.length := by rw [hTombLen]; exact hjLt
    rw [getElem?_append_left hjLtT, setElem?_getElem?_ne ctx.hSetLoc hjNe]
  · intro i ty hi
    have hEqL : ctx.body.locals.length + i = ctx.localsTombstoned.length + i := by
      rw [hTombLen]
    rw [hEqL, getElem?_append_right ctx.localsTombstoned _ i, getElem?_map, hi]

private theorem listMapOption_eq_prefix {α β : Type} (f : α → Option β) :
    ∀ (k : Nat) (xs ys : List α),
      (∀ i, i < k → Trusted.MirSemantics.getElem? xs i = Trusted.MirSemantics.getElem? ys i) →
      listMapOption f (xs.take k) = listMapOption f (ys.take k)
  | 0, _, _, _ => rfl
  | k + 1, [], [], _ => rfl
  | k + 1, [], _ :: _, h => by have h0 := h 0 (Nat.zero_lt_succ k); cases h0
  | k + 1, _ :: _, [], h => by have h0 := h 0 (Nat.zero_lt_succ k); cases h0
  | k + 1, x :: xs, y :: ys, h => by
    have h0 := h 0 (Nat.zero_lt_succ k)
    injection h0 with hxy; subst hxy
    dsimp [List.take, listMapOption]
    rw [listMapOption_eq_prefix f k xs ys (fun i hi => h (i + 1) (Nat.succ_lt_succ hi))]

private theorem scalarize_initStateEnum_spec {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) :
    (∀ q k, initStateEnum pSrc q = .error k ↔ initStateEnum pOut q = .error k) ∧
    (∀ q s₁ s₂,
      initStateEnum pSrc q = .ok s₁ →
      initStateEnum pOut q = .ok s₂ →
      ScalarizeStateRel ctx s₁ s₂) := by
  have hHdrEq : (!Nat.beq pOut.pointerWidthBits 64 || !Nat.beq pOut.mirProfileVersion 1) =
      (!Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1) := by
    rw [ctx.hPOut]
  have hEntryEq : pOut.entryDefId = pSrc.entryDefId := by rw [ctx.hPOut]
  have hEdsOutAdm : pOut.enumDefs.all adtEnumDefAdmitted = true := by
    rw [ctx.hPOut]; dsimp
    cases ctx.bodiesTgt.any (fun b => b.locals.any isAdtEnumDecl) with
    | true => exact ctx.hAllEdsAdm
    | false => rfl
  have hForQ : ∀ q : Query,
      (∀ k, initStateEnum pSrc q = .error k ↔ initStateEnum pOut q = .error k) ∧
      (∀ s₁ s₂, initStateEnum pSrc q = .ok s₁ → initStateEnum pOut q = .ok s₂ →
        ScalarizeStateRel ctx s₁ s₂) := by
    intro q
    unfold initStateEnum
    rw [hHdrEq, hEntryEq, ctx.hAllEdsAdm, hEdsOutAdm]
    cases (!Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1) with
    | true => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
    | false =>
      dsimp
      cases (!q.callerMem.allocations.isEmpty) with
      | true => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
      | false =>
        dsimp
        cases hEqDef : Nat.beq pSrc.entryDefId plan.defId with
        | false =>
          have hNeDef : pSrc.entryDefId ≠ plan.defId := nat_ne_of_beq_false hEqDef
          have hBGetEq : Trusted.MirSemantics.getElem? pOut.bodies pSrc.entryDefId =
              Trusted.MirSemantics.getElem? pSrc.bodies pSrc.entryDefId := by
            rw [ctx.hPOut]; dsimp
            exact setElem?_getElem?_ne ctx.hSetBody hNeDef
          rw [hBGetEq]
          cases hbS : Trusted.MirSemantics.getElem? pSrc.bodies pSrc.entryDefId with
          | none => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
          | some bOther =>
            have hbOut : Trusted.MirSemantics.getElem? pOut.bodies pSrc.entryDefId = some bOther :=
              hBGetEq.trans hbS
            let ⟨_, _, hAllSupEq, hInitLoopEq⟩ := scalarizeCtx_enumDefs_step_eq ctx hbOut
            dsimp
            rw [hAllSupEq 0 bOther.locals rfl, hInitLoopEq q.args 0 bOther.locals rfl]
            cases bOther.basicBlocks.isEmpty with
            | true => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
            | false =>
              dsimp
              cases (!Nat.blt bOther.argumentCount bOther.locals.length) with
              | true => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
              | false =>
                dsimp
                cases (!enumStorageAnnotationsInBounds bOther) with
                | true => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
                | false =>
                  dsimp
                  cases (!allEnumLocalsSupported pSrc.enumDefs bOther.argumentCount 0 bOther.locals) with
                  | true => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
                  | false =>
                    dsimp
                    cases enumParamBaseTys? bOther with
                    | none => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
                    | some pTys =>
                      dsimp
                      cases (!checkArgsMatch q.args pTys) with
                      | true => dsimp; exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
                      | false =>
                        dsimp
                        cases initEnumLocalsLoop pSrc.enumDefs bOther q.args 0 bOther.locals with
