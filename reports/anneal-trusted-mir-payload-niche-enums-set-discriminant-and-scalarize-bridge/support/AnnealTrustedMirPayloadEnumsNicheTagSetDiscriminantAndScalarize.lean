            have hSBndMid : sBase + vd.fields.length ≤ s2Mid.length := by
              rw [hLenMid, ← hOpsLen]; exact hsBaseBnd
            let ⟨s2Pay, hRMv, hLenPay, hOutMv, hPayMv, _⟩ :=
              exec_mkMoveScratchToPayload (p₂ := pOut) (body₂ := bodyTgt) (bb₂ := bbTgt)
                (defId := f₂.defId) (blockIdx := f₂.blockIdx) (cm := cm)
                hB2 hBB2 vd.fields vals sBase pBase preL (stTag :: postStmts) s2Mid
                hValsLen hDisjPS hSBndMid hStMv
                (fun i ty hi => by
                  have hArS : sBase + i = base + 3 + allFs.length + (vOff + i) :=
