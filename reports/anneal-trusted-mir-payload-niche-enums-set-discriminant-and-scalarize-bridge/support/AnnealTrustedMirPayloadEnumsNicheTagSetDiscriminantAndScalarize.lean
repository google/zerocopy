                        rw [hNe0, hBleArg]
                        dsimp
                        let slE1 : EnumSlot :=
                          if enumHasStorageAnnotation ctx.body idx then .enumDead else slLiveE
                        let slE2 : EnumSlot :=
                          if enumHasStorageAnnotation ctx.body idx then .baseSlot .dead
                          else .baseSlot (.live (some .unit))
                        have hHead1 : (if enumHasStorageAnnotation ctx.body idx
                            then some EnumSlot.enumDead
                            else liveUninitEnumSlot pSrc.enumDefs (.adtEnum ctx.eIdx)) =
                            some slE1 := by
                          dsimp [slE1]
                          cases enumHasStorageAnnotation ctx.body idx with
                          | true => rfl
                          | false => exact hLiveEEq
                        have hHead2 : (if enumHasStorageAnnotation ctx.body idx
                            then some (EnumSlot.baseSlot .dead)
                            else liveUninitEnumSlot pSrc.enumDefs (.base .unit)) =
                            some slE2 := by
                          dsimp [slE2]
                          cases enumHasStorageAnnotation ctx.body idx <;> rfl
                        rw [hHead1, hHead2]
                        cases hT1 : initEnumLocalsLoop pSrc.enumDefs ctx.body q.args (idx + 1) restX with
                        | none =>
                          have hT2 : initEnumLocalsLoop pSrc.enumDefs bodyTgt q.args (idx + 1)
                              (restY ++ ctx.compTys.map EnumLocalDecl.base) = none :=
                            ihNone.mp hT1
                          rw [hT2]
                          exact ⟨⟨fun _ => rfl, fun _ => rfl⟩, fun _ _ h => by cases h⟩
                        | some tl1 =>
                          cases hT2 : initEnumLocalsLoop pSrc.enumDefs bodyTgt q.args (idx + 1)
                              (restY ++ ctx.compTys.map EnumLocalDecl.base) with
                          | none =>
                            exact False.elim (by have hC := ihNone.mpr hT2; rw [hT1] at hC; cases hC)
                          | some tl2All =>
                            let ⟨tl2Pre, hTl2Eq, hLen1, hLen2, hAgTl, _⟩ :=
                              ihSome tl1 tl2All hT1 hT2
                            refine ⟨⟨(fun h => by cases h), (fun h => by cases h)⟩, ?_⟩
                            intro s1Pre s2All hs1 hs2
                            injection hs1 with e1; injection hs2 with e2
                            subst e1; subst e2; subst hTl2Eq
                            refine ⟨slE2 :: tl2Pre, rfl,
                                    congrArg Nat.succ hLen1, congrArg Nat.succ hLen2, ?_, ?_⟩
                            · intro k hkLT hkNe
                              cases k with
                              | zero =>
                                rw [Nat.add_zero] at hkNe
                                exact False.elim (hkNe hEqI)
                              | succ k' =>
                                have hAr : idx + (k' + 1) = idx + 1 + k' := by
                                  rw [Nat.add_assoc, Nat.add_comm 1 k']
                                rw [hAr] at hkLT hkNe
                                exact hAgTl k' hkLT hkNe
                            · intro k hkEq
                              cases k with
                              | zero =>
                                rw [← hEqI]
                                exact hHead1.symm
                              | succ k' =>
                                exact False.elim (by
                                  have hGt : idx < idx + (k' + 1) :=
                                    Nat.lt_add_of_pos_right (Nat.zero_lt_succ k')
                                  rw [hkEq, ← hEqI] at hGt
                                  exact Nat.lt_irrefl idx hGt)
                let ⟨hWNone, hWSome⟩ := hInitWalk 0 ctx.body.locals ctx.localsTombstoned
                  (setElem?_length ctx.hSetLoc).symm
                  (Nat.zero_add _)
                  (fun k hk => by
                    rw [Nat.zero_add] at hk
                    rw [Nat.zero_add]
                    refine ⟨fun hNe => setElem?_getElem?_ne ctx.hSetLoc hNe, ?_⟩
                    intro hEq; subst hEq
                    exact ⟨ctx.hEnumDecl, setElem?_getElem?_same ctx.hSetLoc⟩)
                have hBodyTgtLocsDef : bodyTgt.locals =
                    ctx.localsTombstoned ++ ctx.compTys.map EnumLocalDecl.base := rfl
                rw [hBodyTgtLocsDef]
                cases hLoop1 : initEnumLocalsLoop pSrc.enumDefs ctx.body q.args 0 ctx.body.locals with
                | none =>
                  have hLoop2 : initEnumLocalsLoop pSrc.enumDefs bodyTgt q.args 0
                      (ctx.localsTombstoned ++ ctx.compTys.map EnumLocalDecl.base) = none :=
                    hWNone.mp hLoop1
                  rw [hLoop2]
                  dsimp
                  exact ⟨fun _ => Iff.rfl, fun _ _ h => by cases h⟩
                | some slots₁ =>
                  cases hLoop2 : initEnumLocalsLoop pSrc.enumDefs bodyTgt q.args 0
                      (ctx.localsTombstoned ++ ctx.compTys.map EnumLocalDecl.base) with
                  | none =>
                    exact False.elim (by have hC := hWNone.mpr hLoop2; rw [hLoop1] at hC; cases hC)
                  | some slots₂ =>
                    dsimp
                    refine ⟨fun _ => ⟨(fun h => by cases h), (fun h => by cases h)⟩, ?_⟩
                    intro s₁ s₂ hs1 hs2
                    injection hs1 with e1; injection hs2 with e2
                    subst e1; subst e2
                    let ⟨s2Pre, hS2Eq, hLenS1, hLenS2Pre, hAgPre, hESlot⟩ :=
                      hWSome slots₁ slots₂ hLoop1 hLoop2
                    have hSlots2Len : slots₂.length = ctx.body.locals.length + ctx.compTys.length := by
                      rw [hS2Eq, list_append_length, hLenS2Pre, hCompSlotsLen]
                    have hPreAgree : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal
                        slots₁ slots₂ := by
                      refine ⟨hLenS1, by rw [hSlots2Len]; exact Nat.le_add_right _ _, ?_⟩
                      intro j hjLt hjNe
                      have hjS2 : j < s2Pre.length := by rw [hLenS2Pre]; exact hjLt
                      rw [hS2Eq, getElem?_append_left hjS2]
                      exact hAgPre j (by rw [Nat.zero_add]; exact hjLt)
                        (by rw [Nat.zero_add]; exact hjNe)
                    have hCompGet : ∀ i ty, Trusted.MirSemantics.getElem? ctx.compTys i = some ty →
                        Trusted.MirSemantics.getElem? slots₂ (ctx.body.locals.length + i) =
                          some (if enumHasStorageAnnotation bodyTgt (ctx.body.locals.length + i)
                                then .baseSlot .dead
                                else .baseSlot (.live (initFieldOptVal ty))) := by
                      intro i ty hi
                      have hLhs : Trusted.MirSemantics.getElem? slots₂ (ctx.body.locals.length + i) =
                          Trusted.MirSemantics.getElem? compSlots i := by
                        rw [hS2Eq, ← hLenS2Pre, getElem?_append_right s2Pre compSlots i]
                      rw [hLhs]
                      have h0i : 0 + i = i := Nat.zero_add i
                      have hRes := hCompSlotsGet i ty hi
                      rw [h0i] at hRes
                      exact hRes
                    have hBB0 : ∃ bb₀, Trusted.MirSemantics.getElem? ctx.body.basicBlocks 0 = some bb₀ := by
                      have hBBN := ctx.hBBNonEmpty
                      cases hbbs : ctx.body.basicBlocks with
                      | nil => rw [hbbs] at hBBN; cases hBBN
                      | cons bb₀ _ => exact ⟨bb₀, rfl⟩
                    let ⟨bb₀, hbb0Get⟩ := hBB0
                    refine ⟨rfl, _, _, rfl, rfl, rfl, ?_⟩
                    dsimp
                    rw [if_true_of_prop rfl]
                    refine ⟨bb₀, hbb0Get, rfl, Nat.zero_le _, rfl, hPreAgree, ?_⟩
                    have hES1 := hESlot plan.enumLocal (Nat.zero_add _)
                    cases hAnnE : enumHasStorageAnnotation ctx.body plan.enumLocal with
                    | true =>
                      rw [hAnnE] at hES1
                      dsimp at hES1
                      refine ⟨.enumDead, hES1, hSlots2Len, ?_⟩
                      have h0LtNonScr : 0 < nonScratchCompCount ctx.ed :=
                        Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) h2LeNonScr
                      have h0LtComp : 0 < ctx.compTys.length :=
                        Nat.lt_of_lt_of_le h0LtNonScr hNonScrLeComp
                      cases hc : ctx.compTys with
                      | nil => rw [hc] at h0LtComp; cases h0LtComp
                      | cons ty0 _ =>
                        have hC0 := hCompGet 0 ty0 (by rw [hc]; rfl)
                        rw [hAnnNonScrEq 0 h0LtNonScr, hAnnE, Nat.add_zero] at hC0
                        exact hC0
                    | false =>
                      rw [hAnnE] at hES1
                      dsimp at hES1
                      let ⟨slInit, hSlInitEq, hSlInitMatch⟩ :=
                        liveUninitEnumSlot_matches_liveComp
                          ctx.hEdGet ctx.hEdAdm ctx.hComp hSlots2Len
                          (fun i ty hi hTy => by
                            have hCi := hCompGet i ty hTy
                            rw [hAnnNonScrEq i hi, hAnnE] at hCi
                            exact hCi)
                      rw [hSlInitEq] at hES1
                      exact ⟨slInit, hES1, hSlInitMatch⟩
  exact ⟨fun q k => (hForQ q).1 k, fun q s₁ s₂ h1 h2 => (hForQ q).2 s₁ s₂ h1 h2⟩

private theorem directTagEnumTy_readDiscr
    {ed : AdtEnumDef} {tagW : IntWidth} {tagS : Bool}
    {decls : List EnumLocalDecl} {slots : List EnumSlot}
    {tagLoc : LocalId} {dstTy : MirTy}
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .direct tagW tagS)
    (hDecl : Trusted.MirSemantics.getElem? decls tagLoc =
      some (.base (.enum (directTagEnumTy ed tagW tagS)))) :
    (Trusted.MirSemantics.getElem? slots tagLoc = some (.baseSlot (.live none)) →
      evalEnumBaseRvalue decls slots dstTy
        (.discriminant { localId := tagLoc, projection := [] }) = .error .undefined) ∧
    (∀ v vd,
      Trusted.MirSemantics.getElem? ed.variants v = some vd →
      Trusted.MirSemantics.getElem? slots tagLoc =
        some (.baseSlot (.live (some (.enumVal (directTagEnumTy ed tagW tagS) v)))) →
      evalEnumBaseRvalue decls slots dstTy
        (.discriminant { localId := tagLoc, projection := [] }) =
        .ok (.scalar ⟨ed.discrWidth, ed.discrSigned,
          truncateBits ed.discrWidth (BitVec.ofNat 128 vd.discrVal)⟩, slots)) := by
  let ety := directTagEnumTy ed tagW tagS
  have hEA : enumAdmitted ety = true := by
    unfold adtEnumDefAdmitted at hAdm
    rw [hLay] at hAdm
    exact (bool_and_true hAdm).2
  refine ⟨?_, ?_⟩
  · intro hSlot
    unfold evalEnumBaseRvalue
    dsimp [List.isEmpty]
    rw [hDecl, hSlot]
    dsimp
    rw [hEA]
    dsimp [ety, directTagEnumTy]
  · intro v vd hvGet hSlot
    have hDGet : Trusted.MirSemantics.getElem? ety.discriminants v = some vd.discrVal := by
      change Trusted.MirSemantics.getElem? (ed.variants.map (fun x => x.discrVal)) v = _
      rw [getElem?_map, hvGet]
    have hvBlt : Nat.blt v ety.discriminants.length = true :=
      nat_lt_blt (getElem?_some_lt hDGet)
    unfold evalEnumBaseRvalue
    dsimp [List.isEmpty]
    rw [hDecl, hSlot]
    dsimp
    rw [hEA]
    dsimp
    change (if EnumTy.beq ety ety && Nat.blt v ety.discriminants.length then
        match Trusted.MirSemantics.getElem? ety.discriminants v with
        | some disc =>
          Except.ok (Val.scalar ⟨ety.discrWidth, ety.discrSigned,
            truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩, slots)
        | none => Except.error FaultKind.unsupported
      else Except.error FaultKind.unsupported) = _
    rw [enumTy_beq_refl ety, hvBlt, hDGet]
    rfl

