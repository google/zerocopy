                .step { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2End }],
                        callerMem := cm } := by
              rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 })
                    hB2 hBB2 hStZ hPre1Len.symm, hStepEqDefs]
              dsimp [stZ]
              unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot; dsimp
              rw [hDeclDstTgt]; dsimp
              rw [hEvCL]; dsimp
              rw [mirTy_beq_refl fTy]; dsimp
              rw [hW2]
            have hSl1End : Trusted.MirSemantics.getElem? s1End plan.enumLocal =
                some (.liveNiche nb extras) :=
              (s3d_writeEnumBasePlace_preserves_ne (fun h => hDstNe h.symm) hW1).trans hSl1
            have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveNiche nb extras) s2End :=
              s3d2_slotMatchesComp_congr_nonScratch hMatch hLenEnd
                (fun k hkGe _ => hOutEnd k (Or.inr hkGe))
            have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
              (hF2Idx.trans (congrArg List.length hPreEq)) hPreEnd hSl1End hMatchEnd
              (fun _ _ _ h => by cases h)
            dsimp [lowerEnumStmt] at hPost
            rw [nat_beq_refl] at hPost; dsimp at hPost
            rw [hLay, hvGet] at hPost; dsimp at hPost
            rw [hfGet, huGet] at hPost; dsimp at hPost
            rw [hBU, hInN] at hPost; dsimp at hPost
            cases fTy with
            | bool | int _ _ | tuple _ | ref _ _ | rawPtr _ _ | never | unsupported =>
              dsimp [isZstBaseTy] at hZst; cases hZst
            | unit =>
              dsimp [List.length] at hPost
              rw [hF2Idx] at hPost
              exact simStep1 hEv1 hStep2 hPost
            | enum ety =>
              dsimp [isZstBaseTy] at hZst
              dsimp at hPost; rw [hZst] at hPost; dsimp [List.length] at hPost
              rw [hF2Idx] at hPost
              exact simStep1 hEv1 hStep2 hPost

/-! ### 3. Target `enumLocal` Simulation for `aggregateEnum` -/

private theorem s3d2b_aggregateEnum_enumLocal_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb bbTgt : EnumBlock}
    {preStmts postStmts : List EnumStmt}
    {v : Nat} {ops : List Operand} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx =
      some (.aggregateEnum plan.enumLocal v ops))
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hPreEq : preStmts =
      listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx))
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hBbTgtStmts : bbTgt.statements =
      preStmts ++
        lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed
          (.aggregateEnum plan.enumLocal v ops) ++
        postStmts)
    (hStChk : checkStmtForEnumLocal ctx.body.locals plan.enumLocal ctx.ed
      (.aggregateEnum plan.enumLocal v ops) = true)
    (hStBnd : enumStmtLocalsInBounds ctx.body.locals.length
      (.aggregateEnum plan.enumLocal v ops) = true)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals)
    (_hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm }) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumStmt pSrc.enumDefs ctx.body f₁ cm (.aggregateEnum plan.enumLocal v ops)) := by
  let base := ctx.body.locals.length
  let bodyTgt := scalarizeTargetBody ctx
  let ⟨hDeclLive, hDeclFault⟩ := s3d_compDecls_common ctx
  let ⟨_, _, hDeclPre, _⟩ := scalarizeCtx_target_decl_lookup ctx
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  have hOpsBnd : ops.all (operandLocalsInBounds base) = true := (bool_and_true hStBnd).2
  unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
  rw [nat_beq_refl] at hStChk; dsimp at hStChk
  let ⟨hNoAnyB, hVarLenB⟩ := bool_and_true hStChk
  have hOpsNoM : ops.any (stmtMentionsLocalOperand plan.enumLocal) = false :=
    bool_not_true hNoAnyB
  have hVarLen : ∃ vd,
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd ∧
      ops.length = vd.fields.length := by
    cases hv : Trusted.MirSemantics.getElem? ctx.ed.variants v with
    | none => rw [hv] at hVarLenB; cases hVarLenB
    | some vd =>
      rw [hv] at hVarLenB
      exact ⟨vd, rfl, nat_beq_eq hVarLenB⟩
  let ⟨vd, hvGet, hOpsLen⟩ := hVarLen
  dsimp [lowerEnumStmt] at hBbTgtStmts
  rw [nat_beq_refl] at hBbTgtStmts; dsimp at hBbTgtStmts
  cases hLay : ctx.ed.layout with
  | empty =>
    have hEmpty : ctx.ed.variants.isEmpty = true := by
      have hA := ctx.hEdAdm; unfold adtEnumDefAdmitted at hA; rw [hLay] at hA
      exact (bool_and_true hA).2
    cases hVs : ctx.ed.variants with
    | nil => rw [hVs] at hvGet; cases hvGet
    | cons _ _ => rw [hVs] at hEmpty; cases hEmpty
  | single =>
    let ⟨vd₀, hv0Get, hLen1, hCompLen, hFieldDecls⟩ := s3d_compDecls_single ctx hLay
    have hvZero : v = 0 := by
      have hvLt1 : v < 1 := by rw [← hLen1]; exact getElem?_some_lt hvGet
      cases v with
      | zero => rfl
      | succ v' => exact False.elim (Nat.not_lt_zero v' (Nat.lt_of_succ_lt_succ hvLt1))
    subst hvZero
    rw [hv0Get] at hvGet; injection hvGet with hvdEq; subst hvdEq
    rw [hLay, hv0Get] at hBbTgtStmts; dsimp at hBbTgtStmts
    let pBase := base + 2
    let sBase := base + 2 + vd₀.fields.length
    let tailU : List EnumStmt :=
      if variantIsUninhabited vd₀ then [mkImmediateUbStmt (base + 1)]
      else mkMoveScratchToPayload sBase pBase vd₀.fields.length
    have hStEval : bbTgt.statements =
        preStmts ++ mkEvalOpsToScratch sBase ops ++ (mkLivenessCheckStmt base :: (tailU ++ postStmts)) := by
      dsimp [tailU]
      rw [hBbTgtStmts]
      exact s3d2b_reassoc_evalOps preStmts (mkEvalOpsToScratch sBase ops)
        (mkLivenessCheckStmt base) _ postStmts
    have hsBaseGeNonScr : base + nonScratchCompCount ctx.ed = sBase := by
      unfold nonScratchCompCount; rw [hLay]; dsimp; rw [hv0Get]
      exact (Nat.add_assoc base 2 vd₀.fields.length).symm
    have hsBaseGe : base ≤ sBase := by
      rw [← hsBaseGeNonScr]; exact Nat.le_add_right base _
    have hsBaseBnd : sBase + ops.length ≤ f₂.locals.length := by
      rw [hMatch.1, hCompLen, hOpsLen]
      dsimp [sBase, base]
      rw [← Nat.add_assoc ctx.body.locals.length (2 + vd₀.fields.length) vd₀.fields.length,
          ← Nat.add_assoc ctx.body.locals.length 2 vd₀.fields.length]
      exact Nat.le_refl _
    let ⟨hEvErr, hEvOk⟩ := exec_mkEvalOpsToScratch
      (p₂ := pOut) (body₁ := ctx.body) (body₂ := bodyTgt) (bb₂ := bbTgt)
      (defId := f₂.defId) (blockIdx := f₂.blockIdx) (cm := cm)
      ctx.hEnumLtBase hDeclPre hB2 hBB2 ops vd₀.fields sBase
      preStmts (mkLivenessCheckStmt base :: (tailU ++ postStmts))
      f₁.locals f₂.locals hOpsLen hsBaseGe hsBaseBnd hStEval hPre hOpsBnd hOpsNoM
      (fun i ty hi => (hFieldDecls i ty hi).2)
    cases hEvOps : evalAggregateEnumOperands ctx.body.locals f₁.locals ops vd₀.fields with
    | error fk =>
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.aggregateEnum plan.enumLocal 0 ops) = .fault fk := by
        unfold evalEnumStmt; dsimp
        rw [hOpsNoM]; dsimp
        rw [ctx.hEnumDecl]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [ctx.hEdAdm, hv0Get]; dsimp
        rw [hEvOps]
      let ⟨sF, hRF, hEvF⟩ := hEvErr fk hEvOps
      rw [← hF2Idx] at hRF
      exact simFaultR hEv1 hRF hEvF
    | ok pr =>
      cases pr with
      | mk vals s1Mid =>
        let ⟨s2Mid, hROps, hLenMid, hPreMid, hValsLen, hPresMid, hScrMid⟩ :=
          hEvOk vals s1Mid hEvOps
        have hSl1Mid : Trusted.MirSemantics.getElem? s1Mid plan.enumLocal = some sl :=
          (s3d_evalAggregateEnumOperands_preserves_enumLocal ops vd₀.fields f₁.locals hOpsNoM hEvOps).trans hSl1
        have hMatchMid : SlotMatchesComp ctx.ed base ctx.compTys sl s2Mid := by
          apply s3d2_slotMatchesComp_congr_nonScratch hMatch hLenMid
          intro k hkGe hkLt
          rw [hsBaseGeNonScr] at hkLt
          exact hPresMid k (Or.inr (Or.inl ⟨hkGe, hkLt⟩))
        have hROpsF2 : ReachesNEnum pOut (2 * ops.length)
            { frames := [f₂], callerMem := cm }
            { frames := [{ f₂ with stmtIdx := preStmts.length + 2 * ops.length, locals := s2Mid }],
              callerMem := cm } := by
          have hStart : ({ frames := [{ defId := f₂.defId, blockIdx := f₂.blockIdx,
                                        stmtIdx := preStmts.length, locals := f₂.locals }],
                           callerMem := cm } : EnumState) =
              { frames := [f₂], callerMem := cm } := by
            rw [← hF2Idx]
          rw [← hStart]; exact hROps
        refine simStepResult_prepend_reachesN hROpsF2 ?_
        let preOps := preStmts ++ mkEvalOpsToScratch sBase ops
        have hEvalLen : (mkEvalOpsToScratch sBase ops).length = 2 * ops.length := by
          have hGen : ∀ (sb : Nat) (xs : List Operand),
              (mkEvalOpsToScratch sb xs).length = 2 * xs.length := by
            intro sb xs
            induction xs generalizing sb with
            | nil => rfl
            | cons _ tl ih =>
              dsimp [mkEvalOpsToScratch, List.length]
              rw [ih (sb + 1), Nat.mul_succ]
          exact hGen sBase ops
        have hPreOpsLen : preOps.length = preStmts.length + 2 * ops.length := by
          dsimp [preOps]; rw [list_append_length, hEvalLen]
        cases sl with
        | baseSlot _ => exact False.elim hMatchMid.2
        | liveEmpty => rw [hMatchMid.2.1] at hLay; cases hLay
        | liveDirect _ _ => let ⟨_, _, hL, _⟩ := hMatchMid.2; rw [hL] at hLay; cases hLay
        | liveNiche _ _ =>
          let ⟨_, _, _, _, _, _, _, _, _, hL, _⟩ := hMatchMid.2; rw [hL] at hLay; cases hLay
        | enumDead =>
          have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
              (.aggregateEnum plan.enumLocal 0 ops) = .fault .undefined := by
            unfold evalEnumStmt; dsimp
            rw [hOpsNoM]; dsimp
            rw [ctx.hEnumDecl]; dsimp
            rw [ctx.hEdGet]; dsimp
            rw [ctx.hEdAdm, hv0Get]; dsimp
            rw [hEvOps]; dsimp
            rw [hSl1Mid]
          have hEvDead : evalStepEnum pOut 0
              { frames := [{ f₂ with stmtIdx := preStmts.length + 2 * ops.length, locals := s2Mid }],
                callerMem := cm } = .fault .undefined :=
            (stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2 * ops.length, locals := s2Mid })
              hB2 hBB2 hStEval hPreOpsLen.symm).trans
              ((hStepEqDefs _ cm _).trans (eval_mkLivenessCheckStmt_dead hDeclLive hMatchMid.2))
          exact simFault0 hEv1 hEvDead
        | liveSingle fs =>
          let ⟨_, vd₀', hv0', hfsLen, hLiveSlot, hFsAt⟩ := hMatchMid.2
          rw [hv0Get] at hv0'; injection hv0' with hvEq'; subst hvEq'
          have hStepLive : evalStepEnum pOut 0
              { frames := [{ f₂ with stmtIdx := preStmts.length + 2 * ops.length, locals := s2Mid }],
                callerMem := cm } =
              .step { frames := [{ f₂ with stmtIdx := preStmts.length + 2 * ops.length + 1, locals := s2Mid }],
                      callerMem := cm } := by
            rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2 * ops.length, locals := s2Mid })
                  hB2 hBB2 hStEval hPreOpsLen.symm,
                hStepEqDefs, eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot]
          let preL := preOps ++ [mkLivenessCheckStmt base]
          have hPreLLen : preL.length = preStmts.length + 2 * ops.length + 1 := by
            dsimp [preL]; rw [list_append_length, hPreOpsLen]; rfl
          have hStTail : bbTgt.statements = preL ++ tailU ++ postStmts := by
            dsimp [preL]; rw [hStEval]
            change preOps ++ ([mkLivenessCheckStmt base] ++ (tailU ++ postStmts)) = _
            rw [← List.append_assoc preOps [mkLivenessCheckStmt base] (tailU ++ postStmts),
                ← List.append_assoc (preOps ++ [mkLivenessCheckStmt base]) tailU postStmts]
          cases hUninh : variantIsUninhabited vd₀ with
          | true =>
            refine simStepResult_prepend_step hStepLive ?_
            dsimp [tailU] at hStTail; rw [hUninh] at hStTail; dsimp at hStTail
            have hStUb : bbTgt.statements = preL ++ (mkImmediateUbStmt (base + 1)) :: postStmts := by
              rw [hStTail, List.append_assoc]; rfl
            have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
                (.aggregateEnum plan.enumLocal 0 ops) = .fault .undefined := by
              unfold evalEnumStmt; dsimp
              rw [hOpsNoM]; dsimp
              rw [ctx.hEnumDecl]; dsimp
              rw [ctx.hEdGet]; dsimp
              rw [ctx.hEdAdm, hv0Get]; dsimp
              rw [hEvOps]; dsimp
              rw [hSl1Mid]; dsimp
              rw [hUninh]; rfl
            have hEvUb : evalStepEnum pOut 0
                { frames := [{ f₂ with stmtIdx := preStmts.length + 2 * ops.length + 1, locals := s2Mid }],
                  callerMem := cm } = .fault .undefined :=
              (stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2 * ops.length + 1, locals := s2Mid })
                hB2 hBB2 hStUb hPreLLen.symm).trans
                ((hStepEqDefs _ cm _).trans (eval_mkImmediateUbStmt hDeclFault))
            exact simFault0 hEv1 hEvUb
          | false =>
            dsimp [tailU] at hStTail; rw [hUninh] at hStTail; dsimp at hStTail
            let ⟨fs', hSeq1, hfs'Len, _, hfs'Suf⟩ :=
              s3d_writeAdtFieldsSeq_single ctx.hEdAdm vd₀.fields vals 0 fs
                hValsLen (by rw [Nat.zero_add]; exact hfsLen.symm)
                (fun k ty val hkT hkV => (hScrMid k ty val hkT hkV).1)
            have hDiscr1 : writeAdtDiscriminant ctx.ed 0 (.liveSingle fs') = .ok (.liveSingle fs') := by
              unfold writeAdtDiscriminant
              rw [ctx.hEdAdm]; dsimp
              rw [hv0Get]; dsimp
              rw [hUninh, hLay]; rfl
            let ⟨s1End, hSet1End⟩ := setElem?_some_of_lt s1Mid plan.enumLocal
              (.liveSingle fs') (getElem?_some_lt hSl1Mid)
            have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
                (.aggregateEnum plan.enumLocal 0 ops) =
                .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := s1End }],
                        callerMem := cm } := by
              unfold evalEnumStmt; dsimp
              rw [hOpsNoM]; dsimp
              rw [ctx.hEnumDecl]; dsimp
              rw [ctx.hEdGet]; dsimp
              rw [ctx.hEdAdm, hv0Get]; dsimp
              rw [hEvOps]; dsimp
              rw [hSl1Mid]; dsimp
              rw [hUninh]; dsimp
              rw [hSeq1]; dsimp
              rw [hDiscr1]; dsimp
              rw [hSet1End]
            have hDisjPS : pBase + vd₀.fields.length ≤ sBase := Nat.le_refl _
            have hSBndMid : sBase + vd₀.fields.length ≤ s2Mid.length := by
              rw [hLenMid, ← hOpsLen]; exact hsBaseBnd
            let ⟨s2End, hRMv, hLenEnd, hOutMv, hPayMv, _⟩ :=
              exec_mkMoveScratchToPayload (p₂ := pOut) (body₂ := bodyTgt) (bb₂ := bbTgt)
                (defId := f₂.defId) (blockIdx := f₂.blockIdx) (cm := cm)
                hB2 hBB2 vd₀.fields vals sBase pBase preL postStmts s2Mid
                hValsLen hDisjPS hSBndMid hStTail
                (fun i ty hi => ⟨(hFieldDecls i ty hi).2, (hFieldDecls i ty hi).1⟩)
                hScrMid
                (fun i hi => by
                  let ⟨ov, hgi⟩ := getElem?_some_of_lt fs i (by rw [hfsLen]; exact hi)
                  exact ⟨ov, hFsAt i ov hgi⟩)
            rw [hPreLLen] at hRMv
            have hPreEnd : PrefixSlotsAgree base plan.enumLocal s1End s2End := by
              refine ⟨(setElem?_length hSet1End).trans hPreMid.1,
                      by rw [hLenEnd]; exact hPreMid.2.1, ?_⟩
              intro j hjLt hjNe
              have hjLtP : j < pBase := Nat.lt_of_lt_of_le hjLt (Nat.le_add_right base 2)
              have hjLtS : j < sBase := Nat.lt_of_lt_of_le hjLtP (Nat.le_add_right pBase _)
              rw [hOutMv j ⟨Or.inl hjLtP, Or.inl hjLtS⟩,
                  setElem?_getElem?_ne hSet1End hjNe]
              exact hPreMid.2.2 j hjLt hjNe
            have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveSingle fs') s2End := by
              refine ⟨hLenEnd.trans hMatchMid.1, hLay, vd₀, hv0Get, hfs'Len.trans hfsLen, ?_, ?_⟩
              · have hbLtP : base < pBase := Nat.lt_add_of_pos_right (Nat.zero_lt_succ 1)
                have hbLtS : base < sBase := Nat.lt_of_lt_of_le hbLtP (Nat.le_add_right pBase _)
                rw [hOutMv base ⟨Or.inl hbLtP, Or.inl hbLtS⟩]
                exact hLiveSlot
              · intro f ov hf
                have hfLt : f < vd₀.fields.length := by
                  rw [← hfsLen, ← hfs'Len]; exact getElem?_some_lt hf
                let ⟨valF, hValF⟩ := getElem?_some_of_lt vals f (by rw [hValsLen]; exact hfLt)
                have hfsAtF := hfs'Suf f valF hValF
                rw [Nat.zero_add] at hfsAtF
                rw [hfsAtF] at hf; injection hf with hovEq; subst hovEq
                exact hPayMv f valF hfLt hValF
            have hMvLen : (mkMoveScratchToPayload sBase pBase vd₀.fields.length).length =
                vd₀.fields.length := by
              have hGen : ∀ (sb pb k : Nat), (mkMoveScratchToPayload sb pb k).length = k := by
                intro sb pb k
                induction k generalizing sb pb with
                | zero => rfl
                | succ k' ih => dsimp [mkMoveScratchToPayload, List.length]; rw [ih]
              exact hGen sBase pBase vd₀.fields.length
            have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
              (hF2Idx.trans (congrArg List.length hPreEq)) hPreEnd
              (setElem?_getElem?_same hSet1End) hMatchEnd
              (fun _ _ _ h => by cases h)
            dsimp [lowerEnumStmt] at hPost
            rw [nat_beq_refl] at hPost; dsimp at hPost
            rw [hLay, hv0Get] at hPost; dsimp at hPost
            rw [hUninh] at hPost; dsimp at hPost
            rw [list_append_length, list_append_length, hEvalLen, hMvLen] at hPost
            dsimp [List.length] at hPost
            rw [← Nat.add_assoc f₂.stmtIdx (2 * ops.length + 1) vd₀.fields.length,
                ← Nat.add_assoc f₂.stmtIdx (2 * ops.length) 1,
                hF2Idx] at hPost
            exact simStepPlus hEv1 hStepLive hRMv hPost
  | direct tagW tagS =>
    let ⟨hCompLen, hDeclTag, hFieldDecls⟩ := s3d_compDecls_direct ctx hLay
    rw [hLay, hvGet] at hBbTgtStmts; dsimp at hBbTgtStmts
    let allFs := flattenAllVariantFieldTys ctx.ed
    let vOff := directVariantFieldOffset ctx.ed.variants v
    let pBase := base + 3 + vOff
    let sBase := base + 3 + allFs.length + vOff
    let ety := directTagEnumTy ctx.ed tagW tagS
    let tBits := truncateBits tagW (BitVec.ofNat 128 vd.discrVal)
    let cOp : Operand := .constant { ty := .enum ety, lit := .scalar tBits }
    let stTag : EnumStmt := .baseStmt (.assign { localId := base + 2, projection := [] } (.use cOp))
    let tailU : List EnumStmt :=
      if variantIsUninhabited vd then [mkImmediateUbStmt (base + 1)]
      else mkMoveScratchToPayload sBase pBase vd.fields.length ++ [stTag]
    have hStEval : bbTgt.statements =
        preStmts ++ mkEvalOpsToScratch sBase ops ++ (mkLivenessCheckStmt base :: (tailU ++ postStmts)) := by
      dsimp [tailU, stTag, cOp]
      rw [hBbTgtStmts]
      exact s3d2b_reassoc_evalOps preStmts (mkEvalOpsToScratch sBase ops)
        (mkLivenessCheckStmt base) _ postStmts
    have hsBaseGeNonScr : base + nonScratchCompCount ctx.ed ≤ sBase := by
      unfold nonScratchCompCount; rw [hLay]
      dsimp [sBase, allFs]
      rw [Nat.add_assoc base 3 _]
      exact Nat.le_add_right _ vOff
    have hsBaseGe : base ≤ sBase :=
      Nat.le_trans (Nat.le_add_right base _) hsBaseGeNonScr
    have hvOffBnd : vOff + vd.fields.length ≤ allFs.length :=
      directVariantFieldOffset_bound ctx.ed.variants hvGet
    have hsBaseBnd : sBase + ops.length ≤ f₂.locals.length := by
      rw [hMatch.1, hCompLen, hOpsLen]
      dsimp [sBase, base, allFs, vOff]
      rw [Nat.add_assoc (ctx.body.locals.length + 3 + _) _ vd.fields.length,
          ← Nat.add_assoc ctx.body.locals.length (3 + (flattenAllVariantFieldTys ctx.ed).length) _,
          ← Nat.add_assoc ctx.body.locals.length 3 _]
      exact Nat.add_le_add_left hvOffBnd _
    let ⟨hEvErr, hEvOk⟩ := exec_mkEvalOpsToScratch
      (p₂ := pOut) (body₁ := ctx.body) (body₂ := bodyTgt) (bb₂ := bbTgt)
      (defId := f₂.defId) (blockIdx := f₂.blockIdx) (cm := cm)
      ctx.hEnumLtBase hDeclPre hB2 hBB2 ops vd.fields sBase
      preStmts (mkLivenessCheckStmt base :: (tailU ++ postStmts))
      f₁.locals f₂.locals hOpsLen hsBaseGe hsBaseBnd hStEval hPre hOpsBnd hOpsNoM
      (fun i ty hi => by
        have hAr : sBase + i = base + 3 + allFs.length + (vOff + i) :=
          Nat.add_assoc (base + 3 + allFs.length) vOff i
        rw [hAr]
        exact (hFieldDecls v vd i ty hvGet hi).2)
    cases hEvOps : evalAggregateEnumOperands ctx.body.locals f₁.locals ops vd.fields with
    | error fk =>
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.aggregateEnum plan.enumLocal v ops) = .fault fk := by
        unfold evalEnumStmt; dsimp
        rw [hOpsNoM]; dsimp
        rw [ctx.hEnumDecl]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [ctx.hEdAdm, hvGet]; dsimp
        rw [hEvOps]
