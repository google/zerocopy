/-! ## Slice 3d-1: `EnumScalarize` Simulation Helpers, Layout Lookups, Off-Target, & `.baseStmt` / Non-`enumLocal` / `discriminantDirect` Cases -/

/-! ### 1. `DirectTagInhabitedInv`, `ScalarizeSimRel`, & `SimStepResult` Combinators -/

private noncomputable def DirectTagInhabitedInv {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) (s₁ : EnumState) : Prop :=
  ∀ (f₁ : EnumFrame) (v : Nat) (vfs : List (List (Option Val))) (vd : VariantDef),
    s₁.frames = [f₁] →
    f₁.defId = plan.defId →
    Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal =
      some (.liveDirect (some v) vfs) →
    Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
    variantIsUninhabited vd = false

private noncomputable def ScalarizeSimRel {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) (s₁ s₂ : EnumState) : Prop :=
  ScalarizeStateRel ctx s₁ s₂ ∧ DirectTagInhabitedInv ctx s₁

private theorem s3d_liveUninitEnumSlot_not_some_direct (eds : List AdtEnumDef)
    (eIdx v : Nat) (vfs : List (List (Option Val))) :
    liveUninitEnumSlot eds (.adtEnum eIdx) ≠ some (.liveDirect (some v) vfs) := by
  unfold liveUninitEnumSlot
  dsimp
  cases Trusted.MirSemantics.getElem? eds eIdx with
  | none => intro h; cases h
  | some ed0 =>
    dsimp
    cases (!adtEnumDefAdmitted ed0) with
    | true => dsimp; intro h; cases h
    | false =>
      dsimp
      cases ed0.layout with
      | empty => intro h; cases h
      | single =>
        dsimp
        cases Trusted.MirSemantics.getElem? ed0.variants 0 <;> (intro h; cases h)
      | direct _ _ => intro h; cases h
      | niche _ u _ _ _ _ _ _ =>
        dsimp
        cases Trusted.MirSemantics.getElem? ed0.variants u <;> (intro h; cases h)

private theorem s3d_initEnumLocalsLoop_not_some_direct
    (eds : List AdtEnumDef) (body : EnumBody) (args : List Val) :
    ∀ (idx : Nat) (decls : List EnumLocalDecl) (k eIdx v : Nat)
      (vfs : List (List (Option Val))),
      body.argumentCount < idx + k →
      Trusted.MirSemantics.getElem? decls k = some (.adtEnum eIdx) →
      ∀ (slots : List EnumSlot),
        initEnumLocalsLoop eds body args idx decls = some slots →
        Trusted.MirSemantics.getElem? slots k ≠ some (.liveDirect (some v) vfs)
  | _, [], _, _, _, _, _, hDecl, _, _ => by cases hDecl
  | idx, d :: rest, 0, eIdx, v, vfs, hGtArg, hDecl, slots, hInit => by
    injection hDecl with hdEq; subst hdEq
    rw [Nat.add_zero] at hGtArg
    have hPos : 0 < idx := Nat.lt_of_le_of_lt (Nat.zero_le _) hGtArg
    have hNe0 : Nat.beq idx 0 = false :=
      nat_beq_false_of_ne (fun h => by rw [h] at hPos; exact Nat.lt_irrefl 0 hPos)
    have hBle : Nat.ble idx body.argumentCount = false := by
      cases hb : Nat.ble idx body.argumentCount with
      | false => rfl
      | true => exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb) hGtArg)
    revert hInit
    unfold initEnumLocalsLoop
    rw [hNe0, hBle]
    dsimp
    cases enumHasStorageAnnotation body idx with
    | true =>
      dsimp
      cases initEnumLocalsLoop eds body args (idx + 1) rest with
      | none => intro h; cases h
      | some tl =>
        intro hInit; injection hInit with hs; subst hs
        intro hEq; cases hEq
    | false =>
      dsimp
      cases hLU : liveUninitEnumSlot eds (.adtEnum eIdx) with
      | none =>
        cases initEnumLocalsLoop eds body args (idx + 1) rest <;> (intro h; cases h)
      | some slH =>
        cases initEnumLocalsLoop eds body args (idx + 1) rest with
        | none => intro h; cases h
        | some tl =>
          intro hInit; injection hInit with hs; subst hs
          dsimp [Trusted.MirSemantics.getElem?]
          intro hEq
          exact s3d_liveUninitEnumSlot_not_some_direct eds eIdx v vfs (hLU.trans hEq)
  | idx, d :: rest, k + 1, eIdx, v, vfs, hGtArg, hDecl, slots, hInit => by
    let headFn : EnumLocalDecl → Option EnumSlot := fun decl =>
      if Nat.beq idx 0 then liveUninitEnumSlot eds decl
      else if Nat.ble idx body.argumentCount then
        match Trusted.MirSemantics.getElem? args (idx - 1) with
        | some v => some (.baseSlot (.live (some v)))
        | none => some (.baseSlot .dead)
      else if enumHasStorageAnnotation body idx then
        match decl with
        | .base _ => some (.baseSlot .dead)
        | .adtEnum _ => some .enumDead
      else liveUninitEnumSlot eds decl
    unfold initEnumLocalsLoop at hInit
    change (match headFn d, initEnumLocalsLoop eds body args (idx + 1) rest with
      | some sl, some tl => some (sl :: tl) | _, _ => none) = some slots at hInit
    cases hH : headFn d with
    | none => rw [hH] at hInit; cases hInit
    | some slH =>
      rw [hH] at hInit
      cases hT : initEnumLocalsLoop eds body args (idx + 1) rest with
      | none => rw [hT] at hInit; cases hInit
      | some tlSlots =>
        rw [hT] at hInit
        injection hInit with hs; subst hs
        dsimp [Trusted.MirSemantics.getElem?]
        have hAr : (idx + 1) + k = idx + (k + 1) := by
          rw [Nat.add_assoc, Nat.add_comm 1 k]
        exact s3d_initEnumLocalsLoop_not_some_direct eds body args (idx + 1) rest
          k eIdx v vfs (by rw [hAr]; exact hGtArg) hDecl tlSlots hT

private theorem scalarize_initStateEnum_simRel {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) :
    (∀ q k, initStateEnum pSrc q = .error k ↔ initStateEnum pOut q = .error k) ∧
    (∀ q s₁ s₂,
      initStateEnum pSrc q = .ok s₁ →
      initStateEnum pOut q = .ok s₂ →
      ScalarizeSimRel ctx s₁ s₂) := by
  let ⟨hErr, hOk⟩ := scalarize_initStateEnum_spec ctx
  refine ⟨hErr, ?_⟩
  intro q s₁ s₂ h1 h2
  refine ⟨hOk q s₁ s₂ h1 h2, ?_⟩
  have hInv : ∀ s₀, initStateEnum pSrc q = .ok s₀ → DirectTagInhabitedInv ctx s₀ := by
    intro s₀
    unfold initStateEnum
    cases (!Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1) with
    | true => intro h; cases h
    | false =>
      dsimp
      cases (!q.callerMem.allocations.isEmpty) with
      | true => intro h; cases h
      | false =>
        dsimp
        cases (!pSrc.enumDefs.all adtEnumDefAdmitted) with
        | true => intro h; cases h
        | false =>
          dsimp
          cases hb : Trusted.MirSemantics.getElem? pSrc.bodies pSrc.entryDefId with
          | none => intro h; cases h
          | some bEntry =>
            dsimp
            cases bEntry.basicBlocks.isEmpty with
            | true => intro h; cases h
            | false =>
              dsimp
              cases (!Nat.blt bEntry.argumentCount bEntry.locals.length) with
              | true => intro h; cases h
              | false =>
                dsimp
                cases (!enumStorageAnnotationsInBounds bEntry) with
                | true => intro h; cases h
                | false =>
                  dsimp
                  cases (!allEnumLocalsSupported pSrc.enumDefs bEntry.argumentCount 0 bEntry.locals) with
                  | true => intro h; cases h
                  | false =>
                    dsimp
                    cases enumParamBaseTys? bEntry with
                    | none => intro h; cases h
                    | some pTys =>
                      dsimp
                      cases (!checkArgsMatch q.args pTys) with
                      | true => intro h; cases h
                      | false =>
                        dsimp
                        cases hLoop : initEnumLocalsLoop pSrc.enumDefs bEntry q.args 0 bEntry.locals with
                        | none => intro h; cases h
                        | some ls =>
                          dsimp
                          intro hOk0 f₁ v vfs _ hf1 hDef hGetSl _
                          injection hOk0 with hs0
                          rw [← hs0] at hf1
                          dsimp at hf1
                          injection hf1 with hfEq
                          rw [← hfEq] at hDef hGetSl
                          dsimp at hDef hGetSl
                          rw [hDef, ctx.hBodySrc] at hb
                          injection hb with hbEq; subst hbEq
                          exact False.elim (s3d_initEnumLocalsLoop_not_some_direct
                            pSrc.enumDefs ctx.body q.args 0 ctx.body.locals
                            plan.enumLocal ctx.eIdx v vfs
                            (by rw [Nat.zero_add]; exact ctx.hArgLtEnum)
                            ctx.hEnumDecl ls hLoop hGetSl)
  exact hInv s₁ h1

private noncomputable def SimStepResult {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) (s₂ : EnumState) :
    StepResult EnumState TerminalOut → Prop
  | .step s₁' => ∃ s₂', ReachesPlusEnum pOut s₂ s₂' ∧ ScalarizeSimRel ctx s₁' s₂'
  | .done out => ∃ s₂', ReachesEnum pOut s₂ s₂' ∧ evalStepEnum pOut 0 s₂' = .done out
  | .fault fk => ∃ s₂', ReachesEnum pOut s₂ s₂' ∧ evalStepEnum pOut 0 s₂' = .fault fk

private theorem simFault0 {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    {ctx : ScalarizeCtx plan pSrc pOut} {s₂ : EnumState}
    {r : StepResult EnumState TerminalOut} {fk : FaultKind}
    (h1 : r = .fault fk) (h2 : evalStepEnum pOut 0 s₂ = .fault fk) :
    SimStepResult ctx s₂ r := by
  rw [h1]
  exact ⟨s₂, ReachesEnum.refl s₂, h2⟩

private theorem simFaultR {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    {ctx : ScalarizeCtx plan pSrc pOut} {s₂ sF : EnumState}
    {r : StepResult EnumState TerminalOut} {fk : FaultKind}
    (h1 : r = .fault fk)
    (hR : ReachesEnum pOut s₂ sF)
    (h2 : evalStepEnum pOut 0 sF = .fault fk) :
    SimStepResult ctx s₂ r := by
  rw [h1]
  exact ⟨sF, hR, h2⟩

private theorem simDone0 {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    {ctx : ScalarizeCtx plan pSrc pOut} {s₂ : EnumState}
    {r : StepResult EnumState TerminalOut} {out : TerminalOut}
    (h1 : r = .done out) (h2 : evalStepEnum pOut 0 s₂ = .done out) :
    SimStepResult ctx s₂ r := by
  rw [h1]
  exact ⟨s₂, ReachesEnum.refl s₂, h2⟩

private theorem simStep1 {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    {ctx : ScalarizeCtx plan pSrc pOut} {s₂ s₁' s₂' : EnumState}
    {r : StepResult EnumState TerminalOut}
    (h1 : r = .step s₁')
    (h2 : evalStepEnum pOut 0 s₂ = .step s₂')
    (hRel : ScalarizeSimRel ctx s₁' s₂') :
    SimStepResult ctx s₂ r := by
  rw [h1]
  exact ⟨s₂', ⟨0, ReachesNEnum.succ h2 (ReachesNEnum.zero s₂')⟩, hRel⟩

private theorem simStepPlus {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    {ctx : ScalarizeCtx plan pSrc pOut} {s₂ sMid s₁' s₂' : EnumState}
    {r : StepResult EnumState TerminalOut} {k : Nat}
    (h1 : r = .step s₁')
    (hFirst : evalStepEnum pOut 0 s₂ = .step sMid)
    (hTail : ReachesNEnum pOut k sMid s₂')
    (hRel : ScalarizeSimRel ctx s₁' s₂') :
    SimStepResult ctx s₂ r := by
  rw [h1]
  exact ⟨s₂', ⟨k, ReachesNEnum.succ hFirst hTail⟩, hRel⟩

private theorem simStepResult_prepend_step {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    {ctx : ScalarizeCtx plan pSrc pOut} {s₂ sMid : EnumState}
    {r : StepResult EnumState TerminalOut}
    (hStep : evalStepEnum pOut 0 s₂ = .step sMid)
    (hRest : SimStepResult ctx sMid r) :
    SimStepResult ctx s₂ r := by
  cases r with
  | step s₁' =>
    let ⟨s₂', ⟨d, hd⟩, hRel⟩ := hRest
    exact ⟨s₂', ⟨d + 1, ReachesNEnum.succ hStep hd⟩, hRel⟩
  | done out =>
    let ⟨s₂', hRE, hDone⟩ := hRest
    exact ⟨s₂', c_reachesEnum_head_det hStep hRE, hDone⟩
  | fault fk =>
    let ⟨s₂', hRE, hFault⟩ := hRest
    exact ⟨s₂', c_reachesEnum_head_det hStep hRE, hFault⟩

private theorem simStepResult_prepend_reachesN {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    {ctx : ScalarizeCtx plan pSrc pOut} :
    ∀ {m : Nat} {s₂ sMid : EnumState} {r : StepResult EnumState TerminalOut},
      ReachesNEnum pOut m s₂ sMid →
      SimStepResult ctx sMid r →
      SimStepResult ctx s₂ r
  | 0, _, _, _, .zero _, hRest => hRest
  | _ + 1, _, _, _, .succ hStep hTail, hRest =>
    simStepResult_prepend_step hStep (simStepResult_prepend_reachesN hTail hRest)

/-! ### 2. `evalConstLit`, ZST, `MirTy`, & Niche Static Invariant Lemmas -/

private theorem s3d_evalConstLit_int_eq (w : IntWidth) (s : Bool) (bits : BitVec 128)
    (hFit : truncateBits w bits = bits) :
    evalConstLit (.int w s) (.scalar bits) = .ok (.scalar ⟨w, s, bits⟩) ∧
    checkVal (.scalar ⟨w, s, bits⟩) (.int w s) = true := by
  refine ⟨?_, ?_⟩
  · change (if truncateBits w bits != bits then Except.error FaultKind.unsupported
      else Except.ok (Val.scalar ⟨w, s, truncateBits w bits⟩)) = _
    rw [bitvec_bne_false_of_eq hFit, hFit]
    rfl
  · have hWBeq : IntWidth.beq w w = true := by cases w <;> rfl
    have hSBeq : (s == s) = true := by cases s <;> rfl
    have hWf : ScalarVal.wf ⟨w, s, bits⟩ = true := by
      change (truncateBits w bits == bits) = true
      rw [hFit]
      exact bitvec_beq_refl bits
    change (match (if ScalarVal.wf ⟨w, s, bits⟩ then some (MirTy.int w s) else none) with
      | some vTy => MirTy.beq vTy (.int w s)
      | none => false) = true
    rw [hWf]
    dsimp
    change (IntWidth.beq w w && (s == s)) = true
    rw [hWBeq, hSBeq]
    rfl

private theorem s3d_isZstEnumTy_checkVal {ety : EnumTy} (hZst : isZstEnumTy ety = true) :
    evalConstLit (.enum ety) .zeroSized = .ok (.enumVal ety 0) ∧
    checkVal (.enumVal ety 0) (.enum ety) = true := by
  have hEA : enumAdmitted ety = true := by
    have hDef : isZstEnumTy ety =
        (match ety.tagRepr with | .zeroSized => enumAdmitted ety | .scalar _ _ => false) := rfl
    have hZ := hZst
    rw [hDef] at hZ
    cases hTR : ety.tagRepr with
    | zeroSized => rw [hTR] at hZ; exact hZ
    | scalar _ _ => rw [hTR] at hZ; cases hZ
  have hNonEmpty : 0 < ety.discriminants.length := by
    have hDef : enumAdmitted ety =
        (!ety.discriminants.isEmpty &&
          Nat.blt ety.discriminants.length (Nat.pow 2 32) &&
          ety.discriminants.all (fun d => Nat.blt d (Nat.pow 2 ety.discrWidth.bitWidth)) &&
          natListPairwiseNe ety.discriminants &&
          match ety.tagRepr with
          | .zeroSized => Nat.beq ety.discriminants.length 1
          | .scalar tagW tagS =>
            ety.discriminants.all (fun d =>
              tagBitsToDiscrBits tagW tagS ety.discrWidth
                (truncateBits tagW (BitVec.ofNat 128 d)) == BitVec.ofNat 128 d)) := rfl
    have hEA' := hEA
    rw [hDef] at hEA'
    let ⟨h1234, _⟩ := bool_and_true hEA'
    let ⟨h123, _⟩ := bool_and_true h1234
    let ⟨h12, _⟩ := bool_and_true h123
    let ⟨hNE, _⟩ := bool_and_true h12
    cases hd : ety.discriminants with
    | nil => rw [hd] at hNE; cases hNE
    | cons _ _ => exact Nat.zero_lt_succ _
  refine ⟨?_, ?_⟩
  · change (if isZstEnumTy ety then Except.ok (Val.enumVal ety 0)
      else Except.error FaultKind.unsupported) = _
    rw [hZst]
    rfl
  · change (match (if enumAdmitted ety && Nat.blt 0 ety.discriminants.length
        then some (MirTy.enum ety) else none) with
      | some vTy => MirTy.beq vTy (.enum ety)
      | none => false) = true
    rw [hEA, nat_lt_blt hNonEmpty]
    dsimp
    exact enumTy_beq_refl ety

private theorem s3d_checkNicheVariantsZst_at {vs : List VariantDef} {start : Nat} :
    ∀ {cnt i : Nat} {vd : VariantDef},
      checkNicheVariantsZst vs start cnt = true →
      i < cnt →
      Trusted.MirSemantics.getElem? vs (start + i) = some vd →
      vd.fields.all isZstBaseTy = true
  | 0, _, _, _, hi, _ => False.elim (Nat.not_lt_zero _ hi)
  | cnt' + 1, i, vd, hZ, hi, hg => by
    unfold checkNicheVariantsZst at hZ
    cases hgTop : Trusted.MirSemantics.getElem? vs (start + cnt') with
    | none => rw [hgTop] at hZ; cases hZ
    | some vdTop =>
      rw [hgTop] at hZ; dsimp at hZ
      let ⟨hTopAll, hRest⟩ := bool_and_true hZ
      cases Nat.eq_or_lt_of_le (Nat.le_of_lt_succ hi) with
      | inl hEq =>
        subst hEq
        rw [hg] at hgTop
        injection hgTop with hvEq; subst hvEq
        exact hTopAll
      | inr hLt =>
        exact s3d_checkNicheVariantsZst_at hRest hLt hg

private theorem s3d_adtEnumDefAdmitted_niche_props {ed : AdtEnumDef} {tagW : IntWidth}
    {untagged nStart nLast : Nat} {nStartBits : BitVec 128}
    {tagRange : WrappingRange128} {nicheField : Nat} {uRange : WrappingRange128}
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .niche tagW untagged nStart nLast nStartBits
      tagRange nicheField uRange) :
    nStart ≤ nLast ∧
    nLast < ed.variants.length ∧
    ¬ (nStart ≤ untagged ∧ untagged ≤ nLast) ∧
    (∃ uVd,
      Trusted.MirSemantics.getElem? ed.variants untagged = some uVd ∧
      variantIsUninhabited uVd = false ∧
      Trusted.MirSemantics.getElem? uVd.fields nicheField = some (.int tagW false)) ∧
    (∀ v vd f fTy,
      nStart ≤ v → v ≤ nLast →
      Trusted.MirSemantics.getElem? ed.variants v = some vd →
      Trusted.MirSemantics.getElem? vd.fields f = some fTy →
      isZstBaseTy fTy = true) ∧
    truncateBits tagW nStartBits = nStartBits ∧
    wrappingRangeFitsWidth tagW tagRange = true ∧
    wrappingRangeFitsWidth tagW uRange = true ∧
    nLast - nStart + 1 ≤ Nat.pow 2 tagW.bitWidth := by
  unfold adtEnumDefAdmitted at hAdm
  rw [hLay] at hAdm
  dsimp at hAdm
  let ⟨_, hNiche⟩ := bool_and_true hAdm
  let ⟨h1_8, hPart⟩ := bool_and_true hNiche
  let ⟨h1_7, hUVdCheck⟩ := bool_and_true h1_8
  let ⟨h1_6, hZstCheck⟩ := bool_and_true h1_7
  let ⟨h1_5, _⟩ := bool_and_true h1_6
  let ⟨h1_4, hNotMid⟩ := bool_and_true h1_5
  let ⟨h1_3, _⟩ := bool_and_true h1_4
  let ⟨h1_2, hLastLtB⟩ := bool_and_true h1_3
  let ⟨_, hLeB⟩ := bool_and_true h1_2
  have hLe := nat_ble_le hLeB
  have hLastLt := nat_blt_lt hLastLtB
  have hNoMidProp : ¬ (nStart ≤ untagged ∧ untagged ≤ nLast) := by
    intro ⟨hA, hB⟩
    rw [nat_le_ble hA, nat_le_ble hB] at hNotMid
    cases hNotMid
  have hUVd : ∃ uVd,
      Trusted.MirSemantics.getElem? ed.variants untagged = some uVd ∧
      variantIsUninhabited uVd = false ∧
      Trusted.MirSemantics.getElem? uVd.fields nicheField = some (.int tagW false) := by
    cases hG : Trusted.MirSemantics.getElem? ed.variants untagged with
    | none => rw [hG] at hUVdCheck; cases hUVdCheck
    | some uVd =>
      rw [hG] at hUVdCheck; dsimp at hUVdCheck
      let ⟨hNotUninh, hNF⟩ := bool_and_true hUVdCheck
      cases hGF : Trusted.MirSemantics.getElem? uVd.fields nicheField with
      | none => rw [hGF] at hNF; cases hNF
      | some fTy =>
        rw [hGF] at hNF
        cases fTy with
        | bool | unit | tuple _ | enum _ | ref _ _ | rawPtr _ _ | never | unsupported =>
          dsimp at hNF; cases hNF
        | int w s =>
          dsimp at hNF
          let ⟨hwEqB, hsNot⟩ := bool_and_true hNF
          have hwEq : w = tagW := by cases w <;> cases tagW <;> first | rfl | cases hwEqB
          have hsEq : s = false := bool_not_true hsNot
          subst hwEq; subst hsEq
          exact ⟨uVd, rfl, bool_not_true hNotUninh, hGF⟩
  have hZstProp : ∀ v vd f fTy,
      nStart ≤ v → v ≤ nLast →
      Trusted.MirSemantics.getElem? ed.variants v = some vd →
      Trusted.MirSemantics.getElem? vd.fields f = some fTy →
      isZstBaseTy fTy = true := by
    intro v vd f fTy hvGe hvLe hvGet hfGet
    have hvEq : nStart + (v - nStart) = v := Nat.add_sub_of_le hvGe
    have hiLt : v - nStart < nLast - nStart + 1 :=
      Nat.lt_succ_of_le (Nat.sub_le_sub_right hvLe nStart)
    have hAllZ := s3d_checkNicheVariantsZst_at hZstCheck hiLt (by rw [hvEq]; exact hvGet)
    exact list_all_getElem? hAllZ hfGet
  unfold checkNicheRangePartition at hPart
  dsimp at hPart
  let k := nLast - nStart + 1
  cases hG1 : (Nat.beq k 0 || !Nat.blt k (Nat.pow 2 tagW.bitWidth) || !Nat.ble k 64) with
  | true => rw [hG1] at hPart; cases hPart
  | false =>
    rw [hG1] at hPart; dsimp at hPart
    let ⟨hG1a, _⟩ := bool_or_false hG1
    let ⟨_, hKLtB⟩ := bool_or_false hG1a
    have hkLePow : k ≤ Nat.pow 2 tagW.bitWidth :=
      Nat.le_of_lt (nat_blt_lt (bool_not_false hKLtB))
    cases hG2 : (!(truncateBits tagW nStartBits == nStartBits) ||
        !wrappingRangeFitsWidth tagW tagRange ||
        !wrappingRangeFitsWidth tagW uRange) with
    | true => rw [hG2] at hPart; cases hPart
    | false =>
      let ⟨hG2a, hUFitB⟩ := bool_or_false hG2
      let ⟨hN0B, hTFitB⟩ := bool_or_false hG2a
      exact ⟨hLe, hLastLt, hNoMidProp, hUVd, hZstProp,
             eq_of_beq (bool_not_false hN0B),
             bool_not_false hTFitB,
             bool_not_false hUFitB,
             hkLePow⟩

/-! ### 3. Block/Statement Suffix & Component-Declaration Lookup Helpers -/

private theorem s3d_lowerEnumBlock_stmts_suffix (enumLocal base compCount : Nat)
    (ed : AdtEnumDef) (nextAuxBb : BasicBlockId) (bb : EnumBlock) :
    ∃ termExtra : List EnumStmt,
      (lowerEnumBlock enumLocal base compCount ed nextAuxBb bb).1.statements =
        listFlatMap (lowerEnumStmt enumLocal base compCount ed) bb.statements ++ termExtra := by
  dsimp [lowerEnumBlock]
  let stmts₁ := listFlatMap (lowerEnumStmt enumLocal base compCount ed) bb.statements
  cases bb.terminator with
  | baseTerm _ => exact ⟨[], (List.append_nil stmts₁).symm⟩
  | switchDiscr discrDst eLoc targets =>
    dsimp
    cases (!Nat.beq eLoc enumLocal) with
    | true => dsimp; exact ⟨[], (List.append_nil stmts₁).symm⟩
    | false =>
      dsimp
      cases ed.layout with
      | empty => exact ⟨_, rfl⟩
      | single =>
        dsimp
        cases Trusted.MirSemantics.getElem? ed.variants 0 with
        | none => exact ⟨[], (List.append_nil stmts₁).symm⟩
        | some vd₀ =>
          dsimp
          cases variantIsUninhabited vd₀ <;> exact ⟨_, rfl⟩
      | direct _ _ => exact ⟨_, rfl⟩
      | niche _ _ _ _ _ _ _ _ => exact ⟨_, rfl⟩

private theorem s3d_bodyTgt_block_lookup {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {bIdx : BasicBlockId} {bb : EnumBlock}
    (hBB : Trusted.MirSemantics.getElem? ctx.body.basicBlocks bIdx = some bb) :
    ∃ (auxBase : BasicBlockId),
      let cur := lowerEnumBlock plan.enumLocal ctx.body.locals.length ctx.compTys.length
        ctx.ed auxBase bb
      Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks bIdx = some cur.1 ∧
      (∀ i auxBb, Trusted.MirSemantics.getElem? cur.2 i = some auxBb →
        Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks (auxBase + i) =
          some auxBb) := by
  let base := ctx.body.locals.length
  let nBbs := ctx.body.basicBlocks.length
  let lowered := lowerEnumBlocksLoop plan.enumLocal base ctx.compTys.length
    ctx.ed nBbs ctx.body.basicBlocks
  have hFstLen : lowered.1.length = nBbs :=
    lowerEnumBlocksLoop_fst_length plan.enumLocal base ctx.compTys.length
      ctx.ed nBbs ctx.body.basicBlocks
  have hbLt : bIdx < lowered.1.length := by
    rw [hFstLen]; exact getElem?_some_lt hBB
  let ⟨preAux, postAux, hGet1, hEq2⟩ :=
    lowerEnumBlocksLoop_lookup plan.enumLocal base ctx.compTys.length
      ctx.ed nBbs ctx.body.basicBlocks hBB
  let auxBase := nBbs + preAux.length
  refine ⟨auxBase, ?_, ?_⟩
  · change Trusted.MirSemantics.getElem? (lowered.1 ++ lowered.2) bIdx = _
    rw [getElem?_append_left hbLt]
    exact hGet1
  · intro i auxBb hi
    change Trusted.MirSemantics.getElem? (lowered.1 ++ lowered.2) (auxBase + i) = some auxBb
    have hAr : auxBase + i = lowered.1.length + (preAux.length + i) := by
      dsimp [auxBase]
      rw [hFstLen, Nat.add_assoc]
    rw [hAr, getElem?_append_right lowered.1 lowered.2 (preAux.length + i), hEq2]
    have hAssoc : preAux ++ (lowerEnumBlock plan.enumLocal base ctx.compTys.length ctx.ed auxBase bb).2 ++ postAux =
        preAux ++ ((lowerEnumBlock plan.enumLocal base ctx.compTys.length ctx.ed auxBase bb).2 ++ postAux) :=
      List.append_assoc _ _ _
    rw [hAssoc, getElem?_append_right preAux _ i,
        getElem?_append_left (getElem?_some_lt hi)]
    exact hi

private theorem s3d_compDecls_common {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) :
    let base := ctx.body.locals.length
    let bodyTgt := scalarizeTargetBody ctx
    Trusted.MirSemantics.getElem? bodyTgt.locals base = some (.base .unit) ∧
    Trusted.MirSemantics.getElem? bodyTgt.locals (base + 1) = some (.base (.int .i32 false)) := by
  let ⟨_, _, _, hDeclComp⟩ := scalarizeCtx_target_decl_lookup ctx
  have hComp := ctx.hComp
  unfold scalarizedEnumComponentTys at hComp
  have h01 : Trusted.MirSemantics.getElem? ctx.compTys 0 = some .unit ∧
      Trusted.MirSemantics.getElem? ctx.compTys 1 = some (.int .i32 false) := by
    cases hL : ctx.ed.layout with
    | empty =>
      rw [hL] at hComp; injection hComp with hEq
      rw [← hEq]; exact ⟨rfl, rfl⟩
    | single =>
      rw [hL] at hComp; dsimp at hComp
      cases hv : Trusted.MirSemantics.getElem? ctx.ed.variants 0 with
      | none => rw [hv] at hComp; cases hComp
      | some vd₀ =>
        rw [hv] at hComp; injection hComp with hEq
        rw [← hEq]; exact ⟨rfl, rfl⟩
    | direct tagW tagS =>
      rw [hL] at hComp; injection hComp with hEq
      rw [← hEq]; exact ⟨rfl, rfl⟩
    | niche tagW u _ _ _ _ nf _ =>
      rw [hL] at hComp; dsimp at hComp
      cases hu : Trusted.MirSemantics.getElem? ctx.ed.variants u with
      | none => rw [hu] at hComp; cases hComp
      | some uVd =>
        rw [hu] at hComp; injection hComp with hEq
        rw [← hEq]; exact ⟨rfl, rfl⟩
  refine ⟨?_, hDeclComp 1 _ h01.2⟩
  have h0 := hDeclComp 0 .unit h01.1
  rw [Nat.add_zero] at h0
  exact h0

private theorem s3d_compDecls_single {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    (hLay : ctx.ed.layout = .single) :
    ∃ vd₀,
      Trusted.MirSemantics.getElem? ctx.ed.variants 0 = some vd₀ ∧
      ctx.ed.variants.length = 1 ∧
      ctx.compTys.length = 2 + vd₀.fields.length + vd₀.fields.length ∧
      (∀ f fTy, Trusted.MirSemantics.getElem? vd₀.fields f = some fTy →
        Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).locals
          (ctx.body.locals.length + 2 + f) = some (.base fTy) ∧
        Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).locals
          (ctx.body.locals.length + 2 + vd₀.fields.length + f) = some (.base fTy)) := by
  let ⟨_, _, _, hDeclComp⟩ := scalarizeCtx_target_decl_lookup ctx
  have hAdm := ctx.hEdAdm
  unfold adtEnumDefAdmitted at hAdm
  rw [hLay] at hAdm
  have hLen1 : ctx.ed.variants.length = 1 := nat_beq_eq (bool_and_true hAdm).2
  have hComp := ctx.hComp
  unfold scalarizedEnumComponentTys at hComp
  rw [hLay] at hComp; dsimp at hComp
  cases hv0 : Trusted.MirSemantics.getElem? ctx.ed.variants 0 with
  | none => rw [hv0] at hComp; cases hComp
  | some vd₀ =>
    rw [hv0] at hComp
    injection hComp with hCEq
    have hCEq' : ctx.compTys = [MirTy.unit, .int .i32 false] ++ vd₀.fields ++ vd₀.fields :=
      hCEq.symm
    refine ⟨vd₀, rfl, hLen1, ?_, ?_⟩
    · rw [hCEq']
      dsimp [List.append, List.length]
      exact cons2_append_length vd₀.fields vd₀.fields
    · intro f fTy hf
      have hfLt : f < vd₀.fields.length := getElem?_some_lt hf
      let hdr : List MirTy := [.unit, .int .i32 false]
      have hPayComp : Trusted.MirSemantics.getElem? ctx.compTys (2 + f) = some fTy := by
        rw [hCEq']
        have hLt1 : 2 + f < (hdr ++ vd₀.fields).length := by
          rw [list_append_length]; dsimp [hdr, List.length]; exact Nat.add_lt_add_left hfLt 2
        rw [getElem?_append_left hLt1]
        change Trusted.MirSemantics.getElem? (hdr ++ vd₀.fields) (hdr.length + f) = some fTy
        rw [getElem?_append_right hdr vd₀.fields f]
        exact hf
      have hScrComp : Trusted.MirSemantics.getElem? ctx.compTys (2 + vd₀.fields.length + f) =
          some fTy := by
        rw [hCEq']
        have hLenLeft : (hdr ++ vd₀.fields).length = 2 + vd₀.fields.length := by
          rw [list_append_length]; rfl
        rw [← hLenLeft, getElem?_append_right (hdr ++ vd₀.fields) vd₀.fields f]
        exact hf
      refine ⟨?_, ?_⟩
      · rw [Nat.add_assoc ctx.body.locals.length 2 f]
        exact hDeclComp (2 + f) fTy hPayComp
      · rw [Nat.add_assoc ctx.body.locals.length 2 vd₀.fields.length,
            Nat.add_assoc ctx.body.locals.length (2 + vd₀.fields.length) f]
        exact hDeclComp (2 + vd₀.fields.length + f) fTy hScrComp

private theorem s3d_compDecls_direct {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) {tagW : IntWidth} {tagS : Bool}
    (hLay : ctx.ed.layout = .direct tagW tagS) :
    let base := ctx.body.locals.length
    let bodyTgt := scalarizeTargetBody ctx
    let allFs := flattenAllVariantFieldTys ctx.ed
    let ety := directTagEnumTy ctx.ed tagW tagS
    ctx.compTys.length = 3 + allFs.length + allFs.length ∧
    Trusted.MirSemantics.getElem? bodyTgt.locals (base + 2) = some (.base (.enum ety)) ∧
    (∀ v vd f fTy,
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
      Trusted.MirSemantics.getElem? vd.fields f = some fTy →
      let off := directVariantFieldOffset ctx.ed.variants v + f
      Trusted.MirSemantics.getElem? bodyTgt.locals (base + 3 + off) = some (.base fTy) ∧
      Trusted.MirSemantics.getElem? bodyTgt.locals (base + 3 + allFs.length + off) =
        some (.base fTy)) := by
  let ⟨_, _, _, hDeclComp⟩ := scalarizeCtx_target_decl_lookup ctx
  have hComp := ctx.hComp
  unfold scalarizedEnumComponentTys at hComp
  rw [hLay] at hComp
  injection hComp with hCEq
  let allFs := flattenAllVariantFieldTys ctx.ed
  let ety := directTagEnumTy ctx.ed tagW tagS
  let hdr : List MirTy := [.unit, .int .i32 false, .enum ety]
  have hCEq' : ctx.compTys = hdr ++ allFs ++ allFs := hCEq.symm
  refine ⟨?_, ?_, ?_⟩
  · rw [hCEq']
    dsimp [hdr, List.append, List.length]
    exact cons3_append_length allFs allFs
  · have h2 : Trusted.MirSemantics.getElem? ctx.compTys 2 = some (.enum ety) := by
      rw [hCEq']
      have hL1 : 2 < (hdr ++ allFs).length := by
        rw [list_append_length]; dsimp [hdr, List.length]
        exact Nat.lt_of_lt_of_le (Nat.lt_succ_self 2) (Nat.le_add_right 3 _)
      have hL0 : 2 < hdr.length := Nat.lt_succ_self 2
      rw [getElem?_append_left hL1, getElem?_append_left hL0]
      rfl
    exact hDeclComp 2 (.enum ety) h2
  · intro v vd f fTy hv hf
    have hAllAt : Trusted.MirSemantics.getElem? allFs
        (directVariantFieldOffset ctx.ed.variants v + f) = some fTy :=
      directVariantFieldOffset_lookup ctx.ed.variants hv hf
    have hOffLt : directVariantFieldOffset ctx.ed.variants v + f < allFs.length :=
      getElem?_some_lt hAllAt
    let off := directVariantFieldOffset ctx.ed.variants v + f
    have hPayComp : Trusted.MirSemantics.getElem? ctx.compTys (3 + off) = some fTy := by
      rw [hCEq']
      have hLt1 : 3 + off < (hdr ++ allFs).length := by
        rw [list_append_length]; dsimp [hdr, List.length]; exact Nat.add_lt_add_left hOffLt 3
      rw [getElem?_append_left hLt1]
      change Trusted.MirSemantics.getElem? (hdr ++ allFs) (hdr.length + off) = some fTy
      rw [getElem?_append_right hdr allFs off]
      exact hAllAt
    have hScrComp : Trusted.MirSemantics.getElem? ctx.compTys (3 + allFs.length + off) =
        some fTy := by
      rw [hCEq']
      have hLenLeft : (hdr ++ allFs).length = 3 + allFs.length := by
        rw [list_append_length]; rfl
      rw [← hLenLeft, getElem?_append_right (hdr ++ allFs) allFs off]
      exact hAllAt
    refine ⟨?_, ?_⟩
    · rw [Nat.add_assoc ctx.body.locals.length 3 off]
      exact hDeclComp (3 + off) fTy hPayComp
    · rw [Nat.add_assoc ctx.body.locals.length 3 allFs.length,
          Nat.add_assoc ctx.body.locals.length (3 + allFs.length) off]
      exact hDeclComp (3 + allFs.length + off) fTy hScrComp

private theorem s3d_compDecls_niche {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) {tagW : IntWidth}
    {untagged nStart nLast : Nat} {nStartBits : BitVec 128}
    {tagRange : WrappingRange128} {nicheField : Nat} {uRange : WrappingRange128}
    {uVd : VariantDef}
    (hLay : ctx.ed.layout = .niche tagW untagged nStart nLast nStartBits
      tagRange nicheField uRange)
    (huGet : Trusted.MirSemantics.getElem? ctx.ed.variants untagged = some uVd) :
    let base := ctx.body.locals.length
    let bodyTgt := scalarizeTargetBody ctx
    let extras := nicheExtraFieldTysAux nicheField 0 uVd.fields
    let allFs := flattenAllVariantFieldTys ctx.ed
    ctx.compTys.length = 5 + extras.length + allFs.length ∧
    Trusted.MirSemantics.getElem? bodyTgt.locals (base + 2) = some (.base (.int tagW false)) ∧
    Trusted.MirSemantics.getElem? bodyTgt.locals (base + 3) = some (.base (.int tagW false)) ∧
    Trusted.MirSemantics.getElem? bodyTgt.locals (base + 4) = some (.base (.int tagW false)) ∧
    (∀ f fTy, f ≠ nicheField →
      Trusted.MirSemantics.getElem? uVd.fields f = some fTy →
      nicheExtraIdx nicheField f < extras.length ∧
      Trusted.MirSemantics.getElem? bodyTgt.locals (base + 5 + nicheExtraIdx nicheField f) =
        some (.base fTy)) ∧
    (∀ v vd f fTy,
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
      Trusted.MirSemantics.getElem? vd.fields f = some fTy →
      Trusted.MirSemantics.getElem? bodyTgt.locals
        (base + 5 + extras.length + directVariantFieldOffset ctx.ed.variants v + f) =
        some (.base fTy)) := by
  let ⟨_, _, _, hDeclComp⟩ := scalarizeCtx_target_decl_lookup ctx
  have hComp := ctx.hComp
  unfold scalarizedEnumComponentTys at hComp
  rw [hLay] at hComp; dsimp at hComp
  rw [huGet] at hComp
  injection hComp with hCEq
  let extras := nicheExtraFieldTysAux nicheField 0 uVd.fields
  let allFs := flattenAllVariantFieldTys ctx.ed
  let hdr : List MirTy :=
    [.unit, .int .i32 false, .int tagW false, .int tagW false, .int tagW false]
  have hCEq' : ctx.compTys = hdr ++ extras ++ allFs := hCEq.symm
  have hHdrAt : ∀ i, i < 5 →
      Trusted.MirSemantics.getElem? ctx.compTys i = Trusted.MirSemantics.getElem? hdr i := by
    intro i hi
    rw [hCEq']
    have hL1 : i < (hdr ++ extras).length := by
      rw [list_append_length]; dsimp [hdr, List.length]
      exact Nat.lt_of_lt_of_le hi (Nat.le_add_right 5 _)
    rw [getElem?_append_left hL1, getElem?_append_left hi]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hCEq']
    dsimp [hdr, List.append, List.length]
    exact cons5_append_length extras allFs
  · exact hDeclComp 2 (.int tagW false)
      (hHdrAt 2 (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 2))))
  · exact hDeclComp 3 (.int tagW false)
      (hHdrAt 3 (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 1)))))
  · exact hDeclComp 4 (.int tagW false) (hHdrAt 4 (Nat.lt_succ_self 4))
  · intro f fTy hfNe hfGet
    have hExAt : Trusted.MirSemantics.getElem? extras (nicheExtraIdx nicheField f) = some fTy := by
      have hSub0 := nicheExtraFieldTysAux_lookup nicheField uVd.fields 0 f fTy
        (Nat.zero_le f) (Nat.zero_le nicheField) hfNe
        (by rw [Nat.sub_zero]; exact hfGet)
      rw [Nat.sub_zero] at hSub0
      exact hSub0
    have hExLt : nicheExtraIdx nicheField f < extras.length := getElem?_some_lt hExAt
    have hCompAt : Trusted.MirSemantics.getElem? ctx.compTys (5 + nicheExtraIdx nicheField f) =
        some fTy := by
      rw [hCEq']
      have hLt1 : 5 + nicheExtraIdx nicheField f < (hdr ++ extras).length := by
        rw [list_append_length]; dsimp [hdr, List.length]; exact Nat.add_lt_add_left hExLt 5
      rw [getElem?_append_left hLt1]
      change Trusted.MirSemantics.getElem? (hdr ++ extras)
        (hdr.length + nicheExtraIdx nicheField f) = some fTy
      rw [getElem?_append_right hdr extras _]
      exact hExAt
    refine ⟨hExLt, ?_⟩
    rw [Nat.add_assoc ctx.body.locals.length 5 _]
    exact hDeclComp _ fTy hCompAt
  · intro v vd f fTy hv hf
    have hAllAt : Trusted.MirSemantics.getElem? allFs
        (directVariantFieldOffset ctx.ed.variants v + f) = some fTy :=
      directVariantFieldOffset_lookup ctx.ed.variants hv hf
    let off := directVariantFieldOffset ctx.ed.variants v + f
    have hCompAt : Trusted.MirSemantics.getElem? ctx.compTys (5 + extras.length + off) =
        some fTy := by
      rw [hCEq']
      have hLenLeft : (hdr ++ extras).length = 5 + extras.length := by
        rw [list_append_length]; rfl
      rw [← hLenLeft, getElem?_append_right (hdr ++ extras) allFs off]
      exact hAllAt
    have hAr : ctx.body.locals.length + 5 + extras.length + directVariantFieldOffset ctx.ed.variants v + f =
        ctx.body.locals.length + (5 + extras.length + off) := by
      dsimp [off]
      rw [Nat.add_assoc ctx.body.locals.length 5 extras.length,
          Nat.add_assoc ctx.body.locals.length (5 + extras.length) _,
          Nat.add_assoc ctx.body.locals.length _ f,
          Nat.add_assoc (5 + extras.length) _ f]
    rw [hAr]
    exact hDeclComp _ fTy hCompAt

/-! ### 4. `evalAggregateEnumOperands_agree`, `evalEnumBaseRvalue_preserves_enumLocal`, & `writeAdtFieldsSeq` Specs -/

private theorem s3d_evalEnumBaseOperand_preserves_enumLocal
    {decls : List EnumLocalDecl} {enumLocal : Nat} {s0 : List EnumSlot} {op : Operand}
    (hNo : stmtMentionsLocalOperand enumLocal op = false) :
    ∀ {ty ov s'},
      evalEnumBaseOperandToSlot decls s0 op = .ok (ty, ov, s') →
      Trusted.MirSemantics.getElem? s' enumLocal =
        Trusted.MirSemantics.getElem? s0 enumLocal := by
  cases op with
  | constant c =>
    unfold evalEnumBaseOperandToSlot; dsimp
    cases evalConstLit c.ty c.lit with
    | error _ => intro _ _ _ h; cases h
    | ok _ =>
      intro _ _ _ h; injection h with h1; injection h1 with _ h2
      injection h2 with _ hs; subst hs; rfl
  | copy p =>
    unfold evalEnumBaseOperandToSlot; dsimp
    cases p.projection.isEmpty with
    | false => intro _ _ _ h; cases h
    | true =>
      dsimp
      cases Trusted.MirSemantics.getElem? decls p.localId with
      | none => intro _ _ _ h; cases h
      | some d =>
        cases d with
        | adtEnum _ => intro _ _ _ h; cases h
        | base _ =>
          cases Trusted.MirSemantics.getElem? s0 p.localId with
          | none => intro _ _ _ h; cases h
          | some sl0 =>
            cases sl0 with
            | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
              intro _ _ _ h; cases h
            | baseSlot bsl =>
              cases bsl with
              | dead => intro _ _ _ h; cases h
              | live _ =>
                intro _ _ _ h; injection h with h1; injection h1 with _ h2
                injection h2 with _ hs; subst hs; rfl
  | move p =>
    have hpNe : enumLocal ≠ p.localId := fun h => nat_ne_of_beq_false hNo h.symm
    unfold evalEnumBaseOperandToSlot; dsimp
    cases p.projection.isEmpty with
    | false => intro _ _ _ h; cases h
    | true =>
      dsimp
      cases Trusted.MirSemantics.getElem? decls p.localId with
      | none => intro _ _ _ h; cases h
      | some d =>
        cases d with
        | adtEnum _ => intro _ _ _ h; cases h
        | base tyP =>
          cases Trusted.MirSemantics.getElem? s0 p.localId with
          | none => intro _ _ _ h; cases h
          | some sl0 =>
            cases sl0 with
            | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
              intro _ _ _ h; cases h
            | baseSlot bsl =>
              cases bsl with
              | dead => intro _ _ _ h; cases h
              | live _ =>
                dsimp
                cases hS : setElem? s0 p.localId (.baseSlot (liveUninitSlot tyP)) with
                | none => intro _ _ _ h; cases h
                | some sOut =>
                  intro _ _ _ h; injection h with h1; injection h1 with _ h2
                  injection h2 with _ hs; subst hs
                  exact setElem?_getElem?_ne hS hpNe

private theorem s3d_evalEnumPrimitiveOperand_preserves_enumLocal
    {decls : List EnumLocalDecl} {enumLocal : Nat} {s0 : List EnumSlot} {op : Operand}
    (hNo : stmtMentionsLocalOperand enumLocal op = false) :
    ∀ {v s'},
      evalEnumPrimitiveOperand decls s0 op = .ok (v, s') →
      Trusted.MirSemantics.getElem? s' enumLocal =
        Trusted.MirSemantics.getElem? s0 enumLocal := by
  unfold evalEnumPrimitiveOperand
  cases hO : evalEnumBaseOperandToSlot decls s0 op with
  | error _ => intro _ _ h; cases h
  | ok tr =>
    cases tr with
    | mk t1 r1 =>
      cases r1 with
      | mk ov1 s1 =>
        dsimp
        cases (!isPrimitiveReadableTy t1) with
        | true => intro _ _ h; cases h
        | false =>
          dsimp
          cases ov1 with
          | none => intro _ _ h; cases h
          | some _ =>
            intro _ _ h; injection h with h1; injection h1 with _ hs; subst hs
            exact s3d_evalEnumBaseOperand_preserves_enumLocal hNo hO

private theorem s3d_evalEnumBaseRvalue_preserves_enumLocal
    {decls : List EnumLocalDecl} {enumLocal : Nat} {s0 : List EnumSlot}
    {dstTy : MirTy} {rv : Rvalue}
    (hNo : rvalueMentionsLocal enumLocal rv = false) :
    ∀ {v s'},
      evalEnumBaseRvalue decls s0 dstTy rv = .ok (v, s') →
      Trusted.MirSemantics.getElem? s' enumLocal =
        Trusted.MirSemantics.getElem? s0 enumLocal := by
  cases rv with
  | use op =>
    unfold evalEnumBaseRvalue; dsimp
    cases hO : evalEnumBaseOperandToSlot decls s0 op with
    | error _ => intro _ _ h; cases h
    | ok tr =>
      cases tr with
      | mk t1 r1 =>
        cases r1 with
        | mk ov1 sm =>
          dsimp
          cases (!MirTy.beq t1 dstTy) with
          | true => intro _ _ h; cases h
          | false =>
            dsimp
            cases ov1 with
            | none => intro _ _ h; cases h
            | some _ =>
              intro _ _ h; injection h with h1; injection h1 with _ hs; subst hs
              exact s3d_evalEnumBaseOperand_preserves_enumLocal hNo hO
  | unaryOp uop op =>
    unfold evalEnumBaseRvalue; dsimp
    cases hP : evalEnumPrimitiveOperand decls s0 op with
    | error _ => intro _ _ h; cases h
    | ok pr =>
      cases pr with
      | mk vp sm =>
        dsimp
        cases evalUnOp uop vp with
        | error _ => intro _ _ h; cases h
        | ok _ =>
          intro _ _ h; injection h with h1; injection h1 with _ hs; subst hs
          exact s3d_evalEnumPrimitiveOperand_preserves_enumLocal hNo hP
  | binaryOp bop l r =>
    let ⟨hNL, hNR⟩ := bool_or_false hNo
    unfold evalEnumBaseRvalue; dsimp
    cases hPL : evalEnumPrimitiveOperand decls s0 l with
    | error _ => intro _ _ h; cases h
    | ok prL =>
      cases prL with
      | mk vl sm =>
        dsimp
        cases hPR : evalEnumPrimitiveOperand decls sm r with
        | error _ => intro _ _ h; cases h
        | ok prR =>
          cases prR with
          | mk vr se =>
            dsimp
            cases evalBinOp bop vl vr with
            | error _ => intro _ _ h; cases h
            | ok _ =>
              intro _ _ h; injection h with h1; injection h1 with _ hs; subst hs
              exact (s3d_evalEnumPrimitiveOperand_preserves_enumLocal hNR hPR).trans
                (s3d_evalEnumPrimitiveOperand_preserves_enumLocal hNL hPL)
  | discriminant p =>
    unfold evalEnumBaseRvalue; dsimp
    cases p.projection.isEmpty with
    | false => intro _ _ h; cases h
    | true =>
      dsimp
      cases Trusted.MirSemantics.getElem? decls p.localId with
      | none => intro _ _ h; cases h
      | some d =>
        cases d with
        | adtEnum _ => intro _ _ h; cases h
        | base mty =>
          cases mty with
          | bool | int _ _ | unit | tuple _ | ref _ _ | rawPtr _ _ | never | unsupported =>
            intro _ _ h; cases h
          | enum ety =>
            cases Trusted.MirSemantics.getElem? s0 p.localId with
            | none => intro _ _ h; cases h
            | some sl0 =>
              cases sl0 with
              | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
                intro _ _ h; cases h
              | baseSlot bsl =>
                dsimp
                cases (!enumAdmitted ety) with
                | true => intro _ _ h; cases h
                | false =>
                  dsimp
                  cases ety.tagRepr with
                  | zeroSized =>
                    cases bsl with
                    | dead => intro _ _ h; cases h
                    | live ov0 =>
                      cases ov0 with
                      | none =>
                        dsimp
                        cases Trusted.MirSemantics.getElem? ety.discriminants 0 with
                        | none => intro _ _ h; cases h
                        | some _ =>
                          intro _ _ h; injection h with h1; injection h1 with _ hs; subst hs; rfl
                      | some dv0 =>
                        cases dv0 with
                        | scalar _ | ptr _ | bool _ | unit | tuple _ | bytes _ =>
                          intro _ _ h; cases h
                        | enumVal ety' v0 =>
                          dsimp
                          cases (EnumTy.beq ety ety' && Nat.beq v0 0) with
                          | false => intro _ _ h; cases h
                          | true =>
                            dsimp
                            cases Trusted.MirSemantics.getElem? ety.discriminants 0 with
                            | none => intro _ _ h; cases h
                            | some _ =>
                              intro _ _ h; injection h with h1; injection h1 with _ hs; subst hs; rfl
                  | scalar _ _ =>
                    cases bsl with
                    | dead => intro _ _ h; cases h
                    | live ov0 =>
                      cases ov0 with
                      | none => intro _ _ h; cases h
                      | some dv0 =>
                        cases dv0 with
                        | scalar _ | ptr _ | bool _ | unit | tuple _ | bytes _ =>
                          intro _ _ h; cases h
                        | enumVal ety' v0 =>
                          dsimp
                          cases (EnumTy.beq ety ety' && Nat.blt v0 ety.discriminants.length) with
                          | false => intro _ _ h; cases h
                          | true =>
                            dsimp
                            cases Trusted.MirSemantics.getElem? ety.discriminants v0 with
                            | none => intro _ _ h; cases h
                            | some _ =>
                              intro _ _ h; injection h with h1; injection h1 with _ hs; subst hs; rfl
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported =>
    intro _ _ h; cases h

private theorem s3d_writeEnumBasePlace_preserves_ne
    {s0 : List EnumSlot} {dst other : LocalId} {dstTy : MirTy} {val : Val}
    (hNe : other ≠ dst) :
    ∀ {s'},
      writeEnumBasePlace s0 dst dstTy val = .ok s' →
      Trusted.MirSemantics.getElem? s' other =
        Trusted.MirSemantics.getElem? s0 other := by
  unfold writeEnumBasePlace
  cases (!checkVal val dstTy) with
  | true => intro _ h; cases h
  | false =>
    dsimp
    cases Trusted.MirSemantics.getElem? s0 dst with
    | none => intro _ h; cases h
    | some slD =>
      cases slD with
      | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
        intro _ h; cases h
      | baseSlot bsl =>
        cases bsl with
        | dead => intro _ h; cases h
        | live _ =>
          dsimp
          cases hS : setElem? s0 dst (.baseSlot (.live (some val))) with
          | none => intro _ h; cases h
          | some sOut =>
            intro _ h; injection h with hs; subst hs
            exact setElem?_getElem?_ne hS hNe

private theorem s3d_evalAggregateEnumOperands_preserves_enumLocal
    {decls : List EnumLocalDecl} {enumLocal : Nat} :
    ∀ (ops : List Operand) (tys : List MirTy) (s0 : List EnumSlot),
      ops.any (stmtMentionsLocalOperand enumLocal) = false →
      ∀ {vals s'},
        evalAggregateEnumOperands decls s0 ops tys = .ok (vals, s') →
        Trusted.MirSemantics.getElem? s' enumLocal =
          Trusted.MirSemantics.getElem? s0 enumLocal := by
  intro ops
  induction ops with
  | nil =>
    intro tys s0 _ vals s' h
    cases tys with
    | nil =>
      unfold evalAggregateEnumOperands at h
      injection h with h1; injection h1 with _ hs; subst hs; rfl
    | cons _ _ => cases h
  | cons op restOps ih =>
    intro tys s0 hNoAll
    cases tys with
    | nil => intro _ _ h; cases h
    | cons ty₀ restTys =>
      dsimp [List.any] at hNoAll
      let ⟨hN0, hNR⟩ := bool_or_false hNoAll
      unfold evalAggregateEnumOperands
      cases hO : evalEnumBaseOperandToSlot decls s0 op with
      | error _ => intro _ _ h; cases h
      | ok tr =>
        cases tr with
        | mk t1 r1 =>
          cases r1 with
          | mk ov1 s1 =>
            dsimp
            cases (!MirTy.beq t1 ty₀) with
            | true => intro _ _ h; cases h
            | false =>
              dsimp
              cases ov1 with
              | none => intro _ _ h; cases h
              | some v₀ =>
                dsimp
                cases (!checkVal v₀ ty₀) with
                | true => intro _ _ h; cases h
                | false =>
                  dsimp
                  cases hR : evalAggregateEnumOperands decls s1 restOps restTys with
                  | error _ => intro _ _ h; cases h
                  | ok pr =>
                    cases pr with
                    | mk vsR sEnd =>
                      intro _ _ h; injection h with h1; injection h1 with _ hs; subst hs
                      exact (ih restTys s1 hNR hR).trans
                        (s3d_evalEnumBaseOperand_preserves_enumLocal hN0 hO)

private theorem s3d_evalAggregateEnumOperands_agree
    {decls₁ decls₂ : List EnumLocalDecl} {base enumLocal : Nat}
    (hDeclAgree : ∀ j, j < base → j ≠ enumLocal →
      Trusted.MirSemantics.getElem? decls₂ j = Trusted.MirSemantics.getElem? decls₁ j) :
    ∀ (ops : List Operand) (tys : List MirTy) (slots₁ slots₂ : List EnumSlot),
      PrefixSlotsAgree base enumLocal slots₁ slots₂ →
      ops.all (operandLocalsInBounds base) = true →
      ops.any (stmtMentionsLocalOperand enumLocal) = false →
      (∀ k, evalAggregateEnumOperands decls₁ slots₁ ops tys = .error k →
        evalAggregateEnumOperands decls₂ slots₂ ops tys = .error k) ∧
      (∀ vals slots₁',
        evalAggregateEnumOperands decls₁ slots₁ ops tys = .ok (vals, slots₁') →
        ∃ slots₂',
          evalAggregateEnumOperands decls₂ slots₂ ops tys = .ok (vals, slots₂') ∧
          slots₂'.length = slots₂.length ∧
          PrefixSlotsAgree base enumLocal slots₁' slots₂' ∧
          (∀ j, (j = enumLocal ∨ base ≤ j) →
            Trusted.MirSemantics.getElem? slots₂' j =
              Trusted.MirSemantics.getElem? slots₂ j))
  | [], [], slots₁, slots₂, hAg, _, _ => by
    unfold evalAggregateEnumOperands
    refine ⟨(fun _ h => by cases h), ?_⟩
    intro vals s1' hOk
    injection hOk with hEq; injection hEq with hV hS
    subst hV; subst hS
    exact ⟨slots₂, rfl, rfl, hAg, fun _ _ => rfl⟩
  | [], _ :: _, _, _, _, _, _ => ⟨fun _ h => h, fun _ _ h => by cases h⟩
  | _ :: _, [], _, _, _, _, _ => ⟨fun _ h => h, fun _ _ h => by cases h⟩
  | op :: restOps, ty₀ :: restTys, slots₁, slots₂, hAg, hBndAll, hNoAll => by
    dsimp [List.all] at hBndAll
    dsimp [List.any] at hNoAll
    let ⟨hB0, hBR⟩ := bool_and_true hBndAll
    let ⟨hN0, hNR⟩ := bool_or_false hNoAll
    let ⟨hOpErr, hOpOk⟩ := evalEnumBaseOperandToSlot_agree hDeclAgree hAg hB0 hN0
    unfold evalAggregateEnumOperands
    cases hEv1 : evalEnumBaseOperandToSlot decls₁ slots₁ op with
    | error k =>
      rw [hOpErr k hEv1]
      exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
    | ok trip =>
      cases trip with
      | mk srcTy restT =>
        cases restT with
        | mk optVal s1Mid =>
          let ⟨s2Mid, hEv2, hLenMid, hAgMid, hOutMid⟩ := hOpOk srcTy optVal s1Mid hEv1
          rw [hEv2]; dsimp
          cases (!MirTy.beq srcTy ty₀) with
          | true => exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
          | false =>
            dsimp
            cases optVal with
            | none => exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
            | some v₀ =>
              dsimp
              cases (!checkVal v₀ ty₀) with
              | true => exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
              | false =>
                dsimp
                let ⟨ihErr, ihOk⟩ := s3d_evalAggregateEnumOperands_agree hDeclAgree
                  restOps restTys s1Mid s2Mid hAgMid hBR hNR
                cases hRec1 : evalAggregateEnumOperands decls₁ s1Mid restOps restTys with
                | error k =>
                  rw [ihErr k hRec1]
                  exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                | ok pairR =>
                  cases pairR with
                  | mk vsR s1End =>
                    let ⟨s2End, hRec2, hLenEnd, hAgEnd, hOutEnd⟩ := ihOk vsR s1End hRec1
                    rw [hRec2]; dsimp
                    refine ⟨(fun _ h => by cases h), ?_⟩
                    intro vals s1Out hOkAll
                    injection hOkAll with hEq; injection hEq with hV hS
                    subst hV; subst hS
                    exact ⟨s2End, rfl, hLenEnd.trans hLenMid, hAgEnd,
                           fun j hj => (hOutEnd j hj).trans (hOutMid j hj)⟩

private theorem s3d_writeAdtFieldsSeq_single {ed : AdtEnumDef}
    (hAdm : adtEnumDefAdmitted ed = true) :
    ∀ (remTys : List MirTy) (remVals : List Val) (idx : Nat) (fs : List (Option Val)),
      remVals.length = remTys.length →
      idx + remTys.length = fs.length →
      (∀ k ty val,
        Trusted.MirSemantics.getElem? remTys k = some ty →
        Trusted.MirSemantics.getElem? remVals k = some val →
        checkVal val ty = true) →
      ∃ fs' : List (Option Val),
        writeAdtFieldsSeq ed 0 idx remTys remVals (.liveSingle fs) = .ok (.liveSingle fs') ∧
        fs'.length = fs.length ∧
        (∀ j, j < idx →
          Trusted.MirSemantics.getElem? fs' j = Trusted.MirSemantics.getElem? fs j) ∧
        (∀ k val, Trusted.MirSemantics.getElem? remVals k = some val →
          Trusted.MirSemantics.getElem? fs' (idx + k) = some (some val))
  | [], [], _, fs, _, _, _ =>
    ⟨fs, rfl, rfl, fun _ _ => rfl, fun _ _ h => by cases h⟩
  | [], _ :: _, _, _, hL, _, _ => by cases hL
  | _ :: _, [], _, _, hL, _, _ => by cases hL
  | ty₀ :: restTys, v₀ :: restVals, idx, fs, hLen, hEnd, hChk => by
    have hChk0 : checkVal v₀ ty₀ = true := hChk 0 ty₀ v₀ rfl rfl
    have hIdxLt : idx < fs.length := by
      rw [← hEnd]
      exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)
    let ⟨fs₁, hSet1⟩ := setElem?_some_of_lt fs idx (some v₀) hIdxLt
    have hLen1 : fs₁.length = fs.length := setElem?_length hSet1
    have hW1 : writeAdtField ed 0 idx ty₀ v₀ (.liveSingle fs) = .ok (.liveSingle fs₁) := by
      unfold writeAdtField
      rw [hAdm, hChk0, nat_beq_refl 0]
      dsimp
      change (match setElem? fs idx (some v₀) with
        | some r => Except.ok (EnumSlot.liveSingle r)
        | none => Except.error FaultKind.unsupported) = _
      rw [hSet1]
    have hEndRest : (idx + 1) + restTys.length = fs₁.length := by
      rw [hLen1, Nat.add_assoc, Nat.add_comm 1 restTys.length]
      exact hEnd
    let ⟨fs₂, hSeqRest, hLen2, hPre2, hSuf2⟩ :=
      s3d_writeAdtFieldsSeq_single hAdm restTys restVals (idx + 1) fs₁
        (Nat.succ.inj hLen) hEndRest
        (fun k ty val hkT hkV => hChk (k + 1) ty val hkT hkV)
    unfold writeAdtFieldsSeq
    rw [hW1]
    dsimp
    refine ⟨fs₂, hSeqRest, hLen2.trans hLen1, ?_, ?_⟩
    · intro j hj
      rw [hPre2 j (Nat.lt_trans hj (Nat.lt_succ_self idx)),
          setElem?_getElem?_ne hSet1 (fun h => by subst h; exact Nat.lt_irrefl _ hj)]
    · intro k val hkV
      cases k with
      | zero =>
        injection hkV with hvEq; subst hvEq
        rw [Nat.add_zero, hPre2 idx (Nat.lt_succ_self idx), setElem?_getElem?_same hSet1]
      | succ k' =>
        have hAr : idx + (k' + 1) = (idx + 1) + k' := by
          rw [Nat.add_assoc, Nat.add_comm 1 k']
        rw [hAr]
        exact hSuf2 k' val hkV

private theorem s3d_writeAdtFieldsSeq_direct {ed : AdtEnumDef} {v : Nat} {tag : Option Nat}
    (hAdm : adtEnumDefAdmitted ed = true) :
    ∀ (remTys : List MirTy) (remVals : List Val) (idx : Nat)
      (vfs : List (List (Option Val))) (fs : List (Option Val)),
      Trusted.MirSemantics.getElem? vfs v = some fs →
      remVals.length = remTys.length →
      idx + remTys.length = fs.length →
      (∀ k ty val,
        Trusted.MirSemantics.getElem? remTys k = some ty →
        Trusted.MirSemantics.getElem? remVals k = some val →
        checkVal val ty = true) →
      ∃ (vfs' : List (List (Option Val))) (fs' : List (Option Val)),
        writeAdtFieldsSeq ed v idx remTys remVals (.liveDirect tag vfs) =
          .ok (.liveDirect tag vfs') ∧
        setElem? vfs v fs' = some vfs' ∧
        fs'.length = fs.length ∧
        (∀ j, j < idx →
          Trusted.MirSemantics.getElem? fs' j = Trusted.MirSemantics.getElem? fs j) ∧
        (∀ k val, Trusted.MirSemantics.getElem? remVals k = some val →
          Trusted.MirSemantics.getElem? fs' (idx + k) = some (some val))
  | [], [], _, vfs, fs, hvfs, _, _, _ =>
    ⟨vfs, fs, rfl, setElem?_eq_self_of_getElem? hvfs, rfl,
     fun _ _ => rfl, fun _ _ h => by cases h⟩
  | [], _ :: _, _, _, _, _, hL, _, _ => by cases hL
  | _ :: _, [], _, _, _, _, hL, _, _ => by cases hL
  | ty₀ :: restTys, v₀ :: restVals, idx, vfs, fs, hvfs, hLen, hEnd, hChk => by
    have hChk0 : checkVal v₀ ty₀ = true := hChk 0 ty₀ v₀ rfl rfl
    have hIdxLt : idx < fs.length := by
      rw [← hEnd]
      exact Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)
    let ⟨fs₁, hSetFs1⟩ := setElem?_some_of_lt fs idx (some v₀) hIdxLt
    let ⟨vfs₁, hSetVfs1⟩ := setElem?_some_of_lt vfs v fs₁ (getElem?_some_lt hvfs)
    have hW1 : writeAdtField ed v idx ty₀ v₀ (.liveDirect tag vfs) =
        .ok (.liveDirect tag vfs₁) := by
      unfold writeAdtField
      rw [hAdm, hChk0]
      dsimp
      rw [hvfs]
      dsimp
      rw [hSetFs1]
      dsimp
      rw [hSetVfs1]
    have hLenFs1 : fs₁.length = fs.length := setElem?_length hSetFs1
    have hEndRest : (idx + 1) + restTys.length = fs₁.length := by
      rw [hLenFs1, Nat.add_assoc, Nat.add_comm 1 restTys.length]
      exact hEnd
    let ⟨vfs₂, fs₂, hSeqRest, hSetVfs2, hLenFs2, hPre2, hSuf2⟩ :=
      s3d_writeAdtFieldsSeq_direct (tag := tag) hAdm restTys restVals (idx + 1) vfs₁ fs₁
        (setElem?_getElem?_same hSetVfs1) (Nat.succ.inj hLen) hEndRest
        (fun k ty val hkT hkV => hChk (k + 1) ty val hkT hkV)
    have hSetTrans : ∀ {α : Type} {xs ys zs : List α} {i : Nat} {a b : α},
        setElem? xs i a = some ys → setElem? ys i b = some zs →
        setElem? xs i b = some zs := by
      intro α xs ys zs i a b h1 h2
      induction xs generalizing ys zs i with
      | nil => cases h1
      | cons x tl ih =>
        cases i with
        | zero =>
          injection h1 with hy; subst hy
          exact h2
        | succ i' =>
          change (match setElem? tl i' a with | some r => some (x :: r) | none => none) = some ys at h1
          cases hSub1 : setElem? tl i' a with
          | none => rw [hSub1] at h1; cases h1
          | some tlY =>
            rw [hSub1] at h1; injection h1 with hy; subst hy
            change (match setElem? tlY i' b with | some r => some (x :: r) | none => none) = some zs at h2
            cases hSub2 : setElem? tlY i' b with
            | none => rw [hSub2] at h2; cases h2
            | some tlZ =>
              rw [hSub2] at h2; injection h2 with hz; subst hz
              have hComb := ih hSub1 hSub2
              change (match setElem? tl i' b with | some r => some (x :: r) | none => none) = some (x :: tlZ)
              rw [hComb]
    unfold writeAdtFieldsSeq
    rw [hW1]
    dsimp
    refine ⟨vfs₂, fs₂, hSeqRest, hSetTrans hSetVfs1 hSetVfs2, hLenFs2.trans hLenFs1, ?_, ?_⟩
    · intro j hj
      rw [hPre2 j (Nat.lt_trans hj (Nat.lt_succ_self idx)),
          setElem?_getElem?_ne hSetFs1 (fun h => by subst h; exact Nat.lt_irrefl _ hj)]
    · intro k val hkV
      cases k with
      | zero =>
        injection hkV with hvEq; subst hvEq
        rw [Nat.add_zero, hPre2 idx (Nat.lt_succ_self idx), setElem?_getElem?_same hSetFs1]
      | succ k' =>
        have hAr : idx + (k' + 1) = (idx + 1) + k' := by
          rw [Nat.add_assoc, Nat.add_comm 1 k']
        rw [hAr]
        exact hSuf2 k' val hkV

private theorem s3d_writeAdtFieldsSeq_niche_zst {ed : AdtEnumDef} {tagW : IntWidth}
    {untagged nStart nLast : Nat} {nStartBits : BitVec 128}
    {tagRange : WrappingRange128} {nicheField : Nat} {uRange : WrappingRange128}
    {v : Nat}
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .niche tagW untagged nStart nLast nStartBits
      tagRange nicheField uRange)
    (hvNeU : Nat.beq v untagged = false)
    (hvGe : nStart ≤ v) (hvLe : v ≤ nLast) :
    ∀ (remTys : List MirTy) (remVals : List Val) (idx : Nat)
      (nb : Option (BitVec 128)) (extras : List (Option Val)),
      remVals.length = remTys.length →
      remTys.all isZstBaseTy = true →
      (∀ k ty val,
        Trusted.MirSemantics.getElem? remTys k = some ty →
        Trusted.MirSemantics.getElem? remVals k = some val →
        checkVal val ty = true) →
      writeAdtFieldsSeq ed v idx remTys remVals (.liveNiche nb extras) =
        .ok (.liveNiche nb extras)
  | [], [], _, _, _, _, _, _ => rfl
  | [], _ :: _, _, _, _, hL, _, _ => by cases hL
  | _ :: _, [], _, _, _, hL, _, _ => by cases hL
  | ty₀ :: restTys, v₀ :: restVals, idx, nb, extras, hLen, hZstAll, hChk => by
    dsimp [List.all] at hZstAll
    let ⟨hZst0, hZstRest⟩ := bool_and_true hZstAll
    have hChk0 : checkVal v₀ ty₀ = true := hChk 0 ty₀ v₀ rfl rfl
    have hW1 : writeAdtField ed v idx ty₀ v₀ (.liveNiche nb extras) =
        .ok (.liveNiche nb extras) := by
      unfold writeAdtField
      rw [hAdm, hChk0]
      dsimp
      rw [hLay]
      dsimp
      rw [hvNeU, nat_le_ble hvGe, nat_le_ble hvLe, hZst0]
      rfl
    unfold writeAdtFieldsSeq
    rw [hW1]
    dsimp
    exact s3d_writeAdtFieldsSeq_niche_zst hAdm hLay hvNeU hvGe hvLe
      restTys restVals (idx + 1) nb extras (Nat.succ.inj hLen) hZstRest
      (fun k ty val hkT hkV => hChk (k + 1) ty val hkT hkV)

/-! ### 5. Off-Target Body Simulation (`f₁.defId ≠ plan.defId`) -/

private theorem s3d_evalEnumStmt_callerMem (eds : List AdtEnumDef) (b : EnumBody)
    (f : EnumFrame) (cm : CallerMemory) (st : EnumStmt) :
    ∀ {s' : EnumState}, evalEnumStmt eds b f cm st = .step s' → s'.callerMem = cm := by
  unfold evalEnumStmt
  cases st with
  | baseStmt bs =>
    cases bs with
    | nop => intro _ h; injection h with hs; rw [← hs]
    | unsupported => intro _ h; cases h
    | storageLive lid =>
      dsimp
      cases Trusted.MirSemantics.getElem? b.locals lid with
      | none => intro _ h; cases h
      | some d =>
        dsimp
        cases liveUninitEnumSlot eds d with
        | none => intro _ h; cases h
        | some sl =>
          dsimp
          cases setElem? f.locals lid sl with
          | none => intro _ h; cases h
          | some _ => intro _ h; injection h with hs; rw [← hs]
    | storageDead lid =>
      dsimp
      cases Nat.beq lid 0 with
      | true => intro _ h; cases h
      | false =>
        dsimp
        cases setElem? f.locals lid _ with
        | none => intro _ h; cases h
        | some _ => intro _ h; injection h with hs; rw [← hs]
    | assign dst rv =>
      dsimp
      cases (!dst.projection.isEmpty) with
      | true => intro _ h; cases h
      | false =>
        dsimp
        cases Trusted.MirSemantics.getElem? b.locals dst.localId with
        | none => intro _ h; cases h
        | some dd =>
          cases dd with
          | adtEnum _ => intro _ h; cases h
          | base dTy =>
            dsimp
            cases evalEnumBaseRvalue b.locals f.locals dTy rv with
            | error _ => intro _ h; cases h
            | ok p1 =>
              cases p1 with
              | mk val s1 =>
                dsimp
                cases writeEnumBasePlace s1 dst.localId dTy val with
                | error _ => intro _ h; cases h
                | ok _ => intro _ h; injection h with hs; rw [← hs]
  | setDiscriminant lid v =>
    dsimp
    cases Trusted.MirSemantics.getElem? b.locals lid with
    | none => intro _ h; cases h
    | some dd =>
      cases dd with
      | base _ => intro _ h; cases h
      | adtEnum eI =>
        cases Trusted.MirSemantics.getElem? f.locals lid with
        | none => intro _ h; cases h
        | some sl =>
          dsimp
          cases Trusted.MirSemantics.getElem? eds eI with
          | none => intro _ h; cases h
          | some ed0 =>
            dsimp
            cases writeAdtDiscriminant ed0 v sl with
            | error _ => intro _ h; cases h
            | ok sl' =>
              dsimp
              cases setElem? f.locals lid sl' with
              | none => intro _ h; cases h
              | some _ => intro _ h; injection h with hs; rw [← hs]
  | assignField lid v fl rv =>
    dsimp
    cases rvalueMentionsLocal lid rv with
    | true => intro _ h; cases h
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? b.locals lid with
      | none => intro _ h; cases h
      | some dd =>
        cases dd with
        | base _ => intro _ h; cases h
        | adtEnum eI =>
          dsimp
          cases Trusted.MirSemantics.getElem? eds eI with
          | none => intro _ h; cases h
          | some ed0 =>
            dsimp
            cases Trusted.MirSemantics.getElem? ed0.variants v with
            | none => intro _ h; cases h
            | some vd0 =>
              dsimp
              cases Trusted.MirSemantics.getElem? vd0.fields fl with
              | none => intro _ h; cases h
              | some fTy =>
                dsimp
                cases evalEnumBaseRvalue b.locals f.locals fTy rv with
                | error _ => intro _ h; cases h
                | ok p1 =>
                  cases p1 with
                  | mk val s1 =>
                    dsimp
                    cases Trusted.MirSemantics.getElem? s1 lid with
                    | none => intro _ h; cases h
                    | some sl =>
                      dsimp
                      cases writeAdtField ed0 v fl fTy val sl with
                      | error _ => intro _ h; cases h
                      | ok sl' =>
                        dsimp
                        cases setElem? s1 lid sl' with
                        | none => intro _ h; cases h
                        | some _ => intro _ h; injection h with hs; rw [← hs]
  | readField dl slId v fl im =>
    dsimp
    cases Nat.beq dl slId with
    | true => intro _ h; cases h
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? b.locals dl with
      | none => intro _ h; cases h
      | some dd =>
        cases dd with
        | adtEnum _ => intro _ h; cases h
        | base dTy =>
          cases Trusted.MirSemantics.getElem? b.locals slId with
          | none => intro _ h; cases h
          | some sd =>
            cases sd with
            | base _ => intro _ h; cases h
            | adtEnum eI =>
              cases Trusted.MirSemantics.getElem? f.locals slId with
              | none => intro _ h; cases h
              | some sl =>
                dsimp
                cases Trusted.MirSemantics.getElem? eds eI with
                | none => intro _ h; cases h
                | some ed0 =>
                  dsimp
                  cases Trusted.MirSemantics.getElem? ed0.variants v with
                  | none => intro _ h; cases h
                  | some vd0 =>
                    dsimp
                    cases Trusted.MirSemantics.getElem? vd0.fields fl with
                    | none => intro _ h; cases h
                    | some fTy =>
                      dsimp
                      cases (!MirTy.beq fTy dTy) with
                      | true => intro _ h; cases h
                      | false =>
                        dsimp
                        cases readAdtField ed0 v fl fTy im sl with
                        | error _ => intro _ h; cases h
                        | ok pr =>
                          cases pr with
                          | mk val sl' =>
                            dsimp
                            cases setElem? f.locals slId sl' with
                            | none => intro _ h; cases h
                            | some s1 =>
                              dsimp
                              cases writeEnumBasePlace s1 dl dTy val with
                              | error _ => intro _ h; cases h
                              | ok _ => intro _ h; injection h with hs; rw [← hs]
  | aggregateEnum dl v ops =>
    dsimp
    cases ops.any (stmtMentionsLocalOperand dl) with
    | true => intro _ h; cases h
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? b.locals dl with
      | none => intro _ h; cases h
      | some dd =>
        cases dd with
        | base _ => intro _ h; cases h
        | adtEnum eI =>
          dsimp
          cases Trusted.MirSemantics.getElem? eds eI with
          | none => intro _ h; cases h
          | some ed0 =>
            dsimp
            cases (!adtEnumDefAdmitted ed0) with
            | true => intro _ h; cases h
            | false =>
              dsimp
              cases Trusted.MirSemantics.getElem? ed0.variants v with
              | none => intro _ h; cases h
              | some vd0 =>
                dsimp
                cases evalAggregateEnumOperands b.locals f.locals ops vd0.fields with
                | error _ => intro _ h; cases h
                | ok pr =>
                  cases pr with
                  | mk vals s1 =>
                    dsimp
                    cases Trusted.MirSemantics.getElem? s1 dl with
                    | none => intro _ h; cases h
                    | some sl =>
                      cases sl with
                      | enumDead => intro _ h; cases h
                      | baseSlot _ | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
                        dsimp
                        cases variantIsUninhabited vd0 with
                        | true => intro _ h; cases h
                        | false =>
                          dsimp
                          cases writeAdtFieldsSeq ed0 v 0 vd0.fields vals _ with
                          | error _ => intro _ h; cases h
                          | ok sl1 =>
                            dsimp
                            cases writeAdtDiscriminant ed0 v sl1 with
                            | error _ => intro _ h; cases h
                            | ok sl2 =>
                              dsimp
                              cases setElem? s1 dl sl2 with
                              | none => intro _ h; cases h
                              | some _ => intro _ h; injection h with hs; rw [← hs]
  | discriminantDirect dl slId =>
    dsimp
    cases Trusted.MirSemantics.getElem? b.locals dl with
    | none => intro _ h; cases h
    | some dd =>
      cases dd with
      | adtEnum _ => intro _ h; cases h
      | base dTy =>
        cases Trusted.MirSemantics.getElem? b.locals slId with
        | none => intro _ h; cases h
        | some sd =>
          cases sd with
          | base _ => intro _ h; cases h
          | adtEnum eI =>
            cases Trusted.MirSemantics.getElem? f.locals slId with
            | none => intro _ h; cases h
            | some sl =>
              dsimp
              cases Trusted.MirSemantics.getElem? eds eI with
              | none => intro _ h; cases h
              | some ed0 =>
                dsimp
                cases (!MirTy.beq dTy (.int ed0.discrWidth ed0.discrSigned)) with
                | true => intro _ h; cases h
                | false =>
                  dsimp
                  cases ed0.layout with
                  | niche _ _ _ _ _ _ _ _ => intro _ h; cases h
                  | empty | single | direct _ _ =>
                    dsimp
                    cases readAdtDiscriminant ed0 sl with
                    | error _ => intro _ h; cases h
                    | ok dv =>
                      dsimp
                      cases writeEnumBasePlace f.locals dl dTy dv with
                      | error _ => intro _ h; cases h
                      | ok _ => intro _ h; injection h with hs; rw [← hs]

private theorem s3d_evalEnumTerminator_callerMem (eds : List AdtEnumDef) (b : EnumBody)
    (bb : EnumBlock) (f : EnumFrame) (cm : CallerMemory) :
    ∀ {s' : EnumState}, evalEnumTerminator eds b bb f cm = .step s' → s'.callerMem = cm := by
  unfold evalEnumTerminator
  cases bb.terminator with
  | baseTerm bt =>
    cases bt with
    | goto _ => unfold jumpToEnumBlock; intro _ h; injection h with hs; rw [← hs]
    | return_ =>
      dsimp
      cases bb.cleanup with
      | true => intro _ h; cases h
      | false =>
        dsimp
        cases Trusted.MirSemantics.getElem? f.locals 0 with
        | none => intro _ h; cases h
        | some sl0 =>
          cases sl0 with
          | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
            intro _ h; cases h
          | baseSlot bsl =>
            cases bsl with
            | dead => intro _ h; cases h
            | live ov => cases ov <;> (intro _ h; cases h)
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      intro _ h; cases h
    | switchInt discr targets =>
      dsimp
      cases evalEnumPrimitiveOperand b.locals f.locals discr with
      | error _ => intro _ h; cases h
      | ok pr =>
        cases pr with
        | mk dv s1 =>
          dsimp
          cases dv with
          | ptr _ | unit | enumVal _ _ | tuple _ | bytes _ => intro _ h; cases h
          | scalar sv =>
            dsimp
            cases evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
            | error _ => intro _ h; cases h
            | ok _ => unfold jumpToEnumBlock; intro _ h; injection h with hs; rw [← hs]
          | bool b0 =>
            dsimp
            cases evalBoolSwitchBranches b0 targets.otherwise targets.branches with
            | error _ => intro _ h; cases h
            | ok _ => unfold jumpToEnumBlock; intro _ h; injection h with hs; rw [← hs]
  | switchDiscr dDst eLoc targets =>
    dsimp
    cases Trusted.MirSemantics.getElem? b.locals dDst with
    | none => intro _ h; cases h
    | some dd =>
      cases dd with
      | adtEnum _ => intro _ h; cases h
      | base dTy =>
        cases Trusted.MirSemantics.getElem? b.locals eLoc with
        | none => intro _ h; cases h
        | some edD =>
          cases edD with
          | base _ => intro _ h; cases h
          | adtEnum eI =>
            cases Trusted.MirSemantics.getElem? f.locals eLoc with
            | none => intro _ h; cases h
            | some sl =>
              dsimp
              cases Trusted.MirSemantics.getElem? eds eI with
              | none => intro _ h; cases h
              | some ed0 =>
                dsimp
                cases (!MirTy.beq dTy (.int ed0.discrWidth ed0.discrSigned)) with
                | true => intro _ h; cases h
                | false =>
                  dsimp
                  cases readAdtDiscriminant ed0 sl with
                  | error _ => intro _ h; cases h
                  | ok dv =>
                    dsimp
                    cases writeEnumBasePlace f.locals dDst dTy dv with
                    | error _ => intro _ h; cases h
                    | ok s1 =>
                      dsimp
                      cases dv with
                      | ptr _ | bool _ | unit | enumVal _ _ | tuple _ | bytes _ =>
                        intro _ h; cases h
                      | scalar sv =>
                        dsimp
                        cases evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches with
                        | error _ => intro _ h; cases h
                        | ok _ => unfold jumpToEnumBlock; intro _ h; injection h with hs; rw [← hs]

private theorem s3d_offTarget_step_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ : EnumFrame} {cm : CallerMemory}
    (hNe : f₁.defId ≠ plan.defId) :
    let s : EnumState := { frames := [f₁], callerMem := cm }
    SimStepResult ctx s (evalStepEnum pSrc 0 s) := by
  dsimp
  let s : EnumState := { frames := [f₁], callerMem := cm }
  have hBGetEq : Trusted.MirSemantics.getElem? pOut.bodies f₁.defId =
      Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId := by
    rw [ctx.hPOut]; dsimp
    exact setElem?_getElem?_ne ctx.hSetBody hNe
  have hStepEqAndShape :
      evalStepEnum pOut 0 s = evalStepEnum pSrc 0 s ∧
      (∀ s', evalStepEnum pSrc 0 s = .step s' →
        ∃ f', s' = { frames := [f'], callerMem := cm } ∧ f'.defId = f₁.defId) := by
    unfold evalStepEnum
    dsimp [s]
    rw [hBGetEq]
    cases hbS : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId with
    | none => exact ⟨rfl, fun _ h => by cases h⟩
    | some bOther =>
      have hbOut : Trusted.MirSemantics.getElem? pOut.bodies f₁.defId = some bOther :=
        hBGetEq.trans hbS
      let ⟨hStEq, hTmEq, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hbOut
      dsimp
      cases Trusted.MirSemantics.getElem? bOther.basicBlocks f₁.blockIdx with
      | none => exact ⟨rfl, fun _ h => by cases h⟩
      | some obb =>
        dsimp
        cases Trusted.MirSemantics.getElem? obb.statements f₁.stmtIdx with
        | some st =>
          dsimp
          refine ⟨hStEq f₁ cm st, ?_⟩
          intro s' hEv
          let ⟨f', hf', hDef', _⟩ := evalEnumStmt_step_shape pSrc.enumDefs bOther f₁ cm st s' hEv
          have hCm := s3d_evalEnumStmt_callerMem pSrc.enumDefs bOther f₁ cm st hEv
          cases s' with
          | mk frs cm' =>
            dsimp at hf' hCm; subst hf'; subst hCm
            exact ⟨f', rfl, hDef'⟩
        | none =>
          dsimp
          cases Nat.beq f₁.stmtIdx obb.statements.length with
          | false => exact ⟨rfl, fun _ h => by cases h⟩
          | true =>
            dsimp
            refine ⟨hTmEq obb f₁ cm, ?_⟩
            intro s' hEv
            let ⟨f', hf', hDef'⟩ := evalEnumTerminator_preserves_defId pSrc.enumDefs bOther obb f₁ cm s' hEv
            have hCm := s3d_evalEnumTerminator_callerMem pSrc.enumDefs bOther obb f₁ cm hEv
            cases s' with
            | mk frs cm' =>
              dsimp at hf' hCm; subst hf'; subst hCm
              exact ⟨f', rfl, hDef'⟩
  let ⟨hEvEq, hShape⟩ := hStepEqAndShape
  cases hEv1 : evalStepEnum pSrc 0 s with
  | fault fk => exact simFault0 rfl (hEvEq.trans hEv1)
  | done out => exact simDone0 rfl (hEvEq.trans hEv1)
  | step s₁' =>
    let ⟨f₁', hs1Eq, hDef'⟩ := hShape s₁' hEv1
    have hNe' : f₁'.defId ≠ plan.defId := by rw [hDef']; exact hNe
    refine simStep1 rfl (hEvEq.trans hEv1) ⟨?_, ?_⟩
    · subst hs1Eq
      refine ⟨rfl, f₁', f₁', rfl, rfl, rfl, ?_⟩
      rw [if_false_of_not_prop hNe']
    · subst hs1Eq
      intro fx _ _ _ hfx hfxDef
      dsimp at hfx
      injection hfx with hxEq; subst hxEq
      exact False.elim (hNe' hfxDef)

/-! ### 6. Target-Body Post-Statement Relation Constructor -/

private theorem s3d_mkTargetPostStmtSimRel {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb : EnumBlock} {stmt : EnumStmt}
    {slots₁' slots₂' : List EnumSlot} {sl' : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx = some stmt)
    (hF2Idx : f₂.stmtIdx =
      (listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx)).length)
    (hPre' : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal slots₁' slots₂')
    (hSl1' : Trusted.MirSemantics.getElem? slots₁' plan.enumLocal = some sl')
    (hMatch' : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl' slots₂')
    (hDirectInv' : ∀ v vfs vd,
      sl' = .liveDirect (some v) vfs →
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
      variantIsUninhabited vd = false) :
    let loweredLen :=
      (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed stmt).length
    ScalarizeSimRel ctx
      { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], callerMem := cm }
      { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + loweredLen, locals := slots₂' }], callerMem := cm } := by
  dsimp
  have hTakeNext :
      (listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take (f₁.stmtIdx + 1))).length =
      f₂.stmtIdx +
        (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed stmt).length := by
    let ⟨_, hTakeEq⟩ := listFlatMap_take_split
      (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
      bb.statements hStmt1
    rw [hTakeEq, list_append_length, hF2Idx]
  refine ⟨⟨rfl, _, _, rfl, rfl, hDef2, ?_⟩, ?_⟩
  · dsimp
    rw [if_true_of_prop hDef1]
    exact ⟨bb, hBB1, hBlkEq, Nat.succ_le_of_lt (getElem?_some_lt hStmt1),
           hTakeNext.symm, hPre', sl', hSl1', hMatch'⟩
  · intro fx v vfs vd hfx _ hGetSl hvGet
    dsimp at hfx
    injection hfx with hxEq; subst hxEq
    dsimp at hGetSl
    rw [hSl1'] at hGetSl
    injection hGetSl with hslEq
    exact hDirectInv' v vfs vd hslEq hvGet

/-! ### 7. Target `.baseStmt`, Non-`enumLocal` Enum Statements, & `discriminantDirect` -/

private theorem s3d_oneStep_unchanged_stmt {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb bbTgt : EnumBlock}
    {preStmts postStmts : List EnumStmt} {stmt : EnumStmt} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx = some stmt)
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hPreEq : preStmts =
      listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx))
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hLowerEq : lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed stmt = [stmt])
    (hBbTgtStmts : bbTgt.statements =
      preStmts ++
        lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed stmt ++
        postStmts)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm })
    (hGoal :
      (∀ fk, evalEnumStmt pSrc.enumDefs ctx.body f₁ cm stmt = .fault fk →
        evalEnumStmt pSrc.enumDefs (scalarizeTargetBody ctx) f₂ cm stmt = .fault fk) ∧
      (∀ out, evalEnumStmt pSrc.enumDefs ctx.body f₁ cm stmt = .done out → False) ∧
      (∀ s₁', evalEnumStmt pSrc.enumDefs ctx.body f₁ cm stmt = .step s₁' →
        ∃ slots₁' slots₂',
          s₁' = { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }], callerMem := cm } ∧
          evalEnumStmt pSrc.enumDefs (scalarizeTargetBody ctx) f₂ cm stmt =
            .step { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂' }], callerMem := cm } ∧
          PrefixSlotsAgree ctx.body.locals.length plan.enumLocal slots₁' slots₂' ∧
          Trusted.MirSemantics.getElem? slots₁' plan.enumLocal = some sl ∧
          SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl slots₂')) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumStmt pSrc.enumDefs ctx.body f₁ cm stmt) := by
  have hSt2 : bbTgt.statements = preStmts ++ stmt :: postStmts := by
    rw [hBbTgtStmts, hLowerEq, List.append_assoc]; rfl
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  have hEv2Eq : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
      evalEnumStmt pSrc.enumDefs (scalarizeTargetBody ctx) f₂ cm stmt :=
    (stepAtStmt hB2 hBB2 hSt2 hF2Idx).trans (hStepEqDefs f₂ cm stmt)
  have hInvSl : ∀ v vfs vd,
      sl = .liveDirect (some v) vfs →
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
      variantIsUninhabited vd = false :=
    fun v vfs vd hsl hv => hDirectInv f₁ v vfs vd rfl hDef1 (by rw [hsl] at hSl1; exact hSl1) hv
  cases hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm stmt with
  | fault fk =>
    exact simFault0 rfl (hEv2Eq.trans (hGoal.1 fk hEv1))
  | done out =>
    exact False.elim (hGoal.2.1 out hEv1)
  | step s₁' =>
    let ⟨slots₁', slots₂', hs1Eq, hEv2Step, hPre', hSl1', hMatch'⟩ := hGoal.2.2 s₁' hEv1
    have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
      (hF2Idx.trans (congrArg List.length hPreEq)) hPre' hSl1' hMatch' hInvSl
    dsimp at hPost
    rw [hLowerEq] at hPost
    dsimp [List.length] at hPost
    rw [hs1Eq]
    exact simStep1 rfl (hEv2Eq.trans hEv2Step) hPost

private theorem s3d_baseStmt_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb bbTgt : EnumBlock}
    {preStmts postStmts : List EnumStmt} {bs : StatementKind} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx = some (.baseStmt bs))
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hPreEq : preStmts =
      listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx))
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hBbTgtStmts : bbTgt.statements =
      preStmts ++
        lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed (.baseStmt bs) ++
        postStmts)
    (hStChk : checkStmtForEnumLocal ctx.body.locals plan.enumLocal ctx.ed (.baseStmt bs) = true)
    (hStBnd : enumStmtLocalsInBounds ctx.body.locals.length (.baseStmt bs) = true)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals)
    (hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm }) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumStmt pSrc.enumDefs ctx.body f₁ cm (.baseStmt bs)) := by
  let base := ctx.body.locals.length
  let bodyTgt := scalarizeTargetBody ctx
  let ⟨_, hDeclE_Tgt, hDeclPre, hDeclComp⟩ := scalarizeCtx_target_decl_lookup ctx
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  cases bs with
  | unsupported =>
    unfold checkStmtForEnumLocal at hStChk
    cases hStChk
  | nop =>
    exact s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
      hB2 hBB2 rfl hBbTgtStmts hSl1 hDirectInv
      ⟨(fun _ h => by cases h), (fun _ h => by cases h),
       fun s₁' h => by
         injection h with hs
         exact ⟨f₁.locals, f₂.locals, hs.symm, rfl, hPre, hSl1, hMatch⟩⟩
  | storageLive id =>
    unfold enumStmtLocalsInBounds at hStBnd
    have hidLt : id < base := nat_blt_lt hStBnd
    cases hEqId : Nat.beq id plan.enumLocal with
    | false =>
      have hidNe : id ≠ plan.enumLocal := nat_ne_of_beq_false hEqId
      have hLow : lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
          (.baseStmt (.storageLive id)) = [.baseStmt (.storageLive id)] := by
        dsimp [lowerEnumStmt]; rw [hEqId]; rfl
      refine s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
        hB2 hBB2 hLow hBbTgtStmts hSl1 hDirectInv ?_
      unfold evalEnumStmt; dsimp
      rw [hDeclPre id hidLt hidNe]
      cases Trusted.MirSemantics.getElem? ctx.body.locals id with
      | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
      | some d =>
        dsimp
        cases liveUninitEnumSlot pSrc.enumDefs d with
        | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
        | some initSl =>
          dsimp
          let ⟨slots₁', hSet1⟩ := setElem?_some_of_lt f₁.locals id initSl
            (by rw [hPre.1]; exact hidLt)
          let ⟨slots₂', hSet2⟩ := setElem?_some_of_lt f₂.locals id initSl
            (Nat.lt_of_lt_of_le hidLt hPre.2.1)
          rw [hSet1, hSet2]; dsimp
          refine ⟨(fun _ h => by cases h), (fun _ h => by cases h), ?_⟩
          intro s₁' h; injection h with hs
          refine ⟨slots₁', slots₂', hs.symm, rfl, ?_, ?_, ?_⟩
          · refine ⟨(setElem?_length hSet1).trans hPre.1,
                    by rw [setElem?_length hSet2]; exact hPre.2.1, ?_⟩
            intro j hjLt hjNe
            cases hEqJ : Nat.beq j id with
            | true =>
              have hjEq : j = id := nat_beq_eq hEqJ; subst hjEq
              rw [setElem?_getElem?_same hSet2, setElem?_getElem?_same hSet1]
            | false =>
              have hjNeI : j ≠ id := nat_ne_of_beq_false hEqJ
              rw [setElem?_getElem?_ne hSet2 hjNeI, setElem?_getElem?_ne hSet1 hjNeI]
              exact hPre.2.2 j hjLt hjNe
          · rw [setElem?_getElem?_ne hSet1 (fun h => hidNe h.symm)]; exact hSl1
          · exact slotMatchesComp_congr_ge_base hMatch (setElem?_length hSet2)
              (fun k hk => setElem?_getElem?_ne hSet2
                (fun h => by subst h; exact Nat.not_lt_of_ge hk hidLt))
    | true =>
      have hidEq : id = plan.enumLocal := nat_beq_eq hEqId
      subst hidEq
      dsimp [lowerEnumStmt] at hBbTgtStmts
      rw [nat_beq_refl] at hBbTgtStmts; dsimp at hBbTgtStmts
      have hSt1 : bbTgt.statements = preStmts ++
          (EnumStmt.baseStmt (.storageLive plan.enumLocal)) ::
          (mkStorageLiveRange base ctx.compTys.length ++ postStmts) := by
        rw [hBbTgtStmts, List.append_assoc]; rfl
      let ⟨slots₂Mid, hSet2Mid⟩ := setElem?_some_of_lt f₂.locals plan.enumLocal
        (.baseSlot (.live (some .unit))) (Nat.lt_of_lt_of_le ctx.hEnumLtBase hPre.2.1)
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1, locals := slots₂Mid }],
                  callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs]
        unfold evalEnumStmt liveUninitEnumSlot
        dsimp
        rw [hDeclE_Tgt]
        dsimp
        have hLUUnit : liveUninitSlot .unit = .live (some .unit) := rfl
        rw [hLUUnit, hSet2Mid, hF2Idx]
      have hStRange : bbTgt.statements =
          (preStmts ++ [EnumStmt.baseStmt (.storageLive plan.enumLocal)]) ++
          mkStorageLiveRange base ctx.compTys.length ++ postStmts := by
        rw [hSt1]
        change preStmts ++ ([EnumStmt.baseStmt (.storageLive plan.enumLocal)] ++
          (mkStorageLiveRange base ctx.compTys.length ++ postStmts)) = _
        rw [← List.append_assoc, ← List.append_assoc]
      have hPre1Len : (preStmts ++ [EnumStmt.baseStmt (.storageLive plan.enumLocal)]).length =
          preStmts.length + 1 := list_append_length preStmts [_]
      have hBoundMid : base + ctx.compTys.length ≤ slots₂Mid.length := by
        rw [setElem?_length hSet2Mid, hMatch.1]; exact Nat.le_refl _
      let ⟨slots₂', hRRange, hLen2', hPresOut, hCompLive⟩ :=
        exec_mkStorageLiveRange (p := pOut) (body := bodyTgt) (bb := bbTgt)
          (defId := f₂.defId) (blockIdx := f₂.blockIdx) (cm := cm)
          ctx.compTys base (preStmts ++ [EnumStmt.baseStmt (.storageLive plan.enumLocal)])
          postStmts slots₂Mid hStRange hB2 hBB2 hDeclComp hBoundMid
      rw [hPre1Len] at hRRange
      let ⟨slInit, hLiveEEq, hMatchInit⟩ :=
        liveUninitEnumSlot_matches_liveComp ctx.hEdGet ctx.hEdAdm ctx.hComp
          (hLen2'.trans ((setElem?_length hSet2Mid).trans hMatch.1))
          (fun i ty _ hTy => hCompLive i ty hTy)
      let ⟨slots₁', hSet1⟩ := setElem?_some_of_lt f₁.locals plan.enumLocal slInit
        (by rw [hPre.1]; exact ctx.hEnumLtBase)
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm (.baseStmt (.storageLive plan.enumLocal)) =
          .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }],
                  callerMem := cm } := by
        unfold evalEnumStmt; dsimp
        rw [ctx.hEnumDecl]; dsimp
        rw [hLiveEEq]; dsimp
        rw [hSet1]
      have hPre' : PrefixSlotsAgree base plan.enumLocal slots₁' slots₂' := by
        refine ⟨(setElem?_length hSet1).trans hPre.1,
                by rw [hLen2', setElem?_length hSet2Mid]; exact hPre.2.1, ?_⟩
        intro j hjLt hjNe
        rw [hPresOut j (Or.inl hjLt),
            setElem?_getElem?_ne hSet2Mid hjNe,
            setElem?_getElem?_ne hSet1 hjNe]
        exact hPre.2.2 j hjLt hjNe
      have hInvInit : ∀ v vfs vd,
          slInit = .liveDirect (some v) vfs →
          Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
          variantIsUninhabited vd = false := by
        intro v vfs _ hslEq _
        exact False.elim (s3d_liveUninitEnumSlot_not_some_direct pSrc.enumDefs ctx.eIdx v vfs
          (hLiveEEq.trans (congrArg some hslEq)))
      have hLoweredLen :
          (lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
            (.baseStmt (.storageLive plan.enumLocal))).length =
          ctx.compTys.length + 1 := by
        dsimp [lowerEnumStmt]
        rw [nat_beq_refl]
        dsimp [List.length]
        have hMkLen : ∀ (st k : Nat), (mkStorageLiveRange st k).length = k := by
          intro st k
          induction k generalizing st with
          | zero => rfl
          | succ k' ih => dsimp [mkStorageLiveRange, List.length]; exact congrArg Nat.succ (ih (st + 1))
        exact congrArg Nat.succ (hMkLen base ctx.compTys.length)
      have hIdxR : preStmts.length + 1 + ctx.compTys.length =
          f₂.stmtIdx + (lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
            (.baseStmt (.storageLive plan.enumLocal))).length := by
        rw [hLoweredLen, ← hF2Idx, Nat.add_assoc, Nat.add_comm 1 ctx.compTys.length]
      rw [hIdxR] at hRRange
      exact simStepPlus hEv1 hStep1 hRRange
        (s3d_mkTargetPostStmtSimRel ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
          (hF2Idx.trans (congrArg List.length hPreEq)) hPre'
          (setElem?_getElem?_same hSet1) hMatchInit hInvInit)
  | storageDead id =>
    unfold enumStmtLocalsInBounds at hStBnd
    unfold checkStmtForEnumLocal at hStChk
    have hidLt : id < base := nat_blt_lt hStBnd
    have hidNe0 : Nat.beq id 0 = false := bool_not_true hStChk
    cases hEqId : Nat.beq id plan.enumLocal with
    | false =>
      have hidNe : id ≠ plan.enumLocal := nat_ne_of_beq_false hEqId
      have hLow : lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
          (.baseStmt (.storageDead id)) = [.baseStmt (.storageDead id)] := by
        dsimp [lowerEnumStmt]; rw [hEqId]; rfl
      refine s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
        hB2 hBB2 hLow hBbTgtStmts hSl1 hDirectInv ?_
      unfold evalEnumStmt; dsimp
      rw [hidNe0, hDeclPre id hidLt hidNe]; dsimp
      have hDeadCase : ∀ deadSl : EnumSlot,
          (∀ fk, (match setElem? f₁.locals id deadSl with
                  | some slots' =>
                    (StepResult.step (EnumState.mk [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots' }] cm) :
                      StepResult EnumState TerminalOut)
                  | none => StepResult.fault FaultKind.unsupported) = .fault fk →
            (match setElem? f₂.locals id deadSl with
             | some slots' =>
               (StepResult.step (EnumState.mk [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots' }] cm) :
                 StepResult EnumState TerminalOut)
             | none => StepResult.fault FaultKind.unsupported) = .fault fk) ∧
          (∀ out, (match setElem? f₁.locals id deadSl with
                   | some slots' =>
                     (StepResult.step (EnumState.mk [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots' }] cm) :
                       StepResult EnumState TerminalOut)
                   | none => StepResult.fault FaultKind.unsupported) = .done out → False) ∧
          (∀ s₁', (match setElem? f₁.locals id deadSl with
                   | some slots' =>
                     (StepResult.step (EnumState.mk [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots' }] cm) :
                       StepResult EnumState TerminalOut)
                   | none => StepResult.fault FaultKind.unsupported) = .step s₁' →
            ∃ slots₁' slots₂',
              s₁' = EnumState.mk [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }] cm ∧
              (match setElem? f₂.locals id deadSl with
               | some slots' =>
                 (StepResult.step (EnumState.mk [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots' }] cm) :
                   StepResult EnumState TerminalOut)
               | none => StepResult.fault FaultKind.unsupported) =
                .step (EnumState.mk [{ f₂ with stmtIdx := f₂.stmtIdx + 1, locals := slots₂' }] cm) ∧
              PrefixSlotsAgree base plan.enumLocal slots₁' slots₂' ∧
              Trusted.MirSemantics.getElem? slots₁' plan.enumLocal = some sl ∧
              SlotMatchesComp ctx.ed base ctx.compTys sl slots₂') := by
        intro deadSl
        let ⟨slots₁', hSet1⟩ := setElem?_some_of_lt f₁.locals id deadSl
          (by rw [hPre.1]; exact hidLt)
        let ⟨slots₂', hSet2⟩ := setElem?_some_of_lt f₂.locals id deadSl
          (Nat.lt_of_lt_of_le hidLt hPre.2.1)
        rw [hSet1, hSet2]; dsimp
        refine ⟨(fun _ h => by cases h), (fun _ h => by cases h), ?_⟩
        intro s₁' h; injection h with hs
        refine ⟨slots₁', slots₂', hs.symm, rfl, ?_, ?_, ?_⟩
        · refine ⟨(setElem?_length hSet1).trans hPre.1,
                  by rw [setElem?_length hSet2]; exact hPre.2.1, ?_⟩
          intro j hjLt hjNe
          cases hEqJ : Nat.beq j id with
          | true =>
            have hjEq : j = id := nat_beq_eq hEqJ; subst hjEq
            rw [setElem?_getElem?_same hSet2, setElem?_getElem?_same hSet1]
          | false =>
            have hjNeI : j ≠ id := nat_ne_of_beq_false hEqJ
            rw [setElem?_getElem?_ne hSet2 hjNeI, setElem?_getElem?_ne hSet1 hjNeI]
            exact hPre.2.2 j hjLt hjNe
        · rw [setElem?_getElem?_ne hSet1 (fun h => hidNe h.symm)]; exact hSl1
        · exact slotMatchesComp_congr_ge_base hMatch (setElem?_length hSet2)
            (fun k hk => setElem?_getElem?_ne hSet2
              (fun h => by subst h; exact Nat.not_lt_of_ge hk hidLt))
      exact hDeadCase _
    | true =>
      have hidEq : id = plan.enumLocal := nat_beq_eq hEqId
      subst hidEq
      dsimp [lowerEnumStmt] at hBbTgtStmts
      rw [nat_beq_refl] at hBbTgtStmts; dsimp at hBbTgtStmts
      have hSt1 : bbTgt.statements = preStmts ++
          (EnumStmt.baseStmt (.storageDead plan.enumLocal)) ::
          (mkStorageDeadRange base ctx.compTys.length ++ postStmts) := by
        rw [hBbTgtStmts, List.append_assoc]; rfl
      let ⟨slots₂Mid, hSet2Mid⟩ := setElem?_some_of_lt f₂.locals plan.enumLocal
        (.baseSlot .dead) (Nat.lt_of_lt_of_le ctx.hEnumLtBase hPre.2.1)
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1, locals := slots₂Mid }],
                  callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs]
        unfold evalEnumStmt; dsimp
        rw [hidNe0]; dsimp
        rw [hDeclE_Tgt]; dsimp
        rw [hSet2Mid, hF2Idx]
      have hStRange : bbTgt.statements =
          (preStmts ++ [EnumStmt.baseStmt (.storageDead plan.enumLocal)]) ++
          mkStorageDeadRange base ctx.compTys.length ++ postStmts := by
        rw [hSt1]
        change preStmts ++ ([EnumStmt.baseStmt (.storageDead plan.enumLocal)] ++
          (mkStorageDeadRange base ctx.compTys.length ++ postStmts)) = _
        rw [← List.append_assoc, ← List.append_assoc]
      have hPre1Len : (preStmts ++ [EnumStmt.baseStmt (.storageDead plan.enumLocal)]).length =
          preStmts.length + 1 := list_append_length preStmts [_]
      have hBasePos : 0 < base :=
        Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.zero_le _) ctx.hArgLtEnum) ctx.hEnumLtBase
      have hBoundMid : base + ctx.compTys.length ≤ slots₂Mid.length := by
        rw [setElem?_length hSet2Mid, hMatch.1]; exact Nat.le_refl _
      let ⟨slots₂', hRRange, hLen2', hPresOut, hCompDead⟩ :=
        exec_mkStorageDeadRange (p := pOut) (body := bodyTgt) (bb := bbTgt)
          (defId := f₂.defId) (blockIdx := f₂.blockIdx) (cm := cm)
          ctx.compTys.length base (preStmts ++ [EnumStmt.baseStmt (.storageDead plan.enumLocal)])
          postStmts slots₂Mid hBasePos hStRange hB2 hBB2
          (fun i hi => by
            let ⟨ty, hTy⟩ := getElem?_some_of_lt ctx.compTys i hi
            exact ⟨ty, hDeclComp i ty hTy⟩)
          hBoundMid
      rw [hPre1Len] at hRRange
      let ⟨slots₁', hSet1⟩ := setElem?_some_of_lt f₁.locals plan.enumLocal .enumDead
        (by rw [hPre.1]; exact ctx.hEnumLtBase)
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm (.baseStmt (.storageDead plan.enumLocal)) =
          .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := slots₁' }],
                  callerMem := cm } := by
        unfold evalEnumStmt; dsimp
        rw [hidNe0]; dsimp
        rw [ctx.hEnumDecl]; dsimp
        rw [hSet1]
      let ⟨h2LeNonScr, hNonScrLeComp, _⟩ :=
        scalarizedEnumComponentTys_bounds ctx.hEdAdm ctx.hComp
      have h0LtComp : 0 < ctx.compTys.length :=
        Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) h2LeNonScr) hNonScrLeComp
      have hMatchDead : SlotMatchesComp ctx.ed base ctx.compTys .enumDead slots₂' := by
        refine ⟨hLen2'.trans ((setElem?_length hSet2Mid).trans hMatch.1), ?_⟩
        have hD0 := hCompDead 0 h0LtComp
        rw [Nat.add_zero] at hD0
        exact hD0
      have hPre' : PrefixSlotsAgree base plan.enumLocal slots₁' slots₂' := by
        refine ⟨(setElem?_length hSet1).trans hPre.1,
                by rw [hLen2', setElem?_length hSet2Mid]; exact hPre.2.1, ?_⟩
        intro j hjLt hjNe
        rw [hPresOut j (Or.inl hjLt),
            setElem?_getElem?_ne hSet2Mid hjNe,
            setElem?_getElem?_ne hSet1 hjNe]
        exact hPre.2.2 j hjLt hjNe
      have hLoweredLen :
          (lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
            (.baseStmt (.storageDead plan.enumLocal))).length =
          ctx.compTys.length + 1 := by
        dsimp [lowerEnumStmt]
        rw [nat_beq_refl]
        dsimp [List.length]
        have hMkLen : ∀ (st k : Nat), (mkStorageDeadRange st k).length = k := by
          intro st k
          induction k generalizing st with
          | zero => rfl
          | succ k' ih => dsimp [mkStorageDeadRange, List.length]; exact congrArg Nat.succ (ih (st + 1))
        exact congrArg Nat.succ (hMkLen base ctx.compTys.length)
      have hIdxR : preStmts.length + 1 + ctx.compTys.length =
          f₂.stmtIdx + (lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
            (.baseStmt (.storageDead plan.enumLocal))).length := by
        rw [hLoweredLen, ← hF2Idx, Nat.add_assoc, Nat.add_comm 1 ctx.compTys.length]
      rw [hIdxR] at hRRange
      exact simStepPlus hEv1 hStep1 hRRange
        (s3d_mkTargetPostStmtSimRel ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
          (hF2Idx.trans (congrArg List.length hPreEq)) hPre'
          (setElem?_getElem?_same hSet1) hMatchDead (fun _ _ _ h => by cases h))
  | assign dst rval =>
    unfold enumStmtLocalsInBounds at hStBnd
    unfold checkStmtForEnumLocal at hStChk
    let ⟨hDstLtB, hRvBnd⟩ := bool_and_true hStBnd
    let ⟨hDstNeB, hRvNoB⟩ := bool_and_true hStChk
    have hDstLt : dst.localId < base := nat_blt_lt hDstLtB
    have hDstNe : dst.localId ≠ plan.enumLocal := nat_ne_of_beq_false (bool_not_true hDstNeB)
    have hRvNo : rvalueMentionsLocal plan.enumLocal rval = false := bool_not_true hRvNoB
    refine s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
      hB2 hBB2 rfl hBbTgtStmts hSl1 hDirectInv ?_
    unfold evalEnumStmt; dsimp
    cases (!dst.projection.isEmpty) with
    | true => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
    | false =>
      dsimp
      rw [hDeclPre dst.localId hDstLt hDstNe]
      cases Trusted.MirSemantics.getElem? ctx.body.locals dst.localId with
      | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
      | some dd =>
        cases dd with
        | adtEnum _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
        | base dstTy =>
          dsimp
          let ⟨hRvErr, hRvOk⟩ := evalEnumBaseRvalue_agree (dstTy := dstTy)
            hDeclPre hPre hRvBnd hRvNo
          cases hEvRv1 : evalEnumBaseRvalue ctx.body.locals f₁.locals dstTy rval with
          | error k =>
            rw [hRvErr k hEvRv1]; dsimp
            exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
          | ok pr =>
            cases pr with
            | mk val s1Mid =>
              let ⟨s2Mid, hEvRv2, hLenMid, hPreMid, hOutMid⟩ := hRvOk val s1Mid hEvRv1
              rw [hEvRv2]; dsimp
              let ⟨hWrErr, hWrOk⟩ := writeEnumBasePlace_agree (dstTy := dstTy) (val := val)
                hPreMid hDstLt hDstNe
              cases hWr1 : writeEnumBasePlace s1Mid dst.localId dstTy val with
              | error k =>
                rw [hWrErr k hWr1]; dsimp
                exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
              | ok s1End =>
                let ⟨s2End, hWr2, hLenEnd, hPreEnd, hOutEnd⟩ := hWrOk s1End hWr1
                rw [hWr2]; dsimp
                refine ⟨(fun _ h => by cases h), (fun _ h => by cases h), ?_⟩
                intro s₁' h; injection h with hs
                have hSl1End : Trusted.MirSemantics.getElem? s1End plan.enumLocal = some sl :=
                  (s3d_writeEnumBasePlace_preserves_ne (fun hEq => hDstNe hEq.symm) hWr1).trans
                    ((s3d_evalEnumBaseRvalue_preserves_enumLocal hRvNo hEvRv1).trans hSl1)
                have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys sl s2End :=
                  slotMatchesComp_congr_ge_base hMatch (hLenEnd.trans hLenMid)
                    (fun k hk => (hOutEnd k (Or.inr hk)).trans (hOutMid k (Or.inr hk)))
                exact ⟨s1End, s2End, hs.symm, rfl, hPreEnd, hSl1End, hMatchEnd⟩

private theorem s3d_nonEnumLocal_stmt_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb bbTgt : EnumBlock}
    {preStmts postStmts : List EnumStmt} {stmt : EnumStmt} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx = some stmt)
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hPreEq : preStmts =
      listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx))
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hBbTgtStmts : bbTgt.statements =
      preStmts ++
        lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed stmt ++
        postStmts)
    (hStChk : checkStmtForEnumLocal ctx.body.locals plan.enumLocal ctx.ed stmt = true)
    (hStBnd : enumStmtLocalsInBounds ctx.body.locals.length stmt = true)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals)
    (hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm })
    (hNotEnum :
      match stmt with
      | .setDiscriminant l _ | .assignField l _ _ _ | .aggregateEnum l _ _ =>
        Nat.beq l plan.enumLocal = false
      | .readField _ src _ _ _ | .discriminantDirect _ src =>
        Nat.beq src plan.enumLocal = false
      | .baseStmt _ => False) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumStmt pSrc.enumDefs ctx.body f₁ cm stmt) := by
  let base := ctx.body.locals.length
  let ⟨_, _, hDeclPre, _⟩ := scalarizeCtx_target_decl_lookup ctx
  cases stmt with
  | baseStmt _ => exact False.elim hNotEnum
  | setDiscriminant l v =>
    have hlNe : l ≠ plan.enumLocal := nat_ne_of_beq_false hNotEnum
    have hlLt : l < base := nat_blt_lt hStBnd
    have hLow : lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed (.setDiscriminant l v) =
        [.setDiscriminant l v] := by
      dsimp [lowerEnumStmt]; rw [hNotEnum]; rfl
    refine s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
      hB2 hBB2 hLow hBbTgtStmts hSl1 hDirectInv ?_
    unfold evalEnumStmt; dsimp
    rw [hDeclPre l hlLt hlNe, hPre.2.2 l hlLt hlNe]
    cases Trusted.MirSemantics.getElem? ctx.body.locals l with
    | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
    | some dd =>
      cases dd with
      | base _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
      | adtEnum eI =>
        cases Trusted.MirSemantics.getElem? f₁.locals l with
        | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
        | some slL =>
          dsimp
          cases Trusted.MirSemantics.getElem? pSrc.enumDefs eI with
          | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
          | some edL =>
            dsimp
            cases writeAdtDiscriminant edL v slL with
            | error _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
            | ok slL' =>
              dsimp
              let ⟨s1', hSet1⟩ := setElem?_some_of_lt f₁.locals l slL' (by rw [hPre.1]; exact hlLt)
              let ⟨s2', hSet2⟩ := setElem?_some_of_lt f₂.locals l slL' (Nat.lt_of_lt_of_le hlLt hPre.2.1)
              rw [hSet1, hSet2]; dsimp
              refine ⟨(fun _ h => by cases h), (fun _ h => by cases h), ?_⟩
              intro s₁' h; injection h with hs
              refine ⟨s1', s2', hs.symm, rfl, ?_, ?_, ?_⟩
              · refine ⟨(setElem?_length hSet1).trans hPre.1,
                        by rw [setElem?_length hSet2]; exact hPre.2.1, ?_⟩
                intro j hjLt hjNe
                cases hEqJ : Nat.beq j l with
                | true =>
                  have hjEq : j = l := nat_beq_eq hEqJ; subst hjEq
                  rw [setElem?_getElem?_same hSet2, setElem?_getElem?_same hSet1]
                | false =>
                  have hjNeL : j ≠ l := nat_ne_of_beq_false hEqJ
                  rw [setElem?_getElem?_ne hSet2 hjNeL, setElem?_getElem?_ne hSet1 hjNeL]
                  exact hPre.2.2 j hjLt hjNe
              · rw [setElem?_getElem?_ne hSet1 (fun h => hlNe h.symm)]; exact hSl1
              · exact slotMatchesComp_congr_ge_base hMatch (setElem?_length hSet2)
                  (fun k hk => setElem?_getElem?_ne hSet2
                    (fun h => by subst h; exact Nat.not_lt_of_ge hk hlLt))
  | assignField l v fl rval =>
    dsimp at hNotEnum
    have hlNe : l ≠ plan.enumLocal := nat_ne_of_beq_false hNotEnum
    let ⟨hlLtB, hRvBnd⟩ := bool_and_true hStBnd
    have hlLt : l < base := nat_blt_lt hlLtB
    unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
    rw [hNotEnum] at hStChk; dsimp at hStChk
    have hRvNo : rvalueMentionsLocal plan.enumLocal rval = false := bool_not_true hStChk
    have hLow : lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed (.assignField l v fl rval) =
        [.assignField l v fl rval] := by
      dsimp [lowerEnumStmt]; rw [hNotEnum]; rfl
    refine s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
      hB2 hBB2 hLow hBbTgtStmts hSl1 hDirectInv ?_
    unfold evalEnumStmt; dsimp
    cases rvalueMentionsLocal l rval with
    | true => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
    | false =>
      dsimp
      rw [hDeclPre l hlLt hlNe]
      cases Trusted.MirSemantics.getElem? ctx.body.locals l with
      | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
      | some dd =>
        cases dd with
        | base _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
        | adtEnum eI =>
          dsimp
          cases Trusted.MirSemantics.getElem? pSrc.enumDefs eI with
          | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
          | some edL =>
            dsimp
            cases Trusted.MirSemantics.getElem? edL.variants v with
            | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
            | some vdL =>
              dsimp
              cases Trusted.MirSemantics.getElem? vdL.fields fl with
              | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
              | some fTy =>
                dsimp
                let ⟨hRvErr, hRvOk⟩ := evalEnumBaseRvalue_agree (dstTy := fTy)
                  hDeclPre hPre hRvBnd hRvNo
                cases hEvRv1 : evalEnumBaseRvalue ctx.body.locals f₁.locals fTy rval with
                | error k =>
                  rw [hRvErr k hEvRv1]
                  exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                | ok pr =>
                  cases pr with
                  | mk val s1Mid =>
                    let ⟨s2Mid, hEvRv2, hLenMid, hPreMid, hOutMid⟩ := hRvOk val s1Mid hEvRv1
                    rw [hEvRv2]; dsimp
                    rw [hPreMid.2.2 l hlLt hlNe]
                    cases Trusted.MirSemantics.getElem? s1Mid l with
                    | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                    | some slL =>
                      dsimp
                      cases writeAdtField edL v fl fTy val slL with
                      | error _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                      | ok slL' =>
                        dsimp
                        let ⟨s1End, hSet1⟩ := setElem?_some_of_lt s1Mid l slL'
                          (by rw [hPreMid.1]; exact hlLt)
                        let ⟨s2End, hSet2⟩ := setElem?_some_of_lt s2Mid l slL'
                          (Nat.lt_of_lt_of_le hlLt hPreMid.2.1)
                        rw [hSet1, hSet2]; dsimp
                        refine ⟨(fun _ h => by cases h), (fun _ h => by cases h), ?_⟩
                        intro s₁' h; injection h with hs
                        refine ⟨s1End, s2End, hs.symm, rfl, ?_, ?_, ?_⟩
                        · refine ⟨(setElem?_length hSet1).trans hPreMid.1,
                                  by rw [setElem?_length hSet2]; exact hPreMid.2.1, ?_⟩
                          intro j hjLt hjNe
                          cases hEqJ : Nat.beq j l with
                          | true =>
                            have hjEq : j = l := nat_beq_eq hEqJ; subst hjEq
                            rw [setElem?_getElem?_same hSet2, setElem?_getElem?_same hSet1]
                          | false =>
                            have hjNeL : j ≠ l := nat_ne_of_beq_false hEqJ
                            rw [setElem?_getElem?_ne hSet2 hjNeL, setElem?_getElem?_ne hSet1 hjNeL]
                            exact hPreMid.2.2 j hjLt hjNe
                        · rw [setElem?_getElem?_ne hSet1 (fun h => hlNe h.symm)]
                          exact (s3d_evalEnumBaseRvalue_preserves_enumLocal hRvNo hEvRv1).trans hSl1
                        · exact slotMatchesComp_congr_ge_base hMatch
                            ((setElem?_length hSet2).trans hLenMid)
                            (fun k hk =>
                              (setElem?_getElem?_ne hSet2
                                (fun h => by subst h; exact Nat.not_lt_of_ge hk hlLt)).trans
                                (hOutMid k (Or.inr hk)))
  | readField dst src v fl isMove =>
    dsimp at hNotEnum
    have hSrcNe : src ≠ plan.enumLocal := nat_ne_of_beq_false hNotEnum
    let ⟨hDstLtB, hSrcLtB⟩ := bool_and_true hStBnd
    have hDstLt : dst < base := nat_blt_lt hDstLtB
    have hSrcLt : src < base := nat_blt_lt hSrcLtB
    unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
    rw [hNotEnum] at hStChk; dsimp at hStChk
    have hDstNe : dst ≠ plan.enumLocal := nat_ne_of_beq_false (bool_not_true hStChk)
    have hLow : lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
        (.readField dst src v fl isMove) = [.readField dst src v fl isMove] := by
      dsimp [lowerEnumStmt]; rw [hNotEnum]; rfl
    refine s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
      hB2 hBB2 hLow hBbTgtStmts hSl1 hDirectInv ?_
    unfold evalEnumStmt; dsimp
    cases Nat.beq dst src with
    | true => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
    | false =>
      dsimp
      rw [hDeclPre dst hDstLt hDstNe, hDeclPre src hSrcLt hSrcNe, hPre.2.2 src hSrcLt hSrcNe]
      cases Trusted.MirSemantics.getElem? ctx.body.locals dst with
      | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
      | some dd =>
        cases dd with
        | adtEnum _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
        | base dstTy =>
          cases Trusted.MirSemantics.getElem? ctx.body.locals src with
          | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
          | some sd =>
            cases sd with
            | base _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
            | adtEnum eI =>
              cases Trusted.MirSemantics.getElem? f₁.locals src with
              | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
              | some slS =>
                dsimp
                cases Trusted.MirSemantics.getElem? pSrc.enumDefs eI with
                | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                | some edS =>
                  dsimp
                  cases Trusted.MirSemantics.getElem? edS.variants v with
                  | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                  | some vdS =>
                    dsimp
                    cases Trusted.MirSemantics.getElem? vdS.fields fl with
                    | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                    | some fTy =>
                      dsimp
                      cases (!MirTy.beq fTy dstTy) with
                      | true => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                      | false =>
                        dsimp
                        cases readAdtField edS v fl fTy isMove slS with
                        | error _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                        | ok pr =>
                          cases pr with
                          | mk val slS' =>
                            dsimp
                            let ⟨s1Mid, hSet1⟩ := setElem?_some_of_lt f₁.locals src slS'
                              (by rw [hPre.1]; exact hSrcLt)
                            let ⟨s2Mid, hSet2⟩ := setElem?_some_of_lt f₂.locals src slS'
                              (Nat.lt_of_lt_of_le hSrcLt hPre.2.1)
                            rw [hSet1, hSet2]; dsimp
                            have hPreMid : PrefixSlotsAgree base plan.enumLocal s1Mid s2Mid := by
                              refine ⟨(setElem?_length hSet1).trans hPre.1,
                                      by rw [setElem?_length hSet2]; exact hPre.2.1, ?_⟩
                              intro j hjLt hjNe
                              cases hEqJ : Nat.beq j src with
                              | true =>
                                have hjEq : j = src := nat_beq_eq hEqJ; subst hjEq
                                rw [setElem?_getElem?_same hSet2, setElem?_getElem?_same hSet1]
                              | false =>
                                have hjNeS : j ≠ src := nat_ne_of_beq_false hEqJ
                                rw [setElem?_getElem?_ne hSet2 hjNeS, setElem?_getElem?_ne hSet1 hjNeS]
                                exact hPre.2.2 j hjLt hjNe
                            let ⟨hWrErr, hWrOk⟩ := writeEnumBasePlace_agree (dstTy := dstTy) (val := val)
                              hPreMid hDstLt hDstNe
                            cases hWr1 : writeEnumBasePlace s1Mid dst dstTy val with
                            | error k =>
                              rw [hWrErr k hWr1]
                              exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                            | ok s1End =>
                              let ⟨s2End, hWr2, hLenEnd, hPreEnd, hOutEnd⟩ := hWrOk s1End hWr1
                              rw [hWr2]; dsimp
                              refine ⟨(fun _ h => by cases h), (fun _ h => by cases h), ?_⟩
                              intro s₁' h; injection h with hs
                              have hSl1End : Trusted.MirSemantics.getElem? s1End plan.enumLocal = some sl :=
                                (s3d_writeEnumBasePlace_preserves_ne (fun hEq => hDstNe hEq.symm) hWr1).trans
                                  ((setElem?_getElem?_ne hSet1 (fun hEq => hSrcNe hEq.symm)).trans hSl1)
                              have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys sl s2End :=
                                slotMatchesComp_congr_ge_base hMatch
                                  (hLenEnd.trans (setElem?_length hSet2))
                                  (fun k hk =>
                                    (hOutEnd k (Or.inr hk)).trans
                                      (setElem?_getElem?_ne hSet2
                                        (fun hEq => by subst hEq; exact Nat.not_lt_of_ge hk hSrcLt)))
                              exact ⟨s1End, s2End, hs.symm, rfl, hPreEnd, hSl1End, hMatchEnd⟩
  | aggregateEnum dst v ops =>
    dsimp at hNotEnum
    have hDstNe : dst ≠ plan.enumLocal := nat_ne_of_beq_false hNotEnum
    let ⟨hDstLtB, hOpsBnd⟩ := bool_and_true hStBnd
    have hDstLt : dst < base := nat_blt_lt hDstLtB
    unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
    rw [hNotEnum] at hStChk; dsimp at hStChk
    have hOpsNo : ops.any (stmtMentionsLocalOperand plan.enumLocal) = false :=
      bool_not_true hStChk
    have hLow : lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
        (.aggregateEnum dst v ops) = [.aggregateEnum dst v ops] := by
      dsimp [lowerEnumStmt]; rw [hNotEnum]; rfl
    refine s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
      hB2 hBB2 hLow hBbTgtStmts hSl1 hDirectInv ?_
    unfold evalEnumStmt; dsimp
    cases ops.any (stmtMentionsLocalOperand dst) with
    | true => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
    | false =>
      dsimp
      rw [hDeclPre dst hDstLt hDstNe]
      cases Trusted.MirSemantics.getElem? ctx.body.locals dst with
      | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
      | some dd =>
        cases dd with
        | base _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
        | adtEnum eI =>
          dsimp
          cases Trusted.MirSemantics.getElem? pSrc.enumDefs eI with
          | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
          | some edD =>
            dsimp
            cases (!adtEnumDefAdmitted edD) with
            | true => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
            | false =>
              dsimp
              cases Trusted.MirSemantics.getElem? edD.variants v with
              | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
              | some vdD =>
                dsimp
                let ⟨hOpsErr, hOpsOk⟩ := s3d_evalAggregateEnumOperands_agree hDeclPre
                  ops vdD.fields f₁.locals f₂.locals hPre hOpsBnd hOpsNo
                cases hEvOps1 : evalAggregateEnumOperands ctx.body.locals f₁.locals ops vdD.fields with
                | error k =>
                  rw [hOpsErr k hEvOps1]
                  exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                | ok pr =>
                  cases pr with
                  | mk vals s1Mid =>
                    let ⟨s2Mid, hEvOps2, hLenMid, hPreMid, hOutMid⟩ := hOpsOk vals s1Mid hEvOps1
                    rw [hEvOps2]; dsimp
                    rw [hPreMid.2.2 dst hDstLt hDstNe]
                    cases Trusted.MirSemantics.getElem? s1Mid dst with
                    | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                    | some slD =>
                      cases slD with
                      | enumDead => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                      | baseSlot _ | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
                        dsimp
                        cases variantIsUninhabited vdD with
                        | true => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                        | false =>
                          dsimp
                          cases writeAdtFieldsSeq edD v 0 vdD.fields vals _ with
                          | error _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                          | ok slD1 =>
                            dsimp
                            cases writeAdtDiscriminant edD v slD1 with
                            | error _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                            | ok slD2 =>
                              dsimp
                              let ⟨s1End, hSet1⟩ := setElem?_some_of_lt s1Mid dst slD2
                                (by rw [hPreMid.1]; exact hDstLt)
                              let ⟨s2End, hSet2⟩ := setElem?_some_of_lt s2Mid dst slD2
                                (Nat.lt_of_lt_of_le hDstLt hPreMid.2.1)
                              rw [hSet1, hSet2]; dsimp
                              refine ⟨(fun _ h => by cases h), (fun _ h => by cases h), ?_⟩
                              intro s₁' h; injection h with hs
                              refine ⟨s1End, s2End, hs.symm, rfl, ?_, ?_, ?_⟩
                              · refine ⟨(setElem?_length hSet1).trans hPreMid.1,
                                        by rw [setElem?_length hSet2]; exact hPreMid.2.1, ?_⟩
                                intro j hjLt hjNe
                                cases hEqJ : Nat.beq j dst with
                                | true =>
                                  have hjEq : j = dst := nat_beq_eq hEqJ; subst hjEq
                                  rw [setElem?_getElem?_same hSet2, setElem?_getElem?_same hSet1]
                                | false =>
                                  have hjNeD : j ≠ dst := nat_ne_of_beq_false hEqJ
                                  rw [setElem?_getElem?_ne hSet2 hjNeD, setElem?_getElem?_ne hSet1 hjNeD]
                                  exact hPreMid.2.2 j hjLt hjNe
                              · rw [setElem?_getElem?_ne hSet1 (fun h => hDstNe h.symm)]
                                exact (s3d_evalAggregateEnumOperands_preserves_enumLocal
                                  ops vdD.fields f₁.locals hOpsNo hEvOps1).trans hSl1
                              · exact slotMatchesComp_congr_ge_base hMatch
                                  ((setElem?_length hSet2).trans hLenMid)
                                  (fun k hk =>
                                    (setElem?_getElem?_ne hSet2
                                      (fun h => by subst h; exact Nat.not_lt_of_ge hk hDstLt)).trans
                                      (hOutMid k (Or.inr hk)))
  | discriminantDirect dst src =>
    dsimp at hNotEnum
    have hSrcNe : src ≠ plan.enumLocal := nat_ne_of_beq_false hNotEnum
    let ⟨hDstLtB, hSrcLtB⟩ := bool_and_true hStBnd
    have hDstLt : dst < base := nat_blt_lt hDstLtB
    have hSrcLt : src < base := nat_blt_lt hSrcLtB
    unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
    rw [hNotEnum] at hStChk; dsimp at hStChk
    have hDstNe : dst ≠ plan.enumLocal := nat_ne_of_beq_false (bool_not_true hStChk)
    have hLow : lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
        (.discriminantDirect dst src) = [.discriminantDirect dst src] := by
      dsimp [lowerEnumStmt]; rw [hNotEnum]; rfl
    refine s3d_oneStep_unchanged_stmt ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx hPreEq
      hB2 hBB2 hLow hBbTgtStmts hSl1 hDirectInv ?_
    unfold evalEnumStmt; dsimp
    rw [hDeclPre dst hDstLt hDstNe, hDeclPre src hSrcLt hSrcNe, hPre.2.2 src hSrcLt hSrcNe]
    cases Trusted.MirSemantics.getElem? ctx.body.locals dst with
    | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
    | some dd =>
      cases dd with
      | adtEnum _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
      | base dstTy =>
        cases Trusted.MirSemantics.getElem? ctx.body.locals src with
        | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
        | some sd =>
          cases sd with
          | base _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
          | adtEnum eI =>
            cases Trusted.MirSemantics.getElem? f₁.locals src with
            | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
            | some slS =>
              dsimp
              cases Trusted.MirSemantics.getElem? pSrc.enumDefs eI with
              | none => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
              | some edS =>
                dsimp
                cases (!MirTy.beq dstTy (.int edS.discrWidth edS.discrSigned)) with
                | true => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                | false =>
                  dsimp
                  cases edS.layout with
                  | niche _ _ _ _ _ _ _ _ =>
                    exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                  | empty | single | direct _ _ =>
                    dsimp
                    cases readAdtDiscriminant edS slS with
                    | error _ => exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                    | ok dv =>
                      dsimp
                      let ⟨hWrErr, hWrOk⟩ := writeEnumBasePlace_agree (dstTy := dstTy) (val := dv)
                        hPre hDstLt hDstNe
                      cases hWr1 : writeEnumBasePlace f₁.locals dst dstTy dv with
                      | error k =>
                        rw [hWrErr k hWr1]
                        exact ⟨fun _ h => h, (fun _ h => by cases h), fun _ h => by cases h⟩
                      | ok s1End =>
                        let ⟨s2End, hWr2, hLenEnd, hPreEnd, hOutEnd⟩ := hWrOk s1End hWr1
                        rw [hWr2]; dsimp
                        refine ⟨(fun _ h => by cases h), (fun _ h => by cases h), ?_⟩
                        intro s₁' h; injection h with hs
                        have hSl1End : Trusted.MirSemantics.getElem? s1End plan.enumLocal = some sl :=
                          (s3d_writeEnumBasePlace_preserves_ne (fun hEq => hDstNe hEq.symm) hWr1).trans hSl1
                        have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys sl s2End :=
                          slotMatchesComp_congr_ge_base hMatch hLenEnd
                            (fun k hk => hOutEnd k (Or.inr hk))
                        exact ⟨s1End, s2End, hs.symm, rfl, hPreEnd, hSl1End, hMatchEnd⟩

private theorem s3d_discriminantDirect_enumLocal_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb bbTgt : EnumBlock}
    {preStmts postStmts : List EnumStmt} {dst : LocalId} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx =
      some (.discriminantDirect dst plan.enumLocal))
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hPreEq : preStmts =
      listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx))
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hBbTgtStmts : bbTgt.statements =
      preStmts ++
        lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed
          (.discriminantDirect dst plan.enumLocal) ++
        postStmts)
    (hStChk : checkStmtForEnumLocal ctx.body.locals plan.enumLocal ctx.ed
      (.discriminantDirect dst plan.enumLocal) = true)
    (hStBnd : enumStmtLocalsInBounds ctx.body.locals.length
      (.discriminantDirect dst plan.enumLocal) = true)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals)
    (hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm }) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumStmt pSrc.enumDefs ctx.body f₁ cm (.discriminantDirect dst plan.enumLocal)) := by
  let base := ctx.body.locals.length
  let bodyTgt := scalarizeTargetBody ctx
  let ⟨_, _, hDeclPre, _⟩ := scalarizeCtx_target_decl_lookup ctx
  let ⟨hDeclLive, hDeclFault⟩ := s3d_compDecls_common ctx
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  let ⟨hDstLtB, _⟩ := bool_and_true hStBnd
  have hDstLt : dst < base := nat_blt_lt hDstLtB
  unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
  rw [nat_beq_refl] at hStChk; dsimp at hStChk
  let ⟨hChk12, hDstDeclChk⟩ := bool_and_true hStChk
  let ⟨hDstNeB, hNotNiche⟩ := bool_and_true hChk12
  have hDstNe : dst ≠ plan.enumLocal := nat_ne_of_beq_false (bool_not_true hDstNeB)
  have hDstDecl : ∃ dstTy,
      Trusted.MirSemantics.getElem? ctx.body.locals dst = some (.base dstTy) ∧
      MirTy.beq dstTy (.int ctx.ed.discrWidth ctx.ed.discrSigned) = true := by
    cases hd : Trusted.MirSemantics.getElem? ctx.body.locals dst with
    | none => rw [hd] at hDstDeclChk; cases hDstDeclChk
    | some dd =>
      rw [hd] at hDstDeclChk
      cases dd with
      | adtEnum _ => cases hDstDeclChk
      | base dstTy => exact ⟨dstTy, rfl, hDstDeclChk⟩
  let ⟨dstTy, hDstSrc, hDstTyBeq⟩ := hDstDecl
  have hDstTgt : Trusted.MirSemantics.getElem? bodyTgt.locals dst = some (.base dstTy) :=
    (hDeclPre dst hDstLt hDstNe).trans hDstSrc
  have hInvSl : ∀ v vfs vd,
      sl = .liveDirect (some v) vfs →
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
      variantIsUninhabited vd = false :=
    fun v vfs vd hsl hv => hDirectInv f₁ v vfs vd rfl hDef1 (by rw [hsl] at hSl1; exact hSl1) hv
  dsimp [lowerEnumStmt] at hBbTgtStmts
  rw [nat_beq_refl] at hBbTgtStmts; dsimp at hBbTgtStmts
  cases hLay : ctx.ed.layout with
  | niche _ _ _ _ _ _ _ _ =>
    rw [hLay] at hNotNiche; cases hNotNiche
  | empty =>
    rw [hLay] at hBbTgtStmts; dsimp at hBbTgtStmts
    have hSt1 : bbTgt.statements = preStmts ++
        (mkLivenessCheckStmt base) :: (mkImmediateUbStmt (base + 1) :: postStmts) := by
      rw [hBbTgtStmts, List.append_assoc]; rfl
    have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
        (.discriminantDirect dst plan.enumLocal) = .fault .undefined := by
      unfold evalEnumStmt readAdtDiscriminant; dsimp
      rw [hDstSrc, ctx.hEnumDecl, hSl1]; dsimp
      rw [ctx.hEdGet]; dsimp
      rw [hDstTyBeq, hLay, ctx.hEdAdm]; dsimp
      cases sl with
      | enumDead | liveEmpty => rfl
      | baseSlot _ => exact False.elim hMatch.2
      | liveSingle fs => rw [hMatch.2.1] at hLay; cases hLay
      | liveDirect _ _ => let ⟨_, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
      | liveNiche _ _ =>
        let ⟨_, _, _, _, _, _, _, _, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
    cases sl with
    | baseSlot _ => exact False.elim hMatch.2
    | liveSingle _ => rw [hMatch.2.1] at hLay; cases hLay
    | liveDirect _ _ => let ⟨_, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
    | liveNiche _ _ =>
      let ⟨_, _, _, _, _, _, _, _, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
    | enumDead =>
      have hEv2 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } = .fault .undefined :=
        (stepAtStmt hB2 hBB2 hSt1 hF2Idx).trans
          ((hStepEqDefs f₂ cm _).trans (eval_mkLivenessCheckStmt_dead hDeclLive hMatch.2))
      exact simFault0 hEv1 hEv2
    | liveEmpty =>
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
            eval_mkLivenessCheckStmt_live hDeclLive hMatch.2.2, hF2Idx]
      have hSt2 : bbTgt.statements =
          (preStmts ++ [mkLivenessCheckStmt base]) ++ mkImmediateUbStmt (base + 1) :: postStmts := by
        rw [hSt1]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
      have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
        list_append_length preStmts [_]
      have hStep2 : evalStepEnum pOut 0
          { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } =
          .fault .undefined :=
        (stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 }) hB2 hBB2 hSt2 hPre1Len.symm).trans
          ((hStepEqDefs _ cm _).trans (eval_mkImmediateUbStmt hDeclFault))
      exact simFaultR hEv1 (c_reachesEnum_head_det hStep1 (ReachesEnum.refl _)) hStep2
  | single =>
    let ⟨vd₀, hv0Get, _, _, _⟩ := s3d_compDecls_single ctx hLay
    rw [hLay] at hBbTgtStmts; dsimp at hBbTgtStmts
    rw [hv0Get] at hBbTgtStmts; dsimp at hBbTgtStmts
    cases sl with
    | baseSlot _ => exact False.elim hMatch.2
    | liveEmpty => rw [hMatch.2.1] at hLay; cases hLay
    | liveDirect _ _ => let ⟨_, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
    | liveNiche _ _ =>
      let ⟨_, _, _, _, _, _, _, _, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
    | enumDead =>
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.discriminantDirect dst plan.enumLocal) = .fault .undefined := by
        unfold evalEnumStmt readAdtDiscriminant; dsimp
        rw [hDstSrc, ctx.hEnumDecl, hSl1]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [hDstTyBeq, hLay, ctx.hEdAdm]
        rfl
      cases hU : variantIsUninhabited vd₀ <;> (
        rw [hU] at hBbTgtStmts; dsimp at hBbTgtStmts
        have hStEx : ∃ tl, bbTgt.statements = preStmts ++ (mkLivenessCheckStmt base) :: tl :=
          ⟨_, by rw [hBbTgtStmts, List.append_assoc]; rfl⟩
        let ⟨_, hSt1⟩ := hStEx
        have hEv2 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } = .fault .undefined :=
          (stepAtStmt hB2 hBB2 hSt1 hF2Idx).trans
