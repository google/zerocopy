            | inl hlt => exact Nat.lt_irrefl _ (Nat.lt_of_le_of_lt (Nat.le_add_right _ _) hlt)
            | inr hge =>
              exact Nat.not_lt_of_ge hge (Nat.add_lt_add_left hELt extraBase)
          have hjNeS0 : j ≠ sBase + idx := by
            intro heq; subst heq
            cases hjS with
            | inl hlt => exact Nat.lt_irrefl _ hlt
            | inr hge =>
              exact Nat.not_lt_of_ge hge (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _))
          rw [hPresOut j hjN hjD hjG hjE hjSTail,
              setElem?_getElem?_ne hSetM2 hjNeE,
              setElem?_getElem?_ne hSetM1 hjNeS0]

/-! ### 6. `buildNicheDispatchArms` Lookup & `evalSwitchBranches` Dispatch Spec -/

private theorem evalSwitchBranches_append_miss {w : IntWidth} {d : BitVec 128}
    {o : BasicBlockId} :
    ∀ (brs₁ brs₂ : List (BitVec 128 × BasicBlockId)),
      evalSwitchBranches w d o brs₁ = .ok o →
      (∀ p, ∀ i, Trusted.MirSemantics.getElem? brs₁ i = some p → p.2 ≠ o) →
      evalSwitchBranches w d o (brs₁ ++ brs₂) = evalSwitchBranches w d o brs₂
  | [], _, _, _ => rfl
  | (c, tgt) :: rest, brs₂, hEv1, hNoO => by
    rw [evalSwitchBranches_cons] at hEv1
    dsimp [List.append]
    rw [evalSwitchBranches_cons]
    cases hTr : (truncateBits w c != c) with
    | true => rw [hTr] at hEv1; cases hEv1
    | false =>
      rw [hTr] at hEv1; dsimp at hEv1; dsimp
      cases hEq : (truncateBits w d == truncateBits w c) with
      | true =>
        rw [hEq] at hEv1; dsimp at hEv1
        injection hEv1 with htEq
        exact False.elim (hNoO (c, tgt) 0 rfl htEq)
      | false =>
        rw [hEq] at hEv1; dsimp at hEv1; dsimp
        exact evalSwitchBranches_append_miss rest brs₂ hEv1
          (fun p i hi => hNoO p (i + 1) hi)

private theorem evalSwitchBranches_append_hit {w : IntWidth} {d : BitVec 128}
    {o : BasicBlockId} {t : BasicBlockId} (htNeO : t ≠ o) :
    ∀ (brs₁ brs₂ : List (BitVec 128 × BasicBlockId)),
      evalSwitchBranches w d o brs₁ = .ok t →
      evalSwitchBranches w d o (brs₁ ++ brs₂) = .ok t
  | [], _, hEv1 => by
    rw [evalSwitchBranches_nil] at hEv1
    injection hEv1 with hEq; exact False.elim (htNeO hEq.symm)
  | (c, tgt) :: rest, brs₂, hEv1 => by
    rw [evalSwitchBranches_cons] at hEv1
    dsimp [List.append]
    rw [evalSwitchBranches_cons]
    cases hTr : (truncateBits w c != c) with
    | true => rw [hTr] at hEv1; cases hEv1
    | false =>
      rw [hTr] at hEv1; dsimp at hEv1; dsimp
      cases hEq : (truncateBits w d == truncateBits w c) with
      | true =>
        rw [hEq] at hEv1; dsimp at hEv1; dsimp
        exact hEv1
      | false =>
        rw [hEq] at hEv1; dsimp at hEv1; dsimp
        exact evalSwitchBranches_append_hit htNeO rest brs₂ hEv1

private theorem buildNicheDispatchArms_lengths (ed : AdtEnumDef)
    (discrDst : LocalId) (targets : SwitchTargets) (nStart auxBase : Nat)
    (cleanup : Bool) :
    ∀ (k : Nat),
      (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k).1.length = k ∧
      (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k).2.length = k
  | 0 => ⟨rfl, rfl⟩
  | i + 1 => by
    let ⟨h1, h2⟩ := buildNicheDispatchArms_lengths ed discrDst targets nStart auxBase cleanup i
    dsimp [buildNicheDispatchArms]
    rw [list_append_length, list_append_length, h1, h2]
    exact ⟨rfl, rfl⟩

private theorem buildNicheDispatchArms_targets_lt (ed : AdtEnumDef)
    (discrDst : LocalId) (targets : SwitchTargets) (nStart auxBase : Nat)
    (cleanup : Bool) :
    ∀ (k : Nat) (p : BitVec 128 × BasicBlockId) (j : Nat),
      Trusted.MirSemantics.getElem?
        (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k).1 j = some p →
      p.2 < auxBase + k
  | 0, _, _, hg => by cases hg
  | i + 1, p, j, hg => by
    dsimp [buildNicheDispatchArms] at hg
    let prev := buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup i
    have hLen1 : prev.1.length = i :=
      (buildNicheDispatchArms_lengths ed discrDst targets nStart auxBase cleanup i).1
    cases nat_le_or_gt prev.1.length j with
    | inr hLt =>
      rw [getElem?_append_left hLt] at hg
      exact Nat.lt_trans
        (buildNicheDispatchArms_targets_lt ed discrDst targets nStart auxBase cleanup i p j hg)
        (Nat.add_lt_add_left (Nat.lt_succ_self i) auxBase)
    | inl hGe =>
      have hSubEq : j = prev.1.length + (j - prev.1.length) :=
        (Nat.add_sub_of_le hGe).symm
      rw [hSubEq, getElem?_append_right prev.1 _ _] at hg
      cases hRem : j - prev.1.length with
      | zero =>
        rw [hRem] at hg
        injection hg with hpEq; subst hpEq
        exact Nat.add_lt_add_left (Nat.lt_succ_self i) auxBase
      | succ kRem =>
        rw [hRem] at hg
        cases hg

private theorem buildNicheDispatchArms_block_lookup (ed : AdtEnumDef)
    (discrDst : LocalId) (targets : SwitchTargets) (nStart auxBase : Nat)
    (cleanup : Bool) :
    ∀ (k i : Nat),
      i < k →
      Trusted.MirSemantics.getElem?
        (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k).2 i =
      some (match Trusted.MirSemantics.getElem? ed.variants (nStart + i) with
            | none => { statements := [], terminator := .baseTerm .unreachable, cleanup }
            | some vd =>
              if variantIsUninhabited vd then
                { statements := [], terminator := .baseTerm .unreachable, cleanup }
              else
                let dBits := truncateBits ed.discrWidth (BitVec.ofNat 128 vd.discrVal)
                let dConst : Operand :=
                  .constant { ty := .int ed.discrWidth ed.discrSigned, lit := .scalar dBits }
                { statements := [
                    .baseStmt (.assign { localId := discrDst, projection := [] } (.use dConst))
                  ]
                  terminator := .baseTerm (.switchInt
                    (.copy { localId := discrDst, projection := [] }) targets)
                  cleanup })
  | 0, _, h => False.elim (Nat.not_lt_zero _ h)
  | k' + 1, i, hLt => by
    dsimp [buildNicheDispatchArms]
    let prev := buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k'
    have hLen2 : prev.2.length = k' :=
      (buildNicheDispatchArms_lengths ed discrDst targets nStart auxBase cleanup k').2
    cases Nat.eq_or_lt_of_le (Nat.le_of_lt_succ hLt) with
    | inl hEq =>
      subst hEq
      have hZ : prev.2.length = prev.2.length + 0 := (Nat.add_zero _).symm
      have hg := getElem?_append_right prev.2
        [(match Trusted.MirSemantics.getElem? ed.variants (nStart + prev.2.length) with
          | none => { statements := [], terminator := .baseTerm .unreachable, cleanup }
          | some vd =>
            if variantIsUninhabited vd then
              { statements := [], terminator := .baseTerm .unreachable, cleanup }
            else
              let dBits := truncateBits ed.discrWidth (BitVec.ofNat 128 vd.discrVal)
              let dConst : Operand :=
                .constant { ty := .int ed.discrWidth ed.discrSigned, lit := .scalar dBits }
              { statements := [
                  .baseStmt (.assign { localId := discrDst, projection := [] } (.use dConst))
                ]
                terminator := .baseTerm (.switchInt
                  (.copy { localId := discrDst, projection := [] }) targets)
                cleanup })] 0
      rw [Nat.add_zero] at hg
      rw [hLen2] at hg
      exact hg
    | inr hLtK' =>
      have hLtLen : i < prev.2.length := by rw [hLen2]; exact hLtK'
      rw [getElem?_append_left hLtLen]
      exact buildNicheDispatchArms_block_lookup ed discrDst targets nStart auxBase cleanup k' i hLtK'

private theorem buildNicheDispatchArms_evalSwitch (ed : AdtEnumDef)
    (discrDst : LocalId) (targets : SwitchTargets) (nStart auxBase : Nat)
    (cleanup : Bool) {tagW : IntWidth} {diffBits : BitVec 128}
    {untaggedBbId : BasicBlockId}
    (hDiffFit : truncateBits tagW diffBits = diffBits) :
    ∀ (k : Nat),
      k ≤ Nat.pow 2 tagW.bitWidth →
      auxBase + k ≤ untaggedBbId →
      (diffBits.toNat < k →
        evalSwitchBranches tagW diffBits untaggedBbId
          (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k).1 =
          .ok (auxBase + diffBits.toNat)) ∧
      (k ≤ diffBits.toNat →
        evalSwitchBranches tagW diffBits untaggedBbId
          (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup k).1 =
          .ok untaggedBbId)
  | 0, _, _ => ⟨fun h => False.elim (Nat.not_lt_zero _ h), fun _ => rfl⟩
  | i + 1, hkPow, hkLeU => by
    have hiPow : i ≤ Nat.pow 2 tagW.bitWidth :=
      Nat.le_trans (Nat.le_succ i) hkPow
    have hiLeU : auxBase + i ≤ untaggedBbId :=
      Nat.le_trans (Nat.add_le_add_left (Nat.le_succ i) auxBase) hkLeU
    let ⟨ihHit, ihMiss⟩ := buildNicheDispatchArms_evalSwitch ed discrDst targets
      nStart auxBase cleanup hDiffFit i hiPow hiLeU
    have hiLtPow : i < Nat.pow 2 tagW.bitWidth := hkPow
    have hiLt128 : i < Nat.pow 2 128 :=
      Nat.lt_of_lt_of_le hiLtPow (intWidth_pow2_le_pow2_128 tagW)
    have hIFit : truncateBits tagW (BitVec.ofNat 128 i) = BitVec.ofNat 128 i := by
      apply truncateBits_eq_of_toNat_lt
      rw [bitvec_ofNat_toNat, nat_mod_eq_of_lt hiLt128]
      exact hiLtPow
    have hIBne : (truncateBits tagW (BitVec.ofNat 128 i) != BitVec.ofNat 128 i) = false :=
      bitvec_bne_false_of_eq hIFit
    have hNoPrevO : ∀ p j,
        Trusted.MirSemantics.getElem?
          (buildNicheDispatchArms ed discrDst targets nStart auxBase cleanup i).1 j = some p →
        p.2 ≠ untaggedBbId := by
      intro p j hg heq
      have hlt := buildNicheDispatchArms_targets_lt ed discrDst targets nStart auxBase cleanup i p j hg
      have hltU := Nat.lt_of_lt_of_le hlt hiLeU
      rw [heq] at hltU
      exact Nat.lt_irrefl _ hltU
    dsimp [buildNicheDispatchArms]
    refine ⟨?_, ?_⟩
    · intro hLtSucc
      cases Nat.eq_or_lt_of_le (Nat.le_of_lt_succ hLtSucc) with
      | inr hLtI =>
        have hHitI := ihHit hLtI
        have hTgtNeU : auxBase + diffBits.toNat ≠ untaggedBbId := by
          intro heq
          have hltU := Nat.lt_of_lt_of_le (Nat.add_lt_add_left hLtI auxBase) hiLeU
          rw [heq] at hltU
          exact Nat.lt_irrefl _ hltU
        exact evalSwitchBranches_append_hit hTgtNeU _ _ hHitI
      | inl hEqI =>
        have hMissI := ihMiss (by rw [hEqI]; exact Nat.le_refl _)
        rw [evalSwitchBranches_append_miss _ _ hMissI hNoPrevO]
        rw [evalSwitchBranches_cons, hIBne]
        dsimp
        have hBvEq : diffBits = BitVec.ofNat 128 i := by
          apply bitvec_eq_of_toNat_eq
          rw [hEqI, bitvec_ofNat_toNat, nat_mod_eq_of_lt hiLt128]
        rw [hDiffFit, hIFit, hBvEq, bitvec_beq_refl, bitvec_ofNat_toNat,
            nat_mod_eq_of_lt hiLt128]
        rfl
    · intro hGeSucc
      have hMissI := ihMiss (Nat.le_trans (Nat.le_succ i) hGeSucc)
      rw [evalSwitchBranches_append_miss _ _ hMissI hNoPrevO]
      rw [evalSwitchBranches_cons, hIBne]
      dsimp
      rw [hDiffFit, hIFit]
      have hBeqFalse : (diffBits == BitVec.ofNat 128 i) = false := by
        cases hb : (diffBits == BitVec.ofNat 128 i) with
        | false => rfl
        | true =>
          have hEqBv := eq_of_beq hb
          have hEqNat : diffBits.toNat = i := by
            have h1 := congrArg BitVec.toNat hEqBv
            rw [bitvec_ofNat_toNat, nat_mod_eq_of_lt hiLt128] at h1
            exact h1
          rw [hEqNat] at hGeSucc
          exact False.elim (Nat.not_lt_of_ge hGeSucc (Nat.lt_succ_self i))
      rw [hBeqFalse]
      rfl

