/-! ## Slice 3d-2a: Target `enumLocal` Simulation for `setDiscriminant` and `assignField` -/

/-! ### 1. Arithmetic Inequality, Non-Scratch Congruence, & Niche `writeAdtDiscriminant` Helpers -/

private theorem s3d2_ne_of_lt {a b : Nat} (h : a < b) : a ≠ b := by
  intro heq
  exact Nat.not_le_of_gt h (by rw [heq]; exact Nat.le_refl b)

private theorem s3d2_ne_of_gt {a b : Nat} (h : b < a) : a ≠ b :=
  fun heq => s3d2_ne_of_lt h heq.symm

private theorem s3d2_slotMatchesComp_congr_nonScratch {ed : AdtEnumDef} {base : Nat}
    {compTys : List MirTy} {sl : EnumSlot} {slots₂ slots₂' : List EnumSlot}
    (hM : SlotMatchesComp ed base compTys sl slots₂)
    (hLen : slots₂'.length = slots₂.length)
    (hEq : ∀ k, base ≤ k → k < base + nonScratchCompCount ed →
      Trusted.MirSemantics.getElem? slots₂' k = Trusted.MirSemantics.getElem? slots₂ k) :
    SlotMatchesComp ed base compTys sl slots₂' := by
  refine ⟨hLen.trans hM.1, ?_⟩
  have hPosNonScr : 0 < nonScratchCompCount ed := by
    unfold nonScratchCompCount
    cases ed.layout with
    | empty => dsimp; exact Nat.zero_lt_succ 1
    | single =>
      dsimp
      cases Trusted.MirSemantics.getElem? ed.variants 0 with
      | none => exact Nat.zero_lt_succ 1
      | some vd₀ => exact Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) (Nat.le_add_right 2 vd₀.fields.length)
    | direct _ _ =>
      dsimp
      exact Nat.lt_of_lt_of_le (Nat.zero_lt_succ 2) (Nat.le_add_right 3 _)
    | niche _ u _ _ _ _ _ _ =>
      dsimp
      cases Trusted.MirSemantics.getElem? ed.variants u with
      | none => exact Nat.zero_lt_succ 4
      | some _ => exact Nat.lt_of_lt_of_le (Nat.zero_lt_succ 4) (Nat.le_add_right 5 _)
  have hAt0 : Trusted.MirSemantics.getElem? slots₂' base =
      Trusted.MirSemantics.getElem? slots₂ base :=
    hEq base (Nat.le_refl base) (Nat.lt_add_of_pos_right hPosNonScr)
  cases sl with
  | baseSlot _ => exact hM.2
  | enumDead => rw [hAt0]; exact hM.2
  | liveEmpty => exact ⟨hM.2.1, by rw [hAt0]; exact hM.2.2⟩
  | liveSingle fs =>
    let ⟨hL, vd₀, hv0, hfsL, hB0, hFs⟩ := hM.2
    refine ⟨hL, vd₀, hv0, hfsL, by rw [hAt0]; exact hB0, ?_⟩
    intro f ov hf
    have hfLt : f < vd₀.fields.length := by rw [← hfsL]; exact getElem?_some_lt hf
    have hNonScr : nonScratchCompCount ed = 2 + vd₀.fields.length := by
      unfold nonScratchCompCount; rw [hL]; dsimp; rw [hv0]
    have hKGe : base ≤ base + 2 + f := by
      rw [Nat.add_assoc]; exact Nat.le_add_right base (2 + f)
    have hKLt : base + 2 + f < base + nonScratchCompCount ed := by
      rw [hNonScr, Nat.add_assoc]
      exact Nat.add_lt_add_left (Nat.add_lt_add_left hfLt 2) base
    rw [hEq (base + 2 + f) hKGe hKLt]
    exact hFs f ov hf
  | liveDirect tag vfs =>
    let ⟨tW, tS, hL, hvL, hB0, hTagB, hTagS, hVfs⟩ := hM.2
    have hNonScr : nonScratchCompCount ed = 3 + (flattenAllVariantFieldTys ed).length := by
      unfold nonScratchCompCount; rw [hL]
    have hAt2 : Trusted.MirSemantics.getElem? slots₂' (base + 2) =
        Trusted.MirSemantics.getElem? slots₂ (base + 2) := by
      apply hEq (base + 2) (Nat.le_add_right base 2)
      rw [hNonScr]
      exact Nat.add_lt_add_left
        (Nat.lt_of_lt_of_le (Nat.lt_succ_self 2) (Nat.le_add_right 3 _)) base
    refine ⟨tW, tS, hL, hvL, by rw [hAt0]; exact hB0, hTagB,
            by rw [hAt2]; exact hTagS, ?_⟩
    intro v vd fs hv hfs
    let ⟨hLenFs, hF⟩ := hVfs v vd fs hv hfs
    refine ⟨hLenFs, ?_⟩
    intro f ov hf
    have hfLt : f < vd.fields.length := by rw [← hLenFs]; exact getElem?_some_lt hf
    have hOffLt : directVariantFieldOffset ed.variants v + f <
        (flattenAllVariantFieldTys ed).length :=
      Nat.lt_of_lt_of_le (Nat.add_lt_add_left hfLt _)
        (directVariantFieldOffset_bound ed.variants hv)
    let k := base + 3 + directVariantFieldOffset ed.variants v + f
    have hkAr : k = base + (3 + (directVariantFieldOffset ed.variants v + f)) := by
      dsimp [k]
      rw [Nat.add_assoc base 3 _, Nat.add_assoc base _ f, Nat.add_assoc 3 _ f]
    have hkGe : base ≤ k := by rw [hkAr]; exact Nat.le_add_right base _
    have hkLt : k < base + nonScratchCompCount ed := by
      rw [hkAr, hNonScr]
      exact Nat.add_lt_add_left (Nat.add_lt_add_left hOffLt 3) base
    rw [hEq k hkGe hkLt]
    exact hF f ov hf
  | liveNiche nb extras =>
    let ⟨tW, u, ns, nl, nsb, tr, nf, ur, uVd, hL, hu, hexL, hB0, hNbF, hN, hD, hG, hEx⟩ := hM.2
    have hNonScr : nonScratchCompCount ed =
        5 + (nicheExtraFieldTysAux nf 0 uVd.fields).length := by
      unfold nonScratchCompCount; rw [hL]; dsimp; rw [hu]
    have hHdr : ∀ i, i < 5 →
        Trusted.MirSemantics.getElem? slots₂' (base + i) =
          Trusted.MirSemantics.getElem? slots₂ (base + i) := by
      intro i hi
      apply hEq (base + i) (Nat.le_add_right base i)
      rw [hNonScr]
      exact Nat.add_lt_add_left (Nat.lt_of_lt_of_le hi (Nat.le_add_right 5 _)) base
    have h2Lt5 : 2 < 5 := Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 2))
    have h3Lt5 : 3 < 5 := Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 1)))
    have h4Lt5 : 4 < 5 := Nat.lt_succ_self 4
    refine ⟨tW, u, ns, nl, nsb, tr, nf, ur, uVd, hL, hu, hexL,
            by rw [hAt0]; exact hB0, hNbF,
            by rw [hHdr 2 h2Lt5]; exact hN,
            by rw [hHdr 3 h3Lt5]; exact hD,
            by rw [hHdr 4 h4Lt5]; exact hG, ?_⟩
    intro eIdx ov he
    have heLt : eIdx < (nicheExtraFieldTysAux nf 0 uVd.fields).length := by
      rw [← hexL]; exact getElem?_some_lt he
    have hkGe : base ≤ base + 5 + eIdx := by
      rw [Nat.add_assoc]; exact Nat.le_add_right base (5 + eIdx)
    have hkLt : base + 5 + eIdx < base + nonScratchCompCount ed := by
      rw [hNonScr, Nat.add_assoc]
      exact Nat.add_lt_add_left (Nat.add_lt_add_left heLt 5) base
    rw [hEq (base + 5 + eIdx) hkGe hkLt]
    exact hEx eIdx ov he

private theorem s3d2_writeAdtDiscriminant_niche_untagged_ok_eq
    {ed : AdtEnumDef} {tagW : IntWidth}
    {untagged nStart nLast : Nat} {nStartBits : BitVec 128}
    {tagRange : WrappingRange128} {nicheField : Nat} {uRange : WrappingRange128}
    {nb : Option (BitVec 128)} {extras : List (Option Val)} {sl' : EnumSlot}
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .niche tagW untagged nStart nLast nStartBits tagRange nicheField uRange)
    (hW : writeAdtDiscriminant ed untagged (.liveNiche nb extras) = .ok sl') :
    sl' = .liveNiche nb extras := by
  revert hW
  unfold writeAdtDiscriminant
  rw [hAdm]; dsimp
  cases Trusted.MirSemantics.getElem? ed.variants untagged with
  | none => intro h; cases h
  | some uVd =>
    dsimp
    cases variantIsUninhabited uVd with
    | true => intro h; cases h
    | false =>
      dsimp
      rw [hLay]; dsimp
      rw [nat_beq_refl untagged]; dsimp
      cases decodeNicheVariant ed tagW untagged nStart nLast nStartBits tagRange nb with
      | error _ => intro h; cases h
      | ok actual =>
        dsimp
        cases Nat.beq actual untagged with
        | false => intro h; cases h
        | true => intro h; injection h with hs; exact hs.symm

/-! ### 2. Target `enumLocal` Simulation for `setDiscriminant` -/

private theorem s3d2_setDiscriminant_enumLocal_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb bbTgt : EnumBlock}
    {preStmts postStmts : List EnumStmt} {v : Nat} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx =
      some (.setDiscriminant plan.enumLocal v))
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hPreEq : preStmts =
      listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx))
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hBbTgtStmts : bbTgt.statements =
      preStmts ++
        lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed
          (.setDiscriminant plan.enumLocal v) ++
        postStmts)
    (hStChk : checkStmtForEnumLocal ctx.body.locals plan.enumLocal ctx.ed
      (.setDiscriminant plan.enumLocal v) = true)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals)
    (_hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm }) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumStmt pSrc.enumDefs ctx.body f₁ cm (.setDiscriminant plan.enumLocal v)) := by
  let base := ctx.body.locals.length
  let ⟨hDeclLive, hDeclFault⟩ := s3d_compDecls_common ctx
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
  rw [nat_beq_refl] at hStChk; dsimp at hStChk
  have hvLt : v < ctx.ed.variants.length := nat_blt_lt hStChk
  let ⟨vd, hvGet⟩ := getElem?_some_of_lt ctx.ed.variants v hvLt
  dsimp [lowerEnumStmt] at hBbTgtStmts
  rw [nat_beq_refl] at hBbTgtStmts; dsimp at hBbTgtStmts
  rw [hvGet] at hBbTgtStmts; dsimp at hBbTgtStmts
  cases sl with
  | baseSlot _ => exact False.elim hMatch.2
  | enumDead =>
    have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
        (.setDiscriminant plan.enumLocal v) = .fault .undefined := by
      unfold evalEnumStmt writeAdtDiscriminant; dsimp
      rw [ctx.hEnumDecl, hSl1]; dsimp
      rw [ctx.hEdGet]; dsimp
      rw [ctx.hEdAdm, hvGet]; rfl
    have hStEx : ∃ tl, bbTgt.statements = preStmts ++ (mkLivenessCheckStmt base) :: tl := by
      cases hU : variantIsUninhabited vd with
      | true =>
        rw [hU] at hBbTgtStmts; dsimp at hBbTgtStmts
        exact ⟨_, by rw [hBbTgtStmts, List.append_assoc]; rfl⟩
      | false =>
        rw [hU] at hBbTgtStmts; dsimp at hBbTgtStmts
        cases hL : ctx.ed.layout with
        | empty | single | direct _ _ =>
          rw [hL] at hBbTgtStmts; dsimp at hBbTgtStmts
          exact ⟨_, by rw [hBbTgtStmts, List.append_assoc]; rfl⟩
        | niche tagW untagged nStart nLast nStartBits _ _ uRange =>
          rw [hL] at hBbTgtStmts; dsimp at hBbTgtStmts
          cases hBU : Nat.beq v untagged with
          | true =>
            rw [hBU] at hBbTgtStmts; dsimp at hBbTgtStmts
            exact ⟨_, by rw [hBbTgtStmts, List.append_assoc]; rfl⟩
          | false =>
            rw [hBU] at hBbTgtStmts; dsimp at hBbTgtStmts
            cases hBR : (Nat.ble nStart v && Nat.ble v nLast) <;> (
              rw [hBR] at hBbTgtStmts; dsimp at hBbTgtStmts
              exact ⟨_, by rw [hBbTgtStmts, List.append_assoc]; rfl⟩)
    let ⟨_, hSt1⟩ := hStEx
    have hEv2 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } = .fault .undefined :=
      (stepAtStmt hB2 hBB2 hSt1 hF2Idx).trans
        ((hStepEqDefs f₂ cm _).trans (eval_mkLivenessCheckStmt_dead hDeclLive hMatch.2))
    exact simFault0 hEv1 hEv2
  | liveEmpty =>
    have hLay : ctx.ed.layout = .empty := hMatch.2.1
    have hEmpty : ctx.ed.variants.isEmpty = true := by
      have hA := ctx.hEdAdm; unfold adtEnumDefAdmitted at hA; rw [hLay] at hA
      exact (bool_and_true hA).2
    cases hVs : ctx.ed.variants with
    | nil => rw [hVs] at hvGet; cases hvGet
    | cons _ _ => rw [hVs] at hEmpty; cases hEmpty
  | liveSingle fs =>
    let ⟨hLay, vd₀, hv0Get, _, hLiveSlot, _⟩ := hMatch.2
    let ⟨_, _, hLen1, _, _⟩ := s3d_compDecls_single ctx hLay
    have hvZero : v = 0 := by
      rw [hLen1] at hvLt
      cases v with
      | zero => rfl
      | succ v' => exact False.elim (Nat.not_lt_zero v' (Nat.lt_of_succ_lt_succ hvLt))
    subst hvZero
    rw [hv0Get] at hvGet; injection hvGet with hvdEq; subst hvdEq
    cases hUninh : variantIsUninhabited vd₀ with
    | true =>
      rw [hUninh] at hBbTgtStmts; dsimp at hBbTgtStmts
      have hSt1 : bbTgt.statements = preStmts ++
          (mkLivenessCheckStmt base) :: (mkImmediateUbStmt (base + 1) :: postStmts) := by
        rw [hBbTgtStmts, List.append_assoc]; rfl
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.setDiscriminant plan.enumLocal 0) = .fault .undefined := by
        unfold evalEnumStmt writeAdtDiscriminant; dsimp
        rw [ctx.hEnumDecl, hSl1]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [ctx.hEdAdm, hv0Get]; dsimp
        rw [hUninh]; rfl
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
            eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
      have hSt2 : bbTgt.statements =
          (preStmts ++ [mkLivenessCheckStmt base]) ++ mkImmediateUbStmt (base + 1) :: postStmts := by
        rw [hSt1]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
      have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
        list_append_length preStmts [_]
      have hStep2 : evalStepEnum pOut 0
          { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } =
          .fault .undefined :=
        (stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 }) hB2 hBB2 hSt2 hPre1Len.symm).trans
          ((hStepEqDefs _ cm _).trans (eval_mkImmediateUbStmt hDeclFault))
      exact simFaultR hEv1 (c_reachesEnum_head_det hStep1 (ReachesEnum.refl _)) hStep2
    | false =>
      rw [hUninh, hLay] at hBbTgtStmts; dsimp at hBbTgtStmts
      have hSt1 : bbTgt.statements = preStmts ++ (mkLivenessCheckStmt base) :: postStmts := by
        rw [hBbTgtStmts, List.append_assoc]; rfl
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.setDiscriminant plan.enumLocal 0) =
          .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1 }], callerMem := cm } := by
        unfold evalEnumStmt writeAdtDiscriminant; dsimp
        rw [ctx.hEnumDecl, hSl1]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [ctx.hEdAdm, hv0Get]; dsimp
        rw [hUninh]; dsimp
        rw [hLay]; dsimp
        rw [setElem?_eq_self_of_getElem? hSl1]
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := f₂.stmtIdx + 1 }], callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
            eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot]
      have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
        (hF2Idx.trans (congrArg List.length hPreEq)) hPre hSl1 hMatch
        (fun _ _ _ h => by cases h)
      dsimp [lowerEnumStmt] at hPost
      rw [nat_beq_refl] at hPost; dsimp at hPost
      rw [hv0Get] at hPost; dsimp at hPost
      rw [hUninh, hLay] at hPost; dsimp [List.length] at hPost
      exact simStep1 hEv1 hStep1 hPost
  | liveDirect tag vfs =>
    let ⟨tagW, tagS, hLay, hvfsLen, hLiveSlot, _, hTagSlot, hVfsMatch⟩ := hMatch.2
    let ⟨_, hDeclTag, _⟩ := s3d_compDecls_direct ctx hLay
    cases hUninh : variantIsUninhabited vd with
    | true =>
      rw [hUninh] at hBbTgtStmts; dsimp at hBbTgtStmts
      have hSt1 : bbTgt.statements = preStmts ++
          (mkLivenessCheckStmt base) :: (mkImmediateUbStmt (base + 1) :: postStmts) := by
        rw [hBbTgtStmts, List.append_assoc]; rfl
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.setDiscriminant plan.enumLocal v) = .fault .undefined := by
        unfold evalEnumStmt writeAdtDiscriminant; dsimp
        rw [ctx.hEnumDecl, hSl1]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [ctx.hEdAdm, hvGet]; dsimp
        rw [hUninh]; rfl
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
            eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
      have hSt2 : bbTgt.statements =
          (preStmts ++ [mkLivenessCheckStmt base]) ++ mkImmediateUbStmt (base + 1) :: postStmts := by
        rw [hSt1]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
      have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
        list_append_length preStmts [_]
      have hStep2 : evalStepEnum pOut 0
          { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } =
          .fault .undefined :=
        (stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 }) hB2 hBB2 hSt2 hPre1Len.symm).trans
          ((hStepEqDefs _ cm _).trans (eval_mkImmediateUbStmt hDeclFault))
      exact simFaultR hEv1 (c_reachesEnum_head_det hStep1 (ReachesEnum.refl _)) hStep2
    | false =>
      rw [hUninh, hLay] at hBbTgtStmts; dsimp at hBbTgtStmts
      let ety := directTagEnumTy ctx.ed tagW tagS
      let tBits := truncateBits tagW (BitVec.ofNat 128 vd.discrVal)
      let cOp : Operand := .constant { ty := .enum ety, lit := .scalar tBits }
      let stAssign : EnumStmt := .baseStmt (.assign { localId := base + 2, projection := [] } (.use cOp))
      have hSt1 : bbTgt.statements = preStmts ++ (mkLivenessCheckStmt base) :: (stAssign :: postStmts) := by
        rw [hBbTgtStmts, List.append_assoc]; rfl
      let ⟨s1End, hSet1⟩ := setElem?_some_of_lt f₁.locals plan.enumLocal
        (.liveDirect (some v) vfs) (getElem?_some_lt hSl1)
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.setDiscriminant plan.enumLocal v) =
          .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := s1End }],
                  callerMem := cm } := by
        unfold evalEnumStmt writeAdtDiscriminant; dsimp
        rw [ctx.hEnumDecl, hSl1]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [ctx.hEdAdm, hvGet]; dsimp
        rw [hUninh]; dsimp
        rw [hLay]; dsimp
        rw [hSet1]
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
            eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
      have hSt2 : bbTgt.statements =
          (preStmts ++ [mkLivenessCheckStmt base]) ++ stAssign :: postStmts := by
        rw [hSt1]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
      have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
        list_append_length preStmts [_]
      let ⟨hEvConst, hChkEnum⟩ := directTagEnumTy_evalConstLit ctx.hEdAdm hLay hvGet
      let ⟨s2End, hSet2⟩ := setElem?_some_of_lt f₂.locals (base + 2)
        (.baseSlot (.live (some (.enumVal ety v)))) (getElem?_some_lt hTagSlot)
      have hStep2 : evalStepEnum pOut 0
          { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2End }],
                  callerMem := cm } := by
        rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 }) hB2 hBB2 hSt2 hPre1Len.symm,
            hStepEqDefs]
        dsimp [stAssign, cOp]
        unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot writeEnumBasePlace
        dsimp
        rw [hDeclTag, hEvConst]; dsimp
        rw [mirTy_beq_refl (.enum ety)]; dsimp
        rw [hChkEnum]; dsimp
        rw [hTagSlot]; dsimp
        rw [hSet2]
      have hPreEnd : PrefixSlotsAgree base plan.enumLocal s1End s2End := by
        refine ⟨(setElem?_length hSet1).trans hPre.1,
                by rw [setElem?_length hSet2]; exact hPre.2.1, ?_⟩
        intro j hjLt hjNe
        rw [setElem?_getElem?_ne hSet2
              (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt (Nat.le_add_right base 2))),
            setElem?_getElem?_ne hSet1 hjNe]
        exact hPre.2.2 j hjLt hjNe
      have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveDirect (some v) vfs) s2End := by
        refine ⟨(setElem?_length hSet2).trans hMatch.1, tagW, tagS, hLay, hvfsLen, ?_, ?_, ?_, ?_⟩
        · rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_lt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ 1)))]
          exact hLiveSlot
        · intro vx hvx; injection hvx with hvEq; subst hvEq; exact hvLt
        · exact setElem?_getElem?_same hSet2
        · intro vx vdx fsx hvx hfsx
          let ⟨hFsLen, hFsAt⟩ := hVfsMatch vx vdx fsx hvx hfsx
          refine ⟨hFsLen, ?_⟩
          intro fx ovx hfx
          have hSlotGtTag : base + 2 < base + 3 + directVariantFieldOffset ctx.ed.variants vx + fx :=
            Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_succ_self 2) base)
              (Nat.le_trans (Nat.le_add_right (base + 3) _) (Nat.le_add_right _ fx))
          rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_gt hSlotGtTag)]
          exact hFsAt fx ovx hfx
      have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
        (hF2Idx.trans (congrArg List.length hPreEq)) hPreEnd
        (setElem?_getElem?_same hSet1) hMatchEnd
        (fun vx _ vdx hsl hvx => by
          injection hsl with h1 _
          injection h1 with hvEq; subst hvEq
          rw [hvGet] at hvx; injection hvx with hvdEq; subst hvdEq
          exact hUninh)
      dsimp [lowerEnumStmt] at hPost
      rw [nat_beq_refl] at hPost; dsimp at hPost
      rw [hvGet] at hPost; dsimp at hPost
      rw [hUninh, hLay] at hPost; dsimp [List.length] at hPost
      rw [← hF2Idx] at hStep1 hStep2
      exact simStepPlus hEv1 hStep1 (ReachesNEnum.succ hStep2 (ReachesNEnum.zero _)) hPost
  | liveNiche nb extras =>
    let ⟨tagW, untagged, nStart, nLast, nStartBits, tagRange, nicheField, uRange, uVd,
         hLay, huGet, hexLen, hLiveSlot, hNbFit, hSlotNiche, ⟨oD, hSlotDiff⟩, ⟨oG, hSlotGuard⟩, hSlotExtras⟩ :=
      hMatch.2
    let ⟨_, hDeclNiche, hDeclDiff, hDeclGuard, _, _⟩ := s3d_compDecls_niche ctx hLay huGet
    let ⟨_, _, _, _, _, _, _, hURFit, _⟩ := s3d_adtEnumDefAdmitted_niche_props ctx.hEdAdm hLay
    let ⟨_, _, hUntagW⟩ := wrappingNiche_partition_and_writeOrder_iff_slice2
      ctx.ed tagW untagged nStart nLast nStartBits tagRange nicheField uRange ctx.hEdAdm hLay
    cases hUninh : variantIsUninhabited vd with
    | true =>
      rw [hUninh] at hBbTgtStmts; dsimp at hBbTgtStmts
      have hSt1 : bbTgt.statements = preStmts ++
          (mkLivenessCheckStmt base) :: (mkImmediateUbStmt (base + 1) :: postStmts) := by
        rw [hBbTgtStmts, List.append_assoc]; rfl
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.setDiscriminant plan.enumLocal v) = .fault .undefined := by
        unfold evalEnumStmt writeAdtDiscriminant; dsimp
        rw [ctx.hEnumDecl, hSl1]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [ctx.hEdAdm, hvGet]; dsimp
        rw [hUninh]; rfl
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
            eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
      have hSt2 : bbTgt.statements =
          (preStmts ++ [mkLivenessCheckStmt base]) ++ mkImmediateUbStmt (base + 1) :: postStmts := by
        rw [hSt1]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
      have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
        list_append_length preStmts [_]
      have hStep2 : evalStepEnum pOut 0
          { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } =
          .fault .undefined :=
        (stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 }) hB2 hBB2 hSt2 hPre1Len.symm).trans
          ((hStepEqDefs _ cm _).trans (eval_mkImmediateUbStmt hDeclFault))
      exact simFaultR hEv1 (c_reachesEnum_head_det hStep1 (ReachesEnum.refl _)) hStep2
    | false =>
      rw [hUninh, hLay] at hBbTgtStmts; dsimp at hBbTgtStmts
      cases hBeqU : Nat.beq v untagged with
      | true =>
        have hvEqU : v = untagged := nat_beq_eq hBeqU
        subst hvEqU
        rw [nat_beq_refl] at hBbTgtStmts; dsimp at hBbTgtStmts
        let rngStmts := mkWrappingRangeCheckStmts tagW (base + 3) (base + 4)
          (.copy { localId := base + 2, projection := [] }) uRange
        have hSt1 : bbTgt.statements = preStmts ++ (mkLivenessCheckStmt base) :: (rngStmts ++ postStmts) := by
          rw [hBbTgtStmts, List.append_assoc]; rfl
        have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
            .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
          rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
              eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
        have hStRng : bbTgt.statements =
            (preStmts ++ [mkLivenessCheckStmt base]) ++ rngStmts ++ postStmts := by
          rw [hSt1]
          change preStmts ++ ([_] ++ (rngStmts ++ postStmts)) = _
          rw [← List.append_assoc, ← List.append_assoc]
        have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
          list_append_length preStmts [_]
        have hDiffNeGuard : base + 4 ≠ base + 3 :=
          s3d2_ne_of_gt (Nat.add_lt_add_left (Nat.lt_succ_self 3) base)
        let ⟨hRngNone, hRngSome⟩ := exec_mkWrappingRangeCheckStmts_copy
          (f := { f₂ with stmtIdx := preStmts.length + 1 }) (cm := cm)
          hB2 hBB2 hStRng hPre1Len.symm hURFit hDeclNiche hDeclDiff hDeclGuard
          hDiffNeGuard hSlotDiff hSlotGuard
        rw [hPre1Len] at hRngSome
        let ⟨hWIff, hWErr⟩ := hUntagW nb extras
        cases nb with
        | none =>
          have hW : writeAdtDiscriminant ctx.ed v (.liveNiche none extras) = .error .undefined :=
            hWErr (Or.inl rfl)
          have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
              (.setDiscriminant plan.enumLocal v) = .fault .undefined := by
            unfold evalEnumStmt; dsimp
            rw [ctx.hEnumDecl, hSl1]; dsimp
            rw [ctx.hEdGet]; dsimp
            rw [hW]
          exact simFaultR hEv1 (c_reachesEnum_head_det hStep1 (ReachesEnum.refl _))
            (hRngNone hSlotNiche)
        | some bits =>
          have hBitsFit : truncateBits tagW bits = bits := hNbFit bits rfl
          let ⟨hRngIn, hRngOut⟩ := hRngSome bits hBitsFit hSlotNiche
          cases hInU : wrappingRangeContains uRange bits with
          | false =>
            have hW : writeAdtDiscriminant ctx.ed v (.liveNiche (some bits) extras) = .error .undefined :=
              hWErr (Or.inr ⟨bits, rfl, hBitsFit, hInU⟩)
            have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
                (.setDiscriminant plan.enumLocal v) = .fault .undefined := by
              unfold evalEnumStmt; dsimp
              rw [ctx.hEnumDecl, hSl1]; dsimp
              rw [ctx.hEdGet]; dsimp
              rw [hW]
            let ⟨sF, hRF, hEvF⟩ := hRngOut hInU
            exact simFaultR hEv1 (c_reachesEnum_head_det hStep1 hRF) hEvF
          | true =>
            let ⟨slOut, hWOk⟩ := hWIff.mpr ⟨bits, rfl, hBitsFit, hInU⟩
            have hslOutEq := s3d2_writeAdtDiscriminant_niche_untagged_ok_eq ctx.hEdAdm hLay hWOk
            subst hslOutEq
            have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
                (.setDiscriminant plan.enumLocal v) =
                .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1 }], callerMem := cm } := by
              unfold evalEnumStmt; dsimp
              rw [ctx.hEnumDecl, hSl1]; dsimp
              rw [ctx.hEdGet]; dsimp
              rw [hWOk]; dsimp
              rw [setElem?_eq_self_of_getElem? hSl1]
            let ⟨s2End, oD', oG', hR2, hLenEnd, hSD', hSG', hPresEnd⟩ := hRngIn hInU
            have hPreEnd : PrefixSlotsAgree base plan.enumLocal f₁.locals s2End := by
              refine ⟨hPre.1, by rw [hLenEnd]; exact hPre.2.1, ?_⟩
              intro j hjLt hjNe
              rw [hPresEnd j
                    (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt (Nat.le_add_right base 3)))
                    (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt (Nat.le_add_right base 4)))]
              exact hPre.2.2 j hjLt hjNe
            have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveNiche (some bits) extras) s2End := by
              refine ⟨hLenEnd.trans hMatch.1, tagW, v, nStart, nLast, nStartBits, tagRange,
                      nicheField, uRange, uVd, hLay, huGet, hexLen, ?_, hNbFit, ?_,
                      ⟨oD', hSD'⟩, ⟨oG', hSG'⟩, ?_⟩
              · rw [hPresEnd base
                  (s3d2_ne_of_lt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ 2)))
                  (s3d2_ne_of_lt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ 3)))]
                exact hLiveSlot
              · rw [hPresEnd (base + 2)
                  (s3d2_ne_of_lt (Nat.add_lt_add_left (Nat.lt_succ_self 2) base))
                  (s3d2_ne_of_lt (Nat.add_lt_add_left (Nat.lt_trans (Nat.lt_succ_self 2) (Nat.lt_succ_self 3)) base))]
                exact hSlotNiche
              · intro ei ov hei
                rw [hPresEnd (base + 5 + ei)
                  (s3d2_ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_trans (Nat.lt_succ_self 3) (Nat.lt_succ_self 4)) base) (Nat.le_add_right (base + 5) ei)))
                  (s3d2_ne_of_gt (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_succ_self 4) base) (Nat.le_add_right (base + 5) ei)))]
                exact hSlotExtras ei ov hei
            have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
              (hF2Idx.trans (congrArg List.length hPreEq)) hPreEnd hSl1 hMatchEnd
              (fun _ _ _ h => by cases h)
            dsimp [lowerEnumStmt] at hPost
            rw [nat_beq_refl] at hPost; dsimp at hPost
            rw [hvGet] at hPost; dsimp at hPost
            rw [hUninh, hLay] at hPost; dsimp at hPost
            rw [nat_beq_refl] at hPost; dsimp [mkWrappingRangeCheckStmts, List.length] at hPost
            dsimp at hR2
            have hAr3 : preStmts.length + 1 + 2 = f₂.stmtIdx + 3 := by
              rw [hF2Idx, Nat.add_assoc]
            rw [hAr3] at hR2
            rw [← hF2Idx] at hR2 hStep1
            exact simStepPlus hEv1 hStep1 hR2 hPost
      | false =>
        rw [hBeqU] at hBbTgtStmts; dsimp at hBbTgtStmts
        cases hInNiche : (Nat.ble nStart v && Nat.ble v nLast) with
        | false =>
          rw [hInNiche] at hBbTgtStmts; dsimp at hBbTgtStmts
          have hSt1 : bbTgt.statements = preStmts ++
              (mkLivenessCheckStmt base) :: ((.baseStmt .unsupported) :: postStmts) := by
            rw [hBbTgtStmts, List.append_assoc]; rfl
          have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
              (.setDiscriminant plan.enumLocal v) = .fault .unsupported := by
            unfold evalEnumStmt writeAdtDiscriminant; dsimp
            rw [ctx.hEnumDecl, hSl1]; dsimp
            rw [ctx.hEdGet]; dsimp
            rw [ctx.hEdAdm, hvGet]; dsimp
            rw [hUninh, hLay]; dsimp
            rw [hBeqU, hInNiche]; rfl
          have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
              .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
            rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
                eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
          have hSt2 : bbTgt.statements =
              (preStmts ++ [mkLivenessCheckStmt base]) ++ (.baseStmt .unsupported) :: postStmts := by
            rw [hSt1]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
          have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
            list_append_length preStmts [_]
          have hStep2 : evalStepEnum pOut 0
              { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } =
              .fault .unsupported := by
            rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 }) hB2 hBB2 hSt2 hPre1Len.symm,
                hStepEqDefs]
            rfl
          exact simFaultR hEv1 (c_reachesEnum_head_det hStep1 (ReachesEnum.refl _)) hStep2
        | true =>
          rw [hInNiche] at hBbTgtStmts; dsimp at hBbTgtStmts
          let tBits := addTruncBits tagW (BitVec.ofNat 128 (v - nStart)) nStartBits
          have hTFit : truncateBits tagW tBits = tBits :=
            truncateBits_addTruncBits tagW _ _
          let cOp : Operand := .constant { ty := .int tagW false, lit := .scalar tBits }
          let stAssign : EnumStmt := .baseStmt (.assign { localId := base + 2, projection := [] } (.use cOp))
          have hSt1 : bbTgt.statements = preStmts ++ (mkLivenessCheckStmt base) :: (stAssign :: postStmts) := by
            rw [hBbTgtStmts, List.append_assoc]; rfl
          let ⟨s1End, hSet1⟩ := setElem?_some_of_lt f₁.locals plan.enumLocal
            (.liveNiche (some tBits) extras) (getElem?_some_lt hSl1)
          have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
              (.setDiscriminant plan.enumLocal v) =
              .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := s1End }],
                      callerMem := cm } := by
            unfold evalEnumStmt writeAdtDiscriminant; dsimp
            rw [ctx.hEnumDecl, hSl1]; dsimp
            rw [ctx.hEdGet]; dsimp
            rw [ctx.hEdAdm, hvGet]; dsimp
            rw [hUninh, hLay]; dsimp
            rw [hBeqU, hInNiche]; dsimp
            rw [hSet1]
          have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
              .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
            rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
                eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
          have hSt2 : bbTgt.statements =
              (preStmts ++ [mkLivenessCheckStmt base]) ++ stAssign :: postStmts := by
            rw [hSt1]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
          have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
            list_append_length preStmts [_]
          let ⟨s2End, hSet2⟩ := setElem?_some_of_lt f₂.locals (base + 2)
            (.baseSlot (.live (some (.scalar ⟨tagW, false, tBits⟩)))) (getElem?_some_lt hSlotNiche)
          have hStep2 : evalStepEnum pOut 0
              { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } =
              .step { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2End }],
                      callerMem := cm } := by
            rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 }) hB2 hBB2 hSt2 hPre1Len.symm,
                hStepEqDefs]
            dsimp [stAssign, cOp]
            unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot writeEnumBasePlace
            dsimp
            rw [hDeclNiche, evalConstLit_uint_eq tagW tBits hTFit]; dsimp
            rw [mirTy_beq_refl (.int tagW false)]; dsimp
            rw [checkVal_uint_of_fit tagW tBits hTFit, hSlotNiche]; dsimp
            rw [hSet2]
          have hPreEnd : PrefixSlotsAgree base plan.enumLocal s1End s2End := by
            refine ⟨(setElem?_length hSet1).trans hPre.1,
                    by rw [setElem?_length hSet2]; exact hPre.2.1, ?_⟩
            intro j hjLt hjNe
            rw [setElem?_getElem?_ne hSet2
                  (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt (Nat.le_add_right base 2))),
                setElem?_getElem?_ne hSet1 hjNe]
            exact hPre.2.2 j hjLt hjNe
          have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveNiche (some tBits) extras) s2End := by
            refine ⟨(setElem?_length hSet2).trans hMatch.1, tagW, untagged, nStart, nLast, nStartBits,
                    tagRange, nicheField, uRange, uVd, hLay, huGet, hexLen, ?_,
                    (fun b hb => by injection hb with hbEq; subst hbEq; exact hTFit),
                    setElem?_getElem?_same hSet2,
                    ⟨oD, ?_⟩, ⟨oG, ?_⟩, ?_⟩
            · rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_lt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ 1)))]
              exact hLiveSlot
            · rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_gt (Nat.add_lt_add_left (Nat.lt_succ_self 2) base))]
              exact hSlotDiff
            · rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_gt (Nat.add_lt_add_left (Nat.lt_trans (Nat.lt_succ_self 2) (Nat.lt_succ_self 3)) base))]
              exact hSlotGuard
            · intro ei ov hei
              rw [setElem?_getElem?_ne hSet2 (s3d2_ne_of_gt
                (Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ 2))) base)
                  (Nat.le_add_right (base + 5) ei)))]
              exact hSlotExtras ei ov hei
          have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
            (hF2Idx.trans (congrArg List.length hPreEq)) hPreEnd
            (setElem?_getElem?_same hSet1) hMatchEnd
            (fun _ _ _ h => by cases h)
          dsimp [lowerEnumStmt] at hPost
          rw [nat_beq_refl] at hPost; dsimp at hPost
          rw [hvGet] at hPost; dsimp at hPost
          rw [hUninh, hLay] at hPost; dsimp at hPost
          rw [hBeqU, hInNiche] at hPost; dsimp [List.length] at hPost
          rw [← hF2Idx] at hStep1 hStep2
          exact simStepPlus hEv1 hStep1 (ReachesNEnum.succ hStep2 (ReachesNEnum.zero _)) hPost

/-! ### 3. Reusable 2-Step Scratch Evaluation Helper & `assignField` Simulation -/

private theorem s3d2_exec_scrLiveAndAssign {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bbTgt : EnumBlock}
    {preStmts tailStmts : List EnumStmt}
    {scr : LocalId} {fTy : MirTy} {rval : Rvalue} {sl : EnumSlot}
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hDeclScr : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).locals scr = some (.base fTy))
    (hScrGeNonScr : ctx.body.locals.length + nonScratchCompCount ctx.ed ≤ scr)
    (hScrLtLen : scr < f₂.locals.length)
    (hStmts : bbTgt.statements =
      preStmts ++ (EnumStmt.baseStmt (.storageLive scr)) ::
        (EnumStmt.baseStmt (.assign { localId := scr, projection := [] } rval)) :: tailStmts)
    (hRvBnd : rvalueLocalsInBounds ctx.body.locals.length rval = true)
    (hRvNoMent : rvalueMentionsLocal plan.enumLocal rval = false)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals) :
    (∀ fk, evalEnumBaseRvalue ctx.body.locals f₁.locals fTy rval = .error fk →
      ∃ sF, ReachesEnum pOut { frames := [f₂], callerMem := cm } sF ∧
        evalStepEnum pOut 0 sF = .fault fk) ∧
    (∀ val s1Mid,
      evalEnumBaseRvalue ctx.body.locals f₁.locals fTy rval = .ok (val, s1Mid) →
      (checkVal val fTy = false →
        ∃ sF, ReachesEnum pOut { frames := [f₂], callerMem := cm } sF ∧
          evalStepEnum pOut 0 sF = .fault .unsupported) ∧
      (checkVal val fTy = true →
        ∃ s2Mid : List EnumSlot,
          ReachesNEnum pOut 2 { frames := [f₂], callerMem := cm }
            { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid }],
              callerMem := cm } ∧
          Trusted.MirSemantics.getElem? s1Mid plan.enumLocal = some sl ∧
          PrefixSlotsAgree ctx.body.locals.length plan.enumLocal s1Mid s2Mid ∧
          SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl s2Mid ∧
          Trusted.MirSemantics.getElem? s2Mid scr = some (.baseSlot (.live (some val))))) := by
  let base := ctx.body.locals.length
  let ⟨_, _, hDeclPre, _⟩ := scalarizeCtx_target_decl_lookup ctx
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  have hScrGeBase : base ≤ scr :=
    Nat.le_trans (Nat.le_add_right base _) hScrGeNonScr
  let ⟨s2Live, hSetLive⟩ := setElem?_some_of_lt f₂.locals scr
    (.baseSlot (liveUninitSlot fTy)) hScrLtLen
  let stLive : EnumStmt := .baseStmt (.storageLive scr)
  let stAssign : EnumStmt := .baseStmt (.assign { localId := scr, projection := [] } rval)
  have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
      .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1, locals := s2Live }],
              callerMem := cm } := by
    rw [stepAtStmt hB2 hBB2 hStmts hF2Idx, hStepEqDefs]
    unfold evalEnumStmt liveUninitEnumSlot; dsimp
    rw [hDeclScr]; dsimp
    rw [hSetLive, hF2Idx]
  have hPreLive : PrefixSlotsAgree base plan.enumLocal f₁.locals s2Live := by
    refine ⟨hPre.1, by rw [setElem?_length hSetLive]; exact hPre.2.1, ?_⟩
    intro j hjLt hjNe
    rw [setElem?_getElem?_ne hSetLive (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt hScrGeBase))]
    exact hPre.2.2 j hjLt hjNe
  have hSt2 : bbTgt.statements = (preStmts ++ [stLive]) ++ stAssign :: tailStmts := by
    dsimp [stLive, stAssign]
    rw [hStmts]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
  have hPre1Len : (preStmts ++ [stLive]).length = preStmts.length + 1 :=
    list_append_length preStmts [stLive]
  let ⟨hRvErr, hRvOk⟩ := evalEnumBaseRvalue_agree (dstTy := fTy)
    hDeclPre hPreLive hRvBnd hRvNoMent
  refine ⟨?_, ?_⟩
  · intro fk hErr1
    have hFault2 : evalStepEnum pOut 0
        { frames := [{ f₂ with stmtIdx := preStmts.length + 1, locals := s2Live }],
          callerMem := cm } = .fault fk := by
      rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1, locals := s2Live })
            hB2 hBB2 hSt2 hPre1Len.symm, hStepEqDefs]
      dsimp [stAssign]
      unfold evalEnumStmt; dsimp
      rw [hDeclScr]; dsimp; rw [hRvErr fk hErr1]
    exact ⟨_, c_reachesEnum_head_det hStep1 (ReachesEnum.refl _), hFault2⟩
  · intro val s1Mid hOk1
    let ⟨s2AfterRv, hOk2, hLenRv, hPreRv, hOutRv⟩ := hRvOk val s1Mid hOk1
    have hSl1Mid : Trusted.MirSemantics.getElem? s1Mid plan.enumLocal = some sl :=
      (s3d_evalEnumBaseRvalue_preserves_enumLocal hRvNoMent hOk1).trans hSl1
    have hScrSlotRv : Trusted.MirSemantics.getElem? s2AfterRv scr =
        some (.baseSlot (liveUninitSlot fTy)) :=
      (hOutRv scr (Or.inr hScrGeBase)).trans (setElem?_getElem?_same hSetLive)
    refine ⟨?_, ?_⟩
    · intro hChkF
      have hFault2 : evalStepEnum pOut 0
          { frames := [{ f₂ with stmtIdx := preStmts.length + 1, locals := s2Live }],
            callerMem := cm } = .fault .unsupported := by
        rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1, locals := s2Live })
              hB2 hBB2 hSt2 hPre1Len.symm, hStepEqDefs]
        dsimp [stAssign]
        unfold evalEnumStmt writeEnumBasePlace; dsimp
        rw [hDeclScr]; dsimp; rw [hOk2]; dsimp
        rw [hChkF]; rfl
      exact ⟨_, c_reachesEnum_head_det hStep1 (ReachesEnum.refl _), hFault2⟩
    · intro hChkT
      let ⟨s2Mid, hSetScr⟩ := setElem?_some_of_lt s2AfterRv scr
        (.baseSlot (.live (some val))) (getElem?_some_lt hScrSlotRv)
      have hStep2 : evalStepEnum pOut 0
          { frames := [{ f₂ with stmtIdx := preStmts.length + 1, locals := s2Live }],
            callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid }],
                  callerMem := cm } := by
        rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1, locals := s2Live })
              hB2 hBB2 hSt2 hPre1Len.symm, hStepEqDefs]
        dsimp [stAssign]
        unfold evalEnumStmt writeEnumBasePlace; dsimp
        rw [hDeclScr]; dsimp; rw [hOk2]; dsimp
        rw [hChkT]; dsimp
        rw [hScrSlotRv, liveUninitSlot_eq_initFieldOptVal fTy]; dsimp
        rw [hSetScr]
      have hLenMid : s2Mid.length = f₂.locals.length :=
        (setElem?_length hSetScr).trans (hLenRv.trans (setElem?_length hSetLive))
      have hPreMid : PrefixSlotsAgree base plan.enumLocal s1Mid s2Mid := by
        refine ⟨hPreRv.1, by rw [hLenMid]; exact hPre.2.1, ?_⟩
        intro j hjLt hjNe
        rw [setElem?_getElem?_ne hSetScr (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt hScrGeBase))]
        exact hPreRv.2.2 j hjLt hjNe
      have hMatchMid : SlotMatchesComp ctx.ed base ctx.compTys sl s2Mid := by
        apply s3d2_slotMatchesComp_congr_nonScratch hMatch hLenMid
        intro k hkGe hkLtNonScr
        have hkNeScr : k ≠ scr := s3d2_ne_of_lt (Nat.lt_of_lt_of_le hkLtNonScr hScrGeNonScr)
        rw [setElem?_getElem?_ne hSetScr hkNeScr,
            hOutRv k (Or.inr hkGe),
            setElem?_getElem?_ne hSetLive hkNeScr]
      exact ⟨s2Mid,
             ReachesNEnum.succ hStep1 (ReachesNEnum.succ hStep2 (ReachesNEnum.zero _)),
             hSl1Mid, hPreMid, hMatchMid, setElem?_getElem?_same hSetScr⟩

private theorem s3d2_assignField_enumLocal_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb bbTgt : EnumBlock}
    {preStmts postStmts : List EnumStmt}
    {v f : Nat} {rval : Rvalue} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx =
      some (.assignField plan.enumLocal v f rval))
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hPreEq : preStmts =
      listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx))
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hBbTgtStmts : bbTgt.statements =
      preStmts ++
        lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed
          (.assignField plan.enumLocal v f rval) ++
        postStmts)
    (hStChk : checkStmtForEnumLocal ctx.body.locals plan.enumLocal ctx.ed
      (.assignField plan.enumLocal v f rval) = true)
    (hStBnd : enumStmtLocalsInBounds ctx.body.locals.length
      (.assignField plan.enumLocal v f rval) = true)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals)
    (hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm }) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumStmt pSrc.enumDefs ctx.body f₁ cm (.assignField plan.enumLocal v f rval)) := by
  let base := ctx.body.locals.length
  let bodyTgt := scalarizeTargetBody ctx
  let ⟨hDeclLive, _⟩ := s3d_compDecls_common ctx
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  let ⟨_, hRvBnd⟩ := bool_and_true hStBnd
  unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
  rw [nat_beq_refl] at hStChk; dsimp at hStChk
  let ⟨hRvNoMB, hVarFieldChk⟩ := bool_and_true hStChk
  have hRvNoM : rvalueMentionsLocal plan.enumLocal rval = false := bool_not_true hRvNoMB
  have hVarField : ∃ vd fTy,
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd ∧
      Trusted.MirSemantics.getElem? vd.fields f = some fTy := by
    cases hv : Trusted.MirSemantics.getElem? ctx.ed.variants v with
    | none => rw [hv] at hVarFieldChk; cases hVarFieldChk
    | some vd =>
      rw [hv] at hVarFieldChk
      let ⟨fTy, hf⟩ := getElem?_some_of_lt vd.fields f (nat_blt_lt hVarFieldChk)
      exact ⟨vd, fTy, rfl, hf⟩
  let ⟨vd, fTy, hvGet, hfGet⟩ := hVarField
  have hfLt : f < vd.fields.length := getElem?_some_lt hfGet
  have hInvSl : ∀ vx vfs vdx,
      sl = .liveDirect (some vx) vfs →
      Trusted.MirSemantics.getElem? ctx.ed.variants vx = some vdx →
      variantIsUninhabited vdx = false :=
    fun vx vfs vdx hsl hv =>
      hDirectInv f₁ vx vfs vdx rfl hDef1 (by rw [hsl] at hSl1; exact hSl1) hv
  dsimp [lowerEnumStmt] at hBbTgtStmts
  rw [nat_beq_refl] at hBbTgtStmts; dsimp at hBbTgtStmts
  cases hLay : ctx.ed.layout with
  | empty =>
    have hEmpty : ctx.ed.variants.isEmpty = true := by
      have hA := ctx.hEdAdm; unfold adtEnumDefAdmitted at hA; rw [hLay] at hA
      exact (bool_and_true hA).2
    cases hVs : ctx.ed.variants with
    | nil => rw [hVs] at hvGet; cases hvGet
    | cons _ _ => rw [hVs] at hEmpty; cases hEmpty
  | single =>
    let ⟨vd₀, hv0Get, hLen1, hCompLen, hFieldDecls⟩ := s3d_compDecls_single ctx hLay
    have hvZero : v = 0 := by
      have hvLt1 : v < 1 := by rw [← hLen1]; exact getElem?_some_lt hvGet
      cases v with
      | zero => rfl
      | succ v' => exact False.elim (Nat.not_lt_zero v' (Nat.lt_of_succ_lt_succ hvLt1))
    subst hvZero
    rw [hv0Get] at hvGet; injection hvGet with hvdEq; subst hvdEq
    let ⟨hDeclPay, hDeclScr⟩ := hFieldDecls f fTy hfGet
    rw [hLay, hv0Get] at hBbTgtStmts; dsimp at hBbTgtStmts
    let fSlot := base + 2 + f
    let scr := base + 2 + vd₀.fields.length + f
    let stScrLive : EnumStmt := .baseStmt (.storageLive scr)
    let stScrAss : EnumStmt := .baseStmt (.assign { localId := scr, projection := [] } rval)
    let stMove : EnumStmt := .baseStmt (.assign { localId := fSlot, projection := [] }
      (.use (.move { localId := scr, projection := [] })))
    have hStScr : bbTgt.statements =
        preStmts ++ stScrLive :: stScrAss :: (mkLivenessCheckStmt base :: stMove :: postStmts) := by
      rw [hBbTgtStmts, List.append_assoc]; rfl
    have hScrGeNonScr : base + nonScratchCompCount ctx.ed ≤ scr := by
      unfold nonScratchCompCount; rw [hLay]; dsimp; rw [hv0Get]
      dsimp [scr, base]
      rw [Nat.add_assoc ctx.body.locals.length 2 vd₀.fields.length]
      exact Nat.le_add_right _ f
    have hScrLtLen : scr < f₂.locals.length := by
      rw [hMatch.1, hCompLen]
      dsimp [scr, base]
      rw [← Nat.add_assoc ctx.body.locals.length (2 + vd₀.fields.length) vd₀.fields.length,
          ← Nat.add_assoc ctx.body.locals.length 2 vd₀.fields.length]
      exact Nat.add_lt_add_left hfLt _
    let ⟨hScrErr, hScrOk⟩ := s3d2_exec_scrLiveAndAssign (cm := cm) ctx hF2Idx hB2 hBB2
      hDeclScr hScrGeNonScr hScrLtLen hStScr hRvBnd hRvNoM hPre hSl1 hMatch
    cases hEvRv : evalEnumBaseRvalue ctx.body.locals f₁.locals fTy rval with
    | error fk =>
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.assignField plan.enumLocal 0 f rval) = .fault fk := by
        unfold evalEnumStmt; dsimp
        rw [hRvNoM]; dsimp
        rw [ctx.hEnumDecl]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [hv0Get]; dsimp
        rw [hfGet]; dsimp; rw [hEvRv]
      let ⟨sF, hRF, hEvF⟩ := hScrErr fk hEvRv
      exact simFaultR hEv1 hRF hEvF
    | ok pr =>
      cases pr with
      | mk val s1Mid =>
        let ⟨hChkErr, hChkOk⟩ := hScrOk val s1Mid hEvRv
        cases hChkV : checkVal val fTy with
        | false =>
          have hSl1Mid : Trusted.MirSemantics.getElem? s1Mid plan.enumLocal = some sl :=
            (s3d_evalEnumBaseRvalue_preserves_enumLocal hRvNoM hEvRv).trans hSl1
          have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
              (.assignField plan.enumLocal 0 f rval) = .fault .unsupported := by
            unfold evalEnumStmt writeAdtField; dsimp
            rw [hRvNoM]; dsimp
            rw [ctx.hEnumDecl]; dsimp
            rw [ctx.hEdGet]; dsimp
            rw [hv0Get]; dsimp
            rw [hfGet]; dsimp; rw [hEvRv]; dsimp
            rw [hSl1Mid]; dsimp
            rw [ctx.hEdAdm, hChkV]; rfl
          let ⟨sF, hRF, hEvF⟩ := hChkErr hChkV
          exact simFaultR hEv1 hRF hEvF
        | true =>
          let ⟨s2Mid, hR2, hSl1Mid, hPreMid, hMatchMid, hScrVal⟩ := hChkOk hChkV
          refine simStepResult_prepend_reachesN hR2 ?_
          let pre2 := preStmts ++ [stScrLive, stScrAss]
          have hPre2Len : pre2.length = preStmts.length + 2 :=
            list_append_length preStmts [stScrLive, stScrAss]
          have hStLive : bbTgt.statements = pre2 ++ (mkLivenessCheckStmt base) :: (stMove :: postStmts) := by
            dsimp [pre2]; rw [hStScr]; change preStmts ++ ([_, _] ++ _) = _; rw [← List.append_assoc]
          cases sl with
          | baseSlot _ => exact False.elim hMatchMid.2
          | liveEmpty => rw [hMatchMid.2.1] at hLay; cases hLay
          | liveDirect _ _ => let ⟨_, _, hL, _⟩ := hMatchMid.2; rw [hL] at hLay; cases hLay
          | liveNiche _ _ =>
            let ⟨_, _, _, _, _, _, _, _, _, hL, _⟩ := hMatchMid.2; rw [hL] at hLay; cases hLay
          | enumDead =>
            have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
                (.assignField plan.enumLocal 0 f rval) = .fault .undefined := by
              unfold evalEnumStmt writeAdtField; dsimp
              rw [hRvNoM]; dsimp
              rw [ctx.hEnumDecl]; dsimp
              rw [ctx.hEdGet]; dsimp
              rw [hv0Get]; dsimp
              rw [hfGet]; dsimp; rw [hEvRv]; dsimp
              rw [hSl1Mid]; dsimp
              rw [ctx.hEdAdm, hChkV]; rfl
            have hEv3 : evalStepEnum pOut 0
                { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid }],
                  callerMem := cm } = .fault .undefined :=
              (stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid })
                hB2 hBB2 hStLive hPre2Len.symm).trans
                ((hStepEqDefs _ cm _).trans (eval_mkLivenessCheckStmt_dead hDeclLive hMatchMid.2))
            exact simFault0 hEv1 hEv3
          | liveSingle fs =>
            let ⟨_, vd₀', hv0', hfsLen, hLiveSlot, hFsAt⟩ := hMatchMid.2
            rw [hv0Get] at hv0'; injection hv0' with hvEq'; subst hvEq'
            have hStep3 : evalStepEnum pOut 0
                { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid }],
                  callerMem := cm } =
                .step { frames := [{ f₂ with stmtIdx := preStmts.length + 3, locals := s2Mid }],
                        callerMem := cm } := by
              rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid })
                    hB2 hBB2 hStLive hPre2Len.symm,
                  hStepEqDefs, eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot]
            refine simStepResult_prepend_step hStep3 ?_
            let pre3 := pre2 ++ [mkLivenessCheckStmt base]
            have hPre3Len : pre3.length = preStmts.length + 3 := by
              dsimp [pre3]; rw [list_append_length, hPre2Len]; rfl
            have hStMv : bbTgt.statements = pre3 ++ stMove :: postStmts := by
              dsimp [pre3]; rw [hStLive]; change pre2 ++ ([_] ++ _) = _; rw [← List.append_assoc]
            let ⟨fs', hSetFs⟩ := setElem?_some_of_lt fs f (some val)
              (by rw [hfsLen]; exact hfLt)
            let ⟨s1End, hSet1End⟩ := setElem?_some_of_lt s1Mid plan.enumLocal
              (.liveSingle fs') (getElem?_some_lt hSl1Mid)
            have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
                (.assignField plan.enumLocal 0 f rval) =
                .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := s1End }],
                        callerMem := cm } := by
              unfold evalEnumStmt writeAdtField; dsimp
              rw [hRvNoM]; dsimp
              rw [ctx.hEnumDecl]; dsimp
              rw [ctx.hEdGet]; dsimp
              rw [hv0Get]; dsimp
              rw [hfGet]; dsimp; rw [hEvRv]; dsimp
              rw [hSl1Mid]; dsimp
              rw [ctx.hEdAdm, hChkV]; dsimp
              change (match (match setElem? fs f (some val) with
                  | some fs' => Except.ok (EnumSlot.liveSingle fs')
                  | none => Except.error FaultKind.unsupported) with
                | .error k => StepResult.fault k
                | .ok sl' => match setElem? s1Mid plan.enumLocal sl' with
                  | some s' => StepResult.step ({ frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := s' }], callerMem := cm } : EnumState)
                  | none => StepResult.fault FaultKind.unsupported) = _
              rw [hSetFs]; dsimp; rw [hSet1End]
            let ⟨ovOld, hGetFsOld⟩ := getElem?_some_of_lt fs f (by rw [hfsLen]; exact hfLt)
            have hPaySlotOld : Trusted.MirSemantics.getElem? s2Mid fSlot =
                some (.baseSlot (.live ovOld)) := hFsAt f ovOld hGetFsOld
            have hPayLtScr : fSlot < scr := by
              dsimp [fSlot, scr]
              exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hfLt (base + 2))
                (Nat.le_add_right _ f)
            let ⟨s2Mv, hSetMv⟩ := setElem?_some_of_lt s2Mid scr
              (.baseSlot (liveUninitSlot fTy)) (getElem?_some_lt hScrVal)
            have hPayAfterMv : Trusted.MirSemantics.getElem? s2Mv fSlot =
                some (.baseSlot (.live ovOld)) := by
              rw [setElem?_getElem?_ne hSetMv (s3d2_ne_of_lt hPayLtScr)]; exact hPaySlotOld
            let ⟨s2End, hSetPay⟩ := setElem?_some_of_lt s2Mv fSlot
              (.baseSlot (.live (some val))) (getElem?_some_lt hPayAfterMv)
            have hStep4 : evalStepEnum pOut 0
                { frames := [{ f₂ with stmtIdx := preStmts.length + 3, locals := s2Mid }],
                  callerMem := cm } =
                .step { frames := [{ f₂ with stmtIdx := preStmts.length + 4, locals := s2End }],
                        callerMem := cm } := by
              rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 3, locals := s2Mid })
                    hB2 hBB2 hStMv hPre3Len.symm, hStepEqDefs]
              dsimp [stMove]
              unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot writeEnumBasePlace
              dsimp
              rw [hDeclPay, hDeclScr, hScrVal]; dsimp
              rw [hSetMv]; dsimp
              rw [mirTy_beq_refl fTy]; dsimp
              rw [hChkV]; dsimp
              rw [hPayAfterMv]; dsimp
              rw [hSetPay]
            have hPreEnd : PrefixSlotsAgree base plan.enumLocal s1End s2End := by
              refine ⟨(setElem?_length hSet1End).trans hPreMid.1,
                      by rw [setElem?_length hSetPay, setElem?_length hSetMv]; exact hPreMid.2.1, ?_⟩
              intro j hjLt hjNe
              have hBaseLePay : base ≤ fSlot := by
                dsimp [fSlot]; rw [Nat.add_assoc]; exact Nat.le_add_right base _
              rw [setElem?_getElem?_ne hSetPay (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt hBaseLePay)),
                  setElem?_getElem?_ne hSetMv (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt (Nat.le_trans hBaseLePay (Nat.le_of_lt hPayLtScr)))),
                  setElem?_getElem?_ne hSet1End hjNe]
              exact hPreMid.2.2 j hjLt hjNe
            have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveSingle fs') s2End := by
              refine ⟨(setElem?_length hSetPay).trans ((setElem?_length hSetMv).trans hMatchMid.1),
                      hLay, vd₀, hv0Get, (setElem?_length hSetFs).trans hfsLen, ?_, ?_⟩
              · have hBLtPay : base < fSlot := by
                  dsimp [fSlot]; rw [Nat.add_assoc]
                  exact Nat.lt_add_of_pos_right (Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) (Nat.le_add_right 2 f))
                rw [setElem?_getElem?_ne hSetPay (s3d2_ne_of_lt hBLtPay),
                    setElem?_getElem?_ne hSetMv (s3d2_ne_of_lt (Nat.lt_trans hBLtPay hPayLtScr))]
                exact hLiveSlot
              · intro fx ovx hfx
                cases hEqF : Nat.beq fx f with
                | true =>
                  have hfxEq : fx = f := nat_beq_eq hEqF; subst hfxEq
                  rw [setElem?_getElem?_same hSetFs] at hfx
                  injection hfx with hovEq; subst hovEq
                  exact setElem?_getElem?_same hSetPay
                | false =>
                  have hfxNe : fx ≠ f := nat_ne_of_beq_false hEqF
                  rw [setElem?_getElem?_ne hSetFs hfxNe] at hfx
                  have hfxLt : fx < vd₀.fields.length := by rw [← hfsLen]; exact getElem?_some_lt hfx
                  have hNePay : base + 2 + fx ≠ fSlot := fun h => hfxNe (Nat.add_left_cancel h)
                  have hLtScr : base + 2 + fx < scr :=
                    Nat.lt_of_lt_of_le (Nat.add_lt_add_left hfxLt (base + 2))
                      (Nat.le_add_right _ f)
                  rw [setElem?_getElem?_ne hSetPay hNePay,
                      setElem?_getElem?_ne hSetMv (s3d2_ne_of_lt hLtScr)]
                  exact hFsAt fx ovx hfx
            have hPost := s3d_mkTargetPostStmtSimRel (cm := cm) ctx hDef1 hDef2 hBB1 hBlkEq hStmt1
              (hF2Idx.trans (congrArg List.length hPreEq)) hPreEnd
              (setElem?_getElem?_same hSet1End) hMatchEnd
              (fun _ _ _ h => by cases h)
            dsimp [lowerEnumStmt] at hPost
            rw [nat_beq_refl] at hPost; dsimp at hPost
            rw [hLay, hv0Get] at hPost; dsimp [List.length] at hPost
            rw [hF2Idx] at hPost
            exact simStep1 hEv1 hStep4 hPost
  | direct tagW tagS =>
    let ⟨hCompLen, _, hFieldDecls⟩ := s3d_compDecls_direct ctx hLay
    let ⟨hDeclPay, hDeclScr⟩ := hFieldDecls v vd f fTy hvGet hfGet
    rw [hLay, hvGet] at hBbTgtStmts; dsimp at hBbTgtStmts
    let allFs := flattenAllVariantFieldTys ctx.ed
    let off := directVariantFieldOffset ctx.ed.variants v + f
    let fSlot := base + 3 + off
    let scr := base + 3 + allFs.length + off
    let stScrLive : EnumStmt := .baseStmt (.storageLive scr)
    let stScrAss : EnumStmt := .baseStmt (.assign { localId := scr, projection := [] } rval)
    let stMove : EnumStmt := .baseStmt (.assign { localId := fSlot, projection := [] }
      (.use (.move { localId := scr, projection := [] })))
    have hStScr : bbTgt.statements =
        preStmts ++ stScrLive :: stScrAss :: (mkLivenessCheckStmt base :: stMove :: postStmts) := by
      rw [hBbTgtStmts, List.append_assoc]; rfl
    have hOffLt : off < allFs.length :=
      Nat.lt_of_lt_of_le (Nat.add_lt_add_left hfLt _)
        (directVariantFieldOffset_bound ctx.ed.variants hvGet)
    have hScrGeNonScr : base + nonScratchCompCount ctx.ed ≤ scr := by
      unfold nonScratchCompCount; rw [hLay]
      dsimp [scr, base, allFs]
      rw [Nat.add_assoc ctx.body.locals.length 3 _]
      exact Nat.le_add_right _ off
    have hScrLtLen : scr < f₂.locals.length := by
      rw [hMatch.1, hCompLen]
      dsimp [scr, base, allFs]
      rw [← Nat.add_assoc ctx.body.locals.length (3 + (flattenAllVariantFieldTys ctx.ed).length) _,
          ← Nat.add_assoc ctx.body.locals.length 3 _]
      exact Nat.add_lt_add_left hOffLt _
    let ⟨hScrErr, hScrOk⟩ := s3d2_exec_scrLiveAndAssign (cm := cm) ctx hF2Idx hB2 hBB2
      hDeclScr hScrGeNonScr hScrLtLen hStScr hRvBnd hRvNoM hPre hSl1 hMatch
    cases hEvRv : evalEnumBaseRvalue ctx.body.locals f₁.locals fTy rval with
    | error fk =>
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.assignField plan.enumLocal v f rval) = .fault fk := by
        unfold evalEnumStmt; dsimp
        rw [hRvNoM]; dsimp
        rw [ctx.hEnumDecl]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [hvGet]; dsimp
        rw [hfGet]; dsimp; rw [hEvRv]
      let ⟨sF, hRF, hEvF⟩ := hScrErr fk hEvRv
      exact simFaultR hEv1 hRF hEvF
    | ok pr =>
      cases pr with
      | mk val s1Mid =>
        let ⟨hChkErr, hChkOk⟩ := hScrOk val s1Mid hEvRv
        cases hChkV : checkVal val fTy with
        | false =>
          have hSl1Mid : Trusted.MirSemantics.getElem? s1Mid plan.enumLocal = some sl :=
            (s3d_evalEnumBaseRvalue_preserves_enumLocal hRvNoM hEvRv).trans hSl1
          have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
              (.assignField plan.enumLocal v f rval) = .fault .unsupported := by
            unfold evalEnumStmt writeAdtField; dsimp
            rw [hRvNoM]; dsimp
            rw [ctx.hEnumDecl]; dsimp
            rw [ctx.hEdGet]; dsimp
            rw [hvGet]; dsimp
            rw [hfGet]; dsimp; rw [hEvRv]; dsimp
            rw [hSl1Mid]; dsimp
            rw [ctx.hEdAdm, hChkV]; rfl
          let ⟨sF, hRF, hEvF⟩ := hChkErr hChkV
          exact simFaultR hEv1 hRF hEvF
        | true =>
          let ⟨s2Mid, hR2, hSl1Mid, hPreMid, hMatchMid, hScrVal⟩ := hChkOk hChkV
          refine simStepResult_prepend_reachesN hR2 ?_
          let pre2 := preStmts ++ [stScrLive, stScrAss]
          have hPre2Len : pre2.length = preStmts.length + 2 :=
            list_append_length preStmts [stScrLive, stScrAss]
          have hStLive : bbTgt.statements = pre2 ++ (mkLivenessCheckStmt base) :: (stMove :: postStmts) := by
            dsimp [pre2]; rw [hStScr]; change preStmts ++ ([_, _] ++ _) = _; rw [← List.append_assoc]
          cases sl with
          | baseSlot _ => exact False.elim hMatchMid.2
          | liveEmpty => rw [hMatchMid.2.1] at hLay; cases hLay
          | liveSingle _ => rw [hMatchMid.2.1] at hLay; cases hLay
          | liveNiche _ _ =>
            let ⟨_, _, _, _, _, _, _, _, _, hL, _⟩ := hMatchMid.2; rw [hL] at hLay; cases hLay
          | enumDead =>
            have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
                (.assignField plan.enumLocal v f rval) = .fault .undefined := by
              unfold evalEnumStmt writeAdtField; dsimp
              rw [hRvNoM]; dsimp
              rw [ctx.hEnumDecl]; dsimp
              rw [ctx.hEdGet]; dsimp
              rw [hvGet]; dsimp
              rw [hfGet]; dsimp; rw [hEvRv]; dsimp
              rw [hSl1Mid]; dsimp
              rw [ctx.hEdAdm, hChkV]; rfl
            have hEv3 : evalStepEnum pOut 0
                { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid }],
                  callerMem := cm } = .fault .undefined :=
              (stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid })
                hB2 hBB2 hStLive hPre2Len.symm).trans
                ((hStepEqDefs _ cm _).trans (eval_mkLivenessCheckStmt_dead hDeclLive hMatchMid.2))
            exact simFault0 hEv1 hEv3
          | liveDirect tag vfs =>
            let ⟨tW', tS', hLay', hvfsLen, hLiveSlot, hTagBnd, hTagSlot, hVfsAt⟩ := hMatchMid.2
            rw [hLay] at hLay'
            injection hLay' with eW eS
            subst eW; subst eS
            have hStep3 : evalStepEnum pOut 0
                { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid }],
                  callerMem := cm } =
                .step { frames := [{ f₂ with stmtIdx := preStmts.length + 3, locals := s2Mid }],
                        callerMem := cm } := by
              rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 2, locals := s2Mid })
                    hB2 hBB2 hStLive hPre2Len.symm,
                  hStepEqDefs, eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot]
