            { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } =
            (match writeEnumBasePlace f₂.locals dst dstTy discVal with
             | .error k => .fault k
             | .ok s2End =>
               .step { frames := [{ f₂ with stmtIdx := preStmts.length + 2, locals := s2End }],
                       callerMem := cm }) := by
          rw [stepAtStmt (f := { f₂ with stmtIdx := preStmts.length + 1 }) hB2 hBB2 hSt2 hPre1Len.symm,
