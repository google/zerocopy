          rw [stepAtStmt hB2 hBB2 hSt1 hF2Idx, hStepEqDefs,
              eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
        have hSt2 : bbTgt.statements =
            (preStmts ++ [mkLivenessCheckStmt base]) ++ mkImmediateUbStmt (base + 1) :: postStmts := by
          rw [hSt1]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
        have hPre1Len : (preStmts ++ [mkLivenessCheckStmt base]).length = preStmts.length + 1 :=
