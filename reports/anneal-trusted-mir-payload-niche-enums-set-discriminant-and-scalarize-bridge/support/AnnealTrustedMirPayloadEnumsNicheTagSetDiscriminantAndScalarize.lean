/-! ### Part A: `BitVec 128`, `truncateBits`, `addTruncBits`, `subTruncBits`, & Modular `WrappingRange128` Interval Algebra -/

private theorem if_true_of_prop {α : Type} {P : Prop} [d : Decidable P] (h : P) (x y : α) :
    (if P then x else y) = x := by
  cases d with
  | isFalse hn => exact False.elim (hn h)
  | isTrue _ => rfl

private theorem if_false_of_not_prop {α : Type} {P : Prop} [d : Decidable P] (hn : ¬ P) (x y : α) :
    (if P then x else y) = y := by
  cases d with
  | isFalse _ => rfl
  | isTrue hp => exact False.elim (hn hp)

private theorem nat_mod_eq_of_lt {x y : Nat} (h : x < y) : Nat.mod x y = x :=
  Nat.mod_eq_of_lt h

private theorem nat_mod_lt (x : Nat) {y : Nat} (h : 0 < y) : Nat.mod x y < y :=
  Nat.mod_lt x h

private theorem nat_le_or_gt (a b : Nat) : a ≤ b ∨ b < a :=
  match Nat.lt_or_ge b a with
  | .inl h => .inr h
  | .inr h => .inl h

private theorem nat_le_sub_of_add_le' {a b c : Nat} (h : a + b ≤ c) : b ≤ c - a := by
  have h1 := Nat.sub_le_sub_right h a
  rw [Nat.add_sub_cancel_left] at h1
  exact h1

private theorem nat_sub_add_comm {a b c : Nat} (h : b ≤ a) : a - b + c = a + c - b := by
  have h1 : a - b + c + b = a + c := by
    rw [Nat.add_right_comm, Nat.sub_add_cancel h]
  have h2 : a - b + c + b - b = a + c - b := congrArg (fun x => x - b) h1
  rw [Nat.add_sub_cancel] at h2
  exact h2

private theorem nat_sub_eq_of_add_eq {a b c : Nat} (h : a + b = c) : c - a = b := by
  rw [← h, Nat.add_sub_cancel_left]

private theorem nat_sub_right_comm (a b c : Nat) : a - b - c = a - c - b := by
  rw [Nat.sub_sub, Nat.add_comm b c, ← Nat.sub_sub]

private theorem intWidth_bitWidth_sub_add (w : IntWidth) :
    w.bitWidth - 1 - 0 + 1 = w.bitWidth := by
  cases w <;> rfl

private theorem intWidth_pow2_pos (w : IntWidth) : 0 < Nat.pow 2 w.bitWidth := by
  cases w <;> decide

private theorem intWidth_pow2_ge_256 (w : IntWidth) : 256 ≤ Nat.pow 2 w.bitWidth := by
  cases w <;> decide

private theorem intWidth_pow2_le_pow2_128 (w : IntWidth) :
    Nat.pow 2 w.bitWidth ≤ Nat.pow 2 128 := by
  cases w <;> decide

private theorem intWidth_pow2_dvd_128 (w : IntWidth) :
    ∃ q, 1 ≤ q ∧ Nat.pow 2 128 = Nat.pow 2 w.bitWidth * q := by
  cases w with
  | i8 => exact ⟨Nat.pow 2 120, by decide, rfl⟩
  | i16 => exact ⟨Nat.pow 2 112, by decide, rfl⟩
  | i32 => exact ⟨Nat.pow 2 96, by decide, rfl⟩
  | i64 => exact ⟨Nat.pow 2 64, by decide, rfl⟩
  | isize => exact ⟨Nat.pow 2 64, by decide, rfl⟩
  | i128 => exact ⟨1, by decide, rfl⟩

private theorem nat_add_mod_self_right (a m : Nat) :
    Nat.mod (a + m) m = Nat.mod a m := by
  cases m with
  | zero => rfl
  | succ m' =>
    have hEq : Nat.mod (a + Nat.succ m') (Nat.succ m') =
        if 0 < Nat.succ m' ∧ Nat.succ m' ≤ a + Nat.succ m' then
          Nat.mod (a + Nat.succ m' - Nat.succ m') (Nat.succ m')
        else a + Nat.succ m' := Nat.mod_eq_ite (a + Nat.succ m') (Nat.succ m')
    rw [hEq, if_true_of_prop ⟨Nat.zero_lt_succ m', Nat.le_add_left (Nat.succ m') a⟩,
        Nat.add_sub_cancel]

private theorem nat_mul_add_mod (m k r : Nat) :
    Nat.mod (m * k + r) m = Nat.mod r m := by
  induction k with
  | zero => rw [Nat.mul_zero, Nat.zero_add]
  | succ k' ih =>
    rw [Nat.mul_succ, Nat.add_right_comm, nat_add_mod_self_right]
    exact ih

private theorem nat_mod_mod_of_mul (x m q : Nat) :
    Nat.mod (Nat.mod x (m * q)) m = Nat.mod x m := by
  have hDiv : (m * q) * Nat.div x (m * q) + Nat.mod x (m * q) = x :=
    Nat.div_add_mod x (m * q)
  have hMod : Nat.mod (m * (q * Nat.div x (m * q)) + Nat.mod x (m * q)) m =
      Nat.mod (Nat.mod x (m * q)) m :=
    nat_mul_add_mod m (q * Nat.div x (m * q)) (Nat.mod x (m * q))
  rw [← Nat.mul_assoc, hDiv] at hMod
  exact hMod.symm

private theorem bitvec_eq_of_toNat_eq {n : Nat} {a b : BitVec n}
    (h : a.toNat = b.toNat) : a = b := by
  cases a with
  | ofFin fa =>
    cases b with
    | ofFin fb =>
      exact congrArg BitVec.ofFin (Fin.eq_of_val_eq h)

private theorem bitvec_beq_refl {n : Nat} (a : BitVec n) : (a == a) = true := by
  cases h : (a == a) with
  | true => rfl
  | false =>
    have hNe : a ≠ a := fun heq => by
      have hT : (a == a) = true := beq_iff_eq.mpr heq
      rw [h] at hT; cases hT
    exact False.elim (hNe rfl)

private theorem bitvec_bne_false_of_eq {n : Nat} {a b : BitVec n} (h : a = b) :
    (a != b) = false := by
  subst h
  unfold bne
  rw [bitvec_beq_refl]
  rfl

private theorem bitvec_bne_true_of_ne {n : Nat} {a b : BitVec n} (h : a ≠ b) :
    (a != b) = true := by
  unfold bne
  cases hb : (a == b) with
  | false => rfl
  | true => exact False.elim (h (eq_of_beq hb))

private theorem bitvec_ofNat_toNat (n x : Nat) :
    (BitVec.ofNat n x).toNat = Nat.mod x (Nat.pow 2 n) := rfl

private theorem bv_add_toNat (a b : BitVec 128) :
    (a + b).toNat = Nat.mod (a.toNat + b.toNat) (Nat.pow 2 128) := rfl

private theorem bv_sub_toNat (a b : BitVec 128) :
    (a - b).toNat = Nat.mod ((Nat.pow 2 128 - b.toNat) + a.toNat) (Nat.pow 2 128) := rfl

private theorem nat_shiftRight_zero_eq (n : Nat) : Nat.shiftRight n 0 = n := rfl

private theorem truncateBits_toNat (w : IntWidth) (bv : BitVec 128) :
    (truncateBits w bv).toNat = Nat.mod bv.toNat (Nat.pow 2 w.bitWidth) := by
  unfold truncateBits bvZeroExtend bvExtractLsb bvExtractLsb'
  have hLen := intWidth_bitWidth_sub_add w
  have hModLt : Nat.mod bv.toNat (Nat.pow 2 w.bitWidth) < Nat.pow 2 128 :=
    Nat.lt_of_lt_of_le (Nat.mod_lt bv.toNat (intWidth_pow2_pos w))
      (intWidth_pow2_le_pow2_128 w)
  have hInner : (BitVec.ofNat (w.bitWidth - 1 - 0 + 1) (Nat.shiftRight bv.toNat 0)).toNat =
      Nat.mod bv.toNat (Nat.pow 2 w.bitWidth) := by
    rw [bitvec_ofNat_toNat, nat_shiftRight_zero_eq, hLen]
  rw [bitvec_ofNat_toNat, hInner]
  exact nat_mod_eq_of_lt hModLt

private theorem truncateBits_ofNat_toNat (w : IntWidth) (x : Nat) :
    (truncateBits w (BitVec.ofNat 128 x)).toNat = Nat.mod x (Nat.pow 2 w.bitWidth) := by
  rw [truncateBits_toNat, bitvec_ofNat_toNat]
  let ⟨q, _, hq⟩ := intWidth_pow2_dvd_128 w
  rw [hq]
  exact nat_mod_mod_of_mul x (Nat.pow 2 w.bitWidth) q

private theorem truncateBits_idem (w : IntWidth) (bv : BitVec 128) :
    truncateBits w (truncateBits w bv) = truncateBits w bv := by
  apply bitvec_eq_of_toNat_eq
  rw [truncateBits_toNat, truncateBits_toNat]
  exact nat_mod_eq_of_lt (Nat.mod_lt bv.toNat (intWidth_pow2_pos w))

private theorem scalarVal_wf_truncateBits (w : IntWidth) (s : Bool) (bv : BitVec 128) :
    ScalarVal.wf ⟨w, s, truncateBits w bv⟩ = true := by
  unfold ScalarVal.wf
  dsimp
  rw [truncateBits_idem w bv]
  exact bitvec_beq_refl _

private theorem toNat_lt_of_truncateBits_eq {w : IntWidth} {bv : BitVec 128}
    (h : truncateBits w bv = bv) :
    bv.toNat < Nat.pow 2 w.bitWidth := by
  rw [← h, truncateBits_toNat]
  exact Nat.mod_lt bv.toNat (intWidth_pow2_pos w)

private theorem truncateBits_eq_of_toNat_lt {w : IntWidth} {bv : BitVec 128}
    (h : bv.toNat < Nat.pow 2 w.bitWidth) :
    truncateBits w bv = bv := by
  apply bitvec_eq_of_toNat_eq
  rw [truncateBits_toNat]
  exact nat_mod_eq_of_lt h

private theorem maxUnsignedBits_toNat (w : IntWidth) :
    (maxUnsignedBits w).toNat = Nat.pow 2 w.bitWidth - 1 := by
  unfold maxUnsignedBits
  rw [bitvec_ofNat_toNat]
  have hLt : Nat.pow 2 w.bitWidth - 1 < Nat.pow 2 128 :=
    Nat.lt_of_lt_of_le (Nat.sub_lt (intWidth_pow2_pos w) (by decide : 0 < 1))
      (intWidth_pow2_le_pow2_128 w)
  exact nat_mod_eq_of_lt hLt

private theorem addTruncBits_toNat (w : IntWidth) (a b : BitVec 128) :
    (addTruncBits w a b).toNat =
      Nat.mod (a.toNat + b.toNat) (Nat.pow 2 w.bitWidth) := by
  unfold addTruncBits
  rw [truncateBits_toNat, bv_add_toNat]
  let ⟨q, _, hq⟩ := intWidth_pow2_dvd_128 w
  rw [hq]
  exact nat_mod_mod_of_mul (a.toNat + b.toNat) (Nat.pow 2 w.bitWidth) q

private theorem addTruncBits_comm (w : IntWidth) (a b : BitVec 128) :
    addTruncBits w a b = addTruncBits w b a := by
  apply bitvec_eq_of_toNat_eq
  rw [addTruncBits_toNat, addTruncBits_toNat, Nat.add_comm]

private theorem truncateBits_addTruncBits (w : IntWidth) (a b : BitVec 128) :
    truncateBits w (addTruncBits w a b) = addTruncBits w a b :=
  truncateBits_idem w (a + b)

private theorem truncateBits_subTruncBits (w : IntWidth) (a b : BitVec 128) :
    truncateBits w (subTruncBits w a b) = subTruncBits w a b :=
  truncateBits_idem w (a - b)

private theorem nat_mod_sub_of_le_lt_double {x m : Nat} (hGe : m ≤ x) (hLt : x < m + m) :
    Nat.mod x m = x - m := by
  have hSubLt : x - m < m := by
    cases Nat.lt_or_ge (x - m) m with
    | inl h => exact h
    | inr h =>
      have hAdd := Nat.add_le_add_right h m
      rw [Nat.sub_add_cancel hGe] at hAdd
      exact False.elim (Nat.not_lt_of_ge hAdd hLt)
  have hEq : m * 1 + (x - m) = x := by
    rw [Nat.mul_one, Nat.add_comm, Nat.sub_add_cancel hGe]
  rw [← hEq, nat_mul_add_mod, nat_mod_eq_of_lt hSubLt, Nat.mul_one, Nat.add_sub_cancel_left]

/-- Exact modular distance formula for `subTruncBits w a b` when `a, b < 2^w`. -/
private theorem subTruncBits_toNat_of_lt {w : IntWidth} {a b : BitVec 128}
    (ha : a.toNat < Nat.pow 2 w.bitWidth)
    (hb : b.toNat < Nat.pow 2 w.bitWidth) :
    (subTruncBits w a b).toNat =
      if b.toNat ≤ a.toNat then
        a.toNat - b.toNat
      else
        a.toNat + Nat.pow 2 w.bitWidth - b.toNat := by
  unfold subTruncBits
  rw [truncateBits_toNat, bv_sub_toNat]
  let m := Nat.pow 2 w.bitWidth
  let ⟨q, hq1, hq⟩ := intWidth_pow2_dvd_128 w
  change Nat.mod (Nat.mod ((Nat.pow 2 128 - b.toNat) + a.toNat) (Nat.pow 2 128)) m = _
  rw [hq, nat_mod_mod_of_mul]
  have hMq : m * q = m * (q - 1) + m := by
    cases q with
    | zero => cases hq1
    | succ q' =>
      change m * (q' + 1) = m * q' + m
      exact Nat.mul_succ m q'
  have hbLe : b.toNat ≤ m := Nat.le_of_lt hb
  have hSplit : (m * q - b.toNat) + a.toNat = m * (q - 1) + ((m - b.toNat) + a.toNat) := by
    rw [hMq, Nat.add_sub_assoc hbLe, Nat.add_assoc]
  rw [hSplit, nat_mul_add_mod]
  cases nat_le_or_gt b.toNat a.toNat with
  | inl hLe =>
    rw [if_true_of_prop hLe]
    have hSumEq : (m - b.toNat) + a.toNat = m + (a.toNat - b.toNat) := by
      rw [nat_sub_add_comm hbLe, Nat.add_sub_assoc hLe]
    have hDiffLt : a.toNat - b.toNat < m := Nat.lt_of_le_of_lt (Nat.sub_le _ _) ha
    rw [hSumEq, Nat.add_comm m _, nat_add_mod_self_right, nat_mod_eq_of_lt hDiffLt]
  | inr hGt =>
    have hNotLe : ¬ (b.toNat ≤ a.toNat) := Nat.not_le_of_gt hGt
    rw [if_false_of_not_prop hNotLe]
    have hReorder : (m - b.toNat) + a.toNat = a.toNat + m - b.toNat := by
      rw [Nat.add_comm (m - b.toNat) a.toNat, Nat.add_sub_assoc hbLe]
    have hLtM : a.toNat + m - b.toNat < m := by
      have hAddLt : a.toNat + m < b.toNat + m := Nat.add_lt_add_right hGt m
      exact Nat.sub_lt_left_of_lt_add (Nat.le_trans hbLe (Nat.le_add_left m a.toNat)) hAddLt
    rw [hReorder, nat_mod_eq_of_lt hLtM]

private theorem nat_add_mod_left (a b m : Nat) :
    Nat.mod (a + b) m = Nat.mod (Nat.mod a m + b) m := by
  have hDiv : m * Nat.div a m + Nat.mod a m = a := Nat.div_add_mod a m
  have hEq : m * Nat.div a m + (Nat.mod a m + b) = a + b := by
    rw [← Nat.add_assoc, hDiv]
  rw [← hEq, nat_mul_add_mod]

/-- **Master Coordinate-Shift Theorem (`wrappingRangeContains_iff_subTrunc_le`):**
For any width `w` and width-fitting endpoints `r` (`wrappingRangeFitsWidth w r = true`)
and value `x` (`truncateBits w x = x`), `wrappingRangeContains r x = true` holds
iff `(subTruncBits w x r.start).toNat ≤ (subTruncBits w r.end_ r.start).toNat`! -/
private theorem wrappingRangeContains_iff_subTrunc_le {w : IntWidth}
    {r : WrappingRange128} {x : BitVec 128}
    (hFit : wrappingRangeFitsWidth w r = true)
    (hx : truncateBits w x = x) :
    wrappingRangeContains r x = true ↔
      (subTruncBits w x r.start).toNat ≤ (subTruncBits w r.end_ r.start).toNat := by
  unfold wrappingRangeFitsWidth at hFit
  let ⟨hSBeq, hEBeq⟩ := bool_and_true hFit
  have hsLt := toNat_lt_of_truncateBits_eq (eq_of_beq hSBeq)
  have heLt := toNat_lt_of_truncateBits_eq (eq_of_beq hEBeq)
  have hxLt := toNat_lt_of_truncateBits_eq hx
  rw [subTruncBits_toNat_of_lt hxLt hsLt, subTruncBits_toNat_of_lt heLt hsLt]
  unfold wrappingRangeContains
  let S := r.start.toNat
  let E := r.end_.toNat
  let X := x.toNat
  let M := Nat.pow 2 w.bitWidth
  cases hSE : Nat.ble S E with
  | true =>
    have hSELe : S ≤ E := nat_ble_le hSE
    rw [if_true_of_prop hSELe]
    dsimp
    cases nat_le_or_gt S X with
    | inl hSX =>
      rw [if_true_of_prop hSX, nat_le_ble hSX]
      constructor
      · intro hXE
        exact Nat.sub_le_sub_right (nat_ble_le hXE) S
      · intro hSub
        have hXE : X ≤ E := by
          have h1 := Nat.add_le_add_right hSub S
          rw [Nat.sub_add_cancel hSX, Nat.sub_add_cancel hSELe] at h1
          exact h1
        exact nat_le_ble hXE
    | inr hXS =>
      rw [if_false_of_not_prop (Nat.not_le_of_gt hXS), nat_gt_ble_false hXS]
      constructor
      · intro h; cases h
      · intro hSub
        -- X + M - S >= M - S > E - S since E < M!
        have hGeMS : M - S ≤ X + M - S := by
          rw [Nat.add_sub_assoc (Nat.le_of_lt hsLt)]
          exact Nat.le_add_left (M - S) X
        have hGt : E - S < M - S := by
          cases Nat.lt_or_ge (E - S) (M - S) with
          | inl h => exact h
          | inr h =>
            have h1 := Nat.add_le_add_right h S
            rw [Nat.sub_add_cancel (Nat.le_of_lt hsLt), Nat.sub_add_cancel hSELe] at h1
            exact False.elim (Nat.not_lt_of_ge h1 heLt)
        exact False.elim (Nat.not_lt_of_ge (Nat.le_trans hGeMS hSub) hGt)
  | false =>
    have hES : E < S := nat_ble_false_gt hSE
    rw [if_false_of_not_prop (Nat.not_le_of_gt hES)]
    dsimp
    cases nat_le_or_gt S X with
    | inl hSX =>
      rw [if_true_of_prop hSX, nat_le_ble hSX]
      constructor
      · intro _
        -- X - S < M - S <= E + M - S
        have hLtMS : X - S < M - S := by
          cases Nat.lt_or_ge (X - S) (M - S) with
          | inl h => exact h
          | inr h =>
            have h1 := Nat.add_le_add_right h S
            rw [Nat.sub_add_cancel (Nat.le_of_lt hsLt), Nat.sub_add_cancel hSX] at h1
            exact False.elim (Nat.not_lt_of_ge h1 hxLt)
        have hLeEMS : M - S ≤ E + M - S := by
          rw [Nat.add_sub_assoc (Nat.le_of_lt hsLt)]
          exact Nat.le_add_left (M - S) E
        exact Nat.le_of_lt (Nat.lt_of_lt_of_le hLtMS hLeEMS)
      · intro _; rfl
    | inr hXS =>
      rw [if_false_of_not_prop (Nat.not_le_of_gt hXS), nat_gt_ble_false hXS]
      constructor
      · intro hXE
        have hLe : X ≤ E := nat_ble_le hXE
        rw [Nat.add_sub_assoc (Nat.le_of_lt hsLt), Nat.add_sub_assoc (Nat.le_of_lt hsLt)]
        exact Nat.add_le_add_right hLe (M - S)
      · intro hSub
        rw [Nat.add_sub_assoc (Nat.le_of_lt hsLt), Nat.add_sub_assoc (Nat.le_of_lt hsLt)] at hSub
        exact nat_le_ble (Nat.le_of_add_le_add_right hSub)

private theorem wrappingRangeContains_false_iff {w : IntWidth}
    {r : WrappingRange128} {x : BitVec 128}
    (hFit : wrappingRangeFitsWidth w r = true)
    (hx : truncateBits w x = x) :
    wrappingRangeContains r x = false ↔
      (subTruncBits w r.end_ r.start).toNat < (subTruncBits w x r.start).toNat := by
  cases hC : wrappingRangeContains r x with
  | false =>
    constructor
    · intro _
      cases Nat.lt_or_ge (subTruncBits w r.end_ r.start).toNat
          (subTruncBits w x r.start).toNat with
      | inl hLt => exact hLt
      | inr hLe =>
        have hTrue := (wrappingRangeContains_iff_subTrunc_le hFit hx).mpr hLe
        rw [hC] at hTrue; cases hTrue
    · intro _; rfl
  | true =>
    have hLe := (wrappingRangeContains_iff_subTrunc_le hFit hx).mp hC
    constructor
    · intro h; cases h
    · intro hLt; exact False.elim (Nat.not_lt_of_ge hLe hLt)

/-- Round-trip: `(subTruncBits w (addTruncBits w base (ofNat i)) base).toNat = i` when `i < 2^w`. -/
private theorem subTrunc_addTrunc_cancel {w : IntWidth} (base : BitVec 128) {i : Nat}
    (hb : truncateBits w base = base) (hi : i < Nat.pow 2 w.bitWidth) :
    (subTruncBits w (addTruncBits w base (BitVec.ofNat 128 i)) base).toNat = i := by
  let m := Nat.pow 2 w.bitWidth
  have hbLt : base.toNat < m := toNat_lt_of_truncateBits_eq hb
  have hSumLt : (addTruncBits w base (BitVec.ofNat 128 i)).toNat < m := by
    rw [addTruncBits_toNat]; exact Nat.mod_lt _ (intWidth_pow2_pos w)
  rw [subTruncBits_toNat_of_lt hSumLt hbLt, addTruncBits_toNat]
  have hi128 : i < Nat.pow 2 128 :=
    Nat.lt_of_lt_of_le hi (intWidth_pow2_le_pow2_128 w)
  rw [bitvec_ofNat_toNat, nat_mod_eq_of_lt hi128]
  cases Nat.lt_or_ge (base.toNat + i) m with
  | inl hNoWrap =>
    rw [nat_mod_eq_of_lt hNoWrap, if_true_of_prop (Nat.le_add_right base.toNat i),
        Nat.add_sub_cancel_left]
  | inr hWrap =>
    have hLt2 : base.toNat + i < m + m := Nat.add_lt_add hbLt hi
    rw [nat_mod_sub_of_le_lt_double hWrap hLt2]
    have hSubLtBase : base.toNat + i - m < base.toNat := by
      have hAddLt : base.toNat + i < base.toNat + m := Nat.add_lt_add_left hi base.toNat
      rw [Nat.add_comm base.toNat m] at hAddLt
      exact Nat.sub_lt_left_of_lt_add hWrap hAddLt
    rw [if_false_of_not_prop (Nat.not_le_of_gt hSubLtBase)]
    have h1 : base.toNat + i - m + m = base.toNat + i := Nat.sub_add_cancel hWrap
    rw [h1, Nat.add_sub_cancel_left]

/-- Shifting base by `k`: relate `subTruncBits w x (addTruncBits w base k)` to `subTruncBits w x base`. -/
private theorem subTrunc_shift_base {w : IntWidth} (x base : BitVec 128) {k : Nat}
    (hx : truncateBits w x = x) (hb : truncateBits w base = base)
    (hk : k < Nat.pow 2 w.bitWidth) :
    let r := (subTruncBits w x base).toNat
    let m := Nat.pow 2 w.bitWidth
    (subTruncBits w x (addTruncBits w base (BitVec.ofNat 128 k))).toNat =
      if k ≤ r then r - k else r + m - k := by
  dsimp
  let m := Nat.pow 2 w.bitWidth
  let bk := addTruncBits w base (BitVec.ofNat 128 k)
  have hxLt : x.toNat < m := toNat_lt_of_truncateBits_eq hx
  have hbLt : base.toNat < m := toNat_lt_of_truncateBits_eq hb
  have hbkLt : bk.toNat < m := toNat_lt_of_truncateBits_eq (truncateBits_addTruncBits w base _)
  have hk128 : k < Nat.pow 2 128 := Nat.lt_of_lt_of_le hk (intWidth_pow2_le_pow2_128 w)
  have hbkVal : bk.toNat = Nat.mod (base.toNat + k) m := by
    change (addTruncBits w base (BitVec.ofNat 128 k)).toNat = _
    rw [addTruncBits_toNat, bitvec_ofNat_toNat, nat_mod_eq_of_lt hk128]
  rw [subTruncBits_toNat_of_lt hxLt hbkLt, subTruncBits_toNat_of_lt hxLt hbLt, hbkVal]
  cases Nat.lt_or_ge (base.toNat + k) m with
  | inl hNoWrap =>
    rw [nat_mod_eq_of_lt hNoWrap]
    cases nat_le_or_gt base.toNat x.toNat with
    | inl hBX =>
      rw [if_true_of_prop hBX]
      cases nat_le_or_gt (base.toNat + k) x.toNat with
      | inl hBKX =>
        have hkLe : k ≤ x.toNat - base.toNat := nat_le_sub_of_add_le' hBKX
        rw [if_true_of_prop hBKX, if_true_of_prop hkLe, Nat.sub_sub]
      | inr hXBK =>
        have hkGt : ¬ (k ≤ x.toNat - base.toNat) := fun h =>
          Nat.not_le_of_gt hXBK (by
            have h1 := Nat.add_le_add_left h base.toNat
            rw [Nat.add_sub_of_le hBX] at h1
            exact h1)
        rw [if_false_of_not_prop (Nat.not_le_of_gt hXBK), if_false_of_not_prop hkGt]
        -- x + m - (base + k) = x - base + m - k
        have hEq : x.toNat + m - (base.toNat + k) = x.toNat - base.toNat + m - k := by
          rw [← Nat.sub_sub, ← nat_sub_add_comm hBX]
        exact hEq
    | inr hXB =>
      have hXBK : x.toNat < base.toNat + k := Nat.lt_of_lt_of_le hXB (Nat.le_add_right _ _)
      have hkLe : k ≤ x.toNat + m - base.toNat := by
        have hBM : base.toNat + k < m := hNoWrap
        have h1 : base.toNat + k ≤ x.toNat + m :=
          Nat.le_trans (Nat.le_of_lt hBM) (Nat.le_add_left m x.toNat)
        exact nat_le_sub_of_add_le' h1
      rw [if_false_of_not_prop (Nat.not_le_of_gt hXBK),
          if_false_of_not_prop (Nat.not_le_of_gt hXB),
          if_true_of_prop hkLe, Nat.sub_sub]
  | inr hWrap =>
    have hLt2 : base.toNat + k < m + m := Nat.add_lt_add hbLt hk
    rw [nat_mod_sub_of_le_lt_double hWrap hLt2]
    cases nat_le_or_gt base.toNat x.toNat with
    | inl hBX =>
      have hSubLtB : base.toNat + k - m < base.toNat := by
        have h1 : base.toNat + k < base.toNat + m := Nat.add_lt_add_left hk base.toNat
        rw [Nat.add_comm base.toNat m] at h1
        exact Nat.sub_lt_left_of_lt_add hWrap h1
      have hSubLeX : base.toNat + k - m ≤ x.toNat :=
        Nat.le_of_lt (Nat.lt_of_lt_of_le hSubLtB hBX)
      have hkGt : ¬ (k ≤ x.toNat - base.toNat) := fun h => by
        have h1 := Nat.add_le_add_left h base.toNat
        rw [Nat.add_sub_of_le hBX] at h1
        exact Nat.not_lt_of_ge (Nat.le_trans hWrap h1) hxLt
      rw [if_true_of_prop hSubLeX, if_true_of_prop hBX, if_false_of_not_prop hkGt]
      -- x - (base + k - m) = x - base + m - k
      have h1 : (base.toNat + k - m) + (x.toNat - base.toNat + m - k) = x.toNat := by
        have hGeK : k ≤ x.toNat - base.toNat + m :=
          Nat.le_trans (Nat.le_of_lt hk) (Nat.le_add_left m _)
        have h2 : x.toNat - base.toNat + m - k + (base.toNat + k - m) =
            (x.toNat - base.toNat + base.toNat) + k - k := by
          have hSubM : base.toNat + k - m + m = base.toNat + k := Nat.sub_add_cancel hWrap
          have hA : (x.toNat - base.toNat + m - k) + (base.toNat + k - m) =
              ((x.toNat - base.toNat) + (base.toNat + k - m + m)) - k := by
            rw [nat_sub_add_comm hGeK, Nat.add_assoc (x.toNat - base.toNat) m _,
                Nat.add_comm m (base.toNat + k - m)]
          rw [hA, hSubM, Nat.add_assoc (x.toNat - base.toNat) base.toNat k]
        rw [Nat.sub_add_cancel hBX, Nat.add_sub_cancel] at h2
        rw [Nat.add_comm]; exact h2
      exact nat_sub_eq_of_add_eq h1
    | inr hXB =>
      rw [if_false_of_not_prop (Nat.not_le_of_gt hXB)]
      cases nat_le_or_gt (base.toNat + k - m) x.toNat with
      | inl hSubLeX =>
        have hkLe : k ≤ x.toNat + m - base.toNat := by
          have h1 := Nat.add_le_add_right hSubLeX m
          rw [Nat.sub_add_cancel hWrap] at h1
          exact nat_le_sub_of_add_le' h1
        rw [if_true_of_prop hSubLeX, if_true_of_prop hkLe]
        have h1 : (base.toNat + k - m) + (x.toNat + m - base.toNat - k) = x.toNat := by
          have h2 := Nat.sub_add_cancel hkLe
          have h3 : (x.toNat + m - base.toNat - k) + k + base.toNat = x.toNat + m := by
            rw [h2, Nat.sub_add_cancel (Nat.le_trans (Nat.le_of_lt hbLt) (Nat.le_add_left m x.toNat))]
          have h4 : (base.toNat + k - m) + (x.toNat + m - base.toNat - k) + m = x.toNat + m := by
            rw [Nat.add_right_comm, Nat.sub_add_cancel hWrap,
                Nat.add_comm (base.toNat + k) _, ← Nat.add_assoc,
                Nat.add_right_comm (x.toNat + m - base.toNat - k) base.toNat k]
            exact h3
          exact Nat.add_right_cancel h4
        exact nat_sub_eq_of_add_eq h1
      | inr hXSub =>
        have hkGt : ¬ (k ≤ x.toNat + m - base.toNat) := fun h => by
          have h1 := Nat.add_le_add_left h base.toNat
          rw [Nat.add_sub_of_le (Nat.le_trans (Nat.le_of_lt hbLt) (Nat.le_add_left m x.toNat))] at h1
          have h2 : base.toNat + k - m ≤ x.toNat := Nat.sub_le_of_le_add h1
          exact Nat.not_le_of_gt hXSub h2
        rw [if_false_of_not_prop (Nat.not_le_of_gt hXSub), if_false_of_not_prop hkGt]
        have hSubLtM : base.toNat + k - m < m := by
          exact Nat.sub_lt_left_of_lt_add hWrap hLt2
        have h1 : (base.toNat + k - m) + (x.toNat + m - base.toNat + m - k) = x.toNat + m := by
          have hGeB : base.toNat ≤ x.toNat + m :=
            Nat.le_trans (Nat.le_of_lt hbLt) (Nat.le_add_left m x.toNat)
          have hGeK : k ≤ x.toNat + m - base.toNat + m :=
            Nat.le_trans (Nat.le_of_lt hk) (Nat.le_add_left m _)
          have h2 : (base.toNat + k - m) + (x.toNat + m - base.toNat + m - k) + m =
              x.toNat + m + m := by
            rw [Nat.add_right_comm, Nat.sub_add_cancel hWrap,
                Nat.add_comm (base.toNat + k) _,
                nat_sub_add_comm hGeK,
                ← Nat.add_assoc (x.toNat + m - base.toNat + m) base.toNat k,
                Nat.add_sub_cancel,
                Nat.add_right_comm (x.toNat + m - base.toNat) m base.toNat,
                Nat.sub_add_cancel hGeB]
          exact Nat.add_right_cancel h2
        exact nat_sub_eq_of_add_eq h1

private theorem checkNicheTagsDisjoint_at {tagW : IntWidth} {nStartBits : BitVec 128}
    {tagRange uRange : WrappingRange128} :
    ∀ {k i : Nat},
      checkNicheTagsDisjoint tagW nStartBits tagRange uRange k = true →
      i < k →
      let t := addTruncBits tagW nStartBits (BitVec.ofNat 128 i)
      wrappingRangeContains tagRange t = true ∧
        wrappingRangeContains uRange t = false
  | 0, _, _, hi => False.elim (Nat.not_lt_zero _ hi)
  | k' + 1, i, h, hi => by
    unfold checkNicheTagsDisjoint at h
    let ⟨h12, hRest⟩ := bool_and_true h
    let ⟨hTag, hNotU⟩ := bool_and_true h12
    cases Nat.eq_or_lt_of_le (Nat.le_of_lt_succ hi) with
    | inl hEq =>
      subst hEq
      exact ⟨hTag, bool_not_true hNotU⟩
    | inr hLt =>
      exact checkNicheTagsDisjoint_at hRest hLt

/-- Extract all static `.niche` invariants from `adtEnumDefAdmitted ed = true`. -/
private theorem adtEnumDefAdmitted_niche_inv {ed : AdtEnumDef} {tagW : IntWidth}
    {untagged nStart nLast : Nat} {nStartBits : BitVec 128}
    {tagRange : WrappingRange128} {nicheField : Nat} {uRange : WrappingRange128}
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .niche tagW untagged nStart nLast nStartBits
      tagRange nicheField uRange) :
    nStart ≤ nLast ∧
    nLast < ed.variants.length ∧
    untagged < ed.variants.length ∧
    ¬ (nStart ≤ untagged ∧ untagged ≤ nLast) ∧
    (∃ uVd, Trusted.MirSemantics.getElem? ed.variants untagged = some uVd ∧
      variantIsUninhabited uVd = false) ∧
    checkNicheRangePartition tagW (nLast - nStart + 1) nStartBits tagRange uRange = true := by
  unfold adtEnumDefAdmitted at hAdm
  rw [hLay] at hAdm
  dsimp at hAdm
  let ⟨_, hNiche⟩ := bool_and_true hAdm
  let ⟨h1_8, hPart⟩ := bool_and_true hNiche
  let ⟨h1_7, hUVdCheck⟩ := bool_and_true h1_8
  let ⟨h1_6, _⟩ := bool_and_true h1_7
  let ⟨h1_5, _⟩ := bool_and_true h1_6
  let ⟨h1_4, hNotMid⟩ := bool_and_true h1_5
  let ⟨h1_3, hUntLt⟩ := bool_and_true h1_4
  let ⟨h1_2, hLastLt⟩ := bool_and_true h1_3
  let ⟨_, hLe⟩ := bool_and_true h1_2
  have hNoMidProp : ¬ (nStart ≤ untagged ∧ untagged ≤ nLast) := by
    intro ⟨hA, hB⟩
    rw [nat_le_ble hA, nat_le_ble hB] at hNotMid
    cases hNotMid
  have hUVd : ∃ uVd, Trusted.MirSemantics.getElem? ed.variants untagged = some uVd ∧
      variantIsUninhabited uVd = false := by
    cases hG : Trusted.MirSemantics.getElem? ed.variants untagged with
    | none => rw [hG] at hUVdCheck; cases hUVdCheck
    | some uVd =>
      rw [hG] at hUVdCheck
      dsimp at hUVdCheck
      let ⟨hNotUninh, _⟩ := bool_and_true hUVdCheck
      exact ⟨uVd, rfl, bool_not_true hNotUninh⟩
  exact ⟨nat_ble_le hLe, nat_blt_lt hLastLt, nat_blt_lt hUntLt,
    hNoMidProp, hUVd, hPart⟩

/-- Exact modular partition theorem from `checkNicheRangePartition = true`. -/
private theorem nicheRangePartition_iff {tagW : IntWidth} {k : Nat}
    {nStartBits : BitVec 128} {tagRange uRange : WrappingRange128}
    (hPart : checkNicheRangePartition tagW k nStartBits tagRange uRange = true)
    (bits : BitVec 128) (hBits : truncateBits tagW bits = bits) :
    ((wrappingRangeContains tagRange bits = true ↔
        (Nat.ble (subTruncBits tagW bits nStartBits).toNat (k - 1) = true ∨
          wrappingRangeContains uRange bits = true)) ∧
     ¬ (Nat.ble (subTruncBits tagW bits nStartBits).toNat (k - 1) = true ∧
          wrappingRangeContains uRange bits = true)) := by
  unfold checkNicheRangePartition at hPart
  dsimp at hPart
  let m := Nat.pow 2 tagW.bitWidth
  have hmGe256 : 256 ≤ m := intWidth_pow2_ge_256 tagW
  cases hGuard1 : (Nat.beq k 0 || !Nat.blt k m || !Nat.ble k 64) with
  | true => rw [hGuard1] at hPart; cases hPart
  | false =>
    rw [hGuard1] at hPart; dsimp at hPart
    let ⟨hG1a, hBle64⟩ := bool_or_false hGuard1
    let ⟨hKNe0B, hBltM⟩ := bool_or_false hG1a
    have hkPos : 1 ≤ k := by
      cases k with
      | zero => cases hKNe0B
      | succ k' => exact Nat.succ_le_succ (Nat.zero_le k')
    have hkLtM : k < m := nat_blt_lt (bool_not_false hBltM)
    cases hGuard2 : (!(truncateBits tagW nStartBits == nStartBits) ||
        !wrappingRangeFitsWidth tagW tagRange ||
        !wrappingRangeFitsWidth tagW uRange) with
    | true => rw [hGuard2] at hPart; cases hPart
    | false =>
      rw [hGuard2] at hPart; dsimp at hPart
      let ⟨hG2a, hUFitB⟩ := bool_or_false hGuard2
      let ⟨hN0B, hTFitB⟩ := bool_or_false hG2a
      have hN0 : truncateBits tagW nStartBits = nStartBits :=
        eq_of_beq (bool_not_false hN0B)
      have hTFit : wrappingRangeFitsWidth tagW tagRange = true :=
        bool_not_false hTFitB
      have hUFit : wrappingRangeFitsWidth tagW uRange = true :=
        bool_not_false hUFitB
      cases hGuard3 : (!checkNicheTagsDisjoint tagW nStartBits tagRange uRange k) with
      | true => rw [hGuard3] at hPart; cases hPart
      | false =>
        rw [hGuard3] at hPart; dsimp at hPart
        have hDisj : checkNicheTagsDisjoint tagW nStartBits tagRange uRange k = true :=
          bool_not_false hGuard3
        have h1LtM : 1 < m := Nat.lt_of_lt_of_le (by decide : 1 < 256) hmGe256
        -- Split across the 3 structural layout cases (`fullCase || nicheBeforeUntagged || untaggedBeforeNiche`)
        cases bool_or_true hPart with
        | inl hLeft =>
          cases bool_or_true hLeft with
          | inl hFull =>
            -- Case 1: Full `tagW` range `[0 ..= m - 1]`
            let ⟨hF123, hF4⟩ := bool_and_true hFull
            let ⟨hF12, hF3⟩ := bool_and_true hF123
            let ⟨hF1, hF2⟩ := bool_and_true hF12
            have hTS : tagRange.start = BitVec.ofNat 128 0 := eq_of_beq hF1
            have hTE : tagRange.end_ = maxUnsignedBits tagW := eq_of_beq hF2
            have hUS : uRange.start = addTruncBits tagW nStartBits (BitVec.ofNat 128 k) := eq_of_beq hF3
            have hUE1 : addTruncBits tagW uRange.end_ (BitVec.ofNat 128 1) = nStartBits := eq_of_beq hF4
            -- `tagRange` contains ALL `tagW`-fitting `bits`!
            have hInTag : wrappingRangeContains tagRange bits = true := by
              rw [wrappingRangeContains_iff_subTrunc_le hTFit hBits]
              have hS0 : tagRange.start.toNat = 0 := by rw [hTS]; rfl
              have hEM1 : tagRange.end_.toNat = m - 1 := by rw [hTE]; exact maxUnsignedBits_toNat tagW
              have hxLt : bits.toNat < m := toNat_lt_of_truncateBits_eq hBits
              have hsLt : tagRange.start.toNat < m := by rw [hS0]; exact intWidth_pow2_pos tagW
              have heLt : tagRange.end_.toNat < m := by
                rw [hEM1]; exact Nat.sub_lt (intWidth_pow2_pos tagW) (by decide : 0 < 1)
              rw [subTruncBits_toNat_of_lt hxLt hsLt, subTruncBits_toNat_of_lt heLt hsLt,
                  hS0, hEM1, if_true_of_prop (Nat.zero_le _), if_true_of_prop (Nat.zero_le _),
                  Nat.sub_zero, Nat.sub_zero]
              exact Nat.le_sub_one_of_lt hxLt
            -- Compute `(subTruncBits tagW uRange.end_ uRange.start).toNat = m - 1 - k`!
            have hUESubN0 : (subTruncBits tagW uRange.end_ nStartBits).toNat = m - 1 := by
              have huELt : uRange.end_.toNat < m := by
                unfold wrappingRangeFitsWidth at hUFit
                exact toNat_lt_of_truncateBits_eq (eq_of_beq (bool_and_true hUFit).2)
              have hSubSelf : (subTruncBits tagW uRange.end_
                  (addTruncBits tagW uRange.end_ (BitVec.ofNat 128 1))).toNat = m - 1 := by
                have hSh := subTrunc_shift_base uRange.end_ uRange.end_
                  (truncateBits_eq_of_toNat_lt huELt) (truncateBits_eq_of_toNat_lt huELt) h1LtM
                dsimp at hSh
                have hZero : (subTruncBits tagW uRange.end_ uRange.end_).toNat = 0 := by
                  rw [subTruncBits_toNat_of_lt huELt huELt, if_true_of_prop (Nat.le_refl _), Nat.sub_self]
                rw [hZero, if_false_of_not_prop (by decide : ¬ (1 ≤ 0))] at hSh
                rw [Nat.zero_add] at hSh
                exact hSh
              rw [← hUE1]
              exact hSubSelf
            have hUSpan : (subTruncBits tagW uRange.end_ uRange.start).toNat = m - 1 - k := by
              have huELt : uRange.end_.toNat < m := by
                unfold wrappingRangeFitsWidth at hUFit
                exact toNat_lt_of_truncateBits_eq (eq_of_beq (bool_and_true hUFit).2)
              rw [hUS]
              have hSh := subTrunc_shift_base uRange.end_ nStartBits
                (truncateBits_eq_of_toNat_lt huELt) hN0 hkLtM
              dsimp at hSh
              rw [hUESubN0, if_true_of_prop (Nat.le_sub_one_of_lt hkLtM)] at hSh
              exact hSh
            let r := (subTruncBits tagW bits nStartBits).toNat
            have hrLtM : r < m := toNat_lt_of_truncateBits_eq (truncateBits_subTruncBits tagW bits nStartBits)
            have hXShift : (subTruncBits tagW bits uRange.start).toNat =
                if k ≤ r then r - k else r + m - k := by
              rw [hUS]
              exact subTrunc_shift_base bits nStartBits hBits hN0 hkLtM
            have hUIff : wrappingRangeContains uRange bits = true ↔ k ≤ r := by
              rw [wrappingRangeContains_iff_subTrunc_le hUFit hBits, hXShift, hUSpan]
              cases nat_le_or_gt k r with
              | inl hkLe =>
                rw [if_true_of_prop hkLe]
                exact ⟨fun _ => hkLe, fun _ => Nat.sub_le_sub_right (Nat.le_sub_one_of_lt hrLtM) k⟩
              | inr hrLtK =>
                rw [if_false_of_not_prop (Nat.not_le_of_gt hrLtK)]
                constructor
                · intro hLe
                  have hGe : m - k ≤ r + m - k := by
                    rw [Nat.add_sub_assoc (Nat.le_of_lt hkLtM)]
                    exact Nat.le_add_left (m - k) r
                  have hSubLt : m - 1 - k < m - k := by
                    have hPosMk : 0 < m - k := Nat.sub_pos_of_lt hkLtM
                    rw [nat_sub_right_comm]
                    exact Nat.sub_lt hPosMk (by decide : 0 < 1)
                  exact False.elim (Nat.not_lt_of_ge (Nat.le_trans hGe hLe) hSubLt)
                · intro hGe; exact False.elim (Nat.not_le_of_gt hrLtK hGe)
            refine ⟨?_, ?_⟩
            · rw [hInTag]
              constructor
              · intro _
                cases Nat.lt_or_ge r k with
                | inl hLt =>
                  exact Or.inl (nat_le_ble (Nat.le_sub_one_of_lt hLt))
                | inr hGe =>
                  exact Or.inr (hUIff.mpr hGe)
              · intro _; rfl
            · intro ⟨hBle, hU⟩
              have hrLe : r ≤ k - 1 := nat_ble_le hBle
              have hkLeR : k ≤ r := hUIff.mp hU
              have hkLeK1 : k ≤ k - 1 := Nat.le_trans hkLeR hrLe
              exact Nat.not_lt_of_ge hkLeK1 (Nat.sub_lt hkPos (by decide : 0 < 1))
          | inr hNBU =>
            -- Case 2: `nicheBeforeUntagged` (`tS = n₀`, `uS = n₀ + k`, `tE = uE`, `uE + 1 ∉ tagRange`)
            let ⟨hN123, hN4⟩ := bool_and_true hNBU
            let ⟨hN12, hN3⟩ := bool_and_true hN123
            let ⟨hN1, hN2⟩ := bool_and_true hN12
            have hTS : tagRange.start = nStartBits := eq_of_beq hN1
            have hUS : uRange.start = addTruncBits tagW nStartBits (BitVec.ofNat 128 k) := eq_of_beq hN2
            have hTE : tagRange.end_ = uRange.end_ := eq_of_beq hN3
            have hAfterOut : wrappingRangeContains tagRange
                (addTruncBits tagW uRange.end_ (BitVec.ofNat 128 1)) = false :=
              bool_not_true hN4
            let L := (subTruncBits tagW tagRange.end_ nStartBits).toNat
            have hLLtM : L < m := toNat_lt_of_truncateBits_eq (truncateBits_subTruncBits tagW _ _)
            -- From `i = k - 1 < k` in `checkNicheTagsDisjoint`: `k - 1 <= L` and `n₀ + (k - 1) ∉ uRange` -> `k <= L`!
            have hLastNiche := checkNicheTagsDisjoint_at hDisj (Nat.sub_lt hkPos (by decide : 0 < 1))
            dsimp at hLastNiche
            have hk1LtM : k - 1 < m := Nat.lt_of_le_of_lt (Nat.sub_le k 1) hkLtM
            have hK1LeL : k - 1 ≤ L := by
              have hInT := (wrappingRangeContains_iff_subTrunc_le hTFit
                (truncateBits_addTruncBits tagW nStartBits _)).mp hLastNiche.1
              rw [hTS, subTrunc_addTrunc_cancel nStartBits hN0 hk1LtM] at hInT
              exact hInT
            have hkLeL : k ≤ L := by
              cases Nat.eq_or_lt_of_le hK1LeL with
              | inr hGt =>
                have hS : (k - 1) + 1 ≤ L := Nat.succ_le_of_lt hGt
                rw [Nat.sub_add_cancel hkPos] at hS
                exact hS
              | inl hEq =>
                -- If `L = k - 1`, then `uRange.end_ = nStartBits + (k - 1)` while `uRange.start = nStartBits + k`,
                -- so `(subTruncBits tagW uRange.end_ uRange.start).toNat = m - 1`, meaning `uRange` contains EVERYTHING,
                -- contradicting `wrappingRangeContains uRange (nStartBits + (k - 1)) = false`!
                have hUE_sub_US : (subTruncBits tagW uRange.end_ uRange.start).toNat = m - 1 := by
                  have huELt : uRange.end_.toNat < m := by
                    unfold wrappingRangeFitsWidth at hUFit
                    exact toNat_lt_of_truncateBits_eq (eq_of_beq (bool_and_true hUFit).2)
                  rw [hUS, ← hTE]
                  have hSh := subTrunc_shift_base tagRange.end_ nStartBits
                    (by rw [hTE]; exact truncateBits_eq_of_toNat_lt huELt) hN0 hkLtM
                  dsimp at hSh
                  change (subTruncBits tagW tagRange.end_ _).toNat =
                    if k ≤ L then L - k else L + m - k at hSh
                  have hNotKLe : ¬ (k ≤ L) := by
                    rw [← hEq]; exact Nat.not_le_of_gt (Nat.sub_lt hkPos (by decide : 0 < 1))
                  rw [if_false_of_not_prop hNotKLe, ← hEq] at hSh
                  -- k - 1 + m - k = m - 1
                  have hArith : k - 1 + m - k = m - 1 := by
                    have h1 : (k - 1 + m - k) + 1 = m := by
                      have hGeK : k ≤ k - 1 + m := by
                        have hA : k ≤ m := Nat.le_of_lt hkLtM
                        exact Nat.le_trans hA (Nat.le_add_left m (k - 1))
                      rw [nat_sub_add_comm hGeK, Nat.add_right_comm (k - 1) m 1,
                          Nat.sub_add_cancel hkPos, Nat.add_comm k m, Nat.add_sub_cancel]
                    have h2 : (m - 1) + 1 = m := Nat.sub_add_cancel (intWidth_pow2_pos tagW)
                    exact Nat.add_right_cancel (h1.trans h2.symm)
                  rw [hArith] at hSh
                  exact hSh
                have hLastInU : wrappingRangeContains uRange
                    (addTruncBits tagW nStartBits (BitVec.ofNat 128 (k - 1))) = true := by
                  rw [wrappingRangeContains_iff_subTrunc_le hUFit (truncateBits_addTruncBits tagW _ _),
                      hUE_sub_US]
                  exact Nat.le_sub_one_of_lt
                    (toNat_lt_of_truncateBits_eq (truncateBits_subTruncBits tagW _ _))
                cases (hLastNiche.2.symm.trans hLastInU)
            -- Now `k <= L < m`! Compute `(subTruncBits tagW uRange.end_ uRange.start).toNat = L - k`:
            have hUSpan : (subTruncBits tagW uRange.end_ uRange.start).toNat = L - k := by
              have huELt : uRange.end_.toNat < m := by
                unfold wrappingRangeFitsWidth at hUFit
                exact toNat_lt_of_truncateBits_eq (eq_of_beq (bool_and_true hUFit).2)
              rw [hUS, ← hTE]
              have hSh := subTrunc_shift_base tagRange.end_ nStartBits
                (by rw [hTE]; exact truncateBits_eq_of_toNat_lt huELt) hN0 hkLtM
              dsimp at hSh
              change _ = if k ≤ L then L - k else L + m - k at hSh
              rw [if_true_of_prop hkLeL] at hSh
              exact hSh
            let r := (subTruncBits tagW bits nStartBits).toNat
            have hrLtM : r < m := toNat_lt_of_truncateBits_eq (truncateBits_subTruncBits tagW bits nStartBits)
            have hTagIff : wrappingRangeContains tagRange bits = true ↔ r ≤ L := by
              rw [wrappingRangeContains_iff_subTrunc_le hTFit hBits, hTS]
            -- Also prove `L < m - 1` from `hAfterOut`:
            have hLLtM1 : L < m - 1 := by
              cases Nat.eq_or_lt_of_le (Nat.le_sub_one_of_lt hLLtM) with
              | inr hLt => exact hLt
              | inl hEqM1 =>
                -- If `L = m - 1`, then `tagRange` contains EVERY `tagW`-bit value, contradicting `hAfterOut`!
                have hAllIn : wrappingRangeContains tagRange
                    (addTruncBits tagW uRange.end_ (BitVec.ofNat 128 1)) = true := by
                  rw [wrappingRangeContains_iff_subTrunc_le hTFit (truncateBits_addTruncBits tagW _ _),
                      hTS]
                  change _ ≤ L
                  rw [hEqM1]
                  exact Nat.le_sub_one_of_lt
                    (toNat_lt_of_truncateBits_eq (truncateBits_subTruncBits tagW _ _))
                rw [hAfterOut] at hAllIn; cases hAllIn
            have hUIff : wrappingRangeContains uRange bits = true ↔ (k ≤ r ∧ r ≤ L) := by
              rw [wrappingRangeContains_iff_subTrunc_le hUFit hBits, hUSpan]
              have hXShift : (subTruncBits tagW bits uRange.start).toNat =
                  if k ≤ r then r - k else r + m - k := by
                rw [hUS]
                exact subTrunc_shift_base bits nStartBits hBits hN0 hkLtM
              rw [hXShift]
              cases nat_le_or_gt k r with
              | inl hkLe =>
                rw [if_true_of_prop hkLe]
                constructor
                · intro hSub
                  have h1 := Nat.add_le_add_right hSub k
                  rw [Nat.sub_add_cancel hkLe, Nat.sub_add_cancel hkLeL] at h1
                  exact ⟨hkLe, h1⟩
                · intro ⟨_, hrL⟩
                  exact Nat.sub_le_sub_right hrL k
              | inr hrLtK =>
                rw [if_false_of_not_prop (Nat.not_le_of_gt hrLtK)]
                constructor
                · intro hSub
                  have hGe : m - k ≤ r + m - k := by
                    rw [Nat.add_sub_assoc (Nat.le_of_lt hkLtM)]
                    exact Nat.le_add_left (m - k) r
                  have hLSubLt : L - k < m - k := by
                    have hLM : L < m := hLLtM
                    cases Nat.lt_or_ge (L - k) (m - k) with
                    | inl h => exact h
                    | inr h =>
                      have h1 := Nat.add_le_add_right h k
                      rw [Nat.sub_add_cancel (Nat.le_of_lt hkLtM), Nat.sub_add_cancel hkLeL] at h1
                      exact False.elim (Nat.not_lt_of_ge h1 hLM)
                  exact False.elim (Nat.not_lt_of_ge (Nat.le_trans hGe hSub) hLSubLt)
                · intro ⟨hkLe, _⟩
                  exact False.elim (Nat.not_le_of_gt hrLtK hkLe)
            refine ⟨?_, ?_⟩
            · rw [hTagIff, hUIff]
              constructor
              · intro hrL
                cases Nat.lt_or_ge r k with
                | inl hLt => exact Or.inl (nat_le_ble (Nat.le_sub_one_of_lt hLt))
                | inr hGe => exact Or.inr ⟨hGe, hrL⟩
              · intro hOr
                cases hOr with
                | inl hBle =>
                  exact Nat.le_trans (nat_ble_le hBle)
                    (Nat.le_trans (Nat.sub_le k 1) hkLeL)
                | inr hAnd => exact hAnd.2
            · intro ⟨hBle, hU⟩
              have hrLe : r ≤ k - 1 := nat_ble_le hBle
              let ⟨hkLeR, _⟩ := hUIff.mp hU
              exact Nat.not_lt_of_ge (Nat.le_trans hkLeR hrLe) (Nat.sub_lt hkPos (by decide : 0 < 1))
        | inr hUBN =>
          -- Case 3: `untaggedBeforeNiche` (`tS = uS`, `n₀ = uE + 1`, `tE = n₀ + (k - 1)`, `n₀ + k ∉ tagRange`)
          let ⟨hU123, hU4⟩ := bool_and_true hUBN
          let ⟨hU12, hU3⟩ := bool_and_true hU123
          let ⟨hU1, hU2⟩ := bool_and_true hU12
          have hTS : tagRange.start = uRange.start := eq_of_beq hU1
          have hN0Eq : nStartBits = addTruncBits tagW uRange.end_ (BitVec.ofNat 128 1) := eq_of_beq hU2
          have hTE : tagRange.end_ = addTruncBits tagW nStartBits (BitVec.ofNat 128 (k - 1)) := eq_of_beq hU3
          have hAfterOut : wrappingRangeContains tagRange
              (addTruncBits tagW nStartBits (BitVec.ofNat 128 k)) = false :=
            bool_not_true hU4
          have huSLt : uRange.start.toNat < m := by
            unfold wrappingRangeFitsWidth at hUFit
            exact toNat_lt_of_truncateBits_eq (eq_of_beq (bool_and_true hUFit).1)
          have huSFit : truncateBits tagW uRange.start = uRange.start :=
            truncateBits_eq_of_toNat_lt huSLt
          let U := (subTruncBits tagW uRange.end_ uRange.start).toNat
          have hULtM : U < m := toNat_lt_of_truncateBits_eq (truncateBits_subTruncBits tagW _ _)
          -- From `i = 0 < k` in `checkNicheTagsDisjoint`: `nStartBits ∉ uRange`, so `U < m - 1`
          -- and `(subTruncBits tagW nStartBits uRange.start).toNat = U + 1`!
          have hFirstNiche := checkNicheTagsDisjoint_at hDisj (Nat.lt_of_lt_of_le (by decide : 0 < 1) hkPos)
          dsimp at hFirstNiche
          have hN0Zero : addTruncBits tagW nStartBits (BitVec.ofNat 128 0) = nStartBits := by
            apply bitvec_eq_of_toNat_eq
            rw [addTruncBits_toNat, bitvec_ofNat_toNat, nat_mod_eq_of_lt (by decide : 0 < Nat.pow 2 128),
                Nat.add_zero]
            exact ((congrArg BitVec.toNat hN0).symm.trans (truncateBits_toNat tagW nStartBits)).symm
          rw [hN0Zero] at hFirstNiche
          have hULtM1 : U < m - 1 := by
            cases Nat.eq_or_lt_of_le (Nat.le_sub_one_of_lt hULtM) with
            | inr hLt => exact hLt
            | inl hEqM1 =>
              have hInU : wrappingRangeContains uRange nStartBits = true := by
                rw [wrappingRangeContains_iff_subTrunc_le hUFit hN0]
                change _ ≤ U
                rw [hEqM1]
                exact Nat.le_sub_one_of_lt (toNat_lt_of_truncateBits_eq (truncateBits_subTruncBits tagW _ _))
              rw [hFirstNiche.2] at hInU; cases hInU
          -- Note `uRange.end_ = addTruncBits tagW uRange.start U`, so `nStartBits = addTruncBits tagW uRange.start (U + 1)`!
          have hUEEq : uRange.end_ = addTruncBits tagW uRange.start (BitVec.ofNat 128 U) := by
            have huELt : uRange.end_.toNat < m := by
              unfold wrappingRangeFitsWidth at hUFit
              exact toNat_lt_of_truncateBits_eq (eq_of_beq (bool_and_true hUFit).2)
            apply bitvec_eq_of_toNat_eq
            rw [addTruncBits_toNat, bitvec_ofNat_toNat,
                nat_mod_eq_of_lt (Nat.lt_of_lt_of_le hULtM (intWidth_pow2_le_pow2_128 tagW))]
            change uRange.end_.toNat = Nat.mod (uRange.start.toNat + (subTruncBits tagW uRange.end_ uRange.start).toNat) m
            rw [subTruncBits_toNat_of_lt huELt huSLt]
            cases nat_le_or_gt uRange.start.toNat uRange.end_.toNat with
            | inl hLe =>
              rw [if_true_of_prop hLe, Nat.add_sub_of_le hLe, nat_mod_eq_of_lt huELt]
            | inr hGt =>
              rw [if_false_of_not_prop (Nat.not_le_of_gt hGt)]
              have hEq : uRange.start.toNat + (uRange.end_.toNat + m - uRange.start.toNat) =
                  m * 1 + uRange.end_.toNat := by
                rw [Nat.add_sub_of_le (Nat.le_trans (Nat.le_of_lt huSLt) (Nat.le_add_left m _)),
                    Nat.mul_one, Nat.add_comm]
              rw [hEq, nat_mul_add_mod, nat_mod_eq_of_lt huELt]
          have hU1LtM : U + 1 < m := Nat.lt_of_lt_of_le (Nat.add_lt_add_right hULtM1 1)
            (by rw [Nat.sub_add_cancel (intWidth_pow2_pos tagW)]; exact Nat.le_refl m)
          have hN0FromUS : nStartBits = addTruncBits tagW uRange.start (BitVec.ofNat 128 (U + 1)) := by
            rw [hN0Eq, hUEEq]
            apply bitvec_eq_of_toNat_eq
            rw [addTruncBits_toNat, addTruncBits_toNat, addTruncBits_toNat]
            have h1 : (BitVec.ofNat 128 1).toNat = 1 := rfl
            have hU128 : (BitVec.ofNat 128 U).toNat = U :=
              nat_mod_eq_of_lt (Nat.lt_of_lt_of_le hULtM (intWidth_pow2_le_pow2_128 tagW))
            have hU1_128 : (BitVec.ofNat 128 (U + 1)).toNat = U + 1 :=
              nat_mod_eq_of_lt (Nat.lt_of_lt_of_le hU1LtM (intWidth_pow2_le_pow2_128 tagW))
            rw [h1, hU128, hU1_128]
            rw [← nat_add_mod_left, Nat.add_assoc]
          -- Show `U + k < m`: every `n₀ + i` (`0 <= i < k`) has `∉ uRange`!
          -- If `U + k >= m`, let `i := m - 1 - U`. Since `U < m - 1`, `i >= 1`, and `U + k >= m` gives `i < k`!
          -- For that `i`, `n₀ + i = uS + (U + 1 + m - 1 - U) = uS + m ≡ uS mod m`, which IS in `uRange` (`sub = 0 <= U`),
          -- contradicting `checkNicheTagsDisjoint`!
          have hUKLtM : U + k < m := by
            cases Nat.lt_or_ge (U + k) m with
            | inl hLt => exact hLt
            | inr hGe =>
              let i := m - 1 - U
              have hiLtK : i < k := by
                have h1 : m - 1 < U + k := Nat.lt_of_lt_of_le
                  (Nat.sub_lt (intWidth_pow2_pos tagW) (by decide : 0 < 1)) hGe
                exact Nat.sub_lt_left_of_lt_add (Nat.le_of_lt hULtM1) h1
              have hiDisj := checkNicheTagsDisjoint_at hDisj hiLtK
              dsimp at hiDisj
              have hiEqUS : addTruncBits tagW nStartBits (BitVec.ofNat 128 i) = uRange.start := by
                rw [hN0FromUS]
                apply bitvec_eq_of_toNat_eq
                rw [addTruncBits_toNat, addTruncBits_toNat]
                have hU1_128 : (BitVec.ofNat 128 (U + 1)).toNat = U + 1 :=
                  nat_mod_eq_of_lt (Nat.lt_of_lt_of_le hU1LtM (intWidth_pow2_le_pow2_128 tagW))
                have hiLtM : i < m := Nat.lt_of_lt_of_le hiLtK (Nat.le_of_lt hkLtM)
                have hi128 : (BitVec.ofNat 128 i).toNat = i :=
                  nat_mod_eq_of_lt (Nat.lt_of_lt_of_le hiLtM (intWidth_pow2_le_pow2_128 tagW))
                rw [hU1_128, hi128]
                have hSumM : (U + 1) + i = m := by
                  change (U + 1) + (m - 1 - U) = m
                  have hSub : U + 1 + (m - 1 - U) = (m - 1 - U + U) + 1 := by
                    rw [Nat.add_comm (U + 1) _, Nat.add_assoc, Nat.add_comm U 1, ← Nat.add_assoc]
                  rw [hSub, Nat.sub_add_cancel (Nat.le_of_lt hULtM1),
                      Nat.sub_add_cancel (intWidth_pow2_pos tagW)]
                rw [← nat_add_mod_left, Nat.add_assoc, hSumM,
                    nat_add_mod_self_right, nat_mod_eq_of_lt huSLt]
              rw [hiEqUS] at hiDisj
              have hUSInU : wrappingRangeContains uRange uRange.start = true := by
                rw [wrappingRangeContains_iff_subTrunc_le hUFit huSFit,
                    subTruncBits_toNat_of_lt huSLt huSLt,
                    if_true_of_prop (Nat.le_refl _), Nat.sub_self]
                exact Nat.zero_le _
              rw [hiDisj.2] at hUSInU; cases hUSInU
          -- Now `U + k < m`! Compute `tagRange.end_` distance from `uRange.start`: `U + 1 + (k - 1) = U + k`!
          have hTESpan : (subTruncBits tagW tagRange.end_ tagRange.start).toNat = U + k := by
            rw [hTS, hTE, hN0FromUS]
            have hComb : addTruncBits tagW (addTruncBits tagW uRange.start (BitVec.ofNat 128 (U + 1)))
                (BitVec.ofNat 128 (k - 1)) =
                addTruncBits tagW uRange.start (BitVec.ofNat 128 (U + k)) := by
              apply bitvec_eq_of_toNat_eq
              rw [addTruncBits_toNat, addTruncBits_toNat, addTruncBits_toNat]
              have hU1_128 : (BitVec.ofNat 128 (U + 1)).toNat = U + 1 :=
                nat_mod_eq_of_lt (Nat.lt_of_lt_of_le hU1LtM (intWidth_pow2_le_pow2_128 tagW))
              have hk1LtM : k - 1 < m := Nat.lt_of_le_of_lt (Nat.sub_le k 1) hkLtM
              have hk1_128 : (BitVec.ofNat 128 (k - 1)).toNat = k - 1 :=
                nat_mod_eq_of_lt (Nat.lt_of_lt_of_le hk1LtM (intWidth_pow2_le_pow2_128 tagW))
              have hUK_128 : (BitVec.ofNat 128 (U + k)).toNat = U + k :=
                nat_mod_eq_of_lt (Nat.lt_of_lt_of_le hUKLtM (intWidth_pow2_le_pow2_128 tagW))
              rw [hU1_128, hk1_128, hUK_128]
              have hSum : (U + 1) + (k - 1) = U + k := by
                rw [Nat.add_assoc, Nat.add_comm 1 (k - 1), Nat.sub_add_cancel hkPos]
              rw [← nat_add_mod_left, Nat.add_assoc, hSum]
            rw [hComb]
            exact subTrunc_addTrunc_cancel uRange.start huSFit hUKLtM
          let d := (subTruncBits tagW bits uRange.start).toNat
          have hdLtM : d < m := toNat_lt_of_truncateBits_eq (truncateBits_subTruncBits tagW bits _)
          have hTagIff : wrappingRangeContains tagRange bits = true ↔ d ≤ U + k := by
            rw [wrappingRangeContains_iff_subTrunc_le hTFit hBits, hTESpan, hTS]
          have hUIff : wrappingRangeContains uRange bits = true ↔ d ≤ U :=
            wrappingRangeContains_iff_subTrunc_le hUFit hBits
          have hNicheIff : Nat.ble (subTruncBits tagW bits nStartBits).toNat (k - 1) = true ↔
              (U + 1 ≤ d ∧ d ≤ U + k) := by
            have hXShift : (subTruncBits tagW bits nStartBits).toNat =
                if U + 1 ≤ d then d - (U + 1) else d + m - (U + 1) := by
              rw [hN0FromUS]
              exact subTrunc_shift_base bits uRange.start hBits huSFit hU1LtM
            rw [hXShift]
            cases nat_le_or_gt (U + 1) d with
            | inl hLe =>
              rw [if_true_of_prop hLe]
              constructor
              · intro hBle
                have hSub : d - (U + 1) ≤ k - 1 := nat_ble_le hBle
                have h1 := Nat.add_le_add_right hSub (U + 1)
                rw [Nat.sub_add_cancel hLe] at h1
                have hRhs : k - 1 + (U + 1) = U + k := by
                  rw [Nat.add_comm (k - 1) (U + 1), Nat.add_assoc, Nat.add_comm 1 (k - 1),
                      Nat.sub_add_cancel hkPos]
                rw [hRhs] at h1
                exact ⟨hLe, h1⟩
              · intro ⟨_, hdUK⟩
                apply nat_le_ble
                have h1 : d ≤ (k - 1) + (U + 1) := by
                  have hRhs : (k - 1) + (U + 1) = U + k := by
                    rw [Nat.add_comm (k - 1) (U + 1), Nat.add_assoc, Nat.add_comm 1 (k - 1),
                        Nat.sub_add_cancel hkPos]
                  rw [hRhs]; exact hdUK
                exact Nat.sub_le_of_le_add h1
            | inr hGt =>
              rw [if_false_of_not_prop (Nat.not_le_of_gt hGt)]
              constructor
              · intro hBle
                have hSub : d + m - (U + 1) ≤ k - 1 := nat_ble_le hBle
                have hGe : m - (U + 1) ≤ d + m - (U + 1) := by
                  rw [Nat.add_sub_assoc (Nat.le_of_lt hU1LtM)]
                  exact Nat.le_add_left _ d
                have hK1Lt : k - 1 < m - (U + 1) := by
                  -- (k - 1) + (U + 1) = U + k < m
                  have hSum : (k - 1) + (U + 1) < m := by
                    rw [Nat.add_comm (k - 1) (U + 1), Nat.add_assoc, Nat.add_comm 1 (k - 1),
                        Nat.sub_add_cancel hkPos]
                    exact hUKLtM
                  exact Nat.lt_sub_of_add_lt hSum
                exact False.elim (Nat.not_lt_of_ge (Nat.le_trans hGe hSub) hK1Lt)
              · intro ⟨hLe, _⟩
                exact False.elim (Nat.not_le_of_gt hGt hLe)
          refine ⟨?_, ?_⟩
          · rw [hTagIff, hNicheIff, hUIff]
            constructor
            · intro hdUK
              cases nat_le_or_gt d U with
              | inl hdU => exact Or.inr hdU
              | inr hdGtU => exact Or.inl ⟨ hdGtU, hdUK ⟩
            · intro hOr
              cases hOr with
              | inl hAnd => exact hAnd.2
              | inr hdU => exact Nat.le_trans hdU (Nat.le_add_right U k)
          · rw [hNicheIff, hUIff]
            intro ⟨⟨hGe, _⟩, hdU⟩
            exact Nat.not_lt_of_ge hdU hGe

/-! ### Proof of Theorem 2 (`wrappingNiche_partition_and_writeOrder_iff_slice2`) -/

private theorem wrappingNiche_partition_and_writeOrder_iff_slice2
    (ed : AdtEnumDef) (tagW : IntWidth)
    (untagged nStart nLast : Nat) (nStartBits : BitVec 128)
    (tagRange : WrappingRange128) (nicheField : Nat)
    (uRange : WrappingRange128)
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .niche tagW untagged nStart nLast nStartBits
      tagRange nicheField uRange) :
    (∀ bits : BitVec 128,
      truncateBits tagW bits = bits →
      ((wrappingRangeContains tagRange bits = true ↔
          (Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = true ∨
            wrappingRangeContains uRange bits = true)) ∧
       ¬ (Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = true ∧
            wrappingRangeContains uRange bits = true))) ∧
    (∀ (v : Nat) (vd : VariantDef) (b : Option (BitVec 128))
        (extras : List (Option Val)),
      nStart ≤ v → v ≤ nLast →
      Trusted.MirSemantics.getElem? ed.variants v = some vd →
      variantIsUninhabited vd = false →
      ∃ bits' : BitVec 128,
        writeAdtDiscriminant ed v (.liveNiche b extras) =
          .ok (.liveNiche (some bits') extras) ∧
        decodeNicheVariant ed tagW untagged nStart nLast nStartBits tagRange
          (some bits') = .ok v) ∧
    (∀ (nicheBits : Option (BitVec 128)) (extras : List (Option Val)),
      ((∃ sl' : EnumSlot,
          writeAdtDiscriminant ed untagged (.liveNiche nicheBits extras) = .ok sl') ↔
        (∃ bits : BitVec 128,
          nicheBits = some bits ∧
          truncateBits tagW bits = bits ∧
          wrappingRangeContains uRange bits = true)) ∧
      ((nicheBits = none ∨
        ∃ bits : BitVec 128,
          nicheBits = some bits ∧
          truncateBits tagW bits = bits ∧
          wrappingRangeContains uRange bits = false) →
        writeAdtDiscriminant ed untagged (.liveNiche nicheBits extras) =
          .error .undefined)) := by
  let ⟨hLe, hLastLt, hUntLt, hNoMid, ⟨uVd, hUVdGet, hUVdInh⟩, hPart⟩ :=
    adtEnumDefAdmitted_niche_inv hAdm hLay
  have hSubK : (nLast - nStart + 1) - 1 = nLast - nStart := Nat.add_sub_cancel _ 1
  have hPart1 : ∀ bits : BitVec 128, truncateBits tagW bits = bits →
      ((wrappingRangeContains tagRange bits = true ↔
          (Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = true ∨
            wrappingRangeContains uRange bits = true)) ∧
       ¬ (Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = true ∧
            wrappingRangeContains uRange bits = true)) := by
    intro bits hBits
    have hP := nicheRangePartition_iff hPart bits hBits
    rw [hSubK] at hP
    exact hP
  -- Extract `nStartBits` width-fitting and `k < 2^tagW` from `hPart`:
  have hkAndN0 : (nLast - nStart + 1) < Nat.pow 2 tagW.bitWidth ∧
      truncateBits tagW nStartBits = nStartBits ∧
      checkNicheTagsDisjoint tagW nStartBits tagRange uRange (nLast - nStart + 1) = true := by
    unfold checkNicheRangePartition at hPart
    dsimp at hPart
    cases hG1 : (Nat.beq (nLast - nStart + 1) 0 ||
        !Nat.blt (nLast - nStart + 1) (Nat.pow 2 tagW.bitWidth) ||
        !Nat.ble (nLast - nStart + 1) 64) with
    | true => rw [hG1] at hPart; cases hPart
    | false =>
      rw [hG1] at hPart; dsimp at hPart
      let ⟨hG1a, _⟩ := bool_or_false hG1
      let ⟨_, hBltM⟩ := bool_or_false hG1a
      cases hG2 : (!(truncateBits tagW nStartBits == nStartBits) ||
          !wrappingRangeFitsWidth tagW tagRange ||
          !wrappingRangeFitsWidth tagW uRange) with
      | true => rw [hG2] at hPart; cases hPart
      | false =>
        rw [hG2] at hPart; dsimp at hPart
        let ⟨hG2a, _⟩ := bool_or_false hG2
        let ⟨hN0B, _⟩ := bool_or_false hG2a
        cases hG3 : (!checkNicheTagsDisjoint tagW nStartBits tagRange uRange (nLast - nStart + 1)) with
        | true => rw [hG3] at hPart; cases hPart
        | false =>
          exact ⟨nat_blt_lt (bool_not_false hBltM),
            eq_of_beq (bool_not_false hN0B),
            bool_not_false hG3⟩
  let ⟨hkLtM, hN0Fit, hDisj⟩ := hkAndN0
  refine ⟨hPart1, ?_, ?_⟩
  · -- Part 2: Niche Tag Round-Trip
    intro v vd b extras hvGe hvLe hvGet hvInh
    have hvNeUnt : Nat.beq v untagged = false :=
      nat_beq_false_of_ne (fun heq => hNoMid ⟨by rw [← heq]; exact hvGe, by rw [← heq]; exact hvLe⟩)
    let bits' := addTruncBits tagW (BitVec.ofNat 128 (v - nStart)) nStartBits
    refine ⟨bits', ?_, ?_⟩
    · unfold writeAdtDiscriminant
      rw [hAdm]; dsimp
      rw [hvGet]; dsimp
      rw [hvInh]; dsimp
      rw [hLay]; dsimp
      rw [hvNeUnt, nat_le_ble hvGe, nat_le_ble hvLe]
      rfl
    · unfold decodeNicheVariant
      dsimp
      have hBits'Fit : truncateBits tagW bits' = bits' :=
        truncateBits_addTruncBits tagW _ _
      rw [bitvec_bne_false_of_eq hBits'Fit]
      dsimp
      have hComm : bits' = addTruncBits tagW nStartBits (BitVec.ofNat 128 (v - nStart)) :=
        addTruncBits_comm tagW _ _
      have hiLtK : v - nStart < nLast - nStart + 1 :=
        Nat.lt_succ_of_le (Nat.sub_le_sub_right hvLe nStart)
      have hiLtM : v - nStart < Nat.pow 2 tagW.bitWidth := Nat.lt_trans hiLtK hkLtM
      have hTagIn : wrappingRangeContains tagRange bits' = true := by
        rw [hComm]; exact (checkNicheTagsDisjoint_at hDisj hiLtK).1
      rw [hTagIn]
      dsimp
      have hRelEq : (subTruncBits tagW bits' nStartBits).toNat = v - nStart := by
        rw [hComm]; exact subTrunc_addTrunc_cancel nStartBits hN0Fit hiLtM
      rw [hRelEq, nat_le_ble (Nat.sub_le_sub_right hvLe nStart)]
      dsimp
      rw [Nat.add_sub_of_le hvGe, hvGet]
      dsimp
      rw [hvInh]
      rfl
  · -- Part 3: Exact `SetDiscriminant(untagged)` Write-Order UB Characterization
    intro nicheBits extras
    have hWriteBase :
        writeAdtDiscriminant ed untagged (.liveNiche nicheBits extras) =
          match decodeNicheVariant ed tagW untagged nStart nLast nStartBits tagRange nicheBits with
          | .error k => .error k
          | .ok actual =>
            if Nat.beq actual untagged then
              .ok (.liveNiche nicheBits extras)
            else
              .error .undefined := by
      unfold writeAdtDiscriminant
      rw [hAdm]; dsimp
      rw [hUVdGet]; dsimp
      rw [hUVdInh]; dsimp
      rw [hLay]; dsimp
      rw [nat_beq_refl untagged]
      rfl
    rw [hWriteBase]
    refine ⟨?_, ?_⟩
    · constructor
      · intro ⟨sl', hOk⟩
        cases nicheBits with
        | none =>
          unfold decodeNicheVariant at hOk; cases hOk
        | some bits =>
          unfold decodeNicheVariant at hOk
          dsimp at hOk
          cases hTr : (truncateBits tagW bits != bits) with
          | true => rw [hTr] at hOk; cases hOk
          | false =>
            have hFitB : truncateBits tagW bits = bits := by
              unfold bne at hTr
              exact eq_of_beq (bool_not_false hTr)
            rw [hTr] at hOk; dsimp at hOk
            cases hInT : wrappingRangeContains tagRange bits with
            | false => rw [hInT] at hOk; cases hOk
            | true =>
              rw [hInT] at hOk; dsimp at hOk
              cases hInU : wrappingRangeContains uRange bits with
              | true => exact ⟨bits, rfl, hFitB, hInU⟩
              | false =>
                -- By `hPart1`, `hInT = true` and `hInU = false` force `Nat.ble rel span = true`,
                -- so `idx ∈ [nStart, nLast]`, hence `idx ≠ untagged` -> `.error .undefined`!
                have hOr := (hPart1 bits hFitB).1.mp hInT
                have hBle : Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = true := by
                  cases hOr with
                  | inl h => exact h
                  | inr h => rw [hInU] at h; cases h
                rw [hBle] at hOk; dsimp at hOk
                let idx := nStart + (subTruncBits tagW bits nStartBits).toNat
                have hIdxGe : nStart ≤ idx := Nat.le_add_right _ _
                have hIdxLe : idx ≤ nLast := by
                  have h1 := Nat.add_le_add_left (nat_ble_le hBle) nStart
                  rw [Nat.add_sub_of_le hLe] at h1
                  exact h1
                have hIdxNe : Nat.beq idx untagged = false :=
                  nat_beq_false_of_ne (fun heq => hNoMid ⟨by rw [← heq]; exact hIdxGe, by rw [← heq]; exact hIdxLe⟩)
                cases hGIdx : Trusted.MirSemantics.getElem? ed.variants idx with
                | none => rw [hGIdx] at hOk; cases hOk
                | some vdIdx =>
                  rw [hGIdx] at hOk; dsimp at hOk
                  cases hUninh : variantIsUninhabited vdIdx with
                  | true => rw [hUninh] at hOk; cases hOk
                  | false =>
                    rw [hUninh] at hOk; dsimp at hOk
                    rw [hIdxNe] at hOk; cases hOk
      · intro ⟨bits, hSome, hFitB, hInU⟩
        subst hSome
        have ⟨hIff, hDisjP⟩ := hPart1 bits hFitB
        have hInT : wrappingRangeContains tagRange bits = true := hIff.mpr (Or.inr hInU)
        have hBleF : Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = false := by
          cases hb : Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) with
          | false => rfl
          | true => exact False.elim (hDisjP ⟨hb, hInU⟩)
        refine ⟨.liveNiche (some bits) extras, ?_⟩
        unfold decodeNicheVariant
        dsimp
        rw [bitvec_bne_false_of_eq hFitB]
        dsimp
        rw [hInT]
        dsimp
        rw [hBleF]
        dsimp
        rw [hUVdGet]
        dsimp
        rw [hUVdInh]
        dsimp
        rw [nat_beq_refl untagged]
        rfl
    · intro hBad
      cases hBad with
      | inl hNone =>
        subst hNone
        rfl
      | inr hEx =>
        let ⟨bits, hSome, hFitB, hOutU⟩ := hEx
        subst hSome
        unfold decodeNicheVariant
        dsimp
        rw [bitvec_bne_false_of_eq hFitB]
        dsimp
        cases hInT : wrappingRangeContains tagRange bits with
        | false => rfl
        | true =>
          dsimp
          have hOr := (hPart1 bits hFitB).1.mp hInT
          have hBle : Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart) = true := by
            cases hOr with
            | inl h => exact h
            | inr h => rw [hOutU] at h; cases h
          rw [hBle]
          dsimp
          let idx := nStart + (subTruncBits tagW bits nStartBits).toNat
          have hIdxGe : nStart ≤ idx := Nat.le_add_right _ _
          have hIdxLe : idx ≤ nLast := by
            have h1 := Nat.add_le_add_left (nat_ble_le hBle) nStart
            rw [Nat.add_sub_of_le hLe] at h1
            exact h1
          have hIdxLt : idx < ed.variants.length := Nat.lt_of_le_of_lt hIdxLe hLastLt
          let ⟨vdIdx, hGIdx⟩ := getElem?_some_of_lt ed.variants idx hIdxLt
          rw [hGIdx]
          dsimp
          cases hUninh : variantIsUninhabited vdIdx with
          | true => rfl
          | false =>
            dsimp
            have hIdxNe : Nat.beq idx untagged = false :=
              nat_beq_false_of_ne (fun heq => hNoMid ⟨by rw [← heq]; exact hIdxGe, by rw [← heq]; exact hIdxLe⟩)
            rw [hIdxNe]
            rfl

/-! ### Part B: Proof of Theorem 3 (`unreachableEnumBranching_sound_bidirectional_iff_slice2`) -/

private noncomputable def MemBitVec (d : BitVec 128) : List (BitVec 128) → Prop
  | [] => False
  | y :: ys => d = y ∨ MemBitVec d ys

private theorem mem_inhabitedDiscrSet_of_getElem? {w : IntWidth} :
    ∀ {vs : List VariantDef} {v : Nat} {vd : VariantDef},
      Trusted.MirSemantics.getElem? vs v = some vd →
      variantIsUninhabited vd = false →
      MemBitVec (truncateBits w (BitVec.ofNat 128 vd.discrVal)) (inhabitedDiscrSet w vs)
  | [], _, _, h, _ => by cases h
  | vd₀ :: rest, 0, vd, h, hInh => by
    injection h with heq; subst heq
    unfold inhabitedDiscrSet
    rw [hInh]; dsimp [MemBitVec]
    exact Or.inl rfl
  | vd₀ :: rest, v + 1, vd, h, hInh => by
    unfold inhabitedDiscrSet
    have ih := @mem_inhabitedDiscrSet_of_getElem? w rest v vd h hInh
    cases variantIsUninhabited vd₀ with
    | true => exact ih
    | false => exact Or.inr ih

private theorem readAdtDiscriminant_in_inhabitedDiscrSet {ed : AdtEnumDef} {sl : EnumSlot}
    {val : Val} (hRead : readAdtDiscriminant ed sl = .ok val) :
    ∃ dBits : BitVec 128,
      val = .scalar ⟨ed.discrWidth, ed.discrSigned, dBits⟩ ∧
      truncateBits ed.discrWidth dBits = dBits ∧
      MemBitVec dBits (inhabitedDiscrSet ed.discrWidth ed.variants) := by
  unfold readAdtDiscriminant at hRead
  cases hAdm : adtEnumDefAdmitted ed with
  | false => rw [hAdm] at hRead; cases hRead
  | true =>
    rw [hAdm] at hRead; dsimp at hRead
    revert hRead
    cases hLay : ed.layout with
    | empty =>
      cases sl with
      | enumDead | liveEmpty | baseSlot _ | liveSingle _ | liveNiche _ _ =>
        intro hRead; cases hRead
      | liveDirect tag _ =>
        cases tag <;> (intro hRead; cases hRead)
    | single =>
      cases sl with
      | enumDead | baseSlot _ | liveEmpty | liveNiche _ _ =>
        intro hRead; cases hRead
      | liveDirect tag _ =>
        cases tag <;> (intro hRead; cases hRead)
      | liveSingle fields =>
        intro hRead; dsimp at hRead
        cases hG : Trusted.MirSemantics.getElem? ed.variants 0 with
        | none => rw [hG] at hRead; cases hRead
        | some vd =>
          rw [hG] at hRead; dsimp at hRead
          cases hUn : variantIsUninhabited vd with
          | true => rw [hUn] at hRead; cases hRead
          | false =>
            rw [hUn] at hRead; dsimp at hRead
            injection hRead with hEq
            exact ⟨_, hEq.symm, truncateBits_idem _ _,
              mem_inhabitedDiscrSet_of_getElem? hG hUn⟩
    | direct _ _ =>
      cases sl with
      | enumDead | baseSlot _ | liveEmpty | liveSingle _ | liveNiche _ _ =>
        intro hRead; cases hRead
      | liveDirect tag vfs =>
        cases tag with
        | none => intro hRead; cases hRead
        | some v =>
          intro hRead; dsimp at hRead
          cases hG : Trusted.MirSemantics.getElem? ed.variants v with
          | none => rw [hG] at hRead; cases hRead
          | some vd =>
            rw [hG] at hRead; dsimp at hRead
            cases hUn : variantIsUninhabited vd with
            | true => rw [hUn] at hRead; cases hRead
            | false =>
              rw [hUn] at hRead; dsimp at hRead
              injection hRead with hEq
              exact ⟨_, hEq.symm, truncateBits_idem _ _,
                mem_inhabitedDiscrSet_of_getElem? hG hUn⟩
    | niche tagW untagged nStart nLast nStartBits tagRange nicheField uRange =>
      cases sl with
      | enumDead | baseSlot _ | liveEmpty | liveSingle _ =>
        intro hRead; cases hRead
      | liveDirect tag _ =>
        cases tag <;> (intro hRead; cases hRead)
      | liveNiche nicheBits extras =>
        intro hRead; dsimp at hRead
        cases hDec : decodeNicheVariant ed tagW untagged nStart nLast nStartBits tagRange nicheBits with
        | error _ => rw [hDec] at hRead; cases hRead
        | ok v =>
          rw [hDec] at hRead; dsimp at hRead
          -- Extract `variantIsUninhabited vd = false` from `decodeNicheVariant = .ok v`:
          have hVdInh : ∃ vd, Trusted.MirSemantics.getElem? ed.variants v = some vd ∧
              variantIsUninhabited vd = false := by
            revert hDec
            unfold decodeNicheVariant
            cases nicheBits with
            | none => intro hDec; cases hDec
            | some bits =>
              dsimp
              cases (truncateBits tagW bits != bits) with
              | true => intro hDec; cases hDec
              | false =>
                dsimp
                cases wrappingRangeContains tagRange bits with
                | false => intro hDec; cases hDec
                | true =>
                  dsimp
                  intro hDec
                  let idx := if Nat.ble (subTruncBits tagW bits nStartBits).toNat (nLast - nStart)
                    then nStart + (subTruncBits tagW bits nStartBits).toNat else untagged
                  cases hGV : Trusted.MirSemantics.getElem? ed.variants idx with
                  | none => rw [hGV] at hDec; cases hDec
                  | some vd =>
                    rw [hGV] at hDec; dsimp at hDec
                    cases hUV : variantIsUninhabited vd with
                    | true => rw [hUV] at hDec; cases hDec
                    | false =>
                      rw [hUV] at hDec; dsimp at hDec
                      injection hDec with hvEq
                      exact ⟨vd, by rw [← hvEq]; exact hGV, hUV⟩
          let ⟨vd, hGV, hUV⟩ := hVdInh
          rw [hGV] at hRead; dsimp at hRead
          injection hRead with hEq
          exact ⟨_, hEq.symm, truncateBits_idem _ _,
            mem_inhabitedDiscrSet_of_getElem? hGV hUV⟩

private theorem removeBitVecOnce_spec (c d : BitVec 128) :
    ∀ (ys : List (BitVec 128)),
      MemBitVec d ys →
      (d = c → (removeBitVecOnce c ys).1 = true) ∧
      (d ≠ c → MemBitVec d (removeBitVecOnce c ys).2)
  | [], hMem => False.elim hMem
  | y :: ys, hMem => by
    unfold removeBitVecOnce
    cases hcy : (c == y) with
    | true =>
      have hcEqY : c = y := eq_of_beq hcy
      dsimp
      refine ⟨fun _ => rfl, ?_⟩
      intro hdNe
      cases hMem with
      | inl hdEqY => exact False.elim (hdNe (hdEqY.trans hcEqY.symm))
      | inr hTail => exact hTail
    | false =>
      have hcNeY : c ≠ y := fun heq => by
        have hT : (c == y) = true := by subst heq; exact bitvec_beq_refl c
        rw [hcy] at hT; cases hT
      dsimp
      refine ⟨?_, ?_⟩
      · intro hdEqC
        cases hMem with
        | inl hdEqY => exact False.elim (hcNeY (hdEqC.symm.trans hdEqY))
        | inr hTail => exact (removeBitVecOnce_spec c d ys hTail).1 hdEqC
      · intro hdNeC
        cases hMem with
        | inl hdEqY => exact Or.inl hdEqY
        | inr hTail => exact Or.inr ((removeBitVecOnce_spec c d ys hTail).2 hdNeC)

private theorem evalSwitchBranches_nil (w : IntWidth) (d : BitVec 128) (o : BasicBlockId) :
    evalSwitchBranches w d o [] = .ok o := rfl

private theorem evalSwitchBranches_cons (w : IntWidth) (d : BitVec 128) (o : BasicBlockId)
    (caseBits : BitVec 128) (target : BasicBlockId)
    (rest : List (BitVec 128 × BasicBlockId)) :
    evalSwitchBranches w d o ((caseBits, target) :: rest) =
      if truncateBits w caseBits != caseBits then
        .error .unsupported
      else if truncateBits w d == truncateBits w caseBits then
        .ok target
      else
        evalSwitchBranches w d o rest := rfl



/-- Exact evaluation equivalence for `pruneEnumBranches` + optional `[lastDiscr]` promotion
whenever `dBits` is a `discrW`-fitting member of `allowed`! -/
private theorem pruneEnumBranches_evalSwitch_eq {w : IntWidth} {dBits : BitVec 128}
    (hdFit : truncateBits w dBits = dBits)
    (unreachBb origOtherwise : BasicBlockId) :
    ∀ (allowed : List (BitVec 128))
      (brs : List (BitVec 128 × BasicBlockId)),
      allSwitchCasesFitWidth w brs = true →
      MemBitVec dBits allowed →
      let pruned := pruneEnumBranches w unreachBb allowed brs
      let targets' : SwitchTargets :=
        match pruned.1 with
        | [] => { branches := pruned.2, otherwise := unreachBb }
        | [lastDiscr] =>
          { branches := pruned.2 ++ [(lastDiscr, origOtherwise)], otherwise := unreachBb }
        | _ => { branches := pruned.2, otherwise := origOtherwise }
      evalSwitchBranches w dBits targets'.otherwise targets'.branches =
        evalSwitchBranches w dBits origOtherwise brs
  | allowed, [], _, hMem => by
    dsimp [pruneEnumBranches]
    cases allowed with
    | nil => exact False.elim hMem
    | cons lastD restD =>
      cases restD with
      | cons _ _ => rfl
      | nil =>
        dsimp
        have hdEq : dBits = lastD := by
          cases hMem with
          | inl h => exact h
          | inr hF => exact False.elim hF
        subst hdEq
        rw [evalSwitchBranches_cons, evalSwitchBranches_nil,
            bitvec_bne_false_of_eq hdFit, hdFit, bitvec_beq_refl]
        rfl
  | allowed, (caseBits, target) :: rest, hAllFit, hMem => by
    unfold allSwitchCasesFitWidth at hAllFit
    dsimp [List.all] at hAllFit
    let ⟨hCaseFitB, hRestFit⟩ := bool_and_true hAllFit
    have hCaseFit : truncateBits w caseBits = caseBits := eq_of_beq hCaseFitB
    have hCaseBne : (truncateBits w caseBits != caseBits) = false :=
      bitvec_bne_false_of_eq hCaseFit
    dsimp [pruneEnumBranches]
    rw [hCaseBne]
    dsimp
    cases hEqDC : (dBits == caseBits) with
    | true =>
      have hdEqC : dBits = caseBits := eq_of_beq hEqDC
      have hRem1 : (removeBitVecOnce caseBits allowed).1 = true :=
        (removeBitVecOnce_spec caseBits dBits allowed hMem).1 hdEqC
      rw [hRem1]
      dsimp
      -- Both LHS and RHS match the head `(caseBits, target)` immediately!
      cases hRemTail : (pruneEnumBranches w unreachBb (removeBitVecOnce caseBits allowed).2 rest).1 with
      | nil =>
        dsimp
        rw [evalSwitchBranches_cons, evalSwitchBranches_cons, hCaseBne,
            hdFit, hCaseFit, hEqDC]; rfl
      | cons a tailA =>
        cases tailA with
        | nil =>
          dsimp [List.append]
          rw [evalSwitchBranches_cons, evalSwitchBranches_cons, hCaseBne,
              hdFit, hCaseFit, hEqDC]; rfl
        | cons _ _ =>
          dsimp
          rw [evalSwitchBranches_cons, evalSwitchBranches_cons, hCaseBne,
              hdFit, hCaseFit, hEqDC]; rfl
    | false =>
      have hdNeC : dBits ≠ caseBits := fun heq => by
        have hT : (dBits == caseBits) = true := by subst heq; exact bitvec_beq_refl _
        rw [hEqDC] at hT; cases hT
      have hMemRem : MemBitVec dBits (removeBitVecOnce caseBits allowed).2 :=
        (removeBitVecOnce_spec caseBits dBits allowed hMem).2 hdNeC
      have ih := pruneEnumBranches_evalSwitch_eq hdFit unreachBb origOtherwise
        (removeBitVecOnce caseBits allowed).2 rest hRestFit hMemRem
      dsimp at ih
      cases hRemTail : (pruneEnumBranches w unreachBb (removeBitVecOnce caseBits allowed).2 rest).1 with
      | nil =>
        rw [hRemTail] at ih; dsimp at ih; dsimp
        rw [evalSwitchBranches_cons, evalSwitchBranches_cons, hCaseBne,
            hdFit, hCaseFit, hEqDC]
        dsimp
        exact ih
      | cons a tailA =>
        cases tailA with
        | nil =>
          rw [hRemTail] at ih; dsimp [List.append] at ih; dsimp [List.append]
          rw [evalSwitchBranches_cons, evalSwitchBranches_cons, hCaseBne,
              hdFit, hCaseFit, hEqDC]
          dsimp
          exact ih
        | cons b tailB =>
          rw [hRemTail] at ih; dsimp at ih; dsimp
          rw [evalSwitchBranches_cons, evalSwitchBranches_cons, hCaseBne,
              hdFit, hCaseFit, hEqDC]
          dsimp
          exact ih

private theorem evalSwitchBranches_target_lt {w : IntWidth} {d : BitVec 128}
    {o : BasicBlockId} {numBlocks : Nat} {t : BasicBlockId}
    (ho : o < numBlocks) :
    ∀ {brs : List (BitVec 128 × BasicBlockId)},
      brs.all (fun p => Nat.blt p.2 numBlocks) = true →
      evalSwitchBranches w d o brs = .ok t →
      t < numBlocks
  | [], _, hEv => by
    rw [evalSwitchBranches_nil] at hEv
    injection hEv with heq; rw [← heq]; exact ho
  | (c, tgt) :: rest, hAll, hEv => by
    dsimp [List.all] at hAll
    let ⟨hTgtLt, hRestAll⟩ := bool_and_true hAll
    rw [evalSwitchBranches_cons] at hEv
    cases hTr : (truncateBits w c != c) with
    | true => rw [hTr] at hEv; cases hEv
    | false =>
      rw [hTr] at hEv; dsimp at hEv
      cases hEq : (truncateBits w d == truncateBits w c) with
      | true =>
        rw [hEq] at hEv; dsimp at hEv
        injection hEv with heq; rw [← heq]; exact nat_blt_lt hTgtLt
      | false =>
        rw [hEq] at hEv; dsimp at hEv
        exact evalSwitchBranches_target_lt ho hRestAll hEv

private theorem evalBoolSwitchBranches_nil (b : Bool) (o : BasicBlockId) :
    evalBoolSwitchBranches b o [] = .ok o := rfl

private theorem evalBoolSwitchBranches_cons (b : Bool) (o : BasicBlockId)
    (c : BitVec 128) (tgt : BasicBlockId) (rest : List (BitVec 128 × BasicBlockId)) :
    evalBoolSwitchBranches b o ((c, tgt) :: rest) =
      match evalConstLit .bool (.scalar c) with
      | .ok (.bool false) =>
        if !b then .ok tgt else evalBoolSwitchBranches b o rest
      | .ok (.bool true) =>
        if b then .ok tgt else evalBoolSwitchBranches b o rest
      | .error k => .error k
      | .ok _ => .error .unsupported := rfl

private theorem evalBoolSwitchBranches_target_lt {b : Bool} {o : BasicBlockId}
    {numBlocks : Nat} {t : BasicBlockId}
    (ho : o < numBlocks) :
    ∀ {brs : List (BitVec 128 × BasicBlockId)},
      brs.all (fun p => Nat.blt p.2 numBlocks) = true →
      evalBoolSwitchBranches b o brs = .ok t →
      t < numBlocks
  | [], _, hEv => by
    rw [evalBoolSwitchBranches_nil] at hEv
    injection hEv with heq; rw [← heq]; exact ho
  | (c, tgt) :: rest, hAll, hEv => by
    dsimp [List.all] at hAll
    let ⟨hTgtLt, hRestAll⟩ := bool_and_true hAll
    rw [evalBoolSwitchBranches_cons] at hEv
    cases hCL : evalConstLit .bool (.scalar c) with
    | error _ => rw [hCL] at hEv; cases hEv
    | ok v =>
      rw [hCL] at hEv
      cases hV : v with
      | scalar _ | ptr _ | unit | enumVal _ _ | tuple _ | bytes _ =>
        rw [hV] at hEv; cases hEv
      | bool bv =>
        rw [hV] at hEv
        cases hBv : bv with
        | false =>
          rw [hBv] at hEv; dsimp at hEv
          cases hB : b with
          | false =>
            rw [hB] at hEv; dsimp at hEv; injection hEv with heq; rw [← heq]; exact nat_blt_lt hTgtLt
          | true =>
            rw [hB] at hEv; dsimp at hEv; exact evalBoolSwitchBranches_target_lt ho hRestAll hEv
        | true =>
          rw [hBv] at hEv; dsimp at hEv
          cases hB : b with
          | true =>
            rw [hB] at hEv; dsimp at hEv; injection hEv with heq; rw [← heq]; exact nat_blt_lt hTgtLt
          | false =>
            rw [hB] at hEv; dsimp at hEv; exact evalBoolSwitchBranches_target_lt ho hRestAll hEv

private theorem applyUnreachableEnumBranchingBlock_preserves_stmts_cleanup
    (enumDefs : List AdtEnumDef) (bodyLocals : List EnumLocalDecl)
    (unreachBb : BasicBlockId) (bb : EnumBlock) :
    (applyUnreachableEnumBranchingBlock enumDefs bodyLocals unreachBb bb).statements =
      bb.statements ∧
    (applyUnreachableEnumBranchingBlock enumDefs bodyLocals unreachBb bb).cleanup =
      bb.cleanup := by
  cases bb with
  | mk stmts term cl =>
    unfold applyUnreachableEnumBranchingBlock
    dsimp
    cases cl with
    | true => exact ⟨rfl, rfl⟩
    | false =>
      dsimp
      cases term with
      | baseTerm _ => exact ⟨rfl, rfl⟩
      | switchDiscr d e ts =>
        dsimp
        cases Trusted.MirSemantics.getElem? bodyLocals e with
        | none => exact ⟨rfl, rfl⟩
        | some decl =>
          cases decl with
          | base _ => exact ⟨rfl, rfl⟩
          | adtEnum eIdx =>
            dsimp
            cases Trusted.MirSemantics.getElem? enumDefs eIdx with
            | none => exact ⟨rfl, rfl⟩
            | some ed =>
              dsimp
              cases (!adtEnumDefAdmitted ed || !allSwitchCasesFitWidth ed.discrWidth ts.branches) with
              | true => exact ⟨rfl, rfl⟩
              | false =>
                dsimp
                cases (pruneEnumBranches ed.discrWidth unreachBb
                    (inhabitedDiscrSet ed.discrWidth ed.variants) ts.branches).1 with
                | nil => exact ⟨rfl, rfl⟩
                | cons a rest =>
                  cases rest <;> exact ⟨rfl, rfl⟩

private theorem list_any_append {α : Type} (p : α → Bool) :
    ∀ (xs ys : List α), (xs ++ ys).any p = (xs.any p || ys.any p)
  | [], ys => by dsimp [List.any]; cases ys.any p <;> rfl
  | x :: xs, ys => by
    dsimp [List.any]
    rw [list_any_append p xs ys]
    cases p x <;> cases xs.any p <;> cases ys.any p <;> rfl

private theorem unreachableEnumBranching_body_annotations_eq
    (enumDefs : List AdtEnumDef) (body : EnumBody) :
    let unreachBb := body.basicBlocks.length
    let bbs' := body.basicBlocks.map
      (applyUnreachableEnumBranchingBlock enumDefs body.locals unreachBb)
    let trapBb : EnumBlock := { statements := [], terminator := .baseTerm .unreachable, cleanup := false }
    let body' : EnumBody := { body with basicBlocks := bbs' ++ [trapBb] }
    (∀ idx, enumHasStorageAnnotation body' idx = enumHasStorageAnnotation body idx) ∧
    enumStorageAnnotationsInBounds body' = enumStorageAnnotationsInBounds body := by
  dsimp
  refine ⟨?_, ?_⟩
  · intro idx
    unfold enumHasStorageAnnotation
    dsimp
    rw [list_any_append, list_any_map]
    dsimp [List.any]
    have hOrFalse : ∀ b : Bool, (b || false) = b := fun b => by cases b <;> rfl
    rw [hOrFalse, hOrFalse]
    refine congrArg body.basicBlocks.any (funext fun bb => ?_)
    rw [(applyUnreachableEnumBranchingBlock_preserves_stmts_cleanup _ _ _ bb).1]
  · unfold enumStorageAnnotationsInBounds
    dsimp
    rw [list_all_append, list_all_map]
    dsimp [List.all]
    have hAndTrue : ∀ b : Bool, (b && true) = b := fun b => by cases b <;> rfl
    rw [hAndTrue, hAndTrue]
    refine congrArg body.basicBlocks.all (funext fun bb => ?_)
    rw [(applyUnreachableEnumBranchingBlock_preserves_stmts_cleanup _ _ _ bb).1]

private theorem initEnumLocalsLoop_congr_annot (enumDefs : List AdtEnumDef)
    (b₁ b₂ : EnumBody) (args : List Val)
    (hArg : b₁.argumentCount = b₂.argumentCount)
    (hAnn : ∀ idx, enumHasStorageAnnotation b₁ idx = enumHasStorageAnnotation b₂ idx) :
    ∀ (idx : Nat) (decls : List EnumLocalDecl),
      initEnumLocalsLoop enumDefs b₁ args idx decls =
        initEnumLocalsLoop enumDefs b₂ args idx decls
  | _, [] => rfl
  | idx, d :: rest => by
    unfold initEnumLocalsLoop
    rw [hArg, hAnn idx, initEnumLocalsLoop_congr_annot enumDefs b₁ b₂ args hArg hAnn (idx + 1) rest]

private theorem evalEnumStmt_step_shape (enumDefs : List AdtEnumDef)
    (body : EnumBody) (frame : EnumFrame) (callerMem : CallerMemory)
    (stmt : EnumStmt) :
    ∀ s', evalEnumStmt enumDefs body frame callerMem stmt = .step s' →
      ∃ f', s'.frames = [f'] ∧ f'.defId = frame.defId ∧ f'.blockIdx = frame.blockIdx := by
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop =>
      intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩
    | unsupported => intro _ hEv; cases hEv
    | storageLive lid =>
      unfold evalEnumStmt; dsimp
      cases Trusted.MirSemantics.getElem? body.locals lid with
      | none => intro _ hEv; cases hEv
      | some decl =>
        dsimp
        cases liveUninitEnumSlot enumDefs decl with
        | none => intro _ hEv; cases hEv
        | some sl =>
          dsimp
          cases setElem? frame.locals lid sl with
          | none => intro _ hEv; cases hEv
          | some _ =>
            dsimp; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩
    | storageDead lid =>
      unfold evalEnumStmt; dsimp
      cases Nat.beq lid 0 with
      | true => intro _ hEv; cases hEv
      | false =>
        dsimp
        cases setElem? frame.locals lid _ with
        | none => intro _ hEv; cases hEv
        | some _ =>
          dsimp; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩
    | assign dst rv =>
      unfold evalEnumStmt; dsimp
      cases dst.projection.isEmpty with
      | false => intro _ hEv; cases hEv
      | true =>
        dsimp
        cases Trusted.MirSemantics.getElem? body.locals dst.localId with
        | none => intro _ hEv; cases hEv
        | some d =>
          cases d with
          | adtEnum _ => intro _ hEv; cases hEv
          | base dstTy =>
            dsimp
            cases evalEnumBaseRvalue body.locals frame.locals dstTy rv with
            | error _ => intro _ hEv; cases hEv
            | ok p1 =>
              cases p1 with
              | mk v s1 =>
                dsimp
                cases writeEnumBasePlace s1 dst.localId dstTy v with
                | error _ => intro _ hEv; cases hEv
                | ok _ =>
                  dsimp; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩
  | setDiscriminant lid vid =>
    unfold evalEnumStmt; dsimp
    cases Trusted.MirSemantics.getElem? body.locals lid with
    | none => intro _ hEv; cases hEv
    | some d =>
      cases d with
      | base _ => intro _ hEv; cases hEv
      | adtEnum eIdx =>
        cases Trusted.MirSemantics.getElem? frame.locals lid with
        | none => intro _ hEv; cases hEv
        | some sl =>
          dsimp
          cases Trusted.MirSemantics.getElem? enumDefs eIdx with
          | none => intro _ hEv; cases hEv
          | some ed =>
            dsimp
            cases writeAdtDiscriminant ed vid sl with
            | error _ => intro _ hEv; cases hEv
            | ok sl' =>
              dsimp
              cases setElem? frame.locals lid sl' with
              | none => intro _ hEv; cases hEv
              | some _ =>
                dsimp; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩
  | assignField lid vid fid rv =>
    unfold evalEnumStmt; dsimp
    cases rvalueMentionsLocal lid rv with
    | true => intro _ hEv; cases hEv
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? body.locals lid with
      | none => intro _ hEv; cases hEv
      | some d =>
        cases d with
        | base _ => intro _ hEv; cases hEv
        | adtEnum eIdx =>
          dsimp
          cases Trusted.MirSemantics.getElem? enumDefs eIdx with
          | none => intro _ hEv; cases hEv
          | some ed =>
            dsimp
            cases Trusted.MirSemantics.getElem? ed.variants vid with
            | none => intro _ hEv; cases hEv
            | some vd =>
              dsimp
              cases Trusted.MirSemantics.getElem? vd.fields fid with
              | none => intro _ hEv; cases hEv
              | some fTy =>
                dsimp
                cases evalEnumBaseRvalue body.locals frame.locals fTy rv with
                | error _ => intro _ hEv; cases hEv
                | ok p1 =>
                  cases p1 with
                  | mk v s1 =>
                    dsimp
                    cases Trusted.MirSemantics.getElem? s1 lid with
                    | none => intro _ hEv; cases hEv
                    | some sl =>
                      dsimp
                      cases writeAdtField ed vid fid fTy v sl with
                      | error _ => intro _ hEv; cases hEv
                      | ok sl' =>
                        dsimp
                        cases setElem? s1 lid sl' with
                        | none => intro _ hEv; cases hEv
                        | some _ =>
                          dsimp; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩
  | readField dl slId vid fid mv =>
    unfold evalEnumStmt; dsimp
    cases Nat.beq dl slId with
    | true => intro _ hEv; cases hEv
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? body.locals dl with
      | none => intro _ hEv; cases hEv
      | some dd =>
        cases dd with
        | adtEnum _ => intro _ hEv; cases hEv
        | base dstTy =>
          cases Trusted.MirSemantics.getElem? body.locals slId with
          | none => intro _ hEv; cases hEv
          | some sd =>
            cases sd with
            | base _ => intro _ hEv; cases hEv
            | adtEnum eIdx =>
              cases Trusted.MirSemantics.getElem? frame.locals slId with
              | none => intro _ hEv; cases hEv
              | some sl =>
                dsimp
                cases Trusted.MirSemantics.getElem? enumDefs eIdx with
                | none => intro _ hEv; cases hEv
                | some ed =>
                  dsimp
                  cases Trusted.MirSemantics.getElem? ed.variants vid with
                  | none => intro _ hEv; cases hEv
                  | some vd =>
                    dsimp
                    cases Trusted.MirSemantics.getElem? vd.fields fid with
                    | none => intro _ hEv; cases hEv
                    | some fTy =>
                      dsimp
                      cases MirTy.beq fTy dstTy with
                      | false => intro _ hEv; cases hEv
                      | true =>
                        dsimp
                        cases readAdtField ed vid fid fTy mv sl with
                        | error _ => intro _ hEv; cases hEv
                        | ok p1 =>
                          cases p1 with
                          | mk val sl' =>
                            dsimp
                            cases setElem? frame.locals slId sl' with
                            | none => intro _ hEv; cases hEv
                            | some s1 =>
                              dsimp
                              cases writeEnumBasePlace s1 dl dstTy val with
                              | error _ => intro _ hEv; cases hEv
                              | ok _ =>
                                dsimp; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩
  | aggregateEnum dl vid ops =>
    unfold evalEnumStmt; dsimp
    cases ops.any (stmtMentionsLocalOperand dl) with
    | true => intro _ hEv; cases hEv
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? body.locals dl with
      | none => intro _ hEv; cases hEv
      | some d =>
        cases d with
        | base _ => intro _ hEv; cases hEv
        | adtEnum eIdx =>
          dsimp
          cases Trusted.MirSemantics.getElem? enumDefs eIdx with
          | none => intro _ hEv; cases hEv
          | some ed =>
            dsimp
            cases adtEnumDefAdmitted ed with
            | false => intro _ hEv; cases hEv
            | true =>
              dsimp
              cases Trusted.MirSemantics.getElem? ed.variants vid with
              | none => intro _ hEv; cases hEv
              | some vd =>
                dsimp
                cases evalAggregateEnumOperands body.locals frame.locals ops vd.fields with
                | error _ => intro _ hEv; cases hEv
                | ok p1 =>
                  cases p1 with
                  | mk vals s1 =>
                    dsimp
                    cases Trusted.MirSemantics.getElem? s1 dl with
                    | none => intro _ hEv; cases hEv
                    | some sl =>
                      cases sl with
                      | enumDead => intro _ hEv; cases hEv
                      | baseSlot _ | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
                        dsimp
                        cases variantIsUninhabited vd with
                        | true => intro _ hEv; cases hEv
                        | false =>
                          dsimp
                          cases writeAdtFieldsSeq ed vid 0 vd.fields vals _ with
                          | error _ => intro _ hEv; cases hEv
                          | ok sl1 =>
                            dsimp
                            cases writeAdtDiscriminant ed vid sl1 with
                            | error _ => intro _ hEv; cases hEv
                            | ok sl2 =>
                              dsimp
                              cases setElem? s1 dl sl2 with
                              | none => intro _ hEv; cases hEv
                              | some _ =>
                                dsimp; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩
  | discriminantDirect dl slId =>
    unfold evalEnumStmt; dsimp
    cases Trusted.MirSemantics.getElem? body.locals dl with
    | none => intro _ hEv; cases hEv
    | some dd =>
      cases dd with
      | adtEnum _ => intro _ hEv; cases hEv
      | base dstTy =>
        cases Trusted.MirSemantics.getElem? body.locals slId with
        | none => intro _ hEv; cases hEv
        | some sd =>
          cases sd with
          | base _ => intro _ hEv; cases hEv
          | adtEnum eIdx =>
            cases Trusted.MirSemantics.getElem? frame.locals slId with
            | none => intro _ hEv; cases hEv
            | some sl =>
              dsimp
              cases Trusted.MirSemantics.getElem? enumDefs eIdx with
              | none => intro _ hEv; cases hEv
              | some ed =>
                dsimp
                cases MirTy.beq dstTy (.int ed.discrWidth ed.discrSigned) with
                | false => intro _ hEv; cases hEv
                | true =>
                  dsimp
                  cases ed.layout with
                  | niche _ _ _ _ _ _ _ _ => intro _ hEv; cases hEv
                  | empty | single | direct _ _ =>
                    dsimp
                    cases readAdtDiscriminant ed sl with
                    | error _ => intro _ hEv; cases hEv
                    | ok dv =>
                      dsimp
                      cases writeEnumBasePlace frame.locals dl dstTy dv with
                      | error _ => intro _ hEv; cases hEv
                      | ok _ =>
                        dsimp; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl, rfl⟩

/-- Any step of `evalEnumTerminator` preserves `defId = frame.defId`! -/
private theorem evalEnumTerminator_preserves_defId (enumDefs : List AdtEnumDef)
    (body : EnumBody) (bb : EnumBlock) (frame : EnumFrame)
    (callerMem : CallerMemory) :
    ∀ s', evalEnumTerminator enumDefs body bb frame callerMem = .step s' →
      ∃ f', s'.frames = [f'] ∧ f'.defId = frame.defId := by
  unfold evalEnumTerminator
  cases bb.terminator with
  | baseTerm bt =>
    cases bt with
    | goto t =>
      dsimp [jumpToEnumBlock]; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl⟩
    | return_ =>
      dsimp
      cases bb.cleanup with
      | true => intro _ hEv; cases hEv
      | false =>
        dsimp
        cases Trusted.MirSemantics.getElem? frame.locals 0 with
        | none => intro _ hEv; cases hEv
        | some sl =>
          cases sl with
          | baseSlot bsl =>
            cases bsl with
            | dead => intro _ hEv; cases hEv
            | live ov => cases ov <;> (intro _ hEv; cases hEv)
          | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
            intro _ hEv; cases hEv
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      intro _ hEv; cases hEv
    | switchInt discr ts =>
      dsimp
      cases evalEnumPrimitiveOperand body.locals frame.locals discr with
      | error _ => intro _ hEv; cases hEv
      | ok p1 =>
        cases p1 with
        | mk dv s1 =>
          dsimp
          cases dv with
          | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => intro _ hEv; cases hEv
          | scalar sv =>
            dsimp
            cases evalSwitchBranches sv.width sv.bits ts.otherwise ts.branches with
            | error _ => intro _ hEv; cases hEv
            | ok _ =>
              dsimp [jumpToEnumBlock]; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl⟩
          | bool bv =>
            dsimp
            cases evalBoolSwitchBranches bv ts.otherwise ts.branches with
            | error _ => intro _ hEv; cases hEv
            | ok _ =>
              dsimp [jumpToEnumBlock]; intro s' hEv; injection hEv with heq; subst heq; exact ⟨_, rfl, rfl⟩
  | switchDiscr dDst eLoc ts =>
    dsimp
    cases Trusted.MirSemantics.getElem? body.locals dDst with
    | none => intro _ hEv; cases hEv
    | some d1 =>
      cases d1 with
      | adtEnum _ => intro _ hEv; cases hEv
      | base dstTy =>
        cases Trusted.MirSemantics.getElem? body.locals eLoc with
        | none => intro _ hEv; cases hEv
        | some d2 =>
          cases d2 with
          | base _ => intro _ hEv; cases hEv
          | adtEnum eIdx =>
            cases Trusted.MirSemantics.getElem? frame.locals eLoc with
            | none => intro _ hEv; cases hEv
            | some sl =>
              dsimp
              cases Trusted.MirSemantics.getElem? enumDefs eIdx with
              | none => intro _ hEv; cases hEv
              | some ed =>
                dsimp
                cases MirTy.beq dstTy (.int ed.discrWidth ed.discrSigned) with
                | false => intro _ hEv; cases hEv
                | true =>
                  dsimp
                  cases readAdtDiscriminant ed sl with
                  | error _ => intro _ hEv; cases hEv
                  | ok dv =>
                    dsimp
                    cases writeEnumBasePlace frame.locals dDst dstTy dv with
                    | error _ => intro _ hEv; cases hEv
                    | ok _ =>
                      dsimp
                      cases dv with
                      | bool _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ =>
                        intro _ hEv; cases hEv
                      | scalar sv =>
                        dsimp
                        cases evalSwitchBranches sv.width sv.bits ts.otherwise ts.branches with
                        | error _ => intro _ hEv; cases hEv
                        | ok _ =>
                          dsimp [jumpToEnumBlock]; intro s' hEv; injection hEv with heq; subst heq
                          exact ⟨_, rfl, rfl⟩

/-- When `enumBlockTargetsInBounds numBlocks bb = true`, any step of `evalEnumTerminator`
lands at `f'.blockIdx < numBlocks`! -/
private theorem evalEnumTerminator_step_target_lt (enumDefs : List AdtEnumDef)
    (body : EnumBody) (bb : EnumBlock) (frame : EnumFrame)
    (callerMem : CallerMemory) (numBlocks : Nat)
    (hBnd : enumBlockTargetsInBounds numBlocks bb = true) :
    ∀ s', evalEnumTerminator enumDefs body bb frame callerMem = .step s' →
      ∃ f', s'.frames = [f'] ∧ f'.defId = frame.defId ∧ f'.blockIdx < numBlocks := by
  unfold evalEnumTerminator
  unfold enumBlockTargetsInBounds at hBnd
  cases hTerm : bb.terminator with
  | baseTerm bt =>
    rw [hTerm] at hBnd
    cases bt with
    | goto t =>
      dsimp [jumpToEnumBlock]
      intro s' hEv; injection hEv with heq; subst heq
      exact ⟨_, rfl, rfl, nat_blt_lt hBnd⟩
    | return_ =>
      dsimp
      cases bb.cleanup with
      | true => intro _ hEv; cases hEv
      | false =>
        dsimp
        cases Trusted.MirSemantics.getElem? frame.locals 0 with
        | none => intro _ hEv; cases hEv
        | some sl =>
          cases sl with
          | baseSlot bsl =>
            cases bsl with
            | dead => intro _ hEv; cases hEv
            | live ov => cases ov <;> (intro _ hEv; cases hEv)
          | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
            intro _ hEv; cases hEv
    | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      intro _ hEv; cases hEv
    | switchInt discr ts =>
      dsimp at hBnd; dsimp
      let ⟨hOthLt, hBrsAll⟩ := bool_and_true hBnd
      cases evalEnumPrimitiveOperand body.locals frame.locals discr with
      | error _ => intro _ hEv; cases hEv
      | ok p1 =>
        cases p1 with
        | mk dv s1 =>
          dsimp
          cases dv with
          | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => intro _ hEv; cases hEv
          | scalar sv =>
            dsimp
            cases hSw : evalSwitchBranches sv.width sv.bits ts.otherwise ts.branches with
            | error _ => intro _ hEv; cases hEv
            | ok tgt =>
              dsimp [jumpToEnumBlock]; intro s' hEv; injection hEv with heq; subst heq
              exact ⟨_, rfl, rfl, evalSwitchBranches_target_lt (nat_blt_lt hOthLt) hBrsAll hSw⟩
          | bool bv =>
            dsimp
            cases hSw : evalBoolSwitchBranches bv ts.otherwise ts.branches with
            | error _ => intro _ hEv; cases hEv
            | ok tgt =>
              dsimp [jumpToEnumBlock]; intro s' hEv; injection hEv with heq; subst heq
              exact ⟨_, rfl, rfl, evalBoolSwitchBranches_target_lt (nat_blt_lt hOthLt) hBrsAll hSw⟩
  | switchDiscr dDst eLoc ts =>
    rw [hTerm] at hBnd
    dsimp at hBnd; dsimp
    let ⟨hOthLt, hBrsAll⟩ := bool_and_true hBnd
    cases Trusted.MirSemantics.getElem? body.locals dDst with
    | none => intro _ hEv; cases hEv
    | some d1 =>
      cases d1 with
      | adtEnum _ => intro _ hEv; cases hEv
      | base dstTy =>
        cases Trusted.MirSemantics.getElem? body.locals eLoc with
        | none => intro _ hEv; cases hEv
        | some d2 =>
          cases d2 with
          | base _ => intro _ hEv; cases hEv
          | adtEnum eIdx =>
            cases Trusted.MirSemantics.getElem? frame.locals eLoc with
            | none => intro _ hEv; cases hEv
            | some sl =>
              dsimp
              cases Trusted.MirSemantics.getElem? enumDefs eIdx with
              | none => intro _ hEv; cases hEv
              | some ed =>
                dsimp
                cases MirTy.beq dstTy (.int ed.discrWidth ed.discrSigned) with
                | false => intro _ hEv; cases hEv
                | true =>
                  dsimp
                  cases readAdtDiscriminant ed sl with
                  | error _ => intro _ hEv; cases hEv
                  | ok dv =>
                    dsimp
                    cases writeEnumBasePlace frame.locals dDst dstTy dv with
                    | error _ => intro _ hEv; cases hEv
                    | ok _ =>
                      dsimp
                      cases dv with
                      | bool _ | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ =>
                        intro _ hEv; cases hEv
                      | scalar sv =>
                        dsimp
                        cases hSw : evalSwitchBranches sv.width sv.bits ts.otherwise ts.branches with
                        | error _ => intro _ hEv; cases hEv
                        | ok tgt =>
                          dsimp [jumpToEnumBlock]; intro s' hEv; injection hEv with heq; subst heq
                          exact ⟨_, rfl, rfl, evalSwitchBranches_target_lt (nat_blt_lt hOthLt) hBrsAll hSw⟩

private theorem evalEnumTerminator_unreachableBranching_eq
    {enumDefs : List AdtEnumDef} {body body' : EnumBody}
    {bb : EnumBlock} {frame : EnumFrame} {callerMem : CallerMemory}
    (hLocEq : body'.locals = body.locals) :
    let bb' := applyUnreachableEnumBranchingBlock enumDefs body.locals
      body.basicBlocks.length bb
    evalEnumTerminator enumDefs body' bb' frame callerMem =
      evalEnumTerminator enumDefs body bb frame callerMem := by
  dsimp
  have hBodyLoc : ∀ b, evalEnumTerminator enumDefs body' b frame callerMem =
      evalEnumTerminator enumDefs body b frame callerMem := by
    intro b
    unfold evalEnumTerminator
    rw [hLocEq]
  rw [hBodyLoc]
  cases bb with
  | mk stmts term cl =>
    unfold applyUnreachableEnumBranchingBlock
    dsimp
    cases cl with
    | true => rfl
    | false =>
      dsimp
      cases term with
      | baseTerm _ => rfl
      | switchDiscr discrDst enumLocal targets =>
        dsimp
        cases hLoc : Trusted.MirSemantics.getElem? body.locals enumLocal with
        | none => rfl
        | some decl =>
          cases decl with
          | base _ => rfl
          | adtEnum eIdx =>
            dsimp
            cases hEd : Trusted.MirSemantics.getElem? enumDefs eIdx with
            | none => rfl
            | some ed =>
              dsimp
              cases hG : (!adtEnumDefAdmitted ed || !allSwitchCasesFitWidth ed.discrWidth targets.branches) with
              | true => rfl
              | false =>
                dsimp
                let ⟨_, hFitB⟩ := bool_or_false hG
                have hAllFit : allSwitchCasesFitWidth ed.discrWidth targets.branches = true :=
                  bool_not_false hFitB
                unfold evalEnumTerminator
                dsimp
                rw [hLoc]
                cases Trusted.MirSemantics.getElem? body.locals discrDst with
                | none => rfl
                | some dd =>
                  cases dd with
                  | adtEnum _ => rfl
                  | base dstTy =>
                    cases Trusted.MirSemantics.getElem? frame.locals enumLocal with
                    | none => rfl
                    | some sl =>
                      dsimp
                      rw [hEd]
                      dsimp
                      cases MirTy.beq dstTy (.int ed.discrWidth ed.discrSigned) with
                      | false => rfl
                      | true =>
                        dsimp
                        cases hRead : readAdtDiscriminant ed sl with
                        | error _ => rfl
                        | ok discVal =>
                          dsimp
                          let ⟨dBits, hValEq, hdFit, hMem⟩ :=
                            readAdtDiscriminant_in_inhabitedDiscrSet hRead
                          subst hValEq
                          cases writeEnumBasePlace frame.locals discrDst dstTy
                              (.scalar ⟨ed.discrWidth, ed.discrSigned, dBits⟩) with
                          | error _ => rfl
                          | ok slotsAfterWrite =>
                            dsimp
                            have hPruneEq :=
                              pruneEnumBranches_evalSwitch_eq hdFit
                                body.basicBlocks.length targets.otherwise
                                (inhabitedDiscrSet ed.discrWidth ed.variants)
                                targets.branches hAllFit hMem
                            dsimp at hPruneEq
                            cases hRem : (pruneEnumBranches ed.discrWidth body.basicBlocks.length
                                (inhabitedDiscrSet ed.discrWidth ed.variants) targets.branches).1 with
                            | nil =>
                              rw [hRem] at hPruneEq; dsimp at hPruneEq; dsimp
                              rw [hPruneEq]
                            | cons a tailA =>
                              cases tailA with
                              | nil =>
                                rw [hRem] at hPruneEq; dsimp at hPruneEq; dsimp
                                rw [hPruneEq]
                              | cons b tailB =>
                                rw [hRem] at hPruneEq; dsimp at hPruneEq; dsimp
                                rw [hPruneEq]

private theorem initStateEnum_entry_blockIdx_zero {p : EnumProgram} {q : Query} :
    ∀ {s₀ : EnumState}, initStateEnum p q = .ok s₀ →
      ∀ f, s₀.frames = [f] → f.blockIdx = 0 := by
  unfold initStateEnum
  cases (!Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1) with
  | true => intro _ h; cases h
  | false =>
    dsimp
    cases q.callerMem.allocations.isEmpty with
    | false => intro _ h; cases h
    | true =>
      dsimp
      cases p.enumDefs.all adtEnumDefAdmitted with
      | false => intro _ h; cases h
      | true =>
        dsimp
        cases Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
        | none => intro _ h; cases h
        | some body =>
          dsimp
          cases body.basicBlocks.isEmpty with
          | true => intro _ h; cases h
          | false =>
            dsimp
            cases Nat.blt body.argumentCount body.locals.length with
            | false => intro _ h; cases h
            | true =>
              dsimp
              cases enumStorageAnnotationsInBounds body with
              | false => intro _ h; cases h
              | true =>
                dsimp
                cases allEnumLocalsSupported p.enumDefs body.argumentCount 0 body.locals with
                | false => intro _ h; cases h
                | true =>
                  dsimp
                  cases enumParamBaseTys? body with
                  | none => intro _ h; cases h
                  | some paramTys =>
                    dsimp
                    cases checkArgsMatch q.args paramTys with
                    | false => intro _ h; cases h
                    | true =>
                      dsimp
                      cases initEnumLocalsLoop p.enumDefs body q.args 0 body.locals with
                      | none => intro _ h; cases h
                      | some locals =>
                        dsimp
                        intro s₀ hOk f hf
                        injection hOk with hsEq
                        rw [← hsEq] at hf
                        dsimp at hf
                        injection hf with hfEq
                        rw [← hfEq]

private theorem unreachableEnumBranching_sound_bidirectional_iff_slice2
    (bodyId : DefId) (pSrc pTgt : EnumProgram)
    (hCheck : checkUnreachableEnumBranching bodyId pSrc pTgt = true) :
    FullSemanticEquivEnum pSrc pTgt := by
  unfold checkUnreachableEnumBranching at hCheck
  cases hApp : applyUnreachableEnumBranching pSrc bodyId with
  | none => rw [hApp] at hCheck; cases hCheck
  | some pOut =>
    rw [hApp] at hCheck
    have hpEq := enumProgramEq_eq hCheck
    subst hpEq
    unfold applyUnreachableEnumBranching at hApp
    cases hEds : (!pSrc.enumDefs.all adtEnumDefAdmitted) with
    | true => rw [hEds] at hApp; cases hApp
    | false =>
      rw [hEds] at hApp; dsimp at hApp
      cases hBody : Trusted.MirSemantics.getElem? pSrc.bodies bodyId with
      | none => rw [hBody] at hApp; cases hApp
      | some body =>
        rw [hBody] at hApp; dsimp at hApp
        cases hBGuard : (body.basicBlocks.isEmpty || !enumBodyTargetsInBounds body) with
        | true => rw [hBGuard] at hApp; cases hApp
        | false =>
          rw [hBGuard] at hApp; dsimp at hApp
          let ⟨hNotEmpty, hTgtBndB⟩ := bool_or_false hBGuard
          have hTgtBnd : enumBodyTargetsInBounds body = true := bool_not_false hTgtBndB
          have hBBPos : 0 < body.basicBlocks.length := by
            cases hb : body.basicBlocks with
            | nil => rw [hb] at hNotEmpty; cases hNotEmpty
            | cons _ _ => exact Nat.zero_lt_succ _
          let unreachBb := body.basicBlocks.length
          let bbs' := body.basicBlocks.map
            (applyUnreachableEnumBranchingBlock pSrc.enumDefs body.locals unreachBb)
          let trapBb : EnumBlock := {
            statements := []
            terminator := .baseTerm .unreachable
            cleanup := false
          }
          let body' : EnumBody := { body with basicBlocks := bbs' ++ [trapBb] }
          cases hSet : setElem? pSrc.bodies bodyId body' with
          | none => rw [hSet] at hApp; cases hApp
          | some bodies' =>
            rw [hSet] at hApp; dsimp at hApp
            injection hApp with hOutEq
            rw [← hOutEq]
            have hInitEq : ∀ q, initStateEnum pSrc q =
                initStateEnum { pSrc with bodies := bodies' } q := by
              intro q
              unfold initStateEnum
              dsimp
              cases (!Nat.beq pSrc.pointerWidthBits 64 || !Nat.beq pSrc.mirProfileVersion 1) with
              | true => rfl
              | false =>
                dsimp
                cases q.callerMem.allocations.isEmpty with
                | false => rfl
                | true =>
                  dsimp
                  cases pSrc.enumDefs.all adtEnumDefAdmitted with
                  | false => rfl
                  | true =>
                    dsimp
                    cases hEqEntry : Nat.beq pSrc.entryDefId bodyId with
                    | false =>
                      have hNe : pSrc.entryDefId ≠ bodyId := nat_ne_of_beq_false hEqEntry
                      rw [setElem?_getElem?_ne hSet hNe]
                    | true =>
                      have hEq : pSrc.entryDefId = bodyId := nat_beq_eq hEqEntry
                      rw [hEq, hBody, setElem?_getElem?_same hSet]
                      dsimp
                      have hBbs'NonEmpty : body'.basicBlocks.isEmpty = false := by
                        cases hb : body.basicBlocks with
                        | nil => rw [hb] at hNotEmpty; cases hNotEmpty
                        | cons _ _ =>
                          change ((body.basicBlocks.map _ ++ [trapBb]).isEmpty) = false
                          rw [hb]; rfl
                      rw [hNotEmpty, hBbs'NonEmpty]
                      dsimp
                      let ⟨hAnnEq, hAnnBndEq⟩ :=
                        unreachableEnumBranching_body_annotations_eq pSrc.enumDefs body
                      have hArgEq : body'.argumentCount = body.argumentCount := rfl
                      have hLocEq : body'.locals = body.locals := rfl
                      have hParamEq : enumParamBaseTys? body' = enumParamBaseTys? body := rfl
                      rw [hArgEq, hLocEq, hAnnBndEq, hParamEq,
                          initEnumLocalsLoop_congr_annot pSrc.enumDefs body body' q.args rfl
                            (fun idx => (hAnnEq idx).symm)]
            let R : EnumState → EnumState → Prop := fun s₁ s₂ =>
              s₁ = s₂ ∧
              (∀ f, s₁.frames = [f] → f.defId = bodyId →
                f.blockIdx < body.basicBlocks.length)
            have hEvalLock : ∀ s : EnumState,
                (∀ f, s.frames = [f] → f.defId = bodyId →
                  f.blockIdx < body.basicBlocks.length) →
                evalStepEnum { pSrc with bodies := bodies' } 0 s =
                  evalStepEnum pSrc 0 s ∧
                (∀ s', evalStepEnum pSrc 0 s = .step s' →
                  ∀ f', s'.frames = [f'] → f'.defId = bodyId →
                    f'.blockIdx < body.basicBlocks.length) := by
              intro s hInv
              cases s with
              | mk frames callerMem =>
                cases frames with
                | nil => exact ⟨rfl, fun _ h => by cases h⟩
                | cons frame rest =>
                  cases rest with
                  | cons _ _ => exact ⟨rfl, fun _ h => by cases h⟩
                  | nil =>
                    unfold evalStepEnum
                    dsimp
                    cases hDefEq : Nat.beq frame.defId bodyId with
                    | false =>
                      have hNe : frame.defId ≠ bodyId := nat_ne_of_beq_false hDefEq
                      rw [setElem?_getElem?_ne hSet hNe]
                      refine ⟨rfl, ?_⟩
                      cases Trusted.MirSemantics.getElem? pSrc.bodies frame.defId with
                      | none => intro _ hEv; cases hEv
                      | some otherB =>
                        dsimp
                        cases Trusted.MirSemantics.getElem? otherB.basicBlocks frame.blockIdx with
                        | none => intro _ hEv; cases hEv
                        | some obb =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? obb.statements frame.stmtIdx with
                          | some st =>
                            dsimp
                            intro s' hEv f' hf' hfDef
                            let ⟨f1, hf1, hDef1, _⟩ :=
                              evalEnumStmt_step_shape pSrc.enumDefs otherB frame callerMem st s' hEv
                            rw [hf'] at hf1; injection hf1 with heqF; subst heqF
                            exact False.elim (hNe (hDef1.symm.trans hfDef))
                          | none =>
                            dsimp
                            cases Nat.beq frame.stmtIdx obb.statements.length with
                            | false => intro _ hEv; cases hEv
                            | true =>
                              dsimp
                              intro s' hEv f' hf' hfDef
                              let ⟨f1, hf1, hDef1⟩ :=
                                evalEnumTerminator_preserves_defId pSrc.enumDefs otherB obb frame callerMem s' hEv
                              rw [hf'] at hf1; injection hf1 with heqF; subst heqF
                              exact False.elim (hNe (hDef1.symm.trans hfDef))
                    | true =>
                      have hEq : frame.defId = bodyId := nat_beq_eq hDefEq
                      have hBlkLt : frame.blockIdx < body.basicBlocks.length := hInv frame rfl hEq
                      rw [hEq, hBody, setElem?_getElem?_same hSet]
                      dsimp
                      let ⟨bb, hBB⟩ := getElem?_some_of_lt body.basicBlocks frame.blockIdx hBlkLt
                      have hLenMap : bbs'.length = body.basicBlocks.length := by
                        have hL : ∀ (f : EnumBlock → EnumBlock) (xs : List EnumBlock),
                            (xs.map f).length = xs.length := by
                          intro f xs
                          induction xs with
                          | nil => rfl
                          | cons _ tl ih => exact congrArg Nat.succ ih
                        exact hL _ _
                      have hBB' : Trusted.MirSemantics.getElem? body'.basicBlocks frame.blockIdx =
                          some (applyUnreachableEnumBranchingBlock pSrc.enumDefs body.locals unreachBb bb) := by
                        change Trusted.MirSemantics.getElem? (bbs' ++ [trapBb]) frame.blockIdx = _
                        rw [getElem?_append_left (by rw [hLenMap]; exact hBlkLt)]
                        change Trusted.MirSemantics.getElem? (body.basicBlocks.map _) frame.blockIdx = _
                        rw [getElem?_map, hBB]
                      rw [hBB, hBB']
                      dsimp
                      let ⟨hStmtsEq, _⟩ :=
                        applyUnreachableEnumBranchingBlock_preserves_stmts_cleanup
                          pSrc.enumDefs body.locals unreachBb bb
