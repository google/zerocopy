private theorem optBbInlineEq_eq :
    ∀ {a b : Option BasicBlockId},
      (match a, b with
       | none, none => true
       | some x, some y => Nat.beq x y
       | _, _ => false) = true → a = b
  | none, none, _ => rfl
  | none, some _, h => by cases h
  | some _, none, h => by cases h
