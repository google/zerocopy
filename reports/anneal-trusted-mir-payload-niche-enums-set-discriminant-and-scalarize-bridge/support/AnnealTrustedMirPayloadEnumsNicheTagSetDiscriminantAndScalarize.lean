    | (dsimp [enumStmtEq] at h
       let ⟨h1_3, h4⟩ := bool_and_true h
       let ⟨h1_2, h3⟩ := bool_and_true h1_3
       let ⟨h1, h2⟩ := bool_and_true h1_2
       rw [nat_beq_eq h1, nat_beq_eq h2, nat_beq_eq h3, rvalueEq_eq h4])
    | (dsimp [enumStmtEq] at h
       let ⟨h1_4, h5⟩ := bool_and_true h
       let ⟨h1_3, h4⟩ := bool_and_true h1_4
       let ⟨h1_2, h3⟩ := bool_and_true h1_3
       let ⟨h1, h2⟩ := bool_and_true h1_2
       rw [nat_beq_eq h1, nat_beq_eq h2, nat_beq_eq h3, nat_beq_eq h4, boolEq_eq h5])
    | (dsimp [enumStmtEq] at h
       let ⟨h1_2, h3⟩ := bool_and_true h
       let ⟨h1, h2⟩ := bool_and_true h1_2
       rw [nat_beq_eq h1, nat_beq_eq h2, listRel_eq operandEq_eq h3]))

private theorem enumTerminatorEq_eq {a b : EnumTerminator}
    (h : enumTerminatorEq a b = true) : a = b := by
  cases a <;> cases b <;> (first
    | cases h
    | exact congrArg EnumTerminator.baseTerm (terminatorEq_eq h)
    | (dsimp [enumTerminatorEq] at h
       let ⟨h1_2, h3⟩ := bool_and_true h
       let ⟨h1, h2⟩ := bool_and_true h1_2
       rw [nat_beq_eq h1, nat_beq_eq h2, switchTargetsEq_eq h3]))

private theorem enumBlockEq_eq {a b : EnumBlock} (h : enumBlockEq a b = true) :
    a = b := by
  cases a with
  | mk s1 t1 c1 =>
    cases b with
    | mk s2 t2 c2 =>
      dsimp [enumBlockEq] at h
      let ⟨h1_2, h3⟩ := bool_and_true h
      let ⟨h1, h2⟩ := bool_and_true h1_2
      rw [boolEq_eq h1, listRel_eq enumStmtEq_eq h2, enumTerminatorEq_eq h3]

private theorem enumBodyEq_eq {a b : EnumBody} (h : enumBodyEq a b = true) : a = b := by
  cases a with
  | mk ac1 l1 bb1 u1 id1 =>
    cases b with
    | mk ac2 l2 bb2 u2 id2 =>
      dsimp [enumBodyEq] at h
      let ⟨h1_4, h5⟩ := bool_and_true h
      let ⟨h1_3, h4⟩ := bool_and_true h1_4
      let ⟨h1_2, h3⟩ := bool_and_true h1_3
      let ⟨h1, h2⟩ := bool_and_true h1_2
      rw [nat_beq_eq h1, listRel_eq enumLocalDeclEq_eq h2,
          listRel_eq enumBlockEq_eq h3, boolEq_eq h4, stringBeq_eq h5]

private theorem enumProgramEq_eq {a b : EnumProgram}
    (h : enumProgramEq a b = true) : a = b := by
  cases a with
  | mk ed1 bs1 e1 pw1 v1 sc1 =>
    cases b with
    | mk ed2 bs2 e2 pw2 v2 sc2 =>
      dsimp [enumProgramEq] at h
      let ⟨h1_5, h6⟩ := bool_and_true h
      let ⟨h1_4, h5⟩ := bool_and_true h1_5
      let ⟨h1_3, h4⟩ := bool_and_true h1_4
      let ⟨h1_2, h3⟩ := bool_and_true h1_3
      let ⟨h1, h2⟩ := bool_and_true h1_2
      rw [listRel_eq adtEnumDefEq_eq h1, listRel_eq enumBodyEq_eq h2,
          nat_beq_eq h3, nat_beq_eq h4, nat_beq_eq h5, scopeEq_eq h6]

/-! ### List Indexing, `setElem?`, `listMapOption`, `List.all`, `List.any`, & `List.map` Lemmas -/

private theorem getElem?_some_lt {α : Type} :
    ∀ {xs : List α} {i : Nat} {x : α},
      Trusted.MirSemantics.getElem? xs i = some x → i < xs.length
  | [], _, _, h => by cases h
  | _ :: _, 0, _, _ => Nat.zero_lt_succ _
  | _ :: _, _ + 1, _, h => Nat.succ_lt_succ (getElem?_some_lt h)

private theorem getElem?_none_ge {α : Type} :
    ∀ {xs : List α} {i : Nat},
      Trusted.MirSemantics.getElem? xs i = none → xs.length ≤ i
  | [], _, _ => Nat.zero_le _
  | _ :: _, 0, h => by cases h
  | _ :: _, _ + 1, h => Nat.succ_le_succ (getElem?_none_ge h)

private theorem getElem?_none_of_ge {α : Type} :
    ∀ {xs : List α} {i : Nat},
      xs.length ≤ i → Trusted.MirSemantics.getElem? xs i = none
  | [], _, _ => rfl
  | _ :: _, 0, h => False.elim (Nat.not_succ_le_zero _ h)
  | _ :: xs, i + 1, h => @getElem?_none_of_ge α xs i (Nat.le_of_succ_le_succ h)

private theorem getElem?_some_of_lt {α : Type} :
    ∀ (xs : List α) (i : Nat),
      i < xs.length → ∃ x, Trusted.MirSemantics.getElem? xs i = some x
  | [], _, h => False.elim (Nat.not_lt_zero _ h)
  | x :: _, 0, _ => ⟨x, rfl⟩
  | _ :: xs, i + 1, h => getElem?_some_of_lt xs i (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_map {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat),
      Trusted.MirSemantics.getElem? (xs.map f) i =
        match Trusted.MirSemantics.getElem? xs i with
        | some x => some (f x)
        | none => none
  | [], _ => rfl
  | _ :: _, 0 => rfl
  | _ :: xs, i + 1 => getElem?_map f xs i

private theorem getElem?_append_left {α : Type} :
    ∀ {xs ys : List α} {i : Nat},
      i < xs.length →
      Trusted.MirSemantics.getElem? (xs ++ ys) i =
        Trusted.MirSemantics.getElem? xs i
  | [], _, _, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: _, _, 0, _ => rfl
  | _ :: xs, ys, i + 1, h =>
    @getElem?_append_left α xs ys i (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_append_right {α : Type} :
    ∀ (xs ys : List α) (j : Nat),
      Trusted.MirSemantics.getElem? (xs ++ ys) (xs.length + j) =
        Trusted.MirSemantics.getElem? ys j
  | [], _, j => by dsimp [List.length]; rw [Nat.zero_add]
  | _ :: xs, ys, j => by
    dsimp [List.length]
    rw [Nat.succ_add]
    exact getElem?_append_right xs ys j

private theorem getElem?_append_right_comm {α : Type} (xs ys : List α) (j : Nat) :
    Trusted.MirSemantics.getElem? (xs ++ ys) (j + xs.length) =
      Trusted.MirSemantics.getElem? ys j := by
  rw [Nat.add_comm]
  exact getElem?_append_right xs ys j

private theorem setElem?_length {α : Type} :
    ∀ {xs xs' : List α} {i : Nat} {v : α},
      setElem? xs i v = some xs' → xs'.length = xs.length
  | [], _, _, _, h => by cases h
  | _ :: _, _, 0, _, h => by injection h with heq; rw [← heq]; rfl
  | x :: xs, _, i + 1, v, h => by
    cases hs : setElem? xs i v with
    | none =>
      have hEval : setElem? (x :: xs) (i + 1) v = none := by
        change (match setElem? xs i v with | some rest => some (x :: rest) | none => none) = none
        rw [hs]
      rw [hEval] at h; cases h
    | some rest =>
      have hEval : setElem? (x :: xs) (i + 1) v = some (x :: rest) := by
        change (match setElem? xs i v with | some rest => some (x :: rest) | none => none) = _
        rw [hs]
      rw [hEval] at h
      injection h with heq
      rw [← heq]
      exact congrArg Nat.succ (setElem?_length hs)

private theorem setElem?_getElem?_same {α : Type} :
    ∀ {xs xs' : List α} {i : Nat} {v : α},
      setElem? xs i v = some xs' →
      Trusted.MirSemantics.getElem? xs' i = some v
  | [], _, _, _, h => by cases h
  | _ :: _, _, 0, _, h => by injection h with heq; rw [← heq]; rfl
  | x :: xs, _, i + 1, v, h => by
    cases hs : setElem? xs i v with
    | none =>
      have hEval : setElem? (x :: xs) (i + 1) v = none := by
        change (match setElem? xs i v with | some rest => some (x :: rest) | none => none) = none
        rw [hs]
      rw [hEval] at h; cases h
    | some rest =>
      have hEval : setElem? (x :: xs) (i + 1) v = some (x :: rest) := by
        change (match setElem? xs i v with | some rest => some (x :: rest) | none => none) = _
        rw [hs]
      rw [hEval] at h
      injection h with heq
      rw [← heq]
      exact @setElem?_getElem?_same α xs rest i v hs

private theorem setElem?_getElem?_ne {α : Type} :
    ∀ {xs xs' : List α} {i j : Nat} {v : α},
      setElem? xs i v = some xs' →
      j ≠ i →
      Trusted.MirSemantics.getElem? xs' j = Trusted.MirSemantics.getElem? xs j
  | [], _, _, _, _, h, _ => by cases h
  | _ :: _, _, 0, 0, _, _, hne => False.elim (hne rfl)
  | _ :: _, _, 0, _ + 1, _, h, _ => by injection h with heq; rw [← heq]; rfl
  | x :: xs, _, i + 1, 0, v, h, _ => by
    cases hs : setElem? xs i v with
    | none =>
      have hEval : setElem? (x :: xs) (i + 1) v = none := by
        change (match setElem? xs i v with | some rest => some (x :: rest) | none => none) = none
        rw [hs]
      rw [hEval] at h; cases h
    | some rest =>
      have hEval : setElem? (x :: xs) (i + 1) v = some (x :: rest) := by
        change (match setElem? xs i v with | some rest => some (x :: rest) | none => none) = _
        rw [hs]
      rw [hEval] at h; injection h with heq; rw [← heq]; rfl
  | x :: xs, _, i + 1, j + 1, v, h, hne => by
    cases hs : setElem? xs i v with
    | none =>
      have hEval : setElem? (x :: xs) (i + 1) v = none := by
        change (match setElem? xs i v with | some rest => some (x :: rest) | none => none) = none
        rw [hs]
      rw [hEval] at h; cases h
    | some rest =>
      have hEval : setElem? (x :: xs) (i + 1) v = some (x :: rest) := by
        change (match setElem? xs i v with | some rest => some (x :: rest) | none => none) = _
        rw [hs]
      rw [hEval] at h
      injection h with heq
      rw [← heq]
      exact @setElem?_getElem?_ne α xs rest i j v hs (fun eq => hne (congrArg Nat.succ eq))

private theorem setElem?_some_of_lt {α : Type} :
    ∀ (xs : List α) (i : Nat) (v : α),
      i < xs.length → ∃ xs', setElem? xs i v = some xs'
  | [], _, _, h => False.elim (Nat.not_lt_zero _ h)
  | _ :: xs, 0, v, _ => ⟨v :: xs, rfl⟩
  | x :: xs, i + 1, v, h => by
    let ⟨rest, hr⟩ := setElem?_some_of_lt xs i v (Nat.lt_of_succ_lt_succ h)
    refine ⟨x :: rest, ?_⟩
    change (match setElem? xs i v with | some r => some (x :: r) | none => none) = some (x :: rest)
    rw [hr]

private theorem setElem?_map {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat) (v : α),
      setElem? (xs.map f) i (f v) =
        match setElem? xs i v with
        | some xs' => some (xs'.map f)
        | none => none
  | [], _, _ => rfl
  | _ :: _, 0, _ => rfl
  | x :: xs, i + 1, v => by
    have ih := setElem?_map f xs i v
    change (match setElem? (xs.map f) i (f v) with | some r => some (f x :: r) | none => none) =
      match (match setElem? xs i v with | some r => some (x :: r) | none => none) with
      | some xs' => some (xs'.map f)
      | none => none
    rw [ih]
    cases setElem? xs i v <;> rfl

private theorem setElem?_append_left {α : Type} :
    ∀ {xs ys : List α} {i : Nat} {v : α} {xs' : List α},
      setElem? xs i v = some xs' →
      setElem? (xs ++ ys) i v = some (xs' ++ ys)
  | [], _, _, _, _, h => by cases h
  | _ :: _, _, 0, _, _, h => by injection h with heq; rw [← heq]; rfl
  | x :: xs, ys, i + 1, v, _, h => by
    cases hs : setElem? xs i v with
    | none =>
      have hEval : setElem? (x :: xs) (i + 1) v = none := by
        change (match setElem? xs i v with | some r => some (x :: r) | none => none) = none
        rw [hs]
      rw [hEval] at h; cases h
    | some rest =>
      have hEval : setElem? (x :: xs) (i + 1) v = some (x :: rest) := by
        change (match setElem? xs i v with | some r => some (x :: r) | none => none) = _
        rw [hs]
      rw [hEval] at h
      injection h with heq
      rw [← heq]
      have ih := @setElem?_append_left α xs ys i v rest hs
      change (match setElem? (xs ++ ys) i v with | some r => some (x :: r) | none => none) =
        some (x :: (rest ++ ys))
      rw [ih]

private theorem setElem?_append_right {α : Type} :
    ∀ (xs : List α) {ys : List α} {j : Nat} {v : α} {ys' : List α},
      setElem? ys j v = some ys' →
      setElem? (xs ++ ys) (xs.length + j) v = some (xs ++ ys')
  | [], _, _, _, _, h => by dsimp [List.length]; rw [Nat.zero_add]; exact h
  | x :: xs, ys, j, v, ys', h => by
    dsimp [List.length]
    rw [Nat.succ_add]
    have ih := @setElem?_append_right α xs ys j v ys' h
    change (match setElem? (xs ++ ys) (xs.length + j) v with
      | some r => some (x :: r) | none => none) = some (x :: (xs ++ ys'))
    rw [ih]

private theorem listMapOption_length {α β : Type} {f : α → Option β} :
    ∀ {xs : List α} {ys : List β},
      listMapOption f xs = some ys → ys.length = xs.length
  | [], _, h => by dsimp [listMapOption] at h; injection h with heq; rw [← heq]; rfl
  | x :: xs, _, h => by
    dsimp [listMapOption] at h
    cases hfx : f x with
    | none => rw [hfx] at h; cases h
    | some y =>
      rw [hfx] at h
      cases hrest : listMapOption f xs with
      | none => rw [hrest] at h; cases h
      | some ys' =>
        rw [hrest] at h
        injection h with heq
        rw [← heq]
        exact congrArg Nat.succ (listMapOption_length hrest)

private theorem listMapOption_getElem? {α β : Type} {f : α → Option β} :
    ∀ {xs : List α} {ys : List β} (i : Nat),
      listMapOption f xs = some ys →
      match Trusted.MirSemantics.getElem? xs i, Trusted.MirSemantics.getElem? ys i with
      | none, none => True
      | some x, some y => f x = some y
      | _, _ => False
  | [], _, i, h => by
    dsimp [listMapOption] at h
    injection h with heq
    rw [← heq]
    cases i <;> exact True.intro
  | x :: xs, _, 0, h => by
    dsimp [listMapOption] at h
    cases hfx : f x with
    | none => rw [hfx] at h; cases h
    | some y =>
      rw [hfx] at h
      cases hrest : listMapOption f xs with
      | none => rw [hrest] at h; cases h
      | some ys' =>
        rw [hrest] at h
        injection h with heq
        rw [← heq]
        exact hfx
  | x :: xs, _, i + 1, h => by
    dsimp [listMapOption] at h
    cases hfx : f x with
    | none => rw [hfx] at h; cases h
    | some y =>
      rw [hfx] at h
      cases hrest : listMapOption f xs with
      | none => rw [hrest] at h; cases h
      | some ys' =>
        rw [hrest] at h
        injection h with heq
        rw [← heq]
        exact listMapOption_getElem? i hrest

private theorem listMapOption_to_embed {α β : Type} (g : β → α) (f : α → Option β)
    (hgf : ∀ {x y}, f x = some y → x = g y) :
    ∀ {xs : List α} {ys : List β},
      listMapOption f xs = some ys → xs = ys.map g
  | [], _, h => by dsimp [listMapOption] at h; injection h with heq; rw [← heq]; rfl
  | x :: xs, _, h => by
    dsimp [listMapOption] at h
    cases hfx : f x with
    | none => rw [hfx] at h; cases h
    | some y =>
      rw [hfx] at h
      cases hrest : listMapOption f xs with
      | none => rw [hrest] at h; cases h
      | some ys' =>
        rw [hrest] at h
        injection h with heq
        rw [← heq]
        dsimp [List.map]
        rw [hgf hfx, listMapOption_to_embed g f hgf hrest]

private theorem list_all_getElem? {α : Type} {p : α → Bool} :
    ∀ {xs : List α} {i : Nat} {x : α},
      xs.all p = true → Trusted.MirSemantics.getElem? xs i = some x → p x = true
  | [], _, _, _, hg => by cases hg
  | _ :: _, 0, _, ha, hg => by
    injection hg with heq; subst heq
    dsimp [List.all] at ha
    exact (bool_and_true ha).1
  | _ :: _, _ + 1, _, ha, hg => by
    dsimp [List.all] at ha
    exact list_all_getElem? (bool_and_true ha).2 hg

private theorem list_all_of_getElem? {α : Type} {p : α → Bool} :
    ∀ {xs : List α},
      (∀ i x, Trusted.MirSemantics.getElem? xs i = some x → p x = true) →
      xs.all p = true
  | [], _ => rfl
  | x :: xs, h => by
    dsimp [List.all]
    exact bool_and_intro (h 0 x rfl)
      (list_all_of_getElem? (fun i y hy => h (i + 1) y hy))

private theorem list_any_false_getElem? {α : Type} {p : α → Bool} :
    ∀ {xs : List α} {i : Nat} {x : α},
      xs.any p = false → Trusted.MirSemantics.getElem? xs i = some x → p x = false
  | [], _, _, _, hg => by cases hg
  | _ :: _, 0, _, ha, hg => by
    injection hg with heq; subst heq
    dsimp [List.any] at ha
    cases hpx : p _ with
    | false => rfl
    | true => rw [hpx] at ha; cases ha
  | x :: xs, i + 1, y, ha, hg => by
    dsimp [List.any] at ha
    cases hpx : p x with
    | true => rw [hpx] at ha; cases ha
    | false =>
      rw [hpx] at ha
      exact list_any_false_getElem? ha hg

private theorem list_any_map {α β : Type} (f : α → β) (p : β → Bool) :
    ∀ (xs : List α), (xs.map f).any p = xs.any (fun x => p (f x))
  | [] => rfl
  | x :: xs => by dsimp [List.map, List.any]; rw [list_any_map f p xs]

private theorem list_all_append {α : Type} (p : α → Bool) :
    ∀ (xs ys : List α), (xs ++ ys).all p = (xs.all p && ys.all p)
  | [], ys => by dsimp [List.all]; cases ys.all p <;> rfl
  | x :: xs, ys => by
    dsimp [List.all]
    rw [list_all_append p xs ys]
    cases p x <;> cases xs.all p <;> cases ys.all p <;> rfl

private theorem list_all_map {α β : Type} (f : α → β) (p : β → Bool) :
    ∀ (xs : List α), (xs.map f).all p = xs.all (fun x => p (f x))
  | [] => rfl
  | x :: xs => by dsimp [List.map, List.all]; rw [list_all_map f p xs]

/-! ### Constructive Determinism & Stuttering Simulation Combinators in `M_enum` & `Trusted.MirSemantics` (`0` `Classical.choice`) -/

private theorem reachesEnum_trans {p : EnumProgram} {s₁ s₂ s₃ : EnumState}
    (h12 : ReachesEnum p s₁ s₂) (h23 : ReachesEnum p s₂ s₃) :
    ReachesEnum p s₁ s₃ := by
  induction h23 with
  | refl => exact h12
  | tail _ hSt ih => exact ReachesEnum.tail ih hSt

private theorem c_reachesEnum_head_det {p : EnumProgram} {s₁ s₂ s₃ : EnumState}
    (hStep : evalStepEnum p 0 s₁ = .step s₂)
    (hRest : ReachesEnum p s₂ s₃) :
    ReachesEnum p s₁ s₃ :=
  reachesEnum_trans (ReachesEnum.tail (ReachesEnum.refl s₁) ⟨0, rfl, hStep⟩) hRest

private noncomputable def stepOrSelfEnum (p : EnumProgram) (s : EnumState) : EnumState :=
  match evalStepEnum p 0 s with
  | .step s' => s'
  | _ => s

private noncomputable def iterEnum (p : EnumProgram) (s₀ : EnumState) : Nat → EnumState
  | 0 => s₀
  | n + 1 => stepOrSelfEnum p (iterEnum p s₀ n)

private inductive ReachesNEnum (p : EnumProgram) :
    Nat → EnumState → EnumState → Prop where
  | zero (s : EnumState) : ReachesNEnum p 0 s s
  | succ {n : Nat} {s₁ s₂ s₃ : EnumState} :
      evalStepEnum p 0 s₁ = .step s₂ →
      ReachesNEnum p n s₂ s₃ →
      ReachesNEnum p (n + 1) s₁ s₃

private noncomputable def ReachesPlusEnum (p : EnumProgram) (s₁ s₂ : EnumState) : Prop :=
  ∃ n : Nat, ReachesNEnum p (n + 1) s₁ s₂

private theorem reachesNEnum_to_reachesEnum {p : EnumProgram} :
    ∀ {n : Nat} {s₁ s₂ : EnumState},
      ReachesNEnum p n s₁ s₂ → ReachesEnum p s₁ s₂
  | 0, s, _, .zero _ => ReachesEnum.refl s
  | _ + 1, _, _, .succ hStep hRest =>
    c_reachesEnum_head_det hStep (reachesNEnum_to_reachesEnum hRest)

private theorem reachesNEnum_trans {p : EnumProgram} :
    ∀ {n m : Nat} {s₁ s₂ s₃ : EnumState},
      ReachesNEnum p n s₁ s₂ →
      ReachesNEnum p m s₂ s₃ →
      ReachesNEnum p (n + m) s₁ s₃
  | 0, _, _, _, _, .zero _, h2 => by rw [Nat.zero_add]; exact h2
  | n + 1, m, _, _, _, .succ hStep h1, h2 => by
    rw [Nat.succ_add]
    exact ReachesNEnum.succ hStep (reachesNEnum_trans h1 h2)

private theorem reachesEnum_to_reachesNEnum {p : EnumProgram} {s₁ s₂ : EnumState}
    (h : ReachesEnum p s₁ s₂) : ∃ n, ReachesNEnum p n s₁ s₂ := by
  induction h with
  | refl => exact ⟨0, ReachesNEnum.zero _⟩
  | tail _ hStep ih =>
    let ⟨n, hn⟩ := ih
    let ⟨c, hc, hEv⟩ := hStep
    cases hc
    exact ⟨n + 1, reachesNEnum_trans hn (ReachesNEnum.succ hEv (ReachesNEnum.zero _))⟩

private theorem reachesNEnum_det_split {p : EnumProgram} {t : EnumState}
    (hNoStepT : ∀ s', evalStepEnum p 0 t ≠ .step s') :
    ∀ {d m : Nat} {s s₁ : EnumState},
      ReachesNEnum p d s s₁ →
      ReachesNEnum p m s t →
      d ≤ m ∧ ReachesNEnum p (m - d) s₁ t
  | 0, m, _, _, .zero _, hM => ⟨Nat.zero_le m, hM⟩
  | _ + 1, 0, _, _, .succ hStep _, .zero _ =>
    False.elim (hNoStepT _ hStep)
  | d + 1, m + 1, _, _, .succ hStepD hD, .succ hStepM hM => by
    rw [hStepD] at hStepM
    injection hStepM with hEq
    subst hEq
    let ⟨hLe, hRem⟩ := reachesNEnum_det_split hNoStepT hD hM
    rw [Nat.succ_sub_succ]
    exact ⟨Nat.succ_le_succ hLe, hRem⟩

private theorem reachesNEnum_terminal_unique {p : EnumProgram} {s t₁ t₂ : EnumState}
    {r₁ r₂ : StepResult EnumState TerminalOut}
    (hNoStep1 : ∀ s', r₁ ≠ .step s')
    (hNoStep2 : ∀ s', r₂ ≠ .step s')
    (h1 : ∃ n₁, ReachesNEnum p n₁ s t₁)
    (hEv1 : evalStepEnum p 0 t₁ = r₁)
    (h2 : ∃ n₂, ReachesNEnum p n₂ s t₂)
    (hEv2 : evalStepEnum p 0 t₂ = r₂) :
    r₁ = r₂ := by
  let ⟨n₁, hn₁⟩ := h1
  let ⟨n₂, hn₂⟩ := h2
  have hNS1 : ∀ s', evalStepEnum p 0 t₁ ≠ .step s' :=
    fun s' h => hNoStep1 s' (hEv1.symm.trans h)
  have hNS2 : ∀ s', evalStepEnum p 0 t₂ ≠ .step s' :=
    fun s' h => hNoStep2 s' (hEv2.symm.trans h)
  let ⟨hLe1, hRem1⟩ := reachesNEnum_det_split hNS2 hn₁ hn₂
  let ⟨hLe2, _⟩ := reachesNEnum_det_split hNS1 hn₂ hn₁
  have hEqN : n₂ - n₁ = 0 := by
    have hEq : n₁ = n₂ := Nat.le_antisymm hLe1 hLe2
    rw [hEq, Nat.sub_self]
  rw [hEqN] at hRem1
  cases hRem1
  exact hEv1.symm.trans hEv2

private theorem stepChainFromEnum_of_reachesNEnum {p : EnumProgram} :
    ∀ {n : Nat} {s₁ s₂ : EnumState},
      ReachesNEnum p n s₁ s₂ →
      ∀ {k : Nat} {sEnd : EnumState},
        stepChainFromEnum p (n + k) s₁ = some sEnd →
        stepChainFromEnum p k s₂ = some sEnd
  | 0, _, _, .zero _, k, _, h => by rw [Nat.zero_add] at h; exact h
  | n + 1, s₁, s₂, .succ hStep hRest, k, sEnd, h => by
    rw [Nat.succ_add] at h
    unfold stepChainFromEnum at h
    rw [hStep] at h
    exact stepChainFromEnum_of_reachesNEnum hRest h

private theorem divergesEnum_iff_no_terminal_or_fault (p : EnumProgram) (q : Query) :
    DivergesEnum p q ↔
      (∃ s₀, initStateEnum p q = .ok s₀) ∧
      (∀ k : FaultKind, ¬ ReachesResultEnum p q (.fault k)) ∧
      (∀ out : TerminalOut, ¬ BehaviorEnum p q out) := by
  constructor
  · intro ⟨s₀, hInit, hChain⟩
    refine ⟨⟨s₀, hInit⟩, ?_, ?_⟩
    · intro k hF
      unfold ReachesResultEnum at hF
      rw [hInit] at hF
      let ⟨s, hR, ⟨c, hc, hEv⟩⟩ := hF
      cases hc
      let ⟨n, hn⟩ := reachesEnum_to_reachesNEnum hR
      let ⟨sEnd, hC⟩ := hChain (n + 1)
      have hSub := stepChainFromEnum_of_reachesNEnum hn hC
      unfold stepChainFromEnum at hSub
      rw [hEv] at hSub
      cases hSub
    · intro out hB
      unfold BehaviorEnum ReachesResultEnum at hB
      rw [hInit] at hB
      let ⟨s, hR, ⟨c, hc, hEv⟩⟩ := hB
      cases hc
      let ⟨n, hn⟩ := reachesEnum_to_reachesNEnum hR
      let ⟨sEnd, hC⟩ := hChain (n + 1)
      have hSub := stepChainFromEnum_of_reachesNEnum hn hC
      unfold stepChainFromEnum at hSub
      rw [hEv] at hSub
      cases hSub
  · intro ⟨⟨s₀, hInit⟩, hNoF, hNoB⟩
    have hChain : ∀ n : Nat, ∀ s : EnumState,
        ReachesEnum p s₀ s → ∃ sₙ, stepChainFromEnum p n s = some sₙ := by
      intro n
      induction n with
      | zero =>
        intro s _; exact ⟨s, rfl⟩
      | succ m ih =>
        intro s hR
        unfold stepChainFromEnum
        cases hEv : evalStepEnum p 0 s with
        | fault fk =>
          exact False.elim (hNoF fk (by
            unfold ReachesResultEnum; rw [hInit]
            exact ⟨s, hR, ⟨0, rfl, hEv⟩⟩))
        | done out =>
          exact False.elim (hNoB out (by
            unfold BehaviorEnum ReachesResultEnum; rw [hInit]
            exact ⟨s, hR, ⟨0, rfl, hEv⟩⟩))
        | step s' =>
          exact ih s' (ReachesEnum.tail hR ⟨0, rfl, hEv⟩)
    exact ⟨s₀, hInit, fun n => hChain n s₀ (ReachesEnum.refl s₀)⟩

private theorem wellFormedEnum_iff_no_fault (p : EnumProgram) (q : Query) :
    WellFormedEnum p q ↔ ∀ k : FaultKind, ¬ ReachesResultEnum p q (.fault k) := by
  constructor
  · intro hWf; exact hWf.2
  · intro hNoF
    refine ⟨?_, hNoF⟩
    cases hInit : initStateEnum p q with
    | error k =>
      exact False.elim (hNoF k (by unfold ReachesResultEnum; rw [hInit]))
    | ok s₀ =>
      exact ⟨s₀, rfl, fun _ _ => ⟨0, rfl⟩⟩

private theorem fullSemanticEquivEnum_of_outcomes {p₁ p₂ : EnumProgram}
    (hFault : ∀ q k,
      ReachesResultEnum p₁ q (.fault k) ↔ ReachesResultEnum p₂ q (.fault k))
    (hBeh : ∀ q out, BehaviorEnum p₁ q out ↔ BehaviorEnum p₂ q out) :
    FullSemanticEquivEnum p₁ p₂ := by
  have hWf : ∀ q, WellFormedEnum p₁ q ↔ WellFormedEnum p₂ q := by
    intro q
    rw [wellFormedEnum_iff_no_fault, wellFormedEnum_iff_no_fault]
    exact ⟨fun h k hf2 => h k ((hFault q k).mpr hf2),
           fun h k hf1 => h k ((hFault q k).mp hf1)⟩
  have hDiv : ∀ q, DivergesEnum p₁ q ↔ DivergesEnum p₂ q := by
    intro q
    rw [divergesEnum_iff_no_terminal_or_fault, divergesEnum_iff_no_terminal_or_fault]
    constructor
    · intro ⟨_, hNoF1, hNoB1⟩
      have hNoF2 : ∀ k, ¬ ReachesResultEnum p₂ q (.fault k) :=
        fun k hf2 => hNoF1 k ((hFault q k).mpr hf2)
      have hInit2 : ∃ s₀, initStateEnum p₂ q = .ok s₀ := by
        cases hI : initStateEnum p₂ q with
        | error k => exact False.elim (hNoF2 k (by unfold ReachesResultEnum; rw [hI]))
        | ok s₀ => exact ⟨s₀, rfl⟩
      exact ⟨hInit2, hNoF2, fun out hb2 => hNoB1 out ((hBeh q out).mpr hb2)⟩
    · intro ⟨_, hNoF2, hNoB2⟩
      have hNoF1 : ∀ k, ¬ ReachesResultEnum p₁ q (.fault k) :=
        fun k hf1 => hNoF2 k ((hFault q k).mp hf1)
      have hInit1 : ∃ s₀, initStateEnum p₁ q = .ok s₀ := by
        cases hI : initStateEnum p₁ q with
        | error k => exact False.elim (hNoF1 k (by unfold ReachesResultEnum; rw [hI]))
        | ok s₀ => exact ⟨s₀, rfl⟩
      exact ⟨hInit1, hNoF1, fun out hb1 => hNoB2 out ((hBeh q out).mp hb1)⟩
  have hPost : ∀ q post, SatisfiesPostEnum p₁ q post ↔ SatisfiesPostEnum p₂ q post := by
    intro q post
    unfold SatisfiesPostEnum
    constructor
    · intro ⟨hw1, hp1⟩
      exact ⟨(hWf q).mp hw1, fun out hb2 => hp1 out ((hBeh q out).mpr hb2)⟩
    · intro ⟨hw2, hp2⟩
      exact ⟨(hWf q).mpr hw2, fun out hb1 => hp2 out ((hBeh q out).mp hb1)⟩
  exact ⟨hWf, hBeh, hFault, hDiv, hPost⟩

private theorem fwd_stutter_sim_reachesEnum {p₁ p₂ : EnumProgram}
    (R : EnumState → EnumState → Prop)
    (hStep : ∀ s₁ s₂ s₁', R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .step s₁' →
      ∃ s₂', ReachesPlusEnum p₂ s₂ s₂' ∧ R s₁' s₂') :
    ∀ {s₁ t₁ s₂ : EnumState},
      ReachesEnum p₁ s₁ t₁ → R s₁ s₂ →
      ∃ t₂, ReachesEnum p₂ s₂ t₂ ∧ R t₁ t₂ := by
  intro s₁ t₁ s₂ hR hRel
  induction hR with
  | refl => exact ⟨s₂, ReachesEnum.refl s₂, hRel⟩
  | tail _ hSt ih =>
    let ⟨mid₂, hR2, hRelMid⟩ := ih
    let ⟨c, hc, hEv⟩ := hSt
    cases hc
    let ⟨t₂, ⟨d, hd⟩, hRelT⟩ := hStep _ mid₂ _ hRelMid hEv
    exact ⟨t₂, reachesEnum_trans hR2 (reachesNEnum_to_reachesEnum hd), hRelT⟩

private theorem fwd_stutter_sim_reflect_terminalEnum {p₁ p₂ : EnumProgram}
    (R : EnumState → EnumState → Prop)
    (hStep : ∀ s₁ s₂ s₁', R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .step s₁' →
      ∃ s₂', ReachesPlusEnum p₂ s₂ s₂' ∧ R s₁' s₂')
    (hDone : ∀ s₁ s₂ out, R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .done out →
      ∃ s₂', ReachesEnum p₂ s₂ s₂' ∧ evalStepEnum p₂ 0 s₂' = .done out)
    (hFault : ∀ s₁ s₂ k, R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .fault k →
      ∃ s₂', ReachesEnum p₂ s₂ s₂' ∧ evalStepEnum p₂ 0 s₂' = .fault k)
    {t₂ : EnumState} {r : StepResult EnumState TerminalOut}
    (hNoStepR : ∀ x, r ≠ .step x)
    (hEvT2 : evalStepEnum p₂ 0 t₂ = r) :
    ∀ (n m : Nat), m ≤ n →
      ∀ {s₁ s₂ : EnumState},
        R s₁ s₂ →
        ReachesNEnum p₂ m s₂ t₂ →
        ∃ t₁, ReachesEnum p₁ s₁ t₁ ∧ evalStepEnum p₁ 0 t₁ = r := by
  intro n
  induction n with
  | zero =>
    intro m hm s₁ s₂ hRel hRm
    have hM0 : m = 0 := Nat.le_zero.mp hm
    subst hM0
    cases hEv1 : evalStepEnum p₁ 0 s₁ with
    | done out' =>
      let ⟨t₂', hR2', hEv2'⟩ := hDone s₁ s₂ out' hRel hEv1
      have hEq := reachesNEnum_terminal_unique
        (fun x h => by cases h) hNoStepR
        (reachesEnum_to_reachesNEnum hR2') hEv2' ⟨0, hRm⟩ hEvT2
      exact ⟨s₁, ReachesEnum.refl s₁, hEv1.trans hEq⟩
    | fault k' =>
      let ⟨t₂', hR2', hEv2'⟩ := hFault s₁ s₂ k' hRel hEv1
      have hEq := reachesNEnum_terminal_unique
        (fun x h => by cases h) hNoStepR
        (reachesEnum_to_reachesNEnum hR2') hEv2' ⟨0, hRm⟩ hEvT2
      exact ⟨s₁, ReachesEnum.refl s₁, hEv1.trans hEq⟩
    | step s₁' =>
      let ⟨_, ⟨d, hd⟩, _⟩ := hStep s₁ s₂ s₁' hRel hEv1
      have hNST2 : ∀ x, evalStepEnum p₂ 0 t₂ ≠ .step x :=
        fun x h => hNoStepR x (hEvT2.symm.trans h)
      let ⟨hLe, _⟩ := reachesNEnum_det_split hNST2 hd hRm
      exact False.elim (Nat.not_succ_le_zero d hLe)
  | succ n ih =>
    intro m hm s₁ s₂ hRel hRm
    cases hEv1 : evalStepEnum p₁ 0 s₁ with
    | done out' =>
      let ⟨t₂', hR2', hEv2'⟩ := hDone s₁ s₂ out' hRel hEv1
      have hEq := reachesNEnum_terminal_unique
        (fun x h => by cases h) hNoStepR
        (reachesEnum_to_reachesNEnum hR2') hEv2' ⟨m, hRm⟩ hEvT2
      exact ⟨s₁, ReachesEnum.refl s₁, hEv1.trans hEq⟩
    | fault k' =>
      let ⟨t₂', hR2', hEv2'⟩ := hFault s₁ s₂ k' hRel hEv1
      have hEq := reachesNEnum_terminal_unique
        (fun x h => by cases h) hNoStepR
        (reachesEnum_to_reachesNEnum hR2') hEv2' ⟨m, hRm⟩ hEvT2
      exact ⟨s₁, ReachesEnum.refl s₁, hEv1.trans hEq⟩
    | step s₁' =>
      let ⟨_, ⟨d, hd⟩, hRel'⟩ := hStep s₁ s₂ s₁' hRel hEv1
      have hNST2 : ∀ x, evalStepEnum p₂ 0 t₂ ≠ .step x :=
        fun x h => hNoStepR x (hEvT2.symm.trans h)
      let ⟨_, hRem⟩ := reachesNEnum_det_split hNST2 hd hRm
      have hSubLe : m - (d + 1) ≤ n := by
        have h1 : m ≤ n + (d + 1) :=
          Nat.le_trans hm (Nat.add_le_add_left (Nat.succ_le_succ (Nat.zero_le d)) n)
        exact Nat.sub_le_of_le_add h1
      let ⟨t₁, hR1', hEvT1⟩ := ih (m - (d + 1)) hSubLe hRel' hRem
      exact ⟨t₁, c_reachesEnum_head_det hEv1 hR1', hEvT1⟩

private theorem fullSemanticEquivEnum_of_fwd_stutter_sim {p₁ p₂ : EnumProgram}
    (R : EnumState → EnumState → Prop)
    (hInitErr : ∀ q k, initStateEnum p₁ q = .error k ↔ initStateEnum p₂ q = .error k)
    (hInitOk : ∀ q s₁ s₂,
      initStateEnum p₁ q = .ok s₁ → initStateEnum p₂ q = .ok s₂ → R s₁ s₂)
    (hStep : ∀ s₁ s₂ s₁', R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .step s₁' →
      ∃ s₂', ReachesPlusEnum p₂ s₂ s₂' ∧ R s₁' s₂')
    (hDone : ∀ s₁ s₂ out, R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .done out →
      ∃ s₂', ReachesEnum p₂ s₂ s₂' ∧ evalStepEnum p₂ 0 s₂' = .done out)
    (hFault : ∀ s₁ s₂ k, R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .fault k →
      ∃ s₂', ReachesEnum p₂ s₂ s₂' ∧ evalStepEnum p₂ 0 s₂' = .fault k) :
    FullSemanticEquivEnum p₁ p₂ := by
  have hRes : ∀ q (r : StepResult EnumState TerminalOut),
      (∀ x, r ≠ .step x) →
      (ReachesResultEnum p₁ q r ↔ ReachesResultEnum p₂ q r) := by
    intro q r hNoStep
    unfold ReachesResultEnum
    cases hI1 : initStateEnum p₁ q with
    | error k₁ =>
      have hI2 : initStateEnum p₂ q = .error k₁ := (hInitErr q k₁).mp hI1
      rw [hI2]
    | ok s₁ =>
      cases hI2 : initStateEnum p₂ q with
      | error k₂ =>
        have hI1' : initStateEnum p₁ q = .error k₂ := (hInitErr q k₂).mpr hI2
        rw [hI1] at hI1'
        cases hI1'
      | ok s₂ =>
        have hRel0 : R s₁ s₂ := hInitOk q s₁ s₂ hI1 hI2
        constructor
        · intro ⟨t₁, hR1, ⟨c, hc, hEv1⟩⟩
          cases hc
          let ⟨t₂, hR2, hRelT⟩ := fwd_stutter_sim_reachesEnum R hStep hR1 hRel0
          cases r with
          | step x => exact False.elim (hNoStep x rfl)
          | done out =>
            let ⟨t₂', hR2', hEv2'⟩ := hDone t₁ t₂ out hRelT hEv1
            exact ⟨t₂', reachesEnum_trans hR2 hR2', ⟨0, rfl, hEv2'⟩⟩
          | fault k =>
            let ⟨t₂', hR2', hEv2'⟩ := hFault t₁ t₂ k hRelT hEv1
            exact ⟨t₂', reachesEnum_trans hR2 hR2', ⟨0, rfl, hEv2'⟩⟩
        · intro ⟨t₂, hR2, ⟨c, hc, hEv2⟩⟩
          cases hc
          let ⟨n, hn⟩ := reachesEnum_to_reachesNEnum hR2
          let ⟨t₁, hR1, hEv1⟩ :=
            fwd_stutter_sim_reflect_terminalEnum R hStep hDone hFault
              hNoStep hEv2 n n (Nat.le_refl n) hRel0 hn
          exact ⟨t₁, hR1, ⟨0, rfl, hEv1⟩⟩
  exact fullSemanticEquivEnum_of_outcomes
    (fun q k => hRes q (.fault k) (fun _ h => by cases h))
    (fun q out => hRes q (.done out) (fun _ h => by cases h))

private theorem fullSemanticEquivEnum_of_lockstep {p₁ p₂ : EnumProgram}
    (R : EnumState → EnumState → Prop)
    (hInitErr : ∀ q k, initStateEnum p₁ q = .error k ↔ initStateEnum p₂ q = .error k)
    (hInitOk : ∀ q s₁ s₂,
      initStateEnum p₁ q = .ok s₁ → initStateEnum p₂ q = .ok s₂ → R s₁ s₂)
    (hStep : ∀ s₁ s₂ s₁', R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .step s₁' →
      ∃ s₂', evalStepEnum p₂ 0 s₂ = .step s₂' ∧ R s₁' s₂')
    (hDone : ∀ s₁ s₂ out, R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .done out →
      evalStepEnum p₂ 0 s₂ = .done out)
    (hFault : ∀ s₁ s₂ k, R s₁ s₂ →
      evalStepEnum p₁ 0 s₁ = .fault k →
      evalStepEnum p₂ 0 s₂ = .fault k) :
    FullSemanticEquivEnum p₁ p₂ :=
  fullSemanticEquivEnum_of_fwd_stutter_sim R hInitErr hInitOk
    (fun s₁ s₂ s₁' hRel hEv =>
      let ⟨s₂', hEv2, hRel'⟩ := hStep s₁ s₂ s₁' hRel hEv
      ⟨s₂', ⟨0, ReachesNEnum.succ hEv2 (ReachesNEnum.zero s₂')⟩, hRel'⟩)
    (fun s₁ s₂ out hRel hEv =>
      ⟨s₂, ReachesEnum.refl s₂, hDone s₁ s₂ out hRel hEv⟩)
    (fun s₁ s₂ k hRel hEv =>
      ⟨s₂, ReachesEnum.refl s₂, hFault s₁ s₂ k hRel hEv⟩)

private theorem fullSemanticEquivEnum_refl (p : EnumProgram) :
    FullSemanticEquivEnum p p :=
  ⟨fun _ => Iff.rfl, fun _ _ => Iff.rfl, fun _ _ => Iff.rfl,
   fun _ => Iff.rfl, fun _ _ => Iff.rfl⟩

private theorem fullSemanticEquivEnum_trans {p₁ p₂ p₃ : EnumProgram}
    (h12 : FullSemanticEquivEnum p₁ p₂)
    (h23 : FullSemanticEquivEnum p₂ p₃) :
    FullSemanticEquivEnum p₁ p₃ :=
  ⟨fun q => (h12.1 q).trans (h23.1 q),
   fun q out => (h12.2.1 q out).trans (h23.2.1 q out),
   fun q k => (h12.2.2.1 q k).trans (h23.2.2.1 q k),
   fun q => (h12.2.2.2.1 q).trans (h23.2.2.2.1 q),
   fun q post => (h12.2.2.2.2 q post).trans (h23.2.2.2.2 q post)⟩

/-! ### Constructive Determinism on Unmodified `Trusted.MirSemantics` (`Diverges` & `WellFormed`) -/

private noncomputable def stepOrSelfBase (p : Program) (s : State) : State :=
  match evalStep p 0 s with
  | .step s' => s'
  | _ => s

private noncomputable def iterBase (p : Program) (s₀ : State) : Nat → State
  | 0 => s₀
  | n + 1 => stepOrSelfBase p (iterBase p s₀ n)

private inductive ReachesNBase (p : Program) : Nat → State → State → Prop where
  | zero (s : State) : ReachesNBase p 0 s s
  | succ {n : Nat} {s₁ s₂ s₃ : State} :
      evalStep p 0 s₁ = .step s₂ →
      ReachesNBase p n s₂ s₃ →
      ReachesNBase p (n + 1) s₁ s₃

private theorem evalStepBase_choice_irrel (p : Program) (c : Choice) (s : State) :
    evalStep p c s = evalStep p 0 s := rfl

private theorem reachesNBase_trans {p : Program} :
    ∀ {n m : Nat} {s₁ s₂ s₃ : State},
      ReachesNBase p n s₁ s₂ →
      ReachesNBase p m s₂ s₃ →
      ReachesNBase p (n + m) s₁ s₃
  | 0, _, _, _, _, .zero _, h2 => by rw [Nat.zero_add]; exact h2
  | n + 1, m, _, _, _, .succ hStep h1, h2 => by
    rw [Nat.succ_add]
    exact ReachesNBase.succ hStep (reachesNBase_trans h1 h2)

private theorem reachesBase_to_reachesNBase {p : Program} {s₁ s₂ : State}
    (h : Reaches p s₁ s₂) : ∃ n, ReachesNBase p n s₁ s₂ := by
  induction h with
  | refl => exact ⟨0, ReachesNBase.zero _⟩
  | tail _ hStep ih =>
    let ⟨n, hn⟩ := ih
    let ⟨c, _, hEv⟩ := hStep
    rw [evalStepBase_choice_irrel p c] at hEv
    exact ⟨n + 1, reachesNBase_trans hn (ReachesNBase.succ hEv (ReachesNBase.zero _))⟩

private theorem reachesNBase_eq_trace {p : Program} {s₀ : State}
    {tr : Nat → State} (h0 : tr 0 = s₀)
    (hTr : ∀ n, Step p (tr n) (.step (tr (n + 1)))) :
    ∀ {n : Nat} {s : State}, ReachesNBase p n s₀ s → s = tr n
  | 0, _, .zero _ => h0.symm
  | _ + 1, _, .succ hStep hRest => by
    have hAt0 : evalStep p 0 s₀ = .step (tr 1) := by
      let ⟨c, _, hEv⟩ := hTr 0
      rw [evalStepBase_choice_irrel p c, h0] at hEv
      exact hEv
    rw [hAt0] at hStep
    injection hStep with hEq1
    subst hEq1
    exact reachesNBase_eq_trace (tr := fun k => tr (k + 1)) rfl
      (fun k => hTr (k + 1)) hRest

private theorem divergesBase_iff_no_terminal_or_fault (p : Program) (q : Query) :
    Diverges p q ↔
      (∃ s₀, initState p q = .ok s₀) ∧
      (∀ k : FaultKind, ¬ ReachesResult p q (.fault k)) ∧
      (∀ out : TerminalOut, ¬ Behavior p q out) := by
  constructor
  · intro ⟨s₀, hInit, tr, h0, hTr⟩
    refine ⟨⟨s₀, hInit⟩, ?_, ?_⟩
    · intro k hF
      have hF' : match initState p q with
          | .error k' => StepResult.fault k = .fault k'
          | .ok s₀ => ∃ s, Reaches p s₀ s ∧ Step p s (.fault k) := hF
      rw [hInit] at hF'
      let ⟨s, hR, ⟨c, _, hEv⟩⟩ := hF'
      rw [evalStepBase_choice_irrel p c] at hEv
      let ⟨n, hn⟩ := reachesBase_to_reachesNBase hR
      have hsEq := reachesNBase_eq_trace h0 hTr hn
      subst hsEq
      let ⟨c', _, hEv'⟩ := hTr n
      rw [evalStepBase_choice_irrel p c'] at hEv'
      rw [hEv'] at hEv
      cases hEv
    · intro out hB
      have hB' : match initState p q with
          | .error k' => StepResult.done out = .fault k'
          | .ok s₀ => ∃ s, Reaches p s₀ s ∧ Step p s (.done out) := hB
      rw [hInit] at hB'
      let ⟨s, hR, ⟨c, _, hEv⟩⟩ := hB'
      rw [evalStepBase_choice_irrel p c] at hEv
      let ⟨n, hn⟩ := reachesBase_to_reachesNBase hR
      have hsEq := reachesNBase_eq_trace h0 hTr hn
      subst hsEq
      let ⟨c', _, hEv'⟩ := hTr n
      rw [evalStepBase_choice_irrel p c'] at hEv'
      rw [hEv'] at hEv
      cases hEv
  · intro ⟨⟨s₀, hInit⟩, hNoF, hNoB⟩
    have hIter : ∀ n, Reaches p s₀ (iterBase p s₀ n) ∧
        Step p (iterBase p s₀ n) (.step (iterBase p s₀ (n + 1))) := by
      intro n
      induction n with
      | zero =>
        refine ⟨Reaches.refl s₀, ?_⟩
        dsimp [iterBase, stepOrSelfBase]
        cases hEv : evalStep p 0 s₀ with
        | fault k =>
          exact False.elim (hNoF k (by
            change (match initState p q with | .error k' => _ | .ok s => _)
            rw [hInit]
            exact ⟨s₀, Reaches.refl s₀, ⟨0, rfl, hEv⟩⟩))
        | done out =>
          exact False.elim (hNoB out (by
            change (match initState p q with | .error k' => _ | .ok s => _)
            rw [hInit]
            exact ⟨s₀, Reaches.refl s₀, ⟨0, rfl, hEv⟩⟩))
        | step s₁ => exact ⟨0, rfl, hEv⟩
      | succ k ih =>
        have hRNext : Reaches p s₀ (iterBase p s₀ (k + 1)) :=
          Reaches.tail ih.1 ih.2
        refine ⟨hRNext, ?_⟩
        cases hEv : evalStep p 0 (iterBase p s₀ (k + 1)) with
        | fault fk =>
          exact False.elim (hNoF fk (by
            change (match initState p q with | .error k' => _ | .ok s => _)
            rw [hInit]
            exact ⟨_, hRNext, ⟨0, rfl, hEv⟩⟩))
        | done out =>
          exact False.elim (hNoB out (by
            change (match initState p q with | .error k' => _ | .ok s => _)
            rw [hInit]
            exact ⟨_, hRNext, ⟨0, rfl, hEv⟩⟩))
        | step s' =>
          have hNextEq : iterBase p s₀ (k + 1 + 1) = s' := by
            change stepOrSelfBase p (iterBase p s₀ (k + 1)) = s'
            unfold stepOrSelfBase
            rw [hEv]
          rw [hNextEq]
          exact ⟨0, rfl, hEv⟩
    exact ⟨s₀, hInit, iterBase p s₀, rfl, fun n => (hIter n).2⟩

private theorem wellFormedBase_iff_no_fault (p : Program) (q : Query) :
    WellFormed p q ↔ ∀ k : FaultKind, ¬ ReachesResult p q (.fault k) := by
  constructor
  · intro hWf; exact hWf.2
  · intro hNoF
    refine ⟨?_, hNoF⟩
    cases hInit : initState p q with
    | error k =>
      exact False.elim (hNoF k (by
        change (match initState p q with | .error k' => StepResult.fault k = .fault k' | .ok s => _)
        rw [hInit]))
    | ok s₀ =>
      exact ⟨s₀, rfl, fun _ _ => ⟨0, rfl⟩⟩

private theorem equivEnumToBase_of_outcomes {pE : EnumProgram} {pB : Program}
    (hFault : ∀ q k,
      ReachesResultEnum pE q (.fault k) ↔ ReachesResult pB q (.fault k))
    (hBeh : ∀ q out, BehaviorEnum pE q out ↔ Behavior pB q out) :
    (∀ q : Query, WellFormedEnum pE q ↔ WellFormed pB q) ∧
    (∀ q : Query, ∀ out : TerminalOut,
      BehaviorEnum pE q out ↔ Behavior pB q out) ∧
    (∀ q : Query, ∀ k : FaultKind,
      ReachesResultEnum pE q (.fault k) ↔ ReachesResult pB q (.fault k)) ∧
    (∀ q : Query, DivergesEnum pE q ↔ Diverges pB q) ∧
    (∀ q : Query, ∀ post : TerminalOut → Prop,
      SatisfiesPostEnum pE q post ↔ SatisfiesPost pB q post) := by
  have hWf : ∀ q, WellFormedEnum pE q ↔ WellFormed pB q := by
    intro q
    rw [wellFormedEnum_iff_no_fault, wellFormedBase_iff_no_fault]
    exact ⟨fun h k hf2 => h k ((hFault q k).mpr hf2),
           fun h k hf1 => h k ((hFault q k).mp hf1)⟩
  have hDiv : ∀ q, DivergesEnum pE q ↔ Diverges pB q := by
    intro q
    rw [divergesEnum_iff_no_terminal_or_fault, divergesBase_iff_no_terminal_or_fault]
    constructor
    · intro ⟨_, hNoF1, hNoB1⟩
      have hNoF2 : ∀ k, ¬ ReachesResult pB q (.fault k) :=
        fun k hf2 => hNoF1 k ((hFault q k).mpr hf2)
      have hInit2 : ∃ s₀, initState pB q = .ok s₀ := by
        cases hI : initState pB q with
        | error k =>
          exact False.elim (hNoF2 k (by
            change (match initState pB q with | .error k' => StepResult.fault k = .fault k' | .ok s => _)
            rw [hI]))
        | ok s₀ => exact ⟨s₀, rfl⟩
      exact ⟨hInit2, hNoF2, fun out hb2 => hNoB1 out ((hBeh q out).mpr hb2)⟩
    · intro ⟨_, hNoF2, hNoB2⟩
      have hNoF1 : ∀ k, ¬ ReachesResultEnum pE q (.fault k) :=
        fun k hf1 => hNoF2 k ((hFault q k).mp hf1)
      have hInit1 : ∃ s₀, initStateEnum pE q = .ok s₀ := by
        cases hI : initStateEnum pE q with
        | error k => exact False.elim (hNoF1 k (by unfold ReachesResultEnum; rw [hI]))
        | ok s₀ => exact ⟨s₀, rfl⟩
      exact ⟨hInit1, hNoF1, fun out hb1 => hNoB2 out ((hBeh q out).mp hb1)⟩
  have hPost : ∀ q post, SatisfiesPostEnum pE q post ↔ SatisfiesPost pB q post := by
    intro q post
    constructor
    · intro ⟨hw1, hp1⟩
      exact ⟨(hWf q).mp hw1, fun out hb2 => hp1 out ((hBeh q out).mpr hb2)⟩
    · intro ⟨hw2, hp2⟩
      exact ⟨(hWf q).mpr hw2, fun out hb1 => hp2 out ((hBeh q out).mp hb1)⟩
  exact ⟨hWf, hBeh, hFault, hDiv, hPost⟩

