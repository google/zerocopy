                             .constant { ty := .int ctx.ed.discrWidth ctx.ed.discrSigned, lit := .scalar dBits }
                           { statements := [.baseStmt (.assign { localId := discrDst, projection := [] } (.use dConst))]
                             terminator := .baseTerm (.switchInt (.copy { localId := discrDst, projection := [] }) targets)
                             cleanup := bb.cleanup }] 0
                      rw [Nat.add_zero, hArmsLen2] at hRight
                      exact hRight)
                  rw [huGet] at hLookupK
                  exact hLookupK
                let dBits := truncateBits ctx.ed.discrWidth (BitVec.ofNat 128 uVd.discrVal)
                have hEv1Eq : evalEnumTerminator pSrc.enumDefs ctx.body bb f₁ cm =
                    (match writeEnumBasePlace f₁.locals discrDst dstTy
                        (.scalar ⟨ctx.ed.discrWidth, ctx.ed.discrSigned, dBits⟩) with
                     | .error k => .fault k
                     | .ok slotsAfterWrite =>
                       match evalSwitchBranches ctx.ed.discrWidth dBits
                           targets.otherwise targets.branches with
                       | .error k => .fault k
                       | .ok target =>
                         jumpToEnumBlock { f₁ with locals := slotsAfterWrite } cm target) := by
                  unfold evalEnumTerminator readAdtDiscriminant decodeNicheVariant
                  rw [hTerm]; dsimp
                  rw [hDeclDstSrc, ctx.hEnumDecl, hSl1]; dsimp
                  rw [ctx.hEdGet]; dsimp
                  rw [hBeqNotTy]; dsimp
                  rw [ctx.hEdAdm, hLay]; dsimp
                  rw [bitvec_bne_false_of_eq hBitsFit]; dsimp
                  rw [hInTag]; dsimp
                  rw [hBle]; dsimp
                  rw [huGet]; dsimp
                  rw [hUVdUninh]; dsimp
                  rw [huGet] <;> rfl
                rw [hEv1Eq]
                have hEvRhs := s3d2c_evalEnumBaseRvalue_discConst
                  (decls := bodyTgt.locals) (slots := slotsM)
                  (rawVal := uVd.discrVal) hTyBeq
                exact s3d2c_exec_writeDiscrAndSwitch ctx
                  (f₂Mid := { f₂ with blockIdx := untaggedBbId, stmtIdx := 0, locals := slotsM })
                  (pre := [])
                  hDef1 hDef2 hB2 hUntagLookup rfl rfl rfl
                  hDstLt hDstNe hDeclDstTgt hTyBeq hTgtPair hEvRhs hPreM hSl1 hMatchM hDirectInv

/-! ### 3. Full Step Simulation `scalarize_step_sim` & Soundness `applyEnumScalarize_sound` -/

private theorem scalarize_step_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut) {s₁ s₂ : EnumState}
    (hRel : ScalarizeSimRel ctx s₁ s₂) :
    SimStepResult ctx s₂ (evalStepEnum pSrc 0 s₁) := by
  let ⟨hStateRel, hDirectInv⟩ := hRel
  let ⟨hCmEq, f₁, f₂, hS1Eq, hS2Eq, hDef2, hRest⟩ := hStateRel
  cases s₁ with
  | mk frs1 cm1 =>
    cases s₂ with
    | mk frs2 cm2 =>
      dsimp at hCmEq hS1Eq hS2Eq
      subst hCmEq; subst hS1Eq; subst hS2Eq
      cases hIsTgt : Nat.beq f₁.defId plan.defId with
      | false =>
        have hNe : f₁.defId ≠ plan.defId := nat_ne_of_beq_false hIsTgt
        rw [if_false_of_not_prop hNe] at hRest
        subst hRest
        exact s3d_offTarget_step_sim ctx hNe
      | true =>
        have hDef1 : f₁.defId = plan.defId := nat_beq_eq hIsTgt
        rw [if_true_of_prop hDef1] at hRest
        let ⟨bb, hBB1, hBlkEq, hLeLen, hF2Idx, hPre, sl, hSl1, hMatch⟩ := hRest
        have hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId =
            some (scalarizeTargetBody ctx) := by
          rw [hDef2, hDef1]
          exact (congrArg (fun p => Trusted.MirSemantics.getElem? p.bodies plan.defId) ctx.hPOut).trans
            (setElem?_getElem?_same ctx.hSetBody)
        have hChkBoth := list_all_getElem? ctx.hBodyChk hBB1
        let ⟨hStmtsChk, hTermChk⟩ := bool_and_true hChkBoth
        have hLocBnd := ctx.hLocInBnd
        unfold enumBodyLocalsInBounds at hLocBnd
        have hBndBoth := list_all_getElem? hLocBnd hBB1
        let ⟨hStmtsBnd, hTermBnd⟩ := bool_and_true hBndBoth
        have hTgtBnd : enumBlockTargetsInBounds ctx.body.basicBlocks.length bb = true :=
          list_all_getElem? ctx.hTgtInBnd hBB1
        cases Nat.lt_or_eq_of_le hLeLen with
        | inl hLtLen =>
          let ⟨stmt, hStmt1⟩ := getElem?_some_of_lt bb.statements f₁.stmtIdx hLtLen
          have hStChk : checkStmtForEnumLocal ctx.body.locals plan.enumLocal ctx.ed stmt = true :=
            list_all_getElem? hStmtsChk hStmt1
          have hStBnd : enumStmtLocalsInBounds ctx.body.locals.length stmt = true :=
            list_all_getElem? hStmtsBnd hStmt1
          have hEv1 : evalStepEnum pSrc 0 { frames := [f₁], callerMem := cm1 } =
              evalEnumStmt pSrc.enumDefs ctx.body f₁ cm1 stmt := by
            unfold evalStepEnum; dsimp
            rw [hDef1, ctx.hBodySrc]; dsimp
            rw [hBB1]; dsimp
            rw [hStmt1]
          rw [hEv1]
          let ⟨auxBase, hBB2Blk, _⟩ := s3d_bodyTgt_block_lookup ctx hBB1
          have hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx =
              some (lowerEnumBlock plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed auxBase bb).1 := by
            rw [hBlkEq]; exact hBB2Blk
          let base := ctx.body.locals.length
          let lowerFn := lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed
          let preStmts := listFlatMap lowerFn (bb.statements.take f₁.stmtIdx)
          let ⟨termExtra, hBlockStmts⟩ := s3d_lowerEnumBlock_stmts_suffix
            plan.enumLocal base ctx.compTys.length ctx.ed auxBase bb
          let ⟨hSplitAll, _⟩ := listFlatMap_take_split lowerFn bb.statements hStmt1
          let postStmts := listFlatMap lowerFn (bb.statements.drop (f₁.stmtIdx + 1)) ++ termExtra
          have hBbTgtStmts :
              (lowerEnumBlock plan.enumLocal base ctx.compTys.length ctx.ed auxBase bb).1.statements =
                preStmts ++ lowerFn stmt ++ postStmts := by
            rw [hBlockStmts, hSplitAll]
            dsimp [preStmts, postStmts]
            rw [List.append_assoc (listFlatMap lowerFn (bb.statements.take f₁.stmtIdx) ++ lowerFn stmt)
                  (listFlatMap lowerFn (bb.statements.drop (f₁.stmtIdx + 1))) termExtra]
          cases stmt with
          | baseStmt bs =>
            exact s3d_baseStmt_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1 hF2Idx rfl
              hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv
          | setDiscriminant l v =>
            cases hEqL : Nat.beq l plan.enumLocal with
            | true =>
              have hlEq : l = plan.enumLocal := nat_beq_eq hEqL
              subst hlEq
              exact s3d2_setDiscriminant_enumLocal_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hPre hSl1 hMatch hDirectInv
            | false =>
              exact s3d_nonEnumLocal_stmt_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv hEqL
          | assignField l v f rval =>
            cases hEqL : Nat.beq l plan.enumLocal with
            | true =>
              have hlEq : l = plan.enumLocal := nat_beq_eq hEqL
              subst hlEq
              exact s3d2_assignField_enumLocal_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv
            | false =>
              exact s3d_nonEnumLocal_stmt_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv hEqL
          | readField dst src v f isMove =>
            cases hEqS : Nat.beq src plan.enumLocal with
            | true =>
              have hsEq : src = plan.enumLocal := nat_beq_eq hEqS
              subst hsEq
              exact s3d2b_readField_enumLocal_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv
            | false =>
              exact s3d_nonEnumLocal_stmt_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv hEqS
          | aggregateEnum dst v ops =>
            cases hEqD : Nat.beq dst plan.enumLocal with
            | true =>
              have hdEq : dst = plan.enumLocal := nat_beq_eq hEqD
              subst hdEq
              exact s3d2b_aggregateEnum_enumLocal_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv
            | false =>
              exact s3d_nonEnumLocal_stmt_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv hEqD
          | discriminantDirect dst src =>
            cases hEqS : Nat.beq src plan.enumLocal with
            | true =>
              have hsEq : src = plan.enumLocal := nat_beq_eq hEqS
              subst hsEq
              exact s3d_discriminantDirect_enumLocal_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv
            | false =>
              exact s3d_nonEnumLocal_stmt_sim ctx hDef1 hDef2 hBlkEq hBB1 hStmt1
                hF2Idx rfl hB2 hBB2 hBbTgtStmts hStChk hStBnd hPre hSl1 hMatch hDirectInv hEqS
        | inr hEqLen =>
          have hEv1 : evalStepEnum pSrc 0 { frames := [f₁], callerMem := cm1 } =
              evalEnumTerminator pSrc.enumDefs ctx.body bb f₁ cm1 := by
            have hB1 : Trusted.MirSemantics.getElem? pSrc.bodies f₁.defId = some ctx.body := by
              rw [hDef1]; exact ctx.hBodySrc
            exact stepAtTerm hB1 hBB1 hEqLen
          rw [hEv1]
          exact s3d2c_terminator_sim ctx hDef1 hDef2 hBlkEq hBB1 hEqLen hF2Idx hB2
            hTermChk hTermBnd hTgtBnd hPre hSl1 hMatch hDirectInv

private theorem applyEnumScalarize_sound (plan : EnumScalarizePlan) (pSrc pOut : EnumProgram)
    (hApp : applyEnumScalarize plan pSrc = some pOut) :
    FullSemanticEquivEnum pSrc pOut := by
  let ⟨ctx⟩ := applyEnumScalarize_unpack hApp
  let ⟨hInitErr, hInitOk⟩ := scalarize_initStateEnum_simRel ctx
  refine fullSemanticEquivEnum_of_fwd_stutter_sim (ScalarizeSimRel ctx)
    hInitErr hInitOk ?_ ?_ ?_
  · intro s₁ s₂ s₁' hRel hEv
    have hSim := scalarize_step_sim ctx hRel
    rw [hEv] at hSim
    exact hSim
  · intro s₁ s₂ out hRel hEv
    have hSim := scalarize_step_sim ctx hRel
    rw [hEv] at hSim
    exact hSim
  · intro s₁ s₂ k hRel hEv
    have hSim := scalarize_step_sim ctx hRel
    rw [hEv] at hSim
    exact hSim

