/-! ## Slice 3d-2c: Terminator Simulation, Full `scalarize_step_sim`, & `applyEnumScalarize_sound` -/

/-! ### 1. Post-Jump Simulation, `writeEnumBasePlace` Lookup, & Discriminant Switch Helpers -/

private theorem s3d2c_mkTargetPostJumpSimRel {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {target : BasicBlockId}
    {slots₁' slots₂' : List EnumSlot} {sl' : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hTgtLt : target < ctx.body.basicBlocks.length)
    (hPre' : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal slots₁' slots₂')
    (hSl1' : Trusted.MirSemantics.getElem? slots₁' plan.enumLocal = some sl')
    (hMatch' : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl' slots₂')
    (hDirectInv' : ∀ v vfs vd,
      sl' = .liveDirect (some v) vfs →
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
      variantIsUninhabited vd = false) :
    ScalarizeSimRel ctx
      { frames := [{ f₁ with blockIdx := target, stmtIdx := 0, locals := slots₁' }],
        callerMem := cm }
      { frames := [{ f₂ with blockIdx := target, stmtIdx := 0, locals := slots₂' }],
        callerMem := cm } := by
  let ⟨bbNext, hBBNext⟩ := getElem?_some_of_lt ctx.body.basicBlocks target hTgtLt
  refine ⟨⟨rfl, _, _, rfl, rfl, hDef2, ?_⟩, ?_⟩
  · dsimp
    rw [if_true_of_prop hDef1]
    exact ⟨bbNext, hBBNext, rfl, Nat.zero_le _, rfl, hPre', sl', hSl1', hMatch'⟩
  · intro fx v vfs vd hfx _ hGetSl hvGet
    dsimp at hfx
    injection hfx with hxEq; subst hxEq
    dsimp at hGetSl
    rw [hSl1'] at hGetSl
    injection hGetSl with hslEq
    exact hDirectInv' v vfs vd hslEq hvGet

private theorem s3d2c_writeEnumBasePlace_getElem?
    {slots slots' : List EnumSlot} {dst : LocalId} {dstTy : MirTy} {val : Val}
    (hW : writeEnumBasePlace slots dst dstTy val = .ok slots') :
    Trusted.MirSemantics.getElem? slots' dst = some (.baseSlot (.live (some val))) := by
  unfold writeEnumBasePlace at hW
  cases hChk : (!checkVal val dstTy) with
  | true => rw [hChk] at hW; cases hW
  | false =>
    rw [hChk] at hW; dsimp at hW
    cases hGet : Trusted.MirSemantics.getElem? slots dst with
    | none => rw [hGet] at hW; cases hW
    | some sl =>
      rw [hGet] at hW
      cases sl with
      | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ => cases hW
      | baseSlot bsl =>
        cases bsl with
        | dead => cases hW
        | live _ =>
          dsimp at hW
          cases hSet : setElem? slots dst (.baseSlot (.live (some val))) with
          | none => rw [hSet] at hW; cases hW
          | some sOut =>
            rw [hSet] at hW
            injection hW with hEq; subst hEq
            exact setElem?_getElem?_same hSet

private theorem s3d2c_evalEnumBaseRvalue_discConst
    {decls : List EnumLocalDecl} {slots : List EnumSlot}
    {dstTy : MirTy} {w : IntWidth} {s : Bool} {rawVal : Nat}
    (hTyBeq : MirTy.beq dstTy (.int w s) = true) :
    let dBits := truncateBits w (BitVec.ofNat 128 rawVal)
    let dConst : Operand := .constant { ty := .int w s, lit := .scalar dBits }
    evalEnumBaseRvalue decls slots dstTy (.use dConst) =
      .ok (.scalar ⟨w, s, dBits⟩, slots) := by
  have hTyEq : dstTy = .int w s := mirTy_beq_eq hTyBeq
  subst hTyEq
  have hFit : truncateBits w (truncateBits w (BitVec.ofNat 128 rawVal)) =
      truncateBits w (BitVec.ofNat 128 rawVal) := truncateBits_idem w _
  have hEvC := (s3d_evalConstLit_int_eq w s _ hFit).1
  unfold evalEnumBaseRvalue evalEnumBaseOperandToSlot
  dsimp
  rw [hEvC]
  dsimp
  rw [mirTy_beq_refl (.int w s)]
  rfl

private theorem s3d2c_exec_writeDiscrAndSwitch {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂Mid : EnumFrame} {cm : CallerMemory} {bbFinal : EnumBlock}
    {pre : List EnumStmt} {discrDst : LocalId} {dstTy : MirTy}
    {rhs : Rvalue} {dBits : BitVec 128} {targets : SwitchTargets}
    {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂Mid.defId = f₁.defId)
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂Mid.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂Mid.blockIdx =
      some bbFinal)
    (hF2Idx : f₂Mid.stmtIdx = pre.length)
    (hBbStmts : bbFinal.statements =
      pre ++ [.baseStmt (.assign { localId := discrDst, projection := [] } rhs)])
    (hBbTerm : bbFinal.terminator =
      .baseTerm (.switchInt (.copy { localId := discrDst, projection := [] }) targets))
    (hDstLt : discrDst < ctx.body.locals.length)
    (hDstNe : discrDst ≠ plan.enumLocal)
    (hDeclDst : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).locals discrDst =
      some (.base dstTy))
    (hTyBeq : MirTy.beq dstTy (.int ctx.ed.discrWidth ctx.ed.discrSigned) = true)
    (hTgtBnd :
      Nat.blt targets.otherwise ctx.body.basicBlocks.length = true ∧
      targets.branches.all (fun p => Nat.blt p.2 ctx.body.basicBlocks.length) = true)
    (hEvalRhs : evalEnumBaseRvalue (scalarizeTargetBody ctx).locals f₂Mid.locals dstTy rhs =
      .ok (.scalar ⟨ctx.ed.discrWidth, ctx.ed.discrSigned, dBits⟩, f₂Mid.locals))
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂Mid.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂Mid.locals)
    (hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm }) :
    let discVal : Val := .scalar ⟨ctx.ed.discrWidth, ctx.ed.discrSigned, dBits⟩
    SimStepResult ctx { frames := [f₂Mid], callerMem := cm }
      (match writeEnumBasePlace f₁.locals discrDst dstTy discVal with
       | .error k => .fault k
       | .ok slotsAfterWrite =>
         match evalSwitchBranches ctx.ed.discrWidth dBits targets.otherwise targets.branches with
         | .error k => .fault k
         | .ok target =>
           jumpToEnumBlock { f₁ with locals := slotsAfterWrite } cm target) := by
  let ⟨hStepEqDefs, hTermEqDefs, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  let ⟨hWrErr, hWrOk⟩ := writeEnumBasePlace_agree (dstTy := dstTy)
    (val := .scalar ⟨ctx.ed.discrWidth, ctx.ed.discrSigned, dBits⟩)
    hPre hDstLt hDstNe
  have hDstEq : dstTy = .int ctx.ed.discrWidth ctx.ed.discrSigned := mirTy_beq_eq hTyBeq
  have hInvSl : ∀ v vfs vd,
      sl = .liveDirect (some v) vfs →
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
      variantIsUninhabited vd = false :=
    fun v vfs vd hsl hv =>
      hDirectInv f₁ v vfs vd rfl hDef1 (by rw [hsl] at hSl1; exact hSl1) hv
  cases hW1 : writeEnumBasePlace f₁.locals discrDst dstTy
      (.scalar ⟨ctx.ed.discrWidth, ctx.ed.discrSigned, dBits⟩) with
  | error k =>
    have hEv2 : evalStepEnum pOut 0 { frames := [f₂Mid], callerMem := cm } = .fault k := by
      rw [stepAtStmt hB2 hBB2 hBbStmts hF2Idx, hStepEqDefs]
      unfold evalEnumStmt
      dsimp
      rw [hDeclDst]
      dsimp
      rw [hEvalRhs]
      dsimp
      rw [hWrErr k hW1]
    exact simFault0 (by rw [hW1]) hEv2
  | ok s1End =>
    let ⟨s2End, hW2, hLenEnd, hPreEnd, hOutEnd⟩ := hWrOk s1End hW1
    have hSl1End : Trusted.MirSemantics.getElem? s1End plan.enumLocal = some sl :=
      (s3d_writeEnumBasePlace_preserves_ne (fun h => hDstNe h.symm) hW1).trans hSl1
    have hMatchEnd : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl s2End :=
      slotMatchesComp_congr_ge_base hMatch hLenEnd (fun k hk => hOutEnd k (Or.inr hk))
    have hStep1 : evalStepEnum pOut 0 { frames := [f₂Mid], callerMem := cm } =
        .step { frames := [{ f₂Mid with stmtIdx := pre.length + 1, locals := s2End }],
                callerMem := cm } := by
      rw [stepAtStmt hB2 hBB2 hBbStmts hF2Idx, hStepEqDefs]
      unfold evalEnumStmt
      dsimp
      rw [hDeclDst]
      dsimp
      rw [hEvalRhs]
      dsimp
      rw [hW2, hF2Idx]
    have hLenStmt : bbFinal.statements.length = pre.length + 1 := by
      rw [hBbStmts, list_append_length]; rfl
    have hPrim2 : evalEnumPrimitiveOperand (scalarizeTargetBody ctx).locals s2End
        (.copy { localId := discrDst, projection := [] }) =
        .ok (.scalar ⟨ctx.ed.discrWidth, ctx.ed.discrSigned, dBits⟩, s2End) := by
      unfold evalEnumPrimitiveOperand evalEnumBaseOperandToSlot
      dsimp
      rw [hDeclDst, s3d2c_writeEnumBasePlace_getElem? hW2]
      dsimp
      rw [hDstEq]
      rfl
    have hTerm2 : evalStepEnum pOut 0
        { frames := [{ f₂Mid with stmtIdx := pre.length + 1, locals := s2End }],
          callerMem := cm } =
        (match evalSwitchBranches ctx.ed.discrWidth dBits targets.otherwise targets.branches with
         | .error k => .fault k
         | .ok target => jumpToEnumBlock { f₂Mid with locals := s2End } cm target) := by
      rw [stepAtTerm (f := { f₂Mid with stmtIdx := pre.length + 1, locals := s2End })
            hB2 hBB2 hLenStmt.symm, hTermEqDefs]
      unfold evalEnumTerminator
      rw [hBbTerm]
      dsimp
      rw [hPrim2]
      rfl
    cases hSw : evalSwitchBranches ctx.ed.discrWidth dBits targets.otherwise targets.branches with
    | error k =>
      rw [hSw] at hTerm2
      exact simFaultR (by rw [hW1]) (c_reachesEnum_head_det hStep1 (ReachesEnum.refl _)) hTerm2
    | ok target =>
      rw [hSw] at hTerm2
      have hTgtLt : target < ctx.body.basicBlocks.length :=
        evalSwitchBranches_target_lt (nat_blt_lt hTgtBnd.1) hTgtBnd.2 hSw
      have hPost := s3d2c_mkTargetPostJumpSimRel ctx (cm := cm) hDef1 hDef2 hTgtLt
        hPreEnd hSl1End hMatchEnd hInvSl
      exact simStepPlus (by rw [hW1]; rfl) hStep1 (ReachesNEnum.succ hTerm2 (ReachesNEnum.zero _)) hPost

/-! ### 2. `s3d2c_terminator_sim` -/

private theorem s3d2c_terminator_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb : EnumBlock} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hIdx1 : f₁.stmtIdx = bb.statements.length)
    (hF2Idx : f₂.stmtIdx =
      (listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx)).length)
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hTermChk : checkTermForEnumLocal ctx.body.locals plan.enumLocal ctx.ed bb.terminator = true)
    (hTermBnd : enumTermLocalsInBounds ctx.body.locals.length bb.terminator = true)
    (hTgtBnd : enumBlockTargetsInBounds ctx.body.basicBlocks.length bb = true)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals)
    (hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm }) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumTerminator pSrc.enumDefs ctx.body bb f₁ cm) := by
  let base := ctx.body.locals.length
  let bodyTgt := scalarizeTargetBody ctx
  let ⟨hDeclLive, hDeclFault⟩ := s3d_compDecls_common ctx
  let ⟨_, _, hDeclPre, _⟩ := scalarizeCtx_target_decl_lookup ctx
  let ⟨_, hTermEqDefs, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  let ⟨auxBase, hBB2, hAuxLookup⟩ := s3d_bodyTgt_block_lookup ctx hBB1
  let preStmts :=
    listFlatMap (lowerEnumStmt plan.enumLocal base ctx.compTys.length ctx.ed) bb.statements
  have hF2IdxPre : f₂.stmtIdx = preStmts.length := by
    rw [hF2Idx, hIdx1, list_take_all bb.statements]
  have hInvSl : ∀ v vfs vd,
      sl = .liveDirect (some v) vfs →
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd →
      variantIsUninhabited vd = false :=
    fun v vfs vd hsl hv =>
      hDirectInv f₁ v vfs vd rfl hDef1 (by rw [hsl] at hSl1; exact hSl1) hv
  cases hTerm : bb.terminator with
  | baseTerm bt =>
    have hBbTgt :
        Trusted.MirSemantics.getElem? bodyTgt.basicBlocks f₂.blockIdx =
          some { statements := preStmts, terminator := .baseTerm bt, cleanup := bb.cleanup } := by
      rw [hBlkEq]
      have hBB2' := hBB2
      dsimp [lowerEnumBlock] at hBB2'
      rw [hTerm] at hBB2'
      exact hBB2'
    have hTerm2Eq : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
        evalEnumTerminator pSrc.enumDefs bodyTgt
          { statements := preStmts, terminator := .baseTerm bt, cleanup := bb.cleanup } f₂ cm :=
      (stepAtTerm hB2 hBbTgt hF2IdxPre).trans (hTermEqDefs _ f₂ cm)
    unfold evalEnumTerminator at hTerm2Eq
    unfold evalEnumTerminator
    rw [hTerm]
    dsimp at hTerm2Eq
    dsimp
    cases bt with
    | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported =>
      unfold checkTermForEnumLocal at hTermChk
      rw [hTerm] at hTermChk
      cases hTermChk
    | unreachable =>
      exact simFault0 rfl hTerm2Eq
    | goto target =>
      unfold enumBlockTargetsInBounds at hTgtBnd
      rw [hTerm] at hTgtBnd
      have hTgtLt : target < ctx.body.basicBlocks.length := nat_blt_lt hTgtBnd
      have hPost := s3d2c_mkTargetPostJumpSimRel ctx (cm := cm) hDef1 hDef2 hTgtLt hPre hSl1 hMatch hInvSl
      exact simStep1 rfl hTerm2Eq hPost
    | return_ =>
      dsimp at hTerm2Eq
      dsimp
      cases hCl : bb.cleanup with
      | true =>
        rw [hCl] at hTerm2Eq
        dsimp at hTerm2Eq
        exact simFault0 rfl hTerm2Eq
      | false =>
        rw [hCl] at hTerm2Eq
        dsimp at hTerm2Eq
        dsimp
        have h0Lt : 0 < base :=
          Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.zero_le _) ctx.hArgLtEnum) ctx.hEnumLtBase
        have h0Ne : 0 ≠ plan.enumLocal := by
          intro h
          have hPos : 0 < plan.enumLocal :=
            Nat.lt_of_le_of_lt (Nat.zero_le _) ctx.hArgLtEnum
          rw [← h] at hPos
          exact Nat.lt_irrefl 0 hPos
        rw [hPre.2.2 0 h0Lt h0Ne] at hTerm2Eq
        cases hSl0 : Trusted.MirSemantics.getElem? f₁.locals 0 with
        | none =>
          rw [hSl0] at hTerm2Eq
          exact simFault0 rfl hTerm2Eq
        | some sl0 =>
          rw [hSl0] at hTerm2Eq
          cases sl0 with
          | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
            exact simFault0 rfl hTerm2Eq
          | baseSlot bsl0 =>
            cases bsl0 with
            | dead => exact simFault0 rfl hTerm2Eq
            | live ov0 =>
              cases ov0 with
              | none => exact simFault0 rfl hTerm2Eq
              | some _ => exact simDone0 rfl hTerm2Eq
    | switchInt discr targets =>
      dsimp at hTerm2Eq
      dsimp
      unfold checkTermForEnumLocal at hTermChk
      rw [hTerm] at hTermChk
      have hNoMent : stmtMentionsLocalOperand plan.enumLocal discr = false :=
        bool_not_true hTermChk
      unfold enumTermLocalsInBounds at hTermBnd
      rw [hTerm] at hTermBnd
      unfold enumBlockTargetsInBounds at hTgtBnd
      rw [hTerm] at hTgtBnd
      let hTgtPair := bool_and_true hTgtBnd
      let ⟨hPrimErr, hPrimOk⟩ := evalEnumPrimitiveOperand_agree hDeclPre hPre hTermBnd hNoMent
      cases hEvP1 : evalEnumPrimitiveOperand ctx.body.locals f₁.locals discr with
      | error k =>
        rw [hPrimErr k hEvP1] at hTerm2Eq
        exact simFault0 rfl hTerm2Eq
      | ok pr =>
        cases pr with
        | mk discrVal s1After =>
          let ⟨s2After, hEvP2, hLenAfter, hPreAfter, hOutAfter⟩ :=
            hPrimOk discrVal s1After hEvP1
          rw [hEvP2] at hTerm2Eq
          dsimp at hTerm2Eq
          dsimp
