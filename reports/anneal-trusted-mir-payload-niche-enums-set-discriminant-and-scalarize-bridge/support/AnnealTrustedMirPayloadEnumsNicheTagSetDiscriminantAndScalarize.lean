            let preMv := preL ++ mkMoveScratchToPayload sBase pBase vd.fields.length
            have hMvLen : (mkMoveScratchToPayload sBase pBase vd.fields.length).length =
                vd.fields.length := by
              have hGen : ∀ (sb pb k : Nat), (mkMoveScratchToPayload sb pb k).length = k := by
                intro sb pb k
                induction k generalizing sb pb with
                | zero => rfl
                | succ k' ih => dsimp [mkMoveScratchToPayload, List.length]; rw [ih]
              exact hGen sBase pBase vd.fields.length
            have hPreMvLen : preMv.length = preStmts.length + 2 * ops.length + 1 + vd.fields.length := by
              dsimp [preMv]; rw [list_append_length, hPreLLen, hMvLen]
            have hStTag : bbTgt.statements = preMv ++ stTag :: postStmts := hStMv
            have hTagLtP : base + 2 < pBase :=
              Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_succ_self 2) base)
