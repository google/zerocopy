/-! ## Slice 3c: `EnumScalarize` Context, Storage-Annotation Invariants, `SlotMatchesComp`, & Initial-State Equivalence -/

/-! ### 1. `enumDefs` Independence When a Body Has Zero `.adtEnum` Locals -/

private noncomputable def isAdtEnumDecl : EnumLocalDecl → Bool
  | .adtEnum _ => true
  | .base _ => false

private theorem no_adtEnum_of_any_false {decls : List EnumLocalDecl}
    (hNone : decls.any isAdtEnumDecl = false) :
    ∀ (l : Nat) (eIdx : Nat),
      Trusted.MirSemantics.getElem? decls l ≠ some (.adtEnum eIdx) := by
  induction decls with
  | nil => intro _ _ h; cases h
  | cons d tl ih =>
    dsimp [List.any] at hNone
    let ⟨hdF, htlF⟩ := bool_or_false hNone
    intro l eIdx hGet
    cases l with
    | zero =>
      injection hGet with heq; subst heq
      cases hdF
    | succ l' =>
      exact ih htlF l' eIdx hGet

private theorem liveUninitEnumSlot_congr_no_adtEnum (eds : List AdtEnumDef) (d : EnumLocalDecl)
    (hNotAdt : isAdtEnumDecl d = false) :
    liveUninitEnumSlot [] d = liveUninitEnumSlot eds d := by
  cases d with
  | base _ => rfl
  | adtEnum _ => cases hNotAdt

private theorem isSupportedEnumLocalDecl_congr_no_adtEnum (eds : List AdtEnumDef)
    (argCnt idx : Nat) (d : EnumLocalDecl)
    (hNotAdt : isAdtEnumDecl d = false) :
    isSupportedEnumLocalDecl [] argCnt idx d =
      isSupportedEnumLocalDecl eds argCnt idx d := by
  cases d with
  | base _ => rfl
  | adtEnum _ => cases hNotAdt

private theorem allEnumLocalsSupported_congr_no_adtEnum (eds : List AdtEnumDef) (argCnt : Nat) :
    ∀ (idx : Nat) (decls : List EnumLocalDecl),
      decls.any isAdtEnumDecl = false →
      allEnumLocalsSupported [] argCnt idx decls =
        allEnumLocalsSupported eds argCnt idx decls
  | _, [], _ => rfl
  | idx, d :: tl, hNone => by
    dsimp [List.any] at hNone
    let ⟨hdF, htlF⟩ := bool_or_false hNone
    unfold allEnumLocalsSupported
    rw [isSupportedEnumLocalDecl_congr_no_adtEnum eds argCnt idx d hdF,
        allEnumLocalsSupported_congr_no_adtEnum eds argCnt (idx + 1) tl htlF]

private theorem initEnumLocalsLoop_congr_no_adtEnum (eds : List AdtEnumDef)
    (b : EnumBody) (args : List Val) :
    ∀ (idx : Nat) (decls : List EnumLocalDecl),
      decls.any isAdtEnumDecl = false →
      initEnumLocalsLoop [] b args idx decls =
        initEnumLocalsLoop eds b args idx decls
  | _, [], _ => rfl
  | idx, d :: tl, hNone => by
    dsimp [List.any] at hNone
    let ⟨hdF, htlF⟩ := bool_or_false hNone
    unfold initEnumLocalsLoop
    rw [liveUninitEnumSlot_congr_no_adtEnum eds d hdF,
        initEnumLocalsLoop_congr_no_adtEnum eds b args (idx + 1) tl htlF]

private theorem evalEnumStmt_congr_no_adtEnum (eds : List AdtEnumDef)
    (b : EnumBody) (f : EnumFrame) (cm : CallerMemory) (stmt : EnumStmt)
    (hNone : b.locals.any isAdtEnumDecl = false) :
    evalEnumStmt [] b f cm stmt = evalEnumStmt eds b f cm stmt := by
  have hNoAdt := no_adtEnum_of_any_false hNone
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop | storageDead _ | assign _ _ | unsupported => rfl
    | storageLive lid =>
      unfold evalEnumStmt
      dsimp
      cases hg : Trusted.MirSemantics.getElem? b.locals lid with
      | none => rfl
      | some d =>
        cases d with
        | base _ => rfl
        | adtEnum eIdx => exact False.elim (hNoAdt lid eIdx hg)
  | setDiscriminant lid _ =>
    unfold evalEnumStmt
    dsimp
    cases hg : Trusted.MirSemantics.getElem? b.locals lid with
    | none => rfl
    | some d =>
      cases d with
      | base _ => rfl
      | adtEnum eIdx => exact False.elim (hNoAdt lid eIdx hg)
  | assignField lid _ _ rv =>
    unfold evalEnumStmt
    dsimp
    cases rvalueMentionsLocal lid rv with
    | true => rfl
    | false =>
      dsimp
      cases hg : Trusted.MirSemantics.getElem? b.locals lid with
      | none => rfl
      | some d =>
        cases d with
        | base _ => rfl
        | adtEnum eIdx => exact False.elim (hNoAdt lid eIdx hg)
  | readField dl slId _ _ _ =>
    unfold evalEnumStmt
    dsimp
    cases Nat.beq dl slId with
    | true => rfl
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? b.locals dl with
      | none => rfl
      | some dd =>
        cases dd with
        | adtEnum _ => rfl
        | base _ =>
          cases hg : Trusted.MirSemantics.getElem? b.locals slId with
          | none => rfl
          | some sd =>
            cases sd with
            | base _ => rfl
            | adtEnum eIdx => exact False.elim (hNoAdt slId eIdx hg)
  | aggregateEnum dl _ ops =>
    unfold evalEnumStmt
    dsimp
    cases ops.any (stmtMentionsLocalOperand dl) with
    | true => rfl
    | false =>
      dsimp
      cases hg : Trusted.MirSemantics.getElem? b.locals dl with
      | none => rfl
      | some d =>
        cases d with
        | base _ => rfl
        | adtEnum eIdx => exact False.elim (hNoAdt dl eIdx hg)
  | discriminantDirect dl slId =>
    unfold evalEnumStmt
    dsimp
    cases Trusted.MirSemantics.getElem? b.locals dl with
    | none => rfl
    | some dd =>
      cases dd with
      | adtEnum _ => rfl
      | base _ =>
        cases hg : Trusted.MirSemantics.getElem? b.locals slId with
        | none => rfl
        | some sd =>
          cases sd with
          | base _ => rfl
          | adtEnum eIdx => exact False.elim (hNoAdt slId eIdx hg)

private theorem evalEnumTerminator_congr_no_adtEnum (eds : List AdtEnumDef)
    (b : EnumBody) (bb : EnumBlock) (f : EnumFrame) (cm : CallerMemory)
    (hNone : b.locals.any isAdtEnumDecl = false) :
    evalEnumTerminator [] b bb f cm = evalEnumTerminator eds b bb f cm := by
  have hNoAdt := no_adtEnum_of_any_false hNone
  unfold evalEnumTerminator
  cases bb.terminator with
  | baseTerm bt => cases bt <;> rfl
  | switchDiscr dDst eLoc _ =>
    dsimp
    cases Trusted.MirSemantics.getElem? b.locals dDst with
    | none => rfl
    | some dd =>
      cases dd with
      | adtEnum _ => rfl
      | base _ =>
        cases hg : Trusted.MirSemantics.getElem? b.locals eLoc with
        | none => rfl
        | some edDecl =>
          cases edDecl with
          | base _ => rfl
          | adtEnum eIdx => exact False.elim (hNoAdt eLoc eIdx hg)

/-! ### 2. `listFlatMap` & `lowerEnumBlocksLoop` Block/Statement Lookup Lemmas -/

private theorem listFlatMap_append {α β : Type} (f : α → List β) :
    ∀ (xs ys : List α),
      listFlatMap f (xs ++ ys) = listFlatMap f xs ++ listFlatMap f ys
  | [], _ => rfl
  | x :: xs, ys => by
    dsimp [listFlatMap]
    rw [listFlatMap_append f xs ys, List.append_assoc]

private theorem listFlatMap_take_split {α β : Type} (f : α → List β) :
    ∀ (xs : List α) {i : Nat} {x : α},
      Trusted.MirSemantics.getElem? xs i = some x →
      listFlatMap f xs =
        listFlatMap f (xs.take i) ++ f x ++ listFlatMap f (xs.drop (i + 1)) ∧
      listFlatMap f (xs.take (i + 1)) = listFlatMap f (xs.take i) ++ f x
  | [], _, _, hg => by cases hg
  | y :: ys, 0, _, hg => by
    injection hg with heq; subst heq
    dsimp [List.take, List.drop, listFlatMap]
    exact ⟨rfl, List.append_nil (f y)⟩
  | y :: ys, i + 1, x, hg => by
    let ⟨ihFull, ihTake⟩ := listFlatMap_take_split f ys hg
    dsimp [List.take, List.drop, listFlatMap]
    refine ⟨?_, ?_⟩
    · rw [ihFull, ← List.append_assoc, ← List.append_assoc]
    · rw [ihTake, ← List.append_assoc]

private theorem list_take_all {α : Type} :
    ∀ (xs : List α), xs.take xs.length = xs
  | [] => rfl
  | x :: xs => by
    dsimp [List.length, List.take]
    exact congrArg (List.cons x) (list_take_all xs)

private theorem lowerEnumBlocksLoop_fst_length (enumLocal base compCount : Nat)
    (ed : AdtEnumDef) :
    ∀ (nextAuxBb : BasicBlockId) (bbs : List EnumBlock),
      (lowerEnumBlocksLoop enumLocal base compCount ed nextAuxBb bbs).1.length =
        bbs.length
  | _, [] => rfl
  | nextAuxBb, bb :: rest => by
    dsimp [lowerEnumBlocksLoop]
    exact congrArg Nat.succ
      (lowerEnumBlocksLoop_fst_length enumLocal base compCount ed _ rest)

private theorem lowerEnumBlocksLoop_lookup (enumLocal base compCount : Nat)
    (ed : AdtEnumDef) :
    ∀ (nextAuxBb : BasicBlockId) (bbs : List EnumBlock) {idx : Nat} {bb : EnumBlock},
      Trusted.MirSemantics.getElem? bbs idx = some bb →
      ∃ (preAux postAux : List EnumBlock),
        let auxBase := nextAuxBb + preAux.length
        let cur := lowerEnumBlock enumLocal base compCount ed auxBase bb
        Trusted.MirSemantics.getElem?
          (lowerEnumBlocksLoop enumLocal base compCount ed nextAuxBb bbs).1 idx =
          some cur.1 ∧
        (lowerEnumBlocksLoop enumLocal base compCount ed nextAuxBb bbs).2 =
          preAux ++ cur.2 ++ postAux
  | _, [], _, _, hg => by cases hg
  | nextAuxBb, bb₀ :: rest, 0, _, hg => by
    injection hg with heq; subst heq
    refine ⟨[], (lowerEnumBlocksLoop enumLocal base compCount ed
      (nextAuxBb + (lowerEnumBlock enumLocal base compCount ed nextAuxBb bb₀).2.length) rest).2, ?_⟩
    dsimp [List.length, lowerEnumBlocksLoop]
    exact ⟨rfl, rfl⟩
  | nextAuxBb, bb₀ :: rest, idx + 1, bb, hg => by
    let cur0 := lowerEnumBlock enumLocal base compCount ed nextAuxBb bb₀
    let ⟨preR, postR, ih1, ih2⟩ :=
      lowerEnumBlocksLoop_lookup enumLocal base compCount ed
        (nextAuxBb + cur0.2.length) rest hg
    refine ⟨cur0.2 ++ preR, postR, ?_⟩
    dsimp [lowerEnumBlocksLoop]
    have hAuxEq : nextAuxBb + (cur0.2 ++ preR).length =
        nextAuxBb + cur0.2.length + preR.length := by
      rw [list_append_length, Nat.add_assoc]
    rw [hAuxEq]
    refine ⟨ih1, ?_⟩
    change cur0.2 ++ (lowerEnumBlocksLoop enumLocal base compCount ed
      (nextAuxBb + cur0.2.length) rest).2 = _
    rw [ih2, ← List.append_assoc, ← List.append_assoc]

/-! ### 3. Persistent vs. Scratch Component Partition & Storage-Annotation Invariants -/

private theorem cons2_append_length {α : Type} (xs ys : List α) :
    (xs ++ ys).length + 1 + 1 = 2 + xs.length + ys.length := by
  rw [list_append_length, Nat.add_assoc (xs.length + ys.length) 1 1,
      Nat.add_comm (xs.length + ys.length) 2, Nat.add_assoc 2 xs.length ys.length]

private theorem cons3_append_length {α : Type} (xs ys : List α) :
    (xs ++ ys).length + 1 + 1 + 1 = 3 + xs.length + ys.length := by
  have h1 : xs.length + ys.length + 1 + 1 + 1 = (xs.length + ys.length) + 3 := by
    rw [Nat.add_assoc (xs.length + ys.length) 1 1,
        Nat.add_assoc (xs.length + ys.length) 2 1]
  rw [list_append_length, h1, Nat.add_comm (xs.length + ys.length) 3,
      Nat.add_assoc 3 xs.length ys.length]

private theorem cons5_append_length {α : Type} (xs ys : List α) :
    (xs ++ ys).length + 1 + 1 + 1 + 1 + 1 = 5 + xs.length + ys.length := by
  have h1 : xs.length + ys.length + 1 + 1 + 1 + 1 + 1 = (xs.length + ys.length) + 5 := by
    rw [Nat.add_assoc (xs.length + ys.length) 1 1,
        Nat.add_assoc (xs.length + ys.length) 2 1,
        Nat.add_assoc (xs.length + ys.length) 3 1,
        Nat.add_assoc (xs.length + ys.length) 4 1]
  rw [list_append_length, h1, Nat.add_comm (xs.length + ys.length) 5,
      Nat.add_assoc 5 xs.length ys.length]

private noncomputable def nonScratchCompCount (ed : AdtEnumDef) : Nat :=
  match ed.layout with
  | .empty => 2
  | .single =>
    match Trusted.MirSemantics.getElem? ed.variants 0 with
    | none => 2
    | some vd₀ => 2 + vd₀.fields.length
  | .direct _ _ => 3 + (flattenAllVariantFieldTys ed).length
  | .niche _ untagged _ _ _ _ nicheField _ =>
    match Trusted.MirSemantics.getElem? ed.variants untagged with
    | none => 5
    | some uVd => 5 + (nicheExtraFieldTysAux nicheField 0 uVd.fields).length

private theorem scalarizedEnumComponentTys_bounds {ed : AdtEnumDef} {compTys : List MirTy}
    (hAdm : adtEnumDefAdmitted ed = true)
    (hComp : scalarizedEnumComponentTys ed = some compTys) :
    2 ≤ nonScratchCompCount ed ∧
    nonScratchCompCount ed ≤ compTys.length ∧
    compTys.all isSupportedScalarOrUnitTy = true := by
  unfold adtEnumDefAdmitted at hAdm
  let ⟨h123, hLayAdm⟩ := bool_and_true hAdm
  let ⟨h12, _⟩ := bool_and_true h123
  let ⟨hFieldsOk, _⟩ := bool_and_true h12
  have hFlatOk : ∀ (vs : List VariantDef),
      vs.all (fun v => v.fields.all isSupportedScalarOrUnitTy) = true →
      (listFlatMap (fun vd => vd.fields) vs).all isSupportedScalarOrUnitTy = true := by
    intro vs
    induction vs with
    | nil => intro _; rfl
    | cons vd tl ih =>
      intro hAll
      dsimp [List.all] at hAll
      let ⟨hVd, hTl⟩ := bool_and_true hAll
      dsimp [listFlatMap]
      rw [list_all_append, hVd, ih hTl]
      rfl
  have hExtraOk : ∀ (nf idx : Nat) (tys : List MirTy),
      tys.all isSupportedScalarOrUnitTy = true →
      (nicheExtraFieldTysAux nf idx tys).all isSupportedScalarOrUnitTy = true := by
    intro nf idx tys
    induction tys generalizing idx with
    | nil => intro _; rfl
    | cons ty tl ih =>
      intro hAll
      dsimp [List.all] at hAll
      let ⟨hTy, hTl⟩ := bool_and_true hAll
      unfold nicheExtraFieldTysAux
      cases Nat.beq idx nf with
      | true => exact ih (idx + 1) hTl
      | false =>
        dsimp [List.all]
        rw [hTy, ih (idx + 1) hTl]
        rfl
  unfold scalarizedEnumComponentTys at hComp
  unfold nonScratchCompCount
  cases hLay : ed.layout with
  | empty =>
    rw [hLay] at hComp
    injection hComp with hEq; subst hEq
    exact ⟨Nat.le_refl 2, Nat.le_refl 2, rfl⟩
  | single =>
    rw [hLay] at hComp
    dsimp at hComp
    dsimp
    cases hv0 : Trusted.MirSemantics.getElem? ed.variants 0 with
    | none => rw [hv0] at hComp; cases hComp
    | some vd₀ =>
      rw [hv0] at hComp
      dsimp
      injection hComp with hEq; subst hEq
      dsimp
      have hVdOk : vd₀.fields.all isSupportedScalarOrUnitTy = true :=
        list_all_getElem? (p := fun v : VariantDef => v.fields.all isSupportedScalarOrUnitTy)
          hFieldsOk hv0
      refine ⟨Nat.le_add_right 2 _, ?_, ?_⟩
      · rw [cons2_append_length]
        exact Nat.le_add_right _ _
      · change ([MirTy.unit, .int .i32 false] ++ (vd₀.fields ++ vd₀.fields)).all isSupportedScalarOrUnitTy = true
        dsimp [List.append, List.all, isSupportedScalarOrUnitTy]
        rw [list_all_append, hVdOk]
        rfl
  | direct tagW tagS =>
    rw [hLay] at hComp hLayAdm
    dsimp at hComp hLayAdm
    dsimp
    injection hComp with hEq; subst hEq
    dsimp
    have hAllFsOk : (flattenAllVariantFieldTys ed).all isSupportedScalarOrUnitTy = true :=
      hFlatOk ed.variants hFieldsOk
    refine ⟨Nat.le_trans (Nat.le_succ 2) (Nat.le_add_right 3 _), ?_, ?_⟩
    · rw [cons3_append_length]
      exact Nat.le_add_right _ _
    · change ([MirTy.unit, .int .i32 false, .enum (directTagEnumTy ed tagW tagS)] ++
        (flattenAllVariantFieldTys ed ++ flattenAllVariantFieldTys ed)).all isSupportedScalarOrUnitTy = true
      dsimp [List.append, List.all, isSupportedScalarOrUnitTy]
      rw [hLayAdm, list_all_append, hAllFsOk]
      rfl
  | niche tagW untagged nStart nLast nStartBits tagRange nicheField uRange =>
    rw [hLay] at hComp
    dsimp at hComp
    dsimp
    cases hu : Trusted.MirSemantics.getElem? ed.variants untagged with
    | none => rw [hu] at hComp; cases hComp
    | some uVd =>
      rw [hu] at hComp
      dsimp
      injection hComp with hEq; subst hEq
      dsimp
      have hUVdOk : uVd.fields.all isSupportedScalarOrUnitTy = true :=
        list_all_getElem? (p := fun v : VariantDef => v.fields.all isSupportedScalarOrUnitTy)
          hFieldsOk hu
      have hExOk := hExtraOk nicheField 0 uVd.fields hUVdOk
      have hAllFsOk : (flattenAllVariantFieldTys ed).all isSupportedScalarOrUnitTy = true :=
        hFlatOk ed.variants hFieldsOk
      have h2Le5 : 2 ≤ 5 := Nat.succ_le_succ (Nat.succ_le_succ (Nat.zero_le 3))
      refine ⟨Nat.le_trans h2Le5 (Nat.le_add_right 5 _), ?_, ?_⟩
      · rw [cons5_append_length]
        exact Nat.le_add_right _ _
      · change ([MirTy.unit, .int .i32 false, .int tagW false, .int tagW false, .int tagW false] ++
          (nicheExtraFieldTysAux nicheField 0 uVd.fields ++ flattenAllVariantFieldTys ed)).all
          isSupportedScalarOrUnitTy = true
        dsimp [List.append, List.all, isSupportedScalarOrUnitTy]
        rw [list_all_append, hExOk, hAllFsOk]
        rfl

private theorem mkStorageLiveRange_marker (start : LocalId) :
    ∀ (k : Nat) (q : LocalId),
      (mkStorageLiveRange start k).any (enumStmtHasStorageMarker q) =
        (Nat.ble start q && Nat.blt q (start + k))
  | 0, q => by
    dsimp [mkStorageLiveRange, List.any]
    cases hb : Nat.ble start q with
    | false => rfl
    | true =>
      cases hl : Nat.blt q start with
      | false => rfl
      | true =>
        exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb) (nat_blt_lt hl))
  | k' + 1, q => by
    dsimp [mkStorageLiveRange, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]
    rw [mkStorageLiveRange_marker (start + 1) k' q]
    have hEndEq : (start + 1) + k' = start + (k' + 1) := by
      rw [Nat.add_assoc, Nat.add_comm 1 k']
    rw [hEndEq]
    cases hEq : Nat.beq start q with
    | true =>
      have hs : start = q := nat_beq_eq hEq
      subst hs
      have hBle : Nat.ble start start = true := nat_le_ble (Nat.le_refl _)
      have hBlt : Nat.blt start (start + (k' + 1)) = true :=
        nat_lt_blt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ k'))
      rw [hBle, hBlt]
      rfl
    | false =>
      have hNe : start ≠ q := nat_ne_of_beq_false hEq
      cases hb1 : Nat.ble start q with
      | false =>
        have hGt : q < start := by
          cases nat_le_or_gt start q with
          | inl hle => rw [nat_le_ble hle] at hb1; cases hb1
          | inr hgt => exact hgt
        have hb2 : Nat.ble (start + 1) q = false := by
          cases hb : Nat.ble (start + 1) q with
          | false => rfl
          | true =>
            exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb)
              (Nat.lt_trans hGt (Nat.lt_succ_self start)))
        rw [hb2]
        rfl
      | true =>
        have hLt : start < q := by
          cases Nat.eq_or_lt_of_le (nat_ble_le hb1) with
          | inl heq => exact False.elim (hNe heq)
          | inr hlt => exact hlt
        have hb2 : Nat.ble (start + 1) q = true := nat_le_ble hLt
        rw [hb2]
        rfl

private theorem mkStorageDeadRange_marker (start : LocalId) :
    ∀ (k : Nat) (q : LocalId),
      (mkStorageDeadRange start k).any (enumStmtHasStorageMarker q) =
        (Nat.ble start q && Nat.blt q (start + k))
  | 0, q => by
    dsimp [mkStorageDeadRange, List.any]
    cases hb : Nat.ble start q with
    | false => rfl
    | true =>
      cases hl : Nat.blt q start with
      | false => rfl
      | true =>
        exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb) (nat_blt_lt hl))
  | k' + 1, q => by
    dsimp [mkStorageDeadRange, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]
    rw [mkStorageDeadRange_marker (start + 1) k' q]
    have hEndEq : (start + 1) + k' = start + (k' + 1) := by
      rw [Nat.add_assoc, Nat.add_comm 1 k']
    rw [hEndEq]
    cases hEq : Nat.beq start q with
    | true =>
      have hs : start = q := nat_beq_eq hEq
      subst hs
      rw [nat_le_ble (Nat.le_refl _),
          nat_lt_blt (Nat.lt_add_of_pos_right (Nat.zero_lt_succ k'))]
      rfl
    | false =>
      have hNe : start ≠ q := nat_ne_of_beq_false hEq
      cases hb1 : Nat.ble start q with
      | false =>
        have hGt : q < start := by
          cases nat_le_or_gt start q with
          | inl hle => rw [nat_le_ble hle] at hb1; cases hb1
          | inr hgt => exact hgt
        have hb2 : Nat.ble (start + 1) q = false := by
          cases hb : Nat.ble (start + 1) q with
          | false => rfl
          | true =>
            exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb)
              (Nat.lt_trans hGt (Nat.lt_succ_self start)))
        rw [hb2]
        rfl
      | true =>
        have hLt : start < q := by
          cases Nat.eq_or_lt_of_le (nat_ble_le hb1) with
          | inl heq => exact False.elim (hNe heq)
          | inr hlt => exact hlt
        rw [nat_le_ble hLt]
        rfl

private theorem mkWrappingRangeCheckStmts_no_marker (tagW : IntWidth)
    (d g : LocalId) (op : Operand) (r : WrappingRange128) (q : LocalId) :
    (mkWrappingRangeCheckStmts tagW d g op r).any (enumStmtHasStorageMarker q) = false := rfl

private theorem mkMoveScratchToPayload_no_marker :
    ∀ (s p k : Nat) (q : LocalId),
      (mkMoveScratchToPayload s p k).any (enumStmtHasStorageMarker q) = false
  | _, _, 0, _ => rfl
  | s, p, k + 1, q => by
    dsimp [mkMoveScratchToPayload, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]
    exact mkMoveScratchToPayload_no_marker (s + 1) (p + 1) k q

private theorem mkMoveScratchToNicheUntagged_no_marker (tagW : IntWidth)
    (nl sd sg eb sb nf : Nat) (ur : WrappingRange128) :
    ∀ (idx : Nat) (tys : List MirTy) (q : LocalId),
      (mkMoveScratchToNicheUntagged tagW nl sd sg eb sb nf ur idx tys).any
        (enumStmtHasStorageMarker q) = false
  | _, [], _ => rfl
  | idx, _ :: rest, q => by
    dsimp [mkMoveScratchToNicheUntagged]
    cases Nat.beq idx nf with
    | true =>
      dsimp
      rw [list_any_append, list_any_append]
      dsimp [List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]
      exact mkMoveScratchToNicheUntagged_no_marker tagW nl sd sg eb sb nf ur (idx + 1) rest q
    | false =>
      dsimp [List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]
      exact mkMoveScratchToNicheUntagged_no_marker tagW nl sd sg eb sb nf ur (idx + 1) rest q

private theorem mkEvalOpsToScratch_marker_false_of_lt {q : LocalId} :
    ∀ (sBase : LocalId) (ops : List Operand),
      q < sBase →
      (mkEvalOpsToScratch sBase ops).any (enumStmtHasStorageMarker q) = false
  | _, [], _ => rfl
  | sBase, _ :: rest, hLt => by
    dsimp [mkEvalOpsToScratch, List.any, enumStmtHasStorageMarker, stmtHasStorageMarker]
    have hNe : Nat.beq sBase q = false :=
      nat_beq_false_of_ne (fun h => by subst h; exact Nat.lt_irrefl _ hLt)
    rw [hNe]
    exact mkEvalOpsToScratch_marker_false_of_lt (sBase + 1) rest
      (Nat.lt_trans hLt (Nat.lt_succ_self sBase))

private noncomputable def stmtAnnInBounds (lim : Nat) : EnumStmt → Bool
  | .baseStmt (.storageLive id) | .baseStmt (.storageDead id) => Nat.blt id lim
  | _ => true

private theorem mkStorageLiveRange_inBounds (lim : Nat) :
    ∀ (start k : Nat),
      start + k ≤ lim →
      (mkStorageLiveRange start k).all (stmtAnnInBounds lim) = true
  | _, 0, _ => rfl
  | start, k + 1, hLe => by
    dsimp [mkStorageLiveRange, List.all, stmtAnnInBounds]
    have hLt : start < lim :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ k)) hLe
    rw [nat_lt_blt hLt]
    have hRest : (start + 1) + k ≤ lim := by
      rw [Nat.add_assoc, Nat.add_comm 1 k]
      exact hLe
    exact mkStorageLiveRange_inBounds lim (start + 1) k hRest

private theorem mkStorageDeadRange_inBounds (lim : Nat) :
    ∀ (start k : Nat),
      start + k ≤ lim →
      (mkStorageDeadRange start k).all (stmtAnnInBounds lim) = true
  | _, 0, _ => rfl
  | start, k + 1, hLe => by
    dsimp [mkStorageDeadRange, List.all, stmtAnnInBounds]
    have hLt : start < lim :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ k)) hLe
    rw [nat_lt_blt hLt]
    have hRest : (start + 1) + k ≤ lim := by
      rw [Nat.add_assoc, Nat.add_comm 1 k]
      exact hLe
    exact mkStorageDeadRange_inBounds lim (start + 1) k hRest

private theorem mkEvalOpsToScratch_inBounds (lim : Nat) :
    ∀ (sBase : LocalId) (ops : List Operand),
      sBase + ops.length ≤ lim →
      (mkEvalOpsToScratch sBase ops).all (stmtAnnInBounds lim) = true
  | _, [], _ => rfl
  | sBase, _ :: rest, hLe => by
    dsimp [mkEvalOpsToScratch, List.all, stmtAnnInBounds]
    have hLt : sBase < lim :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)) hLe
    rw [nat_lt_blt hLt]
    have hRest : (sBase + 1) + rest.length ≤ lim := by
      rw [Nat.add_assoc, Nat.add_comm 1 rest.length]
      exact hLe
    exact mkEvalOpsToScratch_inBounds lim (sBase + 1) rest hRest

private theorem mkMoveScratchToPayload_inBounds (lim : Nat) :
    ∀ (s p k : Nat),
      (mkMoveScratchToPayload s p k).all (stmtAnnInBounds lim) = true
  | _, _, 0 => rfl
  | s, p, k + 1 => mkMoveScratchToPayload_inBounds lim (s + 1) (p + 1) k

private theorem mkMoveScratchToNicheUntagged_inBounds (lim : Nat) (tagW : IntWidth)
    (nl sd sg eb sb nf : Nat) (ur : WrappingRange128) :
    ∀ (idx : Nat) (tys : List MirTy),
      (mkMoveScratchToNicheUntagged tagW nl sd sg eb sb nf ur idx tys).all
        (stmtAnnInBounds lim) = true
  | _, [] => rfl
  | idx, _ :: rest => by
    dsimp [mkMoveScratchToNicheUntagged]
    cases Nat.beq idx nf with
    | true =>
      dsimp
      rw [list_all_append, list_all_append]
      dsimp [mkWrappingRangeCheckStmts, List.all, stmtAnnInBounds]
      exact mkMoveScratchToNicheUntagged_inBounds lim tagW nl sd sg eb sb nf ur (idx + 1) rest
    | false =>
      dsimp [List.all, stmtAnnInBounds]
      exact mkMoveScratchToNicheUntagged_inBounds lim tagW nl sd sg eb sb nf ur (idx + 1) rest

private theorem lowerEnumStmt_annotations
    {decls : List EnumLocalDecl} {enumLocal base : Nat}
    {ed : AdtEnumDef} {compTys : List MirTy} {stmt : EnumStmt}
    (hEnumLt : enumLocal < base)
    (hAdm : adtEnumDefAdmitted ed = true)
    (hComp : scalarizedEnumComponentTys ed = some compTys)
    (hAnnSrc : stmtAnnInBounds base stmt = true)
    (hChk : checkStmtForEnumLocal decls enumLocal ed stmt = true) :
    let out := lowerEnumStmt enumLocal base compTys.length ed stmt
    out.all (stmtAnnInBounds (base + compTys.length)) = true ∧
    (∀ j, j < base →
      out.any (enumStmtHasStorageMarker j) = enumStmtHasStorageMarker j stmt) ∧
    (∀ i, i < nonScratchCompCount ed →
      out.any (enumStmtHasStorageMarker (base + i)) =
        enumStmtHasStorageMarker enumLocal stmt) := by
  let ⟨_, hNonScrLe, _⟩ := scalarizedEnumComponentTys_bounds hAdm hComp
  dsimp
  cases stmt with
  | baseStmt bs =>
    cases bs with
    | nop | assign _ _ | unsupported =>
      exact ⟨rfl,
             fun _ _ => by dsimp [lowerEnumStmt, List.any]; cases enumStmtHasStorageMarker _ _ <;> rfl,
             fun _ _ => rfl⟩
    | storageLive id =>
      dsimp [lowerEnumStmt]
      cases hEq : Nat.beq id enumLocal with
      | false =>
        dsimp [List.all, List.any, stmtAnnInBounds, enumStmtHasStorageMarker, stmtHasStorageMarker]
        dsimp [stmtAnnInBounds] at hAnnSrc
        have hidLt : id < base + compTys.length :=
          Nat.lt_of_lt_of_le (nat_blt_lt hAnnSrc) (Nat.le_add_right _ _)
        rw [nat_lt_blt hidLt, hEq]
        refine ⟨rfl, ?_, ?_⟩
        · intro j _; cases Nat.beq id j <;> rfl
        · intro i _
          have hidNe : Nat.beq id (base + i) = false :=
            nat_beq_false_of_ne (fun h => by
              have hlt := Nat.lt_of_lt_of_le (nat_blt_lt hAnnSrc) (Nat.le_add_right base i)
              rw [h] at hlt; exact Nat.lt_irrefl _ hlt)
          rw [hidNe]; rfl
      | true =>
        have hidEq : id = enumLocal := nat_beq_eq hEq
        subst hidEq
        dsimp [List.all, List.any, stmtAnnInBounds, enumStmtHasStorageMarker, stmtHasStorageMarker]
        rw [nat_lt_blt (Nat.lt_of_lt_of_le hEnumLt (Nat.le_add_right _ _)),
            mkStorageLiveRange_inBounds _ base compTys.length (Nat.le_refl _),
            nat_beq_refl]
        refine ⟨rfl, ?_, ?_⟩
        · intro j hjLt
          rw [mkStorageLiveRange_marker]
          have hBleF : Nat.ble base j = false := by
            cases hb : Nat.ble base j with
            | false => rfl
            | true => exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb) hjLt)
          rw [hBleF]; cases Nat.beq id j <;> rfl
        · intro i hiLt
          have hNeE : Nat.beq id (base + i) = false :=
            nat_beq_false_of_ne (fun h => by
              have hlt := Nat.lt_of_lt_of_le hEnumLt (Nat.le_add_right base i)
              rw [h] at hlt; exact Nat.lt_irrefl _ hlt)
          rw [hNeE, mkStorageLiveRange_marker,
              nat_le_ble (Nat.le_add_right base i),
              nat_lt_blt (Nat.add_lt_add_left (Nat.lt_of_lt_of_le hiLt hNonScrLe) base)]
          rfl
    | storageDead id =>
      dsimp [lowerEnumStmt]
      cases hEq : Nat.beq id enumLocal with
      | false =>
        dsimp [List.all, List.any, stmtAnnInBounds, enumStmtHasStorageMarker, stmtHasStorageMarker]
        dsimp [stmtAnnInBounds] at hAnnSrc
        have hidLt : id < base + compTys.length :=
          Nat.lt_of_lt_of_le (nat_blt_lt hAnnSrc) (Nat.le_add_right _ _)
        rw [nat_lt_blt hidLt, hEq]
        refine ⟨rfl, ?_, ?_⟩
        · intro j _; cases Nat.beq id j <;> rfl
        · intro i _
          have hidNe : Nat.beq id (base + i) = false :=
            nat_beq_false_of_ne (fun h => by
              have hlt := Nat.lt_of_lt_of_le (nat_blt_lt hAnnSrc) (Nat.le_add_right base i)
              rw [h] at hlt; exact Nat.lt_irrefl _ hlt)
          rw [hidNe]; rfl
      | true =>
        have hidEq : id = enumLocal := nat_beq_eq hEq
        subst hidEq
        dsimp [List.all, List.any, stmtAnnInBounds, enumStmtHasStorageMarker, stmtHasStorageMarker]
        rw [nat_lt_blt (Nat.lt_of_lt_of_le hEnumLt (Nat.le_add_right _ _)),
            mkStorageDeadRange_inBounds _ base compTys.length (Nat.le_refl _),
            nat_beq_refl]
        refine ⟨rfl, ?_, ?_⟩
        · intro j hjLt
          rw [mkStorageDeadRange_marker]
          have hBleF : Nat.ble base j = false := by
            cases hb : Nat.ble base j with
            | false => rfl
            | true => exact False.elim (Nat.not_lt_of_ge (nat_ble_le hb) hjLt)
          rw [hBleF]; cases Nat.beq id j <;> rfl
        · intro i hiLt
          have hNeE : Nat.beq id (base + i) = false :=
            nat_beq_false_of_ne (fun h => by
