/-! ### 1. Reusable Move/Copy Read Helper & ZST List Helper -/

private theorem s3d2b_list_all_of_getElem? {α : Type} {p : α → Bool} :
    ∀ {xs : List α},
      (∀ i x, Trusted.MirSemantics.getElem? xs i = some x → p x = true) →
      xs.all p = true
  | [], _ => rfl
  | x :: _tl, h =>
    bool_and_intro (h 0 x rfl)
      (s3d2b_list_all_of_getElem? (fun i y hi => h (i + 1) y hi))

private theorem s3d2b_reassoc_evalOps {α : Type} (pre evals : List α) (l : α) (tail post : List α) :
    pre ++ (evals ++ [l] ++ tail) ++ post = pre ++ evals ++ (l :: (tail ++ post)) := by
  rw [List.append_assoc evals [l] tail,
      ← List.append_assoc pre evals ([l] ++ tail),
      List.append_assoc (pre ++ evals) ([l] ++ tail) post,
      List.append_assoc [l] tail post]
  rfl

private theorem s3d2b_reassoc_evalOps2 {α : Type} (pre evals : List α) (l x : α) (post : List α) :
    pre ++ (evals ++ [l, x]) ++ post = pre ++ evals ++ (l :: ([x] ++ post)) := by
  rw [← List.append_assoc pre evals [l, x],
      List.append_assoc (pre ++ evals) [l, x] post]
  rfl

private noncomputable def s3d2b_mkReadOp (isMove : Bool) (loc : LocalId) : Operand :=
  if isMove then .move { localId := loc, projection := [] }
  else .copy { localId := loc, projection := [] }

private noncomputable def s3d2b_readFieldNicheTail (tagW : IntWidth) (base dst v untagged nStart nLast f nicheField : Nat)
    (uRange : WrappingRange128) (fTy : MirTy) (isMove : Bool) : List EnumStmt :=
  if Nat.beq v untagged then
    if Nat.beq f nicheField then
      mkWrappingRangeCheckStmts tagW (base + 3) (base + 4)
        (.copy { localId := base + 2, projection := [] }) uRange ++
        [.baseStmt (.assign { localId := dst, projection := [] } (.use (s3d2b_mkReadOp isMove (base + 2))))]
    else
      [.baseStmt (.assign { localId := dst, projection := [] }
        (.use (s3d2b_mkReadOp isMove (base + 5 + nicheExtraIdx nicheField f))))]
  else if Nat.ble nStart v && Nat.ble v nLast then
    match fTy with
    | .unit =>
      [.baseStmt (.assign { localId := dst, projection := [] }
        (.use (.constant { ty := .unit, lit := .zeroSized })))]
    | .enum ety =>
      if isZstEnumTy ety then
        [.baseStmt (.assign { localId := dst, projection := [] }
          (.use (.constant { ty := .enum ety, lit := .zeroSized })))]
      else
        [.baseStmt .unsupported]
    | _ => [.baseStmt .unsupported]
  else
    [.baseStmt .unsupported]

private theorem s3d2b_exec_readMoveOrCopy {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₂ : EnumFrame} {cm : CallerMemory} {bbTgt : EnumBlock}
    {pre post : List EnumStmt} {preLen : Nat}
    {dst srcLoc : LocalId} {fTy : MirTy} {isMove : Bool}
    {s1AfterSrc s2In : List EnumSlot} {ovSrc : Option Val}
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hPreLen : pre.length = preLen)
    (hSt : bbTgt.statements = pre ++
      (EnumStmt.baseStmt (.assign { localId := dst, projection := [] }
        (.use (if isMove then .move { localId := srcLoc, projection := [] }
               else .copy { localId := srcLoc, projection := [] })))) :: post)
    (hDstLt : dst < ctx.body.locals.length)
    (hDstNe : dst ≠ plan.enumLocal)
    (hSrcGe : ctx.body.locals.length ≤ srcLoc)
    (hDeclDst : Trusted.MirSemantics.getElem? ctx.body.locals dst = some (.base fTy))
    (hDeclSrc : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).locals srcLoc = some (.base fTy))
    (hSrcSlot : Trusted.MirSemantics.getElem? s2In srcLoc = some (.baseSlot (.live ovSrc)))
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal s1AfterSrc s2In) :
    (ovSrc = none →
      evalStepEnum pOut 0
        { frames := [{ f₂ with stmtIdx := preLen, locals := s2In }], callerMem := cm } =
        .fault .undefined) ∧
    (∀ val, ovSrc = some val →
      (∀ fk, writeEnumBasePlace s1AfterSrc dst fTy val = .error fk →
        evalStepEnum pOut 0
          { frames := [{ f₂ with stmtIdx := preLen, locals := s2In }], callerMem := cm } =
          .fault fk) ∧
      (∀ s1End, writeEnumBasePlace s1AfterSrc dst fTy val = .ok s1End →
        ∃ s2End : List EnumSlot,
          evalStepEnum pOut 0
            { frames := [{ f₂ with stmtIdx := preLen, locals := s2In }], callerMem := cm } =
            .step { frames := [{ f₂ with stmtIdx := preLen + 1, locals := s2End }],
                    callerMem := cm } ∧
          s2End.length = s2In.length ∧
          PrefixSlotsAgree ctx.body.locals.length plan.enumLocal s1End s2End ∧
          Trusted.MirSemantics.getElem? s2End srcLoc =
            some (.baseSlot (.live (if isMove then initFieldOptVal fTy else some val))) ∧
          (∀ j, ctx.body.locals.length ≤ j → j ≠ srcLoc →
            Trusted.MirSemantics.getElem? s2End j =
              Trusted.MirSemantics.getElem? s2In j))) := by
  let base := ctx.body.locals.length
  let ⟨_, _, hDeclPre, _⟩ := scalarizeCtx_target_decl_lookup ctx
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  have hDeclDstTgt : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).locals dst =
      some (.base fTy) := (hDeclPre dst hDstLt hDstNe).trans hDeclDst
  refine ⟨?_, ?_⟩
  · intro hovNone
    subst hovNone
    rw [stepAtStmt (f := { f₂ with stmtIdx := preLen, locals := s2In })
          hB2 hBB2 hSt hPreLen.symm, hStepEqDefs]
    cases isMove with
    | false =>
      dsimp
      unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot
      dsimp
      rw [hDeclDstTgt, hDeclSrc, hSrcSlot]
      dsimp
      rw [mirTy_beq_refl fTy]
      rfl
    | true =>
      dsimp
      let ⟨s2Mv, hSetMv⟩ := setElem?_some_of_lt s2In srcLoc
        (.baseSlot (liveUninitSlot fTy)) (getElem?_some_lt hSrcSlot)
      unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot
      dsimp
      rw [hDeclDstTgt, hDeclSrc, hSrcSlot]
      dsimp
      rw [hSetMv]
      dsimp
      rw [mirTy_beq_refl fTy]
      rfl
  · intro val hovSome
    subst hovSome
    have hOpStep : ∃ s2AfterOp : List EnumSlot,
        evalEnumBaseRvalue (scalarizeTargetBody ctx).locals s2In fTy
          (.use (if isMove then .move { localId := srcLoc, projection := [] }
                 else .copy { localId := srcLoc, projection := [] })) =
          .ok (val, s2AfterOp) ∧
        s2AfterOp.length = s2In.length ∧
        Trusted.MirSemantics.getElem? s2AfterOp srcLoc =
          some (.baseSlot (.live (if isMove then initFieldOptVal fTy else some val))) ∧
        (∀ j, j ≠ srcLoc →
          Trusted.MirSemantics.getElem? s2AfterOp j =
            Trusted.MirSemantics.getElem? s2In j) := by
      cases isMove with
      | false =>
        refine ⟨s2In, ?_, rfl, hSrcSlot, fun _ _ => rfl⟩
        dsimp
        unfold evalEnumBaseRvalue evalEnumBaseOperandToSlot
        dsimp
        rw [hDeclSrc, hSrcSlot]
        dsimp
        rw [mirTy_beq_refl fTy]
        rfl
      | true =>
        let ⟨s2Mv, hSetMv⟩ := setElem?_some_of_lt s2In srcLoc
          (.baseSlot (liveUninitSlot fTy)) (getElem?_some_lt hSrcSlot)
        refine ⟨s2Mv, ?_, setElem?_length hSetMv, ?_,
                fun j hj => setElem?_getElem?_ne hSetMv hj⟩
        · dsimp
          unfold evalEnumBaseRvalue evalEnumBaseOperandToSlot
          dsimp
          rw [hDeclSrc, hSrcSlot]
          dsimp
          rw [hSetMv]
          dsimp
          rw [mirTy_beq_refl fTy]
          rfl
        · dsimp
          rw [← liveUninitSlot_eq_initFieldOptVal fTy]
          exact setElem?_getElem?_same hSetMv
    let ⟨s2AfterOp, hRvOk, hLenOp, hSrcAfterOp, hOtherAfterOp⟩ := hOpStep
    have hPreOp : PrefixSlotsAgree base plan.enumLocal s1AfterSrc s2AfterOp := by
      refine ⟨hPre.1, by rw [hLenOp]; exact hPre.2.1, ?_⟩
      intro j hjLt hjNe
      rw [hOtherAfterOp j (s3d2_ne_of_lt (Nat.lt_of_lt_of_le hjLt hSrcGe))]
      exact hPre.2.2 j hjLt hjNe
    let ⟨hWErr, hWOk⟩ := writeEnumBasePlace_agree (dstTy := fTy) (val := val)
      hPreOp hDstLt hDstNe
    refine ⟨?_, ?_⟩
    · intro fk hErr1
      rw [stepAtStmt (f := { f₂ with stmtIdx := preLen, locals := s2In })
            hB2 hBB2 hSt hPreLen.symm, hStepEqDefs]
      unfold evalEnumStmt; dsimp
      rw [hDeclDstTgt]; dsimp
      rw [hRvOk]; dsimp
      rw [hWErr fk hErr1]
    · intro s1End hOk1
      let ⟨s2End, hOk2, hLenEnd, hPreEnd, hOutEnd⟩ := hWOk s1End hOk1
      refine ⟨s2End, ?_, hLenEnd.trans hLenOp, hPreEnd,
              (hOutEnd srcLoc (Or.inr hSrcGe)).trans hSrcAfterOp,
              fun j hjGe hjNe => (hOutEnd j (Or.inr hjGe)).trans (hOtherAfterOp j hjNe)⟩
      rw [stepAtStmt (f := { f₂ with stmtIdx := preLen, locals := s2In })
            hB2 hBB2 hSt hPreLen.symm, hStepEqDefs]
      unfold evalEnumStmt; dsimp
      rw [hDeclDstTgt]; dsimp
      rw [hRvOk]; dsimp
      rw [hOk2]

/-! ### 2. Target `enumLocal` Simulation for `readField` -/

private theorem s3d2b_readField_enumLocal_sim {plan : EnumScalarizePlan} {pSrc pOut : EnumProgram}
    (ctx : ScalarizeCtx plan pSrc pOut)
    {f₁ f₂ : EnumFrame} {cm : CallerMemory} {bb bbTgt : EnumBlock}
    {preStmts postStmts : List EnumStmt}
    {dst : LocalId} {v f : Nat} {isMove : Bool} {sl : EnumSlot}
    (hDef1 : f₁.defId = plan.defId)
    (hDef2 : f₂.defId = f₁.defId)
    (hBlkEq : f₂.blockIdx = f₁.blockIdx)
    (hBB1 : Trusted.MirSemantics.getElem? ctx.body.basicBlocks f₁.blockIdx = some bb)
    (hStmt1 : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx =
      some (.readField dst plan.enumLocal v f isMove))
    (hF2Idx : f₂.stmtIdx = preStmts.length)
    (hPreEq : preStmts =
      listFlatMap (lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed)
        (bb.statements.take f₁.stmtIdx))
    (hB2 : Trusted.MirSemantics.getElem? pOut.bodies f₂.defId = some (scalarizeTargetBody ctx))
    (hBB2 : Trusted.MirSemantics.getElem? (scalarizeTargetBody ctx).basicBlocks f₂.blockIdx = some bbTgt)
    (hBbTgtStmts : bbTgt.statements =
      preStmts ++
        lowerEnumStmt plan.enumLocal ctx.body.locals.length ctx.compTys.length ctx.ed
          (.readField dst plan.enumLocal v f isMove) ++
        postStmts)
    (hStChk : checkStmtForEnumLocal ctx.body.locals plan.enumLocal ctx.ed
      (.readField dst plan.enumLocal v f isMove) = true)
    (hStBnd : enumStmtLocalsInBounds ctx.body.locals.length
      (.readField dst plan.enumLocal v f isMove) = true)
    (hPre : PrefixSlotsAgree ctx.body.locals.length plan.enumLocal f₁.locals f₂.locals)
    (hSl1 : Trusted.MirSemantics.getElem? f₁.locals plan.enumLocal = some sl)
    (hMatch : SlotMatchesComp ctx.ed ctx.body.locals.length ctx.compTys sl f₂.locals)
    (hDirectInv : DirectTagInhabitedInv ctx { frames := [f₁], callerMem := cm }) :
    SimStepResult ctx { frames := [f₂], callerMem := cm }
      (evalEnumStmt pSrc.enumDefs ctx.body f₁ cm (.readField dst plan.enumLocal v f isMove)) := by
  let base := ctx.body.locals.length
  let ⟨hDeclLive, _⟩ := s3d_compDecls_common ctx
  let ⟨_, _, hDeclPre, _⟩ := scalarizeCtx_target_decl_lookup ctx
  let ⟨hStepEqDefs, _, _, _⟩ := scalarizeCtx_enumDefs_step_eq ctx hB2
  have hDstLt : dst < base := nat_blt_lt (bool_and_true hStBnd).1
  unfold checkStmtForEnumLocal at hStChk; dsimp at hStChk
  rw [nat_beq_refl] at hStChk; dsimp at hStChk
  let ⟨hDstNeB, hChkRest⟩ := bool_and_true hStChk
  have hDstNeBFalse : Nat.beq dst plan.enumLocal = false := bool_not_true hDstNeB
  have hDstNe : dst ≠ plan.enumLocal := nat_ne_of_beq_false hDstNeBFalse
  have hUnpackChk : ∃ vd fTy,
      Trusted.MirSemantics.getElem? ctx.body.locals dst = some (.base fTy) ∧
      Trusted.MirSemantics.getElem? ctx.ed.variants v = some vd ∧
      Trusted.MirSemantics.getElem? vd.fields f = some fTy := by
    cases hd : Trusted.MirSemantics.getElem? ctx.body.locals dst with
    | none => rw [hd] at hChkRest; cases hChkRest
    | some dDecl =>
      rw [hd] at hChkRest
      cases dDecl with
      | adtEnum _ => cases hChkRest
      | base dstTy =>
        cases hv : Trusted.MirSemantics.getElem? ctx.ed.variants v with
        | none => rw [hv] at hChkRest; cases hChkRest
        | some vd =>
          rw [hv] at hChkRest; dsimp at hChkRest
          cases hf : Trusted.MirSemantics.getElem? vd.fields f with
          | none => rw [hf] at hChkRest; cases hChkRest
          | some fTy =>
            rw [hf] at hChkRest
            have hTyEq : fTy = dstTy := mirTy_beq_eq hChkRest
            subst hTyEq
            exact ⟨vd, fTy, rfl, rfl, hf⟩
  let ⟨vd, fTy, hDeclDst, hvGet, hfGet⟩ := hUnpackChk
  have hfLt : f < vd.fields.length := getElem?_some_lt hfGet
  have hInvSl : ∀ vx vfs vdx,
      sl = .liveDirect (some vx) vfs →
      Trusted.MirSemantics.getElem? ctx.ed.variants vx = some vdx →
      variantIsUninhabited vdx = false :=
    fun vx vfs vdx hsl hv =>
      hDirectInv f₁ vx vfs vdx rfl hDef1 (by rw [hsl] at hSl1; exact hSl1) hv
  dsimp [lowerEnumStmt] at hBbTgtStmts
  rw [nat_beq_refl] at hBbTgtStmts; dsimp at hBbTgtStmts
  cases hLay : ctx.ed.layout with
  | empty =>
    have hEmpty : ctx.ed.variants.isEmpty = true := by
      have hA := ctx.hEdAdm; unfold adtEnumDefAdmitted at hA; rw [hLay] at hA
      exact (bool_and_true hA).2
    cases hVs : ctx.ed.variants with
    | nil => rw [hVs] at hvGet; cases hvGet
    | cons _ _ => rw [hVs] at hEmpty; cases hEmpty
  | single =>
    let ⟨vd₀, hv0Get, hLen1, _, hFieldDecls⟩ := s3d_compDecls_single ctx hLay
    have hvZero : v = 0 := by
      have hvLt1 : v < 1 := by rw [← hLen1]; exact getElem?_some_lt hvGet
      cases v with
      | zero => rfl
      | succ v' => exact False.elim (Nat.not_lt_zero v' (Nat.lt_of_succ_lt_succ hvLt1))
    subst hvZero
    rw [hv0Get] at hvGet; injection hvGet with hvdEq; subst hvdEq
    let ⟨hDeclPay, _⟩ := hFieldDecls f fTy hfGet
    rw [hLay, hv0Get] at hBbTgtStmts; dsimp at hBbTgtStmts
    let fSlot := base + 2 + f
    let stRead : EnumStmt := .baseStmt (.assign { localId := dst, projection := [] }
      (.use (if isMove then .move { localId := fSlot, projection := [] }
             else .copy { localId := fSlot, projection := [] })))
    have hStLive : bbTgt.statements = preStmts ++ (mkLivenessCheckStmt base) :: (stRead :: postStmts) := by
      rw [hBbTgtStmts, List.append_assoc]; rfl
    cases sl with
    | baseSlot _ => exact False.elim hMatch.2
    | liveEmpty => rw [hMatch.2.1] at hLay; cases hLay
    | liveDirect _ _ => let ⟨_, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
    | liveNiche _ _ =>
      let ⟨_, _, _, _, _, _, _, _, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
    | enumDead =>
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.readField dst plan.enumLocal 0 f isMove) = .fault .undefined := by
        unfold evalEnumStmt readAdtField; dsimp
        rw [hDstNeBFalse]; dsimp
        rw [hDeclDst, ctx.hEnumDecl, hSl1]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [hv0Get]; dsimp
        rw [hfGet]; dsimp
        rw [mirTy_beq_refl fTy]; dsimp
        rw [ctx.hEdAdm]; rfl
      have hEv2 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } = .fault .undefined :=
        (stepAtStmt hB2 hBB2 hStLive hF2Idx).trans
          ((hStepEqDefs _ cm _).trans (eval_mkLivenessCheckStmt_dead hDeclLive hMatch.2))
      exact simFault0 hEv1 hEv2
    | liveSingle fs =>
      let ⟨_, vd₀', hv0', hfsLen, hLiveSlot, hFsAt⟩ := hMatch.2
      rw [hv0Get] at hv0'; injection hv0' with hvEq'; subst hvEq'
      have hStep1 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } =
          .step { frames := [{ f₂ with stmtIdx := preStmts.length + 1 }], callerMem := cm } := by
        rw [stepAtStmt hB2 hBB2 hStLive hF2Idx, hStepEqDefs,
            eval_mkLivenessCheckStmt_live hDeclLive hLiveSlot, hF2Idx]
      refine simStepResult_prepend_step hStep1 ?_
      let pre1 := preStmts ++ [mkLivenessCheckStmt base]
      have hPre1Len : pre1.length = preStmts.length + 1 := list_append_length preStmts [_]
      have hStRd : bbTgt.statements = pre1 ++ stRead :: postStmts := by
        dsimp [pre1]; rw [hStLive]; change preStmts ++ ([_] ++ _) = _; rw [← List.append_assoc]
      let ⟨ovOld, hGetFsOld⟩ := getElem?_some_of_lt fs f (by rw [hfsLen]; exact hfLt)
      have hPaySlot : Trusted.MirSemantics.getElem? f₂.locals fSlot =
          some (.baseSlot (.live ovOld)) := hFsAt f ovOld hGetFsOld
      have hFSlotGe : base ≤ fSlot := by
        dsimp [fSlot]; rw [Nat.add_assoc]; exact Nat.le_add_right base _
      cases ovOld with
      | none =>
        let ⟨hRdNone, _⟩ := s3d2b_exec_readMoveOrCopy (cm := cm) (s1AfterSrc := f₁.locals)
          ctx hB2 hBB2 hPre1Len hStRd hDstLt hDstNe hFSlotGe hDeclDst hDeclPay hPaySlot hPre
        have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
            (.readField dst plan.enumLocal 0 f isMove) = .fault .undefined := by
          unfold evalEnumStmt readAdtField; dsimp
          rw [hDstNeBFalse]; dsimp
          rw [hDeclDst, ctx.hEnumDecl, hSl1]; dsimp
          rw [ctx.hEdGet]; dsimp
          rw [hv0Get]; dsimp
          rw [hfGet]; dsimp
          rw [mirTy_beq_refl fTy]; dsimp
          rw [ctx.hEdAdm]; dsimp
          rw [hGetFsOld]
        exact simFault0 hEv1 (hRdNone rfl)
      | some val =>
        have hNewSl : ∃ fs' : List (Option Val),
            readAdtField ctx.ed 0 f fTy isMove (.liveSingle fs) = .ok (val, .liveSingle fs') ∧
            fs'.length = fs.length ∧
            Trusted.MirSemantics.getElem? fs' f =
              some (if isMove then initFieldOptVal fTy else some val) ∧
            (∀ fx, fx ≠ f →
              Trusted.MirSemantics.getElem? fs' fx = Trusted.MirSemantics.getElem? fs fx) := by
          unfold readAdtField; dsimp
          rw [ctx.hEdAdm]; dsimp
          rw [hGetFsOld]; dsimp
          cases isMove with
          | false =>
            exact ⟨fs, rfl, rfl, hGetFsOld, fun _ _ => rfl⟩
          | true =>
            dsimp
            let ⟨fs', hSetFs⟩ := setElem?_some_of_lt fs f (initFieldOptVal fTy)
              (getElem?_some_lt hGetFsOld)
            change ∃ fs',
              (match setElem? fs f (initFieldOptVal fTy) with
                | some fs' => Except.ok (val, EnumSlot.liveSingle fs')
                | none => Except.error FaultKind.unsupported) =
                Except.ok (val, EnumSlot.liveSingle fs') ∧ _
            rw [hSetFs]
            exact ⟨fs', rfl, setElem?_length hSetFs,
                   setElem?_getElem?_same hSetFs,
                   fun fx hne => setElem?_getElem?_ne hSetFs hne⟩
        let ⟨fs', hRdOk, hfs'Len, hfs'Same, hfs'Ne⟩ := hNewSl
        let ⟨s1AfterSrc, hSet1Src⟩ := setElem?_some_of_lt f₁.locals plan.enumLocal
          (.liveSingle fs') (getElem?_some_lt hSl1)
        have hPreAfterSrc : PrefixSlotsAgree base plan.enumLocal s1AfterSrc f₂.locals := by
          refine ⟨(setElem?_length hSet1Src).trans hPre.1, hPre.2.1, ?_⟩
          intro j hjLt hjNe
          rw [setElem?_getElem?_ne hSet1Src hjNe]
          exact hPre.2.2 j hjLt hjNe
        let ⟨_, hRdSome⟩ := s3d2b_exec_readMoveOrCopy (cm := cm)
          ctx hB2 hBB2 hPre1Len hStRd hDstLt hDstNe hFSlotGe hDeclDst hDeclPay hPaySlot hPreAfterSrc
        let ⟨hWErr, hWOk⟩ := hRdSome val rfl
        cases hW1 : writeEnumBasePlace s1AfterSrc dst fTy val with
        | error fk =>
          have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
              (.readField dst plan.enumLocal 0 f isMove) = .fault fk := by
            unfold evalEnumStmt; dsimp
            rw [hDstNeBFalse]; dsimp
            rw [hDeclDst, ctx.hEnumDecl, hSl1]; dsimp
            rw [ctx.hEdGet]; dsimp
            rw [hv0Get]; dsimp
            rw [hfGet]; dsimp
            rw [mirTy_beq_refl fTy]; dsimp
            rw [hRdOk]; dsimp
            rw [hSet1Src]; dsimp
            rw [hW1]
          exact simFault0 hEv1 (hWErr fk hW1)
        | ok s1End =>
          let ⟨s2End, hStep2, hLenEnd, hPreEnd, hSlotSame, hSlotNe⟩ := hWOk s1End hW1
          have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
              (.readField dst plan.enumLocal 0 f isMove) =
              .step { frames := [{ f₁ with stmtIdx := f₁.stmtIdx + 1, locals := s1End }],
                      callerMem := cm } := by
            unfold evalEnumStmt; dsimp
            rw [hDstNeBFalse]; dsimp
            rw [hDeclDst, ctx.hEnumDecl, hSl1]; dsimp
            rw [ctx.hEdGet]; dsimp
            rw [hv0Get]; dsimp
            rw [hfGet]; dsimp
            rw [mirTy_beq_refl fTy]; dsimp
            rw [hRdOk]; dsimp
            rw [hSet1Src]; dsimp
            rw [hW1]
          have hSl1End : Trusted.MirSemantics.getElem? s1End plan.enumLocal =
              some (.liveSingle fs') :=
            (s3d_writeEnumBasePlace_preserves_ne (fun h => hDstNe h.symm) hW1).trans (setElem?_getElem?_same hSet1Src)
          have hMatchEnd : SlotMatchesComp ctx.ed base ctx.compTys (.liveSingle fs') s2End := by
            refine ⟨hLenEnd.trans hMatch.1, hLay, vd₀, hv0Get, hfs'Len.trans hfsLen, ?_, ?_⟩
            · have hBLt : base < fSlot := by
                dsimp [fSlot]; rw [Nat.add_assoc]
