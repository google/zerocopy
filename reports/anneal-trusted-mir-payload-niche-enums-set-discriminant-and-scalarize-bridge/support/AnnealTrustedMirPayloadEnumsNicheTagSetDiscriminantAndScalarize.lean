                  have hArP : pBase + i = base + 3 + (vOff + i) :=
                    Nat.add_assoc (base + 3) vOff i
                  rw [hArS, hArP]
                  exact ⟨(hFieldDecls v vd i ty hvGet hi).2,
                         (hFieldDecls v vd i ty hvGet hi).1⟩)
                hScrMid
                (fun i hi => by
                  let ⟨ov, hgi⟩ := getElem?_some_of_lt fs i (by rw [hfsLen]; exact hi)
