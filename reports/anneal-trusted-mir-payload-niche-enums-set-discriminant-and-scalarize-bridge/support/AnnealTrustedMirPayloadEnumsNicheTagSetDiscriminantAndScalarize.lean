          rw [hLay] at hPost; dsimp at hPost
          rw [hv0Get] at hPost; dsimp at hPost
          rw [hUninh] at hPost; dsimp [List.length] at hPost
          rw [← hF2Idx] at hStep1 hStep2Eq
          exact simStepPlus hEv1Eq hStep1
            (ReachesNEnum.succ hStep2Eq (ReachesNEnum.zero _)) hPost
  | direct tagW tagS =>
    let ⟨_, hDeclTag, _⟩ := s3d_compDecls_direct ctx hLay
    rw [hLay] at hBbTgtStmts; dsimp at hBbTgtStmts
    let stAssign : EnumStmt := .baseStmt (.assign { localId := dst, projection := [] }
      (.discriminant { localId := base + 2, projection := [] }))
    have hSt1 : bbTgt.statements = preStmts ++ (mkLivenessCheckStmt base) :: (stAssign :: postStmts) := by
      rw [hBbTgtStmts, List.append_assoc]; rfl
    cases sl with
    | baseSlot _ => exact False.elim hMatch.2
    | liveEmpty => rw [hMatch.2.1] at hLay; cases hLay
    | liveSingle _ => rw [hMatch.2.1] at hLay; cases hLay
    | liveNiche _ _ =>
      let ⟨_, _, _, _, _, _, _, _, _, hL, _⟩ := hMatch.2; rw [hL] at hLay; cases hLay
    | enumDead =>
      have hEv1 : evalEnumStmt pSrc.enumDefs ctx.body f₁ cm
          (.discriminantDirect dst plan.enumLocal) = .fault .undefined := by
        unfold evalEnumStmt readAdtDiscriminant; dsimp
        rw [hDstSrc, ctx.hEnumDecl, hSl1]; dsimp
        rw [ctx.hEdGet]; dsimp
        rw [hDstTyBeq]; dsimp
        rw [hLay, ctx.hEdAdm]; rfl
      have hEv2 : evalStepEnum pOut 0 { frames := [f₂], callerMem := cm } = .fault .undefined :=
        (stepAtStmt hB2 hBB2 hSt1 hF2Idx).trans
