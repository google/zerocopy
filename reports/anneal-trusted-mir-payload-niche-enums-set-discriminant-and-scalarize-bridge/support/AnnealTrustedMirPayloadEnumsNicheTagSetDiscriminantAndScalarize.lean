/-! ### 1. Exact Alignment of `liveUninitSlot` and `initFieldOptVal` & List Offset Helpers -/

private theorem liveUninitSlot_eq_initFieldOptVal (ty : MirTy) :
    liveUninitSlot ty = .live (initFieldOptVal ty) := by
  cases ty with
  | unit => rfl
  | enum ety =>
    unfold initFieldOptVal
    dsimp
    have hDef : liveUninitSlot (.enum ety) =
        (if isZstEnumTy ety then LocalSlot.live (some (.enumVal ety 0))
         else LocalSlot.live none) := rfl
    rw [hDef]
    cases isZstEnumTy ety <;> rfl
  | bool | int _ _ | tuple _ | ref _ _ | rawPtr _ _ | never | unsupported => rfl

private theorem list_append_length {α : Type} :
    ∀ (xs ys : List α), (xs ++ ys).length = xs.length + ys.length
  | [], ys => by dsimp [List.length]; rw [Nat.zero_add]
  | _ :: xs, ys => by dsimp [List.length]; rw [Nat.succ_add, list_append_length xs ys]

private theorem list_map_length {α β : Type} (f : α → β) :
    ∀ (xs : List α), (xs.map f).length = xs.length
  | [] => rfl
  | _ :: xs => congrArg Nat.succ (list_map_length f xs)

private theorem directVariantFieldOffset_bound :
    ∀ (vs : List VariantDef) {v : Nat} {vd : VariantDef},
      Trusted.MirSemantics.getElem? vs v = some vd →
      directVariantFieldOffset vs v + vd.fields.length ≤
        (listFlatMap (fun vd => vd.fields) vs).length
  | [], _, _, h => by cases h
  | vd₀ :: rest, 0, _, h => by
    injection h with heq; subst heq
    dsimp [directVariantFieldOffset, listFlatMap]
    rw [Nat.zero_add, list_append_length]
    exact Nat.le_add_right _ _
  | vd₀ :: rest, v + 1, vd, h => by
    dsimp [directVariantFieldOffset, listFlatMap]
    rw [list_append_length, Nat.add_assoc]
    exact Nat.add_le_add_left (directVariantFieldOffset_bound rest h) vd₀.fields.length

private theorem directVariantFieldOffset_lookup :
    ∀ (vs : List VariantDef) {v f : Nat} {vd : VariantDef} {fTy : MirTy},
      Trusted.MirSemantics.getElem? vs v = some vd →
      Trusted.MirSemantics.getElem? vd.fields f = some fTy →
      Trusted.MirSemantics.getElem? (listFlatMap (fun vd => vd.fields) vs)
        (directVariantFieldOffset vs v + f) = some fTy
  | [], _, _, _, _, hv, _ => by cases hv
  | vd₀ :: rest, 0, f, _, _, hv, hf => by
    injection hv with heq; subst heq
    dsimp [directVariantFieldOffset, listFlatMap]
    rw [Nat.zero_add, getElem?_append_left (getElem?_some_lt hf)]
    exact hf
  | vd₀ :: rest, v + 1, f, vd, fTy, hv, hf => by
    dsimp [directVariantFieldOffset, listFlatMap]
    rw [Nat.add_assoc, getElem?_append_right vd₀.fields _ _]
    exact directVariantFieldOffset_lookup rest hv hf

private theorem directVariantFieldOffset_disjoint :
    ∀ (vs : List VariantDef) {v₁ f₁ v₂ f₂ : Nat} {vd₁ vd₂ : VariantDef},
      Trusted.MirSemantics.getElem? vs v₁ = some vd₁ →
      Trusted.MirSemantics.getElem? vs v₂ = some vd₂ →
      f₁ < vd₁.fields.length →
      f₂ < vd₂.fields.length →
      directVariantFieldOffset vs v₁ + f₁ = directVariantFieldOffset vs v₂ + f₂ →
      v₁ = v₂ ∧ f₁ = f₂
  | [], _, _, _, _, _, _, hv1, _, _, _, _ => by cases hv1
  | _ :: _, 0, f₁, 0, f₂, _, _, _, _, _, _, hEq => by
    dsimp [directVariantFieldOffset] at hEq
    rw [Nat.zero_add, Nat.zero_add] at hEq
    exact ⟨rfl, hEq⟩
  | vd₀ :: rest, 0, f₁, v₂ + 1, f₂, _, _, hv1, _, hf1, _, hEq => by
    injection hv1 with heq; subst heq
    dsimp [directVariantFieldOffset] at hEq
    rw [Nat.zero_add, Nat.add_assoc] at hEq
    have hGe : vd₀.fields.length ≤ f₁ := by
      rw [hEq]
      exact Nat.le_add_right _ _
    exact False.elim (Nat.not_lt_of_ge hGe hf1)
  | vd₀ :: rest, v₁ + 1, f₁, 0, f₂, _, _, _, hv2, _, hf2, hEq => by
    injection hv2 with heq; subst heq
    dsimp [directVariantFieldOffset] at hEq
    rw [Nat.zero_add, Nat.add_assoc] at hEq
    have hGe : vd₀.fields.length ≤ f₂ := by
      rw [← hEq]
      exact Nat.le_add_right _ _
    exact False.elim (Nat.not_lt_of_ge hGe hf2)
  | vd₀ :: rest, v₁ + 1, f₁, v₂ + 1, f₂, vd₁, vd₂, hv1, hv2, hf1, hf2, hEq => by
    dsimp [directVariantFieldOffset] at hEq
    rw [Nat.add_assoc, Nat.add_assoc] at hEq
    have hSub := Nat.add_left_cancel hEq
    let ⟨hvEq, hfEq⟩ := directVariantFieldOffset_disjoint rest hv1 hv2 hf1 hf2 hSub
    exact ⟨congrArg Nat.succ hvEq, hfEq⟩

private theorem nicheExtraFieldTysAux_gt (nicheField : Nat) :
    ∀ (idx : Nat) (tys : List MirTy),
      nicheField < idx →
      nicheExtraFieldTysAux nicheField idx tys = tys
  | _, [], _ => rfl
  | idx, ty :: rest, hLt => by
    unfold nicheExtraFieldTysAux
    have hNe : Nat.beq idx nicheField = false :=
      nat_beq_false_of_ne (fun h => by subst h; exact Nat.lt_irrefl _ hLt)
    rw [hNe]
    dsimp
    rw [nicheExtraFieldTysAux_gt nicheField (idx + 1) rest
          (Nat.lt_trans hLt (Nat.lt_succ_self idx))]

private theorem initNicheExtraFieldsAux_eq_map (nicheField : Nat) :
    ∀ (idx : Nat) (tys : List MirTy),
      initNicheExtraFieldsAux nicheField idx tys =
        (nicheExtraFieldTysAux nicheField idx tys).map initFieldOptVal
  | _, [] => rfl
  | idx, ty :: rest => by
    unfold initNicheExtraFieldsAux nicheExtraFieldTysAux
    cases Nat.beq idx nicheField with
    | true =>
      dsimp
      exact initNicheExtraFieldsAux_eq_map nicheField (idx + 1) rest
    | false =>
      dsimp [List.map]
      exact congrArg (List.cons (initFieldOptVal ty))
        (initNicheExtraFieldsAux_eq_map nicheField (idx + 1) rest)

private theorem nicheExtraFieldTysAux_lookup (nicheField : Nat) :
    ∀ (tys : List MirTy) (idx f : Nat) (fTy : MirTy),
      idx ≤ f →
      idx ≤ nicheField →
      f ≠ nicheField →
      Trusted.MirSemantics.getElem? tys (f - idx) = some fTy →
      Trusted.MirSemantics.getElem? (nicheExtraFieldTysAux nicheField idx tys)
        (nicheExtraIdx nicheField f - idx) = some fTy
  | [], _, _, _, _, _, _, hg => by cases hg
  | ty₀ :: rest, idx, f, fTy, hIdxLeF, hIdxLeN, hFNeN, hg => by
    unfold nicheExtraFieldTysAux
    cases hEqIN : Nat.beq idx nicheField with
    | true =>
      dsimp
      have hIN : idx = nicheField := nat_beq_eq hEqIN
      subst hIN
      rw [nicheExtraFieldTysAux_gt idx (idx + 1) rest (Nat.lt_succ_self idx)]
      have hFLtN_false : Nat.blt f idx = false := by
        cases hb : Nat.blt f idx with
        | false => rfl
        | true => exact False.elim (Nat.not_lt_of_ge hIdxLeF (nat_blt_lt hb))
      unfold nicheExtraIdx
      rw [hFLtN_false]
      dsimp
      have hIdxLtF : idx < f := by
        cases Nat.eq_or_lt_of_le hIdxLeF with
        | inl heq => exact False.elim (hFNeN heq.symm)
        | inr hlt => exact hlt
      have hSubPos : 1 ≤ f - idx := Nat.sub_pos_of_lt hIdxLtF
      cases hSub : f - idx with
      | zero => rw [hSub] at hSubPos; cases hSubPos
      | succ d =>
        rw [hSub] at hg
        have hgRest : Trusted.MirSemantics.getElem? rest d = some fTy := hg
        have hArith : f - 1 - idx = d := by
          have h1 : f = idx + (d + 1) := by
            have hAdd := Nat.sub_add_cancel hIdxLeF
            rw [hSub, Nat.add_comm] at hAdd
            exact hAdd.symm
          rw [h1, ← Nat.add_assoc idx d 1, Nat.add_sub_cancel]
          exact Nat.add_sub_cancel_left idx d
        rw [hArith]
        exact hgRest
    | false =>
      dsimp
      have hINeN : idx ≠ nicheField := nat_ne_of_beq_false hEqIN
      have hIdxLtN : idx < nicheField := by
        cases Nat.eq_or_lt_of_le hIdxLeN with
        | inl heq => exact False.elim (hINeN heq)
        | inr hlt => exact hlt
      cases Nat.eq_or_lt_of_le hIdxLeF with
      | inl hEqIF =>
        subst hEqIF
        rw [Nat.sub_self] at hg
        injection hg with hTyEq; subst hTyEq
        unfold nicheExtraIdx
        rw [nat_lt_blt hIdxLtN]
        dsimp
        rw [Nat.sub_self]
        rfl
      | inr hIdxLtF =>
        have hSuccLeF : idx + 1 ≤ f := hIdxLtF
        have hSuccLeN : idx + 1 ≤ nicheField := hIdxLtN
        have hSubF : f - idx = (f - (idx + 1)) + 1 := by
          have h1 : (f - (idx + 1)) + 1 + idx = f := by
            rw [Nat.add_assoc, Nat.add_comm 1 idx]
            exact Nat.sub_add_cancel hSuccLeF
          exact nat_sub_eq_of_add_eq (by rw [Nat.add_comm]; exact h1)
        rw [hSubF] at hg
        have hgRest : Trusted.MirSemantics.getElem? rest (f - (idx + 1)) = some fTy := hg
        have hSuccLeExtra : idx + 1 ≤ nicheExtraIdx nicheField f := by
          unfold nicheExtraIdx
          cases hb : Nat.blt f nicheField with
          | true => dsimp; exact hSuccLeF
          | false =>
            dsimp
            have hNLeF : nicheField ≤ f := by
              cases nat_le_or_gt nicheField f with
              | inl hle => exact hle
              | inr hgt =>
                rw [nat_lt_blt hgt] at hb; cases hb
            have hNLtF : nicheField < f := by
              cases Nat.eq_or_lt_of_le hNLeF with
              | inl heq => exact False.elim (hFNeN heq.symm)
              | inr hlt => exact hlt
            have hPredGeN : nicheField ≤ f - 1 := Nat.le_sub_one_of_lt hNLtF
            exact Nat.le_trans hSuccLeN hPredGeN
        have hSubE : nicheExtraIdx nicheField f - idx =
            (nicheExtraIdx nicheField f - (idx + 1)) + 1 := by
          have h1 : (nicheExtraIdx nicheField f - (idx + 1)) + 1 + idx =
              nicheExtraIdx nicheField f := by
            rw [Nat.add_assoc, Nat.add_comm 1 idx]
            exact Nat.sub_add_cancel hSuccLeExtra
          exact nat_sub_eq_of_add_eq (by rw [Nat.add_comm]; exact h1)
        rw [hSubE]
        exact nicheExtraFieldTysAux_lookup nicheField rest (idx + 1) f fTy
          hSuccLeF hSuccLeN hFNeN hgRest

private theorem nicheExtraIdx_inj {nicheField f₁ f₂ : Nat}
    (h1 : f₁ ≠ nicheField) (h2 : f₂ ≠ nicheField)
    (hEq : nicheExtraIdx nicheField f₁ = nicheExtraIdx nicheField f₂) :
    f₁ = f₂ := by
  unfold nicheExtraIdx at hEq
  cases hb1 : Nat.blt f₁ nicheField with
  | true =>
    rw [hb1] at hEq; dsimp at hEq
    cases hb2 : Nat.blt f₂ nicheField with
    | true =>
      rw [hb2] at hEq; dsimp at hEq; exact hEq
    | false =>
      rw [hb2] at hEq; dsimp at hEq
      have hLt1 : f₁ < nicheField := nat_blt_lt hb1
      have hGe2 : nicheField ≤ f₂ := by
        cases nat_le_or_gt nicheField f₂ with
        | inl hle => exact hle
        | inr hgt => rw [nat_lt_blt hgt] at hb2; cases hb2
      have hLt2 : nicheField < f₂ := by
        cases Nat.eq_or_lt_of_le hGe2 with
        | inl heq => exact False.elim (h2 heq.symm)
        | inr hlt => exact hlt
      have hGePred : nicheField ≤ f₂ - 1 := Nat.le_sub_one_of_lt hLt2
      rw [← hEq] at hGePred
      exact False.elim (Nat.not_lt_of_ge hGePred hLt1)
  | false =>
    rw [hb1] at hEq; dsimp at hEq
    have hGe1 : nicheField ≤ f₁ := by
      cases nat_le_or_gt nicheField f₁ with
      | inl hle => exact hle
      | inr hgt => rw [nat_lt_blt hgt] at hb1; cases hb1
    have hLt1 : nicheField < f₁ := by
      cases Nat.eq_or_lt_of_le hGe1 with
      | inl heq => exact False.elim (h1 heq.symm)
      | inr hlt => exact hlt
    cases hb2 : Nat.blt f₂ nicheField with
    | true =>
      rw [hb2] at hEq; dsimp at hEq
      have hLt2 : f₂ < nicheField := nat_blt_lt hb2
      have hGePred : nicheField ≤ f₁ - 1 := Nat.le_sub_one_of_lt hLt1
      rw [hEq] at hGePred
      exact False.elim (Nat.not_lt_of_ge hGePred hLt2)
    | false =>
      rw [hb2] at hEq; dsimp at hEq
      have hGe2 : nicheField ≤ f₂ := by
        cases nat_le_or_gt nicheField f₂ with
        | inl hle => exact hle
        | inr hgt => rw [nat_lt_blt hgt] at hb2; cases hb2
      have hLt2 : nicheField < f₂ := by
        cases Nat.eq_or_lt_of_le hGe2 with
        | inl heq => exact False.elim (h2 heq.symm)
        | inr hlt => exact hlt
      have hPos1 : 1 ≤ f₁ := Nat.lt_of_le_of_lt (Nat.zero_le _) hLt1
      have hPos2 : 1 ≤ f₂ := Nat.lt_of_le_of_lt (Nat.zero_le _) hLt2
      have hAdd := congrArg (fun x => x + 1) hEq
      rw [Nat.sub_add_cancel hPos1, Nat.sub_add_cancel hPos2] at hAdd
      exact hAdd

/-! ### 2. Multi-Step `mkStorageLiveRange` & `mkStorageDeadRange` Execution -/

private theorem exec_mkStorageLiveRange
    {p : EnumProgram} {body : EnumBody} {bb : EnumBlock}
    {defId : DefId} {blockIdx : BasicBlockId} {cm : CallerMemory} :
    ∀ (tys : List MirTy) (start : LocalId)
      (pre post : List EnumStmt) (slots : List EnumSlot),
      bb.statements = pre ++ mkStorageLiveRange start tys.length ++ post →
      Trusted.MirSemantics.getElem? p.bodies defId = some body →
      Trusted.MirSemantics.getElem? body.basicBlocks blockIdx = some bb →
      (∀ i ty, Trusted.MirSemantics.getElem? tys i = some ty →
        Trusted.MirSemantics.getElem? body.locals (start + i) = some (.base ty)) →
      start + tys.length ≤ slots.length →
      ∃ slots' : List EnumSlot,
        ReachesNEnum p tys.length
          { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots }],
            callerMem := cm }
          { frames := [{ defId, blockIdx, stmtIdx := pre.length + tys.length, locals := slots' }],
            callerMem := cm } ∧
        slots'.length = slots.length ∧
        (∀ j, (j < start ∨ start + tys.length ≤ j) →
          Trusted.MirSemantics.getElem? slots' j = Trusted.MirSemantics.getElem? slots j) ∧
        (∀ i ty, Trusted.MirSemantics.getElem? tys i = some ty →
          Trusted.MirSemantics.getElem? slots' (start + i) =
            some (.baseSlot (.live (initFieldOptVal ty))))
  | [], _, pre, _, slots, _, _, _, _, _ => by
    refine ⟨slots, ReachesNEnum.zero _, rfl, fun _ _ => rfl, fun _ _ h => by cases h⟩
  | ty₀ :: rest, start, pre, post, slots, hStmts, hB, hBB, hDecls, hBound => by
    dsimp [List.length, mkStorageLiveRange] at hStmts
    have hSt1 : bb.statements = pre ++ (EnumStmt.baseStmt (.storageLive start)) ::
        (mkStorageLiveRange (start + 1) rest.length ++ post) := by
      rw [hStmts, List.append_assoc]
      rfl
    have hDecl0 : Trusted.MirSemantics.getElem? body.locals start = some (.base ty₀) := by
      have h0 := hDecls 0 ty₀ rfl
      rw [Nat.add_zero] at h0
      exact h0
    have hStartLt : start < slots.length :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)) hBound
    let sl₀ : EnumSlot := .baseSlot (.live (initFieldOptVal ty₀))
    let ⟨slots₁, hSet1⟩ := setElem?_some_of_lt slots start sl₀ hStartLt
    have hStep1 : evalStepEnum p 0
        { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots }],
          callerMem := cm } =
        .step { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₁ }],
                callerMem := cm } := by
      rw [stepAtStmt hB hBB hSt1 rfl]
      unfold evalEnumStmt liveUninitEnumSlot
      dsimp
      rw [hDecl0]
      dsimp
      rw [liveUninitSlot_eq_initFieldOptVal ty₀, hSet1]
    have hLen1 : slots₁.length = slots.length := setElem?_length hSet1
    have hStRest : bb.statements = (pre ++ [EnumStmt.baseStmt (.storageLive start)]) ++
        mkStorageLiveRange (start + 1) rest.length ++ post := by
      rw [hSt1]
      change pre ++ ([EnumStmt.baseStmt (.storageLive start)] ++
        (mkStorageLiveRange (start + 1) rest.length ++ post)) = _
      rw [← List.append_assoc, ← List.append_assoc]
    have hPre1Len : (pre ++ [EnumStmt.baseStmt (.storageLive start)]).length = pre.length + 1 :=
      list_append_length pre [EnumStmt.baseStmt (.storageLive start)]
    have hDeclsRest : ∀ i ty, Trusted.MirSemantics.getElem? rest i = some ty →
        Trusted.MirSemantics.getElem? body.locals ((start + 1) + i) = some (.base ty) := by
      intro i ty hi
      rw [Nat.add_assoc start 1 i, Nat.add_comm 1 i]
      exact hDecls (i + 1) ty hi
    have hBoundRest : (start + 1) + rest.length ≤ slots₁.length := by
      rw [hLen1, Nat.add_assoc, Nat.add_comm 1 rest.length]
      exact hBound
    let ⟨slots₂, hRRest, hLen2, hOutRest, hInRest⟩ :=
      @exec_mkStorageLiveRange p body bb defId blockIdx cm rest (start + 1)
        (pre ++ [EnumStmt.baseStmt (.storageLive start)]) post slots₁
        hStRest hB hBB hDeclsRest hBoundRest
    rw [hPre1Len, Nat.add_assoc pre.length 1 rest.length, Nat.add_comm 1 rest.length] at hRRest
    refine ⟨slots₂, ReachesNEnum.succ hStep1 hRRest, hLen2.trans hLen1, ?_, ?_⟩
    · intro j hj
      have hjRest : j < start + 1 ∨ (start + 1) + rest.length ≤ j := by
        cases hj with
        | inl hLt => exact Or.inl (Nat.lt_trans hLt (Nat.lt_succ_self start))
        | inr hGe =>
          rw [Nat.add_assoc, Nat.add_comm 1 rest.length]
          exact Or.inr hGe
      have hjNeStart : j ≠ start := by
        intro heq; subst heq
        cases hj with
        | inl hLt => exact Nat.lt_irrefl _ hLt
        | inr hGe =>
          exact Nat.not_lt_of_ge hGe (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _))
      rw [hOutRest j hjRest, setElem?_getElem?_ne hSet1 hjNeStart]
    · intro i ty hi
      cases i with
      | zero =>
        injection hi with heq; subst heq
        rw [Nat.add_zero]
        rw [hOutRest start (Or.inl (Nat.lt_succ_self start)),
            setElem?_getElem?_same hSet1]
      | succ i' =>
        have hi' : Trusted.MirSemantics.getElem? rest i' = some ty := hi
        have hIdxEq : start + (i' + 1) = (start + 1) + i' := by
          rw [Nat.add_assoc, Nat.add_comm 1 i']
        rw [hIdxEq]
        exact hInRest i' ty hi'

private theorem exec_mkStorageDeadRange
    {p : EnumProgram} {body : EnumBody} {bb : EnumBlock}
    {defId : DefId} {blockIdx : BasicBlockId} {cm : CallerMemory} :
    ∀ (k : Nat) (start : LocalId)
      (pre post : List EnumStmt) (slots : List EnumSlot),
      0 < start →
      bb.statements = pre ++ mkStorageDeadRange start k ++ post →
      Trusted.MirSemantics.getElem? p.bodies defId = some body →
      Trusted.MirSemantics.getElem? body.basicBlocks blockIdx = some bb →
      (∀ i, i < k → ∃ ty, Trusted.MirSemantics.getElem? body.locals (start + i) = some (.base ty)) →
      start + k ≤ slots.length →
      ∃ slots' : List EnumSlot,
        ReachesNEnum p k
          { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots }],
            callerMem := cm }
          { frames := [{ defId, blockIdx, stmtIdx := pre.length + k, locals := slots' }],
            callerMem := cm } ∧
        slots'.length = slots.length ∧
        (∀ j, (j < start ∨ start + k ≤ j) →
          Trusted.MirSemantics.getElem? slots' j = Trusted.MirSemantics.getElem? slots j) ∧
        (∀ i, i < k →
          Trusted.MirSemantics.getElem? slots' (start + i) = some (.baseSlot .dead))
  | 0, _, pre, _, slots, _, _, _, _, _, _ => by
    refine ⟨slots, ?_, rfl, fun _ _ => rfl, fun _ h => False.elim (Nat.not_lt_zero _ h)⟩
    rw [Nat.add_zero]
    exact ReachesNEnum.zero _
  | k' + 1, start, pre, post, slots, hPos, hStmts, hB, hBB, hDecls, hBound => by
    dsimp [mkStorageDeadRange] at hStmts
    have hSt1 : bb.statements = pre ++ (EnumStmt.baseStmt (.storageDead start)) ::
        (mkStorageDeadRange (start + 1) k' ++ post) := by
      rw [hStmts, List.append_assoc]
      rfl
    let ⟨ty₀, hDecl0⟩ := hDecls 0 (Nat.zero_lt_succ k')
    rw [Nat.add_zero] at hDecl0
    have hStartNe0 : Nat.beq start 0 = false :=
      nat_beq_false_of_ne (fun h => by subst h; exact Nat.lt_irrefl 0 hPos)
    have hStartLt : start < slots.length :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)) hBound
    let ⟨slots₁, hSet1⟩ := setElem?_some_of_lt slots start (.baseSlot .dead) hStartLt
    have hStep1 : evalStepEnum p 0
        { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots }],
          callerMem := cm } =
        .step { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₁ }],
                callerMem := cm } := by
      rw [stepAtStmt hB hBB hSt1 rfl]
      unfold evalEnumStmt
      dsimp
      rw [hStartNe0]
      dsimp
      rw [hDecl0]
      dsimp
      rw [hSet1]
    have hLen1 : slots₁.length = slots.length := setElem?_length hSet1
    have hStRest : bb.statements = (pre ++ [EnumStmt.baseStmt (.storageDead start)]) ++
        mkStorageDeadRange (start + 1) k' ++ post := by
      rw [hSt1]
      change pre ++ ([EnumStmt.baseStmt (.storageDead start)] ++
        (mkStorageDeadRange (start + 1) k' ++ post)) = _
      rw [← List.append_assoc, ← List.append_assoc]
    have hPre1Len : (pre ++ [EnumStmt.baseStmt (.storageDead start)]).length = pre.length + 1 :=
      list_append_length pre [EnumStmt.baseStmt (.storageDead start)]
    have hDeclsRest : ∀ i, i < k' →
        ∃ ty, Trusted.MirSemantics.getElem? body.locals ((start + 1) + i) = some (.base ty) := by
      intro i hi
      rw [Nat.add_assoc start 1 i, Nat.add_comm 1 i]
      exact hDecls (i + 1) (Nat.succ_lt_succ hi)
    have hBoundRest : (start + 1) + k' ≤ slots₁.length := by
      rw [hLen1, Nat.add_assoc, Nat.add_comm 1 k']
      exact hBound
    let ⟨slots₂, hRRest, hLen2, hOutRest, hInRest⟩ :=
      @exec_mkStorageDeadRange p body bb defId blockIdx cm k' (start + 1)
        (pre ++ [EnumStmt.baseStmt (.storageDead start)]) post slots₁
        (Nat.zero_lt_succ start) hStRest hB hBB hDeclsRest hBoundRest
    rw [hPre1Len, Nat.add_assoc pre.length 1 k', Nat.add_comm 1 k'] at hRRest
    refine ⟨slots₂, ReachesNEnum.succ hStep1 hRRest, hLen2.trans hLen1, ?_, ?_⟩
    · intro j hj
      have hjRest : j < start + 1 ∨ (start + 1) + k' ≤ j := by
        cases hj with
        | inl hLt => exact Or.inl (Nat.lt_trans hLt (Nat.lt_succ_self start))
        | inr hGe =>
          rw [Nat.add_assoc, Nat.add_comm 1 k']
          exact Or.inr hGe
      have hjNeStart : j ≠ start := by
        intro heq; subst heq
        cases hj with
        | inl hLt => exact Nat.lt_irrefl _ hLt
        | inr hGe =>
          exact Nat.not_lt_of_ge hGe (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _))
      rw [hOutRest j hjRest, setElem?_getElem?_ne hSet1 hjNeStart]
    · intro i hi
      cases i with
      | zero =>
        rw [Nat.add_zero,
            hOutRest start (Or.inl (Nat.lt_succ_self start)),
            setElem?_getElem?_same hSet1]
      | succ i' =>
        have hIdxEq : start + (i' + 1) = (start + 1) + i' := by
          rw [Nat.add_assoc, Nat.add_comm 1 i']
        rw [hIdxEq]
        exact hInRest i' (Nat.lt_of_succ_lt_succ hi)

/-! ### 3. Prefix Agreement (`j < base`, `j ≠ enumLocal`) for Base Operands, Rvalues, & Writes -/

private noncomputable def PrefixSlotsAgree (base enumLocal : Nat)
    (slots₁ slots₂ : List EnumSlot) : Prop :=
  slots₁.length = base ∧
  base ≤ slots₂.length ∧
  ∀ j, j < base → j ≠ enumLocal →
    Trusted.MirSemantics.getElem? slots₂ j = Trusted.MirSemantics.getElem? slots₁ j

private theorem evalEnumBaseOperandToSlot_agree
    {decls₁ decls₂ : List EnumLocalDecl} {base enumLocal : Nat}
    {slots₁ slots₂ : List EnumSlot} {op : Operand}
    (hDeclAgree : ∀ j, j < base → j ≠ enumLocal →
      Trusted.MirSemantics.getElem? decls₂ j = Trusted.MirSemantics.getElem? decls₁ j)
    (hSlotAgree : PrefixSlotsAgree base enumLocal slots₁ slots₂)
    (hBnd : operandLocalsInBounds base op = true)
    (hNoMent : stmtMentionsLocalOperand enumLocal op = false) :
    (∀ k, evalEnumBaseOperandToSlot decls₁ slots₁ op = .error k →
      evalEnumBaseOperandToSlot decls₂ slots₂ op = .error k) ∧
    (∀ ty optVal slots₁',
      evalEnumBaseOperandToSlot decls₁ slots₁ op = .ok (ty, optVal, slots₁') →
      ∃ slots₂',
        evalEnumBaseOperandToSlot decls₂ slots₂ op = .ok (ty, optVal, slots₂') ∧
        slots₂'.length = slots₂.length ∧
        PrefixSlotsAgree base enumLocal slots₁' slots₂' ∧
        (∀ j, (j = enumLocal ∨ base ≤ j) →
          Trusted.MirSemantics.getElem? slots₂' j =
            Trusted.MirSemantics.getElem? slots₂ j)) := by
  let ⟨hLen1, hLe2, hAg⟩ := hSlotAgree
  cases op with
  | constant c =>
    unfold evalEnumBaseOperandToSlot
    dsimp
    cases evalConstLit c.ty c.lit with
    | error _ =>
      dsimp
      exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
    | ok v =>
      dsimp
      refine ⟨(fun _ h => by cases h), ?_⟩
      intro ty optVal slots₁' hOk
      injection hOk with hEq
      injection hEq with h1 h2
      injection h2 with hO hS
      subst h1; subst hO; subst hS
      exact ⟨slots₂, rfl, rfl, hSlotAgree, fun _ _ => rfl⟩
  | copy p =>
    unfold operandLocalsInBounds at hBnd
    unfold stmtMentionsLocalOperand at hNoMent
    have hpLt : p.localId < base := nat_blt_lt hBnd
    have hpNe : p.localId ≠ enumLocal := nat_ne_of_beq_false hNoMent
    unfold evalEnumBaseOperandToSlot
    dsimp
    cases p.projection.isEmpty with
    | false =>
      dsimp
      exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
    | true =>
      dsimp
      rw [hDeclAgree p.localId hpLt hpNe, hAg p.localId hpLt hpNe]
      cases Trusted.MirSemantics.getElem? decls₁ p.localId with
      | none => exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
      | some d =>
        cases d with
        | adtEnum _ => exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
        | base ty =>
          cases Trusted.MirSemantics.getElem? slots₁ p.localId with
          | none => exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
          | some sl =>
            cases sl with
            | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
              exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
            | baseSlot bsl =>
              cases bsl with
              | dead => exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
              | live ov =>
                dsimp
                refine ⟨(fun _ h => by cases h), ?_⟩
                intro ty' optVal' slots₁' hOk
                injection hOk with hEq
                injection hEq with h1 h2
                injection h2 with hO hS
                subst h1; subst hO; subst hS
                exact ⟨slots₂, rfl, rfl, hSlotAgree, fun _ _ => rfl⟩
  | move p =>
    unfold operandLocalsInBounds at hBnd
    unfold stmtMentionsLocalOperand at hNoMent
    have hpLt : p.localId < base := nat_blt_lt hBnd
    have hpNe : p.localId ≠ enumLocal := nat_ne_of_beq_false hNoMent
    unfold evalEnumBaseOperandToSlot
    dsimp
    cases p.projection.isEmpty with
    | false =>
      dsimp
      exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
    | true =>
      dsimp
      rw [hDeclAgree p.localId hpLt hpNe, hAg p.localId hpLt hpNe]
      cases Trusted.MirSemantics.getElem? decls₁ p.localId with
      | none => exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
      | some d =>
        cases d with
        | adtEnum _ => exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
        | base ty =>
          cases hS1 : Trusted.MirSemantics.getElem? slots₁ p.localId with
          | none => exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
          | some sl =>
            cases sl with
            | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
              exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
            | baseSlot bsl =>
              cases bsl with
              | dead => exact ⟨fun _ h => h, fun _ _ _ h => by cases h⟩
              | live ov =>
                dsimp
                let ⟨slots₁', hSet1⟩ := setElem?_some_of_lt slots₁ p.localId
                  (.baseSlot (liveUninitSlot ty)) (by rw [hLen1]; exact hpLt)
                let ⟨slots₂', hSet2⟩ := setElem?_some_of_lt slots₂ p.localId
                  (.baseSlot (liveUninitSlot ty)) (Nat.lt_of_lt_of_le hpLt hLe2)
                rw [hSet1, hSet2]
                dsimp
                refine ⟨(fun _ h => by cases h), ?_⟩
                intro ty' optVal' s1Out hOk
                injection hOk with hEq
                injection hEq with h1 h2
                injection h2 with hO hS
                subst h1; subst hO; subst hS
                refine ⟨slots₂', rfl, setElem?_length hSet2, ?_, ?_⟩
                · refine ⟨(setElem?_length hSet1).trans hLen1,
                          by rw [setElem?_length hSet2]; exact hLe2, ?_⟩
                  intro j hjLt hjNeE
                  cases hEqJ : Nat.beq j p.localId with
                  | true =>
                    have hjEq : j = p.localId := nat_beq_eq hEqJ
                    subst hjEq
                    rw [setElem?_getElem?_same hSet2, setElem?_getElem?_same hSet1]
                  | false =>
                    have hjNeP : j ≠ p.localId := nat_ne_of_beq_false hEqJ
                    rw [setElem?_getElem?_ne hSet2 hjNeP,
                        setElem?_getElem?_ne hSet1 hjNeP]
                    exact hAg j hjLt hjNeE
                · intro j hjOr
                  have hjNeP : j ≠ p.localId := by
                    intro heq; subst heq
                    cases hjOr with
                    | inl hE => exact hpNe hE
                    | inr hGe => exact Nat.not_lt_of_ge hGe hpLt
                  exact setElem?_getElem?_ne hSet2 hjNeP

private theorem evalEnumPrimitiveOperand_agree
    {decls₁ decls₂ : List EnumLocalDecl} {base enumLocal : Nat}
    {slots₁ slots₂ : List EnumSlot} {op : Operand}
    (hDeclAgree : ∀ j, j < base → j ≠ enumLocal →
      Trusted.MirSemantics.getElem? decls₂ j = Trusted.MirSemantics.getElem? decls₁ j)
    (hSlotAgree : PrefixSlotsAgree base enumLocal slots₁ slots₂)
    (hBnd : operandLocalsInBounds base op = true)
    (hNoMent : stmtMentionsLocalOperand enumLocal op = false) :
    (∀ k, evalEnumPrimitiveOperand decls₁ slots₁ op = .error k →
      evalEnumPrimitiveOperand decls₂ slots₂ op = .error k) ∧
    (∀ v slots₁',
      evalEnumPrimitiveOperand decls₁ slots₁ op = .ok (v, slots₁') →
      ∃ slots₂',
        evalEnumPrimitiveOperand decls₂ slots₂ op = .ok (v, slots₂') ∧
        slots₂'.length = slots₂.length ∧
        PrefixSlotsAgree base enumLocal slots₁' slots₂' ∧
        (∀ j, (j = enumLocal ∨ base ≤ j) →
          Trusted.MirSemantics.getElem? slots₂' j =
            Trusted.MirSemantics.getElem? slots₂ j)) := by
  let ⟨hErr, hOk⟩ := evalEnumBaseOperandToSlot_agree hDeclAgree hSlotAgree hBnd hNoMent
  unfold evalEnumPrimitiveOperand
  cases hEv1 : evalEnumBaseOperandToSlot decls₁ slots₁ op with
  | error k =>
    rw [hErr k hEv1]
    dsimp
    exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
  | ok trip =>
    cases trip with
    | mk ty rest =>
      cases rest with
      | mk optVal s1' =>
        let ⟨s2', hEv2, hLen2, hAg2, hOut2⟩ := hOk ty optVal s1' hEv1
        rw [hEv2]
        dsimp
        cases (!isPrimitiveReadableTy ty) with
        | true => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
        | false =>
          dsimp
          cases optVal with
          | none => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
          | some val =>
            dsimp
            refine ⟨(fun _ h => by cases h), ?_⟩
            intro v' s1Out hOkP
            injection hOkP with hEq
            injection hEq with hV hS
            subst hV; subst hS
            exact ⟨s2', rfl, hLen2, hAg2, hOut2⟩

private theorem evalEnumBaseRvalue_agree
    {decls₁ decls₂ : List EnumLocalDecl} {base enumLocal : Nat}
    {slots₁ slots₂ : List EnumSlot} {dstTy : MirTy} {rval : Rvalue}
    (hDeclAgree : ∀ j, j < base → j ≠ enumLocal →
      Trusted.MirSemantics.getElem? decls₂ j = Trusted.MirSemantics.getElem? decls₁ j)
    (hSlotAgree : PrefixSlotsAgree base enumLocal slots₁ slots₂)
    (hBnd : rvalueLocalsInBounds base rval = true)
    (hNoMent : rvalueMentionsLocal enumLocal rval = false) :
    (∀ k, evalEnumBaseRvalue decls₁ slots₁ dstTy rval = .error k →
      evalEnumBaseRvalue decls₂ slots₂ dstTy rval = .error k) ∧
    (∀ v slots₁',
      evalEnumBaseRvalue decls₁ slots₁ dstTy rval = .ok (v, slots₁') →
      ∃ slots₂',
        evalEnumBaseRvalue decls₂ slots₂ dstTy rval = .ok (v, slots₂') ∧
        slots₂'.length = slots₂.length ∧
        PrefixSlotsAgree base enumLocal slots₁' slots₂' ∧
        (∀ j, (j = enumLocal ∨ base ≤ j) →
          Trusted.MirSemantics.getElem? slots₂' j =
            Trusted.MirSemantics.getElem? slots₂ j)) := by
  cases rval with
  | use op =>
    unfold rvalueLocalsInBounds at hBnd
    unfold rvalueMentionsLocal at hNoMent
    let ⟨hErr, hOk⟩ := evalEnumBaseOperandToSlot_agree hDeclAgree hSlotAgree hBnd hNoMent
    unfold evalEnumBaseRvalue
    dsimp
    cases hEv1 : evalEnumBaseOperandToSlot decls₁ slots₁ op with
    | error k =>
      rw [hErr k hEv1]
      dsimp
      exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
    | ok trip =>
      cases trip with
      | mk srcTy rest =>
        cases rest with
        | mk optVal s1' =>
          let ⟨s2', hEv2, hLen2, hAg2, hOut2⟩ := hOk srcTy optVal s1' hEv1
          rw [hEv2]
          dsimp
          cases (!MirTy.beq srcTy dstTy) with
          | true => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
          | false =>
            dsimp
            cases optVal with
            | none => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
            | some val =>
              dsimp
              refine ⟨(fun _ h => by cases h), ?_⟩
              intro v' s1Out hOkR
              injection hOkR with hEq
              injection hEq with hV hS
              subst hV; subst hS
              exact ⟨s2', rfl, hLen2, hAg2, hOut2⟩
  | unaryOp uop op =>
    unfold rvalueLocalsInBounds at hBnd
    unfold rvalueMentionsLocal at hNoMent
    let ⟨hErr, hOk⟩ := evalEnumPrimitiveOperand_agree hDeclAgree hSlotAgree hBnd hNoMent
    unfold evalEnumBaseRvalue
    dsimp
    cases hEv1 : evalEnumPrimitiveOperand decls₁ slots₁ op with
    | error k =>
      rw [hErr k hEv1]
      dsimp
      exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
    | ok pair =>
      cases pair with
      | mk val s1' =>
        let ⟨s2', hEv2, hLen2, hAg2, hOut2⟩ := hOk val s1' hEv1
        rw [hEv2]
        dsimp
        cases evalUnOp uop val with
        | error _ => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
        | ok res =>
          dsimp
          refine ⟨(fun _ h => by cases h), ?_⟩
          intro v' s1Out hOkR
          injection hOkR with hEq
          injection hEq with hV hS
          subst hV; subst hS
          exact ⟨s2', rfl, hLen2, hAg2, hOut2⟩
  | binaryOp bop lhs rhs =>
    unfold rvalueLocalsInBounds at hBnd
    unfold rvalueMentionsLocal at hNoMent
    let ⟨hBndL, hBndR⟩ := bool_and_true hBnd
    let ⟨hNoL, hNoR⟩ := bool_or_false hNoMent
    let ⟨hErrL, hOkL⟩ := evalEnumPrimitiveOperand_agree hDeclAgree hSlotAgree hBndL hNoL
    unfold evalEnumBaseRvalue
    dsimp
    cases hEvL1 : evalEnumPrimitiveOperand decls₁ slots₁ lhs with
    | error k =>
      rw [hErrL k hEvL1]
      dsimp
      exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
    | ok pairL =>
      cases pairL with
      | mk lVal s1Mid =>
        let ⟨s2Mid, hEvL2, hLenMid, hAgMid, hOutMid⟩ := hOkL lVal s1Mid hEvL1
        rw [hEvL2]
        dsimp
        let ⟨hErrR, hOkR⟩ := evalEnumPrimitiveOperand_agree hDeclAgree hAgMid hBndR hNoR
        cases hEvR1 : evalEnumPrimitiveOperand decls₁ s1Mid rhs with
        | error k =>
          rw [hErrR k hEvR1]
          dsimp
          exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
        | ok pairR =>
          cases pairR with
          | mk rVal s1End =>
            let ⟨s2End, hEvR2, hLenEnd, hAgEnd, hOutEnd⟩ := hOkR rVal s1End hEvR1
            rw [hEvR2]
            dsimp
            cases evalBinOp bop lVal rVal with
            | error _ => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
            | ok res =>
              dsimp
              refine ⟨(fun _ h => by cases h), ?_⟩
              intro v' s1Out hOkB
              injection hOkB with hEq
              injection hEq with hV hS
              subst hV; subst hS
              exact ⟨s2End, rfl, hLenEnd.trans hLenMid, hAgEnd,
                     fun j hj => (hOutEnd j hj).trans (hOutMid j hj)⟩
  | discriminant p =>
    unfold rvalueLocalsInBounds at hBnd
    unfold rvalueMentionsLocal at hNoMent
    have hpLt : p.localId < base := nat_blt_lt hBnd
    have hpNe : p.localId ≠ enumLocal := nat_ne_of_beq_false hNoMent
    unfold evalEnumBaseRvalue
    dsimp
    cases p.projection.isEmpty with
    | false => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
    | true =>
      dsimp
      rw [hDeclAgree p.localId hpLt hpNe, hSlotAgree.2.2 p.localId hpLt hpNe]
      cases Trusted.MirSemantics.getElem? decls₁ p.localId with
      | none => exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
      | some d =>
        cases d with
        | adtEnum _ => exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
        | base mty =>
          cases mty with
          | bool | int _ _ | unit | tuple _ | ref _ _ | rawPtr _ _ | never | unsupported =>
            exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
          | enum ety =>
            cases Trusted.MirSemantics.getElem? slots₁ p.localId with
            | none => exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
            | some sl =>
              cases sl with
              | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
                exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
              | baseSlot bsl =>
                dsimp
                cases (!enumAdmitted ety) with
                | true => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                | false =>
                  dsimp
                  cases ety.tagRepr with
                  | zeroSized =>
                    cases bsl with
                    | dead => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                    | live ov =>
                      cases ov with
                      | none =>
                        dsimp
                        cases Trusted.MirSemantics.getElem? ety.discriminants 0 with
                        | none => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                        | some _ =>
                          dsimp
                          refine ⟨(fun _ h => by cases h), ?_⟩
                          intro v' s1Out hOkD
                          injection hOkD with hEq; injection hEq with hV hS
                          subst hV; subst hS
                          exact ⟨slots₂, rfl, rfl, hSlotAgree, fun _ _ => rfl⟩
                      | some dv =>
                        cases dv with
                        | scalar _ | ptr _ | bool _ | unit | tuple _ | bytes _ =>
                          dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                        | enumVal ety' v =>
                          dsimp
                          cases (EnumTy.beq ety ety' && Nat.beq v 0) with
                          | false => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                          | true =>
                            dsimp
                            cases Trusted.MirSemantics.getElem? ety.discriminants 0 with
                            | none => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                            | some _ =>
                              dsimp
                              refine ⟨(fun _ h => by cases h), ?_⟩
                              intro v' s1Out hOkD
                              injection hOkD with hEq; injection hEq with hV hS
                              subst hV; subst hS
                              exact ⟨slots₂, rfl, rfl, hSlotAgree, fun _ _ => rfl⟩
                  | scalar tw ts =>
                    cases bsl with
                    | dead => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                    | live ov =>
                      cases ov with
                      | none => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                      | some dv =>
                        cases dv with
                        | scalar _ | ptr _ | bool _ | unit | tuple _ | bytes _ =>
                          dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                        | enumVal ety' v =>
                          dsimp
                          cases (EnumTy.beq ety ety' && Nat.blt v ety.discriminants.length) with
                          | false => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                          | true =>
                            dsimp
                            cases Trusted.MirSemantics.getElem? ety.discriminants v with
                            | none => dsimp; exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
                            | some _ =>
                              dsimp
                              refine ⟨(fun _ h => by cases h), ?_⟩
                              intro v' s1Out hOkD
                              injection hOkD with hEq; injection hEq with hV hS
                              subst hV; subst hS
                              exact ⟨slots₂, rfl, rfl, hSlotAgree, fun _ _ => rfl⟩
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported =>
    unfold evalEnumBaseRvalue
    dsimp
    exact ⟨fun _ h => h, fun _ _ h => by cases h⟩

private theorem writeEnumBasePlace_agree
    {base enumLocal : Nat} {slots₁ slots₂ : List EnumSlot}
    {dst : LocalId} {dstTy : MirTy} {val : Val}
    (hSlotAgree : PrefixSlotsAgree base enumLocal slots₁ slots₂)
    (hDstLt : dst < base) (hDstNe : dst ≠ enumLocal) :
    (∀ k, writeEnumBasePlace slots₁ dst dstTy val = .error k →
      writeEnumBasePlace slots₂ dst dstTy val = .error k) ∧
    (∀ slots₁', writeEnumBasePlace slots₁ dst dstTy val = .ok slots₁' →
      ∃ slots₂',
        writeEnumBasePlace slots₂ dst dstTy val = .ok slots₂' ∧
        slots₂'.length = slots₂.length ∧
        PrefixSlotsAgree base enumLocal slots₁' slots₂' ∧
        (∀ j, (j = enumLocal ∨ base ≤ j) →
          Trusted.MirSemantics.getElem? slots₂' j =
            Trusted.MirSemantics.getElem? slots₂ j)) := by
  let ⟨hLen1, hLe2, hAg⟩ := hSlotAgree
  unfold writeEnumBasePlace
  cases (!checkVal val dstTy) with
  | true => dsimp; exact ⟨fun _ h => h, fun _ h => by cases h⟩
  | false =>
    dsimp
    rw [hAg dst hDstLt hDstNe]
    cases Trusted.MirSemantics.getElem? slots₁ dst with
    | none => exact ⟨fun _ h => h, fun _ h => by cases h⟩
    | some sl =>
      cases sl with
      | enumDead | liveEmpty | liveSingle _ | liveDirect _ _ | liveNiche _ _ =>
        exact ⟨fun _ h => h, fun _ h => by cases h⟩
      | baseSlot bsl =>
        cases bsl with
        | dead => exact ⟨fun _ h => h, fun _ h => by cases h⟩
        | live _ =>
          dsimp
          let ⟨s1', hSet1⟩ := setElem?_some_of_lt slots₁ dst
            (.baseSlot (.live (some val))) (by rw [hLen1]; exact hDstLt)
          let ⟨s2', hSet2⟩ := setElem?_some_of_lt slots₂ dst
            (.baseSlot (.live (some val))) (Nat.lt_of_lt_of_le hDstLt hLe2)
          rw [hSet1, hSet2]
          dsimp
          refine ⟨(fun _ h => by cases h), ?_⟩
          intro s1Out hOk
          injection hOk with hEq
          subst hEq
          refine ⟨s2', rfl, setElem?_length hSet2, ?_, ?_⟩
          · refine ⟨(setElem?_length hSet1).trans hLen1,
                    by rw [setElem?_length hSet2]; exact hLe2, ?_⟩
            intro j hjLt hjNeE
            cases hEqJ : Nat.beq j dst with
            | true =>
              have hjEq : j = dst := nat_beq_eq hEqJ
              subst hjEq
              rw [setElem?_getElem?_same hSet2, setElem?_getElem?_same hSet1]
            | false =>
              have hjNeD : j ≠ dst := nat_ne_of_beq_false hEqJ
              rw [setElem?_getElem?_ne hSet2 hjNeD,
                  setElem?_getElem?_ne hSet1 hjNeD]
              exact hAg j hjLt hjNeE
          · intro j hjOr
            have hjNeD : j ≠ dst := by
              intro heq; subst heq
              cases hjOr with
              | inl hE => exact hDstNe hE
              | inr hGe => exact Nat.not_lt_of_ge hGe hDstLt
            exact setElem?_getElem?_ne hSet2 hjNeD

/-! ### 4. Multi-Step `mkEvalOpsToScratch` <-> `evalAggregateEnumOperands` -/

private theorem exec_mkEvalOpsToScratch
    {p₂ : EnumProgram} {body₁ body₂ : EnumBody} {bb₂ : EnumBlock}
    {defId : DefId} {blockIdx : BasicBlockId} {cm : CallerMemory}
    {base enumLocal : Nat}
    (hEnumLt : enumLocal < base)
    (hDeclAgree : ∀ j, j < base → j ≠ enumLocal →
      Trusted.MirSemantics.getElem? body₂.locals j =
        Trusted.MirSemantics.getElem? body₁.locals j)
    (hB : Trusted.MirSemantics.getElem? p₂.bodies defId = some body₂)
    (hBB : Trusted.MirSemantics.getElem? body₂.basicBlocks blockIdx = some bb₂) :
    ∀ (ops : List Operand) (tys : List MirTy) (sBase : LocalId)
      (pre post : List EnumStmt) (slots₁ slots₂ : List EnumSlot),
      ops.length = tys.length →
      base ≤ sBase →
      sBase + ops.length ≤ slots₂.length →
      bb₂.statements = pre ++ mkEvalOpsToScratch sBase ops ++ post →
      PrefixSlotsAgree base enumLocal slots₁ slots₂ →
      ops.all (operandLocalsInBounds base) = true →
      ops.any (stmtMentionsLocalOperand enumLocal) = false →
      (∀ i ty, Trusted.MirSemantics.getElem? tys i = some ty →
        Trusted.MirSemantics.getElem? body₂.locals (sBase + i) = some (.base ty)) →
      (∀ k, evalAggregateEnumOperands body₁.locals slots₁ ops tys = .error k →
        ∃ sF : EnumState,
          ReachesEnum p₂
            { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots₂ }],
              callerMem := cm }
            sF ∧
          evalStepEnum p₂ 0 sF = .fault k) ∧
      (∀ vals slots₁',
        evalAggregateEnumOperands body₁.locals slots₁ ops tys = .ok (vals, slots₁') →
        ∃ slots₂',
          ReachesNEnum p₂ (2 * ops.length)
            { frames := [{ defId, blockIdx,
                           stmtIdx := pre.length, locals := slots₂ }],
              callerMem := cm }
            { frames := [{ defId, blockIdx,
                           stmtIdx := pre.length + 2 * ops.length, locals := slots₂' }],
              callerMem := cm } ∧
          slots₂'.length = slots₂.length ∧
          PrefixSlotsAgree base enumLocal slots₁' slots₂' ∧
          vals.length = tys.length ∧
          (∀ j, (j = enumLocal ∨ (base ≤ j ∧ j < sBase) ∨ sBase + ops.length ≤ j) →
            Trusted.MirSemantics.getElem? slots₂' j =
              Trusted.MirSemantics.getElem? slots₂ j) ∧
          (∀ i ty val,
            Trusted.MirSemantics.getElem? tys i = some ty →
            Trusted.MirSemantics.getElem? vals i = some val →
            checkVal val ty = true ∧
            Trusted.MirSemantics.getElem? slots₂' (sBase + i) =
              some (.baseSlot (.live (some val)))))
  | [], [], _, pre, _, slots₁, slots₂, _, _, _, _, hAg, _, _, _ => by
    unfold evalAggregateEnumOperands
    dsimp
    refine ⟨(fun _ h => by cases h), ?_⟩
    intro vals s1' hOk
    injection hOk with hEq
    injection hEq with hV hS
    subst hV; subst hS
    exact ⟨slots₂, ReachesNEnum.zero _, rfl, hAg, rfl,
           fun _ _ => rfl, fun _ _ _ h => by cases h⟩
  | [], _ :: _, _, _, _, _, _, hLenEq, _, _, _, _, _, _, _ => by cases hLenEq
  | _ :: _, [], _, _, _, _, _, hLenEq, _, _, _, _, _, _, _ => by cases hLenEq
  | op :: restOps, ty₀ :: restTys, sBase, pre, post, slots₁, slots₂,
    hLenEq, hGeBase, hBound, hStmts, hAg, hAllBnd, hNoAny, hScrDecls => by
    have hRestLen : restOps.length = restTys.length := Nat.succ.inj hLenEq
    dsimp [List.all] at hAllBnd
    let ⟨hOpBnd, hRestBnd⟩ := bool_and_true hAllBnd
    dsimp [List.any] at hNoAny
    let ⟨hOpNoM, hRestNoM⟩ := bool_or_false hNoAny
    have hDeclScr0 : Trusted.MirSemantics.getElem? body₂.locals sBase = some (.base ty₀) := by
      have h0 := hScrDecls 0 ty₀ rfl
      rw [Nat.add_zero] at h0
      exact h0
    have hScrLt : sBase < slots₂.length :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)) hBound
    let stLive : EnumStmt := .baseStmt (.storageLive sBase)
    let stAssign : EnumStmt :=
      .baseStmt (.assign { localId := sBase, projection := [] } (.use op))
    dsimp [mkEvalOpsToScratch] at hStmts
    have hSt1 : bb₂.statements = pre ++ stLive ::
        (stAssign :: (mkEvalOpsToScratch (sBase + 1) restOps ++ post)) := by
      rw [hStmts, List.append_assoc]
      rfl
    let ⟨slots₂Live, hSetLive⟩ := setElem?_some_of_lt slots₂ sBase
      (.baseSlot (liveUninitSlot ty₀)) hScrLt
    have hStepLive : evalStepEnum p₂ 0
        { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots₂ }],
          callerMem := cm } =
        .step { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live }],
                callerMem := cm } := by
      rw [stepAtStmt hB hBB hSt1 rfl]
      dsimp [stLive]
      unfold evalEnumStmt liveUninitEnumSlot
      dsimp
      rw [hDeclScr0]
      dsimp
      rw [hSetLive]
    have hLenLive : slots₂Live.length = slots₂.length := setElem?_length hSetLive
    have hAgLive : PrefixSlotsAgree base enumLocal slots₁ slots₂Live := by
      refine ⟨hAg.1, by rw [hLenLive]; exact hAg.2.1, ?_⟩
      intro j hjLt hjNe
      have hjNeScr : j ≠ sBase := fun heq => by
        subst heq; exact Nat.not_lt_of_ge hGeBase hjLt
      rw [setElem?_getElem?_ne hSetLive hjNeScr]
      exact hAg.2.2 j hjLt hjNe
    have hSt2 : bb₂.statements = (pre ++ [stLive]) ++ stAssign ::
        (mkEvalOpsToScratch (sBase + 1) restOps ++ post) := by
      rw [hSt1]
      change pre ++ ([stLive] ++ (stAssign :: (mkEvalOpsToScratch (sBase + 1) restOps ++ post))) = _
      rw [← List.append_assoc]
    have hPre1Len : (pre ++ [stLive]).length = pre.length + 1 := list_append_length pre [stLive]
    let ⟨hOpErr, hOpOk⟩ :=
      evalEnumBaseOperandToSlot_agree hDeclAgree hAgLive hOpBnd hOpNoM
    unfold evalAggregateEnumOperands
    dsimp
    cases hEvOp1 : evalEnumBaseOperandToSlot body₁.locals slots₁ op with
    | error k =>
      dsimp
      have hEvOp2 := hOpErr k hEvOp1
      have hFault2 : evalStepEnum p₂ 0
          { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live }],
            callerMem := cm } = .fault k := by
        rw [stepAtStmt (f := { defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live })
              hB hBB hSt2 hPre1Len.symm]
        dsimp [stAssign]
        unfold evalEnumStmt evalEnumBaseRvalue
        dsimp
        rw [hDeclScr0, hEvOp2]
      refine ⟨?_, fun _ _ h => by cases h⟩
      intro k' hk'
      injection hk' with hkEq; subst hkEq
      exact ⟨_, c_reachesEnum_head_det hStepLive (ReachesEnum.refl _), hFault2⟩
    | ok trip =>
      cases trip with
      | mk srcTy restTrip =>
        cases restTrip with
        | mk optVal s1AfterOp =>
          let ⟨s2AfterOp, hEvOp2, hLenAfterOp, hAgAfterOp, hOutAfterOp⟩ :=
            hOpOk srcTy optVal s1AfterOp hEvOp1
          dsimp
          cases hTyEqB : (!MirTy.beq srcTy ty₀) with
          | true =>
            dsimp
            have hFault2 : evalStepEnum p₂ 0
                { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live }],
                  callerMem := cm } = .fault .unsupported := by
              rw [stepAtStmt (f := { defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live })
                    hB hBB hSt2 hPre1Len.symm]
              dsimp [stAssign]
              unfold evalEnumStmt evalEnumBaseRvalue
              dsimp
              rw [hDeclScr0, hEvOp2]
              dsimp
              rw [hTyEqB]
              rfl
            refine ⟨?_, fun _ _ h => by cases h⟩
            intro k' hk'
            injection hk' with hkEq; subst hkEq
            exact ⟨_, c_reachesEnum_head_det hStepLive (ReachesEnum.refl _), hFault2⟩
          | false =>
            dsimp
            cases optVal with
            | none =>
              dsimp
              have hFault2 : evalStepEnum p₂ 0
                  { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live }],
                    callerMem := cm } = .fault .undefined := by
                rw [stepAtStmt (f := { defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live })
                      hB hBB hSt2 hPre1Len.symm]
                dsimp [stAssign]
                unfold evalEnumStmt evalEnumBaseRvalue
                dsimp
                rw [hDeclScr0, hEvOp2]
                dsimp
                rw [hTyEqB]
                rfl
              refine ⟨?_, fun _ _ h => by cases h⟩
              intro k' hk'
              injection hk' with hkEq; subst hkEq
              exact ⟨_, c_reachesEnum_head_det hStepLive (ReachesEnum.refl _), hFault2⟩
            | some v₀ =>
              dsimp
              have hScrLiveAfterOp : Trusted.MirSemantics.getElem? s2AfterOp sBase =
                  some (.baseSlot (liveUninitSlot ty₀)) := by
                rw [hOutAfterOp sBase (Or.inr hGeBase), setElem?_getElem?_same hSetLive]
              cases hChkB : (!checkVal v₀ ty₀) with
              | true =>
                dsimp
                have hFault2 : evalStepEnum p₂ 0
                    { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live }],
                      callerMem := cm } = .fault .unsupported := by
                  rw [stepAtStmt (f := { defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live })
                        hB hBB hSt2 hPre1Len.symm]
                  dsimp [stAssign]
                  unfold evalEnumStmt evalEnumBaseRvalue writeEnumBasePlace
                  dsimp
                  rw [hDeclScr0, hEvOp2]
                  dsimp
                  rw [hTyEqB]
                  dsimp
                  rw [hChkB]
                  rfl
                refine ⟨?_, fun _ _ h => by cases h⟩
                intro k' hk'
                injection hk' with hkEq; subst hkEq
                exact ⟨_, c_reachesEnum_head_det hStepLive (ReachesEnum.refl _), hFault2⟩
              | false =>
                dsimp
                have hChkOk : checkVal v₀ ty₀ = true := bool_not_false hChkB
                let ⟨s2AfterWrite, hSetWrite⟩ := setElem?_some_of_lt s2AfterOp sBase
                  (.baseSlot (.live (some v₀))) (getElem?_some_lt hScrLiveAfterOp)
                have hStepAssign : evalStepEnum p₂ 0
                    { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live }],
                      callerMem := cm } =
                    .step { frames := [{ defId, blockIdx, stmtIdx := pre.length + 2,
                                         locals := s2AfterWrite }],
                            callerMem := cm } := by
                  rw [stepAtStmt (f := { defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂Live })
                        hB hBB hSt2 hPre1Len.symm]
                  dsimp [stAssign]
                  unfold evalEnumStmt evalEnumBaseRvalue writeEnumBasePlace
                  dsimp
                  rw [hDeclScr0, hEvOp2]
                  dsimp
                  rw [hTyEqB]
                  dsimp
                  rw [hChkB]
                  dsimp
                  rw [hScrLiveAfterOp, liveUninitSlot_eq_initFieldOptVal ty₀]
                  dsimp
                  rw [hSetWrite]
                have hLenWrite : s2AfterWrite.length = slots₂.length :=
                  (setElem?_length hSetWrite).trans (hLenAfterOp.trans hLenLive)
                have hAgWrite : PrefixSlotsAgree base enumLocal s1AfterOp s2AfterWrite := by
                  refine ⟨hAgAfterOp.1, by rw [hLenWrite]; exact hAg.2.1, ?_⟩
                  intro j hjLt hjNe
                  have hjNeScr : j ≠ sBase := fun heq => by
                    subst heq; exact Nat.not_lt_of_ge hGeBase hjLt
                  rw [setElem?_getElem?_ne hSetWrite hjNeScr]
                  exact hAgAfterOp.2.2 j hjLt hjNe
                have hStRest : bb₂.statements = (pre ++ [stLive, stAssign]) ++
                    mkEvalOpsToScratch (sBase + 1) restOps ++ post := by
                  rw [hSt2]
                  change (pre ++ [stLive]) ++ ([stAssign] ++ (mkEvalOpsToScratch (sBase + 1) restOps ++ post)) = _
                  rw [← List.append_assoc, ← List.append_assoc, List.append_assoc pre [stLive] [stAssign]]
                  rfl
                have hPre2Len : (pre ++ [stLive, stAssign]).length = pre.length + 2 :=
                  list_append_length pre [stLive, stAssign]
                have hBoundRest : (sBase + 1) + restOps.length ≤ s2AfterWrite.length := by
                  rw [hLenWrite, Nat.add_assoc, Nat.add_comm 1 restOps.length]
                  exact hBound
                have hScrDeclsRest : ∀ i ty, Trusted.MirSemantics.getElem? restTys i = some ty →
                    Trusted.MirSemantics.getElem? body₂.locals ((sBase + 1) + i) = some (.base ty) := by
                  intro i ty hi
                  rw [Nat.add_assoc sBase 1 i, Nat.add_comm 1 i]
                  exact hScrDecls (i + 1) ty hi
                let ⟨ihErr, ihOk⟩ := exec_mkEvalOpsToScratch (cm := cm) hEnumLt hDeclAgree hB hBB
                  restOps restTys (sBase + 1) (pre ++ [stLive, stAssign]) post
                  s1AfterOp s2AfterWrite hRestLen
                  (Nat.le_trans hGeBase (Nat.le_succ sBase))
                  hBoundRest hStRest hAgWrite hRestBnd hRestNoM hScrDeclsRest
                rw [hPre2Len] at ihErr ihOk
                refine ⟨?_, ?_⟩
                · intro k hk
                  cases hRec : evalAggregateEnumOperands body₁.locals s1AfterOp restOps restTys with
                  | ok pR =>
                    cases pR with
                    | mk _ _ => rw [hRec] at hk; cases hk
                  | error kR =>
                    rw [hRec] at hk
                    injection hk with hkEq; subst hkEq
                    let ⟨sF, hRF, hEvF⟩ := ihErr kR hRec
                    exact ⟨sF,
                      c_reachesEnum_head_det hStepLive (c_reachesEnum_head_det hStepAssign hRF),
                      hEvF⟩
                · intro vals s1End hOkAll
                  cases hRec : evalAggregateEnumOperands body₁.locals s1AfterOp restOps restTys with
                  | error _ => rw [hRec] at hOkAll; cases hOkAll
                  | ok pairRest =>
                    cases pairRest with
                    | mk vsRest s1Final =>
                      rw [hRec] at hOkAll
                      injection hOkAll with hEqAll
                      injection hEqAll with hVsEq hS1Eq
                      subst hVsEq; subst hS1Eq
                      let ⟨s2Final, hRRest, hLenFinal, hAgFinal, hVsLen, hOutFinal, hInFinal⟩ :=
                        ihOk vsRest s1Final hRec
                      have hTwoMul : 2 * (op :: restOps).length = 2 + 2 * restOps.length := by
                        dsimp [List.length]
                        rw [Nat.mul_succ, Nat.add_comm]
                      have hIdxAdd : pre.length + 2 + 2 * restOps.length =
                          pre.length + 2 * (op :: restOps).length := by
                        rw [Nat.add_assoc, hTwoMul]
                      rw [hIdxAdd] at hRRest
                      have hRTotal : ReachesNEnum p₂ (2 * (op :: restOps).length)
                          { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots₂ }],
                            callerMem := cm }
                          { frames := [{ defId, blockIdx,
                                         stmtIdx := pre.length + 2 * (op :: restOps).length,
                                         locals := s2Final }],
                            callerMem := cm } := by
                        have hComb := ReachesNEnum.succ hStepLive (ReachesNEnum.succ hStepAssign hRRest)
                        have hN : 2 * restOps.length + 1 + 1 = 2 * (op :: restOps).length := by
                          rw [hTwoMul, Nat.add_assoc (2 * restOps.length) 1 1, Nat.add_comm]
                        rw [hN] at hComb
                        exact hComb
                      refine ⟨s2Final, hRTotal, hLenFinal.trans hLenWrite, hAgFinal,
                              congrArg Nat.succ hVsLen, ?_, ?_⟩
                      · intro j hjOr
                        have hjNeScr : j ≠ sBase := by
                          intro heq; subst heq
                          cases hjOr with
                          | inl hE =>
                            rw [hE] at hGeBase
                            exact Nat.not_lt_of_ge hGeBase hEnumLt
                          | inr hMid =>
                            cases hMid with
                            | inl hRange => exact Nat.lt_irrefl _ hRange.2
                            | inr hGe =>
                              exact Nat.not_lt_of_ge hGe (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _))
                        have hjRest : j = enumLocal ∨ (base ≤ j ∧ j < sBase + 1) ∨
                            (sBase + 1) + restOps.length ≤ j := by
                          cases hjOr with
                          | inl hE => exact Or.inl hE
                          | inr hMid =>
                            cases hMid with
                            | inl hRange =>
                              exact Or.inr (Or.inl ⟨hRange.1, Nat.lt_trans hRange.2 (Nat.lt_succ_self sBase)⟩)
                            | inr hGe =>
                              rw [Nat.add_assoc, Nat.add_comm 1 restOps.length]
                              exact Or.inr (Or.inr hGe)
                        have hjBaseOrE : j = enumLocal ∨ base ≤ j := by
                          cases hjOr with
                          | inl hE => exact Or.inl hE
                          | inr hMid =>
                            cases hMid with
                            | inl hRange => exact Or.inr hRange.1
                            | inr hGe =>
                              exact Or.inr (Nat.le_trans hGeBase
                                (Nat.le_trans (Nat.le_add_right sBase _) hGe))
                        rw [hOutFinal j hjRest,
                            setElem?_getElem?_ne hSetWrite hjNeScr,
                            hOutAfterOp j hjBaseOrE,
                            setElem?_getElem?_ne hSetLive hjNeScr]
                      · intro i ty val hTyI hValI
                        cases i with
                        | zero =>
                          injection hTyI with hT0; injection hValI with hV0
                          subst hT0; subst hV0
                          rw [Nat.add_zero]
                          refine ⟨hChkOk, ?_⟩
                          have hPres0 := hOutFinal sBase (Or.inr (Or.inl ⟨hGeBase, Nat.lt_succ_self sBase⟩))
                          rw [hPres0, setElem?_getElem?_same hSetWrite]
                        | succ i' =>
                          have hIdxEq : sBase + (i' + 1) = (sBase + 1) + i' := by
                            rw [Nat.add_assoc, Nat.add_comm 1 i']
                          rw [hIdxEq]
                          exact hInFinal i' ty val hTyI hValI

/-! ### 5. Multi-Step `mkMoveScratchToPayload` & `mkMoveScratchToNicheUntagged` -/

private theorem exec_mkMoveScratchToPayload
    {p₂ : EnumProgram} {body₂ : EnumBody} {bb₂ : EnumBlock}
    {defId : DefId} {blockIdx : BasicBlockId} {cm : CallerMemory}
    (hB : Trusted.MirSemantics.getElem? p₂.bodies defId = some body₂)
    (hBB : Trusted.MirSemantics.getElem? body₂.basicBlocks blockIdx = some bb₂) :
    ∀ (tys : List MirTy) (vals : List Val) (sBase pBase : LocalId)
      (pre post : List EnumStmt) (slots : List EnumSlot),
      vals.length = tys.length →
      pBase + tys.length ≤ sBase →
      sBase + tys.length ≤ slots.length →
      bb₂.statements = pre ++ mkMoveScratchToPayload sBase pBase tys.length ++ post →
      (∀ i ty, Trusted.MirSemantics.getElem? tys i = some ty →
        Trusted.MirSemantics.getElem? body₂.locals (sBase + i) = some (.base ty) ∧
        Trusted.MirSemantics.getElem? body₂.locals (pBase + i) = some (.base ty)) →
      (∀ i ty val,
        Trusted.MirSemantics.getElem? tys i = some ty →
        Trusted.MirSemantics.getElem? vals i = some val →
        checkVal val ty = true ∧
        Trusted.MirSemantics.getElem? slots (sBase + i) =
          some (.baseSlot (.live (some val)))) →
      (∀ i, i < tys.length →
        ∃ ov, Trusted.MirSemantics.getElem? slots (pBase + i) =
          some (.baseSlot (.live ov))) →
      ∃ slots' : List EnumSlot,
        ReachesNEnum p₂ tys.length
          { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots }],
            callerMem := cm }
          { frames := [{ defId, blockIdx,
                         stmtIdx := pre.length + tys.length, locals := slots' }],
            callerMem := cm } ∧
        slots'.length = slots.length ∧
        (∀ j, ((j < pBase ∨ pBase + tys.length ≤ j) ∧
               (j < sBase ∨ sBase + tys.length ≤ j)) →
          Trusted.MirSemantics.getElem? slots' j =
            Trusted.MirSemantics.getElem? slots j) ∧
        (∀ i val, i < tys.length →
          Trusted.MirSemantics.getElem? vals i = some val →
          Trusted.MirSemantics.getElem? slots' (pBase + i) =
            some (.baseSlot (.live (some val)))) ∧
        (∀ i ty, Trusted.MirSemantics.getElem? tys i = some ty →
          ∃ ov, Trusted.MirSemantics.getElem? slots' (sBase + i) =
            some (.baseSlot (.live ov)))
  | [], [], _, _, pre, _, slots, _, _, _, _, _, _, _ => by
    refine ⟨slots, ReachesNEnum.zero _, rfl, fun _ _ => rfl,
            fun _ _ h => False.elim (Nat.not_lt_zero _ h),
            fun _ _ h => by cases h⟩
  | [], _ :: _, _, _, _, _, _, hLen, _, _, _, _, _, _ => by cases hLen
  | _ :: _, [], _, _, _, _, _, hLen, _, _, _, _, _, _ => by cases hLen
  | ty₀ :: restTys, v₀ :: restVals, sBase, pBase, pre, post, slots,
    hLenEq, hDisj, hBound, hStmts, hDecls, hScr, hPayLive => by
    have hRestLen : restVals.length = restTys.length := Nat.succ.inj hLenEq
    have hDecls0 := hDecls 0 ty₀ rfl
    rw [Nat.add_zero, Nat.add_zero] at hDecls0
    let ⟨hDeclS0, hDeclP0⟩ := hDecls0
    have hScr0 := hScr 0 ty₀ v₀ rfl rfl
    rw [Nat.add_zero] at hScr0
    let ⟨hChk0, hSlotS0⟩ := hScr0
    have hPay0 := hPayLive 0 (Nat.zero_lt_succ _)
    rw [Nat.add_zero] at hPay0
    let ⟨ovP0, hSlotP0⟩ := hPay0
    have hPLtS : pBase < sBase :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _)) hDisj
    have hPNeS : pBase ≠ sBase := fun h => by subst h; exact Nat.lt_irrefl _ hPLtS
    let stMove : EnumStmt :=
      .baseStmt (.assign { localId := pBase, projection := [] }
        (.use (.move { localId := sBase, projection := [] })))
    dsimp [List.length, mkMoveScratchToPayload] at hStmts
    have hSt1 : bb₂.statements = pre ++ stMove ::
        (mkMoveScratchToPayload (sBase + 1) (pBase + 1) restTys.length ++ post) := by
      rw [hStmts, List.append_assoc]
      rfl
    let ⟨slots₁, hSetMove⟩ := setElem?_some_of_lt slots sBase
      (.baseSlot (liveUninitSlot ty₀)) (getElem?_some_lt hSlotS0)
    have hSlot1P0 : Trusted.MirSemantics.getElem? slots₁ pBase =
        some (.baseSlot (.live ovP0)) := by
      rw [setElem?_getElem?_ne hSetMove hPNeS]
      exact hSlotP0
    let ⟨slots₂, hSetWrite⟩ := setElem?_some_of_lt slots₁ pBase
      (.baseSlot (.live (some v₀))) (getElem?_some_lt hSlot1P0)
    have hStep1 : evalStepEnum p₂ 0
        { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots }],
          callerMem := cm } =
        .step { frames := [{ defId, blockIdx, stmtIdx := pre.length + 1, locals := slots₂ }],
                callerMem := cm } := by
      rw [stepAtStmt hB hBB hSt1 rfl]
      dsimp [stMove]
      unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot writeEnumBasePlace
      dsimp
      rw [hDeclP0, hDeclS0, hSlotS0]
      dsimp
      rw [hSetMove]
      dsimp
      rw [mirTy_beq_refl ty₀]
      dsimp
      rw [hChk0]
      dsimp
      rw [hSlot1P0]
      dsimp
      rw [hSetWrite]
    have hLen2 : slots₂.length = slots.length :=
      (setElem?_length hSetWrite).trans (setElem?_length hSetMove)
    have hStRest : bb₂.statements = (pre ++ [stMove]) ++
        mkMoveScratchToPayload (sBase + 1) (pBase + 1) restTys.length ++ post := by
      rw [hSt1]
      change pre ++ ([stMove] ++ (mkMoveScratchToPayload (sBase + 1) (pBase + 1) restTys.length ++ post)) = _
      rw [← List.append_assoc, ← List.append_assoc]
    have hPre1Len : (pre ++ [stMove]).length = pre.length + 1 := list_append_length pre [stMove]
    have hDisjRest : (pBase + 1) + restTys.length ≤ sBase + 1 := by
      rw [Nat.add_assoc, Nat.add_comm 1 restTys.length]
      exact Nat.le_trans hDisj (Nat.le_succ sBase)
    have hBoundRest : (sBase + 1) + restTys.length ≤ slots₂.length := by
      rw [hLen2, Nat.add_assoc, Nat.add_comm 1 restTys.length]
      exact hBound
    have hDeclsRest : ∀ i ty, Trusted.MirSemantics.getElem? restTys i = some ty →
        Trusted.MirSemantics.getElem? body₂.locals ((sBase + 1) + i) = some (.base ty) ∧
        Trusted.MirSemantics.getElem? body₂.locals ((pBase + 1) + i) = some (.base ty) := by
      intro i ty hi
      rw [Nat.add_assoc sBase 1 i, Nat.add_assoc pBase 1 i, Nat.add_comm 1 i]
      exact hDecls (i + 1) ty hi
    have hScrRest : ∀ i ty val,
        Trusted.MirSemantics.getElem? restTys i = some ty →
        Trusted.MirSemantics.getElem? restVals i = some val →
        checkVal val ty = true ∧
        Trusted.MirSemantics.getElem? slots₂ ((sBase + 1) + i) =
          some (.baseSlot (.live (some val))) := by
      intro i ty val hTyI hValI
      have hIdxS : (sBase + 1) + i = sBase + (i + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 i]
      let ⟨hC, hG⟩ := hScr (i + 1) ty val hTyI hValI
      refine ⟨hC, ?_⟩
      have hNeP : (sBase + 1) + i ≠ pBase := fun heq => by
        have hLt : pBase < (sBase + 1) + i :=
          Nat.lt_of_lt_of_le hPLtS (Nat.le_trans (Nat.le_succ _) (Nat.le_add_right _ _))
        rw [heq] at hLt
        exact Nat.lt_irrefl _ hLt
      have hNeS : (sBase + 1) + i ≠ sBase := fun heq => by
        have hLt : sBase < (sBase + 1) + i :=
          Nat.lt_of_lt_of_le (Nat.lt_succ_self sBase) (Nat.le_add_right _ _)
        rw [heq] at hLt
        exact Nat.lt_irrefl _ hLt
      rw [setElem?_getElem?_ne hSetWrite hNeP,
          setElem?_getElem?_ne hSetMove hNeS,
          hIdxS]
      exact hG
    have hPayRest : ∀ i, i < restTys.length →
        ∃ ov, Trusted.MirSemantics.getElem? slots₂ ((pBase + 1) + i) =
          some (.baseSlot (.live ov)) := by
      intro i hi
      have hIdxP : (pBase + 1) + i = pBase + (i + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 i]
      let ⟨ov, hG⟩ := hPayLive (i + 1) (Nat.succ_lt_succ hi)
      have hNeP : (pBase + 1) + i ≠ pBase := fun heq => by
        have hLt : pBase < (pBase + 1) + i :=
          Nat.lt_of_lt_of_le (Nat.lt_succ_self pBase) (Nat.le_add_right _ _)
        rw [heq] at hLt
        exact Nat.lt_irrefl _ hLt
      have hNeS : (pBase + 1) + i ≠ sBase := fun heq => by
        have hLe : (pBase + 1) + i < pBase + (restTys.length + 1) := by
          rw [hIdxP]
          exact Nat.add_lt_add_left (Nat.succ_lt_succ hi) pBase
        have hLtS : (pBase + 1) + i < sBase := Nat.lt_of_lt_of_le hLe hDisj
        rw [heq] at hLtS
        exact Nat.lt_irrefl _ hLtS
      exact ⟨ov, by
        rw [setElem?_getElem?_ne hSetWrite hNeP,
            setElem?_getElem?_ne hSetMove hNeS,
            hIdxP]
        exact hG⟩
    let ⟨slots₃, hRRest, hLen3, hOutRest, hPayOut, hScrOut⟩ :=
      exec_mkMoveScratchToPayload (cm := cm) hB hBB restTys restVals (sBase + 1) (pBase + 1)
        (pre ++ [stMove]) post slots₂ hRestLen hDisjRest hBoundRest hStRest
        hDeclsRest hScrRest hPayRest
    rw [hPre1Len, Nat.add_assoc pre.length 1 restTys.length, Nat.add_comm 1 restTys.length] at hRRest
    refine ⟨slots₃, ReachesNEnum.succ hStep1 hRRest, hLen3.trans hLen2, ?_, ?_, ?_⟩
    · intro j ⟨hjP, hjS⟩
      have hjPRest : j < pBase + 1 ∨ (pBase + 1) + restTys.length ≤ j := by
        cases hjP with
        | inl hlt => exact Or.inl (Nat.lt_trans hlt (Nat.lt_succ_self _))
        | inr hge =>
          rw [Nat.add_assoc, Nat.add_comm 1 restTys.length]
          exact Or.inr hge
      have hjSRest : j < sBase + 1 ∨ (sBase + 1) + restTys.length ≤ j := by
        cases hjS with
        | inl hlt => exact Or.inl (Nat.lt_trans hlt (Nat.lt_succ_self _))
        | inr hge =>
          rw [Nat.add_assoc, Nat.add_comm 1 restTys.length]
          exact Or.inr hge
      have hjNeP : j ≠ pBase := by
        intro heq; subst heq
        cases hjP with
        | inl hlt => exact Nat.lt_irrefl _ hlt
        | inr hge => exact Nat.not_lt_of_ge hge (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _))
      have hjNeS : j ≠ sBase := by
        intro heq; subst heq
        cases hjS with
        | inl hlt => exact Nat.lt_irrefl _ hlt
        | inr hge => exact Nat.not_lt_of_ge hge (Nat.lt_add_of_pos_right (Nat.zero_lt_succ _))
      rw [hOutRest j ⟨hjPRest, hjSRest⟩,
          setElem?_getElem?_ne hSetWrite hjNeP,
          setElem?_getElem?_ne hSetMove hjNeS]
    · intro i val hi hValI
      cases i with
      | zero =>
        injection hValI with hvEq; subst hvEq
        rw [Nat.add_zero]
        have hpOut := hOutRest pBase
          ⟨Or.inl (Nat.lt_succ_self pBase),
           Or.inl (Nat.lt_trans hPLtS (Nat.lt_succ_self sBase))⟩
        rw [hpOut, setElem?_getElem?_same hSetWrite]
      | succ i' =>
        have hIdxP : pBase + (i' + 1) = (pBase + 1) + i' := by
          rw [Nat.add_assoc, Nat.add_comm 1 i']
        rw [hIdxP]
        exact hPayOut i' val (Nat.lt_of_succ_lt_succ hi) hValI
    · intro i ty hTyI
      cases i with
      | zero =>
        injection hTyI with htEq; subst htEq
        rw [Nat.add_zero]
        have hsOut := hOutRest sBase
          ⟨Or.inr (by
             rw [Nat.add_assoc, Nat.add_comm 1 restTys.length]
             exact hDisj),
           Or.inl (Nat.lt_succ_self sBase)⟩
        refine ⟨initFieldOptVal ty₀, ?_⟩
        rw [hsOut,
            setElem?_getElem?_ne hSetWrite (fun h => hPNeS h.symm),
            setElem?_getElem?_same hSetMove,
            liveUninitSlot_eq_initFieldOptVal ty₀]
      | succ i' =>
        have hIdxS : sBase + (i' + 1) = (sBase + 1) + i' := by
          rw [Nat.add_assoc, Nat.add_comm 1 i']
        rw [hIdxS]
        exact hScrOut i' ty hTyI

private noncomputable def NicheOptVal (tagW : IntWidth) : Option (BitVec 128) → Option Val
  | none => none
  | some b => some (.scalar ⟨tagW, false, b⟩)

private theorem checkVal_uint_inv {val : Val} {w : IntWidth}
    (hChk : checkVal val (.int w false) = true) :
    ∃ bits : BitVec 128,
      val = .scalar ⟨w, false, bits⟩ ∧
      truncateBits w bits = bits ∧
      ScalarVal.wf ⟨w, false, bits⟩ = true := by
  cases val with
  | bool _ => change MirTy.beq .bool (.int w false) = true at hChk; cases hChk
  | unit => change MirTy.beq .unit (.int w false) = true at hChk; cases hChk
  | ptr _ => change false = true at hChk; cases hChk
  | enumVal ety v =>
    have hDef : checkVal (.enumVal ety v) (.int w false) =
        (match (if enumAdmitted ety && Nat.blt v ety.discriminants.length then some (MirTy.enum ety) else none) with
         | some vTy => MirTy.beq vTy (.int w false)
         | none => false) := rfl
    rw [hDef] at hChk
    cases hE : (enumAdmitted ety && Nat.blt v ety.discriminants.length) with
    | false => rw [hE] at hChk; cases hChk
    | true => rw [hE] at hChk; change false = true at hChk; cases hChk
  | tuple _ => change false = true at hChk; cases hChk
  | bytes _ => change false = true at hChk; cases hChk
  | scalar sv =>
    cases sv with
    | mk sw ss sbits =>
      have hDef : checkVal (.scalar ⟨sw, ss, sbits⟩) (.int w false) =
          (match (if ScalarVal.wf ⟨sw, ss, sbits⟩ then some (MirTy.int sw ss) else none) with
           | some vTy => MirTy.beq vTy (.int w false)
           | none => false) := rfl
      rw [hDef] at hChk
      cases hWf : ScalarVal.wf ⟨sw, ss, sbits⟩ with
      | false => rw [hWf] at hChk; cases hChk
      | true =>
        rw [hWf] at hChk
        dsimp at hChk
        have hBeq : (IntWidth.beq sw w && (ss == false)) = true := hChk
        let ⟨hW, hS⟩ := bool_and_true hBeq
        have hwEq : sw = w := by cases sw <;> cases w <;> first | rfl | cases hW
        have hsEq : ss = false := by cases ss <;> first | rfl | cases hS
        subst hwEq; subst hsEq
        have hFit : truncateBits sw sbits = sbits := eq_of_beq hWf
        exact ⟨sbits, rfl, hFit, hWf⟩

private theorem exec_mkMoveScratchToNicheUntagged
    {p₂ : EnumProgram} {body₂ : EnumBody} {bb₂ : EnumBlock}
    {defId : DefId} {blockIdx : BasicBlockId} {cm : CallerMemory}
    {ed : AdtEnumDef} {tagW : IntWidth}
    {untagged nStart nLast : Nat} {nStartBits : BitVec 128}
    {tagRange uRange : WrappingRange128} {nicheField : Nat}
    {nicheLoc scrDiff scrGuard extraBase sBase : LocalId}
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .niche tagW untagged nStart nLast nStartBits tagRange nicheField uRange)
    (hURFit : wrappingRangeFitsWidth tagW uRange = true)
    (hB : Trusted.MirSemantics.getElem? p₂.bodies defId = some body₂)
    (hBB : Trusted.MirSemantics.getElem? body₂.basicBlocks blockIdx = some bb₂)
    (hOrder1 : nicheLoc < scrDiff)
    (hOrder2 : scrDiff < scrGuard)
    (hOrder3 : scrGuard < extraBase)
    (hDeclNiche : Trusted.MirSemantics.getElem? body₂.locals nicheLoc =
      some (.base (.int tagW false)))
    (hDeclDiff : Trusted.MirSemantics.getElem? body₂.locals scrDiff =
      some (.base (.int tagW false)))
    (hDeclGuard : Trusted.MirSemantics.getElem? body₂.locals scrGuard =
      some (.base (.int tagW false))) :
    ∀ (remTys : List MirTy) (remVals : List Val) (idx : Nat)
      (nb : Option (BitVec 128)) (extras : List (Option Val))
      (pre post : List EnumStmt) (slots : List EnumSlot),
      remVals.length = remTys.length →
      extraBase + extras.length ≤ sBase →
      sBase + idx + remTys.length ≤ slots.length →
      bb₂.statements = pre ++
        mkMoveScratchToNicheUntagged tagW nicheLoc scrDiff scrGuard
          extraBase sBase nicheField uRange idx remTys ++ post →
      (∀ b, nb = some b → truncateBits tagW b = b) →
      Trusted.MirSemantics.getElem? slots nicheLoc =
        some (.baseSlot (.live (NicheOptVal tagW nb))) →
      (∃ oD, Trusted.MirSemantics.getElem? slots scrDiff = some (.baseSlot (.live oD))) →
      (∃ oG, Trusted.MirSemantics.getElem? slots scrGuard = some (.baseSlot (.live oG))) →
      (∀ eIdx ov, Trusted.MirSemantics.getElem? extras eIdx = some ov →
        Trusted.MirSemantics.getElem? slots (extraBase + eIdx) =
          some (.baseSlot (.live ov))) →
      (∀ k ty, Trusted.MirSemantics.getElem? remTys k = some ty →
        Trusted.MirSemantics.getElem? body₂.locals (sBase + (idx + k)) = some (.base ty) ∧
        (idx + k = nicheField → ty = .int tagW false) ∧
        (idx + k ≠ nicheField →
          nicheExtraIdx nicheField (idx + k) < extras.length ∧
          Trusted.MirSemantics.getElem? body₂.locals
            (extraBase + nicheExtraIdx nicheField (idx + k)) = some (.base ty))) →
      (∀ k ty val,
        Trusted.MirSemantics.getElem? remTys k = some ty →
        Trusted.MirSemantics.getElem? remVals k = some val →
        checkVal val ty = true ∧
        Trusted.MirSemantics.getElem? slots (sBase + (idx + k)) =
          some (.baseSlot (.live (some val)))) →
      (∀ fk, writeAdtFieldsSeq ed untagged idx remTys remVals (.liveNiche nb extras) = .error fk →
        ∃ sF : EnumState,
          ReachesEnum p₂
            { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots }],
              callerMem := cm }
            sF ∧
          evalStepEnum p₂ 0 sF = .fault fk) ∧
      (∀ slOut,
        writeAdtFieldsSeq ed untagged idx remTys remVals (.liveNiche nb extras) = .ok slOut →
        ∃ (steps : Nat) (nb' : Option (BitVec 128)) (extras' : List (Option Val))
          (slots' : List EnumSlot),
          slOut = .liveNiche nb' extras' ∧
          steps = (mkMoveScratchToNicheUntagged tagW nicheLoc scrDiff scrGuard
            extraBase sBase nicheField uRange idx remTys).length ∧
          extras'.length = extras.length ∧
          (∀ b, nb' = some b → truncateBits tagW b = b) ∧
          ((nb' = nb ∧ ∀ k, k < remTys.length → idx + k ≠ nicheField) ∨
           (∃ b, nb' = some b ∧ wrappingRangeContains uRange b = true)) ∧
          ReachesNEnum p₂ steps
            { frames := [{ defId, blockIdx, stmtIdx := pre.length, locals := slots }],
              callerMem := cm }
            { frames := [{ defId, blockIdx, stmtIdx := pre.length + steps, locals := slots' }],
              callerMem := cm } ∧
          slots'.length = slots.length ∧
          Trusted.MirSemantics.getElem? slots' nicheLoc =
            some (.baseSlot (.live (NicheOptVal tagW nb'))) ∧
          (∃ oD, Trusted.MirSemantics.getElem? slots' scrDiff = some (.baseSlot (.live oD))) ∧
          (∃ oG, Trusted.MirSemantics.getElem? slots' scrGuard = some (.baseSlot (.live oG))) ∧
          (∀ eIdx ov, Trusted.MirSemantics.getElem? extras' eIdx = some ov →
            Trusted.MirSemantics.getElem? slots' (extraBase + eIdx) =
              some (.baseSlot (.live ov))) ∧
          (∀ k ty, Trusted.MirSemantics.getElem? remTys k = some ty →
            ∃ ov, Trusted.MirSemantics.getElem? slots' (sBase + (idx + k)) =
              some (.baseSlot (.live ov))) ∧
          (∀ j,
            j ≠ nicheLoc → j ≠ scrDiff → j ≠ scrGuard →
            (j < extraBase ∨ extraBase + extras.length ≤ j) →
            (j < sBase + idx ∨ sBase + idx + remTys.length ≤ j) →
            Trusted.MirSemantics.getElem? slots' j =
              Trusted.MirSemantics.getElem? slots j))
  | [], [], idx, nb, extras, pre, _, slots,
    _, _, _, _, hNbFit, hSlotN, hSlotD, hSlotG, hSlotE, _, _ => by
    unfold writeAdtFieldsSeq
    dsimp
    refine ⟨(fun _ h => by cases h), ?_⟩
    intro slOut hOk
    injection hOk with hEq; subst hEq
    exact ⟨0, nb, extras, slots, rfl, rfl, rfl, hNbFit,
            Or.inl ⟨rfl, fun _ h => False.elim (Nat.not_lt_zero _ h)⟩,
            ReachesNEnum.zero _,
            rfl, hSlotN, hSlotD, hSlotG, hSlotE,
            (fun _ _ h => by cases h),
            fun _ _ _ _ _ _ => rfl⟩
  | [], _ :: _, _, _, _, _, _, _, hLen, _, _, _, _, _, _, _, _, _, _ => by cases hLen
  | _ :: _, [], _, _, _, _, _, _, hLen, _, _, _, _, _, _, _, _, _, _ => by cases hLen
  | fTy :: restTys, val :: restVals, idx, nb, extras, pre, post, slots,
    hLenEq, hExLeS, hBound, hStmts, hNbFit, hSlotN, hSlotD, hSlotG, hSlotE,
    hDecls, hScr => by
    have hRestLen : restVals.length = restTys.length := Nat.succ.inj hLenEq
    let ⟨oD, hSD⟩ := hSlotD
    let ⟨oG, hSG⟩ := hSlotG
    have hDNeG : scrGuard ≠ scrDiff := fun h => by subst h; exact Nat.lt_irrefl _ hOrder2
    have hNicheLtS : nicheLoc < sBase + idx :=
      Nat.lt_of_lt_of_le (Nat.lt_trans hOrder1 (Nat.lt_trans hOrder2 hOrder3))
        (Nat.le_trans (Nat.le_add_right _ _)
          (Nat.le_trans hExLeS (Nat.le_add_right _ _)))
    have hDiffLtS : scrDiff < sBase + idx :=
      Nat.lt_of_lt_of_le (Nat.lt_trans hOrder2 hOrder3)
        (Nat.le_trans (Nat.le_add_right _ _)
          (Nat.le_trans hExLeS (Nat.le_add_right _ _)))
    have hGuardLtS : scrGuard < sBase + idx :=
      Nat.lt_of_lt_of_le hOrder3
        (Nat.le_trans (Nat.le_add_right _ _)
          (Nat.le_trans hExLeS (Nat.le_add_right _ _)))
    have hDecls0 := hDecls 0 fTy rfl
    rw [Nat.add_zero] at hDecls0
    let ⟨hDeclS0, hIfNiche0, hIfExtra0⟩ := hDecls0
    have hScr0 := hScr 0 fTy val rfl rfl
    rw [Nat.add_zero] at hScr0
    let ⟨hChk0, hSlotS0⟩ := hScr0
    unfold writeAdtFieldsSeq
    dsimp
    dsimp [mkMoveScratchToNicheUntagged] at hStmts
    cases hEqIdxN : Nat.beq idx nicheField with
    | true =>
      have hIdxEqN : idx = nicheField := nat_beq_eq hEqIdxN
      have hfTyEq : fTy = .int tagW false := hIfNiche0 hIdxEqN
      subst hfTyEq
      let ⟨bits, hValEq, hBitsFit, hBitsWf⟩ := checkVal_uint_inv hChk0
      subst hValEq
      rw [hEqIdxN] at hStmts
      dsimp at hStmts
      have hWAdt : writeAdtField ed untagged idx (.int tagW false)
          (.scalar ⟨tagW, false, bits⟩) (.liveNiche nb extras) =
          (if !wrappingRangeContains uRange bits then Except.error FaultKind.undefined
           else Except.ok (.liveNiche (some bits) extras)) := by
        unfold writeAdtField
        rw [hAdm, hChk0]
        dsimp
        rw [hLay]
        dsimp
        rw [nat_beq_refl untagged, hEqIdxN]
        dsimp
        have hWBeq : IntWidth.beq tagW tagW = true := by cases tagW <;> rfl
        rw [hWBeq, hBitsWf]
        rfl
      rw [hWAdt]
      let pScr : Place := { localId := sBase + idx, projection := [] }
      let stMoveN : EnumStmt :=
        .baseStmt (.assign { localId := nicheLoc, projection := [] } (.use (.move pScr)))
      let tailStmts :=
        mkMoveScratchToNicheUntagged tagW nicheLoc scrDiff scrGuard
          extraBase sBase nicheField uRange (idx + 1) restTys
      have hStRange : bb₂.statements =
          pre ++ mkWrappingRangeCheckStmts tagW scrDiff scrGuard (.copy pScr) uRange ++
            (stMoveN :: (tailStmts ++ post)) := by
        rw [hStmts]
        simp only [List.append_assoc]
        rfl
      let ⟨_, hRangeSpec⟩ := exec_mkWrappingRangeCheckStmts_copy (cm := cm)
        (f := { defId, blockIdx, stmtIdx := pre.length, locals := slots })
        hB hBB hStRange rfl hURFit hDeclS0 hDeclDiff hDeclGuard hDNeG hSD hSG
      let ⟨hInSpec, hOutSpec⟩ := hRangeSpec bits hBitsFit hSlotS0
      cases hInU : wrappingRangeContains uRange bits with
      | false =>
        dsimp
        let ⟨sF, hRF, hEvF⟩ := hOutSpec hInU
        refine ⟨?_, fun _ h => by cases h⟩
        intro fk hfk
        injection hfk with hkEq; subst hkEq
        exact ⟨sF, hRF, hEvF⟩
      | true =>
        dsimp
        let ⟨slotsR, oDR, oGR, hRRange, hLenR, hSDR, hSGR, hPresR⟩ := hInSpec hInU
        have hPreRangeLen :
            (pre ++ mkWrappingRangeCheckStmts tagW scrDiff scrGuard (.copy pScr) uRange).length =
            pre.length + 2 := list_append_length pre [_, _]
        have hStMove : bb₂.statements =
            (pre ++ mkWrappingRangeCheckStmts tagW scrDiff scrGuard (.copy pScr) uRange) ++
              stMoveN :: (tailStmts ++ post) := by
          rw [hStRange]
        have hS0NeD : sBase + idx ≠ scrDiff := fun h => by
          rw [h] at hDiffLtS; exact Nat.lt_irrefl _ hDiffLtS
        have hS0NeG : sBase + idx ≠ scrGuard := fun h => by
          rw [h] at hGuardLtS; exact Nat.lt_irrefl _ hGuardLtS
        have hNNeD : nicheLoc ≠ scrDiff := fun h => by
          rw [h] at hOrder1; exact Nat.lt_irrefl _ hOrder1
        have hNNeG : nicheLoc ≠ scrGuard := fun h => by
          have hNLtG := Nat.lt_trans hOrder1 hOrder2
          rw [h] at hNLtG; exact Nat.lt_irrefl _ hNLtG
        have hNNeS0 : nicheLoc ≠ sBase + idx := fun h => by
          rw [h] at hNicheLtS; exact Nat.lt_irrefl _ hNicheLtS
        have hSlotRS0 : Trusted.MirSemantics.getElem? slotsR (sBase + idx) =
            some (.baseSlot (.live (some (.scalar ⟨tagW, false, bits⟩)))) := by
          rw [hPresR _ hS0NeD hS0NeG]; exact hSlotS0
        have hSlotRN : Trusted.MirSemantics.getElem? slotsR nicheLoc =
            some (.baseSlot (.live (NicheOptVal tagW nb))) := by
          rw [hPresR _ hNNeD hNNeG]; exact hSlotN
        let ⟨slotsM1, hSetM1⟩ := setElem?_some_of_lt slotsR (sBase + idx)
          (.baseSlot (.live none)) (getElem?_some_lt hSlotRS0)
        have hSlotM1N : Trusted.MirSemantics.getElem? slotsM1 nicheLoc =
            some (.baseSlot (.live (NicheOptVal tagW nb))) := by
          rw [setElem?_getElem?_ne hSetM1 hNNeS0]; exact hSlotRN
        let ⟨slotsM2, hSetM2⟩ := setElem?_some_of_lt slotsM1 nicheLoc
          (.baseSlot (.live (some (.scalar ⟨tagW, false, bits⟩))))
          (getElem?_some_lt hSlotM1N)
        have hStepMove : evalStepEnum p₂ 0
            { frames := [{ defId, blockIdx, stmtIdx := pre.length + 2, locals := slotsR }],
              callerMem := cm } =
            .step { frames := [{ defId, blockIdx, stmtIdx := pre.length + 3, locals := slotsM2 }],
                    callerMem := cm } := by
          rw [stepAtStmt (f := { defId, blockIdx, stmtIdx := pre.length + 2, locals := slotsR })
                hB hBB hStMove hPreRangeLen.symm]
          dsimp [stMoveN, pScr]
          unfold evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot writeEnumBasePlace
          dsimp
          rw [hDeclNiche, hDeclS0, hSlotRS0]
          dsimp
          rw [liveUninitSlot_uint, hSetM1]
          dsimp
          rw [mirTy_beq_refl (.int tagW false)]
          dsimp
          rw [checkVal_uint_of_fit tagW bits hBitsFit]
          dsimp
          rw [hSlotM1N]
          dsimp
          rw [hSetM2]
        have hLenM2 : slotsM2.length = slots.length :=
          (setElem?_length hSetM2).trans ((setElem?_length hSetM1).trans hLenR)
        let pre3 :=
          pre ++ mkWrappingRangeCheckStmts tagW scrDiff scrGuard (.copy pScr) uRange ++ [stMoveN]
        have hPre3Len : pre3.length = pre.length + 3 := by
          dsimp [pre3]
          rw [list_append_length, hPreRangeLen]
          rfl
        have hStTail : bb₂.statements = pre3 ++ tailStmts ++ post := by
          dsimp [pre3]
          rw [hStMove]
          simp only [List.append_assoc]
          rfl
        have hBoundTail : sBase + (idx + 1) + restTys.length ≤ slotsM2.length := by
          rw [hLenM2]
          have hAr : sBase + (idx + 1) + restTys.length = sBase + idx + (restTys.length + 1) := by
            rw [← Nat.add_assoc sBase idx 1, Nat.add_assoc (sBase + idx) 1 restTys.length,
                Nat.add_comm 1 restTys.length]
          rw [hAr]
          exact hBound
        have hNbFit' : ∀ b, some bits = some b → truncateBits tagW b = b := by
          intro b hb; injection hb with heq; subst heq; exact hBitsFit
        have hSlotNM2 : Trusted.MirSemantics.getElem? slotsM2 nicheLoc =
            some (.baseSlot (.live (NicheOptVal tagW (some bits)))) :=
          setElem?_getElem?_same hSetM2
        have hSlotDM2 : ∃ oD', Trusted.MirSemantics.getElem? slotsM2 scrDiff =
            some (.baseSlot (.live oD')) := by
          refine ⟨oDR, ?_⟩
          rw [setElem?_getElem?_ne hSetM2 (fun h => hNNeD h.symm),
              setElem?_getElem?_ne hSetM1 (fun h => hS0NeD h.symm)]
          exact hSDR
        have hSlotGM2 : ∃ oG', Trusted.MirSemantics.getElem? slotsM2 scrGuard =
            some (.baseSlot (.live oG')) := by
          refine ⟨oGR, ?_⟩
          rw [setElem?_getElem?_ne hSetM2 (fun h => hNNeG h.symm),
              setElem?_getElem?_ne hSetM1 (fun h => hS0NeG h.symm)]
          exact hSGR
        have hSlotEM2 : ∀ eIdx ov, Trusted.MirSemantics.getElem? extras eIdx = some ov →
            Trusted.MirSemantics.getElem? slotsM2 (extraBase + eIdx) =
              some (.baseSlot (.live ov)) := by
          intro eIdx ov hE
          have hELt : eIdx < extras.length := getElem?_some_lt hE
          have hELtS : extraBase + eIdx < sBase + idx :=
            Nat.lt_of_lt_of_le (Nat.add_lt_add_left hELt extraBase)
              (Nat.le_trans hExLeS (Nat.le_add_right _ _))
          have hENeN : extraBase + eIdx ≠ nicheLoc := fun h => by
            have hNLtE := Nat.lt_of_lt_of_le
              (Nat.lt_trans hOrder1 (Nat.lt_trans hOrder2 hOrder3))
              (Nat.le_add_right extraBase eIdx)
            rw [h] at hNLtE; exact Nat.lt_irrefl _ hNLtE
          have hENeD : extraBase + eIdx ≠ scrDiff := fun h => by
            have hDLtE := Nat.lt_of_lt_of_le (Nat.lt_trans hOrder2 hOrder3)
              (Nat.le_add_right extraBase eIdx)
            rw [h] at hDLtE; exact Nat.lt_irrefl _ hDLtE
          have hENeG : extraBase + eIdx ≠ scrGuard := fun h => by
            have hGLtE := Nat.lt_of_lt_of_le hOrder3 (Nat.le_add_right extraBase eIdx)
            rw [h] at hGLtE; exact Nat.lt_irrefl _ hGLtE
