/-! ## Slice 3a: Multi-Step Straight-Line & Dispatch Gadgets for `EnumScalarize` -/

/-! ### 1. List Indexing & `setElem?` Identity Helpers -/

private theorem setElem?_eq_self_of_getElem? {α : Type} :
    ∀ {xs : List α} {i : Nat} {v : α},
      Trusted.MirSemantics.getElem? xs i = some v →
      setElem? xs i v = some xs
  | [], _, _, h => by cases h
  | _ :: xs, 0, _, h => by
    injection h with heq; subst heq; rfl
  | x :: xs, i + 1, v, h => by
    have ih := @setElem?_eq_self_of_getElem? α xs i v h
    change (match setElem? xs i v with | some r => some (x :: r) | none => none) = some (x :: xs)
    rw [ih]

private theorem getElem?_append_middle {α : Type} (pre : List α) (x : α) (post : List α) :
    Trusted.MirSemantics.getElem? (pre ++ x :: post) pre.length = some x := by
  induction pre with
  | nil => rfl
  | cons _ tl ih =>
    dsimp [List.append, List.length]
    exact ih

private theorem stepAtStmt {p : EnumProgram} {body : EnumBody} {bb : EnumBlock}
    {f : EnumFrame} {cm : CallerMemory}
    {pre post : List EnumStmt} {st : EnumStmt}
    (hB : Trusted.MirSemantics.getElem? p.bodies f.defId = some body)
    (hBB : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx = some bb)
    (hStmts : bb.statements = pre ++ st :: post)
    (hIdx : f.stmtIdx = pre.length) :
    evalStepEnum p 0 { frames := [f], callerMem := cm } =
      evalEnumStmt p.enumDefs body f cm st := by
  unfold evalStepEnum
  dsimp
  rw [hB]
  dsimp
  rw [hBB]
  dsimp
  rw [hStmts, hIdx, getElem?_append_middle pre st post]

private theorem stepAtTerm {p : EnumProgram} {body : EnumBody} {bb : EnumBlock}
    {f : EnumFrame} {cm : CallerMemory}
    (hB : Trusted.MirSemantics.getElem? p.bodies f.defId = some body)
    (hBB : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx = some bb)
    (hIdx : f.stmtIdx = bb.statements.length) :
    evalStepEnum p 0 { frames := [f], callerMem := cm } =
      evalEnumTerminator p.enumDefs body bb f cm := by
  unfold evalStepEnum
  dsimp
  rw [hB]
  dsimp
  rw [hBB]
  dsimp
  have hNone : ∀ (xs : List EnumStmt), Trusted.MirSemantics.getElem? xs xs.length = none := by
    intro xs
    induction xs with
    | nil => rfl
    | cons _ _ ih => exact ih
  rw [hIdx, hNone bb.statements, nat_beq_refl]
  rfl

/-! ### 2. Unsigned `BinOp.sub` & `BinOp.subUnchecked` Semantics in `Trusted.MirSemantics` -/

private theorem int_ofNat_sub_eq_subNatNat (a b : Nat) :
    (Int.ofNat a - Int.ofNat b) = Int.subNatNat a b := by
  cases b with
  | zero =>
    unfold Int.subNatNat
    rw [Nat.zero_sub, Nat.sub_zero]
    rfl
  | succ _ => rfl

private theorem int_subNatNat_eq_of_le {a b : Nat} (h : b ≤ a) :
    Int.subNatNat a b = Int.ofNat (a - b) := by
  unfold Int.subNatNat
  have hZero : b - a = 0 := Nat.sub_eq_zero_of_le h
  rw [hZero]

private theorem int_subNatNat_eq_of_lt {a b : Nat} (h : a < b) :
    Int.subNatNat a b = Int.negSucc (b - a - 1) := by
  unfold Int.subNatNat
  have hPos : 1 ≤ b - a := Nat.sub_pos_of_lt h
  cases hSub : b - a with
  | zero => rw [hSub] at hPos; cases hPos
  | succ _ => dsimp

private theorem int_ofNat_le_iff {x y : Nat} (h : Int.ofNat x ≤ Int.ofNat y) : x ≤ y := by
  cases nat_le_or_gt x y with
  | inl hLe => exact hLe
  | inr hGt =>
    have hSub : (Int.ofNat y - Int.ofNat x) = Int.negSucc (x - y - 1) :=
      (int_ofNat_sub_eq_subNatNat y x).trans (int_subNatNat_eq_of_lt hGt)
    have hNN : Int.NonNeg (Int.ofNat y - Int.ofNat x) := h
    rw [hSub] at hNN
    cases hNN

private theorem bvOfInt_128_ofNat (n : Nat) :
    bvOfInt 128 (Int.ofNat n) = BitVec.ofNat 128 n := by
  have hDef : bvOfInt 128 (Int.ofNat n) =
      BitVec.ofNat 128 (Nat.mod n (Nat.pow 2 128)) := rfl
  rw [hDef]
  apply bitvec_eq_of_toNat_eq
  rw [bitvec_ofNat_toNat, bitvec_ofNat_toNat]
  have hMod := nat_mod_mod_of_mul n (Nat.pow 2 128) 1
  rw [Nat.mul_one] at hMod
  exact hMod

private theorem bvOfInt_128_sub_of_lt {a b : Nat}
    (_ha : a < Nat.pow 2 128) (hb : b < Nat.pow 2 128) :
    (bvOfInt 128 (Int.ofNat a - Int.ofNat b)).toNat =
      Nat.mod (Nat.pow 2 128 - b + a) (Nat.pow 2 128) := by
  rw [int_ofNat_sub_eq_subNatNat]
  cases nat_le_or_gt b a with
  | inl hLe =>
    rw [int_subNatNat_eq_of_le hLe, bvOfInt_128_ofNat, bitvec_ofNat_toNat]
    have hEq : Nat.pow 2 128 - b + a = (a - b) + Nat.pow 2 128 := by
      rw [nat_sub_add_comm (Nat.le_of_lt hb), Nat.add_sub_assoc hLe, Nat.add_comm]
    rw [hEq, nat_add_mod_self_right]
  | inr hLt =>
    rw [int_subNatNat_eq_of_lt hLt]
    have hmLt : b - a - 1 < Nat.pow 2 128 :=
      Nat.lt_of_le_of_lt (Nat.sub_le _ _) (Nat.lt_of_le_of_lt (Nat.sub_le b a) hb)
    have hPos : 1 ≤ b - a := Nat.sub_pos_of_lt hLt
    have hSucc : Nat.succ (Nat.mod (b - a - 1) (Nat.pow 2 128)) = b - a := by
      rw [nat_mod_eq_of_lt hmLt]
      exact Nat.sub_add_cancel hPos
    have hBA_le : b - a ≤ Nat.pow 2 128 :=
      Nat.le_of_lt (Nat.lt_of_le_of_lt (Nat.sub_le b a) hb)
    have hDef : bvOfInt 128 (Int.negSucc (b - a - 1)) =
        BitVec.ofNat 128 (Int.subNatNat (Nat.pow 2 128)
          (Nat.succ (Nat.mod (b - a - 1) (Nat.pow 2 128)))).toNat := rfl
    rw [hDef, hSucc, int_subNatNat_eq_of_le hBA_le]
    have hToNat : (Int.ofNat (Nat.pow 2 128 - (b - a))).toNat =
        Nat.pow 2 128 - (b - a) := rfl
    rw [hToNat, bitvec_ofNat_toNat]
    have hArith : Nat.pow 2 128 - (b - a) = Nat.pow 2 128 - b + a := by
      have h1 : (b - a) + (Nat.pow 2 128 - b + a) = Nat.pow 2 128 := by
        rw [Nat.add_comm (b - a) _, Nat.add_assoc, Nat.add_sub_of_le (Nat.le_of_lt hLt),
            Nat.sub_add_cancel (Nat.le_of_lt hb)]
      exact nat_sub_eq_of_add_eq h1
    rw [hArith]

private theorem evalBinOp_unsigned_sub_eq {w : IntWidth} {a b : BitVec 128}
    (ha : truncateBits w a = a) (hb : truncateBits w b = b) :
    evalBinOp .sub (.scalar ⟨w, false, a⟩) (.scalar ⟨w, false, b⟩) =
      .ok (.scalar ⟨w, false, subTruncBits w a b⟩) := by
  have ha128 : a.toNat < Nat.pow 2 128 :=
    Nat.lt_of_lt_of_le (toNat_lt_of_truncateBits_eq ha) (intWidth_pow2_le_pow2_128 w)
  have hb128 : b.toNat < Nat.pow 2 128 :=
    Nat.lt_of_lt_of_le (toNat_lt_of_truncateBits_eq hb) (intWidth_pow2_le_pow2_128 w)
  have hStep : evalBinOp .sub (.scalar ⟨w, false, a⟩) (.scalar ⟨w, false, b⟩) =
      Except.ok (.scalar ⟨w, false,
        truncateBits w (bvOfInt 128 (Int.ofNat a.toNat - Int.ofNat b.toNat))⟩) := by
    have hWBeq : IntWidth.beq w w = true := by cases w <;> rfl
    change (if false then Except.error FaultKind.unsupported
      else if !(IntWidth.beq w w && true) then Except.error FaultKind.unsupported
      else evalArithOp .sub w false
        (Int.ofNat (truncateBits w a).toNat)
        (Int.ofNat (truncateBits w b).toNat)) = _
    rw [hWBeq, ha, hb]
    dsimp
    have hAndFalse : ∀ x : Bool, (x && false) = false := fun x => by cases x <;> rfl
    change (let result := Int.ofNat a.toNat - Int.ofNat b.toNat
      let hostOverflow := decide (result < 0) || decide (result ≥ HPow.hPow (2 : Int) 128)
      let raw := bvOfInt 128 result
      let trunc := truncateBits w raw
      if (hostOverflow || (trunc != raw)) && false then Except.error FaultKind.undefined
      else Except.ok (Val.scalar ⟨w, false, trunc⟩)) = _
    dsimp
    rw [hAndFalse]
    rfl
  rw [hStep]
  have hBvEq : bvOfInt 128 (Int.ofNat a.toNat - Int.ofNat b.toNat) = a - b := by
    apply bitvec_eq_of_toNat_eq
    rw [bvOfInt_128_sub_of_lt ha128 hb128, bv_sub_toNat]
  rw [hBvEq]
  rfl

private theorem evalBinOp_unsigned_subUnchecked_ok {w : IntWidth} {a b : BitVec 128}
    (ha : truncateBits w a = a) (hb : truncateBits w b = b)
    (hLe : b.toNat ≤ a.toNat) :
    evalBinOp .subUnchecked (.scalar ⟨w, false, a⟩) (.scalar ⟨w, false, b⟩) =
      .ok (.scalar ⟨w, false, BitVec.ofNat 128 (a.toNat - b.toNat)⟩) := by
  have hWBeq : IntWidth.beq w w = true := by cases w <;> rfl
  have haLtM : a.toNat < Nat.pow 2 w.bitWidth := toNat_lt_of_truncateBits_eq ha
  have hDiffLtM : a.toNat - b.toNat < Nat.pow 2 w.bitWidth :=
    Nat.lt_of_le_of_lt (Nat.sub_le _ _) haLtM
  have hDiffLt128 : a.toNat - b.toNat < Nat.pow 2 128 :=
    Nat.lt_of_lt_of_le hDiffLtM (intWidth_pow2_le_pow2_128 w)
  have hSubInt : (Int.ofNat a.toNat - Int.ofNat b.toNat) =
      Int.ofNat (a.toNat - b.toNat) :=
    (int_ofNat_sub_eq_subNatNat _ _).trans (int_subNatNat_eq_of_le hLe)
  have hRaw : bvOfInt 128 (Int.ofNat (a.toNat - b.toNat)) =
      BitVec.ofNat 128 (a.toNat - b.toNat) := bvOfInt_128_ofNat _
  have hTrunc : truncateBits w (BitVec.ofNat 128 (a.toNat - b.toNat)) =
      BitVec.ofNat 128 (a.toNat - b.toNat) := by
    apply truncateBits_eq_of_toNat_lt
    rw [bitvec_ofNat_toNat, nat_mod_eq_of_lt hDiffLt128]
    exact hDiffLtM
  have hNotNeg : decide (((a.toNat - b.toNat : Nat) : Int) < 0) = false := rfl
  have hNotGe : decide (((a.toNat - b.toNat : Nat) : Int) ≥
      (340282366920938463463374607431768211456 : Int)) = false := by
    cases hD : decide (((a.toNat - b.toNat : Nat) : Int) ≥
        (340282366920938463463374607431768211456 : Int)) with
    | false => rfl
    | true =>
      have hGeInt : Int.ofNat (Nat.pow 2 128) ≤ Int.ofNat (a.toNat - b.toNat) :=
        of_decide_eq_true hD
      have hGeNat : Nat.pow 2 128 ≤ a.toNat - b.toNat := int_ofNat_le_iff hGeInt
      exact False.elim (Nat.not_lt_of_ge hGeNat hDiffLt128)
  change (if false then Except.error FaultKind.unsupported
    else if !(IntWidth.beq w w && true) then Except.error FaultKind.unsupported
    else evalArithOp .subUnchecked w false
      (Int.ofNat (truncateBits w a).toNat)
      (Int.ofNat (truncateBits w b).toNat)) = _
  rw [hWBeq, ha, hb]
  dsimp
  change (let result := Int.ofNat a.toNat - Int.ofNat b.toNat
    let hostOverflow := decide (result < 0) || decide (result ≥ HPow.hPow (2 : Int) 128)
    let raw := bvOfInt 128 result
    let trunc := truncateBits w raw
    if (hostOverflow || (trunc != raw)) && true then Except.error FaultKind.undefined
    else Except.ok (Val.scalar ⟨w, false, trunc⟩)) = _
  rw [hSubInt]
  dsimp
  have hRaw' : bvOfInt 128 ((a.toNat - b.toNat : Nat) : Int) =
      BitVec.ofNat 128 (a.toNat - b.toNat) := hRaw
  rw [hNotNeg, hNotGe, hRaw', hTrunc, bitvec_bne_false_of_eq rfl]
  rfl

private theorem evalBinOp_unsigned_subUnchecked_err {w : IntWidth} {a b : BitVec 128}
    (ha : truncateBits w a = a) (hb : truncateBits w b = b)
    (hLt : a.toNat < b.toNat) :
    evalBinOp .subUnchecked (.scalar ⟨w, false, a⟩) (.scalar ⟨w, false, b⟩) =
      .error .undefined := by
  have hWBeq : IntWidth.beq w w = true := by cases w <;> rfl
  have hSubInt : (Int.ofNat a.toNat - Int.ofNat b.toNat) =
      Int.negSucc (b.toNat - a.toNat - 1) :=
    (int_ofNat_sub_eq_subNatNat _ _).trans (int_subNatNat_eq_of_lt hLt)
  have hNeg : ∀ n : Nat, decide (Int.negSucc n < 0) = true := by
    intro n
    cases n with
    | zero => decide
    | succ k =>
      apply decide_eq_true
      change Int.NonNeg (Int.ofNat (0 + (k + 1)))
      rw [Nat.zero_add]
      exact Int.NonNeg.mk (k + 1)
  change (if false then Except.error FaultKind.unsupported
    else if !(IntWidth.beq w w && true) then Except.error FaultKind.unsupported
    else evalArithOp .subUnchecked w false
      (Int.ofNat (truncateBits w a).toNat)
      (Int.ofNat (truncateBits w b).toNat)) = _
  rw [hWBeq, ha, hb]
  dsimp
  change (let result := Int.ofNat a.toNat - Int.ofNat b.toNat
    let hostOverflow := decide (result < 0) || decide (result ≥ HPow.hPow (2 : Int) 128)
    let raw := bvOfInt 128 result
    let trunc := truncateBits w raw
    if (hostOverflow || (trunc != raw)) && true then Except.error FaultKind.undefined
    else Except.ok (Val.scalar ⟨w, false, trunc⟩)) = _
  rw [hSubInt]
  dsimp
  rw [hNeg]
  rfl

/-! ### 3. Execution Specs for `mkLivenessCheckStmt`, `mkImmediateUbStmt`, & `mkWrappingRangeCheckStmts` -/

private theorem eval_mkLivenessCheckStmt_live {enumDefs : List AdtEnumDef}
    {body : EnumBody} {frame : EnumFrame} {cm : CallerMemory} {liveLoc : LocalId}
    (hDecl : Trusted.MirSemantics.getElem? body.locals liveLoc = some (.base .unit))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals liveLoc =
      some (.baseSlot (.live (some .unit)))) :
    evalEnumStmt enumDefs body frame cm (mkLivenessCheckStmt liveLoc) =
      .step { frames := [{ frame with stmtIdx := frame.stmtIdx + 1 }], callerMem := cm } := by
  unfold mkLivenessCheckStmt evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot writeEnumBasePlace
  dsimp
  rw [hDecl, hSlot]
  dsimp
  have hUnitBeq : MirTy.beq .unit .unit = true := rfl
  have hValOk : checkVal .unit .unit = true := rfl
  rw [hUnitBeq]
  dsimp
  rw [hValOk, hSlot]
  dsimp
  rw [setElem?_eq_self_of_getElem? hSlot]

private theorem eval_mkLivenessCheckStmt_dead {enumDefs : List AdtEnumDef}
    {body : EnumBody} {frame : EnumFrame} {cm : CallerMemory} {liveLoc : LocalId}
    (hDecl : Trusted.MirSemantics.getElem? body.locals liveLoc = some (.base .unit))
    (hSlot : Trusted.MirSemantics.getElem? frame.locals liveLoc =
      some (.baseSlot .dead)) :
    evalEnumStmt enumDefs body frame cm (mkLivenessCheckStmt liveLoc) =
      .fault .undefined := by
  unfold mkLivenessCheckStmt evalEnumStmt evalEnumBaseRvalue evalEnumBaseOperandToSlot
  dsimp
  rw [hDecl, hSlot]

private theorem eval_mkImmediateUbStmt {enumDefs : List AdtEnumDef}
    {body : EnumBody} {frame : EnumFrame} {cm : CallerMemory} {faultLoc : LocalId}
    (hDecl : Trusted.MirSemantics.getElem? body.locals faultLoc =
      some (.base (.int .i32 false))) :
    evalEnumStmt enumDefs body frame cm (mkImmediateUbStmt faultLoc) =
      .fault .undefined := by
  unfold mkImmediateUbStmt evalEnumStmt evalEnumBaseRvalue evalEnumPrimitiveOperand evalEnumBaseOperandToSlot
  dsimp
  rw [hDecl]
  rfl

private theorem evalConstLit_uint_eq (w : IntWidth) (bits : BitVec 128)
    (hFit : truncateBits w bits = bits) :
    evalConstLit (.int w false) (.scalar bits) =
      .ok (.scalar ⟨w, false, bits⟩) := by
  change (if truncateBits w bits != bits then Except.error FaultKind.unsupported
    else Except.ok (Val.scalar ⟨w, false, truncateBits w bits⟩)) = _
  rw [bitvec_bne_false_of_eq hFit, hFit]
  rfl

private theorem checkVal_uint_of_fit (w : IntWidth) (bits : BitVec 128)
    (hFit : truncateBits w bits = bits) :
    checkVal (.scalar ⟨w, false, bits⟩) (.int w false) = true := by
  have hWBeq : IntWidth.beq w w = true := by cases w <;> rfl
  have hWf : ScalarVal.wf ⟨w, false, bits⟩ = true := by
    change (truncateBits w bits == bits) = true
    rw [hFit]
    exact bitvec_beq_refl bits
  change (match (if ScalarVal.wf ⟨w, false, bits⟩ then some (MirTy.int w false) else none) with
    | some vTy => MirTy.beq vTy (.int w false)
    | none => false) = true
  rw [hWf]
  dsimp
  change (IntWidth.beq w w && (false == false)) = true
  rw [hWBeq]
  rfl

private theorem isPrimitiveReadableTy_uint (w : IntWidth) :
    isPrimitiveReadableTy (.int w false) = true := rfl

private theorem liveUninitSlot_uint (w : IntWidth) :
    liveUninitSlot (.int w false) = .live none := rfl

private theorem exec_mkWrappingRangeCheckStmts_copy
    {p : EnumProgram} {body : EnumBody} {bb : EnumBlock}
    {f : EnumFrame} {cm : CallerMemory}
    {pre post : List EnumStmt}
    {tagW : IntWidth} {valLoc scrDiff scrGuard : LocalId}
    {r : WrappingRange128}
    (hB : Trusted.MirSemantics.getElem? p.bodies f.defId = some body)
    (hBB : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx = some bb)
    (hStmts : bb.statements =
      pre ++ mkWrappingRangeCheckStmts tagW scrDiff scrGuard
        (.copy { localId := valLoc, projection := [] }) r ++ post)
    (hIdx : f.stmtIdx = pre.length)
    (hRFit : wrappingRangeFitsWidth tagW r = true)
    (hDeclVal : Trusted.MirSemantics.getElem? body.locals valLoc =
      some (.base (.int tagW false)))
    (hDeclDiff : Trusted.MirSemantics.getElem? body.locals scrDiff =
      some (.base (.int tagW false)))
    (hDeclGuard : Trusted.MirSemantics.getElem? body.locals scrGuard =
      some (.base (.int tagW false)))
    (hDiffNeGuard : scrGuard ≠ scrDiff)
    {optD optG : Option Val}
    (hSlotDiff : Trusted.MirSemantics.getElem? f.locals scrDiff =
      some (.baseSlot (.live optD)))
    (hSlotGuard : Trusted.MirSemantics.getElem? f.locals scrGuard =
      some (.baseSlot (.live optG))) :
    (Trusted.MirSemantics.getElem? f.locals valLoc = some (.baseSlot (.live none)) →
      evalStepEnum p 0 { frames := [f], callerMem := cm } = .fault .undefined) ∧
    (∀ (bits : BitVec 128),
      truncateBits tagW bits = bits →
      Trusted.MirSemantics.getElem? f.locals valLoc =
        some (.baseSlot (.live (some (.scalar ⟨tagW, false, bits⟩)))) →
      (wrappingRangeContains r bits = true →
        ∃ (slots₂ : List EnumSlot) (oD oG : Option Val),
          ReachesNEnum p 2 { frames := [f], callerMem := cm }
            { frames := [{ f with stmtIdx := pre.length + 2, locals := slots₂ }],
              callerMem := cm } ∧
          slots₂.length = f.locals.length ∧
          Trusted.MirSemantics.getElem? slots₂ scrDiff = some (.baseSlot (.live oD)) ∧
          Trusted.MirSemantics.getElem? slots₂ scrGuard = some (.baseSlot (.live oG)) ∧
          (∀ j, j ≠ scrDiff → j ≠ scrGuard →
            Trusted.MirSemantics.getElem? slots₂ j =
              Trusted.MirSemantics.getElem? f.locals j)) ∧
      (wrappingRangeContains r bits = false →
        ∃ s₁ : EnumState,
          ReachesEnum p { frames := [f], callerMem := cm } s₁ ∧
          evalStepEnum p 0 s₁ = .fault .undefined)) := by
  let startC : Operand :=
    .constant { ty := .int tagW false, lit := .scalar (truncateBits tagW r.start) }
  let spanBits := subTruncBits tagW r.end_ r.start
  let spanC : Operand :=
    .constant { ty := .int tagW false, lit := .scalar spanBits }
  let pDiff : Place := { localId := scrDiff, projection := [] }
  let pGuard : Place := { localId := scrGuard, projection := [] }
  let st1 : EnumStmt := .baseStmt (.assign pDiff
    (.binaryOp .sub (.copy { localId := valLoc, projection := [] }) startC))
  let st2 : EnumStmt := .baseStmt (.assign pGuard
    (.binaryOp .subUnchecked spanC (.move pDiff)))
  have hStmts1 : bb.statements = pre ++ st1 :: (st2 :: post) := by
    rw [hStmts]
    dsimp [mkWrappingRangeCheckStmts, List.append]
    rw [List.append_assoc]
    rfl
  refine ⟨?_, ?_⟩
  · intro hValNone
    rw [stepAtStmt hB hBB hStmts1 hIdx]
    dsimp [st1, pDiff, startC]
    unfold evalEnumStmt evalEnumBaseRvalue evalEnumPrimitiveOperand evalEnumBaseOperandToSlot
    dsimp
    rw [hDeclDiff, hDeclVal, hValNone]
    rfl
  · intro bits hBitsFit hValSome
    have hRStartFit : truncateBits tagW r.start = r.start := by
      unfold wrappingRangeFitsWidth at hRFit
      exact eq_of_beq (bool_and_true hRFit).1
    have hStartFit : truncateBits tagW (truncateBits tagW r.start) = truncateBits tagW r.start :=
      truncateBits_idem tagW r.start
    have hSpanFit : truncateBits tagW spanBits = spanBits :=
      truncateBits_subTruncBits tagW r.end_ r.start
    let diffBits := subTruncBits tagW bits (truncateBits tagW r.start)
    have hDiffEq : diffBits = subTruncBits tagW bits r.start := by
      change subTruncBits tagW bits (truncateBits tagW r.start) = _
      rw [hRStartFit]
    have hDiffFit : truncateBits tagW diffBits = diffBits :=
      truncateBits_subTruncBits tagW bits _
    have hDiffLt : scrDiff < f.locals.length := getElem?_some_lt hSlotDiff
    let ⟨slots₁, hSet1⟩ := setElem?_some_of_lt f.locals scrDiff
      (.baseSlot (.live (some (.scalar ⟨tagW, false, diffBits⟩)))) hDiffLt
    have hStep1 : evalStepEnum p 0 { frames := [f], callerMem := cm } =
        .step { frames := [{ f with stmtIdx := pre.length + 1, locals := slots₁ }],
                callerMem := cm } := by
      rw [stepAtStmt hB hBB hStmts1 hIdx]
      dsimp [st1, pDiff, startC]
      unfold evalEnumStmt evalEnumBaseRvalue evalEnumPrimitiveOperand evalEnumBaseOperandToSlot writeEnumBasePlace
      dsimp
      rw [hDeclDiff, hDeclVal, hValSome]
      dsimp
      rw [isPrimitiveReadableTy_uint]
      dsimp
      rw [evalConstLit_uint_eq tagW _ hStartFit]
      dsimp
      rw [isPrimitiveReadableTy_uint]
      dsimp
      rw [evalBinOp_unsigned_sub_eq hBitsFit hStartFit]
      dsimp
      rw [checkVal_uint_of_fit tagW diffBits hDiffFit, hSlotDiff]
      dsimp
      rw [hSet1, hIdx]
    have hStmts2 : bb.statements = (pre ++ [st1]) ++ st2 :: post := by
      rw [hStmts1]
      change pre ++ ([st1] ++ st2 :: post) = _
      rw [← List.append_assoc]
    have hLenPre1 : (pre ++ [st1]).length = pre.length + 1 := by
      have hAppLen : ∀ (xs ys : List EnumStmt), (xs ++ ys).length = xs.length + ys.length := by
        intro xs ys
        induction xs with
        | nil => dsimp [List.length]; rw [Nat.zero_add]
        | cons _ _ ih => dsimp [List.length]; rw [Nat.succ_add, ih]
      exact hAppLen pre [st1]
    have hSlot1Diff : Trusted.MirSemantics.getElem? slots₁ scrDiff =
        some (.baseSlot (.live (some (.scalar ⟨tagW, false, diffBits⟩)))) :=
      setElem?_getElem?_same hSet1
    have hLen1 : slots₁.length = f.locals.length := setElem?_length hSet1
    let ⟨slots₁', hMove1⟩ := setElem?_some_of_lt slots₁ scrDiff
      (.baseSlot (.live none)) (by rw [hLen1]; exact hDiffLt)
    have hSlot1'Guard : Trusted.MirSemantics.getElem? slots₁' scrGuard =
        some (.baseSlot (.live optG)) := by
      rw [setElem?_getElem?_ne hMove1 hDiffNeGuard,
          setElem?_getElem?_ne hSet1 hDiffNeGuard]
      exact hSlotGuard
    refine ⟨?_, ?_⟩
    · intro hInR
      have hLeSpan : diffBits.toNat ≤ spanBits.toNat := by
        rw [hDiffEq]
        exact (wrappingRangeContains_iff_subTrunc_le hRFit hBitsFit).mp hInR
      have hGuardLt : scrGuard < slots₁'.length := getElem?_some_lt hSlot1'Guard
      let remVal : Val := .scalar ⟨tagW, false, BitVec.ofNat 128 (spanBits.toNat - diffBits.toNat)⟩
      have hRemFit : truncateBits tagW (BitVec.ofNat 128 (spanBits.toNat - diffBits.toNat)) =
          BitVec.ofNat 128 (spanBits.toNat - diffBits.toNat) := by
        have hSpanLt : spanBits.toNat < Nat.pow 2 tagW.bitWidth :=
          toNat_lt_of_truncateBits_eq hSpanFit
        have hSubLt : spanBits.toNat - diffBits.toNat < Nat.pow 2 tagW.bitWidth :=
          Nat.lt_of_le_of_lt (Nat.sub_le _ _) hSpanLt
        have hSub128 : spanBits.toNat - diffBits.toNat < Nat.pow 2 128 :=
          Nat.lt_of_lt_of_le hSubLt (intWidth_pow2_le_pow2_128 tagW)
        apply truncateBits_eq_of_toNat_lt
        rw [bitvec_ofNat_toNat, nat_mod_eq_of_lt hSub128]
        exact hSubLt
      let ⟨slots₂, hSet2⟩ := setElem?_some_of_lt slots₁' scrGuard
        (.baseSlot (.live (some remVal))) hGuardLt
      have hStep2 : evalStepEnum p 0
          { frames := [{ f with stmtIdx := pre.length + 1, locals := slots₁ }],
            callerMem := cm } =
          .step { frames := [{ f with stmtIdx := pre.length + 2, locals := slots₂ }],
                  callerMem := cm } := by
        rw [stepAtStmt (f := { f with stmtIdx := pre.length + 1, locals := slots₁ })
              hB hBB hStmts2 hLenPre1.symm]
        dsimp [st2, pGuard, spanC, pDiff]
        unfold evalEnumStmt evalEnumBaseRvalue evalEnumPrimitiveOperand evalEnumBaseOperandToSlot writeEnumBasePlace
        dsimp
        rw [hDeclGuard, evalConstLit_uint_eq tagW spanBits hSpanFit]
        dsimp
        rw [isPrimitiveReadableTy_uint]
        dsimp
        rw [hDeclDiff, hSlot1Diff]
        dsimp
        rw [liveUninitSlot_uint, hMove1]
        dsimp
        rw [isPrimitiveReadableTy_uint]
        dsimp
        rw [evalBinOp_unsigned_subUnchecked_ok hSpanFit hDiffFit hLeSpan]
        dsimp
        rw [checkVal_uint_of_fit tagW _ hRemFit, hSlot1'Guard]
        dsimp
        rw [hSet2]
      refine ⟨slots₂, none, some remVal,
        ReachesNEnum.succ hStep1 (ReachesNEnum.succ hStep2 (ReachesNEnum.zero _)),
        ?_, ?_, ?_, ?_⟩
      · rw [setElem?_length hSet2, setElem?_length hMove1, hLen1]
      · rw [setElem?_getElem?_ne hSet2 (fun h => hDiffNeGuard h.symm),
            setElem?_getElem?_same hMove1]
      · exact setElem?_getElem?_same hSet2
      · intro j hjDiff hjGuard
        rw [setElem?_getElem?_ne hSet2 hjGuard,
            setElem?_getElem?_ne hMove1 hjDiff,
            setElem?_getElem?_ne hSet1 hjDiff]
    · intro hOutR
      have hGtSpan : spanBits.toNat < diffBits.toNat := by
        rw [hDiffEq]
        exact (wrappingRangeContains_false_iff hRFit hBitsFit).mp hOutR
      have hStep2Fault : evalStepEnum p 0
          { frames := [{ f with stmtIdx := pre.length + 1, locals := slots₁ }],
            callerMem := cm } = .fault .undefined := by
        rw [stepAtStmt (f := { f with stmtIdx := pre.length + 1, locals := slots₁ })
              hB hBB hStmts2 hLenPre1.symm]
        dsimp [st2, pGuard, spanC, pDiff]
        unfold evalEnumStmt evalEnumBaseRvalue evalEnumPrimitiveOperand evalEnumBaseOperandToSlot
        dsimp
        rw [hDeclGuard, evalConstLit_uint_eq tagW spanBits hSpanFit]
        dsimp
        rw [isPrimitiveReadableTy_uint]
        dsimp
        rw [hDeclDiff, hSlot1Diff]
        dsimp
        rw [liveUninitSlot_uint, hMove1]
        dsimp
        rw [isPrimitiveReadableTy_uint]
        dsimp
        rw [evalBinOp_unsigned_subUnchecked_err hSpanFit hDiffFit hGtSpan]
      exact ⟨{ frames := [{ f with stmtIdx := pre.length + 1, locals := slots₁ }],
               callerMem := cm },
             c_reachesEnum_head_det hStep1 (ReachesEnum.refl _),
             hStep2Fault⟩

/-! ### 4. Direct-Tag `EnumTy` Round-Trip (`evalConstLit` <-> `Rvalue.discriminant`) -/

private theorem natNotElem_false_of_getElem? {x : Nat} :
    ∀ {ys : List Nat} {v : Nat},
      natNotElem x ys = true →
      Trusted.MirSemantics.getElem? ys v = some x →
      False
  | [], _, _, hg => by cases hg
  | y :: ys, 0, hNot, hg => by
    injection hg with heq; subst heq
    have hStep : natNotElem y (y :: ys) = (!Nat.beq y y && natNotElem y ys) := rfl
    rw [hStep, nat_beq_refl] at hNot
    cases hNot
  | y :: ys, _ + 1, hNot, hg => by
    have hStep : natNotElem x (y :: ys) = (!Nat.beq x y && natNotElem x ys) := rfl
    rw [hStep] at hNot
    exact natNotElem_false_of_getElem? (bool_and_true hNot).2 hg

private theorem findDiscrVariantAux_unique :
    ∀ {ds : List Nat} {idx v : Nat} {d : Nat},
      natListPairwiseNe ds = true →
      ds.all (fun x => Nat.blt x (Nat.pow 2 128)) = true →
      Trusted.MirSemantics.getElem? ds v = some d →
      findDiscrVariantAux idx (BitVec.ofNat 128 d) ds = some (idx + v)
  | [], _, _, _, _, _, hg => by cases hg
  | d₀ :: ds, idx, 0, _, _, _, hg => by
    injection hg with heq; subst heq
    have hStep : findDiscrVariantAux idx (BitVec.ofNat 128 d₀) (d₀ :: ds) =
        if BitVec.ofNat 128 d₀ == BitVec.ofNat 128 d₀ then some idx
        else findDiscrVariantAux (idx + 1) (BitVec.ofNat 128 d₀) ds := rfl
    rw [hStep, bitvec_beq_refl, Nat.add_zero]
    rfl
  | d₀ :: ds, idx, v + 1, d, hPw, hAll, hg => by
    have hPwStep : natListPairwiseNe (d₀ :: ds) = (natNotElem d₀ ds && natListPairwiseNe ds) := rfl
    rw [hPwStep] at hPw
    let ⟨hNotD0, hPwRest⟩ := bool_and_true hPw
    dsimp [List.all] at hAll
    let ⟨hD0LtB, hAllRest⟩ := bool_and_true hAll
    have hgRest : Trusted.MirSemantics.getElem? ds v = some d := hg
    have hDLtB : Nat.blt d (Nat.pow 2 128) = true :=
      list_all_getElem? (p := fun x => Nat.blt x (Nat.pow 2 128)) hAllRest hgRest
    have hD0Lt : d₀ < Nat.pow 2 128 := nat_blt_lt hD0LtB
    have hDLt : d < Nat.pow 2 128 := nat_blt_lt hDLtB
    have hBBeq : (BitVec.ofNat 128 d₀ == BitVec.ofNat 128 d) = false := by
      cases hb : (BitVec.ofNat 128 d₀ == BitVec.ofNat 128 d) with
      | false => rfl
      | true =>
        have hEqBv := eq_of_beq hb
        have hEqNat : d₀ = d := by
          have h1 := congrArg BitVec.toNat hEqBv
          rw [bitvec_ofNat_toNat, bitvec_ofNat_toNat,
              nat_mod_eq_of_lt hD0Lt, nat_mod_eq_of_lt hDLt] at h1
          exact h1
        subst hEqNat
        exact False.elim (natNotElem_false_of_getElem? hNotD0 hgRest)
    have hStep : findDiscrVariantAux idx (BitVec.ofNat 128 d) (d₀ :: ds) =
        if BitVec.ofNat 128 d₀ == BitVec.ofNat 128 d then some idx
        else findDiscrVariantAux (idx + 1) (BitVec.ofNat 128 d) ds := rfl
    rw [hStep, hBBeq]
    rw [if_false_of_not_prop (fun h => by cases h),
        findDiscrVariantAux_unique hPwRest hAllRest hgRest,
        Nat.add_assoc idx 1 v, Nat.add_comm 1 v]

private theorem directTagEnumTy_evalConstLit {ed : AdtEnumDef} {tagW : IntWidth} {tagS : Bool}
    {v : Nat} {vd : VariantDef}
    (hAdm : adtEnumDefAdmitted ed = true)
    (hLay : ed.layout = .direct tagW tagS)
    (hvGet : Trusted.MirSemantics.getElem? ed.variants v = some vd) :
    let ety := directTagEnumTy ed tagW tagS
    let tBits := truncateBits tagW (BitVec.ofNat 128 vd.discrVal)
    evalConstLit (.enum ety) (.scalar tBits) = .ok (.enumVal ety v) ∧
    checkVal (.enumVal ety v) (.enum ety) = true := by
  dsimp
  let ety := directTagEnumTy ed tagW tagS
  have hEtyAdm : enumAdmitted ety = true ∧
      ety.discriminants.all (fun d => Nat.blt d (Nat.pow 2 ed.discrWidth.bitWidth)) = true ∧
      natListPairwiseNe ety.discriminants = true := by
    unfold adtEnumDefAdmitted at hAdm
    rw [hLay] at hAdm
    dsimp at hAdm
    let ⟨h123, hEA⟩ := bool_and_true hAdm
    let ⟨h12, hDist⟩ := bool_and_true h123
    let ⟨_, hInR⟩ := bool_and_true h12
    exact ⟨hEA, hInR, hDist⟩
  let ⟨hEA, hInR, hDist⟩ := hEtyAdm
  have hDGet : Trusted.MirSemantics.getElem? ety.discriminants v = some vd.discrVal := by
    change Trusted.MirSemantics.getElem? (ed.variants.map (fun x => x.discrVal)) v = _
    rw [getElem?_map, hvGet]
  have hTagRT : tagBitsToDiscrBits tagW tagS ety.discrWidth
      (truncateBits tagW (BitVec.ofNat 128 vd.discrVal)) =
      BitVec.ofNat 128 vd.discrVal := by
    have hEADef : enumAdmitted ety =
        (!ety.discriminants.isEmpty &&
          Nat.blt ety.discriminants.length (Nat.pow 2 32) &&
          ety.discriminants.all (fun d => Nat.blt d (Nat.pow 2 ety.discrWidth.bitWidth)) &&
          natListPairwiseNe ety.discriminants &&
          ety.discriminants.all (fun d =>
            tagBitsToDiscrBits tagW tagS ety.discrWidth
              (truncateBits tagW (BitVec.ofNat 128 d)) == BitVec.ofNat 128 d)) := rfl
    have hEA' := hEA
    rw [hEADef] at hEA'
    let ⟨_, hAllRT⟩ := bool_and_true hEA'
    exact eq_of_beq (list_all_getElem?
      (p := fun d => tagBitsToDiscrBits tagW tagS ety.discrWidth
        (truncateBits tagW (BitVec.ofNat 128 d)) == BitVec.ofNat 128 d) hAllRT hDGet)
  have hAll128 : ety.discriminants.all (fun x => Nat.blt x (Nat.pow 2 128)) = true := by
    apply list_all_of_getElem?
    intro i x hx
    have hLtW := nat_blt_lt (list_all_getElem?
      (p := fun d => Nat.blt d (Nat.pow 2 ed.discrWidth.bitWidth)) hInR hx)
    exact nat_lt_blt (Nat.lt_of_lt_of_le hLtW (intWidth_pow2_le_pow2_128 ed.discrWidth))
  have hFind : findDiscrVariant? (BitVec.ofNat 128 vd.discrVal) ety.discriminants = some v := by
    change findDiscrVariantAux 0 _ _ = some v
    rw [findDiscrVariantAux_unique hDist hAll128 hDGet, Nat.zero_add]
  have hFitT : truncateBits tagW (truncateBits tagW (BitVec.ofNat 128 vd.discrVal)) =
      truncateBits tagW (BitVec.ofNat 128 vd.discrVal) := truncateBits_idem tagW _
  refine ⟨?_, ?_⟩
  · change (if !enumAdmitted ety ||
        (truncateBits tagW (truncateBits tagW (BitVec.ofNat 128 vd.discrVal)) !=
          truncateBits tagW (BitVec.ofNat 128 vd.discrVal)) then
        Except.error FaultKind.unsupported
      else
        match findDiscrVariant?
          (tagBitsToDiscrBits tagW tagS ety.discrWidth
            (truncateBits tagW (BitVec.ofNat 128 vd.discrVal)))
          ety.discriminants with
        | some v => Except.ok (Val.enumVal ety v)
        | none => Except.error FaultKind.undefined) = Except.ok (Val.enumVal ety v)
    rw [hEA, bitvec_bne_false_of_eq hFitT, hTagRT, hFind]
    rfl
  · have hEtyBeq : EnumTy.beq ety ety = true := enumTy_beq_refl ety
    have hvLt : Nat.blt v ety.discriminants.length = true :=
      nat_lt_blt (getElem?_some_lt hDGet)
    change (match (if enumAdmitted ety && Nat.blt v ety.discriminants.length
        then some (MirTy.enum ety) else none) with
      | some vTy => MirTy.beq vTy (MirTy.enum ety)
      | none => false) = true
    rw [hEA, hvLt]
    dsimp
    exact hEtyBeq

