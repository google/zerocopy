private theorem list_length_map {α β : Type} (f : α → β) :
    ∀ (xs : List α), (xs.map f).length = xs.length
  | [] => rfl
  | _ :: xs => congrArg Nat.succ (list_length_map f xs)

private theorem reachesBase_head_local {p : Program} {s₁ s₂ s₃ : State}
    (hStep : Step p s₁ (.step s₂)) (hRest : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction hRest with
  | refl => exact Reaches.tail (Reaches.refl s₁) hStep
  | tail _ hLast ih => exact Reaches.tail ih hLast

private theorem enumHasStorageAnnotation_embedBaseBody (b : Body) (idx : LocalId) :
    enumHasStorageAnnotation (embedBaseBody b) idx = hasStorageAnnotation b idx := by
  unfold enumHasStorageAnnotation hasStorageAnnotation embedBaseBody
  dsimp
  rw [list_any_map]
  exact congrArg b.basicBlocks.any (by
    funext bb
    unfold embedBaseBlock
    dsimp
    rw [list_any_map]
    rfl)

private theorem enumStorageAnnotationsInBounds_embedBaseBody (b : Body) :
    enumStorageAnnotationsInBounds (embedBaseBody b) =
      storageAnnotationsInBounds b := by
  unfold enumStorageAnnotationsInBounds storageAnnotationsInBounds embedBaseBody
  dsimp
  rw [list_length_map, list_all_map]
  exact congrArg b.basicBlocks.all (by
    funext bb
    unfold embedBaseBlock
    dsimp
    rw [list_all_map]
    exact congrArg bb.statements.all (by
      funext s
      cases s <;> rfl))

private theorem allEnumLocalsSupported_map_base (argCount : Nat) :
    ∀ (idx : Nat) (tys : List MirTy),
      allEnumLocalsSupported [] argCount idx (tys.map EnumLocalDecl.base) =
        tys.all isSupportedScalarOrUnitTy
  | _, [] => rfl
  | idx, ty :: rest => by
    dsimp [List.map, allEnumLocalsSupported, isSupportedEnumLocalDecl, List.all]
    rw [allEnumLocalsSupported_map_base argCount (idx + 1) rest]

private theorem listMapOption_map_base :
    ∀ (tys : List MirTy),
      listMapOption (fun d : EnumLocalDecl =>
        match d with | .base ty => some ty | _ => none)
        (tys.map EnumLocalDecl.base) = some tys
  | [] => rfl
  | ty :: rest => by
    dsimp [List.map, listMapOption]
    rw [listMapOption_map_base rest]

private theorem list_drop_map {α β : Type} (f : α → β) :
    ∀ (n : Nat) (xs : List α), (xs.map f).drop n = (xs.drop n).map f
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | n + 1, _ :: xs => list_drop_map f n xs

private theorem list_take_map {α β : Type} (f : α → β) :
    ∀ (n : Nat) (xs : List α), (xs.map f).take n = (xs.take n).map f
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | n + 1, x :: xs => by
    dsimp [List.map, List.take]
    rw [list_take_map f n xs]

private theorem enumParamBaseTys?_embedBaseBody (b : Body) :
    enumParamBaseTys? (embedBaseBody b) =
      some ((b.locals.drop 1).take b.argumentCount) := by
  unfold enumParamBaseTys? embedBaseBody
  dsimp
  rw [list_drop_map, list_take_map]
  exact listMapOption_map_base ((b.locals.drop 1).take b.argumentCount)

private theorem initEnumLocalsLoop_embedBaseBody (b : Body) (args : List Val) :
    ∀ (idx : Nat) (tys : List MirTy),
      initEnumLocalsLoop [] (embedBaseBody b) args idx (tys.map EnumLocalDecl.base) =
        some ((initLocalsLoop b args idx tys).map EnumSlot.baseSlot)
  | _, [] => rfl
  | idx, ty :: rest => by
    unfold initEnumLocalsLoop
    have hRhs :
        initLocalsLoop b args idx (ty :: rest) =
          (if Nat.beq idx 0 then
            liveUninitSlot ty
          else if Nat.ble idx b.argumentCount then
            match Trusted.MirSemantics.getElem? args (idx - 1) with
            | some v => .live (some v)
            | none => .dead
          else if hasStorageAnnotation b idx then
            .dead
          else
            liveUninitSlot ty) :: initLocalsLoop b args (idx + 1) rest := rfl
    rw [hRhs]
    dsimp [List.map]
    rw [initEnumLocalsLoop_embedBaseBody b args (idx + 1) rest]
    rw [enumHasStorageAnnotation_embedBaseBody]
    have hArg : (embedBaseBody b).argumentCount = b.argumentCount := rfl
    rw [hArg]
    cases Nat.beq idx 0 with
    | true => rfl
    | false =>
      dsimp
      cases Nat.ble idx b.argumentCount with
      | true =>
        dsimp
        cases Trusted.MirSemantics.getElem? args (idx - 1) <;> rfl
      | false =>
        dsimp
        cases hasStorageAnnotation b idx <;> rfl

/-! ### Exact 1-Step Lockstep of `evalEnumBaseOperandToSlot`, `evalEnumBaseRvalue`, `writeEnumBasePlace`, `evalEnumStmt`, `evalEnumTerminator`, & `evalStepEnum` -/

private theorem evalEnumBaseOperandToSlot_map_base (tys : List MirTy)
    (slots : List LocalSlot) (op : Operand) :
    evalEnumBaseOperandToSlot (tys.map EnumLocalDecl.base)
        (slots.map EnumSlot.baseSlot) op =
      match evalOperandToSlot tys slots op with
      | .error k => .error k
      | .ok (ty, optVal, slots') =>
        .ok (ty, optVal, slots'.map EnumSlot.baseSlot) := by
  cases op with
  | copy place =>
    unfold evalEnumBaseOperandToSlot evalOperandToSlot
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases Trusted.MirSemantics.getElem? slots place.localId with
        | none => rfl
        | some sl => cases sl <;> rfl
  | move place =>
    unfold evalEnumBaseOperandToSlot evalOperandToSlot
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases Trusted.MirSemantics.getElem? slots place.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | live optVal =>
            dsimp
            rw [setElem?_map EnumSlot.baseSlot slots place.localId (liveUninitSlot ty)]
            cases setElem? slots place.localId (liveUninitSlot ty) <;> rfl
  | constant c =>
    unfold evalEnumBaseOperandToSlot evalOperandToSlot
    dsimp
    cases evalConstLit c.ty c.lit <;> rfl

private theorem evalEnumPrimitiveOperand_map_base (tys : List MirTy)
    (slots : List LocalSlot) (op : Operand) :
    evalEnumPrimitiveOperand (tys.map EnumLocalDecl.base)
        (slots.map EnumSlot.baseSlot) op =
      match evalPrimitiveOperand tys slots op with
      | .error k => .error k
      | .ok (v, slots') => .ok (v, slots'.map EnumSlot.baseSlot) := by
  unfold evalEnumPrimitiveOperand evalPrimitiveOperand
  rw [evalEnumBaseOperandToSlot_map_base]
  cases evalOperandToSlot tys slots op with
  | error _ => rfl
  | ok triple =>
    cases triple with
    | mk ty rest =>
      cases rest with
      | mk optVal slots' =>
        dsimp
        cases isPrimitiveReadableTy ty with
        | false => rfl
        | true => cases optVal <;> rfl

private theorem evalEnumBaseRvalue_map_base (tys : List MirTy)
    (slots : List LocalSlot) (dstTy : MirTy) (rv : Rvalue) :
    evalEnumBaseRvalue (tys.map EnumLocalDecl.base)
        (slots.map EnumSlot.baseSlot) dstTy rv =
      match evalRvalue tys slots dstTy rv with
      | .error k => .error k
      | .ok (v, slots') => .ok (v, slots'.map EnumSlot.baseSlot) := by
  cases rv with
  | use opnd =>
    unfold evalEnumBaseRvalue evalRvalue
    dsimp
    rw [evalEnumBaseOperandToSlot_map_base]
    cases evalOperandToSlot tys slots opnd with
    | error _ => rfl
    | ok triple =>
      cases triple with
      | mk srcTy rest =>
        cases rest with
        | mk optVal slots₁ =>
          dsimp
          cases MirTy.beq srcTy dstTy with
          | false => rfl
          | true => cases optVal <;> rfl
  | binaryOp op lhs rhs =>
    unfold evalEnumBaseRvalue evalRvalue
    dsimp
    rw [evalEnumPrimitiveOperand_map_base]
    cases evalPrimitiveOperand tys slots lhs with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk lVal locals₁ =>
        dsimp
        rw [evalEnumPrimitiveOperand_map_base]
        cases evalPrimitiveOperand tys locals₁ rhs with
        | error _ => rfl
        | ok p2 =>
          cases p2 with
          | mk rVal locals₂ =>
            dsimp
            cases evalBinOp op lVal rVal <;> rfl
  | unaryOp op opnd =>
    unfold evalEnumBaseRvalue evalRvalue
    dsimp
    rw [evalEnumPrimitiveOperand_map_base]
    cases evalPrimitiveOperand tys slots opnd with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk v locals₁ =>
        dsimp
        cases evalUnOp op v <;> rfl
  | discriminant place =>
    unfold evalEnumBaseRvalue evalRvalue
    dsimp
    cases place.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map, getElem?_map]
      cases Trusted.MirSemantics.getElem? tys place.localId with
      | none => rfl
      | some ty =>
        cases ty with
        | bool | int _ _ | unit | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported => rfl
        | enum ety =>
          cases Trusted.MirSemantics.getElem? slots place.localId with
          | none => rfl
          | some slot =>
            dsimp
            cases hAdm : enumAdmitted ety with
            | false => rfl
            | true =>
              dsimp
              cases ety with
              | mk eid edw eds etr ediscs =>
                dsimp
                cases etr with
                | zeroSized =>
                  cases slot with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none =>
                      dsimp
                      cases Trusted.MirSemantics.getElem? ediscs 0 <;> rfl
                    | some val =>
                      cases val with
                      | bool _ | scalar _ | unit | ptr _ | tuple _ | bytes _ => rfl
                      | enumVal ety' v =>
                        dsimp
                        cases (EnumTy.beq ⟨eid, edw, eds, .zeroSized, ediscs⟩ ety' && Nat.beq v 0) with
                        | false => rfl
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? ediscs 0 <;> rfl
                | scalar tw ts =>
                  cases slot with
                  | dead => rfl
                  | live ov =>
                    cases ov with
                    | none => rfl
                    | some val =>
                      cases val with
                      | bool _ | scalar _ | unit | ptr _ | tuple _ | bytes _ => rfl
                      | enumVal ety' v =>
                        dsimp
                        cases (EnumTy.beq ⟨eid, edw, eds, .scalar tw ts, ediscs⟩ ety' &&
                            Nat.blt v ediscs.length) with
                        | false => rfl
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem? ediscs v <;> rfl
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported => rfl

private theorem writeEnumBasePlace_map_base (slots : List LocalSlot)
    (dstLocalId : LocalId) (dstTy : MirTy) (val : Val) :
    writeEnumBasePlace (slots.map EnumSlot.baseSlot) dstLocalId dstTy val =
      match writePlace slots dstLocalId dstTy val with
      | .error k => .error k
      | .ok slots' => .ok (slots'.map EnumSlot.baseSlot) := by
  unfold writeEnumBasePlace writePlace
  cases checkVal val dstTy with
  | false => rfl
  | true =>
    dsimp
    rw [getElem?_map]
    cases Trusted.MirSemantics.getElem? slots dstLocalId with
    | none => rfl
    | some sl =>
      cases sl with
      | dead => rfl
      | live _ =>
        dsimp
        rw [setElem?_map EnumSlot.baseSlot slots dstLocalId (.live (some val))]
        cases setElem? slots dstLocalId (.live (some val)) <;> rfl

private theorem evalEnumStmt_embedBase (body : Body) (frame : FrameState)
    (callerMem : CallerMemory) (stmt : StatementKind) :
    evalEnumStmt [] (embedBaseBody body) (embedEnumFrame frame) callerMem
        (.baseStmt stmt) =
      liftStepResultEnum (evalStatement body frame callerMem stmt) := by
  cases stmt with
  | nop => rfl
  | unsupported => rfl
  | storageLive localId =>
    unfold evalEnumStmt evalStatement embedBaseBody embedEnumFrame
    dsimp
    rw [getElem?_map]
    cases Trusted.MirSemantics.getElem? body.locals localId with
    | none => rfl
    | some localTy =>
      dsimp [liveUninitEnumSlot]
      rw [setElem?_map EnumSlot.baseSlot frame.locals localId (liveUninitSlot localTy)]
      cases setElem? frame.locals localId (liveUninitSlot localTy) <;> rfl
  | storageDead localId =>
    unfold evalEnumStmt evalStatement embedBaseBody embedEnumFrame
    dsimp
    cases Nat.beq localId 0 with
    | true => rfl
    | false =>
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? body.locals localId with
      | none =>
        dsimp
        rw [setElem?_map EnumSlot.baseSlot frame.locals localId .dead]
        cases setElem? frame.locals localId .dead <;> rfl
      | some _ =>
        dsimp
        rw [setElem?_map EnumSlot.baseSlot frame.locals localId .dead]
        cases setElem? frame.locals localId .dead <;> rfl
  | assign dst rvalue =>
    unfold evalEnumStmt evalStatement embedBaseBody embedEnumFrame
    dsimp
    cases dst.projection.isEmpty with
    | false => rfl
    | true =>
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? body.locals dst.localId with
      | none => rfl
      | some dstTy =>
        dsimp
        rw [evalEnumBaseRvalue_map_base]
        cases evalRvalue body.locals frame.locals dstTy rvalue with
        | error _ => rfl
        | ok p1 =>
          cases p1 with
          | mk val localsAfterRval =>
            dsimp
            rw [writeEnumBasePlace_map_base]
            cases writePlace localsAfterRval dst.localId dstTy val <;> rfl

private theorem evalEnumTerminator_embedBase (body : Body) (bb : BasicBlock)
    (frame : FrameState) (callerMem : CallerMemory) :
    evalEnumTerminator [] (embedBaseBody body) (embedBaseBlock bb)
        (embedEnumFrame frame) callerMem =
      liftStepResultEnum (evalTerminator body bb frame callerMem) := by
  unfold evalEnumTerminator evalTerminator embedBaseBody embedBaseBlock embedEnumFrame
  dsimp
  cases bb.terminator with
  | goto _ => rfl
  | return_ =>
    dsimp
    cases bb.cleanup with
    | true => rfl
    | false =>
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? frame.locals 0 with
      | none => rfl
      | some sl =>
        cases sl with
        | dead => rfl
        | live ov => cases ov <;> rfl
  | unreachable => rfl
  | switchInt discr targets =>
    dsimp
    rw [evalEnumPrimitiveOperand_map_base]
    cases evalPrimitiveOperand body.locals frame.locals discr with
    | error _ => rfl
    | ok p1 =>
      cases p1 with
      | mk discrVal localsAfterDiscr =>
        dsimp
        cases discrVal with
        | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => rfl
        | scalar sv =>
          dsimp
          cases evalSwitchBranches sv.width sv.bits targets.otherwise targets.branches <;> rfl
        | bool b =>
          dsimp
          cases evalBoolSwitchBranches b targets.otherwise targets.branches <;> rfl
  | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _ | unsupported => rfl

private theorem evalStepEnum_embedBaseProgram (p : Program) (c : Choice) (s : State) :
    evalStepEnum (embedBaseProgram p) c (embedEnumState s) =
      liftStepResultEnum (evalStep p c s) := by
  cases s with
  | mk frames callerMem =>
    cases frames with
    | nil => rfl
    | cons frame rest =>
      cases rest with
      | cons _ _ => rfl
      | nil =>
        unfold evalStepEnum evalStep embedBaseProgram embedEnumState
        dsimp [List.map, embedEnumFrame]
        rw [getElem?_map]
        cases Trusted.MirSemantics.getElem? p.bodies frame.defId with
        | none => rfl
        | some body =>
          dsimp
          unfold embedBaseBody
          dsimp
          rw [getElem?_map]
          cases Trusted.MirSemantics.getElem? body.basicBlocks frame.blockIdx with
          | none => rfl
          | some bb =>
            dsimp
            unfold embedBaseBlock
            dsimp
            rw [getElem?_map]
            cases Trusted.MirSemantics.getElem? bb.statements frame.stmtIdx with
            | some st =>
              dsimp
              exact evalEnumStmt_embedBase body frame callerMem st
            | none =>
              dsimp
              rw [list_length_map EnumStmt.baseStmt bb.statements]
              cases Nat.beq frame.stmtIdx bb.statements.length with
              | false => rfl
              | true =>
                dsimp
                exact evalEnumTerminator_embedBase body bb frame callerMem

private theorem initStateEnum_embedBaseProgram_clean (p : Program) (q : Query) :
    initStateEnum (embedBaseProgram p) q =
      match initState p q with
      | .error k => .error k
      | .ok s₀ => .ok (embedEnumState s₀) := by
  unfold initStateEnum initState embedBaseProgram
  dsimp
  cases (!Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1) with
  | true => rfl
  | false =>
    dsimp
    cases q.callerMem.allocations.isEmpty with
    | false => rfl
    | true =>
      dsimp [List.all]
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
      | none => rfl
      | some body =>
        dsimp
        have hBbsEmpty : (embedBaseBody body).basicBlocks.isEmpty = body.basicBlocks.isEmpty := by
          unfold embedBaseBody
          cases body.basicBlocks <;> rfl
        have hLocLen : (embedBaseBody body).locals.length = body.locals.length := by
          unfold embedBaseBody
          exact list_length_map EnumLocalDecl.base body.locals
        rw [hBbsEmpty, hLocLen,
            enumStorageAnnotationsInBounds_embedBaseBody,
            enumParamBaseTys?_embedBaseBody]
        have hArgEq : (embedBaseBody body).argumentCount = body.argumentCount := rfl
        rw [hArgEq]
        have hSup :
            allEnumLocalsSupported [] body.argumentCount 0 (embedBaseBody body).locals =
              body.locals.all isSupportedScalarOrUnitTy :=
          allEnumLocalsSupported_map_base body.argumentCount 0 body.locals
        rw [hSup]
        cases body.basicBlocks.isEmpty with
        | true => rfl
        | false =>
          dsimp
          cases Nat.blt body.argumentCount body.locals.length with
          | false => rfl
          | true =>
            dsimp
            cases storageAnnotationsInBounds body with
            | false => rfl
            | true =>
              dsimp
              cases body.locals.all isSupportedScalarOrUnitTy with
              | false => rfl
              | true =>
                dsimp
                cases checkArgsMatch q.args ((body.locals.drop 1).take body.argumentCount) with
                | false => rfl
                | true =>
                  dsimp
                  have hLoop :
                      initEnumLocalsLoop [] (embedBaseBody body) q.args 0 (embedBaseBody body).locals =
                        some ((initLocalsLoop body q.args 0 body.locals).map EnumSlot.baseSlot) :=
                    initEnumLocalsLoop_embedBaseBody body q.args 0 body.locals
                  rw [hLoop]
                  rfl

private theorem reachesNEnum_embed_reflect (p : Program) :
    ∀ {n : Nat} {s₁ : State} {e₂ : EnumState},
      ReachesNEnum (embedBaseProgram p) n (embedEnumState s₁) e₂ →
      ∃ s₂ : State, e₂ = embedEnumState s₂ ∧ Reaches p s₁ s₂
  | 0, s₁, _, .zero _ => ⟨s₁, rfl, Reaches.refl s₁⟩
  | _ + 1, s₁, _, .succ hEvE hRest => by
    have hLock := evalStepEnum_embedBaseProgram p 0 s₁
    rw [hLock] at hEvE
    cases hEvB : evalStep p 0 s₁ with
    | fault _ => rw [hEvB] at hEvE; cases hEvE
    | done _ => rw [hEvB] at hEvE; cases hEvE
    | step sMid =>
      rw [hEvB] at hEvE
      dsimp [liftStepResultEnum] at hEvE
      injection hEvE with hEqMid
      rw [← hEqMid] at hRest
      let ⟨s₂, hEq2, hRRest⟩ := reachesNEnum_embed_reflect p hRest
      exact ⟨s₂, hEq2, reachesBase_head_local ⟨0, rfl, hEvB⟩ hRRest⟩

private theorem reaches_embed_fwd (p : Program) {s₀ s : State}
    (hRB : Reaches p s₀ s) :
    ReachesEnum (embedBaseProgram p) (embedEnumState s₀) (embedEnumState s) := by
  induction hRB with
  | refl => exact ReachesEnum.refl _
  | @tail sMid _ _ hSt ih =>
    let ⟨c', _, hEv'⟩ := hSt
    rw [evalStepBase_choice_irrel p c'] at hEv'
    have hEvE' := evalStepEnum_embedBaseProgram p 0 sMid
    rw [hEv'] at hEvE'
    exact ReachesEnum.tail ih ⟨0, rfl, hEvE'⟩

private theorem reachesResultEnum_embed_iff (p : Program) (q : Query)
    (rB : StepResult State TerminalOut)
    (hNoStep : ∀ x, rB ≠ .step x) :
    ReachesResultEnum (embedBaseProgram p) q (liftStepResultEnum rB) ↔
      ReachesResult p q rB := by
  unfold ReachesResultEnum ReachesResult
  rw [initStateEnum_embedBaseProgram_clean]
  cases initState p q with
  | error k =>
    dsimp
    cases rB with
    | step x => exact False.elim (hNoStep x rfl)
    | done _ =>
      dsimp [liftStepResultEnum]
      constructor
      · intro h; cases h
      · intro h; cases h
    | fault fk =>
      dsimp [liftStepResultEnum]
      constructor
      · intro h; injection h with heq; exact congrArg StepResult.fault heq
      · intro h; injection h with heq; exact congrArg StepResult.fault heq
  | ok s₀ =>
    dsimp
    constructor
    · intro ⟨e, hRE, ⟨c, hc, hEvE⟩⟩
      cases hc
      let ⟨n, hn⟩ := reachesEnum_to_reachesNEnum hRE
      let ⟨s, hEqS, hRB⟩ := reachesNEnum_embed_reflect p hn
      subst hEqS
      rw [evalStepEnum_embedBaseProgram] at hEvE
      refine ⟨s, hRB, ⟨0, rfl, ?_⟩⟩
      cases hB : evalStep p 0 s <;> rw [hB] at hEvE <;> cases rB <;> (first
        | exact False.elim (hNoStep _ rfl)
        | (cases hEvE <;> rfl))
    · intro ⟨s, hRB, ⟨c, _, hEvB⟩⟩
      rw [evalStepBase_choice_irrel p c] at hEvB
      have hEvE := evalStepEnum_embedBaseProgram p 0 s
      rw [hEvB] at hEvE
      exact ⟨embedEnumState s, reaches_embed_fwd p hRB, ⟨0, rfl, hEvE⟩⟩

/-! ### `unembedBaseProgram` Exact Inverse (`pFlat = embedBaseProgram pOut`) -/

private theorem unembed_block_match_inv {stmts? : Option (List StatementKind)}
    {termE : EnumTerminator} {clE : Bool} {bbB : BasicBlock}
    (h : (match stmts?, termE with
          | some stmts, .baseTerm t =>
            some { statements := stmts, terminator := t, cleanup := clE }
          | _, _ => none) = some bbB) :
    ∃ stmts t, stmts? = some stmts ∧ termE = .baseTerm t ∧
      bbB = { statements := stmts, terminator := t, cleanup := clE } := by
  cases stmts? with
  | none => cases termE <;> cases h
  | some stmts =>
    cases termE with
    | switchDiscr _ _ _ => cases h
    | baseTerm t =>
      injection h with heq
      exact ⟨stmts, t, rfl, rfl, heq.symm⟩

private theorem unembed_body_match_inv {ac : Nat} {u : Bool} {idS : String}
    {tys? : Option (List MirTy)} {bbs? : Option (List BasicBlock)} {bB : Body}
    (h : (match tys?, bbs? with
          | some tys, some bbs =>
            some { argumentCount := ac, locals := tys, basicBlocks := bbs,
                   isUnsafe := u, identity := idS }
          | _, _ => none) = some bB) :
    ∃ tys bbs, tys? = some tys ∧ bbs? = some bbs ∧
      bB = { argumentCount := ac, locals := tys, basicBlocks := bbs,
             isUnsafe := u, identity := idS } := by
  cases tys? with
  | none => cases bbs? <;> cases h
  | some tys =>
    cases bbs? with
    | none => cases h
    | some bbs =>
      injection h with heq
      exact ⟨tys, bbs, rfl, rfl, heq.symm⟩

private theorem unembedBaseBlock_eq_embed {bbE : EnumBlock} {bbB : BasicBlock}
    (h : unembedBaseBlock bbE = some bbB) :
    bbE = embedBaseBlock bbB := by
  cases bbE with
  | mk stmtsE termE clE =>
    unfold unembedBaseBlock at h
    dsimp at h
    let ⟨stmtsB, t, hMap, hTerm, hBbEq⟩ := unembed_block_match_inv h
    rw [hTerm, hBbEq]
    unfold embedBaseBlock
    dsimp
    have hStEq : stmtsE = stmtsB.map EnumStmt.baseStmt :=
      listMapOption_to_embed EnumStmt.baseStmt _
        (fun {x y} hx => by cases x <;> cases hx <;> rfl)
        hMap
    rw [hStEq]

private theorem unembedBaseBody_eq_embed {bE : EnumBody} {bB : Body}
    (h : unembedBaseBody bE = some bB) :
    bE = embedBaseBody bB := by
  cases bE with
  | mk ac lE bbE u idS =>
    unfold unembedBaseBody at h
    dsimp at h
    let ⟨tys, bbs, hLoc, hBB, hBEq⟩ := unembed_body_match_inv h
    rw [hBEq]
    unfold embedBaseBody
    dsimp
    have hLocEq : lE = tys.map EnumLocalDecl.base :=
      listMapOption_to_embed EnumLocalDecl.base _
        (fun {x y} hx => by cases x <;> cases hx <;> rfl)
        hLoc
    have hBBEq : bbE = bbs.map embedBaseBlock :=
      listMapOption_to_embed embedBaseBlock unembedBaseBlock
        (fun {x y} hx => unembedBaseBlock_eq_embed hx) hBB
    rw [hLocEq, hBBEq]

private theorem unembedBaseProgram_eq_embed {pFlat : EnumProgram} {pOut : Program}
    (h : unembedBaseProgram pFlat = some pOut) :
    pFlat = embedBaseProgram pOut := by
  cases pFlat with
  | mk eds bs e pw v sc =>
    unfold unembedBaseProgram at h
    cases eds with
    | cons _ _ =>
      dsimp [List.isEmpty] at h
      cases h
    | nil =>
      dsimp [List.isEmpty] at h
      cases hBs : listMapOption unembedBaseBody bs with
      | none => rw [hBs] at h; cases h
      | some bsOut =>
        rw [hBs] at h
        dsimp at h
        injection h with hEq
        rw [← hEq]
        unfold embedBaseProgram
        dsimp
        have hBsEq : bs = bsOut.map embedBaseBody :=
          listMapOption_to_embed embedBaseBody unembedBaseBody
            (fun {x y} hx => unembedBaseBody_eq_embed hx) hBs
        rw [hBsEq]

private theorem enum_conservative_extension_exact_slice1
    (p : Program) :
    (∀ (c : Choice) (s : State),
      evalStepEnum (embedBaseProgram p) c (embedEnumState s) =
        liftStepResultEnum (evalStep p c s)) ∧
    (∀ q : Query,
      (WellFormedEnum (embedBaseProgram p) q ↔ WellFormed p q) ∧
      (∀ out : TerminalOut,
        BehaviorEnum (embedBaseProgram p) q out ↔ Behavior p q out) ∧
      (∀ k : FaultKind,
        ReachesResultEnum (embedBaseProgram p) q (.fault k) ↔
          ReachesResult p q (.fault k)) ∧
      (DivergesEnum (embedBaseProgram p) q ↔ Diverges p q) ∧
      (∀ post : TerminalOut → Prop,
        SatisfiesPostEnum (embedBaseProgram p) q post ↔
          SatisfiesPost p q post)) := by
  refine ⟨evalStepEnum_embedBaseProgram p, ?_⟩
  have hFault : ∀ q k,
      ReachesResultEnum (embedBaseProgram p) q (.fault k) ↔
        ReachesResult p q (.fault k) :=
    fun q k => reachesResultEnum_embed_iff p q (.fault k) (fun _ h => by cases h)
  have hBeh : ∀ q out,
      BehaviorEnum (embedBaseProgram p) q out ↔ Behavior p q out :=
    fun q out => reachesResultEnum_embed_iff p q (.done out) (fun _ h => by cases h)
  have hAll := equivEnumToBase_of_outcomes hFault hBeh
  intro q
  exact ⟨hAll.1 q, hAll.2.1 q, hAll.2.2.1 q, hAll.2.2.2.1 q, hAll.2.2.2.2 q⟩

