// MIR for `const_extract_both` before RemoveUninitDrops

fn const_extract_both(_1: PackedPair) -> (NonCopy, NonCopy) {
    debug p => _1;
    let mut _0: (NonCopy, NonCopy);
    let mut _2: NonCopy;
    let mut _3: NonCopy;

    bb0: {
        StorageLive(_2);
        _2 = move (_1.1: NonCopy);
        StorageLive(_3);
        _3 = move (_1.2: NonCopy);
        _0 = (move _2, move _3);
        drop(_3) -> [return: bb1, unwind: bb4];
    }

    bb1: {
        StorageDead(_3);
        drop(_2) -> [return: bb2, unwind: bb5];
    }

    bb2: {
        StorageDead(_2);
        drop(_1) -> [return: bb3, unwind continue];
    }

    bb3: {
        return;
    }

    bb4 (cleanup): {
        drop(_2) -> [return: bb5, unwind terminate(cleanup)];
    }

    bb5 (cleanup): {
        drop(_1) -> [return: bb6, unwind terminate(cleanup)];
    }

    bb6 (cleanup): {
        resume;
    }
}
