i148_corpus.pair_sum (pair : i148_corpus.Pair) : Aeneas.Std.Result Aeneas.Std.U32
i148_corpus.make_pair (x y : Aeneas.Std.U32) : Aeneas.Std.Result i148_corpus.Pair
