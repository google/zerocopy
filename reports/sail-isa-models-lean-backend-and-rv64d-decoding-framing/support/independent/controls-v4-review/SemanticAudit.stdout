theorem AnnealSail.Controls.add_missing_x1 : ∀ (s : SequentialState RegisterType),
  s.regs.get? Register.x1 = none →
    EStateM.run
        (interpretSailEffects
          (Functions.execute (instruction.RTYPE (regidx.Regidx 2, regidx.Regidx 1, regidx.Regidx 3, rop.ADD))))
        s =
      EStateM.Result.error Sail.Error.Unreachable s :=
fun s h1 =>
  Eq.mpr
    (id
      (congrArg (fun _a => EStateM.run (interpretSailEffects _a) s = EStateM.Result.error Sail.Error.Unreachable s)
        execute_add_effects))
    (of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg Eq
            (congrArg
              (fun x =>
                match
                  (match x with
                    | some s => pure s
                    | x => throw Sail.Error.Unreachable)
                    s with
                | EStateM.Result.ok a s =>
                  (fun res =>
                      FreeM.liftM
                        (fun x =>
                          match x with
                          | Sum.inl (Except.error err) => throw err
                          | Sum.inl (Except.ok eff) => interpretInstructionEffect eff
                          | Sum.inr choice =>
                            let c := choice;
                            if h : 0 < c then pure ⟨0, h⟩ else throw Sail.Error.Unreachable)
                        ((fun a =>
