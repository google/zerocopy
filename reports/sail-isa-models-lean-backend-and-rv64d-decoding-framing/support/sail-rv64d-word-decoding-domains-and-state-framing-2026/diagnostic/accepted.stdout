AnnealSail.ByteDiagnostic.enabled_cfilp :
  Functions.currentlyEnabled extension.Ext_Zicfilp =
    have this := do
      let priv ← readReg Register.cur_privilege
      let lpe ← Functions.get_xLPE priv
      pure (true && (true && lpe));
    this
