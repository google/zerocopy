+fn llvm_backend() -> rustc_codegen_llvm::LlvmCodegenBackend {
+    // LlvmCodegenBackend is a zero-sized struct `LlvmCodegenBackend(())`.
+    unsafe { std::mem::zeroed() }
+}
+
+fn should_route_to_llvm(tcx: Option<TyCtxt<'_>>, cgu_name: &str) -> bool {
+    let policy = std::env::var("AN_COMPOSITE_ROUTE").unwrap_or_else(|_| "alternating".to_string());
+    if policy == "all_llvm" {
+        return true;
+    } else if policy == "all_clif" {
+        return false;
+    } else if let Some(substr) = policy.strip_prefix("llvm_if:") {
+        if let Some(tcx) = tcx {
+            let cgu = tcx.codegen_unit(Symbol::intern(cgu_name));
+            return cgu.items().keys().any(|item| item.symbol_name(tcx).name.contains(substr));
+        }
+        return cgu_name.contains(substr);
+    } else if let Some(substr) = policy.strip_prefix("clif_if:") {
+        if let Some(tcx) = tcx {
+            let cgu = tcx.codegen_unit(Symbol::intern(cgu_name));
+            return !cgu.items().keys().any(|item| item.symbol_name(tcx).name.contains(substr));
+        }
+        return !cgu_name.contains(substr);
+    } else if let Some(seed_str) = policy.strip_prefix("hash:") {
+        let seed: u64 = seed_str.parse().unwrap_or(0);
+        use std::hash::{Hash, Hasher};
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        seed.hash(&mut h);
+        cgu_name.hash(&mut h);
+        return (h.finish() & 1) == 0;
+    }
+    let sum: usize = cgu_name.bytes().map(|b| b as usize).sum();
+    (sum % 2) == 0
+}
