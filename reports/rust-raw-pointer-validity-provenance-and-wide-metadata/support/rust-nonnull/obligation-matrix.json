  "operations": [
    {
      "operation": "NonNull::new(raw)",
      "establishes": [
        "result is None or a NonNull value whose raw pointer is non-null"
      ],
      "does_not_establish": [
        "dereferenceability",
        "alignment for T",
        "live allocation",
        "usable provenance",
        "initialized T",
        "aliasing/exclusive ownership"
      ]
    },
    {
      "operation": "NonNull::new_unchecked(raw)",
      "requires": [
        "raw pointer is non-null"
      ],
      "establishes": [
        "NonNull non-null value invariant"
      ],
      "does_not_establish": [
        "other access/reference obligations"
      ]
    },
    {
      "operation": "NonNull::dangling()",
      "establishes": [
        "non-null",
        "well-aligned address for sized T"
      ],
      "explicitly_does_not_establish": [
        "live allocation",
        "dereferenceability",
        "unique sentinel identity",
        "ordinary access provenance"
      ]
    },
    {
      "operation": "NonNull::without_provenance(nonzero_addr)",
      "requires": [
        "non-zero numeric address"
      ],
      "establishes": [
        "non-null pointer value at that address",
        "absent provenance"
      ],
      "does_not_establish": [
        "ordinary non-zero-sized memory access authority"
      ]
    },
    {
      "operation": "addr",
      "requires": [
        "valid NonNull value"
