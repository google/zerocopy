@wpi_adequate
     : ∀ (Σ : gFunctors) (E : Type → Type) (R : Type) (hlc : has_lc) (invGS_gen0 : invGS_gen hlc Σ) 
         (Φ : R → iProp Σ) (H : handler.iHandler Σ E) (EH : eHandler E E R) (A : eHandlerAdequate H EH) 
         (t : ITreeDefinition.itree E R) (s : eh_state EH) (C : ITreeDefinition.itree E R → eh_state EH → Prop) 
         (m : coPset),
         exec EH t s C
         → wpi.wpi_mask m t (λ v : R, Φ v) -∗
           ehandler_inv s [] ={m,∅}=∗
           ∃ (t' : ITreeDefinition.itree E R) (s' : eh_state EH) (Ms' : list
                                                                          ((ITreeDefinition.itree E R → iProp Σ)
                                                                           → iProp Σ)) (M' : 
                                                                                        (ITreeDefinition.itree E R
                                                                                         → 
                                                                                         iPropI Σ) → 
                                                                                        iPropI Σ), ⌜
             C t' s'⌝ ∗ ehandler_inv s' Ms' ∗
             bi_close (Eqit.eutt eq)
               (λ t'0 : ITreeDefinition.itree E R, ∀ P : ITreeDefinition.itree E R → iPropI Σ, M' P ={∅}=∗ P t'0) t' ∗
             WPi_tp M' :: Ms' @ H {{ v, |={∅,m}=> Φ v }}
