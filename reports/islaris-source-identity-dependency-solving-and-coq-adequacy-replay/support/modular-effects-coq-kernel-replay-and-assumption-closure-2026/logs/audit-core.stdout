@threadpool_adequacy
     : ∀ (Σ : gFunctors) (R : Type) (E : Type → Type) (hlc : has_lc) (invGS_gen0 : invGS_gen hlc Σ) 
         (H : handler.iHandler Σ E),
         handler.Sequential H
         → ∀ (concurrent : ITreeDefinition.itree (Sum.sum1 handler.threadpoolE E) R) (interleaving : 
                                                                                      ITreeDefinition.itree E
                                                                                        (R + last_thread_killed)) 
             (Φ : R → iProp Σ),
             threadpool_irel concurrent interleaving
             → wpi.wpi_mask ⊤ concurrent (λ v : R, Φ v) -∗
               wpi.wpi_mask ⊤ interleaving
                 (λ r : R + last_thread_killed, match r with
                                                | inl r0 => Φ r0
                                                | inr _ => True
                                                end)
