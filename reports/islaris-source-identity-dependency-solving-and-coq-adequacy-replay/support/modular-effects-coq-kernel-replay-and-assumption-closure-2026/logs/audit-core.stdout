@wpi_allocN
     : ∀ (V : Type) (E : Type → Type) (Σ : gFunctors) (H : handler.iHandler Σ E) (hlc : has_lc) 
         (invGS_gen0 : invGS_gen hlc Σ) (heapHGS0 : heapHGS Σ V) (f : CategoryOps.ReSum Function.IFun (heapE V) E),
         handler.inH (heapH V) H
         → ∀ (M : coPset) (n : nat) (v : V) (Φ : loc → iPropI Σ),
