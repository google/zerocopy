@state_adequacy
     : ∀ (S : Type) (E : Type → Type) (hlc : has_lc) (Σ : gFunctors) (invGS_gen0 : invGS_gen hlc Σ) 
         (stateInterp0 : stateInterp Σ S) (H : handler.iHandler Σ E) (R : Type),
         handler.Sequential H
         → ∀ (s : S) (t : ITreeDefinition.itree (Sum.sum1 (stateE S) E) R) (t' : ITreeDefinition.itree E (S * R)) 
             (M : coPset) (Φ : R → iProp Σ),
             state_irel s t t'
             → state_interp s -∗
               wpi.wpi_mask M t (λ v : R, Φ v) -∗
               wpi.wpi_mask M t' (λ x : S * R, let (s0, v) := x in state_interp s0 ∗ Φ v)
