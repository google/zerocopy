@wpi_adequate_pure
     : ∀ (Σ : gFunctors) (E : Type → Type) (R : Type),
         invGpreS Σ
         → ∀ (hlc : has_lc) (n : nat) (m : coPset) (EH : eHandler E E R) (t : ITreeDefinition.itree E R) 
             (s : eh_state EH) (C : ITreeDefinition.itree E R → eh_state EH → Prop) (Ψ : Prop),
             exec EH t s C
             → (∀ Hinv : invGS_gen hlc Σ,
                  £ n ={⊤,m}=∗
                  ∃ (H : handler.iHandler Σ E) (A : eHandlerAdequate H EH) (Φ : R → iProp Σ),
                    wpi.wpi_mask m t (λ v : R, Φ v) ∗ ehandler_inv s [] ∗
                    ∀ (t' : ITreeDefinition.itree E R) (s' : eh_state EH) (Ms' : list
                                                                                   ((ITreeDefinition.itree E R
                                                                                     → iProp Σ) → 
                                                                                    iProp Σ)) 
                      (M' : (ITreeDefinition.itree E R → iPropI Σ) → iPropI Σ),
                      ⌜C t' s'⌝ -∗
                      ehandler_inv s' Ms' -∗
                      bi_close (Eqit.eutt eq)
                        (λ t'0 : ITreeDefinition.itree E R,
                           ∀ P : ITreeDefinition.itree E R → iPropI Σ, M' P ={∅}=∗ P t'0) t' ∗
                      WPi_tp M' :: Ms' @ H {{ v, |={∅,m}=> Φ v }} ={∅}=∗ ⌜Ψ⌝) → Ψ
