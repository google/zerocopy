@heap_adequacy
     : ∀ (V : Type) (E : Type → Type) (hlc : has_lc) (Σ : gFunctors) (invGS_gen0 : invGS_gen hlc Σ) 
         (heapHGS0 : heapHGS Σ V) (H : handler.iHandler Σ E),
         handler.Sequential H
         → ∀ (R : Type) (σ : heap V) (t : ITreeDefinition.itree (Sum.sum1 (heapE V) E) R) (t' : 
                                                                                          ITreeDefinition.itree E
                                                                                          (heap V * R)) 
             (M : coPset) (Φ : R → iProp Σ),
             heap_irel σ t t'
             → state_interp σ -∗
               wpi.wpi_mask M t (λ v : R, Φ v) -∗
               wpi.wpi_mask M t' (λ x : heap V * R, let (σ', v) := x in state_interp σ' ∗ Φ v)
