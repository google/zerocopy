@wp_partial_soundness
     : forall Σ : iprop.gFunctors,
       fancy_updates.invGpreS Σ ->
       program_logic.heaplangHGpreS Σ ->
       forall (e : definition.heap_lang.expr) (σ : gmap.gmap locations.loc (option definition.heap_lang.val))
         (φ : definition.heap_lang.val -> Prop),
       (forall (invGS0 : fancy_updates.invGS_gen fancy_updates.HasLc Σ) (heaplangHGS0 : program_logic.heaplangHGS Σ),
        interface.bi_emp_valid
          (weakestpre.wp step.Later base.top e (fun v : definition.heap_lang.val => interface.bi_pure (φ v)))) ->
       partially_adequate e σ φ
