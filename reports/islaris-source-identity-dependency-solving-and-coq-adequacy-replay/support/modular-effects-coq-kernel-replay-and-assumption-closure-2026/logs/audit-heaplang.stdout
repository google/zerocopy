@wp_total_soundness
     : forall Σ : iprop.gFunctors,
       fancy_updates.invGpreS Σ ->
       program_logic.heaplangHGpreS Σ ->
       forall (e : definition.heap_lang.expr) (σ : gmap.gmap locations.loc (option definition.heap_lang.val))
