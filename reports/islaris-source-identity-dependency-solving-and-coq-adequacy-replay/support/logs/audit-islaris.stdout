               → nsteps n (initial_local_state <$> regs, {| seq_instrs := instrs; seq_mem := mem |}) κs (t2, σ2)
                 → (∀ e2 : expr isla_lang, e2 ∈ t2 → not_stuck e2 σ2) ∧ Pκs κs
