opam-version: "2.0"
name: "coq-lithium"
version: "dev.2024-09-11.0.7945a29d"
synopsis: "Lithium proof automation for Iris"
description: "Lithium proof automation for Iris"
maintainer: [
  "Michael Sammler <msammler@mpi-sws.org>"
  "Rodolphe Lepigre <lepigre@mpi-sws.org>"
]
authors: ["Michael Sammler" "Rodolphe Lepigre"]
license: "BSD-3-Clause"
homepage: "https://plv.mpi-sws.org/refinedc"
bug-reports: "https://gitlab.mpi-sws.org/iris/refinedc/issues"
depends: [
  "coq" {(= "8.19.0")}
  "coq-iris" {(= "dev.2024-09-10.1.6f24ed4b") | (= "dev")}
  "coq-stdpp-unstable"
  "dune" {>= "3.9.1"}
  "coq-record-update" {= "0.3.3"}
]
build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "git+https://gitlab.mpi-sws.org/iris/refinedc.git"
url {
  src:
    "git+https://gitlab.mpi-sws.org/iris/refinedc.git#7945a29d1647970709a9b5ad2ffc53c757e130cc"
}
