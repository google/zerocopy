opam-version: "2.0"
name: "coq-bbv"
version: "1.5"
synopsis: "An implementation of bitvectors in Coq."
maintainer: "gmalecha@gmail.com"
authors: [
  "Tej Chajed"
  "Haogang Chen"
  "Adam Chlipala"
  "Joonwon Choi"
  "Andres Erbsen"
  "Jason Gross"
  "Samuel Gruetter"
  "Frans Kaashoek"
  "Alex Konradi"
  "Gregory Malecha"
  "Duckki Oe"
  "Murali Vijayaraghavan"
  "Nickolai Zeldovich"
  "Daniel Ziegler"
]
license: "MIT"
homepage: "https://github.com/mit-plv/bbv"
bug-reports: "https://github.com/mit-plv/bbv/issues"
depends: [
  "ocaml"
  "coq" {>= "8.16" & < "9.2~"}
]
build: [make "-j%{jobs}%"]
install: [make "install"]
dev-repo: "git+ssh://git@github.com/mit-plv/bbv.git"
url {
  src: "https://github.com/mit-plv/bbv/archive/v1.5.tar.gz"
  checksum:
    "sha512=43bf2c300b5a24275fecd4888ddda0a2ef88ceb22835130bf5fe61d00ddfd7c8634b70e35a45043f69d2f3ef783ee3295e6e1cd6b8b4645ab008d6c1afa36c33"
}
