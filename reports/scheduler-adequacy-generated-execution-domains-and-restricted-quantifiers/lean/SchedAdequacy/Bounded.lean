import SchedAdequacy.Basic

/-!
# Bounded oracles and a decision procedure for adequacy on a given program
-/

namespace Toy.SchedAdequacy

variable {α : Type}

/-- `OracleBounded gen p n`: the run of `gen` on `p` depends only on the first
`n` oracle bits — truncating any oracle to length `n` yields the same run. The
truncation `o.take n` is the explicit witness. -/
def OracleBounded (gen : Gen Oracle α) (p : Prog α) (n : Nat) : Prop :=
  ∀ o : Oracle, gen (o.take n) p = gen o p

/-- All oracles of length at most `n` (`2^(n+1) - 1` of them). -/
def oraclesUpTo : Nat → List Oracle
  | 0 => [[]]
  | n + 1 => [] :: (oraclesUpTo n).flatMap fun o => [false :: o, true :: o]

/-- The runs generated by oracles of length at most `n`. -/
def generatedUpTo (gen : Gen Oracle α) (p : Prog α) (n : Nat) : List (List α) :=
  (oraclesUpTo n).map fun o => gen o p

/-- Decision procedure (completeness half): is every interleaving of `p` produced
by an oracle of length at most `n`? -/
def checkComplete [DecidableEq α] (gen : Gen Oracle α) (p : Prog α) (n : Nat) : Bool :=
  (Interleavings p).all fun t => decide (t ∈ generatedUpTo gen p n)

/-- Decision procedure (soundness half): is every run produced by an oracle of
length at most `n` an interleaving of `p`? -/
def checkSound [DecidableEq α] (gen : Gen Oracle α) (p : Prog α) (n : Nat) : Bool :=
  (generatedUpTo gen p n).all fun t => decide (t ∈ Interleavings p)

/-! ## Supporting lemmas (fully proved) -/

theorem mem_oraclesUpTo {o : Oracle} {n : Nat} (h : o.length ≤ n) : o ∈ oraclesUpTo n := by
  induction n generalizing o with
  | zero =>
      have : o = [] := List.eq_nil_of_length_eq_zero (Nat.le_zero.mp h)
      subst this; simp [oraclesUpTo]
  | succ n ih =>
      cases o with
      | nil => simp [oraclesUpTo]
      | cons b o =>
          have ho : o ∈ oraclesUpTo n := ih (by simp at h; omega)
          simp only [oraclesUpTo, List.mem_cons, List.mem_flatMap]
          refine Or.inr ⟨o, ho, ?_⟩
          cases b <;> simp

/-- The answer `true` of `checkComplete` is always correct (no boundedness
needed): the witnesses are found by the search. -/
theorem complete_of_checkComplete [DecidableEq α] {gen : Gen Oracle α} {p : Prog α} {n : Nat}
    (h : checkComplete gen p n = true) : Complete gen p := by
  intro t ht
  have := (List.all_eq_true.mp h) t ht
  simp only [decide_eq_true_eq, generatedUpTo, List.mem_map] at this
  obtain ⟨o, _, ho⟩ := this
  exact ⟨o, ho⟩

/-- The answer `false` of `checkSound` is always correct (no boundedness needed):
the search exhibits a non-interleaving run. -/
theorem not_sound_of_checkSound [DecidableEq α] {gen : Gen Oracle α} {p : Prog α} {n : Nat}
    (h : checkSound gen p n = false) : ¬ Sound gen p := by
  intro hs
  have : checkSound gen p n = true := by
    apply List.all_eq_true.mpr
    intro t ht
    simp only [generatedUpTo, List.mem_map] at ht
    obtain ⟨o, _, rfl⟩ := ht
    exact decide_eq_true (hs o)
  rw [this] at h; exact Bool.noConfusion h

end Toy.SchedAdequacy
