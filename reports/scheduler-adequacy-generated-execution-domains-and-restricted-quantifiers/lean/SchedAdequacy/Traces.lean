import SchedAdequacy.Basic

/-!
# Swap closure, closed properties and representative sets

`SwapStep I` commutes one adjacent pair `x y` with `I x y`; `TraceEquiv I` is
its reflexive–transitive closure. For an arbitrary relation `I` this closure is
only a preorder (directed rewriting, a semi-commutation in the sense of Clerbout
and Latteux); it is an equivalence relation, Mazurkiewicz trace equivalence,
when `I` is symmetric (`traceEquiv_equivalence_of_symmetric`). The names
`TraceEquiv`, `TraceInvariant` ("invariant") and `MeetsEveryClass` ("class")
describe what the definitions mean for symmetric `I`; the bridge lemmas
`traceInvariant_iff_two_sided_of_symmetric` and `meetsEveryClass_iff_of_symmetric`
prove that reading. Every main result that uses these words assumes
`Symmetric I` or a hypothesis that implies it (`symmetric_of_full_independence`).
The directed generalizations are recorded as separate lemmas
(`representative_transfer_directed`, `invariant_transfer_iff_meets_every_class_directed`).
-/

namespace Toy.SchedAdequacy

variable {α : Type}

/-- `I` is symmetric (one of the two laws of an independence relation). -/
def Symmetric (I : α → α → Prop) : Prop := ∀ x y, I x y → I y x

/-- `I` is irreflexive (the other law of an independence relation). -/
def Irreflexive (I : α → α → Prop) : Prop := ∀ x, ¬ I x x

/-- One adjacent transposition of two actions related by `I`:
`u ++ x :: y :: v` becomes `u ++ y :: x :: v` when `I x y`. -/
inductive SwapStep (I : α → α → Prop) : List α → List α → Prop
  | mk (u v : List α) (x y : α) : I x y → SwapStep I (u ++ x :: y :: v) (u ++ y :: x :: v)

/-- The swap closure generated by `I`: the reflexive–transitive closure of
`SwapStep I` (commuting adjacent `I`-related actions, any number of times, in the
direction `x y ↦ y x` for `I x y`). For an arbitrary `I` this is a preorder, not
an equivalence relation (see `swapClosure_not_symmetric_example` in `Results`).
For symmetric `I` it is an equivalence relation, Mazurkiewicz trace equivalence
(`traceEquiv_equivalence_of_symmetric`); the name refers to that case. -/
inductive TraceEquiv (I : α → α → Prop) : List α → List α → Prop
  | refl (t : List α) : TraceEquiv I t t
  | tail {s t u : List α} : TraceEquiv I s t → SwapStep I t u → TraceEquiv I s u

/-- `P` is closed under the swap closure of `I`: if `P s` holds and `t` is
reachable from `s` by commuting `I`-related adjacent actions, then `P t` holds.
For symmetric `I` this is exactly invariance under trace equivalence, i.e. `P`
cannot distinguish two trace-equivalent traces
(`traceInvariant_iff_two_sided_of_symmetric`); for asymmetric `I` it is only
forward closure. -/
def TraceInvariant (I : α → α → Prop) (P : List α → Prop) : Prop :=
  ∀ s t, TraceEquiv I s t → P s → P t

/-- `MeetsEveryClass I gen p`: every interleaving of `p` is reachable, by
commuting `I`-related adjacent actions, from some run generated by `gen`. For
symmetric `I` this says that the trace class of every interleaving of `p`
contains a run generated by `gen` (`meetsEveryClass_iff_of_symmetric`). The
generated run need not itself be an interleaving of `p` unless `gen` is sound on
`p` (see `meetsEveryClass_without_sound` in `Results`). -/
def MeetsEveryClass {O : Type} (I : α → α → Prop) (gen : Gen O α) (p : Prog α) : Prop :=
  ∀ t ∈ Interleavings p, ∃ o, TraceEquiv I (gen o p) t

/-- Final state of a trace under a state-transformer semantics for actions:
`eff x` is the effect of action `x` on a state of type `σ`. -/
def finalState {σ : Type} (eff : α → σ → σ) (s₀ : σ) (t : List α) : σ :=
  t.foldl (fun s x => eff x s) s₀

/-- `I`-related actions have commuting effects (the semantic justification for
treating them as independent). -/
def Commuting {σ : Type} (eff : α → σ → σ) (I : α → α → Prop) : Prop :=
  ∀ x y, I x y → ∀ s, eff y (eff x s) = eff x (eff y s)

/-! ## Supporting lemmas (fully proved) -/

namespace TraceEquiv

variable {I : α → α → Prop}

theorem single {s t : List α} (h : SwapStep I s t) : TraceEquiv I s t :=
  .tail (.refl s) h

theorem trans {s t u : List α} (h₁ : TraceEquiv I s t) (h₂ : TraceEquiv I t u) :
    TraceEquiv I s u := by
  induction h₂ with
  | refl => exact h₁
  | tail _ hs ih => exact .tail ih hs

/-- Commute one adjacent `I`-related pair. -/
theorem swap1 (u v : List α) (x y : α) (h : I x y) :
    TraceEquiv I (u ++ x :: y :: v) (u ++ y :: x :: v) :=
  single (SwapStep.mk u v x y h)

theorem cons (z : α) {s t : List α} (h : TraceEquiv I s t) : TraceEquiv I (z :: s) (z :: t) := by
  induction h with
  | refl => exact .refl _
  | tail _ hs ih =>
      cases hs with
      | mk u v x y hxy => exact .tail ih (SwapStep.mk (z :: u) v x y hxy)

theorem perm {s t : List α} (h : TraceEquiv I s t) : s.Perm t := by
  induction h with
  | refl => exact List.Perm.refl _
  | tail _ hs ih =>
      cases hs with
      | mk u v x y _ =>
          exact ih.trans (List.Perm.append_left u (List.Perm.swap y x v))

theorem length_eq {s t : List α} (h : TraceEquiv I s t) : s.length = t.length :=
  h.perm.length_eq

/-- For symmetric `I` the swap closure is symmetric. -/
theorem symm (hI : Symmetric I) {s t : List α} (h : TraceEquiv I s t) : TraceEquiv I t s := by
  induction h with
  | refl => exact .refl _
  | tail _ hs ih =>
      cases hs with
      | mk u v x y hxy => exact (swap1 u v y x (hI x y hxy)).trans ih

end TraceEquiv

/-- For symmetric `I`, `TraceEquiv I` is an equivalence relation. -/
theorem traceEquiv_equivalence_of_symmetric {I : α → α → Prop} (hI : Symmetric I) :
    Equivalence (TraceEquiv I) :=
  ⟨TraceEquiv.refl, TraceEquiv.symm hI, TraceEquiv.trans⟩

/-- For symmetric `I`, closure under the swap closure is two-sided invariance. -/
theorem traceInvariant_iff_two_sided_of_symmetric {I : α → α → Prop} (hI : Symmetric I)
    (P : List α → Prop) :
    TraceInvariant I P ↔ ∀ s t, TraceEquiv I s t → (P s ↔ P t) :=
  ⟨fun h s t hst => ⟨h s t hst, h t s (hst.symm hI)⟩, fun h s t hst ps => (h s t hst).mp ps⟩

/-- For symmetric `I`, `MeetsEveryClass` may be read in either direction: every
interleaving is trace-equivalent to some generated run. -/
theorem meetsEveryClass_iff_of_symmetric {O : Type} {I : α → α → Prop} (hI : Symmetric I)
    (gen : Gen O α) (p : Prog α) :
    MeetsEveryClass I gen p ↔ ∀ t ∈ Interleavings p, ∃ o, TraceEquiv I t (gen o p) :=
  ⟨fun h t ht => let ⟨o, ho⟩ := h t ht; ⟨o, ho.symm hI⟩,
   fun h t ht => let ⟨o, ho⟩ := h t ht; ⟨o, ho.symm hI⟩⟩

/-- A relation that relates all distinct actions is symmetric. -/
theorem symmetric_of_full_independence {I : α → α → Prop} (hI : ∀ x y, x ≠ y → I x y) :
    Symmetric I := by
  intro x y hxy
  by_cases heq : x = y
  · subst heq; exact hxy
  · exact hI y x (Ne.symm heq)

/-- Under full independence (every two distinct actions are `I`-related), any
two permutations are trace equivalent. -/
theorem traceEquiv_of_perm {I : α → α → Prop} (hI : ∀ x y, x ≠ y → I x y) {s t : List α}
    (h : s.Perm t) : TraceEquiv I s t := by
  induction h with
  | nil => exact .refl _
  | cons z _ ih => exact ih.cons z
  | swap x y l =>
      by_cases hxy : y = x
      · subst hxy; exact .refl _
      · exact TraceEquiv.swap1 [] l y x (hI y x hxy)
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Under full independence, closure under the swap closure is exactly
permutation invariance. -/
theorem traceInvariant_iff_perm_invariant_of_full_independence {I : α → α → Prop}
    (hI : ∀ x y, x ≠ y → I x y) (P : List α → Prop) :
    TraceInvariant I P ↔ ∀ s t, s.Perm t → P s → P t :=
  ⟨fun h s t hp => h s t (traceEquiv_of_perm hI hp), fun h s t he => h s t he.perm⟩

/-- An action with no `I`-partner (in either argument position) stays at the
head: trace equivalence preserves "the trace starts with `b`". -/
theorem head_eq_iff_of_traceEquiv_of_isolated {I : α → α → Prop} {b : α}
    (hb : ∀ x, ¬ I b x ∧ ¬ I x b) {s t : List α} (h : TraceEquiv I s t) :
    s.head? = some b ↔ t.head? = some b := by
  induction h with
  | refl => exact Iff.rfl
  | tail _ hs ih =>
      refine ih.trans ?_
      cases hs with
      | mk u v x y hxy =>
          cases u with
          | nil =>
              simp only [List.nil_append, List.head?_cons, Option.some.injEq]
              constructor
              · intro hx; subst hx; exact absurd hxy (hb y).1
              · intro hy; subst hy; exact absurd hxy (hb x).2
          | cons z u => simp

/-- Commuting effects make the final state trace-invariant. -/
theorem finalState_eq_of_traceEquiv {σ : Type} {eff : α → σ → σ} {I : α → α → Prop}
    (hc : Commuting eff I) (s₀ : σ) {s t : List α} (h : TraceEquiv I s t) :
    finalState eff s₀ s = finalState eff s₀ t := by
  induction h with
  | refl => rfl
  | tail _ hs ih =>
      rw [ih]
      cases hs with
      | mk u v x y hxy =>
          simp only [finalState, List.foldl_append, List.foldl_cons]
          rw [hc x y hxy]

end Toy.SchedAdequacy
