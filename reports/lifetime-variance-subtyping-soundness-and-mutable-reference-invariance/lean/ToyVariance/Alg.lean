import ToyVariance.Basic

/-!
# A structural decision procedure for `SubGen tbl NoAx`

`subAlg tbl pol S T` checks `S ≤ T` when `pol = true` and `T ≤ S` when `pol = false`, by
structural recursion, with no transitivity rule. It is used to (a) refute subtyping claims
(negative examples, positive controls) and (b) serve as the oracle of concrete programs.
-/

namespace Toy.Variance

/-- Outlives in the direction given by `pol`. -/
def ob (pol : Bool) (a b : Lft) : Bool := if pol then a.outlives b else b.outlives a

/-- Boolean lifetime relation at variance `v`, direction `pol`. -/
def lrelB (v : Variance) (pol : Bool) (a b : Lft) : Bool :=
  (!v.fwd || ob pol a b) && (!v.bwd || ob (!pol) a b)

/-- Structural subtyping check for the relation generated by `tbl` without extra generators. -/
def subAlg (tbl : Table) : Bool → Ty → Ty → Bool
  | _, .unit, .unit => true
  | _, .nat, .nat => true
  | _, .param, .param => true
  | pol, .ref a S, .ref b T =>
    lrelB (tbl .refLft) pol a b && (!(tbl .refTy).fwd || subAlg tbl pol S T) &&
      (!(tbl .refTy).bwd || subAlg tbl (!pol) S T)
  | pol, .refMut a S, .refMut b T =>
    lrelB (tbl .refMutLft) pol a b && (!(tbl .refMutTy).fwd || subAlg tbl pol S T) &&
      (!(tbl .refMutTy).bwd || subAlg tbl (!pol) S T)
  | pol, .cell S, .cell T =>
    (!(tbl .cell).fwd || subAlg tbl pol S T) && (!(tbl .cell).bwd || subAlg tbl (!pol) S T)
  | pol, .fn S U, .fn S' U' =>
    (!(tbl .fnArg).fwd || subAlg tbl pol S S') && (!(tbl .fnArg).bwd || subAlg tbl (!pol) S S') &&
      (!(tbl .fnRes).fwd || subAlg tbl pol U U') && (!(tbl .fnRes).bwd || subAlg tbl (!pol) U U')
  | pol, .prod S U, .prod S' U' =>
    (!(tbl .prodL).fwd || subAlg tbl pol S S') && (!(tbl .prodL).bwd || subAlg tbl (!pol) S S') &&
      (!(tbl .prodR).fwd || subAlg tbl pol U U') && (!(tbl .prodR).bwd || subAlg tbl (!pol) U U')
  | pol, .phantom S, .phantom T =>
    (!(tbl .phantom).fwd || subAlg tbl pol S T) && (!(tbl .phantom).bwd || subAlg tbl (!pol) S T)
  | _, _, _ => false

theorem Lft.outlives_refl (a : Lft) : a.outlives a = true := by
  cases a <;> simp [Lft.outlives]

theorem Lft.outlives_trans {a b c : Lft} (h₁ : a.outlives b = true) (h₂ : b.outlives c = true) :
    a.outlives c = true := by
  cases a <;> cases b <;> cases c <;> simp_all [Lft.outlives] <;> omega

theorem ob_flip (pol : Bool) (a b : Lft) : ob (!pol) a b = ob pol b a := by
  cases pol <;> rfl

theorem lrelB_flip (v : Variance) (pol : Bool) (a b : Lft) :
    lrelB v (!pol) a b = lrelB v pol b a := by
  simp only [lrelB, ob_flip, Bool.not_not]

theorem subAlg_flip (tbl : Table) : ∀ (pol : Bool) (S T : Ty),
    subAlg tbl (!pol) S T = subAlg tbl pol T S := by
  intro pol S
  induction S generalizing pol with
  | unit => intro T; cases T <;> rfl
  | nat => intro T; cases T <;> rfl
  | param => intro T; cases T <;> rfl
  | ref a S ih =>
    intro T; have h2 := ih (!pol); simp only [Bool.not_not] at h2
    cases T <;> simp only [subAlg, lrelB_flip, ih, h2, Bool.not_not]
  | refMut a S ih =>
    intro T; have h2 := ih (!pol); simp only [Bool.not_not] at h2
    cases T <;> simp only [subAlg, lrelB_flip, ih, h2, Bool.not_not]
  | cell S ih =>
    intro T; have h2 := ih (!pol); simp only [Bool.not_not] at h2
    cases T <;> simp only [subAlg, ih, h2, Bool.not_not]
  | fn S U ihS ihU =>
    intro T; have h2 := ihS (!pol); have h3 := ihU (!pol)
    simp only [Bool.not_not] at h2 h3
    cases T <;> simp only [subAlg, ihS, ihU, h2, h3, Bool.not_not]
  | prod S U ihS ihU =>
    intro T; have h2 := ihS (!pol); have h3 := ihU (!pol)
    simp only [Bool.not_not] at h2 h3
    cases T <;> simp only [subAlg, ihS, ihU, h2, h3, Bool.not_not]
  | phantom S ih =>
    intro T; have h2 := ih (!pol); simp only [Bool.not_not] at h2
    cases T <;> simp only [subAlg, ih, h2, Bool.not_not]

theorem lrelB_refl (v : Variance) (pol : Bool) (a : Lft) : lrelB v pol a a = true := by
  cases pol <;> simp [lrelB, ob, Lft.outlives_refl]

theorem subAlg_refl (tbl : Table) : ∀ (pol : Bool) (T : Ty), subAlg tbl pol T T = true := by
  intro pol T
  induction T generalizing pol with
  | unit => rfl
  | nat => rfl
  | param => rfl
  | ref a S ih => simp [subAlg, lrelB_refl, ih]
  | refMut a S ih => simp [subAlg, lrelB_refl, ih]
  | cell S ih => simp [subAlg, ih]
  | fn S U ihS ihU => simp [subAlg, ihS, ihU]
  | prod S U ihS ihU => simp [subAlg, ihS, ihU]
  | phantom S ih => simp [subAlg, ih]

theorem ob_trans {pol : Bool} {a b c : Lft} (h₁ : ob pol a b = true) (h₂ : ob pol b c = true) :
    ob pol a c = true := by
  cases pol
  · exact Lft.outlives_trans h₂ h₁
  · exact Lft.outlives_trans h₁ h₂

theorem lrelB_trans {v : Variance} {pol : Bool} {a b c : Lft}
    (h₁ : lrelB v pol a b = true) (h₂ : lrelB v pol b c = true) : lrelB v pol a c = true := by
  simp only [lrelB, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true'] at *
  obtain ⟨h₁a, h₁b⟩ := h₁
  obtain ⟨h₂a, h₂b⟩ := h₂
  refine ⟨?_, ?_⟩
  · rcases h₁a with h | h
    · exact Or.inl h
    · rcases h₂a with h' | h'
      · exact Or.inl h'
      · exact Or.inr (ob_trans h h')
  · rcases h₁b with h | h
    · exact Or.inl h
    · rcases h₂b with h' | h'
      · exact Or.inl h'
      · exact Or.inr (ob_trans h h')

/-- Helper: the guarded-recursive-call shape `!b || P` composes transitively. -/
theorem guard_trans {b : Bool} {x y z : Bool} (H : x = true → y = true → z = true)
    (h₁ : (!b || x) = true) (h₂ : (!b || y) = true) : (!b || z) = true := by
  cases b <;> simp_all

theorem subAlg_trans (tbl : Table) : ∀ (T : Ty) (pol : Bool) (S U : Ty),
    subAlg tbl pol S T = true → subAlg tbl pol T U = true → subAlg tbl pol S U = true := by
  intro T
  induction T with
  | unit => intro pol S U h₁ h₂; cases S <;> cases U <;> simp_all [subAlg]
  | nat => intro pol S U h₁ h₂; cases S <;> cases U <;> simp_all [subAlg]
  | param => intro pol S U h₁ h₂; cases S <;> cases U <;> simp_all [subAlg]
  | ref b T ih =>
    intro pol S U h₁ h₂
    cases S <;> cases U <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h₁ h₂ ⊢
    obtain ⟨⟨l₁, f₁⟩, b₁⟩ := h₁
    obtain ⟨⟨l₂, f₂⟩, b₂⟩ := h₂
    exact ⟨⟨lrelB_trans l₁ l₂, guard_trans (ih _ _ _) f₁ f₂⟩, guard_trans (ih _ _ _) b₁ b₂⟩
  | refMut b T ih =>
    intro pol S U h₁ h₂
    cases S <;> cases U <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h₁ h₂ ⊢
    obtain ⟨⟨l₁, f₁⟩, b₁⟩ := h₁
    obtain ⟨⟨l₂, f₂⟩, b₂⟩ := h₂
    exact ⟨⟨lrelB_trans l₁ l₂, guard_trans (ih _ _ _) f₁ f₂⟩, guard_trans (ih _ _ _) b₁ b₂⟩
  | cell T ih =>
    intro pol S U h₁ h₂
    cases S <;> cases U <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h₁ h₂ ⊢
    obtain ⟨f₁, b₁⟩ := h₁
    obtain ⟨f₂, b₂⟩ := h₂
    exact ⟨guard_trans (ih _ _ _) f₁ f₂, guard_trans (ih _ _ _) b₁ b₂⟩
  | fn T V ihT ihV =>
    intro pol S U h₁ h₂
    cases S <;> cases U <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h₁ h₂ ⊢
    obtain ⟨⟨⟨a₁, c₁⟩, d₁⟩, e₁⟩ := h₁
    obtain ⟨⟨⟨a₂, c₂⟩, d₂⟩, e₂⟩ := h₂
    exact ⟨⟨⟨guard_trans (ihT _ _ _) a₁ a₂, guard_trans (ihT _ _ _) c₁ c₂⟩,
      guard_trans (ihV _ _ _) d₁ d₂⟩, guard_trans (ihV _ _ _) e₁ e₂⟩
  | prod T V ihT ihV =>
    intro pol S U h₁ h₂
    cases S <;> cases U <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h₁ h₂ ⊢
    obtain ⟨⟨⟨a₁, c₁⟩, d₁⟩, e₁⟩ := h₁
    obtain ⟨⟨⟨a₂, c₂⟩, d₂⟩, e₂⟩ := h₂
    exact ⟨⟨⟨guard_trans (ihT _ _ _) a₁ a₂, guard_trans (ihT _ _ _) c₁ c₂⟩,
      guard_trans (ihV _ _ _) d₁ d₂⟩, guard_trans (ihV _ _ _) e₁ e₂⟩
  | phantom T ih =>
    intro pol S U h₁ h₂
    cases S <;> cases U <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h₁ h₂ ⊢
    obtain ⟨f₁, b₁⟩ := h₁
    obtain ⟨f₂, b₂⟩ := h₂
    exact ⟨guard_trans (ih _ _ _) f₁ f₂, guard_trans (ih _ _ _) b₁ b₂⟩

theorem guard_of {b x : Bool} (h : b = true → x = true) : (!b || x) = true := by
  cases b <;> simp_all

theorem guard_elim {b x : Bool} (h : (!b || x) = true) (hb : b = true) : x = true := by
  simp_all

theorem lrelB_true_iff (v : Variance) (a b : Lft) : lrelB v true a b = true ↔ LRel v a b := by
  cases v <;> simp [lrelB, ob, LRel, Variance.Rel, Variance.fwd, Variance.bwd]

theorem lrelB_false_iff (v : Variance) (a b : Lft) : lrelB v false a b = true ↔ LRel v b a := by
  rw [show false = !true from rfl, lrelB_flip]; exact lrelB_true_iff v b a

/-- `subAlg` is sound for the generated relation (in both directions of `pol`). -/
theorem subGen_of_subAlg (tbl : Table) : ∀ (S T : Ty) (pol : Bool), subAlg tbl pol S T = true →
    (bif pol then SubGen tbl NoAx S T else SubGen tbl NoAx T S) := by
  intro S
  induction S with
  | unit => intro T pol h; cases T <;> simp [subAlg] at h; cases pol <;> exact SubGen.refl _
  | nat => intro T pol h; cases T <;> simp [subAlg] at h; cases pol <;> exact SubGen.refl _
  | param => intro T pol h; cases T <;> simp [subAlg] at h; cases pol <;> exact SubGen.refl _
  | ref a S ih =>
    intro T pol h
    cases T <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h
    obtain ⟨⟨hl, hf⟩, hb⟩ := h
    cases pol
    · exact SubGen.ref ((lrelB_false_iff _ _ _).1 hl) (fun hv => ih _ false (guard_elim hf hv))
        (fun hv => ih _ true (guard_elim hb hv))
    · exact SubGen.ref ((lrelB_true_iff _ _ _).1 hl) (fun hv => ih _ true (guard_elim hf hv))
        (fun hv => ih _ false (guard_elim hb hv))
  | refMut a S ih =>
    intro T pol h
    cases T <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h
    obtain ⟨⟨hl, hf⟩, hb⟩ := h
    cases pol
    · exact SubGen.refMut ((lrelB_false_iff _ _ _).1 hl) (fun hv => ih _ false (guard_elim hf hv))
        (fun hv => ih _ true (guard_elim hb hv))
    · exact SubGen.refMut ((lrelB_true_iff _ _ _).1 hl) (fun hv => ih _ true (guard_elim hf hv))
        (fun hv => ih _ false (guard_elim hb hv))
  | cell S ih =>
    intro T pol h
    cases T <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h
    obtain ⟨hf, hb⟩ := h
    cases pol
    · exact SubGen.cell (fun hv => ih _ false (guard_elim hf hv))
        (fun hv => ih _ true (guard_elim hb hv))
    · exact SubGen.cell (fun hv => ih _ true (guard_elim hf hv))
        (fun hv => ih _ false (guard_elim hb hv))
  | fn S U ihS ihU =>
    intro T pol h
    cases T <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h
    obtain ⟨⟨⟨a, b⟩, c⟩, d⟩ := h
    cases pol
    · exact SubGen.fn (fun hv => ihS _ false (guard_elim a hv)) (fun hv => ihS _ true (guard_elim b hv))
        (fun hv => ihU _ false (guard_elim c hv)) (fun hv => ihU _ true (guard_elim d hv))
    · exact SubGen.fn (fun hv => ihS _ true (guard_elim a hv)) (fun hv => ihS _ false (guard_elim b hv))
        (fun hv => ihU _ true (guard_elim c hv)) (fun hv => ihU _ false (guard_elim d hv))
  | prod S U ihS ihU =>
    intro T pol h
    cases T <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h
    obtain ⟨⟨⟨a, b⟩, c⟩, d⟩ := h
    cases pol
    · exact SubGen.prod (fun hv => ihS _ false (guard_elim a hv)) (fun hv => ihS _ true (guard_elim b hv))
        (fun hv => ihU _ false (guard_elim c hv)) (fun hv => ihU _ true (guard_elim d hv))
    · exact SubGen.prod (fun hv => ihS _ true (guard_elim a hv)) (fun hv => ihS _ false (guard_elim b hv))
        (fun hv => ihU _ true (guard_elim c hv)) (fun hv => ihU _ false (guard_elim d hv))
  | phantom S ih =>
    intro T pol h
    cases T <;> simp only [subAlg, Bool.and_eq_true, Bool.false_eq_true] at h
    obtain ⟨hf, hb⟩ := h
    cases pol
    · exact SubGen.phantom (fun hv => ih _ false (guard_elim hf hv))
        (fun hv => ih _ true (guard_elim hb hv))
    · exact SubGen.phantom (fun hv => ih _ true (guard_elim hf hv))
        (fun hv => ih _ false (guard_elim hb hv))

/-- `subAlg` is complete for the generated relation. -/
theorem subAlg_of_subGen {tbl : Table} {S T : Ty} (h : SubGen tbl NoAx S T) :
    subAlg tbl true S T = true := by
  induction h with
  | refl T => exact subAlg_refl tbl true T
  | trans _ _ ih₁ ih₂ => exact subAlg_trans tbl _ true _ _ ih₁ ih₂
  | base h => exact h.elim
  | ref hl _ _ ihf ihb =>
    simp only [subAlg, Bool.and_eq_true]
    exact ⟨⟨(lrelB_true_iff _ _ _).2 hl, guard_of ihf⟩,
      guard_of (fun hv => (subAlg_flip tbl true _ _).trans (ihb hv))⟩
  | refMut hl _ _ ihf ihb =>
    simp only [subAlg, Bool.and_eq_true]
    exact ⟨⟨(lrelB_true_iff _ _ _).2 hl, guard_of ihf⟩,
      guard_of (fun hv => (subAlg_flip tbl true _ _).trans (ihb hv))⟩
  | cell _ _ ihf ihb =>
    simp only [subAlg, Bool.and_eq_true]
    exact ⟨guard_of ihf, guard_of (fun hv => (subAlg_flip tbl true _ _).trans (ihb hv))⟩
  | fn _ _ _ _ iha ihb ihc ihd =>
    simp only [subAlg, Bool.and_eq_true]
    exact ⟨⟨⟨guard_of iha, guard_of (fun hv => (subAlg_flip tbl true _ _).trans (ihb hv))⟩,
      guard_of ihc⟩, guard_of (fun hv => (subAlg_flip tbl true _ _).trans (ihd hv))⟩
  | prod _ _ _ _ iha ihb ihc ihd =>
    simp only [subAlg, Bool.and_eq_true]
    exact ⟨⟨⟨guard_of iha, guard_of (fun hv => (subAlg_flip tbl true _ _).trans (ihb hv))⟩,
      guard_of ihc⟩, guard_of (fun hv => (subAlg_flip tbl true _ _).trans (ihd hv))⟩
  | phantom _ _ ihf ihb =>
    simp only [subAlg, Bool.and_eq_true]
    exact ⟨guard_of ihf, guard_of (fun hv => (subAlg_flip tbl true _ _).trans (ihb hv))⟩

/-- The generated relation (without extra generators) is decided by `subAlg`. -/
theorem subGen_iff_subAlg (tbl : Table) (S T : Ty) :
    SubGen tbl NoAx S T ↔ subAlg tbl true S T = true :=
  ⟨subAlg_of_subGen, fun h => subGen_of_subAlg tbl S T true h⟩

theorem Variance.le_fwd {v w : Variance} (h : v.le w = true) (hw : w.fwd = true) : v.fwd = true := by
  cases v <;> cases w <;> simp_all [Variance.le, Variance.fwd, Variance.bwd]

theorem Variance.le_bwd {v w : Variance} (h : v.le w = true) (hw : w.bwd = true) : v.bwd = true := by
  cases v <;> cases w <;> simp_all [Variance.le, Variance.fwd, Variance.bwd]

theorem LRel.mono {v w : Variance} {a b : Lft} (h : v.le w = true) (hl : LRel v a b) : LRel w a b :=
  ⟨fun hw => hl.1 (Variance.le_fwd h hw), fun hw => hl.2 (Variance.le_bwd h hw)⟩

/-- The generated relation grows with the table (pointwise permissiveness) and the generators. -/
theorem SubGen.lift {t₁ t₂ : Table} {ax₁ ax₂ : Ty → Ty → Prop} (ht : Table.le t₁ t₂)
    (hax : ∀ S T, ax₁ S T → SubGen t₂ ax₂ S T) {S T : Ty} (h : SubGen t₁ ax₁ S T) :
    SubGen t₂ ax₂ S T := by
  induction h with
  | refl T => exact SubGen.refl T
  | trans _ _ ih₁ ih₂ => exact SubGen.trans ih₁ ih₂
  | base h => exact hax _ _ h
  | ref hl _ _ ihf ihb =>
    exact SubGen.ref (LRel.mono (ht _) hl) (fun hw => ihf (Variance.le_fwd (ht _) hw))
      (fun hw => ihb (Variance.le_bwd (ht _) hw))
  | refMut hl _ _ ihf ihb =>
    exact SubGen.refMut (LRel.mono (ht _) hl) (fun hw => ihf (Variance.le_fwd (ht _) hw))
      (fun hw => ihb (Variance.le_bwd (ht _) hw))
  | cell _ _ ihf ihb =>
    exact SubGen.cell (fun hw => ihf (Variance.le_fwd (ht _) hw))
      (fun hw => ihb (Variance.le_bwd (ht _) hw))
  | fn _ _ _ _ iha ihb ihc ihd =>
    exact SubGen.fn (fun hw => iha (Variance.le_fwd (ht _) hw)) (fun hw => ihb (Variance.le_bwd (ht _) hw))
      (fun hw => ihc (Variance.le_fwd (ht _) hw)) (fun hw => ihd (Variance.le_bwd (ht _) hw))
  | prod _ _ _ _ iha ihb ihc ihd =>
    exact SubGen.prod (fun hw => iha (Variance.le_fwd (ht _) hw)) (fun hw => ihb (Variance.le_bwd (ht _) hw))
      (fun hw => ihc (Variance.le_fwd (ht _) hw)) (fun hw => ihd (Variance.le_bwd (ht _) hw))
  | phantom _ _ ihf ihb =>
    exact SubGen.phantom (fun hw => ihf (Variance.le_fwd (ht _) hw))
      (fun hw => ihb (Variance.le_bwd (ht _) hw))

theorem Table.le_refl (t : Table) : Table.le t t := by
  intro p; cases h : t p <;> rfl

end Toy.Variance
