(set-logic QF_AUFLIA)
(declare-const source (Array Int Int))
(declare-const current (Array Int Int))
(declare-const source_init (Array Int Bool))
(declare-const source_read (Array Int Bool))
(declare-const current_init (Array Int Bool))
(declare-const current_read (Array Int Bool))
(declare-const write_authority (Array Int Bool))
(declare-const changed Int)
(declare-const framed Int)
(declare-const replacement Int)
(set-option :produce-proofs true)
(assert (and (<= 0 (select source 0)) (< (select source 0) 256)))
(assert (and (<= 0 (select source 1)) (< (select source 1) 256)))
(assert (and (<= 0 (select current 0)) (< (select current 0) 256)))
(assert (and (<= 0 (select current 1)) (< (select current 1) 256)))
(assert (and (<= 0 replacement) (< replacement 256)))
(assert (or (= changed 0) (= changed 1)))
(assert (or (= framed 0) (= framed 1)))
(assert (select source_init 0))
(assert (select source_read 0))
(assert (select source_init 1))
(assert (select source_read 1))
(assert (select current_init 0))
(assert (select current_read 0))
(assert (select current_init 1))
(assert (select current_read 1))
(assert (= (select source 0) (select current 0)))
(assert (= (select source 1) (select current 1)))
(assert (< (select source 0) 2))
(assert (< (select source 1) 2))
(assert (not (and (select current_init 0) (select current_read 0) (select current_init 1) (select current_read 1) (< (select current 0) 2) (< (select current 1) 2))))
(check-sat)
(get-proof)
