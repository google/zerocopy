/-! ### `programEq` Reflexivity (`s45_programEq_refl`) -/

private theorem s45_projElemEq_refl (e : ProjectionElem) : projElemEq e e = true := by
  cases e with
  | deref | unsupported => rfl
  | field idx ty =>
    exact bool_and_intro (nat_beq_refl idx) (mirTy_beq_refl ty)

private theorem s45_placeEq_refl (p : Place) : placeEq p p = true :=
  bool_and_intro (nat_beq_refl p.localId)
    (listRel_refl s45_projElemEq_refl p.projection)

private theorem s45_constLitEq_refl (l : ConstLit) : constLitEq l l = true := by
  cases l with
  | scalar b => exact bitvec_beq_refl b
  | zeroSized => rfl

private theorem s45_constOpEq_refl (c : ConstOperand) : constOpEq c c = true :=
  bool_and_intro (mirTy_beq_refl c.ty) (s45_constLitEq_refl c.lit)

private theorem s45_binOpEq_refl (op : BinOp) : binOpEq op op = true := by
  cases op <;> rfl

private theorem s45_unOpEq_refl (op : UnOp) : unOpEq op op = true := by
  cases op <;> rfl

private theorem s45_operandEq_refl (o : Operand) : operandEq o o = true := by
  cases o with
  | copy p | move p => exact s45_placeEq_refl p
  | constant c => exact s45_constOpEq_refl c

private theorem s45_rvalueEq_refl (rv : Rvalue) : rvalueEq rv rv = true := by
  cases rv with
  | use o => exact s45_operandEq_refl o
  | binaryOp op l r =>
    exact bool_and_intro
      (bool_and_intro (s45_binOpEq_refl op) (s45_operandEq_refl l))
      (s45_operandEq_refl r)
  | unaryOp op o =>
    exact bool_and_intro (s45_unOpEq_refl op) (s45_operandEq_refl o)
  | discriminant p => exact s45_placeEq_refl p
  | ref m p | addressOf m p =>
    exact bool_and_intro (mutability_beq_refl m) (s45_placeEq_refl p)
  | aggregateTuple fs => exact listRel_refl s45_operandEq_refl fs
  | unsupported => rfl

private theorem s45_stmtEq_refl (st : StatementKind) : stmtEq st st = true := by
  cases st with
  | assign d rv =>
    exact bool_and_intro (s45_placeEq_refl d) (s45_rvalueEq_refl rv)
  | storageLive i | storageDead i => exact nat_beq_refl i
  | nop | unsupported => rfl

private theorem s45_switchTargetsEq_refl (ts : SwitchTargets) :
    switchTargetsEq ts ts = true :=
  bool_and_intro (nat_beq_refl ts.otherwise)
    (listRel_refl
      (r := fun a b : BitVec 128 × BasicBlockId =>
        (a.1 == b.1) && Nat.beq a.2 b.2)
      (fun br => bool_and_intro (bitvec_beq_refl br.1) (nat_beq_refl br.2))
      ts.branches)

private theorem s45_unwindActionEq_refl (u : UnwindAction) :
    unwindActionEq u u = true := by
  cases u with
  | continue_ | unreachable | terminate => rfl
  | cleanup b => exact nat_beq_refl b

private theorem s45_assertKindEq_refl (k : AssertKind) : assertKindEq k k = true := by
  cases k with
  | overflow op => exact s45_binOpEq_refl op
  | overflowNeg | divByZero | remByZero | boundsCheck | misalignedPtrDeref
  | nullPtrDeref | unsupported => rfl

private theorem s45_optBlockEq_refl (ob : Option BasicBlockId) :
    optBlockEq ob ob = true := by
  cases ob with
  | none => rfl
  | some b => exact nat_beq_refl b

private theorem s45_terminatorEq_refl (t : TerminatorKind) :
    terminatorEq t t = true := by
  cases t with
  | goto tgt => exact nat_beq_refl tgt
  | switchInt d ts =>
    exact bool_and_intro (s45_operandEq_refl d) (s45_switchTargetsEq_refl ts)
  | return_ | unreachable | unwindResume | unsupported => rfl
  | assert c e m tgt u =>
    exact bool_and_intro
      (bool_and_intro
        (bool_and_intro
          (bool_and_intro (s45_operandEq_refl c) (bool_beq_refl e))
          (s45_assertKindEq_refl m))
        (nat_beq_refl tgt))
      (s45_unwindActionEq_refl u)
  | call f args d tgt u =>
    exact bool_and_intro
      (bool_and_intro
        (bool_and_intro
          (bool_and_intro (nat_beq_refl f) (listRel_refl s45_operandEq_refl args))
          (s45_placeEq_refl d))
        (s45_optBlockEq_refl tgt))
      (s45_unwindActionEq_refl u)

private theorem s45_blockEq_refl (bb : BasicBlock) : blockEq bb bb = true :=
  bool_and_intro
    (bool_and_intro (bool_beq_refl bb.cleanup)
      (listRel_refl s45_stmtEq_refl bb.statements))
    (s45_terminatorEq_refl bb.terminator)

private theorem s45_bodyHeaderEq_refl (b : Body) : bodyHeaderEq b b = true :=
  bool_and_intro
    (bool_and_intro
      (bool_and_intro (nat_beq_refl b.argumentCount)
        (mirTy_beqList_refl b.locals))
      (bool_beq_refl b.isUnsafe))
    (stringBeq_refl b.identity)

private theorem s45_bodyEq_refl (b : Body) : bodyEq b b = true :=
  bool_and_intro (s45_bodyHeaderEq_refl b)
    (listRel_refl s45_blockEq_refl b.basicBlocks)

private theorem s45_programEq_refl (p : Program) : programEq p p = true :=
  bool_and_intro (programHeaderEq_refl p) (listRel_refl s45_bodyEq_refl p.bodies)

/-! ### Step & Trace Metadata Preservation and `unitProgForDef` Commutation -/

private theorem s45_applyMoveToCopyLocal_identity (id : LocalId) (b : Body) :
    (applyMoveToCopyLocal id b).identity = b.identity := by
  unfold applyMoveToCopyLocal
  cases (!Nat.blt 0 id || !Nat.blt id b.locals.length ||
      bodyTakesAddressOf b id) with
  | true => rfl
  | false =>
    dsimp
    cases Trusted.MirSemantics.getElem? b.locals id with
    | none => rfl
    | some ty =>
      dsimp
      cases (!isPtrOrRefTy ty) with
      | true => rfl
      | false =>
        dsimp
        cases (!Nat.beq
              (iterateBackwardLiveIn id b (b.basicBlocks.length + 2)
                (b.basicBlocks.map (fun _ => false))).length
              b.basicBlocks.length ||
            !verifyBackwardLiveInLoop id
              (iterateBackwardLiveIn id b (b.basicBlocks.length + 2)
                (b.basicBlocks.map (fun _ => false)))
              0 b.basicBlocks) with
        | true => rfl
        | false => rfl

private theorem s45_applyMoveToCopyLocalsLoop_identity (b : Body) (idx rem : Nat) :
    (applyMoveToCopyLocalsLoop b idx rem).identity = b.identity := by
  induction rem generalizing b idx with
  | zero => rfl
  | succ r ih =>
    dsimp [applyMoveToCopyLocalsLoop]
    rw [ih (applyMoveToCopyLocal idx b) (idx + 1)]
    exact s45_applyMoveToCopyLocal_identity idx b

private theorem s45_applyMoveToCopyBody_identity (b : Body) :
    (applyMoveToCopyBody b).identity = b.identity := by
  unfold applyMoveToCopyBody
  cases (b.basicBlocks.isEmpty || !bodyAllLocalsInBounds b ||
      !bodyAllBlocksInBounds b || !storageAnnotationsInBounds b ||
      !bodyLocalsAdmittedRef b) with
  | true => rfl
  | false =>
    exact s45_applyMoveToCopyLocalsLoop_identity b 1 (b.locals.length - 1)

private theorem s45_listRel_id_map_mtc (bs : List Body) :
    listRel (fun b₁ b₂ : Body => stringBeq b₁.identity b₂.identity)
      bs (bs.map applyMoveToCopyBody) = true := by
  induction bs with
  | nil => rfl
  | cons b rest ih =>
    dsimp [List.map, listRel]
    rw [s45_applyMoveToCopyBody_identity b]
    exact bool_and_intro (stringBeq_refl b.identity) ih

private theorem s45_listRel_id_setElem? {bs bs' : List Body} {idx : Nat}
    {bSrc bTgt : Body}
    (hGet : Trusted.MirSemantics.getElem? bs idx = some bSrc)
    (hSet : setElem? bs idx bTgt = some bs')
    (hId : bTgt.identity = bSrc.identity) :
    listRel (fun b₁ b₂ : Body => stringBeq b₁.identity b₂.identity)
      bs bs' = true := by
  induction bs generalizing bs' idx with
  | nil => cases hGet
  | cons a rest ih =>
    cases idx with
    | zero =>
      dsimp [Trusted.MirSemantics.getElem?] at hGet
      injection hGet with hA; subst hA
      dsimp [setElem?] at hSet
      injection hSet with hBs; subst hBs
      dsimp [listRel]
      rw [hId]
      exact bool_and_intro (stringBeq_refl a.identity) (listRel_id_refl rest)
    | succ k =>
      dsimp [Trusted.MirSemantics.getElem?] at hGet
      dsimp [setElem?] at hSet
      cases hRec : setElem? rest k bTgt with
      | none => rw [hRec] at hSet; cases hSet
      | some rest' =>
        rw [hRec] at hSet
        injection hSet with hBs; subst hBs
        dsimp [listRel]
        exact bool_and_intro (stringBeq_refl a.identity) (ih hGet hRec)

private theorem s45_applyPropagateSsaRef_meta_and_unit (plan : RefPropPlan)
    (pSrc : Program) :
    (∀ pOut, applyPropagateSsaRef plan pSrc = some pOut →
      ProgramMetadataCompat pSrc pOut = true) ∧
    (∀ u : DefId,
      applyPropagateSsaRef plan (unitProgForDef pSrc u) =
        match applyPropagateSsaRef plan pSrc with
        | some pOut => some (unitProgForDef pOut u)
        | none => none) := by
  unfold applyPropagateSsaRef unitProgForDef
  dsimp
  cases hGet : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none =>
    exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
  | some bodySrc =>
    dsimp
    cases (bodySrc.basicBlocks.isEmpty ||
        !bodyAllLocalsInBounds bodySrc ||
        !bodyAllBlocksInBounds bodySrc ||
        !storageAnnotationsInBounds bodySrc ||
        !bodyLocalsAdmittedRef bodySrc ||
        !Nat.blt bodySrc.argumentCount plan.refLocal ||
        !Nat.blt plan.refLocal bodySrc.locals.length ||
        !Nat.blt plan.targetLocal bodySrc.locals.length ||
        Nat.beq plan.refLocal plan.targetLocal ||
        bodyTakesAddressOf bodySrc plan.refLocal) with
    | true =>
      exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
    | false =>
      dsimp
      cases Trusted.MirSemantics.getElem? bodySrc.locals plan.refLocal with
      | none => exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
      | some rTy =>
        cases Trusted.MirSemantics.getElem? bodySrc.locals plan.targetLocal with
        | none => exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
        | some xTy =>
          dsimp
          cases ptrPointeeInfo? rTy with
          | none => exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
          | some info =>
            cases info with
            | mk isSafeRef restInfo =>
              cases restInfo with
              | mk rMut innerTy =>
                dsimp
                cases (!MirTy.beq innerTy xTy ||
                    (isSafeRef && !isOpsemInhabitedTy innerTy) ||
                    ((isSafeRef && !isZeroSizedTy xTy) &&
                      !bodyExclusiveTargetBorrow bodySrc plan.refLocal
                        plan.targetLocal rTy)) with
                | true => exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
                | false =>
                  dsimp
                  cases (!Nat.beq
                        (iterateForwardAbsStates bodySrc plan.refLocal
                          plan.targetLocal rTy xTy (Mutability.beq rMut .mut)
                          isSafeRef (isSafeRef && !isZeroSizedTy xTy)
                          (8 * bodySrc.basicBlocks.length + 2)
                          (joinAtBlock
                            (bodySrc.basicBlocks.map (fun _ => .unreachable)) 0
                            (initAbsState bodySrc plan.refLocal
                              plan.targetLocal))).length
                        bodySrc.basicBlocks.length ||
                      !absLe
                        (initAbsState bodySrc plan.refLocal plan.targetLocal)
                        (getAbsState
                          (iterateForwardAbsStates bodySrc plan.refLocal
                            plan.targetLocal rTy xTy (Mutability.beq rMut .mut)
                            isSafeRef (isSafeRef && !isZeroSizedTy xTy)
                            (8 * bodySrc.basicBlocks.length + 2)
                            (joinAtBlock
                              (bodySrc.basicBlocks.map (fun _ => .unreachable))
                              0
                              (initAbsState bodySrc plan.refLocal
                                plan.targetLocal))) 0)) with
                  | true => exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
                  | false =>
                    dsimp
                    cases verifyAndRewriteBlocksLoop bodySrc.locals
                        plan.refLocal plan.targetLocal rTy xTy
                        (Mutability.beq rMut .mut) isSafeRef
                        (isSafeRef && !isZeroSizedTy xTy)
                        (iterateForwardAbsStates bodySrc plan.refLocal
                          plan.targetLocal rTy xTy (Mutability.beq rMut .mut)
                          isSafeRef (isSafeRef && !isZeroSizedTy xTy)
                          (8 * bodySrc.basicBlocks.length + 2)
                          (joinAtBlock
                            (bodySrc.basicBlocks.map (fun _ => .unreachable)) 0
                            (initAbsState bodySrc plan.refLocal
                              plan.targetLocal)))
                        0 bodySrc.basicBlocks with
                    | none => exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
                    | some blocksTgt =>
                      cases setElem? bodySrc.locals plan.refLocal .unit with
                      | none => exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
                      | some localsTgt =>
                        dsimp
                        cases bodyMentionsLocalExceptStorage plan.refLocal
                            { bodySrc with
                              locals := localsTgt,
                              basicBlocks := blocksTgt } with
                        | true => exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
                        | false =>
                          dsimp
                          cases hSetB : setElem? pSrc.bodies plan.defId
                              { bodySrc with
                                locals := localsTgt,
                                basicBlocks := blocksTgt } with
                          | none =>
                            exact ⟨fun _ h => (by cases h), fun _ => rfl⟩
                          | some bodiesTgt =>
                            dsimp
                            refine ⟨?_, fun _ => rfl⟩
                            intro pOut hEq
                            injection hEq with hP; subst hP
                            exact bool_and_intro
                              (programHeaderEq_of_eq rfl rfl rfl rfl)
                              (s45_listRel_id_setElem? hGet hSetB rfl)

private theorem s45_applyMirRefPropStep_meta {pSrc : Program} {step : RefPropStep}
    {pOut : Program}
    (hStep : applyMirRefPropStep pSrc step = some pOut) :
    ProgramMetadataCompat pSrc pOut = true := by
  cases step with
  | moveToCopy =>
    dsimp [applyMirRefPropStep] at hStep
    injection hStep with hEq; subst hEq
    exact bool_and_intro
      (programHeaderEq_of_eq rfl rfl rfl rfl)
      (s45_listRel_id_map_mtc pSrc.bodies)
  | propagateSsaRef plan =>
    dsimp [applyMirRefPropStep] at hStep
    exact (s45_applyPropagateSsaRef_meta_and_unit plan pSrc).1 pOut hStep

private theorem s45_applyMirRefPropStep_unit (pSrc : Program) (step : RefPropStep)
    (u : DefId) :
    applyMirRefPropStep (unitProgForDef pSrc u) step =
      match applyMirRefPropStep pSrc step with
      | some pOut => some (unitProgForDef pOut u)
      | none => none := by
  cases step with
  | moveToCopy => rfl
  | propagateSsaRef plan =>
    dsimp [applyMirRefPropStep]
    exact (s45_applyPropagateSsaRef_meta_and_unit plan pSrc).2 u

private theorem s45_applyMirRefPropTrace_unit (pSrc : Program) (trace : RefPropTrace)
    (u : DefId) :
    applyMirRefPropTrace (unitProgForDef pSrc u) trace =
      match applyMirRefPropTrace pSrc trace with
      | some pOut => some (unitProgForDef pOut u)
      | none => none := by
  induction trace generalizing pSrc with
  | nil => rfl
  | cons step rest ih =>
    dsimp [applyMirRefPropTrace]
    rw [s45_applyMirRefPropStep_unit pSrc step u]
    cases applyMirRefPropStep pSrc step with
    | none => rfl
    | some pMid => exact ih pMid

private theorem s45_applyMirRefPropTrace_sound_and_meta
    (hStepSound :
      ∀ (p₁ : Program) (step : RefPropStep) (p₂ : Program),
        checkMirRefPropStep p₁ step p₂ = true →
          FullSemanticEquivRef p₁ p₂)
    {pSrc : Program} {trace : RefPropTrace} {pOut : Program}
    (hTr : applyMirRefPropTrace pSrc trace = some pOut) :
    FullSemanticEquivRef pSrc pOut ∧
    ProgramMetadataCompat pSrc pOut = true := by
  induction trace generalizing pSrc with
  | nil =>
    dsimp [applyMirRefPropTrace] at hTr
    injection hTr with hEq; subst hEq
    exact ⟨fullSemanticEquivRef_refl pSrc, programMetadataCompat_refl pSrc⟩
  | cons step rest ih =>
    dsimp [applyMirRefPropTrace] at hTr
    cases hStep : applyMirRefPropStep pSrc step with
    | none => rw [hStep] at hTr; cases hTr
    | some pMid =>
      rw [hStep] at hTr
      have hChk : checkMirRefPropStep pSrc step pMid = true := by
        unfold checkMirRefPropStep
        rw [hStep]
        exact s45_programEq_refl pMid
      have hEq12 := hStepSound pSrc step pMid hChk
      have hMeta12 := s45_applyMirRefPropStep_meta hStep
      let ⟨hEq23, hMeta23⟩ := ih hTr
      exact ⟨fullSemanticEquivRef_trans
        (programMetadataCompat_bodies_len hMeta12) hEq12 hEq23,
        programMetadataCompat_trans hMeta12 hMeta23⟩

private theorem s45_checkMirRefPropTrace_sound_and_meta
    (hStepSound :
      ∀ (p₁ : Program) (step : RefPropStep) (p₂ : Program),
        checkMirRefPropStep p₁ step p₂ = true →
          FullSemanticEquivRef p₁ p₂)
    {pSrc : Program} {trace : RefPropTrace} {pTgt : Program}
    (hTrace : checkMirRefPropTrace pSrc trace pTgt = true) :
    FullSemanticEquivRef pSrc pTgt ∧
    ProgramMetadataCompat pSrc pTgt = true := by
  unfold checkMirRefPropTrace at hTrace
  cases hTr : applyMirRefPropTrace pSrc trace with
  | none => rw [hTr] at hTrace; cases hTrace
  | some pOut =>
    rw [hTr] at hTrace
    have hEq := programEq_eq hTrace
    subst hEq
    exact s45_applyMirRefPropTrace_sound_and_meta hStepSound hTr

private theorem s45_checkMirRefPropTrace_unit {pSrc : Program} {trace : RefPropTrace}
    {pTgt : Program} (u : DefId)
    (hTrace : checkMirRefPropTrace pSrc trace pTgt = true) :
    checkMirRefPropTrace (unitProgForDef pSrc u) trace
      (unitProgForDef pTgt u) = true := by
  unfold checkMirRefPropTrace at hTrace
  cases hTr : applyMirRefPropTrace pSrc trace with
  | none => rw [hTr] at hTrace; cases hTrace
  | some pOut =>
    rw [hTr] at hTrace
    have hEq := programEq_eq hTrace
    subst hEq
    unfold checkMirRefPropTrace
    rw [s45_applyMirRefPropTrace_unit pSrc trace u, hTr]
    exact s45_programEq_refl (unitProgForDef pOut u)

/-! ### Program-Wide & Crate/Unit Verification Transport -/

private theorem s45_bodies_isEmpty_eq_of_len {bs₁ bs₂ : List Body}
    (hLen : bs₁.length = bs₂.length) :
    bs₁.isEmpty = bs₂.isEmpty := by
  cases bs₁ with
  | nil =>
    cases bs₂ with
    | nil => rfl
    | cons _ _ => cases hLen
  | cons _ _ =>
    cases bs₂ with
    | nil => cases hLen
    | cons _ _ => rfl

private theorem s45_programVerifiedRef_iff {p₁ p₂ : Program} {specs : Specs}
    (hEquiv : FullSemanticEquivRef p₁ p₂)
    (hMeta : ProgramMetadataCompat p₁ p₂ = true)
    (hSpec : SpecsPropertyRefInvariant specs) :
    ProgramVerifiedRef p₁ specs ↔ ProgramVerifiedRef p₂ specs := by
  let ⟨hHdr, hRel⟩ := bool_and_true hMeta
  let ⟨hPw, hVer, hEnt, _⟩ := programHeaderEq_elim hHdr
  have hLen : p₁.bodies.length = p₂.bodies.length := listRel_length hRel
  have hIsEmpty := s45_bodies_isEmpty_eq_of_len hLen
  have hUniq := bodiesHaveUniqueIdentities_eq_of_rel hRel
  have hProp := hSpec p₁ p₂ hEquiv
  let ⟨_, _, hBodyEq⟩ := hEquiv
  unfold ProgramVerifiedRef
  rw [hPw, hVer, hIsEmpty, hEnt, hLen, hUniq]
  constructor
  · intro ⟨h1, h2, h3, h4, h5, hB1, hP1⟩
    refine ⟨h1, h2, h3, h4, h5, ?_, hProp.mp hP1⟩
    intro d b₂ hG2
    let ⟨b₁, hG1, hIdB⟩ := listRel_getElem?_right hRel hG2
    have hIdEq : b₁.identity = b₂.identity := stringBeq_eq hIdB
    have hBV1 := hB1 d b₁ hG1
    rw [hIdEq] at hBV1
    exact (hBodyEq d b₁ b₂ (specs.safety b₂.identity) hG1 hG2).mpr hBV1
  · intro ⟨h1, h2, h3, h4, h5, hB2, hP2⟩
    refine ⟨h1, h2, h3, h4, h5, ?_, hProp.mpr hP2⟩
    intro d b₁ hG1
    let ⟨b₂, hG2, hIdB⟩ := listRel_getElem?_left hRel hG1
    have hIdEq : b₁.identity = b₂.identity := stringBeq_eq hIdB
    have hBV2 := hB2 d b₂ hG2
    rw [← hIdEq] at hBV2
    exact (hBodyEq d b₁ b₂ (specs.safety b₁.identity) hG1 hG2).mp hBV2

private theorem s45_crate_and_unit_ref_iff {p₁ p₂ : Program} {specs : Specs}
    (hEquiv : FullSemanticEquivRef p₁ p₂)
    (hMeta : ProgramMetadataCompat p₁ p₂ = true)
    (hSpec : SpecsPropertyRefInvariant specs) :
    (CrateTheoremRef ⟨p₁, specs⟩ ↔ CrateTheoremRef ⟨p₂, specs⟩) ∧
    (UnitTheoremRef ⟨p₁, specs⟩ ↔ UnitTheoremRef ⟨p₂, specs⟩) := by
  let ⟨hHdr, _⟩ := bool_and_true hMeta
  let ⟨_, _, _, hSc⟩ := programHeaderEq_elim hHdr
  have hPV := s45_programVerifiedRef_iff hEquiv hMeta hSpec
  constructor
  · unfold CrateTheoremRef
    dsimp
    rw [hSc]
    exact ⟨fun ⟨hs, hp⟩ => ⟨hs, hPV.mp hp⟩, fun ⟨hs, hp⟩ => ⟨hs, hPV.mpr hp⟩⟩
  · unfold UnitTheoremRef
    dsimp
    rw [hSc]
    exact ⟨fun ⟨hs, hp⟩ => ⟨hs, hPV.mp hp⟩, fun ⟨hs, hp⟩ => ⟨hs, hPV.mpr hp⟩⟩

private theorem s45_fullSemanticEquivRef_of_trusted_equiv {pFlat pOpt : Program}
    (hFreeFlat : isRefFreeProgram pFlat = true)
    (hFreeOpt : isRefFreeProgram pOpt = true)
    (hPostOpt : FullSemanticEquiv pFlat pOpt) :
    FullSemanticEquivRef pFlat pOpt := by
  have hExtFlat := (refPtr_conservative_extension_exact_slice1 pFlat).2.2 hFreeFlat
  have hExtOpt := (refPtr_conservative_extension_exact_slice1 pOpt).2.2 hFreeOpt
  let ⟨hQFlat, hPFlat, hBFlat, _⟩ := hExtFlat
  let ⟨hQOpt, hPOpt, hBOpt, _⟩ := hExtOpt
  let ⟨hQPost, hPPost, hBPost⟩ := hPostOpt
  refine ⟨?_, ?_, ?_⟩
  · intro q
    let ⟨hwF, hbF, hfF, hdF⟩ := hQFlat q
    let ⟨hwO, hbO, hfO, hdO⟩ := hQOpt q
    let ⟨hwP, hbP, hfP, hdP⟩ := hQPost q
    exact ⟨hwO.trans (hwP.trans hwF.symm),
      fun out => (hbO out).trans ((hbP out).trans (hbF out).symm),
      fun k => (hfO k).trans ((hfP k).trans (hfF k).symm),
      hdO.trans (hdP.trans hdF.symm)⟩
  · intro q post
    exact (hPOpt q post).trans ((hPPost q post).trans (hPFlat q post).symm)
  · intro defId bFlat bOpt safetyPre hGF hGO
    exact (hBOpt defId bOpt safetyPre).trans
      ((hBPost defId bFlat bOpt safetyPre hGF hGO).trans
        (hBFlat defId bFlat safetyPre).symm)

/-! ### Theorems 4 & 5 (`Slice4_5_TraceAndVc`) -/

private theorem mirRefPropTrace_reduces_to_trusted_mir_slice4
    (hStepSound :
      ∀ (p₁ : Program) (step : RefPropStep) (p₂ : Program),
        checkMirRefPropStep p₁ step p₂ = true →
          FullSemanticEquivRef p₁ p₂)
    (pSrc : Program) (trace : RefPropTrace) (pFlat : Program)
    (specs : Specs)
    (hTrace : checkMirRefPropTrace pSrc trace pFlat = true)
    (hRefFree : isRefFreeProgram pFlat = true)
    (hSpec : SpecsPropertyRefInvariant specs) :
    (∀ q : Query,
      (WellFormedRef pSrc q ↔ WellFormed pFlat q) ∧
      (∀ out : TerminalOut, BehaviorRef pSrc q out ↔ Behavior pFlat q out) ∧
      (∀ k : FaultKind,
        ReachesResultRef pSrc q (.fault k) ↔
          ReachesResult pFlat q (.fault k)) ∧
      (DivergesRef pSrc q ↔ Diverges pFlat q)) ∧
    (∀ (q : Query) (post : TerminalOut → Prop),
      SatisfiesPostRef pSrc q post ↔ SatisfiesPost pFlat q post) ∧
    (CrateTheoremRef ⟨pSrc, specs⟩ ↔ CrateTheorem ⟨pFlat, specs⟩) ∧
    (UnitTheoremRef ⟨pSrc, specs⟩ ↔ UnitTheorem ⟨pFlat, specs⟩) ∧
    (∀ u : DefId,
      UnitTheoremRef ⟨unitProgForDef pSrc u, specs⟩ ↔
        UnitTheorem ⟨unitProgForDef pFlat u, specs⟩) := by
  let ⟨hEquiv, hMeta⟩ :=
    s45_checkMirRefPropTrace_sound_and_meta hStepSound hTrace
  let ⟨hQEq, hPEq, _⟩ := hEquiv
  let ⟨hCrEq, hUnEq⟩ := s45_crate_and_unit_ref_iff hEquiv hMeta hSpec
  let ⟨hQExt, hPExt, _, hCUExt⟩ :=
    (refPtr_conservative_extension_exact_slice1 pFlat).2.2 hRefFree
  let ⟨hCrExt, hUnExt⟩ := hCUExt specs
  refine ⟨?_, ?_, hCrEq.trans hCrExt, hUnEq.trans hUnExt, ?_⟩
  · intro q
    let ⟨hwE, hbE, hfE, hdE⟩ := hQEq q
    let ⟨hwX, hbX, hfX, hdX⟩ := hQExt q
    exact ⟨hwE.symm.trans hwX,
      fun out => (hbE out).symm.trans (hbX out),
      fun k => (hfE k).symm.trans (hfX k),
      hdE.symm.trans hdX⟩
  · intro q post
    exact (hPEq q post).symm.trans (hPExt q post)
  · intro u
    have hTraceU := s45_checkMirRefPropTrace_unit u hTrace
    have hRefFreeU : isRefFreeProgram (unitProgForDef pFlat u) = true :=
      hRefFree
    let ⟨hEquivU, hMetaU⟩ :=
      s45_checkMirRefPropTrace_sound_and_meta hStepSound hTraceU
    let ⟨_, hUnEqU⟩ := s45_crate_and_unit_ref_iff hEquivU hMetaU hSpec
    let ⟨_, _, _, hCUExtU⟩ :=
      (refPtr_conservative_extension_exact_slice1
        (unitProgForDef pFlat u)).2.2 hRefFreeU
    exact hUnEqU.trans (hCUExtU specs).2

private theorem mirRefProp_then_optPipeline_vc_transport_slice5
    (hStepSound :
      ∀ (p₁ : Program) (step : RefPropStep) (p₂ : Program),
        checkMirRefPropStep p₁ step p₂ = true →
          FullSemanticEquivRef p₁ p₂)
    (pSrc : Program) (trace : RefPropTrace) (pFlat pOpt : Program)
    (specs : Specs)
    (hTrace : checkMirRefPropTrace pSrc trace pFlat = true)
    (hRefFreeMid : isRefFreeProgram pFlat = true)
    (hRefFreeOpt : isRefFreeProgram pOpt = true)
    (hMeta : ProgramMetadataCompat pFlat pOpt = true)
    (hPostOpt : FullSemanticEquiv pFlat pOpt)
    (hSpec : SpecsPropertyRefInvariant specs) :
    (∀ q : Query,
      (WellFormedRef pSrc q ↔ WellFormed pOpt q) ∧
      (∀ out : TerminalOut, BehaviorRef pSrc q out ↔ Behavior pOpt q out) ∧
      (∀ k : FaultKind,
        ReachesResultRef pSrc q (.fault k) ↔
          ReachesResult pOpt q (.fault k)) ∧
      (DivergesRef pSrc q ↔ Diverges pOpt q)) ∧
    (∀ (q : Query) (post : TerminalOut → Prop),
      SatisfiesPostRef pSrc q post ↔ SatisfiesPost pOpt q post) ∧
    (CrateTheoremRef ⟨pSrc, specs⟩ ↔ CrateTheorem ⟨pOpt, specs⟩) ∧
    (UnitTheoremRef ⟨pSrc, specs⟩ ↔ UnitTheorem ⟨pOpt, specs⟩) := by
  let ⟨hEquiv12, hMeta12⟩ :=
    s45_checkMirRefPropTrace_sound_and_meta hStepSound hTrace
  have hEquiv23 :=
    s45_fullSemanticEquivRef_of_trusted_equiv hRefFreeMid hRefFreeOpt hPostOpt
  have hEquiv13 :=
    fullSemanticEquivRef_trans (programMetadataCompat_bodies_len hMeta12)
      hEquiv12 hEquiv23
  have hMeta13 := programMetadataCompat_trans hMeta12 hMeta
  let ⟨hQEq, hPEq, _⟩ := hEquiv13
  let ⟨hCrEq, hUnEq⟩ := s45_crate_and_unit_ref_iff hEquiv13 hMeta13 hSpec
  let ⟨hQExt, hPExt, _, hCUExt⟩ :=
    (refPtr_conservative_extension_exact_slice1 pOpt).2.2 hRefFreeOpt
  let ⟨hCrExt, hUnExt⟩ := hCUExt specs
  refine ⟨?_, ?_, hCrEq.trans hCrExt, hUnEq.trans hUnExt⟩
  · intro q
    let ⟨hwE, hbE, hfE, hdE⟩ := hQEq q
    let ⟨hwX, hbX, hfX, hdX⟩ := hQExt q
    exact ⟨hwE.symm.trans hwX,
      fun out => (hbE out).symm.trans (hbX out),
      fun k => (hfE k).symm.trans (hfX k),
      hdE.symm.trans hdX⟩
  · intro q post
    exact (hPEq q post).symm.trans (hPExt q post)

/-! ### Combined Step Dispatcher -/

private theorem mirRefPropStep_sound_combined
    (pSrc : Program) (step : RefPropStep) (pTgt : Program)
    (hStep : checkMirRefPropStep pSrc step pTgt = true) :
    FullSemanticEquivRef pSrc pTgt := by
  unfold checkMirRefPropStep applyMirRefPropStep at hStep
  cases step with
  | moveToCopy =>
    exact moveToCopyPointers_sound_bidirectional_iff_slice2 pSrc pTgt hStep
  | propagateSsaRef plan =>
    dsimp at hStep
    cases hProp : applyPropagateSsaRef plan pSrc with
    | none => rw [hProp] at hStep; cases hStep
    | some pOut =>
      rw [hProp] at hStep
      have hEq : pOut = pTgt := programEq_eq hStep
      subst hEq
      exact propagateSsaRef_sound_bidirectional_iff_slice3b plan pSrc pOut hProp

/-! ## Part III: Five Core Target Theorems Over `Trusted.MirSemantics` -/

/-- **Theorem 1 (Exact Conservative Extension of `M_refPtr` Over Unmodified
`Trusted.MirSemantics`):**
1. Every `s : State` embeds cleanly via `projectStateRef (embedState s) = some
s`, and on any `p : Program`, any `c : Choice`, and any `sRef : ExecStateRef`
projecting to `s : State` (`projectStateRef sRef = some s`) whose active body
(if in bounds) is ref-free (`stepIsRefFree p s = true`), `evalStepRef p c sRef`
projects via `projectStepResultRef` to `some (evalStep p c s)`.
2. Whenever `isRefFreeProgram p = true`, `WellFormedRef`, `BehaviorRef`,
`ReachesResultRef (.fault k)`, `DivergesRef`, `SatisfiesPostRef`,
`BodyVerifiedRef`, `CrateTheoremRef`, and `UnitTheoremRef` are bidirectionally
equivalent (`↔`) to Anneal's unmodified `Trusted.MirSemantics` judgments. -/
theorem refPtr_conservative_extension_exact
    (p : Program) :
    (∀ s : State, projectStateRef (embedState s) = some s) ∧
    (∀ (c : Choice) (sRef : ExecStateRef) (s : State),
      projectStateRef sRef = some s →
      stepIsRefFree p s = true →
      projectStepResultRef (evalStepRef p c sRef) =
        some (evalStep p c s)) ∧
    (isRefFreeProgram p = true →
      (∀ q : Query,
        (WellFormedRef p q ↔ WellFormed p q) ∧
        (∀ out : TerminalOut, BehaviorRef p q out ↔ Behavior p q out) ∧
        (∀ k : FaultKind,
          ReachesResultRef p q (.fault k) ↔ ReachesResult p q (.fault k)) ∧
        (DivergesRef p q ↔ Diverges p q)) ∧
      (∀ (q : Query) (post : TerminalOut → Prop),
        SatisfiesPostRef p q post ↔ SatisfiesPost p q post) ∧
      (∀ (defId : DefId) (body : Body) (safetyPre : List Val → Prop),
        BodyVerifiedRef p defId body safetyPre ↔
          BodyVerified p defId body safetyPre) ∧
      (∀ specs : Specs,
        (CrateTheoremRef ⟨p, specs⟩ ↔ CrateTheorem ⟨p, specs⟩) ∧
        (UnitTheoremRef ⟨p, specs⟩ ↔ UnitTheorem ⟨p, specs⟩))) := by
  exact refPtr_conservative_extension_exact_slice1 p

/-- **Theorem 2 (Certified `MoveToCopyPointers` Bidirectional Soundness):**
For any `pSrc pTgt : Program`, `checkMoveToCopyPointers pSrc pTgt = true`
implies `FullSemanticEquivRef pSrc pTgt` (`↔` across `WellFormedRef`,
`BehaviorRef`, exact fault kinds, `DivergesRef`, `SatisfiesPostRef`, and
`BodyVerifiedRef` under `deinitMovedPlace = true` and single-slot Tree
Borrows). -/
theorem moveToCopyPointers_sound_bidirectional_iff
    (pSrc pTgt : Program)
    (hMoveToCopy : checkMoveToCopyPointers pSrc pTgt = true) :
    FullSemanticEquivRef pSrc pTgt := by
  exact moveToCopyPointers_sound_bidirectional_iff_slice2 pSrc pTgt hMoveToCopy

/-- **Theorem 3 (Single-Step `ReferencePropagation` Bidirectional Soundness):**
For any `step : RefPropStep` and `pSrc pTgt : Program`,
`checkMirRefPropStep pSrc step pTgt = true` implies
`FullSemanticEquivRef pSrc pTgt` (`↔` across `WellFormedRef`, `BehaviorRef`,
exact fault kinds, `DivergesRef`, `SatisfiesPostRef`, and `BodyVerifiedRef`,
preserving mutability UB, single-slot Tree Borrows aliasing UB, allocation-epoch
ABA UB, dangling-deref UB, `skipValidityForSimpleDeref` fault order, indirect
self-overlap UB, and `Operand.move` pointee deinitialization). -/
theorem mirRefPropStep_sound_bidirectional_iff
    (pSrc : Program) (step : RefPropStep) (pTgt : Program)
    (hStep : checkMirRefPropStep pSrc step pTgt = true) :
    FullSemanticEquivRef pSrc pTgt := by
  exact mirRefPropStep_sound_combined pSrc step pTgt hStep

/-- **Theorem 4 (`ReferencePropagation` Trace Reduction Into Anneal's Unmodified
`Trusted.MirSemantics`):**
Whenever `checkMirRefPropTrace pSrc trace pFlat = true`,
`isRefFreeProgram pFlat = true`, and `SpecsPropertyRefInvariant specs`,
verification of `pSrc` in `M_refPtr` (`WellFormedRef`, `BehaviorRef`,
`ReachesResultRef (.fault k)`, `DivergesRef`, `SatisfiesPostRef`,
`CrateTheoremRef`, and `UnitTheoremRef` across both whole-crate subjects and
arbitrary per-item proof units `u : DefId`) reduces bidirectionally (`↔`)
directly to Anneal's unmodified `Trusted.MirSemantics` on `pFlat`. -/
theorem mirRefPropTrace_reduces_to_trusted_mir
    (pSrc : Program) (trace : RefPropTrace) (pFlat : Program)
    (specs : Specs)
    (hTrace : checkMirRefPropTrace pSrc trace pFlat = true)
    (hRefFree : isRefFreeProgram pFlat = true)
    (hSpec : SpecsPropertyRefInvariant specs) :
    (∀ q : Query,
      (WellFormedRef pSrc q ↔ WellFormed pFlat q) ∧
      (∀ out : TerminalOut, BehaviorRef pSrc q out ↔ Behavior pFlat q out) ∧
      (∀ k : FaultKind,
        ReachesResultRef pSrc q (.fault k) ↔
          ReachesResult pFlat q (.fault k)) ∧
      (DivergesRef pSrc q ↔ Diverges pFlat q)) ∧
    (∀ (q : Query) (post : TerminalOut → Prop),
      SatisfiesPostRef pSrc q post ↔ SatisfiesPost pFlat q post) ∧
    (CrateTheoremRef ⟨pSrc, specs⟩ ↔ CrateTheorem ⟨pFlat, specs⟩) ∧
    (UnitTheoremRef ⟨pSrc, specs⟩ ↔ UnitTheorem ⟨pFlat, specs⟩) ∧
    (∀ u : DefId,
      UnitTheoremRef ⟨unitProgForDef pSrc u, specs⟩ ↔
        UnitTheorem ⟨unitProgForDef pFlat u, specs⟩) := by
  exact mirRefPropTrace_reduces_to_trusted_mir_slice4 mirRefPropStep_sound_combined pSrc trace pFlat specs hTrace hRefFree hSpec

/-- **Theorem 5 (Vertical Composition With Post-`RefProp` `Trusted.MirSemantics`
Optimization Pipelines):**
Composing `checkMirRefPropTrace pSrc trace pFlat = true` with any
post-propagation intraprocedural equivalence `FullSemanticEquiv pFlat pOpt`
(such as the 5-family `MirOptTrace` pipeline in `F1-5`--`F1-9`) preserving
ref-freedom and program metadata transports `WellFormedRef`, `BehaviorRef`,
`ReachesResultRef (.fault k)`, `DivergesRef`, `SatisfiesPostRef`,
`CrateTheoremRef`, and `UnitTheoremRef` bidirectionally (`↔`) directly to
unmodified `Trusted.MirSemantics` on `pOpt`. (Note: because `FullSemanticEquiv
pFlat pOpt` pins `entryDefId` on top-level execution judgments, per-item proof
units `u : DefId` instantiate this theorem on `(unitProgForDef pSrc u,
unitProgForDef pFlat u, unitProgForDef pOpt u)`.) -/
theorem mirRefProp_then_optPipeline_vc_transport
    (pSrc : Program) (trace : RefPropTrace) (pFlat pOpt : Program)
    (specs : Specs)
    (hTrace : checkMirRefPropTrace pSrc trace pFlat = true)
    (hRefFreeMid : isRefFreeProgram pFlat = true)
    (hRefFreeOpt : isRefFreeProgram pOpt = true)
    (hMeta : ProgramMetadataCompat pFlat pOpt = true)
    (hPostOpt : FullSemanticEquiv pFlat pOpt)
    (hSpec : SpecsPropertyRefInvariant specs) :
    (∀ q : Query,
      (WellFormedRef pSrc q ↔ WellFormed pOpt q) ∧
      (∀ out : TerminalOut, BehaviorRef pSrc q out ↔ Behavior pOpt q out) ∧
      (∀ k : FaultKind,
        ReachesResultRef pSrc q (.fault k) ↔
          ReachesResult pOpt q (.fault k)) ∧
      (DivergesRef pSrc q ↔ Diverges pOpt q)) ∧
    (∀ (q : Query) (post : TerminalOut → Prop),
      SatisfiesPostRef pSrc q post ↔ SatisfiesPost pOpt q post) ∧
    (CrateTheoremRef ⟨pSrc, specs⟩ ↔ CrateTheorem ⟨pOpt, specs⟩) ∧
    (UnitTheoremRef ⟨pSrc, specs⟩ ↔ UnitTheorem ⟨pOpt, specs⟩) := by
  exact mirRefProp_then_optPipeline_vc_transport_slice5 mirRefPropStep_sound_combined pSrc trace pFlat pOpt specs hTrace hRefFreeMid hRefFreeOpt hMeta hPostOpt hSpec

/-! ## Part IV: Adequacy, Counterexamples (`CE1`--`CE13`), & Witness -/

/-! ### Deterministic Fuel-Indexed Adequacy (`Trusted.MirSemantics`) -/

noncomputable def execOutcome (p : Program) (onDone : TerminalOut → Prop)
    (onFault : FaultKind → Prop) : Nat → State → Prop
  | 0, _ => False
  | fuel + 1, s =>
    match evalStep p 0 s with
    | .step s' => execOutcome p onDone onFault fuel s'
    | .done out => onDone out
    | .fault k => onFault k

noncomputable def execReturns (p : Program) (fuel : Nat) (q : Query)
    (expected : Val) : Prop :=
  match initState p q with
  | .error _ => False
  | .ok s₀ =>
    execOutcome p (fun out => out = .returned ⟨expected, ⟨[]⟩⟩)
      (fun _ => False) fuel s₀

noncomputable def execFaults (p : Program) (fuel : Nat) (q : Query)
    (expected : FaultKind) : Prop :=
  match initState p q with
  | .error k => k = expected
  | .ok s₀ =>
    execOutcome p (fun _ => False) (fun k => k = expected) fuel s₀

theorem reaches_head_det {p : Program} {s₁ s₂ s₃ : State}
    (hFirst : Step p s₁ (.step s₂)) (hRest : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction hRest with
  | refl => exact Reaches.tail (Reaches.refl s₁) hFirst
  | tail _ hLast ih => exact Reaches.tail ih hLast

theorem execOutcome_reaches_inv {p : Program}
    {onDone : TerminalOut → Prop} {onFault : FaultKind → Prop}
    {s₁ s₂ : State} {fuel : Nat}
    (hExec : execOutcome p onDone onFault fuel s₁)
    (hReach : Reaches p s₁ s₂) :
    ∃ fuel', execOutcome p onDone onFault fuel' s₂ := by
  induction hReach with
  | refl => exact ⟨fuel, hExec⟩
  | tail _ hStep ih =>
    let ⟨f, hf⟩ := ih
    cases f with
    | zero => exact False.elim hf
    | succ f' =>
      let ⟨c, hc, hEval⟩ := hStep
      have hc0 : c = 0 := hc
      subst hc0
      dsimp [execOutcome] at hf
      rw [hEval] at hf
      exact ⟨f', hf⟩

theorem execOutcome_terminal {p : Program}
    {onDone : TerminalOut → Prop} {onFault : FaultKind → Prop}
    {fuel : Nat} {s : State}
    (hExec : execOutcome p onDone onFault fuel s) :
    ∃ sEnd res, Reaches p s sEnd ∧ Step p sEnd res ∧
      match res with
      | .step _ => False
      | .done out => onDone out
      | .fault k => onFault k := by
  induction fuel generalizing s with
  | zero => exact False.elim hExec
  | succ f ih =>
    dsimp [execOutcome] at hExec
    cases hEval : evalStep p 0 s with
    | step s' =>
      rw [hEval] at hExec
      let ⟨sEnd, res, hR, hT, hPost⟩ := ih hExec
      exact ⟨sEnd, res, reaches_head_det ⟨0, rfl, hEval⟩ hR, hT, hPost⟩
    | done out =>
      rw [hEval] at hExec
      exact ⟨s, .done out, Reaches.refl s, ⟨0, rfl, hEval⟩, hExec⟩
    | fault k =>
      rw [hEval] at hExec
      exact ⟨s, .fault k, Reaches.refl s, ⟨0, rfl, hEval⟩, hExec⟩

theorem positiveCanary_of_execReturns {p : Program} {fuel : Nat}
    {q : Query} {expected : Val}
    (h : execReturns p fuel q expected) :
    PositiveCanaryClaim p q expected := by
  unfold execReturns at h
  cases hInit : initState p q with
  | error _ =>
    rw [hInit] at h
    exact False.elim h
  | ok s₀ =>
    rw [hInit] at h
    refine ⟨⟨⟨s₀, hInit, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩, ?_⟩
    · intro k hFault
      change (match initState p q with
        | .error k' => StepResult.fault k = .fault k'
        | .ok sInit => ∃ s, Reaches p sInit s ∧ Step p s (.fault k)) at hFault
      rw [hInit] at hFault
      let ⟨sF, hReach, c, hc, hEval⟩ := hFault
      have hc0 : c = 0 := hc
      subst hc0
      let ⟨f', hf'⟩ := execOutcome_reaches_inv h hReach
      cases f' with
      | zero => exact hf'
      | succ f'' =>
        dsimp [execOutcome] at hf'
        rw [hEval] at hf'
        exact hf'
    · change (match initState p q with
        | .error k' =>
          (StepResult.done (TerminalOut.returned ⟨expected, ⟨[]⟩⟩) :
            StepResult State TerminalOut) = .fault k'
        | .ok sInit =>
          ∃ s, Reaches p sInit s ∧
            Step p s (.done (.returned ⟨expected, ⟨[]⟩⟩)))
      rw [hInit]
      let ⟨sEnd, res, hR, hStep, hRes⟩ := execOutcome_terminal h
      cases res with
      | step _ => exact False.elim hRes
      | fault _ => exact False.elim hRes
      | done out =>
        subst hRes
        exact ⟨sEnd, hR, hStep⟩

theorem negativeCanary_of_execFaults {p : Program} {fuel : Nat}
    {q : Query} {expectedFault otherFault : FaultKind}
    (hNe : otherFault ≠ expectedFault)
    (h : execFaults p fuel q expectedFault) :
    NegativeCanaryClaim p q expectedFault otherFault := by
  unfold execFaults at h
  cases hInit : initState p q with
  | error k =>
    rw [hInit] at h
    subst h
    refine ⟨?_, ?_, ?_⟩
    · change (match initState p q with
        | .error k' => StepResult.fault k = .fault k'
        | .ok sInit => ∃ s, Reaches p sInit s ∧ Step p s (.fault k))
      rw [hInit]
    · intro hOther
      change (match initState p q with
        | .error k' => StepResult.fault otherFault = .fault k'
        | .ok sInit =>
          ∃ s, Reaches p sInit s ∧ Step p s (.fault otherFault)) at hOther
      rw [hInit] at hOther
      cases hOther
      exact hNe rfl
    · intro hWf
      let ⟨⟨_, hOk, _⟩, _⟩ := hWf
      rw [hInit] at hOk
      cases hOk
  | ok s₀ =>
    rw [hInit] at h
    have hReachExp : ReachesResult p q (.fault expectedFault) := by
      change (match initState p q with
        | .error k' => StepResult.fault expectedFault = .fault k'
        | .ok sInit =>
          ∃ s, Reaches p sInit s ∧ Step p s (.fault expectedFault))
      rw [hInit]
      let ⟨sEnd, res, hR, hStep, hRes⟩ := execOutcome_terminal h
      cases res with
      | step _ => exact False.elim hRes
      | done _ => exact False.elim hRes
      | fault k =>
        subst hRes
        exact ⟨sEnd, hR, hStep⟩
    refine ⟨hReachExp, ?_, ?_⟩
    · intro hOther
      change (match initState p q with
        | .error k' => StepResult.fault otherFault = .fault k'
        | .ok sInit =>
          ∃ s, Reaches p sInit s ∧ Step p s (.fault otherFault)) at hOther
      rw [hInit] at hOther
      let ⟨sF, hReach, c, hc, hEval⟩ := hOther
      have hc0 : c = 0 := hc
      subst hc0
      let ⟨f', hf'⟩ := execOutcome_reaches_inv h hReach
      cases f' with
      | zero => exact hf'
      | succ f'' =>
        dsimp [execOutcome] at hf'
        rw [hEval] at hf'
        exact hNe hf'
    · intro hWf
      exact hWf.2 expectedFault hReachExp

/-! ### Deterministic Fuel-Indexed Adequacy for `M_refPtr` -/

/-- Whether a `StepResult` is terminal (`.done _` or `.fault _`). -/
noncomputable def isTerminalStepResult {α β : Type} :
    StepResult α β → Prop
  | .step _ => False
  | .done _ => True
  | .fault _ => True

/-- Standard positive normal-return canary in `M_refPtr`: `WellFormedRef` and
returns `expectedRet` with empty `callerMem`. -/
noncomputable def PositiveCanaryClaimRef (p : Program) (q : Query)
    (expectedRet : Val) : Prop :=
  WellFormedRef p q ∧ BehaviorRef p q (.returned ⟨expectedRet, ⟨[]⟩⟩)

/-- Standard negative fault canary in `M_refPtr`: reaches
`.fault expectedFault`, never reaches `.fault otherFault`, and refutes
`WellFormedRef`. -/
noncomputable def NegativeCanaryClaimRef (p : Program) (q : Query)
    (expectedFault otherFault : FaultKind) : Prop :=
  ReachesResultRef p q (.fault expectedFault) ∧
  ¬ ReachesResultRef p q (.fault otherFault) ∧
  ¬ WellFormedRef p q

noncomputable def execReturnsRef (p : Program) (fuel : Nat) (q : Query)
    (expected : Val) : Prop :=
  match initStateRef p q with
  | .error _ => False
  | .ok s₀ => evalRefFuel p fuel s₀ = .done (.returned ⟨expected, ⟨[]⟩⟩)

noncomputable def execFaultsRef (p : Program) (fuel : Nat) (q : Query)
    (expected : FaultKind) : Prop :=
  match initStateRef p q with
  | .error k => k = expected
  | .ok s₀ => evalRefFuel p fuel s₀ = .fault expected

theorem reachesRef_head_det {p : Program} {s₁ s₂ s₃ : ExecStateRef}
    (hFirst : StepRef p s₁ (.step s₂)) (hRest : ReachesRef p s₂ s₃) :
    ReachesRef p s₁ s₃ := by
  induction hRest with
  | refl => exact ReachesRef.tail (ReachesRef.refl s₁) hFirst
  | tail _ hLast ih => exact ReachesRef.tail ih hLast

theorem execRef_reaches_inv {p : Program}
    {res : StepResult ExecStateRef TerminalOut}
    {s₁ s₂ : ExecStateRef} {fuel : Nat}
    (hExec : evalRefFuel p fuel s₁ = res)
    (hTerm : isTerminalStepResult res)
    (hReach : ReachesRef p s₁ s₂) :
    ∃ fuel', evalRefFuel p fuel' s₂ = res := by
  induction hReach with
  | refl => exact ⟨fuel, hExec⟩
  | tail _ hStep ih =>
    let ⟨f, hf⟩ := ih
    cases f with
    | zero =>
      dsimp [evalRefFuel] at hf
      subst hf
      exact False.elim hTerm
    | succ f' =>
      let ⟨c, hc, hEval⟩ := hStep
      have hc0 : c = 0 := hc
      subst hc0
      dsimp [evalRefFuel] at hf
      rw [hEval] at hf
      exact ⟨f', hf⟩

theorem execRef_terminal {p : Program}
    {res : StepResult ExecStateRef TerminalOut}
    {fuel : Nat} {s : ExecStateRef}
    (hExec : evalRefFuel p fuel s = res)
    (hTerm : isTerminalStepResult res) :
    ∃ sEnd, ReachesRef p s sEnd ∧ StepRef p sEnd res := by
  induction fuel generalizing s with
  | zero =>
    dsimp [evalRefFuel] at hExec
    subst hExec
    exact False.elim hTerm
  | succ f ih =>
    dsimp [evalRefFuel] at hExec
    cases hEval : evalStepRef p 0 s with
    | step s' =>
      rw [hEval] at hExec
      let ⟨sEnd, hR, hT⟩ := ih hExec
      exact ⟨sEnd, reachesRef_head_det ⟨0, rfl, hEval⟩ hR, hT⟩
    | done out =>
      rw [hEval] at hExec
      subst hExec
      exact ⟨s, ReachesRef.refl s, ⟨0, rfl, hEval⟩⟩
    | fault k =>
      rw [hEval] at hExec
      subst hExec
      exact ⟨s, ReachesRef.refl s, ⟨0, rfl, hEval⟩⟩

theorem positiveCanaryRef_of_exec {p : Program} {fuel : Nat}
    {q : Query} {expected : Val}
    (h : execReturnsRef p fuel q expected) :
    PositiveCanaryClaimRef p q expected := by
  unfold execReturnsRef at h
  cases hInit : initStateRef p q with
  | error _ =>
    rw [hInit] at h
    exact False.elim h
  | ok s₀ =>
    rw [hInit] at h
    refine ⟨⟨⟨s₀, hInit, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩, ?_⟩
    · intro k hFault
      unfold ReachesResultRef at hFault
      rw [hInit] at hFault
      let ⟨sF, hReach, c, hc, hEval⟩ := hFault
      have hc0 : c = 0 := hc
      subst hc0
      let ⟨f', hf'⟩ := execRef_reaches_inv h True.intro hReach
      cases f' with
      | zero =>
        dsimp [evalRefFuel] at hf'
        cases hf'
      | succ f'' =>
        dsimp [evalRefFuel] at hf'
        rw [hEval] at hf'
        cases hf'
    · unfold BehaviorRef ReachesResultRef
      rw [hInit]
      exact execRef_terminal h True.intro

theorem negativeCanaryRef_of_exec {p : Program} {fuel : Nat}
    {q : Query} {expectedFault otherFault : FaultKind}
    (hNe : otherFault ≠ expectedFault)
    (h : execFaultsRef p fuel q expectedFault) :
    NegativeCanaryClaimRef p q expectedFault otherFault := by
  unfold execFaultsRef at h
  cases hInit : initStateRef p q with
  | error k =>
    rw [hInit] at h
    subst h
    refine ⟨?_, ?_, ?_⟩
    · unfold ReachesResultRef; rw [hInit]
    · intro hOther
      unfold ReachesResultRef at hOther
      rw [hInit] at hOther
      cases hOther
      exact hNe rfl
    · intro hWf
      let ⟨⟨_, hOk, _⟩, _⟩ := hWf
      rw [hInit] at hOk
      cases hOk
  | ok s₀ =>
    rw [hInit] at h
    have hReachExp : ReachesResultRef p q (.fault expectedFault) := by
      unfold ReachesResultRef
      rw [hInit]
      exact execRef_terminal h True.intro
    refine ⟨hReachExp, ?_, ?_⟩
    · intro hOther
      unfold ReachesResultRef at hOther
      rw [hInit] at hOther
      let ⟨sF, hReach, c, hc, hEval⟩ := hOther
      have hc0 : c = 0 := hc
      subst hc0
      let ⟨f', hf'⟩ := execRef_reaches_inv h True.intro hReach
      cases f' with
      | zero =>
        dsimp [evalRefFuel] at hf'
        cases hf'
      | succ f'' =>
        dsimp [evalRefFuel] at hf'
        rw [hEval] at hf'
        injection hf' with hEq
        exact hNe hEq
    · intro hWf
      exact hWf.2 expectedFault hReachExp

/-! ### Convenience Type & Constant Builders for Part IV Canaries -/

noncomputable def refU32Ty : MirTy := .ref .shared u32Ty

noncomputable def refMutU32Ty : MirTy := .ref .mut u32Ty

noncomputable def rawConstU32Ty : MirTy := .rawPtr .shared u32Ty

noncomputable def rawMutU32Ty : MirTy := .rawPtr .mut u32Ty

noncomputable def u32Const (n : Nat) : Operand :=
  .constant ⟨u32Ty, .scalar (BitVec.ofNat 128 n)⟩

/-! ### Sharpness Counterexample 1 (`CE1`): Uninit Deref Faults `.undefined` -/

/-- Reading `_0 = copy (*_1)` from live-uninitialized `&u32` local `_1`. -/
noncomputable def progCe1UninitRefReadUb : Program where
  pointerWidthBits := 64
  mirProfileVersion := 1
  bodies := [{
    argumentCount := 0
    locals := [u32Ty, refU32Ty]
    identity := "ce1::uninit_ref_read_ub"
    basicBlocks := [{
      statements := [
        .storageLive 1,
        .assign ⟨0, []⟩ (.use (.copy ⟨1, [.deref]⟩))
      ]
      terminator := .return_
    }]
  }]

/-- Writing `*_1 = const 42_u32` through a live-but-uninitialized `*mut u32`
local `_1`. -/
noncomputable def progCe1UninitRawWriteUb : Program where
  pointerWidthBits := 64
  mirProfileVersion := 1
  bodies := [{
    argumentCount := 0
    locals := [u32Ty, rawMutU32Ty]
    identity := "ce1::uninit_raw_write_ub"
    basicBlocks := [{
      statements := [
        .storageLive 1,
        .assign ⟨1, [.deref]⟩ (.use (u32Const 42)),
        .assign ⟨0, []⟩ (.use (u32Const 0))
      ]
      terminator := .return_
    }]
  }]

/-- Taking `r = &mut x` while `x` is live-but-uninitialized succeeds (`x`'s
uninitialized scalar bytes are not read on `&mut x`), and writing `*r = 42`
followed by `_0 = copy (*r)` returns `42_u32`. -/
noncomputable def progCe1BorrowUninitThenInitOk : Program where
  pointerWidthBits := 64
  mirProfileVersion := 1
  bodies := [{
    argumentCount := 0
    locals := [u32Ty, u32Ty, refMutU32Ty]
    identity := "ce1::borrow_uninit_then_write_ok"
    basicBlocks := [{
      statements := [
        .storageLive 1,
        .storageLive 2,
        .assign ⟨2, []⟩ (.ref .mut ⟨1, []⟩),
        .assign ⟨2, [.deref]⟩ (.use (u32Const 42)),
        .assign ⟨0, []⟩ (.use (.copy ⟨2, [.deref]⟩)),
        .storageDead 2,
        .storageDead 1
      ]
      terminator := .return_
    }]
  }]

/-- **Sharpness Theorem CE1:** Dereferencing an uninitialized `&u32` (on read)
or `*mut u32` (on write) faults with `.fault .undefined`, whereas taking
`&mut x` on live-uninitialized `x`, initializing `*r = 42_u32`, and reading
`*r` returns `42_u32`. -/
theorem ce1_uninit_ptr_deref_faults_ub :
    NegativeCanaryClaimRef progCe1UninitRefReadUb queryEmpty
      .undefined .unsupported ∧
    NegativeCanaryClaimRef progCe1UninitRawWriteUb queryEmpty
      .undefined .unsupported ∧
    PositiveCanaryClaimRef progCe1BorrowUninitThenInitOk queryEmpty
      (u32Val 42) := by
  refine ⟨?_, ?_, ?_⟩
  · exact negativeCanaryRef_of_exec (fuel := 6) (by intro h; cases h) rfl
  · exact negativeCanaryRef_of_exec (fuel := 6) (by intro h; cases h) rfl
  · exact positiveCanaryRef_of_exec (fuel := 12) rfl

/-! ### Sharpness Counterexample 2 (`CE2`): ABA Epoch Mismatch UB -/

/-- `StorageLive(_1); _1 = 5; _2 = &_1; StorageDead(_1); StorageLive(_1);
_1 = 9; _0 = copy (*_2)`: `_1` is live and initialized to `9` at the dereference
site, yet `_2` carries `_1`'s retired epoch `2 ≠ 3` and faults `.undefined`! -/
noncomputable def progCe2AbaEpochMismatchUb : Program where
  pointerWidthBits := 64
  mirProfileVersion := 1
  bodies := [{
    argumentCount := 0
    locals := [u32Ty, u32Ty, refU32Ty]
    identity := "ce2::aba_epoch_mismatch_ub"
    basicBlocks := [{
      statements := [
        .storageLive 1,
        .assign ⟨1, []⟩ (.use (u32Const 5)),
        .storageLive 2,
        .assign ⟨2, []⟩ (.ref .shared ⟨1, []⟩),
        .storageDead 1,
        .storageLive 1,
        .assign ⟨1, []⟩ (.use (u32Const 9)),
        .assign ⟨0, []⟩ (.use (.copy ⟨2, [.deref]⟩)),
        .storageDead 2,
        .storageDead 1
      ]
      terminator := .return_
    }]
  }]

/-- Unsound naive replacement of `*_2` with `_1` on `progCe2AbaEpochMismatchUb`
(ignoring the second `StorageLive(_1)` epoch reset), which spuriously returns
`9_u32` instead of faulting `.undefined`. -/
noncomputable def progCe2NaiveUnsoundReplaced : Program where
  pointerWidthBits := 64
  mirProfileVersion := 1
  bodies := [{
    argumentCount := 0
    locals := [u32Ty, u32Ty, .unit]
    identity := "ce2::aba_epoch_mismatch_ub"
    basicBlocks := [{
      statements := [
        .storageLive 1,
        .assign ⟨1, []⟩ (.use (u32Const 5)),
        .storageLive 2,
        .nop,
        .storageDead 1,
        .storageLive 1,
        .assign ⟨1, []⟩ (.use (u32Const 9)),
        .assign ⟨0, []⟩ (.use (.copy ⟨1, []⟩)),
        .storageDead 2,
        .storageDead 1
      ]
      terminator := .return_
    }]
  }]

/-- **Sharpness Theorem CE2:** `StorageDead(x); StorageLive(x)` increments `x`'s
allocation epoch so dereferencing a pre-reallocation reference `r = &x` faults
`.fault .undefined` even after `x = 9_u32`, while naive replacement without
epoch/single-storage tracking unsoundly returns `9_u32` and is rejected by
`applyPropagateSsaRef` / `checkMirRefPropStep`. -/
theorem ce2_aba_storage_dead_live_epoch_mismatch_ub_and_refprop_rejected :
    NegativeCanaryClaimRef progCe2AbaEpochMismatchUb queryEmpty
      .undefined .unsupported ∧
    PositiveCanaryClaim progCe2NaiveUnsoundReplaced queryEmpty (u32Val 9) ∧
    applyPropagateSsaRef ⟨0, 2, 1⟩ progCe2AbaEpochMismatchUb = none ∧
    checkMirRefPropStep progCe2AbaEpochMismatchUb
      (.propagateSsaRef ⟨0, 2, 1⟩) progCe2NaiveUnsoundReplaced = false := by
  refine ⟨?_, ?_, rfl, rfl⟩
  · exact negativeCanaryRef_of_exec (fuel := 15) (by intro h; cases h) rfl
  · exact positiveCanary_of_execReturns (fuel := 15) rfl

/-! ### Sharpness Counterexample 3 (`CE3`): Dangling Deref After Dead -/

/-- Branching CFG where `StorageDead(_2)` executes on the `true` arm (`bb1`)
before merging into `bb3` and dereferencing `*_3` (`!maybeStorageDead` fails at
`bb3`). -/
noncomputable def progCe3BranchDanglingDeref : Program where
  pointerWidthBits := 64
  mirProfileVersion := 1
  bodies := [{
    argumentCount := 1
    locals := [u32Ty, .bool, u32Ty, refU32Ty]
    identity := "ce3::branch_dangling_deref"
    basicBlocks := [
      {
        statements := [
          .storageLive 2,
          .assign ⟨2, []⟩ (.use (u32Const 77)),
          .storageLive 3,
          .assign ⟨3, []⟩ (.ref .shared ⟨2, []⟩)
        ]
        terminator := .switchInt (.copy ⟨1, []⟩) {
          branches := [(BitVec.ofNat 128 1, 1)]
          otherwise := 2
        }
      },
      {
        statements := [.storageDead 2]
        terminator := .goto 3
      },
      {
        statements := [.nop]
        terminator := .goto 3
      },
      {
        statements := [
          .assign ⟨0, []⟩ (.use (.copy ⟨3, [.deref]⟩)),
          .storageDead 3
        ]
        terminator := .return_
      }
    ]
  }]

/-- **Sharpness Theorem CE3:** When `StorageDead(x)` occurs along a branch
before `*r`, taking that branch (`flag = true`) faults `.fault .undefined` on
dangling `*r` (while `flag = false` returns `77_u32`), and
`applyPropagateSsaRef`
rejects propagating `r` because `xLive` is `false` at the join block `bb3`. -/
theorem ce3_dangling_deref_after_storage_dead_ub_and_refprop_rejected :
    NegativeCanaryClaimRef progCe3BranchDanglingDeref
      { args := [.bool true] } .undefined .unsupported ∧
    PositiveCanaryClaimRef progCe3BranchDanglingDeref
      { args := [.bool false] } (u32Val 77) ∧
    applyPropagateSsaRef ⟨0, 3, 2⟩ progCe3BranchDanglingDeref = none := by
  refine ⟨?_, ?_, rfl⟩
  · exact negativeCanaryRef_of_exec (fuel := 15) (by intro h; cases h) rfl
  · exact positiveCanaryRef_of_exec (fuel := 15) rfl

