                    rw [mutability_beq_refl c.rMut, hSupX]
                    dsimp [s3b_evalRefOrAddrBody]
                    rw [s3b_ctx_getElem_localsTgt_x c]
                    dsimp only
                    rw [mirTy_beq_refl c.xTy, hGXT, hEpX]
                    dsimp
