                              (epochs := fS.epochs) (ty := c.rTy)
                              (kind := .read) hCore.hNoTargetRS
                          unfold evalStatementRef
                          rw [if_bool_false hLenS, if_bool_false hLenT]
                          dsimp only
                          rw [hDstNil]
                          dsimp only
                          rw [s3b_ctx_getElem_localsTgt_ne c hYNeR, hEpEq,
