                                      hCoreRd.hBoundedS (Nat.le_refl _) hTLt
                                  hBoundedT :=
                                    rp_NodesBounded_append_one rT
                                      hCoreRd.hBoundedT (Nat.le_refl _)
                                      hCoreRd.hNextTagTPos
                                  hNoTargetRS := by
                                    unfold nodesNotTargeting
                                    rw [list_all_append]
                                    have hXR : (!Nat.beq c.x c.r) = true := by
                                      rw [nat_beq_false_of_ne c.hRNeX.symm]; rfl
                                    exact bool_and_intro hCoreRd.hNoTargetRS
                                      (bool_and_intro hXR rfl)
                                  hNoTargetRT := by
                                    unfold nodesNotTargeting
                                    rw [list_all_append]
                                    have hXR : (!Nat.beq c.x c.r) = true := by
                                      rw [nat_beq_false_of_ne c.hRNeX.symm]; rfl
                                    exact bool_and_intro hCoreRd.hNoTargetRT
                                      (bool_and_intro hXR rfl)
                                  hSlotsOther := fun loc slS slT hNeR hGS hGT =>
                                    s3b_SlotRel_mono_tags (Nat.le_succ _)
                                      (Nat.le_succ _)
                                      (s3b_PmMono_ext pm c.x epX fS.nextTag
                                        fT.nextTag)
                                      (hCoreRd.hSlotsOther loc slS slT hNeR hGS
                                        hGT)
                                  hNonXRel :=
                                    fun loc ep declTy hNeX hDecl hGEp hNZ' => by
                                      have hNe : loc ≠ c.x ∨ ep ≠ epX :=
                                        Or.inl hNeX
                                      dsimp [pm', s3b_extPm]
                                      rw [nat_beq_false_of_ne hNeX,
                                          Bool.false_and]
                                      dsimp
                                      rw [rp_nodesAt_append, rp_nodesAt_append]
                                      dsimp [rp_nodesAt]
                                      rw [if_bool_false
                                            (rp_nodeAt_false_of_ne hAtRS hNe),
                                          if_bool_false
                                            (rp_nodeAt_false_of_ne hAtRT hNe),
                                          List.append_nil, List.append_nil]
                                      exact hCoreRd.hNonXRel loc ep declTy hNeX
                                        hDecl hGEp hNZ'
                                  hTargetInv := fun epX2 _ hEpX2 _ => by
                                    rw [hEpX] at hEpX2
                                    injection hEpX2 with eE; subst eE
                                    unfold s3b_TargetLiveInv
                                    rw [if_bool_true hTr]
                                    dsimp [pm', s3b_extPm]
                                    rw [nat_beq_refl c.x, nat_beq_refl epX]
                                    dsimp
                                    rw [hPM0, List.nil_append,
                                        rp_nodesAt_append, rp_nodesAt_append]
                                    dsimp [rp_nodesAt]
                                    rw [if_bool_true hAtRS, if_bool_true hAtRT,
                                        hNT1, List.nil_append]
                                    exact Or.inr
                                      (rp_DelegatedReborrowRel_init rS rT hRoot1
                                        hFind1 hAtRS hAtRT rfl rfl rfl hInitNR
                                        hSub)
                                }
                                have hValPtr :
                                    s3b_ValRel c fS.epochs fS.nextEpoch
                                      (fS.nextTag + 1) (fT.nextTag + 1) pm'
                                      (.localPtr ⟨c.x, epX, fS.nextTag⟩ dstTy)
                                      (.localPtr ⟨c.x, epX, fT.nextTag⟩
                                        dstTy) := by
                                  refine ⟨rfl, c.hRNeX.symm, rfl, rfl, hEpXLt,
                                    Nat.lt_succ_self _, Nat.lt_succ_self _, ?_⟩
                                  intro _ _ hGEp _
                                  rw [hEpX] at hGEp
                                  injection hGEp with eE; rw [← eE]
                                  rw [hTr, nat_beq_refl c.x]
                                  dsimp [pm', s3b_extPm]
                                  rw [nat_beq_refl c.x, nat_beq_refl epX, hPM0]
                                  dsimp [rp_hasPair]
                                  rw [nat_beq_refl fS.nextTag,
                                      nat_beq_refl fT.nextTag]
                                  exact ⟨hCore.hNextTagSPos,
                                    hCore.hNextTagTPos, rfl⟩
                                have hWr :=
                                  s3b_writeTarget_unproj_nonR
                                    (nodesS := nodesS₁ ++
                                      [{ tag := fS.nextTag, parentTag := tagR,
                                         targetLocal := c.x, targetEpoch := epX,
                                         perm :=
                                           Mutability.casesOn
                                             (motive := fun _ => BorrowPerm) m2
                                             BorrowPerm.frozen
                                             BorrowPerm.reservedFrz }])
                                    (nodesT :=
                                      performTbRootAccess fS.epochs c.x c.xTy
                                        .read fT.borrowNodes ++
                                      [{ tag := fT.nextTag, parentTag := 0,
                                         targetLocal := c.x, targetEpoch := epX,
                                         perm :=
                                           Mutability.casesOn
                                             (motive := fun _ => BorrowPerm) m2
                                             BorrowPerm.frozen
                                             BorrowPerm.reservedFrz }])
                                    hCoreDel hYNeR hBL hValPtr
                                have hMIdle :
                                    s3b_modeAfterRoot c dst.localId .write
                                      .delegated = .delegated := by
                                  unfold s3b_modeAfterRoot
                                  rw [nat_beq_false_of_ne hDstNeX,
                                      Bool.and_false]
                                  rfl
                                rw [hMIdle] at hWr
                                have hM2Or : m2 = .shared ∨ m2 = .mut :=
                                  Mutability.casesOn
                                    (motive := fun x => x = .shared ∨ x = .mut)
                                    m2 (Or.inl rfl) (Or.inr rfl)
                                cases hM2Or with
                                | inl hMS =>
                                  rw [hMS] at hWr
                                  rw [hMS]
                                  dsimp at hWr
                                  dsimp
                                  cases hW1 :
                                      writeTargetSlotRef c.bodySrc.locals
                                        fS.locals fS.epochs
                                        (nodesS₁ ++
                                          [{ tag := fS.nextTag, parentTag := tagR,
                                             targetLocal := c.x,
                                             targetEpoch := epX,
                                             perm := .frozen }])
                                        dst.localId none dstTy
                                        (.localPtr ⟨c.x, epX, fS.nextTag⟩ dstTy)
                                  with
                                  | error _ =>
                                    rw [hW1] at hWr
                                    cases hW2 :
                                        writeTargetSlotRef c.bodyTgt.locals
                                          fT.locals fS.epochs
                                          (performTbRootAccess fS.epochs c.x c.xTy
                                             .read fT.borrowNodes ++
                                            [{ tag := fT.nextTag, parentTag := 0,
                                               targetLocal := c.x,
                                               targetEpoch := epX,
                                               perm := .frozen }])
                                          dst.localId none dstTy
                                          (.localPtr ⟨c.x, epX, fT.nextTag⟩ dstTy)
                                    with
                                    | error _ => rw [hW2] at hWr; exact hWr
                                    | ok _ => rw [hW2] at hWr; exact False.elim hWr
                                  | ok p1 =>
                                    rw [hW1] at hWr
                                    cases hW2 :
                                        writeTargetSlotRef c.bodyTgt.locals
                                          fT.locals fS.epochs
                                          (performTbRootAccess fS.epochs c.x c.xTy
                                             .read fT.borrowNodes ++
                                            [{ tag := fT.nextTag, parentTag := 0,
                                               targetLocal := c.x,
                                               targetEpoch := epX,
                                               perm := .frozen }])
                                          dst.localId none dstTy
                                          (.localPtr ⟨c.x, epX, fT.nextTag⟩ dstTy)
                                    with
                                    | error _ => rw [hW2] at hWr; exact False.elim hWr
                                    | ok p2 =>
                                      rw [hW2] at hWr
                                      cases p1 with
                                      | mk lS2 nS2 =>
                                        cases p2 with
                                        | mk lT2 nT2 =>
                                          exact ⟨_, _, true, true, .delegated,
                                            pm', hStEq, rfl, rfl, rfl, rfl, rfl,
                                            rfl, rfl, rfl, rfl, rfl, hWr⟩
                                | inr hMM =>
                                  rw [hMM] at hWr
                                  rw [hMM]
                                  dsimp at hWr
                                  dsimp
                                  cases hW1 :
                                      writeTargetSlotRef c.bodySrc.locals
                                        fS.locals fS.epochs
                                        (nodesS₁ ++
                                          [{ tag := fS.nextTag, parentTag := tagR,
                                             targetLocal := c.x,
                                             targetEpoch := epX,
                                             perm := .reservedFrz }])
                                        dst.localId none dstTy
                                        (.localPtr ⟨c.x, epX, fS.nextTag⟩ dstTy)
                                  with
                                  | error _ =>
                                    rw [hW1] at hWr
                                    cases hW2 :
                                        writeTargetSlotRef c.bodyTgt.locals
                                          fT.locals fS.epochs
                                          (performTbRootAccess fS.epochs c.x c.xTy
                                             .read fT.borrowNodes ++
                                            [{ tag := fT.nextTag, parentTag := 0,
                                               targetLocal := c.x,
                                               targetEpoch := epX,
                                               perm := .reservedFrz }])
                                          dst.localId none dstTy
                                          (.localPtr ⟨c.x, epX, fT.nextTag⟩ dstTy)
                                    with
                                    | error _ => rw [hW2] at hWr; exact hWr
                                    | ok _ => rw [hW2] at hWr; exact False.elim hWr
                                  | ok p1 =>
                                    rw [hW1] at hWr
                                    cases hW2 :
                                        writeTargetSlotRef c.bodyTgt.locals
                                          fT.locals fS.epochs
                                          (performTbRootAccess fS.epochs c.x c.xTy
                                             .read fT.borrowNodes ++
                                            [{ tag := fT.nextTag, parentTag := 0,
                                               targetLocal := c.x,
                                               targetEpoch := epX,
                                               perm := .reservedFrz }])
                                          dst.localId none dstTy
                                          (.localPtr ⟨c.x, epX, fT.nextTag⟩ dstTy)
                                    with
                                    | error _ => rw [hW2] at hWr; exact False.elim hWr
                                    | ok p2 =>
                                      rw [hW2] at hWr
                                      cases p1 with
                                      | mk lS2 nS2 =>
                                        cases p2 with
                                        | mk lT2 nT2 =>
                                          exact ⟨_, _, true, true, .delegated,
                                            pm', hStEq, rfl, rfl, rfl, rfl, rfl,
                                            rfl, rfl, rfl, rfl, rfl, hWr⟩

/-! ### Terminator Simulation & Whole-Body Lockstep Equivalence -/

private theorem s3b_evalSwitchBranches_all {w : IntWidth} {bits : BitVec 128}
    {oth tgt : BasicBlockId} {P : BasicBlockId → Bool} :
    ∀ {brs : List (BitVec 128 × BasicBlockId)},
      evalSwitchBranches w bits oth brs = .ok tgt →
      P oth = true →
      brs.all (fun br => P br.2) = true →
      P tgt = true
  | [], hEv, hOth, _ => by
    dsimp [evalSwitchBranches] at hEv
    injection hEv with e; rw [← e]; exact hOth
  | (cb, _) :: rest, hEv, hOth, hAll => by
    dsimp [List.all] at hAll
    let ⟨hHd, hTl⟩ := bool_and_true hAll
    dsimp [evalSwitchBranches] at hEv
    cases h1 : (truncateBits w cb != cb) with
    | true => rw [if_bool_true h1] at hEv; cases hEv
    | false =>
      rw [if_bool_false h1] at hEv
      cases h2 : (truncateBits w bits == truncateBits w cb) with
      | true =>
        rw [if_bool_true h2] at hEv
        injection hEv with e; rw [← e]; exact hHd
      | false =>
        rw [if_bool_false h2] at hEv
        exact s3b_evalSwitchBranches_all hEv hOth hTl

private theorem s3b_evalBoolSwitchBranches_all {b : Bool}
    {oth tgt : BasicBlockId} {P : BasicBlockId → Bool} :
    ∀ {brs : List (BitVec 128 × BasicBlockId)},
      evalBoolSwitchBranches b oth brs = .ok tgt →
      P oth = true →
      brs.all (fun br => P br.2) = true →
      P tgt = true
  | [], hEv, hOth, _ => by
    dsimp [evalBoolSwitchBranches] at hEv
    injection hEv with e; rw [← e]; exact hOth
  | (cb, _) :: rest, hEv, hOth, hAll => by
    dsimp [List.all] at hAll
    let ⟨hHd, hTl⟩ := bool_and_true hAll
    dsimp [evalBoolSwitchBranches] at hEv
    cases hC : evalConstLit .bool (.scalar cb) with
    | error _ => rw [hC] at hEv; cases hEv
    | ok v =>
      rw [hC] at hEv
      cases v with
      | bool bLit =>
        cases bLit with
        | false =>
          dsimp at hEv
          cases hB : !b with
          | true =>
            rw [if_bool_true hB] at hEv
            injection hEv with e; rw [← e]; exact hHd
          | false =>
            rw [if_bool_false hB] at hEv
            exact s3b_evalBoolSwitchBranches_all hEv hOth hTl
        | true =>
          dsimp at hEv
          cases hB : b with
          | true =>
            rw [if_bool_true hB] at hEv
            injection hEv with e; rw [← e]; exact hHd
          | false =>
            rw [if_bool_false hB] at hEv
            exact s3b_evalBoolSwitchBranches_all hEv hOth hTl
      | _ => cases hEv

private theorem s3b_evalTerminator_sim {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {bbSrc bbTgt : BasicBlock} {fS fT : FrameStateRef} {mem : CallerMemory}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {succs : List BasicBlockId} {afterTermSt : AbsRefState}
    (hCore : s3b_CoreInv c rL xL mode fS.locals fT.locals fS.epochs fS.nextEpoch
      fS.borrowNodes fT.borrowNodes fS.nextTag fT.nextTag pm)
    (hCleanup : bbTgt.cleanup = bbSrc.cleanup)
    (hEpEq : fT.epochs = fS.epochs)
    (hNEpEq : fT.nextEpoch = fS.nextEpoch)
    (hTermBounds :
      terminatorBlocksLt c.bodySrc.basicBlocks.length bbSrc.terminator = true)
    (hAbs :
      absStepAndRewriteTerminator c.r c.x c.rIsMut c.trackTb
        (.reachable rL xL mode) bbSrc.terminator =
        some (succs, afterTermSt, bbTgt.terminator))
    (hSuccsLe :
      succs.all (fun s => absLe afterTermSt (getAbsState c.inStates s)) =
        true) :
    match evalTerminatorRef c.bodySrc bbSrc fS mem,
        evalTerminatorRef c.bodyTgt bbTgt fT mem with
    | .fault k₁, .fault k₂ => k₁ = k₂
    | .done o₁, .done o₂ => o₁ = o₂
    | .step sS', .step sT' =>
      ∃ fS' fT' rL' xL' mode' pm',
        getAbsState c.inStates fS'.blockIdx = .reachable rL' xL' mode' ∧
        fS'.blockIdx < c.bodySrc.basicBlocks.length ∧
        sS' = { frames := [fS'], callerMem := mem } ∧
        sT' = { frames := [fT'], callerMem := mem } ∧
        fS'.defId = fS.defId ∧
        fT'.defId = fT.defId ∧
        fT'.blockIdx = fS'.blockIdx ∧
        fS'.stmtIdx = 0 ∧
        fT'.stmtIdx = 0 ∧
        fT'.epochs = fS'.epochs ∧
        fT'.nextEpoch = fS'.nextEpoch ∧
        s3b_CoreInv c rL' xL' mode' fS'.locals fT'.locals fS'.epochs
          fS'.nextEpoch fS'.borrowNodes fT'.borrowNodes fS'.nextTag fT'.nextTag
          pm'
    | _, _ => False := by
  have hLenS : (!Nat.beq fS.epochs.length fS.locals.length) = false := by
    rw [hCore.hLenEp, hCore.hLenLocS, nat_beq_refl]; rfl
  have hLenT : (!Nat.beq fT.epochs.length fT.locals.length) = false := by
    rw [hEpEq, hCore.hLenEp, hCore.hLenLocT, nat_beq_refl]; rfl
  unfold evalTerminatorRef
  rw [if_bool_false hLenS, if_bool_false hLenT]
  dsimp
  cases hTerm : bbSrc.terminator with
  | goto tgt =>
    rw [hTerm] at hAbs hTermBounds
    dsimp [terminatorBlocksLt] at hTermBounds
    dsimp [absStepAndRewriteTerminator] at hAbs
    let ⟨hSu, hAf, hTgtTerm⟩ := s3b_some_prod3_eq hAbs
    rw [← hTgtTerm]
    rw [← hSu, ← hAf] at hSuccsLe
    dsimp [List.all] at hSuccsLe
    let ⟨hLeTgt, _⟩ := bool_and_true hSuccsLe
    cases hStTgt : getAbsState c.inStates tgt with
    | unreachable => rw [hStTgt] at hLeTgt; cases hLeTgt
    | reachable rL' xL' mode' =>
      rw [hStTgt] at hLeTgt
      dsimp [jumpToBlockRef]
      exact ⟨_, _, rL', xL', mode', pm, hStTgt, nat_blt_lt hTermBounds,
        rfl, rfl, rfl, rfl, rfl, rfl, rfl, hEpEq, hNEpEq,
        s3b_CoreInv_mono hLeTgt hCore⟩
  | return_ =>
    rw [hTerm] at hAbs
    dsimp [absStepAndRewriteTerminator] at hAbs
    let ⟨_, _, hTgtTerm⟩ := s3b_some_prod3_eq hAbs
    rw [← hTgtTerm, hCleanup]
    dsimp
    cases bbSrc.cleanup with
    | true => rfl
    | false =>
      dsimp
      have h0NeR : (0 : LocalId) ≠ c.r := (s3b_ctx_r_ne_zero c).symm
      cases hG0S : Trusted.MirSemantics.getElem? fS.locals 0 with
      | none =>
        have hGe : fT.locals.length ≤ 0 := by
          rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_none_ge hG0S
        rw [getElem?_none_of_ge hGe]
      | some slS =>
        have hLt0 : 0 < fT.locals.length := by
          rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_some_lt hG0S
        let ⟨slT, hG0T⟩ := getElem?_some_of_lt fT.locals 0 hLt0
        rw [hG0T]
        have hSl0 := hCore.hSlotsOther 0 slS slT h0NeR hG0S hG0T
        cases slS with
        | dead =>
          cases slT with
          | dead => rfl
          | live _ => exact False.elim hSl0
        | live oS =>
          cases slT with
          | dead => exact False.elim hSl0
          | live oT =>
            cases oS with
            | none =>
              cases oT with
              | none => rfl
              | some _ => exact False.elim hSl0
            | some vS =>
              cases oT with
              | none => exact False.elim hSl0
              | some vT =>
                cases vS with
                | localPtr _ _ =>
                  cases vT with
                  | localPtr _ _ => rfl
                  | base _ => exact False.elim hSl0
                | base bS =>
                  cases vT with
                  | localPtr _ _ => exact False.elim hSl0
                  | base bT =>
                    have hbEq : bS = bT := hSl0
                    rw [hbEq]
  | unreachable =>
    rw [hTerm] at hAbs
    dsimp [absStepAndRewriteTerminator] at hAbs
    rw [← (s3b_some_prod3_eq hAbs).2.2]
  | unwindResume =>
    rw [hTerm] at hAbs
    dsimp [absStepAndRewriteTerminator] at hAbs
    rw [← (s3b_some_prod3_eq hAbs).2.2]
  | unsupported =>
    rw [hTerm] at hAbs
    dsimp [absStepAndRewriteTerminator] at hAbs
    rw [← (s3b_some_prod3_eq hAbs).2.2]
  | assert cond exp msg t u =>
    rw [hTerm] at hAbs
    dsimp [absStepAndRewriteTerminator] at hAbs
    cases hM : !terminatorMentionsLocal c.r (.assert cond exp msg t u) with
    | false => rw [if_bool_false hM] at hAbs; cases hAbs
    | true =>
      rw [if_bool_true hM] at hAbs
      rw [← (s3b_some_prod3_eq hAbs).2.2]
  | call fn args dst t u =>
    rw [hTerm] at hAbs
    dsimp [absStepAndRewriteTerminator] at hAbs
    cases hM : !terminatorMentionsLocal c.r (.call fn args dst t u) with
    | false => rw [if_bool_false hM] at hAbs; cases hAbs
    | true =>
      rw [if_bool_true hM] at hAbs
      rw [← (s3b_some_prod3_eq hAbs).2.2]
  | switchInt discr ts =>
    rw [hTerm] at hAbs hTermBounds
    dsimp [terminatorBlocksLt] at hTermBounds
    let ⟨hOthLt, hBrsLt⟩ := bool_and_true hTermBounds
    dsimp [absStepAndRewriteTerminator] at hAbs
    have hJumpFinish :
        ∀ {rL1 xL1 : Bool} {mode1 : BorrowLinkMode} (dv : Val)
          {lS1 lT1 : List LocalSlotRef} {nS1 nT1 : List BorrowNode},
          succs = ts.otherwise :: ts.branches.map (fun br => br.2) →
          afterTermSt = .reachable rL1 xL1 mode1 →
          s3b_CoreInv c rL1 xL1 mode1 lS1 lT1 fS.epochs fS.nextEpoch nS1 nT1
            fS.nextTag fT.nextTag pm →
          match
            (match
               match dv with
               | .scalar sv =>
                 evalSwitchBranches sv.width sv.bits ts.otherwise ts.branches
               | .bool b =>
                 evalBoolSwitchBranches b ts.otherwise ts.branches
               | _ => .error .unsupported with
             | .error k => StepResult.fault k
             | .ok target =>
               jumpToBlockRef { fS with locals := lS1, borrowNodes := nS1 }
                 mem target),
            (match
               match dv with
               | .scalar sv =>
                 evalSwitchBranches sv.width sv.bits ts.otherwise ts.branches
               | .bool b =>
                 evalBoolSwitchBranches b ts.otherwise ts.branches
               | _ => .error .unsupported with
             | .error k => StepResult.fault k
             | .ok target =>
               jumpToBlockRef { fT with locals := lT1, borrowNodes := nT1 }
                 mem target) with
          | .fault k₁, .fault k₂ => k₁ = k₂
          | .done o₁, .done o₂ => o₁ = o₂
          | .step sS', .step sT' =>
            ∃ fS' fT' rL' xL' mode' pm',
              getAbsState c.inStates fS'.blockIdx =
                .reachable rL' xL' mode' ∧
              fS'.blockIdx < c.bodySrc.basicBlocks.length ∧
              sS' = { frames := [fS'], callerMem := mem } ∧
              sT' = { frames := [fT'], callerMem := mem } ∧
              fS'.defId = fS.defId ∧
              fT'.defId = fT.defId ∧
              fT'.blockIdx = fS'.blockIdx ∧
              fS'.stmtIdx = 0 ∧
              fT'.stmtIdx = 0 ∧
              fT'.epochs = fS'.epochs ∧
              fT'.nextEpoch = fS'.nextEpoch ∧
              s3b_CoreInv c rL' xL' mode' fS'.locals fT'.locals fS'.epochs
                fS'.nextEpoch fS'.borrowNodes fT'.borrowNodes fS'.nextTag
                fT'.nextTag pm'
          | _, _ => False := by
      intro rL1 xL1 mode1 dv lS1 lT1 nS1 nT1 hSuEq hAfEq hC1
      subst hSuEq; subst hAfEq
      dsimp [List.all] at hSuccsLe
      let ⟨hOthLe, hBrsLe⟩ := bool_and_true hSuccsLe
      rw [list_all_map] at hBrsLe
      cases dv with
      | scalar sv =>
        dsimp
        cases hSw :
            evalSwitchBranches sv.width sv.bits ts.otherwise ts.branches with
        | error _ => rfl
        | ok target =>
          have hTgtLtB :=
            s3b_evalSwitchBranches_all
              (P := fun b => Nat.blt b c.bodySrc.basicBlocks.length)
              hSw hOthLt hBrsLt
          have hTgtLt := nat_blt_lt hTgtLtB
          have hTgtLe :=
            s3b_evalSwitchBranches_all
              (P := fun b =>
                absLe (.reachable rL1 xL1 mode1) (getAbsState c.inStates b))
              hSw hOthLe hBrsLe
          cases hStTgt : getAbsState c.inStates target with
          | unreachable => rw [hStTgt] at hTgtLe; cases hTgtLe
          | reachable rL' xL' mode' =>
            rw [hStTgt] at hTgtLe
            dsimp [jumpToBlockRef]
            exact ⟨_, _, rL', xL', mode', pm, hStTgt, hTgtLt, rfl, rfl, rfl,
              rfl, rfl, rfl, rfl, hEpEq, hNEpEq, s3b_CoreInv_mono hTgtLe hC1⟩
      | bool b =>
        dsimp
        cases hSw : evalBoolSwitchBranches b ts.otherwise ts.branches with
        | error _ => rfl
        | ok target =>
          have hTgtLtB :=
            s3b_evalBoolSwitchBranches_all
              (P := fun b => Nat.blt b c.bodySrc.basicBlocks.length)
              hSw hOthLt hBrsLt
          have hTgtLt := nat_blt_lt hTgtLtB
          have hTgtLe :=
            s3b_evalBoolSwitchBranches_all
              (P := fun b =>
                absLe (.reachable rL1 xL1 mode1) (getAbsState c.inStates b))
              hSw hOthLe hBrsLe
          cases hStTgt : getAbsState c.inStates target with
          | unreachable => rw [hStTgt] at hTgtLe; cases hTgtLe
          | reachable rL' xL' mode' =>
            rw [hStTgt] at hTgtLe
            dsimp [jumpToBlockRef]
            exact ⟨_, _, rL', xL', mode', pm, hStTgt, hTgtLt, rfl, rfl, rfl,
              rfl, rfl, rfl, rfl, hEpEq, hNEpEq, s3b_CoreInv_mono hTgtLe hC1⟩
      | _ => rfl
    cases hNoR : !operandMentionsLocal c.r discr with
    | true =>
      rw [if_bool_true hNoR] at hAbs
      have hAbsUnp :
          succs = ts.otherwise :: ts.branches.map (fun br => br.2) ∧
          afterTermSt = .reachable rL xL (s3b_opNonRMode c discr mode) ∧
          bbTgt.terminator = .switchInt discr ts := by
        unfold s3b_opNonRMode
        cases hT : !c.trackTb with
        | true =>
          rw [if_bool_true hT] at hAbs
          let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
          exact ⟨e1.symm, e2.symm, e3.symm⟩
        | false =>
          rw [if_bool_false hT] at hAbs
          cases hDM : operandDirectMovesLocal c.x discr with
          | true =>
            rw [if_bool_true hDM] at hAbs
            let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
            exact ⟨e1.symm, e2.symm, e3.symm⟩
          | false =>
            rw [if_bool_false hDM] at hAbs
            cases hMX : operandMentionsLocal c.x discr with
            | true =>
              rw [if_bool_true hMX] at hAbs
              let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
              exact ⟨e1.symm, e2.symm, e3.symm⟩
            | false =>
              rw [if_bool_false hMX] at hAbs
              let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
              exact ⟨e1.symm, e2.symm, e3.symm⟩
      let ⟨hSu, hAf, hTgtTerm⟩ := hAbsUnp
      rw [hTgtTerm]
      dsimp
      have hPr := s3b_evalPrimOperand_nonR hCore (bool_not_true hNoR)
      cases h1 : evalPrimitiveOperandRef c.bodySrc.locals fS.locals fS.epochs
          fS.borrowNodes discr with
      | error _ =>
        rw [h1] at hPr
        cases h2 : evalPrimitiveOperandRef c.bodyTgt.locals fT.locals fT.epochs
            fT.borrowNodes discr with
        | error _ => rw [hEpEq] at h2; rw [h2] at hPr; exact hPr
        | ok _ => rw [hEpEq] at h2; rw [h2] at hPr; exact False.elim hPr
      | ok r1 =>
        rw [h1] at hPr
        cases h2 : evalPrimitiveOperandRef c.bodyTgt.locals fT.locals fT.epochs
            fT.borrowNodes discr with
        | error _ => rw [hEpEq] at h2; rw [h2] at hPr; exact False.elim hPr
        | ok r2 =>
          rw [hEpEq] at h2; rw [h2] at hPr
          cases r1 with
          | mk dv1 a1 =>
            cases a1 with
            | mk lS1 nS1 =>
              cases r2 with
              | mk dv2 b1 =>
                cases b1 with
                | mk lT1 nT1 =>
                  let ⟨hdv, hC1⟩ := hPr
                  subst hdv
                  dsimp
                  exact hJumpFinish dv1 hSu hAf hC1
    | false =>
      rw [if_bool_false hNoR] at hAbs
      have hMR : operandMentionsLocal c.r discr = true := bool_not_false hNoR
      have hNoX : operandMentionsLocal c.x discr = false := by
        cases discr with
        | constant _ => cases hMR
        | copy p =>
          dsimp [operandMentionsLocal] at hMR
          dsimp [operandMentionsLocal]
          rw [nat_beq_eq hMR]
          exact nat_beq_false_of_ne c.hRNeX
        | move p =>
          dsimp [operandMentionsLocal] at hMR
          dsimp [operandMentionsLocal]
          rw [nat_beq_eq hMR]
          exact nat_beq_false_of_ne c.hRNeX
      cases hG : (!(rL && xL) || !operandOnlyUsesDerefOf c.r c.rIsMut discr)
      with
      | true => rw [if_bool_true hG] at hAbs; cases hAbs
      | false =>
        rw [if_bool_false hG] at hAbs
        let ⟨hNLX, hND⟩ := bool_or_false hG
        let ⟨hrLT, hxLT⟩ := bool_and_true (bool_not_false hNLX)
        subst hrLT; subst hxLT
        have hDerefOnly := bool_not_false hND
        cases hTr : c.trackTb with
        | false =>
          rw [hTr] at hAbs; dsimp at hAbs
          cases hM : BorrowLinkMode.beq mode .reserved with
          | false => rw [if_bool_false hM] at hAbs; cases hAbs
          | true =>
            rw [if_bool_true hM] at hAbs
            have hmEq := borrowLinkMode_beq_eq hM
            subst hmEq
            let ⟨hSu, hAf, hTgtTerm⟩ := s3b_some_prod3_eq hAbs
            rw [← hTgtTerm]
            dsimp
            have hPr :=
              s3b_evalPrimOperand_rewritten hCore hDerefOnly (fun _ => hNoX)
                (Or.inl ⟨hTr, rfl⟩)
            cases h1 : evalPrimitiveOperandRef c.bodySrc.locals fS.locals
                fS.epochs fS.borrowNodes discr with
            | error _ =>
              rw [h1] at hPr
              cases h2 : evalPrimitiveOperandRef c.bodyTgt.locals fT.locals
                  fT.epochs fT.borrowNodes (rewriteDerefOperand c.r c.x discr)
              with
              | error _ => rw [hEpEq] at h2; rw [h2] at hPr; exact hPr
              | ok _ => rw [hEpEq] at h2; rw [h2] at hPr; exact False.elim hPr
            | ok r1 =>
              rw [h1] at hPr
              cases h2 : evalPrimitiveOperandRef c.bodyTgt.locals fT.locals
                  fT.epochs fT.borrowNodes (rewriteDerefOperand c.r c.x discr)
              with
              | error _ => rw [hEpEq] at h2; rw [h2] at hPr; exact False.elim hPr
              | ok r2 =>
                rw [hEpEq] at h2; rw [h2] at hPr
                cases r1 with
                | mk dv1 a1 =>
                  cases a1 with
                  | mk lS1 nS1 =>
                    cases r2 with
                    | mk dv2 b1 =>
                      cases b1 with
                      | mk lT1 nT1 =>
                        let ⟨hdv, hC1⟩ := hPr
                        subst hdv
                        dsimp
                        exact hJumpFinish dv1 hSu.symm hAf.symm hC1
        | true =>
          rw [hTr] at hAbs; dsimp at hAbs
          cases hMv : operandMovesDerefOf c.r discr with
          | true =>
            rw [if_bool_true hMv] at hAbs
            cases hNM : !c.rIsMut with
            | true => rw [if_bool_true hNM] at hAbs; cases hAbs
            | false =>
              rw [if_bool_false hNM] at hAbs
              have hRMutT := bool_not_false hNM
              have hLeUniq :
                  absLe (.reachable true true mode)
                    (.reachable true true .unique) = true ∧
                  succs = ts.otherwise :: ts.branches.map (fun br => br.2) ∧
                  afterTermSt = .reachable true true .unique ∧
                  bbTgt.terminator =
                    .switchInt (rewriteDerefOperand c.r c.x discr) ts := by
                cases mode with
                | reserved =>
                  let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
                  exact ⟨rfl, e1.symm, e2.symm, e3.symm⟩
                | unique =>
                  let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
                  exact ⟨rfl, e1.symm, e2.symm, e3.symm⟩
                | frozen | clean | delegated => cases hAbs
              let ⟨hLeU, hSu, hAf, hTgtTerm⟩ := hLeUniq
              rw [hTgtTerm]
              dsimp
              have hCoreU := s3b_CoreInv_mono hLeU hCore
              have hPr :=
                s3b_evalPrimOperand_rewritten hCoreU hDerefOnly (fun _ => hNoX)
                  (Or.inr ⟨hTr, Or.inr ⟨hRMutT, rfl⟩⟩)
              cases h1 : evalPrimitiveOperandRef c.bodySrc.locals fS.locals
                  fS.epochs fS.borrowNodes discr with
              | error _ =>
                rw [h1] at hPr
                cases h2 : evalPrimitiveOperandRef c.bodyTgt.locals fT.locals
                    fT.epochs fT.borrowNodes
                    (rewriteDerefOperand c.r c.x discr) with
                | error _ => rw [hEpEq] at h2; rw [h2] at hPr; exact hPr
                | ok _ => rw [hEpEq] at h2; rw [h2] at hPr; exact False.elim hPr
              | ok r1 =>
                rw [h1] at hPr
                cases h2 : evalPrimitiveOperandRef c.bodyTgt.locals fT.locals
                    fT.epochs fT.borrowNodes
                    (rewriteDerefOperand c.r c.x discr) with
                | error _ => rw [hEpEq] at h2; rw [h2] at hPr; exact False.elim hPr
                | ok r2 =>
                  rw [hEpEq] at h2; rw [h2] at hPr
                  cases r1 with
                  | mk dv1 a1 =>
                    cases a1 with
                    | mk lS1 nS1 =>
                      cases r2 with
                      | mk dv2 b1 =>
                        cases b1 with
                        | mk lT1 nT1 =>
                          let ⟨hdv, hC1⟩ := hPr
                          subst hdv
                          dsimp
                          exact hJumpFinish dv1 hSu hAf hC1
          | false =>
            rw [if_bool_false hMv] at hAbs
            have hMode3 :
                (mode = .reserved ∨ mode = .unique ∨ mode = .frozen) ∧
                succs = ts.otherwise :: ts.branches.map (fun br => br.2) ∧
                afterTermSt = .reachable true true mode ∧
                bbTgt.terminator =
                  .switchInt (rewriteDerefOperand c.r c.x discr) ts := by
              cases mode with
              | reserved =>
                let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
                exact ⟨Or.inl rfl, e1.symm, e2.symm, e3.symm⟩
              | unique =>
                let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
                exact ⟨Or.inr (Or.inl rfl), e1.symm, e2.symm, e3.symm⟩
              | frozen =>
                let ⟨e1, e2, e3⟩ := s3b_some_prod3_eq hAbs
                exact ⟨Or.inr (Or.inr rfl), e1.symm, e2.symm, e3.symm⟩
              | clean | delegated => cases hAbs
            let ⟨hMOr, hSu, hAf, hTgtTerm⟩ := hMode3
            rw [hTgtTerm]
            dsimp
            have hPr :=
              s3b_evalPrimOperand_rewritten hCore hDerefOnly (fun _ => hNoX)
                (Or.inr ⟨hTr, Or.inl ⟨hMv, hMOr⟩⟩)
            cases h1 : evalPrimitiveOperandRef c.bodySrc.locals fS.locals
                fS.epochs fS.borrowNodes discr with
            | error _ =>
              rw [h1] at hPr
              cases h2 : evalPrimitiveOperandRef c.bodyTgt.locals fT.locals
                  fT.epochs fT.borrowNodes (rewriteDerefOperand c.r c.x discr)
              with
              | error _ => rw [hEpEq] at h2; rw [h2] at hPr; exact hPr
              | ok _ => rw [hEpEq] at h2; rw [h2] at hPr; exact False.elim hPr
            | ok r1 =>
              rw [h1] at hPr
              cases h2 : evalPrimitiveOperandRef c.bodyTgt.locals fT.locals
                  fT.epochs fT.borrowNodes (rewriteDerefOperand c.r c.x discr)
              with
              | error _ => rw [hEpEq] at h2; rw [h2] at hPr; exact False.elim hPr
              | ok r2 =>
                rw [hEpEq] at h2; rw [h2] at hPr
                cases r1 with
                | mk dv1 a1 =>
                  cases a1 with
                  | mk lS1 nS1 =>
                    cases r2 with
                    | mk dv2 b1 =>
                      cases b1 with
                      | mk lT1 nT1 =>
                        let ⟨hdv, hC1⟩ := hPr
                        subst hdv
                        dsimp
                        exact hJumpFinish dv1 hSu hAf hC1

private theorem s3b_map_const_eq_of_len {α β γ : Type} (v : γ) :
    ∀ {xs : List α} {ys : List β},
      xs.length = ys.length →
      xs.map (fun _ => v) = ys.map (fun _ => v)
  | [], [], _ => rfl
  | _ :: _, [], h => by cases h
  | [], _ :: _, h => by cases h
  | _ :: xs, _ :: ys, h => by
    dsimp [List.map]
    rw [s3b_map_const_eq_of_len v (Nat.succ.inj h)]

private noncomputable def s3b_QueryEquiv (pSrc pTgt : Program) : Prop :=
  ∀ q : Query,
    (WellFormedRef pTgt q ↔ WellFormedRef pSrc q) ∧
    (∀ out : TerminalOut, BehaviorRef pTgt q out ↔ BehaviorRef pSrc q out) ∧
    (∀ k : FaultKind,
      ReachesResultRef pTgt q (.fault k) ↔
        ReachesResultRef pSrc q (.fault k)) ∧
    (DivergesRef pTgt q ↔ DivergesRef pSrc q)

private theorem s3b_evalStep_preserves_defId {p : Program} {f : FrameStateRef}
    {mem : CallerMemory} {s' : ExecStateRef}
    (hStep : evalStepRef p 0 { frames := [f], callerMem := mem } = .step s') :
    ∃ f', s' = { frames := [f'], callerMem := mem } ∧ f'.defId = f.defId := by
  unfold evalStepRef at hStep
  dsimp at hStep
  cases hL : !Nat.beq f.epochs.length f.locals.length with
  | true => rw [if_bool_true hL] at hStep; cases hStep
  | false =>
    rw [if_bool_false hL] at hStep
    cases hB : Trusted.MirSemantics.getElem? p.bodies f.defId with
    | none => rw [hB] at hStep; cases hStep
    | some body =>
      rw [hB] at hStep; dsimp at hStep
      cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
      | none => rw [hBb] at hStep; cases hStep
      | some bb =>
        rw [hBb] at hStep; dsimp at hStep
        cases hSt : Trusted.MirSemantics.getElem? bb.statements f.stmtIdx with
        | some stmt =>
          rw [hSt] at hStep; dsimp at hStep
          unfold evalStatementRef at hStep
          rw [if_bool_false hL] at hStep
          cases stmt with
          | nop =>
            injection hStep with e; subst e; exact ⟨_, rfl, rfl⟩
          | unsupported => cases hStep
          | storageLive lid =>
            dsimp at hStep
            cases h1 : Trusted.MirSemantics.getElem? body.locals lid with
            | none => rw [h1] at hStep; cases hStep
            | some lTy =>
              rw [h1] at hStep; dsimp at hStep
              cases h2 : setElem? f.locals lid (liveUninitSlotRef lTy) with
              | none => rw [h2] at hStep; cases hStep
              | some _ =>
                rw [h2] at hStep
                cases h3 : setElem? f.epochs lid f.nextEpoch with
                | none => rw [h3] at hStep; cases hStep
                | some _ =>
                  rw [h3] at hStep
                  injection hStep with e; subst e; exact ⟨_, rfl, rfl⟩
          | storageDead lid =>
            dsimp at hStep
            cases h1 : Nat.beq lid 0 with
            | true => rw [if_bool_true h1] at hStep; cases hStep
            | false =>
              rw [if_bool_false h1] at hStep
              cases h2 : setElem? f.locals lid .dead with
              | none => rw [h2] at hStep; cases hStep
              | some _ =>
                rw [h2] at hStep
                injection hStep with e; subst e; exact ⟨_, rfl, rfl⟩
          | assign dst rv =>
            dsimp at hStep
            cases hPr : dst.projection with
            | nil =>
              rw [hPr] at hStep; dsimp at hStep
              cases h1 : Trusted.MirSemantics.getElem? body.locals dst.localId
              with
              | none => rw [h1] at hStep; cases hStep
              | some dstTy =>
                rw [h1] at hStep; dsimp at hStep
                cases h2 : evalRvalueRef body.locals f.locals f.epochs
                    f.borrowNodes f.nextTag dst.localId false dstTy rv with
                | error _ => rw [h2] at hStep; cases hStep
                | ok rr =>
                  rw [h2] at hStep
                  cases rr with
                  | mk val r1 =>
                    cases r1 with
                    | mk l1 r2 =>
                      cases r2 with
                      | mk n1 _ =>
                        dsimp at hStep
                        cases h3 : writeTargetSlotRef body.locals l1 f.epochs
                            n1 dst.localId none dstTy val with
                        | error _ => rw [h3] at hStep; cases hStep
                        | ok wr =>
                          rw [h3] at hStep
                          cases wr with
                          | mk _ _ =>
                            injection hStep with e; subst e; exact ⟨_, rfl, rfl⟩
            | cons pe rest =>
              rw [hPr] at hStep
              cases pe with
              | field _ _ | unsupported => cases hStep
              | deref =>
                cases rest with
                | cons _ _ => cases hStep
                | nil =>
                  dsimp at hStep
                  cases h1 : resolveDerefDstRef body.locals f.locals f.epochs
                      f.borrowNodes dst.localId with
                  | error _ => rw [h1] at hStep; cases hStep
                  | ok dr =>
                    rw [h1] at hStep
                    cases dr with
                    | mk dS d1 =>
                      cases d1 with
                      | mk dM d2 =>
                        cases d2 with
                        | mk dstTy d3 =>
                          cases d3 with
                          | mk ptr nD =>
                            dsimp at hStep
                            cases h2 : evalRvalueRef body.locals f.locals
                                f.epochs nD f.nextTag ptr.targetLocal true
                                dstTy rv with
                            | error _ => rw [h2] at hStep; cases hStep
                            | ok rr =>
                              rw [h2] at hStep
                              cases rr with
                              | mk val r1 =>
                                cases r1 with
                                | mk l1 r2 =>
                                  cases r2 with
                                  | mk n1 _ =>
                                    dsimp at hStep
                                    cases h3 : writeTargetSlotRef body.locals
                                        l1 f.epochs n1 ptr.targetLocal
                                        (some (dS, dM, ptr)) dstTy val with
                                    | error _ => rw [h3] at hStep; cases hStep
                                    | ok wr =>
                                      rw [h3] at hStep
                                      cases wr with
                                      | mk _ _ =>
                                        injection hStep with e; subst e
                                        exact ⟨_, rfl, rfl⟩
        | none =>
          rw [hSt] at hStep; dsimp at hStep
          cases hE : Nat.beq f.stmtIdx bb.statements.length with
          | false => rw [if_bool_false hE] at hStep; cases hStep
          | true =>
            rw [if_bool_true hE] at hStep
            unfold evalTerminatorRef at hStep
            rw [if_bool_false hL] at hStep
            cases hT : bb.terminator with
            | goto _ =>
              rw [hT] at hStep; dsimp [jumpToBlockRef] at hStep
              injection hStep with e; subst e; exact ⟨_, rfl, rfl⟩
            | return_ =>
              rw [hT] at hStep; dsimp at hStep
              cases hCl : bb.cleanup with
              | true => rw [if_bool_true hCl] at hStep; cases hStep
              | false =>
                rw [if_bool_false hCl] at hStep
                cases h0 : Trusted.MirSemantics.getElem? f.locals 0 with
                | none => rw [h0] at hStep; cases hStep
                | some sl =>
                  rw [h0] at hStep
                  cases sl with
                  | dead => cases hStep
                  | live ov =>
                    cases ov with
                    | none => cases hStep
                    | some vr => cases vr <;> cases hStep
            | unreachable | unwindResume | assert _ _ _ _ _
            | call _ _ _ _ _ | unsupported =>
              rw [hT] at hStep; cases hStep
            | switchInt discr ts =>
              rw [hT] at hStep; dsimp at hStep
              cases hD : evalPrimitiveOperandRef body.locals f.locals f.epochs
                  f.borrowNodes discr with
              | error _ => rw [hD] at hStep; cases hStep
              | ok dRes =>
                rw [hD] at hStep
                cases dRes with
                | mk dv d1 =>
                  cases d1 with
                  | mk _ _ =>
                    dsimp at hStep
                    cases dv with
                    | scalar sv =>
                      dsimp at hStep
                      cases hSw : evalSwitchBranches sv.width sv.bits
                          ts.otherwise ts.branches with
                      | error _ => rw [hSw] at hStep; cases hStep
                      | ok _ =>
                        rw [hSw] at hStep; dsimp [jumpToBlockRef] at hStep
                        injection hStep with e; subst e; exact ⟨_, rfl, rfl⟩
                    | bool b =>
                      dsimp at hStep
                      cases hSw : evalBoolSwitchBranches b ts.otherwise
                          ts.branches with
                      | error _ => rw [hSw] at hStep; cases hStep
                      | ok _ =>
                        rw [hSw] at hStep; dsimp [jumpToBlockRef] at hStep
                        injection hStep with e; subst e; exact ⟨_, rfl, rfl⟩
                    | _ => cases hStep

private theorem s3b_queryEquiv_sameEntry {p₁ p₂ : Program}
    (hPw : p₂.pointerWidthBits = p₁.pointerWidthBits)
    (hVer : p₂.mirProfileVersion = p₁.mirProfileVersion)
    (hEnt : p₂.entryDefId = p₁.entryDefId)
    (hBody :
      Trusted.MirSemantics.getElem? p₂.bodies p₁.entryDefId =
        Trusted.MirSemantics.getElem? p₁.bodies p₁.entryDefId) :
    s3b_QueryEquiv p₁ p₂ := by
  intro q
  have hInitEq : initStateRef p₂ q = initStateRef p₁ q := by
    unfold initStateRef
    rw [hPw, hVer, hEnt, hBody]
  apply query_equiv_of_lockstep_sim
    (R := fun s₁ s₂ =>
      ∃ f mem,
        s₁ = { frames := [f], callerMem := mem } ∧
        s₂ = s₁ ∧
        f.defId = p₁.entryDefId)
  · intro k hErr; rw [hInitEq]; exact hErr
  · intro s₀ hOk
    have hOk2 : initStateRef p₂ q = .ok s₀ := by rw [hInitEq]; exact hOk
    unfold initStateRef at hOk
    cases hHdr :
        (!Nat.beq p₁.pointerWidthBits 64 || !Nat.beq p₁.mirProfileVersion 1)
    with
    | true => rw [if_bool_true hHdr] at hOk; cases hOk
    | false =>
      rw [if_bool_false hHdr] at hOk
      cases hMem : !q.callerMem.allocations.isEmpty with
      | true => rw [if_bool_true hMem] at hOk; cases hOk
      | false =>
        rw [if_bool_false hMem] at hOk
        cases hB : Trusted.MirSemantics.getElem? p₁.bodies p₁.entryDefId with
        | none => rw [hB] at hOk; cases hOk
        | some body =>
          rw [hB] at hOk; dsimp at hOk
          cases hE : body.basicBlocks.isEmpty with
          | true => rw [if_bool_true hE] at hOk; cases hOk
          | false =>
            rw [if_bool_false hE] at hOk
            cases hA : !Nat.blt body.argumentCount body.locals.length with
            | true => rw [if_bool_true hA] at hOk; cases hOk
            | false =>
              rw [if_bool_false hA] at hOk
              cases hS : !storageAnnotationsInBounds body with
              | true => rw [if_bool_true hS] at hOk; cases hOk
              | false =>
                rw [if_bool_false hS] at hOk
                cases hAd : !bodyLocalsAdmittedRef body with
                | true => rw [if_bool_true hAd] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hAd] at hOk
                  cases hAM : !checkArgsMatch q.args
                      ((body.locals.drop 1).take body.argumentCount) with
                  | true => rw [if_bool_true hAM] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hAM] at hOk
                    injection hOk with hs0; subst hs0
                    exact ⟨_, hOk2, _, q.callerMem, rfl, rfl, rfl⟩
  · intro s₁ s₂ hR
    let ⟨f, mem, hs1, hs2, hDef⟩ := hR
    subst hs1; subst hs2
    unfold LockstepStepRel
    have hStepEq :
        evalStepRef p₂ 0 { frames := [f], callerMem := mem } =
          evalStepRef p₁ 0 { frames := [f], callerMem := mem } := by
      unfold evalStepRef
      dsimp
      rw [hDef, hBody]
    rw [hStepEq]
    cases hEv : evalStepRef p₁ 0 { frames := [f], callerMem := mem } with
    | done _ => rfl
    | fault _ => rfl
    | step s' =>
      let ⟨f', hs', hDef'⟩ := s3b_evalStep_preserves_defId hEv
      exact ⟨s', rfl, f', mem, hs', rfl, hDef'.trans hDef⟩

private noncomputable def s3b_FrameRel (c : s3b_Ctx) (defId : DefId)
    (fS fT : FrameStateRef) : Prop :=
  ∃ bbSrc rL xL mode pm,
    fS.defId = defId ∧
    fT.defId = defId ∧
    fT.blockIdx = fS.blockIdx ∧
    fT.stmtIdx = fS.stmtIdx ∧
    fT.epochs = fS.epochs ∧
    fT.nextEpoch = fS.nextEpoch ∧
    Trusted.MirSemantics.getElem? c.bodySrc.basicBlocks fS.blockIdx =
      some bbSrc ∧
    fS.stmtIdx ≤ bbSrc.statements.length ∧
    s3b_absStateAtIdx c.bodySrc.locals c.r c.x c.rTy c.xTy c.rIsMut
      c.isSafeRef c.trackTb fS.stmtIdx
      (getAbsState c.inStates fS.blockIdx) bbSrc.statements =
      some (.reachable rL xL mode) ∧
    s3b_CoreInv c rL xL mode fS.locals fT.locals fS.epochs fS.nextEpoch
      fS.borrowNodes fT.borrowNodes fS.nextTag fT.nextTag pm

private theorem s3b_queryEquiv_propEntry (c : s3b_Ctx) {p₁ p₂ : Program}
    (hPw : p₂.pointerWidthBits = p₁.pointerWidthBits)
    (hVer : p₂.mirProfileVersion = p₁.mirProfileVersion)
    (hEnt : p₂.entryDefId = p₁.entryDefId)
    (hBSrc : Trusted.MirSemantics.getElem? p₁.bodies p₁.entryDefId =
      some c.bodySrc)
    (hBTgt : Trusted.MirSemantics.getElem? p₂.bodies p₁.entryDefId =
      some c.bodyTgt) :
    s3b_QueryEquiv p₁ p₂ := by
  intro q
  have hParamEq :
      (c.bodyTgt.locals.drop 1).take c.bodyTgt.argumentCount =
        (c.bodySrc.locals.drop 1).take c.bodySrc.argumentCount := by
    rw [c.hArgCntEq]
    exact s3b_setElem_drop1_take_eq c.hArgLtR c.hSetLocals
  apply query_equiv_of_lockstep_sim
    (R := fun s₁ s₂ =>
      ∃ fS fT mem,
        s₁ = { frames := [fS], callerMem := mem } ∧
        s₂ = { frames := [fT], callerMem := mem } ∧
        s3b_FrameRel c p₁.entryDefId fS fT)
  · intro k hErr
    unfold initStateRef at hErr
    unfold initStateRef
    rw [hBSrc] at hErr
    rw [hPw, hVer, hEnt, hBTgt]
    cases hHdr :
        (!Nat.beq p₁.pointerWidthBits 64 || !Nat.beq p₁.mirProfileVersion 1)
    with
    | true => rw [if_bool_true hHdr] at hErr; rw [if_bool_true rfl]; exact hErr
    | false =>
      rw [if_bool_false hHdr] at hErr; rw [if_bool_false rfl]
      cases hMem : !q.callerMem.allocations.isEmpty with
      | true =>
        rw [if_bool_true hMem] at hErr; rw [if_bool_true rfl]; exact hErr
      | false =>
        rw [if_bool_false hMem] at hErr; rw [if_bool_false rfl]
        dsimp at hErr; dsimp
        rw [c.hNonEmpty, c.hStorageInBounds, c.hAdmittedSrc] at hErr
        rw [s3b_ctx_blocksTgt_nonEmpty c, c.hArgCntEq,
            s3b_ctx_localsTgt_len c, s3b_ctx_storageInBounds_tgt c,
            s3b_ctx_admitted_tgt c]
        dsimp at hErr; dsimp
        cases hAC : !Nat.blt c.bodySrc.argumentCount c.bodySrc.locals.length
        with
        | true => rw [if_bool_true hAC] at hErr; rw [if_bool_true rfl]; exact hErr
        | false =>
          rw [if_bool_false hAC] at hErr; rw [if_bool_false rfl]
          rw [← c.hArgCntEq, hParamEq]
          cases hAM : !checkArgsMatch q.args
              ((c.bodySrc.locals.drop 1).take c.bodySrc.argumentCount) with
          | true =>
            rw [if_bool_true hAM] at hErr; rw [if_bool_true rfl]; exact hErr
          | false => rw [if_bool_false hAM] at hErr; cases hErr
  · intro s₀ hOk
    unfold initStateRef at hOk
    unfold initStateRef
    rw [hBSrc] at hOk
    rw [hPw, hVer, hEnt, hBTgt]
    cases hHdr :
        (!Nat.beq p₁.pointerWidthBits 64 || !Nat.beq p₁.mirProfileVersion 1)
    with
    | true => rw [if_bool_true hHdr] at hOk; cases hOk
    | false =>
      rw [if_bool_false hHdr] at hOk; rw [if_bool_false rfl]
      cases hMem : !q.callerMem.allocations.isEmpty with
      | true => rw [if_bool_true hMem] at hOk; cases hOk
      | false =>
        rw [if_bool_false hMem] at hOk; rw [if_bool_false rfl]
        dsimp at hOk; dsimp
        rw [c.hNonEmpty, c.hStorageInBounds, c.hAdmittedSrc] at hOk
        rw [s3b_ctx_blocksTgt_nonEmpty c, c.hArgCntEq,
            s3b_ctx_localsTgt_len c, s3b_ctx_storageInBounds_tgt c,
            s3b_ctx_admitted_tgt c]
        dsimp at hOk; dsimp
        cases hAC : !Nat.blt c.bodySrc.argumentCount c.bodySrc.locals.length
        with
        | true => rw [if_bool_true hAC] at hOk; cases hOk
        | false =>
          rw [if_bool_false hAC] at hOk; rw [if_bool_false rfl]
          rw [← c.hArgCntEq, hParamEq]
          cases hAM : !checkArgsMatch q.args
              ((c.bodySrc.locals.drop 1).take c.bodySrc.argumentCount) with
          | true => rw [if_bool_true hAM] at hOk; cases hOk
          | false =>
            rw [if_bool_false hAM] at hOk; rw [if_bool_false rfl]
            injection hOk with hs0; subst hs0
            have hArgsTrue := bool_not_false hAM
            let ⟨rL0, xL0, m0, hSt0, hCore0⟩ := s3b_initCoreInv c q.args hArgsTrue
            have hBb0Lt : 0 < c.bodySrc.basicBlocks.length := by
              cases hBbs : c.bodySrc.basicBlocks with
              | nil => have hNE := c.hNonEmpty; rw [hBbs] at hNE; cases hNE
              | cons _ _ => exact Nat.zero_lt_succ _
            let ⟨bb0, hGetBb0⟩ := getElem?_some_of_lt c.bodySrc.basicBlocks 0 hBb0Lt
            have hEpMapEq :
                c.bodyTgt.locals.map (fun _ => 1) =
                  c.bodySrc.locals.map (fun _ => 1) :=
              s3b_map_const_eq_of_len 1 (s3b_ctx_localsTgt_len c)
            refine ⟨_, rfl, _, _, q.callerMem, rfl, rfl,
              bb0, rL0, xL0, m0, fun _ _ => [],
              rfl, rfl, rfl, rfl, hEpMapEq, rfl, hGetBb0, Nat.zero_le _, ?_,
              hCore0⟩
            dsimp [s3b_absStateAtIdx]
            rw [hSt0]
  · intro s₁ s₂ hR
    let ⟨fS, fT, mem, hs1, hs2, bbSrc, rL, xL, mode, pm,
         hDefS, hDefT, hBlkEq, hIdxEq, hEpEq, hNEpEq, hGetBbS, hIdxLe,
         hAtIdx, hCore⟩ := hR
    subst hs1; subst hs2
    have hLenS : (!Nat.beq fS.epochs.length fS.locals.length) = false := by
      rw [hCore.hLenEp, hCore.hLenLocS, nat_beq_refl]; rfl
    have hLenT : (!Nat.beq fT.epochs.length fT.locals.length) = false := by
      rw [hEpEq, hCore.hLenEp, hCore.hLenLocT, nat_beq_refl]; rfl
    let ⟨bbTgt, outSt, succs, afterTermSt, hGetBbT, hCl, hAllStmts, hAbsTerm,
         hSuccsLe⟩ :=
      s3b_verifyBlocks_getElem? c.hVerify hGetBbS
    rw [s3b_zero_add] at hAllStmts
    have hStmtsLenEq := s3b_absStepStmts_length hAllStmts
    unfold LockstepStepRel evalStepRef
    dsimp
    rw [if_bool_false hLenS, if_bool_false hLenT, hDefS, hDefT, hBSrc, hBTgt]
    dsimp
    rw [hBlkEq, hGetBbS, hGetBbT]
    dsimp
    cases hGetStmt : Trusted.MirSemantics.getElem? bbSrc.statements fS.stmtIdx
    with
    | some stmt =>
      let ⟨stNext, stmt', hGetStmtT, hStepAbs, hAtNext⟩ :=
        s3b_absStateAtIdx_step hAllStmts hAtIdx hGetStmt
      rw [hIdxEq, hGetStmtT]
      dsimp
      have hExclStmt :
          c.trackTb = true →
          stmtOnlyTakesAddrOfTargetFor c.r c.x c.rTy stmt = true := by
        intro hTr
        have hExB := list_all_getElem? (c.hExcl hTr) hGetBbS
        exact list_all_getElem? hExB hGetStmt
      have hSim :=
        s3b_evalStatement_sim (mem := mem) hCore (hDefT.trans hDefS.symm)
          hBlkEq hIdxEq hEpEq hNEpEq hExclStmt hStepAbs
      cases hEvS : evalStatementRef c.bodySrc fS mem stmt with
      | fault _ =>
        rw [hEvS] at hSim
        cases hEvT : evalStatementRef c.bodyTgt fT mem stmt' with
        | fault _ => rw [hEvT] at hSim; rw [← hSim]
        | done _ => rw [hEvT] at hSim; exact False.elim hSim
        | step _ => rw [hEvT] at hSim; exact False.elim hSim
      | done _ =>
        rw [hEvS] at hSim
        cases hEvT : evalStatementRef c.bodyTgt fT mem stmt' with
        | fault _ => rw [hEvT] at hSim; exact False.elim hSim
        | done _ => rw [hEvT] at hSim; rw [← hSim]
        | step _ => rw [hEvT] at hSim; exact False.elim hSim
      | step sS' =>
        rw [hEvS] at hSim
        cases hEvT : evalStatementRef c.bodyTgt fT mem stmt' with
        | fault _ => rw [hEvT] at hSim; exact False.elim hSim
        | done _ => rw [hEvT] at hSim; exact False.elim hSim
        | step sT' =>
          rw [hEvT] at hSim
          let ⟨fS', fT', rL₁, xL₁, mode₁, pm', hStNextEq, hsS', hsT',
               hDS', hDT', hBS', hBT', hIS', hIT', hEp', hNEp', hCore'⟩ := hSim
          subst hStNextEq
          have hIdxLt : fS.stmtIdx < bbSrc.statements.length :=
            getElem?_some_lt hGetStmt
          refine ⟨sT', rfl, fS', fT', mem, hsS', hsT', bbSrc, rL₁, xL₁, mode₁,
            pm', hDS'.trans hDefS, hDT'.trans hDefT,
            hBT'.trans (hBlkEq.trans hBS'.symm),
            hIT'.trans ((congrArg (fun n => n + 1) hIdxEq).trans hIS'.symm),
            hEp', hNEp', ?_, ?_, ?_, hCore'⟩
          · rw [hBS']; exact hGetBbS
          · rw [hIS']; exact Nat.succ_le_of_lt hIdxLt
          · rw [hBS', hIS']; exact hAtNext
    | none =>
      have hGeLen : bbSrc.statements.length ≤ fS.stmtIdx :=
        getElem?_none_ge hGetStmt
      have hAtEndEq : fS.stmtIdx = bbSrc.statements.length :=
        Nat.le_antisymm hIdxLe hGeLen
      have hNoneT :
          Trusted.MirSemantics.getElem? bbTgt.statements fT.stmtIdx = none :=
        getElem?_none_of_ge (by rw [hStmtsLenEq, hIdxEq, hAtEndEq]; exact Nat.le_refl _)
      rw [hNoneT, nat_beq_of_eq hAtEndEq,
          nat_beq_of_eq (by rw [hIdxEq, hStmtsLenEq]; exact hAtEndEq)]
      dsimp
      have hOutEq : .reachable rL xL mode = outSt := by
        rw [hAtEndEq] at hAtIdx
        exact s3b_absStateAtIdx_end hAllStmts hAtIdx
      rw [← hOutEq] at hAbsTerm
      have hTermBounds :
          terminatorBlocksLt c.bodySrc.basicBlocks.length bbSrc.terminator =
            true := by
        have hBB :
            c.bodySrc.basicBlocks.all
              (fun bb =>
                terminatorBlocksLt c.bodySrc.basicBlocks.length bb.terminator) =
              true := c.hBlocksInBounds
        exact list_all_getElem?
          (p := fun bb =>
            terminatorBlocksLt c.bodySrc.basicBlocks.length bb.terminator)
          hBB hGetBbS
      have hSim :=
        s3b_evalTerminator_sim (mem := mem) hCore hCl hEpEq hNEpEq hTermBounds
          hAbsTerm hSuccsLe
      cases hEvS : evalTerminatorRef c.bodySrc bbSrc fS mem with
      | fault _ =>
        rw [hEvS] at hSim
        cases hEvT : evalTerminatorRef c.bodyTgt bbTgt fT mem with
        | fault _ => rw [hEvT] at hSim; rw [← hSim]
        | done _ => rw [hEvT] at hSim; exact False.elim hSim
        | step _ => rw [hEvT] at hSim; exact False.elim hSim
      | done _ =>
        rw [hEvS] at hSim
        cases hEvT : evalTerminatorRef c.bodyTgt bbTgt fT mem with
        | fault _ => rw [hEvT] at hSim; exact False.elim hSim
        | done _ => rw [hEvT] at hSim; rw [← hSim]
        | step _ => rw [hEvT] at hSim; exact False.elim hSim
      | step sS' =>
        rw [hEvS] at hSim
        cases hEvT : evalTerminatorRef c.bodyTgt bbTgt fT mem with
        | fault _ => rw [hEvT] at hSim; exact False.elim hSim
        | done _ => rw [hEvT] at hSim; exact False.elim hSim
        | step sT' =>
          rw [hEvT] at hSim
          let ⟨fS', fT', rL', xL', mode', pm', hStNew, hBlkLt, hsS', hsT',
               hDS', hDT', hBT', hIS', hIT', hEp', hNEp', hCore'⟩ := hSim
          let ⟨bbSrc', hGetBbS'⟩ :=
            getElem?_some_of_lt c.bodySrc.basicBlocks fS'.blockIdx hBlkLt
          refine ⟨sT', rfl, fS', fT', mem, hsS', hsT', bbSrc', rL', xL',
            mode', pm', hDS'.trans hDefS, hDT'.trans hDefT, hBT',
            hIT'.trans hIS'.symm, hEp', hNEp', hGetBbS',
            by rw [hIS']; exact Nat.zero_le _, ?_, hCore'⟩
          rw [hIS']
          dsimp [s3b_absStateAtIdx]
          rw [hStNew]

/-- Single-step `propagateSsaRef` soundness theorem: if
`applyPropagateSsaRef plan pSrc = some pTgt`, then `pSrc` and `pTgt` satisfy
full bidirectional semantic equivalence in `M_refPtr` (`WellFormedRef`,
`BehaviorRef`, exact fault kinds, `DivergesRef`, `SatisfiesPostRef`, and
`BodyVerifiedRef`). -/
private theorem propagateSsaRef_sound_bidirectional_iff_slice3b
    (plan : RefPropPlan) (pSrc pTgt : Program)
    (hProp : applyPropagateSsaRef plan pSrc = some pTgt) :
    FullSemanticEquivRef pSrc pTgt := by
  unfold applyPropagateSsaRef at hProp
  cases hGetBody : Trusted.MirSemantics.getElem? pSrc.bodies plan.defId with
  | none => rw [hGetBody] at hProp; cases hProp
  | some bodySrc =>
    rw [hGetBody] at hProp
    dsimp at hProp
    cases hG1 :
        (bodySrc.basicBlocks.isEmpty ||
          !bodyAllLocalsInBounds bodySrc ||
          !bodyAllBlocksInBounds bodySrc ||
          !storageAnnotationsInBounds bodySrc ||
          !bodyLocalsAdmittedRef bodySrc ||
          !Nat.blt bodySrc.argumentCount plan.refLocal ||
          !Nat.blt plan.refLocal bodySrc.locals.length ||
          !Nat.blt plan.targetLocal bodySrc.locals.length ||
          Nat.beq plan.refLocal plan.targetLocal ||
          bodyTakesAddressOf bodySrc plan.refLocal) with
    | true => rw [if_bool_true hG1] at hProp; cases hProp
    | false =>
      rw [if_bool_false hG1] at hProp
      let ⟨g9, hNoAddr⟩ := bool_or_false hG1
      let ⟨g8, hNeBeq⟩ := bool_or_false g9
      let ⟨g7, hXLtB⟩ := bool_or_false g8
      let ⟨g6, hRLtB⟩ := bool_or_false g7
      let ⟨g5, hArgLtB⟩ := bool_or_false g6
      let ⟨g4, hAdmB⟩ := bool_or_false g5
      let ⟨g3, hSbB⟩ := bool_or_false g4
      let ⟨g2, hBbIB⟩ := bool_or_false g3
      let ⟨hNonEmp, hLocIB⟩ := bool_or_false g2
      cases hGR : Trusted.MirSemantics.getElem? bodySrc.locals plan.refLocal
      with
      | none => rw [hGR] at hProp; cases hProp
      | some rTy =>
        rw [hGR] at hProp
        cases hGX :
            Trusted.MirSemantics.getElem? bodySrc.locals plan.targetLocal with
        | none => rw [hGX] at hProp; cases hProp
        | some xTy =>
          rw [hGX] at hProp; dsimp at hProp
          cases hPI : ptrPointeeInfo? rTy with
          | none => rw [hPI] at hProp; cases hProp
          | some pInf =>
            rw [hPI] at hProp
            cases pInf with
            | mk isSafeRef pRest =>
              cases pRest with
              | mk rMut innerTy =>
                dsimp at hProp
                cases hG2 :
                    (!MirTy.beq innerTy xTy ||
                      (isSafeRef && !isOpsemInhabitedTy innerTy) ||
                      ((isSafeRef && !isZeroSizedTy xTy) &&
                        !bodyExclusiveTargetBorrow bodySrc plan.refLocal
                          plan.targetLocal rTy)) with
                | true => rw [if_bool_true hG2] at hProp; cases hProp
                | false =>
                  rw [if_bool_false hG2] at hProp
                  let ⟨hG2a, hExclF⟩ := bool_or_false hG2
                  let ⟨hInEqF, hInhF⟩ := bool_or_false hG2a
                  have hInnerEq := mirTy_beq_eq (bool_not_false hInEqF)
                  subst innerTy
                  let r := plan.refLocal
                  let x := plan.targetLocal
                  let rIsMut := Mutability.beq rMut .mut
                  let trackTb := isSafeRef && !isZeroSizedTy xTy
                  let initVec :=
                    bodySrc.basicBlocks.map (fun _ => AbsRefState.unreachable)
                  let entrySt := initAbsState bodySrc r x
                  let seeded := joinAtBlock initVec 0 entrySt
                  let fuel := 8 * bodySrc.basicBlocks.length + 2
                  let inStates :=
                    iterateForwardAbsStates bodySrc r x rTy xTy rIsMut isSafeRef
                      trackTb fuel seeded
                  change
                    (if !Nat.beq inStates.length bodySrc.basicBlocks.length ||
                        !absLe entrySt (getAbsState inStates 0) then
                       none
                     else _) = some pTgt at hProp
                  cases hG3 :
                      (!Nat.beq inStates.length bodySrc.basicBlocks.length ||
                        !absLe entrySt (getAbsState inStates 0)) with
                  | true => rw [if_bool_true hG3] at hProp; cases hProp
                  | false =>
                    rw [if_bool_false hG3] at hProp
                    let ⟨hInLenF, hEntLeF⟩ := bool_or_false hG3
                    cases hVer :
                        verifyAndRewriteBlocksLoop bodySrc.locals r x rTy xTy
                          rIsMut isSafeRef trackTb inStates 0
                          bodySrc.basicBlocks with
                    | none => rw [hVer] at hProp; cases hProp
                    | some blocksTgt =>
                      rw [hVer] at hProp
                      cases hSetL : setElem? bodySrc.locals r .unit with
                      | none => rw [hSetL] at hProp; cases hProp
                      | some localsTgt =>
                        rw [hSetL] at hProp; dsimp at hProp
                        let bodyTgt : Body := {
                          bodySrc with
                          locals := localsTgt
                          basicBlocks := blocksTgt
                        }
                        change
                          (if bodyMentionsLocalExceptStorage r bodyTgt then
                             none
                           else
                             match setElem? pSrc.bodies plan.defId bodyTgt with
                             | some bodiesTgt =>
                               some { pSrc with bodies := bodiesTgt }
                             | none => none) = some pTgt at hProp
                        cases hMentTgt :
                            bodyMentionsLocalExceptStorage r bodyTgt with
                        | true => rw [if_bool_true hMentTgt] at hProp; cases hProp
                        | false =>
                          rw [if_bool_false hMentTgt] at hProp
                          cases hSetB :
                              setElem? pSrc.bodies plan.defId bodyTgt with
                          | none => rw [hSetB] at hProp; cases hProp
                          | some bodiesTgt =>
                            rw [hSetB] at hProp
                            injection hProp with hpEq
                            have hPTgt :
                                pTgt = { pSrc with bodies := bodiesTgt } :=
                              hpEq.symm
                            subst hPTgt
                            let ctx : s3b_Ctx := {
                              bodySrc := bodySrc
                              bodyTgt := bodyTgt
                              r := r
                              x := x
                              rTy := rTy
                              xTy := xTy
                              isSafeRef := isSafeRef
                              rMut := rMut
                              rIsMut := rIsMut
                              trackTb := trackTb
                              inStates := inStates
                              hNonEmpty := hNonEmp
                              hLocsInBounds := bool_not_false hLocIB
                              hBlocksInBounds := bool_not_false hBbIB
                              hStorageInBounds := bool_not_false hSbB
                              hAdmittedSrc := bool_not_false hAdmB
                              hArgLtR := nat_blt_lt (bool_not_false hArgLtB)
                              hRLt := nat_blt_lt (bool_not_false hRLtB)
                              hXLt := nat_blt_lt (bool_not_false hXLtB)
                              hRNeX := nat_ne_of_beq_false hNeBeq
                              hNoAddrSrc := hNoAddr
                              hNoMentionsTgt := hMentTgt
                              hGetRSrc := hGR
                              hGetXSrc := hGX
                              hSetLocals := hSetL
                              hArgCntEq := rfl
                              hUnsafeEq := rfl
                              hIdentityEq := rfl
                              hPtrInfo := hPI
                              hRIsMut := rfl
                              hTrackTb := rfl
                              hInhab := fun hSR => by
                                cases hInh0 : isOpsemInhabitedTy xTy with
                                | true => rfl
                                | false =>
                                  rw [hSR, hInh0] at hInhF
                                  cases hInhF
                              hExcl := fun hTr => by
                                change trackTb = true at hTr
                                change (trackTb &&
                                  !bodyExclusiveTargetBorrow bodySrc r x rTy) =
                                    false at hExclF
                                cases hEx0 :
                                    bodyExclusiveTargetBorrow bodySrc r x rTy with
                                | true => rfl
                                | false =>
                                  rw [hTr, hEx0] at hExclF
                                  cases hExclF
                              hInLen := nat_beq_eq (bool_not_false hInLenF)
                              hEntryLe := bool_not_false hEntLeF
                              hVerify := hVer
                            }
                            have hQAny : ∀ d : DefId,
                                s3b_QueryEquiv (entryProgForBody pSrc d)
                                  (entryProgForBody
                                    { pSrc with bodies := bodiesTgt } d) := by
                              intro d
                              cases hEqD : Nat.beq d plan.defId with
                              | true =>
                                have ed := nat_beq_eq hEqD; subst ed
                                exact s3b_queryEquiv_propEntry ctx rfl rfl rfl
                                  hGetBody (setElem?_getElem?_same hSetB)
                              | false =>
                                exact s3b_queryEquiv_sameEntry rfl rfl rfl
                                  (setElem?_getElem?_ne hSetB
                                    (nat_ne_of_beq_false hEqD))
                            have hQRoot :
                                s3b_QueryEquiv pSrc
                                  { pSrc with bodies := bodiesTgt } := by
                              cases hEqE : Nat.beq pSrc.entryDefId plan.defId
                              with
                              | true =>
                                have ee := nat_beq_eq hEqE
                                have hGB' :
                                    Trusted.MirSemantics.getElem? pSrc.bodies
                                      pSrc.entryDefId = some bodySrc := by
                                  rw [ee]; exact hGetBody
                                have hSB' :
                                    Trusted.MirSemantics.getElem? bodiesTgt
                                      pSrc.entryDefId = some bodyTgt := by
                                  rw [ee]; exact setElem?_getElem?_same hSetB
                                exact s3b_queryEquiv_propEntry ctx rfl rfl rfl
                                  hGB' hSB'
                              | false =>
                                exact s3b_queryEquiv_sameEntry rfl rfl rfl
                                  (setElem?_getElem?_ne hSetB
                                    (nat_ne_of_beq_false hEqE))
                            refine ⟨hQRoot, ?_, ?_⟩
                            · intro q post
                              let ⟨hWf, hBeh, _, _⟩ := hQRoot q
                              exact satisfiesPostRef_iff_of_query_equiv hWf
                                hBeh post
                            · intro defId bSrc bTgt safetyPre hBS hBT
                              have hQD := hQAny defId
                              cases hEqD : Nat.beq defId plan.defId with
                              | false =>
                                rw [setElem?_getElem?_ne hSetB
                                      (nat_ne_of_beq_false hEqD),
                                    hBS] at hBT
                                injection hBT with eb; subst eb
                                unfold BodyVerifiedRef BodyStaticAdmittedRef
                                dsimp
                                constructor
                                · intro ⟨_, hSt, hRun⟩
                                  refine ⟨hBS, hSt, ?_⟩
                                  intro args hVA hSafe
                                  exact (hQD { args := args }).1.mp
                                    (hRun args hVA hSafe)
                                · intro ⟨_, hSt, hRun⟩
                                  refine ⟨by
                                    rw [setElem?_getElem?_ne hSetB
                                          (nat_ne_of_beq_false hEqD)]
                                    exact hBS, hSt, ?_⟩
                                  intro args hVA hSafe
                                  exact (hQD { args := args }).1.mpr
                                    (hRun args hVA hSafe)
                              | true =>
                                have ed := nat_beq_eq hEqD; subst ed
                                rw [hGetBody] at hBS
                                injection hBS with eb1; subst eb1
                                rw [setElem?_getElem?_same hSetB] at hBT
                                injection hBT with eb2; subst eb2
                                have hStEq :
                                    BodyStaticAdmittedRef
                                      { pSrc with bodies := bodiesTgt }
                                      ctx.bodyTgt =
                                    BodyStaticAdmittedRef pSrc ctx.bodySrc := by
                                  unfold BodyStaticAdmittedRef
                                  dsimp
                                  rw [ctx.hIdentityEq,
                                      s3b_ctx_blocksTgt_nonEmpty ctx,
                                      ctx.hNonEmpty, ctx.hArgCntEq,
                                      s3b_ctx_localsTgt_len ctx,
                                      s3b_ctx_storageInBounds_tgt ctx,
                                      ctx.hStorageInBounds,
                                      s3b_ctx_admitted_tgt ctx,
                                      ctx.hAdmittedSrc]
                                have hVA_eq : ∀ args,
                                    ValidEntryArgsRef ctx.bodyTgt args ↔
                                      ValidEntryArgsRef ctx.bodySrc args := by
                                  intro args
                                  unfold ValidEntryArgsRef
                                  rw [ctx.hArgCntEq,
                                      s3b_setElem_drop1_take_eq ctx.hArgLtR
                                        ctx.hSetLocals]
                                unfold BodyVerifiedRef
                                rw [hStEq, ctx.hUnsafeEq]
                                constructor
                                · intro ⟨_, hSt, hRun⟩
                                  refine ⟨hGetBody, hSt, ?_⟩
                                  intro args hVA hSafe
                                  exact (hQD { args := args }).1.mp
                                    (hRun args ((hVA_eq args).mpr hVA) hSafe)
                                · intro ⟨_, hSt, hRun⟩
                                  refine ⟨setElem?_getElem?_same hSetB, hSt, ?_⟩
                                  intro args hVA hSafe
                                  exact (hQD { args := args }).1.mpr
                                    (hRun args ((hVA_eq args).mp hVA) hSafe)

