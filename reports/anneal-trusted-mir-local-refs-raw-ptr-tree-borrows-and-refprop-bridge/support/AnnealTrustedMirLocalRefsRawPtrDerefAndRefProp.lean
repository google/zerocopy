/-- Equality of `BitVec n` from equality of `.toNat` using only `BasicAux`. -/
private theorem bv_eq_of_toNat_eq {n : Nat} {a b : BitVec n}
    (h : a.toNat = b.toNat) : a = b := by
  cases a with
  | ofFin af =>
    cases b with
    | ofFin bf =>
      cases af with
      | mk av aLt =>
        cases bf with
        | mk bv bLt =>
          dsimp [BitVec.toNat] at h
          subst h
          rfl

/-- Idempotence of `truncateBits .i32` on `BitVec 128` (`x % 2^32 < 2^32`). -/
private theorem truncateBits_i32_wf (x : BitVec 128) :
    ScalarVal.wf ⟨.i32, false, truncateBits .i32 x⟩ = true := by
  unfold ScalarVal.wf
  have hIdem :
      truncateBits .i32 (truncateBits .i32 x) = truncateBits .i32 x := by
    apply bv_eq_of_toNat_eq
    dsimp [truncateBits, bvZeroExtend, bvExtractLsb, bvExtractLsb',
      IntWidth.bitWidth, IntWidth.byteSize, Nat.shiftRight, BitVec.toNat,
      BitVec.ofNat, Fin.ofNat]
    change
      Nat.mod
        (Nat.mod
          (Nat.mod (Nat.mod x.toFin.val 4294967296)
            340282366920938463463374607431768211456)
          4294967296)
        340282366920938463463374607431768211456 =
      Nat.mod (Nat.mod x.toFin.val 4294967296)
        340282366920938463463374607431768211456
    have hLt32 : Nat.mod x.toFin.val 4294967296 < 4294967296 :=
      Nat.mod_lt x.toFin.val (by decide)
    have hLt128 :
        Nat.mod x.toFin.val 4294967296 <
          340282366920938463463374607431768211456 :=
      Nat.lt_trans hLt32 (by decide)
    have hEq128 :
        Nat.mod (Nat.mod x.toFin.val 4294967296)
          340282366920938463463374607431768211456 =
          Nat.mod x.toFin.val 4294967296 :=
      Nat.mod_eq_of_lt hLt128
    have hEq32 :
        Nat.mod (Nat.mod x.toFin.val 4294967296) 4294967296 =
          Nat.mod x.toFin.val 4294967296 :=
      Nat.mod_eq_of_lt hLt32
    rw [hEq128, hEq32]
    exact hEq128
  rw [hIdem]
  exact beq_self_eq_true _

/-- Invert `ValidEntryArgs` on a 1-parameter `u32` body into a canonical
well-formed `u32` `ScalarVal`. -/
private theorem validEntryArgs_u32_inv {b : Body} {args : List Val}
    (hCount : b.argumentCount = 1)
    (hDrop : (b.locals.drop 1).take 1 = [u32Ty])
    (hArgs : checkArgsMatch args ((b.locals.drop 1).take b.argumentCount) =
      true) :
    ∃ bits : BitVec 128,
      args = [.scalar ⟨.i32, false, bits⟩] ∧
      ScalarVal.wf ⟨.i32, false, bits⟩ = true := by
  rw [hCount, hDrop] at hArgs
  cases args with
  | nil => cases hArgs
  | cons v rest =>
    cases rest with
    | cons v2 rest2 =>
      dsimp [checkArgsMatch] at hArgs
      cases hChk : checkVal v u32Ty with
      | false =>
        rw [hChk] at hArgs
        cases hArgs
      | true =>
        rw [hChk] at hArgs
        cases hArgs
    | nil =>
      dsimp [checkArgsMatch] at hArgs
      cases v with
      | ptr _ => cases hArgs
      | bool _ => cases hArgs
      | unit => cases hArgs
      | tuple _ => cases hArgs
      | bytes _ => cases hArgs
      | enumVal ety var =>
        dsimp [checkVal, Val.ty?] at hArgs
        cases hAdm : (enumAdmitted ety &&
            Nat.blt var ety.discriminants.length) with
        | false =>
          rw [hAdm] at hArgs
          cases hArgs
        | true =>
          rw [hAdm] at hArgs
          cases hArgs
      | scalar sv =>
        cases sv with
        | mk w s bits =>
          dsimp [checkVal, Val.ty?] at hArgs
          cases hWf : ScalarVal.wf ⟨w, s, bits⟩ with
          | false =>
            rw [hWf] at hArgs
            cases hArgs
          | true =>
            rw [hWf] at hArgs
            cases w with
            | i8 => cases s <;> cases hArgs
            | i16 => cases s <;> cases hArgs
            | i64 => cases s <;> cases hArgs
            | i128 => cases s <;> cases hArgs
            | isize => cases s <;> cases hArgs
            | i32 =>
              cases s with
              | true => cases hArgs
              | false => exact ⟨bits, rfl, hWf⟩

/-- Symbolic `evalArithOp .add .i32 false` step on arbitrary integers `l, r`. -/
private theorem evalArithOp_u32_add (l r : Int) :
    evalArithOp .add .i32 false l r =
      Except.ok
        (.scalar ⟨.i32, false, truncateBits .i32 (bvOfInt 128 (l + r))⟩) := by
  change
    ((if ((decide (l + r < 0) || decide (l + r ≥ HPow.hPow (2 : Int) 128)) ||
          (truncateBits .i32 (bvOfInt 128 (l + r)) != bvOfInt 128 (l + r))) &&
          false then
      Except.error FaultKind.undefined
    else
      Except.ok
        (Val.scalar ⟨.i32, false, truncateBits .i32 (bvOfInt 128 (l + r))⟩)) :
      Except FaultKind Val) = _
  cases ((decide (l + r < 0) || decide (l + r ≥ HPow.hPow (2 : Int) 128)) ||
      (truncateBits .i32 (bvOfInt 128 (l + r)) != bvOfInt 128 (l + r))) <;>
    rfl

/-- Symbolic `evalBinOp .add` step on any `u32` `ScalarVal` and `1_u32`. -/
private theorem evalBinOp_u32_add_one (bits : BitVec 128) :
    evalBinOp .add (.scalar ⟨.i32, false, bits⟩)
      (.scalar ⟨.i32, false, truncateBits .i32 (BitVec.ofNat 128 1)⟩) =
      Except.ok (.scalar ⟨.i32, false,
        truncateBits .i32
          (bvOfInt 128
            (decodeScalar ⟨.i32, false, bits⟩ +
              decodeScalar ⟨.i32, false,
                truncateBits .i32 (BitVec.ofNat 128 1)⟩))⟩) :=
  evalArithOp_u32_add
    (decodeScalar ⟨.i32, false, bits⟩)
    (decodeScalar ⟨.i32, false, truncateBits .i32 (BitVec.ofNat 128 1)⟩)

