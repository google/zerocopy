                        rw [if_bool_false hZ] at hTInv
                        exact ⟨0, hCore.hNextTagSPos, hTInv.2 rfl, fun _ => rfl⟩
                    unfold evalStatementRef
                    rw [if_bool_false hLenS, if_bool_false hLenT]
                    dsimp only
                    rw [hDstNil]
                    dsimp only
                    rw [hGYTy, s3b_ctx_getElem_localsTgt_ne c hYNeR, hGYTy,
