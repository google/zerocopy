/-! ## Slice 2: Certified `MoveToCopyPointers` Bidirectional Soundness -/

/-! ### 1. Statement Suffix, Rewrite Lookup, & Metadata Preservation -/

private noncomputable def mtc_dropStmts :
    Nat → List StatementKind → List StatementKind
  | 0, ss => ss
  | _ + 1, [] => []
  | n + 1, _ :: ss => mtc_dropStmts n ss

private noncomputable def mtc_rewriteOneStmt (id : LocalId) (stmt : StatementKind)
    (liveAfter : Bool) : StatementKind :=
  match stmt with
  | .assign dst rv =>
    if !Nat.beq dst.localId id && !liveAfter then
      .assign dst (rewriteRvalueMoveToCopy id rv)
    else
      stmt
  | _ => stmt

private noncomputable def mtc_rewriteBlock (id : LocalId) (liveIn : List Bool)
    (bb : BasicBlock) : BasicBlock :=
  let liveOut := terminatorMayReadBeforeKill id liveIn bb.terminator
  let (stmts', _) := rewriteStmtsMoveToCopy id bb.statements liveOut
  { bb with statements := stmts' }

private theorem mtc_rewriteBlock_eq (id : LocalId) (liveIn : List Bool)
    (bb : BasicBlock) :
    mtc_rewriteBlock id liveIn bb =
      { bb with
        statements :=
          (rewriteStmtsMoveToCopy id bb.statements
            (terminatorMayReadBeforeKill id liveIn bb.terminator)).1 } :=
  rfl

private theorem mtc_dropStmts_of_getElem? {ss : List StatementKind} {idx : Nat}
    {stmt : StatementKind}
    (h : Trusted.MirSemantics.getElem? ss idx = some stmt) :
    mtc_dropStmts idx ss = stmt :: mtc_dropStmts (idx + 1) ss := by
  induction ss generalizing idx with
  | nil => cases h
  | cons s rest ih =>
    cases idx with
    | zero =>
      dsimp [Trusted.MirSemantics.getElem?] at h
      injection h with hEq
      subst hEq
      rfl
    | succ k =>
      dsimp [Trusted.MirSemantics.getElem?] at h
      dsimp [mtc_dropStmts]
      exact ih h

private theorem mtc_dropStmts_length (ss : List StatementKind) :
    mtc_dropStmts ss.length ss = [] := by
  induction ss with
  | nil => rfl
  | cons _ rest ih =>
    dsimp [List.length, mtc_dropStmts]
    exact ih

private theorem mtc_rewriteStmts_snd (id : LocalId) (ss : List StatementKind)
    (liveOut : Bool) :
    (rewriteStmtsMoveToCopy id ss liveOut).2 =
      stmtsMayReadBeforeKill id ss liveOut := by
  induction ss with
  | nil => rfl
  | cons stmt rest ih =>
    dsimp [rewriteStmtsMoveToCopy, stmtsMayReadBeforeKill]
    cases hRec : rewriteStmtsMoveToCopy id rest liveOut with
    | mk rest' liveAfter =>
      dsimp
      rw [hRec] at ih
      dsimp at ih
      rw [ih]

private theorem mtc_rewriteStmts_length (id : LocalId) (ss : List StatementKind)
    (liveOut : Bool) :
    (rewriteStmtsMoveToCopy id ss liveOut).1.length = ss.length := by
  induction ss with
  | nil => rfl
  | cons stmt rest ih =>
    dsimp [rewriteStmtsMoveToCopy]
    cases hRec : rewriteStmtsMoveToCopy id rest liveOut with
    | mk rest' liveAfter =>
      dsimp [List.length]
      rw [hRec] at ih
      dsimp at ih
      rw [ih]

private theorem mtc_rewriteStmts_getElem? (id : LocalId) (ss : List StatementKind)
    (liveOut : Bool) {idx : Nat} {stmt : StatementKind}
    (hGet : Trusted.MirSemantics.getElem? ss idx = some stmt) :
    Trusted.MirSemantics.getElem?
        (rewriteStmtsMoveToCopy id ss liveOut).1 idx =
      some (mtc_rewriteOneStmt id stmt
        (stmtsMayReadBeforeKill id (mtc_dropStmts (idx + 1) ss) liveOut)) := by
  induction ss generalizing idx with
  | nil => cases hGet
  | cons s rest ih =>
    dsimp [rewriteStmtsMoveToCopy]
    cases hRec : rewriteStmtsMoveToCopy id rest liveOut with
    | mk rest' liveAfter =>
      dsimp
      have hSnd := mtc_rewriteStmts_snd id rest liveOut
      rw [hRec] at hSnd
      dsimp at hSnd
      cases idx with
      | zero =>
        dsimp [Trusted.MirSemantics.getElem?] at hGet
        injection hGet with hEq
        subst hEq
        dsimp [Trusted.MirSemantics.getElem?, mtc_dropStmts]
        rw [← hSnd]
        rfl
      | succ k =>
        dsimp [Trusted.MirSemantics.getElem?] at hGet
        dsimp [Trusted.MirSemantics.getElem?, mtc_dropStmts]
        have hSub := ih hGet
        rw [hRec] at hSub
        dsimp at hSub
        exact hSub

private theorem mtc_rewriteStmts_getElem?_none (id : LocalId)
    (ss : List StatementKind) (liveOut : Bool) {idx : Nat}
    (hNone : Trusted.MirSemantics.getElem? ss idx = none) :
    Trusted.MirSemantics.getElem?
      (rewriteStmtsMoveToCopy id ss liveOut).1 idx = none := by
  have hGe : ss.length ≤ idx := getElem?_none_ge hNone
  rw [← mtc_rewriteStmts_length id ss liveOut] at hGe
  exact getElem?_none_of_ge hGe

private theorem mtc_stmtHasStorageMarker_rewriteOne (loc id : LocalId)
    (stmt : StatementKind) (liveAfter : Bool) :
    stmtHasStorageMarker loc (mtc_rewriteOneStmt id stmt liveAfter) =
      stmtHasStorageMarker loc stmt := by
  cases stmt with
  | assign dst rv =>
    dsimp [mtc_rewriteOneStmt]
    cases !Nat.beq dst.localId id && !liveAfter <;> rfl
  | storageLive _ | storageDead _ | nop | unsupported => rfl

private theorem mtc_stmtsHaveStorageMarker_rewrite (loc id : LocalId)
    (ss : List StatementKind) (liveOut : Bool) :
    (rewriteStmtsMoveToCopy id ss liveOut).1.any (stmtHasStorageMarker loc) =
      ss.any (stmtHasStorageMarker loc) := by
  induction ss with
  | nil => rfl
  | cons stmt rest ih =>
    dsimp [rewriteStmtsMoveToCopy]
    cases hRec : rewriteStmtsMoveToCopy id rest liveOut with
    | mk rest' liveAfter =>
      dsimp [List.any]
      rw [hRec] at ih
      dsimp at ih
      have hHd := mtc_stmtHasStorageMarker_rewriteOne loc id stmt liveAfter
      change (stmtHasStorageMarker loc
          (mtc_rewriteOneStmt id stmt liveAfter) ||
          rest'.any (stmtHasStorageMarker loc)) = _
      rw [hHd, ih]

private noncomputable def mtc_stmtStorageInBounds (bound : Nat) :
    StatementKind → Bool
  | .storageLive lid | .storageDead lid => Nat.blt lid bound
  | _ => true

private theorem mtc_stmtStorageInBounds_rewriteOne (bound : Nat) (id : LocalId)
    (stmt : StatementKind) (liveAfter : Bool) :
    mtc_stmtStorageInBounds bound (mtc_rewriteOneStmt id stmt liveAfter) =
      mtc_stmtStorageInBounds bound stmt := by
  cases stmt with
  | assign dst rv =>
    dsimp [mtc_rewriteOneStmt]
    cases !Nat.beq dst.localId id && !liveAfter <;> rfl
  | storageLive _ | storageDead _ | nop | unsupported => rfl

private theorem mtc_stmtsStorageInBounds_rewrite (bound : Nat) (id : LocalId)
    (ss : List StatementKind) (liveOut : Bool) :
    (rewriteStmtsMoveToCopy id ss liveOut).1.all
        (mtc_stmtStorageInBounds bound) =
      ss.all (mtc_stmtStorageInBounds bound) := by
  induction ss with
  | nil => rfl
  | cons stmt rest ih =>
    dsimp [rewriteStmtsMoveToCopy]
    cases hRec : rewriteStmtsMoveToCopy id rest liveOut with
    | mk rest' liveAfter =>
      dsimp [List.all]
      rw [hRec] at ih
      dsimp at ih
      have hHd := mtc_stmtStorageInBounds_rewriteOne bound id stmt liveAfter
      change (mtc_stmtStorageInBounds bound
          (mtc_rewriteOneStmt id stmt liveAfter) &&
          rest'.all (mtc_stmtStorageInBounds bound)) = _
      rw [hHd, ih]

private theorem mtc_stmtTakesDirectAddrOf_rewriteOne (loc id : LocalId)
    (stmt : StatementKind) (liveAfter : Bool) :
    stmtTakesDirectAddrOf loc (mtc_rewriteOneStmt id stmt liveAfter) =
      stmtTakesDirectAddrOf loc stmt := by
  cases stmt with
  | assign dst rv =>
    dsimp [mtc_rewriteOneStmt]
    cases hC : !Nat.beq dst.localId id && !liveAfter with
    | false => rfl
    | true =>
      dsimp
      cases rv <;> rfl
  | storageLive _ | storageDead _ | nop | unsupported => rfl

private theorem mtc_stmtsTakeDirectAddrOf_rewrite (loc id : LocalId)
    (ss : List StatementKind) (liveOut : Bool) :
    (rewriteStmtsMoveToCopy id ss liveOut).1.any (stmtTakesDirectAddrOf loc) =
      ss.any (stmtTakesDirectAddrOf loc) := by
  induction ss with
  | nil => rfl
  | cons stmt rest ih =>
    dsimp [rewriteStmtsMoveToCopy]
    cases hRec : rewriteStmtsMoveToCopy id rest liveOut with
    | mk rest' liveAfter =>
      dsimp [List.any]
      rw [hRec] at ih
      dsimp at ih
      have hHd := mtc_stmtTakesDirectAddrOf_rewriteOne loc id stmt liveAfter
      change (stmtTakesDirectAddrOf loc
          (mtc_rewriteOneStmt id stmt liveAfter) ||
          rest'.any (stmtTakesDirectAddrOf loc)) = _
      rw [hHd, ih]

private theorem mtc_applyMoveToCopyLocal_cases (id : LocalId) (body : Body) :
    applyMoveToCopyLocal id body = body ∨
    ∃ (idTy : MirTy) (liveIn : List Bool),
      0 < id ∧
      id < body.locals.length ∧
      bodyTakesAddressOf body id = false ∧
      Trusted.MirSemantics.getElem? body.locals id = some idTy ∧
      isPtrOrRefTy idTy = true ∧
      liveIn.length = body.basicBlocks.length ∧
      verifyBackwardLiveInLoop id liveIn 0 body.basicBlocks = true ∧
      applyMoveToCopyLocal id body =
        { body with
          basicBlocks := body.basicBlocks.map (mtc_rewriteBlock id liveIn) }
      := by
  unfold applyMoveToCopyLocal
  cases hG1 :
      (!Nat.blt 0 id || !Nat.blt id body.locals.length ||
        bodyTakesAddressOf body id) with
  | true =>
    exact Or.inl rfl
  | false =>
    dsimp
    let ⟨hBoundsOr, hNoAddr⟩ := bool_or_false hG1
    let ⟨hPosNot, hLtNot⟩ := bool_or_false hBoundsOr
    have hIdPos : 0 < id := nat_blt_lt (bool_not_false hPosNot)
    have hIdLt : id < body.locals.length := nat_blt_lt (bool_not_false hLtNot)
    cases hTy : Trusted.MirSemantics.getElem? body.locals id with
    | none =>
      dsimp
      exact Or.inl rfl
    | some idTy =>
      dsimp
      cases hPtrNot : !isPtrOrRefTy idTy with
      | true =>
        exact Or.inl rfl
      | false =>
        dsimp
        have hPtr : isPtrOrRefTy idTy = true := bool_not_false hPtrNot
        let initLive := body.basicBlocks.map (fun _ => false)
        let fuel := body.basicBlocks.length + 2
        let liveIn := iterateBackwardLiveIn id body fuel initLive
        cases hG2 :
            (!Nat.beq liveIn.length body.basicBlocks.length ||
              !verifyBackwardLiveInLoop id liveIn 0 body.basicBlocks) with
        | true =>
          exact Or.inl rfl
        | false =>
          let ⟨hLenNot, hVerNot⟩ := bool_or_false hG2
          have hLiveLen : liveIn.length = body.basicBlocks.length :=
            nat_beq_eq (bool_not_false hLenNot)
          have hVer :
              verifyBackwardLiveInLoop id liveIn 0 body.basicBlocks = true :=
            bool_not_false hVerNot
          exact Or.inr ⟨idTy, liveIn, hIdPos, hIdLt, hNoAddr, rfl, hPtr,
            hLiveLen, hVer, rfl⟩

private theorem mtc_local_meta (id : LocalId) (b : Body) :
    let b' := applyMoveToCopyLocal id b
    b'.argumentCount = b.argumentCount ∧
    b'.locals = b.locals ∧
    b'.isUnsafe = b.isUnsafe ∧
    b'.identity = b.identity ∧
    b'.basicBlocks.length = b.basicBlocks.length ∧
    b'.basicBlocks.isEmpty = b.basicBlocks.isEmpty ∧
    (∀ loc : LocalId,
      hasStorageAnnotation b' loc = hasStorageAnnotation b loc) ∧
    storageAnnotationsInBounds b' = storageAnnotationsInBounds b ∧
    bodyLocalsAdmittedRef b' = bodyLocalsAdmittedRef b ∧
    (∀ loc : LocalId,
      bodyTakesAddressOf b' loc = bodyTakesAddressOf b loc) := by
  dsimp
  cases mtc_applyMoveToCopyLocal_cases id b with
  | inl hEq =>
    rw [hEq]
    exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, fun _ => rfl, rfl, rfl, fun _ => rfl⟩
  | inr hRew =>
    let ⟨_, liveIn, _, _, _, _, _, _, _, hB'⟩ := hRew
    rw [hB']
    dsimp
    have hLen :
        (b.basicBlocks.map (mtc_rewriteBlock id liveIn)).length =
          b.basicBlocks.length :=
      map_length_eq (mtc_rewriteBlock id liveIn) b.basicBlocks
    have hEmp :
        (b.basicBlocks.map (mtc_rewriteBlock id liveIn)).isEmpty =
          b.basicBlocks.isEmpty :=
      list_isEmpty_eq_of_length hLen
    have hHasStor : ∀ loc : LocalId,
        hasStorageAnnotation
          { b with
            basicBlocks := b.basicBlocks.map (mtc_rewriteBlock id liveIn) }
          loc = hasStorageAnnotation b loc := by
      intro loc
      unfold hasStorageAnnotation
      dsimp
      rw [list_any_map]
      have hAnyEq : ∀ bbs : List BasicBlock,
          bbs.any (fun bb =>
            (mtc_rewriteBlock id liveIn bb).statements.any
              (stmtHasStorageMarker loc)) =
          bbs.any (fun bb =>
            bb.statements.any (stmtHasStorageMarker loc)) := by
        intro bbs
        induction bbs with
        | nil => rfl
        | cons bb rest ih =>
          dsimp [List.any]
          rw [mtc_rewriteBlock_eq]
          dsimp
          rw [mtc_stmtsHaveStorageMarker_rewrite loc id bb.statements
                (terminatorMayReadBeforeKill id liveIn bb.terminator), ih]
      exact hAnyEq b.basicBlocks
    have hStorB :
        storageAnnotationsInBounds
          { b with
            basicBlocks := b.basicBlocks.map (mtc_rewriteBlock id liveIn) } =
          storageAnnotationsInBounds b := by
      unfold storageAnnotationsInBounds
      dsimp
      rw [list_all_map]
      have hAllEq :
          ∀ bbs : List BasicBlock,
            bbs.all (fun bb =>
              (mtc_rewriteBlock id liveIn bb).statements.all
                (mtc_stmtStorageInBounds b.locals.length)) =
            bbs.all (fun bb =>
              bb.statements.all (mtc_stmtStorageInBounds b.locals.length)) := by
        intro bbs
        induction bbs with
        | nil => rfl
        | cons bb rest ih =>
          dsimp [List.all]
          rw [mtc_rewriteBlock_eq]
          dsimp
          rw [mtc_stmtsStorageInBounds_rewrite b.locals.length id bb.statements
                (terminatorMayReadBeforeKill id liveIn bb.terminator), ih]
      exact hAllEq b.basicBlocks
    have hAddr : ∀ loc : LocalId,
        bodyTakesAddressOf
          { b with
            basicBlocks := b.basicBlocks.map (mtc_rewriteBlock id liveIn) }
          loc = bodyTakesAddressOf b loc := by
      intro loc
      unfold bodyTakesAddressOf
      dsimp
      rw [list_any_map]
      have hAnyEq : ∀ bbs : List BasicBlock,
          bbs.any (fun bb =>
            (mtc_rewriteBlock id liveIn bb).statements.any
              (stmtTakesDirectAddrOf loc)) =
          bbs.any (fun bb =>
            bb.statements.any (stmtTakesDirectAddrOf loc)) := by
        intro bbs
        induction bbs with
        | nil => rfl
        | cons bb rest ih =>
          dsimp [List.any]
          rw [mtc_rewriteBlock_eq]
          dsimp
          rw [mtc_stmtsTakeDirectAddrOf_rewrite loc id bb.statements
                (terminatorMayReadBeforeKill id liveIn bb.terminator), ih]
      exact hAnyEq b.basicBlocks
    exact ⟨rfl, rfl, rfl, rfl, hLen, hEmp, hHasStor, hStorB, rfl, hAddr⟩

private theorem mtc_loop_meta (b : Body) (idx rem : Nat) :
    let b' := applyMoveToCopyLocalsLoop b idx rem
    b'.argumentCount = b.argumentCount ∧
    b'.locals = b.locals ∧
    b'.isUnsafe = b.isUnsafe ∧
    b'.identity = b.identity ∧
    b'.basicBlocks.isEmpty = b.basicBlocks.isEmpty ∧
    (∀ loc : LocalId,
      hasStorageAnnotation b' loc = hasStorageAnnotation b loc) ∧
    storageAnnotationsInBounds b' = storageAnnotationsInBounds b ∧
    bodyLocalsAdmittedRef b' = bodyLocalsAdmittedRef b := by
  induction rem generalizing b idx with
  | zero =>
    exact ⟨rfl, rfl, rfl, rfl, rfl, fun _ => rfl, rfl, rfl⟩
  | succ k ih =>
    dsimp [applyMoveToCopyLocalsLoop]
    let ⟨hA1, hL1, hU1, hI1, _, hE1, hH1, hS1, hAd1, _⟩ := mtc_local_meta idx b
    let ⟨hA2, hL2, hU2, hI2, hE2, hH2, hS2, hAd2⟩ :=
      ih (applyMoveToCopyLocal idx b) (idx + 1)
    exact ⟨hA2.trans hA1, hL2.trans hL1, hU2.trans hU1, hI2.trans hI1,
      hE2.trans hE1, fun loc => (hH2 loc).trans (hH1 loc),
      hS2.trans hS1, hAd2.trans hAd1⟩

private theorem mtc_body_meta (b : Body) :
    let b' := applyMoveToCopyBody b
    b'.argumentCount = b.argumentCount ∧
    b'.locals = b.locals ∧
    b'.isUnsafe = b.isUnsafe ∧
    b'.identity = b.identity ∧
    b'.basicBlocks.isEmpty = b.basicBlocks.isEmpty ∧
    storageAnnotationsInBounds b' = storageAnnotationsInBounds b ∧
    bodyLocalsAdmittedRef b' = bodyLocalsAdmittedRef b := by
  dsimp [applyMoveToCopyBody]
  cases hG :
      (b.basicBlocks.isEmpty || !bodyAllLocalsInBounds b ||
        !bodyAllBlocksInBounds b || !storageAnnotationsInBounds b ||
        !bodyLocalsAdmittedRef b) with
  | true =>
    exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
  | false =>
    dsimp
    let ⟨hA, hL, hU, hI, hE, _, hS, hAd⟩ :=
      mtc_loop_meta b 1 (b.locals.length - 1)
    exact ⟨hA, hL, hU, hI, hE, hS, hAd⟩

private theorem applyMoveToCopyPointers_bodies_length (p : Program) :
    (applyMoveToCopyPointers p).bodies.length = p.bodies.length :=
  map_length_eq applyMoveToCopyBody p.bodies

private theorem mtc_listRel_id_map_body (bs : List Body) :
    listRel (fun b₁ b₂ : Body => stringBeq b₁.identity b₂.identity)
      bs (bs.map applyMoveToCopyBody) = true := by
  induction bs with
  | nil => rfl
  | cons b rest ih =>
    dsimp [List.map, listRel]
    let ⟨_, _, _, hId, _, _, _⟩ := mtc_body_meta b
    rw [hId, stringBeq_refl b.identity]
    exact ih

private theorem applyMoveToCopyPointers_metadataCompat (p : Program) :
    ProgramMetadataCompat p (applyMoveToCopyPointers p) = true :=
  bool_and_intro (programHeaderEq_of_eq rfl rfl rfl rfl)
    (mtc_listRel_id_map_body p.bodies)

private theorem applyMoveToCopyPointers_unitProgForDef (p : Program) (u : DefId) :
    applyMoveToCopyPointers (unitProgForDef p u) =
      unitProgForDef (applyMoveToCopyPointers p) u := by
  cases p
  rfl

/-! ### 2. Length Preservation & Entry-Body Reduction -/

private theorem mtc_evalOperandToSlotRef_length {bodyLocals : List MirTy}
    {locals locals' : List LocalSlotRef} {epochs : List Nat}
    {nodes nodes' : List BorrowNode} {opnd : Operand} {ty : MirTy}
    {optVal : Option ValRef} {srcLoc? : Option LocalId}
    (hOk : evalOperandToSlotRef bodyLocals locals epochs nodes opnd =
      .ok (ty, optVal, srcLoc?, locals', nodes')) :
    locals'.length = locals.length := by
  cases opnd with
  | constant c =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hC : evalConstLit c.ty c.lit with
    | error _ => rw [hC] at hOk; cases hOk
    | ok _ => rw [hC] at hOk; injection hOk with hT; cases hT; rfl
  | copy pl =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hP : pl.projection with
    | nil =>
      rw [hP] at hOk; dsimp at hOk
      cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
      | none => rw [h1] at hOk; cases hOk
      | some _ =>
        rw [h1] at hOk
        cases h2 : Trusted.MirSemantics.getElem? locals pl.localId with
        | none => rw [h2] at hOk; cases hOk
        | some sl =>
          rw [h2] at hOk
          cases sl with
          | dead => cases hOk
          | live _ => injection hOk with hT; cases hT; rfl
    | cons pe rest =>
      rw [hP] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases hR : resolveDerefPlaceRef bodyLocals locals epochs nodes
              pl.localId with
          | error _ => rw [hR] at hOk; cases hOk
          | ok res =>
            rw [hR] at hOk
            cases res with
            | mk _ r1 =>
              cases r1 with
              | mk _ r2 =>
                cases r2 with
                | mk _ r3 =>
                  cases r3 with
                  | mk _ r4 =>
                    cases r4 with
                    | mk _ _ => injection hOk with hT; cases hT; rfl
  | move pl =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hP : pl.projection with
    | nil =>
      rw [hP] at hOk; dsimp at hOk
      cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
      | none => rw [h1] at hOk; cases hOk
      | some ty' =>
        rw [h1] at hOk
        cases h2 : Trusted.MirSemantics.getElem? locals pl.localId with
        | none => rw [h2] at hOk; cases hOk
        | some sl =>
          rw [h2] at hOk
          cases sl with
          | dead => cases hOk
          | live _ =>
            dsimp at hOk
            cases hS : setElem? locals pl.localId (liveUninitSlotRef ty') with
            | none => rw [hS] at hOk; cases hOk
            | some _ =>
              rw [hS] at hOk
              injection hOk with hT; cases hT
              exact setElem?_length hS
    | cons pe rest =>
      rw [hP] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
          | none => rw [h1] at hOk; cases hOk
          | some pTy =>
            rw [h1] at hOk; dsimp at hOk
            cases hPI : ptrPointeeInfo? pTy with
            | none => rw [hPI] at hOk; cases hOk
            | some info =>
              rw [hPI] at hOk
              cases info with
              | mk dS dRest =>
                cases dRest with
                | mk dM _ =>
                  dsimp at hOk
                  cases hSh : !dS && Mutability.beq dM .shared with
                  | true => rw [if_bool_true hSh] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hSh] at hOk
                    cases hR : resolveDerefPlaceRef bodyLocals locals epochs
                        nodes pl.localId with
                    | error _ => rw [hR] at hOk; cases hOk
                    | ok res =>
                      rw [hR] at hOk
                      cases res with
                      | mk sR r1 =>
                        cases r1 with
                        | mk pM r2 =>
                          cases r2 with
                          | mk ptTy r3 =>
                            cases r3 with
                            | mk ptr r4 =>
                              cases r4 with
                              | mk _ n1 =>
                                dsimp at hOk
                                cases hSh2 :
                                    sR && Mutability.beq pM .shared with
                                | true =>
                                  rw [if_bool_true hSh2] at hOk; cases hOk
                                | false =>
                                  rw [if_bool_false hSh2] at hOk
                                  cases hTb : performTbAccess ptr.targetLocal
                                      ptr.targetEpoch ptTy .write
                                      ptr.borrowTag n1 with
                                  | error _ => rw [hTb] at hOk; cases hOk
                                  | ok _ =>
                                    rw [hTb] at hOk; dsimp at hOk
                                    cases hS : setElem? locals ptr.targetLocal
                                        (liveUninitSlotRef ptTy) with
                                    | none => rw [hS] at hOk; cases hOk
                                    | some _ =>
                                      rw [hS] at hOk
                                      injection hOk with hT; cases hT
                                      exact setElem?_length hS

private theorem mtc_evalPrimOperandRef_length {bodyLocals : List MirTy}
    {locals locals' : List LocalSlotRef} {epochs : List Nat}
    {nodes nodes' : List BorrowNode} {opnd : Operand} {v : Val}
    (hOk : evalPrimitiveOperandRef bodyLocals locals epochs nodes opnd =
      .ok (v, locals', nodes')) :
    locals'.length = locals.length := by
  unfold evalPrimitiveOperandRef at hOk
  cases hO : evalOperandToSlotRef bodyLocals locals epochs nodes opnd with
  | error _ => rw [hO] at hOk; cases hOk
  | ok res =>
    rw [hO] at hOk
    cases res with
    | mk ty r1 =>
      cases r1 with
      | mk ov r2 =>
        cases r2 with
        | mk sL r3 =>
          cases r3 with
          | mk l' n' =>
            dsimp at hOk
            have hL := mtc_evalOperandToSlotRef_length hO
            cases hP : !isPrimitiveReadableTy ty with
            | true => rw [if_bool_true hP] at hOk; cases hOk
            | false =>
              rw [if_bool_false hP] at hOk
              cases ov with
              | none => cases hOk
              | some vr =>
                cases vr with
                | localPtr _ _ => cases hOk
                | base _ => injection hOk with hT; cases hT; exact hL

private theorem mtc_evalRvalueRef_length {bodyLocals : List MirTy}
    {locals locals' : List LocalSlotRef} {epochs : List Nat}
    {nodes nodes' : List BorrowNode} {nextTag nextTag' : Nat}
    {dstLoc : LocalId} {dstIsDeref : Bool} {dstTy : MirTy}
    {rv : Rvalue} {val : ValRef}
    (hOk : evalRvalueRef bodyLocals locals epochs nodes nextTag dstLoc
      dstIsDeref dstTy rv = .ok (val, locals', nodes', nextTag')) :
    locals'.length = locals.length := by
  cases rv with
  | use opnd =>
    dsimp [evalRvalueRef] at hOk
    cases hO : evalOperandToSlotRef bodyLocals locals epochs nodes opnd with
    | error _ => rw [hO] at hOk; cases hOk
    | ok res =>
      rw [hO] at hOk
      cases res with
      | mk sTy r1 =>
        cases r1 with
        | mk ov r2 =>
          cases r2 with
          | mk sL r3 =>
            cases r3 with
            | mk l' n' =>
              dsimp at hOk
              have hL := mtc_evalOperandToSlotRef_length hO
              cases hT : !MirTy.beq sTy dstTy with
              | true => rw [if_bool_true hT] at hOk; cases hOk
              | false =>
                rw [if_bool_false hT] at hOk
                cases sL with
                | none =>
                  dsimp at hOk
                  cases hOv :
                      ((dstIsDeref || operandHasDerefProj opnd) &&
                        !isZeroSizedTy dstTy && false) with
                  | true => rw [if_bool_true hOv] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hOv] at hOk
                    cases ov with
                    | none => cases hOk
                    | some _ => injection hOk with hTup; cases hTup; exact hL
                | some sLoc =>
                  dsimp at hOk
                  cases hOv :
                      ((dstIsDeref || operandHasDerefProj opnd) &&
                        !isZeroSizedTy dstTy && Nat.beq sLoc dstLoc) with
                  | true => rw [if_bool_true hOv] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hOv] at hOk
                    cases ov with
                    | none => cases hOk
                    | some _ => injection hOk with hTup; cases hTup; exact hL
  | unaryOp op opnd =>
    dsimp [evalRvalueRef] at hOk
    cases hO : evalPrimitiveOperandRef bodyLocals locals epochs nodes opnd with
    | error _ => rw [hO] at hOk; cases hOk
    | ok rO =>
      rw [hO] at hOk
      cases rO with
      | mk v' r1 =>
        cases r1 with
        | mk l' n' =>
          dsimp at hOk
          have hL := mtc_evalPrimOperandRef_length hO
          cases hU : evalUnOp op v' with
          | error _ => rw [hU] at hOk; cases hOk
          | ok _ =>
            rw [hU] at hOk; injection hOk with hTup; cases hTup; exact hL
  | binaryOp op lhs rhs =>
    dsimp [evalRvalueRef] at hOk
    cases hL0 : evalPrimitiveOperandRef bodyLocals locals epochs nodes lhs with
    | error _ => rw [hL0] at hOk; cases hOk
    | ok rL =>
      rw [hL0] at hOk
      cases rL with
      | mk lv r1 =>
        cases r1 with
        | mk l' n' =>
          dsimp at hOk
          have hLen1 := mtc_evalPrimOperandRef_length hL0
          cases hR0 : evalPrimitiveOperandRef bodyLocals l' epochs n' rhs with
          | error _ => rw [hR0] at hOk; cases hOk
          | ok rR =>
            rw [hR0] at hOk
            cases rR with
            | mk rv' r2 =>
              cases r2 with
              | mk l'' n'' =>
                dsimp at hOk
                have hLen2 := mtc_evalPrimOperandRef_length hR0
                cases hB0 : evalBinOp op lv rv' with
                | error _ => rw [hB0] at hOk; cases hOk
                | ok _ =>
                  rw [hB0] at hOk
                  injection hOk with hTup; cases hTup
                  exact hLen2.trans hLen1
  | discriminant pl =>
    dsimp [evalRvalueRef] at hOk
    cases hP : pl.projection with
    | nil =>
      rw [hP] at hOk; dsimp at hOk
      cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
      | none => rw [h1] at hOk; cases hOk
      | some pTy =>
        rw [h1] at hOk
        cases pTy with
        | enum ety =>
          cases h2 : Trusted.MirSemantics.getElem? locals pl.localId with
          | none => rw [h2] at hOk; cases hOk
          | some sl =>
            rw [h2] at hOk; dsimp at hOk
            cases hEA : !enumAdmitted ety with
            | true => rw [if_bool_true hEA] at hOk; cases hOk
            | false =>
              rw [if_bool_false hEA] at hOk
              cases sl with
              | dead => cases hOk
              | live ov =>
                dsimp at hOk
                cases hD : decodeEnumDiscriminantSlot ety ov with
                | error _ => rw [hD] at hOk; cases hOk
                | ok _ => rw [hD] at hOk; injection hOk with hT; cases hT; rfl
        | _ => cases hOk
    | cons pe rest =>
      rw [hP] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases hR : resolveDerefPlaceRef bodyLocals locals epochs nodes
              pl.localId with
          | error _ => rw [hR] at hOk; cases hOk
          | ok res =>
            rw [hR] at hOk
            cases res with
            | mk _ r1 =>
              cases r1 with
              | mk _ r2 =>
                cases r2 with
                | mk ptTy r3 =>
                  cases r3 with
                  | mk _ r4 =>
                    cases r4 with
                    | mk tgtOpt _ =>
                      cases ptTy with
                      | enum ety =>
                        dsimp at hOk
                        cases hEA : !enumAdmitted ety with
                        | true => rw [if_bool_true hEA] at hOk; cases hOk
                        | false =>
                          rw [if_bool_false hEA] at hOk
                          cases hD : decodeEnumDiscriminantSlot ety tgtOpt with
                          | error _ => rw [hD] at hOk; cases hOk
                          | ok _ =>
                            rw [hD] at hOk
                            injection hOk with hT; cases hT; rfl
                      | _ => cases hOk
  | ref m sPl =>
    dsimp [evalRvalueRef] at hOk
    cases hRO : evalRefOrAddrOf bodyLocals locals epochs nodes nextTag true m
        sPl dstTy with
    | error _ => rw [hRO] at hOk; cases hOk
    | ok res =>
      rw [hRO] at hOk
      cases res with
      | mk _ r1 =>
        cases r1 with
        | mk _ _ => injection hOk with hT; cases hT; rfl
  | addressOf m sPl =>
    dsimp [evalRvalueRef] at hOk
    cases hRO : evalRefOrAddrOf bodyLocals locals epochs nodes nextTag false m
        sPl dstTy with
    | error _ => rw [hRO] at hOk; cases hOk
    | ok res =>
      rw [hRO] at hOk
      cases res with
      | mk _ r1 =>
        cases r1 with
        | mk _ _ => injection hOk with hT; cases hT; rfl
  | aggregateTuple _ | unsupported => cases hOk

private theorem mtc_writeTargetSlotRef_length {bodyLocals : List MirTy}
    {locals locals' : List LocalSlotRef} {epochs : List Nat}
    {nodes nodes' : List BorrowNode} {dstLoc : LocalId}
    {dstDeref? : Option (Bool × Mutability × LocalPtr)}
    {dstTy : MirTy} {val : ValRef}
    (hOk : writeTargetSlotRef bodyLocals locals epochs nodes dstLoc dstDeref?
      dstTy val = .ok (locals', nodes')) :
    locals'.length = locals.length := by
  unfold writeTargetSlotRef at hOk
  cases hCV : !checkValRef val dstTy with
  | true => rw [if_bool_true hCV] at hOk; cases hOk
  | false =>
    rw [if_bool_false hCV] at hOk
    cases dstDeref? with
    | none =>
      dsimp at hOk
      cases hDL : Trusted.MirSemantics.getElem? locals dstLoc with
      | none => rw [hDL] at hOk; cases hOk
      | some sl =>
        rw [hDL] at hOk
        cases sl with
        | dead => cases hOk
        | live _ =>
          dsimp at hOk
          cases hV : validateRuntimeValRef bodyLocals locals epochs dstTy val
          with
          | error _ => rw [hV] at hOk; cases hOk
          | ok u =>
            rw [hV] at hOk; cases u; dsimp at hOk
            cases hS : setElem? locals dstLoc (.live (some val)) with
            | none => rw [hS] at hOk; cases hOk
            | some _ =>
              rw [hS] at hOk
              injection hOk with hTup; cases hTup
              exact setElem?_length hS
    | some inf =>
      cases inf with
      | mk dS r1 =>
        cases r1 with
        | mk dM ptr =>
          dsimp at hOk
          cases h1 : Trusted.MirSemantics.getElem? bodyLocals dstLoc with
          | none => rw [h1] at hOk; cases hOk
          | some tTy =>
            rw [h1] at hOk
            cases h2 : Trusted.MirSemantics.getElem? locals dstLoc with
            | none => rw [h2] at hOk; cases hOk
            | some tSl =>
              rw [h2] at hOk
              cases h3 : Trusted.MirSemantics.getElem? epochs dstLoc with
              | none => rw [h3] at hOk; cases hOk
              | some cEp =>
                rw [h3] at hOk; dsimp at hOk
                cases hT : !MirTy.beq tTy dstTy with
                | true => rw [if_bool_true hT] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hT] at hOk
                  cases hInh : dS && !isOpsemInhabitedTy dstTy with
                  | true => rw [if_bool_true hInh] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hInh] at hOk
                    cases tSl with
                    | dead => cases hOk
                    | live _ =>
                      dsimp at hOk
                      cases hEp : !Nat.beq cEp ptr.targetEpoch with
                      | true => rw [if_bool_true hEp] at hOk; cases hOk
                      | false =>
                        rw [if_bool_false hEp] at hOk
                        cases hSh : Mutability.beq dM .shared with
                        | true => rw [if_bool_true hSh] at hOk; cases hOk
                        | false =>
                          rw [if_bool_false hSh] at hOk
                          cases hTb : performTbAccess dstLoc cEp dstTy .write
                              ptr.borrowTag nodes with
                          | error _ => rw [hTb] at hOk; cases hOk
                          | ok _ =>
                            rw [hTb] at hOk; dsimp at hOk
                            cases hV : validateRuntimeValRef bodyLocals locals
                                epochs dstTy val with
                            | error _ => rw [hV] at hOk; cases hOk
                            | ok u =>
                              rw [hV] at hOk; cases u; dsimp at hOk
                              cases hS : setElem? locals dstLoc
                                  (.live (some val)) with
                              | none => rw [hS] at hOk; cases hOk
                              | some _ =>
                                rw [hS] at hOk
                                injection hOk with hTup; cases hTup
                                exact setElem?_length hS

private theorem mtc_evalStepRef_singleFrame_shape {p : Program} {f : FrameStateRef}
    {mem : CallerMemory} {s' : ExecStateRef}
    (hStep : evalStepRef p 0 { frames := [f], callerMem := mem } = .step s') :
    ∃ f', s' = { frames := [f'], callerMem := mem } ∧ f'.defId = f.defId ∧
      f'.locals.length = f.locals.length ∧
      f'.epochs.length = f.epochs.length := by
  unfold evalStepRef at hStep
  dsimp at hStep
  cases hLen : !Nat.beq f.epochs.length f.locals.length with
  | true => rw [if_bool_true hLen] at hStep; cases hStep
  | false =>
    rw [if_bool_false hLen] at hStep
    cases hB : Trusted.MirSemantics.getElem? p.bodies f.defId with
    | none => rw [hB] at hStep; cases hStep
    | some body =>
      rw [hB] at hStep; dsimp at hStep
      cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
      | none => rw [hBb] at hStep; cases hStep
      | some bb =>
        rw [hBb] at hStep; dsimp at hStep
        cases hSt : Trusted.MirSemantics.getElem? bb.statements f.stmtIdx with
        | some stmt =>
          rw [hSt] at hStep; dsimp at hStep
          unfold evalStatementRef at hStep
          rw [if_bool_false hLen] at hStep
          cases stmt with
          | nop =>
            injection hStep with hEq; subst hEq
            exact ⟨_, rfl, rfl, rfl, rfl⟩
          | unsupported => cases hStep
          | storageLive lid =>
            dsimp at hStep
            cases hBL : Trusted.MirSemantics.getElem? body.locals lid with
            | none => rw [hBL] at hStep; cases hStep
            | some lTy =>
              rw [hBL] at hStep; dsimp at hStep
              cases hS1 : setElem? f.locals lid (liveUninitSlotRef lTy) with
              | none => rw [hS1] at hStep; cases hStep
              | some _ =>
                rw [hS1] at hStep
                cases hS2 : setElem? f.epochs lid f.nextEpoch with
                | none => rw [hS2] at hStep; cases hStep
                | some _ =>
                  rw [hS2] at hStep
                  injection hStep with hEq; subst hEq
                  exact ⟨_, rfl, rfl, setElem?_length hS1, setElem?_length hS2⟩
          | storageDead lid =>
            dsimp at hStep
            cases hL0 : Nat.beq lid 0 with
            | true => rw [if_bool_true hL0] at hStep; cases hStep
            | false =>
              rw [if_bool_false hL0] at hStep
              cases hS1 : setElem? f.locals lid .dead with
              | none => rw [hS1] at hStep; cases hStep
              | some _ =>
                rw [hS1] at hStep
                injection hStep with hEq; subst hEq
                exact ⟨_, rfl, rfl, setElem?_length hS1, rfl⟩
          | assign dst rv =>
            dsimp at hStep
            cases hPr : dst.projection with
            | nil =>
              rw [hPr] at hStep; dsimp at hStep
              cases hBL : Trusted.MirSemantics.getElem? body.locals dst.localId
              with
              | none => rw [hBL] at hStep; cases hStep
              | some dstTy =>
                rw [hBL] at hStep; dsimp at hStep
                cases hRv : evalRvalueRef body.locals f.locals f.epochs
                    f.borrowNodes f.nextTag dst.localId false dstTy rv with
                | error _ => rw [hRv] at hStep; cases hStep
                | ok rvRes =>
                  rw [hRv] at hStep
                  cases rvRes with
                  | mk val r1 =>
                    cases r1 with
                    | mk l1 r2 =>
                      cases r2 with
                      | mk n1 _ =>
                        dsimp at hStep
                        cases hWr : writeTargetSlotRef body.locals l1 f.epochs
                            n1 dst.localId none dstTy val with
                        | error _ => rw [hWr] at hStep; cases hStep
                        | ok wrRes =>
                          rw [hWr] at hStep
                          cases wrRes with
                          | mk l2 _ =>
                            injection hStep with hEq; subst hEq
                            exact ⟨_, rfl, rfl,
                              (mtc_writeTargetSlotRef_length hWr).trans
                                (mtc_evalRvalueRef_length hRv), rfl⟩
            | cons pe rest =>
              rw [hPr] at hStep
              cases pe with
              | field _ _ | unsupported => cases hStep
              | deref =>
                cases rest with
                | cons _ _ => cases hStep
                | nil =>
                  dsimp at hStep
                  cases hDst : resolveDerefDstRef body.locals f.locals f.epochs
                      f.borrowNodes dst.localId with
                  | error _ => rw [hDst] at hStep; cases hStep
                  | ok dRes =>
                    rw [hDst] at hStep
                    cases dRes with
                    | mk dS d1 =>
                      cases d1 with
                      | mk dM d2 =>
                        cases d2 with
                        | mk dstTy d3 =>
                          cases d3 with
                          | mk ptr nDst =>
                            dsimp at hStep
                            cases hRv : evalRvalueRef body.locals f.locals
                                f.epochs nDst f.nextTag ptr.targetLocal true
                                dstTy rv with
                            | error _ => rw [hRv] at hStep; cases hStep
                            | ok rvRes =>
                              rw [hRv] at hStep
                              cases rvRes with
                              | mk val r1 =>
                                cases r1 with
                                | mk l1 r2 =>
                                  cases r2 with
                                  | mk n1 _ =>
                                    dsimp at hStep
                                    cases hWr : writeTargetSlotRef body.locals
                                        l1 f.epochs n1 ptr.targetLocal
                                        (some (dS, dM, ptr)) dstTy val with
                                    | error _ => rw [hWr] at hStep; cases hStep
                                    | ok wrRes =>
                                      rw [hWr] at hStep
                                      cases wrRes with
                                      | mk l2 _ =>
                                        injection hStep with hEq; subst hEq
                                        exact ⟨_, rfl, rfl,
                                          (mtc_writeTargetSlotRef_length
                                            hWr).trans
                                            (mtc_evalRvalueRef_length hRv),
                                          rfl⟩
        | none =>
          rw [hSt] at hStep; dsimp at hStep
          cases hEnd : Nat.beq f.stmtIdx bb.statements.length with
          | false => rw [if_bool_false hEnd] at hStep; cases hStep
          | true =>
            rw [if_bool_true hEnd] at hStep
            unfold evalTerminatorRef at hStep
            rw [if_bool_false hLen] at hStep
            cases hTerm : bb.terminator with
            | goto _ =>
              rw [hTerm] at hStep; dsimp [jumpToBlockRef] at hStep
              injection hStep with hEq; subst hEq
              exact ⟨_, rfl, rfl, rfl, rfl⟩
            | return_ =>
              rw [hTerm] at hStep; dsimp at hStep
              cases hCl : bb.cleanup with
              | true => rw [if_bool_true hCl] at hStep; cases hStep
              | false =>
                rw [if_bool_false hCl] at hStep
                cases hL0 : Trusted.MirSemantics.getElem? f.locals 0 with
                | none => rw [hL0] at hStep; cases hStep
                | some sl =>
                  rw [hL0] at hStep
                  cases sl with
                  | dead => cases hStep
                  | live ov =>
                    cases ov with
                    | none => cases hStep
                    | some vr => cases vr <;> cases hStep
            | unreachable | unwindResume | assert _ _ _ _ _
            | call _ _ _ _ _ | unsupported =>
              rw [hTerm] at hStep; cases hStep
            | switchInt discr targets =>
              rw [hTerm] at hStep; dsimp at hStep
              cases hD : evalPrimitiveOperandRef body.locals f.locals f.epochs
                  f.borrowNodes discr with
              | error _ => rw [hD] at hStep; cases hStep
              | ok dRes =>
                rw [hD] at hStep
                cases dRes with
                | mk dv dRest =>
                  cases dRest with
                  | mk l1 _ =>
                    dsimp at hStep
                    have hDLen := mtc_evalPrimOperandRef_length hD
                    cases dv with
                    | scalar sv =>
                      dsimp at hStep
                      cases hSw : evalSwitchBranches sv.width sv.bits
                          targets.otherwise targets.branches with
                      | error _ => rw [hSw] at hStep; cases hStep
                      | ok _ =>
                        rw [hSw] at hStep; dsimp [jumpToBlockRef] at hStep
                        injection hStep with hEq; subst hEq
                        exact ⟨_, rfl, rfl, hDLen, rfl⟩
                    | bool b =>
                      dsimp at hStep
                      cases hSw : evalBoolSwitchBranches b targets.otherwise
                          targets.branches with
                      | error _ => rw [hSw] at hStep; cases hStep
                      | ok _ =>
                        rw [hSw] at hStep; dsimp [jumpToBlockRef] at hStep
                        injection hStep with hEq; subst hEq
                        exact ⟨_, rfl, rfl, hDLen, rfl⟩
                    | _ => cases hStep

private noncomputable def mtc_QueryEquiv (pSrc pTgt : Program) : Prop :=
  ∀ q : Query,
    (WellFormedRef pTgt q ↔ WellFormedRef pSrc q) ∧
    (∀ out : TerminalOut, BehaviorRef pTgt q out ↔ BehaviorRef pSrc q out) ∧
    (∀ k : FaultKind,
      ReachesResultRef pTgt q (.fault k) ↔
        ReachesResultRef pSrc q (.fault k)) ∧
    (DivergesRef pTgt q ↔ DivergesRef pSrc q)

private theorem mtc_QueryEquiv_refl (p : Program) : mtc_QueryEquiv p p :=
  fun _ => ⟨Iff.rfl, fun _ => Iff.rfl, fun _ => Iff.rfl, Iff.rfl⟩

private theorem mtc_QueryEquiv_symm {p₁ p₂ : Program} (h : mtc_QueryEquiv p₁ p₂) :
    mtc_QueryEquiv p₂ p₁ := by
  intro q
  let ⟨hw, hb, hf, hd⟩ := h q
  exact ⟨hw.symm, fun o => (hb o).symm, fun k => (hf k).symm, hd.symm⟩

private theorem mtc_QueryEquiv_trans {p₁ p₂ p₃ : Program}
    (h12 : mtc_QueryEquiv p₁ p₂) (h23 : mtc_QueryEquiv p₂ p₃) :
    mtc_QueryEquiv p₁ p₃ := by
  intro q
  let ⟨hw12, hb12, hf12, hd12⟩ := h12 q
  let ⟨hw23, hb23, hf23, hd23⟩ := h23 q
  exact ⟨hw23.trans hw12,
    fun o => (hb23 o).trans (hb12 o),
    fun k => (hf23 k).trans (hf12 k),
    hd23.trans hd12⟩

private noncomputable def mtc_singleBodyProg (pw ver : Nat) (b : Body) : Program :=
  {
    bodies := [b]
    entryDefId := 0
    pointerWidthBits := pw
    mirProfileVersion := ver
    scope := .unit
  }

private noncomputable def mtc_retagFrame (d : DefId) (f : FrameStateRef) :
    FrameStateRef :=
  { f with defId := d }

private noncomputable def mtc_retagStepResult (d : DefId) :
    StepResult ExecStateRef TerminalOut → StepResult ExecStateRef TerminalOut
  | .step { frames := [f], callerMem := mem } =>
    .step { frames := [mtc_retagFrame d f], callerMem := mem }
  | res => res

private theorem mtc_evalStatementRef_retag (body : Body) (f : FrameStateRef)
    (mem : CallerMemory) (stmt : StatementKind) (d : DefId) :
    evalStatementRef body (mtc_retagFrame d f) mem stmt =
      mtc_retagStepResult d (evalStatementRef body f mem stmt) := by
  cases f with
  | mk defId blk idx locs eps nextEp nodes nextTag =>
    unfold evalStatementRef mtc_retagFrame
    dsimp
    cases !Nat.beq eps.length locs.length with
    | true => rfl
    | false =>
      dsimp
      cases stmt with
      | nop => rfl
      | unsupported => rfl
      | storageLive lid =>
        dsimp
        cases Trusted.MirSemantics.getElem? body.locals lid with
        | none => rfl
        | some lTy =>
          dsimp
          cases setElem? locs lid (liveUninitSlotRef lTy) with
          | none => rfl
          | some _ => cases setElem? eps lid nextEp <;> rfl
      | storageDead lid =>
        dsimp
        cases Nat.beq lid 0 with
        | true => rfl
        | false =>
          dsimp
          cases setElem? locs lid .dead <;> rfl
      | assign dst rv =>
        dsimp
        cases dst.projection with
        | nil =>
          dsimp
          cases Trusted.MirSemantics.getElem? body.locals dst.localId with
          | none => rfl
          | some dstTy =>
            dsimp
            cases evalRvalueRef body.locals locs eps nodes nextTag dst.localId
                false dstTy rv with
            | error _ => rfl
            | ok rvRes =>
              cases rvRes with
              | mk val r1 =>
                cases r1 with
                | mk l1 r2 =>
                  cases r2 with
                  | mk n1 _ =>
                    dsimp
                    cases writeTargetSlotRef body.locals l1 eps n1 dst.localId
                        none dstTy val with
                    | error _ => rfl
                    | ok wrRes => cases wrRes <;> rfl
        | cons pe rest =>
          cases pe with
          | field _ _ | unsupported => rfl
          | deref =>
            cases rest with
            | cons _ _ => rfl
            | nil =>
              dsimp
              cases resolveDerefDstRef body.locals locs eps nodes
                  dst.localId with
              | error _ => rfl
              | ok dRes =>
                cases dRes with
                | mk dS d1 =>
                  cases d1 with
                  | mk dM d2 =>
                    cases d2 with
                    | mk dstTy d3 =>
                      cases d3 with
                      | mk ptr nDst =>
                        dsimp
                        cases evalRvalueRef body.locals locs eps nDst nextTag
                            ptr.targetLocal true dstTy rv with
                        | error _ => rfl
                        | ok rvRes =>
                          cases rvRes with
                          | mk val r1 =>
                            cases r1 with
                            | mk l1 r2 =>
                              cases r2 with
                              | mk n1 _ =>
                                dsimp
                                cases writeTargetSlotRef body.locals l1 eps n1
                                    ptr.targetLocal (some (dS, dM, ptr)) dstTy
                                    val with
                                | error _ => rfl
                                | ok wrRes => cases wrRes <;> rfl

private theorem mtc_evalTerminatorRef_retag (body : Body) (bb : BasicBlock)
    (f : FrameStateRef) (mem : CallerMemory) (d : DefId) :
    evalTerminatorRef body bb (mtc_retagFrame d f) mem =
      mtc_retagStepResult d (evalTerminatorRef body bb f mem) := by
  cases f with
  | mk defId blk idx locs eps nextEp nodes nextTag =>
    unfold evalTerminatorRef mtc_retagFrame
    dsimp
    cases !Nat.beq eps.length locs.length with
    | true => rfl
    | false =>
      dsimp
      cases bb.terminator with
      | goto _ => rfl
      | return_ =>
        dsimp
        cases bb.cleanup with
        | true => rfl
        | false =>
          dsimp
          cases Trusted.MirSemantics.getElem? locs 0 with
          | none => rfl
          | some sl =>
            cases sl with
            | dead => rfl
            | live ov =>
              cases ov with
              | none => rfl
              | some vr => cases vr <;> rfl
      | unreachable | unwindResume | assert _ _ _ _ _
      | call _ _ _ _ _ | unsupported => rfl
      | switchInt discr targets =>
        dsimp
        cases evalPrimitiveOperandRef body.locals locs eps nodes discr with
        | error _ => rfl
        | ok dRes =>
          cases dRes with
          | mk dv dRest =>
            cases dRest with
            | mk l1 n1 =>
              dsimp
              cases dv with
              | scalar sv =>
                dsimp
                cases evalSwitchBranches sv.width sv.bits targets.otherwise
                    targets.branches <;> rfl
              | bool b =>
                dsimp
                cases evalBoolSwitchBranches b targets.otherwise
                    targets.branches <;> rfl
              | _ => rfl

private theorem mtc_query_equiv_of_same_entry {p₁ p₂ : Program}
    (hPw : p₁.pointerWidthBits = p₂.pointerWidthBits)
    (hVer : p₁.mirProfileVersion = p₂.mirProfileVersion)
    (hEntry : Trusted.MirSemantics.getElem? p₁.bodies p₁.entryDefId =
      Trusted.MirSemantics.getElem? p₂.bodies p₂.entryDefId) :
    mtc_QueryEquiv p₁ p₂ := by
  intro q
  let R : ExecStateRef → ExecStateRef → Prop := fun s₁ s₂ =>
    ∃ f₁ mem,
      s₁ = { frames := [f₁], callerMem := mem } ∧
      s₂ = { frames := [mtc_retagFrame p₂.entryDefId f₁], callerMem := mem } ∧
      f₁.defId = p₁.entryDefId
  apply query_equiv_of_lockstep_sim (R := R)
  · intro k hErr
    unfold initStateRef at hErr
    unfold initStateRef
    rw [← hPw, ← hVer, ← hEntry]
    cases hHdr :
        (!Nat.beq p₁.pointerWidthBits 64 || !Nat.beq p₁.mirProfileVersion 1)
    with
    | true =>
      rw [if_bool_true hHdr] at hErr
      exact hErr
    | false =>
      rw [if_bool_false hHdr] at hErr
      dsimp
      cases hMem : !q.callerMem.allocations.isEmpty with
      | true =>
        rw [if_bool_true hMem] at hErr
        exact hErr
      | false =>
        rw [if_bool_false hMem] at hErr
        dsimp
        cases hB : Trusted.MirSemantics.getElem? p₁.bodies p₁.entryDefId with
        | none =>
          rw [hB] at hErr
          exact hErr
        | some body =>
          rw [hB] at hErr
          dsimp at hErr
          dsimp
          cases hE : body.basicBlocks.isEmpty with
          | true =>
            rw [if_bool_true hE] at hErr
            exact hErr
          | false =>
            rw [if_bool_false hE] at hErr
            dsimp
            cases hA : !Nat.blt body.argumentCount body.locals.length with
            | true =>
              rw [if_bool_true hA] at hErr
              exact hErr
            | false =>
              rw [if_bool_false hA] at hErr
              dsimp
              cases hS : !storageAnnotationsInBounds body with
              | true =>
                rw [if_bool_true hS] at hErr
                exact hErr
              | false =>
                rw [if_bool_false hS] at hErr
                dsimp
                cases hAd : !bodyLocalsAdmittedRef body with
                | true =>
                  rw [if_bool_true hAd] at hErr
                  exact hErr
                | false =>
                  rw [if_bool_false hAd] at hErr
                  dsimp
                  cases hAM : !checkArgsMatch q.args
                      ((body.locals.drop 1).take body.argumentCount) with
                  | true =>
                    rw [if_bool_true hAM] at hErr
                    exact hErr
                  | false =>
                    rw [if_bool_false hAM] at hErr
                    cases hErr
  · intro s₀ hOk
    unfold initStateRef at hOk
    unfold initStateRef
    rw [← hPw, ← hVer, ← hEntry]
    cases hHdr :
        (!Nat.beq p₁.pointerWidthBits 64 || !Nat.beq p₁.mirProfileVersion 1)
    with
    | true => rw [if_bool_true hHdr] at hOk; cases hOk
    | false =>
      rw [if_bool_false hHdr] at hOk
      dsimp
      cases hMem : !q.callerMem.allocations.isEmpty with
      | true => rw [if_bool_true hMem] at hOk; cases hOk
      | false =>
        rw [if_bool_false hMem] at hOk
        dsimp
        cases hB : Trusted.MirSemantics.getElem? p₁.bodies p₁.entryDefId with
        | none => rw [hB] at hOk; cases hOk
        | some body =>
          rw [hB] at hOk
          dsimp at hOk
          dsimp
          cases hE : body.basicBlocks.isEmpty with
          | true => rw [if_bool_true hE] at hOk; cases hOk
          | false =>
            rw [if_bool_false hE] at hOk
            dsimp
            cases hA : !Nat.blt body.argumentCount body.locals.length with
            | true => rw [if_bool_true hA] at hOk; cases hOk
            | false =>
              rw [if_bool_false hA] at hOk
              dsimp
              cases hS : !storageAnnotationsInBounds body with
              | true => rw [if_bool_true hS] at hOk; cases hOk
              | false =>
                rw [if_bool_false hS] at hOk
                dsimp
                cases hAd : !bodyLocalsAdmittedRef body with
                | true => rw [if_bool_true hAd] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hAd] at hOk
                  dsimp
                  cases hAM : !checkArgsMatch q.args
                      ((body.locals.drop 1).take body.argumentCount) with
                  | true =>
                    rw [if_bool_true hAM] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hAM] at hOk
                    dsimp
                    injection hOk with hEq
                    subst hEq
                    exact ⟨_, rfl, ⟨_, q.callerMem, rfl, rfl, rfl⟩⟩
  · intro s₁ s₂ hR
    let ⟨f₁, mem, hs₁, hs₂, hDef⟩ := hR
    subst hs₁; subst hs₂
    unfold LockstepStepRel
    have hEvEq :
        evalStepRef p₂ 0
          { frames := [mtc_retagFrame p₂.entryDefId f₁], callerMem := mem } =
        mtc_retagStepResult p₂.entryDefId
          (evalStepRef p₁ 0 { frames := [f₁], callerMem := mem }) := by
      unfold evalStepRef
      dsimp [mtc_retagFrame]
      rw [hDef, ← hEntry]
      cases !Nat.beq f₁.epochs.length f₁.locals.length with
      | true => rfl
      | false =>
        dsimp
        cases Trusted.MirSemantics.getElem? p₁.bodies p₁.entryDefId with
        | none => rfl
        | some body =>
          dsimp
          cases Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
          | none => rfl
          | some bb =>
            dsimp
            cases Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
            | some stmt =>
              dsimp
              exact mtc_evalStatementRef_retag body f₁ mem stmt p₂.entryDefId
            | none =>
              dsimp
              cases Nat.beq f₁.stmtIdx bb.statements.length with
              | false => rfl
              | true =>
                dsimp
                exact mtc_evalTerminatorRef_retag body bb f₁ mem p₂.entryDefId
    cases hStep1 : evalStepRef p₁ 0 { frames := [f₁], callerMem := mem } with
    | done out =>
      rw [hEvEq, hStep1]
      rfl
    | fault fk =>
      rw [hEvEq, hStep1]
      rfl
    | step s₁' =>
      let ⟨f₁', hs₁', hDef', _, _⟩ := mtc_evalStepRef_singleFrame_shape hStep1
      subst hs₁'
      rw [hEvEq, hStep1]
      dsimp [mtc_retagStepResult]
      exact ⟨_, rfl, ⟨f₁', mem, rfl, rfl, hDef'.trans hDef⟩⟩

/-! ### 3. Operational Non-Mention & Rewritten-Rvalue Lemmas -/

private noncomputable def mtc_localsAgreeExcept (id : LocalId)
    (l₁ l₂ : List LocalSlotRef) : Prop :=
  l₁.length = l₂.length ∧
  ∀ j : LocalId, j ≠ id →
    Trusted.MirSemantics.getElem? l₁ j = Trusted.MirSemantics.getElem? l₂ j

private theorem mtc_localsAgreeExcept_refl (id : LocalId) (l : List LocalSlotRef) :
    mtc_localsAgreeExcept id l l :=
  ⟨rfl, fun _ _ => rfl⟩

private theorem mtc_localsAgreeExcept_setElem?_ne {id loc : LocalId}
    {l₁ l₂ l₁' : List LocalSlotRef} {v : LocalSlotRef}
    (hAg : mtc_localsAgreeExcept id l₁ l₂)
    (hNe : loc ≠ id)
    (hS1 : setElem? l₁ loc v = some l₁') :
    ∃ l₂', setElem? l₂ loc v = some l₂' ∧
      mtc_localsAgreeExcept id l₁' l₂' ∧
      Trusted.MirSemantics.getElem? l₂' id =
        Trusted.MirSemantics.getElem? l₂ id := by
  let ⟨hLen, hAt⟩ := hAg
  have hLt2 : loc < l₂.length := by
    rw [← hLen]
    exact setElem?_some_lt hS1
  let ⟨l₂', hS2⟩ := setElem?_some_of_lt l₂ loc v hLt2
  refine ⟨l₂', hS2, ⟨?_, ?_⟩, setElem?_getElem?_ne hS2 hNe.symm⟩
  · rw [setElem?_length hS1, setElem?_length hS2, hLen]
  · intro j hjNe
    cases hEq : Nat.beq j loc with
    | true =>
      have hjLoc := nat_beq_eq hEq
      subst hjLoc
      rw [setElem?_getElem?_same hS1, setElem?_getElem?_same hS2]
    | false =>
      have hjNeLoc := nat_ne_of_beq_false hEq
      rw [setElem?_getElem?_ne hS1 hjNeLoc, setElem?_getElem?_ne hS2 hjNeLoc]
      exact hAt j hjNe

private theorem mtc_derefPointeeSlot_congr_noTarget {id : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {expectedTy : MirTy} {ptr : LocalPtr}
    (hNoPtr : (!Nat.beq ptr.targetLocal id) = true)
    (hAg : mtc_localsAgreeExcept id l₁ l₂) :
    derefPointeeSlot bodyLocals l₂ epochs expectedTy ptr =
      derefPointeeSlot bodyLocals l₁ epochs expectedTy ptr := by
  have hNe : ptr.targetLocal ≠ id :=
    nat_ne_of_beq_false (bool_not_true hNoPtr)
  unfold derefPointeeSlot
  rw [← hAg.2 ptr.targetLocal hNe]

private theorem mtc_validateRuntimeValRef_congr_noTarget {id : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {dstTy : MirTy} {val : ValRef}
    (hVal : valNotTargeting id val = true)
    (hAg : mtc_localsAgreeExcept id l₁ l₂) :
    validateRuntimeValRef bodyLocals l₂ epochs dstTy val =
      validateRuntimeValRef bodyLocals l₁ epochs dstTy val := by
  unfold validateRuntimeValRef
  cases !checkValRef val dstTy with
  | true => rfl
  | false =>
    dsimp
    cases val with
    | base _ => rfl
    | localPtr ptr ptrTy =>
      cases ptrTy with
      | ref _ innerTy =>
        dsimp [valNotTargeting] at hVal
        dsimp
        cases !isOpsemInhabitedTy innerTy with
        | true => rfl
        | false =>
          dsimp
          rw [mtc_derefPointeeSlot_congr_noTarget hVal hAg]
      | rawPtr _ _ => rfl
      | _ => rfl

private theorem mtc_resolveDerefPlaceRef_congr_ne {id ptrId : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode}
    (hNe : ptrId ≠ id)
    (hLocs1 : l₁.all (slotNotTargeting id) = true)
    (hAg : mtc_localsAgreeExcept id l₁ l₂) :
    resolveDerefPlaceRef bodyLocals l₂ epochs nodes ptrId =
      resolveDerefPlaceRef bodyLocals l₁ epochs nodes ptrId := by
  unfold resolveDerefPlaceRef
  cases Trusted.MirSemantics.getElem? bodyLocals ptrId with
  | none => rfl
  | some ptrDeclTy =>
    dsimp
    cases ptrPointeeInfo? ptrDeclTy with
    | none => rfl
    | some info =>
      cases info with
      | mk isSR rest =>
        cases rest with
        | mk pMut ptTy =>
          dsimp
          rw [← hAg.1, ← hAg.2 ptrId hNe]
          cases !Nat.beq epochs.length l₁.length with
          | true => rfl
          | false =>
            dsimp
            cases hGet : Trusted.MirSemantics.getElem? l₁ ptrId with
            | none => rfl
            | some sl =>
              have hSl := list_all_getElem? hLocs1 hGet
              cases sl with
              | dead => rfl
              | live ov =>
                cases ov with
                | none => rfl
                | some vr =>
                  cases vr with
                  | base _ => rfl
                  | localPtr ptr vTy =>
                    dsimp [slotNotTargeting, optValNotTargeting,
                      valNotTargeting] at hSl
                    dsimp
                    cases !MirTy.beq vTy ptrDeclTy with
                    | true => rfl
                    | false =>
                      dsimp
                      cases isSR && !isOpsemInhabitedTy ptTy with
                      | true => rfl
                      | false =>
                        dsimp
                        rw [mtc_derefPointeeSlot_congr_noTarget hSl hAg]

private theorem mtc_resolveDerefDstRef_congr_ne {id ptrId : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode}
    (hNe : ptrId ≠ id)
    (hAg : mtc_localsAgreeExcept id l₁ l₂) :
    resolveDerefDstRef bodyLocals l₂ epochs nodes ptrId =
      resolveDerefDstRef bodyLocals l₁ epochs nodes ptrId := by
  unfold resolveDerefDstRef
  rw [← hAg.1, ← hAg.2 ptrId hNe]

private theorem mtc_evalOperand_congr_noMention {id : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode} {opnd : Operand}
    (hNoMent : operandMentionsLocal id opnd = false)
    (hLocs1 : l₁.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hAg : mtc_localsAgreeExcept id l₁ l₂) :
    (∀ k, evalOperandToSlotRef bodyLocals l₁ epochs nodes opnd = .error k →
      evalOperandToSlotRef bodyLocals l₂ epochs nodes opnd = .error k) ∧
    (∀ ty ov sL l₁' n',
      evalOperandToSlotRef bodyLocals l₁ epochs nodes opnd =
        .ok (ty, ov, sL, l₁', n') →
      ∃ l₂',
        evalOperandToSlotRef bodyLocals l₂ epochs nodes opnd =
          .ok (ty, ov, sL, l₂', n') ∧
        mtc_localsAgreeExcept id l₁' l₂' ∧
        Trusted.MirSemantics.getElem? l₁' id =
          Trusted.MirSemantics.getElem? l₁ id ∧
        Trusted.MirSemantics.getElem? l₂' id =
          Trusted.MirSemantics.getElem? l₂ id) := by
  cases opnd with
  | constant c =>
    dsimp [evalOperandToSlotRef]
    constructor
    · intro k hErr
      cases hC : evalConstLit c.ty c.lit with
      | error _ => rw [hC] at hErr; exact hErr
      | ok _ => rw [hC] at hErr; cases hErr
    · intro ty ov sL l₁' n' hOk
      cases hC : evalConstLit c.ty c.lit with
      | error _ => rw [hC] at hOk; cases hOk
      | ok v =>
        rw [hC] at hOk
        injection hOk with hT; cases hT
        exact ⟨l₂, rfl, hAg, rfl, rfl⟩
  | copy pl =>
    dsimp [operandMentionsLocal] at hNoMent
    have hNe : pl.localId ≠ id := nat_ne_of_beq_false hNoMent
    dsimp [evalOperandToSlotRef]
    cases hP : pl.projection with
    | nil =>
      dsimp
      rw [← hAg.2 pl.localId hNe]
      constructor
      · intro k hErr
        cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
        | none => rw [h1] at hErr; exact hErr
        | some _ =>
          rw [h1] at hErr
          cases h2 : Trusted.MirSemantics.getElem? l₁ pl.localId with
          | none => rw [h2] at hErr; exact hErr
          | some sl =>
            rw [h2] at hErr
            cases sl with
            | dead => exact hErr
            | live _ => cases hErr
      · intro ty ov sL l₁' n' hOk
        cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
        | none => rw [h1] at hOk; cases hOk
        | some _ =>
          rw [h1] at hOk
          cases h2 : Trusted.MirSemantics.getElem? l₁ pl.localId with
          | none => rw [h2] at hOk; cases hOk
          | some sl =>
            rw [h2] at hOk
            cases sl with
            | dead => cases hOk
            | live _ =>
              injection hOk with hT; cases hT
              exact ⟨l₂, rfl, hAg, rfl, rfl⟩
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported =>
        exact ⟨fun _ h => h, fun _ _ _ _ _ h => by cases h⟩
      | deref =>
        cases rest with
        | cons _ _ => exact ⟨fun _ h => h, fun _ _ _ _ _ h => by cases h⟩
        | nil =>
          dsimp
          rw [mtc_resolveDerefPlaceRef_congr_ne hNe hLocs1 hAg]
          constructor
          · intro k hErr
            cases hR : resolveDerefPlaceRef bodyLocals l₁ epochs nodes
                pl.localId with
            | error _ => rw [hR] at hErr; exact hErr
            | ok res =>
              rw [hR] at hErr
              cases res with
              | mk _ a1 =>
                cases a1 with
                | mk _ a2 =>
                  cases a2 with
                  | mk _ a3 =>
                    cases a3 with
                    | mk _ a4 =>
                      cases a4 <;> cases hErr
          · intro ty ov sL l₁' n' hOk
            cases hR : resolveDerefPlaceRef bodyLocals l₁ epochs nodes
                pl.localId with
            | error _ => rw [hR] at hOk; cases hOk
            | ok res =>
              rw [hR] at hOk
              cases res with
              | mk _ a1 =>
                cases a1 with
                | mk _ a2 =>
                  cases a2 with
                  | mk _ a3 =>
                    cases a3 with
                    | mk _ a4 =>
                      cases a4 with
                      | mk _ _ =>
                        injection hOk with hT; cases hT
                        exact ⟨l₂, rfl, hAg, rfl, rfl⟩
  | move pl =>
    dsimp [operandMentionsLocal] at hNoMent
    have hNe : pl.localId ≠ id := nat_ne_of_beq_false hNoMent
    dsimp [evalOperandToSlotRef]
    cases hP : pl.projection with
    | nil =>
      dsimp
      rw [← hAg.2 pl.localId hNe]
      constructor
      · intro k hErr
        cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
        | none => rw [h1] at hErr; exact hErr
        | some ty' =>
          rw [h1] at hErr
          cases h2 : Trusted.MirSemantics.getElem? l₁ pl.localId with
          | none => rw [h2] at hErr; exact hErr
          | some sl =>
            rw [h2] at hErr
            cases sl with
            | dead => exact hErr
            | live _ =>
              dsimp at hErr; dsimp
              cases hS1 : setElem? l₁ pl.localId (liveUninitSlotRef ty') with
              | some _ => rw [hS1] at hErr; cases hErr
              | none =>
                rw [hS1] at hErr
                have hGe1 : l₁.length ≤ pl.localId := by
                  cases Nat.lt_or_ge pl.localId l₁.length with
                  | inr hg => exact hg
                  | inl hl =>
                    let ⟨_, hs⟩ :=
                      setElem?_some_of_lt l₁ pl.localId
                        (liveUninitSlotRef ty') hl
                    rw [hS1] at hs; cases hs
                rw [hAg.1] at hGe1
                rw [setElem?_none_of_ge l₂ pl.localId (liveUninitSlotRef ty')
                      hGe1]
                exact hErr
      · intro ty ov sL l₁' n' hOk
        cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
        | none => rw [h1] at hOk; cases hOk
        | some ty' =>
          rw [h1] at hOk
          cases h2 : Trusted.MirSemantics.getElem? l₁ pl.localId with
          | none => rw [h2] at hOk; cases hOk
          | some sl =>
            rw [h2] at hOk
            cases sl with
            | dead => cases hOk
            | live _ =>
              dsimp at hOk; dsimp
              cases hS1 : setElem? l₁ pl.localId (liveUninitSlotRef ty') with
              | none => rw [hS1] at hOk; cases hOk
              | some l1Out =>
                rw [hS1] at hOk
                let ⟨l₂', hS2, hAg', hId2⟩ :=
                  mtc_localsAgreeExcept_setElem?_ne hAg hNe hS1
                rw [hS2]
                injection hOk with hT; cases hT
                exact ⟨l₂', rfl, hAg',
                  setElem?_getElem?_ne hS1 hNe.symm, hId2⟩
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported =>
        exact ⟨fun _ h => h, fun _ _ _ _ _ h => by cases h⟩
      | deref =>
        cases rest with
        | cons _ _ => exact ⟨fun _ h => h, fun _ _ _ _ _ h => by cases h⟩
        | nil =>
          dsimp
          cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
          | none => exact ⟨fun _ h => h, fun _ _ _ _ _ h => by cases h⟩
          | some pTy =>
            dsimp
            cases hPI : ptrPointeeInfo? pTy with
            | none => exact ⟨fun _ h => h, fun _ _ _ _ _ h => by cases h⟩
            | some inf =>
              cases inf with
              | mk dS dR =>
                cases dR with
                | mk dM _ =>
                  dsimp
                  cases !dS && Mutability.beq dM .shared with
                  | true =>
                    exact ⟨fun _ h => h, fun _ _ _ _ _ h => by cases h⟩
                  | false =>
                    dsimp
                    rw [mtc_resolveDerefPlaceRef_congr_ne hNe hLocs1 hAg]
                    constructor
                    · intro k hErr
                      cases hR : resolveDerefPlaceRef bodyLocals l₁ epochs
                          nodes pl.localId with
                      | error _ => rw [hR] at hErr; exact hErr
                      | ok res =>
                        rw [hR] at hErr
                        cases res with
                        | mk sR a1 =>
                          cases a1 with
                          | mk pM a2 =>
                            cases a2 with
                            | mk ptTy a3 =>
                              cases a3 with
                              | mk ptr a4 =>
                                cases a4 with
                                | mk _ n1 =>
                                  dsimp at hErr; dsimp
                                  cases hSh2 : sR && Mutability.beq pM .shared
                                  with
                                  | true =>
                                    rw [if_bool_true hSh2] at hErr; exact hErr
                                  | false =>
                                    rw [if_bool_false hSh2] at hErr; dsimp
                                    cases hTb : performTbAccess ptr.targetLocal
                                        ptr.targetEpoch ptTy .write
                                        ptr.borrowTag n1 with
                                    | error _ => rw [hTb] at hErr; exact hErr
                                    | ok _ =>
                                      rw [hTb] at hErr; dsimp at hErr; dsimp
                                      cases hS1 : setElem? l₁ ptr.targetLocal
                                          (liveUninitSlotRef ptTy) with
                                      | some _ =>
                                        rw [hS1] at hErr; cases hErr
                                      | none =>
                                        rw [hS1] at hErr
                                        have hGe1 :
                                            l₁.length ≤ ptr.targetLocal := by
                                          cases Nat.lt_or_ge ptr.targetLocal
                                              l₁.length with
                                          | inr hg => exact hg
                                          | inl hl =>
                                            let ⟨_, hs⟩ :=
                                              setElem?_some_of_lt l₁
                                                ptr.targetLocal
                                                (liveUninitSlotRef ptTy) hl
                                            rw [hS1] at hs; cases hs
                                        rw [hAg.1] at hGe1
                                        rw [setElem?_none_of_ge l₂
                                              ptr.targetLocal
                                              (liveUninitSlotRef ptTy) hGe1]
                                        exact hErr
                    · intro ty ov sL l₁' n' hOk
                      cases hR : resolveDerefPlaceRef bodyLocals l₁ epochs
                          nodes pl.localId with
                      | error _ => rw [hR] at hOk; cases hOk
                      | ok res =>
                        rw [hR] at hOk
                        cases res with
                        | mk sR a1 =>
                          cases a1 with
                          | mk pM a2 =>
                            cases a2 with
                            | mk ptTy a3 =>
                              cases a3 with
                              | mk ptr a4 =>
                                cases a4 with
                                | mk _ n1 =>
                                  let ⟨hNoTgt, _, _⟩ :=
                                    resolveDerefPlaceRef_notTargeting hLocs1
                                      hNodes hR
                                  have hTgtNe : ptr.targetLocal ≠ id :=
                                    nat_ne_of_beq_false (bool_not_true hNoTgt)
                                  dsimp at hOk; dsimp
                                  cases hSh2 : sR && Mutability.beq pM .shared
                                  with
                                  | true =>
                                    rw [if_bool_true hSh2] at hOk; cases hOk
                                  | false =>
                                    rw [if_bool_false hSh2] at hOk; dsimp
                                    cases hTb : performTbAccess ptr.targetLocal
                                        ptr.targetEpoch ptTy .write
                                        ptr.borrowTag n1 with
                                    | error _ => rw [hTb] at hOk; cases hOk
                                    | ok _ =>
                                      rw [hTb] at hOk; dsimp at hOk; dsimp
                                      cases hS1 : setElem? l₁ ptr.targetLocal
                                          (liveUninitSlotRef ptTy) with
                                      | none => rw [hS1] at hOk; cases hOk
                                      | some _ =>
                                        rw [hS1] at hOk
                                        let ⟨l₂', hS2, hAg', hId2⟩ :=
                                          mtc_localsAgreeExcept_setElem?_ne hAg
                                            hTgtNe hS1
                                        rw [hS2]
                                        injection hOk with hT; cases hT
                                        exact ⟨l₂', rfl, hAg',
                                          setElem?_getElem?_ne hS1 hTgtNe.symm,
                                          hId2⟩

private theorem mtc_evalPrimOperand_congr_noMention {id : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode} {opnd : Operand}
    (hNoMent : operandMentionsLocal id opnd = false)
    (hLocs1 : l₁.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hAg : mtc_localsAgreeExcept id l₁ l₂) :
    (∀ k, evalPrimitiveOperandRef bodyLocals l₁ epochs nodes opnd =
        .error k →
      evalPrimitiveOperandRef bodyLocals l₂ epochs nodes opnd = .error k) ∧
    (∀ v l₁' n',
      evalPrimitiveOperandRef bodyLocals l₁ epochs nodes opnd =
        .ok (v, l₁', n') →
      ∃ l₂',
        evalPrimitiveOperandRef bodyLocals l₂ epochs nodes opnd =
          .ok (v, l₂', n') ∧
        mtc_localsAgreeExcept id l₁' l₂' ∧
        Trusted.MirSemantics.getElem? l₁' id =
          Trusted.MirSemantics.getElem? l₁ id ∧
        Trusted.MirSemantics.getElem? l₂' id =
          Trusted.MirSemantics.getElem? l₂ id) := by
  let ⟨hErrOp, hOkOp⟩ :=
    mtc_evalOperand_congr_noMention (bodyLocals := bodyLocals)
      (epochs := epochs) hNoMent hLocs1 hNodes hAg
  unfold evalPrimitiveOperandRef
  constructor
  · intro k hErr
    cases hO1 : evalOperandToSlotRef bodyLocals l₁ epochs nodes opnd with
    | error k0 =>
      rw [hO1] at hErr
      rw [hErrOp k0 hO1]
      exact hErr
    | ok res =>
      rw [hO1] at hErr
      cases res with
      | mk ty r1 =>
        cases r1 with
        | mk ov r2 =>
          cases r2 with
          | mk sL r3 =>
            cases r3 with
            | mk l₁' n' =>
              let ⟨l₂', hO2, _, _, _⟩ := hOkOp ty ov sL l₁' n' hO1
              rw [hO2]
              dsimp at hErr; dsimp
              cases hP : !isPrimitiveReadableTy ty with
              | true =>
                rw [if_bool_true hP] at hErr; dsimp; exact hErr
              | false =>
                rw [if_bool_false hP] at hErr; dsimp
                cases ov with
                | none => exact hErr
                | some vr =>
                  cases vr with
                  | base _ => cases hErr
                  | localPtr _ _ => exact hErr
  · intro v l₁' n' hOk
    cases hO1 : evalOperandToSlotRef bodyLocals l₁ epochs nodes opnd with
    | error _ => rw [hO1] at hOk; cases hOk
    | ok res =>
      rw [hO1] at hOk
      cases res with
      | mk ty r1 =>
        cases r1 with
        | mk ov r2 =>
          cases r2 with
          | mk sL r3 =>
            cases r3 with
            | mk l1Out nOut =>
              let ⟨l₂', hO2, hAg', hId1, hId2⟩ :=
                hOkOp ty ov sL l1Out nOut hO1
              rw [hO2]
              dsimp at hOk; dsimp
              cases hP : !isPrimitiveReadableTy ty with
              | true => rw [if_bool_true hP] at hOk; cases hOk
              | false =>
                rw [if_bool_false hP] at hOk
                dsimp
                cases ov with
                | none => cases hOk
                | some vr =>
                  cases vr with
                  | localPtr _ _ => cases hOk
                  | base _ =>
                    injection hOk with hT; cases hT
                    exact ⟨l₂', rfl, hAg', hId1, hId2⟩

private theorem mtc_evalRefOrAddrOf_congr_ne {id : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode} {nextTag : Nat}
    {isSafeRef : Bool} {m : Mutability} {srcPlace : Place} {dstTy : MirTy}
    (hNe : srcPlace.localId ≠ id)
    (hLocs1 : l₁.all (slotNotTargeting id) = true)
    (hAg : mtc_localsAgreeExcept id l₁ l₂) :
    evalRefOrAddrOf bodyLocals l₂ epochs nodes nextTag isSafeRef m srcPlace
        dstTy =
      evalRefOrAddrOf bodyLocals l₁ epochs nodes nextTag isSafeRef m srcPlace
        dstTy := by
  unfold evalRefOrAddrOf
  change (match expectedRefOrAddrInner? isSafeRef m dstTy with
          | none => Except.error FaultKind.unsupported
          | some dstInnerTy => _) =
         (match expectedRefOrAddrInner? isSafeRef m dstTy with
          | none => Except.error FaultKind.unsupported
          | some dstInnerTy => _)
  cases expectedRefOrAddrInner? isSafeRef m dstTy with
  | none => rfl
  | some dstInnerTy =>
    dsimp
    cases srcPlace.projection with
    | nil =>
      dsimp
      rw [← hAg.2 srcPlace.localId hNe]
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          cases Trusted.MirSemantics.getElem? bodyLocals srcPlace.localId with
          | none => rfl
          | some ptrDeclTy =>
            dsimp
            cases ptrPointeeInfo? ptrDeclTy with
            | none => rfl
            | some inf =>
              cases inf with
              | mk baseIsSR r1 =>
                cases r1 with
                | mk baseMut innerTy =>
                  dsimp
                  change (if (!MirTy.beq innerTy dstInnerTy ||
                        !reborrowMutOk m baseMut) then _ else _) =
                    (if (!MirTy.beq innerTy dstInnerTy ||
                        !reborrowMutOk m baseMut) then _ else _)
                  cases (!MirTy.beq innerTy dstInnerTy ||
                      !reborrowMutOk m baseMut) with
                  | true => rfl
                  | false =>
                    dsimp
                    rw [← hAg.2 srcPlace.localId hNe]
                    cases hGetP : Trusted.MirSemantics.getElem? l₁
                        srcPlace.localId with
                    | none => rfl
                    | some sl =>
                      have hSl := list_all_getElem? hLocs1 hGetP
                      cases sl with
                      | dead => rfl
                      | live ov =>
                        cases ov with
                        | none => rfl
                        | some vr =>
                          cases vr with
                          | base _ => rfl
                          | localPtr ptr vPtrTy =>
                            dsimp [slotNotTargeting, optValNotTargeting,
                              valNotTargeting] at hSl
                            have hTgtNe : ptr.targetLocal ≠ id :=
                              nat_ne_of_beq_false (bool_not_true hSl)
                            dsimp
                            cases !MirTy.beq vPtrTy ptrDeclTy with
                            | true => rfl
                            | false =>
                              dsimp
                              rw [← hAg.2 ptr.targetLocal hTgtNe]

private theorem mtc_evalRvalue_congr_noMention {id : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode} {nextTag : Nat}
    {dstLoc : LocalId} {dstIsDeref : Bool} {dstTy : MirTy} {rv : Rvalue}
    (hNoMent : rvalueMentionsLocal id rv = false)
    (hLocs1 : l₁.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hAg : mtc_localsAgreeExcept id l₁ l₂) :
    (∀ k, evalRvalueRef bodyLocals l₁ epochs nodes nextTag dstLoc dstIsDeref
        dstTy rv = .error k →
      evalRvalueRef bodyLocals l₂ epochs nodes nextTag dstLoc dstIsDeref
        dstTy rv = .error k) ∧
    (∀ val l₁' n' nt',
      evalRvalueRef bodyLocals l₁ epochs nodes nextTag dstLoc dstIsDeref
        dstTy rv = .ok (val, l₁', n', nt') →
      ∃ l₂',
        evalRvalueRef bodyLocals l₂ epochs nodes nextTag dstLoc dstIsDeref
          dstTy rv = .ok (val, l₂', n', nt') ∧
        mtc_localsAgreeExcept id l₁' l₂' ∧
        Trusted.MirSemantics.getElem? l₁' id =
          Trusted.MirSemantics.getElem? l₁ id ∧
        Trusted.MirSemantics.getElem? l₂' id =
          Trusted.MirSemantics.getElem? l₂ id) := by
  cases rv with
  | use opnd =>
    dsimp [rvalueMentionsLocal] at hNoMent
    let ⟨hErrOp, hOkOp⟩ :=
      mtc_evalOperand_congr_noMention (bodyLocals := bodyLocals)
        (epochs := epochs) hNoMent hLocs1 hNodes hAg
    dsimp [evalRvalueRef]
    constructor
    · intro k hErr
      cases hO1 : evalOperandToSlotRef bodyLocals l₁ epochs nodes opnd with
      | error k0 => rw [hO1] at hErr; rw [hErrOp k0 hO1]; exact hErr
      | ok res =>
        rw [hO1] at hErr
        cases res with
        | mk sTy r1 =>
          cases r1 with
          | mk ov r2 =>
            cases r2 with
            | mk sL r3 =>
              cases r3 with
              | mk l1Out nOut =>
                let ⟨_, hO2, _, _, _⟩ := hOkOp sTy ov sL l1Out nOut hO1
                rw [hO2]
                dsimp at hErr; dsimp
                cases hT : !MirTy.beq sTy dstTy with
                | true =>
                  rw [if_bool_true hT] at hErr; dsimp; exact hErr
                | false =>
                  rw [if_bool_false hT] at hErr; dsimp
                  cases sL with
                  | none =>
                    dsimp at hErr; dsimp
                    cases hOv :
                        ((dstIsDeref || operandHasDerefProj opnd) &&
                          !isZeroSizedTy dstTy && false) with
                    | true =>
                      rw [if_bool_true hOv] at hErr; dsimp; exact hErr
                    | false =>
                      rw [if_bool_false hOv] at hErr; dsimp
                      cases ov with
                      | none => exact hErr
                      | some _ => cases hErr
                  | some sLoc =>
                    dsimp at hErr; dsimp
                    cases hOv :
                        ((dstIsDeref || operandHasDerefProj opnd) &&
                          !isZeroSizedTy dstTy && Nat.beq sLoc dstLoc) with
                    | true =>
                      rw [if_bool_true hOv] at hErr; dsimp; exact hErr
                    | false =>
                      rw [if_bool_false hOv] at hErr; dsimp
                      cases ov with
                      | none => exact hErr
                      | some _ => cases hErr
    · intro val l₁' n' nt' hOk
      cases hO1 : evalOperandToSlotRef bodyLocals l₁ epochs nodes opnd with
      | error _ => rw [hO1] at hOk; cases hOk
      | ok res =>
        rw [hO1] at hOk
        cases res with
        | mk sTy r1 =>
          cases r1 with
          | mk ov r2 =>
            cases r2 with
            | mk sL r3 =>
              cases r3 with
              | mk l1Out nOut =>
                let ⟨l₂', hO2, hAg', hId1, hId2⟩ :=
                  hOkOp sTy ov sL l1Out nOut hO1
                rw [hO2]
                dsimp at hOk; dsimp
                cases hT : !MirTy.beq sTy dstTy with
                | true => rw [if_bool_true hT] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hT] at hOk; dsimp
                  cases sL with
                  | none =>
                    dsimp at hOk; dsimp
                    cases hOv :
                        ((dstIsDeref || operandHasDerefProj opnd) &&
                          !isZeroSizedTy dstTy && false) with
                    | true => rw [if_bool_true hOv] at hOk; cases hOk
                    | false =>
                      rw [if_bool_false hOv] at hOk; dsimp
                      cases ov with
                      | none => cases hOk
                      | some _ =>
                        injection hOk with hTup; cases hTup
                        exact ⟨l₂', rfl, hAg', hId1, hId2⟩
                  | some sLoc =>
                    dsimp at hOk; dsimp
                    cases hOv :
                        ((dstIsDeref || operandHasDerefProj opnd) &&
                          !isZeroSizedTy dstTy && Nat.beq sLoc dstLoc) with
                    | true => rw [if_bool_true hOv] at hOk; cases hOk
                    | false =>
                      rw [if_bool_false hOv] at hOk; dsimp
                      cases ov with
                      | none => cases hOk
                      | some _ =>
                        injection hOk with hTup; cases hTup
                        exact ⟨l₂', rfl, hAg', hId1, hId2⟩
  | unaryOp op opnd =>
    dsimp [rvalueMentionsLocal] at hNoMent
    let ⟨hErrP, hOkP⟩ :=
      mtc_evalPrimOperand_congr_noMention (bodyLocals := bodyLocals)
        (epochs := epochs) hNoMent hLocs1 hNodes hAg
    dsimp [evalRvalueRef]
    constructor
    · intro k hErr
      cases hO1 : evalPrimitiveOperandRef bodyLocals l₁ epochs nodes opnd with
      | error k0 => rw [hO1] at hErr; rw [hErrP k0 hO1]; exact hErr
      | ok rO =>
        rw [hO1] at hErr
        cases rO with
        | mk v r1 =>
          cases r1 with
          | mk l1Out nOut =>
            let ⟨_, hO2, _, _, _⟩ := hOkP v l1Out nOut hO1
            rw [hO2]
            dsimp at hErr; dsimp
            cases hU : evalUnOp op v with
            | error _ => rw [hU] at hErr; exact hErr
            | ok _ => rw [hU] at hErr; cases hErr
    · intro val l₁' n' nt' hOk
      cases hO1 : evalPrimitiveOperandRef bodyLocals l₁ epochs nodes opnd with
      | error _ => rw [hO1] at hOk; cases hOk
      | ok rO =>
        rw [hO1] at hOk
        cases rO with
        | mk v r1 =>
          cases r1 with
          | mk l1Out nOut =>
            let ⟨l₂', hO2, hAg', hId1, hId2⟩ := hOkP v l1Out nOut hO1
            rw [hO2]
            dsimp at hOk; dsimp
            cases hU : evalUnOp op v with
            | error _ => rw [hU] at hOk; cases hOk
            | ok _ =>
              rw [hU] at hOk
              injection hOk with hTup; cases hTup
              exact ⟨l₂', rfl, hAg', hId1, hId2⟩
  | binaryOp op lhs rhs =>
    dsimp [rvalueMentionsLocal] at hNoMent
    let ⟨hNoL, hNoR⟩ := bool_or_false hNoMent
    let ⟨hErrL, hOkL⟩ :=
      mtc_evalPrimOperand_congr_noMention (bodyLocals := bodyLocals)
        (epochs := epochs) hNoL hLocs1 hNodes hAg
    dsimp [evalRvalueRef]
    constructor
    · intro k hErr
      cases hL1 : evalPrimitiveOperandRef bodyLocals l₁ epochs nodes lhs with
      | error k0 => rw [hL1] at hErr; rw [hErrL k0 hL1]; exact hErr
      | ok rL =>
        rw [hL1] at hErr
        cases rL with
        | mk lv a1 =>
          cases a1 with
          | mk lMid1 nMid =>
            let ⟨lMid2, hL2, hAgMid, _, _⟩ := hOkL lv lMid1 nMid hL1
            let ⟨hLocsMid1, hNodesMid⟩ :=
              evalPrimitiveOperandRef_notTargeting hLocs1 hNodes hL1
            let ⟨hErrR, hOkR⟩ :=
              mtc_evalPrimOperand_congr_noMention (bodyLocals := bodyLocals)
                (epochs := epochs) hNoR hLocsMid1 hNodesMid hAgMid
            rw [hL2]; dsimp at hErr; dsimp
            cases hR1 : evalPrimitiveOperandRef bodyLocals lMid1 epochs nMid
                rhs with
            | error k1 => rw [hR1] at hErr; rw [hErrR k1 hR1]; exact hErr
            | ok rR =>
              rw [hR1] at hErr
              cases rR with
              | mk rv' a2 =>
                cases a2 with
                | mk lEnd1 nEnd =>
                  let ⟨_, hR2, _, _, _⟩ := hOkR rv' lEnd1 nEnd hR1
                  rw [hR2]
                  dsimp at hErr; dsimp
                  cases hB : evalBinOp op lv rv' with
                  | error _ => rw [hB] at hErr; exact hErr
                  | ok _ => rw [hB] at hErr; cases hErr
    · intro val l₁' n' nt' hOk
      cases hL1 : evalPrimitiveOperandRef bodyLocals l₁ epochs nodes lhs with
      | error _ => rw [hL1] at hOk; cases hOk
      | ok rL =>
        rw [hL1] at hOk
        cases rL with
        | mk lv a1 =>
          cases a1 with
          | mk lMid1 nMid =>
            let ⟨lMid2, hL2, hAgMid, hIdMid1, hIdMid2⟩ :=
              hOkL lv lMid1 nMid hL1
            let ⟨hLocsMid1, hNodesMid⟩ :=
              evalPrimitiveOperandRef_notTargeting hLocs1 hNodes hL1
            let ⟨_, hOkR⟩ :=
              mtc_evalPrimOperand_congr_noMention (bodyLocals := bodyLocals)
                (epochs := epochs) hNoR hLocsMid1 hNodesMid hAgMid
            rw [hL2]; dsimp at hOk; dsimp
            cases hR1 : evalPrimitiveOperandRef bodyLocals lMid1 epochs nMid
                rhs with
            | error _ => rw [hR1] at hOk; cases hOk
            | ok rR =>
              rw [hR1] at hOk
              cases rR with
              | mk rv' a2 =>
                cases a2 with
                | mk lEnd1 nEnd =>
                  let ⟨l₂', hR2, hAgEnd, hIdEnd1, hIdEnd2⟩ :=
                    hOkR rv' lEnd1 nEnd hR1
                  rw [hR2]; dsimp at hOk; dsimp
                  cases hB : evalBinOp op lv rv' with
                  | error _ => rw [hB] at hOk; cases hOk
                  | ok _ =>
                    rw [hB] at hOk
                    injection hOk with hTup; cases hTup
                    exact ⟨l₂', rfl, hAgEnd, hIdEnd1.trans hIdMid1,
                      hIdEnd2.trans hIdMid2⟩
  | discriminant pl =>
    dsimp [rvalueMentionsLocal] at hNoMent
    have hNe : pl.localId ≠ id := nat_ne_of_beq_false hNoMent
    dsimp [evalRvalueRef]
    cases hP : pl.projection with
    | nil =>
      dsimp
      rw [← hAg.2 pl.localId hNe]
      constructor
      · intro k hErr
        cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
        | none => rw [h1] at hErr; exact hErr
        | some pTy =>
          rw [h1] at hErr
          cases pTy with
          | enum ety =>
            cases h2 : Trusted.MirSemantics.getElem? l₁ pl.localId with
            | none => rw [h2] at hErr; exact hErr
            | some sl =>
              rw [h2] at hErr; dsimp at hErr; dsimp
              cases hEA : !enumAdmitted ety with
              | true =>
                rw [if_bool_true hEA] at hErr; dsimp; exact hErr
              | false =>
                rw [if_bool_false hEA] at hErr
                dsimp
                cases sl with
                | dead => exact hErr
                | live ov =>
                  dsimp at hErr; dsimp
                  cases hD : decodeEnumDiscriminantSlot ety ov with
                  | error _ => rw [hD] at hErr; exact hErr
                  | ok _ => rw [hD] at hErr; cases hErr
          | _ => exact hErr
      · intro val l₁' n' nt' hOk
        cases h1 : Trusted.MirSemantics.getElem? bodyLocals pl.localId with
        | none => rw [h1] at hOk; cases hOk
        | some pTy =>
          rw [h1] at hOk
          cases pTy with
          | enum ety =>
            cases h2 : Trusted.MirSemantics.getElem? l₁ pl.localId with
            | none => rw [h2] at hOk; cases hOk
            | some sl =>
              rw [h2] at hOk; dsimp at hOk; dsimp
              cases hEA : !enumAdmitted ety with
              | true => rw [if_bool_true hEA] at hOk; cases hOk
              | false =>
                rw [if_bool_false hEA] at hOk; dsimp
                cases sl with
                | dead => cases hOk
                | live ov =>
                  dsimp at hOk; dsimp
                  cases hD : decodeEnumDiscriminantSlot ety ov with
                  | error _ => rw [hD] at hOk; cases hOk
                  | ok _ =>
                    rw [hD] at hOk
                    injection hOk with hTup; cases hTup
                    exact ⟨l₂, rfl, hAg, rfl, rfl⟩
          | _ => cases hOk
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported =>
        exact ⟨fun _ h => h, fun _ _ _ _ h => by cases h⟩
      | deref =>
        cases rest with
        | cons _ _ => exact ⟨fun _ h => h, fun _ _ _ _ h => by cases h⟩
        | nil =>
          dsimp
          rw [mtc_resolveDerefPlaceRef_congr_ne hNe hLocs1 hAg]
          constructor
          · intro k hErr
            cases hR : resolveDerefPlaceRef bodyLocals l₁ epochs nodes
                pl.localId with
            | error _ => rw [hR] at hErr; exact hErr
            | ok res =>
              rw [hR] at hErr
              cases res with
              | mk _ a1 =>
                cases a1 with
                | mk _ a2 =>
                  cases a2 with
                  | mk ptTy a3 =>
                    cases a3 with
                    | mk _ a4 =>
                      cases a4 with
                      | mk tgtOpt _ =>
                        cases ptTy with
                        | enum ety =>
                          dsimp at hErr; dsimp
                          cases hEA : !enumAdmitted ety with
                          | true =>
                            rw [if_bool_true hEA] at hErr; dsimp; exact hErr
                          | false =>
                            rw [if_bool_false hEA] at hErr
                            dsimp
                            cases hD : decodeEnumDiscriminantSlot ety tgtOpt
                            with
                            | error _ => rw [hD] at hErr; exact hErr
                            | ok _ => rw [hD] at hErr; cases hErr
                        | _ => exact hErr
          · intro val l₁' n' nt' hOk
            cases hR : resolveDerefPlaceRef bodyLocals l₁ epochs nodes
                pl.localId with
            | error _ => rw [hR] at hOk; cases hOk
            | ok res =>
              rw [hR] at hOk
              cases res with
              | mk _ a1 =>
                cases a1 with
                | mk _ a2 =>
                  cases a2 with
                  | mk ptTy a3 =>
                    cases a3 with
                    | mk _ a4 =>
                      cases a4 with
                      | mk tgtOpt _ =>
                        cases ptTy with
                        | enum ety =>
                          dsimp at hOk; dsimp
                          cases hEA : !enumAdmitted ety with
                          | true => rw [if_bool_true hEA] at hOk; cases hOk
                          | false =>
                            rw [if_bool_false hEA] at hOk; dsimp
                            cases hD : decodeEnumDiscriminantSlot ety tgtOpt
                            with
                            | error _ => rw [hD] at hOk; cases hOk
                            | ok _ =>
                              rw [hD] at hOk
                              injection hOk with hTup; cases hTup
                              exact ⟨l₂, rfl, hAg, rfl, rfl⟩
                        | _ => cases hOk
  | ref m srcPlace =>
    dsimp [rvalueMentionsLocal] at hNoMent
    have hNe : srcPlace.localId ≠ id := nat_ne_of_beq_false hNoMent
    dsimp [evalRvalueRef]
    rw [mtc_evalRefOrAddrOf_congr_ne hNe hLocs1 hAg]
    constructor
    · intro k hErr
      cases hRO : evalRefOrAddrOf bodyLocals l₁ epochs nodes nextTag true m
          srcPlace dstTy with
      | error _ => rw [hRO] at hErr; exact hErr
      | ok res =>
        rw [hRO] at hErr
        cases res with
        | mk _ r1 => cases r1 <;> cases hErr
    · intro val l₁' n' nt' hOk
      cases hRO : evalRefOrAddrOf bodyLocals l₁ epochs nodes nextTag true m
          srcPlace dstTy with
      | error _ => rw [hRO] at hOk; cases hOk
      | ok res =>
        rw [hRO] at hOk
        cases res with
        | mk _ r1 =>
          cases r1 with
          | mk _ _ =>
            injection hOk with hTup; cases hTup
            exact ⟨l₂, rfl, hAg, rfl, rfl⟩
  | addressOf m srcPlace =>
    dsimp [rvalueMentionsLocal] at hNoMent
    have hNe : srcPlace.localId ≠ id := nat_ne_of_beq_false hNoMent
    dsimp [evalRvalueRef]
    rw [mtc_evalRefOrAddrOf_congr_ne hNe hLocs1 hAg]
    constructor
    · intro k hErr
      cases hRO : evalRefOrAddrOf bodyLocals l₁ epochs nodes nextTag false m
          srcPlace dstTy with
      | error _ => rw [hRO] at hErr; exact hErr
      | ok res =>
        rw [hRO] at hErr
        cases res with
        | mk _ r1 => cases r1 <;> cases hErr
    · intro val l₁' n' nt' hOk
      cases hRO : evalRefOrAddrOf bodyLocals l₁ epochs nodes nextTag false m
          srcPlace dstTy with
      | error _ => rw [hRO] at hOk; cases hOk
      | ok res =>
        rw [hRO] at hOk
        cases res with
        | mk _ r1 =>
          cases r1 with
          | mk _ _ =>
            injection hOk with hTup; cases hTup
            exact ⟨l₂, rfl, hAg, rfl, rfl⟩
  | aggregateTuple _ | unsupported =>
    exact ⟨fun _ h => h, fun _ _ _ _ h => by cases h⟩

private theorem mtc_writeTargetSlot_congr {id dstLoc : LocalId}
    {bodyLocals : List MirTy} {l₁ l₂ : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode}
    {dstDeref? : Option (Bool × Mutability × LocalPtr)}
    {dstTy : MirTy} {val : ValRef}
    (hVal : valNotTargeting id val = true)
    (hAg : mtc_localsAgreeExcept id l₁ l₂)
    (hDstSlot :
      dstLoc = id →
        Trusted.MirSemantics.getElem? l₂ id =
          Trusted.MirSemantics.getElem? l₁ id ∨
        (∃ s₁ s₂,
          Trusted.MirSemantics.getElem? l₁ id = some (.live s₁) ∧
          Trusted.MirSemantics.getElem? l₂ id = some (.live s₂))) :
    (∀ k, writeTargetSlotRef bodyLocals l₁ epochs nodes dstLoc dstDeref?
        dstTy val = .error k →
      writeTargetSlotRef bodyLocals l₂ epochs nodes dstLoc dstDeref?
        dstTy val = .error k) ∧
    (∀ l₁' n',
      writeTargetSlotRef bodyLocals l₁ epochs nodes dstLoc dstDeref?
        dstTy val = .ok (l₁', n') →
      ∃ l₂',
        writeTargetSlotRef bodyLocals l₂ epochs nodes dstLoc dstDeref?
          dstTy val = .ok (l₂', n') ∧
        mtc_localsAgreeExcept id l₁' l₂' ∧
        (dstLoc = id →
          Trusted.MirSemantics.getElem? l₂' id =
            Trusted.MirSemantics.getElem? l₁' id) ∧
        (dstLoc ≠ id →
          Trusted.MirSemantics.getElem? l₁' id =
            Trusted.MirSemantics.getElem? l₁ id ∧
          Trusted.MirSemantics.getElem? l₂' id =
            Trusted.MirSemantics.getElem? l₂ id)) := by
  have hValCongr :=
    mtc_validateRuntimeValRef_congr_noTarget (bodyLocals := bodyLocals)
      (epochs := epochs) (dstTy := dstTy) hVal hAg
  have hSlotLiveEquiv :
      (Trusted.MirSemantics.getElem? l₂ dstLoc =
        Trusted.MirSemantics.getElem? l₁ dstLoc) ∨
      (dstLoc = id ∧ ∃ s₁ s₂,
        Trusted.MirSemantics.getElem? l₁ dstLoc = some (.live s₁) ∧
        Trusted.MirSemantics.getElem? l₂ dstLoc = some (.live s₂)) := by
    cases hEq : Nat.beq dstLoc id with
    | false =>
      exact Or.inl (hAg.2 dstLoc (nat_ne_of_beq_false hEq)).symm
    | true =>
      have hD := nat_beq_eq hEq
      subst hD
      cases hDstSlot rfl with
      | inl hSame => exact Or.inl hSame
      | inr hBoth => exact Or.inr ⟨rfl, hBoth⟩
  unfold writeTargetSlotRef
  cases !checkValRef val dstTy with
  | true =>
    exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
  | false =>
    dsimp
    cases dstDeref? with
    | none =>
      dsimp
      rw [hValCongr]
      constructor
      · intro k hErr
        cases hSlotLiveEquiv with
        | inl hSame =>
          rw [hSame]
          cases hDL : Trusted.MirSemantics.getElem? l₁ dstLoc with
          | none => rw [hDL] at hErr; exact hErr
          | some sl =>
            rw [hDL] at hErr
            cases sl with
            | dead => exact hErr
            | live _ =>
              dsimp at hErr; dsimp
              cases hV : validateRuntimeValRef bodyLocals l₁ epochs dstTy val
              with
              | error _ => rw [hV] at hErr; exact hErr
              | ok u =>
                rw [hV] at hErr; cases u; dsimp at hErr; dsimp
                cases hS1 : setElem? l₁ dstLoc (.live (some val)) with
                | some _ => rw [hS1] at hErr; cases hErr
                | none =>
                  rw [hS1] at hErr
                  have hGe1 : l₁.length ≤ dstLoc := by
                    cases Nat.lt_or_ge dstLoc l₁.length with
                    | inr hg => exact hg
                    | inl hl =>
                      let ⟨_, hs⟩ :=
                        setElem?_some_of_lt l₁ dstLoc (.live (some val)) hl
                      rw [hS1] at hs; cases hs
                  rw [hAg.1] at hGe1
                  rw [setElem?_none_of_ge l₂ dstLoc (.live (some val)) hGe1]
                  exact hErr
        | inr hBoth =>
          let ⟨_, s₁, s₂, hG1, hG2⟩ := hBoth
          rw [hG1] at hErr
          rw [hG2]
          dsimp at hErr; dsimp
          cases hV : validateRuntimeValRef bodyLocals l₁ epochs dstTy val with
          | error _ => rw [hV] at hErr; exact hErr
          | ok u =>
            rw [hV] at hErr; cases u; dsimp at hErr; dsimp
            let ⟨_, hs1⟩ :=
              setElem?_some_of_lt l₁ dstLoc (.live (some val))
                (getElem?_some_lt hG1)
            rw [hs1] at hErr; cases hErr
      · intro l₁' n' hOk
        cases hDL1 : Trusted.MirSemantics.getElem? l₁ dstLoc with
        | none => rw [hDL1] at hOk; cases hOk
        | some sl1 =>
          rw [hDL1] at hOk
          cases sl1 with
          | dead => cases hOk
          | live s1 =>
            have hDL2 : ∃ s2,
                Trusted.MirSemantics.getElem? l₂ dstLoc = some (.live s2) := by
              cases hSlotLiveEquiv with
              | inl hSame => exact ⟨s1, hSame.trans hDL1⟩
              | inr hBoth =>
                let ⟨_, _, s₂, _, hG2⟩ := hBoth
                exact ⟨s₂, hG2⟩
            let ⟨s2, hG2⟩ := hDL2
            rw [hG2]
            dsimp at hOk; dsimp
            cases hV : validateRuntimeValRef bodyLocals l₁ epochs dstTy val
            with
            | error _ => rw [hV] at hOk; cases hOk
            | ok u =>
              rw [hV] at hOk; cases u; dsimp at hOk; dsimp
              cases hS1 : setElem? l₁ dstLoc (.live (some val)) with
              | none => rw [hS1] at hOk; cases hOk
              | some _ =>
                rw [hS1] at hOk
                let ⟨l₂', hS2⟩ :=
                  setElem?_some_of_lt l₂ dstLoc (.live (some val))
                    (getElem?_some_lt hG2)
                rw [hS2]
                injection hOk with hTup; cases hTup
                refine ⟨l₂', rfl, ⟨?_, ?_⟩, ?_, ?_⟩
                · rw [setElem?_length hS1, setElem?_length hS2, hAg.1]
                · intro j hjNe
                  cases hEq : Nat.beq j dstLoc with
                  | true =>
                    have hjd := nat_beq_eq hEq; subst hjd
                    rw [setElem?_getElem?_same hS1, setElem?_getElem?_same hS2]
                  | false =>
                    have hjnd := nat_ne_of_beq_false hEq
                    rw [setElem?_getElem?_ne hS1 hjnd,
                        setElem?_getElem?_ne hS2 hjnd]
                    exact hAg.2 j hjNe
                · intro hEqId
                  subst hEqId
                  rw [setElem?_getElem?_same hS1, setElem?_getElem?_same hS2]
                · intro hNeId
                  exact ⟨setElem?_getElem?_ne hS1 (fun h => hNeId h.symm),
                    setElem?_getElem?_ne hS2 (fun h => hNeId h.symm)⟩
    | some inf =>
      cases inf with
      | mk dS r1 =>
        cases r1 with
        | mk dM ptr =>
          dsimp
          rw [hValCongr]
          cases Trusted.MirSemantics.getElem? bodyLocals dstLoc with
          | none => exact ⟨fun _ h => h, fun _ _ h => by cases h⟩
          | some tTy =>
            cases Trusted.MirSemantics.getElem? epochs dstLoc with
            | none =>
              constructor
              · intro _ hErr
                cases h1 : Trusted.MirSemantics.getElem? l₁ dstLoc <;>
                  (rw [h1] at hErr;
                   cases h2 : Trusted.MirSemantics.getElem? l₂ dstLoc <;>
                     exact hErr)
              · intro _ _ hOk
                cases h1 : Trusted.MirSemantics.getElem? l₁ dstLoc with
                | none => rw [h1] at hOk; cases hOk
                | some _ => rw [h1] at hOk; cases hOk
            | some cEp =>
              constructor
              · intro k hErr
                cases hSlotLiveEquiv with
                | inl hSame =>
                  rw [hSame]
                  cases hDL1 : Trusted.MirSemantics.getElem? l₁ dstLoc with
                  | none => rw [hDL1] at hErr; exact hErr
                  | some tSl =>
                    rw [hDL1] at hErr; dsimp at hErr; dsimp
                    cases hT : !MirTy.beq tTy dstTy with
                    | true =>
                      rw [if_bool_true hT] at hErr; dsimp; exact hErr
                    | false =>
                      rw [if_bool_false hT] at hErr; dsimp
                      cases hInh : dS && !isOpsemInhabitedTy dstTy with
                      | true =>
                        rw [if_bool_true hInh] at hErr; dsimp; exact hErr
                      | false =>
                        rw [if_bool_false hInh] at hErr; dsimp
                        cases tSl with
                        | dead => exact hErr
                        | live _ =>
                          dsimp at hErr; dsimp
                          cases hEp : !Nat.beq cEp ptr.targetEpoch with
                          | true =>
                            rw [if_bool_true hEp] at hErr; dsimp; exact hErr
                          | false =>
                            rw [if_bool_false hEp] at hErr; dsimp
                            cases hSh : Mutability.beq dM .shared with
                            | true =>
                              rw [if_bool_true hSh] at hErr; dsimp; exact hErr
                            | false =>
                              rw [if_bool_false hSh] at hErr; dsimp
                              cases hTb : performTbAccess dstLoc cEp dstTy
                                  .write ptr.borrowTag nodes with
                              | error _ => rw [hTb] at hErr; exact hErr
                              | ok _ =>
                                rw [hTb] at hErr; dsimp at hErr; dsimp
                                cases hV : validateRuntimeValRef bodyLocals l₁
                                    epochs dstTy val with
                                | error _ => rw [hV] at hErr; exact hErr
                                | ok u =>
                                  rw [hV] at hErr; cases u; dsimp at hErr; dsimp
                                  let ⟨_, hs1⟩ :=
                                    setElem?_some_of_lt l₁ dstLoc
                                      (.live (some val))
                                      (getElem?_some_lt hDL1)
                                  rw [hs1] at hErr; cases hErr
                | inr hBoth =>
                  let ⟨_, s₁, s₂, hG1, hG2⟩ := hBoth
                  rw [hG1] at hErr
                  rw [hG2]; dsimp at hErr; dsimp
                  cases hT : !MirTy.beq tTy dstTy with
                  | true =>
                    rw [if_bool_true hT] at hErr; dsimp; exact hErr
                  | false =>
                    rw [if_bool_false hT] at hErr; dsimp
                    cases hInh : dS && !isOpsemInhabitedTy dstTy with
                    | true =>
                      rw [if_bool_true hInh] at hErr; dsimp; exact hErr
                    | false =>
                      rw [if_bool_false hInh] at hErr; dsimp
                      cases hEp : !Nat.beq cEp ptr.targetEpoch with
                      | true =>
                        rw [if_bool_true hEp] at hErr; dsimp; exact hErr
                      | false =>
                        rw [if_bool_false hEp] at hErr; dsimp
                        cases hSh : Mutability.beq dM .shared with
                        | true =>
                          rw [if_bool_true hSh] at hErr; dsimp; exact hErr
                        | false =>
                          rw [if_bool_false hSh] at hErr; dsimp
                          cases hTb : performTbAccess dstLoc cEp dstTy .write
                              ptr.borrowTag nodes with
                          | error _ => rw [hTb] at hErr; exact hErr
                          | ok _ =>
                            rw [hTb] at hErr; dsimp at hErr; dsimp
                            cases hV : validateRuntimeValRef bodyLocals l₁
                                epochs dstTy val with
                            | error _ => rw [hV] at hErr; exact hErr
                            | ok u =>
                              rw [hV] at hErr; cases u; dsimp at hErr; dsimp
                              let ⟨_, hs1⟩ :=
                                setElem?_some_of_lt l₁ dstLoc
                                  (.live (some val))
                                  (getElem?_some_lt hG1)
                              rw [hs1] at hErr; cases hErr
              · intro l₁' n' hOk
                cases hDL1 : Trusted.MirSemantics.getElem? l₁ dstLoc with
                | none => rw [hDL1] at hOk; cases hOk
                | some tSl1 =>
                  rw [hDL1] at hOk; dsimp at hOk
                  cases hT : !MirTy.beq tTy dstTy with
                  | true => rw [if_bool_true hT] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hT] at hOk
                    cases hInh : dS && !isOpsemInhabitedTy dstTy with
                    | true => rw [if_bool_true hInh] at hOk; cases hOk
                    | false =>
                      rw [if_bool_false hInh] at hOk
                      cases tSl1 with
                      | dead => cases hOk
                      | live s1 =>
                        have hDL2 : ∃ s2,
                            Trusted.MirSemantics.getElem? l₂ dstLoc =
                              some (.live s2) := by
                          cases hSlotLiveEquiv with
                          | inl hSame => exact ⟨s1, hSame.trans hDL1⟩
                          | inr hBoth =>
                            let ⟨_, _, s₂, _, hG2⟩ := hBoth
                            exact ⟨s₂, hG2⟩
                        let ⟨s2, hG2⟩ := hDL2
                        rw [hG2]; dsimp at hOk; dsimp
                        rw [if_bool_false hT]
                        cases hEp : !Nat.beq cEp ptr.targetEpoch with
                        | true => rw [if_bool_true hEp] at hOk; cases hOk
                        | false =>
                          rw [if_bool_false hEp] at hOk; dsimp
                          cases hSh : Mutability.beq dM .shared with
                          | true => rw [if_bool_true hSh] at hOk; cases hOk
                          | false =>
                            rw [if_bool_false hSh] at hOk; dsimp
                            cases hTb : performTbAccess dstLoc cEp dstTy .write
                                ptr.borrowTag nodes with
                            | error _ => rw [hTb] at hOk; cases hOk
                            | ok _ =>
                              rw [hTb] at hOk; dsimp at hOk; dsimp
                              cases hV : validateRuntimeValRef bodyLocals l₁
                                  epochs dstTy val with
                              | error _ => rw [hV] at hOk; cases hOk
                              | ok u =>
                                rw [hV] at hOk; cases u; dsimp at hOk; dsimp
                                cases hS1 : setElem? l₁ dstLoc
                                    (.live (some val)) with
                                | none => rw [hS1] at hOk; cases hOk
                                | some _ =>
                                  rw [hS1] at hOk
                                  let ⟨l₂', hS2⟩ :=
                                    setElem?_some_of_lt l₂ dstLoc
                                      (.live (some val))
                                      (getElem?_some_lt hG2)
                                  rw [hS2]
                                  injection hOk with hTup; cases hTup
                                  refine ⟨l₂', rfl, ⟨?_, ?_⟩, ?_, ?_⟩
                                  · rw [setElem?_length hS1,
                                        setElem?_length hS2, hAg.1]
                                  · intro j hjNe
                                    cases hEq : Nat.beq j dstLoc with
                                    | true =>
                                      have hjd := nat_beq_eq hEq; subst hjd
                                      rw [setElem?_getElem?_same hS1,
                                          setElem?_getElem?_same hS2]
                                    | false =>
                                      have hjnd := nat_ne_of_beq_false hEq
                                      rw [setElem?_getElem?_ne hS1 hjnd,
                                          setElem?_getElem?_ne hS2 hjnd]
                                      exact hAg.2 j hjNe
                                  · intro hEqId
                                    subst hEqId
                                    rw [setElem?_getElem?_same hS1,
                                        setElem?_getElem?_same hS2]
                                  · intro hNeId
                                    exact ⟨setElem?_getElem?_ne hS1
                                      (fun h => hNeId h.symm),
                                      setElem?_getElem?_ne hS2
                                        (fun h => hNeId h.symm)⟩

/-! ### 4. Rewritten-Operand/Rvalue Congruence & Backward Liveness Invariants -/

private theorem mtc_locals_eq_of_agree_and_same {id : LocalId}
    {l₁ l₂ : List LocalSlotRef}
    (hAg : mtc_localsAgreeExcept id l₁ l₂)
    (hId : Trusted.MirSemantics.getElem? l₂ id =
      Trusted.MirSemantics.getElem? l₁ id) :
    l₁ = l₂ := by
  apply list_eq_of_getElem?_eq hAg.1
  intro i
  cases hEq : Nat.beq i id with
  | true =>
    have hi := nat_beq_eq hEq
    subst hi
    exact hId.symm
  | false =>
    exact hAg.2 i (nat_ne_of_beq_false hEq)

private theorem mtc_liveUninitSlotRef_is_live (ty : MirTy) :
    ∃ s, liveUninitSlotRef ty = .live s := by
  cases ty with
  | unit => exact ⟨_, rfl⟩
  | enum ety =>
    dsimp [liveUninitSlotRef]
    cases isZstEnumTy ety <;> exact ⟨_, rfl⟩
  | _ => exact ⟨_, rfl⟩

private theorem mtc_moveToCopyOperand_noMention {id : LocalId} {opnd : Operand}
    (hNo : operandMentionsLocal id opnd = false) :
    moveToCopyOperandIfLocal id opnd = opnd := by
  cases opnd with
  | copy _ => rfl
  | constant _ => rfl
  | move p =>
    dsimp [operandMentionsLocal] at hNo
    dsimp [moveToCopyOperandIfLocal]
    rw [hNo]
    cases p.projection.isEmpty <;> rfl

private theorem mtc_rewriteRvalue_noMention {id : LocalId} {rv : Rvalue}
    (hNo : rvalueMentionsLocal id rv = false) :
    rewriteRvalueMoveToCopy id rv = rv := by
  cases rv with
  | use o =>
    dsimp [rvalueMentionsLocal] at hNo
    dsimp [rewriteRvalueMoveToCopy]
    rw [mtc_moveToCopyOperand_noMention hNo]
  | unaryOp op o =>
    dsimp [rvalueMentionsLocal] at hNo
    dsimp [rewriteRvalueMoveToCopy]
    rw [mtc_moveToCopyOperand_noMention hNo]
  | binaryOp op lhs rhs =>
    dsimp [rvalueMentionsLocal] at hNo
    let ⟨hNoL, hNoR⟩ := bool_or_false hNo
    dsimp [rewriteRvalueMoveToCopy]
    rw [hNoR]
    dsimp
    rw [mtc_moveToCopyOperand_noMention hNoL,
        mtc_moveToCopyOperand_noMention hNoR]
  | discriminant _ | ref _ _ | addressOf _ _ | aggregateTuple _
  | unsupported => rfl

private theorem mtc_operandHasDerefProj_moveToCopy (id : LocalId)
    (opnd : Operand) :
    operandHasDerefProj (moveToCopyOperandIfLocal id opnd) =
      operandHasDerefProj opnd := by
  cases opnd with
  | copy _ => rfl
  | constant _ => rfl
  | move p =>
    dsimp [moveToCopyOperandIfLocal]
    cases h : (p.projection.isEmpty && Nat.beq p.localId id) with
    | true => rfl
    | false => rfl

private theorem mtc_evalOperand_moveToCopy_same {id : LocalId}
    {bodyLocals : List MirTy} {l : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode} (opnd : Operand)
    (hNodes : nodesNotTargeting id nodes = true) :
    (∀ k, evalOperandToSlotRef bodyLocals l epochs nodes opnd = .error k →
      evalOperandToSlotRef bodyLocals l epochs nodes
        (moveToCopyOperandIfLocal id opnd) = .error k) ∧
    (∀ ty ov sL l₁' n',
      evalOperandToSlotRef bodyLocals l epochs nodes opnd =
        .ok (ty, ov, sL, l₁', n') →
      ∃ l₂',
        evalOperandToSlotRef bodyLocals l epochs nodes
          (moveToCopyOperandIfLocal id opnd) = .ok (ty, ov, sL, l₂', n') ∧
        mtc_localsAgreeExcept id l₁' l₂' ∧
        (Trusted.MirSemantics.getElem? l₂' id =
            Trusted.MirSemantics.getElem? l₁' id ∨
          ∃ s₁ s₂,
            Trusted.MirSemantics.getElem? l₁' id = some (.live s₁) ∧
            Trusted.MirSemantics.getElem? l₂' id = some (.live s₂))) := by
  cases opnd with
  | copy _ =>
    exact ⟨fun _ h => h, fun _ _ _ l₁' _ h =>
      ⟨l₁', h, mtc_localsAgreeExcept_refl id l₁', Or.inl rfl⟩⟩
  | constant _ =>
    exact ⟨fun _ h => h, fun _ _ _ l₁' _ h =>
      ⟨l₁', h, mtc_localsAgreeExcept_refl id l₁', Or.inl rfl⟩⟩
  | move p =>
    dsimp [moveToCopyOperandIfLocal]
    cases hC : (p.projection.isEmpty && Nat.beq p.localId id) with
    | false =>
      dsimp
      exact ⟨fun _ h => h, fun _ _ _ l₁' _ h =>
        ⟨l₁', h, mtc_localsAgreeExcept_refl id l₁', Or.inl rfl⟩⟩
    | true =>
      dsimp
      let ⟨hEmp, hIdEqB⟩ := bool_and_true hC
      have hIdEq : p.localId = id := nat_beq_eq hIdEqB
      cases p with
      | mk loc proj =>
        dsimp at hEmp hIdEq
        subst hIdEq
        cases proj with
        | cons _ _ => cases hEmp
        | nil =>
          dsimp [evalOperandToSlotRef]
          constructor
          · intro k hErr
            cases hBL : Trusted.MirSemantics.getElem? bodyLocals loc with
            | none => rw [hBL] at hErr; exact hErr
            | some ty =>
              rw [hBL] at hErr
              cases hL : Trusted.MirSemantics.getElem? l loc with
              | none => rw [hL] at hErr; exact hErr
              | some sl =>
                rw [hL] at hErr
                cases sl with
                | dead => exact hErr
                | live optVal =>
                  dsimp at hErr
                  let ⟨_, hSet⟩ :=
                    setElem?_some_of_lt l loc (liveUninitSlotRef ty)
                      (getElem?_some_lt hL)
                  rw [hSet] at hErr
                  cases hErr
          · intro ty ov sL l₁' n' hOk
            cases hBL : Trusted.MirSemantics.getElem? bodyLocals loc with
            | none => rw [hBL] at hOk; cases hOk
            | some lTy =>
              rw [hBL] at hOk
              cases hL : Trusted.MirSemantics.getElem? l loc with
              | none => rw [hL] at hOk; cases hOk
              | some sl =>
                rw [hL] at hOk
                cases sl with
                | dead => cases hOk
                | live optVal =>
                  dsimp at hOk; dsimp
                  cases hSet : setElem? l loc (liveUninitSlotRef lTy) with
                  | none => rw [hSet] at hOk; cases hOk
                  | some lSet =>
                    rw [hSet] at hOk
                    dsimp at hOk
                    have hNoopR :
                        performTbRootAccess epochs loc lTy .read nodes =
                          nodes :=
                      performTbRootAccess_noop_of_noTarget hNodes
                    rw [hNoopR] at hOk
                    rw [hNoopR]
                    have hNoopW :
                        performTbRootAccess epochs loc lTy .write nodes =
                          nodes :=
                      performTbRootAccess_noop_of_noTarget hNodes
                    rw [hNoopW] at hOk
                    injection hOk with hTup; cases hTup
                    let ⟨s₁, hLU⟩ := mtc_liveUninitSlotRef_is_live ty
                    refine ⟨l, rfl, ⟨setElem?_length hSet, ?_⟩, Or.inr ⟨s₁,
                      ov, ?_, hL⟩⟩
                    · intro j hjNe
                      exact setElem?_getElem?_ne hSet hjNe
                    · rw [setElem?_getElem?_same hSet, hLU]

private theorem mtc_evalPrimOperand_moveToCopy_same {id : LocalId}
    {bodyLocals : List MirTy} {l : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode} (opnd : Operand)
    (hNodes : nodesNotTargeting id nodes = true) :
    (∀ k, evalPrimitiveOperandRef bodyLocals l epochs nodes opnd = .error k →
      evalPrimitiveOperandRef bodyLocals l epochs nodes
        (moveToCopyOperandIfLocal id opnd) = .error k) ∧
    (∀ v l₁' n',
      evalPrimitiveOperandRef bodyLocals l epochs nodes opnd =
        .ok (v, l₁', n') →
      ∃ l₂',
        evalPrimitiveOperandRef bodyLocals l epochs nodes
          (moveToCopyOperandIfLocal id opnd) = .ok (v, l₂', n') ∧
        mtc_localsAgreeExcept id l₁' l₂' ∧
        (Trusted.MirSemantics.getElem? l₂' id =
            Trusted.MirSemantics.getElem? l₁' id ∨
          ∃ s₁ s₂,
            Trusted.MirSemantics.getElem? l₁' id = some (.live s₁) ∧
            Trusted.MirSemantics.getElem? l₂' id = some (.live s₂))) := by
  let ⟨hErrOp, hOkOp⟩ :=
    mtc_evalOperand_moveToCopy_same (bodyLocals := bodyLocals)
      (l := l) (epochs := epochs) opnd hNodes
  unfold evalPrimitiveOperandRef
  constructor
  · intro k hErr
    cases hO1 : evalOperandToSlotRef bodyLocals l epochs nodes opnd with
    | error k0 => rw [hO1] at hErr; rw [hErrOp k0 hO1]; exact hErr
    | ok res =>
      rw [hO1] at hErr
      cases res with
      | mk ty r1 =>
        cases r1 with
        | mk ov r2 =>
          cases r2 with
          | mk sL r3 =>
            cases r3 with
            | mk l₁' n' =>
              let ⟨_, hO2, _, _⟩ := hOkOp ty ov sL l₁' n' hO1
              rw [hO2]
              dsimp at hErr; dsimp
              cases hP : !isPrimitiveReadableTy ty with
              | true =>
                rw [if_bool_true hP] at hErr; dsimp; exact hErr
              | false =>
                rw [if_bool_false hP] at hErr; dsimp
                cases ov with
                | none => exact hErr
                | some vr =>
                  cases vr with
                  | base _ => cases hErr
                  | localPtr _ _ => exact hErr
  · intro v l₁' n' hOk
    cases hO1 : evalOperandToSlotRef bodyLocals l epochs nodes opnd with
    | error _ => rw [hO1] at hOk; cases hOk
    | ok res =>
      rw [hO1] at hOk
      cases res with
      | mk ty r1 =>
        cases r1 with
        | mk ov r2 =>
          cases r2 with
          | mk sL r3 =>
            cases r3 with
            | mk l1Out nOut =>
              let ⟨l₂', hO2, hAg', hSlot'⟩ := hOkOp ty ov sL l1Out nOut hO1
              rw [hO2]
              dsimp at hOk; dsimp
              cases hP : !isPrimitiveReadableTy ty with
              | true => rw [if_bool_true hP] at hOk; cases hOk
              | false =>
                rw [if_bool_false hP] at hOk; dsimp
                cases ov with
                | none => cases hOk
                | some vr =>
                  cases vr with
                  | localPtr _ _ => cases hOk
                  | base _ =>
                    injection hOk with hT; cases hT
                    exact ⟨l₂', rfl, hAg', hSlot'⟩

private theorem mtc_evalRvalue_moveToCopy_same {id : LocalId}
    {bodyLocals : List MirTy} {l : List LocalSlotRef}
    {epochs : List Nat} {nodes : List BorrowNode} {nextTag : Nat}
    {dstLoc : LocalId} {dstIsDeref : Bool} {dstTy : MirTy} (rv : Rvalue)
    (hLocs : l.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true) :
    (∀ k, evalRvalueRef bodyLocals l epochs nodes nextTag dstLoc dstIsDeref
        dstTy rv = .error k →
      evalRvalueRef bodyLocals l epochs nodes nextTag dstLoc dstIsDeref
        dstTy (rewriteRvalueMoveToCopy id rv) = .error k) ∧
    (∀ val l₁' n' nt',
      evalRvalueRef bodyLocals l epochs nodes nextTag dstLoc dstIsDeref
        dstTy rv = .ok (val, l₁', n', nt') →
      ∃ l₂',
        evalRvalueRef bodyLocals l epochs nodes nextTag dstLoc dstIsDeref
          dstTy (rewriteRvalueMoveToCopy id rv) = .ok (val, l₂', n', nt') ∧
        mtc_localsAgreeExcept id l₁' l₂' ∧
        (Trusted.MirSemantics.getElem? l₂' id =
            Trusted.MirSemantics.getElem? l₁' id ∨
          ∃ s₁ s₂,
            Trusted.MirSemantics.getElem? l₁' id = some (.live s₁) ∧
            Trusted.MirSemantics.getElem? l₂' id = some (.live s₂))) := by
  cases rv with
  | use opnd =>
    dsimp [rewriteRvalueMoveToCopy, evalRvalueRef]
    rw [mtc_operandHasDerefProj_moveToCopy id opnd]
    let ⟨hErrOp, hOkOp⟩ :=
      mtc_evalOperand_moveToCopy_same (bodyLocals := bodyLocals)
        (l := l) (epochs := epochs) opnd hNodes
    constructor
    · intro k hErr
      cases hO1 : evalOperandToSlotRef bodyLocals l epochs nodes opnd with
      | error k0 => rw [hO1] at hErr; rw [hErrOp k0 hO1]; exact hErr
      | ok res =>
        rw [hO1] at hErr
        cases res with
        | mk sTy r1 =>
          cases r1 with
          | mk ov r2 =>
            cases r2 with
            | mk sL r3 =>
              cases r3 with
              | mk l1Out nOut =>
                let ⟨_, hO2, _, _⟩ := hOkOp sTy ov sL l1Out nOut hO1
                rw [hO2]
                dsimp at hErr; dsimp
                cases hT : !MirTy.beq sTy dstTy with
                | true =>
                  rw [if_bool_true hT] at hErr; dsimp; exact hErr
                | false =>
                  rw [if_bool_false hT] at hErr; dsimp
                  cases sL with
                  | none =>
                    dsimp at hErr; dsimp
                    cases hOv :
                        ((dstIsDeref || operandHasDerefProj opnd) &&
                          !isZeroSizedTy dstTy && false) with
                    | true =>
                      rw [if_bool_true hOv] at hErr; dsimp; exact hErr
                    | false =>
                      rw [if_bool_false hOv] at hErr; dsimp
                      cases ov with
                      | none => exact hErr
                      | some _ => cases hErr
                  | some sLoc =>
                    dsimp at hErr; dsimp
                    cases hOv :
                        ((dstIsDeref || operandHasDerefProj opnd) &&
                          !isZeroSizedTy dstTy && Nat.beq sLoc dstLoc) with
                    | true =>
                      rw [if_bool_true hOv] at hErr; dsimp; exact hErr
                    | false =>
                      rw [if_bool_false hOv] at hErr; dsimp
                      cases ov with
                      | none => exact hErr
                      | some _ => cases hErr
    · intro val l₁' n' nt' hOk
      cases hO1 : evalOperandToSlotRef bodyLocals l epochs nodes opnd with
      | error _ => rw [hO1] at hOk; cases hOk
      | ok res =>
        rw [hO1] at hOk
        cases res with
        | mk sTy r1 =>
          cases r1 with
          | mk ov r2 =>
            cases r2 with
            | mk sL r3 =>
              cases r3 with
              | mk l1Out nOut =>
                let ⟨l₂', hO2, hAg', hSlot'⟩ := hOkOp sTy ov sL l1Out nOut hO1
                rw [hO2]
                dsimp at hOk; dsimp
                cases hT : !MirTy.beq sTy dstTy with
                | true => rw [if_bool_true hT] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hT] at hOk; dsimp
                  cases sL with
                  | none =>
                    dsimp at hOk; dsimp
                    cases hOv :
                        ((dstIsDeref || operandHasDerefProj opnd) &&
                          !isZeroSizedTy dstTy && false) with
                    | true => rw [if_bool_true hOv] at hOk; cases hOk
                    | false =>
                      rw [if_bool_false hOv] at hOk; dsimp
                      cases ov with
                      | none => cases hOk
                      | some _ =>
                        injection hOk with hTup; cases hTup
                        exact ⟨l₂', rfl, hAg', hSlot'⟩
                  | some sLoc =>
                    dsimp at hOk; dsimp
                    cases hOv :
                        ((dstIsDeref || operandHasDerefProj opnd) &&
                          !isZeroSizedTy dstTy && Nat.beq sLoc dstLoc) with
                    | true => rw [if_bool_true hOv] at hOk; cases hOk
                    | false =>
                      rw [if_bool_false hOv] at hOk; dsimp
                      cases ov with
                      | none => cases hOk
                      | some _ =>
                        injection hOk with hTup; cases hTup
                        exact ⟨l₂', rfl, hAg', hSlot'⟩
  | unaryOp op opnd =>
    dsimp [rewriteRvalueMoveToCopy, evalRvalueRef]
    let ⟨hErrP, hOkP⟩ :=
      mtc_evalPrimOperand_moveToCopy_same (bodyLocals := bodyLocals)
        (l := l) (epochs := epochs) opnd hNodes
    constructor
    · intro k hErr
      cases hO1 : evalPrimitiveOperandRef bodyLocals l epochs nodes opnd with
      | error k0 => rw [hO1] at hErr; rw [hErrP k0 hO1]; exact hErr
      | ok rO =>
        rw [hO1] at hErr
        cases rO with
        | mk v r1 =>
          cases r1 with
          | mk l1Out nOut =>
            let ⟨_, hO2, _, _⟩ := hOkP v l1Out nOut hO1
            rw [hO2]
            dsimp at hErr; dsimp
            cases hU : evalUnOp op v with
            | error _ => rw [hU] at hErr; exact hErr
            | ok _ => rw [hU] at hErr; cases hErr
    · intro val l₁' n' nt' hOk
      cases hO1 : evalPrimitiveOperandRef bodyLocals l epochs nodes opnd with
      | error _ => rw [hO1] at hOk; cases hOk
      | ok rO =>
        rw [hO1] at hOk
        cases rO with
        | mk v r1 =>
          cases r1 with
          | mk l1Out nOut =>
            let ⟨l₂', hO2, hAg', hSlot'⟩ := hOkP v l1Out nOut hO1
            rw [hO2]
            dsimp at hOk; dsimp
            cases hU : evalUnOp op v with
            | error _ => rw [hU] at hOk; cases hOk
            | ok _ =>
              rw [hU] at hOk
              injection hOk with hTup; cases hTup
              exact ⟨l₂', rfl, hAg', hSlot'⟩
  | binaryOp op lhs rhs =>
    dsimp [rewriteRvalueMoveToCopy]
    cases hRNo : !operandMentionsLocal id rhs with
    | true =>
      have hNoR : operandMentionsLocal id rhs = false := bool_not_true hRNo
      dsimp
      rw [mtc_moveToCopyOperand_noMention hNoR]
      dsimp [evalRvalueRef]
      let ⟨hErrL, hOkL⟩ :=
        mtc_evalPrimOperand_moveToCopy_same (bodyLocals := bodyLocals)
          (l := l) (epochs := epochs) lhs hNodes
      constructor
      · intro k hErr
        cases hL1 : evalPrimitiveOperandRef bodyLocals l epochs nodes lhs with
        | error k0 => rw [hL1] at hErr; rw [hErrL k0 hL1]; exact hErr
        | ok rL =>
          rw [hL1] at hErr
          cases rL with
          | mk lv a1 =>
            cases a1 with
            | mk lMid1 nMid =>
              let ⟨lMid2, hL2, hAgMid, _⟩ := hOkL lv lMid1 nMid hL1
              let ⟨hLocsMid1, hNodesMid⟩ :=
                evalPrimitiveOperandRef_notTargeting hLocs hNodes hL1
              let ⟨hErrR, hOkR⟩ :=
                mtc_evalPrimOperand_congr_noMention (bodyLocals := bodyLocals)
                  (epochs := epochs) hNoR hLocsMid1 hNodesMid hAgMid
              rw [hL2]; dsimp at hErr; dsimp
              cases hR1 : evalPrimitiveOperandRef bodyLocals lMid1 epochs nMid
                  rhs with
              | error k1 => rw [hR1] at hErr; rw [hErrR k1 hR1]; exact hErr
              | ok rR =>
                rw [hR1] at hErr
                cases rR with
                | mk rv' a2 =>
                  cases a2 with
                  | mk lEnd1 nEnd =>
                    let ⟨_, hR2, _, _, _⟩ := hOkR rv' lEnd1 nEnd hR1
                    rw [hR2]; dsimp at hErr; dsimp
                    cases hB : evalBinOp op lv rv' with
                    | error _ => rw [hB] at hErr; exact hErr
                    | ok _ => rw [hB] at hErr; cases hErr
      · intro val l₁' n' nt' hOk
        cases hL1 : evalPrimitiveOperandRef bodyLocals l epochs nodes lhs with
        | error _ => rw [hL1] at hOk; cases hOk
        | ok rL =>
          rw [hL1] at hOk
          cases rL with
          | mk lv a1 =>
            cases a1 with
            | mk lMid1 nMid =>
              let ⟨lMid2, hL2, hAgMid, hSlotMid⟩ := hOkL lv lMid1 nMid hL1
              let ⟨hLocsMid1, hNodesMid⟩ :=
                evalPrimitiveOperandRef_notTargeting hLocs hNodes hL1
              let ⟨_, hOkR⟩ :=
                mtc_evalPrimOperand_congr_noMention (bodyLocals := bodyLocals)
                  (epochs := epochs) hNoR hLocsMid1 hNodesMid hAgMid
              rw [hL2]; dsimp at hOk; dsimp
              cases hR1 : evalPrimitiveOperandRef bodyLocals lMid1 epochs nMid
                  rhs with
              | error _ => rw [hR1] at hOk; cases hOk
              | ok rR =>
                rw [hR1] at hOk
                cases rR with
                | mk rv' a2 =>
                  cases a2 with
                  | mk lEnd1 nEnd =>
                    let ⟨l₂', hR2, hAgEnd, hIdEnd1, hIdEnd2⟩ :=
                      hOkR rv' lEnd1 nEnd hR1
                    rw [hR2]; dsimp at hOk; dsimp
                    cases hB : evalBinOp op lv rv' with
                    | error _ => rw [hB] at hOk; cases hOk
                    | ok _ =>
                      rw [hB] at hOk
                      injection hOk with hTup; cases hTup
                      refine ⟨l₂', rfl, hAgEnd, ?_⟩
                      rw [hIdEnd1, hIdEnd2]
                      exact hSlotMid
    | false =>
      dsimp [evalRvalueRef]
      constructor
      · intro k hErr
        cases hL1 : evalPrimitiveOperandRef bodyLocals l epochs nodes lhs with
        | error _ => rw [hL1] at hErr; exact hErr
        | ok rL =>
          rw [hL1] at hErr
          cases rL with
          | mk lv a1 =>
            cases a1 with
            | mk lMid nMid =>
              dsimp at hErr; dsimp
              let ⟨_, hNodesMid⟩ :=
                evalPrimitiveOperandRef_notTargeting hLocs hNodes hL1
              let ⟨hErrR, hOkR⟩ :=
                mtc_evalPrimOperand_moveToCopy_same (bodyLocals := bodyLocals)
                  (l := lMid) (epochs := epochs) rhs hNodesMid
              cases hR1 : evalPrimitiveOperandRef bodyLocals lMid epochs nMid
                  rhs with
              | error k1 => rw [hR1] at hErr; rw [hErrR k1 hR1]; exact hErr
              | ok rR =>
                rw [hR1] at hErr
                cases rR with
                | mk rv' a2 =>
                  cases a2 with
                  | mk lEnd1 nEnd =>
                    let ⟨_, hR2, _, _⟩ := hOkR rv' lEnd1 nEnd hR1
                    rw [hR2]; dsimp at hErr; dsimp
                    cases hB : evalBinOp op lv rv' with
                    | error _ => rw [hB] at hErr; exact hErr
                    | ok _ => rw [hB] at hErr; cases hErr
      · intro val l₁' n' nt' hOk
        cases hL1 : evalPrimitiveOperandRef bodyLocals l epochs nodes lhs with
        | error _ => rw [hL1] at hOk; cases hOk
        | ok rL =>
          rw [hL1] at hOk
          cases rL with
          | mk lv a1 =>
            cases a1 with
            | mk lMid nMid =>
              dsimp at hOk; dsimp
              let ⟨_, hNodesMid⟩ :=
                evalPrimitiveOperandRef_notTargeting hLocs hNodes hL1
              let ⟨_, hOkR⟩ :=
                mtc_evalPrimOperand_moveToCopy_same (bodyLocals := bodyLocals)
                  (l := lMid) (epochs := epochs) rhs hNodesMid
              cases hR1 : evalPrimitiveOperandRef bodyLocals lMid epochs nMid
                  rhs with
              | error _ => rw [hR1] at hOk; cases hOk
              | ok rR =>
                rw [hR1] at hOk
                cases rR with
                | mk rv' a2 =>
                  cases a2 with
                  | mk lEnd1 nEnd =>
                    let ⟨l₂', hR2, hAgEnd, hSlotEnd⟩ :=
                      hOkR rv' lEnd1 nEnd hR1
                    rw [hR2]; dsimp at hOk; dsimp
                    cases hB : evalBinOp op lv rv' with
                    | error _ => rw [hB] at hOk; cases hOk
                    | ok _ =>
                      rw [hB] at hOk
                      injection hOk with hTup; cases hTup
                      exact ⟨l₂', rfl, hAgEnd, hSlotEnd⟩
  | discriminant _ | ref _ _ | addressOf _ _ | aggregateTuple _
  | unsupported =>
    dsimp [rewriteRvalueMoveToCopy]
    exact ⟨fun _ h => h, fun _ l₁' _ _ h =>
      ⟨l₁', h, mtc_localsAgreeExcept_refl id l₁', Or.inl rfl⟩⟩

private noncomputable def mtc_liveAt (id : LocalId) (body : Body)
    (liveIn : List Bool) (bbIdx stmtIdx : Nat) : Bool :=
  match Trusted.MirSemantics.getElem? body.basicBlocks bbIdx with
  | none => false
  | some bb =>
    let liveOut := terminatorMayReadBeforeKill id liveIn bb.terminator
    stmtsMayReadBeforeKill id (mtc_dropStmts stmtIdx bb.statements) liveOut

private theorem mtc_zero_add (n : Nat) : 0 + n = n := by
  induction n with
  | zero => rfl
  | succ k ih => exact congrArg Nat.succ ih

private theorem mtc_add_succ_left (a b : Nat) : (a + 1) + b = a + (b + 1) := by
  induction b with
  | zero => rfl
  | succ k ih => exact congrArg Nat.succ ih

private theorem mtc_verifyBackwardLiveIn_getElem? {id : LocalId}
    {liveIn : List Bool} {base idx : Nat} {bbs : List BasicBlock}
    {bb : BasicBlock}
    (hVer : verifyBackwardLiveInLoop id liveIn base bbs = true)
    (hGet : Trusted.MirSemantics.getElem? bbs idx = some bb)
    (hReq : stmtsMayReadBeforeKill id bb.statements
      (terminatorMayReadBeforeKill id liveIn bb.terminator) = true) :
    getBoolDefault false liveIn (base + idx) = true := by
  induction bbs generalizing base idx with
  | nil => cases hGet
  | cons bb0 rest ih =>
    dsimp [verifyBackwardLiveInLoop] at hVer
    let ⟨hHere, hRest⟩ := bool_and_true hVer
    cases idx with
    | zero =>
      dsimp [Trusted.MirSemantics.getElem?] at hGet
      injection hGet with hEq
      subst hEq
      rw [hReq] at hHere
      exact hHere
    | succ k =>
      dsimp [Trusted.MirSemantics.getElem?] at hGet
      have hSub := ih hRest hGet
      rw [mtc_add_succ_left base k] at hSub
      exact hSub

private theorem mtc_liveAt_entry_implies_liveIn {id : LocalId} {body : Body}
    {liveIn : List Bool} {target : BasicBlockId}
    (hVer : verifyBackwardLiveInLoop id liveIn 0 body.basicBlocks = true)
    (hLive0 : mtc_liveAt id body liveIn target 0 = true) :
    getBoolDefault false liveIn target = true := by
  unfold mtc_liveAt at hLive0
  cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks target with
  | none => rw [hBb] at hLive0; cases hLive0
  | some bb =>
    rw [hBb] at hLive0
    dsimp [mtc_dropStmts] at hLive0
    have hSub := mtc_verifyBackwardLiveIn_getElem? hVer hBb hLive0
    rw [mtc_zero_add target] at hSub
    exact hSub

private theorem mtc_evalSwitchBranches_mem (w : IntWidth)
    (discrBits : BitVec 128) (otherwise : BasicBlockId)
    (branches : List (BitVec 128 × BasicBlockId)) {target : BasicBlockId}
    (hOk : evalSwitchBranches w discrBits otherwise branches = .ok target)
    (liveIn : List Bool)
    (hTgt : getBoolDefault false liveIn target = true) :
    (getBoolDefault false liveIn otherwise ||
      branches.any (fun br => getBoolDefault false liveIn br.2)) = true := by
  induction branches with
  | nil =>
    change Except.ok otherwise = Except.ok target at hOk
    injection hOk with hEq
    subst hEq
    exact bool_or_intro_left _ hTgt
  | cons br rest ih =>
    cases br with
    | mk caseBits brTgt =>
      change
        (if (truncateBits w caseBits != caseBits) = true then
          Except.error FaultKind.unsupported
        else if (truncateBits w discrBits == truncateBits w caseBits) = true
        then
          Except.ok brTgt
        else
          evalSwitchBranches w discrBits otherwise rest) =
        Except.ok target at hOk
      cases hC1 : (truncateBits w caseBits != caseBits) with
      | true => rw [if_bool_true hC1] at hOk; cases hOk
      | false =>
        rw [if_bool_false hC1] at hOk
        cases hC2 : (truncateBits w discrBits == truncateBits w caseBits) with
        | true =>
          rw [if_bool_true hC2] at hOk
          injection hOk with hEq
          subst hEq
          dsimp [List.any]
          rw [hTgt]
          exact bool_or_intro_right _ (bool_or_intro_left _ rfl)
        | false =>
          rw [if_bool_false hC2] at hOk
          dsimp [List.any]
          cases bool_or_true (ih hOk) with
          | inl hO => exact bool_or_intro_left _ hO
          | inr hR => exact bool_or_intro_right _ (bool_or_intro_right _ hR)

private theorem mtc_evalBoolSwitchBranches_mem (b : Bool)
    (otherwise : BasicBlockId)
    (branches : List (BitVec 128 × BasicBlockId)) {target : BasicBlockId}
    (hOk : evalBoolSwitchBranches b otherwise branches = .ok target)
    (liveIn : List Bool)
    (hTgt : getBoolDefault false liveIn target = true) :
    (getBoolDefault false liveIn otherwise ||
      branches.any (fun br => getBoolDefault false liveIn br.2)) = true := by
  induction branches with
  | nil =>
    change Except.ok otherwise = Except.ok target at hOk
    injection hOk with hEq
    subst hEq
    exact bool_or_intro_left _ hTgt
  | cons br rest ih =>
    cases br with
    | mk caseBits brTgt =>
      change
        (match evalConstLit .bool (.scalar caseBits) with
        | .ok (.bool false) =>
          if !b then .ok brTgt else evalBoolSwitchBranches b otherwise rest
        | .ok (.bool true) =>
          if b then .ok brTgt else evalBoolSwitchBranches b otherwise rest
        | .error k => .error k
        | .ok _ => .error .unsupported) = Except.ok target at hOk
      cases hCL : evalConstLit .bool (.scalar caseBits) with
      | error _ => rw [hCL] at hOk; cases hOk
      | ok cv =>
        rw [hCL] at hOk
        cases cv with
        | bool bv =>
          cases bv with
          | false =>
            dsimp at hOk
            cases hNB : !b with
            | true =>
              rw [if_bool_true hNB] at hOk
              injection hOk with hEq
              subst hEq
              dsimp [List.any]
              rw [hTgt]
              exact bool_or_intro_right _ (bool_or_intro_left _ rfl)
            | false =>
              rw [if_bool_false hNB] at hOk
              dsimp [List.any]
              cases bool_or_true (ih hOk) with
              | inl hO => exact bool_or_intro_left _ hO
              | inr hR =>
                exact bool_or_intro_right _ (bool_or_intro_right _ hR)
          | true =>
            dsimp at hOk
            cases hB : b with
            | true =>
              rw [if_bool_true hB] at hOk
              injection hOk with hEq
              subst hEq
              dsimp [List.any]
              rw [hTgt]
              exact bool_or_intro_right _ (bool_or_intro_left _ rfl)
            | false =>
              rw [if_bool_false hB] at hOk
              dsimp [List.any]
              cases bool_or_true (ih hOk) with
              | inl hO => exact bool_or_intro_left _ hO
              | inr hR =>
                exact bool_or_intro_right _ (bool_or_intro_right _ hR)
        | _ => cases hOk

/-! ### 5. Frame Simulation & `MoveToCopyPointers` Bidirectional Soundness -/

private noncomputable def mtc_SlotRel (id : LocalId)
    (l₁ l₂ : List LocalSlotRef) : Prop :=
  Trusted.MirSemantics.getElem? l₂ id = Trusted.MirSemantics.getElem? l₁ id ∨
  ∃ s₁ s₂,
    Trusted.MirSemantics.getElem? l₁ id = some (.live s₁) ∧
    Trusted.MirSemantics.getElem? l₂ id = some (.live s₂)

private noncomputable def mtc_FrameRel (id : LocalId) (body : Body)
    (liveIn : List Bool) (f₁ f₂ : FrameStateRef) : Prop :=
  f₁.defId = 0 ∧
  f₂.defId = 0 ∧
  f₂.blockIdx = f₁.blockIdx ∧
  f₂.stmtIdx = f₁.stmtIdx ∧
  f₂.epochs = f₁.epochs ∧
  f₂.nextEpoch = f₁.nextEpoch ∧
  f₂.borrowNodes = f₁.borrowNodes ∧
  f₂.nextTag = f₁.nextTag ∧
  frameNotTargeting id f₁ = true ∧
  mtc_localsAgreeExcept id f₁.locals f₂.locals ∧
  mtc_SlotRel id f₁.locals f₂.locals ∧
  (mtc_liveAt id body liveIn f₁.blockIdx f₁.stmtIdx = true →
    Trusted.MirSemantics.getElem? f₂.locals id =
      Trusted.MirSemantics.getElem? f₁.locals id)

private theorem mtc_frame_eq_of_locals_eq {id : LocalId} {body : Body}
    {liveIn : List Bool} {f₁ f₂ : FrameStateRef}
    (hRel : mtc_FrameRel id body liveIn f₁ f₂)
    (hLocsEq : f₁.locals = f₂.locals) :
    f₂ = f₁ := by
  let ⟨hd1, hd2, hblk, hst, hep, hnep, hbn, hnt, _, _, _, _⟩ := hRel
  cases f₁ with
  | mk d1 b1 s1 l1 e1 ne1 n1 nt1 =>
    cases f₂ with
    | mk d2 b2 s2 l2 e2 ne2 n2 nt2 =>
      dsimp at hd1 hd2 hblk hst hep hnep hbn hnt hLocsEq
      subst hd1; subst hd2; subst hblk; subst hst
      subst hep; subst hnep; subst hbn; subst hnt; subst hLocsEq
      rfl

private theorem mtc_frameRel_of_same_frame {id : LocalId} (body : Body)
    (liveIn : List Bool) (f : FrameStateRef)
    (hDef : f.defId = 0)
    (hInv : frameNotTargeting id f = true) :
    mtc_FrameRel id body liveIn f f :=
  ⟨hDef, hDef, rfl, rfl, rfl, rfl, rfl, rfl, hInv,
    mtc_localsAgreeExcept_refl id f.locals, Or.inl rfl, fun _ => rfl⟩

private theorem mtc_setElem?_none_iff_of_len {α : Type} {l₁ l₂ : List α}
    (hLen : l₁.length = l₂.length) (idx : Nat) (v : α)
    (hNone : setElem? l₁ idx v = none) :
    setElem? l₂ idx v = none := by
  cases Nat.lt_or_ge idx l₁.length with
  | inl hLt =>
    let ⟨_, hSome⟩ := setElem?_some_of_lt l₁ idx v hLt
    rw [hNone] at hSome; cases hSome
  | inr hGe =>
    rw [hLen] at hGe
    exact setElem?_none_of_ge l₂ idx v hGe

private theorem mtc_setElem?_same_id {id : LocalId}
    {l₁ l₂ l₁' : List LocalSlotRef} {v : LocalSlotRef}
    (hAg : mtc_localsAgreeExcept id l₁ l₂)
    (hS1 : setElem? l₁ id v = some l₁') :
    ∃ l₂', setElem? l₂ id v = some l₂' ∧
      mtc_localsAgreeExcept id l₁' l₂' ∧
      Trusted.MirSemantics.getElem? l₂' id =
        Trusted.MirSemantics.getElem? l₁' id := by
  have hLt2 : id < l₂.length := by
    rw [← hAg.1]
    exact setElem?_some_lt hS1
  let ⟨l₂', hS2⟩ := setElem?_some_of_lt l₂ id v hLt2
  refine ⟨l₂', hS2, ⟨?_, ?_⟩, ?_⟩
  · rw [setElem?_length hS1, setElem?_length hS2, hAg.1]
  · intro j hjNe
    rw [setElem?_getElem?_ne hS1 hjNe, setElem?_getElem?_ne hS2 hjNe]
    exact hAg.2 j hjNe
  · rw [setElem?_getElem?_same hS1, setElem?_getElem?_same hS2]

private theorem mtc_assign_same_step {id : LocalId} (body body' : Body)
    {liveIn : List Bool} {f₁ f₂ : FrameStateRef} {mem : CallerMemory}
    {stmt : StatementKind}
    (hBL : body'.locals = body.locals)
    (hRel : mtc_FrameRel id body liveIn f₁ f₂)
    (hLocsEq : f₁.locals = f₂.locals)
    (hStepInv :
      ∀ s₁', evalStatementRef body f₁ mem stmt = .step s₁' →
        ∃ f₁', s₁'.frames = [f₁'] ∧ f₁'.defId = 0 ∧
          frameNotTargeting id f₁' = true) :
    match evalStatementRef body f₁ mem stmt with
    | .step s₁' =>
      ∃ s₂', evalStatementRef body' f₂ mem stmt = .step s₂' ∧
        ∃ g₁ g₂ cm,
          s₁' = { frames := [g₁], callerMem := cm } ∧
          s₂' = { frames := [g₂], callerMem := cm } ∧
          mtc_FrameRel id body liveIn g₁ g₂
    | .done out => evalStatementRef body' f₂ mem stmt = .done out
    | .fault k => evalStatementRef body' f₂ mem stmt = .fault k := by
  have hF2Eq := mtc_frame_eq_of_locals_eq hRel hLocsEq
  rw [hF2Eq]
  have hEvEq :
      evalStatementRef body' f₁ mem stmt = evalStatementRef body f₁ mem stmt := by
    unfold evalStatementRef
    rw [hBL]
  rw [hEvEq]
  cases hEv : evalStatementRef body f₁ mem stmt with
  | done _ => rfl
  | fault _ => rfl
  | step s₁' =>
    let ⟨f₁', hFr, hDef', hInv'⟩ := hStepInv s₁' hEv
    have hs1 : s₁' = { frames := [f₁'], callerMem := s₁'.callerMem } := by
      cases s₁' with
      | mk frs cm =>
        dsimp at hFr
        subst hFr
        rfl
    exact ⟨s₁', rfl, f₁', f₁', s₁'.callerMem, hs1, hs1,
      mtc_frameRel_of_same_frame body liveIn f₁' hDef' hInv'⟩

private theorem mtc_assign_noMention_sim {id : LocalId} (body body' : Body)
    {liveIn : List Bool} {bb : BasicBlock} {f₁ f₂ : FrameStateRef}
    {mem : CallerMemory} {dst : Place} {rv : Rvalue} {liveAfter : Bool}
    (hBL : body'.locals = body.locals)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx = some bb)
    (hAfterEq :
      stmtsMayReadBeforeKill id (mtc_dropStmts (f₁.stmtIdx + 1) bb.statements)
        (terminatorMayReadBeforeKill id liveIn bb.terminator) = liveAfter)
    (hStmtNo : stmtTakesDirectAddrOf id (.assign dst rv) = false)
    (hNoMent : rvalueMentionsLocal id rv = false)
    (hDstCase : dst.localId ≠ id ∨ dst.projection = [])
    (hLiveImp :
      dst.localId ≠ id →
      liveAfter = true →
      Trusted.MirSemantics.getElem? f₂.locals id =
        Trusted.MirSemantics.getElem? f₁.locals id)
    (hRel : mtc_FrameRel id body liveIn f₁ f₂) :
    match evalStatementRef body f₁ mem (.assign dst rv) with
    | .step s₁' =>
      ∃ s₂', evalStatementRef body' f₂ mem (.assign dst rv) = .step s₂' ∧
        ∃ g₁ g₂ cm,
          s₁' = { frames := [g₁], callerMem := cm } ∧
          s₂' = { frames := [g₂], callerMem := cm } ∧
          mtc_FrameRel id body liveIn g₁ g₂
    | .done out => evalStatementRef body' f₂ mem (.assign dst rv) = .done out
    | .fault k => evalStatementRef body' f₂ mem (.assign dst rv) = .fault k := by
  let ⟨hd1, hd2, hblk, hst, hep, hnep, hbn, hnt, hInv, hAg, hSlot, _⟩ := hRel
  let ⟨hLocs1, hNodes1⟩ := bool_and_true hInv
  have hLenEq :
      (!Nat.beq f₂.epochs.length f₂.locals.length) =
        (!Nat.beq f₁.epochs.length f₁.locals.length) := by
    rw [hep, ← hAg.1]
  unfold evalStatementRef
  rw [hLenEq, hBL]
  cases hLen : !Nat.beq f₁.epochs.length f₁.locals.length with
  | true => rfl
  | false =>
    dsimp
    rw [hep, hbn, hnt, hblk, hst, hnep, hd2]
    have hNextLive :
        mtc_liveAt id body liveIn f₁.blockIdx (f₁.stmtIdx + 1) = liveAfter := by
      unfold mtc_liveAt
      rw [hBb]
      exact hAfterEq
    cases hProj : dst.projection with
    | nil =>
      dsimp
      cases hDTy : Trusted.MirSemantics.getElem? body.locals dst.localId with
      | none => rfl
      | some dstTy =>
        dsimp
        let ⟨hRvErr, hRvOk⟩ :=
          mtc_evalRvalue_congr_noMention (bodyLocals := body.locals)
            (epochs := f₁.epochs) (nextTag := f₁.nextTag)
            (dstLoc := dst.localId) (dstIsDeref := false) (dstTy := dstTy)
            hNoMent hLocs1 hNodes1 hAg
        cases hRv1 : evalRvalueRef body.locals f₁.locals f₁.epochs
            f₁.borrowNodes f₁.nextTag dst.localId false dstTy rv with
        | error k =>
          dsimp
          rw [hRvErr k hRv1]
        | ok rvRes =>
          cases rvRes with
          | mk val r1 =>
            cases r1 with
            | mk l1 r2 =>
              cases r2 with
              | mk n1 nt1 =>
                dsimp
                let ⟨l2, hRv2, hAg1, hId1, hId2⟩ :=
                  hRvOk val l1 n1 nt1 hRv1
                rw [hRv2]
                dsimp
                let ⟨hVal, hL1No, hN1No⟩ :=
                  evalRvalueRef_notTargeting hStmtNo hLocs1 hNodes1 hRv1
                have hSlot1 : mtc_SlotRel id l1 l2 := by
                  cases hSlot with
                  | inl hEq =>
                    exact Or.inl (hId2.trans (hEq.trans hId1.symm))
                  | inr hBoth =>
                    let ⟨s1, s2, hs1, hs2⟩ := hBoth
                    exact Or.inr ⟨s1, s2, hId1.trans hs1, hId2.trans hs2⟩
                let ⟨hWrErr, hWrOk⟩ :=
                  mtc_writeTargetSlot_congr (bodyLocals := body.locals)
                    (epochs := f₁.epochs) (nodes := n1) (dstLoc := dst.localId)
                    (dstDeref? := none) (dstTy := dstTy) hVal hAg1
                    (fun _ => hSlot1)
                cases hWr1 : writeTargetSlotRef body.locals l1 f₁.epochs n1
                    dst.localId none dstTy val with
                | error k =>
                  dsimp
                  rw [hWrErr k hWr1]
                | ok wrRes =>
                  cases wrRes with
                  | mk l1' n1' =>
                    dsimp
                    let ⟨l2', hWr2, hAg2, hEqIfSame, hPreserveIfNe⟩ :=
                      hWrOk l1' n1' hWr1
                    rw [hWr2]
                    dsimp
                    let ⟨hL1'No, hN1'No⟩ :=
                      writeTargetSlotRef_notTargeting hVal hL1No hN1No hWr1
                    refine ⟨_, rfl, _, _, mem, rfl, rfl,
                      ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                        bool_and_intro hL1'No hN1'No, hAg2, ?_, ?_⟩⟩
                    · cases hEqD : Nat.beq dst.localId id with
                      | true =>
                        exact Or.inl (hEqIfSame (nat_beq_eq hEqD))
                      | false =>
                        let ⟨hu1, hu2⟩ :=
                          hPreserveIfNe (nat_ne_of_beq_false hEqD)
                        cases hSlot1 with
                        | inl hEq =>
                          exact Or.inl (hu2.trans (hEq.trans hu1.symm))
                        | inr hBoth =>
                          let ⟨s1, s2, hs1, hs2⟩ := hBoth
                          exact Or.inr ⟨s1, s2, hu1.trans hs1, hu2.trans hs2⟩
                    · intro hLiveNext
                      dsimp at hLiveNext
                      rw [hNextLive] at hLiveNext
                      cases hEqD : Nat.beq dst.localId id with
                      | true =>
                        exact hEqIfSame (nat_beq_eq hEqD)
                      | false =>
                        have hNeD := nat_ne_of_beq_false hEqD
                        let ⟨hu1, hu2⟩ := hPreserveIfNe hNeD
                        rw [hu2, hu1, hId2, hId1]
                        exact hLiveImp hNeD hLiveNext
    | cons pe rest =>
      have hDstNe : dst.localId ≠ id := by
        cases hDstCase with
        | inl hNe => exact hNe
        | inr hNil => rw [hProj] at hNil; cases hNil
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          rw [mtc_resolveDerefDstRef_congr_ne hDstNe hAg]
          cases hDst : resolveDerefDstRef body.locals f₁.locals f₁.epochs
              f₁.borrowNodes dst.localId with
          | error _ => rfl
          | ok dRes =>
            cases dRes with
            | mk dS d1 =>
              cases d1 with
              | mk dM d2 =>
                cases d2 with
                | mk dstTy d3 =>
                  cases d3 with
                  | mk ptr nDst =>
                    dsimp
                    let ⟨hPtrNotB, hNDst⟩ :=
                      resolveDerefDstRef_notTargeting hLocs1 hNodes1 hDst
                    have hPtrNe : ptr.targetLocal ≠ id :=
                      nat_ne_of_beq_false (bool_not_true hPtrNotB)
                    let ⟨hRvErr, hRvOk⟩ :=
                      mtc_evalRvalue_congr_noMention (bodyLocals := body.locals)
                        (epochs := f₁.epochs) (nextTag := f₁.nextTag)
                        (dstLoc := ptr.targetLocal) (dstIsDeref := true)
                        (dstTy := dstTy) hNoMent hLocs1 hNDst hAg
                    cases hRv1 : evalRvalueRef body.locals f₁.locals f₁.epochs
                        nDst f₁.nextTag ptr.targetLocal true dstTy rv with
                    | error k =>
                      dsimp
                      rw [hRvErr k hRv1]
                    | ok rvRes =>
                      cases rvRes with
                      | mk val r1 =>
                        cases r1 with
                        | mk l1 r2 =>
                          cases r2 with
                          | mk n1 nt1 =>
                            dsimp
                            let ⟨l2, hRv2, hAg1, hId1, hId2⟩ :=
                              hRvOk val l1 n1 nt1 hRv1
                            rw [hRv2]
                            dsimp
                            let ⟨hVal, hL1No, hN1No⟩ :=
                              evalRvalueRef_notTargeting hStmtNo hLocs1 hNDst
                                hRv1
                            let ⟨hWrErr, hWrOk⟩ :=
                              mtc_writeTargetSlot_congr
                                (bodyLocals := body.locals)
                                (epochs := f₁.epochs) (nodes := n1)
                                (dstLoc := ptr.targetLocal)
                                (dstDeref? := some (dS, dM, ptr))
                                (dstTy := dstTy) hVal hAg1
                                (fun hEq => False.elim (hPtrNe hEq))
                            cases hWr1 : writeTargetSlotRef body.locals l1
                                f₁.epochs n1 ptr.targetLocal
                                (some (dS, dM, ptr)) dstTy val with
                            | error k =>
                              dsimp
                              rw [hWrErr k hWr1]
                            | ok wrRes =>
                              cases wrRes with
                              | mk l1' n1' =>
                                dsimp
                                let ⟨l2', hWr2, hAg2, _, hPreserveIfNe⟩ :=
                                  hWrOk l1' n1' hWr1
                                rw [hWr2]
                                dsimp
                                let ⟨hL1'No, hN1'No⟩ :=
                                  writeTargetSlotRef_notTargeting hVal hL1No
                                    hN1No hWr1
                                let ⟨hu1, hu2⟩ := hPreserveIfNe hPtrNe
                                refine ⟨_, rfl, _, _, mem, rfl, rfl,
                                  ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                                    bool_and_intro hL1'No hN1'No, hAg2, ?_, ?_⟩⟩
                                · cases hSlot with
                                  | inl hEq =>
                                    exact Or.inl
                                      (hu2.trans (hId2.trans
                                        (hEq.trans (hu1.trans hId1).symm)))
                                  | inr hBoth =>
                                    let ⟨s1, s2, hs1, hs2⟩ := hBoth
                                    exact Or.inr ⟨s1, s2,
                                      hu1.trans (hId1.trans hs1),
                                      hu2.trans (hId2.trans hs2)⟩
                                · intro hLiveNext
                                  dsimp at hLiveNext
                                  rw [hNextLive] at hLiveNext
                                  rw [hu2, hu1, hId2, hId1]
                                  exact hLiveImp hDstNe hLiveNext

private theorem mtc_assign_rewritten_deadAfter_sim {id : LocalId}
    (body body' : Body) {liveIn : List Bool} {bb : BasicBlock}
    {f₁ f₂ : FrameStateRef} {mem : CallerMemory} {dst : Place} {rv : Rvalue}
    (hBL : body'.locals = body.locals)
    (hBb : Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx = some bb)
    (hAfterDead :
      stmtsMayReadBeforeKill id (mtc_dropStmts (f₁.stmtIdx + 1) bb.statements)
        (terminatorMayReadBeforeKill id liveIn bb.terminator) = false)
    (hStmtNo : stmtTakesDirectAddrOf id (.assign dst rv) = false)
    (hDstNe : dst.localId ≠ id)
    (hLocsEq : f₁.locals = f₂.locals)
    (hRel : mtc_FrameRel id body liveIn f₁ f₂) :
    match evalStatementRef body f₁ mem (.assign dst rv) with
    | .step s₁' =>
      ∃ s₂', evalStatementRef body' f₂ mem
          (.assign dst (rewriteRvalueMoveToCopy id rv)) = .step s₂' ∧
        ∃ g₁ g₂ cm,
          s₁' = { frames := [g₁], callerMem := cm } ∧
          s₂' = { frames := [g₂], callerMem := cm } ∧
          mtc_FrameRel id body liveIn g₁ g₂
    | .done out =>
      evalStatementRef body' f₂ mem
        (.assign dst (rewriteRvalueMoveToCopy id rv)) = .done out
    | .fault k =>
      evalStatementRef body' f₂ mem
        (.assign dst (rewriteRvalueMoveToCopy id rv)) = .fault k := by
  have hF2Eq := mtc_frame_eq_of_locals_eq hRel hLocsEq
  rw [hF2Eq]
  let ⟨hd1, _, _, _, _, _, _, _, hInv, _, _, _⟩ := hRel
  let ⟨hLocs1, hNodes1⟩ := bool_and_true hInv
  have hDeadNext :
      mtc_liveAt id body liveIn f₁.blockIdx (f₁.stmtIdx + 1) = false := by
    unfold mtc_liveAt
    rw [hBb]
    exact hAfterDead
  unfold evalStatementRef
  rw [hBL]
  cases !Nat.beq f₁.epochs.length f₁.locals.length with
  | true => rfl
  | false =>
    dsimp
    cases dst.projection with
    | nil =>
      dsimp
      cases Trusted.MirSemantics.getElem? body.locals dst.localId with
      | none => rfl
      | some dstTy =>
        dsimp
        let ⟨hRvErr, hRvOk⟩ :=
          mtc_evalRvalue_moveToCopy_same (id := id) (bodyLocals := body.locals)
            (l := f₁.locals) (epochs := f₁.epochs) (nodes := f₁.borrowNodes)
            (nextTag := f₁.nextTag) (dstLoc := dst.localId)
            (dstIsDeref := false) (dstTy := dstTy) rv hLocs1 hNodes1
        cases hRv1 : evalRvalueRef body.locals f₁.locals f₁.epochs
            f₁.borrowNodes f₁.nextTag dst.localId false dstTy rv with
        | error k =>
          dsimp
          rw [hRvErr k hRv1]
        | ok rvRes =>
          cases rvRes with
          | mk val r1 =>
            cases r1 with
            | mk l1 r2 =>
              cases r2 with
              | mk n1 nt1 =>
                dsimp
                let ⟨l2, hRv2, hAg1, hSlot1⟩ := hRvOk val l1 n1 nt1 hRv1
                rw [hRv2]
                dsimp
                let ⟨hVal, hL1No, hN1No⟩ :=
                  evalRvalueRef_notTargeting hStmtNo hLocs1 hNodes1 hRv1
                let ⟨hWrErr, hWrOk⟩ :=
                  mtc_writeTargetSlot_congr (bodyLocals := body.locals)
                    (epochs := f₁.epochs) (nodes := n1) (dstLoc := dst.localId)
                    (dstDeref? := none) (dstTy := dstTy) hVal hAg1
                    (fun hEq => False.elim (hDstNe hEq))
                cases hWr1 : writeTargetSlotRef body.locals l1 f₁.epochs n1
                    dst.localId none dstTy val with
                | error k =>
                  dsimp
                  rw [hWrErr k hWr1]
                | ok wrRes =>
                  cases wrRes with
                  | mk l1' n1' =>
                    dsimp
                    let ⟨l2', hWr2, hAg2, _, hPreserveIfNe⟩ :=
                      hWrOk l1' n1' hWr1
                    rw [hWr2]
                    dsimp
                    let ⟨hL1'No, hN1'No⟩ :=
                      writeTargetSlotRef_notTargeting hVal hL1No hN1No hWr1
                    let ⟨hu1, hu2⟩ := hPreserveIfNe hDstNe
                    refine ⟨_, rfl, _, _, mem, rfl, rfl,
                      ⟨hd1, hd1, rfl, rfl, rfl, rfl, rfl, rfl,
                        bool_and_intro hL1'No hN1'No, hAg2, ?_, ?_⟩⟩
                    · cases hSlot1 with
                      | inl hEq =>
                        exact Or.inl (hu2.trans (hEq.trans hu1.symm))
                      | inr hBoth =>
                        let ⟨s1, s2, hs1, hs2⟩ := hBoth
                        exact Or.inr ⟨s1, s2, hu1.trans hs1, hu2.trans hs2⟩
                    · intro hLiveNext
                      dsimp at hLiveNext
                      rw [hDeadNext] at hLiveNext
                      cases hLiveNext
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          cases hDst : resolveDerefDstRef body.locals f₁.locals f₁.epochs
              f₁.borrowNodes dst.localId with
          | error _ => rfl
          | ok dRes =>
            cases dRes with
            | mk dS d1 =>
              cases d1 with
              | mk dM d2 =>
                cases d2 with
                | mk dstTy d3 =>
                  cases d3 with
                  | mk ptr nDst =>
                    dsimp
                    let ⟨hPtrNotB, hNDst⟩ :=
                      resolveDerefDstRef_notTargeting hLocs1 hNodes1 hDst
                    have hPtrNe : ptr.targetLocal ≠ id :=
                      nat_ne_of_beq_false (bool_not_true hPtrNotB)
                    let ⟨hRvErr, hRvOk⟩ :=
                      mtc_evalRvalue_moveToCopy_same (id := id)
                        (bodyLocals := body.locals) (l := f₁.locals)
                        (epochs := f₁.epochs) (nodes := nDst)
                        (nextTag := f₁.nextTag) (dstLoc := ptr.targetLocal)
                        (dstIsDeref := true) (dstTy := dstTy) rv hLocs1 hNDst
                    cases hRv1 : evalRvalueRef body.locals f₁.locals f₁.epochs
                        nDst f₁.nextTag ptr.targetLocal true dstTy rv with
                    | error k =>
                      dsimp
                      rw [hRvErr k hRv1]
                    | ok rvRes =>
                      cases rvRes with
                      | mk val r1 =>
                        cases r1 with
                        | mk l1 r2 =>
                          cases r2 with
                          | mk n1 nt1 =>
                            dsimp
                            let ⟨l2, hRv2, hAg1, hSlot1⟩ :=
                              hRvOk val l1 n1 nt1 hRv1
                            rw [hRv2]
                            dsimp
                            let ⟨hVal, hL1No, hN1No⟩ :=
                              evalRvalueRef_notTargeting hStmtNo hLocs1 hNDst
                                hRv1
                            let ⟨hWrErr, hWrOk⟩ :=
                              mtc_writeTargetSlot_congr
                                (bodyLocals := body.locals)
                                (epochs := f₁.epochs) (nodes := n1)
                                (dstLoc := ptr.targetLocal)
                                (dstDeref? := some (dS, dM, ptr))
                                (dstTy := dstTy) hVal hAg1
                                (fun hEq => False.elim (hPtrNe hEq))
                            cases hWr1 : writeTargetSlotRef body.locals l1
                                f₁.epochs n1 ptr.targetLocal
                                (some (dS, dM, ptr)) dstTy val with
                            | error k =>
                              dsimp
                              rw [hWrErr k hWr1]
                            | ok wrRes =>
                              cases wrRes with
                              | mk l1' n1' =>
                                dsimp
                                let ⟨l2', hWr2, hAg2, _, hPreserveIfNe⟩ :=
                                  hWrOk l1' n1' hWr1
                                rw [hWr2]
                                dsimp
                                let ⟨hL1'No, hN1'No⟩ :=
                                  writeTargetSlotRef_notTargeting hVal hL1No
                                    hN1No hWr1
                                let ⟨hu1, hu2⟩ := hPreserveIfNe hPtrNe
                                refine ⟨_, rfl, _, _, mem, rfl, rfl,
                                  ⟨hd1, hd1, rfl, rfl, rfl, rfl, rfl, rfl,
                                    bool_and_intro hL1'No hN1'No, hAg2, ?_, ?_⟩⟩
                                · cases hSlot1 with
                                  | inl hEq =>
                                    exact Or.inl (hu2.trans (hEq.trans hu1.symm))
                                  | inr hBoth =>
                                    let ⟨s1, s2, hs1, hs2⟩ := hBoth
                                    exact Or.inr ⟨s1, s2, hu1.trans hs1,
                                      hu2.trans hs2⟩
                                · intro hLiveNext
                                  dsimp at hLiveNext
                                  rw [hDeadNext] at hLiveNext
                                  cases hLiveNext

private theorem mtc_evalStepRef_local_sim {id : LocalId} {pw ver : Nat}
    {body : Body} {liveIn : List Bool} {f₁ f₂ : FrameStateRef}
    {mem : CallerMemory}
    (hPos : 0 < id)
    (hNoAddr : bodyTakesAddressOf body id = false)
    (hVer : verifyBackwardLiveInLoop id liveIn 0 body.basicBlocks = true)
    (hRel : mtc_FrameRel id body liveIn f₁ f₂) :
    let body' : Body :=
      { body with basicBlocks := body.basicBlocks.map (mtc_rewriteBlock id liveIn) }
    let p₁ := mtc_singleBodyProg pw ver body
    let p₂ := mtc_singleBodyProg pw ver body'
    LockstepStepRel p₁ p₂
      (fun s₁ s₂ =>
        ∃ g₁ g₂ cm,
          s₁ = { frames := [g₁], callerMem := cm } ∧
          s₂ = { frames := [g₂], callerMem := cm } ∧
          mtc_FrameRel id body liveIn g₁ g₂)
      { frames := [f₁], callerMem := mem }
      { frames := [f₂], callerMem := mem } := by
  dsimp [LockstepStepRel]
  let body' : Body :=
    { body with basicBlocks := body.basicBlocks.map (mtc_rewriteBlock id liveIn) }
  let ⟨hd1, hd2, hblk, hst, hep, hnep, hbn, hnt, hInv, hAg, hSlot, hLiveEq⟩ :=
    hRel
  let ⟨hLocs1, hNodes1⟩ := bool_and_true hInv
  have hLenEq :
      (!Nat.beq f₂.epochs.length f₂.locals.length) =
        (!Nat.beq f₁.epochs.length f₁.locals.length) := by
    rw [hep, ← hAg.1]
  unfold evalStepRef
  dsimp [mtc_singleBodyProg]
  rw [hLenEq, hd1, hd2]
  dsimp [Trusted.MirSemantics.getElem?]
  cases hLen : !Nat.beq f₁.epochs.length f₁.locals.length with
  | true => rfl
  | false =>
    dsimp
    rw [hblk, getElem?_map]
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks f₁.blockIdx with
    | none => rfl
    | some bb =>
      dsimp
      rw [hst, mtc_rewriteBlock_eq]
      dsimp
      let liveOut := terminatorMayReadBeforeKill id liveIn bb.terminator
      cases hSt : Trusted.MirSemantics.getElem? bb.statements f₁.stmtIdx with
      | some stmt =>
        rw [mtc_rewriteStmts_getElem? id bb.statements liveOut hSt]
        dsimp
        let liveAfter :=
          stmtsMayReadBeforeKill id (mtc_dropStmts (f₁.stmtIdx + 1) bb.statements)
            liveOut
        have hLiveBefore :
            mtc_liveAt id body liveIn f₁.blockIdx f₁.stmtIdx =
              stmtMayReadBeforeKill id stmt liveAfter := by
          unfold mtc_liveAt
          rw [hBb]
          dsimp
          rw [mtc_dropStmts_of_getElem? hSt]
          rfl
        have hLiveNext :
            mtc_liveAt id body liveIn f₁.blockIdx (f₁.stmtIdx + 1) =
              liveAfter := by
          unfold mtc_liveAt
          rw [hBb]
        have hBbNo : bb.statements.any (stmtTakesDirectAddrOf id) = false :=
          list_any_false_getElem?
            (p := fun b : BasicBlock =>
              b.statements.any (stmtTakesDirectAddrOf id))
            hNoAddr hBb
        have hStmtNo : stmtTakesDirectAddrOf id stmt = false :=
          list_any_false_getElem? hBbNo hSt
        have hStepInv :
            ∀ s₁', evalStatementRef body f₁ mem stmt = .step s₁' →
              ∃ f₁', s₁'.frames = [f₁'] ∧ f₁'.defId = 0 ∧
                frameNotTargeting id f₁' = true := by
          intro s₁' hEvS
          have hEvFull :
              evalStepRef (mtc_singleBodyProg pw ver body) 0
                { frames := [f₁], callerMem := mem } = .step s₁' := by
            unfold evalStepRef
            dsimp [mtc_singleBodyProg]
            rw [if_bool_false hLen, hd1]
            dsimp [Trusted.MirSemantics.getElem?]
            rw [hBb]
            dsimp
            rw [hSt]
            exact hEvS
          let ⟨f₁', hFr, hDefEq, hInv'⟩ :=
            evalStepRef_preserves_frameNotTargeting
              (p := mtc_singleBodyProg pw ver body) (body := body) (id := id)
              (by rw [hd1]; rfl) hNoAddr hInv hEvFull
          exact ⟨f₁', hFr, hDefEq.trans hd1, hInv'⟩
        cases stmt with
        | nop =>
          dsimp [mtc_rewriteOneStmt]
          unfold evalStatementRef
          rw [hLenEq, hLen]
          dsimp
          rw [hd2, hblk, hst, hep, hnep, hbn, hnt]
          refine ⟨_, rfl, _, _, mem, rfl, rfl,
            ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl, hInv, hAg, hSlot, ?_⟩⟩
          intro hLN
          dsimp at hLN
          rw [hLiveNext] at hLN
          apply hLiveEq
          rw [hLiveBefore]
          exact hLN
        | unsupported =>
          dsimp [mtc_rewriteOneStmt]
          unfold evalStatementRef
          rw [hLenEq, hLen]
          rfl
        | storageLive lid =>
          dsimp [mtc_rewriteOneStmt]
          unfold evalStatementRef
          rw [hLenEq, hLen]
          dsimp
          cases hBL : Trusted.MirSemantics.getElem? body.locals lid with
          | none => rfl
          | some lTy =>
            dsimp
            cases hEqL : Nat.beq lid id with
            | true =>
              have hLidEq := nat_beq_eq hEqL
              subst hLidEq
              cases hS1 : setElem? f₁.locals lid (liveUninitSlotRef lTy) with
              | none =>
                rw [mtc_setElem?_none_iff_of_len hAg.1 lid
                  (liveUninitSlotRef lTy) hS1]
              | some l1' =>
                let ⟨l2', hS2, hAg', hSameId⟩ := mtc_setElem?_same_id hAg hS1
                rw [hS2, hep, hnep]
                cases hSE : setElem? f₁.epochs lid f₁.nextEpoch with
                | none => rfl
                | some eps' =>
                  dsimp
                  rw [hd2, hblk, hst, hbn, hnt]
                  exact ⟨_, rfl, _, _, mem, rfl, rfl,
                    ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                      bool_and_intro
                        (list_all_setElem? hLocs1
                          (liveUninitSlotRef_notTargeting lid lTy) hS1)
                        hNodes1,
                      hAg', Or.inl hSameId, fun _ => hSameId⟩⟩
            | false =>
              have hLidNe := nat_ne_of_beq_false hEqL
              cases hS1 : setElem? f₁.locals lid (liveUninitSlotRef lTy) with
              | none =>
                rw [mtc_setElem?_none_iff_of_len hAg.1 lid
                  (liveUninitSlotRef lTy) hS1]
              | some l1' =>
                let ⟨l2', hS2, hAg', hId2⟩ :=
                  mtc_localsAgreeExcept_setElem?_ne hAg hLidNe hS1
                have hId1 : Trusted.MirSemantics.getElem? l1' id =
                    Trusted.MirSemantics.getElem? f₁.locals id :=
                  setElem?_getElem?_ne hS1 hLidNe.symm
                rw [hS2, hep, hnep]
                cases hSE : setElem? f₁.epochs lid f₁.nextEpoch with
                | none => rfl
                | some eps' =>
                  dsimp
                  rw [hd2, hblk, hst, hbn, hnt]
                  refine ⟨_, rfl, _, _, mem, rfl, rfl,
                    ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                      bool_and_intro
                        (list_all_setElem? hLocs1
                          (liveUninitSlotRef_notTargeting id lTy) hS1)
                        hNodes1,
                      hAg', ?_, ?_⟩⟩
                  · cases hSlot with
                    | inl hEq =>
                      exact Or.inl (hId2.trans (hEq.trans hId1.symm))
                    | inr hBoth =>
                      let ⟨s1, s2, hs1, hs2⟩ := hBoth
                      exact Or.inr ⟨s1, s2, hId1.trans hs1, hId2.trans hs2⟩
                  · intro hLN
                    dsimp at hLN
                    rw [hLiveNext] at hLN
                    rw [hId2, hId1]
                    apply hLiveEq
                    rw [hLiveBefore]
                    dsimp [stmtMayReadBeforeKill]
                    rw [if_bool_false hEqL]
                    exact hLN
        | storageDead lid =>
          dsimp [mtc_rewriteOneStmt]
          unfold evalStatementRef
          rw [hLenEq, hLen]
          dsimp
          cases hL0 : Nat.beq lid 0 with
          | true => rfl
          | false =>
            dsimp
            cases hEqL : Nat.beq lid id with
            | true =>
              have hLidEq := nat_beq_eq hEqL
              subst hLidEq
              cases hS1 : setElem? f₁.locals lid .dead with
              | none =>
                rw [mtc_setElem?_none_iff_of_len hAg.1 lid .dead hS1]
              | some l1' =>
                let ⟨l2', hS2, hAg', hSameId⟩ := mtc_setElem?_same_id hAg hS1
                rw [hS2, hd2, hblk, hst, hep, hnep, hbn, hnt]
                dsimp
                exact ⟨_, rfl, _, _, mem, rfl, rfl,
                  ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                    bool_and_intro (list_all_setElem? hLocs1 rfl hS1) hNodes1,
                    hAg', Or.inl hSameId, fun _ => hSameId⟩⟩
            | false =>
              have hLidNe := nat_ne_of_beq_false hEqL
              cases hS1 : setElem? f₁.locals lid .dead with
              | none =>
                rw [mtc_setElem?_none_iff_of_len hAg.1 lid .dead hS1]
              | some l1' =>
                let ⟨l2', hS2, hAg', hId2⟩ :=
                  mtc_localsAgreeExcept_setElem?_ne hAg hLidNe hS1
                have hId1 : Trusted.MirSemantics.getElem? l1' id =
                    Trusted.MirSemantics.getElem? f₁.locals id :=
                  setElem?_getElem?_ne hS1 hLidNe.symm
                rw [hS2, hd2, hblk, hst, hep, hnep, hbn, hnt]
                dsimp
                refine ⟨_, rfl, _, _, mem, rfl, rfl,
                  ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                    bool_and_intro (list_all_setElem? hLocs1 rfl hS1) hNodes1,
                    hAg', ?_, ?_⟩⟩
                · cases hSlot with
                  | inl hEq =>
                    exact Or.inl (hId2.trans (hEq.trans hId1.symm))
                  | inr hBoth =>
                    let ⟨s1, s2, hs1, hs2⟩ := hBoth
                    exact Or.inr ⟨s1, s2, hId1.trans hs1, hId2.trans hs2⟩
                · intro hLN
                  dsimp at hLN
                  rw [hLiveNext] at hLN
                  rw [hId2, hId1]
                  apply hLiveEq
                  rw [hLiveBefore]
                  dsimp [stmtMayReadBeforeKill]
                  rw [if_bool_false hEqL]
                  exact hLN
        | assign dst rv =>
          dsimp [mtc_rewriteOneStmt]
          cases hRew : (!Nat.beq dst.localId id && !liveAfter) with
          | true =>
            dsimp
            let ⟨hDstNotB, hAfterNotB⟩ := bool_and_true hRew
            have hDstNe : dst.localId ≠ id :=
              nat_ne_of_beq_false (bool_not_true hDstNotB)
            have hAfterFalse : liveAfter = false := bool_not_true hAfterNotB
            cases hMent : rvalueMentionsLocal id rv with
            | false =>
              rw [mtc_rewriteRvalue_noMention hMent]
              exact mtc_assign_noMention_sim body body' (liveAfter := liveAfter)
                rfl hBb rfl hStmtNo hMent (Or.inl hDstNe)
                (fun _ hLA => by rw [hAfterFalse] at hLA; cases hLA)
                hRel
            | true =>
              have hLB : mtc_liveAt id body liveIn f₁.blockIdx f₁.stmtIdx =
                  true := by
                rw [hLiveBefore]
                dsimp [stmtMayReadBeforeKill]
                rw [if_bool_false (bool_not_true hDstNotB), hMent]
                rfl
              have hLocsEq :=
                mtc_locals_eq_of_agree_and_same hAg (hLiveEq hLB)
              exact mtc_assign_rewritten_deadAfter_sim body body' rfl hBb
                hAfterFalse hStmtNo hDstNe hLocsEq hRel
          | false =>
            dsimp
            cases hEqD : Nat.beq dst.localId id with
            | false =>
              have hDstNe := nat_ne_of_beq_false hEqD
              cases hMent : rvalueMentionsLocal id rv with
              | true =>
                have hLB : mtc_liveAt id body liveIn f₁.blockIdx f₁.stmtIdx =
                    true := by
                  rw [hLiveBefore]
                  dsimp [stmtMayReadBeforeKill]
                  rw [if_bool_false hEqD, hMent]
                  rfl
                have hLocsEq :=
                  mtc_locals_eq_of_agree_and_same hAg (hLiveEq hLB)
                exact mtc_assign_same_step body body' rfl hRel hLocsEq
                  hStepInv
              | false =>
                exact mtc_assign_noMention_sim body body' rfl hBb rfl hStmtNo
                  hMent (Or.inl hDstNe)
                  (fun _ hLA => by
                    apply hLiveEq
                    rw [hLiveBefore]
                    dsimp [stmtMayReadBeforeKill]
                    rw [if_bool_false hEqD, hMent]
                    exact hLA)
                  hRel
            | true =>
              cases hProj : dst.projection with
              | nil =>
                cases hMent : rvalueMentionsLocal id rv with
                | true =>
                  have hLB : mtc_liveAt id body liveIn f₁.blockIdx f₁.stmtIdx =
                      true := by
                    rw [hLiveBefore]
                    dsimp [stmtMayReadBeforeKill]
                    rw [if_bool_true hEqD, hProj]
                    exact hMent
                  have hLocsEq :=
                    mtc_locals_eq_of_agree_and_same hAg (hLiveEq hLB)
                  exact mtc_assign_same_step body body' rfl hRel hLocsEq
                    hStepInv
                | false =>
                  exact mtc_assign_noMention_sim body body' rfl hBb rfl
                    hStmtNo hMent (Or.inr hProj)
                    (fun hNe _ => False.elim (hNe (nat_beq_eq hEqD))) hRel
              | cons _ _ =>
                have hLB : mtc_liveAt id body liveIn f₁.blockIdx f₁.stmtIdx =
                    true := by
                  rw [hLiveBefore]
                  dsimp [stmtMayReadBeforeKill]
                  rw [if_bool_true hEqD, hProj]
                  rfl
                have hLocsEq :=
                  mtc_locals_eq_of_agree_and_same hAg (hLiveEq hLB)
                exact mtc_assign_same_step body body' rfl hRel hLocsEq
                  hStepInv
      | none =>
        rw [mtc_rewriteStmts_getElem?_none id bb.statements liveOut hSt]
        dsimp
        rw [mtc_rewriteStmts_length id bb.statements liveOut]
        cases hAtEnd : Nat.beq f₁.stmtIdx bb.statements.length with
        | false => rfl
        | true =>
          dsimp
          have hIdxEq := nat_beq_eq hAtEnd
          have hLiveTerm :
              mtc_liveAt id body liveIn f₁.blockIdx f₁.stmtIdx =
                terminatorMayReadBeforeKill id liveIn bb.terminator := by
            unfold mtc_liveAt
            rw [hBb, hIdxEq]
            dsimp
            rw [mtc_dropStmts_length]
            rfl
          unfold evalTerminatorRef
          rw [hLenEq, hLen]
          dsimp
          cases hTerm : bb.terminator with
          | goto tgt =>
            dsimp [jumpToBlockRef]
            rw [hd2, hep, hnep, hbn, hnt]
            refine ⟨_, rfl, _, _, mem, rfl, rfl,
              ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl, hInv, hAg, hSlot, ?_⟩⟩
            intro hLiveTgt
            have hInTgt := mtc_liveAt_entry_implies_liveIn hVer hLiveTgt
            apply hLiveEq
            rw [hLiveTerm, hTerm]
            exact hInTgt
          | return_ =>
            dsimp
            cases bb.cleanup with
            | true => rfl
            | false =>
              dsimp
              have h0Ne : (0 : LocalId) ≠ id := fun h =>
                Nat.ne_of_lt hPos h
              rw [← hAg.2 0 h0Ne]
              cases Trusted.MirSemantics.getElem? f₁.locals 0 with
              | none => rfl
              | some sl =>
                cases sl with
                | dead => rfl
                | live ov =>
                  cases ov with
                  | none => rfl
                  | some vr => cases vr <;> rfl
          | unreachable | unwindResume | assert _ _ _ _ _
          | call _ _ _ _ _ | unsupported =>
            rfl
          | switchInt discr targets =>
            dsimp
            cases hMentD : operandMentionsLocal id discr with
            | true =>
              have hLB : mtc_liveAt id body liveIn f₁.blockIdx f₁.stmtIdx =
                  true := by
                rw [hLiveTerm, hTerm]
                dsimp [terminatorMayReadBeforeKill]
                rw [hMentD]
                rfl
              have hLocsEq :=
                mtc_locals_eq_of_agree_and_same hAg (hLiveEq hLB)
              have hF2Eq := mtc_frame_eq_of_locals_eq hRel hLocsEq
              rw [hF2Eq]
              cases hD : evalPrimitiveOperandRef body.locals f₁.locals f₁.epochs
                  f₁.borrowNodes discr with
              | error _ => rfl
              | ok dRes =>
                cases dRes with
                | mk dv rRest =>
                  cases rRest with
                  | mk l1 n1 =>
                    dsimp
                    let ⟨hL1No, hN1No⟩ :=
                      evalPrimitiveOperandRef_notTargeting hLocs1 hNodes1 hD
                    cases dv with
                    | scalar sv =>
                      dsimp
                      cases hSw : evalSwitchBranches sv.width sv.bits
                          targets.otherwise targets.branches with
                      | error _ => rfl
                      | ok tgt =>
                        dsimp [jumpToBlockRef]
                        exact ⟨_, rfl, _, _, mem, rfl, rfl,
                          mtc_frameRel_of_same_frame body liveIn _ hd1
                            (bool_and_intro hL1No hN1No)⟩
                    | bool b =>
                      dsimp
                      cases hSw : evalBoolSwitchBranches b targets.otherwise
                          targets.branches with
                      | error _ => rfl
                      | ok tgt =>
                        dsimp [jumpToBlockRef]
                        exact ⟨_, rfl, _, _, mem, rfl, rfl,
                          mtc_frameRel_of_same_frame body liveIn _ hd1
                            (bool_and_intro hL1No hN1No)⟩
                    | _ => rfl
            | false =>
              rw [hep, hbn]
              let ⟨hPrErr, hPrOk⟩ :=
                mtc_evalPrimOperand_congr_noMention (bodyLocals := body.locals)
                  (epochs := f₁.epochs) hMentD hLocs1 hNodes1 hAg
              cases hD1 : evalPrimitiveOperandRef body.locals f₁.locals
                  f₁.epochs f₁.borrowNodes discr with
              | error k =>
                dsimp
                rw [hPrErr k hD1]
              | ok dRes =>
                cases dRes with
                | mk dv rRest =>
                  cases rRest with
                  | mk l1 n1 =>
                    dsimp
                    let ⟨l2, hD2, hAg1, hId1, hId2⟩ := hPrOk dv l1 n1 hD1
                    rw [hD2]
                    dsimp
                    let ⟨hL1No, hN1No⟩ :=
                      evalPrimitiveOperandRef_notTargeting hLocs1 hNodes1 hD1
                    have hSlot1 : mtc_SlotRel id l1 l2 := by
                      cases hSlot with
                      | inl hEq =>
                        exact Or.inl (hId2.trans (hEq.trans hId1.symm))
                      | inr hBoth =>
                        let ⟨s1, s2, hs1, hs2⟩ := hBoth
                        exact Or.inr ⟨s1, s2, hId1.trans hs1, hId2.trans hs2⟩
                    cases dv with
                    | scalar sv =>
                      dsimp
                      cases hSw : evalSwitchBranches sv.width sv.bits
                          targets.otherwise targets.branches with
                      | error _ => rfl
                      | ok tgt =>
                        dsimp [jumpToBlockRef]
                        rw [hd2, hnep, hnt]
                        refine ⟨_, rfl, _, _, mem, rfl, rfl,
                          ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                            bool_and_intro hL1No hN1No, hAg1, hSlot1, ?_⟩⟩
                        intro hLiveTgt
                        have hInTgt :=
                          mtc_liveAt_entry_implies_liveIn hVer hLiveTgt
                        have hOrMem :=
                          mtc_evalSwitchBranches_mem sv.width sv.bits
                            targets.otherwise targets.branches hSw liveIn hInTgt
                        rw [hId2, hId1]
                        apply hLiveEq
                        rw [hLiveTerm, hTerm]
                        dsimp [terminatorMayReadBeforeKill]
                        rw [hMentD]
                        cases bool_or_true hOrMem with
                        | inl hO =>
                          exact bool_or_intro_left _ (bool_or_intro_right _ hO)
                        | inr hR => exact bool_or_intro_right _ hR
                    | bool b =>
                      dsimp
                      cases hSw : evalBoolSwitchBranches b targets.otherwise
                          targets.branches with
                      | error _ => rfl
                      | ok tgt =>
                        dsimp [jumpToBlockRef]
                        rw [hd2, hnep, hnt]
                        refine ⟨_, rfl, _, _, mem, rfl, rfl,
                          ⟨hd1, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                            bool_and_intro hL1No hN1No, hAg1, hSlot1, ?_⟩⟩
                        intro hLiveTgt
                        have hInTgt :=
                          mtc_liveAt_entry_implies_liveIn hVer hLiveTgt
                        have hOrMem :=
                          mtc_evalBoolSwitchBranches_mem b targets.otherwise
                            targets.branches hSw liveIn hInTgt
                        rw [hId2, hId1]
                        apply hLiveEq
                        rw [hLiveTerm, hTerm]
                        dsimp [terminatorMayReadBeforeKill]
                        rw [hMentD]
                        cases bool_or_true hOrMem with
                        | inl hO =>
                          exact bool_or_intro_left _ (bool_or_intro_right _ hO)
                        | inr hR => exact bool_or_intro_right _ hR
                    | _ => rfl

private theorem mtc_initLocalsRefLoop_congr {b₁ b₂ : Body}
    (hArg : b₂.argumentCount = b₁.argumentCount)
    (hStor : ∀ loc : LocalId,
      hasStorageAnnotation b₂ loc = hasStorageAnnotation b₁ loc)
    (args : List Val) (idx : Nat) (tys : List MirTy) :
    initLocalsRefLoop b₂ args idx tys = initLocalsRefLoop b₁ args idx tys := by
  induction tys generalizing idx with
  | nil => rfl
  | cons ty rest ih =>
    dsimp [initLocalsRefLoop]
    rw [hArg, hStor idx, ih (idx + 1)]

private theorem mtc_initStateRef_local_eq (id : LocalId) (pw ver : Nat)
    (b : Body) (q : Query) :
    initStateRef (mtc_singleBodyProg pw ver (applyMoveToCopyLocal id b)) q =
      initStateRef (mtc_singleBodyProg pw ver b) q := by
  let ⟨hArg, hLoc, _, _, _, hEmp, hStor, hSb, hAdm, _⟩ := mtc_local_meta id b
  unfold initStateRef mtc_singleBodyProg
  dsimp [Trusted.MirSemantics.getElem?]
  rw [hEmp, hArg, hLoc, hSb, hAdm,
      mtc_initLocalsRefLoop_congr hArg hStor q.args 0 b.locals]

private theorem mtc_local_queryEquiv (id : LocalId) (pw ver : Nat) (b : Body) :
    mtc_QueryEquiv (mtc_singleBodyProg pw ver b)
      (mtc_singleBodyProg pw ver (applyMoveToCopyLocal id b)) := by
  cases mtc_applyMoveToCopyLocal_cases id b with
  | inl hNoop =>
    rw [hNoop]
    exact mtc_QueryEquiv_refl _
  | inr hRew =>
    let ⟨_, liveIn, hPos, _, hNoAddr, _, _, _, hVer, hB'⟩ := hRew
    have hInitEq := mtc_initStateRef_local_eq id pw ver b
    rw [hB'] at hInitEq
    rw [hB']
    intro q
    apply query_equiv_of_lockstep_sim
      (R := fun s₁ s₂ =>
        ∃ g₁ g₂ cm,
          s₁ = { frames := [g₁], callerMem := cm } ∧
          s₂ = { frames := [g₂], callerMem := cm } ∧
          mtc_FrameRel id b liveIn g₁ g₂)
    · intro k hErr
      rw [hInitEq q]
      exact hErr
    · intro s₀ hOk
      have hOk2 :
          initStateRef
            (mtc_singleBodyProg pw ver
              { b with
                basicBlocks := b.basicBlocks.map (mtc_rewriteBlock id liveIn) })
            q = .ok s₀ := by
        rw [hInitEq q]
        exact hOk
      unfold initStateRef mtc_singleBodyProg at hOk
      dsimp [Trusted.MirSemantics.getElem?] at hOk
      cases hHdr : (!Nat.beq pw 64 || !Nat.beq ver 1) with
      | true => rw [if_bool_true hHdr] at hOk; cases hOk
      | false =>
        rw [if_bool_false hHdr] at hOk
        cases hMem : !q.callerMem.allocations.isEmpty with
        | true => rw [if_bool_true hMem] at hOk; cases hOk
        | false =>
          rw [if_bool_false hMem] at hOk
          cases hEmp : b.basicBlocks.isEmpty with
          | true => rw [if_bool_true hEmp] at hOk; cases hOk
          | false =>
            rw [if_bool_false hEmp] at hOk
            cases hAC : !Nat.blt b.argumentCount b.locals.length with
            | true => rw [if_bool_true hAC] at hOk; cases hOk
            | false =>
              rw [if_bool_false hAC] at hOk
              cases hSB : !storageAnnotationsInBounds b with
              | true => rw [if_bool_true hSB] at hOk; cases hOk
              | false =>
                rw [if_bool_false hSB] at hOk
                cases hAd : !bodyLocalsAdmittedRef b with
                | true => rw [if_bool_true hAd] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hAd] at hOk
                  cases hAM : !checkArgsMatch q.args
                      ((b.locals.drop 1).take b.argumentCount) with
                  | true => rw [if_bool_true hAM] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hAM] at hOk
                    injection hOk with hs0
                    subst hs0
                    exact ⟨_, hOk2, _, _, q.callerMem, rfl, rfl,
                      mtc_frameRel_of_same_frame b liveIn _ rfl
                        (bool_and_intro
                          (initLocalsRefLoop_notTargeting id b q.args 0
                            b.locals)
                          rfl)⟩
    · intro s₁ s₂ hR
      let ⟨f₁, f₂, cm, hs1, hs2, hFRel⟩ := hR
      subst hs1; subst hs2
      exact mtc_evalStepRef_local_sim hPos hNoAddr hVer hFRel

private theorem mtc_loop_queryEquiv (pw ver : Nat) (b : Body) (idx rem : Nat) :
    mtc_QueryEquiv (mtc_singleBodyProg pw ver b)
      (mtc_singleBodyProg pw ver (applyMoveToCopyLocalsLoop b idx rem)) := by
  induction rem generalizing b idx with
  | zero => exact mtc_QueryEquiv_refl _
  | succ k ih =>
    dsimp [applyMoveToCopyLocalsLoop]
    exact mtc_QueryEquiv_trans (mtc_local_queryEquiv idx pw ver b)
      (ih (applyMoveToCopyLocal idx b) (idx + 1))

private theorem mtc_body_queryEquiv (pw ver : Nat) (b : Body) :
    mtc_QueryEquiv (mtc_singleBodyProg pw ver b)
      (mtc_singleBodyProg pw ver (applyMoveToCopyBody b)) := by
  unfold applyMoveToCopyBody
  cases (b.basicBlocks.isEmpty || !bodyAllLocalsInBounds b ||
      !bodyAllBlocksInBounds b || !storageAnnotationsInBounds b ||
      !bodyLocalsAdmittedRef b) with
  | true => exact mtc_QueryEquiv_refl _
  | false => exact mtc_loop_queryEquiv pw ver b 1 (b.locals.length - 1)

private theorem mtc_prog_queryEquiv {p₁ p₂ : Program}
    (hPw : p₁.pointerWidthBits = p₂.pointerWidthBits)
    (hVer : p₁.mirProfileVersion = p₂.mirProfileVersion)
    (hEnt : p₁.entryDefId = p₂.entryDefId)
    (hBodies : p₂.bodies = p₁.bodies.map applyMoveToCopyBody) :
    mtc_QueryEquiv p₁ p₂ := by
  cases hEntry : Trusted.MirSemantics.getElem? p₁.bodies p₁.entryDefId with
  | none =>
    apply mtc_query_equiv_of_same_entry (p₁ := p₁) (p₂ := p₂) hPw hVer
    rw [hBodies, ← hEnt, getElem?_map, hEntry]
    rfl
  | some b =>
    have h1 : mtc_QueryEquiv p₁
        (mtc_singleBodyProg p₁.pointerWidthBits p₁.mirProfileVersion b) := by
      apply mtc_query_equiv_of_same_entry
        (p₁ := p₁)
        (p₂ := mtc_singleBodyProg p₁.pointerWidthBits p₁.mirProfileVersion b)
        rfl rfl
      rw [hEntry]
      rfl
    have h2 := mtc_body_queryEquiv p₁.pointerWidthBits p₁.mirProfileVersion b
    have h3 : mtc_QueryEquiv
        (mtc_singleBodyProg p₁.pointerWidthBits p₁.mirProfileVersion
          (applyMoveToCopyBody b)) p₂ := by
      apply mtc_query_equiv_of_same_entry
        (p₁ := mtc_singleBodyProg p₁.pointerWidthBits p₁.mirProfileVersion
          (applyMoveToCopyBody b))
        (p₂ := p₂)
        hPw hVer
      rw [hBodies, ← hEnt, getElem?_map, hEntry]
      rfl
    exact mtc_QueryEquiv_trans h1 (mtc_QueryEquiv_trans h2 h3)

private theorem moveToCopyPointers_sound_bidirectional_iff_slice2
    (pSrc pTgt : Program)
    (hMoveToCopy : checkMoveToCopyPointers pSrc pTgt = true) :
    FullSemanticEquivRef pSrc pTgt := by
  unfold checkMoveToCopyPointers at hMoveToCopy
  have hEqP : applyMoveToCopyPointers pSrc = pTgt := programEq_eq hMoveToCopy
  subst hEqP
  have hQ := mtc_prog_queryEquiv (p₁ := pSrc) (p₂ := applyMoveToCopyPointers pSrc)
    rfl rfl rfl rfl
  refine ⟨hQ, ?_, ?_⟩
  · intro q post
    let ⟨hWf, hBeh, _, _⟩ := hQ q
    exact satisfiesPostRef_iff_of_query_equiv hWf hBeh post
  · intro defId bSrc bTgt safetyPre hGSrc hGTgt
    dsimp [applyMoveToCopyPointers] at hGTgt
    rw [getElem?_map, hGSrc] at hGTgt
    dsimp at hGTgt
    injection hGTgt with hBTgt
    subst hBTgt
    let ⟨hArg, hLoc, hUns, hId, hEmp, hSb, hAdm⟩ := mtc_body_meta bSrc
    have hStaticEq :
        BodyStaticAdmittedRef (applyMoveToCopyPointers pSrc)
          (applyMoveToCopyBody bSrc) =
        BodyStaticAdmittedRef pSrc bSrc := by
      unfold BodyStaticAdmittedRef
      dsimp [applyMoveToCopyPointers]
      rw [hId, hEmp, hArg, hLoc, hSb, hAdm]
    have hQEntry :=
      mtc_prog_queryEquiv
        (p₁ := entryProgForBody pSrc defId)
        (p₂ := entryProgForBody (applyMoveToCopyPointers pSrc) defId)
        rfl rfl rfl rfl
    unfold BodyVerifiedRef ValidEntryArgsRef
    rw [hStaticEq, hArg, hLoc, hUns]
    constructor
    · intro ⟨_, hSt, hRun⟩
      refine ⟨hGSrc, hSt, ?_⟩
      intro args hVA hSafe
      exact (hQEntry { args := args }).1.mp (hRun args hVA hSafe)
    · intro ⟨_, hSt, hRun⟩
      refine ⟨by dsimp [applyMoveToCopyPointers]; rw [getElem?_map, hGSrc]; rfl,
        hSt, ?_⟩
      intro args hVA hSafe
      exact (hQEntry { args := args }).1.mpr (hRun args hVA hSafe)

