                        rw [c.hRIsMut, hMut]; rfl
                      rw [hMutB]
                      dsimp
                      refine ⟨hNT0, hPM0, hRoot', fS.nextTag, initPerm,
                        Nat.lt_succ_self _, rfl, hFindNew, ?_⟩
                      dsimp [initPerm]
                      rw [hMut]
                      exact Or.inl ⟨rfl, rfl⟩
                    | shared =>
                      have hMutB : c.rIsMut = false := by
                        rw [c.hRIsMut, hMut]; rfl
                      rw [hMutB]
                      dsimp
                      refine ⟨hNT0, hPM0, hRoot', fS.nextTag, initPerm,
                        Nat.lt_succ_self _, rfl, hFindNew, ?_⟩
                      dsimp [initPerm]
                      rw [hMut]
                      exact Or.inr ⟨rfl, rfl⟩
