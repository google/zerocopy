/-! ### Slice 3a: Tree Borrows Per-Allocation Isolation & Isomorphism -/

private noncomputable def rp_nodeAt (loc : LocalId) (ep : Nat)
    (n : BorrowNode) : Bool :=
  Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep

private noncomputable def rp_nodesAt (loc : LocalId) (ep : Nat) :
    List BorrowNode → List BorrowNode
  | [] => []
  | n :: ns =>
    if rp_nodeAt loc ep n then
      n :: rp_nodesAt loc ep ns
    else
      rp_nodesAt loc ep ns

private theorem rp_nodeAt_true {loc : LocalId} {ep : Nat} {n : BorrowNode}
    (h : rp_nodeAt loc ep n = true) :
    n.targetLocal = loc ∧ n.targetEpoch = ep := by
  let ⟨h1, h2⟩ := bool_and_true h
  exact ⟨nat_beq_eq h1, nat_beq_eq h2⟩

private theorem rp_nodeAt_intro {loc : LocalId} {ep : Nat} {n : BorrowNode}
    (hL : n.targetLocal = loc) (hE : n.targetEpoch = ep) :
    rp_nodeAt loc ep n = true :=
  bool_and_intro (nat_beq_of_eq hL) (nat_beq_of_eq hE)

private theorem rp_nodeAt_false_of_ne {loc loc' : LocalId} {ep ep' : Nat}
    {n : BorrowNode}
    (hMatch : rp_nodeAt loc ep n = true)
    (hNe : loc' ≠ loc ∨ ep' ≠ ep) :
    rp_nodeAt loc' ep' n = false := by
  let ⟨hL, hE⟩ := rp_nodeAt_true hMatch
  cases h : rp_nodeAt loc' ep' n with
  | false => rfl
  | true =>
    let ⟨hL', hE'⟩ := rp_nodeAt_true h
    cases hNe with
    | inl hNL =>
      rw [hL] at hL'
      exact False.elim (hNL hL'.symm)
    | inr hNE =>
      rw [hE] at hE'
      exact False.elim (hNE hE'.symm)

private theorem rp_nodesAt_append (loc : LocalId) (ep : Nat)
    (xs ys : List BorrowNode) :
    rp_nodesAt loc ep (xs ++ ys) =
      rp_nodesAt loc ep xs ++ rp_nodesAt loc ep ys := by
  induction xs with
  | nil => rfl
  | cons n ns ih =>
    dsimp [rp_nodesAt]
    cases h : rp_nodeAt loc ep n with
    | true =>
      rw [if_bool_true rfl, if_bool_true rfl]
      dsimp
      rw [ih]
    | false =>
      rw [if_bool_false rfl, if_bool_false rfl]
      exact ih

private theorem rp_nodesAt_all_at (loc : LocalId) (ep : Nat) :
    ∀ ns : List BorrowNode,
      (rp_nodesAt loc ep ns).all (rp_nodeAt loc ep) = true
  | [] => rfl
  | n :: ns => by
    dsimp [rp_nodesAt]
    cases h : rp_nodeAt loc ep n with
    | true =>
      rw [if_bool_true rfl]
      dsimp [List.all]
      exact bool_and_intro h (rp_nodesAt_all_at loc ep ns)
    | false =>
      rw [if_bool_false rfl]
      exact rp_nodesAt_all_at loc ep ns

private theorem rp_nodesAt_of_all_at {loc : LocalId} {ep : Nat} :
    ∀ {ns : List BorrowNode},
      ns.all (rp_nodeAt loc ep) = true →
      rp_nodesAt loc ep ns = ns
  | [], _ => rfl
  | n :: ns, hAll => by
    dsimp [List.all] at hAll
    let ⟨hn, hns⟩ := bool_and_true hAll
    dsimp [rp_nodesAt]
    rw [if_bool_true hn, rp_nodesAt_of_all_at hns]

private theorem rp_nodesAt_empty_of_epoch_lt {loc : LocalId} {ep bound : Nat}
    (hBound : bound ≤ ep) :
    ∀ {ns : List BorrowNode},
      ns.all (fun n => Nat.blt n.targetEpoch bound) = true →
      rp_nodesAt loc ep ns = []
  | [], _ => rfl
  | n :: ns, hAll => by
    dsimp [List.all] at hAll
    let ⟨hn, hns⟩ := bool_and_true hAll
    have hLt : n.targetEpoch < bound := nat_blt_lt hn
    have hLtEp : n.targetEpoch < ep := Nat.lt_of_lt_of_le hLt hBound
    have hNe : n.targetEpoch ≠ ep := Nat.ne_of_lt hLtEp
    have hFalse : rp_nodeAt loc ep n = false := by
      unfold rp_nodeAt
      rw [nat_beq_false_of_ne hNe]
      cases Nat.beq n.targetLocal loc <;> rfl
    dsimp [rp_nodesAt]
    rw [if_bool_false hFalse]
    exact rp_nodesAt_empty_of_epoch_lt hBound hns

private theorem rp_hasBorrowTagAt_nodesAt (loc : LocalId) (ep t : Nat) :
    ∀ ns : List BorrowNode,
      hasBorrowTagAt loc ep t ns =
        hasBorrowTagAt loc ep t (rp_nodesAt loc ep ns)
  | [] => rfl
  | n :: ns => by
    dsimp [hasBorrowTagAt, rp_nodesAt]
    cases hAt : rp_nodeAt loc ep n with
    | true =>
      rw [if_bool_true rfl]
      dsimp [hasBorrowTagAt]
      change ((rp_nodeAt loc ep n && Nat.beq n.tag t) ||
        hasBorrowTagAt loc ep t ns) =
        ((rp_nodeAt loc ep n && Nat.beq n.tag t) ||
          hasBorrowTagAt loc ep t (rp_nodesAt loc ep ns))
      rw [rp_hasBorrowTagAt_nodesAt loc ep t ns]
    | false =>
      rw [if_bool_false rfl]
      change ((rp_nodeAt loc ep n && Nat.beq n.tag t) ||
        hasBorrowTagAt loc ep t ns) =
        hasBorrowTagAt loc ep t (rp_nodesAt loc ep ns)
      rw [hAt]
      exact rp_hasBorrowTagAt_nodesAt loc ep t ns

private theorem rp_findParentTagAt_nodesAt (loc : LocalId) (ep t : Nat) :
    ∀ ns : List BorrowNode,
      findParentTagAt? loc ep t ns =
        findParentTagAt? loc ep t (rp_nodesAt loc ep ns)
  | [] => rfl
  | n :: ns => by
    dsimp [findParentTagAt?, rp_nodesAt]
    cases hAt : rp_nodeAt loc ep n with
    | true =>
      rw [if_bool_true rfl]
      dsimp [findParentTagAt?]
      change (if rp_nodeAt loc ep n && Nat.beq n.tag t then some n.parentTag
        else findParentTagAt? loc ep t ns) =
        (if rp_nodeAt loc ep n && Nat.beq n.tag t then some n.parentTag
          else findParentTagAt? loc ep t (rp_nodesAt loc ep ns))
      rw [rp_findParentTagAt_nodesAt loc ep t ns]
    | false =>
      rw [if_bool_false rfl]
      change (if rp_nodeAt loc ep n && Nat.beq n.tag t then some n.parentTag
        else findParentTagAt? loc ep t ns) =
        findParentTagAt? loc ep t (rp_nodesAt loc ep ns)
      rw [hAt]
      dsimp
      exact rp_findParentTagAt_nodesAt loc ep t ns

private theorem rp_isAncestorTagFuel_congr {ns₁ ns₂ : List BorrowNode}
    {loc : LocalId} {ep anc : Nat}
    (hParent : ∀ t,
      findParentTagAt? loc ep t ns₁ = findParentTagAt? loc ep t ns₂) :
    ∀ (fuel cur : Nat),
      isAncestorTagFuel ns₁ loc ep anc fuel cur =
        isAncestorTagFuel ns₂ loc ep anc fuel cur
  | 0, cur => rfl
  | fuel + 1, cur => by
    dsimp [isAncestorTagFuel]
    cases Nat.beq anc cur with
    | true => rfl
    | false =>
      cases Nat.beq cur 0 with
      | true => rfl
      | false =>
        dsimp
        rw [hParent cur]
        cases findParentTagAt? loc ep cur ns₂ with
        | none => rfl
        | some pTag => exact rp_isAncestorTagFuel_congr hParent fuel pTag

/-! ### Tag Ordering & Fuel-Free Ancestry (`rp_NodesBounded`) -/

private inductive rp_NodesBounded : Nat → Nat → List BorrowNode → Prop where
  | nil {lo hi : Nat} (hLe : lo ≤ hi) : rp_NodesBounded lo hi []
  | cons {lo hi : Nat} (n : BorrowNode) (ns : List BorrowNode)
      (hLo : lo ≤ n.tag)
      (hParent : n.parentTag < n.tag)
      (hRest : rp_NodesBounded (n.tag + 1) hi ns) :
      rp_NodesBounded lo hi (n :: ns)

private theorem rp_NodesBounded_le {lo hi : Nat} {ns : List BorrowNode}
    (h : rp_NodesBounded lo hi ns) : lo ≤ hi := by
  induction h with
  | nil hLe => exact hLe
  | cons n _ hLo _ _ ih =>
    exact Nat.le_trans hLo (Nat.le_trans (Nat.le_succ n.tag) ih)

private theorem rp_NodesBounded_mono_lo {lo' lo hi : Nat} {ns : List BorrowNode}
    (hLo' : lo' ≤ lo) (h : rp_NodesBounded lo hi ns) :
    rp_NodesBounded lo' hi ns := by
  cases h with
  | nil hLe => exact .nil (Nat.le_trans hLo' hLe)
  | cons n rest hLo hP hRest =>
    exact .cons n rest (Nat.le_trans hLo' hLo) hP hRest

private theorem rp_NodesBounded_mono_hi {lo hi hi' : Nat} {ns : List BorrowNode}
    (hHi' : hi ≤ hi') (h : rp_NodesBounded lo hi ns) :
    rp_NodesBounded lo hi' ns := by
  induction h with
  | nil hLe => exact .nil (Nat.le_trans hLe hHi')
  | cons n rest hLo hP _ ih =>
    exact .cons n rest hLo hP (ih hHi')

private theorem rp_NodesBounded_append_one {lo hi : Nat} {ns : List BorrowNode}
    (n : BorrowNode)
    (hNs : rp_NodesBounded lo hi ns)
    (hHi : hi ≤ n.tag)
    (hP : n.parentTag < n.tag) :
    rp_NodesBounded lo (n.tag + 1) (ns ++ [n]) := by
  induction hNs with
  | nil hLe =>
    exact .cons n [] (Nat.le_trans hLe hHi) hP (.nil (Nat.le_refl _))
  | cons m rest hLo hPm _ ih =>
    exact .cons m (rest ++ [n]) hLo hPm (ih hHi)

private theorem rp_NodesBounded_nodesAt (loc : LocalId) (ep : Nat)
    {lo hi : Nat} {ns : List BorrowNode}
    (h : rp_NodesBounded lo hi ns) :
    rp_NodesBounded lo hi (rp_nodesAt loc ep ns) := by
  induction h with
  | nil hLe => exact .nil hLe
  | cons n rest hLo hP _ ih =>
    dsimp [rp_nodesAt]
    cases rp_nodeAt loc ep n with
    | true =>
      rw [if_bool_true rfl]
      exact .cons n _ hLo hP ih
    | false =>
      rw [if_bool_false rfl]
      exact rp_NodesBounded_mono_lo
        (Nat.le_trans hLo (Nat.le_succ n.tag)) ih

private theorem rp_hasBorrowTagAt_false_of_lt {loc : LocalId} {ep t lo hi : Nat}
    {ns : List BorrowNode}
    (hB : rp_NodesBounded lo hi ns) (hLt : t < lo) :
    hasBorrowTagAt loc ep t ns = false := by
  induction hB with
  | nil _ => rfl
  | cons n rest hLo _ _ ih =>
    dsimp [hasBorrowTagAt]
    have hLtTag : t < n.tag := Nat.lt_of_lt_of_le hLt hLo
    have hNe : n.tag ≠ t := Nat.ne_of_gt hLtTag
    rw [nat_beq_false_of_ne hNe]
    have hLeft :
        (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep && false) =
          false := by
      cases Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep <;> rfl
    rw [hLeft]
    exact ih (Nat.lt_of_lt_of_le hLtTag (Nat.le_succ n.tag))

private theorem rp_findParentTagAt_none_of_lt {loc : LocalId} {ep t lo hi : Nat}
    {ns : List BorrowNode}
    (hB : rp_NodesBounded lo hi ns) (hLt : t < lo) :
    findParentTagAt? loc ep t ns = none := by
  induction hB with
  | nil _ => rfl
  | cons n rest hLo _ _ ih =>
    dsimp [findParentTagAt?]
    have hLtTag : t < n.tag := Nat.lt_of_lt_of_le hLt hLo
    have hNe : n.tag ≠ t := Nat.ne_of_gt hLtTag
    rw [nat_beq_false_of_ne hNe]
    have hLeft :
        (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep && false) =
          false := by
      cases Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep <;> rfl
    rw [hLeft]
    exact ih (Nat.lt_of_lt_of_le hLtTag (Nat.le_succ n.tag))

private theorem rp_findParentTagAt_bounds {loc : LocalId} {ep t pTag lo hi : Nat}
    {ns : List BorrowNode}
    (hB : rp_NodesBounded lo hi ns)
    (hF : findParentTagAt? loc ep t ns = some pTag) :
    pTag < t ∧ lo ≤ t ∧ t < hi := by
  induction hB with
  | nil _ => cases hF
  | cons n rest hLo hP hRest ih =>
    dsimp [findParentTagAt?] at hF
    cases hCond :
        Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep &&
          Nat.beq n.tag t with
    | true =>
      rw [if_bool_true hCond] at hF
      injection hF with hEq
      subst hEq
      let ⟨_, hTagEq⟩ := bool_and_true hCond
      have ht : n.tag = t := nat_beq_eq hTagEq
      subst ht
      exact ⟨hP, hLo, rp_NodesBounded_le hRest⟩
    | false =>
      rw [if_bool_false hCond] at hF
      let ⟨hPt, hLo2, hHi2⟩ := ih hF
      exact ⟨hPt,
        Nat.le_trans hLo (Nat.le_trans (Nat.le_succ n.tag) hLo2), hHi2⟩

private noncomputable def rp_countLe (bound : Nat) : List BorrowNode → Nat
  | [] => 0
  | n :: ns =>
    if Nat.ble n.tag bound then
      rp_countLe bound ns + 1
    else
      rp_countLe bound ns

private theorem rp_countLe_le_length (bound : Nat) :
    ∀ ns : List BorrowNode, rp_countLe bound ns ≤ ns.length
  | [] => Nat.le_refl 0
  | n :: ns => by
    dsimp [rp_countLe, List.length]
    cases Nat.ble n.tag bound with
    | true =>
      exact Nat.succ_le_succ (rp_countLe_le_length bound ns)
    | false =>
      exact Nat.le_trans (rp_countLe_le_length bound ns)
        (Nat.le_succ ns.length)

private theorem rp_countLe_mono {a b : Nat} (hLe : a ≤ b) :
    ∀ ns : List BorrowNode, rp_countLe a ns ≤ rp_countLe b ns
  | [] => Nat.le_refl 0
  | n :: ns => by
    dsimp [rp_countLe]
    have ih := rp_countLe_mono hLe ns
    cases hA : Nat.ble n.tag a with
    | true =>
      have hB : Nat.ble n.tag b = true :=
        nat_le_ble (Nat.le_trans (nat_ble_le hA) hLe)
      rw [if_bool_true rfl, if_bool_true hB]
      exact Nat.succ_le_succ ih
    | false =>
      rw [if_bool_false rfl]
      cases Nat.ble n.tag b with
      | true => exact Nat.le_trans ih (Nat.le_succ _)
      | false => exact ih

private theorem rp_countLe_step {loc : LocalId} {ep cur pTag lo hi : Nat}
    {ns : List BorrowNode}
    (hB : rp_NodesBounded lo hi ns)
    (hF : findParentTagAt? loc ep cur ns = some pTag) :
    rp_countLe pTag ns + 1 ≤ rp_countLe cur ns := by
  induction hB with
  | nil _ => cases hF
  | cons n rest _ hP hRest ih =>
    dsimp [findParentTagAt?] at hF
    dsimp [rp_countLe]
    cases hCond :
        Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep &&
          Nat.beq n.tag cur with
    | true =>
      rw [if_bool_true hCond] at hF
      injection hF with hEq
      subst hEq
      let ⟨_, hTagEq⟩ := bool_and_true hCond
      have hTag : n.tag = cur := nat_beq_eq hTagEq
      subst hTag
      rw [if_bool_false (nat_gt_ble_false hP),
          if_bool_true (nat_le_ble (Nat.le_refl _))]
      exact Nat.succ_le_succ (rp_countLe_mono (Nat.le_of_lt hP) rest)
    | false =>
      rw [if_bool_false hCond] at hF
      have ihStep := ih hF
      cases h1 : Nat.ble n.tag pTag with
      | true =>
        have ⟨hPtLt, _, _⟩ := rp_findParentTagAt_bounds hRest hF
        have h2 : Nat.ble n.tag cur = true :=
          nat_le_ble (Nat.le_trans (nat_ble_le h1) (Nat.le_of_lt hPtLt))
        rw [if_bool_true rfl, if_bool_true h2]
        exact Nat.succ_le_succ ihStep
      | false =>
        rw [if_bool_false rfl]
        cases Nat.ble n.tag cur with
        | true => exact Nat.le_trans ihStep (Nat.le_succ _)
        | false => exact ihStep

private theorem rp_isAncestorTagFuel_ge_zero {ns : List BorrowNode}
    {loc : LocalId} {ep anc cur lo hi : Nat}
    (hB : rp_NodesBounded lo hi ns)
    (hZero : rp_countLe cur ns ≤ 0) (f : Nat) :
    isAncestorTagFuel ns loc ep anc f cur = Nat.beq anc cur := by
  cases f with
  | zero => rfl
  | succ f' =>
    dsimp [isAncestorTagFuel]
    cases hEq : Nat.beq anc cur with
    | true => rfl
    | false =>
      cases Nat.beq cur 0 with
      | true => rfl
      | false =>
        dsimp
        cases hF : findParentTagAt? loc ep cur ns with
        | none => rfl
        | some pTag =>
          have hStep := rp_countLe_step hB hF
          have hAbs : rp_countLe pTag ns + 1 ≤ 0 :=
            Nat.le_trans hStep hZero
          cases hAbs

private theorem rp_isAncestorTagFuel_indep_aux {ns : List BorrowNode}
    {loc : LocalId} {ep anc lo hi : Nat}
    (hB : rp_NodesBounded lo hi ns) :
    ∀ (k cur f₁ f₂ : Nat),
      rp_countLe cur ns ≤ k →
      k ≤ f₁ →
      k ≤ f₂ →
      isAncestorTagFuel ns loc ep anc f₁ cur =
        isAncestorTagFuel ns loc ep anc f₂ cur
  | 0, cur, f₁, f₂, hCnt, _, _ => by
    rw [rp_isAncestorTagFuel_ge_zero hB hCnt f₁,
        rp_isAncestorTagFuel_ge_zero hB hCnt f₂]
  | k + 1, cur, f₁, f₂, hCnt, hf₁, hf₂ => by
    cases f₁ with
    | zero => cases hf₁
    | succ f₁' =>
      cases f₂ with
      | zero => cases hf₂
      | succ f₂' =>
        dsimp [isAncestorTagFuel]
        cases Nat.beq anc cur with
        | true => rfl
        | false =>
          cases Nat.beq cur 0 with
          | true => rfl
          | false =>
            dsimp
            cases hF : findParentTagAt? loc ep cur ns with
            | none => rfl
            | some pTag =>
              have hStep := rp_countLe_step hB hF
              have hCntP : rp_countLe pTag ns ≤ k :=
                Nat.le_of_succ_le_succ (Nat.le_trans hStep hCnt)
              exact rp_isAncestorTagFuel_indep_aux hB k pTag f₁' f₂'
                hCntP (Nat.le_of_succ_le_succ hf₁)
                (Nat.le_of_succ_le_succ hf₂)

private theorem rp_isAncestorTag_unfold {ns : List BorrowNode}
    {loc : LocalId} {ep anc cur lo hi : Nat}
    (hB : rp_NodesBounded lo hi ns) :
    isAncestorTag ns loc ep anc cur =
      (if Nat.beq anc cur then
        true
      else if Nat.beq cur 0 then
        false
      else
        match findParentTagAt? loc ep cur ns with
        | none => false
        | some pTag => isAncestorTag ns loc ep anc pTag) := by
  have hCnt : rp_countLe cur ns ≤ ns.length := rp_countLe_le_length cur ns
  have hEq :=
    rp_isAncestorTagFuel_indep_aux (loc := loc) (ep := ep) (anc := anc)
      hB (rp_countLe cur ns) cur ns.length (ns.length + 1)
      (Nat.le_refl _) hCnt (Nat.le_trans hCnt (Nat.le_succ _))
  unfold isAncestorTag
  rw [hEq]
  rfl

private theorem rp_isAncestorTag_refl {ns : List BorrowNode}
    {loc : LocalId} {ep t : Nat} :
    isAncestorTag ns loc ep t t = true := by
  unfold isAncestorTag
  cases ns.length with
  | zero => exact nat_beq_refl t
  | succ k =>
    dsimp [isAncestorTagFuel]
    rw [if_bool_true (nat_beq_refl t)]

private theorem rp_isAncestorTag_nodesAt {ns : List BorrowNode}
    {loc : LocalId} {ep anc cur lo hi : Nat}
    (hB : rp_NodesBounded lo hi ns) :
    isAncestorTag ns loc ep anc cur =
      isAncestorTag (rp_nodesAt loc ep ns) loc ep anc cur := by
  let nsLoc := rp_nodesAt loc ep ns
  have hBLoc : rp_NodesBounded lo hi nsLoc :=
    rp_NodesBounded_nodesAt loc ep hB
  have hCongr :=
    rp_isAncestorTagFuel_congr
      (ns₁ := ns) (ns₂ := nsLoc) (loc := loc) (ep := ep) (anc := anc)
      (fun t => rp_findParentTagAt_nodesAt loc ep t ns)
      ns.length cur
  unfold isAncestorTag
  rw [hCongr]
  have hCnt : rp_countLe cur nsLoc ≤ nsLoc.length :=
    rp_countLe_le_length cur nsLoc
  have hLenLe : nsLoc.length ≤ ns.length := by
    have hAux : ∀ xs : List BorrowNode,
        (rp_nodesAt loc ep xs).length ≤ xs.length := by
      intro xs
      induction xs with
      | nil => exact Nat.le_refl 0
      | cons m ms ih =>
        dsimp [rp_nodesAt, List.length]
        cases rp_nodeAt loc ep m with
        | true => exact Nat.succ_le_succ ih
        | false => exact Nat.le_trans ih (Nat.le_succ _)
    exact hAux ns
  exact rp_isAncestorTagFuel_indep_aux hBLoc (rp_countLe cur nsLoc) cur
    ns.length nsLoc.length (Nat.le_refl _)
    (Nat.le_trans hCnt hLenLe) hCnt

/-! ### Localization of `tbForeignAccessAt` and `performTbAccess` -/

private theorem rp_tbForeignAccessAt_bounded {loc : LocalId} {ep lo hi : Nat}
    {kind : TbAccessKind} {ns : List BorrowNode}
    (hB : rp_NodesBounded lo hi ns) :
    rp_NodesBounded lo hi (tbForeignAccessAt loc ep kind ns) := by
  induction hB with
  | nil hLe => exact .nil hLe
  | cons n rest hLo hP _ ih =>
    dsimp [tbForeignAccessAt]
    cases Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep with
    | true => exact .cons _ _ hLo hP ih
    | false => exact .cons _ _ hLo hP ih

private theorem rp_tbForeignAccessAt_epoch_lt {loc : LocalId} {ep bound : Nat}
    {kind : TbAccessKind} :
    ∀ {ns : List BorrowNode},
      ns.all (fun n => Nat.blt n.targetEpoch bound) = true →
      (tbForeignAccessAt loc ep kind ns).all
        (fun n => Nat.blt n.targetEpoch bound) = true
  | [], _ => rfl
  | n :: ns, hAll => by
    dsimp [List.all] at hAll
    let ⟨hn, hns⟩ := bool_and_true hAll
    dsimp [tbForeignAccessAt, List.all]
    cases Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep with
    | true =>
      exact bool_and_intro hn (rp_tbForeignAccessAt_epoch_lt hns)
    | false =>
      exact bool_and_intro hn (rp_tbForeignAccessAt_epoch_lt hns)

private theorem rp_nodesAt_tbForeignAccessAt_same (loc : LocalId) (ep : Nat)
    (kind : TbAccessKind) :
    ∀ ns : List BorrowNode,
      rp_nodesAt loc ep (tbForeignAccessAt loc ep kind ns) =
        tbForeignAccessAt loc ep kind (rp_nodesAt loc ep ns)
  | [] => rfl
  | n :: ns => by
    dsimp [tbForeignAccessAt, rp_nodesAt]
    cases hAt : rp_nodeAt loc ep n with
    | true =>
      have hAtRaw :
          (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = true := hAt
      have hAtUpd :
          rp_nodeAt loc ep { n with perm := tbForeignStep kind n.perm } =
            true := hAt
      rw [if_bool_true hAtRaw, if_bool_true rfl]
      dsimp [rp_nodesAt, tbForeignAccessAt]
      rw [if_bool_true hAtUpd, if_bool_true hAtRaw]
      rw [rp_nodesAt_tbForeignAccessAt_same loc ep kind ns]
    | false =>
      have hAtRaw :
          (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = false := hAt
      rw [if_bool_false hAtRaw, if_bool_false rfl]
      rw [if_bool_false hAt]
      exact rp_nodesAt_tbForeignAccessAt_same loc ep kind ns

private theorem rp_nodesAt_tbForeignAccessAt_other {loc loc' : LocalId}
    {ep ep' : Nat} (hNe : loc' ≠ loc ∨ ep' ≠ ep) (kind : TbAccessKind) :
    ∀ ns : List BorrowNode,
      rp_nodesAt loc' ep' (tbForeignAccessAt loc ep kind ns) =
        rp_nodesAt loc' ep' ns
  | [] => rfl
  | n :: ns => by
    dsimp [tbForeignAccessAt, rp_nodesAt]
    cases hAt : rp_nodeAt loc ep n with
    | true =>
      have hOther : rp_nodeAt loc' ep' n = false :=
        rp_nodeAt_false_of_ne hAt hNe
      change (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = true
        at hAt
      rw [if_bool_true hAt]
      have hOther' :
          rp_nodeAt loc' ep'
            { n with perm := tbForeignStep kind n.perm } = false := hOther
      rw [if_bool_false hOther', if_bool_false hOther]
      exact rp_nodesAt_tbForeignAccessAt_other hNe kind ns
    | false =>
      change (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = false
        at hAt
      rw [if_bool_false hAt]
      cases rp_nodeAt loc' ep' n with
      | true =>
        rw [if_bool_true rfl, if_bool_true rfl]
        rw [rp_nodesAt_tbForeignAccessAt_other hNe kind ns]
      | false =>
        rw [if_bool_false rfl, if_bool_false rfl]
        exact rp_nodesAt_tbForeignAccessAt_other hNe kind ns

private theorem rp_tbDerivedAccessLoop_local {origNodes : List BorrowNode}
    {loc : LocalId} {ep hi : Nat} {kind : TbAccessKind} {accessTag : Nat}
    (hBOrig : rp_NodesBounded 1 hi origNodes) :
    ∀ (lo : Nat) (curNodes : List BorrowNode),
      rp_NodesBounded lo hi curNodes →
      match tbDerivedAccessLoop origNodes loc ep kind accessTag curNodes,
          tbDerivedAccessLoop (rp_nodesAt loc ep origNodes) loc ep kind
            accessTag (rp_nodesAt loc ep curNodes) with
      | .error k₁, .error k₂ => k₁ = k₂
      | .ok curNodes', .ok localNodes' =>
        rp_NodesBounded lo hi curNodes' ∧
        rp_nodesAt loc ep curNodes' = localNodes' ∧
        (∀ loc' ep', (loc' ≠ loc ∨ ep' ≠ ep) →
          rp_nodesAt loc' ep' curNodes' = rp_nodesAt loc' ep' curNodes) ∧
        (∀ bound,
          curNodes.all (fun n => Nat.blt n.targetEpoch bound) = true →
          curNodes'.all (fun n => Nat.blt n.targetEpoch bound) = true)
      | _, _ => False
  | lo, [], .nil hLe => by
    dsimp [rp_nodesAt, tbDerivedAccessLoop]
    exact ⟨.nil hLe, rfl, fun _ _ _ => rfl, fun _ h => h⟩
  | lo, n :: ns, .cons _ _ hLo hP hRest => by
    dsimp [rp_nodesAt, tbDerivedAccessLoop]
    have ih :=
      rp_tbDerivedAccessLoop_local (loc := loc) (ep := ep) (kind := kind)
        (accessTag := accessTag) hBOrig (n.tag + 1) ns hRest
    cases hAt : rp_nodeAt loc ep n with
    | false =>
      have hAtF : rp_nodeAt loc ep n = false := hAt
      change (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = false
        at hAt
      rw [hAt, if_bool_false rfl]
      dsimp
      cases hRec1 :
          tbDerivedAccessLoop origNodes loc ep kind accessTag ns with
      | error k1 =>
        rw [hRec1] at ih
        cases hRec2 :
            tbDerivedAccessLoop (rp_nodesAt loc ep origNodes) loc ep kind
              accessTag (rp_nodesAt loc ep ns) with
        | error k2 => rw [hRec2] at ih; exact ih
        | ok _ => rw [hRec2] at ih; exact ih
      | ok ns' =>
        rw [hRec1] at ih
        cases hRec2 :
            tbDerivedAccessLoop (rp_nodesAt loc ep origNodes) loc ep kind
              accessTag (rp_nodesAt loc ep ns) with
        | error _ => rw [hRec2] at ih; exact ih
        | ok lns' =>
          rw [hRec2] at ih
          let ⟨hBNs', hLocEq, hOtherEq, hEpLt⟩ := ih
          refine ⟨.cons n ns' hLo hP hBNs', ?_, ?_, ?_⟩
          · dsimp [rp_nodesAt]
            rw [if_bool_false hAtF]
            exact hLocEq
          · intro loc' ep' hNe
            dsimp [rp_nodesAt]
            cases rp_nodeAt loc' ep' n with
            | true =>
              rw [if_bool_true rfl, if_bool_true rfl,
                  hOtherEq loc' ep' hNe]
            | false =>
              rw [if_bool_false rfl, if_bool_false rfl,
                  hOtherEq loc' ep' hNe]
          · intro bound hAll
            let ⟨hn, hns⟩ := bool_and_true hAll
            exact bool_and_intro hn (hEpLt bound hns)
    | true =>
      have hAtT : rp_nodeAt loc ep n = true := hAt
      change (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = true
        at hAt
      rw [if_bool_true rfl]
      dsimp [tbDerivedAccessLoop]
      rw [hAt]
      dsimp
      rw [rp_isAncestorTag_nodesAt hBOrig]
      cases isAncestorTag (rp_nodesAt loc ep origNodes) loc ep n.tag
          accessTag with
      | true =>
        dsimp
        cases tbChildStep kind n.perm with
        | none => rfl
        | some perm' =>
          dsimp
          cases hRec1 :
              tbDerivedAccessLoop origNodes loc ep kind accessTag ns with
          | error k1 =>
            rw [hRec1] at ih
            cases hRec2 :
                tbDerivedAccessLoop (rp_nodesAt loc ep origNodes) loc ep
                  kind accessTag (rp_nodesAt loc ep ns) with
            | error k2 => rw [hRec2] at ih; exact ih
            | ok _ => rw [hRec2] at ih; exact ih
          | ok ns' =>
            rw [hRec1] at ih
            cases hRec2 :
                tbDerivedAccessLoop (rp_nodesAt loc ep origNodes) loc ep
                  kind accessTag (rp_nodesAt loc ep ns) with
            | error _ => rw [hRec2] at ih; exact ih
            | ok lns' =>
              rw [hRec2] at ih
              let ⟨hBNs', hLocEq, hOtherEq, hEpLt⟩ := ih
              refine ⟨.cons _ ns' hLo hP hBNs', ?_, ?_, ?_⟩
              · dsimp [rp_nodesAt]
                have hAtT' :
                    rp_nodeAt loc ep { n with perm := perm' } = true := hAtT
                rw [if_bool_true hAtT', hLocEq]
              · intro loc' ep' hNe
                have hOther : rp_nodeAt loc' ep' n = false :=
                  rp_nodeAt_false_of_ne hAtT hNe
                have hOther' :
                    rp_nodeAt loc' ep' { n with perm := perm' } = false :=
                  hOther
                dsimp [rp_nodesAt]
                rw [if_bool_false hOther', if_bool_false hOther,
                    hOtherEq loc' ep' hNe]
              · intro bound hAll
                let ⟨hn, hns⟩ := bool_and_true hAll
                exact bool_and_intro hn (hEpLt bound hns)
      | false =>
        dsimp
        cases hRec1 :
            tbDerivedAccessLoop origNodes loc ep kind accessTag ns with
        | error k1 =>
          rw [hRec1] at ih
          cases hRec2 :
              tbDerivedAccessLoop (rp_nodesAt loc ep origNodes) loc ep kind
                accessTag (rp_nodesAt loc ep ns) with
          | error k2 => rw [hRec2] at ih; exact ih
          | ok _ => rw [hRec2] at ih; exact ih
        | ok ns' =>
          rw [hRec1] at ih
          cases hRec2 :
              tbDerivedAccessLoop (rp_nodesAt loc ep origNodes) loc ep kind
                accessTag (rp_nodesAt loc ep ns) with
          | error _ => rw [hRec2] at ih; exact ih
          | ok lns' =>
            rw [hRec2] at ih
            let ⟨hBNs', hLocEq, hOtherEq, hEpLt⟩ := ih
            refine ⟨.cons _ ns' hLo hP hBNs', ?_, ?_, ?_⟩
            · dsimp [rp_nodesAt]
              have hAtT' :
                  rp_nodeAt loc ep
                    { n with perm := tbForeignStep kind n.perm } = true :=
                hAtT
              rw [if_bool_true hAtT', hLocEq]
            · intro loc' ep' hNe
              have hOther : rp_nodeAt loc' ep' n = false :=
                rp_nodeAt_false_of_ne hAtT hNe
              have hOther' :
                  rp_nodeAt loc' ep'
                    { n with perm := tbForeignStep kind n.perm } = false :=
                hOther
              dsimp [rp_nodesAt]
              rw [if_bool_false hOther', if_bool_false hOther,
                  hOtherEq loc' ep' hNe]
            · intro bound hAll
              let ⟨hn, hns⟩ := bool_and_true hAll
              exact bool_and_intro hn (hEpLt bound hns)

private theorem rp_performTbAccess_local {nodes : List BorrowNode}
    {loc : LocalId} {ep hi : Nat} {ty : MirTy} {kind : TbAccessKind}
    {accessTag : Nat}
    (hB : rp_NodesBounded 1 hi nodes) :
    match performTbAccess loc ep ty kind accessTag nodes,
        performTbAccess loc ep ty kind accessTag (rp_nodesAt loc ep nodes) with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok nodes', .ok localNodes' =>
      rp_NodesBounded 1 hi nodes' ∧
      rp_nodesAt loc ep nodes' = localNodes' ∧
      (∀ loc' ep', (loc' ≠ loc ∨ ep' ≠ ep) →
        rp_nodesAt loc' ep' nodes' = rp_nodesAt loc' ep' nodes) ∧
      (∀ bound,
        nodes.all (fun n => Nat.blt n.targetEpoch bound) = true →
        nodes'.all (fun n => Nat.blt n.targetEpoch bound) = true)
    | _, _ => False := by
  unfold performTbAccess
  cases isZeroSizedTy ty with
  | true =>
    dsimp
    exact ⟨hB, rfl, fun _ _ _ => rfl, fun _ h => h⟩
  | false =>
    dsimp
    cases Nat.beq accessTag 0 with
    | true =>
      dsimp
      exact ⟨rp_tbForeignAccessAt_bounded hB,
        rp_nodesAt_tbForeignAccessAt_same loc ep kind nodes,
        fun _ _ hNe => rp_nodesAt_tbForeignAccessAt_other hNe kind nodes,
        fun _ hAll => rp_tbForeignAccessAt_epoch_lt hAll⟩
    | false =>
      dsimp
      rw [rp_hasBorrowTagAt_nodesAt loc ep accessTag nodes]
      cases !hasBorrowTagAt loc ep accessTag (rp_nodesAt loc ep nodes) with
      | true => rfl
      | false =>
        dsimp
        exact rp_tbDerivedAccessLoop_local hB 1 nodes hB

/-! ### Tag-Pair Correspondence & Tree Isomorphism (`rp_ExactNodeRel`) -/

private noncomputable def rp_hasPair : List (Nat × Nat) → Nat → Nat → Bool
  | [], _, _ => false
  | (a, b) :: ps, tS, tT =>
    (Nat.beq a tS && Nat.beq b tT) || rp_hasPair ps tS tT

private noncomputable def rp_hasFst : List (Nat × Nat) → Nat → Bool
  | [], _ => false
  | (a, _) :: ps, tS => Nat.beq a tS || rp_hasFst ps tS

private noncomputable def rp_parentPairOk (pairs : List (Nat × Nat))
    (pS pT : Nat) : Bool :=
  (Nat.beq pS 0 && Nat.beq pT 0) || rp_hasPair pairs pS pT

private noncomputable def rp_tagPairValid (pairs : List (Nat × Nat))
    (tS tT : Nat) : Prop :=
  (tS = 0 ∧ tT = 0) ∨ (1 ≤ tS ∧ 1 ≤ tT ∧ rp_hasPair pairs tS tT = true)

private theorem rp_hasPair_append (xs ys : List (Nat × Nat)) (tS tT : Nat) :
    rp_hasPair (xs ++ ys) tS tT =
      (rp_hasPair xs tS tT || rp_hasPair ys tS tT) := by
  induction xs with
  | nil => rfl
  | cons p ps ih =>
    cases p with
    | mk a b =>
      dsimp [rp_hasPair]
      rw [ih]
      cases Nat.beq a tS && Nat.beq b tT <;> rfl

private theorem rp_hasPair_hasFst {ps : List (Nat × Nat)} {tS tT : Nat}
    (h : rp_hasPair ps tS tT = true) :
    rp_hasFst ps tS = true := by
  induction ps with
  | nil => cases h
  | cons p rest ih =>
    cases p with
    | mk a b =>
      dsimp [rp_hasPair] at h
      dsimp [rp_hasFst]
      cases bool_or_true h with
      | inl hHead =>
        let ⟨ha, _⟩ := bool_and_true hHead
        exact bool_or_intro_left _ ha
      | inr hTail =>
        exact bool_or_intro_right _ (ih hTail)

private theorem rp_hasFst_append (xs ys : List (Nat × Nat)) (tS : Nat) :
    rp_hasFst (xs ++ ys) tS = (rp_hasFst xs tS || rp_hasFst ys tS) := by
  induction xs with
  | nil => rfl
  | cons p ps ih =>
    cases p with
    | mk a _ =>
      dsimp [rp_hasFst]
      rw [ih]
      cases Nat.beq a tS <;> rfl

private theorem rp_parentPairOk_mono {xs ys : List (Nat × Nat)} {pS pT : Nat}
    (h : rp_parentPairOk xs pS pT = true) :
    rp_parentPairOk (xs ++ ys) pS pT = true := by
  unfold rp_parentPairOk at h
  unfold rp_parentPairOk
  rw [rp_hasPair_append]
  cases bool_or_true h with
  | inl h0 => exact bool_or_intro_left _ h0
  | inr hp => exact bool_or_intro_right _ (bool_or_intro_left _ hp)

private theorem rp_tagPairValid_mono {xs : List (Nat × Nat)} (ys : List (Nat × Nat))
    {tS tT : Nat} (h : rp_tagPairValid xs tS tT) :
    rp_tagPairValid (xs ++ ys) tS tT := by
  cases h with
  | inl h0 => exact Or.inl h0
  | inr h1 =>
    let ⟨hge1, hge2, hp⟩ := h1
    unfold rp_tagPairValid
    rw [rp_hasPair_append]
    exact Or.inr ⟨hge1, hge2, bool_or_intro_left _ hp⟩

private inductive rp_ExactNodeRel (loc : LocalId) (ep : Nat) :
    List (Nat × Nat) → List (Nat × Nat) →
    List BorrowNode → List BorrowNode → Prop where
  | nil (prior : List (Nat × Nat)) :
      rp_ExactNodeRel loc ep prior [] [] []
  | cons (prior : List (Nat × Nat)) (nS nT : BorrowNode)
      (ps : List (Nat × Nat)) (nsS nsT : List BorrowNode)
      (hAtS : rp_nodeAt loc ep nS = true)
      (hAtT : rp_nodeAt loc ep nT = true)
      (hPerm : nS.perm = nT.perm)
      (hNotRoot : nS.perm ≠ .rootOrRaw)
      (hParent : rp_parentPairOk prior nS.parentTag nT.parentTag = true)
      (hRest : rp_ExactNodeRel loc ep (prior ++ [(nS.tag, nT.tag)])
        ps nsS nsT) :
      rp_ExactNodeRel loc ep prior ((nS.tag, nT.tag) :: ps)
        (nS :: nsS) (nT :: nsT)

private theorem rp_tbForeignStep_ne_root {kind : TbAccessKind} {perm : BorrowPerm}
    (h : perm ≠ .rootOrRaw) :
    tbForeignStep kind perm ≠ .rootOrRaw := by
  cases perm with
  | rootOrRaw => exact False.elim (h rfl)
  | reservedFrz | unique | frozen | disabled =>
    cases kind <;> intro hEq <;> cases hEq

private theorem rp_tbChildStep_ne_root {kind : TbAccessKind} {perm perm' : BorrowPerm}
    (h : perm ≠ .rootOrRaw) (hStep : tbChildStep kind perm = some perm') :
    perm' ≠ .rootOrRaw := by
  cases perm with
  | rootOrRaw => exact False.elim (h rfl)
  | reservedFrz | unique | frozen | disabled =>
    cases kind <;> dsimp [tbChildStep] at hStep <;>
      cases hStep <;> intro hEq <;> cases hEq

private theorem rp_ExactNodeRel_tbForeign {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (kind : TbAccessKind)
    (hRel : rp_ExactNodeRel loc ep prior ps nsS nsT) :
    rp_ExactNodeRel loc ep prior ps
      (tbForeignAccessAt loc ep kind nsS)
      (tbForeignAccessAt loc ep kind nsT) := by
  induction hRel with
  | nil pr => exact .nil pr
  | cons pr nS nT ps' restS restT hAtS hAtT hPerm hNR hPar _ ih =>
    dsimp [tbForeignAccessAt]
    have hAtS' :
        (Nat.beq nS.targetLocal loc && Nat.beq nS.targetEpoch ep) = true :=
      hAtS
    have hAtT' :
        (Nat.beq nT.targetLocal loc && Nat.beq nT.targetEpoch ep) = true :=
      hAtT
    rw [if_bool_true hAtS', if_bool_true hAtT']
    exact .cons pr { nS with perm := tbForeignStep kind nS.perm }
      { nT with perm := tbForeignStep kind nT.perm } ps' _ _ hAtS hAtT
      (by dsimp; rw [hPerm]) (rp_tbForeignStep_ne_root hNR) hPar ih

private theorem rp_ExactNodeRel_append_one {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (nS nT : BorrowNode)
    (hRel : rp_ExactNodeRel loc ep prior ps nsS nsT)
    (hAtS : rp_nodeAt loc ep nS = true)
    (hAtT : rp_nodeAt loc ep nT = true)
    (hPerm : nS.perm = nT.perm)
    (hNR : nS.perm ≠ .rootOrRaw)
    (hPar : rp_parentPairOk (prior ++ ps) nS.parentTag nT.parentTag = true) :
    rp_ExactNodeRel loc ep prior (ps ++ [(nS.tag, nT.tag)])
      (nsS ++ [nS]) (nsT ++ [nT]) := by
  induction hRel with
  | nil pr =>
    have hPar' : rp_parentPairOk pr nS.parentTag nT.parentTag = true := by
      rw [List.append_nil] at hPar
      exact hPar
    exact .cons pr nS nT [] [] [] hAtS hAtT hPerm hNR hPar'
      (.nil (pr ++ [(nS.tag, nT.tag)]))
  | cons pr mS mT ps' restS restT hmAtS hmAtT hmPerm hmNR hmPar _ ih =>
    have hAssoc :
        (pr ++ [(mS.tag, mT.tag)]) ++ ps' =
          pr ++ ((mS.tag, mT.tag) :: ps') := by
      rw [List.append_assoc]
      rfl
    have hPar' :
        rp_parentPairOk ((pr ++ [(mS.tag, mT.tag)]) ++ ps')
          nS.parentTag nT.parentTag = true := by
      rw [hAssoc]
      exact hPar
    exact .cons pr mS mT (ps' ++ [(nS.tag, nT.tag)])
      (restS ++ [nS]) (restT ++ [nT])
      hmAtS hmAtT hmPerm hmNR hmPar (ih hPar')

private theorem rp_ExactNodeRel_hasTag {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {tS tT : Nat}
    (hRel : rp_ExactNodeRel loc ep prior ps nsS nsT)
    (hPair : rp_hasPair ps tS tT = true) :
    hasBorrowTagAt loc ep tS nsS = true ∧
      hasBorrowTagAt loc ep tT nsT = true := by
  induction hRel with
  | nil _ => cases hPair
  | cons _ nS nT ps' restS restT hAtS hAtT _ _ _ _ ih =>
    dsimp [rp_hasPair] at hPair
    dsimp [hasBorrowTagAt]
    change ((rp_nodeAt loc ep nS && Nat.beq nS.tag tS) ||
      hasBorrowTagAt loc ep tS restS) = true ∧
      ((rp_nodeAt loc ep nT && Nat.beq nT.tag tT) ||
        hasBorrowTagAt loc ep tT restT) = true
    cases bool_or_true hPair with
    | inl hHead =>
      let ⟨hEqS, hEqT⟩ := bool_and_true hHead
      exact ⟨bool_or_intro_left _ (bool_and_intro hAtS hEqS),
             bool_or_intro_left _ (bool_and_intro hAtT hEqT)⟩
    | inr hTail =>
      let ⟨ihS, ihT⟩ := ih hTail
      exact ⟨bool_or_intro_right _ ihS, bool_or_intro_right _ ihT⟩

private theorem rp_ExactNodeRel_findParent {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {loS hiS loT hiT tS tT : Nat}
    (hRel : rp_ExactNodeRel loc ep prior ps nsS nsT)
    (hBS : rp_NodesBounded loS hiS nsS)
    (hBT : rp_NodesBounded loT hiT nsT)
    (hPair : rp_hasPair ps tS tT = true) :
    ∃ pS pT,
      findParentTagAt? loc ep tS nsS = some pS ∧
      findParentTagAt? loc ep tT nsT = some pT ∧
      rp_parentPairOk (prior ++ ps) pS pT = true := by
  induction hRel generalizing loS loT with
  | nil _ => cases hPair
  | cons pr nS nT ps' restS restT hAtS hAtT _ _ hPar _ ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest =>
      cases hBT with
      | cons _ _ _ _ hBTRest =>
        dsimp [rp_hasPair] at hPair
        dsimp [findParentTagAt?]
        change ∃ pS pT,
          (if rp_nodeAt loc ep nS && Nat.beq nS.tag tS then some nS.parentTag
            else findParentTagAt? loc ep tS restS) = some pS ∧
          (if rp_nodeAt loc ep nT && Nat.beq nT.tag tT then some nT.parentTag
            else findParentTagAt? loc ep tT restT) = some pT ∧ _
        rw [hAtS, hAtT]
        change ∃ pS pT,
          (if Nat.beq nS.tag tS = true then some nS.parentTag
            else findParentTagAt? loc ep tS restS) = some pS ∧
          (if Nat.beq nT.tag tT = true then some nT.parentTag
            else findParentTagAt? loc ep tT restT) = some pT ∧ _
        cases hHead : Nat.beq nS.tag tS && Nat.beq nT.tag tT with
        | true =>
          let ⟨hEqS, hEqT⟩ := bool_and_true hHead
          rw [if_bool_true hEqS, if_bool_true hEqT]
          exact ⟨nS.parentTag, nT.parentTag, rfl, rfl,
            rp_parentPairOk_mono hPar⟩
        | false =>
          rw [hHead] at hPair
          change rp_hasPair ps' tS tT = true at hPair
          let ⟨pS, pT, hfS, hfT, hParOk⟩ := ih hBSRest hBTRest hPair
          have ⟨_, hLoS2, _⟩ := rp_findParentTagAt_bounds hBSRest hfS
          have ⟨_, hLoT2, _⟩ := rp_findParentTagAt_bounds hBTRest hfT
          have hNeS : nS.tag ≠ tS := Nat.ne_of_lt hLoS2
          have hNeT : nT.tag ≠ tT := Nat.ne_of_lt hLoT2
          rw [if_bool_false (nat_beq_false_of_ne hNeS),
              if_bool_false (nat_beq_false_of_ne hNeT)]
          have hAssoc :
              (pr ++ [(nS.tag, nT.tag)]) ++ ps' =
                pr ++ ((nS.tag, nT.tag) :: ps') := by
            rw [List.append_assoc]; rfl
          rw [hAssoc] at hParOk
          exact ⟨pS, pT, hfS, hfT, hParOk⟩

private theorem rp_ExactNodeRel_pair_inj {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {loS hiS loT hiT aS aT bS bT : Nat}
    (hRel : rp_ExactNodeRel loc ep prior ps nsS nsT)
    (hBS : rp_NodesBounded loS hiS nsS)
    (hBT : rp_NodesBounded loT hiT nsT)
    (hA : rp_hasPair ps aS aT = true)
    (hB : rp_hasPair ps bS bT = true) :
    Nat.beq aS bS = Nat.beq aT bT := by
  induction hRel generalizing loS loT with
  | nil _ => cases hA
  | cons _ nS nT ps' restS restT _ _ _ _ _ hRest ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest =>
      cases hBT with
      | cons _ _ _ _ hBTRest =>
        dsimp [rp_hasPair] at hA hB
        have hBoundsPair : ∀ {xS xT}, rp_hasPair ps' xS xT = true →
            nS.tag < xS ∧ nT.tag < xT := by
          intro xS xT hx
          let ⟨_, _, hfS, hfT, _⟩ :=
            rp_ExactNodeRel_findParent hRest hBSRest hBTRest hx
          let ⟨_, h1, _⟩ := rp_findParentTagAt_bounds hBSRest hfS
          let ⟨_, h2, _⟩ := rp_findParentTagAt_bounds hBTRest hfT
          exact ⟨h1, h2⟩
        cases bool_or_true hA with
        | inl hAH =>
          let ⟨haS, haT⟩ := bool_and_true hAH
          have eaS := nat_beq_eq haS; subst eaS
          have eaT := nat_beq_eq haT; subst eaT
          cases bool_or_true hB with
          | inl hBH =>
            let ⟨hbS, hbT⟩ := bool_and_true hBH
            have ebS := nat_beq_eq hbS; subst ebS
            have ebT := nat_beq_eq hbT; subst ebT
            rw [nat_beq_refl, nat_beq_refl]
          | inr hBTail =>
            let ⟨hltS, hltT⟩ := hBoundsPair hBTail
            rw [nat_beq_false_of_ne (Nat.ne_of_lt hltS),
                nat_beq_false_of_ne (Nat.ne_of_lt hltT)]
        | inr hATail =>
          let ⟨hltAS, hltAT⟩ := hBoundsPair hATail
          cases bool_or_true hB with
          | inl hBH =>
            let ⟨hbS, hbT⟩ := bool_and_true hBH
            have ebS := nat_beq_eq hbS; subst ebS
            have ebT := nat_beq_eq hbT; subst ebT
            rw [nat_beq_false_of_ne (Nat.ne_of_gt hltAS),
                nat_beq_false_of_ne (Nat.ne_of_gt hltAT)]
          | inr hBTail =>
            exact ih hBSRest hBTRest hATail hBTail

private theorem rp_ExactNodeRel_pair_ge_lo {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {loS hiS loT hiT xS xT : Nat}
    (hRel : rp_ExactNodeRel loc ep prior ps nsS nsT)
    (hBS : rp_NodesBounded loS hiS nsS)
    (hBT : rp_NodesBounded loT hiT nsT)
    (hP : rp_hasPair ps xS xT = true) :
    loS ≤ xS ∧ loT ≤ xT := by
  let ⟨_, _, hfS, hfT, _⟩ := rp_ExactNodeRel_findParent hRel hBS hBT hP
  let ⟨_, h1, _⟩ := rp_findParentTagAt_bounds hBS hfS
  let ⟨_, h2, _⟩ := rp_findParentTagAt_bounds hBT hfT
  exact ⟨h1, h2⟩

private theorem rp_ExactRel_isAncestor_aux {loc : LocalId} {ep : Nat}
    {ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {hiS hiT ancS ancT : Nat}
    (hRel : rp_ExactNodeRel loc ep [] ps nsS nsT)
    (hBS : rp_NodesBounded 1 hiS nsS)
    (hBT : rp_NodesBounded 1 hiT nsT)
    (hAnc : rp_hasPair ps ancS ancT = true) :
    ∀ (k curS curT : Nat),
      rp_countLe curS nsS ≤ k →
      rp_parentPairOk ps curS curT = true →
      isAncestorTag nsS loc ep ancS curS =
        isAncestorTag nsT loc ep ancT curT
  | k, curS, curT, hCnt, hCur => by
    let ⟨hAncGeS, hAncGeT⟩ := rp_ExactNodeRel_pair_ge_lo hRel hBS hBT hAnc
    rw [rp_isAncestorTag_unfold hBS, rp_isAncestorTag_unfold hBT]
    cases bool_or_true hCur with
    | inl hZero =>
      let ⟨hS0, hT0⟩ := bool_and_true hZero
      have eS0 := nat_beq_eq hS0; subst eS0
      have eT0 := nat_beq_eq hT0; subst eT0
      have hNeS : ancS ≠ 0 := Nat.ne_of_gt hAncGeS
      have hNeT : ancT ≠ 0 := Nat.ne_of_gt hAncGeT
      rw [if_bool_false (nat_beq_false_of_ne hNeS),
          if_bool_false (nat_beq_false_of_ne hNeT)]
      rfl
    | inr hCurPair =>
      let ⟨hCurGeS, hCurGeT⟩ :=
        rp_ExactNodeRel_pair_ge_lo hRel hBS hBT hCurPair
      have hEqBeq := rp_ExactNodeRel_pair_inj hRel hBS hBT hAnc hCurPair
      rw [hEqBeq]
      cases Nat.beq ancT curT with
      | true => rfl
      | false =>
        rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurGeS)),
            if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurGeT))]
        let ⟨pS, pT, hfS, hfT, hParOk⟩ :=
          rp_ExactNodeRel_findParent hRel hBS hBT hCurPair
        rw [List.nil_append] at hParOk
        rw [hfS, hfT]
        have hStep := rp_countLe_step hBS hfS
        cases k with
        | zero =>
          have hAbs := Nat.le_trans hStep hCnt
          cases hAbs
        | succ k' =>
          have hCnt' : rp_countLe pS nsS ≤ k' :=
            Nat.le_of_succ_le_succ (Nat.le_trans hStep hCnt)
          exact rp_ExactRel_isAncestor_aux hRel hBS hBT hAnc k' pS pT
            hCnt' hParOk

private theorem rp_ExactRel_derivedLoop {loc : LocalId} {ep : Nat}
    {ps : List (Nat × Nat)} {origS origT : List BorrowNode}
    {hiS hiT accS accT : Nat} {kind : TbAccessKind}
    (hOrig : rp_ExactNodeRel loc ep [] ps origS origT)
    (hBS : rp_NodesBounded 1 hiS origS)
    (hBT : rp_NodesBounded 1 hiT origT)
    (hAcc : rp_hasPair ps accS accT = true) :
    ∀ {prior psRest : List (Nat × Nat)} {curS curT : List BorrowNode},
      prior ++ psRest = ps →
      rp_ExactNodeRel loc ep prior psRest curS curT →
      match tbDerivedAccessLoop origS loc ep kind accS curS,
          tbDerivedAccessLoop origT loc ep kind accT curT with
      | .error k₁, .error k₂ => k₁ = k₂
      | .ok curS', .ok curT' =>
        rp_ExactNodeRel loc ep prior psRest curS' curT'
      | _, _ => False := by
  intro prior psRest curS curT hSplit hRel
  induction hRel with
  | nil prior =>
    dsimp [tbDerivedAccessLoop]
    exact .nil prior
  | cons prior nS nT ps' restS restT hAtS hAtT hPerm hNR hPar _ ih_rel =>
    dsimp [tbDerivedAccessLoop]
    have hAtS' :
        (Nat.beq nS.targetLocal loc && Nat.beq nS.targetEpoch ep) = true :=
      hAtS
    have hAtT' :
        (Nat.beq nT.targetLocal loc && Nat.beq nT.targetEpoch ep) = true :=
      hAtT
    rw [hAtS', hAtT']
    dsimp
    have hNodePair : rp_hasPair ps nS.tag nT.tag = true := by
      rw [← hSplit, rp_hasPair_append]
      apply bool_or_intro_right
      dsimp [rp_hasPair]
      exact bool_or_intro_left _
        (bool_and_intro (nat_beq_refl _) (nat_beq_refl _))
    have hAncEq :=
      rp_ExactRel_isAncestor_aux hOrig hBS hBT hNodePair
        (rp_countLe accS origS) accS accT (Nat.le_refl _)
        (bool_or_intro_right _ hAcc)
    rw [hAncEq]
    have hSplit' : (prior ++ [(nS.tag, nT.tag)]) ++ ps' = ps := by
      rw [List.append_assoc]
      exact hSplit
    have ih := ih_rel hSplit'
    cases isAncestorTag origT loc ep nT.tag accT with
    | true =>
      dsimp
      rw [hPerm]
      cases hStep : tbChildStep kind nT.perm with
      | none => rfl
      | some perm' =>
        dsimp
        have hNR' : perm' ≠ .rootOrRaw := by
          rw [hPerm] at hNR
          exact rp_tbChildStep_ne_root hNR hStep
        cases hR1 : tbDerivedAccessLoop origS loc ep kind accS restS with
        | error k1 =>
          rw [hR1] at ih
          cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
          | error k2 => rw [hR2] at ih; exact ih
          | ok _ => rw [hR2] at ih; exact ih
        | ok restS' =>
          rw [hR1] at ih
          cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
          | error _ => rw [hR2] at ih; exact ih
          | ok restT' =>
            rw [hR2] at ih
            exact .cons prior { nS with perm := perm' }
              { nT with perm := perm' } ps' restS' restT'
              hAtS hAtT rfl hNR' hPar ih
    | false =>
      dsimp
      rw [hPerm]
      have hNR' : tbForeignStep kind nT.perm ≠ .rootOrRaw := by
        rw [hPerm] at hNR
        exact rp_tbForeignStep_ne_root hNR
      cases hR1 : tbDerivedAccessLoop origS loc ep kind accS restS with
      | error k1 =>
        rw [hR1] at ih
        cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
        | error k2 => rw [hR2] at ih; exact ih
        | ok _ => rw [hR2] at ih; exact ih
      | ok restS' =>
        rw [hR1] at ih
        cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
        | error _ => rw [hR2] at ih; exact ih
        | ok restT' =>
          rw [hR2] at ih
          exact .cons prior { nS with perm := tbForeignStep kind nT.perm }
            { nT with perm := tbForeignStep kind nT.perm } ps' restS' restT'
            hAtS hAtT rfl hNR' hPar ih

private theorem rp_ExactRel_performTbAccess {loc : LocalId} {ep : Nat}
    {ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {hiS hiT tS tT : Nat} {ty : MirTy} {kind : TbAccessKind}
    (hRel : rp_ExactNodeRel loc ep [] ps nsS nsT)
    (hBS : rp_NodesBounded 1 hiS nsS)
    (hBT : rp_NodesBounded 1 hiT nsT)
    (hTag : rp_tagPairValid ps tS tT) :
    match performTbAccess loc ep ty kind tS nsS,
        performTbAccess loc ep ty kind tT nsT with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok nsS', .ok nsT' => rp_ExactNodeRel loc ep [] ps nsS' nsT'
    | _, _ => False := by
  unfold performTbAccess
  cases isZeroSizedTy ty with
  | true => exact hRel
  | false =>
    dsimp
    cases hTag with
    | inl hZero =>
      let ⟨hS0, hT0⟩ := hZero
      subst hS0; subst hT0
      dsimp
      exact rp_ExactNodeRel_tbForeign kind hRel
    | inr hPos =>
      let ⟨hGeS, hGeT, hPair⟩ := hPos
      rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hGeS)),
          if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hGeT))]
      let ⟨hHasS, hHasT⟩ := rp_ExactNodeRel_hasTag hRel hPair
      rw [hHasS, hHasT]
      dsimp
      exact rp_ExactRel_derivedLoop hRel hBS hBT hPair rfl hRel

/-! ### Target `(x, ep_x)` State Machine (`rp_TbStateAtX` + `Delegated`) -/

private noncomputable def rp_allRootParents (loc : LocalId) (ep : Nat) :
    List BorrowNode → Prop
  | [] => True
  | n :: ns =>
    rp_nodeAt loc ep n = true ∧
    n.parentTag = 0 ∧
    n.perm ≠ .rootOrRaw ∧
    rp_allRootParents loc ep ns

private noncomputable def rp_findPermAt? (loc : LocalId) (ep t : Nat) :
    List BorrowNode → Option BorrowPerm
  | [] => none
  | n :: ns =>
    if rp_nodeAt loc ep n && Nat.beq n.tag t then
      some n.perm
    else
      rp_findPermAt? loc ep t ns

private noncomputable def rp_permAllowed (rIsMut : Bool) (mode : BorrowLinkMode)
    (perm : BorrowPerm) : Prop :=
  match mode with
  | .reserved =>
    (rIsMut = true ∧ perm = .reservedFrz) ∨
      (rIsMut = false ∧ perm = .frozen)
  | .unique =>
    (rIsMut = true ∧ (perm = .reservedFrz ∨ perm = .unique)) ∨
      (rIsMut = false ∧ perm = .frozen)
  | .frozen =>
    (rIsMut = true ∧
      (perm = .reservedFrz ∨ perm = .unique ∨ perm = .frozen)) ∨
      (rIsMut = false ∧ perm = .frozen)
  | .clean | .delegated => True

private noncomputable def rp_permSubsumes (pAnc pRoot : BorrowPerm) : Prop :=
  match pRoot with
  | .reservedFrz => pAnc = .reservedFrz
  | .unique => pAnc = .unique
  | .frozen => pAnc = .reservedFrz ∨ pAnc = .unique ∨ pAnc = .frozen
  | .disabled => True
  | .rootOrRaw => False

private theorem rp_permAllowed_mono {rIsMut : Bool} {m₁ m₂ : BorrowLinkMode}
    {perm : BorrowPerm}
    (hLe : linkModeLe m₁ m₂ = true)
    (hPerm : rp_permAllowed rIsMut m₁ perm) :
    rp_permAllowed rIsMut m₂ perm := by
  cases m₁ with
  | reserved =>
    cases m₂ with
    | reserved => exact hPerm
    | unique =>
      cases hPerm with
      | inl h => exact Or.inl ⟨h.1, Or.inl h.2⟩
      | inr h => exact Or.inr h
    | frozen =>
      cases hPerm with
      | inl h => exact Or.inl ⟨h.1, Or.inl h.2⟩
      | inr h => exact Or.inr h
    | clean | delegated => exact True.intro
  | unique =>
    cases m₂ with
    | reserved => cases hLe
    | unique => exact hPerm
    | frozen =>
      cases hPerm with
      | inl h =>
        cases h.2 with
        | inl hp => exact Or.inl ⟨h.1, Or.inl hp⟩
        | inr hp => exact Or.inl ⟨h.1, Or.inr (Or.inl hp)⟩
      | inr h => exact Or.inr h
    | clean | delegated => exact True.intro
  | frozen =>
    cases m₂ with
    | reserved | unique => cases hLe
    | frozen => exact hPerm
    | clean | delegated => exact True.intro
  | clean =>
    cases m₂ with
    | reserved | unique | frozen => cases hLe
    | clean | delegated => exact True.intro
  | delegated =>
    cases m₂ with
    | reserved | unique | frozen | clean => cases hLe
    | delegated => exact True.intro

private theorem rp_permSubsumes_foreign {kind : TbAccessKind}
    {pAnc pRoot : BorrowPerm}
    (hAncNR : pAnc ≠ .rootOrRaw)
    (hSub : rp_permSubsumes pAnc pRoot) :
    rp_permSubsumes (tbForeignStep kind pAnc) (tbForeignStep kind pRoot) := by
  cases pRoot with
  | rootOrRaw => exact False.elim hSub
  | reservedFrz =>
    dsimp [rp_permSubsumes] at hSub
    subst hSub
    cases kind with
    | read => rfl
    | write => exact True.intro
  | unique =>
    dsimp [rp_permSubsumes] at hSub
    subst hSub
    cases kind with
    | read => exact Or.inr (Or.inr rfl)
    | write => exact True.intro
  | frozen =>
    dsimp [rp_permSubsumes] at hSub
    cases kind with
    | write => exact True.intro
    | read =>
      cases hSub with
      | inl h => subst h; exact Or.inl rfl
      | inr h =>
        cases h with
        | inl h2 => subst h2; exact Or.inr (Or.inr rfl)
        | inr h3 => subst h3; exact Or.inr (Or.inr rfl)
  | disabled =>
    cases pAnc with
    | rootOrRaw => exact False.elim (hAncNR rfl)
    | reservedFrz | unique | frozen | disabled =>
      cases kind <;> exact True.intro

private theorem rp_permSubsumes_child {kind : TbAccessKind}
    {pAnc pRoot pRoot' : BorrowPerm}
    (hSub : rp_permSubsumes pAnc pRoot)
    (hStep : tbChildStep kind pRoot = some pRoot') :
    ∃ pAnc', tbChildStep kind pAnc = some pAnc' ∧
      rp_permSubsumes pAnc' pRoot' := by
  cases pRoot with
  | rootOrRaw => exact False.elim hSub
  | disabled =>
    cases kind <;> cases hStep
  | reservedFrz =>
    dsimp [rp_permSubsumes] at hSub
    subst hSub
    cases kind <;> injection hStep with hEq <;> subst hEq <;>
      exact ⟨_, rfl, rfl⟩
  | unique =>
    dsimp [rp_permSubsumes] at hSub
    subst hSub
    cases kind <;> injection hStep with hEq <;> subst hEq <;>
      exact ⟨_, rfl, rfl⟩
  | frozen =>
    cases kind with
    | write => cases hStep
    | read =>
      injection hStep with hEq; subst hEq
      dsimp [rp_permSubsumes] at hSub
      cases hSub with
      | inl h => subst h; exact ⟨.reservedFrz, rfl, Or.inl rfl⟩
      | inr h =>
        cases h with
        | inl h2 => subst h2; exact ⟨.unique, rfl, Or.inr (Or.inl rfl)⟩
        | inr h3 => subst h3; exact ⟨.frozen, rfl, Or.inr (Or.inr rfl)⟩

private theorem rp_allRootParents_append {loc : LocalId} {ep : Nat}
    {xs ys : List BorrowNode}
    (hx : rp_allRootParents loc ep xs)
    (hy : rp_allRootParents loc ep ys) :
    rp_allRootParents loc ep (xs ++ ys) := by
  induction xs with
  | nil => exact hy
  | cons n ns ih =>
    let ⟨h1, h2, h3, hRest⟩ := hx
    exact ⟨h1, h2, h3, ih hRest⟩

private theorem rp_allRootParents_tbForeign {loc : LocalId} {ep : Nat}
    {kind : TbAccessKind} {ns : List BorrowNode}
    (h : rp_allRootParents loc ep ns) :
    rp_allRootParents loc ep (tbForeignAccessAt loc ep kind ns) := by
  induction ns with
  | nil => exact True.intro
  | cons n rest ih =>
    let ⟨hAt, hP0, hNR, hRest⟩ := h
    dsimp [tbForeignAccessAt]
    have hAt' :
        (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = true := hAt
    rw [if_bool_true hAt']
    exact ⟨hAt, hP0, rp_tbForeignStep_ne_root hNR, ih hRest⟩

private theorem rp_findPermAt_hasTag {loc : LocalId} {ep t : Nat}
    {perm : BorrowPerm} {ns : List BorrowNode}
    (h : rp_findPermAt? loc ep t ns = some perm) :
    hasBorrowTagAt loc ep t ns = true := by
  induction ns with
  | nil => cases h
  | cons n rest ih =>
    dsimp [rp_findPermAt?] at h
    dsimp [hasBorrowTagAt]
    change ((rp_nodeAt loc ep n && Nat.beq n.tag t) ||
      hasBorrowTagAt loc ep t rest) = true
    cases hCond : rp_nodeAt loc ep n && Nat.beq n.tag t with
    | true => exact bool_or_intro_left _ rfl
    | false =>
      rw [if_bool_false hCond] at h
      exact bool_or_intro_right _ (ih h)

private theorem rp_findPermAt_bounds {loc : LocalId} {ep t lo hi : Nat}
    {perm : BorrowPerm} {ns : List BorrowNode}
    (hB : rp_NodesBounded lo hi ns)
    (hF : rp_findPermAt? loc ep t ns = some perm) :
    lo ≤ t ∧ t < hi := by
  induction hB with
  | nil _ => cases hF
  | cons n rest hLo _ hRest ih =>
    dsimp [rp_findPermAt?] at hF
    cases hCond : rp_nodeAt loc ep n && Nat.beq n.tag t with
    | true =>
      let ⟨_, hEq⟩ := bool_and_true hCond
      have ht := nat_beq_eq hEq; subst ht
      exact ⟨hLo, rp_NodesBounded_le hRest⟩
    | false =>
      rw [if_bool_false hCond] at hF
      let ⟨h1, h2⟩ := ih hF
      exact ⟨Nat.le_trans hLo (Nat.le_trans (Nat.le_succ _) h1), h2⟩

private theorem rp_findPermAt_none_of_lt {loc : LocalId} {ep t lo hi : Nat}
    {ns : List BorrowNode}
    (hB : rp_NodesBounded lo hi ns) (hLt : t < lo) :
    rp_findPermAt? loc ep t ns = none := by
  induction hB with
  | nil _ => rfl
  | cons n rest hLo _ _ ih =>
    dsimp [rp_findPermAt?]
    have hLtTag : t < n.tag := Nat.lt_of_lt_of_le hLt hLo
    rw [nat_beq_false_of_ne (Nat.ne_of_gt hLtTag)]
    have hF : (rp_nodeAt loc ep n && false) = false := by
      cases rp_nodeAt loc ep n <;> rfl
    rw [if_bool_false hF]
    exact ih (Nat.lt_of_lt_of_le hLtTag (Nat.le_succ _))

private theorem rp_findPermAt_append_last {loc : LocalId} {ep lo hi : Nat}
    {ns : List BorrowNode} (n : BorrowNode)
    (hB : rp_NodesBounded lo hi ns)
    (hHi : hi ≤ n.tag)
    (hAt : rp_nodeAt loc ep n = true) :
    rp_findPermAt? loc ep n.tag (ns ++ [n]) = some n.perm := by
  induction hB with
  | nil _ =>
    dsimp [rp_findPermAt?]
    rw [if_bool_true (bool_and_intro hAt (nat_beq_refl n.tag))]
  | cons m rest hLo _ hRest ih =>
    dsimp [rp_findPermAt?]
    have hMlt : m.tag < n.tag :=
      Nat.lt_of_lt_of_le (rp_NodesBounded_le hRest) hHi
    rw [nat_beq_false_of_ne (Nat.ne_of_lt hMlt)]
    have hF : (rp_nodeAt loc ep m && false) = false := by
      cases rp_nodeAt loc ep m <;> rfl
    rw [if_bool_false hF]
    exact ih hHi

private theorem rp_findPermAt_tbForeign {loc : LocalId} {ep t : Nat}
    {perm : BorrowPerm} {ns : List BorrowNode} (kind : TbAccessKind)
    (hF : rp_findPermAt? loc ep t ns = some perm) :
    rp_findPermAt? loc ep t (tbForeignAccessAt loc ep kind ns) =
      some (tbForeignStep kind perm) := by
  induction ns with
  | nil => cases hF
  | cons n rest ih =>
    dsimp [rp_findPermAt?] at hF
    dsimp [tbForeignAccessAt, rp_findPermAt?]
    cases hCond : rp_nodeAt loc ep n && Nat.beq n.tag t with
    | true =>
      rw [if_bool_true hCond] at hF
      injection hF with hEq; subst hEq
      let ⟨hAt, hTag⟩ := bool_and_true hCond
      have hAt' :
          (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = true := hAt
      rw [if_bool_true hAt']
      have hCond' :
          (rp_nodeAt loc ep { n with perm := tbForeignStep kind n.perm } &&
            Nat.beq n.tag t) = true := bool_and_intro hAt hTag
      rw [if_bool_true hCond']
    | false =>
      rw [if_bool_false hCond] at hF
      cases hAt : Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep with
      | true =>
        rw [if_bool_true rfl]
        have hCond' :
            (rp_nodeAt loc ep { n with perm := tbForeignStep kind n.perm } &&
              Nat.beq n.tag t) = false := hCond
        rw [if_bool_false hCond']
        exact ih hF
      | false =>
        rw [if_bool_false rfl, if_bool_false hCond]
        exact ih hF

private theorem rp_allRootParents_findParent_zero {loc : LocalId} {ep t pTag : Nat}
    {ns : List BorrowNode}
    (hRoot : rp_allRootParents loc ep ns)
    (hF : findParentTagAt? loc ep t ns = some pTag) :
    pTag = 0 := by
  induction ns with
  | nil => cases hF
  | cons n rest ih =>
    let ⟨_, hP0, _, hRest⟩ := hRoot
    dsimp [findParentTagAt?] at hF
    cases hCond :
        Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep &&
          Nat.beq n.tag t with
    | true =>
      rw [if_bool_true hCond] at hF
      injection hF with hEq
      rw [← hEq, hP0]
    | false =>
      rw [if_bool_false hCond] at hF
      exact ih hRest hF

private theorem rp_allRootParents_isAncestor {loc : LocalId} {ep anc cur hi : Nat}
    {ns : List BorrowNode}
    (hB : rp_NodesBounded 1 hi ns)
    (hRoot : rp_allRootParents loc ep ns)
    (hAncPos : 1 ≤ anc) :
    isAncestorTag ns loc ep anc cur = Nat.beq anc cur := by
  rw [rp_isAncestorTag_unfold hB]
  cases hEq : Nat.beq anc cur with
  | true => rfl
  | false =>
    cases Nat.beq cur 0 with
    | true => rfl
    | false =>
      dsimp
      cases hF : findParentTagAt? loc ep cur ns with
      | none => rfl
      | some pTag =>
        have hp0 := rp_allRootParents_findParent_zero hRoot hF
        rw [hp0]
        dsimp
        rw [rp_isAncestorTag_unfold hB,
            if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hAncPos))]
        rfl

private theorem rp_allRootParents_derivedLoop {loc : LocalId} {ep hi tagR : Nat}
    {origNodes : List BorrowNode} {kind : TbAccessKind}
    {permR permR' : BorrowPerm}
    (hBOrig : rp_NodesBounded 1 hi origNodes)
    (hRootOrig : rp_allRootParents loc ep origNodes)
    (hStepR : tbChildStep kind permR = some permR') :
    ∀ {lo : Nat} {curNodes : List BorrowNode},
      rp_NodesBounded lo hi curNodes →
      rp_allRootParents loc ep curNodes →
      (∀ p, rp_findPermAt? loc ep tagR curNodes = some p → p = permR) →
      ∃ curNodes',
        tbDerivedAccessLoop origNodes loc ep kind tagR curNodes =
          .ok curNodes' ∧
        rp_allRootParents loc ep curNodes' ∧
        (rp_findPermAt? loc ep tagR curNodes = some permR →
          rp_findPermAt? loc ep tagR curNodes' = some permR')
  | _, [], _, _, _ =>
    ⟨[], rfl, True.intro, fun h => by cases h⟩
  | lo, n :: rest, .cons _ _ hLo hParent hBRest,
      ⟨hAt, hP0, hNR, hRootRest⟩, hPermMatch => by
    dsimp [tbDerivedAccessLoop]
    have hAt' :
        (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = true := hAt
    rw [hAt']
    dsimp
    have hNPos : 1 ≤ n.tag := by
      cases hNT : n.tag with
      | zero => rw [hNT] at hParent; cases hParent
      | succ k => exact Nat.succ_le_succ (Nat.zero_le k)
    rw [rp_allRootParents_isAncestor hBOrig hRootOrig hNPos]
    cases hTagEq : Nat.beq n.tag tagR with
    | true =>
      dsimp
      have hFindHere :
          rp_findPermAt? loc ep tagR (n :: rest) = some n.perm := by
        dsimp [rp_findPermAt?]
        rw [if_bool_true (bool_and_intro hAt hTagEq)]
      have hnPerm : n.perm = permR := hPermMatch n.perm hFindHere
      rw [hnPerm, hStepR]
      dsimp
      have hNoneRest : rp_findPermAt? loc ep tagR rest = none := by
        have htEq := nat_beq_eq hTagEq; subst htEq
        exact rp_findPermAt_none_of_lt hBRest (Nat.lt_succ_self _)
      let ⟨rest', hLoopRest, hRootRest', _⟩ :=
        rp_allRootParents_derivedLoop (tagR := tagR) hBOrig hRootOrig hStepR
          hBRest hRootRest (fun p hp => by rw [hNoneRest] at hp; cases hp)
      rw [hLoopRest]
      refine ⟨_, rfl,
        ⟨hAt, hP0, rp_tbChildStep_ne_root (hnPerm ▸ hNR) hStepR,
          hRootRest'⟩, ?_⟩
      intro _
      dsimp [rp_findPermAt?]
      have hCond' :
          (rp_nodeAt loc ep { n with perm := permR' } &&
            Nat.beq n.tag tagR) = true := bool_and_intro hAt hTagEq
      rw [if_bool_true hCond']
    | false =>
      dsimp
      have hFindStep :
          rp_findPermAt? loc ep tagR (n :: rest) =
            rp_findPermAt? loc ep tagR rest := by
        dsimp [rp_findPermAt?]
        have hCondF : (rp_nodeAt loc ep n && Nat.beq n.tag tagR) = false := by
          rw [hAt, hTagEq]; rfl
        rw [if_bool_false hCondF]
      let ⟨rest', hLoopRest, hRootRest', hFindRest'⟩ :=
        rp_allRootParents_derivedLoop (tagR := tagR) hBOrig hRootOrig hStepR
          hBRest hRootRest (fun p hp => hPermMatch p (hFindStep.trans hp))
      rw [hLoopRest]
      refine ⟨_, rfl,
        ⟨hAt, hP0, rp_tbForeignStep_ne_root hNR, hRootRest'⟩, ?_⟩
      intro hF
      rw [hFindStep] at hF
      dsimp [rp_findPermAt?]
      have hCondF' :
          (rp_nodeAt loc ep { n with perm := tbForeignStep kind n.perm } &&
            Nat.beq n.tag tagR) = false := by
        change (rp_nodeAt loc ep n && Nat.beq n.tag tagR) = false
        rw [hAt, hTagEq]; rfl
      rw [if_bool_false hCondF']
      exact hFindRest' hF

private theorem rp_allRootParents_performTbAccess {loc : LocalId} {ep hi tagR : Nat}
    {ty : MirTy} {kind : TbAccessKind} {permR permR' : BorrowPerm}
    {nodes : List BorrowNode}
    (hNotZst : isZeroSizedTy ty = false)
    (hB : rp_NodesBounded 1 hi nodes)
    (hRoot : rp_allRootParents loc ep nodes)
    (hFind : rp_findPermAt? loc ep tagR nodes = some permR)
    (hStepR : tbChildStep kind permR = some permR') :
    ∃ nodes',
      performTbAccess loc ep ty kind tagR nodes = .ok nodes' ∧
      rp_allRootParents loc ep nodes' ∧
      rp_findPermAt? loc ep tagR nodes' = some permR' := by
  unfold performTbAccess
  rw [if_bool_false hNotZst]
  let ⟨hGe1, _⟩ := rp_findPermAt_bounds hB hFind
  rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hGe1))]
  rw [rp_findPermAt_hasTag hFind]
  dsimp
  let ⟨nodes', hLoop, hRoot', hFind'⟩ :=
    rp_allRootParents_derivedLoop (tagR := tagR) hB hRoot hStepR hB hRoot
      (fun p hp => by rw [hFind] at hp; injection hp with h; exact h.symm)
  exact ⟨nodes', hLoop, hRoot', hFind' hFind⟩

/-! ### Delegated Mode (`D1`: Forwarded Copy, `D2`: Reborrow Subtree) -/

private inductive rp_DelegatedCopyRel (loc : LocalId) (ep : Nat) :
    List (Nat × Nat) → List (Nat × Nat) →
    List BorrowNode → List BorrowNode → Prop where
  | nil (prior : List (Nat × Nat)) :
      rp_DelegatedCopyRel loc ep prior [] [] []
  | skip (prior : List (Nat × Nat)) (d : BorrowNode)
      (ps : List (Nat × Nat)) (nsS nsT : List BorrowNode)
      (hAtD : rp_nodeAt loc ep d = true)
      (hP0 : d.parentTag = 0)
      (hNR : d.perm ≠ .rootOrRaw)
      (hNotPrior : rp_hasFst prior d.tag = false)
      (hNotPs : rp_hasFst ps d.tag = false)
      (hRest : rp_DelegatedCopyRel loc ep prior ps nsS nsT) :
      rp_DelegatedCopyRel loc ep prior ps (d :: nsS) nsT
  | cons (prior : List (Nat × Nat)) (nS nT : BorrowNode)
      (ps : List (Nat × Nat)) (nsS nsT : List BorrowNode)
      (hAtS : rp_nodeAt loc ep nS = true)
      (hAtT : rp_nodeAt loc ep nT = true)
      (hPerm : nS.perm = nT.perm)
      (hNR : nS.perm ≠ .rootOrRaw)
      (hPar : rp_parentPairOk prior nS.parentTag nT.parentTag = true)
      (hRest : rp_DelegatedCopyRel loc ep (prior ++ [(nS.tag, nT.tag)])
        ps nsS nsT) :
      rp_DelegatedCopyRel loc ep prior ((nS.tag, nT.tag) :: ps)
        (nS :: nsS) (nT :: nsT)

private theorem rp_DelegatedCopyRel_of_allRoot_split {loc : LocalId} {ep : Nat}
    {lo hi : Nat} {nsS : List BorrowNode} {tagR : Nat} {permR : BorrowPerm}
    (nT : BorrowNode)
    (hBS : rp_NodesBounded lo hi nsS)
    (hRoot : rp_allRootParents loc ep nsS)
    (hFind : rp_findPermAt? loc ep tagR nsS = some permR)
    (hAtT : rp_nodeAt loc ep nT = true)
    (hPT0 : nT.parentTag = 0)
    (hPermT : nT.perm = permR) :
    rp_DelegatedCopyRel loc ep [] [(tagR, nT.tag)] nsS [nT] := by
  induction hBS with
  | nil _ => cases hFind
  | cons n rest hLo _ hBRest ih =>
    let ⟨hAtN, hPN0, hNRN, hRootRest⟩ := hRoot
    dsimp [rp_findPermAt?] at hFind
    have hCondEq : (rp_nodeAt loc ep n && Nat.beq n.tag tagR) =
        Nat.beq n.tag tagR := by
      rw [hAtN]; rfl
    rw [hCondEq] at hFind
    cases hTagEq : Nat.beq n.tag tagR with
    | true =>
      rw [if_bool_true hTagEq] at hFind
      injection hFind with hPEq
      have ht := nat_beq_eq hTagEq; subst ht
      have hAllSkip : ∀ {l h : Nat} {rs : List BorrowNode},
          rp_NodesBounded l h rs →
          rp_allRootParents loc ep rs →
          n.tag < l →
          rp_DelegatedCopyRel loc ep [(n.tag, nT.tag)] [] rs [] := by
        intro l h rs hBrs hRrs hLtL
        induction hBrs with
        | nil _ => exact .nil _
        | cons m ms hmLo _ _ ihm =>
          let ⟨hmAt, hmP0, hmNR, hmRRest⟩ := hRrs
          have hNeM : n.tag ≠ m.tag :=
            Nat.ne_of_lt (Nat.lt_of_lt_of_le hLtL hmLo)
          have hNotPr : rp_hasFst [(n.tag, nT.tag)] m.tag = false := by
            dsimp [rp_hasFst]
            rw [nat_beq_false_of_ne hNeM]; rfl
          exact .skip _ m [] ms [] hmAt hmP0 hmNR hNotPr rfl
            (ihm hmRRest
              (Nat.lt_of_lt_of_le (Nat.lt_of_lt_of_le hLtL hmLo)
                (Nat.le_succ m.tag)))
      refine .cons [] n nT [] rest [] hAtN hAtT ?_ hNRN ?_
        (hAllSkip hBRest hRootRest (Nat.lt_succ_self n.tag))
      · rw [hPEq, hPermT]
      · unfold rp_parentPairOk
        rw [hPN0, hPT0]; rfl
    | false =>
      rw [if_bool_false hTagEq] at hFind
      have hNotPs : rp_hasFst [(tagR, nT.tag)] n.tag = false := by
        dsimp [rp_hasFst]
        rw [nat_beq_symm tagR n.tag, hTagEq]; rfl
      exact .skip [] n [(tagR, nT.tag)] rest [nT]
        hAtN hPN0 hNRN rfl hNotPs (ih hRootRest hFind)

private theorem rp_DelegatedCopyRel_tbForeign {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (kind : TbAccessKind)
    (hRel : rp_DelegatedCopyRel loc ep prior ps nsS nsT) :
    rp_DelegatedCopyRel loc ep prior ps
      (tbForeignAccessAt loc ep kind nsS)
      (tbForeignAccessAt loc ep kind nsT) := by
  induction hRel with
  | nil pr => exact .nil pr
  | skip pr d ps' restS restT hAtD hP0 hNR hNP hNPs _ ih =>
    dsimp [tbForeignAccessAt]
    have hAtD' :
        (Nat.beq d.targetLocal loc && Nat.beq d.targetEpoch ep) = true := hAtD
    rw [if_bool_true hAtD']
    exact .skip pr { d with perm := tbForeignStep kind d.perm } ps' _ _
      hAtD hP0 (rp_tbForeignStep_ne_root hNR) hNP hNPs ih
  | cons pr nS nT ps' restS restT hAtS hAtT hPerm hNR hPar _ ih =>
    dsimp [tbForeignAccessAt]
    have hAtS' :
        (Nat.beq nS.targetLocal loc && Nat.beq nS.targetEpoch ep) = true := hAtS
    have hAtT' :
        (Nat.beq nT.targetLocal loc && Nat.beq nT.targetEpoch ep) = true := hAtT
    rw [if_bool_true hAtS', if_bool_true hAtT']
    exact .cons pr { nS with perm := tbForeignStep kind nS.perm }
      { nT with perm := tbForeignStep kind nT.perm } ps' _ _ hAtS hAtT
      (by dsimp; rw [hPerm]) (rp_tbForeignStep_ne_root hNR) hPar ih

private theorem rp_DelegatedCopyRel_append_one {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {loS hiS : Nat}
    (nS nT : BorrowNode)
    (hRel : rp_DelegatedCopyRel loc ep prior ps nsS nsT)
    (hBS : rp_NodesBounded loS hiS nsS)
    (hHiS : hiS ≤ nS.tag)
    (hAtS : rp_nodeAt loc ep nS = true)
    (hAtT : rp_nodeAt loc ep nT = true)
    (hPerm : nS.perm = nT.perm)
    (hNR : nS.perm ≠ .rootOrRaw)
    (hPar : rp_parentPairOk (prior ++ ps) nS.parentTag nT.parentTag = true) :
    rp_DelegatedCopyRel loc ep prior (ps ++ [(nS.tag, nT.tag)])
      (nsS ++ [nS]) (nsT ++ [nT]) := by
  induction hRel generalizing loS with
  | nil pr =>
    rw [List.append_nil] at hPar
    exact .cons pr nS nT [] [] [] hAtS hAtT hPerm hNR hPar
      (.nil (pr ++ [(nS.tag, nT.tag)]))
  | skip pr d ps' restS restT hAtD hP0 hNRD hNP hNPs _ ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest =>
      have hDLt : d.tag < nS.tag :=
        Nat.lt_of_lt_of_le (rp_NodesBounded_le hBSRest) hHiS
      have hNPs' :
          rp_hasFst (ps' ++ [(nS.tag, nT.tag)]) d.tag = false := by
        rw [rp_hasFst_append, hNPs]
        dsimp [rp_hasFst]
        rw [nat_beq_false_of_ne (Nat.ne_of_gt hDLt)]; rfl
      exact .skip pr d _ (restS ++ [nS]) (restT ++ [nT])
        hAtD hP0 hNRD hNP hNPs' (ih hBSRest hPar)
  | cons pr mS mT ps' restS restT hmAtS hmAtT hmPerm hmNR hmPar _ ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest =>
      have hAssoc :
          (pr ++ [(mS.tag, mT.tag)]) ++ ps' =
            pr ++ ((mS.tag, mT.tag) :: ps') := by
        rw [List.append_assoc]; rfl
      have hPar' :
          rp_parentPairOk ((pr ++ [(mS.tag, mT.tag)]) ++ ps')
            nS.parentTag nT.parentTag = true := by
        rw [hAssoc]; exact hPar
      exact .cons pr mS mT (ps' ++ [(nS.tag, nT.tag)])
        (restS ++ [nS]) (restT ++ [nT])
        hmAtS hmAtT hmPerm hmNR hmPar (ih hBSRest hPar')

private theorem rp_DelegatedCopyRel_hasTag {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {tS tT : Nat}
    (hRel : rp_DelegatedCopyRel loc ep prior ps nsS nsT)
    (hPair : rp_hasPair ps tS tT = true) :
    hasBorrowTagAt loc ep tS nsS = true ∧
      hasBorrowTagAt loc ep tT nsT = true := by
  induction hRel with
  | nil _ => cases hPair
  | skip _ d _ restS _ _ _ _ _ _ _ ih =>
    let ⟨ihS, ihT⟩ := ih hPair
    dsimp [hasBorrowTagAt]
    exact ⟨bool_or_intro_right _ ihS, ihT⟩
  | cons _ nS nT _ restS restT hAtS hAtT _ _ _ _ ih =>
    dsimp [rp_hasPair] at hPair
    dsimp [hasBorrowTagAt]
    change ((rp_nodeAt loc ep nS && Nat.beq nS.tag tS) ||
      hasBorrowTagAt loc ep tS restS) = true ∧
      ((rp_nodeAt loc ep nT && Nat.beq nT.tag tT) ||
        hasBorrowTagAt loc ep tT restT) = true
    cases bool_or_true hPair with
    | inl hHead =>
      let ⟨hEqS, hEqT⟩ := bool_and_true hHead
      exact ⟨bool_or_intro_left _ (bool_and_intro hAtS hEqS),
             bool_or_intro_left _ (bool_and_intro hAtT hEqT)⟩
    | inr hTail =>
      let ⟨ihS, ihT⟩ := ih hTail
      exact ⟨bool_or_intro_right _ ihS, bool_or_intro_right _ ihT⟩

private theorem rp_DelegatedCopyRel_findParent {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {loS hiS loT hiT tS tT : Nat}
    (hRel : rp_DelegatedCopyRel loc ep prior ps nsS nsT)
    (hBS : rp_NodesBounded loS hiS nsS)
    (hBT : rp_NodesBounded loT hiT nsT)
    (hPair : rp_hasPair ps tS tT = true) :
    ∃ pS pT,
      findParentTagAt? loc ep tS nsS = some pS ∧
      findParentTagAt? loc ep tT nsT = some pT ∧
      rp_parentPairOk (prior ++ ps) pS pT = true := by
  induction hRel generalizing loS loT with
  | nil _ => cases hPair
  | skip pr d ps' restS restT hAtD _ _ _ hNPs _ ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest =>
      dsimp [findParentTagAt?]
      change ∃ pS pT,
        (if rp_nodeAt loc ep d && Nat.beq d.tag tS then some d.parentTag
          else findParentTagAt? loc ep tS restS) = some pS ∧ _
      have hHasFst : rp_hasFst ps' tS = true := rp_hasPair_hasFst hPair
      have hNeD : d.tag ≠ tS := by
        intro hEq; subst hEq
        rw [hHasFst] at hNPs; cases hNPs
      rw [hAtD, nat_beq_false_of_ne hNeD]
      dsimp
      exact ih hBSRest hBT hPair
  | cons pr nS nT ps' restS restT hAtS hAtT _ _ hPar _ ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest =>
      cases hBT with
      | cons _ _ _ _ hBTRest =>
        dsimp [rp_hasPair] at hPair
        dsimp [findParentTagAt?]
        change ∃ pS pT,
          (if rp_nodeAt loc ep nS && Nat.beq nS.tag tS then some nS.parentTag
            else findParentTagAt? loc ep tS restS) = some pS ∧
          (if rp_nodeAt loc ep nT && Nat.beq nT.tag tT then some nT.parentTag
            else findParentTagAt? loc ep tT restT) = some pT ∧ _
        rw [hAtS, hAtT]
        change ∃ pS pT,
          (if Nat.beq nS.tag tS = true then some nS.parentTag
            else findParentTagAt? loc ep tS restS) = some pS ∧
          (if Nat.beq nT.tag tT = true then some nT.parentTag
            else findParentTagAt? loc ep tT restT) = some pT ∧ _
        cases hHead : Nat.beq nS.tag tS && Nat.beq nT.tag tT with
        | true =>
          let ⟨hEqS, hEqT⟩ := bool_and_true hHead
          rw [if_bool_true hEqS, if_bool_true hEqT]
          exact ⟨nS.parentTag, nT.parentTag, rfl, rfl,
            rp_parentPairOk_mono hPar⟩
        | false =>
          rw [hHead] at hPair
          change rp_hasPair ps' tS tT = true at hPair
          let ⟨pS, pT, hfS, hfT, hParOk⟩ := ih hBSRest hBTRest hPair
          let ⟨_, hLoS2, _⟩ := rp_findParentTagAt_bounds hBSRest hfS
          let ⟨_, hLoT2, _⟩ := rp_findParentTagAt_bounds hBTRest hfT
          rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hLoS2)),
              if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hLoT2))]
          have hAssoc :
              (pr ++ [(nS.tag, nT.tag)]) ++ ps' =
                pr ++ ((nS.tag, nT.tag) :: ps') := by
            rw [List.append_assoc]; rfl
          rw [hAssoc] at hParOk
          exact ⟨pS, pT, hfS, hfT, hParOk⟩

private theorem rp_DelegatedCopyRel_pair_inj {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {loS hiS loT hiT aS aT bS bT : Nat}
    (hRel : rp_DelegatedCopyRel loc ep prior ps nsS nsT)
    (hBS : rp_NodesBounded loS hiS nsS)
    (hBT : rp_NodesBounded loT hiT nsT)
    (hA : rp_hasPair ps aS aT = true)
    (hB : rp_hasPair ps bS bT = true) :
    Nat.beq aS bS = Nat.beq aT bT := by
  induction hRel generalizing loS loT with
  | nil _ => cases hA
  | skip _ _ _ _ _ _ _ _ _ _ _ ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest => exact ih hBSRest hBT hA hB
  | cons _ nS nT ps' restS restT _ _ _ _ _ hRest ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest =>
      cases hBT with
      | cons _ _ _ _ hBTRest =>
        dsimp [rp_hasPair] at hA hB
        have hBoundsPair : ∀ {xS xT}, rp_hasPair ps' xS xT = true →
            nS.tag < xS ∧ nT.tag < xT := by
          intro xS xT hx
          let ⟨_, _, hfS, hfT, _⟩ :=
            rp_DelegatedCopyRel_findParent hRest hBSRest hBTRest hx
          let ⟨_, h1, _⟩ := rp_findParentTagAt_bounds hBSRest hfS
          let ⟨_, h2, _⟩ := rp_findParentTagAt_bounds hBTRest hfT
          exact ⟨h1, h2⟩
        cases bool_or_true hA with
        | inl hAH =>
          let ⟨haS, haT⟩ := bool_and_true hAH
          have eaS := nat_beq_eq haS; subst eaS
          have eaT := nat_beq_eq haT; subst eaT
          cases bool_or_true hB with
          | inl hBH =>
            let ⟨hbS, hbT⟩ := bool_and_true hBH
            have ebS := nat_beq_eq hbS; subst ebS
            have ebT := nat_beq_eq hbT; subst ebT
            rw [nat_beq_refl, nat_beq_refl]
          | inr hBTail =>
            let ⟨hltS, hltT⟩ := hBoundsPair hBTail
            rw [nat_beq_false_of_ne (Nat.ne_of_lt hltS),
                nat_beq_false_of_ne (Nat.ne_of_lt hltT)]
        | inr hATail =>
          let ⟨hltAS, hltAT⟩ := hBoundsPair hATail
          cases bool_or_true hB with
          | inl hBH =>
            let ⟨hbS, hbT⟩ := bool_and_true hBH
            have ebS := nat_beq_eq hbS; subst ebS
            have ebT := nat_beq_eq hbT; subst ebT
            rw [nat_beq_false_of_ne (Nat.ne_of_gt hltAS),
                nat_beq_false_of_ne (Nat.ne_of_gt hltAT)]
          | inr hBTail =>
            exact ih hBSRest hBTRest hATail hBTail

private theorem rp_DelegatedCopyRel_orphan_not_anc {loc : LocalId} {ep : Nat}
    {ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {hiS hiT dTag : Nat}
    (hRel : rp_DelegatedCopyRel loc ep [] ps nsS nsT)
    (hBS : rp_NodesBounded 1 hiS nsS)
    (hBT : rp_NodesBounded 1 hiT nsT)
    (hDPos : 1 ≤ dTag)
    (hNotFst : rp_hasFst ps dTag = false) :
    ∀ (k curS curT : Nat),
      rp_countLe curS nsS ≤ k →
      rp_parentPairOk ps curS curT = true →
      isAncestorTag nsS loc ep dTag curS = false
  | k, curS, curT, hCnt, hCur => by
    rw [rp_isAncestorTag_unfold hBS]
    cases bool_or_true hCur with
    | inl hZero =>
      let ⟨hS0, _⟩ := bool_and_true hZero
      have eS0 := nat_beq_eq hS0; subst eS0
      rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hDPos))]
      rfl
    | inr hCurPair =>
      have hCurFst := rp_hasPair_hasFst hCurPair
      have hNeD : dTag ≠ curS := by
        intro hEq; subst hEq
        rw [hCurFst] at hNotFst; cases hNotFst
      let ⟨_, _, hfS, _, hParOk⟩ :=
        rp_DelegatedCopyRel_findParent hRel hBS hBT hCurPair
      let ⟨_, hCurGe1, _⟩ := rp_findParentTagAt_bounds hBS hfS
      rw [if_bool_false (nat_beq_false_of_ne hNeD),
          if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurGe1)), hfS]
      rw [List.nil_append] at hParOk
      have hStep := rp_countLe_step hBS hfS
      cases k with
      | zero => cases Nat.le_trans hStep hCnt
      | succ k' =>
        exact rp_DelegatedCopyRel_orphan_not_anc hRel hBS hBT hDPos hNotFst
          k' _ _ (Nat.le_of_succ_le_succ (Nat.le_trans hStep hCnt)) hParOk

private theorem rp_DelegatedCopyRel_isAncestor_aux {loc : LocalId} {ep : Nat}
    {ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {hiS hiT ancS ancT : Nat}
    (hRel : rp_DelegatedCopyRel loc ep [] ps nsS nsT)
    (hBS : rp_NodesBounded 1 hiS nsS)
    (hBT : rp_NodesBounded 1 hiT nsT)
    (hAnc : rp_hasPair ps ancS ancT = true) :
    ∀ (k curS curT : Nat),
      rp_countLe curS nsS ≤ k →
      rp_parentPairOk ps curS curT = true →
      isAncestorTag nsS loc ep ancS curS =
        isAncestorTag nsT loc ep ancT curT
  | k, curS, curT, hCnt, hCur => by
    let ⟨_, _, hfAncS, hfAncT, _⟩ :=
      rp_DelegatedCopyRel_findParent hRel hBS hBT hAnc
    let ⟨_, hAncGeS, _⟩ := rp_findParentTagAt_bounds hBS hfAncS
    let ⟨_, hAncGeT, _⟩ := rp_findParentTagAt_bounds hBT hfAncT
    rw [rp_isAncestorTag_unfold hBS, rp_isAncestorTag_unfold hBT]
    cases bool_or_true hCur with
    | inl hZero =>
      let ⟨hS0, hT0⟩ := bool_and_true hZero
      have eS0 := nat_beq_eq hS0; subst eS0
      have eT0 := nat_beq_eq hT0; subst eT0
      rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hAncGeS)),
          if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hAncGeT))]
      rfl
    | inr hCurPair =>
      let ⟨pS, pT, hfS, hfT, hParOk⟩ :=
        rp_DelegatedCopyRel_findParent hRel hBS hBT hCurPair
      let ⟨_, hCurGeS, _⟩ := rp_findParentTagAt_bounds hBS hfS
      let ⟨_, hCurGeT, _⟩ := rp_findParentTagAt_bounds hBT hfT
      rw [rp_DelegatedCopyRel_pair_inj hRel hBS hBT hAnc hCurPair]
      cases Nat.beq ancT curT with
      | true => rfl
      | false =>
        rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurGeS)),
            if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurGeT)),
            hfS, hfT]
        rw [List.nil_append] at hParOk
        have hStep := rp_countLe_step hBS hfS
        cases k with
        | zero => cases Nat.le_trans hStep hCnt
        | succ k' =>
          exact rp_DelegatedCopyRel_isAncestor_aux hRel hBS hBT hAnc
            k' pS pT (Nat.le_of_succ_le_succ (Nat.le_trans hStep hCnt))
            hParOk

private theorem rp_DelegatedCopyRel_derivedLoop {loc : LocalId} {ep : Nat}
    {ps : List (Nat × Nat)} {origS origT : List BorrowNode}
    {hiS hiT accS accT : Nat} {kind : TbAccessKind}
    (hOrig : rp_DelegatedCopyRel loc ep [] ps origS origT)
    (hBS : rp_NodesBounded 1 hiS origS)
    (hBT : rp_NodesBounded 1 hiT origT)
    (hAcc : rp_hasPair ps accS accT = true) :
    ∀ {loS : Nat} {prior psRest : List (Nat × Nat)}
      {curS curT : List BorrowNode},
      1 ≤ loS →
      rp_NodesBounded loS hiS curS →
      prior ++ psRest = ps →
      rp_DelegatedCopyRel loc ep prior psRest curS curT →
      match tbDerivedAccessLoop origS loc ep kind accS curS,
          tbDerivedAccessLoop origT loc ep kind accT curT with
      | .error k₁, .error k₂ => k₁ = k₂
      | .ok curS', .ok curT' =>
        rp_DelegatedCopyRel loc ep prior psRest curS' curT'
      | _, _ => False := by
  intro loS prior psRest curS curT hLoPos hBCurS hSplit hRel
  induction hRel generalizing loS with
  | nil prior =>
    dsimp [tbDerivedAccessLoop]
    exact .nil prior
  | skip prior d psRest restS curT hAtD hP0 hNRD hNP hNPs _ ih_rel =>
    cases hBCurS with
    | cons _ _ hLoD _ hBSRest =>
      dsimp [tbDerivedAccessLoop]
      have hAtD' :
          (Nat.beq d.targetLocal loc && Nat.beq d.targetEpoch ep) = true := hAtD
      rw [hAtD']
      dsimp
      have hNotAll : rp_hasFst ps d.tag = false := by
        rw [← hSplit, rp_hasFst_append, hNP, hNPs]; rfl
      have hDPos : 1 ≤ d.tag := Nat.le_trans hLoPos hLoD
      have hNotAnc :=
        rp_DelegatedCopyRel_orphan_not_anc hOrig hBS hBT hDPos hNotAll
          (rp_countLe accS origS) accS accT (Nat.le_refl _)
          (bool_or_intro_right _ hAcc)
      rw [hNotAnc]
      dsimp
      have ih :=
        ih_rel (Nat.le_trans hDPos (Nat.le_succ _)) hBSRest hSplit
      cases hR1 : tbDerivedAccessLoop origS loc ep kind accS restS with
      | error k1 =>
        rw [hR1] at ih
        cases hR2 : tbDerivedAccessLoop origT loc ep kind accT curT with
        | error k2 => rw [hR2] at ih; exact ih
        | ok _ => rw [hR2] at ih; exact ih
      | ok restS' =>
        rw [hR1] at ih
        cases hR2 : tbDerivedAccessLoop origT loc ep kind accT curT with
        | error _ => rw [hR2] at ih; exact ih
        | ok curT' =>
          rw [hR2] at ih
          exact .skip prior { d with perm := tbForeignStep kind d.perm }
            psRest restS' curT'
            hAtD hP0 (rp_tbForeignStep_ne_root hNRD) hNP hNPs ih
  | cons prior nS nT ps' restS restT hAtS hAtT hPerm hNR hPar _ ih_rel =>
    cases hBCurS with
    | cons _ _ hLoN _ hBSRest =>
      dsimp [tbDerivedAccessLoop]
      have hAtS' :
          (Nat.beq nS.targetLocal loc && Nat.beq nS.targetEpoch ep) = true :=
        hAtS
      have hAtT' :
          (Nat.beq nT.targetLocal loc && Nat.beq nT.targetEpoch ep) = true :=
        hAtT
      rw [hAtS', hAtT']
      dsimp
      have hNodePair : rp_hasPair ps nS.tag nT.tag = true := by
        rw [← hSplit, rp_hasPair_append]
        apply bool_or_intro_right
        dsimp [rp_hasPair]
        exact bool_or_intro_left _
          (bool_and_intro (nat_beq_refl _) (nat_beq_refl _))
      rw [rp_DelegatedCopyRel_isAncestor_aux hOrig hBS hBT hNodePair
          (rp_countLe accS origS) accS accT (Nat.le_refl _)
          (bool_or_intro_right _ hAcc)]
      have hSplit' : (prior ++ [(nS.tag, nT.tag)]) ++ ps' = ps := by
        rw [List.append_assoc]; exact hSplit
      have ih :=
        ih_rel (Nat.le_trans (Nat.le_trans hLoPos hLoN) (Nat.le_succ _))
          hBSRest hSplit'
      cases isAncestorTag origT loc ep nT.tag accT with
      | true =>
        dsimp
        rw [hPerm]
        cases hStep : tbChildStep kind nT.perm with
        | none => rfl
        | some perm' =>
          dsimp
          have hNR' : perm' ≠ .rootOrRaw := by
            rw [hPerm] at hNR
            exact rp_tbChildStep_ne_root hNR hStep
          cases hR1 : tbDerivedAccessLoop origS loc ep kind accS restS with
          | error k1 =>
            rw [hR1] at ih
            cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
            | error k2 => rw [hR2] at ih; exact ih
            | ok _ => rw [hR2] at ih; exact ih
          | ok restS' =>
            rw [hR1] at ih
            cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
            | error _ => rw [hR2] at ih; exact ih
            | ok restT' =>
              rw [hR2] at ih
              exact .cons prior { nS with perm := perm' }
                { nT with perm := perm' } ps' restS' restT'
                hAtS hAtT rfl hNR' hPar ih
      | false =>
        dsimp
        rw [hPerm]
        have hNR' : tbForeignStep kind nT.perm ≠ .rootOrRaw := by
          rw [hPerm] at hNR
          exact rp_tbForeignStep_ne_root hNR
        cases hR1 : tbDerivedAccessLoop origS loc ep kind accS restS with
        | error k1 =>
          rw [hR1] at ih
          cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
          | error k2 => rw [hR2] at ih; exact ih
          | ok _ => rw [hR2] at ih; exact ih
        | ok restS' =>
          rw [hR1] at ih
          cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
          | error _ => rw [hR2] at ih; exact ih
          | ok restT' =>
            rw [hR2] at ih
            exact .cons prior { nS with perm := tbForeignStep kind nT.perm }
              { nT with perm := tbForeignStep kind nT.perm } ps' restS' restT'
              hAtS hAtT rfl hNR' hPar ih

private theorem rp_DelegatedCopyRel_performTbAccess {loc : LocalId} {ep : Nat}
    {ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {hiS hiT accS accT : Nat} {ty : MirTy} {kind : TbAccessKind}
    (hRel : rp_DelegatedCopyRel loc ep [] ps nsS nsT)
    (hBS : rp_NodesBounded 1 hiS nsS)
    (hBT : rp_NodesBounded 1 hiT nsT)
    (hGeS : 1 ≤ accS) (hGeT : 1 ≤ accT)
    (hAcc : rp_hasPair ps accS accT = true) :
    match performTbAccess loc ep ty kind accS nsS,
        performTbAccess loc ep ty kind accT nsT with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok nsS', .ok nsT' => rp_DelegatedCopyRel loc ep [] ps nsS' nsT'
    | _, _ => False := by
  unfold performTbAccess
  cases isZeroSizedTy ty with
  | true => exact hRel
  | false =>
    dsimp
    rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hGeS)),
        if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hGeT))]
    let ⟨hHasS, hHasT⟩ := rp_DelegatedCopyRel_hasTag hRel hAcc
    rw [hHasS, hHasT]
    dsimp
    exact rp_DelegatedCopyRel_derivedLoop hRel hBS hBT hAcc
      (Nat.le_refl 1) hBS rfl hRel

/-! ### `D2`: Reborrow Subtree (`rp_DescRel` + `rp_DelegatedReborrowRel`) -/

private inductive rp_DescRel (loc : LocalId) (ep : Nat) :
    List (Nat × Nat) → List (Nat × Nat) →
    List BorrowNode → List BorrowNode → Prop where
  | nil (prior : List (Nat × Nat)) :
      rp_DescRel loc ep prior [] [] []
  | cons (prior : List (Nat × Nat)) (nS nT : BorrowNode)
      (ps : List (Nat × Nat)) (nsS nsT : List BorrowNode)
      (hAtS : rp_nodeAt loc ep nS = true)
      (hAtT : rp_nodeAt loc ep nT = true)
      (hPerm : nS.perm = nT.perm)
      (hNR : nS.perm ≠ .rootOrRaw)
      (hPar : rp_hasPair prior nS.parentTag nT.parentTag = true)
      (hRest : rp_DescRel loc ep (prior ++ [(nS.tag, nT.tag)])
        ps nsS nsT) :
      rp_DescRel loc ep prior ((nS.tag, nT.tag) :: ps)
        (nS :: nsS) (nT :: nsT)

private inductive rp_DelegatedReborrowRel (loc : LocalId) (ep : Nat)
    (pairs : List (Nat × Nat))
    (nsS nsT : List BorrowNode) : Prop where
  | mk (srcPrefix : List BorrowNode)
      (ancTag : Nat)
      (ancPerm : BorrowPerm)
      (rootS rootT : BorrowNode)
      (descPairs : List (Nat × Nat))
      (descS descT : List BorrowNode)
      (hPairs : pairs = (rootS.tag, rootT.tag) :: descPairs)
      (hSrcEq : nsS = srcPrefix ++ (rootS :: descS))
      (hTgtEq : nsT = rootT :: descT)
      (hPrefRoot : rp_allRootParents loc ep srcPrefix)
      (hAncFind : rp_findPermAt? loc ep ancTag srcPrefix = some ancPerm)
      (hAtRootS : rp_nodeAt loc ep rootS = true)
      (hAtRootT : rp_nodeAt loc ep rootT = true)
      (hRootSPar : rootS.parentTag = ancTag)
      (hRootTPar : rootT.parentTag = 0)
      (hRootPerm : rootS.perm = rootT.perm)
      (hRootNR : rootS.perm ≠ .rootOrRaw)
      (hSubsumes : rp_permSubsumes ancPerm rootS.perm)
      (hDesc : rp_DescRel loc ep [(rootS.tag, rootT.tag)] descPairs
        descS descT) :
      rp_DelegatedReborrowRel loc ep pairs nsS nsT

private theorem rp_DescRel_to_Exact {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (h : rp_DescRel loc ep prior ps nsS nsT) :
    rp_ExactNodeRel loc ep prior ps nsS nsT := by
  induction h with
  | nil pr => exact .nil pr
  | cons pr nS nT ps' restS restT hAtS hAtT hPerm hNR hPar _ ih =>
    exact .cons pr nS nT ps' restS restT hAtS hAtT hPerm hNR
      (bool_or_intro_right _ hPar) ih

private theorem rp_DescRel_tbForeign {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (kind : TbAccessKind)
    (h : rp_DescRel loc ep prior ps nsS nsT) :
    rp_DescRel loc ep prior ps
      (tbForeignAccessAt loc ep kind nsS)
      (tbForeignAccessAt loc ep kind nsT) := by
  induction h with
  | nil pr => exact .nil pr
  | cons pr nS nT ps' restS restT hAtS hAtT hPerm hNR hPar _ ih =>
    dsimp [tbForeignAccessAt]
    have hAtS' :
        (Nat.beq nS.targetLocal loc && Nat.beq nS.targetEpoch ep) = true := hAtS
    have hAtT' :
        (Nat.beq nT.targetLocal loc && Nat.beq nT.targetEpoch ep) = true := hAtT
    rw [if_bool_true hAtS', if_bool_true hAtT']
    exact .cons pr { nS with perm := tbForeignStep kind nS.perm }
      { nT with perm := tbForeignStep kind nT.perm } ps' _ _ hAtS hAtT
      (by dsimp; rw [hPerm]) (rp_tbForeignStep_ne_root hNR) hPar ih

private theorem rp_DescRel_append_one {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (nS nT : BorrowNode)
    (h : rp_DescRel loc ep prior ps nsS nsT)
    (hAtS : rp_nodeAt loc ep nS = true)
    (hAtT : rp_nodeAt loc ep nT = true)
    (hPerm : nS.perm = nT.perm)
    (hNR : nS.perm ≠ .rootOrRaw)
    (hPar : rp_hasPair (prior ++ ps) nS.parentTag nT.parentTag = true) :
    rp_DescRel loc ep prior (ps ++ [(nS.tag, nT.tag)])
      (nsS ++ [nS]) (nsT ++ [nT]) := by
  induction h with
  | nil pr =>
    rw [List.append_nil] at hPar
    exact .cons pr nS nT [] [] [] hAtS hAtT hPerm hNR hPar
      (.nil (pr ++ [(nS.tag, nT.tag)]))
  | cons pr mS mT ps' restS restT hmAtS hmAtT hmPerm hmNR hmPar _ ih =>
    have hAssoc :
        (pr ++ [(mS.tag, mT.tag)]) ++ ps' =
          pr ++ ((mS.tag, mT.tag) :: ps') := by
      rw [List.append_assoc]; rfl
    have hPar' :
        rp_hasPair ((pr ++ [(mS.tag, mT.tag)]) ++ ps')
          nS.parentTag nT.parentTag = true := by
      rw [hAssoc]; exact hPar
    exact .cons pr mS mT (ps' ++ [(nS.tag, nT.tag)])
      (restS ++ [nS]) (restT ++ [nT])
      hmAtS hmAtT hmPerm hmNR hmPar (ih hPar')

private theorem rp_NodesBounded_split_append {lo hi : Nat}
    (xs : List BorrowNode) {y : BorrowNode} {ys : List BorrowNode}
    (h : rp_NodesBounded lo hi (xs ++ (y :: ys))) :
    rp_NodesBounded lo y.tag xs ∧ rp_NodesBounded y.tag hi (y :: ys) := by
  induction xs generalizing lo with
  | nil =>
    cases h with
    | cons _ _ hLo hP hRest =>
      exact ⟨.nil hLo, .cons y ys (Nat.le_refl _) hP hRest⟩
  | cons m ms ih =>
    cases h with
    | cons _ _ hLo hP hRest =>
      let ⟨h1, h2⟩ := ih hRest
      exact ⟨.cons m ms hLo hP h1, h2⟩

private theorem rp_findParentTagAt_append_right {loc : LocalId} {ep t lo mid : Nat}
    {xs ys : List BorrowNode}
    (hB : rp_NodesBounded lo mid xs) (hGe : mid ≤ t) :
    findParentTagAt? loc ep t (xs ++ ys) = findParentTagAt? loc ep t ys := by
  induction hB with
  | nil _ => rfl
  | cons m rest _ _ hRest ih =>
    dsimp [findParentTagAt?]
    have hMlt : m.tag < t :=
      Nat.lt_of_lt_of_le (rp_NodesBounded_le hRest) hGe
    rw [nat_beq_false_of_ne (Nat.ne_of_lt hMlt)]
    have hF :
        (Nat.beq m.targetLocal loc && Nat.beq m.targetEpoch ep && false) =
          false := by
      cases Nat.beq m.targetLocal loc && Nat.beq m.targetEpoch ep <;> rfl
    rw [if_bool_false hF]
    exact ih hGe

private theorem rp_findParentTagAt_append_left {loc : LocalId} {ep t pTag : Nat}
    {xs : List BorrowNode} (ys : List BorrowNode)
    (hF : findParentTagAt? loc ep t xs = some pTag) :
    findParentTagAt? loc ep t (xs ++ ys) = some pTag := by
  induction xs with
  | nil => cases hF
  | cons m rest ih =>
    dsimp [findParentTagAt?] at hF
    dsimp [findParentTagAt?]
    cases hCond :
        Nat.beq m.targetLocal loc && Nat.beq m.targetEpoch ep &&
          Nat.beq m.tag t with
    | true =>
      rw [if_bool_true hCond] at hF
      rw [if_bool_true rfl]
      exact hF
    | false =>
      rw [if_bool_false hCond] at hF
      rw [if_bool_false rfl]
      exact ih hF

private theorem rp_allRootParents_findPerm_perm {loc : LocalId} {ep t : Nat}
    {perm : BorrowPerm} {ns : List BorrowNode}
    (hRoot : rp_allRootParents loc ep ns)
    (hF : rp_findPermAt? loc ep t ns = some perm) :
    perm ≠ .rootOrRaw ∧ findParentTagAt? loc ep t ns = some 0 := by
  induction ns with
  | nil => cases hF
  | cons n rest ih =>
    let ⟨hAt, hP0, hNR, hRest⟩ := hRoot
    dsimp [rp_findPermAt?] at hF
    dsimp [findParentTagAt?]
    change perm ≠ .rootOrRaw ∧
      (if rp_nodeAt loc ep n && Nat.beq n.tag t then some n.parentTag
        else findParentTagAt? loc ep t rest) = some 0
    cases hCond : rp_nodeAt loc ep n && Nat.beq n.tag t with
    | true =>
      rw [if_bool_true hCond] at hF
      rw [if_bool_true rfl]
      injection hF with hEq; subst hEq
      rw [hP0]
      exact ⟨hNR, rfl⟩
    | false =>
      rw [if_bool_false hCond] at hF
      rw [if_bool_false rfl]
      exact ih hRest hF

private theorem rp_DescRel_findParent {loc : LocalId} {ep : Nat}
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {loS hiS loT hiT tS tT : Nat}
    (hRel : rp_DescRel loc ep prior ps nsS nsT)
    (hBS : rp_NodesBounded loS hiS nsS)
    (hBT : rp_NodesBounded loT hiT nsT)
    (hPair : rp_hasPair ps tS tT = true) :
    ∃ pS pT,
      findParentTagAt? loc ep tS nsS = some pS ∧
      findParentTagAt? loc ep tT nsT = some pT ∧
      rp_hasPair (prior ++ ps) pS pT = true := by
  induction hRel generalizing loS loT with
  | nil _ => cases hPair
  | cons pr nS nT ps' restS restT hAtS hAtT _ _ hPar _ ih =>
    cases hBS with
    | cons _ _ _ _ hBSRest =>
      cases hBT with
      | cons _ _ _ _ hBTRest =>
        dsimp [rp_hasPair] at hPair
        dsimp [findParentTagAt?]
        change ∃ pS pT,
          (if rp_nodeAt loc ep nS && Nat.beq nS.tag tS then some nS.parentTag
            else findParentTagAt? loc ep tS restS) = some pS ∧
          (if rp_nodeAt loc ep nT && Nat.beq nT.tag tT then some nT.parentTag
            else findParentTagAt? loc ep tT restT) = some pT ∧ _
        rw [hAtS, hAtT]
        change ∃ pS pT,
          (if Nat.beq nS.tag tS = true then some nS.parentTag
            else findParentTagAt? loc ep tS restS) = some pS ∧
          (if Nat.beq nT.tag tT = true then some nT.parentTag
            else findParentTagAt? loc ep tT restT) = some pT ∧ _
        cases hHead : Nat.beq nS.tag tS && Nat.beq nT.tag tT with
        | true =>
          let ⟨hEqS, hEqT⟩ := bool_and_true hHead
          rw [if_bool_true hEqS, if_bool_true hEqT]
          refine ⟨nS.parentTag, nT.parentTag, rfl, rfl, ?_⟩
          rw [rp_hasPair_append]
          exact bool_or_intro_left _ hPar
        | false =>
          rw [hHead] at hPair
          change rp_hasPair ps' tS tT = true at hPair
          let ⟨pS, pT, hfS, hfT, hParOk⟩ := ih hBSRest hBTRest hPair
          let ⟨_, hLoS2, _⟩ := rp_findParentTagAt_bounds hBSRest hfS
          let ⟨_, hLoT2, _⟩ := rp_findParentTagAt_bounds hBTRest hfT
          rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hLoS2)),
              if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hLoT2))]
          have hAssoc :
              (pr ++ [(nS.tag, nT.tag)]) ++ ps' =
                pr ++ ((nS.tag, nT.tag) :: ps') := by
            rw [List.append_assoc]; rfl
          rw [hAssoc] at hParOk
          exact ⟨pS, pT, hfS, hfT, hParOk⟩

private theorem rp_DelegatedReborrowRel_tbForeign {loc : LocalId} {ep : Nat}
    {pairs : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (kind : TbAccessKind)
    (h : rp_DelegatedReborrowRel loc ep pairs nsS nsT) :
    rp_DelegatedReborrowRel loc ep pairs
      (tbForeignAccessAt loc ep kind nsS)
      (tbForeignAccessAt loc ep kind nsT) := by
  let ⟨pref, ancT, ancP, rS, rT, dPs, dS, dT, hPs, hSEq, hTEq,
       hPRoot, hAFind, hAtRS, hAtRT, hRSPar, hRTPar, hRPerm, hRNR,
       hSub, hDesc⟩ := h
  have ⟨hAncNR, _⟩ := rp_allRootParents_findPerm_perm hPRoot hAFind
  have hForeignApp : ∀ xs ys : List BorrowNode,
      tbForeignAccessAt loc ep kind (xs ++ ys) =
        tbForeignAccessAt loc ep kind xs ++
          tbForeignAccessAt loc ep kind ys := by
    intro xs ys
    induction xs with
    | nil => rfl
    | cons m ms ihm =>
      dsimp [tbForeignAccessAt]
      rw [ihm]
  rw [hSEq, hTEq, hForeignApp]
  dsimp [tbForeignAccessAt]
  have hAtRS' :
      (Nat.beq rS.targetLocal loc && Nat.beq rS.targetEpoch ep) = true :=
    hAtRS
  have hAtRT' :
      (Nat.beq rT.targetLocal loc && Nat.beq rT.targetEpoch ep) = true :=
    hAtRT
  rw [if_bool_true hAtRS', if_bool_true hAtRT']
  exact .mk
    (tbForeignAccessAt loc ep kind pref)
    ancT
    (tbForeignStep kind ancP)
    { rS with perm := tbForeignStep kind rS.perm }
    { rT with perm := tbForeignStep kind rT.perm }
    dPs
    (tbForeignAccessAt loc ep kind dS)
    (tbForeignAccessAt loc ep kind dT)
    hPs rfl rfl
    (rp_allRootParents_tbForeign hPRoot)
    (rp_findPermAt_tbForeign kind hAFind)
    hAtRS hAtRT hRSPar hRTPar
    (by dsimp; rw [hRPerm])
    (rp_tbForeignStep_ne_root hRNR)
    (rp_permSubsumes_foreign hAncNR hSub)
    (rp_DescRel_tbForeign kind hDesc)

private theorem rp_DelegatedReborrowRel_append_one {loc : LocalId} {ep : Nat}
    {pairs : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (nS nT : BorrowNode)
    (h : rp_DelegatedReborrowRel loc ep pairs nsS nsT)
    (hAtS : rp_nodeAt loc ep nS = true)
    (hAtT : rp_nodeAt loc ep nT = true)
    (hPerm : nS.perm = nT.perm)
    (hNR : nS.perm ≠ .rootOrRaw)
    (hPar : rp_hasPair pairs nS.parentTag nT.parentTag = true) :
    rp_DelegatedReborrowRel loc ep (pairs ++ [(nS.tag, nT.tag)])
      (nsS ++ [nS]) (nsT ++ [nT]) := by
  let ⟨pref, ancT, ancP, rS, rT, dPs, dS, dT, hPs, hSEq, hTEq,
       hPRoot, hAFind, hAtRS, hAtRT, hRSPar, hRTPar, hRPerm, hRNR,
       hSub, hDesc⟩ := h
  rw [hPs] at hPar
  exact .mk
    pref ancT ancP rS rT
    (dPs ++ [(nS.tag, nT.tag)])
    (dS ++ [nS])
    (dT ++ [nT])
    (by rw [hPs]; rfl)
    (by rw [hSEq, List.append_assoc]; rfl)
    (by rw [hTEq]; rfl)
    hPRoot hAFind hAtRS hAtRT hRSPar hRTPar hRPerm hRNR hSub
    (rp_DescRel_append_one nS nT hDesc hAtS hAtT hPerm hNR hPar)

private theorem rp_isAncestorTag_false_of_gt {ns : List BorrowNode}
    {loc : LocalId} {ep anc lo hi : Nat}
    (hB : rp_NodesBounded lo hi ns) :
    ∀ (k cur : Nat),
      rp_countLe cur ns ≤ k →
      cur < anc →
      isAncestorTag ns loc ep anc cur = false
  | k, cur, hCnt, hLt => by
    rw [rp_isAncestorTag_unfold hB]
    rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hLt))]
    cases Nat.beq cur 0 with
    | true => rfl
    | false =>
      dsimp
      cases hf : findParentTagAt? loc ep cur ns with
      | none => rfl
      | some pTag =>
        let ⟨hPLt, _, _⟩ := rp_findParentTagAt_bounds hB hf
        have hStep := rp_countLe_step hB hf
        cases k with
        | zero => cases Nat.le_trans hStep hCnt
        | succ k' =>
          exact rp_isAncestorTag_false_of_gt hB k' pTag
            (Nat.le_of_succ_le_succ (Nat.le_trans hStep hCnt))
            (Nat.lt_trans hPLt hLt)

private theorem rp_DescRel_to_Exact_prepend {loc : LocalId} {ep : Nat}
    (extra : List (Nat × Nat))
    {prior ps : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    (h : rp_DescRel loc ep prior ps nsS nsT) :
    rp_ExactNodeRel loc ep (extra ++ prior) ps nsS nsT := by
  induction h with
  | nil pr => exact .nil (extra ++ pr)
  | cons pr nS nT ps' restS restT hAtS hAtT hPerm hNR hPar _ ih =>
    have hParOk :
        rp_parentPairOk (extra ++ pr) nS.parentTag nT.parentTag = true := by
      unfold rp_parentPairOk
      rw [rp_hasPair_append]
      exact bool_or_intro_right _ (bool_or_intro_right _ hPar)
    have hEq :
        (extra ++ pr) ++ [(nS.tag, nT.tag)] =
          extra ++ (pr ++ [(nS.tag, nT.tag)]) := by
      rw [List.append_assoc]
    exact .cons (extra ++ pr) nS nT ps' restS restT hAtS hAtT hPerm hNR
      hParOk (hEq ▸ ih)

private theorem rp_hasBorrowTagAt_append (loc : LocalId) (ep t : Nat) :
    ∀ xs ys : List BorrowNode,
      hasBorrowTagAt loc ep t (xs ++ ys) =
        (hasBorrowTagAt loc ep t xs || hasBorrowTagAt loc ep t ys)
  | [], _ => rfl
  | n :: xs, ys => by
    dsimp [hasBorrowTagAt]
    rw [rp_hasBorrowTagAt_append loc ep t xs ys, Bool.or_assoc]

private theorem rp_DelegatedReborrowRel_hasTag {loc : LocalId} {ep : Nat}
    {pairs : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {tS tT : Nat}
    (h : rp_DelegatedReborrowRel loc ep pairs nsS nsT)
    (hPair : rp_hasPair pairs tS tT = true) :
    hasBorrowTagAt loc ep tS nsS = true ∧
      hasBorrowTagAt loc ep tT nsT = true := by
  let ⟨pref, _, _, rS, rT, dPs, dS, dT, hPs, hSEq, hTEq,
       _, _, hAtRS, hAtRT, _, _, hRPerm, hRNR, _, hDesc⟩ := h
  rw [hPs] at hPair
  have hRootParOk :
      rp_parentPairOk [(rS.parentTag, rT.parentTag)]
        rS.parentTag rT.parentTag = true := by
    unfold rp_parentPairOk
    dsimp [rp_hasPair]
    exact bool_or_intro_right _
      (bool_or_intro_left _
        (bool_and_intro (nat_beq_refl _) (nat_beq_refl _)))
  have hEx : rp_ExactNodeRel loc ep [(rS.parentTag, rT.parentTag)]
      ((rS.tag, rT.tag) :: dPs) (rS :: dS) (rT :: dT) :=
    .cons [(rS.parentTag, rT.parentTag)] rS rT dPs dS dT
      hAtRS hAtRT hRPerm hRNR hRootParOk
      (rp_DescRel_to_Exact_prepend [(rS.parentTag, rT.parentTag)] hDesc)
  let ⟨hHasSubS, hHasT⟩ := rp_ExactNodeRel_hasTag hEx hPair
  rw [hSEq, hTEq, rp_hasBorrowTagAt_append]
  exact ⟨bool_or_intro_right _ hHasSubS, hHasT⟩

private theorem rp_DelegatedReborrowRel_ancestry {loc : LocalId} {ep : Nat}
    {pairs : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {hiS hiT : Nat}
    {pref : List BorrowNode} {ancT : Nat} {ancP : BorrowPerm}
    {rS rT : BorrowNode} {dPs : List (Nat × Nat)}
    {dS dT : List BorrowNode}
    (hPs : pairs = (rS.tag, rT.tag) :: dPs)
    (hSEq : nsS = pref ++ (rS :: dS))
    (hTEq : nsT = rT :: dT)
    (hPRoot : rp_allRootParents loc ep pref)
    (hAFind : rp_findPermAt? loc ep ancT pref = some ancP)
    (hAtRS : rp_nodeAt loc ep rS = true)
    (hAtRT : rp_nodeAt loc ep rT = true)
    (hRSPar : rS.parentTag = ancT)
    (hRTPar : rT.parentTag = 0)
    (hRPerm : rS.perm = rT.perm)
    (hRNR : rS.perm ≠ .rootOrRaw)
    (hSub : rp_permSubsumes ancP rS.perm)
    (hDesc : rp_DescRel loc ep [(rS.tag, rT.tag)] dPs dS dT)
    (hBS : rp_NodesBounded 1 hiS nsS)
    (hBT : rp_NodesBounded 1 hiT nsT) :
    ∀ (k curS curT : Nat),
      rp_countLe curS nsS ≤ k →
      rp_hasPair pairs curS curT = true →
      isAncestorTag nsS loc ep rS.tag curS = true ∧
      isAncestorTag nsT loc ep rT.tag curT = true ∧
      isAncestorTag nsS loc ep ancT curS = true ∧
      (∀ dTag, 1 ≤ dTag → dTag < rS.tag →
        isAncestorTag nsS loc ep dTag curS = Nat.beq dTag ancT) ∧
      (∀ pS pT, rp_hasPair pairs pS pT = true →
        isAncestorTag nsS loc ep pS curS =
          isAncestorTag nsT loc ep pT curT)
  | k, curS, curT, hCnt, hCur => by
    have hBS_eq : rp_NodesBounded 1 hiS (pref ++ (rS :: dS)) := hSEq ▸ hBS
    let ⟨hBPref, hBRS⟩ := rp_NodesBounded_split_append pref hBS_eq
    have hBT_eq : rp_NodesBounded 1 hiT (rT :: dT) := hTEq ▸ hBT
    cases hBRS with
    | cons _ _ _ _ hBDS =>
      cases hBT_eq with
      | cons _ _ hRTGe1 _ hBDT =>
        have ⟨hAncGe1, hAncLtRS⟩ := rp_findPermAt_bounds hBPref hAFind
        have hRSGe1 : 1 ≤ rS.tag := Nat.le_trans hAncGe1 (Nat.le_of_lt hAncLtRS)
        have ⟨_, hAncPar0⟩ := rp_allRootParents_findPerm_perm hPRoot hAFind
        have hFindAncS : findParentTagAt? loc ep ancT nsS = some 0 := by
          rw [hSEq]
          exact rp_findParentTagAt_append_left (rS :: dS) hAncPar0
        have hFindRS : findParentTagAt? loc ep rS.tag nsS = some ancT := by
          rw [hSEq, rp_findParentTagAt_append_right hBPref (Nat.le_refl _)]
          dsimp [findParentTagAt?]
          have hAtRS' :
              (Nat.beq rS.targetLocal loc && Nat.beq rS.targetEpoch ep &&
                Nat.beq rS.tag rS.tag) = true :=
            bool_and_intro hAtRS (nat_beq_refl _)
          rw [if_bool_true hAtRS', hRSPar]
        have hRootParOk :
            rp_parentPairOk [(rS.parentTag, rT.parentTag)]
              rS.parentTag rT.parentTag = true := by
          unfold rp_parentPairOk
          dsimp [rp_hasPair]
          exact bool_or_intro_right _
            (bool_or_intro_left _
              (bool_and_intro (nat_beq_refl _) (nat_beq_refl _)))
        have hExSub : rp_ExactNodeRel loc ep [(rS.parentTag, rT.parentTag)]
            ((rS.tag, rT.tag) :: dPs) (rS :: dS) (rT :: dT) :=
          .cons [(rS.parentTag, rT.parentTag)] rS rT dPs dS dT
            hAtRS hAtRT hRPerm hRNR hRootParOk
            (rp_DescRel_to_Exact_prepend [(rS.parentTag, rT.parentTag)] hDesc)
        have hBRSFull : rp_NodesBounded rS.tag hiS (rS :: dS) :=
          .cons rS dS (Nat.le_refl _) (hRSPar ▸ hAncLtRS) hBDS
        have hBRTFull : rp_NodesBounded 1 hiT (rT :: dT) := hTEq ▸ hBT
        have hCurP : rp_hasPair ((rS.tag, rT.tag) :: dPs) curS curT = true :=
          hPs ▸ hCur
        dsimp [rp_hasPair] at hCurP
        cases bool_or_true hCurP with
        | inl hHead =>
          let ⟨hEqS, hEqT⟩ := bool_and_true hHead
          have eS := nat_beq_eq hEqS; subst eS
          have eT := nat_beq_eq hEqT; subst eT
          have h1 : isAncestorTag nsS loc ep rS.tag rS.tag = true :=
            rp_isAncestorTag_refl
          have h2 : isAncestorTag nsT loc ep rT.tag rT.tag = true :=
            rp_isAncestorTag_refl
          have h3 : isAncestorTag nsS loc ep ancT rS.tag = true := by
            rw [rp_isAncestorTag_unfold hBS,
                if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hAncLtRS)),
                if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hRSGe1)),
                hFindRS]
            exact rp_isAncestorTag_refl
          have h4 : ∀ dTag, 1 ≤ dTag → dTag < rS.tag →
              isAncestorTag nsS loc ep dTag rS.tag = Nat.beq dTag ancT := by
            intro dTag hDGe1 hDLt
            rw [rp_isAncestorTag_unfold hBS,
                if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hDLt)),
                if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hRSGe1)),
                hFindRS]
            dsimp
            rw [rp_isAncestorTag_unfold hBS]
            cases Nat.beq dTag ancT with
            | true => rfl
            | false =>
              rw [if_bool_false rfl,
                  if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hAncGe1)),
                  hFindAncS]
              dsimp
              rw [rp_isAncestorTag_unfold hBS,
                  if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hDGe1))]
              rfl
          have h5 : ∀ pS pT, rp_hasPair pairs pS pT = true →
              isAncestorTag nsS loc ep pS rS.tag =
                isAncestorTag nsT loc ep pT rT.tag := by
            intro pS pT hp
            rw [hPs] at hp
            dsimp [rp_hasPair] at hp
            cases bool_or_true hp with
            | inl hpH =>
              let ⟨hpS, hpT⟩ := bool_and_true hpH
              have epS := nat_beq_eq hpS; subst epS
              have epT := nat_beq_eq hpT; subst epT
              rw [rp_isAncestorTag_refl, rp_isAncestorTag_refl]
            | inr hpTail =>
              let ⟨_, _, hfPS, hfPT, _⟩ :=
                rp_DescRel_findParent hDesc hBDS hBDT hpTail
              let ⟨_, hLtPS, _⟩ := rp_findParentTagAt_bounds hBDS hfPS
              let ⟨_, hLtPT, _⟩ := rp_findParentTagAt_bounds hBDT hfPT
              rw [rp_isAncestorTag_false_of_gt hBS
                    (rp_countLe rS.tag nsS) rS.tag (Nat.le_refl _) hLtPS,
                  rp_isAncestorTag_false_of_gt hBT
                    (rp_countLe rT.tag nsT) rT.tag (Nat.le_refl _) hLtPT]
          exact ⟨h1, h2, h3, h4, h5⟩
        | inr hTail =>
          let ⟨parS, parT, hfDS, hfDT, hParIn⟩ :=
            rp_DescRel_findParent hDesc hBDS hBDT hTail
          let ⟨_, hRSLtCur, _⟩ := rp_findParentTagAt_bounds hBDS hfDS
          let ⟨_, hRTLtCur, _⟩ := rp_findParentTagAt_bounds hBDT hfDT
          have hCurSGe1 : 1 ≤ curS :=
            Nat.le_trans hRSGe1 (Nat.le_of_lt hRSLtCur)
          have hCurTGe1 : 1 ≤ curT :=
            Nat.le_trans hRTGe1 (Nat.le_of_lt hRTLtCur)
          have hFindCurS : findParentTagAt? loc ep curS nsS = some parS := by
            rw [hSEq,
                rp_findParentTagAt_append_right hBPref (Nat.le_of_lt hRSLtCur)]
            dsimp [findParentTagAt?]
            rw [nat_beq_false_of_ne (Nat.ne_of_lt hRSLtCur)]
            have hF :
                (Nat.beq rS.targetLocal loc && Nat.beq rS.targetEpoch ep &&
                  false) = false := by
              cases Nat.beq rS.targetLocal loc && Nat.beq rS.targetEpoch ep <;>
                rfl
            rw [if_bool_false hF]
            exact hfDS
          have hFindCurT : findParentTagAt? loc ep curT nsT = some parT := by
            rw [hTEq]
            dsimp [findParentTagAt?]
            rw [nat_beq_false_of_ne (Nat.ne_of_lt hRTLtCur)]
            have hF :
                (Nat.beq rT.targetLocal loc && Nat.beq rT.targetEpoch ep &&
                  false) = false := by
              cases Nat.beq rT.targetLocal loc && Nat.beq rT.targetEpoch ep <;>
                rfl
            rw [if_bool_false hF]
            exact hfDT
          have hParPairs : rp_hasPair pairs parS parT = true := by
            rw [hPs]; exact hParIn
          have hStepCnt := rp_countLe_step hBS hFindCurS
          cases k with
          | zero => cases Nat.le_trans hStepCnt hCnt
          | succ k' =>
            have hCntPar : rp_countLe parS nsS ≤ k' :=
              Nat.le_of_succ_le_succ (Nat.le_trans hStepCnt hCnt)
            let ⟨ih1, ih2, ih3, ih4, ih5⟩ :=
              rp_DelegatedReborrowRel_ancestry
                hPs hSEq hTEq hPRoot hAFind hAtRS hAtRT hRSPar hRTPar
                hRPerm hRNR hSub hDesc
                hBS hBT k' parS parT hCntPar hParPairs
            have h1 : isAncestorTag nsS loc ep rS.tag curS = true := by
              rw [rp_isAncestorTag_unfold hBS,
                  if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hRSLtCur)),
                  if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurSGe1)),
                  hFindCurS]
              exact ih1
            have h2 : isAncestorTag nsT loc ep rT.tag curT = true := by
              rw [rp_isAncestorTag_unfold hBT,
                  if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hRTLtCur)),
                  if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurTGe1)),
                  hFindCurT]
              exact ih2
            have h3 : isAncestorTag nsS loc ep ancT curS = true := by
              rw [rp_isAncestorTag_unfold hBS,
                  if_bool_false (nat_beq_false_of_ne
                    (Nat.ne_of_lt (Nat.lt_trans hAncLtRS hRSLtCur))),
                  if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurSGe1)),
                  hFindCurS]
              exact ih3
            have h4 : ∀ dTag, 1 ≤ dTag → dTag < rS.tag →
                isAncestorTag nsS loc ep dTag curS = Nat.beq dTag ancT := by
              intro dTag hDGe1 hDLt
              rw [rp_isAncestorTag_unfold hBS,
                  if_bool_false (nat_beq_false_of_ne
                    (Nat.ne_of_lt (Nat.lt_trans hDLt hRSLtCur))),
                  if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurSGe1)),
                  hFindCurS]
              exact ih4 dTag hDGe1 hDLt
            have h5 : ∀ pS pT, rp_hasPair pairs pS pT = true →
                isAncestorTag nsS loc ep pS curS =
                  isAncestorTag nsT loc ep pT curT := by
              intro pS pT hp
              have hpSub : rp_hasPair ((rS.tag, rT.tag) :: dPs) pS pT = true :=
                hPs ▸ hp
              have hBeqEq :=
                rp_ExactNodeRel_pair_inj hExSub hBRSFull hBRTFull hpSub hCurP
              rw [rp_isAncestorTag_unfold hBS, rp_isAncestorTag_unfold hBT,
                  hBeqEq]
              cases Nat.beq pT curT with
              | true => rfl
              | false =>
                rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurSGe1)),
                    if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hCurTGe1)),
                    hFindCurS, hFindCurT]
                exact ih5 pS pT hp
            exact ⟨h1, h2, h3, h4, h5⟩

private theorem rp_tbDerivedAccessLoop_error_undefined {origNodes : List BorrowNode}
    {loc : LocalId} {ep : Nat} {kind : TbAccessKind} {acc : Nat} :
    ∀ {cur : List BorrowNode} {k : FaultKind},
      tbDerivedAccessLoop origNodes loc ep kind acc cur = .error k →
      k = .undefined
  | [], _, h => by cases h
  | n :: ns, k, h => by
    dsimp [tbDerivedAccessLoop] at h
    cases hAt : !(Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) with
    | true =>
      rw [hAt] at h; dsimp at h
      cases hRec : tbDerivedAccessLoop origNodes loc ep kind acc ns with
      | ok _ => rw [hRec] at h; cases h
      | error k' =>
        rw [hRec] at h
        injection h with hEq; subst hEq
        exact rp_tbDerivedAccessLoop_error_undefined hRec
    | false =>
      rw [hAt] at h; dsimp at h
      cases hAnc : isAncestorTag origNodes loc ep n.tag acc with
      | true =>
        rw [hAnc] at h; dsimp at h
        cases hStep : tbChildStep kind n.perm with
        | none => rw [hStep] at h; injection h with hEq; exact hEq.symm
        | some _ =>
          rw [hStep] at h; dsimp at h
          cases hRec : tbDerivedAccessLoop origNodes loc ep kind acc ns with
          | ok _ => rw [hRec] at h; cases h
          | error k' =>
            rw [hRec] at h
            injection h with hEq; subst hEq
            exact rp_tbDerivedAccessLoop_error_undefined hRec
      | false =>
        rw [hAnc] at h; dsimp at h
        cases hRec : tbDerivedAccessLoop origNodes loc ep kind acc ns with
        | ok _ => rw [hRec] at h; cases h
        | error k' =>
          rw [hRec] at h
          injection h with hEq; subst hEq
          exact rp_tbDerivedAccessLoop_error_undefined hRec

private theorem rp_tbDerivedAccessLoop_append (origNodes : List BorrowNode)
    (loc : LocalId) (ep : Nat) (kind : TbAccessKind) (acc : Nat) :
    ∀ (xs ys : List BorrowNode),
      tbDerivedAccessLoop origNodes loc ep kind acc (xs ++ ys) =
        match tbDerivedAccessLoop origNodes loc ep kind acc xs with
        | .error k => .error k
        | .ok xs' =>
          match tbDerivedAccessLoop origNodes loc ep kind acc ys with
          | .error k => .error k
          | .ok ys' => .ok (xs' ++ ys')
  | [], _ => by dsimp [tbDerivedAccessLoop]; cases tbDerivedAccessLoop origNodes loc ep kind acc _ <;> rfl
  | n :: xs, ys => by
    dsimp [tbDerivedAccessLoop]
    rw [rp_tbDerivedAccessLoop_append origNodes loc ep kind acc xs ys]
    cases !(Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) with
    | true =>
      dsimp
      cases tbDerivedAccessLoop origNodes loc ep kind acc xs with
      | error _ => rfl
      | ok _ =>
        dsimp
        cases tbDerivedAccessLoop origNodes loc ep kind acc ys <;> rfl
    | false =>
      dsimp
      cases isAncestorTag origNodes loc ep n.tag acc with
      | true =>
        dsimp
        cases tbChildStep kind n.perm with
        | none => rfl
        | some _ =>
          dsimp
          cases tbDerivedAccessLoop origNodes loc ep kind acc xs with
          | error _ => rfl
          | ok _ =>
            dsimp
            cases tbDerivedAccessLoop origNodes loc ep kind acc ys <;> rfl
      | false =>
        dsimp
        cases tbDerivedAccessLoop origNodes loc ep kind acc xs with
        | error _ => rfl
        | ok _ =>
          dsimp
          cases tbDerivedAccessLoop origNodes loc ep kind acc ys <;> rfl

private theorem rp_DelegatedReborrowRel_prefixLoop {loc : LocalId} {ep hi tagR : Nat}
    {origNodes : List BorrowNode} {kind : TbAccessKind} {accS : Nat}
    {permR permR' : BorrowPerm}
    (hAncEq : ∀ dTag, 1 ≤ dTag → dTag < hi →
      isAncestorTag origNodes loc ep dTag accS = Nat.beq dTag tagR)
    (hStepR : tbChildStep kind permR = some permR') :
    ∀ {lo : Nat} {curNodes : List BorrowNode},
      1 ≤ lo →
      rp_NodesBounded lo hi curNodes →
      rp_allRootParents loc ep curNodes →
      (∀ p, rp_findPermAt? loc ep tagR curNodes = some p → p = permR) →
      ∃ curNodes',
        tbDerivedAccessLoop origNodes loc ep kind accS curNodes =
          .ok curNodes' ∧
        rp_allRootParents loc ep curNodes' ∧
        (rp_findPermAt? loc ep tagR curNodes = some permR →
          rp_findPermAt? loc ep tagR curNodes' = some permR')
  | _, [], _, _, _, _ =>
    ⟨[], rfl, True.intro, fun h => by cases h⟩
  | lo, n :: rest, hLoPos, .cons _ _ hLo _ hBRest,
      ⟨hAt, hP0, hNR, hRootRest⟩, hPermMatch => by
    dsimp [tbDerivedAccessLoop]
    have hAt' :
        (Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) = true := hAt
    rw [hAt']
    dsimp
    have hNPos : 1 ≤ n.tag := Nat.le_trans hLoPos hLo
    have hNLt : n.tag < hi := rp_NodesBounded_le hBRest
    rw [hAncEq n.tag hNPos hNLt]
    cases hTagEq : Nat.beq n.tag tagR with
    | true =>
      dsimp
      have hFindHere :
          rp_findPermAt? loc ep tagR (n :: rest) = some n.perm := by
        dsimp [rp_findPermAt?]
        rw [if_bool_true (bool_and_intro hAt hTagEq)]
      have hnPerm : n.perm = permR := hPermMatch n.perm hFindHere
      rw [hnPerm, hStepR]
      dsimp
      have hNoneRest : rp_findPermAt? loc ep tagR rest = none := by
        have htEq := nat_beq_eq hTagEq; subst htEq
        exact rp_findPermAt_none_of_lt hBRest (Nat.lt_succ_self _)
      let ⟨rest', hLoopRest, hRootRest', _⟩ :=
        rp_DelegatedReborrowRel_prefixLoop hAncEq hStepR
          (Nat.le_trans hNPos (Nat.le_succ _)) hBRest hRootRest
          (fun p hp => by rw [hNoneRest] at hp; cases hp)
      rw [hLoopRest]
      refine ⟨_, rfl,
        ⟨hAt, hP0, rp_tbChildStep_ne_root (hnPerm ▸ hNR) hStepR,
          hRootRest'⟩, ?_⟩
      intro _
      dsimp [rp_findPermAt?]
      have hCond' :
          (rp_nodeAt loc ep { n with perm := permR' } &&
            Nat.beq n.tag tagR) = true := bool_and_intro hAt hTagEq
      rw [if_bool_true hCond']
    | false =>
      dsimp
      have hFindStep :
          rp_findPermAt? loc ep tagR (n :: rest) =
            rp_findPermAt? loc ep tagR rest := by
        dsimp [rp_findPermAt?]
        have hCondF : (rp_nodeAt loc ep n && Nat.beq n.tag tagR) = false := by
          rw [hAt, hTagEq]; rfl
        rw [if_bool_false hCondF]
      let ⟨rest', hLoopRest, hRootRest', hFindRest'⟩ :=
        rp_DelegatedReborrowRel_prefixLoop hAncEq hStepR
          (Nat.le_trans hNPos (Nat.le_succ _)) hBRest hRootRest
          (fun p hp => hPermMatch p (hFindStep.trans hp))
      rw [hLoopRest]
      refine ⟨_, rfl,
        ⟨hAt, hP0, rp_tbForeignStep_ne_root hNR, hRootRest'⟩, ?_⟩
      intro hF
      rw [hFindStep] at hF
      dsimp [rp_findPermAt?]
      have hCondF' :
          (rp_nodeAt loc ep { n with perm := tbForeignStep kind n.perm } &&
            Nat.beq n.tag tagR) = false := by
        change (rp_nodeAt loc ep n && Nat.beq n.tag tagR) = false
        rw [hAt, hTagEq]; rfl
      rw [if_bool_false hCondF']
      exact hFindRest' hF

private theorem rp_DelegatedReborrowRel_descLoop {loc : LocalId} {ep : Nat}
    {allPairs : List (Nat × Nat)} {origS origT : List BorrowNode}
    {accS accT : Nat} {kind : TbAccessKind}
    (hPairAnc : ∀ pS pT, rp_hasPair allPairs pS pT = true →
      isAncestorTag origS loc ep pS accS =
        isAncestorTag origT loc ep pT accT) :
    ∀ {prior psRest : List (Nat × Nat)} {curS curT : List BorrowNode},
      prior ++ psRest = allPairs →
      rp_DescRel loc ep prior psRest curS curT →
      match tbDerivedAccessLoop origS loc ep kind accS curS,
          tbDerivedAccessLoop origT loc ep kind accT curT with
      | .error k₁, .error k₂ => k₁ = k₂
      | .ok curS', .ok curT' =>
        rp_DescRel loc ep prior psRest curS' curT'
      | _, _ => False := by
  intro prior psRest curS curT hSplit hRel
  induction hRel with
  | nil prior =>
    dsimp [tbDerivedAccessLoop]
    exact .nil prior
  | cons prior nS nT ps' restS restT hAtS hAtT hPerm hNR hPar _ ih_rel =>
    dsimp [tbDerivedAccessLoop]
    have hAtS' :
        (Nat.beq nS.targetLocal loc && Nat.beq nS.targetEpoch ep) = true := hAtS
    have hAtT' :
        (Nat.beq nT.targetLocal loc && Nat.beq nT.targetEpoch ep) = true := hAtT
    rw [hAtS', hAtT']
    dsimp
    have hInAll : rp_hasPair allPairs nS.tag nT.tag = true := by
      rw [← hSplit, rp_hasPair_append]
      apply bool_or_intro_right
      dsimp [rp_hasPair]
      exact bool_or_intro_left _
        (bool_and_intro (nat_beq_refl _) (nat_beq_refl _))
    rw [hPairAnc nS.tag nT.tag hInAll]
    have hSplit' : (prior ++ [(nS.tag, nT.tag)]) ++ ps' = allPairs := by
      rw [List.append_assoc]; exact hSplit
    have ih := ih_rel hSplit'
    cases isAncestorTag origT loc ep nT.tag accT with
    | true =>
      dsimp
      rw [hPerm]
      cases hStep : tbChildStep kind nT.perm with
      | none => rfl
      | some perm' =>
        dsimp
        have hNR' : perm' ≠ .rootOrRaw := by
          rw [hPerm] at hNR
          exact rp_tbChildStep_ne_root hNR hStep
        cases hR1 : tbDerivedAccessLoop origS loc ep kind accS restS with
        | error _ =>
          rw [hR1] at ih
          cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT <;>
            (rw [hR2] at ih; exact ih)
        | ok restS' =>
          rw [hR1] at ih
          cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
          | error _ => rw [hR2] at ih; exact ih
          | ok restT' =>
            rw [hR2] at ih
            exact .cons prior { nS with perm := perm' }
              { nT with perm := perm' } ps' restS' restT'
              hAtS hAtT rfl hNR' hPar ih
    | false =>
      dsimp
      rw [hPerm]
      have hNR' : tbForeignStep kind nT.perm ≠ .rootOrRaw := by
        rw [hPerm] at hNR
        exact rp_tbForeignStep_ne_root hNR
      cases hR1 : tbDerivedAccessLoop origS loc ep kind accS restS with
      | error _ =>
        rw [hR1] at ih
        cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT <;>
          (rw [hR2] at ih; exact ih)
      | ok restS' =>
        rw [hR1] at ih
        cases hR2 : tbDerivedAccessLoop origT loc ep kind accT restT with
        | error _ => rw [hR2] at ih; exact ih
        | ok restT' =>
          rw [hR2] at ih
          exact .cons prior { nS with perm := tbForeignStep kind nT.perm }
            { nT with perm := tbForeignStep kind nT.perm } ps' restS' restT'
            hAtS hAtT rfl hNR' hPar ih

private theorem rp_DelegatedReborrowRel_performTbAccess {loc : LocalId} {ep : Nat}
    {pairs : List (Nat × Nat)} {nsS nsT : List BorrowNode}
    {hiS hiT accS accT : Nat} {ty : MirTy} {kind : TbAccessKind}
    (h : rp_DelegatedReborrowRel loc ep pairs nsS nsT)
    (hBS : rp_NodesBounded 1 hiS nsS)
    (hBT : rp_NodesBounded 1 hiT nsT)
    (hGeS : 1 ≤ accS) (hGeT : 1 ≤ accT)
    (hAcc : rp_hasPair pairs accS accT = true) :
    match performTbAccess loc ep ty kind accS nsS,
        performTbAccess loc ep ty kind accT nsT with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok nsS', .ok nsT' => rp_DelegatedReborrowRel loc ep pairs nsS' nsT'
    | _, _ => False := by
  unfold performTbAccess
  cases isZeroSizedTy ty with
  | true => exact h
  | false =>
    dsimp
    rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hGeS)),
        if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hGeT))]
    let ⟨hHasS, hHasT⟩ := rp_DelegatedReborrowRel_hasTag h hAcc
    rw [hHasS, hHasT]
    dsimp
    let ⟨pref, ancT, ancP, rS, rT, dPs, dS, dT, hPs, hSEq, hTEq,
         hPRoot, hAFind, hAtRS, hAtRT, hRSPar, hRTPar, hRPerm, hRNR,
         hSub, hDesc⟩ := h
    let ⟨hAncRS, hAncRT, _, hAncPref, hAncPairs⟩ :=
      rp_DelegatedReborrowRel_ancestry
        hPs hSEq hTEq hPRoot hAFind hAtRS hAtRT hRSPar hRTPar
        hRPerm hRNR hSub hDesc
        hBS hBT (rp_countLe accS nsS) accS accT (Nat.le_refl _) hAcc
    have hBS_eq : rp_NodesBounded 1 hiS (pref ++ (rS :: dS)) := hSEq ▸ hBS
    let ⟨hBPref, _⟩ := rp_NodesBounded_split_append pref hBS_eq
    have hAtRS' :
        (Nat.beq rS.targetLocal loc && Nat.beq rS.targetEpoch ep) = true :=
      hAtRS
    have hAtRT' :
        (Nat.beq rT.targetLocal loc && Nat.beq rT.targetEpoch ep) = true :=
      hAtRT
    have hLoopS :
        tbDerivedAccessLoop nsS loc ep kind accS nsS =
          match tbDerivedAccessLoop nsS loc ep kind accS pref with
          | .error k => .error k
          | .ok xs' =>
            match tbDerivedAccessLoop nsS loc ep kind accS (rS :: dS) with
            | .error k => .error k
            | .ok ys' => .ok (xs' ++ ys') :=
      (congrArg (tbDerivedAccessLoop nsS loc ep kind accS) hSEq).trans
        (rp_tbDerivedAccessLoop_append nsS loc ep kind accS pref (rS :: dS))
    have hLoopT :
        tbDerivedAccessLoop nsT loc ep kind accT nsT =
          tbDerivedAccessLoop nsT loc ep kind accT (rT :: dT) :=
      congrArg (tbDerivedAccessLoop nsT loc ep kind accT) hTEq
    rw [hLoopS, hLoopT]
    dsimp [tbDerivedAccessLoop]
    rw [hAtRS', hAtRT', hAncRS, hAncRT]
    dsimp
    cases hStepRoot : tbChildStep kind rS.perm with
    | none =>
      have hStepRootT : tbChildStep kind rT.perm = none := hRPerm ▸ hStepRoot
      rw [hStepRootT]
      dsimp
      cases hPrefRes : tbDerivedAccessLoop nsS loc ep kind accS pref with
      | error k1 =>
        exact rp_tbDerivedAccessLoop_error_undefined hPrefRes
      | ok _ => rfl
    | some rPerm' =>
      have hStepRootT : tbChildStep kind rT.perm = some rPerm' :=
        hRPerm ▸ hStepRoot
      rw [hStepRootT]
      dsimp
      let ⟨ancP', hStepAnc, hSub'⟩ := rp_permSubsumes_child hSub hStepRoot
      let ⟨pref', hPrefOk, hPRoot', hAFind'⟩ :=
        rp_DelegatedReborrowRel_prefixLoop hAncPref hStepAnc
          (Nat.le_refl 1) hBPref hPRoot
          (fun p hp => by rw [hAFind] at hp; injection hp with e; exact e.symm)
      rw [hPrefOk]
      dsimp
      have hSplitDesc : [(rS.tag, rT.tag)] ++ dPs = pairs := by
        rw [hPs]; rfl
      have hDescRes :=
        rp_DelegatedReborrowRel_descLoop (kind := kind) hAncPairs
          hSplitDesc hDesc
      cases hDS : tbDerivedAccessLoop nsS loc ep kind accS dS with
      | error k1 =>
        rw [hDS] at hDescRes
        cases hDT : tbDerivedAccessLoop nsT loc ep kind accT dT with
        | error k2 => rw [hDT] at hDescRes; exact hDescRes
        | ok _ => rw [hDT] at hDescRes; exact hDescRes
      | ok dS' =>
        rw [hDS] at hDescRes
        cases hDT : tbDerivedAccessLoop nsT loc ep kind accT dT with
        | error _ => rw [hDT] at hDescRes; exact hDescRes
        | ok dT' =>
          rw [hDT] at hDescRes
          exact .mk
            pref' ancT ancP'
            { rS with perm := rPerm' }
            { rT with perm := rPerm' }
            dPs dS' dT'
            hPs rfl rfl
            hPRoot'
            (hAFind' hAFind)
            hAtRS hAtRT hRSPar hRTPar rfl
            (rp_tbChildStep_ne_root hRNR hStepRoot)
            hSub' hDescRes

private theorem rp_DelegatedReborrowRel_init {loc : LocalId} {ep ancT : Nat}
    {ancP : BorrowPerm} {pref : List BorrowNode} (rS rT : BorrowNode)
    (hPRoot : rp_allRootParents loc ep pref)
    (hAFind : rp_findPermAt? loc ep ancT pref = some ancP)
    (hAtRS : rp_nodeAt loc ep rS = true)
    (hAtRT : rp_nodeAt loc ep rT = true)
    (hRSPar : rS.parentTag = ancT)
    (hRTPar : rT.parentTag = 0)
    (hRPerm : rS.perm = rT.perm)
    (hRNR : rS.perm ≠ .rootOrRaw)
    (hSub : rp_permSubsumes ancP rS.perm) :
    rp_DelegatedReborrowRel loc ep [(rS.tag, rT.tag)]
      (pref ++ [rS]) [rT] :=
  .mk pref ancT ancP rS rT [] [] []
    rfl rfl rfl hPRoot hAFind hAtRS hAtRT hRSPar hRTPar
    hRPerm hRNR hSub (.nil _)

