                            fS.epochs (fT.borrowNodes ++ [newNodeT])
                            dst.localId none (.ref c.rMut c.xTy)
                            (.localPtr ⟨c.x, epX, fT.nextTag⟩
                              (.ref c.rMut c.xTy)) with
