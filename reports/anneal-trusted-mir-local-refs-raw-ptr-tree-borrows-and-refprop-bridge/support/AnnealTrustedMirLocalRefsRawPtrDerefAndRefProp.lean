                                          | inl hB1 =>
                                            rw [hB1]
                                            exact Or.inr (Or.inl rfl)
                                          | inr hB2 =>
                                            rw [hB2]
                                            exact Or.inr (Or.inr rfl)
                                      | inr hp =>
                                        rw [hp.2]; exact Or.inr (Or.inr rfl)
                                let ⟨hNT1, hPM0, hRoot1, permR1, hTLt, hFind1,
