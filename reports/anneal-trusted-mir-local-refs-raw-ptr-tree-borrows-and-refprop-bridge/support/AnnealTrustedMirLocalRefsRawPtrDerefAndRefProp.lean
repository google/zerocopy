                  dsimp only
                  rw [performTbRootAccess_noop_of_noTarget hCore.hNoTargetRS,
                      hRTyRef, mirTy_beq_refl (.ref c.rMut c.xTy)]
                  dsimp [expectedRefOrAddrInner?, operandHasDerefProj]
                  rw [mutability_beq_refl c.rMut, hSupX]
                  dsimp [s3b_evalRefOrAddrBody]
                  rw [s3b_ctx_getElem_localsTgt_x c]
                  dsimp only
                  rw [mirTy_beq_refl c.xTy, hGXT, hEpX, hInhX,
                      s3b_allocateBorrowTag_pos hCore.hNextTagTPos]
                  dsimp
                  let nodesT₁ :=
                    performTbRootAccess fS.epochs c.x c.xTy .read fT.borrowNodes
                  let newNodeT : BorrowNode :=
                    ⟨fT.nextTag, 0, c.x, epX, initPerm⟩
                  let pm' := s3b_extPm pm c.x epX tagR fT.nextTag
                  have hAtNewT : rp_nodeAt c.x epX newNodeT = true :=
                    rp_nodeAt_intro rfl rfl
                  let ⟨hNT1Ep, hNT1B⟩ :=
                    s3b_performTbRootAccess_bounds fS.epochs c.x c.xTy .read
                      hCore.hNodesTEpLt hCore.hBoundedT
                  have hPmMono : ∀ l e t1 t2,
                      rp_hasPair (pm l e) t1 t2 = true →
                      rp_hasPair (pm' l e) t1 t2 = true := by
                    intro l e t1 t2 hp
                    dsimp [pm', s3b_extPm]
                    cases Nat.beq l c.x && Nat.beq e epX with
                    | false => exact hp
                    | true =>
                      dsimp; rw [rp_hasPair_append]
                      exact bool_or_intro_left _ hp
                  have hCoreDel :
                      s3b_CoreInv c true true .delegated fS.locals fT.locals
                        fS.epochs fS.nextEpoch fS.borrowNodes
                        (nodesT₁ ++ [newNodeT]) fS.nextTag (fT.nextTag + 1)
                        pm' := {
                    hCore with
                    hNodesTEpLt := by
                      rw [list_all_append]
                      exact bool_and_intro hNT1Ep
                        (bool_and_intro (nat_lt_blt hEpXLt) rfl)
                    hNextTagTPos :=
                      Nat.le_trans hCore.hNextTagTPos (Nat.le_succ _)
                    hBoundedT :=
                      rp_NodesBounded_append_one newNodeT hNT1B (Nat.le_refl _)
                        hCore.hNextTagTPos
                    hNoTargetRT := by
                      unfold nodesNotTargeting; rw [list_all_append]
                      have hN1 :=
                        performTbRootAccess_preserves_noTarget c.r c.x
                          fS.epochs c.xTy .read hCore.hNoTargetRT
                      have hXR : (!Nat.beq c.x c.r) = true := by
                        rw [nat_beq_false_of_ne c.hRNeX.symm]; rfl
                      exact bool_and_intro hN1 (bool_and_intro hXR rfl)
                    hSlotsOther := fun loc slS slT hNeR hGS hGT =>
                      s3b_SlotRel_mono_tags (Nat.le_refl _) (Nat.le_succ _)
                        hPmMono (hCore.hSlotsOther loc slS slT hNeR hGS hGT)
                    hNonXRel := fun loc ep declTy hNeX hDecl hGEp hNZ' => by
                      have hNe : loc ≠ c.x ∨ ep ≠ epX := Or.inl hNeX
                      dsimp [pm', s3b_extPm]
                      rw [nat_beq_false_of_ne hNeX, Bool.false_and]
                      dsimp
                      rw [rp_nodesAt_append]
                      dsimp [rp_nodesAt]
                      rw [if_bool_false (rp_nodeAt_false_of_ne hAtNewT hNe),
                          List.append_nil]
                      unfold nodesT₁ performTbRootAccess
                      rw [if_bool_false hNZ, hEpX]
                      dsimp
                      rw [rp_nodesAt_tbForeignAccessAt_other hNe]
                      exact hCore.hNonXRel loc ep declTy hNeX hDecl hGEp hNZ'
                    hTargetInv := fun epX2 _ hEpX2 _ => by
                      rw [hEpX] at hEpX2; injection hEpX2 with eE; subst eE
                      unfold s3b_TargetLiveInv
                      rw [if_bool_true hTr]
                      dsimp [pm', s3b_extPm]
                      rw [nat_beq_refl c.x, nat_beq_refl epX]
                      dsimp
                      rw [hPM0, List.nil_append, rp_nodesAt_append]
                      dsimp [rp_nodesAt]
                      rw [if_bool_true hAtNewT]
                      unfold nodesT₁ performTbRootAccess
                      rw [if_bool_false hNZ, hEpX]
                      dsimp
                      rw [rp_nodesAt_tbForeignAccessAt_same, hNT0]
                      dsimp [tbForeignAccessAt]
                      exact Or.inl
                        (rp_DelegatedCopyRel_of_allRoot_split newNodeT
                          (rp_NodesBounded_nodesAt c.x epX hCore.hBoundedS)
                          hRoot0 hFindR hAtNewT rfl rfl)
                  }
                  have hValPtr :
                      s3b_ValRel c fS.epochs fS.nextEpoch fS.nextTag
                        (fT.nextTag + 1) pm'
                        (.localPtr ⟨c.x, epX, tagR⟩ (.ref c.rMut c.xTy))
                        (.localPtr ⟨c.x, epX, fT.nextTag⟩
                          (.ref c.rMut c.xTy)) := by
                    refine ⟨rfl, c.hRNeX.symm, rfl, rfl, hEpXLt, hTLt,
                      Nat.lt_succ_self _, ?_⟩
                    intro _ _ hGEp _
                    rw [hEpX] at hGEp; injection hGEp with eE; rw [← eE]
                    rw [hTr, nat_beq_refl c.x]
                    dsimp [pm', s3b_extPm]
                    rw [nat_beq_refl c.x, nat_beq_refl epX, hPM0]
                    dsimp [rp_hasPair]
                    rw [nat_beq_refl tagR, nat_beq_refl fT.nextTag]
                    exact ⟨hTagRGe1, hCore.hNextTagTPos, rfl⟩
                  have hWr :=
                    s3b_writeTarget_unproj_nonR hCoreDel hYNeR
                      (hGYTy.trans (congrArg Option.some hRTyRef)) hValPtr
                  have hMIdle :
                      s3b_modeAfterRoot c dst.localId .write .delegated =
                        .delegated := by
                    unfold s3b_modeAfterRoot
                    rw [nat_beq_false_of_ne hYNeX, Bool.and_false]
                    rfl
                  rw [hMIdle] at hWr
                  cases hW1 :
                      writeTargetSlotRef c.bodySrc.locals fS.locals fS.epochs
                        fS.borrowNodes dst.localId none (.ref c.rMut c.xTy)
                        (.localPtr ⟨c.x, epX, tagR⟩ (.ref c.rMut c.xTy)) with
                  | error _ =>
                    rw [hW1] at hWr
                    cases hW2 :
                        writeTargetSlotRef c.bodyTgt.locals fT.locals fS.epochs
                          (nodesT₁ ++ [newNodeT]) dst.localId none
                          (.ref c.rMut c.xTy)
                          (.localPtr ⟨c.x, epX, fT.nextTag⟩
                            (.ref c.rMut c.xTy)) with
                    | error _ => rw [hW2] at hWr; exact hWr
                    | ok _ => rw [hW2] at hWr; exact False.elim hWr
                  | ok w1 =>
                    rw [hW1] at hWr
                    cases hW2 :
                        writeTargetSlotRef c.bodyTgt.locals fT.locals fS.epochs
                          (nodesT₁ ++ [newNodeT]) dst.localId none
                          (.ref c.rMut c.xTy)
                          (.localPtr ⟨c.x, epX, fT.nextTag⟩
                            (.ref c.rMut c.xTy)) with
                    | error _ => rw [hW2] at hWr; exact False.elim hWr
                    | ok w2 =>
                      rw [hW2] at hWr
                      cases w1 with
                      | mk lS' nS' =>
                        cases w2 with
                        | mk lT' nT' =>
                          exact ⟨_, _, true, true, .delegated, pm', hStEq, rfl,
                            rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, hWr⟩
        | none =>
          rw [hFwd] at hAbs
          dsimp at hAbs
          -- Branch 3: !stmtAssignMentionsLocal c.r
          cases hNoR : !stmtAssignMentionsLocal c.r (.assign dst rv) with
          | true =>
            rw [if_bool_true hNoR] at hAbs
            have hFalseM := bool_not_true hNoR
            let ⟨hDstNoR, hRvNoR⟩ := bool_or_false hFalseM
            have hDstNeR := nat_ne_of_beq_false hDstNoR
            have hNoDirX :
                c.trackTb = true →
                stmtTakesDirectAddrOf c.x (.assign dst rv) = false := by
              intro hTr
              have hOnly := hExclStmt hTr
              unfold stmtOnlyTakesAddrOfTargetFor at hOnly
              cases hD : stmtTakesDirectAddrOf c.x (.assign dst rv) with
              | false => rfl
              | true =>
                rw [if_bool_true hD] at hOnly
                dsimp at hOnly
                rw [hDef] at hOnly; cases hOnly
            let modeTarget : BorrowLinkMode :=
              (fun m =>
                if !c.trackTb then m
                else
                  match m with
                  | .clean | .delegated => m
                  | .reserved | .unique | .frozen =>
                    if (dst.projection.isEmpty && Nat.beq dst.localId c.x) ||
                        rvalueDirectMovesLocal c.x rv then .clean
                    else if stmtAssignMentionsLocal c.x (.assign dst rv) then
