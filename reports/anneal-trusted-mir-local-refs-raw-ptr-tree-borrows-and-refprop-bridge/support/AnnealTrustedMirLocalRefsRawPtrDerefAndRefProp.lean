                                                                writeTargetSlotRef
                                                                  c.bodySrc.locals
                                                                  lS1 fS.epochs
                                                                  nS1
                                                                  ptrS.targetLocal
                                                                  (some (dSafe,
                                                                    dMut, ptrS))
                                                                  dstTy vS with
                                                            | error _ =>
                                                              rw [hW1] at hWr
                                                              cases hW2 :
                                                                  writeTargetSlotRef
                                                                    c.bodyTgt.locals
                                                                    lT1
                                                                    fS.epochs
                                                                    nT1
                                                                    ptrS.targetLocal
                                                                    (some (dSafe,
                                                                      dMut,
                                                                      ptrT))
                                                                    dstTy vT
                                                              with
                                                              | error _ =>
                                                                rw [hW2] at hWr
                                                                exact hWr
                                                              | ok _ =>
                                                                rw [hW2] at hWr
                                                                exact False.elim hWr
                                                            | ok w1 =>
                                                              rw [hW1] at hWr
                                                              cases hW2 :
                                                                  writeTargetSlotRef
                                                                    c.bodyTgt.locals
                                                                    lT1
                                                                    fS.epochs
                                                                    nT1
                                                                    ptrS.targetLocal
                                                                    (some (dSafe,
                                                                      dMut,
                                                                      ptrT))
                                                                    dstTy vT
                                                              with
                                                              | error _ =>
                                                                rw [hW2] at hWr
                                                                exact False.elim hWr
                                                              | ok w2 =>
                                                                rw [hW2] at hWr
                                                                cases w1 with
                                                                | mk lS2 nS2 =>
                                                                  cases w2 with
                                                                  | mk lT2 nT2 =>
                                                                    exact ⟨_, _,
                                                                      rL, xL,
                                                                      modeTarget,
                                                                      pm1,
                                                                      hStEq,
                                                                      rfl, rfl,
                                                                      rfl, rfl,
                                                                      rfl, rfl,
                                                                      rfl, rfl,
                                                                      rfl, rfl,
                                                                      hWr⟩
          | false =>
            rw [if_bool_false hNoR] at hAbs
            cases hG1 : (!(rL && xL) || !placeOnlyUsesDerefOf c.r dst ||
                (Nat.beq dst.localId c.r && !c.rIsMut) ||
                !rvalueOnlyUsesDerefOf c.r c.rIsMut c.isSafeRef rv) with
            | true => rw [if_bool_true hG1] at hAbs; cases hAbs
            | false =>
              rw [if_bool_false hG1] at hAbs
              let ⟨hG1a, hNRv⟩ := bool_or_false hG1
              let ⟨hG1b, hDstMutF⟩ := bool_or_false hG1a
              let ⟨hNLX, hNDst⟩ := bool_or_false hG1b
              let ⟨hrLT, hxLT⟩ := bool_and_true (bool_not_false hNLX)
              subst hrLT; subst hxLT
              have hDerefDst := bool_not_false hNDst
              have hDerefRv := bool_not_false hNRv
              have hDstMut : dst.localId = c.r → c.rIsMut = true := by
                intro hEq
                rw [nat_beq_of_eq hEq] at hDstMutF
                change (!c.rIsMut) = false at hDstMutF
                exact bool_not_false hDstMutF
              cases hSelf : createsUnprojectedNonZstSelfUse c.xTy
                  (rewriteDerefPlace c.r c.x dst)
                  (rewriteDerefRvalue c.r c.x rv) with
              | true => rw [if_bool_true hSelf] at hAbs; cases hAbs
              | false =>
                rw [if_bool_false hSelf] at hAbs
                cases hTr : c.trackTb with
                | false =>
                  rw [hTr] at hAbs; dsimp at hAbs
                  cases hM : BorrowLinkMode.beq mode .reserved with
                  | false => rw [if_bool_false hM] at hAbs; cases hAbs
                  | true =>
                    rw [if_bool_true hM] at hAbs
                    have hmEq := borrowLinkMode_beq_eq hM
                    subst hmEq
                    let ⟨hStEq, hS'⟩ := s3b_some_prod_eq hAbs
                    rw [← hS']
                    exact s3b_evalAssign_rewritten_nonReb hCore hLenS hLenT
                      hEpEq hNEpEq hStEq.symm hDerefDst hDstMut hDerefRv hSelf
                      (fun h => by rw [hTr] at h; cases h)
                      (fun h => by rw [hTr] at h; cases h)
                      (fun h => by rw [hTr] at h; cases h)
                      (Or.inl ⟨hTr, rfl⟩)
                      (fun _ h => by rw [hTr] at h; cases h)
                | true =>
                  rw [hTr] at hAbs; dsimp at hAbs
                  cases hMX : stmtAssignMentionsLocal c.x (.assign dst rv) with
                  | true => rw [if_bool_true hMX] at hAbs; cases hAbs
                  | false =>
                    rw [if_bool_false hMX] at hAbs
                    let ⟨hDstNoX, hRvNoX⟩ := bool_or_false hMX
                    have hDstNeX := nat_ne_of_beq_false hDstNoX
                    change (match s3b_reborrowMutOpt c.r rv with
                        | some m2 => _
                        | none => _) = some (st₁, stmt') at hAbs
                    cases hReb : s3b_reborrowMutOpt c.r rv with
                    | none =>
                      rw [hReb] at hAbs; dsimp at hAbs
                      cases hMutates :
                          (Nat.beq dst.localId c.r || rvalueMovesDerefOf c.r rv)
                      with
                      | true =>
                        rw [if_bool_true hMutates] at hAbs
                        cases hNM : !c.rIsMut with
                        | true => rw [if_bool_true hNM] at hAbs; cases hAbs
                        | false =>
                          rw [if_bool_false hNM] at hAbs
                          have hRMutT := bool_not_false hNM
                          have hLeUniq :
                              absLe (.reachable true true mode)
                                (.reachable true true .unique) = true ∧
                              st₁ = .reachable true true .unique ∧
                              stmt' = .assign (rewriteDerefPlace c.r c.x dst)
                                (rewriteDerefRvalue c.r c.x rv) := by
                            cases mode with
                            | reserved =>
                              let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                              exact ⟨rfl, e1.symm, e2.symm⟩
                            | unique =>
                              let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                              exact ⟨rfl, e1.symm, e2.symm⟩
                            | frozen | clean | delegated => cases hAbs
                          let ⟨hLeU, hStEq, hS'⟩ := hLeUniq
                          rw [hS']
                          have hCoreU := s3b_CoreInv_mono hLeU hCore
                          exact s3b_evalAssign_rewritten_nonReb hCoreU hLenS
                            hLenT hEpEq hNEpEq hStEq hDerefDst hDstMut hDerefRv
                            hSelf (fun _ => hDstNeX) (fun _ => hRvNoX)
                            (fun _ => hReb)
                            (Or.inr ⟨hTr, Or.inr ⟨hRMutT, rfl⟩⟩)
                            (fun _ _ => rfl)
                      | false =>
                        rw [if_bool_false hMutates] at hAbs
                        let ⟨hDstNotR, hNoMoveRv⟩ := bool_or_false hMutates
                        have hMode3 :
                            (mode = .reserved ∨ mode = .unique ∨
                              mode = .frozen) ∧
                            st₁ = .reachable true true mode ∧
                            stmt' = .assign (rewriteDerefPlace c.r c.x dst)
                              (rewriteDerefRvalue c.r c.x rv) := by
                          cases mode with
                          | reserved =>
                            let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                            exact ⟨Or.inl rfl, e1.symm, e2.symm⟩
                          | unique =>
                            let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                            exact ⟨Or.inr (Or.inl rfl), e1.symm, e2.symm⟩
                          | frozen =>
                            let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                            exact ⟨Or.inr (Or.inr rfl), e1.symm, e2.symm⟩
                          | clean | delegated => cases hAbs
                        let ⟨hMOr, hStEq, hS'⟩ := hMode3
                        rw [hS']
                        exact s3b_evalAssign_rewritten_nonReb hCore hLenS hLenT
                          hEpEq hNEpEq hStEq hDerefDst hDstMut hDerefRv hSelf
                          (fun _ => hDstNeX) (fun _ => hRvNoX) (fun _ => hReb)
                          (Or.inr ⟨hTr, Or.inl ⟨hNoMoveRv, hMOr⟩⟩)
                          (fun hDR => by
                            rw [nat_beq_of_eq hDR] at hDstNotR; cases hDstNotR)
                    | some m2 =>
                      rw [hReb] at hAbs; dsimp at hAbs
                      cases hDP : !dst.projection.isEmpty with
                      | true => rw [if_bool_true hDP] at hAbs; cases hAbs
                      | false =>
                        rw [if_bool_false hDP] at hAbs
                        have hDstNil : dst.projection = [] := by
                          cases hp : dst.projection with
                          | nil => rfl
                          | cons _ _ => rw [hp] at hDP; cases hDP
                        have hYNeR : dst.localId ≠ c.r := by
                          intro hEq
                          dsimp [placeOnlyUsesDerefOf] at hDerefDst
                          rw [if_bool_true (nat_beq_of_eq hEq), hDstNil]
                            at hDerefDst
                          cases hDerefDst
                        -- Unpack rv = .ref m2 ⟨c.r, [.deref]⟩
                        have hRvShape : rv = .ref m2 ⟨c.r, [.deref]⟩ := by
                          cases rv with
                          | ref m3 srcP =>
                            dsimp [s3b_reborrowMutOpt] at hReb
                            cases hSR : Nat.beq srcP.localId c.r with
                            | false => rw [if_bool_false hSR] at hReb; cases hReb
                            | true =>
                              rw [if_bool_true hSR] at hReb
                              injection hReb with em3; subst em3
                              dsimp [rvalueOnlyUsesDerefOf,
                                placeOnlyUsesDerefOf] at hDerefRv
                              rw [hSR] at hDerefRv; dsimp at hDerefRv
                              let ⟨hPrOk, _⟩ := bool_and_true hDerefRv
                              have hsId := nat_beq_eq hSR
                              have hsPr : srcP.projection = [.deref] := by
                                cases hp : srcP.projection with
                                | nil => rw [hp] at hPrOk; cases hPrOk
                                | cons a b =>
