    {old : Option ValRef} {curEp : Nat} {nodes' : List BorrowNode}
    {locals' : List LocalSlotRef}
    (hVal : checkValRef (.base val) ty = true)
    (hDecl : Trusted.MirSemantics.getElem? bodyLocals id = some ty)
    (hTyEq : MirTy.beq ty ty = true)
    (hInh : isOpsemInhabitedTy ty = true)
    (hGet : Trusted.MirSemantics.getElem? locals id = some (.live old))
    (hEpGet : Trusted.MirSemantics.getElem? epochs id = some curEp)
    (hEpEq : Nat.beq curEp ptr.targetEpoch = true)
    (hTb : performTbAccess id curEp ty .write ptr.borrowTag nodes =
      Except.ok nodes')
    (hSet : setElem? locals id (.live (some (.base val))) = some locals') :
    writeTargetSlotRef bodyLocals locals epochs nodes id
      (some (true, .mut, ptr)) ty (.base val) =
      Except.ok (locals', nodes') := by
  unfold writeTargetSlotRef
  rw [hVal, hDecl, hGet, hEpGet]
  dsimp only []
  rw [hTyEq, hInh, hEpEq]
  dsimp only [Mutability.beq]
  rw [hTb]
  dsimp only [validateRuntimeValRef]
  rw [hVal, hSet]
  rfl

