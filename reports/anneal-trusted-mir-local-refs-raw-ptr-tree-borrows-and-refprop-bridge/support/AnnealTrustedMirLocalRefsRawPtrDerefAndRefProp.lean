/-! ### Stage 4 Common Infrastructure: Reflection, Lists, Fuel, & Lockstep Sim -/

private theorem if_bool_true {α : Type} {c : Bool} {t e : α} (h : c = true) :
    (if c then t else e) = t := by
  rw [h]; rfl

private theorem if_bool_false {α : Type} {c : Bool} {t e : α} (h : c = false) :
    (if c then t else e) = e := by
  rw [h]; rfl

private theorem if_cond_congr {α : Type} {b1 b2 : Bool} (h : b1 = b2) (x y : α) :
    (if b1 then x else y) = (if b2 then x else y) := by
  rw [h]

private theorem bool_and_true {a b : Bool} (h : (a && b) = true) :
    a = true ∧ b = true := by
  cases a with
  | false => cases h
  | true =>
    cases b with
    | false => cases h
    | true => exact ⟨rfl, rfl⟩

private theorem bool_and_intro {a b : Bool} (ha : a = true) (hb : b = true) :
    (a && b) = true := by
  rw [ha, hb]; rfl

private theorem bool_or_true {a b : Bool} (h : (a || b) = true) :
    a = true ∨ b = true := by
  cases a with
  | true => exact Or.inl rfl
  | false =>
    cases b with
    | true => exact Or.inr rfl
    | false => cases h

private theorem bool_or_false {a b : Bool} (h : (a || b) = false) :
    a = false ∧ b = false := by
  cases a with
  | true => cases h
  | false =>
    cases b with
    | true => cases h
    | false => exact ⟨rfl, rfl⟩

private theorem bool_or_intro_left {a : Bool} (b : Bool) (ha : a = true) :
    (a || b) = true := by
  rw [ha]; rfl

private theorem bool_or_intro_right (a : Bool) {b : Bool} (hb : b = true) :
    (a || b) = true := by
  rw [hb]; cases a <;> rfl

private theorem bool_not_true {a : Bool} (h : (!a) = true) : a = false := by
  cases a with
  | false => rfl
  | true => cases h

private theorem bool_not_false {a : Bool} (h : (!a) = false) : a = true := by
  cases a with
  | true => rfl
  | false => cases h

private theorem bool_beq_eq {a b : Bool} (h : (a == b) = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem bool_beq_refl (a : Bool) : (a == a) = true := by
  cases a <;> rfl

private theorem nat_beq_refl (n : Nat) : Nat.beq n n = true := by
  induction n with
  | zero => rfl
  | succ _ ih => exact ih

private theorem nat_beq_eq {a b : Nat} (h : Nat.beq a b = true) : a = b := by
  induction a generalizing b with
  | zero =>
    cases b with
    | zero => rfl
    | succ _ => cases h
  | succ _ ih =>
    cases b with
    | zero => cases h
    | succ _ => rw [ih h]

private theorem nat_beq_of_eq {a b : Nat} (h : a = b) : Nat.beq a b = true := by
  subst h; exact nat_beq_refl a

private theorem nat_beq_false_of_ne {a b : Nat} (h : a ≠ b) :
    Nat.beq a b = false := by
  cases hEq : Nat.beq a b with
  | false => rfl
  | true => exact False.elim (h (nat_beq_eq hEq))

private theorem nat_ne_of_beq_false {a b : Nat} (h : Nat.beq a b = false) :
    a ≠ b := by
  intro hEq
  rw [hEq, nat_beq_refl] at h
  cases h

private theorem nat_beq_symm (a b : Nat) : Nat.beq a b = Nat.beq b a := by
  cases h : Nat.beq a b with
  | true => exact (nat_beq_of_eq (nat_beq_eq h).symm).symm
  | false =>
    exact (nat_beq_false_of_ne (fun hba => nat_ne_of_beq_false h hba.symm)).symm

private theorem nat_ble_le {a b : Nat} (h : Nat.ble a b = true) : a ≤ b := by
  induction a generalizing b with
  | zero => exact Nat.zero_le b
  | succ _ ih =>
    cases b with
    | zero => cases h
    | succ _ => exact Nat.succ_le_succ (ih h)

private theorem nat_le_ble {a b : Nat} (h : a ≤ b) : Nat.ble a b = true := by
  induction a generalizing b with
  | zero => rfl
  | succ k ih =>
    cases b with
    | zero => exact False.elim (Nat.not_succ_le_zero k h)
    | succ _ => exact ih (Nat.le_of_succ_le_succ h)

private theorem nat_ble_false_gt {a b : Nat} (h : Nat.ble a b = false) : b < a := by
  cases Nat.lt_or_ge b a with
  | inl hlt => exact hlt
  | inr hle =>
    rw [nat_le_ble hle] at h
    cases h

private theorem nat_gt_ble_false {a b : Nat} (h : b < a) :
    Nat.ble a b = false := by
  cases hB : Nat.ble a b with
  | false => rfl
  | true => exact False.elim (Nat.not_lt_of_ge (nat_ble_le hB) h)

private theorem nat_blt_lt {a b : Nat} (h : Nat.blt a b = true) : a < b :=
  nat_ble_le h

private theorem nat_lt_blt {a b : Nat} (h : a < b) : Nat.blt a b = true :=
  nat_le_ble h

private theorem nat_blt_false_ge {a b : Nat} (h : Nat.blt a b = false) : b ≤ a := by
  cases Nat.lt_or_ge a b with
  | inl hlt =>
    rw [nat_lt_blt hlt] at h
    cases h
  | inr hge => exact hge

private theorem nat_ge_blt_false {a b : Nat} (h : b ≤ a) :
    Nat.blt a b = false := by
  cases hB : Nat.blt a b with
  | false => rfl
  | true => exact False.elim (Nat.not_lt_of_ge h (nat_blt_lt hB))

private theorem nat_add_sub_cancel_left (a b : Nat) : (a + b) - a = b := by
  rw [Nat.add_comm]
  exact Nat.add_sub_cancel b a

private theorem nat_sub_add_cancel_of_le {a b : Nat} (h : a ≤ b) :
    a + (b - a) = b := by
  rw [Nat.add_comm]
  exact Nat.sub_add_cancel h

private theorem bitvec_beq_eq {n : Nat} {a b : BitVec n}
    (h : (a == b) = true) : a = b :=
  eq_of_beq h

private theorem bitvec_beq_refl {n : Nat} (a : BitVec n) : (a == a) = true :=
  beq_self_eq_true a

private theorem uint8_beq_eq {a b : UInt8} (h : (a == b) = true) : a = b :=
  eq_of_beq h

private theorem uint8_list_beq_eq {xs ys : List UInt8}
    (h : List.beq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons _ _ ih =>
    cases ys with
    | nil => cases h
    | cons _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [uint8_beq_eq h1, ih h2]

private theorem uint8_list_beq_refl (xs : List UInt8) :
    List.beq xs xs = true := by
  induction xs with
  | nil => rfl
  | cons x _ ih =>
    change ((x == x) && List.beq _ _) = true
    rw [beq_self_eq_true x, ih]
    rfl

private theorem stringBeq_eq {a b : String} (h : stringBeq a b = true) : a = b := by
  unfold stringBeq at h
  have hL : a.toByteArray.data.toList = b.toByteArray.data.toList :=
    uint8_list_beq_eq h
  cases a with
  | ofByteArray ba _ =>
    cases b with
    | ofByteArray bb _ =>
      cases ba with
      | mk da =>
        cases bb with
        | mk db =>
          cases da with
          | mk la =>
            cases db with
            | mk lb =>
              dsimp at hL
              subst hL
              rfl

private theorem stringBeq_refl (a : String) : stringBeq a a = true := by
  unfold stringBeq
  exact uint8_list_beq_refl a.toByteArray.data.toList

private theorem intWidth_beq_eq {a b : IntWidth}
    (h : IntWidth.beq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem intWidth_beq_refl (a : IntWidth) : IntWidth.beq a a = true := by
  cases a <;> rfl

private theorem mutability_beq_eq {a b : Mutability}
    (h : Mutability.beq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem mutability_beq_refl (a : Mutability) :
    Mutability.beq a a = true := by
  cases a <;> rfl

private theorem natListBeq_eq {a b : List Nat}
    (h : natListBeq a b = true) : a = b := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => rfl
    | cons _ _ => cases h
  | cons _ _ ih =>
    cases b with
    | nil => cases h
    | cons _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [nat_beq_eq h1, ih h2]

private theorem natListBeq_refl (a : List Nat) : natListBeq a a = true := by
  induction a with
  | nil => rfl
  | cons x _ ih =>
    dsimp [natListBeq]
    rw [nat_beq_refl x, ih]
    rfl

private theorem enumTagRepr_beq_eq {a b : EnumTagRepr}
    (h : EnumTagRepr.beq a b = true) : a = b := by
  cases a with
  | zeroSized =>
    cases b with
    | zeroSized => rfl
    | scalar _ _ => cases h
  | scalar _ _ =>
    cases b with
    | zeroSized => cases h
    | scalar _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [intWidth_beq_eq h1, bool_beq_eq h2]

private theorem enumTagRepr_beq_refl (a : EnumTagRepr) :
    EnumTagRepr.beq a a = true := by
  cases a with
  | zeroSized => rfl
  | scalar w s =>
    dsimp [EnumTagRepr.beq]
    rw [intWidth_beq_refl w]
    cases s <;> rfl

private theorem enumTy_beq_eq {a b : EnumTy}
    (h : EnumTy.beq a b = true) : a = b := by
  cases a with
  | mk _ _ _ _ _ =>
    cases b with
    | mk _ _ _ _ _ =>
      dsimp [EnumTy.beq] at h
      let ⟨h1234, h5⟩ := bool_and_true h
      let ⟨h123, h4⟩ := bool_and_true h1234
      let ⟨h12, h3⟩ := bool_and_true h123
      let ⟨h1, h2⟩ := bool_and_true h12
      rw [nat_beq_eq h1, intWidth_beq_eq h2, bool_beq_eq h3,
          enumTagRepr_beq_eq h4, natListBeq_eq h5]

private theorem enumTy_beq_refl (a : EnumTy) : EnumTy.beq a a = true := by
  cases a with
  | mk id w s tr ds =>
    unfold EnumTy.beq
    rw [nat_beq_refl id, intWidth_beq_refl w, enumTagRepr_beq_refl tr,
        natListBeq_refl ds]
    cases s <;> rfl

mutual
  private theorem mirTy_beq_eq : ∀ {a b : MirTy}, MirTy.beq a b = true → a = b
    | .bool, .bool, _ => rfl
    | .int _ _, .int _ _, h => by
      let ⟨h1, h2⟩ := bool_and_true h
      rw [intWidth_beq_eq h1, bool_beq_eq h2]
    | .unit, .unit, _ => rfl
    | .never, .never, _ => rfl
    | .enum _, .enum _, h => by rw [enumTy_beq_eq h]
    | .tuple _, .tuple _, h => by rw [mirTy_beqList_eq h]
    | .ref _ _, .ref _ _, h => by
      let ⟨h1, h2⟩ := bool_and_true h
      rw [mutability_beq_eq h1, mirTy_beq_eq h2]
    | .rawPtr _ _, .rawPtr _ _, h => by
      let ⟨h1, h2⟩ := bool_and_true h
      rw [mutability_beq_eq h1, mirTy_beq_eq h2]
    | .unsupported, .unsupported, _ => rfl
    | .bool, .int _ _, h | .bool, .unit, h | .bool, .never, h
    | .bool, .enum _, h | .bool, .tuple _, h | .bool, .ref _ _, h
    | .bool, .rawPtr _ _, h | .bool, .unsupported, h
    | .int _ _, .bool, h | .int _ _, .unit, h | .int _ _, .never, h
    | .int _ _, .enum _, h | .int _ _, .tuple _, h | .int _ _, .ref _ _, h
    | .int _ _, .rawPtr _ _, h | .int _ _, .unsupported, h
    | .unit, .bool, h | .unit, .int _ _, h | .unit, .never, h
    | .unit, .enum _, h | .unit, .tuple _, h | .unit, .ref _ _, h
    | .unit, .rawPtr _ _, h | .unit, .unsupported, h
    | .never, .bool, h | .never, .int _ _, h | .never, .unit, h
    | .never, .enum _, h | .never, .tuple _, h | .never, .ref _ _, h
    | .never, .rawPtr _ _, h | .never, .unsupported, h
    | .enum _, .bool, h | .enum _, .int _ _, h | .enum _, .unit, h
    | .enum _, .never, h | .enum _, .tuple _, h | .enum _, .ref _ _, h
    | .enum _, .rawPtr _ _, h | .enum _, .unsupported, h
    | .tuple _, .bool, h | .tuple _, .int _ _, h | .tuple _, .unit, h
    | .tuple _, .never, h | .tuple _, .enum _, h | .tuple _, .ref _ _, h
    | .tuple _, .rawPtr _ _, h | .tuple _, .unsupported, h
    | .ref _ _, .bool, h | .ref _ _, .int _ _, h | .ref _ _, .unit, h
    | .ref _ _, .never, h | .ref _ _, .enum _, h | .ref _ _, .tuple _, h
    | .ref _ _, .rawPtr _ _, h | .ref _ _, .unsupported, h
    | .rawPtr _ _, .bool, h | .rawPtr _ _, .int _ _, h | .rawPtr _ _, .unit, h
    | .rawPtr _ _, .never, h | .rawPtr _ _, .enum _, h
    | .rawPtr _ _, .tuple _, h | .rawPtr _ _, .ref _ _, h
    | .rawPtr _ _, .unsupported, h
    | .unsupported, .bool, h | .unsupported, .int _ _, h
    | .unsupported, .unit, h | .unsupported, .never, h
    | .unsupported, .enum _, h | .unsupported, .tuple _, h
    | .unsupported, .ref _ _, h | .unsupported, .rawPtr _ _, h =>
      by cases h

  private theorem mirTy_beqList_eq :
      ∀ {a b : List MirTy}, MirTy.beqList a b = true → a = b
    | [], [], _ => rfl
    | _ :: _, _ :: _, h => by
      let ⟨h1, h2⟩ := bool_and_true h
      rw [mirTy_beq_eq h1, mirTy_beqList_eq h2]
    | [], _ :: _, h | _ :: _, [], h => by cases h
end

mutual
  private theorem mirTy_beq_refl : ∀ (t : MirTy), MirTy.beq t t = true
    | .bool => rfl
    | .int w s => by
      change (IntWidth.beq w w && (s == s)) = true
      rw [intWidth_beq_refl w, bool_beq_refl s]
      rfl
    | .unit => rfl
    | .never => rfl
    | .enum ety => enumTy_beq_refl ety
    | .tuple fs => mirTy_beqList_refl fs
    | .ref m p => by
      change (Mutability.beq m m && MirTy.beq p p) = true
      rw [mutability_beq_refl m, mirTy_beq_refl p]
      rfl
    | .rawPtr m p => by
      change (Mutability.beq m m && MirTy.beq p p) = true
      rw [mutability_beq_refl m, mirTy_beq_refl p]
      rfl
    | .unsupported => rfl

  private theorem mirTy_beqList_refl :
      ∀ (fs : List MirTy), MirTy.beqList fs fs = true
    | [] => rfl
    | x :: xs => by
      change (MirTy.beq x x && MirTy.beqList xs xs) = true
      rw [mirTy_beq_refl x, mirTy_beqList_refl xs]
      rfl
end

private theorem borrowPerm_beq_eq {a b : BorrowPerm}
    (h : BorrowPerm.beq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem borrowPerm_beq_refl (a : BorrowPerm) :
    BorrowPerm.beq a a = true := by
  cases a <;> rfl

private theorem localPtr_beq_eq {a b : LocalPtr}
    (h : LocalPtr.beq a b = true) : a = b := by
  cases a with
  | mk _ _ _ =>
    cases b with
    | mk _ _ _ =>
      dsimp [LocalPtr.beq] at h
      let ⟨h12, h3⟩ := bool_and_true h
      let ⟨h1, h2⟩ := bool_and_true h12
      rw [nat_beq_eq h1, nat_beq_eq h2, nat_beq_eq h3]

private theorem localPtr_beq_refl (a : LocalPtr) :
    LocalPtr.beq a a = true := by
  cases a with
  | mk l e t =>
    dsimp [LocalPtr.beq]
    rw [nat_beq_refl l, nat_beq_refl e, nat_beq_refl t]
    rfl

private theorem borrowLinkMode_beq_eq {a b : BorrowLinkMode}
    (h : BorrowLinkMode.beq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem borrowLinkMode_beq_refl (a : BorrowLinkMode) :
    BorrowLinkMode.beq a a = true := by
  cases a <;> rfl

private theorem absRefState_beq_eq {a b : AbsRefState}
    (h : AbsRefState.beq a b = true) : a = b := by
  cases a with
  | unreachable =>
    cases b <;> first | rfl | cases h
  | reachable r1 x1 m1 =>
    cases b with
    | unreachable => cases h
    | reachable r2 x2 m2 =>
      dsimp [AbsRefState.beq] at h
      let ⟨h12, h3⟩ := bool_and_true h
      let ⟨h1, h2⟩ := bool_and_true h12
      rw [bool_beq_eq h1, bool_beq_eq h2, borrowLinkMode_beq_eq h3]

private theorem absRefState_beq_refl (a : AbsRefState) :
    AbsRefState.beq a a = true := by
  cases a with
  | unreachable => rfl
  | reachable r x m =>
    dsimp [AbsRefState.beq]
    rw [bool_beq_refl r, bool_beq_refl x, borrowLinkMode_beq_refl m]
    rfl

/-! ### `listRel`, `programEq`, & `ProgramMetadataCompat` Lemmas -/

private theorem listRel_length {α β : Type} {r : α → β → Bool}
    {xs : List α} {ys : List β} (h : listRel r xs ys = true) :
    xs.length = ys.length := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons _ _ ih =>
    cases ys with
    | nil => cases h
    | cons _ _ =>
      let ⟨_, h2⟩ := bool_and_true h
      dsimp [List.length]
      rw [ih h2]

private theorem listRel_eq {α : Type} {r : α → α → Bool}
    (hEq : ∀ x y, r x y = true → x = y) {xs ys : List α}
    (hRel : listRel r xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases hRel
  | cons x _ ih =>
    cases ys with
    | nil => cases hRel
    | cons y _ =>
      let ⟨h1, h2⟩ := bool_and_true hRel
      rw [hEq x y h1, ih h2]

private theorem listRel_refl {α : Type} {r : α → α → Bool}
    (hRefl : ∀ x, r x x = true) (xs : List α) :
    listRel r xs xs = true := by
  induction xs with
  | nil => rfl
  | cons x _ ih =>
    dsimp [listRel]
    rw [hRefl x, ih]
    rfl

private theorem listRel_getElem?_left {α β : Type} {r : α → β → Bool}
    {xs : List α} {ys : List β} {i : Nat} {x : α}
    (hRel : listRel r xs ys = true)
    (hGet : Trusted.MirSemantics.getElem? xs i = some x) :
    ∃ y, Trusted.MirSemantics.getElem? ys i = some y ∧ r x y = true := by
  induction xs generalizing ys i with
  | nil => cases hGet
  | cons a _ ih =>
    cases ys with
    | nil => cases hRel
    | cons b _ =>
      let ⟨hab, hTail⟩ := bool_and_true hRel
      cases i with
      | zero =>
        injection hGet with hxa
        subst hxa
        exact ⟨b, rfl, hab⟩
      | succ _ =>
        dsimp [Trusted.MirSemantics.getElem?]
        exact ih hTail hGet

private theorem listRel_getElem?_right {α β : Type} {r : α → β → Bool}
    {xs : List α} {ys : List β} {i : Nat} {y : β}
    (hRel : listRel r xs ys = true)
    (hGet : Trusted.MirSemantics.getElem? ys i = some y) :
    ∃ x, Trusted.MirSemantics.getElem? xs i = some x ∧ r x y = true := by
  induction xs generalizing ys i with
  | nil =>
    cases ys with
    | nil => cases hGet
    | cons _ _ => cases hRel
  | cons a _ ih =>
    cases ys with
    | nil => cases hRel
    | cons b _ =>
      let ⟨hab, hTail⟩ := bool_and_true hRel
      cases i with
      | zero =>
        injection hGet with hyb
        subst hyb
        exact ⟨a, rfl, hab⟩
      | succ _ =>
        dsimp [Trusted.MirSemantics.getElem?]
        exact ih hTail hGet

private theorem list_map_eq_of_rel {α β γ : Type} {r : α → β → Bool}
    {f : α → γ} {g : β → γ} {xs : List α} {ys : List β}
    (hRel : listRel r xs ys = true)
    (hFG : ∀ a b, r a b = true → f a = g b) :
    xs.map f = ys.map g := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases hRel
  | cons a _ ih =>
    cases ys with
    | nil => cases hRel
    | cons b _ =>
      let ⟨hab, hTail⟩ := bool_and_true hRel
      dsimp [List.map]
      rw [hFG a b hab, ih hTail]

private theorem projElemEq_eq {a b : ProjectionElem}
    (h : projElemEq a b = true) : a = b := by
  cases a with
  | deref => cases b <;> first | rfl | cases h
  | field _ _ =>
    cases b with
    | field _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [nat_beq_eq h1, mirTy_beq_eq h2]
    | _ => cases h
  | unsupported => cases b <;> first | rfl | cases h

private theorem placeEq_eq {a b : Place} (h : placeEq a b = true) : a = b := by
  cases a with
  | mk _ _ =>
    cases b with
    | mk _ _ =>
      dsimp [placeEq] at h
      let ⟨h1, h2⟩ := bool_and_true h
      rw [nat_beq_eq h1, listRel_eq (fun _ _ => projElemEq_eq) h2]

private theorem constLitEq_eq {a b : ConstLit}
    (h : constLitEq a b = true) : a = b := by
  cases a with
  | scalar _ =>
    cases b with
    | scalar _ => rw [bitvec_beq_eq h]
    | zeroSized => cases h
  | zeroSized =>
    cases b with
    | scalar _ => cases h
    | zeroSized => rfl

private theorem constOpEq_eq {a b : ConstOperand}
    (h : constOpEq a b = true) : a = b := by
  cases a with
  | mk _ _ =>
    cases b with
    | mk _ _ =>
      dsimp [constOpEq] at h
      let ⟨h1, h2⟩ := bool_and_true h
      rw [mirTy_beq_eq h1, constLitEq_eq h2]

private theorem binOpEq_eq {a b : BinOp} (h : binOpEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem unOpEq_eq {a b : UnOp} (h : unOpEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem operandEq_eq {a b : Operand}
    (h : operandEq a b = true) : a = b := by
  cases a with
  | copy _ =>
    cases b with
    | copy _ => rw [placeEq_eq h]
    | _ => cases h
  | move _ =>
    cases b with
    | move _ => rw [placeEq_eq h]
    | _ => cases h
  | constant _ =>
    cases b with
    | constant _ => rw [constOpEq_eq h]
    | _ => cases h

private theorem rvalueEq_eq {a b : Rvalue}
    (h : rvalueEq a b = true) : a = b := by
  cases a with
  | use _ =>
    cases b with
    | use _ => rw [operandEq_eq h]
    | _ => cases h
  | binaryOp _ _ _ =>
    cases b with
    | binaryOp _ _ _ =>
      let ⟨h12, h3⟩ := bool_and_true h
      let ⟨h1, h2⟩ := bool_and_true h12
      rw [binOpEq_eq h1, operandEq_eq h2, operandEq_eq h3]
    | _ => cases h
  | unaryOp _ _ =>
    cases b with
    | unaryOp _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [unOpEq_eq h1, operandEq_eq h2]
    | _ => cases h
  | discriminant _ =>
    cases b with
    | discriminant _ => rw [placeEq_eq h]
    | _ => cases h
  | ref _ _ =>
    cases b with
    | ref _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [mutability_beq_eq h1, placeEq_eq h2]
    | _ => cases h
  | addressOf _ _ =>
    cases b with
    | addressOf _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [mutability_beq_eq h1, placeEq_eq h2]
    | _ => cases h
  | aggregateTuple _ =>
    cases b with
    | aggregateTuple _ =>
      rw [listRel_eq (fun _ _ => operandEq_eq) h]
    | _ => cases h
  | unsupported =>
    cases b <;> first | rfl | cases h

private theorem stmtEq_eq {a b : StatementKind}
    (h : stmtEq a b = true) : a = b := by
  cases a with
  | assign _ _ =>
    cases b with
    | assign _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [placeEq_eq h1, rvalueEq_eq h2]
    | _ => cases h
  | storageLive _ =>
    cases b with
    | storageLive _ => rw [nat_beq_eq h]
    | _ => cases h
  | storageDead _ =>
    cases b with
    | storageDead _ => rw [nat_beq_eq h]
    | _ => cases h
  | nop => cases b <;> first | rfl | cases h
  | unsupported => cases b <;> first | rfl | cases h

private theorem switchTargetsEq_eq {a b : SwitchTargets}
    (h : switchTargetsEq a b = true) : a = b := by
  cases a with
  | mk bs1 ow1 =>
    cases b with
    | mk bs2 ow2 =>
      dsimp [switchTargetsEq] at h
      let ⟨h1, h2⟩ := bool_and_true h
      have hOw : ow1 = ow2 := nat_beq_eq h1
      have hBs : bs1 = bs2 := listRel_eq (fun x y hxy => by
        cases x with
        | mk _ _ =>
          cases y with
          | mk _ _ =>
            dsimp at hxy
            let ⟨hv, ht⟩ := bool_and_true hxy
            rw [bitvec_beq_eq hv, nat_beq_eq ht]) h2
      rw [hOw, hBs]

private theorem unwindActionEq_eq {a b : UnwindAction}
    (h : unwindActionEq a b = true) : a = b := by
  cases a with
  | cleanup _ =>
    cases b with
    | cleanup _ => rw [nat_beq_eq h]
    | _ => cases h
  | continue_ => cases b <;> first | rfl | cases h
  | unreachable => cases b <;> first | rfl | cases h
  | terminate => cases b <;> first | rfl | cases h

private theorem assertKindEq_eq {a b : AssertKind}
    (h : assertKindEq a b = true) : a = b := by
  cases a with
  | overflow _ =>
    cases b with
    | overflow _ => rw [binOpEq_eq h]
    | _ => cases h
  | overflowNeg => cases b <;> first | rfl | cases h
  | divByZero => cases b <;> first | rfl | cases h
  | remByZero => cases b <;> first | rfl | cases h
  | boundsCheck => cases b <;> first | rfl | cases h
  | misalignedPtrDeref => cases b <;> first | rfl | cases h
  | nullPtrDeref => cases b <;> first | rfl | cases h
  | unsupported => cases b <;> first | rfl | cases h

private theorem optBlockEq_eq {a b : Option BasicBlockId}
    (h : optBlockEq a b = true) : a = b := by
  cases a with
  | none => cases b <;> first | rfl | cases h
  | some _ =>
    cases b with
    | some _ => rw [nat_beq_eq h]
    | none => cases h

private theorem terminatorEq_eq {a b : TerminatorKind}
    (h : terminatorEq a b = true) : a = b := by
  cases a with
  | goto _ =>
    cases b with
    | goto _ => rw [nat_beq_eq h]
    | _ => cases h
  | switchInt _ _ =>
    cases b with
    | switchInt _ _ =>
      let ⟨h1, h2⟩ := bool_and_true h
      rw [operandEq_eq h1, switchTargetsEq_eq h2]
    | _ => cases h
  | return_ => cases b <;> first | rfl | cases h
  | unreachable => cases b <;> first | rfl | cases h
  | unwindResume => cases b <;> first | rfl | cases h
  | assert _ _ _ _ _ =>
    cases b with
    | assert _ _ _ _ _ =>
      let ⟨h1234, h5⟩ := bool_and_true h
      let ⟨h123, h4⟩ := bool_and_true h1234
      let ⟨h12, h3⟩ := bool_and_true h123
      let ⟨h1, h2⟩ := bool_and_true h12
      rw [operandEq_eq h1, bool_beq_eq h2, assertKindEq_eq h3,
          nat_beq_eq h4, unwindActionEq_eq h5]
    | _ => cases h
  | call _ _ _ _ _ =>
    cases b with
    | call _ _ _ _ _ =>
      let ⟨h1234, h5⟩ := bool_and_true h
      let ⟨h123, h4⟩ := bool_and_true h1234
      let ⟨h12, h3⟩ := bool_and_true h123
      let ⟨h1, h2⟩ := bool_and_true h12
      rw [nat_beq_eq h1, listRel_eq (fun _ _ => operandEq_eq) h2,
          placeEq_eq h3, optBlockEq_eq h4, unwindActionEq_eq h5]
    | _ => cases h
  | unsupported => cases b <;> first | rfl | cases h

private theorem blockEq_eq {a b : BasicBlock} (h : blockEq a b = true) : a = b := by
  cases a with
  | mk _ _ _ =>
    cases b with
    | mk _ _ _ =>
      dsimp [blockEq] at h
      let ⟨h12, h3⟩ := bool_and_true h
      let ⟨h1, h2⟩ := bool_and_true h12
      rw [bool_beq_eq h1, listRel_eq (fun _ _ => stmtEq_eq) h2,
          terminatorEq_eq h3]

private theorem scopeEq_eq {a b : VerificationScope}
    (h : scopeEq a b = true) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

private theorem scopeEq_refl (a : VerificationScope) : scopeEq a a = true := by
  cases a <;> rfl

private theorem bodyHeaderEq_elim {b₁ b₂ : Body}
    (h : bodyHeaderEq b₁ b₂ = true) :
    b₁.argumentCount = b₂.argumentCount ∧
    b₁.locals = b₂.locals ∧
    b₁.isUnsafe = b₂.isUnsafe ∧
    b₁.identity = b₂.identity := by
  unfold bodyHeaderEq at h
  let ⟨h123, hId⟩ := bool_and_true h
  let ⟨h12, hUns⟩ := bool_and_true h123
  let ⟨hArg, hLoc⟩ := bool_and_true h12
  exact ⟨nat_beq_eq hArg, mirTy_beqList_eq hLoc, bool_beq_eq hUns,
         stringBeq_eq hId⟩

private theorem bodyEq_eq {b₁ b₂ : Body} (h : bodyEq b₁ b₂ = true) : b₁ = b₂ := by
  cases b₁ with
  | mk _ _ _ _ _ =>
    cases b₂ with
    | mk _ _ _ _ _ =>
      unfold bodyEq at h
      let ⟨hHdr, hBbs⟩ := bool_and_true h
      let ⟨hArg, hLoc, hUns, hId⟩ := bodyHeaderEq_elim hHdr
      have hB := listRel_eq (fun _ _ => blockEq_eq) hBbs
      dsimp at hArg hLoc hUns hId hB
      rw [hArg, hLoc, hUns, hId, hB]

private theorem programHeaderEq_elim {p₁ p₂ : Program}
    (h : programHeaderEq p₁ p₂ = true) :
    p₁.pointerWidthBits = p₂.pointerWidthBits ∧
    p₁.mirProfileVersion = p₂.mirProfileVersion ∧
    p₁.entryDefId = p₂.entryDefId ∧
    p₁.scope = p₂.scope := by
  unfold programHeaderEq at h
  let ⟨h123, hSc⟩ := bool_and_true h
  let ⟨h12, hEnt⟩ := bool_and_true h123
  let ⟨hPw, hVer⟩ := bool_and_true h12
  exact ⟨nat_beq_eq hPw, nat_beq_eq hVer, nat_beq_eq hEnt, scopeEq_eq hSc⟩

private theorem programHeaderEq_refl (p : Program) :
    programHeaderEq p p = true := by
  unfold programHeaderEq
  rw [nat_beq_refl p.pointerWidthBits, nat_beq_refl p.mirProfileVersion,
      nat_beq_refl p.entryDefId, scopeEq_refl p.scope]
  rfl

private theorem programHeaderEq_of_eq {p₁ p₂ : Program}
    (h1 : p₁.pointerWidthBits = p₂.pointerWidthBits)
    (h2 : p₁.mirProfileVersion = p₂.mirProfileVersion)
    (h3 : p₁.entryDefId = p₂.entryDefId)
    (h4 : p₁.scope = p₂.scope) :
    programHeaderEq p₁ p₂ = true := by
  unfold programHeaderEq
  rw [h1, h2, h3, h4, nat_beq_refl, nat_beq_refl, nat_beq_refl, scopeEq_refl]
  rfl

private theorem programEq_eq {p₁ p₂ : Program} (h : programEq p₁ p₂ = true) :
    p₁ = p₂ := by
  cases p₁ with
  | mk _ _ _ _ _ =>
    cases p₂ with
    | mk _ _ _ _ _ =>
      unfold programEq at h
      let ⟨hHdr, hBods⟩ := bool_and_true h
      let ⟨hPw, hVer, hEnt, hSc⟩ := programHeaderEq_elim hHdr
      have hB := listRel_eq (fun _ _ => bodyEq_eq) hBods
      dsimp at hPw hVer hEnt hSc hB
      rw [hPw, hVer, hEnt, hSc, hB]

private theorem listRel_id_refl (bs : List Body) :
    listRel (fun b₁ b₂ : Body => stringBeq b₁.identity b₂.identity) bs bs =
      true :=
  listRel_refl (fun b => stringBeq_refl b.identity) bs

private theorem listRel_id_trans {bs₁ bs₂ bs₃ : List Body}
    (h12 :
      listRel (fun b₁ b₂ : Body => stringBeq b₁.identity b₂.identity)
        bs₁ bs₂ = true)
    (h23 :
      listRel (fun b₁ b₂ : Body => stringBeq b₁.identity b₂.identity)
        bs₂ bs₃ = true) :
    listRel (fun b₁ b₂ : Body => stringBeq b₁.identity b₂.identity)
      bs₁ bs₃ = true := by
  induction bs₁ generalizing bs₂ bs₃ with
  | nil =>
    cases bs₂ with
    | nil =>
      cases bs₃ with
      | nil => rfl
      | cons _ _ => cases h23
    | cons _ _ => cases h12
  | cons a rest₁ ih =>
    cases bs₂ with
    | nil => cases h12
    | cons b rest₂ =>
      cases bs₃ with
      | nil => cases h23
      | cons c rest₃ =>
        let ⟨hab, hR12⟩ := bool_and_true h12
        let ⟨hbc, hR23⟩ := bool_and_true h23
        have hac : stringBeq a.identity c.identity = true := by
          rw [stringBeq_eq hab, stringBeq_eq hbc]
          exact stringBeq_refl c.identity
        exact bool_and_intro hac (ih hR12 hR23)

private theorem programMetadataCompat_refl (p : Program) :
    ProgramMetadataCompat p p = true :=
  bool_and_intro (programHeaderEq_refl p) (listRel_id_refl p.bodies)

private theorem programMetadataCompat_trans {p₁ p₂ p₃ : Program}
    (h12 : ProgramMetadataCompat p₁ p₂ = true)
    (h23 : ProgramMetadataCompat p₂ p₃ = true) :
    ProgramMetadataCompat p₁ p₃ = true := by
  let ⟨hH12, hB12⟩ := bool_and_true h12
  let ⟨hH23, hB23⟩ := bool_and_true h23
  let ⟨hpw1, hmp1, hed1, hsc1⟩ := programHeaderEq_elim hH12
  let ⟨hpw2, hmp2, hed2, hsc2⟩ := programHeaderEq_elim hH23
  exact bool_and_intro
    (programHeaderEq_of_eq (hpw1.trans hpw2) (hmp1.trans hmp2)
      (hed1.trans hed2) (hsc1.trans hsc2))
    (listRel_id_trans hB12 hB23)

private theorem programMetadataCompat_bodies_len {p₁ p₂ : Program}
    (h : ProgramMetadataCompat p₁ p₂ = true) :
    p₁.bodies.length = p₂.bodies.length := by
  let ⟨_, hB⟩ := bool_and_true h
  exact listRel_length hB

private theorem programMetadataCompat_unitProgForDef {p₁ p₂ : Program} (u : DefId)
    (h : ProgramMetadataCompat p₁ p₂ = true) :
    ProgramMetadataCompat (unitProgForDef p₁ u) (unitProgForDef p₂ u) =
      true := by
  let ⟨hHdr, hB⟩ := bool_and_true h
  let ⟨hpw, hmp, _, _⟩ := programHeaderEq_elim hHdr
  exact bool_and_intro (programHeaderEq_of_eq hpw hmp rfl rfl) hB

/-! ### List, `getElem?`, `setElem?`, `map`, `all`, `any`, `listMapOption` -/

private theorem getElem?_some_lt {α : Type} {xs : List α} {i : Nat} {x : α}
    (h : Trusted.MirSemantics.getElem? xs i = some x) : i < xs.length := by
  induction xs generalizing i with
  | nil => cases h
  | cons _ xs ih =>
    cases i with
    | zero => exact Nat.zero_lt_succ xs.length
    | succ _ => exact Nat.succ_lt_succ (ih h)

private theorem getElem?_none_of_ge {α : Type} {xs : List α} {i : Nat}
    (h : xs.length ≤ i) : Trusted.MirSemantics.getElem? xs i = none := by
  induction xs generalizing i with
  | nil => rfl
  | cons _ xs ih =>
    cases i with
    | zero => exact False.elim (Nat.not_succ_le_zero xs.length h)
    | succ _ => exact ih (Nat.le_of_succ_le_succ h)

private theorem getElem?_some_of_lt {α : Type} (xs : List α) (i : Nat)
    (h : i < xs.length) :
    ∃ x, Trusted.MirSemantics.getElem? xs i = some x := by
  induction xs generalizing i with
  | nil => exact False.elim (Nat.not_lt_zero i h)
  | cons a _ ih =>
    cases i with
    | zero => exact ⟨a, rfl⟩
    | succ k => exact ih k (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_none_ge {α : Type} {xs : List α} {i : Nat}
    (h : Trusted.MirSemantics.getElem? xs i = none) : xs.length ≤ i := by
  cases Nat.lt_or_ge i xs.length with
  | inl hlt =>
    let ⟨_, hx⟩ := getElem?_some_of_lt xs i hlt
    rw [h] at hx
    cases hx
  | inr hge => exact hge

private theorem list_eq_of_getElem?_eq {α : Type} {xs ys : List α}
    (hLen : xs.length = ys.length)
    (hAt : ∀ i, Trusted.MirSemantics.getElem? xs i =
      Trusted.MirSemantics.getElem? ys i) :
    xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases hLen
  | cons _ _ ih =>
    cases ys with
    | nil => cases hLen
    | cons _ _ =>
      have h0 := hAt 0
      dsimp [Trusted.MirSemantics.getElem?] at h0
      injection h0 with hxy
      subst hxy
      rw [ih (Nat.succ.inj hLen) (fun i => hAt (i + 1))]

private theorem setElem?_length {α : Type} {xs xs' : List α} {i : Nat} {v : α}
    (h : setElem? xs i v = some xs') : xs'.length = xs.length := by
  induction xs generalizing xs' i with
  | nil => cases h
  | cons _ _ ih =>
    cases i with
    | zero =>
      injection h with hEq; subst hEq; rfl
    | succ k =>
      dsimp [setElem?] at h
      cases hSub : setElem? _ k v with
      | none => rw [hSub] at h; cases h
      | some _ =>
        rw [hSub] at h
        injection h with hEq; subst hEq
        dsimp [List.length]
        rw [ih hSub]

private theorem setElem?_some_lt {α : Type} {xs xs' : List α} {i : Nat} {v : α}
    (h : setElem? xs i v = some xs') : i < xs.length := by
  induction xs generalizing xs' i with
  | nil => cases h
  | cons _ _ ih =>
    cases i with
    | zero => exact Nat.zero_lt_succ _
    | succ k =>
      dsimp [setElem?] at h
      cases hSub : setElem? _ k v with
      | none => rw [hSub] at h; cases h
      | some _ => exact Nat.succ_lt_succ (ih hSub)

private theorem setElem?_getElem?_same {α : Type} {xs xs' : List α} {i : Nat}
    {v : α} (h : setElem? xs i v = some xs') :
    Trusted.MirSemantics.getElem? xs' i = some v := by
  induction xs generalizing xs' i with
  | nil => cases h
  | cons _ _ ih =>
    cases i with
    | zero =>
      injection h with hEq; subst hEq; rfl
    | succ k =>
      dsimp [setElem?] at h
      cases hSub : setElem? _ k v with
      | none => rw [hSub] at h; cases h
      | some _ =>
        rw [hSub] at h
        injection h with hEq; subst hEq
        dsimp [Trusted.MirSemantics.getElem?]
        exact ih hSub

private theorem setElem?_getElem?_ne {α : Type} {xs xs' : List α} {i j : Nat}
    {v : α} (h : setElem? xs i v = some xs') (hNe : j ≠ i) :
    Trusted.MirSemantics.getElem? xs' j =
      Trusted.MirSemantics.getElem? xs j := by
  induction xs generalizing xs' i j with
  | nil => cases h
  | cons _ _ ih =>
    cases i with
    | zero =>
      injection h with hEq; subst hEq
      cases j with
      | zero => exact False.elim (hNe rfl)
      | succ _ => rfl
    | succ k =>
      dsimp [setElem?] at h
      cases hSub : setElem? _ k v with
      | none => rw [hSub] at h; cases h
      | some _ =>
        rw [hSub] at h
        injection h with hEq; subst hEq
        cases j with
        | zero => rfl
        | succ _ => exact ih hSub (fun hEq => hNe (by rw [hEq]))

private theorem setElem?_some_of_lt {α : Type} (xs : List α) (i : Nat) (v : α)
    (h : i < xs.length) : ∃ xs', setElem? xs i v = some xs' := by
  induction xs generalizing i with
  | nil => exact False.elim (Nat.not_lt_zero i h)
  | cons a _ ih =>
    cases i with
    | zero => exact ⟨v :: _, rfl⟩
    | succ k =>
      let ⟨sub, hSub⟩ := ih k (Nat.lt_of_succ_lt_succ h)
      exact ⟨a :: sub, by dsimp [setElem?]; rw [hSub]⟩

private theorem setElem?_none_of_ge {α : Type} (xs : List α) (i : Nat) (v : α)
    (h : xs.length ≤ i) : setElem? xs i v = none := by
  induction xs generalizing i with
  | nil => rfl
  | cons _ _ ih =>
    cases i with
    | zero => exact False.elim (Nat.not_succ_le_zero _ h)
    | succ k =>
      dsimp [setElem?]
      rw [ih k (Nat.le_of_succ_le_succ h)]

private theorem setElem?_overwrite {α : Type} {xs xs₁ : List α} {i : Nat}
    {v₁ v₂ : α} (h : setElem? xs i v₁ = some xs₁) :
    setElem? xs₁ i v₂ = setElem? xs i v₂ := by
  induction xs generalizing xs₁ i with
  | nil => cases h
  | cons a rest ih =>
    cases i with
    | zero =>
      injection h with hEq; subst hEq; rfl
    | succ k =>
      dsimp [setElem?] at h
      cases hSub : setElem? rest k v₁ with
      | none => rw [hSub] at h; cases h
      | some sub =>
        rw [hSub] at h
        injection h with hEq; subst hEq
        dsimp [setElem?]
        rw [ih hSub]

private theorem setElem?_noop_of_getElem? {α : Type} {xs : List α} {i : Nat}
    {v : α} (h : Trusted.MirSemantics.getElem? xs i = some v) :
    setElem? xs i v = some xs := by
  induction xs generalizing i with
  | nil => cases h
  | cons a rest ih =>
    cases i with
    | zero =>
      injection h with hEq; subst hEq; rfl
    | succ k =>
      dsimp [setElem?]
      rw [ih h]

private theorem list_append_length {α : Type} (xs ys : List α) :
    (xs ++ ys).length = xs.length + ys.length := by
  induction xs with
  | nil => dsimp [List.length]; rw [Nat.zero_add]
  | cons _ _ ih =>
    dsimp [List.length]
    rw [ih, Nat.succ_add]

private theorem getElem?_append_left {α : Type} (xs ys : List α) (i : Nat)
    (h : i < xs.length) :
    Trusted.MirSemantics.getElem? (xs ++ ys) i =
      Trusted.MirSemantics.getElem? xs i := by
  induction xs generalizing i with
  | nil => exact False.elim (Nat.not_lt_zero i h)
  | cons _ _ ih =>
    cases i with
    | zero => rfl
    | succ k => exact ih k (Nat.lt_of_succ_lt_succ h)

private theorem getElem?_append_right_add {α : Type} (xs ys : List α) (j : Nat) :
    Trusted.MirSemantics.getElem? (xs ++ ys) (xs.length + j) =
      Trusted.MirSemantics.getElem? ys j := by
  induction xs with
  | nil =>
    dsimp [List.length]
    rw [Nat.zero_add]
  | cons _ _ ih =>
    dsimp [List.length]
    rw [Nat.succ_add]
    exact ih

private theorem map_length_eq {α β : Type} (f : α → β) (xs : List α) :
    (xs.map f).length = xs.length := by
  induction xs with
  | nil => rfl
  | cons _ _ ih =>
    dsimp [List.map, List.length]
    rw [ih]

private theorem getElem?_map {α β : Type} (f : α → β) (xs : List α) (i : Nat) :
    Trusted.MirSemantics.getElem? (xs.map f) i =
      (Trusted.MirSemantics.getElem? xs i).map f := by
  induction xs generalizing i with
  | nil => rfl
  | cons _ _ ih =>
    cases i with
    | zero => rfl
    | succ k => exact ih k

private theorem map_setElem? {α β : Type} (f : α → β) {xs xs' : List α}
    {i : Nat} {v : α} (h : setElem? xs i v = some xs') :
    setElem? (xs.map f) i (f v) = some (xs'.map f) := by
  induction xs generalizing xs' i with
  | nil => cases h
  | cons _ rest ih =>
    cases i with
    | zero =>
      injection h with hEq; subst hEq; rfl
    | succ k =>
      dsimp [setElem?] at h
      cases hSub : setElem? rest k v with
      | none => rw [hSub] at h; cases h
      | some _ =>
        rw [hSub] at h
        injection h with hEq; subst hEq
        dsimp [List.map, setElem?]
        rw [ih hSub]

private theorem setElem?_map_eq {α β : Type} (f : α → β) (xs : List α) (i : Nat)
    (v : α) :
    setElem? (xs.map f) i (f v) = (setElem? xs i v).map (List.map f) := by
  induction xs generalizing i with
  | nil => rfl
  | cons _ rest ih =>
    cases i with
    | zero => rfl
    | succ k =>
      dsimp [List.map, setElem?]
      rw [ih k]
      cases setElem? rest k v <;> rfl

private theorem list_all_getElem? {α : Type} {p : α → Bool} {xs : List α}
    {i : Nat} {x : α} (hAll : xs.all p = true)
    (hGet : Trusted.MirSemantics.getElem? xs i = some x) : p x = true := by
  induction xs generalizing i with
  | nil => cases hGet
  | cons _ _ ih =>
    let ⟨ha, hRest⟩ := bool_and_true hAll
    cases i with
    | zero =>
      injection hGet with hEq; subst hEq; exact ha
    | succ _ => exact ih hRest hGet

private theorem list_all_of_forall_getElem? {α : Type} {p : α → Bool}
    {xs : List α}
    (h : ∀ i x, Trusted.MirSemantics.getElem? xs i = some x → p x = true) :
    xs.all p = true := by
  induction xs with
  | nil => rfl
  | cons a _ ih =>
    have ha : p a = true := h 0 a rfl
    have hRest : _ = true := ih (fun i x hG => h (i + 1) x hG)
    exact bool_and_intro ha hRest

private theorem list_all_append {α : Type} (p : α → Bool) (xs ys : List α) :
    (xs ++ ys).all p = (xs.all p && ys.all p) := by
  induction xs with
  | nil => rfl
  | cons a _ ih =>
    dsimp [List.all]
    cases p a with
    | false => rfl
    | true => exact ih

private theorem list_all_map {α β : Type} (p : β → Bool) (f : α → β)
    (xs : List α) :
    (xs.map f).all p = xs.all (fun a => p (f a)) := by
  induction xs with
  | nil => rfl
  | cons a _ ih =>
    dsimp [List.map, List.all]
    cases p (f a) with
    | false => rfl
    | true => exact ih

private theorem list_all_setElem? {α : Type} {p : α → Bool} {xs xs' : List α}
    {i : Nat} {v : α} (hAll : xs.all p = true) (hv : p v = true)
    (hSet : setElem? xs i v = some xs') : xs'.all p = true := by
  apply list_all_of_forall_getElem?
  intro j x hGet
  cases hEq : Nat.beq j i with
  | true =>
    have hji := nat_beq_eq hEq
    subst hji
    rw [setElem?_getElem?_same hSet] at hGet
    injection hGet with hxv
    subst hxv
    exact hv
  | false =>
    rw [setElem?_getElem?_ne hSet (nat_ne_of_beq_false hEq)] at hGet
    exact list_all_getElem? hAll hGet

private theorem list_any_append {α : Type} (p : α → Bool) (xs ys : List α) :
    (xs ++ ys).any p = (xs.any p || ys.any p) := by
  induction xs with
  | nil => rfl
  | cons a _ ih =>
    dsimp [List.any]
    cases p a with
    | true => rfl
    | false => exact ih

private theorem list_any_map {α β : Type} (p : β → Bool) (f : α → β)
    (xs : List α) :
    (xs.map f).any p = xs.any (fun a => p (f a)) := by
  induction xs with
  | nil => rfl
  | cons a _ ih =>
    dsimp [List.map, List.any]
    cases p (f a) with
    | true => rfl
    | false => exact ih

private theorem list_any_false_of_forall_getElem? {α : Type} {p : α → Bool}
    {xs : List α}
    (h : ∀ i x,
      Trusted.MirSemantics.getElem? xs i = some x → p x = false) :
    xs.any p = false := by
  induction xs with
  | nil => rfl
  | cons a _ ih =>
    have ha : p a = false := h 0 a rfl
    have hRest : _ = false := ih (fun i x hG => h (i + 1) x hG)
    dsimp [List.any]
    rw [ha, hRest]
    rfl

private theorem list_any_true_of_getElem? {α : Type} {p : α → Bool} {xs : List α}
    {i : Nat} {x : α} (hGet : Trusted.MirSemantics.getElem? xs i = some x)
    (hP : p x = true) : xs.any p = true := by
  induction xs generalizing i with
  | nil => cases hGet
  | cons a _ ih =>
    cases i with
    | zero =>
      injection hGet with hEq; subst hEq
      dsimp [List.any]
      rw [hP]
      rfl
    | succ _ =>
      dsimp [List.any]
      rw [ih hGet]
      cases p a <;> rfl

private theorem list_any_exists_getElem? {α : Type} {p : α → Bool} {xs : List α}
    (h : xs.any p = true) :
    ∃ i x, Trusted.MirSemantics.getElem? xs i = some x ∧ p x = true := by
  induction xs with
  | nil => cases h
  | cons a _ ih =>
    dsimp [List.any] at h
    cases hPa : p a with
    | true => exact ⟨0, a, rfl, hPa⟩
    | false =>
      rw [hPa] at h
      let ⟨i, x, hGet, hPx⟩ := ih h
      exact ⟨i + 1, x, hGet, hPx⟩

private theorem list_any_false_getElem? {α : Type} {p : α → Bool} {xs : List α}
    {i : Nat} {x : α} (hAny : xs.any p = false)
    (hGet : Trusted.MirSemantics.getElem? xs i = some x) : p x = false := by
  cases hPx : p x with
  | false => rfl
  | true =>
    have hT := list_any_true_of_getElem? hGet hPx
    rw [hAny] at hT
    cases hT

private theorem list_any_eq_of_getElem? {α : Type} {p : α → Bool}
    {xs ys : List α} (hLen : xs.length = ys.length)
    (hAt : ∀ i x y,
      Trusted.MirSemantics.getElem? xs i = some x →
      Trusted.MirSemantics.getElem? ys i = some y →
      p x = p y) :
    xs.any p = ys.any p := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases hLen
  | cons a _ ih =>
    cases ys with
    | nil => cases hLen
    | cons b _ =>
      have hHead : p a = p b := hAt 0 a b rfl rfl
      have hTail :=
        ih (Nat.succ.inj hLen) (fun i x y hx hy => hAt (i + 1) x y hx hy)
      dsimp [List.any]
      rw [hHead, hTail]

private theorem list_isEmpty_eq_of_length {α β : Type} {xs : List α}
    {ys : List β} (h : xs.length = ys.length) :
    xs.isEmpty = ys.isEmpty := by
  cases xs with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons _ _ =>
    cases ys with
    | nil => cases h
    | cons _ _ => rfl

private theorem listMapOption_length {α β : Type} {f : α → Option β}
    {xs : List α} {ys : List β} (h : listMapOption f xs = some ys) :
    ys.length = xs.length := by
  induction xs generalizing ys with
  | nil =>
    injection h with hEq; subst hEq; rfl
  | cons a rest ih =>
    dsimp [listMapOption] at h
    cases hFa : f a with
    | none => rw [hFa] at h; cases h
    | some _ =>
      rw [hFa] at h
      cases hRest : listMapOption f rest with
      | none => rw [hRest] at h; cases h
      | some _ =>
        rw [hRest] at h
        injection h with hEq; subst hEq
        dsimp [List.length]
        rw [ih hRest]

private theorem listMapOption_getElem?_left {α β : Type} {f : α → Option β}
    {xs : List α} {ys : List β} {i : Nat} {x : α}
    (hMap : listMapOption f xs = some ys)
    (hGet : Trusted.MirSemantics.getElem? xs i = some x) :
    ∃ y, Trusted.MirSemantics.getElem? ys i = some y ∧ f x = some y := by
  induction xs generalizing ys i with
  | nil => cases hGet
  | cons a rest ih =>
    dsimp [listMapOption] at hMap
    cases hFa : f a with
    | none => rw [hFa] at hMap; cases hMap
    | some b =>
      rw [hFa] at hMap
      cases hRest : listMapOption f rest with
      | none => rw [hRest] at hMap; cases hMap
      | some bs =>
        rw [hRest] at hMap
        injection hMap with hEq; subst hEq
        cases i with
        | zero =>
          injection hGet with hxa; subst hxa
          exact ⟨b, rfl, hFa⟩
        | succ k =>
          dsimp [Trusted.MirSemantics.getElem?]
          exact @ih bs k hRest hGet

private theorem listMapOption_getElem?_right {α β : Type} {f : α → Option β}
    {xs : List α} {ys : List β} {i : Nat} {y : β}
    (hMap : listMapOption f xs = some ys)
    (hGet : Trusted.MirSemantics.getElem? ys i = some y) :
    ∃ x, Trusted.MirSemantics.getElem? xs i = some x ∧ f x = some y := by
  induction xs generalizing ys i with
  | nil =>
    injection hMap with hEq; subst hEq; cases hGet
  | cons a rest ih =>
    dsimp [listMapOption] at hMap
    cases hFa : f a with
    | none => rw [hFa] at hMap; cases hMap
    | some b =>
      rw [hFa] at hMap
      cases hRest : listMapOption f rest with
      | none => rw [hRest] at hMap; cases hMap
      | some bs =>
        rw [hRest] at hMap
        injection hMap with hEq; subst hEq
        cases i with
        | zero =>
          injection hGet with hyb; subst hyb
          exact ⟨a, rfl, hFa⟩
        | succ k =>
          dsimp [Trusted.MirSemantics.getElem?]
          exact @ih bs k hRest hGet

private theorem listMapOption_map_some {α β γ : Type} (g : α → β)
    (f : β → Option γ) {h : α → γ} (hfg : ∀ a, f (g a) = some (h a))
    (xs : List α) :
    listMapOption f (xs.map g) = some (xs.map h) := by
  induction xs with
  | nil => rfl
  | cons a rest ih =>
    dsimp [List.map, listMapOption]
    rw [hfg a, ih]

private theorem bodiesHaveUniqueIdentities_eq_of_map_id {bs₁ bs₂ : List Body}
    (hIds : bs₁.map (fun b => b.identity) = bs₂.map (fun b => b.identity)) :
    bodiesHaveUniqueIdentities bs₁ = bodiesHaveUniqueIdentities bs₂ := by
  unfold bodiesHaveUniqueIdentities
  have hAll : bs₁.all (fun b => !stringBeq b.identity "") =
      bs₂.all (fun b => !stringBeq b.identity "") := by
    have h1 :=
      list_all_map (fun s => !stringBeq s "") (fun b : Body => b.identity) bs₁
    have h2 :=
      list_all_map (fun s => !stringBeq s "") (fun b : Body => b.identity) bs₂
    rw [← h1, ← h2, hIds]
  rw [hAll, hIds]

private theorem bodiesHaveUniqueIdentities_eq_of_rel {bs₁ bs₂ : List Body}
    (hRel :
      listRel (fun b₁ b₂ : Body => stringBeq b₁.identity b₂.identity)
        bs₁ bs₂ = true) :
    bodiesHaveUniqueIdentities bs₁ = bodiesHaveUniqueIdentities bs₂ :=
  bodiesHaveUniqueIdentities_eq_of_map_id
    (list_map_eq_of_rel hRel (fun _ _ h => stringBeq_eq h))

private theorem initLocalsRefLoop_length (body : Body) (args : List Val)
    (base : Nat) (tys : List MirTy) :
    (initLocalsRefLoop body args base tys).length = tys.length := by
  induction tys generalizing base with
  | nil => rfl
  | cons _ _ ih =>
    dsimp [initLocalsRefLoop, List.length]
    rw [ih (base + 1)]

private theorem initLocalsRefLoop_getElem? (body : Body) (args : List Val)
    (base : Nat) (tys : List MirTy) (i : Nat) (ty : MirTy)
    (hTy : Trusted.MirSemantics.getElem? tys i = some ty) :
    Trusted.MirSemantics.getElem? (initLocalsRefLoop body args base tys) i =
      some (if Nat.beq (base + i) 0 then
              liveUninitSlotRef ty
            else if Nat.ble (base + i) body.argumentCount then
              match Trusted.MirSemantics.getElem? args ((base + i) - 1) with
              | some v => .live (some (.base v))
              | none => .dead
            else if hasStorageAnnotation body (base + i) then
              .dead
            else
              liveUninitSlotRef ty) := by
  induction tys generalizing base i with
  | nil => cases hTy
  | cons _ _ ih =>
    cases i with
    | zero =>
      injection hTy with hEq; subst hEq; rfl
    | succ k =>
      have hAdd : base + 1 + k = base + (k + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 k]
      have hRec := ih (base + 1) k hTy
      rw [hAdd] at hRec
      exact hRec

/-! ### Deterministic Step, Fuel, Reachability, & Lockstep Simulation -/

private noncomputable def evalMirFuel (p : Program) :
    Nat → State → StepResult State TerminalOut
  | 0, s => .step s
  | fuel + 1, s =>
    match evalStep p 0 s with
    | .step s' => evalMirFuel p fuel s'
    | .done out => .done out
    | .fault k => .fault k

private noncomputable def iterMirStep (p : Program) (s₀ : State) : Nat → State
  | 0 => s₀
  | n + 1 =>
    match evalStep p 0 (iterMirStep p s₀ n) with
    | .step s' => s'
    | _ => s₀

private theorem step_iff_evalStep {p : Program} {s : State}
    {res : StepResult State TerminalOut} :
    Step p s res ↔ evalStep p 0 s = res := by
  constructor
  · intro ⟨c, hc, hEval⟩
    have hc0 : c = 0 := hc
    subst hc0
    exact hEval
  · intro h
    exact ⟨0, rfl, h⟩

private theorem stepRef_iff_evalStepRef {p : Program} {s : ExecStateRef}
    {res : StepResult ExecStateRef TerminalOut} :
    StepRef p s res ↔ evalStepRef p 0 s = res := by
  constructor
  · intro ⟨c, hc, hEval⟩
    have hc0 : c = 0 := hc
    subst hc0
    exact hEval
  · intro h
    exact ⟨0, rfl, h⟩

private theorem reaches_head_priv {p : Program} {s₁ s₂ s₃ : State}
    (hFirst : Step p s₁ (.step s₂)) (hRest : Reaches p s₂ s₃) :
    Reaches p s₁ s₃ := by
  induction hRest with
  | refl => exact Reaches.tail (Reaches.refl s₁) hFirst
  | tail _ hLast ih => exact Reaches.tail ih hLast

private theorem reachesRef_head_priv {p : Program} {s₁ s₂ s₃ : ExecStateRef}
    (hFirst : StepRef p s₁ (.step s₂)) (hRest : ReachesRef p s₂ s₃) :
    ReachesRef p s₁ s₃ := by
  induction hRest with
  | refl => exact ReachesRef.tail (ReachesRef.refl s₁) hFirst
  | tail _ hLast ih => exact ReachesRef.tail ih hLast

private theorem evalMirFuel_add (p : Program) (m n : Nat) (s : State) :
    evalMirFuel p (m + n) s =
      match evalMirFuel p m s with
      | .step s' => evalMirFuel p n s'
      | .done out => .done out
      | .fault k => .fault k := by
  induction m generalizing s with
  | zero => rw [Nat.zero_add]; rfl
  | succ k ih =>
    rw [Nat.succ_add]
    dsimp [evalMirFuel]
    cases evalStep p 0 s with
    | step s' => exact ih s'
    | done _ => rfl
    | fault _ => rfl

private theorem evalRefFuel_add (p : Program) (m n : Nat) (s : ExecStateRef) :
    evalRefFuel p (m + n) s =
      match evalRefFuel p m s with
      | .step s' => evalRefFuel p n s'
      | .done out => .done out
      | .fault k => .fault k := by
  induction m generalizing s with
  | zero => rw [Nat.zero_add]; rfl
  | succ k ih =>
    rw [Nat.succ_add]
    dsimp [evalRefFuel]
    cases evalStepRef p 0 s with
    | step s' => exact ih s'
    | done _ => rfl
    | fault _ => rfl

private theorem reaches_of_evalMirFuel {p : Program} {n : Nat} {s₀ s : State}
    (h : evalMirFuel p n s₀ = .step s) : Reaches p s₀ s := by
  induction n generalizing s₀ with
  | zero =>
    dsimp [evalMirFuel] at h
    injection h with hEq; subst hEq
    exact Reaches.refl s₀
  | succ _ ih =>
    dsimp [evalMirFuel] at h
    cases hStep : evalStep p 0 s₀ with
    | step s' =>
      rw [hStep] at h
      exact reaches_head_priv ⟨0, rfl, hStep⟩ (ih h)
    | done _ => rw [hStep] at h; cases h
    | fault _ => rw [hStep] at h; cases h

private theorem exists_evalMirFuel_of_reaches {p : Program} {s₀ s : State}
    (h : Reaches p s₀ s) : ∃ n, evalMirFuel p n s₀ = .step s := by
  induction h with
  | refl => exact ⟨0, rfl⟩
  | tail _ hStep ih =>
    let ⟨n, hn⟩ := ih
    let ⟨c, hc, hEval⟩ := hStep
    have hc0 : c = 0 := hc
    subst hc0
    refine ⟨n + 1, ?_⟩
    rw [evalMirFuel_add, hn]
    dsimp [evalMirFuel]
    rw [hEval]

private theorem evalMirFuel_terminal_of_reaches {p : Program}
    {s₀ s : State} {res : StepResult State TerminalOut}
    (hR : Reaches p s₀ s) (hS : Step p s res) :
    ∃ n, evalMirFuel p (n + 1) s₀ = res := by
  let ⟨n, hn⟩ := exists_evalMirFuel_of_reaches hR
  let ⟨c, hc, hEval⟩ := hS
  have hc0 : c = 0 := hc
  subst hc0
  refine ⟨n, ?_⟩
  rw [evalMirFuel_add, hn]
  dsimp [evalMirFuel]
  rw [hEval]
  cases res <;> rfl

private theorem reaches_and_step_of_evalMirFuel_done {p : Program}
    {n : Nat} {s₀ : State} {out : TerminalOut}
    (h : evalMirFuel p n s₀ = .done out) :
    ∃ s, Reaches p s₀ s ∧ Step p s (.done out) := by
  induction n generalizing s₀ with
  | zero => dsimp [evalMirFuel] at h; cases h
  | succ _ ih =>
    dsimp [evalMirFuel] at h
    cases hStep : evalStep p 0 s₀ with
    | step s' =>
      rw [hStep] at h
      let ⟨s, hR, hT⟩ := ih h
      exact ⟨s, reaches_head_priv ⟨0, rfl, hStep⟩ hR, hT⟩
    | done o =>
      rw [hStep] at h
      injection h with hEq; subst hEq
      exact ⟨s₀, Reaches.refl s₀, ⟨0, rfl, hStep⟩⟩
    | fault _ => rw [hStep] at h; cases h

private theorem reaches_and_step_of_evalMirFuel_fault {p : Program}
    {n : Nat} {s₀ : State} {fk : FaultKind}
    (h : evalMirFuel p n s₀ = .fault fk) :
    ∃ s, Reaches p s₀ s ∧ Step p s (.fault fk) := by
  induction n generalizing s₀ with
  | zero => dsimp [evalMirFuel] at h; cases h
  | succ _ ih =>
    dsimp [evalMirFuel] at h
    cases hStep : evalStep p 0 s₀ with
    | step s' =>
      rw [hStep] at h
      let ⟨s, hR, hT⟩ := ih h
      exact ⟨s, reaches_head_priv ⟨0, rfl, hStep⟩ hR, hT⟩
    | done _ => rw [hStep] at h; cases h
    | fault k' =>
      rw [hStep] at h
      injection h with hEq; subst hEq
      exact ⟨s₀, Reaches.refl s₀, ⟨0, rfl, hStep⟩⟩

private theorem reachesRef_of_evalRefFuel {p : Program} {n : Nat}
    {s₀ s : ExecStateRef} (h : evalRefFuel p n s₀ = .step s) :
    ReachesRef p s₀ s := by
  induction n generalizing s₀ with
  | zero =>
    dsimp [evalRefFuel] at h
    injection h with hEq; subst hEq
    exact ReachesRef.refl s₀
  | succ _ ih =>
    dsimp [evalRefFuel] at h
    cases hStep : evalStepRef p 0 s₀ with
    | step s' =>
      rw [hStep] at h
      exact reachesRef_head_priv ⟨0, rfl, hStep⟩ (ih h)
    | done _ => rw [hStep] at h; cases h
    | fault _ => rw [hStep] at h; cases h

private theorem exists_evalRefFuel_of_reachesRef {p : Program}
    {s₀ s : ExecStateRef} (h : ReachesRef p s₀ s) :
    ∃ n, evalRefFuel p n s₀ = .step s := by
  induction h with
  | refl => exact ⟨0, rfl⟩
  | tail _ hStep ih =>
    let ⟨n, hn⟩ := ih
    let ⟨c, hc, hEval⟩ := hStep
    have hc0 : c = 0 := hc
    subst hc0
    refine ⟨n + 1, ?_⟩
    rw [evalRefFuel_add, hn]
    dsimp [evalRefFuel]
    rw [hEval]

private theorem evalRefFuel_terminal_of_reachesRef {p : Program}
    {s₀ s : ExecStateRef} {res : StepResult ExecStateRef TerminalOut}
    (hR : ReachesRef p s₀ s) (hS : StepRef p s res) :
    ∃ n, evalRefFuel p (n + 1) s₀ = res := by
  let ⟨n, hn⟩ := exists_evalRefFuel_of_reachesRef hR
  let ⟨c, hc, hEval⟩ := hS
  have hc0 : c = 0 := hc
  subst hc0
  refine ⟨n, ?_⟩
  rw [evalRefFuel_add, hn]
  dsimp [evalRefFuel]
  rw [hEval]
  cases res <;> rfl

private theorem reachesRef_and_stepRef_of_evalRefFuel_done {p : Program}
    {n : Nat} {s₀ : ExecStateRef} {out : TerminalOut}
    (h : evalRefFuel p n s₀ = .done out) :
    ∃ s, ReachesRef p s₀ s ∧ StepRef p s (.done out) := by
  induction n generalizing s₀ with
  | zero => dsimp [evalRefFuel] at h; cases h
  | succ _ ih =>
    dsimp [evalRefFuel] at h
    cases hStep : evalStepRef p 0 s₀ with
    | step s' =>
      rw [hStep] at h
      let ⟨s, hR, hT⟩ := ih h
      exact ⟨s, reachesRef_head_priv ⟨0, rfl, hStep⟩ hR, hT⟩
    | done o =>
      rw [hStep] at h
      injection h with hEq; subst hEq
      exact ⟨s₀, ReachesRef.refl s₀, ⟨0, rfl, hStep⟩⟩
    | fault _ => rw [hStep] at h; cases h

private theorem reachesRef_and_stepRef_of_evalRefFuel_fault {p : Program}
    {n : Nat} {s₀ : ExecStateRef} {fk : FaultKind}
    (h : evalRefFuel p n s₀ = .fault fk) :
    ∃ s, ReachesRef p s₀ s ∧ StepRef p s (.fault fk) := by
  induction n generalizing s₀ with
  | zero => dsimp [evalRefFuel] at h; cases h
  | succ _ ih =>
    dsimp [evalRefFuel] at h
    cases hStep : evalStepRef p 0 s₀ with
    | step s' =>
      rw [hStep] at h
      let ⟨s, hR, hT⟩ := ih h
      exact ⟨s, reachesRef_head_priv ⟨0, rfl, hStep⟩ hR, hT⟩
    | done _ => rw [hStep] at h; cases h
    | fault k' =>
      rw [hStep] at h
      injection h with hEq; subst hEq
      exact ⟨s₀, ReachesRef.refl s₀, ⟨0, rfl, hStep⟩⟩

private theorem diverges_iff_forall_evalMirFuel (p : Program) (q : Query) :
    Diverges p q ↔
      ∃ s₀ : State,
        initState p q = .ok s₀ ∧
        ∀ n : Nat, ∃ s' : State, evalMirFuel p n s₀ = .step s' := by
  constructor
  · intro ⟨s₀, hInit, trace, h0, hSteps⟩
    refine ⟨s₀, hInit, ?_⟩
    intro n
    have hFuel : ∀ k, evalMirFuel p k s₀ = .step (trace k) := by
      intro k
      induction k with
      | zero => exact congrArg StepResult.step h0.symm
      | succ m ih =>
        rw [evalMirFuel_add, ih]
        dsimp [evalMirFuel]
        let ⟨c, hc, hEv⟩ := hSteps m
        have hc0 : c = 0 := hc
        subst hc0
        rw [hEv]
    exact ⟨trace n, hFuel n⟩
  · intro ⟨s₀, hInit, hAll⟩
    refine ⟨s₀, hInit, iterMirStep p s₀, rfl, ?_⟩
    have hFuel : ∀ k, evalMirFuel p k s₀ = .step (iterMirStep p s₀ k) := by
      intro k
      induction k with
      | zero => rfl
      | succ m ih =>
        let ⟨_, hNext⟩ := hAll (m + 1)
        rw [evalMirFuel_add, ih] at hNext
        dsimp [evalMirFuel] at hNext
        cases hEv : evalStep p 0 (iterMirStep p s₀ m) with
        | step s' =>
          rw [hEv] at hNext
          injection hNext with hEq; subst hEq
          rw [evalMirFuel_add, ih]
          dsimp [evalMirFuel, iterMirStep]
          rw [hEv]
        | done _ => rw [hEv] at hNext; cases hNext
        | fault _ => rw [hEv] at hNext; cases hNext
    intro n
    let ⟨_, hNext⟩ := hAll (n + 1)
    rw [evalMirFuel_add, hFuel n] at hNext
    dsimp [evalMirFuel] at hNext
    cases hEv : evalStep p 0 (iterMirStep p s₀ n) with
    | step _ =>
      dsimp [iterMirStep]
      rw [hEv]
      exact ⟨0, rfl, hEv⟩
    | done _ => rw [hEv] at hNext; cases hNext
    | fault _ => rw [hEv] at hNext; cases hNext

/-! ### 1-to-1 Lockstep Simulation -> Bidirectional `M_refPtr` Equivalence -/

private noncomputable def LockstepStepRel (pSrc pTgt : Program)
    (R : ExecStateRef → ExecStateRef → Prop)
    (sSrc sTgt : ExecStateRef) : Prop :=
  match evalStepRef pSrc 0 sSrc with
  | .step sSrc' =>
    ∃ sTgt', evalStepRef pTgt 0 sTgt = .step sTgt' ∧ R sSrc' sTgt'
  | .done out => evalStepRef pTgt 0 sTgt = .done out
  | .fault fk => evalStepRef pTgt 0 sTgt = .fault fk

private theorem evalRefFuel_lockstep {pSrc pTgt : Program}
    {R : ExecStateRef → ExecStateRef → Prop}
    (hLock : ∀ sSrc sTgt, R sSrc sTgt → LockstepStepRel pSrc pTgt R sSrc sTgt)
    (n : Nat) {sSrc sTgt : ExecStateRef} (hR : R sSrc sTgt) :
    match evalRefFuel pSrc n sSrc with
    | .step sSrc' =>
      ∃ sTgt', evalRefFuel pTgt n sTgt = .step sTgt' ∧ R sSrc' sTgt'
    | .done out => evalRefFuel pTgt n sTgt = .done out
    | .fault fk => evalRefFuel pTgt n sTgt = .fault fk := by
  induction n generalizing sSrc sTgt with
  | zero => exact ⟨sTgt, rfl, hR⟩
  | succ k ih =>
    dsimp [evalRefFuel]
    have h1 := hLock sSrc sTgt hR
    unfold LockstepStepRel at h1
    cases hEv : evalStepRef pSrc 0 sSrc with
    | step sSrc' =>
      rw [hEv] at h1
      let ⟨sTgt', hEvTgt, hR'⟩ := h1
      rw [hEvTgt]
      exact ih hR'
    | done out =>
      rw [hEv] at h1
      rw [h1]
    | fault fk =>
      rw [hEv] at h1
      rw [h1]

private theorem query_equiv_of_lockstep_sim {pSrc pTgt : Program} {q : Query}
    {R : ExecStateRef → ExecStateRef → Prop}
    (hInitErr : ∀ k, initStateRef pSrc q = .error k →
      initStateRef pTgt q = .error k)
    (hInitOk : ∀ s₀Src, initStateRef pSrc q = .ok s₀Src →
      ∃ s₀Tgt, initStateRef pTgt q = .ok s₀Tgt ∧ R s₀Src s₀Tgt)
    (hLock : ∀ sSrc sTgt, R sSrc sTgt →
      LockstepStepRel pSrc pTgt R sSrc sTgt) :
    (WellFormedRef pTgt q ↔ WellFormedRef pSrc q) ∧
    (∀ out : TerminalOut,
      BehaviorRef pTgt q out ↔ BehaviorRef pSrc q out) ∧
    (∀ k : FaultKind,
      ReachesResultRef pTgt q (.fault k) ↔
        ReachesResultRef pSrc q (.fault k)) ∧
    (DivergesRef pTgt q ↔ DivergesRef pSrc q) := by
  cases hInitSrc : initStateRef pSrc q with
  | error kErr =>
    have hInitTgt := hInitErr kErr hInitSrc
    have hBeh : ∀ out : TerminalOut,
        BehaviorRef pTgt q out ↔ BehaviorRef pSrc q out := by
      intro out
      unfold BehaviorRef ReachesResultRef
      rw [hInitTgt, hInitSrc]
    have hFault : ∀ k : FaultKind,
        ReachesResultRef pTgt q (.fault k) ↔
          ReachesResultRef pSrc q (.fault k) := by
      intro k
      unfold ReachesResultRef
      rw [hInitTgt, hInitSrc]
    have hWf : WellFormedRef pTgt q ↔ WellFormedRef pSrc q := by
      unfold WellFormedRef
      constructor
      · intro ⟨⟨_, hOk, _⟩, _⟩; rw [hInitTgt] at hOk; cases hOk
      · intro ⟨⟨_, hOk, _⟩, _⟩; rw [hInitSrc] at hOk; cases hOk
    have hDiv : DivergesRef pTgt q ↔ DivergesRef pSrc q := by
      unfold DivergesRef
      constructor
      · intro ⟨_, hOk, _⟩; rw [hInitTgt] at hOk; cases hOk
      · intro ⟨_, hOk, _⟩; rw [hInitSrc] at hOk; cases hOk
    exact ⟨hWf, hBeh, hFault, hDiv⟩
  | ok s₀Src =>
    let ⟨s₀Tgt, hInitTgt, hR0⟩ := hInitOk s₀Src hInitSrc
    have hBeh : ∀ out : TerminalOut,
        BehaviorRef pTgt q out ↔ BehaviorRef pSrc q out := by
      intro out
      unfold BehaviorRef ReachesResultRef
      rw [hInitTgt, hInitSrc]
      constructor
      · intro ⟨sTgt, hRTgt, hSTgt⟩
        let ⟨n, hnTgt⟩ := evalRefFuel_terminal_of_reachesRef hRTgt hSTgt
        have hSim := evalRefFuel_lockstep hLock (n + 1) hR0
        cases hSrcN : evalRefFuel pSrc (n + 1) s₀Src with
        | step _ =>
          rw [hSrcN] at hSim
          let ⟨_, hTgtStep, _⟩ := hSim
          rw [hnTgt] at hTgtStep; cases hTgtStep
        | fault _ =>
          rw [hSrcN] at hSim
          rw [hnTgt] at hSim; cases hSim
        | done oSrc =>
          rw [hSrcN] at hSim
          rw [hnTgt] at hSim
          injection hSim with hEq; subst hEq
          exact reachesRef_and_stepRef_of_evalRefFuel_done hSrcN
      · intro ⟨sSrc, hRSrc, hSSrc⟩
        let ⟨n, hnSrc⟩ := evalRefFuel_terminal_of_reachesRef hRSrc hSSrc
        have hSim := evalRefFuel_lockstep hLock (n + 1) hR0
        rw [hnSrc] at hSim
        exact reachesRef_and_stepRef_of_evalRefFuel_done hSim
    have hFault : ∀ k : FaultKind,
        ReachesResultRef pTgt q (.fault k) ↔
          ReachesResultRef pSrc q (.fault k) := by
      intro fk
      unfold ReachesResultRef
      rw [hInitTgt, hInitSrc]
      constructor
      · intro ⟨sTgt, hRTgt, hSTgt⟩
        let ⟨n, hnTgt⟩ := evalRefFuel_terminal_of_reachesRef hRTgt hSTgt
        have hSim := evalRefFuel_lockstep hLock (n + 1) hR0
        cases hSrcN : evalRefFuel pSrc (n + 1) s₀Src with
        | step _ =>
          rw [hSrcN] at hSim
          let ⟨_, hTgtStep, _⟩ := hSim
          rw [hnTgt] at hTgtStep; cases hTgtStep
        | done _ =>
          rw [hSrcN] at hSim
          rw [hnTgt] at hSim; cases hSim
        | fault kSrc =>
          rw [hSrcN] at hSim
          rw [hnTgt] at hSim
          injection hSim with hEq; subst hEq
          exact reachesRef_and_stepRef_of_evalRefFuel_fault hSrcN
      · intro ⟨sSrc, hRSrc, hSSrc⟩
        let ⟨n, hnSrc⟩ := evalRefFuel_terminal_of_reachesRef hRSrc hSSrc
        have hSim := evalRefFuel_lockstep hLock (n + 1) hR0
        rw [hnSrc] at hSim
        exact reachesRef_and_stepRef_of_evalRefFuel_fault hSim
    have hWf : WellFormedRef pTgt q ↔ WellFormedRef pSrc q := by
      unfold WellFormedRef
      constructor
      · intro ⟨_, hNoFaultTgt⟩
        refine ⟨⟨s₀Src, hInitSrc, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩
        intro k hkSrc
        exact hNoFaultTgt k ((hFault k).mpr hkSrc)
      · intro ⟨_, hNoFaultSrc⟩
        refine ⟨⟨s₀Tgt, hInitTgt, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩
        intro k hkTgt
        exact hNoFaultSrc k ((hFault k).mp hkTgt)
    have hDiv : DivergesRef pTgt q ↔ DivergesRef pSrc q := by
      unfold DivergesRef
      constructor
      · intro ⟨sTgt0, hOkTgt, hAllTgt⟩
        rw [hInitTgt] at hOkTgt
        injection hOkTgt with hEq; subst hEq
        refine ⟨s₀Src, hInitSrc, ?_⟩
        intro n
        let ⟨_, hnTgt⟩ := hAllTgt n
        have hSim := evalRefFuel_lockstep hLock n hR0
        cases hSrcN : evalRefFuel pSrc n s₀Src with
        | step s' => exact ⟨s', rfl⟩
        | done _ => rw [hSrcN] at hSim; rw [hnTgt] at hSim; cases hSim
        | fault _ => rw [hSrcN] at hSim; rw [hnTgt] at hSim; cases hSim
      · intro ⟨sSrc0, hOkSrc, hAllSrc⟩
        rw [hInitSrc] at hOkSrc
        injection hOkSrc with hEq; subst hEq
        refine ⟨s₀Tgt, hInitTgt, ?_⟩
        intro n
        let ⟨_, hnSrc⟩ := hAllSrc n
        have hSim := evalRefFuel_lockstep hLock n hR0
        rw [hnSrc] at hSim
        let ⟨sTgt', hnTgt, _⟩ := hSim
        exact ⟨sTgt', hnTgt⟩
    exact ⟨hWf, hBeh, hFault, hDiv⟩

private theorem satisfiesPostRef_iff_of_query_equiv {pSrc pTgt : Program}
    {q : Query}
    (hWf : WellFormedRef pTgt q ↔ WellFormedRef pSrc q)
    (hBeh : ∀ out : TerminalOut,
      BehaviorRef pTgt q out ↔ BehaviorRef pSrc q out)
    (post : TerminalOut → Prop) :
    SatisfiesPostRef pTgt q post ↔ SatisfiesPostRef pSrc q post := by
  unfold SatisfiesPostRef
  constructor
  · intro ⟨hw, hp⟩
    exact ⟨hWf.mp hw, fun out hb => hp out ((hBeh out).mpr hb)⟩
  · intro ⟨hw, hp⟩
    exact ⟨hWf.mpr hw, fun out hb => hp out ((hBeh out).mp hb)⟩

private theorem fullSemanticEquivRef_refl (p : Program) :
    FullSemanticEquivRef p p := by
  refine ⟨fun _ => ⟨Iff.rfl, fun _ => Iff.rfl, fun _ => Iff.rfl, Iff.rfl⟩,
          fun _ _ => Iff.rfl, ?_⟩
  intro _ bSrc bTgt _ h1 h2
  rw [h1] at h2
  injection h2 with hEq; subst hEq
  exact Iff.rfl

private theorem fullSemanticEquivRef_trans {p₁ p₂ p₃ : Program}
    (hLen : p₁.bodies.length = p₂.bodies.length)
    (h12 : FullSemanticEquivRef p₁ p₂)
    (h23 : FullSemanticEquivRef p₂ p₃) :
    FullSemanticEquivRef p₁ p₃ := by
  let ⟨hq12, hp12, hb12⟩ := h12
  let ⟨hq23, hp23, hb23⟩ := h23
  refine ⟨?_, ?_, ?_⟩
  · intro q
    let ⟨hw12, hbeh12, hf12, hd12⟩ := hq12 q
    let ⟨hw23, hbeh23, hf23, hd23⟩ := hq23 q
    exact ⟨hw23.trans hw12,
           fun out => (hbeh23 out).trans (hbeh12 out),
           fun k => (hf23 k).trans (hf12 k),
           hd23.trans hd12⟩
  · intro q post
    exact (hp23 q post).trans (hp12 q post)
  · intro defId b1 b3 safetyPre hG1 hG3
    have hLt2 : defId < p₂.bodies.length := by
      rw [← hLen]
      exact getElem?_some_lt hG1
    let ⟨b2, hG2⟩ := getElem?_some_of_lt p₂.bodies defId hLt2
    exact (hb23 defId b2 b3 safetyPre hG2 hG3).trans
      (hb12 defId b1 b2 safetyPre hG1 hG2)

/-! ### Shared Non-Addressed Local Invariant (`NoAddrTarget`) -/

private noncomputable def valNotTargeting (id : LocalId) : ValRef → Bool
  | .base _ => true
  | .localPtr ptr _ => !Nat.beq ptr.targetLocal id

private noncomputable def optValNotTargeting (id : LocalId) : Option ValRef → Bool
  | none => true
  | some v => valNotTargeting id v

private noncomputable def slotNotTargeting (id : LocalId) : LocalSlotRef → Bool
  | .dead => true
  | .live optV => optValNotTargeting id optV

private noncomputable def nodesNotTargeting (id : LocalId)
    (nodes : List BorrowNode) : Bool :=
  nodes.all (fun n => !Nat.beq n.targetLocal id)

private noncomputable def frameNotTargeting (id : LocalId)
    (f : FrameStateRef) : Bool :=
  f.locals.all (slotNotTargeting id) && nodesNotTargeting id f.borrowNodes

private theorem tbForeignAccessAt_noop_of_noTarget {id : LocalId} {ep : Nat}
    {kind : TbAccessKind} {nodes : List BorrowNode}
    (hNo : nodesNotTargeting id nodes = true) :
    tbForeignAccessAt id ep kind nodes = nodes := by
  induction nodes with
  | nil => rfl
  | cons n ns ih =>
    let ⟨hn, hns⟩ := bool_and_true hNo
    have hNe : Nat.beq n.targetLocal id = false := bool_not_true hn
    dsimp [tbForeignAccessAt]
    rw [hNe]
    dsimp
    rw [ih hns]

private theorem performTbRootAccess_noop_of_noTarget {epochs : List Nat}
    {id : LocalId} {ty : MirTy} {kind : TbAccessKind}
    {nodes : List BorrowNode}
    (hNo : nodesNotTargeting id nodes = true) :
    performTbRootAccess epochs id ty kind nodes = nodes := by
  unfold performTbRootAccess
  cases isZeroSizedTy ty with
  | true => rfl
  | false =>
    dsimp
    cases Trusted.MirSemantics.getElem? epochs id with
    | none => rfl
    | some _ => exact tbForeignAccessAt_noop_of_noTarget hNo

private theorem tbForeignAccessAt_preserves_noTarget (id loc : LocalId)
    (ep : Nat) (kind : TbAccessKind) {nodes : List BorrowNode}
    (hNo : nodesNotTargeting id nodes = true) :
    nodesNotTargeting id (tbForeignAccessAt loc ep kind nodes) = true := by
  induction nodes with
  | nil => rfl
  | cons n ns ih =>
    let ⟨hn, hns⟩ := bool_and_true hNo
    dsimp [tbForeignAccessAt, nodesNotTargeting, List.all]
    have hHead :
        (!Nat.beq
          (if Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep then
            { n with perm := tbForeignStep kind n.perm }
          else n).targetLocal id) = true := by
      cases Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep <;> exact hn
    exact bool_and_intro hHead (ih hns)

private theorem performTbRootAccess_preserves_noTarget (id loc : LocalId)
    (epochs : List Nat) (ty : MirTy) (kind : TbAccessKind)
    {nodes : List BorrowNode}
    (hNo : nodesNotTargeting id nodes = true) :
    nodesNotTargeting id
      (performTbRootAccess epochs loc ty kind nodes) = true := by
  unfold performTbRootAccess
  cases isZeroSizedTy ty with
  | true => exact hNo
  | false =>
    dsimp
    cases Trusted.MirSemantics.getElem? epochs loc with
    | none => exact hNo
    | some ep => exact tbForeignAccessAt_preserves_noTarget id loc ep kind hNo

private theorem tbDerivedAccessLoop_preserves_noTarget (id loc : LocalId)
    (origNodes : List BorrowNode) (ep : Nat) (kind : TbAccessKind)
    (accessTag : Nat) {curNodes nodes' : List BorrowNode}
    (hNo : nodesNotTargeting id curNodes = true)
    (hOk :
      tbDerivedAccessLoop origNodes loc ep kind accessTag curNodes =
        .ok nodes') :
    nodesNotTargeting id nodes' = true := by
  induction curNodes generalizing nodes' with
  | nil =>
    injection hOk with hEq; subst hEq; rfl
  | cons n ns ih =>
    let ⟨hn, hns⟩ := bool_and_true hNo
    dsimp [tbDerivedAccessLoop] at hOk
    cases hC1 : !(Nat.beq n.targetLocal loc && Nat.beq n.targetEpoch ep) with
    | true =>
      rw [if_bool_true hC1] at hOk
      cases hRec : tbDerivedAccessLoop origNodes loc ep kind accessTag ns with
      | error _ => rw [hRec] at hOk; cases hOk
      | ok ns1 =>
        rw [hRec] at hOk
        injection hOk with hEq; subst hEq
        exact bool_and_intro hn (ih hns hRec)
    | false =>
      rw [if_bool_false hC1] at hOk
      cases hAnc : isAncestorTag origNodes loc ep n.tag accessTag with
      | true =>
        rw [if_bool_true hAnc] at hOk
        cases hCh : tbChildStep kind n.perm with
        | none => rw [hCh] at hOk; cases hOk
        | some perm' =>
          rw [hCh] at hOk
          dsimp at hOk
          cases hRec :
              tbDerivedAccessLoop origNodes loc ep kind accessTag ns with
          | error _ => rw [hRec] at hOk; cases hOk
          | ok ns1 =>
            rw [hRec] at hOk
            injection hOk with hEq; subst hEq
            exact bool_and_intro hn (ih hns hRec)
      | false =>
        rw [if_bool_false hAnc] at hOk
        cases hRec :
            tbDerivedAccessLoop origNodes loc ep kind accessTag ns with
        | error _ => rw [hRec] at hOk; cases hOk
        | ok ns1 =>
          rw [hRec] at hOk
          injection hOk with hEq; subst hEq
          exact bool_and_intro hn (ih hns hRec)

private theorem performTbAccess_preserves_noTarget (id loc : LocalId)
    (ep : Nat) (ty : MirTy) (kind : TbAccessKind) (accessTag : Nat)
    {nodes nodes' : List BorrowNode}
    (hNo : nodesNotTargeting id nodes = true)
    (hOk : performTbAccess loc ep ty kind accessTag nodes = .ok nodes') :
    nodesNotTargeting id nodes' = true := by
  unfold performTbAccess at hOk
  cases hZ : isZeroSizedTy ty with
  | true =>
    rw [if_bool_true hZ] at hOk
    injection hOk with hEq; subst hEq; exact hNo
  | false =>
    rw [if_bool_false hZ] at hOk
    cases hA0 : Nat.beq accessTag 0 with
    | true =>
      rw [if_bool_true hA0] at hOk
      injection hOk with hEq; subst hEq
      exact tbForeignAccessAt_preserves_noTarget id loc ep kind hNo
    | false =>
      rw [if_bool_false hA0] at hOk
      cases hHas : !hasBorrowTagAt loc ep accessTag nodes with
      | true => rw [if_bool_true hHas] at hOk; cases hOk
      | false =>
        rw [if_bool_false hHas] at hOk
        exact tbDerivedAccessLoop_preserves_noTarget id loc nodes ep kind
          accessTag hNo hOk

private theorem liveUninitSlotRef_notTargeting (id : LocalId) (ty : MirTy) :
    slotNotTargeting id (liveUninitSlotRef ty) = true := by
  cases ty with
  | unit => rfl
  | enum ety =>
    dsimp [liveUninitSlotRef]
    cases isZstEnumTy ety <;> rfl
  | _ => rfl

private theorem initLocalsRefLoop_notTargeting (id : LocalId) (body : Body)
    (args : List Val) (idx : Nat) (tys : List MirTy) :
    (initLocalsRefLoop body args idx tys).all (slotNotTargeting id) =
      true := by
  induction tys generalizing idx with
  | nil => rfl
  | cons ty rest ih =>
    dsimp [initLocalsRefLoop, List.all]
    have hHead :
        slotNotTargeting id
          (if Nat.beq idx 0 then liveUninitSlotRef ty
           else if Nat.ble idx body.argumentCount then
             match Trusted.MirSemantics.getElem? args (idx - 1) with
             | some v => .live (some (.base v))
             | none => .dead
           else if hasStorageAnnotation body idx then .dead
           else liveUninitSlotRef ty) = true := by
      cases Nat.beq idx 0 with
      | true => exact liveUninitSlotRef_notTargeting id ty
      | false =>
        dsimp
        cases Nat.ble idx body.argumentCount with
        | true =>
          dsimp
          cases Trusted.MirSemantics.getElem? args (idx - 1) <;> rfl
        | false =>
          dsimp
          cases hasStorageAnnotation body idx with
          | true => rfl
          | false => exact liveUninitSlotRef_notTargeting id ty
    exact bool_and_intro hHead (ih (idx + 1))

private theorem derefPointeeSlot_notTargeting {id : LocalId}
    {bodyLocals : List MirTy} {locals : List LocalSlotRef}
    {epochs : List Nat} {expectedTy : MirTy} {ptr : LocalPtr}
    {optVal : Option ValRef}
    (hLocs : locals.all (slotNotTargeting id) = true)
    (hOk : derefPointeeSlot bodyLocals locals epochs expectedTy ptr =
      .ok optVal) :
    optValNotTargeting id optVal = true := by
  unfold derefPointeeSlot at hOk
  cases hG1 : Trusted.MirSemantics.getElem? bodyLocals ptr.targetLocal with
  | none => rw [hG1] at hOk; cases hOk
  | some tgtDeclTy =>
    rw [hG1] at hOk
    cases hGetL : Trusted.MirSemantics.getElem? locals ptr.targetLocal with
    | none => rw [hGetL] at hOk; cases hOk
    | some tgtSlot =>
      rw [hGetL] at hOk
      cases hGE : Trusted.MirSemantics.getElem? epochs ptr.targetLocal with
      | none => rw [hGE] at hOk; cases hOk
      | some tgtEp =>
        rw [hGE] at hOk
        dsimp at hOk
        cases hT : !MirTy.beq tgtDeclTy expectedTy with
        | true => rw [if_bool_true hT] at hOk; cases hOk
        | false =>
          rw [if_bool_false hT] at hOk
          have hSlot := list_all_getElem? hLocs hGetL
          cases tgtSlot with
          | dead => cases hOk
          | live vOpt =>
            dsimp at hOk
            cases hEp : !Nat.beq tgtEp ptr.targetEpoch with
            | true => rw [if_bool_true hEp] at hOk; cases hOk
            | false =>
              rw [if_bool_false hEp] at hOk
              injection hOk with hEq; subst hEq
              exact hSlot

private theorem resolveDerefPlaceRef_notTargeting {id : LocalId}
    {bodyLocals : List MirTy} {locals : List LocalSlotRef}
    {epochs : List Nat} {nodes nodes' : List BorrowNode}
    {ptrId : LocalId} {sRef : Bool} {pm : Mutability} {pTy : MirTy}
    {ptr : LocalPtr} {optVal : Option ValRef}
    (hLocs : locals.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hOk : resolveDerefPlaceRef bodyLocals locals epochs nodes ptrId =
      .ok (sRef, pm, pTy, ptr, optVal, nodes')) :
    (!Nat.beq ptr.targetLocal id) = true ∧
    optValNotTargeting id optVal = true ∧
    nodesNotTargeting id nodes' = true := by
  unfold resolveDerefPlaceRef at hOk
  cases hB : Trusted.MirSemantics.getElem? bodyLocals ptrId with
  | none => rw [hB] at hOk; cases hOk
  | some ptrDeclTy =>
    rw [hB] at hOk
    dsimp at hOk
    cases hPI : ptrPointeeInfo? ptrDeclTy with
    | none => rw [hPI] at hOk; cases hOk
    | some info =>
      rw [hPI] at hOk
      cases info with
      | mk isSR rest =>
        cases rest with
        | mk pMut ptTy =>
          dsimp at hOk
          cases hLen : !Nat.beq epochs.length locals.length with
          | true => rw [if_bool_true hLen] at hOk; cases hOk
          | false =>
            rw [if_bool_false hLen] at hOk
            cases hGetP : Trusted.MirSemantics.getElem? locals ptrId with
            | none => rw [hGetP] at hOk; cases hOk
            | some slotP =>
              rw [hGetP] at hOk
              have hSlotP := list_all_getElem? hLocs hGetP
              cases slotP with
              | dead => cases hOk
              | live optP =>
                cases optP with
                | none => cases hOk
                | some valP =>
                  cases valP with
                  | base _ => cases hOk
                  | localPtr p0 vTy =>
                    dsimp [slotNotTargeting, optValNotTargeting,
                      valNotTargeting] at hSlotP
                    dsimp at hOk
                    cases hVT : !MirTy.beq vTy ptrDeclTy with
                    | true => rw [if_bool_true hVT] at hOk; cases hOk
                    | false =>
                      rw [if_bool_false hVT] at hOk
                      cases hInh : isSR && !isOpsemInhabitedTy ptTy with
                      | true => rw [if_bool_true hInh] at hOk; cases hOk
                      | false =>
                        rw [if_bool_false hInh] at hOk
                        cases hDeref :
                            derefPointeeSlot bodyLocals locals epochs ptTy
                              p0 with
                        | error _ => rw [hDeref] at hOk; cases hOk
                        | ok tgtOpt =>
                          rw [hDeref] at hOk
                          dsimp at hOk
                          have hN0 :=
                            performTbRootAccess_preserves_noTarget id ptrId
                              epochs ptrDeclTy .read hNodes
                          cases hTb :
                              performTbAccess p0.targetLocal p0.targetEpoch
                                ptTy .read p0.borrowTag
                                (performTbRootAccess epochs ptrId ptrDeclTy
                                  .read nodes) with
                          | error _ => rw [hTb] at hOk; cases hOk
                          | ok n1 =>
                            rw [hTb] at hOk
                            have hN1 :=
                              performTbAccess_preserves_noTarget id
                                p0.targetLocal p0.targetEpoch ptTy .read
                                p0.borrowTag hN0 hTb
                            have hV := derefPointeeSlot_notTargeting hLocs hDeref
                            injection hOk with hTup
                            cases hTup
                            exact ⟨hSlotP, hV, hN1⟩

private theorem resolveDerefDstRef_notTargeting {id : LocalId}
    {bodyLocals : List MirTy} {locals : List LocalSlotRef}
    {epochs : List Nat} {nodes nodes' : List BorrowNode}
    {ptrId : LocalId} {sRef : Bool} {pm : Mutability} {pTy : MirTy}
    {ptr : LocalPtr}
    (hLocs : locals.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hOk : resolveDerefDstRef bodyLocals locals epochs nodes ptrId =
      .ok (sRef, pm, pTy, ptr, nodes')) :
    (!Nat.beq ptr.targetLocal id) = true ∧
    nodesNotTargeting id nodes' = true := by
  unfold resolveDerefDstRef at hOk
  cases hB : Trusted.MirSemantics.getElem? bodyLocals ptrId with
  | none => rw [hB] at hOk; cases hOk
  | some ptrDeclTy =>
    rw [hB] at hOk
    dsimp at hOk
    cases hPI : ptrPointeeInfo? ptrDeclTy with
    | none => rw [hPI] at hOk; cases hOk
    | some info =>
      rw [hPI] at hOk
      cases info with
      | mk isSR rest =>
        cases rest with
        | mk pMut ptTy =>
          dsimp at hOk
          cases hSh : !isSR && Mutability.beq pMut .shared with
          | true => rw [if_bool_true hSh] at hOk; cases hOk
          | false =>
            rw [if_bool_false hSh] at hOk
            cases hLen : !Nat.beq epochs.length locals.length with
            | true => rw [if_bool_true hLen] at hOk; cases hOk
            | false =>
              rw [if_bool_false hLen] at hOk
              cases hGetP : Trusted.MirSemantics.getElem? locals ptrId with
              | none => rw [hGetP] at hOk; cases hOk
              | some slotP =>
                rw [hGetP] at hOk
                have hSlotP := list_all_getElem? hLocs hGetP
                cases slotP with
                | dead => cases hOk
                | live optP =>
                  cases optP with
                  | none => cases hOk
                  | some valP =>
                    cases valP with
                    | base _ => cases hOk
                    | localPtr p0 vTy =>
                      dsimp [slotNotTargeting, valNotTargeting] at hSlotP
                      dsimp at hOk
                      cases hVT : !MirTy.beq vTy ptrDeclTy with
                      | true => rw [if_bool_true hVT] at hOk; cases hOk
                      | false =>
                        rw [if_bool_false hVT] at hOk
                        injection hOk with hTup
                        cases hTup
                        exact ⟨hSlotP,
                          performTbRootAccess_preserves_noTarget id ptrId
                            epochs ptrDeclTy .read hNodes⟩

private theorem evalOperandToSlotRef_notTargeting {id : LocalId}
    {bodyLocals : List MirTy} {locals locals' : List LocalSlotRef}
    {epochs : List Nat} {nodes nodes' : List BorrowNode}
    {opnd : Operand} {ty : MirTy} {optVal : Option ValRef}
    {srcLoc? : Option LocalId}
    (hLocs : locals.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hOk : evalOperandToSlotRef bodyLocals locals epochs nodes opnd =
      .ok (ty, optVal, srcLoc?, locals', nodes')) :
    optValNotTargeting id optVal = true ∧
    locals'.all (slotNotTargeting id) = true ∧
    nodesNotTargeting id nodes' = true := by
  cases opnd with
  | copy place =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hPr : place.projection with
    | nil =>
      rw [hPr] at hOk
      dsimp at hOk
      cases hBL : Trusted.MirSemantics.getElem? bodyLocals place.localId with
      | none => rw [hBL] at hOk; cases hOk
      | some declTy =>
        rw [hBL] at hOk
        cases hGetL :
            Trusted.MirSemantics.getElem? locals place.localId with
        | none => rw [hGetL] at hOk; cases hOk
        | some slot =>
          rw [hGetL] at hOk
          have hSlot := list_all_getElem? hLocs hGetL
          cases slot with
          | dead => cases hOk
          | live vOpt =>
            dsimp at hOk
            have hN1 :=
              performTbRootAccess_preserves_noTarget id place.localId
                epochs declTy .read hNodes
            injection hOk with hTup
            cases hTup
            exact ⟨hSlot, hLocs, hN1⟩
    | cons pe rest =>
      rw [hPr] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases hRes :
              resolveDerefPlaceRef bodyLocals locals epochs nodes
                place.localId with
          | error _ => rw [hRes] at hOk; cases hOk
          | ok res =>
            rw [hRes] at hOk
            cases res with
            | mk sR r1 =>
              cases r1 with
              | mk pM r2 =>
                cases r2 with
                | mk ptTy r3 =>
                  cases r3 with
                  | mk ptr r4 =>
                    cases r4 with
                    | mk tgtOpt n1 =>
                      dsimp at hOk
                      injection hOk with hTup
                      cases hTup
                      let ⟨_, hV, hN⟩ :=
                        resolveDerefPlaceRef_notTargeting hLocs hNodes hRes
                      exact ⟨hV, hLocs, hN⟩
  | move place =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hPr : place.projection with
    | nil =>
      rw [hPr] at hOk
      dsimp at hOk
      cases hBL : Trusted.MirSemantics.getElem? bodyLocals place.localId with
      | none => rw [hBL] at hOk; cases hOk
      | some declTy =>
        rw [hBL] at hOk
        cases hGetL :
            Trusted.MirSemantics.getElem? locals place.localId with
        | none => rw [hGetL] at hOk; cases hOk
        | some slot =>
          rw [hGetL] at hOk
          have hSlot := list_all_getElem? hLocs hGetL
          cases slot with
          | dead => cases hOk
          | live vOpt =>
            dsimp at hOk
            cases hSet :
                setElem? locals place.localId (liveUninitSlotRef declTy) with
            | none => rw [hSet] at hOk; cases hOk
            | some l' =>
              rw [hSet] at hOk
              have hN1 :=
                performTbRootAccess_preserves_noTarget id place.localId
                  epochs declTy .read hNodes
              have hN2 :=
                performTbRootAccess_preserves_noTarget id place.localId
                  epochs declTy .write hN1
              have hL' :=
                list_all_setElem? hLocs
                  (liveUninitSlotRef_notTargeting id declTy) hSet
              injection hOk with hTup
              cases hTup
              exact ⟨hSlot, hL', hN2⟩
    | cons pe rest =>
      rw [hPr] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases hBL :
              Trusted.MirSemantics.getElem? bodyLocals place.localId with
          | none => rw [hBL] at hOk; cases hOk
          | some ptrDeclTy =>
            rw [hBL] at hOk
            dsimp at hOk
            cases hPI : ptrPointeeInfo? ptrDeclTy with
            | none => rw [hPI] at hOk; cases hOk
            | some dInfo =>
              rw [hPI] at hOk
              cases dInfo with
              | mk dSafe dRest =>
                cases dRest with
                | mk dMut _ =>
                  dsimp at hOk
                  cases hSh1 : !dSafe && Mutability.beq dMut .shared with
                  | true => rw [if_bool_true hSh1] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hSh1] at hOk
                    cases hRes :
                        resolveDerefPlaceRef bodyLocals locals epochs nodes
                          place.localId with
                    | error _ => rw [hRes] at hOk; cases hOk
                    | ok res =>
                      rw [hRes] at hOk
                      cases res with
                      | mk sR r1 =>
                        cases r1 with
                        | mk pM r2 =>
                          cases r2 with
                          | mk ptTy r3 =>
                            cases r3 with
                            | mk ptr r4 =>
                              cases r4 with
                              | mk tgtOpt n1 =>
                                dsimp at hOk
                                let ⟨_, hV, hN1⟩ :=
                                  resolveDerefPlaceRef_notTargeting hLocs
                                    hNodes hRes
                                cases hSh2 :
                                    sR && Mutability.beq pM .shared with
                                | true =>
                                  rw [if_bool_true hSh2] at hOk; cases hOk
                                | false =>
                                  rw [if_bool_false hSh2] at hOk
                                  cases hTb :
                                      performTbAccess ptr.targetLocal
                                        ptr.targetEpoch ptTy .write
                                        ptr.borrowTag n1 with
                                  | error _ => rw [hTb] at hOk; cases hOk
                                  | ok n2 =>
                                    rw [hTb] at hOk
                                    dsimp at hOk
                                    cases hSet :
                                        setElem? locals ptr.targetLocal
                                          (liveUninitSlotRef ptTy) with
                                    | none => rw [hSet] at hOk; cases hOk
                                    | some l' =>
                                      rw [hSet] at hOk
                                      have hL' :=
                                        list_all_setElem? hLocs
                                          (liveUninitSlotRef_notTargeting id
                                            ptTy) hSet
                                      have hN2 :=
                                        performTbAccess_preserves_noTarget id
                                          ptr.targetLocal ptr.targetEpoch ptTy
                                          .write ptr.borrowTag hN1 hTb
                                      injection hOk with hTup
                                      cases hTup
                                      exact ⟨hV, hL', hN2⟩
  | constant c =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hC : evalConstLit c.ty c.lit with
    | error _ => rw [hC] at hOk; cases hOk
    | ok _ =>
      rw [hC] at hOk
      injection hOk with hTup
      cases hTup
      exact ⟨rfl, hLocs, hNodes⟩

private theorem evalPrimitiveOperandRef_notTargeting {id : LocalId}
    {bodyLocals : List MirTy} {locals locals' : List LocalSlotRef}
    {epochs : List Nat} {nodes nodes' : List BorrowNode}
    {opnd : Operand} {v : Val}
    (hLocs : locals.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hOk : evalPrimitiveOperandRef bodyLocals locals epochs nodes opnd =
      .ok (v, locals', nodes')) :
    locals'.all (slotNotTargeting id) = true ∧
    nodesNotTargeting id nodes' = true := by
  unfold evalPrimitiveOperandRef at hOk
  cases hOp : evalOperandToSlotRef bodyLocals locals epochs nodes opnd with
  | error _ => rw [hOp] at hOk; cases hOk
  | ok res =>
    rw [hOp] at hOk
    cases res with
    | mk ty r1 =>
      cases r1 with
      | mk optV r2 =>
        cases r2 with
        | mk src? r3 =>
          cases r3 with
          | mk l1 n1 =>
            dsimp at hOk
            let ⟨_, hL1, hN1⟩ :=
              evalOperandToSlotRef_notTargeting hLocs hNodes hOp
            cases hPr : !isPrimitiveReadableTy ty with
            | true => rw [if_bool_true hPr] at hOk; cases hOk
            | false =>
              rw [if_bool_false hPr] at hOk
              cases optV with
              | none => cases hOk
              | some vr =>
                cases vr with
                | localPtr _ _ => cases hOk
                | base _ =>
                  injection hOk with hTup
                  cases hTup
                  exact ⟨hL1, hN1⟩

private noncomputable def expectedRefOrAddrInner? (isSafeRef : Bool) (m : Mutability)
    (dstTy : MirTy) : Option MirTy :=
  match isSafeRef, dstTy with
  | true, .ref dstM inner =>
    if Mutability.beq m dstM && isSupportedRefPtrTy inner then
      some inner else none
  | false, .rawPtr dstM inner =>
    if Mutability.beq m dstM && isSupportedRefPtrTy inner then
      some inner else none
  | _, _ => none

private noncomputable def reborrowMutOk (m baseMut : Mutability) : Bool :=
  match m with
  | .shared => true
  | .mut =>
    match baseMut with
    | .mut => true
    | .shared => false

private theorem evalRefOrAddrOf_notTargeting {id : LocalId}
    {bodyLocals : List MirTy} {locals : List LocalSlotRef}
    {epochs : List Nat} {nodes nodes' : List BorrowNode}
    {nextTag nextTag' : Nat} {isSafeRef : Bool} {m : Mutability}
    {srcPlace : Place} {dstTy : MirTy} {ptrVal : ValRef}
    (hNoDirect :
      (!(srcPlace.projection.isEmpty && Nat.beq srcPlace.localId id)) = true)
    (hLocs : locals.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hOk : evalRefOrAddrOf bodyLocals locals epochs nodes nextTag isSafeRef
      m srcPlace dstTy = .ok (ptrVal, nodes', nextTag')) :
    valNotTargeting id ptrVal = true ∧
    nodesNotTargeting id nodes' = true := by
  unfold evalRefOrAddrOf at hOk
  change (match expectedRefOrAddrInner? isSafeRef m dstTy with
          | none => Except.error FaultKind.unsupported
          | some dstInnerTy => _) = _ at hOk
  cases hExp : expectedRefOrAddrInner? isSafeRef m dstTy with
  | none => rw [hExp] at hOk; cases hOk
  | some dstInnerTy =>
    rw [hExp] at hOk
    dsimp at hOk
    cases hProj : srcPlace.projection with
    | nil =>
      rw [hProj] at hOk hNoDirect
      dsimp at hOk hNoDirect
      cases hBL :
          Trusted.MirSemantics.getElem? bodyLocals srcPlace.localId with
      | none => rw [hBL] at hOk; cases hOk
      | some srcTy =>
        rw [hBL] at hOk
        dsimp at hOk
        cases hT : !MirTy.beq srcTy dstInnerTy with
        | true => rw [if_bool_true hT] at hOk; cases hOk
        | false =>
          rw [if_bool_false hT] at hOk
          cases hSL :
              Trusted.MirSemantics.getElem? locals srcPlace.localId with
          | none => rw [hSL] at hOk; cases hOk
          | some srcSlot =>
            rw [hSL] at hOk
            cases srcSlot with
            | dead => cases hOk
            | live _ =>
              cases hSE :
                  Trusted.MirSemantics.getElem? epochs srcPlace.localId with
              | none => rw [hSE] at hOk; cases hOk
              | some ep =>
                rw [hSE] at hOk
                dsimp at hOk
                cases hSR : !isSafeRef with
                | true =>
                  rw [if_bool_true hSR] at hOk
                  injection hOk with hTup
                  cases hTup
                  exact ⟨hNoDirect, hNodes⟩
                | false =>
                  rw [if_bool_false hSR] at hOk
                  cases hInh : !isOpsemInhabitedTy dstInnerTy with
                  | true => rw [if_bool_true hInh] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hInh] at hOk
                    have hN1 :=
                      performTbRootAccess_preserves_noTarget id
                        srcPlace.localId epochs dstInnerTy .read hNodes
                    injection hOk with hTup
                    cases hTup
                    unfold nodesNotTargeting
                    rw [list_all_append]
                    exact ⟨hNoDirect,
                      bool_and_intro hN1 (bool_and_intro hNoDirect rfl)⟩
    | cons pe rest =>
      rw [hProj] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases hBL :
              Trusted.MirSemantics.getElem? bodyLocals srcPlace.localId with
          | none => rw [hBL] at hOk; cases hOk
          | some ptrDeclTy =>
            rw [hBL] at hOk
            dsimp at hOk
            cases hPI : ptrPointeeInfo? ptrDeclTy with
            | none => rw [hPI] at hOk; cases hOk
            | some bInfo =>
              rw [hPI] at hOk
              cases bInfo with
              | mk baseSafe bRest =>
                cases bRest with
                | mk baseMut innerTy =>
                  dsimp at hOk
                  change (if (!MirTy.beq innerTy dstInnerTy ||
                              !reborrowMutOk m baseMut) = true then
                            Except.error FaultKind.unsupported
                          else _) = _ at hOk
                  cases hMOk :
                      (!MirTy.beq innerTy dstInnerTy ||
                       !reborrowMutOk m baseMut) with
                  | true => rw [if_bool_true hMOk] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hMOk] at hOk
                    cases hGetP :
                        Trusted.MirSemantics.getElem? locals
                          srcPlace.localId with
                    | none => rw [hGetP] at hOk; cases hOk
                    | some slotP =>
                      rw [hGetP] at hOk
                      have hSlotP := list_all_getElem? hLocs hGetP
                      cases slotP with
                      | dead => cases hOk
                      | live optP =>
                        cases optP with
                        | none => cases hOk
                        | some valP =>
                          cases valP with
                          | base _ => cases hOk
                          | localPtr ptr vPtrTy =>
                            dsimp [slotNotTargeting, optValNotTargeting,
                              valNotTargeting] at hSlotP
                            dsimp at hOk
                            cases hVT : !MirTy.beq vPtrTy ptrDeclTy with
                            | true => rw [if_bool_true hVT] at hOk; cases hOk
                            | false =>
                              rw [if_bool_false hVT] at hOk
                              have hN0 :=
                                performTbRootAccess_preserves_noTarget id
                                  srcPlace.localId epochs ptrDeclTy .read
                                  hNodes
                              cases hTBL :
                                  Trusted.MirSemantics.getElem? bodyLocals
                                    ptr.targetLocal with
                              | none => rw [hTBL] at hOk; cases hOk
                              | some tgtDeclTy =>
                                rw [hTBL] at hOk
                                cases hTL :
                                    Trusted.MirSemantics.getElem? locals
                                      ptr.targetLocal with
                                | none => rw [hTL] at hOk; cases hOk
                                | some tgtSlot =>
                                  rw [hTL] at hOk
                                  cases hTE :
                                      Trusted.MirSemantics.getElem? epochs
                                        ptr.targetLocal with
                                  | none => rw [hTE] at hOk; cases hOk
                                  | some tgtEp =>
                                    rw [hTE] at hOk
                                    dsimp at hOk
                                    cases hTD :
                                        !MirTy.beq tgtDeclTy dstInnerTy with
                                    | true =>
                                      rw [if_bool_true hTD] at hOk; cases hOk
                                    | false =>
                                      rw [if_bool_false hTD] at hOk
                                      cases hSR2 : isSafeRef with
                                      | true =>
                                        rw [if_bool_true hSR2] at hOk
                                        cases hInh2 :
                                            !isOpsemInhabitedTy
                                              dstInnerTy with
                                        | true =>
                                          rw [if_bool_true hInh2] at hOk
                                          cases hOk
                                        | false =>
                                          rw [if_bool_false hInh2] at hOk
                                          cases tgtSlot with
                                          | dead => cases hOk
                                          | live _ =>
                                            dsimp at hOk
                                            cases hEp2 :
                                                !Nat.beq tgtEp
                                                  ptr.targetEpoch with
                                            | true =>
                                              rw [if_bool_true hEp2] at hOk
                                              cases hOk
                                            | false =>
                                              rw [if_bool_false hEp2] at hOk
                                              cases hTb :
                                                  performTbAccess
                                                    ptr.targetLocal
                                                    ptr.targetEpoch dstInnerTy
                                                    .read ptr.borrowTag
                                                    (performTbRootAccess epochs
                                                      srcPlace.localId
                                                      ptrDeclTy .read
                                                      nodes) with
                                              | error _ =>
                                                rw [hTb] at hOk; cases hOk
                                              | ok n1 =>
                                                rw [hTb] at hOk
                                                dsimp at hOk
                                                injection hOk with hTup
                                                cases hTup
                                                have hN1 :=
                                                  performTbAccess_preserves_noTarget
                                                    id ptr.targetLocal
                                                    ptr.targetEpoch dstInnerTy
                                                    .read ptr.borrowTag hN0
                                                    hTb
                                                unfold nodesNotTargeting
                                                rw [list_all_append]
                                                exact ⟨hSlotP,
                                                  bool_and_intro hN1
                                                    (bool_and_intro hSlotP
                                                      rfl)⟩
                                      | false =>
                                        rw [if_bool_false hSR2] at hOk
                                        cases hBS : baseSafe with
                                        | false =>
                                          rw [if_bool_false hBS] at hOk
                                          injection hOk with hTup
                                          cases hTup
                                          exact ⟨hSlotP, hN0⟩
                                        | true =>
                                          rw [if_bool_true hBS] at hOk
                                          cases hInh2 :
                                              !isOpsemInhabitedTy
                                                dstInnerTy with
                                          | true =>
                                            rw [if_bool_true hInh2] at hOk
                                            cases hOk
                                          | false =>
                                            rw [if_bool_false hInh2] at hOk
                                            cases tgtSlot with
                                            | dead => cases hOk
                                            | live _ =>
                                              dsimp at hOk
                                              cases hEp2 :
                                                  !Nat.beq tgtEp
                                                    ptr.targetEpoch with
                                              | true =>
                                                rw [if_bool_true hEp2] at hOk
                                                cases hOk
                                              | false =>
                                                rw [if_bool_false hEp2] at hOk
                                                injection hOk with hTup
                                                cases hTup
                                                exact ⟨hSlotP, hN0⟩

private theorem evalRvalueRef_notTargeting {id : LocalId}
    {bodyLocals : List MirTy} {locals locals' : List LocalSlotRef}
    {epochs : List Nat} {nodes nodes' : List BorrowNode}
    {nextTag nextTag' : Nat} {dstLoc : LocalId} {dstIsDeref : Bool}
    {dstTy : MirTy} {dst : Place} {rv : Rvalue} {val : ValRef}
    (hNoStmtAddr : stmtTakesDirectAddrOf id (.assign dst rv) = false)
    (hLocs : locals.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hOk : evalRvalueRef bodyLocals locals epochs nodes nextTag dstLoc
      dstIsDeref dstTy rv = .ok (val, locals', nodes', nextTag')) :
    valNotTargeting id val = true ∧
    locals'.all (slotNotTargeting id) = true ∧
    nodesNotTargeting id nodes' = true := by
  cases rv with
  | use opnd =>
    dsimp [evalRvalueRef] at hOk
    cases hOp : evalOperandToSlotRef bodyLocals locals epochs nodes opnd with
    | error _ => rw [hOp] at hOk; cases hOk
    | ok res =>
      rw [hOp] at hOk
      cases res with
      | mk sTy r1 =>
        cases r1 with
        | mk optV r2 =>
          cases r2 with
          | mk sLoc? r3 =>
            cases r3 with
            | mk l1 n1 =>
              dsimp at hOk
              let ⟨hV, hL1, hN1⟩ :=
                evalOperandToSlotRef_notTargeting hLocs hNodes hOp
              cases hT : !MirTy.beq sTy dstTy with
              | true => rw [if_bool_true hT] at hOk; cases hOk
              | false =>
                rw [if_bool_false hT] at hOk
                cases sLoc? with
                | none =>
                  dsimp at hOk
                  cases hZ :
                      (dstIsDeref || operandHasDerefProj opnd) &&
                      !isZeroSizedTy dstTy && false with
                  | true => rw [if_bool_true hZ] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hZ] at hOk
                    cases optV with
                    | none => cases hOk
                    | some v =>
                      injection hOk with hTup
                      cases hTup
                      exact ⟨hV, hL1, hN1⟩
                | some sL =>
                  dsimp at hOk
                  cases hOv :
                      (dstIsDeref || operandHasDerefProj opnd) &&
                      !isZeroSizedTy dstTy && Nat.beq sL dstLoc with
                  | true => rw [if_bool_true hOv] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hOv] at hOk
                    cases optV with
                    | none => cases hOk
                    | some v =>
                      injection hOk with hTup
                      cases hTup
                      exact ⟨hV, hL1, hN1⟩
  | binaryOp op lhs rhs =>
    dsimp [evalRvalueRef] at hOk
    cases hL : evalPrimitiveOperandRef bodyLocals locals epochs nodes lhs with
    | error _ => rw [hL] at hOk; cases hOk
    | ok rL =>
      rw [hL] at hOk
      cases rL with
      | mk lv restL =>
        cases restL with
        | mk l1 n1 =>
          dsimp at hOk
          let ⟨hL1, hN1⟩ :=
            evalPrimitiveOperandRef_notTargeting hLocs hNodes hL
          cases hR : evalPrimitiveOperandRef bodyLocals l1 epochs n1 rhs with
          | error _ => rw [hR] at hOk; cases hOk
          | ok rR =>
            rw [hR] at hOk
            cases rR with
            | mk rv' restR =>
              cases restR with
              | mk l2 n2 =>
                dsimp at hOk
                let ⟨hL2, hN2⟩ :=
                  evalPrimitiveOperandRef_notTargeting hL1 hN1 hR
                cases hB : evalBinOp op lv rv' with
                | error _ => rw [hB] at hOk; cases hOk
                | ok _ =>
                  rw [hB] at hOk
                  injection hOk with hTup
                  cases hTup
                  exact ⟨rfl, hL2, hN2⟩
  | unaryOp op opnd =>
    dsimp [evalRvalueRef] at hOk
    cases hO : evalPrimitiveOperandRef bodyLocals locals epochs nodes opnd with
    | error _ => rw [hO] at hOk; cases hOk
    | ok rO =>
      rw [hO] at hOk
      cases rO with
      | mk v' restO =>
        cases restO with
        | mk l1 n1 =>
          dsimp at hOk
          let ⟨hL1, hN1⟩ :=
            evalPrimitiveOperandRef_notTargeting hLocs hNodes hO
          cases hU : evalUnOp op v' with
          | error _ => rw [hU] at hOk; cases hOk
          | ok _ =>
            rw [hU] at hOk
            injection hOk with hTup
            cases hTup
            exact ⟨rfl, hL1, hN1⟩
  | discriminant place =>
    dsimp [evalRvalueRef] at hOk
    have hDecodeBase : ∀ ety optV dv,
        decodeEnumDiscriminantSlot ety optV = .ok dv →
        valNotTargeting id dv = true := by
      intro ety optV dv hDec
      unfold decodeEnumDiscriminantSlot at hDec
      cases hTR : ety.tagRepr with
      | zeroSized =>
        rw [hTR] at hDec
        cases optV with
        | none =>
          dsimp at hDec
          cases hD0 : Trusted.MirSemantics.getElem? ety.discriminants 0 with
          | none => rw [hD0] at hDec; cases hDec
          | some _ => rw [hD0] at hDec; injection hDec with hE; subst hE; rfl
        | some vr =>
          cases vr with
          | localPtr _ _ => cases hDec
          | base bv =>
            cases bv with
            | enumVal ety' v =>
              dsimp at hDec
              cases hC : EnumTy.beq ety ety' && Nat.beq v 0 with
              | false => rw [if_bool_false hC] at hDec; cases hDec
              | true =>
                rw [if_bool_true hC] at hDec
                cases hD0 :
                    Trusted.MirSemantics.getElem? ety.discriminants 0 with
                | none => rw [hD0] at hDec; cases hDec
                | some _ =>
                  rw [hD0] at hDec; injection hDec with hE; subst hE; rfl
            | _ => cases hDec
      | scalar _ _ =>
        rw [hTR] at hDec
        cases optV with
        | none => cases hDec
        | some vr =>
          cases vr with
          | localPtr _ _ => cases hDec
          | base bv =>
            cases bv with
            | enumVal ety' v =>
              dsimp at hDec
              cases hC :
                  EnumTy.beq ety ety' &&
                  Nat.blt v ety.discriminants.length with
              | false => rw [if_bool_false hC] at hDec; cases hDec
              | true =>
                rw [if_bool_true hC] at hDec
                cases hDv :
                    Trusted.MirSemantics.getElem? ety.discriminants v with
                | none => rw [hDv] at hDec; cases hDec
                | some _ =>
                  rw [hDv] at hDec; injection hDec with hE; subst hE; rfl
            | _ => cases hDec
    cases hPr : place.projection with
    | nil =>
      rw [hPr] at hOk
      dsimp at hOk
      cases hBL :
          Trusted.MirSemantics.getElem? bodyLocals place.localId with
      | none => rw [hBL] at hOk; cases hOk
      | some pTy =>
        rw [hBL] at hOk
        cases pTy with
        | enum ety =>
          cases hSL : Trusted.MirSemantics.getElem? locals place.localId with
          | none => rw [hSL] at hOk; cases hOk
          | some slot =>
            rw [hSL] at hOk
            dsimp at hOk
            cases hEA : !enumAdmitted ety with
            | true => rw [if_bool_true hEA] at hOk; cases hOk
            | false =>
              rw [if_bool_false hEA] at hOk
              cases slot with
              | dead => cases hOk
              | live optV =>
                dsimp at hOk
                cases hDec : decodeEnumDiscriminantSlot ety optV with
                | error _ => rw [hDec] at hOk; cases hOk
                | ok dv =>
                  rw [hDec] at hOk
                  have hVD := hDecodeBase ety optV dv hDec
                  injection hOk with hTup
                  cases hTup
                  exact ⟨hVD, hLocs,
                    performTbRootAccess_preserves_noTarget id place.localId
                      epochs (.enum ety) .read hNodes⟩
        | _ => cases hOk
    | cons pe rest =>
      rw [hPr] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases hRes :
              resolveDerefPlaceRef bodyLocals locals epochs nodes
                place.localId with
          | error _ => rw [hRes] at hOk; cases hOk
          | ok res =>
            rw [hRes] at hOk
            cases res with
            | mk sR r1 =>
              cases r1 with
              | mk pM r2 =>
                cases r2 with
                | mk ptTy r3 =>
                  cases r3 with
                  | mk ptr r4 =>
                    cases r4 with
                    | mk tgtOpt n1 =>
                      let ⟨_, _, hN1⟩ :=
                        resolveDerefPlaceRef_notTargeting hLocs hNodes hRes
                      cases ptTy with
                      | enum ety =>
                        dsimp at hOk
                        cases hEA : !enumAdmitted ety with
                        | true => rw [if_bool_true hEA] at hOk; cases hOk
                        | false =>
                          rw [if_bool_false hEA] at hOk
                          cases hDec :
                              decodeEnumDiscriminantSlot ety tgtOpt with
                          | error _ => rw [hDec] at hOk; cases hOk
                          | ok dv =>
                            rw [hDec] at hOk
                            have hVD := hDecodeBase ety tgtOpt dv hDec
                            injection hOk with hTup
                            cases hTup
                            exact ⟨hVD, hLocs, hN1⟩
                      | _ => cases hOk
  | ref m srcPlace =>
    dsimp [evalRvalueRef] at hOk
    dsimp [stmtTakesDirectAddrOf] at hNoStmtAddr
    have hND :
        (!(srcPlace.projection.isEmpty && Nat.beq srcPlace.localId id)) =
          true := by
      rw [hNoStmtAddr]; rfl
    cases hRO : evalRefOrAddrOf bodyLocals locals epochs nodes nextTag true m
        srcPlace dstTy with
    | error _ => rw [hRO] at hOk; cases hOk
    | ok res =>
      rw [hRO] at hOk
      cases res with
      | mk pv rest =>
        cases rest with
        | mk n1 nt1 =>
          let ⟨hV, hN1⟩ :=
            evalRefOrAddrOf_notTargeting hND hLocs hNodes hRO
          injection hOk with hTup
          cases hTup
          exact ⟨hV, hLocs, hN1⟩
  | addressOf m srcPlace =>
    dsimp [evalRvalueRef] at hOk
    dsimp [stmtTakesDirectAddrOf] at hNoStmtAddr
    have hND :
        (!(srcPlace.projection.isEmpty && Nat.beq srcPlace.localId id)) =
          true := by
      rw [hNoStmtAddr]; rfl
    cases hRO : evalRefOrAddrOf bodyLocals locals epochs nodes nextTag false m
        srcPlace dstTy with
    | error _ => rw [hRO] at hOk; cases hOk
    | ok res =>
      rw [hRO] at hOk
      cases res with
      | mk pv rest =>
        cases rest with
        | mk n1 nt1 =>
          let ⟨hV, hN1⟩ :=
            evalRefOrAddrOf_notTargeting hND hLocs hNodes hRO
          injection hOk with hTup
          cases hTup
          exact ⟨hV, hLocs, hN1⟩
  | aggregateTuple _ | unsupported => cases hOk

private theorem writeTargetSlotRef_notTargeting {id : LocalId}
    {bodyLocals : List MirTy} {locals locals' : List LocalSlotRef}
    {epochs : List Nat} {nodes nodes' : List BorrowNode}
    {dstLoc : LocalId} {dstDeref? : Option (Bool × Mutability × LocalPtr)}
    {dstTy : MirTy} {val : ValRef}
    (hVal : valNotTargeting id val = true)
    (hLocs : locals.all (slotNotTargeting id) = true)
    (hNodes : nodesNotTargeting id nodes = true)
    (hOk : writeTargetSlotRef bodyLocals locals epochs nodes dstLoc dstDeref?
      dstTy val = .ok (locals', nodes')) :
    locals'.all (slotNotTargeting id) = true ∧
    nodesNotTargeting id nodes' = true := by
  unfold writeTargetSlotRef at hOk
  cases hCV : !checkValRef val dstTy with
  | true => rw [if_bool_true hCV] at hOk; cases hOk
  | false =>
    rw [if_bool_false hCV] at hOk
    cases dstDeref? with
    | none =>
      dsimp at hOk
      cases hDL : Trusted.MirSemantics.getElem? locals dstLoc with
      | none => rw [hDL] at hOk; cases hOk
      | some slot =>
        rw [hDL] at hOk
        cases slot with
        | dead => cases hOk
        | live _ =>
          dsimp at hOk
          cases hValOk :
              validateRuntimeValRef bodyLocals locals epochs dstTy val with
          | error _ => rw [hValOk] at hOk; cases hOk
          | ok u =>
            rw [hValOk] at hOk
            cases u
            dsimp at hOk
            cases hSet : setElem? locals dstLoc (.live (some val)) with
            | none => rw [hSet] at hOk; cases hOk
            | some l' =>
              rw [hSet] at hOk
              injection hOk with hTup
              cases hTup
              have hSlotV : slotNotTargeting id (.live (some val)) = true :=
                hVal
              exact ⟨list_all_setElem? hLocs hSlotV hSet,
                performTbRootAccess_preserves_noTarget id dstLoc epochs dstTy
                  .write hNodes⟩
    | some dInfo =>
      cases dInfo with
      | mk dSafe dRest =>
        cases dRest with
        | mk dMut ptr =>
          dsimp at hOk
          cases hBL : Trusted.MirSemantics.getElem? bodyLocals dstLoc with
          | none => rw [hBL] at hOk; cases hOk
          | some tgtDeclTy =>
            rw [hBL] at hOk
            cases hDL : Trusted.MirSemantics.getElem? locals dstLoc with
            | none => rw [hDL] at hOk; cases hOk
            | some tgtSlot =>
              rw [hDL] at hOk
              cases hDE : Trusted.MirSemantics.getElem? epochs dstLoc with
              | none => rw [hDE] at hOk; cases hOk
              | some curEp =>
                rw [hDE] at hOk
                dsimp at hOk
                cases hT : !MirTy.beq tgtDeclTy dstTy with
                | true => rw [if_bool_true hT] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hT] at hOk
                  cases hInh : dSafe && !isOpsemInhabitedTy dstTy with
                  | true => rw [if_bool_true hInh] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hInh] at hOk
                    cases tgtSlot with
                    | dead => cases hOk
                    | live _ =>
                      dsimp at hOk
                      cases hEp : !Nat.beq curEp ptr.targetEpoch with
                      | true => rw [if_bool_true hEp] at hOk; cases hOk
                      | false =>
                        rw [if_bool_false hEp] at hOk
                        cases hSh : Mutability.beq dMut .shared with
                        | true => rw [if_bool_true hSh] at hOk; cases hOk
                        | false =>
                          rw [if_bool_false hSh] at hOk
                          cases hTb :
                              performTbAccess dstLoc curEp dstTy .write
                                ptr.borrowTag nodes with
                          | error _ => rw [hTb] at hOk; cases hOk
                          | ok n' =>
                            rw [hTb] at hOk
                            dsimp at hOk
                            cases hValOk :
                                validateRuntimeValRef bodyLocals locals
                                  epochs dstTy val with
                            | error _ => rw [hValOk] at hOk; cases hOk
                            | ok u =>
                              rw [hValOk] at hOk
                              cases u
                              dsimp at hOk
                              cases hSet :
                                  setElem? locals dstLoc
                                    (.live (some val)) with
                              | none => rw [hSet] at hOk; cases hOk
                              | some l' =>
                                rw [hSet] at hOk
                                injection hOk with hTup
                                cases hTup
                                have hSlotV :
                                    slotNotTargeting id (.live (some val)) =
                                      true := hVal
                                exact ⟨list_all_setElem? hLocs hSlotV hSet,
                                  performTbAccess_preserves_noTarget id dstLoc
                                    curEp dstTy .write ptr.borrowTag hNodes
                                    hTb⟩

private theorem evalStepRef_preserves_frameNotTargeting {p : Program}
    {body : Body} {id : LocalId} {f : FrameStateRef} {mem : CallerMemory}
    {s' : ExecStateRef}
    (hBody : Trusted.MirSemantics.getElem? p.bodies f.defId = some body)
    (hNoAddr : bodyTakesAddressOf body id = false)
    (hInv : frameNotTargeting id f = true)
    (hStep : evalStepRef p 0 { frames := [f], callerMem := mem } = .step s') :
    ∃ f', s'.frames = [f'] ∧ f'.defId = f.defId ∧
      frameNotTargeting id f' = true := by
  let ⟨hLocs, hNodes⟩ := bool_and_true hInv
  unfold evalStepRef at hStep
  dsimp at hStep
  cases hLen : !Nat.beq f.epochs.length f.locals.length with
  | true => rw [if_bool_true hLen] at hStep; cases hStep
  | false =>
    rw [if_bool_false hLen, hBody] at hStep
    dsimp at hStep
    cases hBb : Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
    | none => rw [hBb] at hStep; cases hStep
    | some bb =>
      rw [hBb] at hStep
      dsimp at hStep
      cases hSt : Trusted.MirSemantics.getElem? bb.statements f.stmtIdx with
      | some stmt =>
        rw [hSt] at hStep
        dsimp at hStep
        have hBbNo : bb.statements.any (stmtTakesDirectAddrOf id) = false :=
          list_any_false_getElem?
            (p := fun b : BasicBlock =>
              b.statements.any (stmtTakesDirectAddrOf id))
            hNoAddr hBb
        have hStmtNo : stmtTakesDirectAddrOf id stmt = false :=
          list_any_false_getElem? hBbNo hSt
        unfold evalStatementRef at hStep
        rw [if_bool_false hLen] at hStep
        cases stmt with
        | nop =>
          injection hStep with hEq; subst hEq
          exact ⟨_, rfl, rfl, bool_and_intro hLocs hNodes⟩
        | unsupported => cases hStep
        | storageLive lid =>
          dsimp at hStep
          cases hBL : Trusted.MirSemantics.getElem? body.locals lid with
          | none => rw [hBL] at hStep; cases hStep
          | some lTy =>
            rw [hBL] at hStep
            dsimp at hStep
            cases hS1 :
                setElem? f.locals lid (liveUninitSlotRef lTy) with
            | none => rw [hS1] at hStep; cases hStep
            | some l' =>
              rw [hS1] at hStep
              cases hS2 : setElem? f.epochs lid f.nextEpoch with
              | none => rw [hS2] at hStep; cases hStep
              | some _ =>
                rw [hS2] at hStep
                injection hStep with hEq; subst hEq
                exact ⟨_, rfl, rfl,
                  bool_and_intro
                    (list_all_setElem? hLocs
                      (liveUninitSlotRef_notTargeting id lTy) hS1)
                    hNodes⟩
        | storageDead lid =>
          dsimp at hStep
          cases hL0 : Nat.beq lid 0 with
          | true => rw [if_bool_true hL0] at hStep; cases hStep
          | false =>
            rw [if_bool_false hL0] at hStep
            cases hS1 : setElem? f.locals lid .dead with
            | none => rw [hS1] at hStep; cases hStep
            | some l' =>
              rw [hS1] at hStep
              injection hStep with hEq; subst hEq
              exact ⟨_, rfl, rfl,
                bool_and_intro (list_all_setElem? hLocs rfl hS1) hNodes⟩
        | assign dst rv =>
          dsimp at hStep
          cases hProj : dst.projection with
          | nil =>
            rw [hProj] at hStep
            dsimp at hStep
            cases hBL :
                Trusted.MirSemantics.getElem? body.locals dst.localId with
            | none => rw [hBL] at hStep; cases hStep
            | some dstTy =>
              rw [hBL] at hStep
              dsimp at hStep
              cases hRv :
                  evalRvalueRef body.locals f.locals f.epochs f.borrowNodes
                    f.nextTag dst.localId false dstTy rv with
              | error _ => rw [hRv] at hStep; cases hStep
              | ok rvRes =>
                rw [hRv] at hStep
                cases rvRes with
                | mk val r1 =>
                  cases r1 with
                  | mk l1 r2 =>
                    cases r2 with
                    | mk n1 nt1 =>
                      dsimp at hStep
                      let ⟨hVal, hL1, hN1⟩ :=
                        evalRvalueRef_notTargeting hStmtNo hLocs hNodes hRv
                      cases hWr :
                          writeTargetSlotRef body.locals l1 f.epochs n1
                            dst.localId none dstTy val with
                      | error _ => rw [hWr] at hStep; cases hStep
                      | ok wrRes =>
                        rw [hWr] at hStep
                        cases wrRes with
                        | mk l2 n2 =>
                          injection hStep with hEq; subst hEq
                          let ⟨hL2, hN2⟩ :=
                            writeTargetSlotRef_notTargeting hVal hL1 hN1 hWr
                          exact ⟨_, rfl, rfl, bool_and_intro hL2 hN2⟩
          | cons pe rest =>
            rw [hProj] at hStep
            cases pe with
            | field _ _ | unsupported => cases hStep
            | deref =>
              cases rest with
              | cons _ _ => cases hStep
              | nil =>
                dsimp at hStep
                cases hDst :
                    resolveDerefDstRef body.locals f.locals f.epochs
                      f.borrowNodes dst.localId with
                | error _ => rw [hDst] at hStep; cases hStep
                | ok dRes =>
                  rw [hDst] at hStep
                  cases dRes with
                  | mk dSafe d1 =>
                    cases d1 with
                    | mk dMut d2 =>
                      cases d2 with
                      | mk dstTy d3 =>
                        cases d3 with
                        | mk ptr nDst =>
                          dsimp at hStep
                          let ⟨_, hNDst⟩ :=
                            resolveDerefDstRef_notTargeting hLocs hNodes
                              hDst
                          cases hRv :
                              evalRvalueRef body.locals f.locals f.epochs
                                nDst f.nextTag ptr.targetLocal true dstTy
                                rv with
                          | error _ => rw [hRv] at hStep; cases hStep
                          | ok rvRes =>
                            rw [hRv] at hStep
                            cases rvRes with
                            | mk val r1 =>
                              cases r1 with
                              | mk l1 r2 =>
                                cases r2 with
                                | mk n1 nt1 =>
                                  dsimp at hStep
                                  let ⟨hVal, hL1, hN1⟩ :=
                                    evalRvalueRef_notTargeting hStmtNo hLocs
                                      hNDst hRv
                                  cases hWr :
                                      writeTargetSlotRef body.locals l1
                                        f.epochs n1 ptr.targetLocal
                                        (some (dSafe, dMut, ptr)) dstTy
                                        val with
                                  | error _ =>
                                    rw [hWr] at hStep; cases hStep
                                  | ok wrRes =>
                                    rw [hWr] at hStep
                                    cases wrRes with
                                    | mk l2 n2 =>
                                      injection hStep with hEq; subst hEq
                                      let ⟨hL2, hN2⟩ :=
                                        writeTargetSlotRef_notTargeting hVal
                                          hL1 hN1 hWr
                                      exact ⟨_, rfl, rfl,
                                        bool_and_intro hL2 hN2⟩
      | none =>
        rw [hSt] at hStep
        dsimp at hStep
        cases hAtEnd : Nat.beq f.stmtIdx bb.statements.length with
        | false => rw [if_bool_false hAtEnd] at hStep; cases hStep
        | true =>
          rw [if_bool_true hAtEnd] at hStep
          unfold evalTerminatorRef at hStep
          rw [if_bool_false hLen] at hStep
          cases hTerm : bb.terminator with
          | goto _ =>
            rw [hTerm] at hStep
            dsimp [jumpToBlockRef] at hStep
            injection hStep with hEq; subst hEq
            exact ⟨_, rfl, rfl, bool_and_intro hLocs hNodes⟩
          | return_ =>
            rw [hTerm] at hStep
            dsimp at hStep
            cases hCl : bb.cleanup with
            | true => rw [if_bool_true hCl] at hStep; cases hStep
            | false =>
              rw [if_bool_false hCl] at hStep
              cases hL0 : Trusted.MirSemantics.getElem? f.locals 0 with
              | none => rw [hL0] at hStep; cases hStep
              | some sl =>
                rw [hL0] at hStep
                cases sl with
                | dead => cases hStep
                | live ov =>
                  cases ov with
                  | none => cases hStep
                  | some vr => cases vr <;> cases hStep
          | unreachable | unwindResume | assert _ _ _ _ _
          | call _ _ _ _ _ | unsupported =>
            rw [hTerm] at hStep; cases hStep
          | switchInt discr targets =>
            rw [hTerm] at hStep
            dsimp at hStep
            cases hD :
                evalPrimitiveOperandRef body.locals f.locals f.epochs
                  f.borrowNodes discr with
            | error _ => rw [hD] at hStep; cases hStep
            | ok dRes =>
              rw [hD] at hStep
              cases dRes with
              | mk dv dRest =>
                cases dRest with
                | mk l1 n1 =>
                  dsimp at hStep
                  let ⟨hL1, hN1⟩ :=
                    evalPrimitiveOperandRef_notTargeting hLocs hNodes hD
                  cases dv with
                  | scalar sv =>
                    dsimp at hStep
                    cases hSw :
                        evalSwitchBranches sv.width sv.bits targets.otherwise
                          targets.branches with
                    | error _ => rw [hSw] at hStep; cases hStep
                    | ok _ =>
                      rw [hSw] at hStep
                      dsimp [jumpToBlockRef] at hStep
                      injection hStep with hEq; subst hEq
                      exact ⟨_, rfl, rfl, bool_and_intro hL1 hN1⟩
                  | bool b =>
                    dsimp at hStep
                    cases hSw :
                        evalBoolSwitchBranches b targets.otherwise
                          targets.branches with
                    | error _ => rw [hSw] at hStep; cases hStep
                    | ok _ =>
                      rw [hSw] at hStep
                      dsimp [jumpToBlockRef] at hStep
                      injection hStep with hEq; subst hEq
                      exact ⟨_, rfl, rfl, bool_and_intro hL1 hN1⟩
                  | _ => cases hStep

