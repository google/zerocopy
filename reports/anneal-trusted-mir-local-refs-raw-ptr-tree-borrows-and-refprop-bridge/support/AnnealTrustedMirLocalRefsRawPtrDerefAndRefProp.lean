          | _ => cases hRvPart
    | false =>
      rw [if_bool_false hDef] at hAbs
      cases hWR : (dst.projection.isEmpty && Nat.beq dst.localId c.r) with
      | true => rw [if_bool_true hWR] at hAbs; cases hAbs
      | false =>
        rw [if_bool_false hWR] at hAbs
        -- Branch 2: forwardCopyOfRefStmt? (`y = copy r` -> `y = &m x` / `y = &raw m x`)
        cases hFwd : forwardCopyOfRefStmt? c.bodySrc.locals c.r c.x c.rTy dst rv
        with
        | some fwd =>
          rw [hFwd] at hAbs
          dsimp at hAbs
          let ⟨src, m, inner, hDstNil, hYNeR, hYNeX, hGYTy, hRvEq, hSrcNil,
               hSrcId, hFwdOr⟩ := s3b_forwardCopy_shape hFwd
          subst hRvEq
          cases src with
          | mk sLoc sProj =>
          dsimp at hSrcNil hSrcId; subst hSrcNil; subst hSrcId
          have hSrcNil : ([ ] : List ProjectionElem) = [] := rfl
          have hSrcId : c.r = c.r := rfl
          cases hLX : (!rL || !xL) with
          | true => rw [if_bool_true hLX] at hAbs; cases hAbs
          | false =>
            rw [if_bool_false hLX] at hAbs
            let ⟨hNR, hNX⟩ := bool_or_false hLX
            have hrLTrue := bool_not_false hNR
            have hxLTrue := bool_not_false hNX
            subst hrLTrue; subst hxLTrue
            let ⟨hSupX, hPtrR, hPtrCases⟩ := s3b_ctx_ptrTy_shape c
            have hXLtS : c.x < fS.locals.length := by
              rw [hCore.hLenLocS]; exact c.hXLt
            have hXLtT : c.x < fT.locals.length := by
              rw [hCore.hLenLocT]; exact c.hXLt
            have hXLtEp : c.x < fS.epochs.length := by
              rw [hCore.hLenEp]; exact c.hXLt
            let ⟨slXS, hGXS⟩ := getElem?_some_of_lt fS.locals c.x hXLtS
            let ⟨slXT, hGXT⟩ := getElem?_some_of_lt fT.locals c.x hXLtT
            let ⟨epX, hEpX⟩ := getElem?_some_of_lt fS.epochs c.x hXLtEp
            let ⟨optXS, hEqXS⟩ :=
              s3b_liveSlot_of_sound (hCore.hXLiveSound rfl slXS hGXS)
            subst hEqXS
            have hSlX := hCore.hSlotsOther c.x _ slXT c.hRNeX.symm hGXS hGXT
            cases slXT with
            | dead => exact False.elim hSlX
            | live _ =>
              have hEpXLt :=
                nat_blt_lt
