                                       | .mut => true
                                       | .shared => false) =
                                    reborrowMutOk m0 rM := by
                                intro m0 rM; cases m0 <;> cases rM <;> rfl
                              rw [c.hGetRSrc, s3b_ctx_getElem_localsTgt_x c]
                              dsimp only
                              rw [c.hPtrInfo]
                              dsimp
                              rw [hMutFold m2 c.rMut, hRebMutOk]
