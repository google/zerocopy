/-- **Sharpness Theorem CE8 & End-to-End Witness
(`witness_reborrow_inc_refprop_reduces_to_trusted`):**
Two-hop mutable reborrow + pointer move (`r1 = &mut x; r2_tmp = &mut (*r1);
r2 = move r2_tmp; *r2 = *r2 + 1`):
1. `pWitnessSrc` is not ref-free and faults `.fault .unsupported` in unmodified
   `Trusted.MirSemantics`, while returning `42_u32` on `41_u32` (and wrapping
   `0_u32` on `u32::MAX`) in `M_refPtr`;
2. `checkMirRefPropTrace pWitnessSrc witnessRefPropTrace pWitnessFlat = true`
   reduces `pWitnessSrc` to `pWitnessFlat` with
   `isRefFreeProgram pWitnessFlat = true` (`pWitnessSrc ≠ pWitnessFlat`); and
3. Both unmodified `Trusted.MirSemantics.UnitTheorem ⟨pWitnessFlat,
   witnessSpecs⟩` AND `UnitTheoremRef ⟨pWitnessSrc, witnessSpecs⟩` hold
   universally across all $2^{32}$ `u32` inputs with zero `sorry`! -/
theorem witness_reborrow_inc_refprop_reduces_to_trusted :
    isRefFreeProgram pWitnessSrc = false ∧
    isRefFreeProgram pWitnessFlat = true ∧
    checkMirRefPropTrace pWitnessSrc witnessRefPropTrace pWitnessFlat = true ∧
    pWitnessSrc ≠ pWitnessFlat ∧
    NegativeCanaryClaim pWitnessSrc { args := [u32Val 41] }
      .unsupported .undefined ∧
    PositiveCanaryClaimRef pWitnessSrc { args := [u32Val 41] } (u32Val 42) ∧
    PositiveCanaryClaim pWitnessFlat { args := [u32Val 41] } (u32Val 42) ∧
    PositiveCanaryClaimRef pWitnessSrc { args := [u32Val 4294967295] }
      (u32Val 0) ∧
    PositiveCanaryClaim pWitnessFlat { args := [u32Val 4294967295] }
      (u32Val 0) ∧
    UnitTheorem ⟨pWitnessFlat, witnessSpecs⟩ ∧
    UnitTheoremRef ⟨pWitnessSrc, witnessSpecs⟩ := by
  refine ⟨rfl, rfl, rfl, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro hEq
    have hRf :
        isRefFreeProgram pWitnessSrc = isRefFreeProgram pWitnessFlat := by
      rw [hEq]
    cases hRf
  · exact negativeCanary_of_execFaults (fuel := 6) (by intro h; cases h) rfl
  · exact positiveCanaryRef_of_exec (fuel := 20) rfl
  · exact positiveCanary_of_execReturns (fuel := 20) rfl
  · exact positiveCanaryRef_of_exec (fuel := 20) rfl
  · exact positiveCanary_of_execReturns (fuel := 20) rfl
  · refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, ?_, True.intro⟩
    intro defId body hGet
    cases defId with
    | succ n =>
      cases n <;> cases hGet
    | zero =>
      injection hGet with hBody
      subst hBody
      refine ⟨rfl, rfl, ?_⟩
      intro args hValid _
      let ⟨bits, hArgsEq, hWf⟩ :=
        validEntryArgs_u32_inv rfl rfl hValid
      subst hArgsEq
      exact pWitnessFlat_wellFormed_all_u32 bits hWf
  · refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, ?_, True.intro⟩
    intro defId body hGet
    cases defId with
    | succ n =>
      cases n <;> cases hGet
    | zero =>
      injection hGet with hBody
      subst hBody
      refine ⟨rfl, rfl, ?_⟩
      intro args hValid _
      let ⟨bits, hArgsEq, hWf⟩ :=
        validEntryArgs_u32_inv rfl rfl hValid
      subst hArgsEq
      exact pWitnessSrc_wellFormedRef_all_u32 bits hWf

