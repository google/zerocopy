                                      have htEq : t1 = tagR := by
                                        rw [hLR] at h5
                                        injection h5 with e1
                                        injection e1 with e2
                                        injection e2 with e2b
                                        injection e2b with e3 _
                                        injection e3 with _ _ eT; exact eT.symm
                                      subst htEq
                                      refine ⟨h1, h2, h3, p1, h4, h6, ?_⟩
                                      cases hPA1 with
                                      | inl hp => rw [hp.2]; exact Or.inl rfl
                                      | inr hp =>
                                        rw [hp.2]; exact Or.inr (Or.inr rfl)
                                    | inr hmFrz =>
                                      subst hmFrz
                                      let ⟨h1, h2, h3, t1, p1, h4, h5, h6,
                                           hPA1⟩ := hTRd
                                      have htEq : t1 = tagR := by
                                        rw [hLR] at h5
                                        injection h5 with e1
                                        injection e1 with e2
                                        injection e2 with e2b
                                        injection e2b with e3 _
                                        injection e3 with _ _ eT; exact eT.symm
                                      subst htEq
                                      refine ⟨h1, h2, h3, p1, h4, h6, ?_⟩
                                      cases hPA1 with
                                      | inl hp =>
                                        cases hp.2 with
                                        | inl hA => rw [hA]; exact Or.inl rfl
                                        | inr hB =>
