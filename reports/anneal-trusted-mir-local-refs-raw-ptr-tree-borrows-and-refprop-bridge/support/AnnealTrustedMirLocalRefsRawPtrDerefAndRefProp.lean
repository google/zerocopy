                            rw [s3b_evalRefOrAddrOf_eq_body,
                                s3b_evalRefOrAddrOf_eq_body]
                            cases expectedRefOrAddrInner? true m2 dstTy with
                            | none => rfl
                            | some dstInnerTy =>
                              dsimp [s3b_evalRefOrAddrBody]
