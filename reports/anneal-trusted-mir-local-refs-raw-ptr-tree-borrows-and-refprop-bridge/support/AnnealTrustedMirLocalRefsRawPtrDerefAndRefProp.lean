                            | false => rw [if_bool_false hC] at hAbs; cases hAbs
                            | true =>
                              rw [if_bool_true hC] at hAbs
                              let ⟨hm1, hm2⟩ := bool_and_true hC
                              let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                              rw [s3b_rewritePlace_noR
                                    (nat_beq_false_of_ne hYNeR)] at e2
                              dsimp [rewriteDerefRvalue, rewriteDerefPlace]
                                at e2
                              rw [if_bool_true (nat_beq_refl c.r)] at e2
                              exact ⟨e1.symm, e2.symm,
                                Or.inl ⟨rfl, hm1, borrowLinkMode_beq_eq hm2⟩⟩
                          | shared =>
                            dsimp at hAbs
                            cases hC : (BorrowLinkMode.beq mode .reserved ||
                                BorrowLinkMode.beq mode .frozen) with
                            | false => rw [if_bool_false hC] at hAbs; cases hAbs
                            | true =>
                              rw [if_bool_true hC] at hAbs
                              let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                              rw [s3b_rewritePlace_noR
                                    (nat_beq_false_of_ne hYNeR)] at e2
                              dsimp [rewriteDerefRvalue, rewriteDerefPlace]
                                at e2
                              rw [if_bool_true (nat_beq_refl c.r)] at e2
                              refine ⟨e1.symm, e2.symm, Or.inr ⟨rfl, ?_⟩⟩
                              cases bool_or_true hC with
