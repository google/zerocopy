              refine ⟨pm, Nat.le_refl _, Nat.le_refl _, s3b_PmMono_refl pm,
                ⟨rfl, c.hRNeX.symm, rfl, rfl, hEpLt, hTR0Lt,
                  hCore.hNextTagTPos, ?_⟩, hCore⟩
              intro declTy hDecl _ hNZ
              rw [c.hGetXSrc] at hDecl; injection hDecl with eD; subst eD
              have hCF : (c.trackTb && Nat.beq c.x c.x) = false := by
                rw [hTrF]; rfl
              rw [if_bool_false hCF]
              have hTInv := hCore.hTargetInv epX optXS hEpX hGXS
              unfold s3b_TargetLiveInv at hTInv
              rw [if_bool_false hTrF, if_bool_false hNZ] at hTInv
              have hLRZero := hTInv.2 rfl
              rw [hLRZero] at hLR0
              injection hLR0 with e1; injection e1 with e2
              injection e2 with e2b
              injection e2b with e3 _; injection e3 with _ _ eT
              exact Or.inl ⟨eT.symm, rfl⟩

private theorem s3b_evalOperand_getElem_r {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)} {opnd : Operand}
    {ty : MirTy} {opt : Option ValRef} {src? : Option LocalId}
    {localsS' : List LocalSlotRef} {nodesS' : List BorrowNode}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hDerefOnly : operandOnlyUsesDerefOf c.r c.rIsMut opnd = true)
    (hROk : ∀ ptr rTy',
      Trusted.MirSemantics.getElem? localsS c.r =
        some (.live (some (.localPtr ptr rTy'))) →
      ptr.targetLocal ≠ c.r)
    (hOk : evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd =
      .ok (ty, opt, src?, localsS', nodesS')) :
    Trusted.MirSemantics.getElem? localsS' c.r =
      Trusted.MirSemantics.getElem? localsS c.r := by
  cases opnd with
  | constant cst =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hC : evalConstLit cst.ty cst.lit with
    | error _ => rw [hC] at hOk; cases hOk
    | ok _ =>
      rw [hC] at hOk
      injection hOk with e; injection e with _ e2; injection e2 with _ e3
      injection e3 with _ e4; injection e4 with eL _; rw [eL]
  | copy p =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hp : p.projection with
    | nil =>
      rw [hp] at hOk; dsimp at hOk
      cases h1 : Trusted.MirSemantics.getElem? c.bodySrc.locals p.localId with
      | none => rw [h1] at hOk; cases hOk
      | some _ =>
        rw [h1] at hOk
        cases h2 : Trusted.MirSemantics.getElem? localsS p.localId with
        | none => rw [h2] at hOk; cases hOk
        | some sl =>
          rw [h2] at hOk
          cases sl with
          | dead => cases hOk
          | live _ =>
            injection hOk with e; injection e with _ e2
            injection e2 with _ e3; injection e3 with _ e4
            injection e4 with eL _; rw [eL]
    | cons pe rest =>
      rw [hp] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases hR : resolveDerefPlaceRef c.bodySrc.locals localsS epochs nodesS
              p.localId with
          | error _ => rw [hR] at hOk; cases hOk
          | ok res =>
            rw [hR] at hOk
            cases res with
            | mk _ a1 =>
              cases a1 with
              | mk _ a2 =>
                cases a2 with
                | mk _ a3 =>
                  cases a3 with
                  | mk _ a4 =>
                    cases a4 with
                    | mk _ _ =>
                      injection hOk with e; injection e with _ e2
                      injection e2 with _ e3; injection e3 with _ e4
                      injection e4 with eL _; rw [eL]
  | move p =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hp : p.projection with
    | nil =>
      have hNeR : p.localId ≠ c.r := by
        intro hEq
        dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnly
        rw [if_bool_true (nat_beq_of_eq hEq), hp] at hDerefOnly
        cases hDerefOnly
      rw [hp] at hOk; dsimp at hOk
      cases h1 : Trusted.MirSemantics.getElem? c.bodySrc.locals p.localId with
      | none => rw [h1] at hOk; cases hOk
      | some lTy =>
        rw [h1] at hOk
        cases h2 : Trusted.MirSemantics.getElem? localsS p.localId with
        | none => rw [h2] at hOk; cases hOk
        | some sl =>
          rw [h2] at hOk
          cases sl with
          | dead => cases hOk
          | live _ =>
            dsimp at hOk
            cases hS : setElem? localsS p.localId (liveUninitSlotRef lTy) with
            | none => rw [hS] at hOk; cases hOk
            | some _ =>
              rw [hS] at hOk
              injection hOk with e; injection e with _ e2
              injection e2 with _ e3; injection e3 with _ e4
              injection e4 with eL _; rw [← eL]
              exact setElem?_getElem?_ne hS (fun h => hNeR h.symm)
    | cons pe rest =>
      rw [hp] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases h1 : Trusted.MirSemantics.getElem? c.bodySrc.locals p.localId
          with
          | none => rw [h1] at hOk; cases hOk
          | some pDeclTy =>
            rw [h1] at hOk
            dsimp at hOk
            cases h2 : ptrPointeeInfo? pDeclTy with
            | none => rw [h2] at hOk; cases hOk
            | some pInf =>
              rw [h2] at hOk
              cases pInf with
              | mk dS d1 =>
                cases d1 with
                | mk dM dPtTy =>
                  dsimp at hOk
                  cases hSh : !dS && Mutability.beq dM .shared with
                  | true => rw [if_bool_true hSh] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hSh] at hOk
                    cases hR : resolveDerefPlaceRef c.bodySrc.locals localsS
                        epochs nodesS p.localId with
                    | error _ => rw [hR] at hOk; cases hOk
                    | ok rRes =>
                      rw [hR] at hOk
                      cases rRes with
                      | mk sR a1 =>
                        cases a1 with
                        | mk pM a2 =>
                          cases a2 with
                          | mk ptTy a3 =>
                            cases a3 with
                            | mk ptr a4 =>
                              cases a4 with
                              | mk _ n1 =>
                                dsimp at hOk
                                have hPtrNeR : ptr.targetLocal ≠ c.r := by
                                  unfold resolveDerefPlaceRef at hR
                                  rw [h1] at hR; dsimp only at hR
                                  rw [h2] at hR; dsimp at hR
                                  cases hL : !Nat.beq epochs.length
                                      localsS.length with
                                  | true => rw [if_bool_true hL] at hR; cases hR
                                  | false =>
                                    rw [if_bool_false hL] at hR
                                    cases hGP :
                                        Trusted.MirSemantics.getElem? localsS
                                          p.localId with
                                    | none => rw [hGP] at hR; cases hR
                                    | some slP =>
                                      rw [hGP] at hR
                                      cases slP with
                                      | dead => cases hR
                                      | live oP =>
                                        cases oP with
                                        | none => cases hR
                                        | some vP =>
                                          cases vP with
                                          | base _ => cases hR
                                          | localPtr ptr0 vTy0 =>
                                            dsimp at hR
                                            have hPtrEq : ptr0 = ptr := by
                                              cases hM : !MirTy.beq vTy0
                                                  pDeclTy with
                                              | true =>
                                                rw [if_bool_true hM] at hR
                                                cases hR
                                              | false =>
                                                rw [if_bool_false hM] at hR
                                                cases hI : dS &&
                                                    !isOpsemInhabitedTy dPtTy
                                                with
                                                | true =>
                                                  rw [if_bool_true hI] at hR
                                                  cases hR
                                                | false =>
                                                  rw [if_bool_false hI] at hR
                                                  cases hD : derefPointeeSlot
                                                      c.bodySrc.locals localsS
                                                      epochs _ ptr0 with
                                                  | error _ =>
                                                    rw [hD] at hR; cases hR
                                                  | ok _ =>
                                                    rw [hD] at hR; dsimp at hR
                                                    cases hT : performTbAccess
                                                        ptr0.targetLocal
                                                        ptr0.targetEpoch _ .read
                                                        ptr0.borrowTag _ with
                                                    | error _ =>
                                                      rw [hT] at hR; cases hR
                                                    | ok _ =>
                                                      rw [hT] at hR
                                                      injection hR with e
                                                      exact (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj e).2).2).2).1
                                            subst hPtrEq
                                            cases hEqP : Nat.beq p.localId c.r
                                            with
                                            | true =>
                                              have ep := nat_beq_eq hEqP
                                              rw [ep] at hGP
                                              exact hROk ptr0 vTy0 hGP
                                            | false =>
                                              have hLtT : p.localId <
                                                  localsT.length := by
                                                rw [hCore.hLenLocT,
                                                    ← hCore.hLenLocS]
                                                exact getElem?_some_lt hGP
                                              let ⟨slT, hGT⟩ :=
                                                getElem?_some_of_lt localsT
                                                  p.localId hLtT
                                              have hSl :=
                                                hCore.hSlotsOther p.localId _
                                                  slT (nat_ne_of_beq_false hEqP)
                                                  hGP hGT
                                              cases slT with
                                              | dead => exact False.elim hSl
                                              | live oT =>
                                                cases oT with
                                                | none => exact False.elim hSl
                                                | some vT =>
                                                  cases vT with
                                                  | base _ =>
                                                    exact False.elim hSl
                                                  | localPtr _ _ =>
                                                    exact hSl.2.1
                                cases hSh2 : sR && Mutability.beq pM .shared
                                with
                                | true => rw [if_bool_true hSh2] at hOk; cases hOk
                                | false =>
                                  rw [if_bool_false hSh2] at hOk
                                  cases hTb : performTbAccess ptr.targetLocal
                                      ptr.targetEpoch ptTy .write ptr.borrowTag
                                      n1 with
                                  | error _ => rw [hTb] at hOk; cases hOk
                                  | ok _ =>
                                    rw [hTb] at hOk; dsimp at hOk
                                    cases hS : setElem? localsS ptr.targetLocal
                                        (liveUninitSlotRef ptTy) with
                                    | none => rw [hS] at hOk; cases hOk
                                    | some _ =>
                                      rw [hS] at hOk
                                      injection hOk with e; injection e with _ e2
                                      injection e2 with _ e3
                                      injection e3 with _ e4
                                      injection e4 with eL _; rw [← eL]
                                      exact setElem?_getElem?_ne hS
                                        (fun h => hPtrNeR h.symm)

private theorem s3b_evalPrimOperand_getElem_r {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)} {opnd : Operand}
    {v : Val} {localsS' : List LocalSlotRef} {nodesS' : List BorrowNode}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hDerefOnly : operandOnlyUsesDerefOf c.r c.rIsMut opnd = true)
    (hROk : ∀ ptr rTy',
      Trusted.MirSemantics.getElem? localsS c.r =
        some (.live (some (.localPtr ptr rTy'))) →
      ptr.targetLocal ≠ c.r)
    (hOk : evalPrimitiveOperandRef c.bodySrc.locals localsS epochs nodesS opnd =
      .ok (v, localsS', nodesS')) :
    Trusted.MirSemantics.getElem? localsS' c.r =
      Trusted.MirSemantics.getElem? localsS c.r := by
  unfold evalPrimitiveOperandRef at hOk
  cases h1 : evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd
  with
  | error _ => rw [h1] at hOk; cases hOk
  | ok r1 =>
    rw [h1] at hOk
    cases r1 with
    | mk ty a1 =>
      cases a1 with
      | mk oS a2 =>
        cases a2 with
        | mk _ a3 =>
          cases a3 with
          | mk l1 _ =>
            have hEq := s3b_evalOperand_getElem_r hCore hDerefOnly hROk h1
            dsimp at hOk
            cases hP : !isPrimitiveReadableTy ty with
            | true => rw [if_bool_true hP] at hOk; cases hOk
            | false =>
              rw [if_bool_false hP] at hOk
              cases oS with
              | none => cases hOk
              | some vr =>
                cases vr with
                | localPtr _ _ => cases hOk
                | base _ =>
                  injection hOk with e; injection e with _ e2
                  injection e2 with eL _; rw [← eL]; exact hEq

private theorem s3b_evalRvalue_getElem_r {c : s3b_Ctx}
    {rL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {dstLoc : LocalId} {dstIsDeref : Bool} {dstTy : MirTy} {rv : Rvalue}
    {vS : ValRef} {localsS' : List LocalSlotRef} {nodesS' : List BorrowNode}
    {ntS' : Nat}
    (hCore : s3b_CoreInv c rL true mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hDerefRv : rvalueOnlyUsesDerefOf c.r c.rIsMut c.isSafeRef rv = true)
    (hNoXIfTr : c.trackTb = true → rvalueMentionsLocal c.x rv = false)
    (hModeOk :
      (c.trackTb = false ∧ mode = .reserved) ∨
      (c.trackTb = true ∧
        ((rvalueMovesDerefOf c.r rv = false ∧
            (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
          (c.rIsMut = true ∧ mode = .unique))))
    (hOk : evalRvalueRef c.bodySrc.locals localsS epochs nodesS ntS dstLoc
      dstIsDeref dstTy rv = .ok (vS, localsS', nodesS', ntS')) :
    Trusted.MirSemantics.getElem? localsS' c.r =
      Trusted.MirSemantics.getElem? localsS c.r := by
  have hXLtS : c.x < localsS.length := by rw [hCore.hLenLocS]; exact c.hXLt
  have hXLtEp : c.x < epochs.length := by rw [hCore.hLenEp]; exact c.hXLt
  let ⟨slXS, hGXS⟩ := getElem?_some_of_lt localsS c.x hXLtS
  let ⟨epX, hEpX⟩ := getElem?_some_of_lt epochs c.x hXLtEp
  let ⟨_, hEqXS⟩ := s3b_liveSlot_of_sound (hCore.hXLiveSound rfl slXS hGXS)
  subst hEqXS
  have hRdOk :
      (c.trackTb = false ∧ mode = .reserved) ∨
      (c.trackTb = true ∧ TbAccessKind.read = .read ∧
        (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
      (c.trackTb = true ∧ TbAccessKind.read = .write ∧
        c.rIsMut = true ∧ mode = .unique) := by
    cases hModeOk with
    | inl h1 => exact Or.inl h1
    | inr h2 =>
      cases h2.2 with
      | inl h3 => exact Or.inr (Or.inl ⟨h2.1, rfl, h3.2⟩)
      | inr h4 => exact Or.inr (Or.inl ⟨h2.1, rfl, Or.inr (Or.inl h4.2)⟩)
  let ⟨_, _, _, hLR0, _, _⟩ := s3b_tbDerefR .read hCore hEpX hGXS hRdOk
  have hROk0 : ∀ ptr rTy',
      Trusted.MirSemantics.getElem? localsS c.r =
        some (.live (some (.localPtr ptr rTy'))) →
      ptr.targetLocal ≠ c.r := by
    intro ptr _ hG
    rw [hLR0] at hG
    injection hG with e1; injection e1 with e2
    injection e2 with e2b
    injection e2b with ePtr _
    rw [← congrArg LocalPtr.targetLocal ePtr]
    exact c.hRNeX.symm
  cases rv with
  | aggregateTuple _ | unsupported => cases hOk
  | use opnd =>
    dsimp [evalRvalueRef] at hOk
    cases h1 : evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd
    with
    | error _ => rw [h1] at hOk; cases hOk
    | ok r1 =>
      rw [h1] at hOk
      cases r1 with
      | mk sTy a1 =>
        cases a1 with
        | mk oS a2 =>
          cases a2 with
          | mk sL a3 =>
            cases a3 with
            | mk l1 _ =>
              have hEq := s3b_evalOperand_getElem_r hCore hDerefRv hROk0 h1
              dsimp at hOk
              cases hM : !MirTy.beq sTy dstTy with
              | true => rw [if_bool_true hM] at hOk; cases hOk
              | false =>
                rw [if_bool_false hM] at hOk
                cases sL with
                | none =>
                  dsimp at hOk
                  rw [Bool.and_false] at hOk
                  dsimp at hOk
                  cases oS with
                  | none => cases hOk
                  | some _ =>
                    injection hOk with e; injection e with _ e2
                    injection e2 with eL _; rw [← eL]; exact hEq
                | some s =>
                  dsimp at hOk
                  cases hOv :
                      ((dstIsDeref || operandHasDerefProj opnd) &&
                        !isZeroSizedTy dstTy && Nat.beq s dstLoc)
                  with
                  | true => rw [if_bool_true hOv] at hOk; cases hOk
                  | false =>
                    rw [if_bool_false hOv] at hOk
                    cases oS with
                    | none => cases hOk
                    | some _ =>
                      injection hOk with e; injection e with _ e2
                      injection e2 with eL _; rw [← eL]; exact hEq
  | unaryOp op opnd =>
    dsimp [evalRvalueRef] at hOk
    cases h1 :
        evalPrimitiveOperandRef c.bodySrc.locals localsS epochs nodesS opnd with
    | error _ => rw [h1] at hOk; cases hOk
    | ok r1 =>
      rw [h1] at hOk
      cases r1 with
      | mk v1 a1 =>
        cases a1 with
        | mk l1 _ =>
          have hEq := s3b_evalPrimOperand_getElem_r hCore hDerefRv hROk0 h1
          dsimp at hOk
          cases hU : evalUnOp op v1 with
          | error _ => rw [hU] at hOk; cases hOk
          | ok _ =>
            rw [hU] at hOk
            injection hOk with e; injection e with _ e2
            injection e2 with eL _; rw [← eL]; exact hEq
  | binaryOp op lhs rhs =>
    dsimp [evalRvalueRef] at hOk
    let ⟨hDL, hDR⟩ := bool_and_true hDerefRv
    have hModeL :
        (c.trackTb = false ∧ mode = .reserved) ∨
        (c.trackTb = true ∧
          ((operandMovesDerefOf c.r lhs = false ∧
              (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
            (c.rIsMut = true ∧ mode = .unique))) := by
      cases hModeOk with
      | inl h1 => exact Or.inl h1
      | inr h2 =>
        cases h2.2 with
        | inl h3 =>
          exact Or.inr ⟨h2.1, Or.inl ⟨(bool_or_false h3.1).1, h3.2⟩⟩
        | inr h4 => exact Or.inr ⟨h2.1, Or.inr h4⟩
    have hLSim :=
      s3b_evalPrimOperand_rewritten hCore hDL
        (fun hTr => (bool_or_false (hNoXIfTr hTr)).1) hModeL
    cases h1 :
        evalPrimitiveOperandRef c.bodySrc.locals localsS epochs nodesS lhs with
    | error _ => rw [h1] at hOk; cases hOk
    | ok rl1 =>
      rw [h1] at hOk hLSim
      cases h2T :
          evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT
            (rewriteDerefOperand c.r c.x lhs) with
      | error _ => rw [h2T] at hLSim; exact False.elim hLSim
      | ok rl2 =>
        rw [h2T] at hLSim
        cases rl1 with
        | mk vl1 al1 =>
          cases al1 with
          | mk lS1 nS1 =>
            cases rl2 with
            | mk _ bl1 =>
              cases bl1 with
              | mk _ _ =>
                have hEq1 := s3b_evalPrimOperand_getElem_r hCore hDL hROk0 h1
                have hROk1 : ∀ ptr rTy',
                    Trusted.MirSemantics.getElem? lS1 c.r =
                      some (.live (some (.localPtr ptr rTy'))) →
                    ptr.targetLocal ≠ c.r := by
                  intro ptr rTy' hG; rw [hEq1] at hG; exact hROk0 ptr rTy' hG
                dsimp at hOk
                cases h2 :
                    evalPrimitiveOperandRef c.bodySrc.locals lS1 epochs nS1 rhs
                with
                | error _ => rw [h2] at hOk; cases hOk
                | ok rr1 =>
                  rw [h2] at hOk
                  cases rr1 with
                  | mk vr1 ar1 =>
                    cases ar1 with
                    | mk lS2 _ =>
                      have hEq2 :=
                        s3b_evalPrimOperand_getElem_r hLSim.2 hDR hROk1 h2
                      dsimp at hOk
                      cases hB : evalBinOp op vl1 vr1 with
                      | error _ => rw [hB] at hOk; cases hOk
                      | ok _ =>
                        rw [hB] at hOk
                        injection hOk with e; injection e with _ e2
                        injection e2 with eL _; rw [← eL]
                        exact hEq2.trans hEq1
  | discriminant p =>
    dsimp [evalRvalueRef] at hOk
    cases hp : p.projection with
    | nil =>
      rw [hp] at hOk; dsimp at hOk
      cases h1 : Trusted.MirSemantics.getElem? c.bodySrc.locals p.localId with
      | none => rw [h1] at hOk; cases hOk
      | some pTy =>
        rw [h1] at hOk
        cases pTy with
        | enum ety =>
          cases h2 : Trusted.MirSemantics.getElem? localsS p.localId with
          | none => rw [h2] at hOk; cases hOk
          | some sl =>
            rw [h2] at hOk; dsimp at hOk
            cases hEA : !enumAdmitted ety with
            | true => rw [if_bool_true hEA] at hOk; cases hOk
            | false =>
              rw [if_bool_false hEA] at hOk
              cases sl with
              | dead => cases hOk
              | live ov =>
                dsimp at hOk
                cases hD : decodeEnumDiscriminantSlot ety ov with
                | error _ => rw [hD] at hOk; cases hOk
                | ok _ =>
                  rw [hD] at hOk
                  injection hOk with e; injection e with _ e2
                  injection e2 with eL _; rw [← eL]
        | _ => cases hOk
    | cons pe rest =>
      rw [hp] at hOk
      cases pe with
      | field _ _ | unsupported => cases hOk
      | deref =>
        cases rest with
        | cons _ _ => cases hOk
        | nil =>
          dsimp at hOk
          cases hR : resolveDerefPlaceRef c.bodySrc.locals localsS epochs nodesS
              p.localId with
          | error _ => rw [hR] at hOk; cases hOk
          | ok rRes =>
            rw [hR] at hOk
            cases rRes with
            | mk _ a1 =>
              cases a1 with
              | mk _ a2 =>
                cases a2 with
                | mk ptTy a3 =>
                  cases a3 with
                  | mk _ a4 =>
                    cases a4 with
                    | mk ov _ =>
                      cases ptTy with
                      | enum ety =>
                        dsimp at hOk
                        cases hEA : !enumAdmitted ety with
                        | true => rw [if_bool_true hEA] at hOk; cases hOk
                        | false =>
                          rw [if_bool_false hEA] at hOk
                          cases hD : decodeEnumDiscriminantSlot ety ov with
                          | error _ => rw [hD] at hOk; cases hOk
                          | ok _ =>
                            rw [hD] at hOk
                            injection hOk with e; injection e with _ e2
                            injection e2 with eL _; rw [← eL]
                      | _ => cases hOk
  | ref m srcP =>
    dsimp [evalRvalueRef] at hOk
    cases h1 : evalRefOrAddrOf c.bodySrc.locals localsS epochs nodesS ntS true
        m srcP dstTy with
    | error _ => rw [h1] at hOk; cases hOk
    | ok r1 =>
      rw [h1] at hOk
      cases r1 with
      | mk _ a1 =>
        cases a1 with
        | mk _ _ =>
          injection hOk with e; injection e with _ e2
          injection e2 with eL _; rw [← eL]
  | addressOf m srcP =>
    dsimp [evalRvalueRef] at hOk
    cases h1 : evalRefOrAddrOf c.bodySrc.locals localsS epochs nodesS ntS false
        m srcP dstTy with
    | error _ => rw [h1] at hOk; cases hOk
    | ok r1 =>
      rw [h1] at hOk
      cases r1 with
      | mk _ a1 =>
        cases a1 with
        | mk _ _ =>
          injection hOk with e; injection e with _ e2
          injection e2 with eL _; rw [← eL]

/-! ### Statement-Level & Terminator-Level Lockstep Simulation -/

private theorem s3b_evalAssign_rewritten_nonReb {c : s3b_Ctx}
    {rL : Bool} {mode₁ : BorrowLinkMode}
    {fS fT : FrameStateRef} {mem : CallerMemory}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {dst : Place} {rv : Rvalue} {st₁ : AbsRefState}
    (hCore₁ : s3b_CoreInv c rL true mode₁ fS.locals fT.locals fS.epochs
      fS.nextEpoch fS.borrowNodes fT.borrowNodes fS.nextTag fT.nextTag pm)
    (hLenS : (!Nat.beq fS.epochs.length fS.locals.length) = false)
    (hLenT : (!Nat.beq fT.epochs.length fT.locals.length) = false)
    (hEpEq : fT.epochs = fS.epochs)
    (hNEpEq : fT.nextEpoch = fS.nextEpoch)
    (hSt₁ : st₁ = .reachable rL true mode₁)
    (hDerefDst : placeOnlyUsesDerefOf c.r dst = true)
    (hDstMut : dst.localId = c.r → c.rIsMut = true)
    (hDerefRv : rvalueOnlyUsesDerefOf c.r c.rIsMut c.isSafeRef rv = true)
    (hNoSelf :
      createsUnprojectedNonZstSelfUse c.xTy
        (rewriteDerefPlace c.r c.x dst)
        (rewriteDerefRvalue c.r c.x rv) = false)
    (hDstNoXIfTr : c.trackTb = true → dst.localId ≠ c.x)
    (hRvNoXIfTr : c.trackTb = true → rvalueMentionsLocal c.x rv = false)
    (hNoRebIfTr : c.trackTb = true → s3b_reborrowMutOpt c.r rv = none)
    (hModeOk :
      (c.trackTb = false ∧ mode₁ = .reserved) ∨
      (c.trackTb = true ∧
        ((rvalueMovesDerefOf c.r rv = false ∧
            (mode₁ = .reserved ∨ mode₁ = .unique ∨ mode₁ = .frozen)) ∨
          (c.rIsMut = true ∧ mode₁ = .unique))))
    (hModeWrIfR :
      dst.localId = c.r → c.trackTb = true → mode₁ = .unique) :
    match evalStatementRef c.bodySrc fS mem (.assign dst rv),
        evalStatementRef c.bodyTgt fT mem
          (.assign (rewriteDerefPlace c.r c.x dst)
            (rewriteDerefRvalue c.r c.x rv)) with
    | .fault k₁, .fault k₂ => k₁ = k₂
    | .done o₁, .done o₂ => o₁ = o₂
    | .step sS', .step sT' =>
      ∃ fS' fT' rL₁ xL₁ m₁ pm',
        st₁ = .reachable rL₁ xL₁ m₁ ∧
        sS' = { frames := [fS'], callerMem := mem } ∧
        sT' = { frames := [fT'], callerMem := mem } ∧
        fS'.defId = fS.defId ∧
        fT'.defId = fT.defId ∧
        fS'.blockIdx = fS.blockIdx ∧
        fT'.blockIdx = fT.blockIdx ∧
        fS'.stmtIdx = fS.stmtIdx + 1 ∧
        fT'.stmtIdx = fT.stmtIdx + 1 ∧
        fT'.epochs = fS'.epochs ∧
        fT'.nextEpoch = fS'.nextEpoch ∧
        s3b_CoreInv c rL₁ xL₁ m₁ fS'.locals fT'.locals fS'.epochs
          fS'.nextEpoch fS'.borrowNodes fT'.borrowNodes fS'.nextTag fT'.nextTag
          pm'
    | _, _ => False := by
  cases hDstR : Nat.beq dst.localId c.r with
  | true =>
    have hDstIdR := nat_beq_eq hDstR
    have hMutT : c.rIsMut = true := hDstMut hDstIdR
    have hRMutEq : c.rMut = .mut :=
      mutability_beq_eq (c.hRIsMut.symm.trans hMutT)
    have hNotSh : Mutability.beq c.rMut .shared = false := by
      rw [hRMutEq]; rfl
    have hDerefDstOrig := hDerefDst
    dsimp [placeOnlyUsesDerefOf] at hDerefDst
    rw [hDstR] at hDerefDst
    dsimp at hDerefDst
    have hDstProj : dst.projection = [.deref] := by
      cases hp : dst.projection with
      | nil => rw [hp] at hDerefDst; cases hDerefDst
      | cons a b =>
        cases a <;> first | (rw [hp] at hDerefDst; cases hDerefDst) |
          (cases b with
           | nil => rfl
           | cons _ _ => rw [hp] at hDerefDst; cases hDerefDst)
    have hXLtS : c.x < fS.locals.length := by
      rw [hCore₁.hLenLocS]; exact c.hXLt
    have hXLtEp : c.x < fS.epochs.length := by
      rw [hCore₁.hLenEp]; exact c.hXLt
    let ⟨slXS0, hGXS0⟩ := getElem?_some_of_lt fS.locals c.x hXLtS
    let ⟨epX, hEpX⟩ := getElem?_some_of_lt fS.epochs c.x hXLtEp
    let ⟨_, hEqXS0⟩ :=
      s3b_liveSlot_of_sound (hCore₁.hXLiveSound rfl slXS0 hGXS0)
    subst hEqXS0
    have hRdOk0 :
        (c.trackTb = false ∧ mode₁ = .reserved) ∨
        (c.trackTb = true ∧ TbAccessKind.read = .read ∧
          (mode₁ = .reserved ∨ mode₁ = .unique ∨ mode₁ = .frozen)) ∨
        (c.trackTb = true ∧ TbAccessKind.read = .write ∧
          c.rIsMut = true ∧ mode₁ = .unique) := by
      cases hModeOk with
      | inl h1 => exact Or.inl h1
      | inr h2 =>
        cases h2.2 with
        | inl h3 => exact Or.inr (Or.inl ⟨h2.1, rfl, h3.2⟩)
        | inr h4 => exact Or.inr (Or.inl ⟨h2.1, rfl, Or.inr (Or.inl h4.2)⟩)
    let ⟨tagR, _, _, hLR0, _, _⟩ :=
      s3b_tbDerefR .read hCore₁ hEpX hGXS0 hRdOk0
    have hRootNoop :=
      performTbRootAccess_noop_of_noTarget
        (epochs := fS.epochs) (ty := c.rTy) (kind := .read) hCore₁.hNoTargetRS
    have hDstShape :
        (dst.localId = c.r ∧ c.x = c.x ∧ c.xTy = c.xTy ∧
          true = true ∧ false = false) ∨
        (dst.localId ≠ c.r ∧ true = false ∧
          (false = false → dst.projection = [] ∧ c.x = dst.localId)) :=
      Or.inl ⟨hDstIdR, rfl, rfl, rfl, rfl⟩
    have hRv :=
      s3b_evalRvalue_rewritten (dstLoc := c.x) (dstIsDerefSrc := true)
        (dstIsDerefTgt := false) (dstTy := c.xTy) hCore₁ hDerefDstOrig hDerefRv
        hNoSelf hRvNoXIfTr hNoRebIfTr hDstShape hModeOk
    have hRewDst : rewriteDerefPlace c.r c.x dst = ⟨c.x, []⟩ := by
      unfold rewriteDerefPlace
      rw [if_bool_true hDstR, hDstProj]
    rw [hRewDst]
    unfold evalStatementRef
    rw [if_bool_false hLenS, if_bool_false hLenT]
    dsimp only
    rw [hDstProj, hDstIdR, hEpEq, hNEpEq]
    dsimp [resolveDerefDstRef]
    rw [c.hGetRSrc, s3b_ctx_getElem_localsTgt_x c]
    dsimp only
    rw [c.hPtrInfo]
    dsimp only
    rw [hNotSh, Bool.and_false]
    dsimp
    rw [if_bool_false hLenS, hLR0]
    dsimp only
    rw [mirTy_beq_refl c.rTy, hRootNoop]
    dsimp
    cases hR1 : evalRvalueRef c.bodySrc.locals fS.locals fS.epochs
        fS.borrowNodes fS.nextTag c.x true c.xTy rv with
    | error _ =>
      rw [hR1] at hRv
      cases hR2 : evalRvalueRef c.bodyTgt.locals fT.locals fS.epochs
          fT.borrowNodes fT.nextTag c.x false c.xTy
          (rewriteDerefRvalue c.r c.x rv) with
      | error _ => rw [hR2] at hRv; exact hRv
      | ok _ => rw [hR2] at hRv; exact False.elim hRv
    | ok rr1 =>
      rw [hR1] at hRv
      cases hR2 : evalRvalueRef c.bodyTgt.locals fT.locals fS.epochs
          fT.borrowNodes fT.nextTag c.x false c.xTy
          (rewriteDerefRvalue c.r c.x rv) with
      | error _ => rw [hR2] at hRv; exact False.elim hRv
      | ok rr2 =>
        rw [hR2] at hRv
        cases rr1 with
        | mk vS a1 =>
          cases a1 with
          | mk lS1 a2 =>
            cases a2 with
            | mk nS1 ntS1 =>
              cases rr2 with
              | mk vT b1 =>
                cases b1 with
                | mk lT1 b2 =>
                  cases b2 with
                  | mk nT1 ntT1 =>
                    dsimp
                    let ⟨pm1, _, _, _, hVal, hC1⟩ := hRv
                    have hGetR1 :
                        Trusted.MirSemantics.getElem? lS1 c.r =
                          Trusted.MirSemantics.getElem? fS.locals c.r :=
                      s3b_evalRvalue_getElem_r hCore₁ hDerefRv hRvNoXIfTr
                        hModeOk hR1
                    have hXLtS1 : c.x < lS1.length := by
                      rw [hC1.hLenLocS]; exact c.hXLt
                    have hXLtT1 : c.x < lT1.length := by
                      rw [hC1.hLenLocT]; exact c.hXLt
                    let ⟨slXS1, hGXS1⟩ := getElem?_some_of_lt lS1 c.x hXLtS1
                    let ⟨slXT1, hGXT1⟩ := getElem?_some_of_lt lT1 c.x hXLtT1
                    let ⟨_, hEqXS1⟩ :=
                      s3b_liveSlot_of_sound (hC1.hXLiveSound rfl slXS1 hGXS1)
                    subst hEqXS1
                    have hSlX1 :=
                      hC1.hSlotsOther c.x _ slXT1 c.hRNeX.symm hGXS1 hGXT1
                    cases slXT1 with
                    | dead => exact False.elim hSlX1
                    | live _ =>
                      have hWrModeOk :
                          (c.trackTb = false ∧ mode₁ = .reserved) ∨
                          (c.trackTb = true ∧ TbAccessKind.write = .read ∧
                            (mode₁ = .reserved ∨ mode₁ = .unique ∨
                              mode₁ = .frozen)) ∨
                          (c.trackTb = true ∧ TbAccessKind.write = .write ∧
                            c.rIsMut = true ∧ mode₁ = .unique) := by
                        cases hTr : c.trackTb with
                        | false =>
                          cases hModeOk with
                          | inl h1 => exact Or.inl ⟨rfl, h1.2⟩
                          | inr h2 => rw [hTr] at h2; cases h2.1
                        | true =>
                          exact Or.inr
                            (Or.inr ⟨rfl, rfl, hMutT, hModeWrIfR hDstIdR hTr⟩)
                      let ⟨tagR1, nS2, _, hLR1, hTbWr, hC2⟩ :=
                        s3b_tbDerefR .write hC1 hEpX hGXS1 hWrModeOk
                      have hTagEq : tagR1 = tagR := by
                        rw [hGetR1, hLR0] at hLR1
                        injection hLR1 with e1; injection e1 with e2
                        injection e2 with e2b
                        injection e2b with e3 _; injection e3 with _ _ eT
                        exact eT.symm
                      subst hTagEq
                      have hInhCheck :
                          (c.isSafeRef && !isOpsemInhabitedTy c.xTy) = false :=
                      by
                        cases hSR : c.isSafeRef with
                        | false => rfl
                        | true => rw [c.hInhab hSR]; rfl
                      unfold writeTargetSlotRef
                      rw [s3b_ValRel_checkValRef c.xTy hVal]
                      cases !checkValRef vT c.xTy with
                      | true => rfl
                      | false =>
                        dsimp
                        rw [c.hGetXSrc, hGXS1, hEpX, hGXT1]
                        dsimp only
                        rw [mirTy_beq_refl c.xTy, if_bool_false hInhCheck,
                            nat_beq_refl epX, hNotSh, hTbWr]
                        dsimp
                        rw [s3b_validateRuntimeValRef_eq hC1 hVal]
                        cases validateRuntimeValRef c.bodyTgt.locals lT1
                            fS.epochs c.xTy vT with
                        | error _ => rfl
                        | ok _ =>
                          dsimp
                          let ⟨lS2, hSetS⟩ :=
                            setElem?_some_of_lt lS1 c.x (.live (some vS))
                              hXLtS1
                          let ⟨lT2, hSetT⟩ :=
                            setElem?_some_of_lt lT1 c.x (.live (some vT))
                              hXLtT1
                          rw [hSetS, hSetT]
                          exact ⟨_, _, rL, true, mode₁, pm1, hSt₁, rfl, rfl,
                            rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                            s3b_CoreInv_setLiveOther hC2 c.hRNeX.symm hGXS1
                              hSetS hSetT rfl hVal⟩
  | false =>
    have hDstNeR := nat_ne_of_beq_false hDstR
    rw [s3b_rewritePlace_noR hDstR]
    unfold evalStatementRef
    rw [if_bool_false hLenS, if_bool_false hLenT, hEpEq, hNEpEq]
    dsimp
    cases hProj : dst.projection with
    | nil =>
      dsimp
      rw [s3b_ctx_getElem_localsTgt_ne c hDstNeR]
      cases hBL : Trusted.MirSemantics.getElem? c.bodySrc.locals dst.localId
      with
      | none => rfl
      | some dstTy =>
        dsimp
        have hDstShape :
            (dst.localId = c.r ∧ dst.localId = c.x ∧ dstTy = c.xTy ∧
              false = true ∧ false = false) ∨
            (dst.localId ≠ c.r ∧ false = false ∧
              (false = false → dst.projection = [] ∧ dst.localId = dst.localId)) :=
          Or.inr ⟨hDstNeR, rfl, fun _ => ⟨hProj, rfl⟩⟩
        have hRv :=
          s3b_evalRvalue_rewritten (dstLoc := dst.localId)
            (dstIsDerefSrc := false) (dstIsDerefTgt := false) (dstTy := dstTy)
            hCore₁ hDerefDst hDerefRv hNoSelf hRvNoXIfTr hNoRebIfTr hDstShape
            hModeOk
        cases hR1 : evalRvalueRef c.bodySrc.locals fS.locals fS.epochs
            fS.borrowNodes fS.nextTag dst.localId false dstTy rv with
        | error _ =>
          rw [hR1] at hRv
          cases hR2 : evalRvalueRef c.bodyTgt.locals fT.locals fS.epochs
              fT.borrowNodes fT.nextTag dst.localId false dstTy
              (rewriteDerefRvalue c.r c.x rv) with
          | error _ => rw [hR2] at hRv; exact hRv
          | ok _ => rw [hR2] at hRv; exact False.elim hRv
        | ok rr1 =>
          rw [hR1] at hRv
          cases hR2 : evalRvalueRef c.bodyTgt.locals fT.locals fS.epochs
              fT.borrowNodes fT.nextTag dst.localId false dstTy
              (rewriteDerefRvalue c.r c.x rv) with
          | error _ => rw [hR2] at hRv; exact False.elim hRv
          | ok rr2 =>
            rw [hR2] at hRv
            cases rr1 with
            | mk vS a1 =>
              cases a1 with
              | mk lS1 a2 =>
                cases a2 with
                | mk nS1 ntS1 =>
                  cases rr2 with
                  | mk vT b1 =>
                    cases b1 with
                    | mk lT1 b2 =>
                      cases b2 with
                      | mk nT1 ntT1 =>
                        dsimp
                        let ⟨pm1, _, _, _, hVal, hC1⟩ := hRv
                        have hWr :=
                          s3b_writeTarget_unproj_nonR hC1 hDstNeR hBL hVal
                        have hMIdle :
                            s3b_modeAfterRoot c dst.localId .write mode₁ =
                              mode₁ := by
                          unfold s3b_modeAfterRoot
                          cases hTr : c.trackTb with
                          | false => rfl
                          | true =>
                            rw [nat_beq_false_of_ne (hDstNoXIfTr hTr),
                                Bool.and_false]
                            rfl
                        rw [hMIdle] at hWr
                        cases hW1 : writeTargetSlotRef c.bodySrc.locals lS1
                            fS.epochs nS1 dst.localId none dstTy vS with
                        | error _ =>
                          rw [hW1] at hWr
                          cases hW2 : writeTargetSlotRef c.bodyTgt.locals lT1
                              fS.epochs nT1 dst.localId none dstTy vT with
                          | error _ => rw [hW2] at hWr; exact hWr
                          | ok _ => rw [hW2] at hWr; exact False.elim hWr
                        | ok w1 =>
                          rw [hW1] at hWr
                          cases hW2 : writeTargetSlotRef c.bodyTgt.locals lT1
                              fS.epochs nT1 dst.localId none dstTy vT with
                          | error _ => rw [hW2] at hWr; exact False.elim hWr
                          | ok w2 =>
                            rw [hW2] at hWr
                            cases w1 with
                            | mk lS2 nS2 =>
                              cases w2 with
                              | mk lT2 nT2 =>
                                exact ⟨_, _, rL, true, mode₁, pm1, hSt₁, rfl,
                                  rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
                                  hWr⟩
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          unfold resolveDerefDstRef
          have hLenST :
              (!Nat.beq fS.epochs.length fT.locals.length) = false := by
            rw [hCore₁.hLenEp, hCore₁.hLenLocT, nat_beq_refl]; rfl
          rw [s3b_ctx_getElem_localsTgt_ne c hDstNeR]
          cases hBL : Trusted.MirSemantics.getElem? c.bodySrc.locals
              dst.localId with
          | none => rfl
          | some ptrDeclTy =>
            dsimp
            cases ptrPointeeInfo? ptrDeclTy with
            | none => rfl
            | some dInfo =>
              cases dInfo with
              | mk dSafe dRest =>
                cases dRest with
                | mk dMut dstTy =>
                  dsimp
                  cases !dSafe && Mutability.beq dMut .shared with
                  | true => rfl
                  | false =>
                    dsimp
                    rw [if_bool_false hLenS, if_bool_false hLenST]
                    cases hLS : Trusted.MirSemantics.getElem? fS.locals
                        dst.localId with
                    | none =>
                      have hGe : fT.locals.length ≤ dst.localId := by
                        rw [hCore₁.hLenLocT, ← hCore₁.hLenLocS]
                        exact getElem?_none_ge hLS
                      rw [getElem?_none_of_ge hGe]
                    | some slS =>
                      have hLtT : dst.localId < fT.locals.length := by
                        rw [hCore₁.hLenLocT, ← hCore₁.hLenLocS]
                        exact getElem?_some_lt hLS
                      let ⟨slT, hLT⟩ :=
                        getElem?_some_of_lt fT.locals dst.localId hLtT
                      rw [hLT]
                      have hSl :=
                        hCore₁.hSlotsOther dst.localId slS slT hDstNeR hLS hLT
                      cases slS with
                      | dead =>
                        cases slT with
                        | dead => rfl
                        | live _ => exact False.elim hSl
                      | live oS =>
                        cases slT with
                        | dead => exact False.elim hSl
                        | live oT =>
                          cases oS with
                          | none =>
                            cases oT with
                            | none => rfl
                            | some _ => exact False.elim hSl
                          | some pvS =>
                            cases oT with
                            | none => exact False.elim hSl
                            | some pvT =>
                              cases pvS with
                              | base _ =>
                                cases pvT with
                                | base _ => rfl
                                | localPtr _ _ => exact False.elim hSl
                              | localPtr ptrS vTyS =>
                                cases pvT with
                                | base _ => exact False.elim hSl
                                | localPtr ptrT vTyT =>
                                  dsimp
                                  have hVTyST : vTyS = vTyT := hSl.1
                                  rw [← hVTyST]
                                  cases hVT : !MirTy.beq vTyS ptrDeclTy with
                                  | true => rfl
                                  | false =>
                                    dsimp
                                    have hPtrRel0 :
                                        s3b_ValRel c fS.epochs fS.nextEpoch
                                          fS.nextTag fT.nextTag pm
                                          (.localPtr ptrS ptrDeclTy)
                                          (.localPtr ptrT ptrDeclTy) := by
                                      have e1 : vTyS = ptrDeclTy :=
                                        mirTy_beq_eq (bool_not_false hVT)
                                      have e2 : vTyT = ptrDeclTy :=
                                        hVTyST.symm.trans e1
                                      rw [e1, e2] at hSl
                                      exact hSl
                                    have hC0 :=
                                      s3b_tbRoot_any .read hCore₁ hBL
                                    have hM0 :
                                        s3b_modeAfterRoot c dst.localId .read
                                          mode₁ = mode₁ := by
                                      unfold s3b_modeAfterRoot
                                      cases hTr : c.trackTb with
                                      | false => rfl
                                      | true =>
                                        rw [nat_beq_false_of_ne
                                              (hDstNoXIfTr hTr),
                                            Bool.and_false]
                                        rfl
                                    rw [hM0] at hC0
                                    rw [← hPtrRel0.2.2.1]
                                    have hDstShape :
                                        (dst.localId = c.r ∧
                                          ptrS.targetLocal = c.x ∧
                                          dstTy = c.xTy ∧
                                          true = true ∧ true = false) ∨
                                        (dst.localId ≠ c.r ∧ true = true ∧
                                          (true = false →
                                            dst.projection = [] ∧
                                            ptrS.targetLocal = dst.localId)) :=
                                      Or.inr ⟨hDstNeR, rfl, fun h => by cases h⟩
                                    have hRv :=
                                      s3b_evalRvalue_rewritten
                                        (dstLoc := ptrS.targetLocal)
                                        (dstIsDerefSrc := true)
                                        (dstIsDerefTgt := true)
                                        (dstTy := dstTy)
                                        hC0 hDerefDst hDerefRv hNoSelf
                                        hRvNoXIfTr hNoRebIfTr hDstShape hModeOk
                                    cases hR1 :
                                        evalRvalueRef c.bodySrc.locals fS.locals
                                          fS.epochs
                                          (performTbRootAccess fS.epochs
                                            dst.localId ptrDeclTy .read
                                            fS.borrowNodes)
                                          fS.nextTag ptrS.targetLocal true dstTy
                                          rv with
                                    | error _ =>
                                      rw [hR1] at hRv
                                      cases hR2 :
                                          evalRvalueRef c.bodyTgt.locals
                                            fT.locals fS.epochs
                                            (performTbRootAccess fS.epochs
                                              dst.localId ptrDeclTy .read
                                              fT.borrowNodes)
                                            fT.nextTag ptrS.targetLocal true
                                            dstTy
                                            (rewriteDerefRvalue c.r c.x rv) with
                                      | error _ => rw [hR2] at hRv; exact hRv
                                      | ok _ =>
                                        rw [hR2] at hRv; exact False.elim hRv
                                    | ok rr1 =>
                                      rw [hR1] at hRv
                                      cases hR2 :
                                          evalRvalueRef c.bodyTgt.locals
                                            fT.locals fS.epochs
                                            (performTbRootAccess fS.epochs
                                              dst.localId ptrDeclTy .read
                                              fT.borrowNodes)
                                            fT.nextTag ptrS.targetLocal true
                                            dstTy
                                            (rewriteDerefRvalue c.r c.x rv) with
                                      | error _ =>
                                        rw [hR2] at hRv; exact False.elim hRv
                                      | ok rr2 =>
                                        rw [hR2] at hRv
                                        cases rr1 with
                                        | mk vS a1 =>
                                          cases a1 with
                                          | mk lS1 a2 =>
                                            cases a2 with
                                            | mk nS1 ntS1 =>
                                              cases rr2 with
                                              | mk vT b1 =>
                                                cases b1 with
                                                | mk lT1 b2 =>
                                                  cases b2 with
                                                  | mk nT1 ntT1 =>
                                                    dsimp
                                                    let ⟨pm1, hLeS, hLeT, hPmM,
                                                         hVal, hC1⟩ := hRv
                                                    have hPtrRel1 :=
                                                      s3b_ValRel_mono_tags hLeS
                                                        hLeT hPmM hPtrRel0
                                                    have hWr :=
                                                      s3b_writeTarget_deref_nonR
                                                        (dSafe := dSafe)
                                                        (dMut := dMut)
                                                        (dstTy := dstTy)
                                                        hC1 hPtrRel1 hVal
                                                    rw [← hPtrRel0.2.2.1] at hWr
                                                    cases hW1 :
                                                        writeTargetSlotRef
                                                          c.bodySrc.locals lS1
                                                          fS.epochs nS1
                                                          ptrS.targetLocal
                                                          (some (dSafe, dMut,
                                                            ptrS)) dstTy vS with
                                                    | error _ =>
                                                      rw [hW1] at hWr
                                                      cases hW2 :
                                                          writeTargetSlotRef
                                                            c.bodyTgt.locals lT1
                                                            fS.epochs nT1
                                                            ptrS.targetLocal
                                                            (some (dSafe, dMut,
                                                              ptrT)) dstTy vT
                                                      with
                                                      | error _ =>
                                                        rw [hW2] at hWr
                                                        exact hWr
                                                      | ok _ =>
                                                        rw [hW2] at hWr
                                                        exact False.elim hWr
                                                    | ok w1 =>
                                                      rw [hW1] at hWr
                                                      cases hW2 :
                                                          writeTargetSlotRef
                                                            c.bodyTgt.locals lT1
                                                            fS.epochs nT1
                                                            ptrS.targetLocal
                                                            (some (dSafe, dMut,
                                                              ptrT)) dstTy vT
                                                      with
                                                      | error _ =>
                                                        rw [hW2] at hWr
                                                        exact False.elim hWr
                                                      | ok w2 =>
                                                        rw [hW2] at hWr
                                                        cases w1 with
                                                        | mk lS2 nS2 =>
                                                          cases w2 with
                                                          | mk lT2 nT2 =>
                                                            exact ⟨_, _, rL,
                                                              true, mode₁, pm1,
                                                              hSt₁, rfl, rfl,
                                                              rfl, rfl, rfl,
                                                              rfl, rfl, rfl,
                                                              rfl, rfl, hWr⟩

private theorem s3b_evalStatement_sim {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {fS fT : FrameStateRef} {mem : CallerMemory}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {stmt stmt' : StatementKind} {st₁ : AbsRefState}
    (hCore : s3b_CoreInv c rL xL mode fS.locals fT.locals fS.epochs fS.nextEpoch
      fS.borrowNodes fT.borrowNodes fS.nextTag fT.nextTag pm)
    (_hDefEq : fT.defId = fS.defId)
    (_hBlkEq : fT.blockIdx = fS.blockIdx)
    (_hIdxEq : fT.stmtIdx = fS.stmtIdx)
    (hEpEq : fT.epochs = fS.epochs)
    (hNEpEq : fT.nextEpoch = fS.nextEpoch)
    (hExclStmt :
      c.trackTb = true →
      stmtOnlyTakesAddrOfTargetFor c.r c.x c.rTy stmt = true)
    (hAbs :
      absStepAndRewriteStmt c.bodySrc.locals c.r c.x c.rTy c.xTy c.rIsMut
        c.isSafeRef c.trackTb (.reachable rL xL mode) stmt = some (st₁, stmt')) :
    match evalStatementRef c.bodySrc fS mem stmt,
        evalStatementRef c.bodyTgt fT mem stmt' with
    | .fault k₁, .fault k₂ => k₁ = k₂
    | .done o₁, .done o₂ => o₁ = o₂
    | .step sS', .step sT' =>
      ∃ fS' fT' rL₁ xL₁ mode₁ pm',
        st₁ = .reachable rL₁ xL₁ mode₁ ∧
        sS' = { frames := [fS'], callerMem := mem } ∧
        sT' = { frames := [fT'], callerMem := mem } ∧
        fS'.defId = fS.defId ∧
        fT'.defId = fT.defId ∧
        fS'.blockIdx = fS.blockIdx ∧
        fT'.blockIdx = fT.blockIdx ∧
        fS'.stmtIdx = fS.stmtIdx + 1 ∧
        fT'.stmtIdx = fT.stmtIdx + 1 ∧
        fT'.epochs = fS'.epochs ∧
        fT'.nextEpoch = fS'.nextEpoch ∧
        s3b_CoreInv c rL₁ xL₁ mode₁ fS'.locals fT'.locals fS'.epochs
          fS'.nextEpoch fS'.borrowNodes fT'.borrowNodes fS'.nextTag fT'.nextTag
          pm'
    | _, _ => False := by
  have hLenS : (!Nat.beq fS.epochs.length fS.locals.length) = false := by
    rw [hCore.hLenEp, hCore.hLenLocS, nat_beq_refl]; rfl
  have hLenT : (!Nat.beq fT.epochs.length fT.locals.length) = false := by
    rw [hEpEq, hCore.hLenEp, hCore.hLenLocT, nat_beq_refl]; rfl
  cases stmt with
  | nop =>
    dsimp [absStepAndRewriteStmt] at hAbs
    let ⟨hSt, hS'⟩ := s3b_some_prod_eq hAbs
    rw [← hS']
    unfold evalStatementRef
    rw [if_bool_false hLenS, if_bool_false hLenT]
    exact ⟨_, _, rL, xL, mode, pm, hSt.symm, rfl, rfl, rfl, rfl, rfl, rfl,
      rfl, rfl, hEpEq, hNEpEq, hCore⟩
  | unsupported =>
    dsimp [absStepAndRewriteStmt] at hAbs
    rw [← (s3b_some_prod_eq hAbs).2]
    unfold evalStatementRef
    rw [if_bool_false hLenS, if_bool_false hLenT]
  | storageLive lid =>
    dsimp [absStepAndRewriteStmt] at hAbs
    have hStmtEq : stmt' = .storageLive lid := by
      cases hR : Nat.beq lid c.r with
      | true => rw [if_bool_true hR] at hAbs; exact (s3b_some_prod_eq hAbs).2.symm
      | false =>
        rw [if_bool_false hR] at hAbs
        cases hX : Nat.beq lid c.x with
        | true => rw [if_bool_true hX] at hAbs; exact (s3b_some_prod_eq hAbs).2.symm
        | false => rw [if_bool_false hX] at hAbs; exact (s3b_some_prod_eq hAbs).2.symm
    rw [hStmtEq]
    unfold evalStatementRef
    rw [if_bool_false hLenS, if_bool_false hLenT, hEpEq, hNEpEq]
    dsimp
    cases hLidLt : Nat.blt lid c.bodySrc.locals.length with
    | false =>
      have hGeS := nat_blt_false_ge hLidLt
      have hGeT : c.bodyTgt.locals.length ≤ lid := by
        rw [s3b_ctx_localsTgt_len c]; exact hGeS
      rw [getElem?_none_of_ge hGeS, getElem?_none_of_ge hGeT]
    | true =>
      have hLt := nat_blt_lt hLidLt
      let ⟨tyS, hGTyS⟩ := getElem?_some_of_lt c.bodySrc.locals lid hLt
      let ⟨tyT, hGTyT⟩ :=
        getElem?_some_of_lt c.bodyTgt.locals lid
          (by rw [s3b_ctx_localsTgt_len c]; exact hLt)
      let ⟨lS', hSetLS⟩ :=
        setElem?_some_of_lt fS.locals lid (liveUninitSlotRef tyS)
          (by rw [hCore.hLenLocS]; exact hLt)
      let ⟨lT', hSetLT⟩ :=
        setElem?_some_of_lt fT.locals lid (liveUninitSlotRef tyT)
          (by rw [hCore.hLenLocT]; exact hLt)
      let ⟨eps', hSetEp⟩ :=
        setElem?_some_of_lt fS.epochs lid fS.nextEpoch
          (by rw [hCore.hLenEp]; exact hLt)
      rw [hGTyS, hGTyT]
      dsimp only
      rw [hSetLS, hSetLT, hSetEp]
      dsimp
      let pm' : LocalId → Nat → List (Nat × Nat) :=
        fun l e => if Nat.beq e fS.nextEpoch then [] else pm l e
      have hPmSame : ∀ l e, e < fS.nextEpoch → pm' l e = pm l e := by
        intro l e hLtE
        dsimp [pm']
        rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_lt hLtE))]
      have hEpLt' :
          eps'.all (fun ep => Nat.blt ep (fS.nextEpoch + 1)) = true := by
        have hStepEp :
            fS.epochs.all (fun ep => Nat.blt ep (fS.nextEpoch + 1)) = true :=
          list_all_of_forall_getElem? (fun _ ep hG => by
            have hB := list_all_getElem? hCore.hEpLt hG
            exact nat_lt_blt (Nat.lt_of_lt_of_le (nat_blt_lt hB) (Nat.le_succ _)))
        exact list_all_setElem? hStepEp (nat_lt_blt (Nat.lt_succ_self _)) hSetEp
      have hNodesSEp' :
          fS.borrowNodes.all
            (fun n => Nat.blt n.targetEpoch (fS.nextEpoch + 1)) = true :=
        list_all_of_forall_getElem? (fun _ n hG => by
          have hB := list_all_getElem? hCore.hNodesSEpLt hG
          exact nat_lt_blt (Nat.lt_of_lt_of_le (nat_blt_lt hB) (Nat.le_succ _)))
      have hNodesTEp' :
          fT.borrowNodes.all
            (fun n => Nat.blt n.targetEpoch (fS.nextEpoch + 1)) = true :=
        list_all_of_forall_getElem? (fun _ n hG => by
          have hB := list_all_getElem? hCore.hNodesTEpLt hG
          exact nat_lt_blt (Nat.lt_of_lt_of_le (nat_blt_lt hB) (Nat.le_succ _)))
      have hSlotsOther' :
          ∀ loc slS slT,
            loc ≠ c.r →
            Trusted.MirSemantics.getElem? lS' loc = some slS →
            Trusted.MirSemantics.getElem? lT' loc = some slT →
            s3b_SlotRel c eps' (fS.nextEpoch + 1) fS.nextTag fT.nextTag pm'
              slS slT := by
        intro loc slS slT hLocNeR hGS hGT
        cases hEqL : Nat.beq loc lid with
        | true =>
          have eL := nat_beq_eq hEqL; subst eL
          rw [setElem?_getElem?_same hSetLS] at hGS
          rw [setElem?_getElem?_same hSetLT] at hGT
          injection hGS with eS; injection hGT with eT
          have hTyEq : tyT = tyS := by
            rw [s3b_ctx_getElem_localsTgt_ne c hLocNeR, hGTyS] at hGTyT
            injection hGTyT with e; exact e.symm
          rw [← eS, ← eT, hTyEq]
          exact s3b_SlotRel_liveUninit c eps' (fS.nextEpoch + 1) fS.nextTag
            fT.nextTag pm' tyS
        | false =>
          have hNeL := nat_ne_of_beq_false hEqL
          rw [setElem?_getElem?_ne hSetLS hNeL] at hGS
          rw [setElem?_getElem?_ne hSetLT hNeL] at hGT
          exact s3b_SlotRel_storageLive hSetEp hPmSame
            (hCore.hSlotsOther loc slS slT hLocNeR hGS hGT)
      have hNonXRel' :
          ∀ loc ep declTy,
            loc ≠ c.x →
            Trusted.MirSemantics.getElem? c.bodySrc.locals loc = some declTy →
            Trusted.MirSemantics.getElem? eps' loc = some ep →
            isZeroSizedTy declTy = false →
            rp_ExactNodeRel loc ep [] (pm' loc ep)
              (rp_nodesAt loc ep fS.borrowNodes)
              (rp_nodesAt loc ep fT.borrowNodes) := by
        intro loc ep declTy hNeX hDecl hGEp' hNZ
        cases hEqL : Nat.beq loc lid with
        | true =>
          have eL := nat_beq_eq hEqL; subst eL
          rw [setElem?_getElem?_same hSetEp] at hGEp'
          injection hGEp' with eE; subst eE
          dsimp [pm']
          rw [nat_beq_refl fS.nextEpoch,
              rp_nodesAt_empty_of_epoch_lt (Nat.le_refl _) hCore.hNodesSEpLt,
              rp_nodesAt_empty_of_epoch_lt (Nat.le_refl _) hCore.hNodesTEpLt]
          exact .nil []
        | false =>
          have hNeL := nat_ne_of_beq_false hEqL
          rw [setElem?_getElem?_ne hSetEp hNeL] at hGEp'
          have hLtE :=
            nat_blt_lt
              (list_all_getElem? (p := fun ep => ep.blt fS.nextEpoch)
                hCore.hEpLt hGEp')
          rw [hPmSame loc ep hLtE]
          exact hCore.hNonXRel loc ep declTy hNeX hDecl hGEp' hNZ
      cases hEqR : Nat.beq lid c.r with
      | true =>
        rw [if_bool_true hEqR] at hAbs
        have eR := nat_beq_eq hEqR; subst eR
        let m' := match mode with | .delegated => BorrowLinkMode.delegated | _ => .clean
        have hStEq : st₁ = .reachable true xL m' := (s3b_some_prod_eq hAbs).1.symm
        refine ⟨_, _, true, xL, m', pm', hStEq, rfl, rfl, rfl, rfl, rfl, rfl,
          rfl, rfl, rfl, rfl, {
            hLenLocS := (setElem?_length hSetLS).trans hCore.hLenLocS
            hLenLocT := (setElem?_length hSetLT).trans hCore.hLenLocT
            hLenEp := (setElem?_length hSetEp).trans hCore.hLenEp
            hNextEpPos := Nat.le_trans hCore.hNextEpPos (Nat.le_succ _)
            hEpLt := hEpLt'
            hNodesSEpLt := hNodesSEp'
            hNodesTEpLt := hNodesTEp'
            hNextTagSPos := hCore.hNextTagSPos
            hNextTagTPos := hCore.hNextTagTPos
            hBoundedS := hCore.hBoundedS
            hBoundedT := hCore.hBoundedT
            hNoTargetRS := hCore.hNoTargetRS
            hNoTargetRT := hCore.hNoTargetRT
            hSlotsOther := hSlotsOther'
            hSlotRLiveEq := fun slS slT hGS hGT => by
              rw [setElem?_getElem?_same hSetLS] at hGS
              rw [setElem?_getElem?_same hSetLT] at hGT
              injection hGS with eS; injection hGT with eT
              rw [← eS, ← eT, s3b_slotIsLive_liveUninit,
                  s3b_slotIsLive_liveUninit]
            hRLiveSound := fun _ slS hGS => by
              rw [setElem?_getElem?_same hSetLS] at hGS
              injection hGS with eS; rw [← eS]
              exact s3b_slotIsLive_liveUninit tyS
            hXLiveSound := fun hx slX hGX => by
              rw [setElem?_getElem?_ne hSetLS c.hRNeX.symm] at hGX
              exact hCore.hXLiveSound hx slX hGX
            hNonXRel := hNonXRel'
            hTargetInv := fun epX optX hEpX' hLX' => by
              rw [setElem?_getElem?_ne hSetEp c.hRNeX.symm] at hEpX'
              rw [setElem?_getElem?_ne hSetLS c.hRNeX.symm] at hLX'
              have hLtEX :=
                nat_blt_lt
                  (list_all_getElem? (p := fun ep => ep.blt fS.nextEpoch)
                    hCore.hEpLt hEpX')
              have hBase := hCore.hTargetInv epX optX hEpX' hLX'
              have hMLe : linkModeLe mode m' = true := by
                cases mode <;> rfl
              have hMono := s3b_TargetLiveInv_mono hMLe hBase
              unfold s3b_TargetLiveInv at hMono
              unfold s3b_TargetLiveInv
              rw [hPmSame c.x epX hLtEX]
              cases hTr : c.trackTb with
              | true =>
                rw [if_bool_true hTr] at hMono
                rw [if_bool_true rfl]
                cases mode <;> exact hMono
              | false =>
                rw [if_bool_false hTr] at hMono
                rw [if_bool_false rfl]
                have hNotRes : BorrowLinkMode.beq m' .reserved = false := by
                  cases mode <;> rfl
                cases hZ : isZeroSizedTy c.xTy with
                | true =>
                  rw [if_bool_true rfl]
                  intro hm; rw [hNotRes] at hm; cases hm
                | false =>
                  rw [if_bool_false hZ] at hMono
                  rw [if_bool_false rfl]
                  exact ⟨hMono.1, fun hm => by rw [hNotRes] at hm; cases hm⟩
          }⟩
      | false =>
        rw [if_bool_false hEqR] at hAbs
        have hLidNeR := nat_ne_of_beq_false hEqR
        have hRNeLid : c.r ≠ lid := fun h => hLidNeR h.symm
        cases hEqX : Nat.beq lid c.x with
        | true =>
          rw [if_bool_true hEqX] at hAbs
          have eX := nat_beq_eq hEqX; subst eX
          have hStEq : st₁ = .reachable rL true .clean :=
            (s3b_some_prod_eq hAbs).1.symm
          refine ⟨_, _, rL, true, .clean, pm', hStEq, rfl, rfl, rfl, rfl, rfl,
            rfl, rfl, rfl, rfl, rfl, {
              hLenLocS := (setElem?_length hSetLS).trans hCore.hLenLocS
              hLenLocT := (setElem?_length hSetLT).trans hCore.hLenLocT
              hLenEp := (setElem?_length hSetEp).trans hCore.hLenEp
              hNextEpPos := Nat.le_trans hCore.hNextEpPos (Nat.le_succ _)
              hEpLt := hEpLt'
              hNodesSEpLt := hNodesSEp'
              hNodesTEpLt := hNodesTEp'
              hNextTagSPos := hCore.hNextTagSPos
              hNextTagTPos := hCore.hNextTagTPos
              hBoundedS := hCore.hBoundedS
              hBoundedT := hCore.hBoundedT
              hNoTargetRS := hCore.hNoTargetRS
              hNoTargetRT := hCore.hNoTargetRT
              hSlotsOther := hSlotsOther'
              hSlotRLiveEq := fun slS slT hGS hGT => by
                rw [setElem?_getElem?_ne hSetLS hRNeLid] at hGS
                rw [setElem?_getElem?_ne hSetLT hRNeLid] at hGT
                exact hCore.hSlotRLiveEq slS slT hGS hGT
              hRLiveSound := fun hr slS hGS => by
                rw [setElem?_getElem?_ne hSetLS hRNeLid] at hGS
                exact hCore.hRLiveSound hr slS hGS
              hXLiveSound := fun _ slX hGX => by
                rw [setElem?_getElem?_same hSetLS] at hGX
                injection hGX with eS; rw [← eS]
                exact s3b_slotIsLive_liveUninit tyS
              hNonXRel := hNonXRel'
              hTargetInv := fun epX _ hEpX' _ => by
                rw [setElem?_getElem?_same hSetEp] at hEpX'
                injection hEpX' with eE; subst eE
                unfold s3b_TargetLiveInv
                dsimp [pm']
                rw [nat_beq_refl fS.nextEpoch,
                    rp_nodesAt_empty_of_epoch_lt (Nat.le_refl _)
                      hCore.hNodesSEpLt,
                    rp_nodesAt_empty_of_epoch_lt (Nat.le_refl _)
                      hCore.hNodesTEpLt]
                cases c.trackTb with
                | true => exact ⟨rfl, rfl, True.intro⟩
                | false =>
                  dsimp
                  cases isZeroSizedTy c.xTy with
                  | true => intro hm; cases hm
                  | false => exact ⟨.nil [], fun hm => by cases hm⟩
            }⟩
        | false =>
          rw [if_bool_false hEqX] at hAbs
          have hLidNeX := nat_ne_of_beq_false hEqX
          have hXNeLid : c.x ≠ lid := fun h => hLidNeX h.symm
          have hStEq : st₁ = .reachable rL xL mode :=
            (s3b_some_prod_eq hAbs).1.symm
          refine ⟨_, _, rL, xL, mode, pm', hStEq, rfl, rfl, rfl, rfl, rfl, rfl,
            rfl, rfl, rfl, rfl, {
              hLenLocS := (setElem?_length hSetLS).trans hCore.hLenLocS
              hLenLocT := (setElem?_length hSetLT).trans hCore.hLenLocT
              hLenEp := (setElem?_length hSetEp).trans hCore.hLenEp
              hNextEpPos := Nat.le_trans hCore.hNextEpPos (Nat.le_succ _)
              hEpLt := hEpLt'
              hNodesSEpLt := hNodesSEp'
              hNodesTEpLt := hNodesTEp'
              hNextTagSPos := hCore.hNextTagSPos
              hNextTagTPos := hCore.hNextTagTPos
              hBoundedS := hCore.hBoundedS
              hBoundedT := hCore.hBoundedT
              hNoTargetRS := hCore.hNoTargetRS
              hNoTargetRT := hCore.hNoTargetRT
              hSlotsOther := hSlotsOther'
              hSlotRLiveEq := fun slS slT hGS hGT => by
                rw [setElem?_getElem?_ne hSetLS hRNeLid] at hGS
                rw [setElem?_getElem?_ne hSetLT hRNeLid] at hGT
                exact hCore.hSlotRLiveEq slS slT hGS hGT
              hRLiveSound := fun hr slS hGS => by
                rw [setElem?_getElem?_ne hSetLS hRNeLid] at hGS
                exact hCore.hRLiveSound hr slS hGS
              hXLiveSound := fun hx slX hGX => by
                rw [setElem?_getElem?_ne hSetLS hXNeLid] at hGX
                exact hCore.hXLiveSound hx slX hGX
              hNonXRel := hNonXRel'
              hTargetInv := fun epX optX hEpX' hLX' => by
                rw [setElem?_getElem?_ne hSetEp hXNeLid] at hEpX'
                rw [setElem?_getElem?_ne hSetLS hXNeLid] at hLX'
                have hLtEX :=
                  nat_blt_lt
                    (list_all_getElem? (p := fun ep => ep.blt fS.nextEpoch)
                      hCore.hEpLt hEpX')
                have hBase :=
                  s3b_TargetLiveInv_setOther hLidNeR hSetLS
                    (hCore.hTargetInv epX optX hEpX' hLX')
                unfold s3b_TargetLiveInv at hBase
                unfold s3b_TargetLiveInv
                rw [hPmSame c.x epX hLtEX]
                exact hBase
            }⟩
  | storageDead lid =>
    dsimp [absStepAndRewriteStmt] at hAbs
    have hStmtEq : stmt' = .storageDead lid := by
      cases hR : Nat.beq lid c.r with
      | true => rw [if_bool_true hR] at hAbs; exact (s3b_some_prod_eq hAbs).2.symm
      | false =>
        rw [if_bool_false hR] at hAbs
        cases hX : Nat.beq lid c.x with
        | true => rw [if_bool_true hX] at hAbs; exact (s3b_some_prod_eq hAbs).2.symm
        | false => rw [if_bool_false hX] at hAbs; exact (s3b_some_prod_eq hAbs).2.symm
    rw [hStmtEq]
    unfold evalStatementRef
    rw [if_bool_false hLenS, if_bool_false hLenT]
    dsimp
    cases Nat.beq lid 0 with
    | true => rfl
    | false =>
      dsimp
      cases hLidLt : Nat.blt lid c.bodySrc.locals.length with
      | false =>
        have hGe := nat_blt_false_ge hLidLt
        rw [setElem?_none_of_ge fS.locals lid .dead
              (by rw [hCore.hLenLocS]; exact hGe),
