private theorem projectLocalSlotRef_embed (sl : LocalSlot) :
    projectLocalSlotRef (embedLocalSlot sl) = some sl := by
  cases sl with
  | dead => rfl
  | live optV =>
    cases optV with
    | none => rfl
    | some _ => rfl

private theorem projectLocalSlotRef_eq_some_iff {slRef : LocalSlotRef}
    {sl : LocalSlot} :
    projectLocalSlotRef slRef = some sl ↔ slRef = embedLocalSlot sl := by
  constructor
  · intro h
    cases slRef with
    | dead =>
      injection h with hEq; subst hEq; rfl
    | live optVr =>
      cases optVr with
      | none =>
        injection h with hEq; subst hEq; rfl
      | some vr =>
        cases vr with
        | base v =>
          injection h with hEq; subst hEq; rfl
        | localPtr _ _ => cases h
  · intro h
    subst h
    exact projectLocalSlotRef_embed sl

private theorem listMapOption_projectLocalSlotRef_embed (ls : List LocalSlot) :
    listMapOption projectLocalSlotRef (ls.map embedLocalSlot) = some ls := by
  induction ls with
  | nil => rfl
  | cons sl rest ih =>
    dsimp [List.map, listMapOption]
    rw [projectLocalSlotRef_embed sl, ih]

private theorem listMapOption_projectLocalSlotRef_iff {lsRef : List LocalSlotRef}
    {ls : List LocalSlot} :
    listMapOption projectLocalSlotRef lsRef = some ls ↔
      lsRef = ls.map embedLocalSlot := by
  constructor
  · intro h
    induction lsRef generalizing ls with
    | nil =>
      injection h with hEq; subst hEq; rfl
    | cons a rest ih =>
      dsimp [listMapOption] at h
      cases hPa : projectLocalSlotRef a with
      | none => rw [hPa] at h; cases h
      | some b =>
        rw [hPa] at h
        cases hRest : listMapOption projectLocalSlotRef rest with
        | none => rw [hRest] at h; cases h
        | some bs =>
          rw [hRest] at h
          injection h with hEq; subst hEq
          dsimp [List.map]
          rw [(projectLocalSlotRef_eq_some_iff.mp hPa), ih hRest]
  · intro h
    subst h
    exact listMapOption_projectLocalSlotRef_embed ls

private theorem projectFrameRef_embed (f : FrameState) :
    projectFrameRef (embedFrame f) = some f := by
  unfold projectFrameRef embedFrame
  dsimp
  rw [map_length_eq, map_length_eq, nat_beq_refl]
  dsimp
  rw [listMapOption_projectLocalSlotRef_embed]

private theorem projectFrameRef_of_map_embed {fRef : FrameStateRef}
    {ls : List LocalSlot}
    (hLocs : fRef.locals = ls.map embedLocalSlot)
    (hEpLen : fRef.epochs.length = ls.length) :
    projectFrameRef fRef =
      some {
        defId := fRef.defId
        blockIdx := fRef.blockIdx
        stmtIdx := fRef.stmtIdx
        locals := ls
      } := by
  unfold projectFrameRef
  rw [hLocs, hEpLen, map_length_eq, nat_beq_refl]
  dsimp
  rw [listMapOption_projectLocalSlotRef_embed]

private theorem projectFrameRef_elim {fRef : FrameStateRef} {f : FrameState}
    (h : projectFrameRef fRef = some f) :
    fRef.defId = f.defId ∧
    fRef.blockIdx = f.blockIdx ∧
    fRef.stmtIdx = f.stmtIdx ∧
    fRef.locals = f.locals.map embedLocalSlot ∧
    fRef.epochs.length = f.locals.length := by
  unfold projectFrameRef at h
  cases hLen : !Nat.beq fRef.epochs.length fRef.locals.length with
  | true => rw [if_bool_true hLen] at h; cases h
  | false =>
    rw [if_bool_false hLen] at h
    cases hMap : listMapOption projectLocalSlotRef fRef.locals with
    | none => rw [hMap] at h; cases h
    | some ls =>
      rw [hMap] at h
      injection h with hF
      have hLocsEq : fRef.locals = ls.map embedLocalSlot :=
        listMapOption_projectLocalSlotRef_iff.mp hMap
      have hEpEq : fRef.epochs.length = ls.length := by
        have h1 := nat_beq_eq (bool_not_false hLen)
        rw [hLocsEq, map_length_eq] at h1
        exact h1
      subst hF
      exact ⟨rfl, rfl, rfl, hLocsEq, hEpEq⟩

private theorem projectStateRef_embed (s : State) :
    projectStateRef (embedState s) = some s := by
  unfold projectStateRef embedState
  dsimp
  have hFrames :
      listMapOption projectFrameRef (s.frames.map embedFrame) =
        some s.frames := by
    induction s.frames with
    | nil => rfl
    | cons fr rest ih =>
      dsimp [List.map, listMapOption]
      rw [projectFrameRef_embed fr, ih]
  rw [hFrames]

private theorem liveUninitSlotRef_eq_embed (ty : MirTy) :
    liveUninitSlotRef ty = embedLocalSlot (liveUninitSlot ty) := by
  cases ty with
  | unit => rfl
  | enum ety =>
    dsimp [liveUninitSlotRef, liveUninitSlot]
    cases isZstEnumTy ety <;> rfl
  | bool | int _ _ | never | tuple _ | ref _ _ | rawPtr _ _ | unsupported =>
    rfl

private theorem checkValRef_base_eq (v : Val) (ty : MirTy) :
    checkValRef (.base v) ty = checkVal v ty :=
  rfl

private theorem placeHasDeref_false_not_deref {p : Place}
    (h : placeHasDeref p = false) :
    p.projection ≠ [.deref] := by
  intro hEq
  unfold placeHasDeref at h
  rw [hEq] at h
  cases h

private theorem evalOperandToSlotRef_embed_eq (bodyLocals : List MirTy)
    (locals : List LocalSlot) (epochs : List Nat) (nodes : List BorrowNode)
    (opnd : Operand) (hNoDeref : operandHasDeref opnd = false) :
    match evalOperandToSlot bodyLocals locals opnd with
    | .error k =>
      evalOperandToSlotRef bodyLocals (locals.map embedLocalSlot) epochs nodes
        opnd = .error k
    | .ok (ty, optVal, locals') =>
      operandHasDerefProj opnd = false ∧
      ∃ srcLoc? nodes',
        evalOperandToSlotRef bodyLocals (locals.map embedLocalSlot) epochs
          nodes opnd =
          .ok (ty, optVal.map ValRef.base, srcLoc?,
               locals'.map embedLocalSlot, nodes') := by
  cases opnd with
  | copy place =>
    dsimp [operandHasDeref] at hNoDeref
    cases hPr : place.projection with
    | nil =>
      have hEv1 :
          evalOperandToSlot bodyLocals locals (.copy place) =
            match Trusted.MirSemantics.getElem? bodyLocals place.localId,
                Trusted.MirSemantics.getElem? locals place.localId with
            | some ty, some (.live optVal) => .ok (ty, optVal, locals)
            | some _, some .dead => .error .undefined
            | _, _ => .error .unsupported := by
        cases place with
        | mk lid proj =>
          dsimp at hPr
          subst hPr
          rfl
      rw [hEv1]
      dsimp [evalOperandToSlotRef]
      rw [hPr]
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? bodyLocals place.localId with
      | none => rfl
      | some ty =>
        cases Trusted.MirSemantics.getElem? locals place.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | live optV =>
            refine ⟨?_, some place.localId,
              performTbRootAccess epochs place.localId ty .read nodes, ?_⟩
            · dsimp [operandHasDerefProj]; rw [hPr]; rfl
            · cases optV <;> rfl
    | cons pe rest =>
      have hEv1 :
          evalOperandToSlot bodyLocals locals (.copy place) =
            .error .unsupported := by
        cases place with
        | mk lid proj =>
          dsimp at hPr
          subst hPr
          rfl
      rw [hEv1]
      dsimp [evalOperandToSlotRef]
      rw [hPr]
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          exact False.elim (placeHasDeref_false_not_deref hNoDeref hPr)
  | move place =>
    dsimp [operandHasDeref] at hNoDeref
    cases hPr : place.projection with
    | nil =>
      have hEv1 :
          evalOperandToSlot bodyLocals locals (.move place) =
            match Trusted.MirSemantics.getElem? bodyLocals place.localId,
                Trusted.MirSemantics.getElem? locals place.localId with
            | some ty, some (.live optVal) =>
              match setElem? locals place.localId (liveUninitSlot ty) with
              | some locals' => .ok (ty, optVal, locals')
              | none => .error .unsupported
            | some _, some .dead => .error .undefined
            | _, _ => .error .unsupported := by
        cases place with
        | mk lid proj =>
          dsimp at hPr
          subst hPr
          rfl
      rw [hEv1]
      dsimp [evalOperandToSlotRef]
      rw [hPr]
      dsimp
      rw [getElem?_map]
      cases Trusted.MirSemantics.getElem? bodyLocals place.localId with
      | none => rfl
      | some ty =>
        cases Trusted.MirSemantics.getElem? locals place.localId with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | live optV =>
            have hSlot :
                embedLocalSlot (.live optV) = .live (optV.map ValRef.base) := by
              cases optV <;> rfl
            dsimp [Option.map]
            rw [hSlot]
            dsimp
            rw [liveUninitSlotRef_eq_embed ty, setElem?_map_eq]
            cases setElem? locals place.localId (liveUninitSlot ty) with
            | none => rfl
            | some locals' =>
              refine ⟨?_, some place.localId, _, rfl⟩
              dsimp [operandHasDerefProj]; rw [hPr]; rfl
    | cons pe rest =>
      have hEv1 :
          evalOperandToSlot bodyLocals locals (.move place) =
            .error .unsupported := by
        cases place with
        | mk lid proj =>
          dsimp at hPr
          subst hPr
          rfl
      rw [hEv1]
      dsimp [evalOperandToSlotRef]
      rw [hPr]
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          exact False.elim (placeHasDeref_false_not_deref hNoDeref hPr)
  | constant c =>
    have hEv1 :
        evalOperandToSlot bodyLocals locals (.constant c) =
          match evalConstLit c.ty c.lit with
          | .ok v => .ok (c.ty, some v, locals)
          | .error k => .error k := rfl
    rw [hEv1]
    dsimp [evalOperandToSlotRef]
    cases evalConstLit c.ty c.lit with
    | error _ => rfl
    | ok v => exact ⟨rfl, none, nodes, rfl⟩

private theorem evalPrimitiveOperandRef_embed_eq (bodyLocals : List MirTy)
    (locals : List LocalSlot) (epochs : List Nat) (nodes : List BorrowNode)
    (opnd : Operand) (hNoDeref : operandHasDeref opnd = false) :
    match evalPrimitiveOperand bodyLocals locals opnd with
    | .error k =>
      evalPrimitiveOperandRef bodyLocals (locals.map embedLocalSlot) epochs
        nodes opnd = .error k
    | .ok (v, locals') =>
      ∃ nodes',
        evalPrimitiveOperandRef bodyLocals (locals.map embedLocalSlot) epochs
          nodes opnd = .ok (v, locals'.map embedLocalSlot, nodes') := by
  unfold evalPrimitiveOperand evalPrimitiveOperandRef
  have hOp :=
    evalOperandToSlotRef_embed_eq bodyLocals locals epochs nodes opnd hNoDeref
  cases hE : evalOperandToSlot bodyLocals locals opnd with
  | error k =>
    rw [hE] at hOp
    rw [hOp]
  | ok res =>
    rw [hE] at hOp
    cases res with
    | mk ty rest =>
      cases rest with
      | mk optVal locals' =>
        let ⟨_, srcLoc?, nodes', hRefE⟩ := hOp
        rw [hRefE]
        dsimp
        cases isPrimitiveReadableTy ty with
        | false => rfl
        | true =>
          dsimp
          cases optVal with
          | none => rfl
          | some v => exact ⟨nodes', rfl⟩

private theorem evalOperandToSlot_length {bodyLocals : List MirTy}
    {locals locals' : List LocalSlot} {opnd : Operand} {ty : MirTy}
    {optVal : Option Val}
    (h : evalOperandToSlot bodyLocals locals opnd = .ok (ty, optVal, locals')) :
    locals'.length = locals.length := by
  cases opnd with
  | copy place =>
    cases hPr : place.projection with
    | cons pe rest =>
      have hE :
          evalOperandToSlot bodyLocals locals (.copy place) =
            .error .unsupported := by
        cases place with
        | mk _ proj => dsimp at hPr; subst hPr; rfl
      rw [hE] at h; cases h
    | nil =>
      have hE :
          evalOperandToSlot bodyLocals locals (.copy place) =
            match Trusted.MirSemantics.getElem? bodyLocals place.localId,
                Trusted.MirSemantics.getElem? locals place.localId with
            | some t, some (.live ov) => .ok (t, ov, locals)
            | some _, some .dead => .error .undefined
            | _, _ => .error .unsupported := by
        cases place with
        | mk _ proj => dsimp at hPr; subst hPr; rfl
      rw [hE] at h
      cases hBL : Trusted.MirSemantics.getElem? bodyLocals place.localId with
      | none => rw [hBL] at h; cases h
      | some _ =>
        rw [hBL] at h
        cases hL : Trusted.MirSemantics.getElem? locals place.localId with
        | none => rw [hL] at h; cases h
        | some sl =>
          rw [hL] at h
          cases sl with
          | dead => cases h
          | live _ => injection h with hT; cases hT; rfl
  | move place =>
    cases hPr : place.projection with
    | cons _ _ =>
      have hE :
          evalOperandToSlot bodyLocals locals (.move place) =
            .error .unsupported := by
        cases place with
        | mk _ proj => dsimp at hPr; subst hPr; rfl
      rw [hE] at h; cases h
    | nil =>
      have hE :
          evalOperandToSlot bodyLocals locals (.move place) =
            match Trusted.MirSemantics.getElem? bodyLocals place.localId,
                Trusted.MirSemantics.getElem? locals place.localId with
            | some t, some (.live ov) =>
              match setElem? locals place.localId (liveUninitSlot t) with
              | some ls' => .ok (t, ov, ls')
              | none => .error .unsupported
            | some _, some .dead => .error .undefined
            | _, _ => .error .unsupported := by
        cases place with
        | mk _ proj => dsimp at hPr; subst hPr; rfl
      rw [hE] at h
      cases hBL : Trusted.MirSemantics.getElem? bodyLocals place.localId with
      | none => rw [hBL] at h; cases h
      | some t =>
        rw [hBL] at h
        cases hL : Trusted.MirSemantics.getElem? locals place.localId with
        | none => rw [hL] at h; cases h
        | some sl =>
          rw [hL] at h
          cases sl with
          | dead => cases h
          | live _ =>
            dsimp at h
            cases hSet : setElem? locals place.localId (liveUninitSlot t) with
            | none => rw [hSet] at h; cases h
            | some ls' =>
              rw [hSet] at h
              injection h with hT; cases hT
              exact setElem?_length hSet
  | constant c =>
    have hE :
        evalOperandToSlot bodyLocals locals (.constant c) =
          match evalConstLit c.ty c.lit with
          | .ok v => .ok (c.ty, some v, locals)
          | .error k => .error k := rfl
    rw [hE] at h
    cases hC : evalConstLit c.ty c.lit with
    | error _ => rw [hC] at h; cases h
    | ok _ => rw [hC] at h; injection h with hT; cases hT; rfl

private theorem evalPrimitiveOperand_length {bodyLocals : List MirTy}
    {locals locals' : List LocalSlot} {opnd : Operand} {v : Val}
    (h : evalPrimitiveOperand bodyLocals locals opnd = .ok (v, locals')) :
    locals'.length = locals.length := by
  unfold evalPrimitiveOperand at h
  cases hOp : evalOperandToSlot bodyLocals locals opnd with
  | error _ => rw [hOp] at h; cases h
  | ok res =>
    rw [hOp] at h
    cases res with
    | mk ty rest =>
      cases rest with
      | mk optV ls1 =>
        dsimp at h
        cases hPr : !isPrimitiveReadableTy ty with
        | true => rw [if_bool_true hPr] at h; cases h
        | false =>
          rw [if_bool_false hPr] at h
          cases optV with
          | none => cases h
          | some _ =>
            injection h with hT; cases hT
            exact evalOperandToSlot_length hOp

private theorem evalRvalue_length {bodyLocals : List MirTy}
    {locals locals' : List LocalSlot} {dstTy : MirTy} {rv : Rvalue} {v : Val}
    (h : evalRvalue bodyLocals locals dstTy rv = .ok (v, locals')) :
    locals'.length = locals.length := by
  cases rv with
  | use opnd =>
    change (match evalOperandToSlot bodyLocals locals opnd with
            | .error k => Except.error k
            | .ok (srcTy, optVal, locals₁) =>
              if !(MirTy.beq srcTy dstTy) then .error .unsupported
              else match optVal with
                   | some v => .ok (v, locals₁)
                   | none => .error .undefined) = _ at h
    cases hOp : evalOperandToSlot bodyLocals locals opnd with
    | error _ => rw [hOp] at h; cases h
    | ok res =>
      rw [hOp] at h
      cases res with
      | mk sTy rest =>
        cases rest with
        | mk optV ls1 =>
          dsimp at h
          cases hT : !MirTy.beq sTy dstTy with
          | true => rw [if_bool_true hT] at h; cases h
          | false =>
            rw [if_bool_false hT] at h
            cases optV with
            | none => cases h
            | some _ =>
              injection h with hEq; cases hEq
              exact evalOperandToSlot_length hOp
  | binaryOp op lhs rhs =>
    change (match evalPrimitiveOperand bodyLocals locals lhs with
            | .error k => Except.error k
            | .ok (lVal, locals₁) =>
              match evalPrimitiveOperand bodyLocals locals₁ rhs with
              | .error k => .error k
              | .ok (rVal, locals₂) =>
                match evalBinOp op lVal rVal with
                | .error k => .error k
                | .ok res => .ok (res, locals₂)) = _ at h
    cases hL : evalPrimitiveOperand bodyLocals locals lhs with
    | error _ => rw [hL] at h; cases h
    | ok rL =>
      rw [hL] at h
      cases rL with
      | mk lv ls1 =>
        dsimp at h
        cases hR : evalPrimitiveOperand bodyLocals ls1 rhs with
        | error _ => rw [hR] at h; cases h
        | ok rR =>
          rw [hR] at h
          cases rR with
          | mk rv' ls2 =>
            dsimp at h
            cases hB : evalBinOp op lv rv' with
            | error _ => rw [hB] at h; cases h
            | ok _ =>
              rw [hB] at h
              injection h with hEq; cases hEq
              exact (evalPrimitiveOperand_length hR).trans
                (evalPrimitiveOperand_length hL)
  | unaryOp op opnd =>
    change (match evalPrimitiveOperand bodyLocals locals opnd with
            | .error k => Except.error k
            | .ok (v', locals₁) =>
              match evalUnOp op v' with
              | .error k => .error k
              | .ok res => .ok (res, locals₁)) = _ at h
    cases hO : evalPrimitiveOperand bodyLocals locals opnd with
    | error _ => rw [hO] at h; cases h
    | ok rO =>
      rw [hO] at h
      cases rO with
      | mk v' ls1 =>
        dsimp at h
        cases hU : evalUnOp op v' with
        | error _ => rw [hU] at h; cases h
        | ok _ =>
          rw [hU] at h
          injection h with hEq; cases hEq
          exact evalPrimitiveOperand_length hO
  | discriminant place =>
    cases hPr : place.projection with
    | cons _ _ =>
      have hE :
          evalRvalue bodyLocals locals dstTy (.discriminant place) =
            .error .unsupported := by
        cases place with
        | mk _ proj => dsimp at hPr; subst hPr; rfl
      rw [hE] at h; cases h
    | nil =>
      cases place with
      | mk lid proj =>
        dsimp at hPr; subst hPr
        change (match Trusted.MirSemantics.getElem? bodyLocals lid,
                    Trusted.MirSemantics.getElem? locals lid with
                | some (.enum ety), some slot =>
                  if !enumAdmitted ety then Except.error FaultKind.unsupported
                  else
                    match ety.tagRepr, slot with
                    | _, .dead => .error .undefined
                    | .zeroSized, .live none =>
                      match Trusted.MirSemantics.getElem? ety.discriminants 0
                      with
                      | some d =>
                        .ok (Val.scalar ⟨ety.discrWidth, ety.discrSigned,
                          truncateBits ety.discrWidth (BitVec.ofNat 128 d)⟩,
                          locals)
                      | none => .error .unsupported
                    | .zeroSized, .live (some (.enumVal ety' v)) =>
                      if EnumTy.beq ety ety' && Nat.beq v 0 then
                        match Trusted.MirSemantics.getElem? ety.discriminants 0
                        with
                        | some d =>
                          .ok (Val.scalar ⟨ety.discrWidth, ety.discrSigned,
                            truncateBits ety.discrWidth (BitVec.ofNat 128 d)⟩,
                            locals)
                        | none => .error .unsupported
                      else .error .unsupported
                    | .zeroSized, .live (some _) => .error .unsupported
                    | .scalar _ _, .live none => .error .undefined
                    | .scalar _ _, .live (some (.enumVal ety' v)) =>
                      if EnumTy.beq ety ety' &&
                          Nat.blt v ety.discriminants.length then
                        match Trusted.MirSemantics.getElem? ety.discriminants v
                        with
                        | some d =>
                          .ok (Val.scalar ⟨ety.discrWidth, ety.discrSigned,
                            truncateBits ety.discrWidth (BitVec.ofNat 128 d)⟩,
                            locals)
                        | none => .error .unsupported
                      else .error .unsupported
                    | .scalar _ _, .live (some _) => .error .unsupported
                | _, _ => .error .unsupported) = _ at h
        cases hBL : Trusted.MirSemantics.getElem? bodyLocals lid with
        | none => rw [hBL] at h; cases h
        | some lTy =>
          rw [hBL] at h
          cases lTy with
          | enum ety =>
            cases hSL : Trusted.MirSemantics.getElem? locals lid with
            | none => rw [hSL] at h; cases h
            | some slot =>
              rw [hSL] at h
              dsimp at h
              cases hEA : !enumAdmitted ety with
              | true => rw [if_bool_true hEA] at h; cases h
              | false =>
                rw [if_bool_false hEA] at h
                cases hTR : ety.tagRepr with
                | zeroSized =>
                  rw [hTR] at h
                  cases slot with
                  | dead => cases h
                  | live ov =>
                    cases ov with
                    | none =>
                      dsimp at h
                      cases hD :
                          Trusted.MirSemantics.getElem? ety.discriminants 0 with
                      | none => rw [hD] at h; cases h
                      | some _ => rw [hD] at h; injection h with hE; cases hE; rfl
                    | some bv =>
                      cases bv with
                      | enumVal ety' v =>
                        dsimp at h
                        cases hC : EnumTy.beq ety ety' && Nat.beq v 0 with
                        | false => rw [if_bool_false hC] at h; cases h
                        | true =>
                          rw [if_bool_true hC] at h
                          cases hD :
                              Trusted.MirSemantics.getElem? ety.discriminants
                                0 with
                          | none => rw [hD] at h; cases h
                          | some _ =>
                            rw [hD] at h; injection h with hE; cases hE; rfl
                      | _ => cases h
                | scalar _ _ =>
                  rw [hTR] at h
                  cases slot with
                  | dead => cases h
                  | live ov =>
                    cases ov with
                    | none => cases h
                    | some bv =>
                      cases bv with
                      | enumVal ety' v =>
                        dsimp at h
                        cases hC :
                            EnumTy.beq ety ety' &&
                            Nat.blt v ety.discriminants.length with
                        | false => rw [if_bool_false hC] at h; cases h
                        | true =>
                          rw [if_bool_true hC] at h
                          cases hD :
                              Trusted.MirSemantics.getElem? ety.discriminants
                                v with
                          | none => rw [hD] at h; cases h
                          | some _ =>
                            rw [hD] at h; injection h with hE; cases hE; rfl
                      | _ => cases h
          | _ => cases h
  | ref _ _ | addressOf _ _ | aggregateTuple _ | unsupported => cases h

private theorem evalRvalueRef_embed_eq (bodyLocals : List MirTy)
    (locals : List LocalSlot) (epochs : List Nat) (nodes : List BorrowNode)
    (nextTag : Nat) (dstLoc : LocalId) (dstTy : MirTy) (rv : Rvalue)
    (hNoRef : rvalueHasRefOrDeref rv = false) :
    match evalRvalue bodyLocals locals dstTy rv with
    | .error k =>
      evalRvalueRef bodyLocals (locals.map embedLocalSlot) epochs nodes nextTag
        dstLoc false dstTy rv = .error k
    | .ok (v, locals') =>
      ∃ nodes' nextTag',
        evalRvalueRef bodyLocals (locals.map embedLocalSlot) epochs nodes
          nextTag dstLoc false dstTy rv =
          .ok (.base v, locals'.map embedLocalSlot, nodes', nextTag') := by
  cases rv with
  | use opnd =>
    dsimp [rvalueHasRefOrDeref] at hNoRef
    have hOp :=
      evalOperandToSlotRef_embed_eq bodyLocals locals epochs nodes opnd hNoRef
    dsimp [evalRvalueRef]
    have hEv :
        evalRvalue bodyLocals locals dstTy (.use opnd) =
          match evalOperandToSlot bodyLocals locals opnd with
          | .error k => .error k
          | .ok (srcTy, optVal, locals₁) =>
            if !(MirTy.beq srcTy dstTy) then .error .unsupported
            else match optVal with
                 | some v => .ok (v, locals₁)
                 | none => .error .undefined := rfl
    rw [hEv]
    cases hE : evalOperandToSlot bodyLocals locals opnd with
    | error k =>
      rw [hE] at hOp
      rw [hOp]
    | ok res =>
      rw [hE] at hOp
      cases res with
      | mk srcTy rest =>
        cases rest with
        | mk optVal locals₁ =>
          let ⟨hNoProj, srcLoc?, nodes₁, hRefE⟩ := hOp
          rw [hRefE]
          dsimp
          cases !MirTy.beq srcTy dstTy with
          | true => rfl
          | false =>
            dsimp
            rw [hNoProj]
            dsimp
            cases optVal with
            | none => rfl
            | some v => exact ⟨nodes₁, nextTag, rfl⟩
  | binaryOp op lhs rhs =>
    dsimp [rvalueHasRefOrDeref] at hNoRef
    let ⟨hNoL, hNoR⟩ := bool_or_false hNoRef
    have hEv :
        evalRvalue bodyLocals locals dstTy (.binaryOp op lhs rhs) =
          match evalPrimitiveOperand bodyLocals locals lhs with
          | .error k => .error k
          | .ok (lVal, locals₁) =>
            match evalPrimitiveOperand bodyLocals locals₁ rhs with
            | .error k => .error k
            | .ok (rVal, locals₂) =>
              match evalBinOp op lVal rVal with
              | .error k => .error k
              | .ok res => .ok (res, locals₂) := rfl
    rw [hEv]
    dsimp [evalRvalueRef]
    have hL :=
      evalPrimitiveOperandRef_embed_eq bodyLocals locals epochs nodes lhs hNoL
    cases hEL : evalPrimitiveOperand bodyLocals locals lhs with
    | error k => rw [hEL] at hL; rw [hL]
    | ok resL =>
      rw [hEL] at hL
      cases resL with
      | mk lVal locals₁ =>
        let ⟨nodes₁, hRefL⟩ := hL
        rw [hRefL]
        dsimp
        have hR :=
          evalPrimitiveOperandRef_embed_eq bodyLocals locals₁ epochs nodes₁ rhs
            hNoR
        cases hER : evalPrimitiveOperand bodyLocals locals₁ rhs with
        | error k => rw [hER] at hR; rw [hR]
        | ok resR =>
          rw [hER] at hR
          cases resR with
          | mk rVal locals₂ =>
            let ⟨nodes₂, hRefR⟩ := hR
            rw [hRefR]
            dsimp
            cases evalBinOp op lVal rVal with
            | error _ => rfl
            | ok res => exact ⟨nodes₂, nextTag, rfl⟩
  | unaryOp op opnd =>
    dsimp [rvalueHasRefOrDeref] at hNoRef
    have hEv :
        evalRvalue bodyLocals locals dstTy (.unaryOp op opnd) =
          match evalPrimitiveOperand bodyLocals locals opnd with
          | .error k => .error k
          | .ok (v, locals₁) =>
            match evalUnOp op v with
            | .error k => .error k
            | .ok res => .ok (res, locals₁) := rfl
    rw [hEv]
    dsimp [evalRvalueRef]
    have hO :=
      evalPrimitiveOperandRef_embed_eq bodyLocals locals epochs nodes opnd
        hNoRef
    cases hEO : evalPrimitiveOperand bodyLocals locals opnd with
    | error k => rw [hEO] at hO; rw [hO]
    | ok resO =>
      rw [hEO] at hO
      cases resO with
      | mk v locals₁ =>
        let ⟨nodes₁, hRefO⟩ := hO
        rw [hRefO]
        dsimp
        cases evalUnOp op v with
        | error _ => rfl
        | ok res => exact ⟨nodes₁, nextTag, rfl⟩
  | discriminant place =>
    dsimp [rvalueHasRefOrDeref] at hNoRef
    cases hPr : place.projection with
    | cons pe rest =>
      have hEv :
          evalRvalue bodyLocals locals dstTy (.discriminant place) =
            .error .unsupported := by
        cases place with
        | mk _ proj => dsimp at hPr; subst hPr; rfl
      rw [hEv]
      dsimp [evalRvalueRef]
      rw [hPr]
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          exact False.elim (placeHasDeref_false_not_deref hNoRef hPr)
    | nil =>
      cases place with
      | mk lid proj =>
        dsimp at hPr; subst hPr
        have hEv :
            evalRvalue bodyLocals locals dstTy (.discriminant ⟨lid, []⟩) =
              match Trusted.MirSemantics.getElem? bodyLocals lid,
                  Trusted.MirSemantics.getElem? locals lid with
              | some (.enum ety), some slot =>
                if !enumAdmitted ety then .error .unsupported
                else
                  match ety.tagRepr, slot with
                  | _, .dead => .error .undefined
                  | .zeroSized, .live none =>
                    match Trusted.MirSemantics.getElem? ety.discriminants 0 with
                    | some disc =>
                      .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                        truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩,
                        locals)
                    | none => .error .unsupported
                  | .zeroSized, .live (some (.enumVal ety' v)) =>
                    if EnumTy.beq ety ety' && Nat.beq v 0 then
                      match Trusted.MirSemantics.getElem? ety.discriminants 0
                      with
                      | some disc =>
                        .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                          truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩,
                          locals)
                      | none => .error .unsupported
                    else .error .unsupported
                  | .zeroSized, .live (some _) => .error .unsupported
                  | .scalar _ _, .live none => .error .undefined
                  | .scalar _ _, .live (some (.enumVal ety' v)) =>
                    if EnumTy.beq ety ety' &&
                        Nat.blt v ety.discriminants.length then
                      match Trusted.MirSemantics.getElem? ety.discriminants v
                      with
                      | some disc =>
                        .ok (.scalar ⟨ety.discrWidth, ety.discrSigned,
                          truncateBits ety.discrWidth (BitVec.ofNat 128 disc)⟩,
                          locals)
                      | none => .error .unsupported
                    else .error .unsupported
                  | .scalar _ _, .live (some _) => .error .unsupported
              | _, _ => .error .unsupported := rfl
        rw [hEv]
        dsimp [evalRvalueRef, decodeEnumDiscriminantSlot]
        rw [getElem?_map]
        cases Trusted.MirSemantics.getElem? bodyLocals lid with
        | none => rfl
        | some pTy =>
          cases pTy with
          | enum ety =>
            cases Trusted.MirSemantics.getElem? locals lid with
            | none => rfl
            | some slot =>
              dsimp
              cases !enumAdmitted ety with
              | true => rfl
              | false =>
                dsimp
                cases ety.tagRepr with
                | zeroSized =>
                  cases slot with
                  | dead => rfl
                  | live optV =>
                    cases optV with
                    | none =>
                      dsimp [embedLocalSlot]
                      cases Trusted.MirSemantics.getElem? ety.discriminants 0
                      with
                      | none => rfl
                      | some _ => exact ⟨_, nextTag, rfl⟩
                    | some bv =>
                      dsimp [embedLocalSlot]
                      cases bv with
                      | enumVal ety' v =>
                        dsimp
                        cases EnumTy.beq ety ety' && Nat.beq v 0 with
                        | false => rfl
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem?
                              ety.discriminants 0 with
                          | none => rfl
                          | some _ => exact ⟨_, nextTag, rfl⟩
                      | scalar _ | bool _ | unit | ptr _ | tuple _
                      | bytes _ => rfl
                | scalar _ _ =>
                  cases slot with
                  | dead => rfl
                  | live optV =>
                    cases optV with
                    | none => rfl
                    | some bv =>
                      dsimp [embedLocalSlot]
                      cases bv with
                      | enumVal ety' v =>
                        dsimp
                        cases EnumTy.beq ety ety' &&
                            Nat.blt v ety.discriminants.length with
                        | false => rfl
                        | true =>
                          dsimp
                          cases Trusted.MirSemantics.getElem?
                              ety.discriminants v with
                          | none => rfl
                          | some _ => exact ⟨_, nextTag, rfl⟩
                      | scalar _ | bool _ | unit | ptr _ | tuple _
                      | bytes _ => rfl
          | bool | int _ _ | unit | never | tuple _ | ref _ _ | rawPtr _ _
          | unsupported => rfl
  | ref _ _ | addressOf _ _ => cases hNoRef
  | aggregateTuple _ | unsupported => rfl

private theorem writeTargetSlotRef_embed_eq (bodyLocals : List MirTy)
    (locals : List LocalSlot) (epochs : List Nat) (nodes : List BorrowNode)
    (dstLoc : LocalId) (dstTy : MirTy) (val : Val) :
    match writePlace locals dstLoc dstTy val with
    | .error k =>
      writeTargetSlotRef bodyLocals (locals.map embedLocalSlot) epochs nodes
        dstLoc none dstTy (.base val) = .error k
    | .ok locals' =>
      ∃ nodes',
        writeTargetSlotRef bodyLocals (locals.map embedLocalSlot) epochs nodes
          dstLoc none dstTy (.base val) =
          .ok (locals'.map embedLocalSlot, nodes') := by
  unfold writePlace writeTargetSlotRef validateRuntimeValRef
  rw [checkValRef_base_eq, getElem?_map]
  cases hCV : !checkVal val dstTy with
  | true => rfl
  | false =>
    dsimp
    cases Trusted.MirSemantics.getElem? locals dstLoc with
    | none => rfl
    | some slot =>
      cases slot with
      | dead => rfl
      | live optV =>
        have hSlot :
            embedLocalSlot (.live optV) = .live (optV.map ValRef.base) := by
          cases optV <;> rfl
        dsimp [Option.map]
        rw [hSlot]
        dsimp
        have hSetMap :=
          setElem?_map_eq embedLocalSlot locals dstLoc (.live (some val))
        dsimp [embedLocalSlot] at hSetMap
        rw [hSetMap]
        cases setElem? locals dstLoc (.live (some val)) with
        | none => rfl
        | some locals' =>
          exact ⟨performTbRootAccess epochs dstLoc dstTy .write nodes, rfl⟩

private theorem writePlace_length {locals locals' : List LocalSlot}
    {dstLoc : LocalId} {dstTy : MirTy} {val : Val}
    (h : writePlace locals dstLoc dstTy val = .ok locals') :
    locals'.length = locals.length := by
  unfold writePlace at h
  cases hCV : !checkVal val dstTy with
  | true => rw [if_bool_true hCV] at h; cases h
  | false =>
    rw [if_bool_false hCV] at h
    cases hG : Trusted.MirSemantics.getElem? locals dstLoc with
    | none => rw [hG] at h; cases h
    | some sl =>
      rw [hG] at h
      cases sl with
      | dead => cases h
      | live _ =>
        dsimp at h
        cases hSet : setElem? locals dstLoc (.live (some val)) with
        | none => rw [hSet] at h; cases h
        | some ls' =>
          rw [hSet] at h
          injection h with hEq; subst hEq
          exact setElem?_length hSet

private theorem evalStatementRef_project_eq (body : Body)
    (fRef : FrameStateRef) (f : FrameState) (mem : CallerMemory)
    (stmt : StatementKind)
    (hProj : projectFrameRef fRef = some f)
    (hNoRef : stmtHasRefOrDeref stmt = false) :
    projectStepResultRef (evalStatementRef body fRef mem stmt) =
      some (evalStatement body f mem stmt) := by
  let ⟨hDef, hBlk, hStIdx, hLocs, hEpLen⟩ := projectFrameRef_elim hProj
  have hLenBeq : Nat.beq fRef.epochs.length fRef.locals.length = true := by
    rw [hLocs, map_length_eq, hEpLen, nat_beq_refl]
  unfold evalStatementRef
  rw [hLenBeq]
  dsimp
  cases stmt with
  | nop =>
    dsimp [evalStatement, projectStepResultRef, projectStateRef, listMapOption]
    let fRef' : FrameStateRef := { fRef with stmtIdx := fRef.stmtIdx + 1 }
    rw [projectFrameRef_of_map_embed (fRef := fRef') hLocs hEpLen]
    dsimp [fRef']
    rw [hDef, hBlk, hStIdx]
  | unsupported => rfl
  | storageLive lid =>
    dsimp [evalStatement]
    cases Trusted.MirSemantics.getElem? body.locals lid with
    | none => rfl
    | some localTy =>
      dsimp
      rw [hLocs, liveUninitSlotRef_eq_embed localTy, setElem?_map_eq]
      cases hSetL : setElem? f.locals lid (liveUninitSlot localTy) with
      | none => rfl
      | some locals' =>
        have hLt : lid < fRef.epochs.length := by
          rw [hEpLen]
          exact setElem?_some_lt hSetL
        let ⟨epochs', hSetE⟩ :=
          setElem?_some_of_lt fRef.epochs lid fRef.nextEpoch hLt
        rw [hSetE]
        dsimp [projectStepResultRef, projectStateRef, listMapOption]
        have hEpLen' : epochs'.length = locals'.length := by
          rw [setElem?_length hSetE, hEpLen, setElem?_length hSetL]
        let fRef' : FrameStateRef := {
          fRef with
          stmtIdx := fRef.stmtIdx + 1
          locals := locals'.map embedLocalSlot
          epochs := epochs'
          nextEpoch := fRef.nextEpoch + 1
        }
        rw [projectFrameRef_of_map_embed (fRef := fRef') rfl hEpLen']
        dsimp [fRef']
        rw [hDef, hBlk, hStIdx]
  | storageDead lid =>
    dsimp [evalStatement]
    cases Nat.beq lid 0 with
    | true => rfl
    | false =>
      dsimp
      have hSetMap := setElem?_map_eq embedLocalSlot f.locals lid .dead
      dsimp [embedLocalSlot] at hSetMap
      rw [hLocs, hSetMap]
      cases hSetL : setElem? f.locals lid .dead with
      | none => rfl
      | some locals' =>
        dsimp [projectStepResultRef, projectStateRef, listMapOption]
        have hEpLen' : fRef.epochs.length = locals'.length := by
          rw [hEpLen, setElem?_length hSetL]
        let fRef' : FrameStateRef := {
          fRef with
          stmtIdx := fRef.stmtIdx + 1
          locals := locals'.map embedLocalSlot
        }
        rw [projectFrameRef_of_map_embed (fRef := fRef') rfl hEpLen']
        dsimp [fRef']
        rw [hDef, hBlk, hStIdx]
  | assign dst rvalue =>
    dsimp [stmtHasRefOrDeref] at hNoRef
    let ⟨hNoDst, hNoRv⟩ := bool_or_false hNoRef
    cases hPr : dst.projection with
    | cons pe rest =>
      have hEv :
          evalStatement body f mem (.assign dst rvalue) =
            .fault .unsupported := by
        cases dst with
        | mk _ proj => dsimp at hPr; subst hPr; rfl
      rw [hEv]
      dsimp
      rw [hPr]
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          exact False.elim (placeHasDeref_false_not_deref hNoDst hPr)
    | nil =>
      have hEv :
          evalStatement body f mem (.assign dst rvalue) =
            match Trusted.MirSemantics.getElem? body.locals dst.localId with
            | none => .fault .unsupported
            | some dstTy =>
              match evalRvalue body.locals f.locals dstTy rvalue with
              | .error k => .fault k
              | .ok (val, locals₁) =>
                match writePlace locals₁ dst.localId dstTy val with
                | .error k => .fault k
                | .ok locals₂ =>
                  .step {
                    frames := [{
                      f with
                      stmtIdx := f.stmtIdx + 1
                      locals := locals₂
                    }]
                    callerMem := mem
                  } := by
        cases dst with
        | mk _ proj => dsimp at hPr; subst hPr; rfl
      rw [hEv]
      dsimp
      rw [hPr]
      dsimp
      cases Trusted.MirSemantics.getElem? body.locals dst.localId with
      | none => rfl
      | some dstTy =>
        dsimp
        rw [hLocs]
        have hRv :=
          evalRvalueRef_embed_eq body.locals f.locals fRef.epochs
            fRef.borrowNodes fRef.nextTag dst.localId dstTy rvalue hNoRv
        cases hERv : evalRvalue body.locals f.locals dstTy rvalue with
        | error k =>
          rw [hERv] at hRv
          rw [hRv]
          rfl
        | ok rvRes =>
          rw [hERv] at hRv
          cases rvRes with
          | mk val locals₁ =>
            let ⟨nodes₁, nextTag₁, hRefRv⟩ := hRv
            rw [hRefRv]
            dsimp
            have hWr :=
              writeTargetSlotRef_embed_eq body.locals locals₁ fRef.epochs
                nodes₁ dst.localId dstTy val
            cases hEWr : writePlace locals₁ dst.localId dstTy val with
            | error k =>
              rw [hEWr] at hWr
              rw [hWr]
              rfl
            | ok locals₂ =>
              rw [hEWr] at hWr
              let ⟨nodes₂, hRefWr⟩ := hWr
              rw [hRefWr]
              dsimp [projectStepResultRef, projectStateRef, listMapOption]
              have hEpLen2 : fRef.epochs.length = locals₂.length := by
                rw [hEpLen, ← evalRvalue_length hERv, ← writePlace_length hEWr]
              let fRef' : FrameStateRef := {
                fRef with
                stmtIdx := fRef.stmtIdx + 1
                locals := locals₂.map embedLocalSlot
                borrowNodes := nodes₂
                nextTag := nextTag₁
              }
              rw [projectFrameRef_of_map_embed (fRef := fRef') rfl hEpLen2]
              dsimp [fRef']
              rw [hDef, hBlk, hStIdx]

private theorem evalTerminatorRef_project_eq (body : Body) (bb : BasicBlock)
    (fRef : FrameStateRef) (f : FrameState) (mem : CallerMemory)
    (hProj : projectFrameRef fRef = some f)
    (hNoDeref : terminatorHasDeref bb.terminator = false) :
    projectStepResultRef (evalTerminatorRef body bb fRef mem) =
      some (evalTerminator body bb f mem) := by
  let ⟨hDef, hBlk, hStIdx, hLocs, hEpLen⟩ := projectFrameRef_elim hProj
  have hLenBeq : Nat.beq fRef.epochs.length fRef.locals.length = true := by
    rw [hLocs, map_length_eq, hEpLen, nat_beq_refl]
  unfold evalTerminatorRef evalTerminator
  rw [hLenBeq]
  dsimp
  cases hTerm : bb.terminator with
  | goto target =>
    dsimp [jumpToBlockRef, jumpToBlock, projectStepResultRef, projectStateRef,
      listMapOption]
    let fRef' : FrameStateRef := {
      fRef with
      blockIdx := target
      stmtIdx := 0
    }
    rw [projectFrameRef_of_map_embed (fRef := fRef') hLocs hEpLen]
    dsimp [fRef']
    rw [hDef]
  | return_ =>
    dsimp
    cases bb.cleanup with
    | true => rfl
    | false =>
      dsimp
      rw [hLocs, getElem?_map]
      cases Trusted.MirSemantics.getElem? f.locals 0 with
      | none => rfl
      | some sl =>
        cases sl with
        | dead => rfl
        | live optV =>
          cases optV with
          | none => rfl
          | some _ => rfl
  | unreachable | unwindResume | assert _ _ _ _ _ | call _ _ _ _ _
  | unsupported => rfl
  | switchInt discr targets =>
    rw [hTerm] at hNoDeref
    dsimp [terminatorHasDeref] at hNoDeref
    dsimp
    rw [hLocs]
    have hD :=
      evalPrimitiveOperandRef_embed_eq body.locals f.locals fRef.epochs
        fRef.borrowNodes discr hNoDeref
    cases hED : evalPrimitiveOperand body.locals f.locals discr with
    | error k =>
      rw [hED] at hD
      rw [hD]
      rfl
    | ok resD =>
      rw [hED] at hD
      cases resD with
      | mk discrVal locals₁ =>
        let ⟨nodes₁, hRefD⟩ := hD
        rw [hRefD]
        dsimp
        have hEpLen1 : fRef.epochs.length = locals₁.length := by
          rw [hEpLen, ← evalPrimitiveOperand_length hED]
        cases discrVal with
        | scalar sv =>
          dsimp
          cases evalSwitchBranches sv.width sv.bits targets.otherwise
              targets.branches with
          | error _ => rfl
          | ok target =>
            dsimp [jumpToBlockRef, jumpToBlock, projectStepResultRef,
              projectStateRef, listMapOption]
            let fRef' : FrameStateRef := {
              fRef with
              blockIdx := target
              stmtIdx := 0
              locals := locals₁.map embedLocalSlot
              borrowNodes := nodes₁
            }
            rw [projectFrameRef_of_map_embed (fRef := fRef') rfl hEpLen1]
            dsimp [fRef']
            rw [hDef]
        | bool b =>
          dsimp
          cases evalBoolSwitchBranches b targets.otherwise
              targets.branches with
          | error _ => rfl
          | ok target =>
            dsimp [jumpToBlockRef, jumpToBlock, projectStepResultRef,
              projectStateRef, listMapOption]
            let fRef' : FrameStateRef := {
              fRef with
              blockIdx := target
              stmtIdx := 0
              locals := locals₁.map embedLocalSlot
              borrowNodes := nodes₁
            }
            rw [projectFrameRef_of_map_embed (fRef := fRef') rfl hEpLen1]
            dsimp [fRef']
            rw [hDef]
        | unit | enumVal _ _ | ptr _ | tuple _ | bytes _ => rfl

private theorem evalStepRef_project_eq (p : Program) (c : Choice)
    (sRef : ExecStateRef) (s : State)
    (hProj : projectStateRef sRef = some s)
    (hFree : stepIsRefFree p s = true) :
    projectStepResultRef (evalStepRef p c sRef) =
      some (evalStep p c s) := by
  unfold projectStateRef at hProj
  cases hFrs : sRef.frames with
  | nil =>
    rw [hFrs] at hProj
    dsimp [listMapOption] at hProj
    injection hProj with hS
    subst hS
    unfold evalStepRef evalStep
    rw [hFrs]
    rfl
  | cons fRef restRef =>
    cases restRef with
    | cons fRef2 restRef2 =>
      rw [hFrs] at hProj
      dsimp [listMapOption] at hProj
      cases hPf1 : projectFrameRef fRef with
      | none => rw [hPf1] at hProj; cases hProj
      | some f1 =>
        rw [hPf1] at hProj
        cases hPf2 : projectFrameRef fRef2 with
        | none => rw [hPf2] at hProj; cases hProj
        | some f2 =>
          rw [hPf2] at hProj
          cases hPrR : listMapOption projectFrameRef restRef2 with
          | none => rw [hPrR] at hProj; cases hProj
          | some frsR =>
            rw [hPrR] at hProj
            injection hProj with hS
            subst hS
            unfold evalStepRef evalStep
            rw [hFrs]
            rfl
    | nil =>
      rw [hFrs] at hProj
      dsimp [listMapOption] at hProj
      cases hPf : projectFrameRef fRef with
      | none => rw [hPf] at hProj; cases hProj
      | some f =>
        rw [hPf] at hProj
        injection hProj with hS
        subst hS
        let ⟨hDef, hBlk, hStIdx, hLocs, hEpLen⟩ := projectFrameRef_elim hPf
        have hLenBeq : Nat.beq fRef.epochs.length fRef.locals.length = true := by
          rw [hLocs, map_length_eq, hEpLen, nat_beq_refl]
        unfold evalStepRef evalStep
        rw [hFrs]
        dsimp
        rw [hLenBeq, hDef, hBlk, hStIdx]
        dsimp
        unfold stepIsRefFree at hFree
        dsimp at hFree
        cases hBody : Trusted.MirSemantics.getElem? p.bodies f.defId with
        | none => rfl
        | some body =>
          rw [hBody] at hFree
          let ⟨_, hNoSynNeg⟩ := bool_and_true hFree
          have hNoSyn : bodyHasRefPtrSyntax body = false :=
            bool_not_true hNoSynNeg
          dsimp
          cases hBb :
              Trusted.MirSemantics.getElem? body.basicBlocks f.blockIdx with
          | none => rfl
          | some bb =>
            have hBbFalse :=
              list_any_false_getElem?
                (p := fun b : BasicBlock =>
                  b.statements.any stmtHasRefOrDeref ||
                    terminatorHasDeref b.terminator)
                hNoSyn hBb
            let ⟨hNoStmts, hNoTerm⟩ := bool_or_false hBbFalse
            dsimp
            cases hSt :
                Trusted.MirSemantics.getElem? bb.statements f.stmtIdx with
            | some stmt =>
              have hNoStmt := list_any_false_getElem? hNoStmts hSt
              exact evalStatementRef_project_eq body fRef f sRef.callerMem
                stmt hPf hNoStmt
            | none =>
              dsimp
              cases Nat.beq f.stmtIdx bb.statements.length with
              | false => rfl
              | true =>
                dsimp
                exact evalTerminatorRef_project_eq body bb fRef f
                  sRef.callerMem hPf hNoTerm

/-! ### Lifting Conservative Extension Across Fuel, Reachability, & Crate VCs -/

private theorem isSupportedRefPtrTy_of_scalar (ty : MirTy)
    (h : isSupportedScalarOrUnitTy ty = true) :
    isSupportedRefPtrTy ty = true := by
  cases ty with
  | bool | int _ _ | unit | never => rfl
  | enum ety => exact h
  | tuple _ | ref _ _ | rawPtr _ _ | unsupported => cases h

private theorem list_all_take {α : Type} {p : α → Bool} {xs : List α} (k : Nat)
    (h : xs.all p = true) : (xs.take k).all p = true := by
  induction xs generalizing k with
  | nil =>
    cases k <;> rfl
  | cons a rest ih =>
    let ⟨ha, hRest⟩ := bool_and_true h
    cases k with
    | zero => rfl
    | succ m =>
      dsimp [List.take, List.all]
      exact bool_and_intro ha (ih m hRest)

private theorem bodyLocalsAdmittedRef_of_scalar {body : Body}
    (h : body.locals.all isSupportedScalarOrUnitTy = true) :
    bodyLocalsAdmittedRef body = true := by
  unfold bodyLocalsAdmittedRef
  refine bool_and_intro (list_all_take (body.argumentCount + 1) h) ?_
  apply list_all_of_forall_getElem?
  intro i ty hGet
  exact isSupportedRefPtrTy_of_scalar ty (list_all_getElem? h hGet)

private theorem bodyLocalsAdmittedRef_eq_of_isRefFree {body : Body}
    (hFree : isRefFreeBody body = true) :
    bodyLocalsAdmittedRef body =
      body.locals.all isSupportedScalarOrUnitTy := by
  let ⟨hSc, _⟩ := bool_and_true hFree
  rw [hSc, bodyLocalsAdmittedRef_of_scalar hSc]

private theorem initLocalsRefLoop_eq_map_embed (body : Body) (args : List Val)
    (idx : Nat) (tys : List MirTy) :
    initLocalsRefLoop body args idx tys =
      (initLocalsLoop body args idx tys).map embedLocalSlot := by
  induction tys generalizing idx with
  | nil => rfl
  | cons ty rest ih =>
    dsimp [initLocalsRefLoop, initLocalsLoop, List.map]
    rw [ih (idx + 1)]
    cases Nat.beq idx 0 with
    | true =>
      dsimp
      rw [liveUninitSlotRef_eq_embed ty]
    | false =>
      dsimp
      cases Nat.ble idx body.argumentCount with
      | true =>
        dsimp
        cases Trusted.MirSemantics.getElem? args (idx - 1) <;> rfl
      | false =>
        dsimp
        cases hasStorageAnnotation body idx with
        | true => rfl
        | false =>
          dsimp
          rw [liveUninitSlotRef_eq_embed ty]

private theorem initLocalsLoop_map_const_one (body : Body) (args : List Val)
    (idx : Nat) (tys : List MirTy) :
    (initLocalsLoop body args idx tys).map (fun _ => (1 : Nat)) =
      tys.map (fun _ => (1 : Nat)) := by
  induction tys generalizing idx with
  | nil => rfl
  | cons _ rest ih =>
    dsimp [initLocalsLoop, List.map]
    rw [ih (idx + 1)]

private theorem initStateRef_eq_map_embed {p : Program} (q : Query)
    (hFree : isRefFreeProgram p = true) :
    initStateRef p q = (initState p q).map embedState := by
  unfold initStateRef initState
  cases !Nat.beq p.pointerWidthBits 64 || !Nat.beq p.mirProfileVersion 1 with
  | true => rfl
  | false =>
    dsimp
    cases !q.callerMem.allocations.isEmpty with
    | true => rfl
    | false =>
      dsimp
      cases hBody : Trusted.MirSemantics.getElem? p.bodies p.entryDefId with
      | none => rfl
      | some body =>
        have hBodyFree : isRefFreeBody body = true :=
          list_all_getElem? hFree hBody
        dsimp
        rw [bodyLocalsAdmittedRef_eq_of_isRefFree hBodyFree]
        cases body.basicBlocks.isEmpty with
        | true => rfl
        | false =>
          dsimp
          cases !Nat.blt body.argumentCount body.locals.length with
          | true => rfl
          | false =>
            dsimp
            cases !storageAnnotationsInBounds body with
            | true => rfl
            | false =>
              dsimp
              cases !body.locals.all isSupportedScalarOrUnitTy with
              | true => rfl
              | false =>
                dsimp
                cases !checkArgsMatch q.args
                    ((body.locals.drop 1).take body.argumentCount) with
                | true => rfl
                | false =>
                  dsimp [Except.map, embedState, embedFrame, List.map]
                  rw [initLocalsRefLoop_eq_map_embed,
                      initLocalsLoop_map_const_one]

private theorem stepIsRefFree_of_program {p : Program}
    (hFree : isRefFreeProgram p = true) (s : State) :
    stepIsRefFree p s = true := by
  unfold stepIsRefFree
  cases s.frames with
  | nil => rfl
  | cons f rest =>
    cases rest with
    | cons _ _ => rfl
    | nil =>
      dsimp
      cases hB : Trusted.MirSemantics.getElem? p.bodies f.defId with
      | none => rfl
      | some body =>
        exact list_all_getElem? (p := isRefFreeBody) hFree hB

private theorem evalRefFuel_project_eq {p : Program}
    (hFree : isRefFreeProgram p = true) (n : Nat)
    {sRef : ExecStateRef} {s : State}
    (hProj : projectStateRef sRef = some s) :
    projectStepResultRef (evalRefFuel p n sRef) =
      some (evalMirFuel p n s) := by
  induction n generalizing sRef s with
  | zero =>
    dsimp [evalRefFuel, evalMirFuel, projectStepResultRef]
    rw [hProj]
  | succ k ih =>
    dsimp [evalRefFuel, evalMirFuel]
    have h1 :=
      evalStepRef_project_eq p 0 sRef s hProj (stepIsRefFree_of_program hFree s)
    cases hEvRef : evalStepRef p 0 sRef with
    | step sRef' =>
      rw [hEvRef] at h1
      dsimp [projectStepResultRef] at h1
      cases hPr' : projectStateRef sRef' with
      | none => rw [hPr'] at h1; cases h1
      | some s' =>
        rw [hPr'] at h1
        injection h1 with hEvMir
        rw [← hEvMir]
        exact ih hPr'
    | done out =>
      rw [hEvRef] at h1
      injection h1 with hEvMir
      rw [← hEvMir]
      rfl
    | fault fk =>
      rw [hEvRef] at h1
      injection h1 with hEvMir
      rw [← hEvMir]
      rfl

private theorem conservative_ext_query {p : Program}
    (hFree : isRefFreeProgram p = true) (q : Query) :
    (WellFormedRef p q ↔ WellFormed p q) ∧
    (∀ out : TerminalOut, BehaviorRef p q out ↔ Behavior p q out) ∧
    (∀ k : FaultKind,
      ReachesResultRef p q (.fault k) ↔ ReachesResult p q (.fault k)) ∧
    (DivergesRef p q ↔ Diverges p q) := by
  have hInit := initStateRef_eq_map_embed q hFree
  cases hIM : initState p q with
  | error kErr =>
    rw [hIM] at hInit
    dsimp [Except.map] at hInit
    have hBeh : ∀ out, BehaviorRef p q out ↔ Behavior p q out := by
      intro out
      unfold BehaviorRef ReachesResultRef Behavior ReachesResult
      rw [hInit, hIM]
      dsimp
      constructor
      · intro h; cases h
      · intro h; cases h
    have hFault : ∀ k,
        ReachesResultRef p q (.fault k) ↔ ReachesResult p q (.fault k) := by
      intro k
      unfold ReachesResultRef ReachesResult
      rw [hInit, hIM]
      dsimp
      constructor
      · intro h; injection h with hK; subst hK; rfl
      · intro h; injection h with hK; subst hK; rfl
    have hWf : WellFormedRef p q ↔ WellFormed p q := by
      unfold WellFormedRef WellFormed
      constructor
      · intro ⟨⟨_, hOk, _⟩, _⟩; rw [hInit] at hOk; cases hOk
      · intro ⟨⟨_, hOk, _⟩, _⟩; rw [hIM] at hOk; cases hOk
    have hDiv : DivergesRef p q ↔ Diverges p q := by
      unfold DivergesRef Diverges
      constructor
      · intro ⟨_, hOk, _⟩; rw [hInit] at hOk; cases hOk
      · intro ⟨_, hOk, _⟩; rw [hIM] at hOk; cases hOk
    exact ⟨hWf, hBeh, hFault, hDiv⟩
  | ok s₀ =>
    rw [hIM] at hInit
    dsimp [Except.map] at hInit
    have hProj0 : projectStateRef (embedState s₀) = some s₀ :=
      projectStateRef_embed s₀
    have hBeh : ∀ out, BehaviorRef p q out ↔ Behavior p q out := by
      intro out
      unfold BehaviorRef ReachesResultRef Behavior ReachesResult
      rw [hInit, hIM]
      constructor
      · intro ⟨sRef, hR, hS⟩
        let ⟨n, hn⟩ := evalRefFuel_terminal_of_reachesRef hR hS
        have hPr := evalRefFuel_project_eq hFree (n + 1) hProj0
        rw [hn] at hPr
        injection hPr with hMir
        exact reaches_and_step_of_evalMirFuel_done hMir.symm
      · intro ⟨s, hR, hS⟩
        let ⟨n, hn⟩ := evalMirFuel_terminal_of_reaches hR hS
        have hPr := evalRefFuel_project_eq hFree (n + 1) hProj0
        rw [hn] at hPr
        cases hRefN : evalRefFuel p (n + 1) (embedState s₀) with
        | step s' =>
          rw [hRefN] at hPr
          dsimp [projectStepResultRef] at hPr
          cases hPs : projectStateRef s' with
          | none => rw [hPs] at hPr; cases hPr
          | some _ => rw [hPs] at hPr; cases hPr
        | fault _ =>
          rw [hRefN] at hPr; cases hPr
        | done oRef =>
          rw [hRefN] at hPr
          injection hPr with hStepEq
          injection hStepEq with hEq
          subst hEq
          exact reachesRef_and_stepRef_of_evalRefFuel_done hRefN
    have hFault : ∀ k,
        ReachesResultRef p q (.fault k) ↔ ReachesResult p q (.fault k) := by
      intro fk
      unfold ReachesResultRef ReachesResult
      rw [hInit, hIM]
      constructor
      · intro ⟨sRef, hR, hS⟩
        let ⟨n, hn⟩ := evalRefFuel_terminal_of_reachesRef hR hS
        have hPr := evalRefFuel_project_eq hFree (n + 1) hProj0
        rw [hn] at hPr
        injection hPr with hMir
        exact reaches_and_step_of_evalMirFuel_fault hMir.symm
      · intro ⟨s, hR, hS⟩
        let ⟨n, hn⟩ := evalMirFuel_terminal_of_reaches hR hS
        have hPr := evalRefFuel_project_eq hFree (n + 1) hProj0
        rw [hn] at hPr
        cases hRefN : evalRefFuel p (n + 1) (embedState s₀) with
        | step s' =>
          rw [hRefN] at hPr
          dsimp [projectStepResultRef] at hPr
          cases hPs : projectStateRef s' with
          | none => rw [hPs] at hPr; cases hPr
          | some _ => rw [hPs] at hPr; cases hPr
        | done _ =>
          rw [hRefN] at hPr; cases hPr
        | fault kRef =>
          rw [hRefN] at hPr
          injection hPr with hStepEq
          injection hStepEq with hEq
          subst hEq
          exact reachesRef_and_stepRef_of_evalRefFuel_fault hRefN
    have hWf : WellFormedRef p q ↔ WellFormed p q := by
      unfold WellFormedRef WellFormed
      constructor
      · intro ⟨_, hNoF⟩
        refine ⟨⟨s₀, hIM, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩
        intro k hk
        exact hNoF k ((hFault k).mpr hk)
      · intro ⟨_, hNoF⟩
        refine ⟨⟨embedState s₀, hInit, fun _ _ => ⟨0, rfl⟩⟩, ?_⟩
        intro k hk
        exact hNoF k ((hFault k).mp hk)
    have hDiv : DivergesRef p q ↔ Diverges p q := by
      rw [diverges_iff_forall_evalMirFuel]
      unfold DivergesRef
      constructor
      · intro ⟨sRef0, hOkRef, hAllRef⟩
        rw [hInit] at hOkRef
        injection hOkRef with hEq; subst hEq
        refine ⟨s₀, hIM, ?_⟩
        intro n
        let ⟨sRef', hn⟩ := hAllRef n
        have hPr := evalRefFuel_project_eq hFree n hProj0
        rw [hn] at hPr
        dsimp [projectStepResultRef] at hPr
        cases hPs : projectStateRef sRef' with
        | none => rw [hPs] at hPr; cases hPr
        | some s' =>
          rw [hPs] at hPr
          injection hPr with hMir
          exact ⟨s', hMir.symm⟩
      · intro ⟨s0', hOkMir, hAllMir⟩
        rw [hIM] at hOkMir
        injection hOkMir with hEq; subst hEq
        refine ⟨embedState s₀, hInit, ?_⟩
        intro n
        let ⟨s', hn⟩ := hAllMir n
        have hPr := evalRefFuel_project_eq hFree n hProj0
        rw [hn] at hPr
        cases hRefN : evalRefFuel p n (embedState s₀) with
        | step sRef' => exact ⟨sRef', rfl⟩
        | done _ => rw [hRefN] at hPr; cases hPr
        | fault _ => rw [hRefN] at hPr; cases hPr
    exact ⟨hWf, hBeh, hFault, hDiv⟩

private theorem refPtr_conservative_extension_exact_slice1
    (p : Program) :
    (∀ s : State, projectStateRef (embedState s) = some s) ∧
    (∀ (c : Choice) (sRef : ExecStateRef) (s : State),
      projectStateRef sRef = some s →
      stepIsRefFree p s = true →
      projectStepResultRef (evalStepRef p c sRef) =
        some (evalStep p c s)) ∧
    (isRefFreeProgram p = true →
      (∀ q : Query,
        (WellFormedRef p q ↔ WellFormed p q) ∧
        (∀ out : TerminalOut, BehaviorRef p q out ↔ Behavior p q out) ∧
        (∀ k : FaultKind,
          ReachesResultRef p q (.fault k) ↔ ReachesResult p q (.fault k)) ∧
        (DivergesRef p q ↔ Diverges p q)) ∧
      (∀ (q : Query) (post : TerminalOut → Prop),
        SatisfiesPostRef p q post ↔ SatisfiesPost p q post) ∧
      (∀ (defId : DefId) (body : Body) (safetyPre : List Val → Prop),
        BodyVerifiedRef p defId body safetyPre ↔
          BodyVerified p defId body safetyPre) ∧
      (∀ specs : Specs,
        (CrateTheoremRef ⟨p, specs⟩ ↔ CrateTheorem ⟨p, specs⟩) ∧
        (UnitTheoremRef ⟨p, specs⟩ ↔ UnitTheorem ⟨p, specs⟩))) := by
  refine ⟨projectStateRef_embed, evalStepRef_project_eq p, ?_⟩
  intro hFree
  have hQ := conservative_ext_query hFree
  have hPost : ∀ (q : Query) (post : TerminalOut → Prop),
      SatisfiesPostRef p q post ↔ SatisfiesPost p q post := by
    intro q post
    let ⟨hWf, hBeh, _, _⟩ := hQ q
    unfold SatisfiesPostRef SatisfiesPost
    constructor
    · intro ⟨hw, hp⟩
      exact ⟨hWf.mp hw, fun out hb => hp out ((hBeh out).mpr hb)⟩
    · intro ⟨hw, hp⟩
      exact ⟨hWf.mpr hw, fun out hb => hp out ((hBeh out).mp hb)⟩
  have hBody : ∀ (defId : DefId) (body : Body) (safetyPre : List Val → Prop),
      BodyVerifiedRef p defId body safetyPre ↔
        BodyVerified p defId body safetyPre := by
    intro defId body safetyPre
    unfold BodyVerifiedRef BodyVerified ValidEntryArgsRef ValidEntryArgs
    have hFreeEntry : isRefFreeProgram (entryProgForBody p defId) = true :=
      hFree
    constructor
    · intro ⟨hGet, hAdm, hRun⟩
      have hBFree : isRefFreeBody body = true := list_all_getElem? hFree hGet
      have hAdmEq : BodyStaticAdmittedRef p body = BodyStaticAdmitted p body := by
        unfold BodyStaticAdmittedRef BodyStaticAdmitted
        rw [bodyLocalsAdmittedRef_eq_of_isRefFree hBFree]
      rw [hAdmEq] at hAdm
      refine ⟨hGet, hAdm, ?_⟩
      intro args hVA hSafe
      exact (conservative_ext_query hFreeEntry { args := args }).1.mp
        (hRun args hVA hSafe)
    · intro ⟨hGet, hAdm, hRun⟩
      have hBFree : isRefFreeBody body = true := list_all_getElem? hFree hGet
      have hAdmEq : BodyStaticAdmittedRef p body = BodyStaticAdmitted p body := by
        unfold BodyStaticAdmittedRef BodyStaticAdmitted
        rw [bodyLocalsAdmittedRef_eq_of_isRefFree hBFree]
      rw [← hAdmEq] at hAdm
      refine ⟨hGet, hAdm, ?_⟩
      intro args hVA hSafe
      exact (conservative_ext_query hFreeEntry { args := args }).1.mpr
        (hRun args hVA hSafe)
  have hProg : ∀ specs : Specs,
      ProgramVerifiedRef p specs ↔ ProgramVerified p specs := by
    intro specs
    unfold ProgramVerifiedRef ProgramVerified
    constructor
    · intro ⟨h1, h2, h3, h4, h5, hB, hP⟩
      exact ⟨h1, h2, h3, h4, h5,
        fun d b hG => (hBody d b (specs.safety b.identity)).mp (hB d b hG),
        hP⟩
    · intro ⟨h1, h2, h3, h4, h5, hB, hP⟩
      exact ⟨h1, h2, h3, h4, h5,
        fun d b hG => (hBody d b (specs.safety b.identity)).mpr (hB d b hG),
        hP⟩
  refine ⟨hQ, hPost, hBody, ?_⟩
  intro specs
  constructor
  · unfold CrateTheoremRef CrateTheorem
    dsimp
    constructor
    · intro ⟨hsc, hpv⟩; exact ⟨hsc, (hProg specs).mp hpv⟩
    · intro ⟨hsc, hpv⟩; exact ⟨hsc, (hProg specs).mpr hpv⟩
  · unfold UnitTheoremRef UnitTheorem
    dsimp
    constructor
    · intro ⟨hsc, hpv⟩; exact ⟨hsc, (hProg specs).mp hpv⟩
    · intro ⟨hsc, hpv⟩; exact ⟨hsc, (hProg specs).mpr hpv⟩

