                                exact Or.inl (borrowLinkMode_beq_eq hm1)
                              | inr hm2 =>
                                exact Or.inr (borrowLinkMode_beq_eq hm2)
                        let ⟨hStEq, hS', hM2Cases⟩ := hAbsReb
                        rw [hS']
                        have hSRT : c.isSafeRef = true :=
