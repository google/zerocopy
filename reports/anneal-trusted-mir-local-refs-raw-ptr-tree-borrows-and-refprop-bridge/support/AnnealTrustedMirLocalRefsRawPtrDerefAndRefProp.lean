              cases hTr : c.trackTb with
              | false =>
                rw [hTr] at hAbs; dsimp at hAbs
                cases hM : BorrowLinkMode.beq mode .reserved with
                | false => rw [if_bool_false hM] at hAbs; cases hAbs
                | true =>
                  rw [if_bool_true hM] at hAbs
                  have hmRes := borrowLinkMode_beq_eq hM; subst hmRes
                  let ⟨hStEq, hS'⟩ := s3b_some_prod_eq hAbs
                  rw [← hS']
                  have hTInv := hCore.hTargetInv epX optXS hEpX hGXS
                  unfold s3b_TargetLiveInv at hTInv
                  rw [if_bool_false hTr] at hTInv
