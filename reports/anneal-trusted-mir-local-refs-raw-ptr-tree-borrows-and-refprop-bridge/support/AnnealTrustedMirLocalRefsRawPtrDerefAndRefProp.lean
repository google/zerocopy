/-! ## Slice 3b: Single-Step `propagateSsaRef` Bidirectional Soundness -/

/-! ### 1. Lattice Order, CFG Post-Fixpoint Lookup, & Static Metadata -/

private noncomputable def s3b_slotIsLive : LocalSlotRef → Bool
  | .dead => false
  | .live _ => true

private theorem s3b_slotIsLive_liveUninit (ty : MirTy) :
    s3b_slotIsLive (liveUninitSlotRef ty) = true := by
  cases ty with
  | unit => rfl
  | enum ety =>
    dsimp [liveUninitSlotRef]
    cases isZstEnumTy ety <;> rfl
  | _ => rfl

private theorem s3b_zero_add (n : Nat) : 0 + n = n := by
  induction n with
  | zero => rfl
  | succ k ih => exact congrArg Nat.succ ih

private theorem s3b_add_succ_left (a b : Nat) : (a + 1) + b = a + (b + 1) := by
  induction b with
  | zero => rfl
  | succ k ih => exact congrArg Nat.succ ih

private theorem s3b_some_prod_eq {α β : Type} {a₁ a₂ : α} {b₁ b₂ : β}
    (h : some (a₁, b₁) = some (a₂, b₂)) : a₁ = a₂ ∧ b₁ = b₂ := by
  injection h with hEq
  injection hEq with ha hb
  exact ⟨ha, hb⟩

private theorem s3b_some_prod3_eq {α β γ : Type}
    {a₁ a₂ : α} {b₁ b₂ : β} {c₁ c₂ : γ}
    (h : some (a₁, b₁, c₁) = some (a₂, b₂, c₂)) :
    a₁ = a₂ ∧ b₁ = b₂ ∧ c₁ = c₂ := by
  injection h with hEq
  injection hEq with ha hbc
  injection hbc with hb hc
  exact ⟨ha, hb, hc⟩

private theorem s3b_DelegatedCopyRel_of_allRoot_empty {loc : LocalId}
    {ep : Nat} :
    ∀ {nsS : List BorrowNode},
      rp_allRootParents loc ep nsS →
      rp_DelegatedCopyRel loc ep [] [] nsS []
  | [], _ => .nil []
  | d :: rest, ⟨hAt, hP0, hNR, hRest⟩ =>
    .skip [] d [] rest [] hAt hP0 hNR rfl rfl
      (s3b_DelegatedCopyRel_of_allRoot_empty hRest)

private noncomputable def s3b_stmtStorageInBounds (bound : Nat) :
    StatementKind → Bool
  | .storageLive id | .storageDead id => Nat.blt id bound
  | _ => true

private theorem s3b_bool_cases (b : Bool) : b = false ∨ b = true := by
  cases b
  · exact Or.inl rfl
  · exact Or.inr rfl

private theorem s3b_epochs_getElem_lt {epochs : List Nat} {nextEpoch : Nat}
    {loc : LocalId} {ep : Nat}
    (hAll : epochs.all (fun e => Nat.blt e nextEpoch) = true)
    (hGet : Trusted.MirSemantics.getElem? epochs loc = some ep) :
    ep < nextEpoch :=
  nat_blt_lt (list_all_getElem? (p := fun e => Nat.blt e nextEpoch) hAll hGet)

private theorem s3b_localPtr_slot_inj {p₁ p₂ : LocalPtr} {ty₁ ty₂ : MirTy}
    (h : (some (LocalSlotRef.live (some (ValRef.localPtr p₁ ty₁))) :
        Option LocalSlotRef) =
      some (.live (some (.localPtr p₂ ty₂)))) :
    p₁ = p₂ := by
  cases h
  rfl

private theorem s3b_forwardCopy_shape {bodyLocals : List MirTy}
    {r x : LocalId} {rTy : MirTy} {dst : Place} {rv : Rvalue}
    {fwd : StatementKind}
    (hFwd : forwardCopyOfRefStmt? bodyLocals r x rTy dst rv = some fwd) :
    ∃ src m inner,
      dst.projection = [] ∧
      dst.localId ≠ r ∧
      dst.localId ≠ x ∧
      Trusted.MirSemantics.getElem? bodyLocals dst.localId = some rTy ∧
      rv = .use (.copy src) ∧
      src.projection = [] ∧
      src.localId = r ∧
      ((rTy = .ref m inner ∧ fwd = .assign dst (.ref m ⟨x, []⟩)) ∨
        (rTy = .rawPtr m inner ∧ fwd = .assign dst (.addressOf m ⟨x, []⟩))) :=
by
  unfold forwardCopyOfRefStmt? at hFwd
  cases hC1 : (!dst.projection.isEmpty || Nat.beq dst.localId r ||
      Nat.beq dst.localId x) with
  | true => rw [if_bool_true hC1] at hFwd; cases hFwd
  | false =>
    rw [if_bool_false hC1] at hFwd
    let ⟨hC1a, hNeX⟩ := bool_or_false hC1
    let ⟨hPEmp, hNeR⟩ := bool_or_false hC1a
    have hProjNil : dst.projection = [] := by
      cases hp : dst.projection with
      | nil => rfl
      | cons _ _ => rw [hp] at hPEmp; cases hPEmp
    cases hG : Trusted.MirSemantics.getElem? bodyLocals dst.localId with
    | none => rw [hG] at hFwd; cases hFwd
    | some dTy =>
      rw [hG] at hFwd
      cases rv with
      | use opnd =>
        cases opnd with
        | copy src =>
          dsimp at hFwd
          cases hC2 : (MirTy.beq dTy rTy && src.projection.isEmpty &&
              Nat.beq src.localId r) with
          | false => rw [if_bool_false hC2] at hFwd; cases hFwd
          | true =>
            rw [if_bool_true hC2] at hFwd
            let ⟨hC2a, hSrcR⟩ := bool_and_true hC2
            let ⟨hTyEq, hSrcEmp⟩ := bool_and_true hC2a
            have hdTy : dTy = rTy := mirTy_beq_eq hTyEq
            have hSrcNil : src.projection = [] := by
              cases hs : src.projection with
              | nil => rfl
              | cons _ _ => rw [hs] at hSrcEmp; cases hSrcEmp
            cases hRTy : rTy with
            | ref m inner =>
              rw [hRTy] at hFwd hdTy
              dsimp at hFwd
              injection hFwd with hEq
              exact ⟨src, m, inner, hProjNil, nat_ne_of_beq_false hNeR,
                nat_ne_of_beq_false hNeX, congrArg some hdTy, rfl, hSrcNil,
                nat_beq_eq hSrcR, Or.inl ⟨rfl, hEq.symm⟩⟩
            | rawPtr m inner =>
              rw [hRTy] at hFwd hdTy
              dsimp at hFwd
              injection hFwd with hEq
              exact ⟨src, m, inner, hProjNil, nat_ne_of_beq_false hNeR,
                nat_ne_of_beq_false hNeX, congrArg some hdTy, rfl, hSrcNil,
                nat_beq_eq hSrcR, Or.inr ⟨rfl, hEq.symm⟩⟩
            | _ =>
              rw [hRTy] at hFwd
              cases hFwd
        | _ => cases hFwd
      | _ => cases hFwd

private noncomputable def s3b_reborrowMutOpt (r : LocalId) (rv : Rvalue) :
    Option Mutability :=
  match rv with
  | .ref m2 srcP => if Nat.beq srcP.localId r then some m2 else none
  | _ => none

private theorem s3b_absStepAssign_notStorage {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool}
    {rL xL : Bool} {mode : BorrowLinkMode} {dst : Place} {rv : Rvalue}
    {st₁ : AbsRefState} {s' : StatementKind}
    (hStep :
      absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
        (.reachable rL xL mode) (.assign dst rv) = some (st₁, s')) :
    s' = .nop ∨ ∃ d2 r2, s' = .assign d2 r2 := by
  dsimp [absStepAndRewriteStmt] at hStep
  cases hDef : isDefiningBorrowAssign r x rTy dst rv with
  | true =>
    rw [if_bool_true hDef] at hStep
    cases hG : (!rL || !xL || (trackTb && BorrowLinkMode.beq mode .delegated))
    with
    | true => rw [if_bool_true hG] at hStep; cases hStep
    | false =>
      rw [if_bool_false hG] at hStep
      exact Or.inl (s3b_some_prod_eq hStep).2.symm
  | false =>
    rw [if_bool_false hDef] at hStep
    cases hWR : (dst.projection.isEmpty && Nat.beq dst.localId r) with
    | true => rw [if_bool_true hWR] at hStep; cases hStep
    | false =>
      rw [if_bool_false hWR] at hStep
      cases hFwd : forwardCopyOfRefStmt? bodyLocals r x rTy dst rv with
      | some fwd =>
        rw [hFwd] at hStep
        dsimp at hStep
        let ⟨_, m, _, _, _, _, _, _, _, _, hFwdOr⟩ := s3b_forwardCopy_shape hFwd
        have hEq : s' = fwd := by
          cases hL : (!rL || !xL) with
          | true => rw [if_bool_true hL] at hStep; cases hStep
          | false =>
            rw [if_bool_false hL] at hStep
            cases hT : !trackTb with
            | true =>
              rw [if_bool_true hT] at hStep
              cases hM : BorrowLinkMode.beq mode .reserved with
              | false => rw [if_bool_false hM] at hStep; cases hStep
              | true =>
                rw [if_bool_true hM] at hStep
                exact (s3b_some_prod_eq hStep).2.symm
            | false =>
              rw [if_bool_false hT] at hStep
              cases hMut : rIsMut with
              | true =>
                rw [if_bool_true hMut] at hStep
                cases hM : BorrowLinkMode.beq mode .reserved with
                | false => rw [if_bool_false hM] at hStep; cases hStep
                | true =>
                  rw [if_bool_true hM] at hStep
                  exact (s3b_some_prod_eq hStep).2.symm
              | false =>
                rw [if_bool_false hMut] at hStep
                cases hM : (BorrowLinkMode.beq mode .reserved ||
                    BorrowLinkMode.beq mode .frozen) with
                | false => rw [if_bool_false hM] at hStep; cases hStep
                | true =>
                  rw [if_bool_true hM] at hStep
                  exact (s3b_some_prod_eq hStep).2.symm
        rw [hEq]
        cases hFwdOr with
        | inl h1 => exact Or.inr ⟨dst, .ref m ⟨x, []⟩, h1.2⟩
        | inr h2 => exact Or.inr ⟨dst, .addressOf m ⟨x, []⟩, h2.2⟩
      | none =>
        rw [hFwd] at hStep
        dsimp at hStep
        cases hNoR : !stmtAssignMentionsLocal r (.assign dst rv) with
        | true =>
          rw [if_bool_true hNoR] at hStep
          have hEq : s' = .assign dst rv := by
            cases hT : !trackTb with
            | true =>
              rw [if_bool_true hT] at hStep
              exact (s3b_some_prod_eq hStep).2.symm
            | false =>
              rw [if_bool_false hT] at hStep
              cases mode with
              | clean | delegated =>
                exact (s3b_some_prod_eq hStep).2.symm
              | reserved | unique | frozen =>
                dsimp at hStep
                cases hDW : ((dst.projection.isEmpty &&
                    Nat.beq dst.localId x) ||
                    rvalueDirectMovesLocal x rv) with
                | true =>
                  rw [if_bool_true hDW] at hStep
                  exact (s3b_some_prod_eq hStep).2.symm
                | false =>
                  rw [if_bool_false hDW] at hStep
                  cases hMX : stmtAssignMentionsLocal x (.assign dst rv) with
                  | true =>
                    rw [if_bool_true hMX] at hStep
                    exact (s3b_some_prod_eq hStep).2.symm
                  | false =>
                    rw [if_bool_false hMX] at hStep
                    exact (s3b_some_prod_eq hStep).2.symm
          exact Or.inr ⟨dst, rv, hEq⟩
        | false =>
          rw [if_bool_false hNoR] at hStep
          have hEq : s' = .assign (rewriteDerefPlace r x dst)
              (rewriteDerefRvalue r x rv) := by
            cases hG1 : (!(rL && xL) || !placeOnlyUsesDerefOf r dst ||
                (Nat.beq dst.localId r && !rIsMut) ||
                !rvalueOnlyUsesDerefOf r rIsMut rIsSafeRef rv) with
            | true => rw [if_bool_true hG1] at hStep; cases hStep
            | false =>
              rw [if_bool_false hG1] at hStep
              cases hSelf : createsUnprojectedNonZstSelfUse xTy
                  (rewriteDerefPlace r x dst)
                  (rewriteDerefRvalue r x rv) with
              | true => rw [if_bool_true hSelf] at hStep; cases hStep
              | false =>
                rw [if_bool_false hSelf] at hStep
                cases hT : !trackTb with
                | true =>
                  rw [if_bool_true hT] at hStep
                  cases hM : BorrowLinkMode.beq mode .reserved with
                  | false => rw [if_bool_false hM] at hStep; cases hStep
                  | true =>
                    rw [if_bool_true hM] at hStep
                    exact (s3b_some_prod_eq hStep).2.symm
                | false =>
                  rw [if_bool_false hT] at hStep
                  cases hMX : stmtAssignMentionsLocal x (.assign dst rv) with
                  | true => rw [if_bool_true hMX] at hStep; cases hStep
                  | false =>
                    rw [if_bool_false hMX] at hStep
                    change (match s3b_reborrowMutOpt r rv with
                        | some m2 => _
                        | none => _) = some (st₁, s') at hStep
                    cases hReb : s3b_reborrowMutOpt r rv with
                    | some m2 =>
                      rw [hReb] at hStep
                      dsimp at hStep
                      cases hDP : !dst.projection.isEmpty with
                      | true => rw [if_bool_true hDP] at hStep; cases hStep
                      | false =>
                        rw [if_bool_false hDP] at hStep
                        cases m2 with
                        | «mut» =>
                          dsimp at hStep
                          cases hC : (rIsMut &&
                              BorrowLinkMode.beq mode .reserved) with
                          | false => rw [if_bool_false hC] at hStep; cases hStep
                          | true =>
                            rw [if_bool_true hC] at hStep
                            exact (s3b_some_prod_eq hStep).2.symm
                        | shared =>
                          dsimp at hStep
                          cases hC : (BorrowLinkMode.beq mode .reserved ||
                              BorrowLinkMode.beq mode .frozen) with
                          | false => rw [if_bool_false hC] at hStep; cases hStep
                          | true =>
                            rw [if_bool_true hC] at hStep
                            exact (s3b_some_prod_eq hStep).2.symm
                    | none =>
                      rw [hReb] at hStep
                      dsimp at hStep
                      cases hMR : (Nat.beq dst.localId r ||
                          rvalueMovesDerefOf r rv) with
                      | true =>
                        rw [if_bool_true hMR] at hStep
                        cases hNM : !rIsMut with
                        | true => rw [if_bool_true hNM] at hStep; cases hStep
                        | false =>
                          rw [if_bool_false hNM] at hStep
                          cases mode with
                          | reserved | unique =>
                            exact (s3b_some_prod_eq hStep).2.symm
                          | frozen | clean | delegated => cases hStep
                      | false =>
                        rw [if_bool_false hMR] at hStep
                        cases mode with
                        | reserved | unique | frozen =>
                          exact (s3b_some_prod_eq hStep).2.symm
                        | clean | delegated => cases hStep
          exact Or.inr ⟨_, _, hEq⟩

private theorem s3b_absStepStmt_storage_eq {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool}
    {st st₁ : AbsRefState} {stmt s' : StatementKind}
    (hStep :
      absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
        st stmt = some (st₁, s')) :
    (∀ loc, stmtHasStorageMarker loc s' = stmtHasStorageMarker loc stmt) ∧
      (∀ bound, s3b_stmtStorageInBounds bound s' =
        s3b_stmtStorageInBounds bound stmt) := by
  cases st with
  | unreachable =>
    dsimp [absStepAndRewriteStmt] at hStep
    cases hM : !stmtAssignMentionsLocal r stmt with
    | false => rw [if_bool_false hM] at hStep; cases hStep
    | true =>
      rw [if_bool_true hM] at hStep
      rw [← (s3b_some_prod_eq hStep).2]
      exact ⟨fun _ => rfl, fun _ => rfl⟩
  | reachable rL xL mode =>
    cases stmt with
    | nop =>
      dsimp [absStepAndRewriteStmt] at hStep
      rw [← (s3b_some_prod_eq hStep).2]
      exact ⟨fun _ => rfl, fun _ => rfl⟩
    | unsupported =>
      dsimp [absStepAndRewriteStmt] at hStep
      rw [← (s3b_some_prod_eq hStep).2]
      exact ⟨fun _ => rfl, fun _ => rfl⟩
    | storageLive id =>
      dsimp [absStepAndRewriteStmt] at hStep
      cases hR : Nat.beq id r with
      | true =>
        rw [if_bool_true hR] at hStep
        rw [← (s3b_some_prod_eq hStep).2]; exact ⟨fun _ => rfl, fun _ => rfl⟩
      | false =>
        rw [if_bool_false hR] at hStep
        cases hX : Nat.beq id x with
        | true =>
          rw [if_bool_true hX] at hStep
          rw [← (s3b_some_prod_eq hStep).2]; exact ⟨fun _ => rfl, fun _ => rfl⟩
        | false =>
          rw [if_bool_false hX] at hStep
          rw [← (s3b_some_prod_eq hStep).2]; exact ⟨fun _ => rfl, fun _ => rfl⟩
    | storageDead id =>
      dsimp [absStepAndRewriteStmt] at hStep
      cases hR : Nat.beq id r with
      | true =>
        rw [if_bool_true hR] at hStep
        rw [← (s3b_some_prod_eq hStep).2]; exact ⟨fun _ => rfl, fun _ => rfl⟩
      | false =>
        rw [if_bool_false hR] at hStep
        cases hX : Nat.beq id x with
        | true =>
          rw [if_bool_true hX] at hStep
          rw [← (s3b_some_prod_eq hStep).2]; exact ⟨fun _ => rfl, fun _ => rfl⟩
        | false =>
          rw [if_bool_false hX] at hStep
          rw [← (s3b_some_prod_eq hStep).2]; exact ⟨fun _ => rfl, fun _ => rfl⟩
    | assign dst rv =>
      cases s3b_absStepAssign_notStorage hStep with
      | inl hNop => rw [hNop]; exact ⟨fun _ => rfl, fun _ => rfl⟩
      | inr hAs =>
        let ⟨_, _, hEq⟩ := hAs
        rw [hEq]; exact ⟨fun _ => rfl, fun _ => rfl⟩

private theorem s3b_absStepStmts_length {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool} :
    ∀ {st outSt : AbsRefState} {ss ss' : List StatementKind},
      absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
        st ss = some (outSt, ss') →
      ss'.length = ss.length
  | _, _, [], _, h => by
    dsimp [absStepAndRewriteStmts] at h
    rw [← (s3b_some_prod_eq h).2]
  | st, _, s :: ss, _, h => by
    dsimp [absStepAndRewriteStmts] at h
    cases h1 :
        absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
          st s with
    | none => rw [h1] at h; cases h
    | some p1 =>
      rw [h1] at h
      cases p1 with
      | mk st₁ _ =>
        dsimp at h
        cases h2 :
            absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
              trackTb st₁ ss with
        | none => rw [h2] at h; cases h
        | some p2 =>
          rw [h2] at h
          cases p2 with
          | mk _ _ =>
            rw [← (s3b_some_prod_eq h).2]
            dsimp [List.length]
            rw [s3b_absStepStmts_length h2]

private noncomputable def s3b_absStateAtIdx (bodyLocals : List MirTy)
    (r x : LocalId) (rTy xTy : MirTy) (rIsMut rIsSafeRef trackTb : Bool) :
    Nat → AbsRefState → List StatementKind → Option AbsRefState
  | 0, st, _ => some st
  | _ + 1, _, [] => none
  | idx + 1, st, s :: ss =>
    match absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef
        trackTb st s with
    | none => none
    | some (st₁, _) =>
      s3b_absStateAtIdx bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
        idx st₁ ss

private theorem s3b_absStateAtIdx_step {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool}
    {idx : Nat} {st outSt stCur : AbsRefState}
    {ss ss' : List StatementKind} {stmt : StatementKind}
    (hAll : absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
      trackTb st ss = some (outSt, ss'))
    (hAt : s3b_absStateAtIdx bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
      idx st ss = some stCur)
    (hGet : Trusted.MirSemantics.getElem? ss idx = some stmt) :
    ∃ stNext stmt',
      Trusted.MirSemantics.getElem? ss' idx = some stmt' ∧
      absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
        stCur stmt = some (stNext, stmt') ∧
      s3b_absStateAtIdx bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
        (idx + 1) st ss = some stNext := by
  induction idx generalizing st stCur ss ss' with
  | zero =>
    cases ss with
    | nil => cases hGet
    | cons s ss =>
      dsimp only [s3b_absStateAtIdx] at hAt
      injection hAt with hEqSt; subst hEqSt
      dsimp only [Trusted.MirSemantics.getElem?] at hGet
      injection hGet with hEqS; subst hEqS
      dsimp only [absStepAndRewriteStmts] at hAll
      cases h1 :
          absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
            st s with
      | none => rw [h1] at hAll; cases hAll
      | some p1 =>
        rw [h1] at hAll
        cases p1 with
        | mk st₁ s' =>
          dsimp only at hAll
          cases h2 :
              absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
                trackTb st₁ ss with
          | none => rw [h2] at hAll; cases hAll
          | some p2 =>
            rw [h2] at hAll
            cases p2 with
            | mk _ _ =>
              rw [← (s3b_some_prod_eq hAll).2]
              dsimp only [Trusted.MirSemantics.getElem?, s3b_absStateAtIdx]
              rw [h1]
              exact ⟨st₁, s', rfl, rfl, rfl⟩
  | succ idx ih =>
    cases ss with
    | nil => cases hGet
    | cons s ss =>
      dsimp only [absStepAndRewriteStmts] at hAll
      dsimp only [s3b_absStateAtIdx] at hAt
      dsimp only [Trusted.MirSemantics.getElem?] at hGet
      cases h1 :
          absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
            st s with
      | none => rw [h1] at hAll; cases hAll
      | some p1 =>
        rw [h1] at hAll hAt
        cases p1 with
        | mk st₁ _ =>
          dsimp only at hAll hAt
          cases h2 :
              absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
                trackTb st₁ ss with
          | none => rw [h2] at hAll; cases hAll
          | some p2 =>
            rw [h2] at hAll
            cases p2 with
            | mk st₂ ss₂ =>
              let ⟨eSt, eSs⟩ := s3b_some_prod_eq hAll
              subst eSt; subst eSs
              let ⟨stNext, stmt', hGet', hStep, hAtNext⟩ := ih h2 hAt hGet
              dsimp only [Trusted.MirSemantics.getElem?, s3b_absStateAtIdx]
              rw [h1]
              exact ⟨stNext, stmt', hGet', hStep, hAtNext⟩

private theorem s3b_absStateAtIdx_end {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool}
    {st outSt stCur : AbsRefState} {ss ss' : List StatementKind}
    (hAll : absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
      trackTb st ss = some (outSt, ss'))
    (hAt : s3b_absStateAtIdx bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
      ss.length st ss = some stCur) :
    stCur = outSt := by
  induction ss generalizing st stCur ss' with
  | nil =>
    injection hAt with hCur
    exact hCur.symm.trans (s3b_some_prod_eq hAll).1
  | cons s ss ih =>
    dsimp only [absStepAndRewriteStmts] at hAll
    dsimp only [List.length, s3b_absStateAtIdx] at hAt
    cases h1 :
        absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
          st s with
    | none => rw [h1] at hAll; cases hAll
    | some p1 =>
      rw [h1] at hAll hAt
      cases p1 with
      | mk st₁ _ =>
        dsimp only at hAll hAt
        cases h2 :
            absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
              trackTb st₁ ss with
        | none => rw [h2] at hAll; cases hAll
        | some p2 =>
          rw [h2] at hAll
          cases p2 with
          | mk _ _ =>
            rw [(s3b_some_prod_eq hAll).1] at h2
            exact ih h2 hAt

private theorem s3b_verifyBlocks_length {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool}
    {inStates : List AbsRefState} :
    ∀ {base : Nat} {bbs bbs' : List BasicBlock},
      verifyAndRewriteBlocksLoop bodyLocals r x rTy xTy rIsMut rIsSafeRef
        trackTb inStates base bbs = some bbs' →
      bbs'.length = bbs.length
  | _, [], _, h => by
    dsimp [verifyAndRewriteBlocksLoop] at h
    injection h with hEq; rw [← hEq]
  | base, bb :: rest, _, h => by
    dsimp [verifyAndRewriteBlocksLoop] at h
    cases h1 :
        absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
          trackTb (getAbsState inStates base) bb.statements with
    | none => rw [h1] at h; cases h
    | some p1 =>
      rw [h1] at h
      cases p1 with
      | mk outSt _ =>
        dsimp at h
        cases h2 :
            absStepAndRewriteTerminator r x rIsMut trackTb outSt
              bb.terminator with
        | none => rw [h2] at h; cases h
        | some p2 =>
          rw [h2] at h
          cases p2 with
          | mk succs p2b =>
            cases p2b with
            | mk afterSt _ =>
              dsimp at h
              cases hAll :
                  !succs.all (fun s => absLe afterSt (getAbsState inStates s))
              with
              | true => rw [if_bool_true hAll] at h; cases h
              | false =>
                rw [if_bool_false hAll] at h
                cases h3 :
                    verifyAndRewriteBlocksLoop bodyLocals r x rTy xTy rIsMut
                      rIsSafeRef trackTb inStates (base + 1) rest with
                | none => rw [h3] at h; cases h
                | some _ =>
                  rw [h3] at h
                  injection h with hEq
                  rw [← hEq]
                  dsimp [List.length]
                  rw [s3b_verifyBlocks_length h3]

private theorem s3b_verifyBlocks_getElem? {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool}
    {inStates : List AbsRefState} :
    ∀ {base idx : Nat} {bbs bbs' : List BasicBlock} {bbSrc : BasicBlock},
      verifyAndRewriteBlocksLoop bodyLocals r x rTy xTy rIsMut rIsSafeRef
        trackTb inStates base bbs = some bbs' →
      Trusted.MirSemantics.getElem? bbs idx = some bbSrc →
      ∃ bbTgt outSt succs afterTermSt,
        Trusted.MirSemantics.getElem? bbs' idx = some bbTgt ∧
        bbTgt.cleanup = bbSrc.cleanup ∧
        absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
          trackTb (getAbsState inStates (base + idx)) bbSrc.statements =
          some (outSt, bbTgt.statements) ∧
        absStepAndRewriteTerminator r x rIsMut trackTb outSt bbSrc.terminator =
          some (succs, afterTermSt, bbTgt.terminator) ∧
        succs.all (fun s => absLe afterTermSt (getAbsState inStates s)) = true
  | base, 0, bb :: rest, _, _, h, hGet => by
    dsimp [Trusted.MirSemantics.getElem?] at hGet
    injection hGet with hEqBb; subst hEqBb
    dsimp [verifyAndRewriteBlocksLoop] at h
    cases h1 :
        absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
          trackTb (getAbsState inStates base) bb.statements with
    | none => rw [h1] at h; cases h
    | some p1 =>
      rw [h1] at h
      cases p1 with
      | mk outSt stmts' =>
        dsimp at h
        cases h2 :
            absStepAndRewriteTerminator r x rIsMut trackTb outSt
              bb.terminator with
        | none => rw [h2] at h; cases h
        | some p2 =>
          rw [h2] at h
          cases p2 with
          | mk succs p2b =>
            cases p2b with
            | mk afterSt term' =>
              dsimp at h
              cases hAll :
                  !succs.all (fun s => absLe afterSt (getAbsState inStates s))
              with
              | true => rw [if_bool_true hAll] at h; cases h
              | false =>
                rw [if_bool_false hAll] at h
                cases h3 :
                    verifyAndRewriteBlocksLoop bodyLocals r x rTy xTy rIsMut
                      rIsSafeRef trackTb inStates (base + 1) rest with
                | none => rw [h3] at h; cases h
                | some rest' =>
                  rw [h3] at h
                  injection h with hEq
                  rw [← hEq]
                  exact ⟨{ statements := stmts', terminator := term',
                           cleanup := bb.cleanup },
                    outSt, succs, afterSt, rfl, rfl,
                    rfl, h2,
                    bool_not_false hAll⟩
  | base, idx + 1, bb :: rest, _, _, h, hGet => by
    dsimp [Trusted.MirSemantics.getElem?] at hGet
    dsimp [verifyAndRewriteBlocksLoop] at h
    cases h1 :
        absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
          trackTb (getAbsState inStates base) bb.statements with
    | none => rw [h1] at h; cases h
    | some p1 =>
      rw [h1] at h
      cases p1 with
      | mk outSt _ =>
        dsimp at h
        cases h2 :
            absStepAndRewriteTerminator r x rIsMut trackTb outSt
              bb.terminator with
        | none => rw [h2] at h; cases h
        | some p2 =>
          rw [h2] at h
          cases p2 with
          | mk succs p2b =>
            cases p2b with
            | mk afterSt _ =>
              dsimp at h
              cases hAll :
                  !succs.all (fun s => absLe afterSt (getAbsState inStates s))
              with
              | true => rw [if_bool_true hAll] at h; cases h
              | false =>
                rw [if_bool_false hAll] at h
                cases h3 :
                    verifyAndRewriteBlocksLoop bodyLocals r x rTy xTy rIsMut
                      rIsSafeRef trackTb inStates (base + 1) rest with
                | none => rw [h3] at h; cases h
                | some _ =>
                  rw [h3] at h
                  injection h with hEq
                  rw [← hEq]
                  let ⟨bbTgt, out2, succs2, after2, hG2, hCl, hS2, hT2, hA2⟩ :=
                    s3b_verifyBlocks_getElem? h3 hGet
                  rw [s3b_add_succ_left base idx] at hS2
                  exact ⟨bbTgt, out2, succs2, after2, hG2, hCl, hS2, hT2, hA2⟩

private theorem s3b_absStepStmts_storage_eq {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool} :
    ∀ {st outSt : AbsRefState} {ss ss' : List StatementKind},
      absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
        st ss = some (outSt, ss') →
      (∀ loc,
        ss'.any (stmtHasStorageMarker loc) =
          ss.any (stmtHasStorageMarker loc)) ∧
        (∀ bound,
          ss'.all (s3b_stmtStorageInBounds bound) =
            ss.all (s3b_stmtStorageInBounds bound))
  | _, _, [], _, h => by
    dsimp [absStepAndRewriteStmts] at h
    rw [← (s3b_some_prod_eq h).2]
    exact ⟨fun _ => rfl, fun _ => rfl⟩
  | st, _, s :: ss, _, h => by
    dsimp [absStepAndRewriteStmts] at h
    cases h1 :
        absStepAndRewriteStmt bodyLocals r x rTy xTy rIsMut rIsSafeRef trackTb
          st s with
    | none => rw [h1] at h; cases h
    | some p1 =>
      rw [h1] at h
      cases p1 with
      | mk st₁ _ =>
        dsimp at h
        cases h2 :
            absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
              trackTb st₁ ss with
        | none => rw [h2] at h; cases h
        | some p2 =>
          rw [h2] at h
          cases p2 with
          | mk _ _ =>
            rw [← (s3b_some_prod_eq h).2]
            let ⟨hHdM, hHdB⟩ := s3b_absStepStmt_storage_eq h1
            let ⟨hTlM, hTlB⟩ := s3b_absStepStmts_storage_eq h2
            refine ⟨?_, ?_⟩
            · intro loc; dsimp [List.any]; rw [hHdM loc, hTlM loc]
            · intro bound; dsimp [List.all]; rw [hHdB bound, hTlB bound]

private theorem s3b_verifyBlocks_storage_eq {bodyLocals : List MirTy}
    {r x : LocalId} {rTy xTy : MirTy} {rIsMut rIsSafeRef trackTb : Bool}
    {inStates : List AbsRefState} :
    ∀ {base : Nat} {bbs bbs' : List BasicBlock},
      verifyAndRewriteBlocksLoop bodyLocals r x rTy xTy rIsMut rIsSafeRef
        trackTb inStates base bbs = some bbs' →
      (∀ loc,
        bbs'.any (fun bb => bb.statements.any (stmtHasStorageMarker loc)) =
          bbs.any (fun bb => bb.statements.any (stmtHasStorageMarker loc))) ∧
        (∀ bound,
          bbs'.all (fun bb =>
            bb.statements.all (s3b_stmtStorageInBounds bound)) =
          bbs.all (fun bb =>
            bb.statements.all (s3b_stmtStorageInBounds bound)))
  | _, [], _, h => by
    dsimp [verifyAndRewriteBlocksLoop] at h
    injection h with hE; rw [← hE]
    exact ⟨fun _ => rfl, fun _ => rfl⟩
  | base, bb :: rest, _, h => by
    dsimp [verifyAndRewriteBlocksLoop] at h
    cases h1 :
        absStepAndRewriteStmts bodyLocals r x rTy xTy rIsMut rIsSafeRef
          trackTb (getAbsState inStates base) bb.statements with
    | none => rw [h1] at h; cases h
    | some p1 =>
      rw [h1] at h
      cases p1 with
      | mk outSt _ =>
        dsimp at h
        cases h2 :
            absStepAndRewriteTerminator r x rIsMut trackTb outSt
              bb.terminator with
        | none => rw [h2] at h; cases h
        | some p2 =>
          rw [h2] at h
          cases p2 with
          | mk succs p2b =>
            cases p2b with
            | mk afterSt _ =>
              dsimp at h
              cases hAll :
                  !succs.all (fun s => absLe afterSt (getAbsState inStates s))
              with
              | true => rw [if_bool_true hAll] at h; cases h
              | false =>
                rw [if_bool_false hAll] at h
                cases h3 :
                    verifyAndRewriteBlocksLoop bodyLocals r x rTy xTy rIsMut
                      rIsSafeRef trackTb inStates (base + 1) rest with
                | none => rw [h3] at h; cases h
                | some _ =>
                  rw [h3] at h
                  injection h with hEq
                  rw [← hEq]
                  let ⟨hHdM, hHdB⟩ := s3b_absStepStmts_storage_eq h1
                  let ⟨hTlM, hTlB⟩ := s3b_verifyBlocks_storage_eq h3
                  refine ⟨?_, ?_⟩
                  · intro loc; dsimp [List.any]; rw [hHdM loc, hTlM loc]
                  · intro bound; dsimp [List.all]; rw [hHdB bound, hTlB bound]

private theorem s3b_setElem_take_eq {α : Type} :
    ∀ {xs xs' : List α} {k i : Nat} {v : α},
      k ≤ i →
      setElem? xs i v = some xs' →
      xs'.take k = xs.take k
  | [], _, _, _, _, _, hSet => by cases hSet
  | _ :: _, _, 0, _, _, _, _ => rfl
  | _ :: _, _, _ + 1, 0, _, hLe, _ =>
    False.elim (Nat.not_succ_le_zero _ hLe)
  | _ :: rest, _, k + 1, i + 1, v, hLe, hSet => by
    dsimp [setElem?] at hSet
    cases hSub : setElem? rest i v with
    | none => rw [hSub] at hSet; cases hSet
    | some _ =>
      rw [hSub] at hSet
      injection hSet with hEq; subst hEq
      dsimp [List.take]
      rw [s3b_setElem_take_eq (Nat.le_of_succ_le_succ hLe) hSub]

private theorem s3b_setElem_drop1_take_eq {α : Type} {xs xs' : List α}
    {argCnt r : Nat} {v : α}
    (hLt : argCnt < r) (hSet : setElem? xs r v = some xs') :
    (xs'.drop 1).take argCnt = (xs.drop 1).take argCnt := by
  cases xs with
  | nil => cases hSet
  | cons _ rest =>
    cases r with
    | zero => exact False.elim (Nat.not_lt_zero _ hLt)
    | succ r' =>
      dsimp [setElem?] at hSet
      cases hSub : setElem? rest r' v with
      | none => rw [hSub] at hSet; cases hSet
      | some _ =>
        rw [hSub] at hSet
        injection hSet with hEq; subst hEq
        dsimp [List.drop]
        exact s3b_setElem_take_eq (Nat.le_of_succ_le_succ hLt) hSub

private theorem s3b_storageInBounds_stmts_eq (bound : Nat) :
    ∀ (stmts : List StatementKind),
      stmts.all (fun stmt =>
        match stmt with
        | .storageLive id | .storageDead id => Nat.blt id bound
        | _ => true) =
      stmts.all (s3b_stmtStorageInBounds bound)
  | [] => rfl
  | st :: rest => by
    dsimp [List.all]
    have hHd :
        (match st with
         | .storageLive id | .storageDead id => Nat.blt id bound
         | _ => true) = s3b_stmtStorageInBounds bound st := by
      cases st <;> rfl
    rw [hHd, s3b_storageInBounds_stmts_eq bound rest]

private theorem s3b_storageInBounds_eq_helper (bound : Nat) :
    ∀ (bbs : List BasicBlock),
      bbs.all (fun bb =>
        bb.statements.all (fun stmt =>
          match stmt with
          | .storageLive id | .storageDead id => Nat.blt id bound
          | _ => true)) =
      bbs.all (fun bb => bb.statements.all (s3b_stmtStorageInBounds bound))
  | [] => rfl
  | bb :: rest => by
    dsimp [List.all]
    rw [s3b_storageInBounds_stmts_eq bound bb.statements,
        s3b_storageInBounds_eq_helper bound rest]

/-! ### 2. Context Bundle & Coupled Frame/Tree-Borrows Simulation Relation -/

private structure s3b_Ctx where
  bodySrc : Body
  bodyTgt : Body
  r : LocalId
  x : LocalId
  rTy : MirTy
  xTy : MirTy
  isSafeRef : Bool
  rMut : Mutability
  rIsMut : Bool
  trackTb : Bool
  inStates : List AbsRefState
  hNonEmpty : bodySrc.basicBlocks.isEmpty = false
  hLocsInBounds : bodyAllLocalsInBounds bodySrc = true
  hBlocksInBounds : bodyAllBlocksInBounds bodySrc = true
  hStorageInBounds : storageAnnotationsInBounds bodySrc = true
  hAdmittedSrc : bodyLocalsAdmittedRef bodySrc = true
  hArgLtR : bodySrc.argumentCount < r
  hRLt : r < bodySrc.locals.length
  hXLt : x < bodySrc.locals.length
  hRNeX : r ≠ x
  hNoAddrSrc : bodyTakesAddressOf bodySrc r = false
  hNoMentionsTgt : bodyMentionsLocalExceptStorage r bodyTgt = false
  hGetRSrc : Trusted.MirSemantics.getElem? bodySrc.locals r = some rTy
  hGetXSrc : Trusted.MirSemantics.getElem? bodySrc.locals x = some xTy
  hSetLocals : setElem? bodySrc.locals r .unit = some bodyTgt.locals
  hArgCntEq : bodyTgt.argumentCount = bodySrc.argumentCount
  hUnsafeEq : bodyTgt.isUnsafe = bodySrc.isUnsafe
  hIdentityEq : bodyTgt.identity = bodySrc.identity
  hPtrInfo : ptrPointeeInfo? rTy = some (isSafeRef, rMut, xTy)
  hRIsMut : rIsMut = Mutability.beq rMut .mut
  hTrackTb : trackTb = (isSafeRef && !isZeroSizedTy xTy)
  hInhab : isSafeRef = true → isOpsemInhabitedTy xTy = true
  hExcl : trackTb = true → bodyExclusiveTargetBorrow bodySrc r x rTy = true
  hInLen : inStates.length = bodySrc.basicBlocks.length
  hEntryLe : absLe (initAbsState bodySrc r x) (getAbsState inStates 0) = true
  hVerify :
    verifyAndRewriteBlocksLoop bodySrc.locals r x rTy xTy rIsMut isSafeRef
      trackTb inStates 0 bodySrc.basicBlocks = some bodyTgt.basicBlocks

private theorem s3b_ctx_r_ne_zero (c : s3b_Ctx) : c.r ≠ 0 :=
  Nat.ne_of_gt (Nat.lt_of_le_of_lt (Nat.zero_le _) c.hArgLtR)

private theorem s3b_ctx_localsTgt_len (c : s3b_Ctx) :
    c.bodyTgt.locals.length = c.bodySrc.locals.length :=
  setElem?_length c.hSetLocals

private theorem s3b_ctx_getElem_localsTgt_ne (c : s3b_Ctx) {loc : LocalId}
    (hNe : loc ≠ c.r) :
    Trusted.MirSemantics.getElem? c.bodyTgt.locals loc =
      Trusted.MirSemantics.getElem? c.bodySrc.locals loc :=
  setElem?_getElem?_ne c.hSetLocals hNe

private theorem s3b_ctx_getElem_localsTgt_r (c : s3b_Ctx) :
    Trusted.MirSemantics.getElem? c.bodyTgt.locals c.r = some .unit :=
  setElem?_getElem?_same c.hSetLocals

private theorem s3b_ctx_getElem_localsTgt_x (c : s3b_Ctx) :
    Trusted.MirSemantics.getElem? c.bodyTgt.locals c.x = some c.xTy := by
  rw [s3b_ctx_getElem_localsTgt_ne c (fun h => c.hRNeX h.symm)]
  exact c.hGetXSrc

private theorem s3b_ctx_ptrTy_shape (c : s3b_Ctx) :
    isSupportedRefPtrTy c.xTy = true ∧
    isPtrOrRefTy c.rTy = true ∧
    ((c.isSafeRef = true ∧ c.rTy = .ref c.rMut c.xTy) ∨
      (c.isSafeRef = false ∧ c.rTy = .rawPtr c.rMut c.xTy)) := by
  have hPI := c.hPtrInfo
  cases hTy : c.rTy with
  | ref m inner =>
    rw [hTy] at hPI
    dsimp [ptrPointeeInfo?] at hPI
    cases hSup : isSupportedRefPtrTy inner with
    | false => rw [if_bool_false hSup] at hPI; cases hPI
    | true =>
      rw [if_bool_true hSup] at hPI
      let ⟨hSR, hM, hIn⟩ := s3b_some_prod3_eq hPI
      rw [← hSR, ← hM, ← hIn]
      exact ⟨hSup, hSup, Or.inl ⟨rfl, rfl⟩⟩
  | rawPtr m inner =>
    rw [hTy] at hPI
    dsimp [ptrPointeeInfo?] at hPI
    cases hSup : isSupportedRefPtrTy inner with
    | false => rw [if_bool_false hSup] at hPI; cases hPI
    | true =>
      rw [if_bool_true hSup] at hPI
      let ⟨hSR, hM, hIn⟩ := s3b_some_prod3_eq hPI
      rw [← hSR, ← hM, ← hIn]
      exact ⟨hSup, hSup, Or.inr ⟨rfl, rfl⟩⟩
  | _ =>
    rw [hTy] at hPI
    cases hPI

private theorem s3b_ctx_hasStorageAnnotation_eq (c : s3b_Ctx) (loc : LocalId) :
    hasStorageAnnotation c.bodyTgt loc = hasStorageAnnotation c.bodySrc loc :=
  (s3b_verifyBlocks_storage_eq c.hVerify).1 loc

private theorem s3b_storageInBounds_of_body (b : Body) :
    storageAnnotationsInBounds b =
      b.basicBlocks.all (fun bb =>
        bb.statements.all (s3b_stmtStorageInBounds b.locals.length)) :=
  s3b_storageInBounds_eq_helper b.locals.length b.basicBlocks

private theorem s3b_ctx_storageInBounds_tgt (c : s3b_Ctx) :
    storageAnnotationsInBounds c.bodyTgt = true := by
  have hSrc := c.hStorageInBounds
  rw [s3b_storageInBounds_of_body] at hSrc
  rw [s3b_storageInBounds_of_body, s3b_ctx_localsTgt_len c,
      (s3b_verifyBlocks_storage_eq c.hVerify).2]
  exact hSrc

private theorem s3b_ctx_admitted_tgt (c : s3b_Ctx) :
    bodyLocalsAdmittedRef c.bodyTgt = true := by
  let ⟨hAbi, hAllSrc⟩ := bool_and_true c.hAdmittedSrc
  unfold bodyLocalsAdmittedRef
  rw [c.hArgCntEq, s3b_setElem_take_eq c.hArgLtR c.hSetLocals]
  exact bool_and_intro hAbi (list_all_setElem? hAllSrc rfl c.hSetLocals)

private theorem s3b_ctx_blocksTgt_nonEmpty (c : s3b_Ctx) :
    c.bodyTgt.basicBlocks.isEmpty = false := by
  rw [list_isEmpty_eq_of_length (s3b_verifyBlocks_length c.hVerify)]
  exact c.hNonEmpty

private noncomputable def s3b_ValRel (c : s3b_Ctx) (epochs : List Nat)
    (nextEpoch nextTagS nextTagT : Nat)
    (pairMap : LocalId → Nat → List (Nat × Nat)) :
    ValRef → ValRef → Prop
  | .base bS, .base bT => bS = bT
  | .localPtr ptrS tyS, .localPtr ptrT tyT =>
    tyS = tyT ∧
    ptrS.targetLocal ≠ c.r ∧
    ptrS.targetLocal = ptrT.targetLocal ∧
    ptrS.targetEpoch = ptrT.targetEpoch ∧
    ptrS.targetEpoch < nextEpoch ∧
    ptrS.borrowTag < nextTagS ∧
    ptrT.borrowTag < nextTagT ∧
    (∀ declTy,
      Trusted.MirSemantics.getElem? c.bodySrc.locals ptrS.targetLocal =
        some declTy →
      Trusted.MirSemantics.getElem? epochs ptrS.targetLocal =
        some ptrS.targetEpoch →
      isZeroSizedTy declTy = false →
      if c.trackTb && Nat.beq ptrS.targetLocal c.x then
        1 ≤ ptrS.borrowTag ∧ 1 ≤ ptrT.borrowTag ∧
        rp_hasPair (pairMap c.x ptrS.targetEpoch)
          ptrS.borrowTag ptrT.borrowTag = true
      else
        rp_tagPairValid (pairMap ptrS.targetLocal ptrS.targetEpoch)
          ptrS.borrowTag ptrT.borrowTag)
  | _, _ => False

private noncomputable def s3b_OptValRel (c : s3b_Ctx) (epochs : List Nat)
    (nextEpoch nextTagS nextTagT : Nat)
    (pairMap : LocalId → Nat → List (Nat × Nat)) :
    Option ValRef → Option ValRef → Prop
  | none, none => True
  | some vS, some vT =>
    s3b_ValRel c epochs nextEpoch nextTagS nextTagT pairMap vS vT
  | _, _ => False

private noncomputable def s3b_SlotRel (c : s3b_Ctx) (epochs : List Nat)
    (nextEpoch nextTagS nextTagT : Nat)
    (pairMap : LocalId → Nat → List (Nat × Nat)) :
    LocalSlotRef → LocalSlotRef → Prop
  | .dead, .dead => True
  | .live optS, .live optT =>
    s3b_OptValRel c epochs nextEpoch nextTagS nextTagT pairMap optS optT
  | _, _ => False

private theorem s3b_SlotRel_liveUninit (c : s3b_Ctx) (epochs : List Nat)
    (nextEpoch nextTagS nextTagT : Nat)
    (pairMap : LocalId → Nat → List (Nat × Nat)) (ty : MirTy) :
    s3b_SlotRel c epochs nextEpoch nextTagS nextTagT pairMap
      (liveUninitSlotRef ty) (liveUninitSlotRef ty) := by
  cases ty with
  | unit => exact rfl
  | enum ety =>
    dsimp [liveUninitSlotRef]
    cases isZstEnumTy ety with
    | true => exact rfl
    | false => exact True.intro
  | _ => exact True.intro

private theorem s3b_ValRel_checkValRef {c : s3b_Ctx} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {pm : LocalId → Nat → List (Nat × Nat)}
    {vS vT : ValRef} (ty : MirTy)
    (hV : s3b_ValRel c epochs nextEpoch ntS ntT pm vS vT) :
    checkValRef vS ty = checkValRef vT ty := by
  unfold checkValRef
  cases vS with
  | base bS =>
    cases vT with
    | base bT =>
      have hEq : bS = bT := hV
      rw [hEq]
    | localPtr _ _ => exact False.elim hV
  | localPtr _ tyS =>
    cases vT with
    | base _ => exact False.elim hV
    | localPtr _ tyT =>
      dsimp [ValRef.ty?]
      rw [hV.1]

private theorem s3b_decodeEnumDiscriminant_eq {c : s3b_Ctx} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {pm : LocalId → Nat → List (Nat × Nat)}
    {ety : EnumTy} {optS optT : Option ValRef}
    (hOpt : s3b_OptValRel c epochs nextEpoch ntS ntT pm optS optT) :
    decodeEnumDiscriminantSlot ety optS =
      decodeEnumDiscriminantSlot ety optT := by
  cases optS with
  | none =>
    cases optT with
    | none => rfl
    | some _ => exact False.elim hOpt
  | some vS =>
    cases optT with
    | none => exact False.elim hOpt
    | some vT =>
      cases vS with
      | base bS =>
        cases vT with
        | base bT =>
          have hEq : bS = bT := hOpt
          rw [hEq]
        | localPtr _ _ => exact False.elim hOpt
      | localPtr _ _ =>
        cases vT with
        | base _ => exact False.elim hOpt
        | localPtr _ _ =>
          unfold decodeEnumDiscriminantSlot
          cases ety.tagRepr <;> rfl

private theorem s3b_ValRel_mono_tags {c : s3b_Ctx} {epochs : List Nat}
    {nextEpoch ntS ntS' ntT ntT' : Nat}
    {pm pm' : LocalId → Nat → List (Nat × Nat)} {vS vT : ValRef}
    (hNtS : ntS ≤ ntS') (hNtT : ntT ≤ ntT')
    (hPm : ∀ loc ep tS tT,
      rp_hasPair (pm loc ep) tS tT = true →
      rp_hasPair (pm' loc ep) tS tT = true)
    (hRel : s3b_ValRel c epochs nextEpoch ntS ntT pm vS vT) :
    s3b_ValRel c epochs nextEpoch ntS' ntT' pm' vS vT := by
  cases vS with
  | base _ =>
    cases vT with
    | base _ => exact hRel
    | localPtr _ _ => exact False.elim hRel
  | localPtr pS _ =>
    cases vT with
    | base _ => exact False.elim hRel
    | localPtr pT _ =>
      let ⟨hTy, hNeR, hLoc, hEp, hEpLt, hBS, hBT, hTag⟩ := hRel
      refine ⟨hTy, hNeR, hLoc, hEp, hEpLt,
        Nat.lt_of_lt_of_le hBS hNtS, Nat.lt_of_lt_of_le hBT hNtT, ?_⟩
      intro declTy hDecl hGetEp hNZ
      have hSub := hTag declTy hDecl hGetEp hNZ
      cases hCond : (c.trackTb && Nat.beq pS.targetLocal c.x) with
      | true =>
        rw [if_bool_true hCond] at hSub
        dsimp
        let ⟨h1, h2, hP⟩ := hSub
        exact ⟨h1, h2, hPm c.x pS.targetEpoch pS.borrowTag pT.borrowTag hP⟩
      | false =>
        rw [if_bool_false hCond] at hSub
        dsimp
        cases hSub with
        | inl h0 => exact Or.inl h0
        | inr hPos =>
          let ⟨h1, h2, hP⟩ := hPos
          exact Or.inr
            ⟨h1, h2,
              hPm pS.targetLocal pS.targetEpoch pS.borrowTag pT.borrowTag hP⟩

private theorem s3b_SlotRel_mono_tags {c : s3b_Ctx} {epochs : List Nat}
    {nextEpoch ntS ntS' ntT ntT' : Nat}
    {pm pm' : LocalId → Nat → List (Nat × Nat)} {slS slT : LocalSlotRef}
    (hNtS : ntS ≤ ntS') (hNtT : ntT ≤ ntT')
    (hPm : ∀ loc ep tS tT,
      rp_hasPair (pm loc ep) tS tT = true →
      rp_hasPair (pm' loc ep) tS tT = true)
    (hRel : s3b_SlotRel c epochs nextEpoch ntS ntT pm slS slT) :
    s3b_SlotRel c epochs nextEpoch ntS' ntT' pm' slS slT := by
  cases slS with
  | dead =>
    cases slT with
    | dead => exact True.intro
    | live _ => exact False.elim hRel
  | live oS =>
    cases slT with
    | dead => exact False.elim hRel
    | live oT =>
      cases oS with
      | none =>
        cases oT with
        | none => exact True.intro
        | some _ => exact False.elim hRel
      | some _ =>
        cases oT with
        | none => exact False.elim hRel
        | some _ => exact s3b_ValRel_mono_tags hNtS hNtT hPm hRel

private theorem s3b_SlotRel_storageLive {c : s3b_Ctx}
    {epochs epochs' : List Nat} {lid nextEpoch ntS ntT : Nat}
    {pm pm' : LocalId → Nat → List (Nat × Nat)} {slS slT : LocalSlotRef}
    (hSetEp : setElem? epochs lid nextEpoch = some epochs')
    (hPmSame : ∀ loc ep, ep < nextEpoch → pm' loc ep = pm loc ep)
    (hRel : s3b_SlotRel c epochs nextEpoch ntS ntT pm slS slT) :
    s3b_SlotRel c epochs' (nextEpoch + 1) ntS ntT pm' slS slT := by
  cases slS with
  | dead =>
    cases slT with
    | dead => exact True.intro
    | live _ => exact False.elim hRel
  | live oS =>
    cases slT with
    | dead => exact False.elim hRel
    | live oT =>
      cases oS with
      | none =>
        cases oT with
        | none => exact True.intro
        | some _ => exact False.elim hRel
      | some vS =>
        cases oT with
        | none => exact False.elim hRel
        | some vT =>
          cases vS with
          | base _ =>
            cases vT with
            | base _ => exact hRel
            | localPtr _ _ => exact False.elim hRel
          | localPtr pS _ =>
            cases vT with
            | base _ => exact False.elim hRel
            | localPtr pT _ =>
              let ⟨hTy, hNeR, hLoc, hEp, hEpLt, hBS, hBT, hTag⟩ := hRel
              refine ⟨hTy, hNeR, hLoc, hEp,
                Nat.lt_of_lt_of_le hEpLt (Nat.le_succ _), hBS, hBT, ?_⟩
              intro declTy hDecl hGetEp' hNZ
              cases hEqLid : Nat.beq pS.targetLocal lid with
              | true =>
                have hIsLid := nat_beq_eq hEqLid
                subst hIsLid
                rw [setElem?_getElem?_same hSetEp] at hGetEp'
                injection hGetEp' with hEqEp
                rw [← hEqEp] at hEpLt
                exact False.elim (Nat.lt_irrefl _ hEpLt)
              | false =>
                have hNeLid := nat_ne_of_beq_false hEqLid
                rw [setElem?_getElem?_ne hSetEp hNeLid] at hGetEp'
                have hSub := hTag declTy hDecl hGetEp' hNZ
                rw [hPmSame c.x pS.targetEpoch hEpLt,
                    hPmSame pS.targetLocal pS.targetEpoch hEpLt]
                exact hSub

private noncomputable def s3b_TargetLiveInv (c : s3b_Ctx)
    (mode : BorrowLinkMode) (localsS : List LocalSlotRef) (epX : Nat)
    (nodesS nodesT : List BorrowNode) (nextTagS : Nat)
    (pairMap : LocalId → Nat → List (Nat × Nat)) : Prop :=
  if c.trackTb then
    match mode with
    | .reserved | .unique | .frozen =>
      rp_nodesAt c.x epX nodesT = [] ∧
      pairMap c.x epX = [] ∧
      rp_allRootParents c.x epX (rp_nodesAt c.x epX nodesS) ∧
      ∃ tagR permR,
        tagR < nextTagS ∧
        Trusted.MirSemantics.getElem? localsS c.r =
          some (.live (some (.localPtr ⟨c.x, epX, tagR⟩ c.rTy))) ∧
        rp_findPermAt? c.x epX tagR (rp_nodesAt c.x epX nodesS) = some permR ∧
        rp_permAllowed c.rIsMut mode permR
    | .clean =>
      rp_nodesAt c.x epX nodesT = [] ∧
      pairMap c.x epX = [] ∧
      rp_allRootParents c.x epX (rp_nodesAt c.x epX nodesS)
    | .delegated =>
      rp_DelegatedCopyRel c.x epX [] (pairMap c.x epX)
        (rp_nodesAt c.x epX nodesS) (rp_nodesAt c.x epX nodesT) ∨
      rp_DelegatedReborrowRel c.x epX (pairMap c.x epX)
        (rp_nodesAt c.x epX nodesS) (rp_nodesAt c.x epX nodesT)
  else if isZeroSizedTy c.xTy then
    BorrowLinkMode.beq mode .reserved = true →
      ∃ tagR,
        tagR < nextTagS ∧
        Trusted.MirSemantics.getElem? localsS c.r =
          some (.live (some (.localPtr ⟨c.x, epX, tagR⟩ c.rTy)))
  else
    rp_ExactNodeRel c.x epX [] (pairMap c.x epX)
      (rp_nodesAt c.x epX nodesS) (rp_nodesAt c.x epX nodesT) ∧
    (BorrowLinkMode.beq mode .reserved = true →
      Trusted.MirSemantics.getElem? localsS c.r =
        some (.live (some (.localPtr ⟨c.x, epX, 0⟩ c.rTy))))

private theorem s3b_TargetLiveInv_mono {c : s3b_Ctx}
    {m₁ m₂ : BorrowLinkMode} {localsS : List LocalSlotRef} {epX : Nat}
    {nodesS nodesT : List BorrowNode} {nextTagS : Nat}
    {pairMap : LocalId → Nat → List (Nat × Nat)}
    (hLe : linkModeLe m₁ m₂ = true)
    (hInv : s3b_TargetLiveInv c m₁ localsS epX nodesS nodesT nextTagS pairMap) :
    s3b_TargetLiveInv c m₂ localsS epX nodesS nodesT nextTagS pairMap := by
  unfold s3b_TargetLiveInv at hInv
  unfold s3b_TargetLiveInv
  cases hTr : c.trackTb with
  | true =>
    rw [if_bool_true hTr] at hInv
    dsimp
    cases m₁ with
    | reserved =>
      let ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLocR, hFind, hPA⟩ := hInv
      cases m₂ with
      | reserved => exact hInv
      | unique =>
        exact ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLocR, hFind,
          rp_permAllowed_mono hLe hPA⟩
      | frozen =>
        exact ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLocR, hFind,
          rp_permAllowed_mono hLe hPA⟩
      | clean => exact ⟨hNT, hPM, hRoot⟩
      | delegated =>
        rw [hNT, hPM]
        exact Or.inl (s3b_DelegatedCopyRel_of_allRoot_empty hRoot)
    | unique =>
      let ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLocR, hFind, hPA⟩ := hInv
      cases m₂ with
      | reserved => cases hLe
      | unique => exact hInv
      | frozen =>
        exact ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLocR, hFind,
          rp_permAllowed_mono hLe hPA⟩
      | clean => exact ⟨hNT, hPM, hRoot⟩
      | delegated =>
        rw [hNT, hPM]
        exact Or.inl (s3b_DelegatedCopyRel_of_allRoot_empty hRoot)
    | frozen =>
      let ⟨hNT, hPM, hRoot, _⟩ := hInv
      cases m₂ with
      | reserved | unique => cases hLe
      | frozen => exact hInv
      | clean => exact ⟨hNT, hPM, hRoot⟩
      | delegated =>
        rw [hNT, hPM]
        exact Or.inl (s3b_DelegatedCopyRel_of_allRoot_empty hRoot)
    | clean =>
      let ⟨hNT, hPM, hRoot⟩ := hInv
      cases m₂ with
      | reserved | unique | frozen => cases hLe
      | clean => exact hInv
      | delegated =>
        rw [hNT, hPM]
        exact Or.inl (s3b_DelegatedCopyRel_of_allRoot_empty hRoot)
    | delegated =>
      cases m₂ with
      | reserved | unique | frozen | clean => cases hLe
      | delegated => exact hInv
  | false =>
    rw [if_bool_false hTr] at hInv
    dsimp
    have hResImp :
        BorrowLinkMode.beq m₂ .reserved = true →
        BorrowLinkMode.beq m₁ .reserved = true := by
      intro hm2
      have em2 := borrowLinkMode_beq_eq hm2
      subst em2
      cases m₁ <;> first | rfl | cases hLe
    cases hZ : isZeroSizedTy c.xTy with
    | true =>
      rw [if_bool_true hZ] at hInv
      dsimp
      exact fun hm2 => hInv (hResImp hm2)
    | false =>
      rw [if_bool_false hZ] at hInv
      dsimp
      exact ⟨hInv.1, fun hm2 => hInv.2 (hResImp hm2)⟩

private theorem s3b_TargetLiveInv_setOther {c : s3b_Ctx}
    {mode : BorrowLinkMode} {localsS localsS' : List LocalSlotRef}
    {dstLoc : LocalId} {slNew : LocalSlotRef} {epX : Nat}
    {nodesS nodesT : List BorrowNode} {nextTagS : Nat}
    {pm : LocalId → Nat → List (Nat × Nat)}
    (hNeR : dstLoc ≠ c.r)
    (hSet : setElem? localsS dstLoc slNew = some localsS')
    (hInv : s3b_TargetLiveInv c mode localsS epX nodesS nodesT nextTagS pm) :
    s3b_TargetLiveInv c mode localsS' epX nodesS nodesT nextTagS pm := by
  unfold s3b_TargetLiveInv at hInv
  unfold s3b_TargetLiveInv
  rw [setElem?_getElem?_ne hSet (fun h => hNeR h.symm)]
  exact hInv

private structure s3b_CoreInv (c : s3b_Ctx) (rLive xLive : Bool)
    (mode : BorrowLinkMode) (localsS localsT : List LocalSlotRef)
    (epochs : List Nat) (nextEpoch : Nat) (nodesS nodesT : List BorrowNode)
    (nextTagS nextTagT : Nat)
    (pairMap : LocalId → Nat → List (Nat × Nat)) : Prop where
  hLenLocS : localsS.length = c.bodySrc.locals.length
  hLenLocT : localsT.length = c.bodySrc.locals.length
  hLenEp : epochs.length = c.bodySrc.locals.length
  hNextEpPos : 1 ≤ nextEpoch
  hEpLt : epochs.all (fun ep => Nat.blt ep nextEpoch) = true
  hNodesSEpLt : nodesS.all (fun n => Nat.blt n.targetEpoch nextEpoch) = true
  hNodesTEpLt : nodesT.all (fun n => Nat.blt n.targetEpoch nextEpoch) = true
  hNextTagSPos : 1 ≤ nextTagS
  hNextTagTPos : 1 ≤ nextTagT
  hBoundedS : rp_NodesBounded 1 nextTagS nodesS
  hBoundedT : rp_NodesBounded 1 nextTagT nodesT
  hNoTargetRS : nodesNotTargeting c.r nodesS = true
  hNoTargetRT : nodesNotTargeting c.r nodesT = true
  hSlotsOther :
    ∀ loc slS slT,
      loc ≠ c.r →
      Trusted.MirSemantics.getElem? localsS loc = some slS →
      Trusted.MirSemantics.getElem? localsT loc = some slT →
      s3b_SlotRel c epochs nextEpoch nextTagS nextTagT pairMap slS slT
  hSlotRLiveEq :
    ∀ slS slT,
      Trusted.MirSemantics.getElem? localsS c.r = some slS →
      Trusted.MirSemantics.getElem? localsT c.r = some slT →
      s3b_slotIsLive slS = s3b_slotIsLive slT
  hRLiveSound :
    rLive = true →
      ∀ slS, Trusted.MirSemantics.getElem? localsS c.r = some slS →
        s3b_slotIsLive slS = true
  hXLiveSound :
    xLive = true →
      ∀ slX, Trusted.MirSemantics.getElem? localsS c.x = some slX →
        s3b_slotIsLive slX = true
  hNonXRel :
    ∀ loc ep declTy,
      loc ≠ c.x →
      Trusted.MirSemantics.getElem? c.bodySrc.locals loc = some declTy →
      Trusted.MirSemantics.getElem? epochs loc = some ep →
      isZeroSizedTy declTy = false →
      rp_ExactNodeRel loc ep [] (pairMap loc ep)
        (rp_nodesAt loc ep nodesS) (rp_nodesAt loc ep nodesT)
  hTargetInv :
    ∀ epX optX,
      Trusted.MirSemantics.getElem? epochs c.x = some epX →
      Trusted.MirSemantics.getElem? localsS c.x = some (.live optX) →
      s3b_TargetLiveInv c mode localsS epX nodesS nodesT nextTagS pairMap

private theorem s3b_CoreInv_mono {c : s3b_Ctx} {rL₁ xL₁ rL₂ xL₂ : Bool}
    {m₁ m₂ : BorrowLinkMode} {localsS localsT : List LocalSlotRef}
    {epochs : List Nat} {nextEpoch : Nat} {nodesS nodesT : List BorrowNode}
    {nextTagS nextTagT : Nat}
    {pairMap : LocalId → Nat → List (Nat × Nat)}
    (hLe : absLe (.reachable rL₁ xL₁ m₁) (.reachable rL₂ xL₂ m₂) = true)
    (hCore : s3b_CoreInv c rL₁ xL₁ m₁ localsS localsT epochs nextEpoch
      nodesS nodesT nextTagS nextTagT pairMap) :
    s3b_CoreInv c rL₂ xL₂ m₂ localsS localsT epochs nextEpoch
      nodesS nodesT nextTagS nextTagT pairMap := by
  dsimp [absLe] at hLe
  let ⟨h12, hMLe⟩ := bool_and_true hLe
  let ⟨hR, hX⟩ := bool_and_true h12
  exact {
    hCore with
    hRLiveSound := fun hr2 => hCore.hRLiveSound (by rw [hr2] at hR; exact hR)
    hXLiveSound := fun hx2 => hCore.hXLiveSound (by rw [hx2] at hX; exact hX)
    hTargetInv := fun epX optX hEp hLX =>
      s3b_TargetLiveInv_mono hMLe (hCore.hTargetInv epX optX hEp hLX)
  }

private theorem s3b_CoreInv_setLiveOther {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT localsS' localsT' : List LocalSlotRef}
    {epochs : List Nat} {nextEpoch ntS ntT : Nat}
    {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {dstLoc : LocalId} {optOld : Option ValRef}
    {slNewS slNewT : LocalSlotRef}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hNeR : dstLoc ≠ c.r)
    (hOldLive : Trusted.MirSemantics.getElem? localsS dstLoc =
      some (.live optOld))
    (hSetS : setElem? localsS dstLoc slNewS = some localsS')
    (hSetT : setElem? localsT dstLoc slNewT = some localsT')
    (hNewLive : s3b_slotIsLive slNewS = true)
    (hNewRel : s3b_SlotRel c epochs nextEpoch ntS ntT pm slNewS slNewT) :
    s3b_CoreInv c rL xL mode localsS' localsT' epochs nextEpoch
      nodesS nodesT ntS ntT pm := by
  have hRNeDst : c.r ≠ dstLoc := fun h => hNeR h.symm
  refine {
    hCore with
    hLenLocS := (setElem?_length hSetS).trans hCore.hLenLocS
    hLenLocT := (setElem?_length hSetT).trans hCore.hLenLocT
    hSlotsOther := ?_
    hSlotRLiveEq := fun slS slT hGS hGT => by
      rw [setElem?_getElem?_ne hSetS hRNeDst] at hGS
      rw [setElem?_getElem?_ne hSetT hRNeDst] at hGT
      exact hCore.hSlotRLiveEq slS slT hGS hGT
    hRLiveSound := fun hr slS hGS => by
      rw [setElem?_getElem?_ne hSetS hRNeDst] at hGS
      exact hCore.hRLiveSound hr slS hGS
    hXLiveSound := fun hx slX hGX => by
      cases hEqX : Nat.beq c.x dstLoc with
      | true =>
        have eX := nat_beq_eq hEqX; subst eX
        rw [setElem?_getElem?_same hSetS] at hGX
        injection hGX with eSl; rw [← eSl]; exact hNewLive
      | false =>
        rw [setElem?_getElem?_ne hSetS (nat_ne_of_beq_false hEqX)] at hGX
        exact hCore.hXLiveSound hx slX hGX
    hTargetInv := fun epX optX hEpX hLX' => by
      cases hEqX : Nat.beq c.x dstLoc with
      | true =>
        have eX := nat_beq_eq hEqX; subst eX
        exact s3b_TargetLiveInv_setOther hNeR hSetS
          (hCore.hTargetInv epX optOld hEpX hOldLive)
      | false =>
        rw [setElem?_getElem?_ne hSetS (nat_ne_of_beq_false hEqX)] at hLX'
        exact s3b_TargetLiveInv_setOther hNeR hSetS
          (hCore.hTargetInv epX optX hEpX hLX')
  }
  · intro loc slS slT hLocNeR hGS hGT
    cases hEq : Nat.beq loc dstLoc with
    | true =>
      have eL := nat_beq_eq hEq; subst eL
      rw [setElem?_getElem?_same hSetS] at hGS
      rw [setElem?_getElem?_same hSetT] at hGT
      injection hGS with eS; injection hGT with eT
      rw [← eS, ← eT]; exact hNewRel
    | false =>
      have hNe := nat_ne_of_beq_false hEq
      rw [setElem?_getElem?_ne hSetS hNe] at hGS
      rw [setElem?_getElem?_ne hSetT hNe] at hGT
      exact hCore.hSlotsOther loc slS slT hLocNeR hGS hGT

/-! ### 3. Tree Borrows Access, Allocation, & Pointee-Validation Helpers -/

private theorem s3b_derefPointeeSlot_rel {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {expectedTy : MirTy} {ptrS ptrT : LocalPtr}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hNeR : ptrS.targetLocal ≠ c.r)
    (hLocEq : ptrS.targetLocal = ptrT.targetLocal)
    (hEpEq : ptrS.targetEpoch = ptrT.targetEpoch) :
    match derefPointeeSlot c.bodySrc.locals localsS epochs expectedTy ptrS,
        derefPointeeSlot c.bodyTgt.locals localsT epochs expectedTy ptrT with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok optS, .ok optT =>
      s3b_OptValRel c epochs nextEpoch ntS ntT pm optS optT
    | _, _ => False := by
  unfold derefPointeeSlot
  rw [← hLocEq, ← hEpEq, s3b_ctx_getElem_localsTgt_ne c hNeR]
  cases Trusted.MirSemantics.getElem? c.bodySrc.locals ptrS.targetLocal with
  | none =>
    cases Trusted.MirSemantics.getElem? localsS ptrS.targetLocal <;>
      cases Trusted.MirSemantics.getElem? localsT ptrS.targetLocal <;>
      cases Trusted.MirSemantics.getElem? epochs ptrS.targetLocal <;> rfl
  | some tgtDeclTy =>
    cases hLS : Trusted.MirSemantics.getElem? localsS ptrS.targetLocal with
    | none =>
      have hGe : localsT.length ≤ ptrS.targetLocal := by
        rw [hCore.hLenLocT, ← hCore.hLenLocS]
        exact getElem?_none_ge hLS
      rw [getElem?_none_of_ge hGe]
    | some slS =>
      have hLt : ptrS.targetLocal < localsT.length := by
        rw [hCore.hLenLocT, ← hCore.hLenLocS]
        exact getElem?_some_lt hLS
      let ⟨slT, hLT⟩ := getElem?_some_of_lt localsT ptrS.targetLocal hLt
      rw [hLT]
      have hSlRel := hCore.hSlotsOther ptrS.targetLocal slS slT hNeR hLS hLT
      cases Trusted.MirSemantics.getElem? epochs ptrS.targetLocal with
      | none => rfl
      | some tgtEpoch =>
        dsimp
        cases !MirTy.beq tgtDeclTy expectedTy with
        | true => rfl
        | false =>
          dsimp
          cases slS with
          | dead =>
            cases slT with
            | dead => rfl
            | live _ => exact False.elim hSlRel
          | live oS =>
            cases slT with
            | dead => exact False.elim hSlRel
            | live oT =>
              dsimp
              cases !Nat.beq tgtEpoch ptrS.targetEpoch with
              | true => rfl
              | false => exact hSlRel

private theorem s3b_validateRuntimeValRef_eq {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {dstTy : MirTy} {vS vT : ValRef}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hV : s3b_ValRel c epochs nextEpoch ntS ntT pm vS vT) :
    validateRuntimeValRef c.bodySrc.locals localsS epochs dstTy vS =
      validateRuntimeValRef c.bodyTgt.locals localsT epochs dstTy vT := by
  unfold validateRuntimeValRef
  rw [s3b_ValRel_checkValRef dstTy hV]
  cases !checkValRef vT dstTy with
  | true => rfl
  | false =>
    dsimp
    cases vS with
    | base _ =>
      cases vT with
      | base _ => rfl
      | localPtr _ _ => exact False.elim hV
    | localPtr pS tyS =>
      cases vT with
      | base _ => exact False.elim hV
      | localPtr pT tyT =>
        let ⟨hTy, hNeR, hLoc, hEp, _, _, _, _⟩ := hV
        subst hTy
        cases tyS with
        | ref _ innerTy =>
          dsimp
          cases !isOpsemInhabitedTy innerTy with
          | true => rfl
          | false =>
            dsimp
            have hDeref :=
              s3b_derefPointeeSlot_rel (expectedTy := innerTy) hCore hNeR hLoc
                hEp
            cases h1 : derefPointeeSlot c.bodySrc.locals localsS epochs
                innerTy pS with
            | error k1 =>
              rw [h1] at hDeref
              cases h2 : derefPointeeSlot c.bodyTgt.locals localsT epochs
                  innerTy pT with
              | error k2 => rw [h2] at hDeref; rw [hDeref]
              | ok _ => rw [h2] at hDeref; exact False.elim hDeref
            | ok _ =>
              rw [h1] at hDeref
              cases h2 : derefPointeeSlot c.bodyTgt.locals localsT epochs
                  innerTy pT with
              | error _ => rw [h2] at hDeref; exact False.elim hDeref
              | ok _ => rfl
        | rawPtr _ _ => rfl
        | _ => rfl

private theorem s3b_performTbRootAccess_bounds (epochs : List Nat)
    (loc : LocalId) (ty : MirTy) (kind : TbAccessKind)
    {nextEpoch nt : Nat} {nodes : List BorrowNode}
    (hEpLt : nodes.all (fun n => Nat.blt n.targetEpoch nextEpoch) = true)
    (hB : rp_NodesBounded 1 nt nodes) :
    (performTbRootAccess epochs loc ty kind nodes).all
      (fun n => Nat.blt n.targetEpoch nextEpoch) = true ∧
    rp_NodesBounded 1 nt (performTbRootAccess epochs loc ty kind nodes) := by
  unfold performTbRootAccess
  cases isZeroSizedTy ty with
  | true => exact ⟨hEpLt, hB⟩
  | false =>
    dsimp
    cases Trusted.MirSemantics.getElem? epochs loc with
    | none => exact ⟨hEpLt, hB⟩
    | some _ =>
      exact ⟨rp_tbForeignAccessAt_epoch_lt hEpLt,
        rp_tbForeignAccessAt_bounded hB⟩

private theorem s3b_tbRoot_nonTarget {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {loc : LocalId} {ty : MirTy} (kind : TbAccessKind)
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hLocTy : Trusted.MirSemantics.getElem? c.bodySrc.locals loc = some ty)
    (hCond : loc ≠ c.x ∨ c.trackTb = false) :
    s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      (performTbRootAccess epochs loc ty kind nodesS)
      (performTbRootAccess epochs loc ty kind nodesT) ntS ntT pm := by
  let ⟨hSEp, hBS⟩ :=
    s3b_performTbRootAccess_bounds epochs loc ty kind
      hCore.hNodesSEpLt hCore.hBoundedS
  let ⟨hTEp, hBT⟩ :=
    s3b_performTbRootAccess_bounds epochs loc ty kind
      hCore.hNodesTEpLt hCore.hBoundedT
  refine {
    hCore with
    hNodesSEpLt := hSEp
    hNodesTEpLt := hTEp
    hBoundedS := hBS
    hBoundedT := hBT
    hNoTargetRS :=
      performTbRootAccess_preserves_noTarget c.r loc epochs ty kind
        hCore.hNoTargetRS
    hNoTargetRT :=
      performTbRootAccess_preserves_noTarget c.r loc epochs ty kind
        hCore.hNoTargetRT
    hNonXRel := ?_
    hTargetInv := ?_
  }
  · intro loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
    have hBase := hCore.hNonXRel loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
    unfold performTbRootAccess
    cases isZeroSizedTy ty with
    | true => exact hBase
    | false =>
      dsimp
      cases hELoc : Trusted.MirSemantics.getElem? epochs loc with
      | none => exact hBase
      | some epLoc =>
        cases hEqL : Nat.beq loc' loc with
        | true =>
          have eL := nat_beq_eq hEqL; subst eL
          rw [hELoc] at hEp'; injection hEp' with eE; subst eE
          rw [rp_nodesAt_tbForeignAccessAt_same,
              rp_nodesAt_tbForeignAccessAt_same]
          exact rp_ExactNodeRel_tbForeign kind hBase
        | false =>
          have hNeL : loc' ≠ loc ∨ ep' ≠ epLoc :=
            Or.inl (nat_ne_of_beq_false hEqL)
          rw [rp_nodesAt_tbForeignAccessAt_other hNeL,
              rp_nodesAt_tbForeignAccessAt_other hNeL]
          exact hBase
  · intro epX optX hEpX hLX
    have hTBase := hCore.hTargetInv epX optX hEpX hLX
    cases hCond with
    | inl hLocNeX =>
      unfold performTbRootAccess
      cases isZeroSizedTy ty with
      | true => exact hTBase
      | false =>
        dsimp
        cases Trusted.MirSemantics.getElem? epochs loc with
        | none => exact hTBase
        | some epLoc =>
          have hNe2 : c.x ≠ loc ∨ epX ≠ epLoc := Or.inl hLocNeX.symm
          unfold s3b_TargetLiveInv at hTBase
          unfold s3b_TargetLiveInv
          rw [rp_nodesAt_tbForeignAccessAt_other hNe2,
              rp_nodesAt_tbForeignAccessAt_other hNe2]
          exact hTBase
    | inr hTrFalse =>
      cases hEqX : Nat.beq loc c.x with
      | false =>
        have hLocNeX := nat_ne_of_beq_false hEqX
        unfold performTbRootAccess
        cases isZeroSizedTy ty with
        | true => exact hTBase
        | false =>
          dsimp
          cases Trusted.MirSemantics.getElem? epochs loc with
          | none => exact hTBase
          | some epLoc =>
            have hNe2 : c.x ≠ loc ∨ epX ≠ epLoc := Or.inl hLocNeX.symm
            unfold s3b_TargetLiveInv at hTBase
            unfold s3b_TargetLiveInv
            rw [rp_nodesAt_tbForeignAccessAt_other hNe2,
                rp_nodesAt_tbForeignAccessAt_other hNe2]
            exact hTBase
      | true =>
        have eX := nat_beq_eq hEqX; subst eX
        have hTyEq : ty = c.xTy := by
          rw [c.hGetXSrc] at hLocTy; injection hLocTy with e; exact e.symm
        subst hTyEq
        unfold s3b_TargetLiveInv at hTBase
        unfold s3b_TargetLiveInv
        rw [if_bool_false hTrFalse] at hTBase
        rw [if_bool_false hTrFalse]
        unfold performTbRootAccess
        cases hZ : isZeroSizedTy c.xTy with
        | true =>
          rw [if_bool_true hZ] at hTBase
          dsimp
          exact hTBase
        | false =>
          rw [if_bool_false hZ] at hTBase
          dsimp
          rw [hEpX]
          dsimp
          rw [rp_nodesAt_tbForeignAccessAt_same,
              rp_nodesAt_tbForeignAccessAt_same]
          exact ⟨rp_ExactNodeRel_tbForeign kind hTBase.1, hTBase.2⟩

private noncomputable def s3b_modeAfterRootTarget (kind : TbAccessKind)
    (mode : BorrowLinkMode) : BorrowLinkMode :=
  match mode with
  | .delegated => .delegated
  | .clean => .clean
  | m =>
    match kind with
    | .write => .clean
    | .read =>
      match m with
      | .unique => .frozen
      | m0 => m0

private noncomputable def s3b_modeAfterRoot (c : s3b_Ctx) (loc : LocalId)
    (kind : TbAccessKind) (mode : BorrowLinkMode) : BorrowLinkMode :=
  if c.trackTb && Nat.beq loc c.x then
    s3b_modeAfterRootTarget kind mode
  else
    mode

private theorem s3b_tbRoot_targetTrack {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    (kind : TbAccessKind)
    (hTr : c.trackTb = true)
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm) :
    s3b_CoreInv c rL xL (s3b_modeAfterRootTarget kind mode) localsS localsT
      epochs nextEpoch
      (performTbRootAccess epochs c.x c.xTy kind nodesS)
      (performTbRootAccess epochs c.x c.xTy kind nodesT) ntS ntT pm := by
  have hNZ : isZeroSizedTy c.xTy = false := by
    have h1 := c.hTrackTb
    rw [hTr] at h1
    exact bool_not_true (bool_and_true h1.symm).2
  let ⟨hSEp, hBS⟩ :=
    s3b_performTbRootAccess_bounds epochs c.x c.xTy kind
      hCore.hNodesSEpLt hCore.hBoundedS
  let ⟨hTEp, hBT⟩ :=
    s3b_performTbRootAccess_bounds epochs c.x c.xTy kind
      hCore.hNodesTEpLt hCore.hBoundedT
  refine {
    hCore with
    hNodesSEpLt := hSEp
    hNodesTEpLt := hTEp
    hBoundedS := hBS
    hBoundedT := hBT
    hNoTargetRS :=
      performTbRootAccess_preserves_noTarget c.r c.x epochs c.xTy kind
        hCore.hNoTargetRS
    hNoTargetRT :=
      performTbRootAccess_preserves_noTarget c.r c.x epochs c.xTy kind
        hCore.hNoTargetRT
    hNonXRel := ?_
    hTargetInv := ?_
  }
  · intro loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
    have hBase := hCore.hNonXRel loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
    unfold performTbRootAccess
    rw [if_bool_false hNZ, if_bool_false hNZ]
    cases Trusted.MirSemantics.getElem? epochs c.x with
    | none => exact hBase
    | some epX =>
      have hNe : loc' ≠ c.x ∨ ep' ≠ epX := Or.inl hNeX'
      rw [rp_nodesAt_tbForeignAccessAt_other hNe,
          rp_nodesAt_tbForeignAccessAt_other hNe]
      exact hBase
  · intro epX optX hEpX hLX
    have hTBase := hCore.hTargetInv epX optX hEpX hLX
    unfold performTbRootAccess
    rw [if_bool_false hNZ, if_bool_false hNZ, hEpX]
    dsimp
    unfold s3b_TargetLiveInv at hTBase
    unfold s3b_TargetLiveInv
    rw [if_bool_true hTr] at hTBase
    rw [if_bool_true hTr]
    cases mode with
    | delegated =>
      dsimp [s3b_modeAfterRootTarget]
      rw [rp_nodesAt_tbForeignAccessAt_same, rp_nodesAt_tbForeignAccessAt_same]
      cases hTBase with
      | inl hC => exact Or.inl (rp_DelegatedCopyRel_tbForeign kind hC)
      | inr hR => exact Or.inr (rp_DelegatedReborrowRel_tbForeign kind hR)
    | clean =>
      dsimp [s3b_modeAfterRootTarget]
      rw [rp_nodesAt_tbForeignAccessAt_same, rp_nodesAt_tbForeignAccessAt_same]
      let ⟨hNT, hPM, hRoot⟩ := hTBase
      rw [hNT]
      exact ⟨rfl, hPM, rp_allRootParents_tbForeign hRoot⟩
    | reserved =>
      let ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLR, hFind, hPA⟩ := hTBase
      cases kind with
      | write =>
        dsimp [s3b_modeAfterRootTarget]
        rw [rp_nodesAt_tbForeignAccessAt_same,
            rp_nodesAt_tbForeignAccessAt_same, hNT]
        exact ⟨rfl, hPM, rp_allRootParents_tbForeign hRoot⟩
      | read =>
        dsimp [s3b_modeAfterRootTarget]
        rw [rp_nodesAt_tbForeignAccessAt_same,
            rp_nodesAt_tbForeignAccessAt_same, hNT]
        refine ⟨rfl, hPM, rp_allRootParents_tbForeign hRoot, tagR,
          tbForeignStep .read permR, hTLt, hLR,
          rp_findPermAt_tbForeign .read hFind, ?_⟩
        cases hPA with
        | inl h1 => rw [h1.2]; exact Or.inl ⟨h1.1, rfl⟩
        | inr h2 => rw [h2.2]; exact Or.inr ⟨h2.1, rfl⟩
    | unique =>
      let ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLR, hFind, hPA⟩ := hTBase
      cases kind with
      | write =>
        dsimp [s3b_modeAfterRootTarget]
        rw [rp_nodesAt_tbForeignAccessAt_same,
            rp_nodesAt_tbForeignAccessAt_same, hNT]
        exact ⟨rfl, hPM, rp_allRootParents_tbForeign hRoot⟩
      | read =>
        dsimp [s3b_modeAfterRootTarget]
        rw [rp_nodesAt_tbForeignAccessAt_same,
            rp_nodesAt_tbForeignAccessAt_same, hNT]
        refine ⟨rfl, hPM, rp_allRootParents_tbForeign hRoot, tagR,
          tbForeignStep .read permR, hTLt, hLR,
          rp_findPermAt_tbForeign .read hFind, ?_⟩
        cases hPA with
        | inl h1 =>
          cases h1.2 with
          | inl hp => rw [hp]; exact Or.inl ⟨h1.1, Or.inl rfl⟩
          | inr hp => rw [hp]; exact Or.inl ⟨h1.1, Or.inr (Or.inr rfl)⟩
        | inr h2 => rw [h2.2]; exact Or.inr ⟨h2.1, rfl⟩
    | frozen =>
      let ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLR, hFind, hPA⟩ := hTBase
      cases kind with
      | write =>
        dsimp [s3b_modeAfterRootTarget]
        rw [rp_nodesAt_tbForeignAccessAt_same,
            rp_nodesAt_tbForeignAccessAt_same, hNT]
        exact ⟨rfl, hPM, rp_allRootParents_tbForeign hRoot⟩
      | read =>
        dsimp [s3b_modeAfterRootTarget]
        rw [rp_nodesAt_tbForeignAccessAt_same,
            rp_nodesAt_tbForeignAccessAt_same, hNT]
        refine ⟨rfl, hPM, rp_allRootParents_tbForeign hRoot, tagR,
          tbForeignStep .read permR, hTLt, hLR,
          rp_findPermAt_tbForeign .read hFind, ?_⟩
        cases hPA with
        | inl h1 =>
          cases h1.2 with
          | inl hp => rw [hp]; exact Or.inl ⟨h1.1, Or.inl rfl⟩
          | inr hRest =>
            cases hRest with
            | inl hp => rw [hp]; exact Or.inl ⟨h1.1, Or.inr (Or.inr rfl)⟩
            | inr hp => rw [hp]; exact Or.inl ⟨h1.1, Or.inr (Or.inr rfl)⟩
        | inr h2 => rw [h2.2]; exact Or.inr ⟨h2.1, rfl⟩

private theorem s3b_tbRoot_any {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {loc : LocalId} {ty : MirTy} (kind : TbAccessKind)
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hLocTy : Trusted.MirSemantics.getElem? c.bodySrc.locals loc = some ty) :
    s3b_CoreInv c rL xL (s3b_modeAfterRoot c loc kind mode) localsS localsT
      epochs nextEpoch
      (performTbRootAccess epochs loc ty kind nodesS)
      (performTbRootAccess epochs loc ty kind nodesT) ntS ntT pm := by
  unfold s3b_modeAfterRoot
  cases hTr : c.trackTb with
  | false =>
    dsimp
    exact s3b_tbRoot_nonTarget kind hCore hLocTy (Or.inr hTr)
  | true =>
    cases hEqX : Nat.beq loc c.x with
    | false =>
      dsimp
      exact s3b_tbRoot_nonTarget kind hCore hLocTy
        (Or.inl (nat_ne_of_beq_false hEqX))
    | true =>
      dsimp
      have eX := nat_beq_eq hEqX; subst eX
      have hTyEq : ty = c.xTy := by
        rw [c.hGetXSrc] at hLocTy; injection hLocTy with e; exact e.symm
      subst hTyEq
      exact s3b_tbRoot_targetTrack kind hTr hCore

private theorem s3b_tbDerived_rel {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {loc : LocalId} {ep tagS tagT : Nat} {ty : MirTy} {optLoc : Option ValRef}
    (kind : TbAccessKind)
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hDecl : Trusted.MirSemantics.getElem? c.bodySrc.locals loc = some ty)
    (hEp : Trusted.MirSemantics.getElem? epochs loc = some ep)
    (hLive : Trusted.MirSemantics.getElem? localsS loc = some (.live optLoc))
    (hTags :
      isZeroSizedTy ty = false →
      if c.trackTb && Nat.beq loc c.x then
        1 ≤ tagS ∧ 1 ≤ tagT ∧ rp_hasPair (pm c.x ep) tagS tagT = true
      else
        rp_tagPairValid (pm loc ep) tagS tagT) :
    match performTbAccess loc ep ty kind tagS nodesS,
        performTbAccess loc ep ty kind tagT nodesT with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok nodesS', .ok nodesT' =>
      s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
        nodesS' nodesT' ntS ntT pm
    | _, _ => False := by
  cases hZ : isZeroSizedTy ty with
  | true =>
    unfold performTbAccess
    rw [if_bool_true hZ, if_bool_true hZ]
    exact hCore
  | false =>
    have hTagInfo := hTags hZ
    have hLocS :=
      rp_performTbAccess_local (loc := loc) (ep := ep) (ty := ty)
        (kind := kind) (accessTag := tagS) hCore.hBoundedS
    have hLocT :=
      rp_performTbAccess_local (loc := loc) (ep := ep) (ty := ty)
        (kind := kind) (accessTag := tagT) hCore.hBoundedT
    have hBSLoc := rp_NodesBounded_nodesAt loc ep hCore.hBoundedS
    have hBTLoc := rp_NodesBounded_nodesAt loc ep hCore.hBoundedT
    have hLocalSim :
        match performTbAccess loc ep ty kind tagS (rp_nodesAt loc ep nodesS),
            performTbAccess loc ep ty kind tagT (rp_nodesAt loc ep nodesT) with
        | .error k₁, .error k₂ => k₁ = k₂
        | .ok lnsS', .ok lnsT' =>
          (loc ≠ c.x →
            rp_ExactNodeRel loc ep [] (pm loc ep) lnsS' lnsT') ∧
          (loc = c.x →
            if c.trackTb then
              mode = .delegated ∧
              (rp_DelegatedCopyRel c.x ep [] (pm c.x ep) lnsS' lnsT' ∨
                rp_DelegatedReborrowRel c.x ep (pm c.x ep) lnsS' lnsT')
            else
              rp_ExactNodeRel c.x ep [] (pm c.x ep) lnsS' lnsT')
        | _, _ => False := by
      cases hEqX : Nat.beq loc c.x with
      | false =>
        have hNeX := nat_ne_of_beq_false hEqX
        have hCFalse : (c.trackTb && Nat.beq loc c.x) = false := by
          rw [hEqX]; cases c.trackTb <;> rfl
        rw [if_bool_false hCFalse] at hTagInfo
        have hEx := hCore.hNonXRel loc ep ty hNeX hDecl hEp hZ
        have hRes :=
          rp_ExactRel_performTbAccess (ty := ty) (kind := kind)
            hEx hBSLoc hBTLoc hTagInfo
        cases hL1 : performTbAccess loc ep ty kind tagS
            (rp_nodesAt loc ep nodesS) with
        | error _ =>
          rw [hL1] at hRes
          cases hL2 : performTbAccess loc ep ty kind tagT
              (rp_nodesAt loc ep nodesT) with
          | error _ => rw [hL2] at hRes; exact hRes
          | ok _ => rw [hL2] at hRes; exact False.elim hRes
        | ok _ =>
          rw [hL1] at hRes
          cases hL2 : performTbAccess loc ep ty kind tagT
              (rp_nodesAt loc ep nodesT) with
          | error _ => rw [hL2] at hRes; exact False.elim hRes
          | ok _ =>
            rw [hL2] at hRes
            exact ⟨fun _ => hRes, fun h => False.elim (hNeX h)⟩
      | true =>
        have eX := nat_beq_eq hEqX; subst eX
        have hTyEq : ty = c.xTy := by
          rw [c.hGetXSrc] at hDecl; injection hDecl with e; exact e.symm
        subst hTyEq
        have hTInv := hCore.hTargetInv ep optLoc hEp hLive
        unfold s3b_TargetLiveInv at hTInv
        cases hTr : c.trackTb with
        | false =>
          have hCF : (c.trackTb && Nat.beq c.x c.x) = false := by rw [hTr]; rfl
          rw [if_bool_false hCF] at hTagInfo
          rw [if_bool_false hTr, if_bool_false hZ] at hTInv
          have hRes :=
            rp_ExactRel_performTbAccess (ty := c.xTy) (kind := kind)
              hTInv.1 hBSLoc hBTLoc hTagInfo
          cases hL1 : performTbAccess c.x ep c.xTy kind tagS
              (rp_nodesAt c.x ep nodesS) with
          | error _ =>
            rw [hL1] at hRes
            cases hL2 : performTbAccess c.x ep c.xTy kind tagT
                (rp_nodesAt c.x ep nodesT) with
            | error _ => rw [hL2] at hRes; exact hRes
            | ok _ => rw [hL2] at hRes; exact False.elim hRes
          | ok _ =>
            rw [hL1] at hRes
            cases hL2 : performTbAccess c.x ep c.xTy kind tagT
                (rp_nodesAt c.x ep nodesT) with
            | error _ => rw [hL2] at hRes; exact False.elim hRes
            | ok _ =>
              rw [hL2] at hRes
              refine ⟨fun h => False.elim (h rfl), ?_⟩
              intro _
              dsimp
              exact hRes
        | true =>
          have hCT : (c.trackTb && Nat.beq c.x c.x) = true := by
            rw [hTr, nat_beq_refl]; rfl
          rw [if_bool_true hCT] at hTagInfo
          let ⟨hGeS, hGeT, hPair⟩ := hTagInfo
          rw [if_bool_true hTr] at hTInv
          have hModeDel : mode = .delegated := by
            cases mode with
            | delegated => rfl
            | reserved | unique | frozen =>
              rw [hTInv.2.1] at hPair; cases hPair
            | clean =>
              rw [hTInv.2.1] at hPair; cases hPair
          subst hModeDel
          dsimp at hTInv
          cases hTInv with
          | inl hDC =>
            have hRes :=
              rp_DelegatedCopyRel_performTbAccess (ty := c.xTy) (kind := kind)
                hDC hBSLoc hBTLoc hGeS hGeT hPair
            cases hL1 : performTbAccess c.x ep c.xTy kind tagS
                (rp_nodesAt c.x ep nodesS) with
            | error _ =>
              rw [hL1] at hRes
              cases hL2 : performTbAccess c.x ep c.xTy kind tagT
                  (rp_nodesAt c.x ep nodesT) with
              | error _ => rw [hL2] at hRes; exact hRes
              | ok _ => rw [hL2] at hRes; exact False.elim hRes
            | ok _ =>
              rw [hL1] at hRes
              cases hL2 : performTbAccess c.x ep c.xTy kind tagT
                  (rp_nodesAt c.x ep nodesT) with
              | error _ => rw [hL2] at hRes; exact False.elim hRes
              | ok _ =>
                rw [hL2] at hRes
                refine ⟨fun h => False.elim (h rfl), ?_⟩
                intro _
                dsimp
                exact ⟨rfl, Or.inl hRes⟩
          | inr hDR =>
            have hRes :=
              rp_DelegatedReborrowRel_performTbAccess (ty := c.xTy)
                (kind := kind) hDR hBSLoc hBTLoc hGeS hGeT hPair
            cases hL1 : performTbAccess c.x ep c.xTy kind tagS
                (rp_nodesAt c.x ep nodesS) with
            | error _ =>
              rw [hL1] at hRes
              cases hL2 : performTbAccess c.x ep c.xTy kind tagT
                  (rp_nodesAt c.x ep nodesT) with
              | error _ => rw [hL2] at hRes; exact hRes
              | ok _ => rw [hL2] at hRes; exact False.elim hRes
            | ok _ =>
              rw [hL1] at hRes
              cases hL2 : performTbAccess c.x ep c.xTy kind tagT
                  (rp_nodesAt c.x ep nodesT) with
              | error _ => rw [hL2] at hRes; exact False.elim hRes
              | ok _ =>
                rw [hL2] at hRes
                refine ⟨fun h => False.elim (h rfl), ?_⟩
                intro _
                dsimp
                exact ⟨rfl, Or.inr hRes⟩
    cases hGS : performTbAccess loc ep ty kind tagS nodesS with
    | error _ =>
      rw [hGS] at hLocS
      cases hLS : performTbAccess loc ep ty kind tagS
          (rp_nodesAt loc ep nodesS) with
      | ok _ => rw [hLS] at hLocS; exact False.elim hLocS
      | error _ =>
        rw [hLS] at hLocS hLocalSim
        cases hLT : performTbAccess loc ep ty kind tagT
            (rp_nodesAt loc ep nodesT) with
        | ok _ => rw [hLT] at hLocalSim; exact False.elim hLocalSim
        | error _ =>
          rw [hLT] at hLocT hLocalSim
          cases hGT : performTbAccess loc ep ty kind tagT nodesT with
          | ok _ => rw [hGT] at hLocT; exact False.elim hLocT
          | error _ =>
            rw [hGT] at hLocT
            exact hLocS.trans (hLocalSim.trans hLocT.symm)
    | ok nodesS' =>
      rw [hGS] at hLocS
      cases hLS : performTbAccess loc ep ty kind tagS
          (rp_nodesAt loc ep nodesS) with
      | error _ => rw [hLS] at hLocS; exact False.elim hLocS
      | ok _ =>
        rw [hLS] at hLocS hLocalSim
        cases hLT : performTbAccess loc ep ty kind tagT
            (rp_nodesAt loc ep nodesT) with
        | error _ => rw [hLT] at hLocalSim; exact False.elim hLocalSim
        | ok _ =>
          rw [hLT] at hLocT hLocalSim
          cases hGT : performTbAccess loc ep ty kind tagT nodesT with
          | error _ => rw [hGT] at hLocT; exact False.elim hLocT
          | ok nodesT' =>
            rw [hGT] at hLocT
            let ⟨hBS', hAtS, hOtherS, hEpLtS⟩ := hLocS
            let ⟨hBT', hAtT, hOtherT, hEpLtT⟩ := hLocT
            let ⟨hIfNeX, hIfEqX⟩ := hLocalSim
            refine {
              hCore with
              hNodesSEpLt := hEpLtS nextEpoch hCore.hNodesSEpLt
              hNodesTEpLt := hEpLtT nextEpoch hCore.hNodesTEpLt
              hBoundedS := hBS'
              hBoundedT := hBT'
              hNoTargetRS :=
                performTbAccess_preserves_noTarget c.r loc ep ty kind tagS
                  hCore.hNoTargetRS hGS
              hNoTargetRT :=
                performTbAccess_preserves_noTarget c.r loc ep ty kind tagT
                  hCore.hNoTargetRT hGT
              hNonXRel := ?_
              hTargetInv := ?_
            }
            · intro loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
              cases hEqL : Nat.beq loc' loc with
              | true =>
                have eL := nat_beq_eq hEqL; subst eL
                rw [hEp] at hEp'; injection hEp' with eE; subst eE
                rw [hAtS, hAtT]
                exact hIfNeX hNeX'
              | false =>
                have hNe : loc' ≠ loc ∨ ep' ≠ ep :=
                  Or.inl (nat_ne_of_beq_false hEqL)
                rw [hOtherS loc' ep' hNe, hOtherT loc' ep' hNe]
                exact hCore.hNonXRel loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
            · intro epX optX hEpX hLX
              cases hEqX : Nat.beq loc c.x with
              | false =>
                have hNe : c.x ≠ loc ∨ epX ≠ ep :=
                  Or.inl (fun h => nat_ne_of_beq_false hEqX h.symm)
                have hBase := hCore.hTargetInv epX optX hEpX hLX
                unfold s3b_TargetLiveInv at hBase
                unfold s3b_TargetLiveInv
                rw [hOtherS c.x epX hNe, hOtherT c.x epX hNe]
                exact hBase
              | true =>
                have eX := nat_beq_eq hEqX; subst eX
                rw [hEp] at hEpX; injection hEpX with eE; subst eE
                have hXInfo := hIfEqX rfl
                have hBase := hCore.hTargetInv ep optX hEp hLX
                unfold s3b_TargetLiveInv at hBase
                unfold s3b_TargetLiveInv
                rw [hAtS, hAtT]
                cases hTr : c.trackTb with
                | true =>
                  rw [if_bool_true hTr] at hXInfo
                  dsimp
                  rw [hXInfo.1]
                  exact hXInfo.2
                | false =>
                  rw [if_bool_false hTr] at hXInfo
                  have hTyEq : ty = c.xTy := by
                    rw [c.hGetXSrc] at hDecl; injection hDecl with e; exact e.symm
                  subst hTyEq
                  rw [if_bool_false hTr, if_bool_false hZ] at hBase
                  dsimp
                  rw [if_bool_false hZ]
                  exact ⟨hXInfo, hBase.2⟩

private theorem s3b_tbDerefR {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {epX : Nat} {optX : Option ValRef}
    (kind : TbAccessKind)
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hEpX : Trusted.MirSemantics.getElem? epochs c.x = some epX)
    (hLiveX : Trusted.MirSemantics.getElem? localsS c.x = some (.live optX))
    (hModeOk :
      (c.trackTb = false ∧ mode = .reserved) ∨
      (c.trackTb = true ∧ kind = .read ∧
        (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
      (c.trackTb = true ∧ kind = .write ∧ c.rIsMut = true ∧ mode = .unique)) :
    ∃ tagR nodesS',
      tagR < ntS ∧
      Trusted.MirSemantics.getElem? localsS c.r =
        some (.live (some (.localPtr ⟨c.x, epX, tagR⟩ c.rTy))) ∧
      performTbAccess c.x epX c.xTy kind tagR nodesS = .ok nodesS' ∧
      s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
        nodesS' (performTbRootAccess epochs c.x c.xTy kind nodesT) ntS ntT pm :=
by
  have hTInv := hCore.hTargetInv epX optX hEpX hLiveX
  cases hModeOk with
  | inl hNoTr =>
    let ⟨hTrF, hMRes⟩ := hNoTr
    subst hMRes
    unfold s3b_TargetLiveInv at hTInv
    rw [if_bool_false hTrF] at hTInv
    cases hZ : isZeroSizedTy c.xTy with
    | true =>
      rw [if_bool_true hZ] at hTInv
      let ⟨tagR, hTLt, hLR⟩ := hTInv rfl
      refine ⟨tagR, nodesS, hTLt, hLR, ?_, ?_⟩
      · unfold performTbAccess; rw [if_bool_true hZ]
      · unfold performTbRootAccess; rw [if_bool_true hZ]; exact hCore
    | false =>
      rw [if_bool_false hZ] at hTInv
      have hLR := hTInv.2 rfl
      have hStep :=
        s3b_tbRoot_nonTarget (loc := c.x) (ty := c.xTy) kind hCore c.hGetXSrc
          (Or.inr hTrF)
      have hRootEq :
          performTbRootAccess epochs c.x c.xTy kind nodesS =
            tbForeignAccessAt c.x epX kind nodesS := by
        unfold performTbRootAccess
        rw [if_bool_false hZ, hEpX]
      rw [hRootEq] at hStep
      refine ⟨0, tbForeignAccessAt c.x epX kind nodesS,
        hCore.hNextTagSPos, hLR, ?_, hStep⟩
      unfold performTbAccess
      rw [if_bool_false hZ]
      rfl
  | inr hTrCases =>
    have hTrT : c.trackTb = true := by
      cases hTrCases with
      | inl h1 => exact h1.1
      | inr h2 => exact h2.1
    have hNZ : isZeroSizedTy c.xTy = false := by
      have h1 := c.hTrackTb
      rw [hTrT] at h1
      exact bool_not_true (bool_and_true h1.symm).2
    unfold s3b_TargetLiveInv at hTInv
    rw [if_bool_true hTrT] at hTInv
    have hUnpack :
        rp_nodesAt c.x epX nodesT = [] ∧
        pm c.x epX = [] ∧
        rp_allRootParents c.x epX (rp_nodesAt c.x epX nodesS) ∧
        ∃ tagR permR,
          tagR < ntS ∧
          Trusted.MirSemantics.getElem? localsS c.r =
            some (.live (some (.localPtr ⟨c.x, epX, tagR⟩ c.rTy))) ∧
          rp_findPermAt? c.x epX tagR (rp_nodesAt c.x epX nodesS) =
            some permR ∧
          ∃ permR',
            tbChildStep kind permR = some permR' ∧
            rp_permAllowed c.rIsMut mode permR' := by
      cases hTrCases with
      | inl hRd =>
        let ⟨_, hK, hMOr⟩ := hRd
        subst hK
        cases hMOr with
        | inl hm =>
          subst hm
          let ⟨h1, h2, h3, tagR, permR, h4, h5, h6, hPA⟩ := hTInv
          refine ⟨h1, h2, h3, tagR, permR, h4, h5, h6, permR, ?_, hPA⟩
          cases hPA with
          | inl hp => rw [hp.2]; rfl
          | inr hp => rw [hp.2]; rfl
        | inr hMOr2 =>
          cases hMOr2 with
          | inl hm =>
            subst hm
            let ⟨h1, h2, h3, tagR, permR, h4, h5, h6, hPA⟩ := hTInv
            refine ⟨h1, h2, h3, tagR, permR, h4, h5, h6, permR, ?_, hPA⟩
            cases hPA with
            | inl hp =>
              cases hp.2 with
              | inl hp1 => rw [hp1]; rfl
              | inr hp2 => rw [hp2]; rfl
            | inr hp => rw [hp.2]; rfl
          | inr hm =>
            subst hm
            let ⟨h1, h2, h3, tagR, permR, h4, h5, h6, hPA⟩ := hTInv
            refine ⟨h1, h2, h3, tagR, permR, h4, h5, h6, permR, ?_, hPA⟩
            cases hPA with
            | inl hp =>
              cases hp.2 with
              | inl hp1 => rw [hp1]; rfl
              | inr hpRest =>
                cases hpRest with
                | inl hp2 => rw [hp2]; rfl
                | inr hp3 => rw [hp3]; rfl
            | inr hp => rw [hp.2]; rfl
      | inr hWr =>
        let ⟨_, hK, hMut, hm⟩ := hWr
        subst hK; subst hm
        let ⟨h1, h2, h3, tagR, permR, h4, h5, h6, hPA⟩ := hTInv
        refine ⟨h1, h2, h3, tagR, permR, h4, h5, h6, .unique, ?_,
          Or.inl ⟨hMut, Or.inr rfl⟩⟩
        cases hPA with
        | inl hp =>
          cases hp.2 with
          | inl hp1 => rw [hp1]; rfl
          | inr hp2 => rw [hp2]; rfl
        | inr hp => rw [hMut] at hp; cases hp.1
    let ⟨hNT, hPM, hRoot, tagR, permR, hTLt, hLR, hFind, permR', hCStep,
         hPA'⟩ := hUnpack
    have hBSLoc := rp_NodesBounded_nodesAt c.x epX hCore.hBoundedS
    let ⟨lnsS', hLocalOk, hRoot', hFind'⟩ :=
      rp_allRootParents_performTbAccess (ty := c.xTy) hNZ hBSLoc hRoot hFind
        hCStep
    have hLocS :=
      rp_performTbAccess_local (loc := c.x) (ep := epX) (ty := c.xTy)
        (kind := kind) (accessTag := tagR) hCore.hBoundedS
    rw [hLocalOk] at hLocS
    cases hGS : performTbAccess c.x epX c.xTy kind tagR nodesS with
    | error _ => rw [hGS] at hLocS; exact False.elim hLocS
    | ok nodesS' =>
      rw [hGS] at hLocS
      let ⟨hBS', hAtS', hOtherS', hEpLtS'⟩ := hLocS
      let ⟨hTEp, hBT'⟩ :=
        s3b_performTbRootAccess_bounds epochs c.x c.xTy kind
          hCore.hNodesTEpLt hCore.hBoundedT
      refine ⟨tagR, nodesS', hTLt, hLR, hGS,
        {
          hCore with
          hNodesSEpLt := hEpLtS' nextEpoch hCore.hNodesSEpLt
          hNodesTEpLt := hTEp
          hBoundedS := hBS'
          hBoundedT := hBT'
          hNoTargetRS :=
            performTbAccess_preserves_noTarget c.r c.x epX c.xTy kind tagR
              hCore.hNoTargetRS hGS
          hNoTargetRT :=
            performTbRootAccess_preserves_noTarget c.r c.x epochs c.xTy kind
              hCore.hNoTargetRT
          hNonXRel := ?_
          hTargetInv := ?_
        }⟩
      · intro loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
        have hNe : loc' ≠ c.x ∨ ep' ≠ epX := Or.inl hNeX'
        rw [hOtherS' loc' ep' hNe]
        unfold performTbRootAccess
        rw [if_bool_false hNZ, hEpX]
        dsimp
        rw [rp_nodesAt_tbForeignAccessAt_other hNe]
        exact hCore.hNonXRel loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
      · intro epX2 _ hEpX2 _
        rw [hEpX] at hEpX2; injection hEpX2 with eE; subst eE
        unfold performTbRootAccess
        rw [if_bool_false hNZ, hEpX]
        dsimp
        unfold s3b_TargetLiveInv
        rw [if_bool_true hTrT, hAtS', rp_nodesAt_tbForeignAccessAt_same, hNT]
        have hModeInv :
            rp_nodesAt c.x epX ([] : List BorrowNode) = [] ∧
            pm c.x epX = [] ∧
            rp_allRootParents c.x epX lnsS' ∧
            ∃ tR pR,
              tR < ntS ∧
              Trusted.MirSemantics.getElem? localsS c.r =
                some (.live (some (.localPtr ⟨c.x, epX, tR⟩ c.rTy))) ∧
              rp_findPermAt? c.x epX tR lnsS' = some pR ∧
              rp_permAllowed c.rIsMut mode pR :=
          ⟨rfl, hPM, hRoot', tagR, permR', hTLt, hLR, hFind', hPA'⟩
        cases mode with
        | reserved | unique | frozen => exact hModeInv
        | clean => exact ⟨rfl, hPM, hRoot'⟩
        | delegated =>
          cases hTrCases with
          | inl hRd =>
            cases hRd.2.2 with
            | inl h => cases h
            | inr h2 => cases h2 <;> cases ‹_›
          | inr hWr => cases hWr.2.2.2

private theorem s3b_allocateBorrowTag_pos {nt : Nat} (hPos : 1 ≤ nt) :
    allocateBorrowTag nt = (nt, nt + 1) := by
  unfold allocateBorrowTag
  rw [if_bool_false (nat_beq_false_of_ne (Nat.ne_of_gt hPos))]

private noncomputable def s3b_extPm (pm : LocalId → Nat → List (Nat × Nat))
    (loc : LocalId) (ep tS tT : Nat) : LocalId → Nat → List (Nat × Nat) :=
  fun l e =>
    if Nat.beq l loc && Nat.beq e ep then
      pm l e ++ [(tS, tT)]
    else
      pm l e

private theorem s3b_appendBorrowPair {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {loc : LocalId} {ep parS parT : Nat} {ptTy dstTy : MirTy}
    {optLoc : Option ValRef} {initPerm : BorrowPerm}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hLocNeR : loc ≠ c.r)
    (hDecl : Trusted.MirSemantics.getElem? c.bodySrc.locals loc = some ptTy)
    (hEp : Trusted.MirSemantics.getElem? epochs loc = some ep)
    (hLive : Trusted.MirSemantics.getElem? localsS loc = some (.live optLoc))
    (hParSLt : parS < ntS)
    (hParTLt : parT < ntT)
    (hNR : initPerm ≠ .rootOrRaw)
    (hParValid :
      isZeroSizedTy ptTy = false →
      if c.trackTb && Nat.beq loc c.x then
        mode = .delegated ∧ rp_hasPair (pm c.x ep) parS parT = true
      else
        rp_parentPairOk (pm loc ep) parS parT = true) :
    let nS : BorrowNode := ⟨ntS, parS, loc, ep, initPerm⟩
    let nT : BorrowNode := ⟨ntT, parT, loc, ep, initPerm⟩
    let pm' := s3b_extPm pm loc ep ntS ntT
    s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      (nodesS ++ [nS]) (nodesT ++ [nT]) (ntS + 1) (ntT + 1) pm' ∧
    s3b_ValRel c epochs nextEpoch (ntS + 1) (ntT + 1) pm'
      (.localPtr ⟨loc, ep, ntS⟩ dstTy) (.localPtr ⟨loc, ep, ntT⟩ dstTy) := by
  have hEpLt : ep < nextEpoch := s3b_epochs_getElem_lt hCore.hEpLt hEp
  have hEpBlt : Nat.blt ep nextEpoch = true := nat_lt_blt hEpLt
  let nS : BorrowNode := ⟨ntS, parS, loc, ep, initPerm⟩
  let nT : BorrowNode := ⟨ntT, parT, loc, ep, initPerm⟩
  let pm' := s3b_extPm pm loc ep ntS ntT
  have hAtNS : rp_nodeAt loc ep nS = true := rp_nodeAt_intro rfl rfl
  have hAtNT : rp_nodeAt loc ep nT = true := rp_nodeAt_intro rfl rfl
  have hPmMono : ∀ l e t1 t2,
      rp_hasPair (pm l e) t1 t2 = true →
      rp_hasPair (pm' l e) t1 t2 = true := by
    intro l e t1 t2 hp
    dsimp [pm', s3b_extPm]
    cases Nat.beq l loc && Nat.beq e ep with
    | false => exact hp
    | true =>
      dsimp
      rw [rp_hasPair_append]
      exact bool_or_intro_left _ hp
  have hNewPair : rp_hasPair (pm' loc ep) ntS ntT = true := by
    dsimp [pm', s3b_extPm]
    rw [nat_beq_refl loc, nat_beq_refl ep]
    dsimp
    rw [rp_hasPair_append]
    apply bool_or_intro_right
    dsimp [rp_hasPair]
    rw [nat_beq_refl ntS, nat_beq_refl ntT]
    rfl
  refine ⟨{
    hCore with
    hNodesSEpLt := by
      rw [list_all_append]
      exact bool_and_intro hCore.hNodesSEpLt (bool_and_intro hEpBlt rfl)
    hNodesTEpLt := by
      rw [list_all_append]
      exact bool_and_intro hCore.hNodesTEpLt (bool_and_intro hEpBlt rfl)
    hNextTagSPos := Nat.le_trans hCore.hNextTagSPos (Nat.le_succ _)
    hNextTagTPos := Nat.le_trans hCore.hNextTagTPos (Nat.le_succ _)
    hBoundedS :=
      rp_NodesBounded_append_one nS hCore.hBoundedS (Nat.le_refl _) hParSLt
    hBoundedT :=
      rp_NodesBounded_append_one nT hCore.hBoundedT (Nat.le_refl _) hParTLt
    hNoTargetRS := by
      unfold nodesNotTargeting
      rw [list_all_append]
      have hN : (!Nat.beq loc c.r) = true := by
        rw [nat_beq_false_of_ne hLocNeR]; rfl
      exact bool_and_intro hCore.hNoTargetRS (bool_and_intro hN rfl)
    hNoTargetRT := by
      unfold nodesNotTargeting
      rw [list_all_append]
      have hN : (!Nat.beq loc c.r) = true := by
        rw [nat_beq_false_of_ne hLocNeR]; rfl
      exact bool_and_intro hCore.hNoTargetRT (bool_and_intro hN rfl)
    hSlotsOther := fun l slS slT hNe hGS hGT =>
      s3b_SlotRel_mono_tags (Nat.le_succ _) (Nat.le_succ _) hPmMono
        (hCore.hSlotsOther l slS slT hNe hGS hGT)
    hNonXRel := ?_
    hTargetInv := ?_
  }, ?_⟩
  · intro loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
    rw [rp_nodesAt_append, rp_nodesAt_append]
    cases hEqL : Nat.beq loc' loc with
    | true =>
      have eL := nat_beq_eq hEqL; subst loc'
      rw [hEp] at hEp'; injection hEp' with eE; subst ep'
      have hTyEq : declTy' = ptTy := by
        rw [hDecl] at hDecl'; injection hDecl' with e; exact e.symm
      subst declTy'
      have hCF : (c.trackTb && Nat.beq loc c.x) = false := by
        rw [nat_beq_false_of_ne hNeX']; cases c.trackTb <;> rfl
      have hPOk := hParValid hNZ'
      rw [if_bool_false hCF] at hPOk
      dsimp [rp_nodesAt, pm', s3b_extPm]
      rw [if_bool_true hAtNS, if_bool_true hAtNT, nat_beq_refl, nat_beq_refl]
      dsimp
      exact rp_ExactNodeRel_append_one nS nT
        (hCore.hNonXRel loc ep ptTy hNeX' hDecl hEp hNZ')
        hAtNS hAtNT rfl hNR (by rw [List.nil_append]; exact hPOk)
    | false =>
      have hNe : loc' ≠ loc ∨ ep' ≠ ep := Or.inl (nat_ne_of_beq_false hEqL)
      dsimp [rp_nodesAt, pm', s3b_extPm]
      rw [if_bool_false (rp_nodeAt_false_of_ne hAtNS hNe),
          if_bool_false (rp_nodeAt_false_of_ne hAtNT hNe),
          hEqL, List.append_nil, List.append_nil]
      exact hCore.hNonXRel loc' ep' declTy' hNeX' hDecl' hEp' hNZ'
  · intro epX optX hEpX hLX
    have hBase := hCore.hTargetInv epX optX hEpX hLX
    cases hEqX : Nat.beq loc c.x with
    | false =>
      have hNe : c.x ≠ loc ∨ epX ≠ ep :=
        Or.inl (fun h => nat_ne_of_beq_false hEqX h.symm)
      have hCXF : (Nat.beq c.x loc && Nat.beq epX ep) = false := by
        rw [nat_beq_symm c.x loc, hEqX]; rfl
      unfold s3b_TargetLiveInv at hBase
      unfold s3b_TargetLiveInv
      dsimp [pm', s3b_extPm]
      rw [hCXF, rp_nodesAt_append, rp_nodesAt_append]
      dsimp [rp_nodesAt]
      rw [if_bool_false (rp_nodeAt_false_of_ne hAtNS hNe),
          if_bool_false (rp_nodeAt_false_of_ne hAtNT hNe),
          List.append_nil, List.append_nil]
      cases hTr : c.trackTb with
      | true =>
        rw [if_bool_true hTr] at hBase
        dsimp
        cases mode with
        | reserved | unique | frozen =>
          let ⟨h1, h2, h3, tagR, permR, hLt, h4, h5, h6⟩ := hBase
          exact ⟨h1, h2, h3, tagR, permR,
            Nat.lt_of_lt_of_le hLt (Nat.le_succ _), h4, h5, h6⟩
        | clean | delegated => exact hBase
      | false =>
        rw [if_bool_false hTr] at hBase
        dsimp
        cases hZ : isZeroSizedTy c.xTy with
        | true =>
          rw [if_bool_true hZ] at hBase
          dsimp
          intro hm
          let ⟨tagR, hLt, hLR⟩ := hBase hm
          exact ⟨tagR, Nat.lt_of_lt_of_le hLt (Nat.le_succ _), hLR⟩
        | false =>
          rw [if_bool_false hZ] at hBase
          dsimp
          exact hBase
    | true =>
      have eX := nat_beq_eq hEqX; subst eX
      rw [hEp] at hEpX; injection hEpX with eE; subst eE
      have hTyEq : ptTy = c.xTy := by
        rw [c.hGetXSrc] at hDecl; injection hDecl with e; exact e.symm
      subst hTyEq
      unfold s3b_TargetLiveInv at hBase
      unfold s3b_TargetLiveInv
      dsimp [pm', s3b_extPm]
      rw [nat_beq_refl c.x, nat_beq_refl ep, rp_nodesAt_append,
          rp_nodesAt_append]
      dsimp [rp_nodesAt]
      rw [if_bool_true hAtNS, if_bool_true hAtNT]
      cases hTr : c.trackTb with
      | false =>
        rw [if_bool_false hTr] at hBase
        dsimp
        cases hZ : isZeroSizedTy c.xTy with
        | true =>
          rw [if_bool_true hZ] at hBase
          dsimp
          intro hm
          let ⟨tagR, hTLt, hLR⟩ := hBase hm
          exact ⟨tagR, Nat.lt_of_lt_of_le hTLt (Nat.le_succ _), hLR⟩
        | false =>
          rw [if_bool_false hZ] at hBase
          dsimp
          have hPOk := hParValid hZ
          have hCF : (c.trackTb && Nat.beq c.x c.x) = false := by rw [hTr]; rfl
          rw [if_bool_false hCF] at hPOk
          exact ⟨rp_ExactNodeRel_append_one nS nT hBase.1 hAtNS hAtNT rfl hNR
            (by rw [List.nil_append]; exact hPOk), hBase.2⟩
      | true =>
        rw [if_bool_true hTr] at hBase
        dsimp
        have hNZ : isZeroSizedTy c.xTy = false := by
          have h1 := c.hTrackTb; rw [hTr] at h1
          exact bool_not_true (bool_and_true h1.symm).2
        have hPOk := hParValid hNZ
        have hCT : (c.trackTb && Nat.beq c.x c.x) = true := by
          rw [hTr, nat_beq_refl]; rfl
        rw [if_bool_true hCT] at hPOk
        let ⟨hMDel, hPairPar⟩ := hPOk
        subst hMDel
        dsimp at hBase
        dsimp
        have hBSLoc := rp_NodesBounded_nodesAt c.x ep hCore.hBoundedS
        cases hBase with
        | inl hDC =>
          exact Or.inl
            (rp_DelegatedCopyRel_append_one nS nT hDC hBSLoc (Nat.le_refl _)
              hAtNS hAtNT rfl hNR
              (by rw [List.nil_append]; exact bool_or_intro_right _ hPairPar))
        | inr hDR =>
          exact Or.inr
            (rp_DelegatedReborrowRel_append_one nS nT hDR hAtNS hAtNT rfl hNR
              hPairPar)
  · refine ⟨rfl, hLocNeR, rfl, rfl, hEpLt, Nat.lt_succ_self _,
      Nat.lt_succ_self _, ?_⟩
    intro _ _ _ _
    cases hCond : (c.trackTb && Nat.beq loc c.x) with
    | true =>
      dsimp
      have eX : loc = c.x := nat_beq_eq (bool_and_true hCond).2
      rw [← eX]
      exact ⟨hCore.hNextTagSPos, hCore.hNextTagTPos, hNewPair⟩
    | false =>
      dsimp
      exact Or.inr ⟨hCore.hNextTagSPos, hCore.hNextTagTPos, hNewPair⟩

/-! ### 4. Entry State Initialization Equivalence (`initStateRef`) -/

private theorem s3b_initLocals_slotRel (c : s3b_Ctx) (args : List Val)
    (epochs : List Nat) :
    ∀ (base : Nat) (tysS tysT : List MirTy) (loc : Nat) (slS slT : LocalSlotRef),
      tysS.length = tysT.length →
      (∀ j, base + j ≠ c.r →
        Trusted.MirSemantics.getElem? tysT j =
          Trusted.MirSemantics.getElem? tysS j) →
      base + loc ≠ c.r →
      Trusted.MirSemantics.getElem?
        (initLocalsRefLoop c.bodySrc args base tysS) loc = some slS →
      Trusted.MirSemantics.getElem?
        (initLocalsRefLoop c.bodyTgt args base tysT) loc = some slT →
      s3b_SlotRel c epochs 2 1 1 (fun _ _ => []) slS slT
  | _, [], [], _, _, _, _, _, _, hGS, _ => by cases hGS
  | _, [], _ :: _, _, _, _, hLen, _, _, _, _ => by cases hLen
  | _, _ :: _, [], _, _, _, hLen, _, _, _, _ => by cases hLen
  | base, tyS :: _, tyT :: _, 0, slS, slT, _, hAt, hNeR, hGS, hGT => by
    have h0Eq : some tyT = some tyS := hAt 0 (by rw [Nat.add_zero]; exact hNeR)
    injection h0Eq with hTyEq; subst hTyEq
    dsimp [initLocalsRefLoop, Trusted.MirSemantics.getElem?] at hGS hGT
    rw [c.hArgCntEq, s3b_ctx_hasStorageAnnotation_eq c base] at hGT
    injection hGS with eS; subst eS
    injection hGT with eT; subst eT
    cases Nat.beq base 0 with
    | true => exact s3b_SlotRel_liveUninit c epochs 2 1 1 _ tyT
    | false =>
      dsimp
      cases Nat.ble base c.bodySrc.argumentCount with
      | true =>
        dsimp
        cases Trusted.MirSemantics.getElem? args (base - 1) with
        | some _ => exact rfl
        | none => exact True.intro
      | false =>
        dsimp
        cases hasStorageAnnotation c.bodySrc base with
        | true => exact True.intro
        | false => exact s3b_SlotRel_liveUninit c epochs 2 1 1 _ tyT
  | base, _ :: restS, _ :: restT, k + 1, slS, slT, hLen, hAt, hNeR, hGS,
      hGT => by
    dsimp [initLocalsRefLoop, Trusted.MirSemantics.getElem?] at hGS hGT
    have hNeR' : (base + 1) + k ≠ c.r := by
      rw [s3b_add_succ_left base k]; exact hNeR
    exact s3b_initLocals_slotRel c args epochs (base + 1) restS restT k slS slT
      (Nat.succ.inj hLen)
      (fun j hj => by
        rw [s3b_add_succ_left base j] at hj
        exact hAt (j + 1) hj)
      hNeR' hGS hGT

private theorem s3b_checkArgsMatch_len :
    ∀ {args : List Val} {tys : List MirTy},
      checkArgsMatch args tys = true →
      args.length = tys.length
  | [], [], _ => rfl
  | _ :: _, [], h => by cases h
  | [], _ :: _, h => by cases h
  | _ :: vs, _ :: ts, h => by
    let ⟨_, hRest⟩ := bool_and_true h
    dsimp [List.length]
    rw [s3b_checkArgsMatch_len hRest]

private theorem s3b_take_length_of_le {α : Type} :
    ∀ {k : Nat} {xs : List α},
      k ≤ xs.length →
      (xs.take k).length = k
  | 0, _, _ => rfl
  | _ + 1, [], h => False.elim (Nat.not_succ_le_zero _ h)
  | k + 1, _ :: xs, h => by
    dsimp [List.take, List.length]
    rw [s3b_take_length_of_le (Nat.le_of_succ_le_succ h)]

private theorem s3b_initCoreInv (c : s3b_Ctx) (args : List Val)
    (hArgs :
      checkArgsMatch args
        ((c.bodySrc.locals.drop 1).take c.bodySrc.argumentCount) = true) :
    ∃ rL0 xL0 m0,
      getAbsState c.inStates 0 = .reachable rL0 xL0 m0 ∧
      s3b_CoreInv c rL0 xL0 m0
        (initLocalsRefLoop c.bodySrc args 0 c.bodySrc.locals)
        (initLocalsRefLoop c.bodyTgt args 0 c.bodyTgt.locals)
        (c.bodySrc.locals.map (fun _ => 1))
        2 [] [] 1 1 (fun _ _ => []) := by
  let localsS := initLocalsRefLoop c.bodySrc args 0 c.bodySrc.locals
  let localsT := initLocalsRefLoop c.bodyTgt args 0 c.bodyTgt.locals
  let epochs := c.bodySrc.locals.map (fun _ => 1)
  have hEntry := c.hEntryLe
  unfold initAbsState at hEntry
  cases hSt0 : getAbsState c.inStates 0 with
  | unreachable =>
    rw [hSt0] at hEntry; cases hEntry
  | reachable rL0 xL0 m0 =>
    rw [hSt0] at hEntry
    have hCoreInit :
        s3b_CoreInv c (!hasStorageAnnotation c.bodySrc c.r)
          (Nat.ble c.x c.bodySrc.argumentCount ||
            !hasStorageAnnotation c.bodySrc c.x)
          .clean localsS localsT epochs 2 [] [] 1 1 (fun _ _ => []) := by
      refine {
        hLenLocS := initLocalsRefLoop_length c.bodySrc args 0 c.bodySrc.locals
        hLenLocT :=
          (initLocalsRefLoop_length c.bodyTgt args 0 c.bodyTgt.locals).trans
            (s3b_ctx_localsTgt_len c)
        hLenEp := map_length_eq (fun _ => 1) c.bodySrc.locals
        hNextEpPos := Nat.le_succ 1
        hEpLt := by
          rw [list_all_map]
          exact list_all_of_forall_getElem? (fun _ _ _ => rfl)
        hNodesSEpLt := rfl
        hNodesTEpLt := rfl
        hNextTagSPos := Nat.le_refl 1
        hNextTagTPos := Nat.le_refl 1
        hBoundedS := .nil (Nat.le_refl 1)
        hBoundedT := .nil (Nat.le_refl 1)
        hNoTargetRS := rfl
        hNoTargetRT := rfl
        hSlotsOther := ?_
        hSlotRLiveEq := ?_
        hRLiveSound := ?_
        hXLiveSound := ?_
        hNonXRel := fun _ _ _ _ _ _ _ => .nil []
        hTargetInv := ?_
      }
      · intro loc slS slT hNeR hGS hGT
        exact s3b_initLocals_slotRel c args epochs 0
          c.bodySrc.locals c.bodyTgt.locals loc slS slT
          (s3b_ctx_localsTgt_len c).symm
          (fun j hj =>
            s3b_ctx_getElem_localsTgt_ne c
              (by rw [s3b_zero_add j] at hj; exact hj))
          (by rw [s3b_zero_add loc]; exact hNeR) hGS hGT
      · intro slS slT hGS hGT
        have hRS :=
          initLocalsRefLoop_getElem? c.bodySrc args 0 c.bodySrc.locals c.r
            c.rTy c.hGetRSrc
        have hRT :=
          initLocalsRefLoop_getElem? c.bodyTgt args 0 c.bodyTgt.locals c.r
            .unit (s3b_ctx_getElem_localsTgt_r c)
        rw [s3b_zero_add c.r,
            if_bool_false (nat_beq_false_of_ne (s3b_ctx_r_ne_zero c)),
            if_bool_false (nat_gt_ble_false c.hArgLtR)] at hRS
        rw [s3b_zero_add c.r, c.hArgCntEq,
            s3b_ctx_hasStorageAnnotation_eq c c.r,
            if_bool_false (nat_beq_false_of_ne (s3b_ctx_r_ne_zero c)),
            if_bool_false (nat_gt_ble_false c.hArgLtR)] at hRT
        rw [hRS] at hGS; injection hGS with eS; subst eS
        rw [hRT] at hGT; injection hGT with eT; subst eT
        cases hasStorageAnnotation c.bodySrc c.r with
        | true => rfl
        | false =>
          dsimp
          rw [s3b_slotIsLive_liveUninit, s3b_slotIsLive_liveUninit]
      · intro hRL slS hGS
        have hNoAnn : hasStorageAnnotation c.bodySrc c.r = false :=
          bool_not_true hRL
        have hRS :=
          initLocalsRefLoop_getElem? c.bodySrc args 0 c.bodySrc.locals c.r
            c.rTy c.hGetRSrc
        rw [s3b_zero_add c.r,
            if_bool_false (nat_beq_false_of_ne (s3b_ctx_r_ne_zero c)),
            if_bool_false (nat_gt_ble_false c.hArgLtR), hNoAnn] at hRS
        dsimp at hRS
        rw [hRS] at hGS; injection hGS with eS; subst eS
        exact s3b_slotIsLive_liveUninit c.rTy
      · intro hXL slX hGX
        have hXS :=
          initLocalsRefLoop_getElem? c.bodySrc args 0 c.bodySrc.locals c.x
            c.xTy c.hGetXSrc
        rw [s3b_zero_add c.x] at hXS
        rw [hXS] at hGX; injection hGX with eX; subst eX
        cases hXEq0 : Nat.beq c.x 0 with
        | true => exact s3b_slotIsLive_liveUninit c.xTy
        | false =>
          dsimp
          cases hBle : Nat.ble c.x c.bodySrc.argumentCount with
          | true =>
            dsimp
            have hArgLen : args.length = c.bodySrc.argumentCount := by
              have hDropLe :
                  c.bodySrc.argumentCount ≤ (c.bodySrc.locals.drop 1).length :=
              by
                cases hL : c.bodySrc.locals with
                | nil =>
                  have hLt := c.hRLt; rw [hL] at hLt; cases hLt
                | cons hd tail =>
                  dsimp [List.drop]
                  have hArgLtLen :
                      c.bodySrc.argumentCount < (hd :: tail).length := by
                    rw [← hL]
                    exact Nat.lt_trans c.hArgLtR c.hRLt
                  exact Nat.le_of_succ_le_succ hArgLtLen
              exact (s3b_checkArgsMatch_len hArgs).trans
                (s3b_take_length_of_le hDropLe)
            have hSubLt : c.x - 1 < args.length := by
              rw [hArgLen]
              cases hX0 : c.x with
              | zero => rw [hX0] at hXEq0; cases hXEq0
              | succ _ =>
                rw [hX0] at hBle
                dsimp
                exact Nat.lt_of_succ_le (nat_ble_le hBle)
            let ⟨_, hv⟩ := getElem?_some_of_lt args (c.x - 1) hSubLt
            rw [hv]
            rfl
          | false =>
            dsimp
            rw [hBle] at hXL
            have hNoAnn : hasStorageAnnotation c.bodySrc c.x = false :=
              bool_not_true hXL
            rw [hNoAnn]
            exact s3b_slotIsLive_liveUninit c.xTy
      · intro _ _ _ _
        unfold s3b_TargetLiveInv
        cases c.trackTb with
        | true => exact ⟨rfl, rfl, True.intro⟩
        | false =>
          dsimp
          cases isZeroSizedTy c.xTy with
          | true => intro h; cases h
          | false => exact ⟨.nil [], fun h => by cases h⟩
    exact ⟨rL0, xL0, m0, rfl, s3b_CoreInv_mono hEntry hCoreInit⟩

/-! ### 5. Small-Step Operand, Rvalue, Statement, & Terminator Simulation -/

private noncomputable def s3b_readXMode (mode : BorrowLinkMode) :
    BorrowLinkMode :=
  match mode with
  | .unique => .frozen
  | m => m

private noncomputable def s3b_writeXMode (mode : BorrowLinkMode) :
    BorrowLinkMode :=
  match mode with
  | .delegated => .delegated
  | _ => .clean

private theorem s3b_modeAfterRootTarget_read (mode : BorrowLinkMode) :
    s3b_modeAfterRootTarget .read mode = s3b_readXMode mode := by
  cases mode <;> rfl

private theorem s3b_modeAfterRootTarget_write (mode : BorrowLinkMode) :
    s3b_modeAfterRootTarget .write mode = s3b_writeXMode mode := by
  cases mode <;> rfl

private theorem s3b_readXMode_idem (mode : BorrowLinkMode) :
    s3b_readXMode (s3b_readXMode mode) = s3b_readXMode mode := by
  cases mode <;> rfl

private theorem s3b_writeXMode_idem (mode : BorrowLinkMode) :
    s3b_writeXMode (s3b_writeXMode mode) = s3b_writeXMode mode := by
  cases mode <;> rfl

private theorem s3b_readXMode_writeXMode (mode : BorrowLinkMode) :
    s3b_readXMode (s3b_writeXMode mode) = s3b_writeXMode mode := by
  cases mode <;> rfl

private theorem s3b_writeXMode_readXMode (mode : BorrowLinkMode) :
    s3b_writeXMode (s3b_readXMode mode) = s3b_writeXMode mode := by
  cases mode <;> rfl

private noncomputable def s3b_opNonRMode (c : s3b_Ctx) (opnd : Operand)
    (mode : BorrowLinkMode) : BorrowLinkMode :=
  if !c.trackTb then
    mode
  else if operandDirectMovesLocal c.x opnd then
    s3b_writeXMode mode
  else if operandMentionsLocal c.x opnd then
    s3b_readXMode mode
  else
    mode

private noncomputable def s3b_rvNonRMode (c : s3b_Ctx) (rv : Rvalue)
    (mode : BorrowLinkMode) : BorrowLinkMode :=
  if !c.trackTb then
    mode
  else if rvalueDirectMovesLocal c.x rv then
    s3b_writeXMode mode
  else if rvalueMentionsLocal c.x rv then
    s3b_readXMode mode
  else
    mode

private theorem s3b_opNonRMode_seq_aux (tr dL dR mL mR : Bool)
    (mode : BorrowLinkMode) :
    (if !tr then
       if !tr then mode
       else if dL then s3b_writeXMode mode
       else if mL then s3b_readXMode mode
       else mode
     else if dR then
       s3b_writeXMode
         (if !tr then mode
          else if dL then s3b_writeXMode mode
          else if mL then s3b_readXMode mode
          else mode)
     else if mR then
       s3b_readXMode
         (if !tr then mode
          else if dL then s3b_writeXMode mode
          else if mL then s3b_readXMode mode
          else mode)
     else
       if !tr then mode
       else if dL then s3b_writeXMode mode
       else if mL then s3b_readXMode mode
       else mode) =
    (if !tr then mode
     else if dL || dR then s3b_writeXMode mode
     else if mL || mR then s3b_readXMode mode
     else mode) := by
  cases tr <;> cases dL <;> cases dR <;> cases mL <;> cases mR <;>
    cases mode <;> rfl

private theorem s3b_modeAfterRoot_read_eq_aux (tr eqX : Bool)
    (mode : BorrowLinkMode) :
    (if tr && eqX then s3b_modeAfterRootTarget .read mode else mode) =
    (if !tr then mode
     else if false then s3b_writeXMode mode
     else if eqX then s3b_readXMode mode
     else mode) := by
  cases tr <;> cases eqX <;> cases mode <;> rfl

private theorem s3b_modeAfterRoot_move_unproj_aux (tr eqX : Bool)
    (mode : BorrowLinkMode) :
    (if tr && eqX then
       s3b_modeAfterRootTarget .write
         (if tr && eqX then s3b_modeAfterRootTarget .read mode else mode)
     else
       if tr && eqX then s3b_modeAfterRootTarget .read mode else mode) =
    (if !tr then mode
     else if (true && eqX) then s3b_writeXMode mode
     else if eqX then s3b_readXMode mode
     else mode) := by
  cases tr <;> cases eqX <;> cases mode <;> rfl

private theorem s3b_opNonRMode_seq {op : BinOp} (c : s3b_Ctx)
    (lhs rhs : Operand) (mode : BorrowLinkMode) :
    s3b_opNonRMode c rhs (s3b_opNonRMode c lhs mode) =
      s3b_rvNonRMode c (.binaryOp op lhs rhs) mode :=
  s3b_opNonRMode_seq_aux c.trackTb
    (operandDirectMovesLocal c.x lhs) (operandDirectMovesLocal c.x rhs)
    (operandMentionsLocal c.x lhs) (operandMentionsLocal c.x rhs) mode

private theorem s3b_resolveDerefPlace_nonR {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)} {ptrId : LocalId}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hNeR : ptrId ≠ c.r) :
    match resolveDerefPlaceRef c.bodySrc.locals localsS epochs nodesS ptrId,
        resolveDerefPlaceRef c.bodyTgt.locals localsT epochs nodesT ptrId with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (sR₁, pM₁, ptTy₁, ptrS, optS, nodesS'),
      .ok (sR₂, pM₂, ptTy₂, ptrT, optT, nodesT') =>
      ∃ declTy optTgtS,
        sR₁ = sR₂ ∧ pM₁ = pM₂ ∧ ptTy₁ = ptTy₂ ∧
        Trusted.MirSemantics.getElem? c.bodySrc.locals ptrId = some declTy ∧
        s3b_ValRel c epochs nextEpoch ntS ntT pm
          (.localPtr ptrS declTy) (.localPtr ptrT declTy) ∧
        Trusted.MirSemantics.getElem? c.bodySrc.locals ptrS.targetLocal =
          some ptTy₁ ∧
        Trusted.MirSemantics.getElem? epochs ptrS.targetLocal =
          some ptrS.targetEpoch ∧
        Trusted.MirSemantics.getElem? localsS ptrS.targetLocal =
          some (.live optTgtS) ∧
        s3b_OptValRel c epochs nextEpoch ntS ntT pm optS optT ∧
        s3b_CoreInv c rL xL (s3b_modeAfterRoot c ptrId .read mode)
          localsS localsT epochs nextEpoch nodesS' nodesT' ntS ntT pm
    | _, _ => False := by
  unfold resolveDerefPlaceRef
  rw [s3b_ctx_getElem_localsTgt_ne c hNeR]
  have hLenS : (!Nat.beq epochs.length localsS.length) = false := by
    rw [hCore.hLenEp, hCore.hLenLocS, nat_beq_refl]; rfl
  have hLenT : (!Nat.beq epochs.length localsT.length) = false := by
    rw [hCore.hLenEp, hCore.hLenLocT, nat_beq_refl]; rfl
  cases hBL : Trusted.MirSemantics.getElem? c.bodySrc.locals ptrId with
  | none => rfl
  | some ptrDeclTy =>
    dsimp
    cases ptrPointeeInfo? ptrDeclTy with
    | none => rfl
    | some info =>
      cases info with
      | mk isSR rest =>
        cases rest with
        | mk pMut ptTy =>
          dsimp
          rw [if_bool_false hLenS, if_bool_false hLenT]
          cases hLS : Trusted.MirSemantics.getElem? localsS ptrId with
          | none =>
            have hGe : localsT.length ≤ ptrId := by
              rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_none_ge hLS
            rw [getElem?_none_of_ge hGe]
          | some slS =>
            have hLt : ptrId < localsT.length := by
              rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_some_lt hLS
            let ⟨slT, hLT⟩ := getElem?_some_of_lt localsT ptrId hLt
            rw [hLT]
            have hSl := hCore.hSlotsOther ptrId slS slT hNeR hLS hLT
            cases slS with
            | dead =>
              cases slT with
              | dead => rfl
              | live _ => exact False.elim hSl
            | live oS =>
              cases slT with
              | dead => exact False.elim hSl
              | live oT =>
                cases oS with
                | none =>
                  cases oT with
                  | none => rfl
                  | some _ => exact False.elim hSl
                | some vS =>
                  cases oT with
                  | none => exact False.elim hSl
                  | some vT =>
                    cases vS with
                    | base _ =>
                      cases vT with
                      | base _ => rfl
                      | localPtr _ _ => exact False.elim hSl
                    | localPtr ptrS vTyS =>
                      cases vT with
                      | base _ => exact False.elim hSl
                      | localPtr ptrT vTyT =>
                        dsimp
                        let ⟨hVTyEq, hTgtNeR, hTgtLoc, hTgtEp, hEpLt, hBS, hBT,
                             hTags⟩ := hSl
                        rw [← hVTyEq]
                        cases hVT : !MirTy.beq vTyS ptrDeclTy with
                        | true => rfl
                        | false =>
                          have hVTyDecl : vTyS = ptrDeclTy :=
                            mirTy_beq_eq (bool_not_false hVT)
                          subst hVTyDecl
                          dsimp
                          cases isSR && !isOpsemInhabitedTy ptTy with
                          | true => rfl
                          | false =>
                            dsimp
                            have hCore0 := s3b_tbRoot_any .read hCore hBL
                            have hDeref :=
                              s3b_derefPointeeSlot_rel (expectedTy := ptTy)
                                hCore0 hTgtNeR hTgtLoc hTgtEp
                            cases hD1 :
                                derefPointeeSlot c.bodySrc.locals localsS
                                  epochs ptTy ptrS with
                            | error _ =>
                              rw [hD1] at hDeref
                              cases hD2 :
                                  derefPointeeSlot c.bodyTgt.locals localsT
                                    epochs ptTy ptrT with
                              | error _ => rw [hD2] at hDeref; exact hDeref
                              | ok _ => rw [hD2] at hDeref; exact False.elim hDeref
                            | ok optS =>
                              rw [hD1] at hDeref
                              cases hD2 :
                                  derefPointeeSlot c.bodyTgt.locals localsT
                                    epochs ptTy ptrT with
                              | error _ =>
                                rw [hD2] at hDeref; exact False.elim hDeref
                              | ok optT =>
                                rw [hD2] at hDeref
                                dsimp
                                -- Extract target decl, live, epoch from hD1
                                have hD1Unp :
                                    Trusted.MirSemantics.getElem?
                                      c.bodySrc.locals ptrS.targetLocal =
                                      some ptTy ∧
                                    Trusted.MirSemantics.getElem? epochs
                                      ptrS.targetLocal =
                                      some ptrS.targetEpoch ∧
                                    Trusted.MirSemantics.getElem? localsS
                                      ptrS.targetLocal =
                                      some (.live optS) := by
                                  unfold derefPointeeSlot at hD1
                                  cases hG1 :
                                      Trusted.MirSemantics.getElem?
                                        c.bodySrc.locals ptrS.targetLocal with
                                  | none => rw [hG1] at hD1; cases hD1
                                  | some dTy =>
                                    rw [hG1] at hD1
                                    cases hG2 :
                                        Trusted.MirSemantics.getElem? localsS
                                          ptrS.targetLocal with
                                    | none => rw [hG2] at hD1; cases hD1
                                    | some tSl =>
                                      rw [hG2] at hD1
                                      cases hG3 :
                                          Trusted.MirSemantics.getElem? epochs
                                            ptrS.targetLocal with
                                      | none => rw [hG3] at hD1; cases hD1
                                      | some tEp =>
                                        rw [hG3] at hD1; dsimp at hD1
                                        cases hM : !MirTy.beq dTy ptTy with
                                        | true =>
                                          rw [if_bool_true hM] at hD1; cases hD1
                                        | false =>
                                          rw [if_bool_false hM] at hD1
                                          cases tSl with
                                          | dead => cases hD1
                                          | live oS2 =>
                                            dsimp at hD1
                                            cases hE :
                                                !Nat.beq tEp ptrS.targetEpoch
                                            with
                                            | true =>
                                              rw [if_bool_true hE] at hD1
                                              cases hD1
                                            | false =>
                                              rw [if_bool_false hE] at hD1
                                              injection hD1 with eO; subst eO
                                              have hdTy :=
                                                mirTy_beq_eq (bool_not_false hM)
                                              subst hdTy
                                              have htEp :=
                                                nat_beq_eq (bool_not_false hE)
                                              subst htEp
                                              exact ⟨rfl, rfl, rfl⟩
                                let ⟨hTgtDecl, hTgtEpGet, hTgtLive⟩ := hD1Unp
                                rw [← hTgtLoc, ← hTgtEp]
                                have hTb :=
                                  s3b_tbDerived_rel .read hCore0 hTgtDecl
                                    hTgtEpGet hTgtLive
                                    (hTags ptTy hTgtDecl hTgtEpGet)
                                cases hTb1 :
                                    performTbAccess ptrS.targetLocal
                                      ptrS.targetEpoch ptTy .read
                                      ptrS.borrowTag
                                      (performTbRootAccess epochs ptrId vTyS
                                        .read nodesS) with
                                | error _ =>
                                  rw [hTb1] at hTb
                                  cases hTb2 :
                                      performTbAccess ptrS.targetLocal
                                        ptrS.targetEpoch ptTy .read
                                        ptrT.borrowTag
                                        (performTbRootAccess epochs ptrId vTyS
                                          .read nodesT) with
                                  | error _ => rw [hTb2] at hTb; exact hTb
                                  | ok _ =>
                                    rw [hTb2] at hTb; exact False.elim hTb
                                | ok nS1 =>
                                  rw [hTb1] at hTb
                                  cases hTb2 :
                                      performTbAccess ptrS.targetLocal
                                        ptrS.targetEpoch ptTy .read
                                        ptrT.borrowTag
                                        (performTbRootAccess epochs ptrId vTyS
                                          .read nodesT) with
                                  | error _ =>
                                    rw [hTb2] at hTb; exact False.elim hTb
                                  | ok nT1 =>
                                    rw [hTb2] at hTb
                                    exact ⟨vTyS, optS, rfl, rfl, rfl, rfl,
                                      ⟨rfl, hTgtNeR, hTgtLoc, hTgtEp, hEpLt,
                                        hBS, hBT, hTags⟩,
                                      hTgtDecl, hTgtEpGet, hTgtLive, hDeref,
                                      hTb⟩

private theorem s3b_evalOperand_nonR {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)} {opnd : Operand}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hNoR : operandMentionsLocal c.r opnd = false) :
    match evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd,
        evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT opnd with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (ty₁, optS, src₁?, localsS', nodesS'),
      .ok (ty₂, optT, src₂?, localsT', nodesT') =>
      ty₁ = ty₂ ∧ src₁? = src₂? ∧
      s3b_OptValRel c epochs nextEpoch ntS ntT pm optS optT ∧
      s3b_CoreInv c rL xL (s3b_opNonRMode c opnd mode)
        localsS' localsT' epochs nextEpoch nodesS' nodesT' ntS ntT pm
    | _, _ => False := by
  cases opnd with
  | constant cst =>
    dsimp [evalOperandToSlotRef, s3b_opNonRMode, operandDirectMovesLocal,
      operandMentionsLocal]
    have hM : (if !c.trackTb then mode else mode) = mode := by
      cases !c.trackTb <;> rfl
    rw [hM]
    cases evalConstLit cst.ty cst.lit with
    | error _ => rfl
    | ok _ => exact ⟨rfl, rfl, rfl, hCore⟩
  | copy place =>
    have hNeR : place.localId ≠ c.r := nat_ne_of_beq_false hNoR
    dsimp [evalOperandToSlotRef]
    have hModeEq :
        s3b_modeAfterRoot c place.localId .read mode =
          s3b_opNonRMode c (.copy place) mode :=
      s3b_modeAfterRoot_read_eq_aux c.trackTb (Nat.beq place.localId c.x) mode
    cases place.projection with
    | nil =>
      dsimp
      rw [s3b_ctx_getElem_localsTgt_ne c hNeR]
      cases hBL : Trusted.MirSemantics.getElem? c.bodySrc.locals place.localId
      with
      | none =>
        cases Trusted.MirSemantics.getElem? localsS place.localId <;>
          cases Trusted.MirSemantics.getElem? localsT place.localId <;> rfl
      | some ty =>
        cases hLS : Trusted.MirSemantics.getElem? localsS place.localId with
        | none =>
          have hGe : localsT.length ≤ place.localId := by
            rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_none_ge hLS
          rw [getElem?_none_of_ge hGe]
        | some slS =>
          have hLt : place.localId < localsT.length := by
            rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_some_lt hLS
          let ⟨slT, hLT⟩ := getElem?_some_of_lt localsT place.localId hLt
          rw [hLT]
          have hSl := hCore.hSlotsOther place.localId slS slT hNeR hLS hLT
          cases slS with
          | dead =>
            cases slT with
            | dead => rfl
            | live _ => exact False.elim hSl
          | live oS =>
            cases slT with
            | dead => exact False.elim hSl
            | live oT =>
              dsimp
              rw [← hModeEq]
              exact ⟨rfl, rfl, hSl, s3b_tbRoot_any .read hCore hBL⟩
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          have hRes := s3b_resolveDerefPlace_nonR hCore hNeR
          cases hR1 : resolveDerefPlaceRef c.bodySrc.locals localsS epochs
              nodesS place.localId with
          | error _ =>
            rw [hR1] at hRes
            cases hR2 : resolveDerefPlaceRef c.bodyTgt.locals localsT epochs
                nodesT place.localId with
            | error _ => rw [hR2] at hRes; exact hRes
            | ok _ => rw [hR2] at hRes; exact False.elim hRes
          | ok tup1 =>
            rw [hR1] at hRes
            cases hR2 : resolveDerefPlaceRef c.bodyTgt.locals localsT epochs
                nodesT place.localId with
            | error _ => rw [hR2] at hRes; exact False.elim hRes
            | ok tup2 =>
              rw [hR2] at hRes
              cases tup1 with
              | mk _ r1 =>
                cases r1 with
                | mk _ r2 =>
                  cases r2 with
                  | mk ptTy1 r3 =>
                    cases r3 with
                    | mk ptrS r4 =>
                      cases r4 with
                      | mk oS nS' =>
                        cases tup2 with
                        | mk _ t1 =>
                          cases t1 with
                          | mk _ t2 =>
                            cases t2 with
                            | mk ptTy2 t3 =>
                              cases t3 with
                              | mk ptrT t4 =>
                                cases t4 with
                                | mk oT nT' =>
                                  let ⟨_, _, _, _, hPtEq, _, hPtrV, _, _, _,
                                       hOpt, hC'⟩ := hRes
                                  rw [← hModeEq]
                                  exact ⟨hPtEq, congrArg some hPtrV.2.2.1,
                                    hOpt, hC'⟩
  | move place =>
    have hNeR : place.localId ≠ c.r := nat_ne_of_beq_false hNoR
    dsimp [evalOperandToSlotRef]
    cases hPr : place.projection with
    | nil =>
      dsimp
      rw [s3b_ctx_getElem_localsTgt_ne c hNeR]
      cases hBL : Trusted.MirSemantics.getElem? c.bodySrc.locals place.localId
      with
      | none =>
        cases Trusted.MirSemantics.getElem? localsS place.localId <;>
          cases Trusted.MirSemantics.getElem? localsT place.localId <;> rfl
      | some ty =>
        cases hLS : Trusted.MirSemantics.getElem? localsS place.localId with
        | none =>
          have hGe : localsT.length ≤ place.localId := by
            rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_none_ge hLS
          rw [getElem?_none_of_ge hGe]
        | some slS =>
          have hLtS := getElem?_some_lt hLS
          have hLtT : place.localId < localsT.length := by
            rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact hLtS
          let ⟨slT, hLT⟩ := getElem?_some_of_lt localsT place.localId hLtT
          rw [hLT]
          have hSl := hCore.hSlotsOther place.localId slS slT hNeR hLS hLT
          cases slS with
          | dead =>
            cases slT with
            | dead => rfl
            | live _ => exact False.elim hSl
          | live oS =>
            cases slT with
            | dead => exact False.elim hSl
            | live oT =>
              dsimp
              let ⟨lS', hSetS⟩ :=
                setElem?_some_of_lt localsS place.localId
                  (liveUninitSlotRef ty) hLtS
              let ⟨lT', hSetT⟩ :=
                setElem?_some_of_lt localsT place.localId
                  (liveUninitSlotRef ty) hLtT
              rw [hSetS, hSetT]
              dsimp
              have hC1 := s3b_tbRoot_any .read hCore hBL
              have hC2 := s3b_tbRoot_any .write hC1 hBL
              have hModeEq :
                  s3b_modeAfterRoot c place.localId .write
                    (s3b_modeAfterRoot c place.localId .read mode) =
                  s3b_opNonRMode c (.move place) mode := by
                cases place with
                | mk pL pPr =>
                  dsimp at hPr
                  subst hPr
                  exact s3b_modeAfterRoot_move_unproj_aux c.trackTb
                    (Nat.beq pL c.x) mode
              rw [hModeEq] at hC2
              exact ⟨rfl, rfl, hSl,
                s3b_CoreInv_setLiveOther hC2 hNeR hLS hSetS hSetT
                  (s3b_slotIsLive_liveUninit ty)
                  (s3b_SlotRel_liveUninit c epochs nextEpoch ntS ntT pm ty)⟩
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          rw [s3b_ctx_getElem_localsTgt_ne c hNeR]
          cases hBL :
              Trusted.MirSemantics.getElem? c.bodySrc.locals place.localId with
          | none => rfl
          | some ptrDeclTy =>
            dsimp
            cases ptrPointeeInfo? ptrDeclTy with
            | none => rfl
            | some dInfo =>
              cases dInfo with
              | mk dSafe dRest =>
                cases dRest with
                | mk dMut _ =>
                  dsimp
                  cases !dSafe && Mutability.beq dMut .shared with
                  | true => rfl
                  | false =>
                    dsimp
                    have hRes := s3b_resolveDerefPlace_nonR hCore hNeR
                    cases hR1 : resolveDerefPlaceRef c.bodySrc.locals localsS
                        epochs nodesS place.localId with
                    | error _ =>
                      rw [hR1] at hRes
                      cases hR2 : resolveDerefPlaceRef c.bodyTgt.locals localsT
                          epochs nodesT place.localId with
                      | error _ => rw [hR2] at hRes; exact hRes
                      | ok _ => rw [hR2] at hRes; exact False.elim hRes
                    | ok tup1 =>
                      rw [hR1] at hRes
                      cases hR2 : resolveDerefPlaceRef c.bodyTgt.locals localsT
                          epochs nodesT place.localId with
                      | error _ => rw [hR2] at hRes; exact False.elim hRes
                      | ok tup2 =>
                        rw [hR2] at hRes
                        cases tup1 with
                        | mk sR1 r1 =>
                          cases r1 with
                          | mk pM1 r2 =>
                            cases r2 with
                            | mk ptTy1 r3 =>
                              cases r3 with
                              | mk ptrS r4 =>
                                cases r4 with
                                | mk oS nS1 =>
                                  cases tup2 with
                                  | mk sR2 t1 =>
                                    cases t1 with
                                    | mk pM2 t2 =>
                                      cases t2 with
                                      | mk ptTy2 t3 =>
                                        cases t3 with
                                        | mk ptrT t4 =>
                                          cases t4 with
                                          | mk oT nT1 =>
                                            let ⟨_, optTgtS, hSR, hPM, hPt, _,
                                                 hPtrV, hTgtDecl, hTgtEpG,
                                                 hTgtLive, hOpt, hC1⟩ := hRes
                                            subst hSR; subst hPM; subst hPt
                                            dsimp
                                            cases sR1 &&
                                                Mutability.beq pM1 .shared with
                                            | true => rfl
                                            | false =>
                                              dsimp
                                              let ⟨_, hTgtNeR, hTgtLoc, hTgtEp,
                                                   _, _, _, hTags⟩ := hPtrV
                                              rw [← hTgtLoc, ← hTgtEp]
                                              have hTb :=
                                                s3b_tbDerived_rel .write hC1
                                                  hTgtDecl hTgtEpG hTgtLive
                                                  (hTags ptTy1 hTgtDecl
                                                    hTgtEpG)
                                              cases hTb1 :
                                                  performTbAccess
                                                    ptrS.targetLocal
                                                    ptrS.targetEpoch ptTy1
                                                    .write ptrS.borrowTag
                                                    nS1 with
                                              | error _ =>
                                                rw [hTb1] at hTb
                                                cases hTb2 :
                                                    performTbAccess
                                                      ptrS.targetLocal
                                                      ptrS.targetEpoch ptTy1
                                                      .write ptrT.borrowTag
                                                      nT1 with
                                                | error _ =>
                                                  rw [hTb2] at hTb; exact hTb
                                                | ok _ =>
                                                  rw [hTb2] at hTb
                                                  exact False.elim hTb
                                              | ok nS2 =>
                                                rw [hTb1] at hTb
                                                cases hTb2 :
                                                    performTbAccess
                                                      ptrS.targetLocal
                                                      ptrS.targetEpoch ptTy1
                                                      .write ptrT.borrowTag
                                                      nT1 with
                                                | error _ =>
                                                  rw [hTb2] at hTb
                                                  exact False.elim hTb
                                                | ok nT2 =>
                                                  rw [hTb2] at hTb
                                                  dsimp
                                                  have hLtS :=
                                                    getElem?_some_lt hTgtLive
                                                  have hLtT :
                                                      ptrS.targetLocal <
                                                        localsT.length := by
                                                    rw [hCore.hLenLocT,
                                                        ← hCore.hLenLocS]
                                                    exact hLtS
                                                  let ⟨lS', hSetS⟩ :=
                                                    setElem?_some_of_lt localsS
                                                      ptrS.targetLocal
                                                      (liveUninitSlotRef ptTy1)
                                                      hLtS
                                                  let ⟨lT', hSetT⟩ :=
                                                    setElem?_some_of_lt localsT
                                                      ptrS.targetLocal
                                                      (liveUninitSlotRef ptTy1)
                                                      hLtT
                                                  rw [hSetS, hSetT]
                                                  have hModeEq :
                                                      s3b_modeAfterRoot c
                                                        place.localId .read
                                                        mode =
                                                      s3b_opNonRMode c
                                                        (.move place) mode := by
                                                    cases place with
                                                    | mk pL pPr =>
                                                      dsimp at hPr
                                                      subst hPr
                                                      exact
                                                        s3b_modeAfterRoot_read_eq_aux
                                                          c.trackTb
                                                          (Nat.beq pL c.x) mode
                                                  rw [hModeEq] at hTb
                                                  exact ⟨rfl, rfl, hOpt,
                                                    s3b_CoreInv_setLiveOther hTb
                                                      hTgtNeR hTgtLive hSetS
                                                      hSetT
                                                      (s3b_slotIsLive_liveUninit
                                                        ptTy1)
                                                      (s3b_SlotRel_liveUninit c
                                                        epochs nextEpoch ntS
                                                        ntT pm ptTy1)⟩

private theorem s3b_evalPrimOperand_nonR {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)} {opnd : Operand}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hNoR : operandMentionsLocal c.r opnd = false) :
    match evalPrimitiveOperandRef c.bodySrc.locals localsS epochs nodesS opnd,
        evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT opnd with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (v₁, localsS', nodesS'), .ok (v₂, localsT', nodesT') =>
      v₁ = v₂ ∧
      s3b_CoreInv c rL xL (s3b_opNonRMode c opnd mode)
        localsS' localsT' epochs nextEpoch nodesS' nodesT' ntS ntT pm
    | _, _ => False := by
  unfold evalPrimitiveOperandRef
  have hOp := s3b_evalOperand_nonR hCore hNoR
  cases h1 : evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd
  with
  | error _ =>
    rw [h1] at hOp
    cases h2 : evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT opnd
    with
    | error _ => rw [h2] at hOp; exact hOp
    | ok _ => rw [h2] at hOp; exact False.elim hOp
  | ok r1 =>
    rw [h1] at hOp
    cases h2 : evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT opnd
    with
    | error _ => rw [h2] at hOp; exact False.elim hOp
    | ok r2 =>
      rw [h2] at hOp
      cases r1 with
      | mk ty1 a1 =>
        cases a1 with
        | mk oS a2 =>
          cases a2 with
          | mk _ a3 =>
            cases a3 with
            | mk lS' nS' =>
              cases r2 with
              | mk ty2 b1 =>
                cases b1 with
                | mk oT b2 =>
                  cases b2 with
                  | mk _ b3 =>
                    cases b3 with
                    | mk lT' nT' =>
                      let ⟨hTy, _, hOpt, hC'⟩ := hOp
                      subst hTy
                      dsimp
                      cases !isPrimitiveReadableTy ty1 with
                      | true => rfl
                      | false =>
                        dsimp
                        cases oS with
                        | none =>
                          cases oT with
                          | none => rfl
                          | some _ => exact False.elim hOpt
                        | some vS =>
                          cases oT with
                          | none => exact False.elim hOpt
                          | some vT =>
                            cases vS with
                            | localPtr _ _ =>
                              cases vT with
                              | localPtr _ _ => rfl
                              | base _ => exact False.elim hOpt
                            | base bS =>
                              cases vT with
                              | localPtr _ _ => exact False.elim hOpt
                              | base bT => exact ⟨hOpt, hC'⟩

private noncomputable def s3b_PmMono
    (pm pm' : LocalId → Nat → List (Nat × Nat)) : Prop :=
  ∀ l e t1 t2,
    rp_hasPair (pm l e) t1 t2 = true → rp_hasPair (pm' l e) t1 t2 = true

private theorem s3b_PmMono_refl (pm : LocalId → Nat → List (Nat × Nat)) :
    s3b_PmMono pm pm :=
  fun _ _ _ _ h => h

private theorem s3b_PmMono_ext (pm : LocalId → Nat → List (Nat × Nat))
    (loc : LocalId) (ep tS tT : Nat) :
    s3b_PmMono pm (s3b_extPm pm loc ep tS tT) := by
  intro l e t1 t2 hp
  dsimp [s3b_extPm]
  cases Nat.beq l loc && Nat.beq e ep with
  | false => exact hp
  | true =>
    dsimp
    rw [rp_hasPair_append]
    exact bool_or_intro_left _ hp

private noncomputable def s3b_evalRefOrAddrBody (bodyLocals : List MirTy)
    (locals : List LocalSlotRef) (epochs : List Nat) (nodes : List BorrowNode)
    (nextTag : Nat) (isSafeRef : Bool) (m : Mutability) (srcPlace : Place)
    (dstTy dstInnerTy : MirTy) :
    Except FaultKind (ValRef × List BorrowNode × Nat) :=
  match srcPlace.projection with
  | [] =>
    match Trusted.MirSemantics.getElem? bodyLocals srcPlace.localId with
    | none => .error .unsupported
    | some srcTy =>
      if !MirTy.beq srcTy dstInnerTy then
        .error .unsupported
      else
        match Trusted.MirSemantics.getElem? locals srcPlace.localId,
            Trusted.MirSemantics.getElem? epochs srcPlace.localId with
        | some .dead, _ => .error .undefined
        | some (.live _), some ep =>
          if !isSafeRef then
            .ok (.localPtr ⟨srcPlace.localId, ep, 0⟩ dstTy, nodes, nextTag)
          else if !isOpsemInhabitedTy dstInnerTy then
            .error .undefined
          else
            let nodes₁ :=
              performTbRootAccess epochs srcPlace.localId dstInnerTy .read
                nodes
            let (tag, nextTag') := allocateBorrowTag nextTag
            let initPerm : BorrowPerm :=
              match m with
              | .shared => .frozen
              | .mut => .reservedFrz
            let newNode : BorrowNode :=
              ⟨tag, 0, srcPlace.localId, ep, initPerm⟩
            .ok (.localPtr ⟨srcPlace.localId, ep, tag⟩ dstTy,
              nodes₁ ++ [newNode], nextTag')
        | _, _ => .error .unsupported
  | [.deref] =>
    match Trusted.MirSemantics.getElem? bodyLocals srcPlace.localId with
    | none => .error .unsupported
    | some ptrDeclTy =>
      match ptrPointeeInfo? ptrDeclTy with
      | none => .error .unsupported
      | some (baseIsSafeRef, baseMut, innerTy) =>
        let mutOk : Bool :=
          match m with
          | .shared => true
          | .mut =>
            match baseMut with
            | .mut => true
            | .shared => false
        if !MirTy.beq innerTy dstInnerTy || !mutOk then
          .error .unsupported
        else
          match Trusted.MirSemantics.getElem? locals srcPlace.localId with
          | none => .error .unsupported
          | some .dead | some (.live none) => .error .undefined
          | some (.live (some (.base _))) => .error .unsupported
          | some (.live (some (.localPtr ptr vPtrTy))) =>
            if !MirTy.beq vPtrTy ptrDeclTy then
              .error .unsupported
            else
              let nodes₀ :=
                performTbRootAccess epochs srcPlace.localId ptrDeclTy .read
                  nodes
              match Trusted.MirSemantics.getElem? bodyLocals ptr.targetLocal,
                  Trusted.MirSemantics.getElem? locals ptr.targetLocal,
                  Trusted.MirSemantics.getElem? epochs ptr.targetLocal with
              | some tgtDeclTy, some tgtSlot, some tgtEpoch =>
                if !MirTy.beq tgtDeclTy dstInnerTy then
                  .error .unsupported
                else if isSafeRef then
                  if !isOpsemInhabitedTy dstInnerTy then
                    .error .undefined
                  else
                    match tgtSlot with
                    | .dead => .error .undefined
                    | .live _ =>
                      if !Nat.beq tgtEpoch ptr.targetEpoch then
                        .error .undefined
                      else
                        match performTbAccess ptr.targetLocal ptr.targetEpoch
                            dstInnerTy .read ptr.borrowTag nodes₀ with
                        | .error k => .error k
                        | .ok nodes₁ =>
                          let (tag, nextTag') := allocateBorrowTag nextTag
                          let initPerm : BorrowPerm :=
                            match m with
                            | .shared => .frozen
                            | .mut => .reservedFrz
                          let newNode : BorrowNode :=
                            ⟨tag, ptr.borrowTag, ptr.targetLocal,
                              ptr.targetEpoch, initPerm⟩
                          .ok (.localPtr
                              ⟨ptr.targetLocal, ptr.targetEpoch, tag⟩ dstTy,
                            nodes₁ ++ [newNode], nextTag')
                else if baseIsSafeRef then
                  if !isOpsemInhabitedTy dstInnerTy then
                    .error .undefined
                  else
                    match tgtSlot with
                    | .dead => .error .undefined
                    | .live _ =>
                      if !Nat.beq tgtEpoch ptr.targetEpoch then
                        .error .undefined
                      else
                        .ok (.localPtr ptr dstTy, nodes₀, nextTag)
                else
                  .ok (.localPtr ptr dstTy, nodes₀, nextTag)
              | _, _, _ => .error .unsupported
  | _ => .error .unsupported

private theorem s3b_evalRefOrAddrOf_eq_body (bodyLocals : List MirTy)
    (locals : List LocalSlotRef) (epochs : List Nat) (nodes : List BorrowNode)
    (nextTag : Nat) (isSafeRefOp : Bool) (m : Mutability) (srcP : Place)
    (dstTy : MirTy) :
    evalRefOrAddrOf bodyLocals locals epochs nodes nextTag isSafeRefOp m srcP
      dstTy =
    match expectedRefOrAddrInner? isSafeRefOp m dstTy with
    | none => .error .unsupported
    | some dstInnerTy =>
      s3b_evalRefOrAddrBody bodyLocals locals epochs nodes nextTag isSafeRefOp
        m srcP dstTy dstInnerTy := by
  cases isSafeRefOp <;>
    cases dstTy <;>
      dsimp [evalRefOrAddrOf, expectedRefOrAddrInner?, s3b_evalRefOrAddrBody]

private theorem s3b_evalRefOrAddrOf_nonR {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    (isSafeRefOp : Bool) (m : Mutability) (srcP : Place) (dstTy : MirTy)
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hNeR : srcP.localId ≠ c.r)
    (hNoDirX :
      c.trackTb = true →
      (srcP.projection.isEmpty && Nat.beq srcP.localId c.x) = false) :
    match evalRefOrAddrOf c.bodySrc.locals localsS epochs nodesS ntS
        isSafeRefOp m srcP dstTy,
        evalRefOrAddrOf c.bodyTgt.locals localsT epochs nodesT ntT
        isSafeRefOp m srcP dstTy with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (vS, nodesS', ntS'), .ok (vT, nodesT', ntT') =>
      ∃ pm',
        ntS ≤ ntS' ∧ ntT ≤ ntT' ∧ s3b_PmMono pm pm' ∧
        s3b_ValRel c epochs nextEpoch ntS' ntT' pm' vS vT ∧
        s3b_CoreInv c rL xL (s3b_modeAfterRoot c srcP.localId .read mode)
          localsS localsT epochs nextEpoch nodesS' nodesT' ntS' ntT' pm'
    | _, _ => False := by
  rw [s3b_evalRefOrAddrOf_eq_body, s3b_evalRefOrAddrOf_eq_body]
  cases expectedRefOrAddrInner? isSafeRefOp m dstTy with
  | none => rfl
  | some dstInnerTy =>
    dsimp [s3b_evalRefOrAddrBody]
    cases hPr : srcP.projection with
    | nil =>
      dsimp
      rw [s3b_ctx_getElem_localsTgt_ne c hNeR]
      have hCondNonX : srcP.localId ≠ c.x ∨ c.trackTb = false := by
        cases hTr : c.trackTb with
        | false => exact Or.inr rfl
        | true =>
          have hF := hNoDirX hTr
          rw [hPr] at hF
          dsimp at hF
          exact Or.inl (nat_ne_of_beq_false hF)
      have hModeIdle : s3b_modeAfterRoot c srcP.localId .read mode = mode := by
        unfold s3b_modeAfterRoot
        cases hCondNonX with
        | inl hNeX =>
          rw [nat_beq_false_of_ne hNeX]; cases c.trackTb <;> rfl
        | inr hTrF => rw [hTrF]; rfl
      rw [hModeIdle]
      cases hBL : Trusted.MirSemantics.getElem? c.bodySrc.locals srcP.localId
      with
      | none => rfl
      | some srcTy =>
        dsimp
        cases hTyM : !MirTy.beq srcTy dstInnerTy with
        | true => rfl
        | false =>
          have hSrcEq : srcTy = dstInnerTy :=
            mirTy_beq_eq (bool_not_false hTyM)
          subst hSrcEq
          dsimp
          cases hLS : Trusted.MirSemantics.getElem? localsS srcP.localId with
          | none =>
            have hGe : localsT.length ≤ srcP.localId := by
              rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_none_ge hLS
            rw [getElem?_none_of_ge hGe]
          | some slS =>
            have hLtT : srcP.localId < localsT.length := by
              rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_some_lt hLS
            let ⟨slT, hLT⟩ := getElem?_some_of_lt localsT srcP.localId hLtT
            rw [hLT]
            have hSl := hCore.hSlotsOther srcP.localId slS slT hNeR hLS hLT
            cases slS with
            | dead =>
              cases slT with
              | dead =>
                cases Trusted.MirSemantics.getElem? epochs srcP.localId <;> rfl
              | live _ => exact False.elim hSl
            | live oS =>
              cases slT with
              | dead => exact False.elim hSl
              | live _ =>
                cases hEp : Trusted.MirSemantics.getElem? epochs srcP.localId
                with
                | none => rfl
                | some ep =>
                  dsimp
                  cases !isSafeRefOp with
                  | true =>
                    dsimp
                    have hEpLt : ep < nextEpoch :=
                      s3b_epochs_getElem_lt hCore.hEpLt hEp
                    have hCF : (c.trackTb && Nat.beq srcP.localId c.x) =
                        false := by
                      cases hCondNonX with
                      | inl hNeX =>
                        rw [nat_beq_false_of_ne hNeX]; cases c.trackTb <;> rfl
                      | inr hTrF => rw [hTrF]; rfl
                    refine ⟨pm, Nat.le_refl _, Nat.le_refl _, s3b_PmMono_refl pm,
                      ⟨rfl, hNeR, rfl, rfl, hEpLt,
                        hCore.hNextTagSPos, hCore.hNextTagTPos, ?_⟩, hCore⟩
                    intro _ _ _ _
                    rw [if_bool_false hCF]
                    exact Or.inl ⟨rfl, rfl⟩
                  | false =>
                    dsimp
                    cases !isOpsemInhabitedTy srcTy with
                    | true => rfl
                    | false =>
                      dsimp
                      rw [s3b_allocateBorrowTag_pos hCore.hNextTagSPos,
                          s3b_allocateBorrowTag_pos hCore.hNextTagTPos]
                      have hC1 :=
                        s3b_tbRoot_nonTarget .read hCore hBL hCondNonX
                      have hInitNR :
                          (match m with
                           | .shared => BorrowPerm.frozen
                           | .mut => BorrowPerm.reservedFrz) ≠ .rootOrRaw := by
                        cases m <;> intro h <;> cases h
                      have hCF : (c.trackTb && Nat.beq srcP.localId c.x) =
                          false := by
                        cases hCondNonX with
                        | inl hNeX =>
                          rw [nat_beq_false_of_ne hNeX]
                          cases c.trackTb <;> rfl
                        | inr hTrF => rw [hTrF]; rfl
                      let ⟨hC2, hVR⟩ :=
                        s3b_appendBorrowPair (dstTy := dstTy) hC1 hNeR hBL hEp
                          hLS hCore.hNextTagSPos hCore.hNextTagTPos hInitNR
                          (fun _ => by rw [if_bool_false hCF]; rfl)
                      exact ⟨_, Nat.le_succ _, Nat.le_succ _,
                        s3b_PmMono_ext pm _ _ _ _, hVR, hC2⟩
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          rw [s3b_ctx_getElem_localsTgt_ne c hNeR]
          cases hBL :
              Trusted.MirSemantics.getElem? c.bodySrc.locals srcP.localId with
          | none => rfl
          | some ptrDeclTy =>
            dsimp
            cases ptrPointeeInfo? ptrDeclTy with
            | none => rfl
            | some bInfo =>
              cases bInfo with
              | mk baseSafe bRest =>
                cases bRest with
                | mk baseMut innerTy =>
                  dsimp
                  have hMutFold :
                      (match m with
                       | .shared => true
                       | .mut =>
                         match baseMut with
                         | .mut => true
                         | .shared => false) = reborrowMutOk m baseMut := rfl
                  rw [hMutFold]
                  cases !MirTy.beq innerTy dstInnerTy ||
                      !reborrowMutOk m baseMut with
                  | true => rfl
                  | false =>
                    dsimp
                    cases hLS :
                        Trusted.MirSemantics.getElem? localsS srcP.localId with
                    | none =>
                      have hGe : localsT.length ≤ srcP.localId := by
                        rw [hCore.hLenLocT, ← hCore.hLenLocS]
                        exact getElem?_none_ge hLS
                      rw [getElem?_none_of_ge hGe]
                    | some slS =>
                      have hLtT : srcP.localId < localsT.length := by
                        rw [hCore.hLenLocT, ← hCore.hLenLocS]
                        exact getElem?_some_lt hLS
                      let ⟨slT, hLT⟩ :=
                        getElem?_some_of_lt localsT srcP.localId hLtT
                      rw [hLT]
                      have hSl :=
                        hCore.hSlotsOther srcP.localId slS slT hNeR hLS hLT
                      cases slS with
                      | dead =>
                        cases slT with
                        | dead => rfl
                        | live _ => exact False.elim hSl
                      | live oS =>
                        cases slT with
                        | dead => exact False.elim hSl
                        | live oT =>
                          cases oS with
                          | none =>
                            cases oT with
                            | none => rfl
                            | some _ => exact False.elim hSl
                          | some vS =>
                            cases oT with
                            | none => exact False.elim hSl
                            | some vT =>
                              cases vS with
                              | base _ =>
                                cases vT with
                                | base _ => rfl
                                | localPtr _ _ => exact False.elim hSl
                              | localPtr ptrS vTyS =>
                                cases vT with
                                | base _ => exact False.elim hSl
                                | localPtr ptrT vTyT =>
                                  dsimp
                                  let ⟨hVTyEq, hTgtNeR, hTgtLoc, hTgtEp, hEpLt,
                                       hBS, hBT, hTags⟩ := hSl
                                  rw [← hVTyEq]
                                  cases !MirTy.beq vTyS ptrDeclTy with
                                  | true => rfl
                                  | false =>
                                    dsimp
                                    have hC0 := s3b_tbRoot_any .read hCore hBL
                                    rw [← hTgtLoc, ← hTgtEp,
                                        s3b_ctx_getElem_localsTgt_ne c hTgtNeR]
                                    cases hTBL :
                                        Trusted.MirSemantics.getElem?
                                          c.bodySrc.locals ptrS.targetLocal
                                    with
                                    | none =>
                                      cases Trusted.MirSemantics.getElem?
                                          localsS ptrS.targetLocal <;>
                                        cases Trusted.MirSemantics.getElem?
                                          localsT ptrS.targetLocal <;>
                                        cases Trusted.MirSemantics.getElem?
                                          epochs ptrS.targetLocal <;> rfl
                                    | some tgtDeclTy =>
                                      cases hTLS :
                                          Trusted.MirSemantics.getElem? localsS
                                            ptrS.targetLocal with
                                      | none =>
                                        have hGe :
                                            localsT.length ≤ ptrS.targetLocal :=
                                        by
                                          rw [hCore.hLenLocT, ← hCore.hLenLocS]
                                          exact getElem?_none_ge hTLS
                                        rw [getElem?_none_of_ge hGe]
                                      | some tgtSlS =>
                                        have hLt2 :
                                            ptrS.targetLocal < localsT.length :=
                                        by
                                          rw [hCore.hLenLocT, ← hCore.hLenLocS]
                                          exact getElem?_some_lt hTLS
                                        let ⟨tgtSlT, hTLT⟩ :=
                                          getElem?_some_of_lt localsT
                                            ptrS.targetLocal hLt2
                                        rw [hTLT]
                                        have hTSl :=
                                          hCore.hSlotsOther ptrS.targetLocal
                                            tgtSlS tgtSlT hTgtNeR hTLS hTLT
                                        cases hTE :
                                            Trusted.MirSemantics.getElem? epochs
                                              ptrS.targetLocal with
                                        | none => rfl
                                        | some tgtEp =>
                                          dsimp
                                          cases hTD :
                                              !MirTy.beq tgtDeclTy dstInnerTy
                                          with
                                          | true => rfl
                                          | false =>
                                            have hTgtTyEq :
                                                tgtDeclTy = dstInnerTy :=
                                              mirTy_beq_eq (bool_not_false hTD)
                                            subst hTgtTyEq
                                            dsimp
                                            cases isSafeRefOp with
                                            | true =>
                                              dsimp
                                              cases !isOpsemInhabitedTy
                                                  tgtDeclTy with
                                              | true => rfl
                                              | false =>
                                                dsimp
                                                cases tgtSlS with
                                                | dead =>
                                                  cases tgtSlT with
                                                  | dead => rfl
                                                  | live _ =>
                                                    exact False.elim hTSl
                                                | live oTS =>
                                                  cases tgtSlT with
                                                  | dead =>
                                                    exact False.elim hTSl
                                                  | live _ =>
                                                    dsimp
                                                    cases hEM :
                                                        !Nat.beq tgtEp
                                                          ptrS.targetEpoch with
                                                    | true => rfl
                                                    | false =>
                                                      have hEpEq :=
                                                        nat_beq_eq
                                                          (bool_not_false hEM)
                                                      subst hEpEq
                                                      dsimp
                                                      have hTb :=
                                                        s3b_tbDerived_rel .read
                                                          hC0 hTBL hTE hTLS
                                                          (hTags tgtDeclTy hTBL
                                                            hTE)
                                                      cases hTb1 :
                                                          performTbAccess
                                                            ptrS.targetLocal
                                                            ptrS.targetEpoch
                                                            tgtDeclTy
                                                            .read ptrS.borrowTag
                                                            (performTbRootAccess
                                                              epochs
                                                              srcP.localId
                                                              ptrDeclTy .read
                                                              nodesS) with
                                                      | error _ =>
                                                        rw [hTb1] at hTb
                                                        cases hTb2 :
                                                            performTbAccess
                                                              ptrS.targetLocal
                                                              ptrS.targetEpoch
                                                              tgtDeclTy
                                                              .read
                                                              ptrT.borrowTag
                                                              (performTbRootAccess
                                                                epochs
                                                                srcP.localId
                                                                ptrDeclTy .read
                                                                nodesT) with
                                                        | error _ =>
                                                          rw [hTb2] at hTb
                                                          exact hTb
                                                        | ok _ =>
                                                          rw [hTb2] at hTb
                                                          exact False.elim hTb
                                                      | ok nS1 =>
                                                        rw [hTb1] at hTb
                                                        cases hTb2 :
                                                            performTbAccess
                                                              ptrS.targetLocal
                                                              ptrS.targetEpoch
                                                              tgtDeclTy
                                                              .read
                                                              ptrT.borrowTag
                                                              (performTbRootAccess
                                                                epochs
                                                                srcP.localId
                                                                ptrDeclTy .read
                                                                nodesT) with
                                                        | error _ =>
                                                          rw [hTb2] at hTb
                                                          exact False.elim hTb
                                                        | ok nT1 =>
                                                          rw [hTb2] at hTb
                                                          dsimp
                                                          rw [s3b_allocateBorrowTag_pos hCore.hNextTagSPos,
                                                              s3b_allocateBorrowTag_pos hCore.hNextTagTPos]
                                                          have hInitNR :
                                                              (match m with
                                                               | .shared =>
                                                                 BorrowPerm.frozen
                                                               | .mut =>
                                                                 BorrowPerm.reservedFrz) ≠
                                                                .rootOrRaw := by
                                                            cases m <;>
                                                              intro h <;>
                                                              cases h
                                                          let ⟨hC2, hVR⟩ :=
                                                            s3b_appendBorrowPair
                                                              (dstTy := dstTy)
                                                              hTb hTgtNeR hTBL
                                                              hTE hTLS hBS hBT
                                                              hInitNR
                                                              (fun hNZ => by
                                                                have hTI :=
                                                                  hTags
                                                                    tgtDeclTy
                                                                    hTBL hTE hNZ
                                                                cases hCnd :
                                                                    (c.trackTb &&
                                                                      Nat.beq
                                                                        ptrS.targetLocal
                                                                        c.x)
                                                                with
                                                                | true =>
                                                                  rw [if_bool_true hCnd] at hTI
                                                                  dsimp
                                                                  let ⟨hTrT, hEqX⟩ :=
                                                                    bool_and_true hCnd
                                                                  have eX :=
                                                                    nat_beq_eq hEqX
                                                                  rw [eX] at hTE hTLS
                                                                  have hTInv :=
                                                                    hTb.hTargetInv
                                                                      ptrS.targetEpoch oTS
                                                                      hTE hTLS
                                                                  unfold s3b_TargetLiveInv at hTInv
                                                                  rw [if_bool_true hTrT] at hTInv
                                                                  have hMD :
                                                                      s3b_modeAfterRoot c srcP.localId .read mode = .delegated := by
                                                                    cases hm : s3b_modeAfterRoot c srcP.localId .read mode with
                                                                    | delegated => rfl
                                                                    | reserved | unique | frozen =>
                                                                      rw [hm] at hTInv
                                                                      rw [hTInv.2.1] at hTI
                                                                      cases hTI.2.2
                                                                    | clean =>
                                                                      rw [hm] at hTInv
                                                                      rw [hTInv.2.1] at hTI
                                                                      cases hTI.2.2
                                                                  exact ⟨hMD, hTI.2.2⟩
                                                                | false =>
                                                                  rw [if_bool_false hCnd] at hTI
                                                                  dsimp
                                                                  unfold rp_parentPairOk
                                                                  cases hTI with
                                                                  | inl h0 =>
                                                                    rw [h0.1, h0.2]
                                                                    rfl
                                                                  | inr hP =>
                                                                    exact bool_or_intro_right _ hP.2.2)
                                                          exact ⟨_, Nat.le_succ _, Nat.le_succ _,
                                                            s3b_PmMono_ext pm _ _ _ _, hVR, hC2⟩
                                            | false =>
                                              dsimp
                                              have hSamePtr :
                                                  s3b_ValRel c epochs nextEpoch
                                                    ntS ntT pm
                                                    (.localPtr ptrS dstTy)
                                                    (.localPtr ptrT dstTy) :=
                                                ⟨rfl, hTgtNeR, hTgtLoc, hTgtEp,
                                                  hEpLt, hBS, hBT, hTags⟩
                                              cases baseSafe with
                                              | false =>
                                                exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                                                  s3b_PmMono_refl pm, hSamePtr, hC0⟩
                                              | true =>
                                                dsimp
                                                cases !isOpsemInhabitedTy
                                                    tgtDeclTy with
                                                | true => rfl
                                                | false =>
                                                  dsimp
                                                  cases tgtSlS with
                                                  | dead =>
                                                    cases tgtSlT with
                                                    | dead => rfl
                                                    | live _ =>
                                                      exact False.elim hTSl
                                                  | live _ =>
                                                    cases tgtSlT with
                                                    | dead =>
                                                      exact False.elim hTSl
                                                    | live _ =>
                                                      dsimp
                                                      cases !Nat.beq tgtEp
                                                          ptrS.targetEpoch with
                                                      | true => rfl
                                                      | false =>
                                                        exact ⟨pm, Nat.le_refl _,
                                                          Nat.le_refl _,
                                                          s3b_PmMono_refl pm,
                                                          hSamePtr, hC0⟩

private theorem s3b_evalRvalue_nonR {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {dstLoc : LocalId} {dstIsDeref : Bool} {dstTy : MirTy}
    {dst : Place} {rv : Rvalue}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hNoR : rvalueMentionsLocal c.r rv = false)
    (hNoDirX :
      c.trackTb = true → stmtTakesDirectAddrOf c.x (.assign dst rv) = false) :
    match evalRvalueRef c.bodySrc.locals localsS epochs nodesS ntS dstLoc
        dstIsDeref dstTy rv,
        evalRvalueRef c.bodyTgt.locals localsT epochs nodesT ntT dstLoc
        dstIsDeref dstTy rv with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (vS, localsS', nodesS', ntS'),
      .ok (vT, localsT', nodesT', ntT') =>
      ∃ pm',
        ntS ≤ ntS' ∧ ntT ≤ ntT' ∧ s3b_PmMono pm pm' ∧
        s3b_ValRel c epochs nextEpoch ntS' ntT' pm' vS vT ∧
        s3b_CoreInv c rL xL (s3b_rvNonRMode c rv mode)
          localsS' localsT' epochs nextEpoch nodesS' nodesT' ntS' ntT' pm'
    | _, _ => False := by
  cases rv with
  | aggregateTuple _ | unsupported => rfl
  | use opnd =>
    dsimp [evalRvalueRef]
    have hOp := s3b_evalOperand_nonR hCore hNoR
    cases h1 : evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd
    with
    | error _ =>
      rw [h1] at hOp
      cases h2 :
          evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT opnd with
      | error _ => rw [h2] at hOp; exact hOp
      | ok _ => rw [h2] at hOp; exact False.elim hOp
    | ok r1 =>
      rw [h1] at hOp
      cases h2 :
          evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT opnd with
      | error _ => rw [h2] at hOp; exact False.elim hOp
      | ok r2 =>
        rw [h2] at hOp
        cases r1 with
        | mk sTy1 a1 =>
          cases a1 with
          | mk oS a2 =>
            cases a2 with
            | mk src1? a3 =>
              cases a3 with
              | mk lS' nS' =>
                cases r2 with
                | mk sTy2 b1 =>
                  cases b1 with
                  | mk oT b2 =>
                    cases b2 with
                    | mk src2? b3 =>
                      cases b3 with
                      | mk lT' nT' =>
                        let ⟨hTy, hSrc, hOpt, hC'⟩ := hOp
                        subst hTy; subst hSrc
                        dsimp
                        cases !MirTy.beq sTy1 dstTy with
                        | true => rfl
                        | false =>
                          dsimp
                          cases src1? with
                          | none =>
                            dsimp
                            rw [Bool.and_false]
                            dsimp
                            cases oS with
                            | none =>
                              cases oT with
                              | none => rfl
                              | some _ => exact False.elim hOpt
                            | some vS =>
                              cases oT with
                              | none => exact False.elim hOpt
                              | some vT =>
                                exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                                  s3b_PmMono_refl pm, hOpt, hC'⟩
                          | some sL =>
                            dsimp
                            cases s3b_bool_cases
                                ((dstIsDeref || operandHasDerefProj opnd) &&
                                  !isZeroSizedTy dstTy &&
                                  Nat.beq sL dstLoc) with
                            | inr hOv =>
                              rw [if_bool_true hOv, if_bool_true hOv]
                            | inl hOv =>
                              rw [if_bool_false hOv, if_bool_false hOv]
                              cases oS with
                              | none =>
                                cases oT with
                                | none => rfl
                                | some _ => exact False.elim hOpt
                              | some vS =>
                                cases oT with
                                | none => exact False.elim hOpt
                                | some vT =>
                                  exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                                    s3b_PmMono_refl pm, hOpt, hC'⟩
  | unaryOp op opnd =>
    dsimp [evalRvalueRef]
    have hOp := s3b_evalPrimOperand_nonR hCore hNoR
    cases h1 :
        evalPrimitiveOperandRef c.bodySrc.locals localsS epochs nodesS opnd with
    | error _ =>
      rw [h1] at hOp
      cases h2 :
          evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT opnd
      with
      | error _ => rw [h2] at hOp; exact hOp
      | ok _ => rw [h2] at hOp; exact False.elim hOp
    | ok r1 =>
      rw [h1] at hOp
      cases h2 :
          evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT opnd
      with
      | error _ => rw [h2] at hOp; exact False.elim hOp
      | ok r2 =>
        rw [h2] at hOp
        cases r1 with
        | mk v1 a1 =>
          cases a1 with
          | mk lS' nS' =>
            cases r2 with
            | mk v2 b1 =>
              cases b1 with
              | mk lT' nT' =>
                let ⟨hv, hC'⟩ := hOp
                subst hv
                dsimp
                cases evalUnOp op v1 with
                | error _ => rfl
                | ok res =>
                  exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                    s3b_PmMono_refl pm, rfl, hC'⟩
  | binaryOp op lhs rhs =>
    dsimp [evalRvalueRef]
    let ⟨hNoRL, hNoRR⟩ := bool_or_false hNoR
    have hL := s3b_evalPrimOperand_nonR hCore hNoRL
    cases hL1 :
        evalPrimitiveOperandRef c.bodySrc.locals localsS epochs nodesS lhs with
    | error _ =>
      rw [hL1] at hL
      cases hL2 :
          evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT lhs
      with
      | error _ => rw [hL2] at hL; exact hL
      | ok _ => rw [hL2] at hL; exact False.elim hL
    | ok rl1 =>
      rw [hL1] at hL
      cases hL2 :
          evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT lhs
      with
      | error _ => rw [hL2] at hL; exact False.elim hL
      | ok rl2 =>
        rw [hL2] at hL
        cases rl1 with
        | mk vl1 al1 =>
          cases al1 with
          | mk lS1 nS1 =>
            cases rl2 with
            | mk vl2 bl1 =>
              cases bl1 with
              | mk lT1 nT1 =>
                let ⟨hvl, hC1⟩ := hL
                subst hvl
                dsimp
                have hR := s3b_evalPrimOperand_nonR hC1 hNoRR
                cases hR1 :
                    evalPrimitiveOperandRef c.bodySrc.locals lS1 epochs nS1 rhs
                with
                | error _ =>
                  rw [hR1] at hR
                  cases hR2 :
                      evalPrimitiveOperandRef c.bodyTgt.locals lT1 epochs nT1
                        rhs with
                  | error _ => rw [hR2] at hR; exact hR
                  | ok _ => rw [hR2] at hR; exact False.elim hR
                | ok rr1 =>
                  rw [hR1] at hR
                  cases hR2 :
                      evalPrimitiveOperandRef c.bodyTgt.locals lT1 epochs nT1
                        rhs with
                  | error _ => rw [hR2] at hR; exact False.elim hR
                  | ok rr2 =>
                    rw [hR2] at hR
                    cases rr1 with
                    | mk vr1 ar1 =>
                      cases ar1 with
                      | mk lS2 nS2 =>
                        cases rr2 with
                        | mk vr2 br1 =>
                          cases br1 with
                          | mk lT2 nT2 =>
                            let ⟨hvr, hC2⟩ := hR
                            subst hvr
                            dsimp
                            have hSeq :
                                s3b_opNonRMode c rhs
                                  (s3b_opNonRMode c lhs mode) =
                                s3b_rvNonRMode c (.binaryOp op lhs rhs) mode :=
                              s3b_opNonRMode_seq c lhs rhs mode
                            rw [hSeq] at hC2
                            cases evalBinOp op vl1 vr1 with
                            | error _ => rfl
                            | ok _ =>
                              exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                                s3b_PmMono_refl pm, rfl, hC2⟩
  | discriminant place =>
    have hNeR : place.localId ≠ c.r := nat_ne_of_beq_false hNoR
    have hModeEq :
        s3b_modeAfterRoot c place.localId .read mode =
          s3b_rvNonRMode c (.discriminant place) mode :=
      s3b_modeAfterRoot_read_eq_aux c.trackTb (Nat.beq place.localId c.x) mode
    dsimp [evalRvalueRef]
    cases place.projection with
    | nil =>
      dsimp
      rw [s3b_ctx_getElem_localsTgt_ne c hNeR]
      cases hBL : Trusted.MirSemantics.getElem? c.bodySrc.locals place.localId
      with
      | none =>
        cases Trusted.MirSemantics.getElem? localsS place.localId <;>
          cases Trusted.MirSemantics.getElem? localsT place.localId <;> rfl
      | some pTy =>
        cases pTy with
        | enum ety =>
          cases hLS : Trusted.MirSemantics.getElem? localsS place.localId with
          | none =>
            have hGe : localsT.length ≤ place.localId := by
              rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_none_ge hLS
            rw [getElem?_none_of_ge hGe]
          | some slS =>
            have hLt : place.localId < localsT.length := by
              rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_some_lt hLS
            let ⟨slT, hLT⟩ := getElem?_some_of_lt localsT place.localId hLt
            rw [hLT]
            have hSl := hCore.hSlotsOther place.localId slS slT hNeR hLS hLT
            dsimp
            cases !enumAdmitted ety with
            | true => rfl
            | false =>
              dsimp
              cases slS with
              | dead =>
                cases slT with
                | dead => rfl
                | live _ => exact False.elim hSl
              | live oS =>
                cases slT with
                | dead => exact False.elim hSl
                | live oT =>
                  dsimp
                  rw [s3b_decodeEnumDiscriminant_eq hSl]
                  cases hDec : decodeEnumDiscriminantSlot ety oT with
                  | error _ => rfl
                  | ok dv =>
                    have hBaseDv :
                        s3b_ValRel c epochs nextEpoch ntS ntT pm dv dv := by
                      unfold decodeEnumDiscriminantSlot at hDec
                      cases hTR : ety.tagRepr with
                      | zeroSized =>
                        rw [hTR] at hDec
                        cases oT with
                        | none =>
                          dsimp at hDec
                          cases h0 :
                              Trusted.MirSemantics.getElem? ety.discriminants 0
                          with
                          | none => rw [h0] at hDec; cases hDec
                          | some _ =>
                            rw [h0] at hDec; injection hDec with e; rw [← e]; rfl
                        | some vr =>
                          cases vr with
                          | localPtr _ _ => cases hDec
                          | base bv =>
                            cases bv with
                            | enumVal ety' v =>
                              dsimp at hDec
                              cases hC : EnumTy.beq ety ety' && Nat.beq v 0 with
                              | false => rw [if_bool_false hC] at hDec; cases hDec
                              | true =>
                                rw [if_bool_true hC] at hDec
                                cases h0 :
                                    Trusted.MirSemantics.getElem?
                                      ety.discriminants 0 with
                                | none => rw [h0] at hDec; cases hDec
                                | some _ =>
                                  rw [h0] at hDec
                                  injection hDec with e; rw [← e]; rfl
                            | _ => cases hDec
                      | scalar _ _ =>
                        rw [hTR] at hDec
                        cases oT with
                        | none => cases hDec
                        | some vr =>
                          cases vr with
                          | localPtr _ _ => cases hDec
                          | base bv =>
                            cases bv with
                            | enumVal ety' v =>
                              dsimp at hDec
                              cases hC : EnumTy.beq ety ety' &&
                                  Nat.blt v ety.discriminants.length with
                              | false => rw [if_bool_false hC] at hDec; cases hDec
                              | true =>
                                rw [if_bool_true hC] at hDec
                                cases h0 :
                                    Trusted.MirSemantics.getElem?
                                      ety.discriminants v with
                                | none => rw [h0] at hDec; cases hDec
                                | some _ =>
                                  rw [h0] at hDec
                                  injection hDec with e; rw [← e]; rfl
                            | _ => cases hDec
                    rw [← hModeEq]
                    exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                      s3b_PmMono_refl pm, hBaseDv,
                      s3b_tbRoot_any .read hCore hBL⟩
        | _ =>
          cases Trusted.MirSemantics.getElem? localsS place.localId <;>
            cases Trusted.MirSemantics.getElem? localsT place.localId <;> rfl
    | cons pe rest =>
      cases pe with
      | field _ _ | unsupported => rfl
      | deref =>
        cases rest with
        | cons _ _ => rfl
        | nil =>
          dsimp
          have hRes := s3b_resolveDerefPlace_nonR hCore hNeR
          cases hR1 : resolveDerefPlaceRef c.bodySrc.locals localsS epochs
              nodesS place.localId with
          | error _ =>
            rw [hR1] at hRes
            cases hR2 : resolveDerefPlaceRef c.bodyTgt.locals localsT epochs
                nodesT place.localId with
            | error _ => rw [hR2] at hRes; exact hRes
            | ok _ => rw [hR2] at hRes; exact False.elim hRes
          | ok tup1 =>
            rw [hR1] at hRes
            cases hR2 : resolveDerefPlaceRef c.bodyTgt.locals localsT epochs
                nodesT place.localId with
            | error _ => rw [hR2] at hRes; exact False.elim hRes
            | ok tup2 =>
              rw [hR2] at hRes
              cases tup1 with
              | mk _ r1 =>
                cases r1 with
                | mk _ r2 =>
                  cases r2 with
                  | mk ptTy1 r3 =>
                    cases r3 with
                    | mk _ r4 =>
                      cases r4 with
                      | mk oS nS1 =>
                        cases tup2 with
                        | mk _ t1 =>
                          cases t1 with
                          | mk _ t2 =>
                            cases t2 with
                            | mk ptTy2 t3 =>
                              cases t3 with
                              | mk _ t4 =>
                                cases t4 with
                                | mk oT nT1 =>
                                  let ⟨_, _, _, _, hPt, _, _, _, _, _, hOpt,
                                       hC1⟩ := hRes
                                  subst hPt
                                  cases ptTy1 with
                                  | enum ety =>
                                    dsimp
                                    cases !enumAdmitted ety with
                                    | true => rfl
                                    | false =>
                                      dsimp
                                      rw [s3b_decodeEnumDiscriminant_eq hOpt]
                                      cases hDec :
                                          decodeEnumDiscriminantSlot ety oT with
                                      | error _ => rfl
                                      | ok dv =>
                                        have hDvBase :
                                            s3b_ValRel c epochs nextEpoch ntS
                                              ntT pm dv dv := by
                                          unfold decodeEnumDiscriminantSlot
                                            at hDec
                                          cases hTR : ety.tagRepr with
                                          | zeroSized =>
                                            rw [hTR] at hDec
                                            cases oT with
                                            | none =>
                                              dsimp at hDec
                                              cases h0 :
                                                  Trusted.MirSemantics.getElem?
                                                    ety.discriminants 0 with
                                              | none =>
                                                rw [h0] at hDec; cases hDec
                                              | some _ =>
                                                rw [h0] at hDec
                                                injection hDec with e
                                                rw [← e]; rfl
                                            | some vr =>
                                              cases vr with
                                              | localPtr _ _ => cases hDec
                                              | base bv =>
                                                cases bv with
                                                | enumVal ety' v =>
                                                  dsimp at hDec
                                                  cases hC :
                                                      EnumTy.beq ety ety' &&
                                                      Nat.beq v 0 with
                                                  | false =>
                                                    rw [if_bool_false hC]
                                                      at hDec
                                                    cases hDec
                                                  | true =>
                                                    rw [if_bool_true hC]
                                                      at hDec
                                                    cases h0 :
                                                        Trusted.MirSemantics.getElem?
                                                          ety.discriminants 0
                                                    with
                                                    | none =>
                                                      rw [h0] at hDec
                                                      cases hDec
                                                    | some _ =>
                                                      rw [h0] at hDec
                                                      injection hDec with e
                                                      rw [← e]; rfl
                                                | _ => cases hDec
                                          | scalar _ _ =>
                                            rw [hTR] at hDec
                                            cases oT with
                                            | none => cases hDec
                                            | some vr =>
                                              cases vr with
                                              | localPtr _ _ => cases hDec
                                              | base bv =>
                                                cases bv with
                                                | enumVal ety' v =>
                                                  dsimp at hDec
                                                  cases hC :
                                                      EnumTy.beq ety ety' &&
                                                      Nat.blt v
                                                        ety.discriminants.length
                                                  with
                                                  | false =>
                                                    rw [if_bool_false hC]
                                                      at hDec
                                                    cases hDec
                                                  | true =>
                                                    rw [if_bool_true hC]
                                                      at hDec
                                                    cases h0 :
                                                        Trusted.MirSemantics.getElem?
                                                          ety.discriminants v
                                                    with
                                                    | none =>
                                                      rw [h0] at hDec
                                                      cases hDec
                                                    | some _ =>
                                                      rw [h0] at hDec
                                                      injection hDec with e
                                                      rw [← e]; rfl
                                                | _ => cases hDec
                                        rw [← hModeEq]
                                        exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                                          s3b_PmMono_refl pm, hDvBase, hC1⟩
                                  | _ => rfl
  | ref m srcP =>
    have hNeR : srcP.localId ≠ c.r := nat_ne_of_beq_false hNoR
    have hModeEq :
        s3b_modeAfterRoot c srcP.localId .read mode =
          s3b_rvNonRMode c (.ref m srcP) mode :=
      s3b_modeAfterRoot_read_eq_aux c.trackTb (Nat.beq srcP.localId c.x) mode
    dsimp [evalRvalueRef]
    have hRO := s3b_evalRefOrAddrOf_nonR true m srcP dstTy hCore hNeR hNoDirX
    cases h1 : evalRefOrAddrOf c.bodySrc.locals localsS epochs nodesS ntS true
        m srcP dstTy with
    | error _ =>
      rw [h1] at hRO
      cases h2 : evalRefOrAddrOf c.bodyTgt.locals localsT epochs nodesT ntT true
          m srcP dstTy with
      | error _ => rw [h2] at hRO; exact hRO
      | ok _ => rw [h2] at hRO; exact False.elim hRO
    | ok r1 =>
      rw [h1] at hRO
      cases h2 : evalRefOrAddrOf c.bodyTgt.locals localsT epochs nodesT ntT true
          m srcP dstTy with
      | error _ => rw [h2] at hRO; exact False.elim hRO
      | ok r2 =>
        rw [h2] at hRO
        cases r1 with
        | mk pvS a1 =>
          cases a1 with
          | mk nS1 ntS1 =>
            cases r2 with
            | mk pvT b1 =>
              cases b1 with
              | mk nT1 ntT1 =>
                rw [hModeEq] at hRO
                exact hRO
  | addressOf m srcP =>
    have hNeR : srcP.localId ≠ c.r := nat_ne_of_beq_false hNoR
    have hModeEq :
        s3b_modeAfterRoot c srcP.localId .read mode =
          s3b_rvNonRMode c (.addressOf m srcP) mode :=
      s3b_modeAfterRoot_read_eq_aux c.trackTb (Nat.beq srcP.localId c.x) mode
    dsimp [evalRvalueRef]
    have hRO := s3b_evalRefOrAddrOf_nonR false m srcP dstTy hCore hNeR hNoDirX
    cases h1 : evalRefOrAddrOf c.bodySrc.locals localsS epochs nodesS ntS false
        m srcP dstTy with
    | error _ =>
      rw [h1] at hRO
      cases h2 : evalRefOrAddrOf c.bodyTgt.locals localsT epochs nodesT ntT
          false m srcP dstTy with
      | error _ => rw [h2] at hRO; exact hRO
      | ok _ => rw [h2] at hRO; exact False.elim hRO
    | ok r1 =>
      rw [h1] at hRO
      cases h2 : evalRefOrAddrOf c.bodyTgt.locals localsT epochs nodesT ntT
          false m srcP dstTy with
      | error _ => rw [h2] at hRO; exact False.elim hRO
      | ok r2 =>
        rw [h2] at hRO
        cases r1 with
        | mk pvS a1 =>
          cases a1 with
          | mk nS1 ntS1 =>
            cases r2 with
            | mk pvT b1 =>
              cases b1 with
              | mk nT1 ntT1 =>
                rw [hModeEq] at hRO
                exact hRO

private theorem s3b_writeTarget_unproj_nonR {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {dstLoc : LocalId} {dstTy : MirTy} {vS vT : ValRef}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hNeR : dstLoc ≠ c.r)
    (hDecl : Trusted.MirSemantics.getElem? c.bodySrc.locals dstLoc = some dstTy)
    (hV : s3b_ValRel c epochs nextEpoch ntS ntT pm vS vT) :
    match writeTargetSlotRef c.bodySrc.locals localsS epochs nodesS dstLoc none
        dstTy vS,
        writeTargetSlotRef c.bodyTgt.locals localsT epochs nodesT dstLoc none
        dstTy vT with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (localsS', nodesS'), .ok (localsT', nodesT') =>
      s3b_CoreInv c rL xL (s3b_modeAfterRoot c dstLoc .write mode)
        localsS' localsT' epochs nextEpoch nodesS' nodesT' ntS ntT pm
    | _, _ => False := by
  unfold writeTargetSlotRef
  rw [s3b_ValRel_checkValRef dstTy hV]
  cases !checkValRef vT dstTy with
  | true => rfl
  | false =>
    dsimp
    cases hLS : Trusted.MirSemantics.getElem? localsS dstLoc with
    | none =>
      have hGe : localsT.length ≤ dstLoc := by
        rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_none_ge hLS
      rw [getElem?_none_of_ge hGe]
    | some slS =>
      have hLtS := getElem?_some_lt hLS
      have hLtT : dstLoc < localsT.length := by
        rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact hLtS
      let ⟨slT, hLT⟩ := getElem?_some_of_lt localsT dstLoc hLtT
      rw [hLT]
      have hSl := hCore.hSlotsOther dstLoc slS slT hNeR hLS hLT
      cases slS with
      | dead =>
        cases slT with
        | dead => rfl
        | live _ => exact False.elim hSl
      | live oS =>
        cases slT with
        | dead => exact False.elim hSl
        | live _ =>
          dsimp
          rw [s3b_validateRuntimeValRef_eq hCore hV]
          cases validateRuntimeValRef c.bodyTgt.locals localsT epochs dstTy vT
          with
          | error _ => rfl
          | ok _ =>
            dsimp
            let ⟨lS', hSetS⟩ :=
              setElem?_some_of_lt localsS dstLoc (.live (some vS)) hLtS
            let ⟨lT', hSetT⟩ :=
              setElem?_some_of_lt localsT dstLoc (.live (some vT)) hLtT
            rw [hSetS, hSetT]
            have hC1 := s3b_tbRoot_any .write hCore hDecl
            exact s3b_CoreInv_setLiveOther hC1 hNeR hLS hSetS hSetT rfl hV

private theorem s3b_writeTarget_deref_nonR {c : s3b_Ctx}
    {rL xL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {dSafe : Bool} {dMut : Mutability} {ptrDeclTy dstTy : MirTy}
    {ptrS ptrT : LocalPtr} {vS vT : ValRef}
    (hCore : s3b_CoreInv c rL xL mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hPtrV : s3b_ValRel c epochs nextEpoch ntS ntT pm
      (.localPtr ptrS ptrDeclTy) (.localPtr ptrT ptrDeclTy))
    (hV : s3b_ValRel c epochs nextEpoch ntS ntT pm vS vT) :
    match writeTargetSlotRef c.bodySrc.locals localsS epochs nodesS
        ptrS.targetLocal (some (dSafe, dMut, ptrS)) dstTy vS,
        writeTargetSlotRef c.bodyTgt.locals localsT epochs nodesT
        ptrT.targetLocal (some (dSafe, dMut, ptrT)) dstTy vT with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (localsS', nodesS'), .ok (localsT', nodesT') =>
      s3b_CoreInv c rL xL mode
        localsS' localsT' epochs nextEpoch nodesS' nodesT' ntS ntT pm
    | _, _ => False := by
  let ⟨_, hTgtNeR, hTgtLoc, hTgtEp, _, _, _, hTags⟩ := hPtrV
  unfold writeTargetSlotRef
  rw [s3b_ValRel_checkValRef dstTy hV]
  cases !checkValRef vT dstTy with
  | true => rfl
  | false =>
    dsimp
    rw [← hTgtLoc, ← hTgtEp, s3b_ctx_getElem_localsTgt_ne c hTgtNeR]
    cases hBL : Trusted.MirSemantics.getElem? c.bodySrc.locals ptrS.targetLocal
    with
    | none =>
      cases Trusted.MirSemantics.getElem? localsS ptrS.targetLocal <;>
        cases Trusted.MirSemantics.getElem? localsT ptrS.targetLocal <;>
        cases Trusted.MirSemantics.getElem? epochs ptrS.targetLocal <;> rfl
    | some tgtDeclTy =>
      cases hLS : Trusted.MirSemantics.getElem? localsS ptrS.targetLocal with
      | none =>
        have hGe : localsT.length ≤ ptrS.targetLocal := by
          rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact getElem?_none_ge hLS
        rw [getElem?_none_of_ge hGe]
      | some slS =>
        have hLtS := getElem?_some_lt hLS
        have hLtT : ptrS.targetLocal < localsT.length := by
          rw [hCore.hLenLocT, ← hCore.hLenLocS]; exact hLtS
        let ⟨slT, hLT⟩ := getElem?_some_of_lt localsT ptrS.targetLocal hLtT
        rw [hLT]
        have hSl := hCore.hSlotsOther ptrS.targetLocal slS slT hTgtNeR hLS hLT
        cases hEp : Trusted.MirSemantics.getElem? epochs ptrS.targetLocal with
        | none => rfl
        | some curEp =>
          dsimp
          cases hTyM : !MirTy.beq tgtDeclTy dstTy with
          | true => rfl
          | false =>
            have hTgtTyEq := mirTy_beq_eq (bool_not_false hTyM)
            subst hTgtTyEq
            dsimp
            cases dSafe && !isOpsemInhabitedTy tgtDeclTy with
            | true => rfl
            | false =>
              dsimp
              cases slS with
              | dead =>
                cases slT with
                | dead => rfl
                | live _ => exact False.elim hSl
              | live oS =>
                cases slT with
                | dead => exact False.elim hSl
                | live _ =>
                  dsimp
                  cases hEM : !Nat.beq curEp ptrS.targetEpoch with
                  | true => rfl
                  | false =>
                    have hEpEq := nat_beq_eq (bool_not_false hEM)
                    subst hEpEq
                    dsimp
                    cases Mutability.beq dMut .shared with
                    | true => rfl
                    | false =>
                      dsimp
                      have hTb :=
                        s3b_tbDerived_rel .write hCore hBL hEp hLS
                          (hTags tgtDeclTy hBL hEp)
                      cases hTb1 :
                          performTbAccess ptrS.targetLocal ptrS.targetEpoch
                            tgtDeclTy .write ptrS.borrowTag nodesS with
                      | error _ =>
                        rw [hTb1] at hTb
                        cases hTb2 :
                            performTbAccess ptrS.targetLocal ptrS.targetEpoch
                              tgtDeclTy .write ptrT.borrowTag nodesT with
                        | error _ => rw [hTb2] at hTb; exact hTb
                        | ok _ => rw [hTb2] at hTb; exact False.elim hTb
                      | ok nS' =>
                        rw [hTb1] at hTb
                        cases hTb2 :
                            performTbAccess ptrS.targetLocal ptrS.targetEpoch
                              tgtDeclTy .write ptrT.borrowTag nodesT with
                        | error _ => rw [hTb2] at hTb; exact False.elim hTb
                        | ok nT' =>
                          rw [hTb2] at hTb
                          dsimp
                          rw [s3b_validateRuntimeValRef_eq hTb hV]
                          cases validateRuntimeValRef c.bodyTgt.locals localsT
                              epochs tgtDeclTy vT with
                          | error _ => rfl
                          | ok _ =>
                            dsimp
                            let ⟨lS', hSetS⟩ :=
                              setElem?_some_of_lt localsS ptrS.targetLocal
                                (.live (some vS)) hLtS
                            let ⟨lT', hSetT⟩ :=
                              setElem?_some_of_lt localsT ptrS.targetLocal
                                (.live (some vT)) hLtT
                            rw [hSetS, hSetT]
                            exact s3b_CoreInv_setLiveOther hTb hTgtNeR hLS
                              hSetS hSetT rfl hV

/-! ### Rewritten Deref Expressions (`⟨r, [.deref]⟩ -> ⟨x, []⟩`) -/

private theorem s3b_liveSlot_of_sound {sl : LocalSlotRef}
    (h : s3b_slotIsLive sl = true) : ∃ opt, sl = .live opt := by
  cases sl with
  | dead => cases h
  | live opt => exact ⟨opt, rfl⟩

private theorem s3b_rewritePlace_noR {r x : LocalId} {p : Place}
    (hNoR : Nat.beq p.localId r = false) :
    rewriteDerefPlace r x p = p := by
  unfold rewriteDerefPlace
  rw [if_bool_false hNoR]

private theorem s3b_rewriteOperand_noR {r x : LocalId} {opnd : Operand}
    (hNoR : operandMentionsLocal r opnd = false) :
    rewriteDerefOperand r x opnd = opnd := by
  cases opnd with
  | copy p =>
    dsimp [rewriteDerefOperand]; rw [s3b_rewritePlace_noR hNoR]
  | move p =>
    dsimp [rewriteDerefOperand]; rw [s3b_rewritePlace_noR hNoR]
  | constant _ => rfl

private theorem s3b_evalOperand_rewritten {c : s3b_Ctx}
    {rL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)} {opnd : Operand}
    (hCore : s3b_CoreInv c rL true mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hDerefOnly : operandOnlyUsesDerefOf c.r c.rIsMut opnd = true)
    (hNoXIfTr : c.trackTb = true → operandMentionsLocal c.x opnd = false)
    (hModeOk :
      (c.trackTb = false ∧ mode = .reserved) ∨
      (c.trackTb = true ∧
        ((operandMovesDerefOf c.r opnd = false ∧
            (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
          (c.rIsMut = true ∧ mode = .unique)))) :
    match evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd,
        evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT
          (rewriteDerefOperand c.r c.x opnd) with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (ty₁, optS, src₁?, localsS', nodesS'),
      .ok (ty₂, optT, src₂?, localsT', nodesT') =>
      ty₁ = ty₂ ∧ src₁? = src₂? ∧
      s3b_OptValRel c epochs nextEpoch ntS ntT pm optS optT ∧
      s3b_CoreInv c rL true mode
        localsS' localsT' epochs nextEpoch nodesS' nodesT' ntS ntT pm
    | _, _ => False := by
  cases hMR : operandMentionsLocal c.r opnd with
  | false =>
    rw [s3b_rewriteOperand_noR hMR]
    have hModeIdle : s3b_opNonRMode c opnd mode = mode := by
      unfold s3b_opNonRMode
      cases hTr : c.trackTb with
      | false => rfl
      | true =>
        have hNX := hNoXIfTr hTr
        have hND : operandDirectMovesLocal c.x opnd = false := by
          cases opnd with
          | move p =>
            dsimp [operandMentionsLocal] at hNX
            dsimp [operandDirectMovesLocal]
            rw [hNX]; cases p.projection.isEmpty <;> rfl
          | _ => rfl
        rw [hND, hNX]
        rfl
    have hRes := s3b_evalOperand_nonR hCore hMR
    rw [hModeIdle] at hRes
    exact hRes
  | true =>
    have hXLtS : c.x < localsS.length := by rw [hCore.hLenLocS]; exact c.hXLt
    have hXLtT : c.x < localsT.length := by rw [hCore.hLenLocT]; exact c.hXLt
    have hXLtEp : c.x < epochs.length := by rw [hCore.hLenEp]; exact c.hXLt
    let ⟨slXS, hGXS⟩ := getElem?_some_of_lt localsS c.x hXLtS
    let ⟨slXT, hGXT⟩ := getElem?_some_of_lt localsT c.x hXLtT
    let ⟨epX, hEpX⟩ := getElem?_some_of_lt epochs c.x hXLtEp
    let ⟨optXS, hEqXS⟩ := s3b_liveSlot_of_sound (hCore.hXLiveSound rfl slXS hGXS)
    subst hEqXS
    have hSlX := hCore.hSlotsOther c.x _ slXT c.hRNeX.symm hGXS hGXT
    cases slXT with
    | dead => exact False.elim hSlX
    | live optXT =>
      have hLenS : (!Nat.beq epochs.length localsS.length) = false := by
        rw [hCore.hLenEp, hCore.hLenLocS, nat_beq_refl]; rfl
      have hInhCheck : (c.isSafeRef && !isOpsemInhabitedTy c.xTy) = false := by
        cases hSR : c.isSafeRef with
        | false => rfl
        | true => rw [c.hInhab hSR]; rfl
      have hRdOk :
          (c.trackTb = false ∧ mode = .reserved) ∨
          (c.trackTb = true ∧ TbAccessKind.read = .read ∧
            (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
          (c.trackTb = true ∧ TbAccessKind.read = .write ∧
            c.rIsMut = true ∧ mode = .unique) := by
        cases hModeOk with
        | inl h1 => exact Or.inl h1
        | inr h2 =>
          cases h2.2 with
          | inl h3 => exact Or.inr (Or.inl ⟨h2.1, rfl, h3.2⟩)
          | inr h4 => exact Or.inr (Or.inl ⟨h2.1, rfl, Or.inr (Or.inl h4.2)⟩)
      let ⟨tagR, nodesS₁, _, hLR, hTbRd, hCoreRd⟩ :=
        s3b_tbDerefR .read hCore hEpX hGXS hRdOk
      have hRootRNoop :
          performTbRootAccess epochs c.r c.rTy .read nodesS = nodesS :=
        performTbRootAccess_noop_of_noTarget hCore.hNoTargetRS
      cases opnd with
      | constant _ => cases hMR
      | copy place =>
        have hPR : place.localId = c.r := nat_beq_eq hMR
        change Nat.beq place.localId c.r = true at hMR
        dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnly
        rw [hMR] at hDerefOnly
        dsimp at hDerefOnly
        have hProj : place.projection = [.deref] := by
          cases hp : place.projection with
          | nil => rw [hp] at hDerefOnly; cases hDerefOnly
          | cons a b =>
            cases a with
            | field _ _ | unsupported =>
              rw [hp] at hDerefOnly; cases hDerefOnly
            | deref =>
              cases b with
              | nil => rfl
              | cons _ _ => rw [hp] at hDerefOnly; cases hDerefOnly
        cases place with
        | mk pLoc pProj =>
          dsimp at hPR hProj
          subst hPR; subst hProj
          dsimp [rewriteDerefOperand, rewriteDerefPlace]
          rw [if_bool_true (nat_beq_refl c.r)]
          dsimp [evalOperandToSlotRef, resolveDerefPlaceRef]
          rw [c.hGetRSrc, s3b_ctx_getElem_localsTgt_x c]
          dsimp only
          rw [c.hPtrInfo]
          dsimp only
          rw [if_bool_false hLenS, hLR]
          dsimp only
          rw [mirTy_beq_refl c.rTy, hRootRNoop,
              if_bool_false hInhCheck, hGXT]
          dsimp [derefPointeeSlot]
          rw [c.hGetXSrc, hGXS, hEpX]
          dsimp only
          rw [mirTy_beq_refl c.xTy, nat_beq_refl epX]
          dsimp
          rw [hTbRd]
          exact ⟨rfl, rfl, hSlX, hCoreRd⟩
      | move place =>
        have hPR : place.localId = c.r := nat_beq_eq hMR
        change Nat.beq place.localId c.r = true at hMR
        dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnly
        rw [hMR] at hDerefOnly
        dsimp at hDerefOnly
        let ⟨hPrOk, hMutTrue⟩ := bool_and_true hDerefOnly
        have hProj : place.projection = [.deref] := by
          cases hp : place.projection with
          | nil => rw [hp] at hPrOk; cases hPrOk
          | cons a b =>
            cases a with
            | field _ _ | unsupported => rw [hp] at hPrOk; cases hPrOk
            | deref =>
              cases b with
              | nil => rfl
              | cons _ _ => rw [hp] at hPrOk; cases hPrOk
        have hRMutEq : c.rMut = .mut := by
          have h1 := c.hRIsMut
          rw [hMutTrue] at h1
          exact mutability_beq_eq h1.symm
        have hNotShared : Mutability.beq c.rMut .shared = false := by
          rw [hRMutEq]; rfl
        cases place with
        | mk pLoc pProj =>
          dsimp at hPR hProj
          subst hPR; subst hProj
          have hMovesTrue :
              operandMovesDerefOf c.r (.move ⟨c.r, [.deref]⟩) = true := by
            dsimp [operandMovesDerefOf, listRel, projElemEq]
            rw [nat_beq_refl c.r]; rfl
          have hWrOk :
              (c.trackTb = false ∧ mode = .reserved) ∨
              (c.trackTb = true ∧ TbAccessKind.write = .read ∧
                (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
              (c.trackTb = true ∧ TbAccessKind.write = .write ∧
                c.rIsMut = true ∧ mode = .unique) := by
            cases hModeOk with
            | inl h1 => exact Or.inl h1
            | inr h2 =>
              cases h2.2 with
              | inl h3 => rw [hMovesTrue] at h3; cases h3.1
              | inr h4 => exact Or.inr (Or.inr ⟨h2.1, rfl, h4.1, h4.2⟩)
          let ⟨tagR2, nodesS₂, _, hLR2, hTbWr, hCoreWr⟩ :=
            s3b_tbDerefR .write hCoreRd hEpX hGXS hWrOk
          have hTagEq : tagR2 = tagR := by
            rw [hLR] at hLR2
            injection hLR2 with e1; injection e1 with e2
            injection e2 with e2b
            injection e2b with e3 _
            injection e3 with _ _ eT
            exact eT.symm
          subst hTagEq
          dsimp [rewriteDerefOperand, rewriteDerefPlace]
          rw [if_bool_true (nat_beq_refl c.r)]
          dsimp [evalOperandToSlotRef, resolveDerefPlaceRef]
          rw [c.hGetRSrc, s3b_ctx_getElem_localsTgt_x c]
          dsimp only
          rw [c.hPtrInfo]
          dsimp only
          rw [hNotShared, Bool.and_false]
          dsimp
          rw [if_bool_false hLenS, hLR]
          dsimp only
          rw [mirTy_beq_refl c.rTy, hRootRNoop,
              if_bool_false hInhCheck, hGXT]
          dsimp [derefPointeeSlot]
          rw [c.hGetXSrc, hGXS, hEpX]
          dsimp only
          rw [mirTy_beq_refl c.xTy, nat_beq_refl epX]
          dsimp
          rw [hTbRd]
          dsimp
          rw [hNotShared, Bool.and_false]
          dsimp
          rw [hTbWr]
          dsimp
          let ⟨lS', hSetS⟩ :=
            setElem?_some_of_lt localsS c.x (liveUninitSlotRef c.xTy) hXLtS
          let ⟨lT', hSetT⟩ :=
            setElem?_some_of_lt localsT c.x (liveUninitSlotRef c.xTy) hXLtT
          rw [hSetS, hSetT]
          exact ⟨rfl, rfl, hSlX,
            s3b_CoreInv_setLiveOther hCoreWr c.hRNeX.symm hGXS hSetS hSetT
              (s3b_slotIsLive_liveUninit c.xTy)
              (s3b_SlotRel_liveUninit c epochs nextEpoch ntS ntT pm c.xTy)⟩

private theorem s3b_evalPrimOperand_rewritten {c : s3b_Ctx}
    {rL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)} {opnd : Operand}
    (hCore : s3b_CoreInv c rL true mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hDerefOnly : operandOnlyUsesDerefOf c.r c.rIsMut opnd = true)
    (hNoXIfTr : c.trackTb = true → operandMentionsLocal c.x opnd = false)
    (hModeOk :
      (c.trackTb = false ∧ mode = .reserved) ∨
      (c.trackTb = true ∧
        ((operandMovesDerefOf c.r opnd = false ∧
            (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
          (c.rIsMut = true ∧ mode = .unique)))) :
    match evalPrimitiveOperandRef c.bodySrc.locals localsS epochs nodesS opnd,
        evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT
          (rewriteDerefOperand c.r c.x opnd) with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (v₁, localsS', nodesS'), .ok (v₂, localsT', nodesT') =>
      v₁ = v₂ ∧
      s3b_CoreInv c rL true mode
        localsS' localsT' epochs nextEpoch nodesS' nodesT' ntS ntT pm
    | _, _ => False := by
  unfold evalPrimitiveOperandRef
  have hOp := s3b_evalOperand_rewritten hCore hDerefOnly hNoXIfTr hModeOk
  cases h1 : evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd
  with
  | error _ =>
    rw [h1] at hOp
    cases h2 :
        evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT
          (rewriteDerefOperand c.r c.x opnd) with
    | error _ => rw [h2] at hOp; exact hOp
    | ok _ => rw [h2] at hOp; exact False.elim hOp
  | ok r1 =>
    rw [h1] at hOp
    cases h2 :
        evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT
          (rewriteDerefOperand c.r c.x opnd) with
    | error _ => rw [h2] at hOp; exact False.elim hOp
    | ok r2 =>
      rw [h2] at hOp
      cases r1 with
      | mk ty1 a1 =>
        cases a1 with
        | mk oS a2 =>
          cases a2 with
          | mk _ a3 =>
            cases a3 with
            | mk lS' nS' =>
              cases r2 with
              | mk ty2 b1 =>
                cases b1 with
                | mk oT b2 =>
                  cases b2 with
                  | mk _ b3 =>
                    cases b3 with
                    | mk lT' nT' =>
                      let ⟨hTy, _, hOpt, hC'⟩ := hOp
                      subst hTy
                      dsimp
                      cases !isPrimitiveReadableTy ty1 with
                      | true => rfl
                      | false =>
                        dsimp
                        cases oS with
                        | none =>
                          cases oT with
                          | none => rfl
                          | some _ => exact False.elim hOpt
                        | some vS =>
                          cases oT with
                          | none => exact False.elim hOpt
                          | some vT =>
                            cases vS with
                            | localPtr _ _ =>
                              cases vT with
                              | localPtr _ _ => rfl
                              | base _ => exact False.elim hOpt
                            | base bS =>
                              cases vT with
                              | localPtr _ _ => exact False.elim hOpt
                              | base bT => exact ⟨hOpt, hC'⟩

private theorem s3b_overlaps_rewritten_eq {c : s3b_Ctx}
    {dst : Place} {dstLoc : LocalId} {dstIsDerefSrc dstIsDerefTgt : Bool}
    {dstTy : MirTy} {opnd : Operand} {sL : LocalId}
    (hDerefOnlyDst : placeOnlyUsesDerefOf c.r dst = true)
    (hDerefOnlyOp : operandOnlyUsesDerefOf c.r c.rIsMut opnd = true)
    (hNoSelf :
      createsUnprojectedNonZstSelfUse c.xTy
        (rewriteDerefPlace c.r c.x dst)
        (.use (rewriteDerefOperand c.r c.x opnd)) = false)
    (hDstShape :
      (dst.localId = c.r ∧ dstLoc = c.x ∧ dstTy = c.xTy ∧
        dstIsDerefSrc = true ∧ dstIsDerefTgt = false) ∨
      (dst.localId ≠ c.r ∧ dstIsDerefSrc = dstIsDerefTgt ∧
        (dstIsDerefTgt = false → dst.projection = [] ∧ dstLoc = dst.localId)))
    (hSrcShape :
      match opnd with
      | .constant _ => False
      | .copy p | .move p =>
        (p.projection = [] → p.localId ≠ c.r ∧ some sL = some p.localId) ∧
        (p.localId = c.r → some sL = some c.x ∧ dstTy = c.xTy)) :
    ((dstIsDerefSrc || operandHasDerefProj opnd) &&
      !isZeroSizedTy dstTy && Nat.beq sL dstLoc) =
    ((dstIsDerefTgt || operandHasDerefProj (rewriteDerefOperand c.r c.x opnd)) &&
      !isZeroSizedTy dstTy && Nat.beq sL dstLoc) := by
  cases hEqLoc : Nat.beq sL dstLoc with
  | false => rw [Bool.and_false, Bool.and_false]
  | true =>
    have hsL := nat_beq_eq hEqLoc
    subst hsL
    cases hNZ : !isZeroSizedTy dstTy with
    | false =>
      rw [Bool.and_false, Bool.false_and, Bool.and_false, Bool.false_and]
    | true =>
      cases opnd with
      | constant _ => exact False.elim hSrcShape
      | copy p =>
        cases hPR : Nat.beq p.localId c.r with
        | false =>
          have hNoROp : operandMentionsLocal c.r (.copy p) = false := hPR
          rw [s3b_rewriteOperand_noR hNoROp]
          cases hDstShape with
          | inr hD2 => rw [hD2.2.1]
          | inl hD1 =>
            let ⟨hDR, hDL, hDTy, hIS, hIT⟩ := hD1
            subst hDL; subst hDTy; subst hIS; subst hIT
            dsimp [placeOnlyUsesDerefOf] at hDerefOnlyDst
            rw [nat_beq_of_eq hDR] at hDerefOnlyDst
            dsimp at hDerefOnlyDst
            have hDstP : dst.projection = [.deref] := by
              cases hp : dst.projection with
              | nil => rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst
              | cons a b =>
                cases a <;> first | (rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst) |
                  (cases b with
                   | nil => rfl
                   | cons _ _ => rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst)
            cases hpP : p.projection with
            | cons _ _ =>
              dsimp [operandHasDerefProj]
              rw [hpP]; rfl
            | nil =>
              have hSX := (hSrcShape.1 hpP).2
              injection hSX with eP
              have hRewDst : rewriteDerefPlace c.r c.x dst = ⟨c.x, []⟩ := by
                unfold rewriteDerefPlace
                rw [if_bool_true (nat_beq_of_eq hDR), hDstP]
              have hRewOp :
                  rewriteDerefOperand c.r c.x (.copy p) = .copy p :=
                s3b_rewriteOperand_noR hNoROp
              rw [hRewDst, hRewOp] at hNoSelf
              dsimp [createsUnprojectedNonZstSelfUse] at hNoSelf
              rw [hpP, hNZ, ← eP, nat_beq_refl c.x] at hNoSelf
              cases hNoSelf
        | true =>
          have hpR := nat_beq_eq hPR
          dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnlyOp
          rw [hPR] at hDerefOnlyOp
          dsimp at hDerefOnlyOp
          have hpProj : p.projection = [.deref] := by
            cases hp : p.projection with
            | nil => rw [hp] at hDerefOnlyOp; cases hDerefOnlyOp
            | cons a b =>
              cases a <;> first | (rw [hp] at hDerefOnlyOp; cases hDerefOnlyOp) |
                (cases b with
                 | nil => rfl
                 | cons _ _ => rw [hp] at hDerefOnlyOp; cases hDerefOnlyOp)
          have hRewOp :
              rewriteDerefOperand c.r c.x (.copy p) = .copy ⟨c.x, []⟩ := by
            dsimp [rewriteDerefOperand, rewriteDerefPlace]
            rw [if_bool_true hPR, hpProj]
          cases hDstShape with
          | inl hD1 =>
            let ⟨hDR, hDL, hDTy, _, _⟩ := hD1
            subst hDL; subst hDTy
            dsimp [placeOnlyUsesDerefOf] at hDerefOnlyDst
            rw [nat_beq_of_eq hDR] at hDerefOnlyDst
            dsimp at hDerefOnlyDst
            have hDstP : dst.projection = [.deref] := by
              cases hp : dst.projection with
              | nil => rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst
              | cons a b =>
                cases a <;> first | (rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst) |
                  (cases b with
                   | nil => rfl
                   | cons _ _ => rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst)
            have hRewDst : rewriteDerefPlace c.r c.x dst = ⟨c.x, []⟩ := by
              unfold rewriteDerefPlace
              rw [if_bool_true (nat_beq_of_eq hDR), hDstP]
            rw [hRewDst, hRewOp] at hNoSelf
            dsimp [createsUnprojectedNonZstSelfUse] at hNoSelf
            rw [hNZ, nat_beq_refl c.x] at hNoSelf
            cases hNoSelf
          | inr hD2 =>
            let ⟨hDNeR, hDEq, hIfUnp⟩ := hD2
            subst hDEq
            cases hID : dstIsDerefSrc with
            | true => rfl
            | false =>
              let ⟨hDstNil, hDstLocEq⟩ := hIfUnp hID
              let ⟨hSLX, hDTy⟩ := hSrcShape.2 hpR
              injection hSLX with esL
              subst hDTy
              have hDstIdX : dst.localId = c.x :=
                hDstLocEq.symm.trans esL
              have hNoRDst : Nat.beq dst.localId c.r = false :=
                nat_beq_false_of_ne hDNeR
              have hRewDst : rewriteDerefPlace c.r c.x dst = dst :=
                s3b_rewritePlace_noR hNoRDst
              rw [hRewDst, hRewOp] at hNoSelf
              dsimp [createsUnprojectedNonZstSelfUse] at hNoSelf
              rw [hDstNil, hNZ, hDstIdX, nat_beq_refl c.x] at hNoSelf
              cases hNoSelf
      | move p =>
        cases hPR : Nat.beq p.localId c.r with
        | false =>
          have hNoROp : operandMentionsLocal c.r (.move p) = false := hPR
          rw [s3b_rewriteOperand_noR hNoROp]
          cases hDstShape with
          | inr hD2 => rw [hD2.2.1]
          | inl hD1 =>
            let ⟨hDR, hDL, hDTy, hIS, hIT⟩ := hD1
            subst hDL; subst hDTy; subst hIS; subst hIT
            dsimp [placeOnlyUsesDerefOf] at hDerefOnlyDst
            rw [nat_beq_of_eq hDR] at hDerefOnlyDst
            dsimp at hDerefOnlyDst
            have hDstP : dst.projection = [.deref] := by
              cases hp : dst.projection with
              | nil => rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst
              | cons a b =>
                cases a <;> first | (rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst) |
                  (cases b with
                   | nil => rfl
                   | cons _ _ => rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst)
            cases hpP : p.projection with
            | cons _ _ =>
              dsimp [operandHasDerefProj]
              rw [hpP]; rfl
            | nil =>
              have hSX := (hSrcShape.1 hpP).2
              injection hSX with eP
              have hRewDst : rewriteDerefPlace c.r c.x dst = ⟨c.x, []⟩ := by
                unfold rewriteDerefPlace
                rw [if_bool_true (nat_beq_of_eq hDR), hDstP]
              have hRewOp :
                  rewriteDerefOperand c.r c.x (.move p) = .move p :=
                s3b_rewriteOperand_noR hNoROp
              rw [hRewDst, hRewOp] at hNoSelf
              dsimp [createsUnprojectedNonZstSelfUse] at hNoSelf
              rw [hpP, hNZ, ← eP, nat_beq_refl c.x] at hNoSelf
              cases hNoSelf
        | true =>
          have hpR := nat_beq_eq hPR
          dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnlyOp
          rw [hPR] at hDerefOnlyOp
          dsimp at hDerefOnlyOp
          let ⟨hPrOk, _⟩ := bool_and_true hDerefOnlyOp
          have hpProj : p.projection = [.deref] := by
            cases hp : p.projection with
            | nil => rw [hp] at hPrOk; cases hPrOk
            | cons a b =>
              cases a <;> first | (rw [hp] at hPrOk; cases hPrOk) |
                (cases b with
                 | nil => rfl
                 | cons _ _ => rw [hp] at hPrOk; cases hPrOk)
          have hRewOp :
              rewriteDerefOperand c.r c.x (.move p) = .move ⟨c.x, []⟩ := by
            dsimp [rewriteDerefOperand, rewriteDerefPlace]
            rw [if_bool_true hPR, hpProj]
          cases hDstShape with
          | inl hD1 =>
            let ⟨hDR, hDL, hDTy, _, _⟩ := hD1
            subst hDL; subst hDTy
            dsimp [placeOnlyUsesDerefOf] at hDerefOnlyDst
            rw [nat_beq_of_eq hDR] at hDerefOnlyDst
            dsimp at hDerefOnlyDst
            have hDstP : dst.projection = [.deref] := by
              cases hp : dst.projection with
              | nil => rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst
              | cons a b =>
                cases a <;> first | (rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst) |
                  (cases b with
                   | nil => rfl
                   | cons _ _ => rw [hp] at hDerefOnlyDst; cases hDerefOnlyDst)
            have hRewDst : rewriteDerefPlace c.r c.x dst = ⟨c.x, []⟩ := by
              unfold rewriteDerefPlace
              rw [if_bool_true (nat_beq_of_eq hDR), hDstP]
            rw [hRewDst, hRewOp] at hNoSelf
            dsimp [createsUnprojectedNonZstSelfUse] at hNoSelf
            rw [hNZ, nat_beq_refl c.x] at hNoSelf
            cases hNoSelf
          | inr hD2 =>
            let ⟨hDNeR, hDEq, hIfUnp⟩ := hD2
            subst hDEq
            cases hID : dstIsDerefSrc with
            | true => rfl
            | false =>
              let ⟨hDstNil, hDstLocEq⟩ := hIfUnp hID
              let ⟨hSLX, hDTy⟩ := hSrcShape.2 hpR
              injection hSLX with esL
              subst hDTy
              have hDstIdX : dst.localId = c.x :=
                hDstLocEq.symm.trans esL
              have hNoRDst : Nat.beq dst.localId c.r = false :=
                nat_beq_false_of_ne hDNeR
              have hRewDst : rewriteDerefPlace c.r c.x dst = dst :=
                s3b_rewritePlace_noR hNoRDst
              rw [hRewDst, hRewOp] at hNoSelf
              dsimp [createsUnprojectedNonZstSelfUse] at hNoSelf
              rw [hDstNil, hNZ, hDstIdX, nat_beq_refl c.x] at hNoSelf
              cases hNoSelf

private theorem s3b_evalOperand_srcShape {c : s3b_Ctx}
    {localsS : List LocalSlotRef} {epochs : List Nat}
    {nodesS : List BorrowNode} {opnd : Operand}
    {sTy : MirTy} {optS : Option ValRef} {src? : Option LocalId}
    {lS' : List LocalSlotRef} {nS' : List BorrowNode}
    {epX : Nat} {tagR : Nat}
    (hDerefOnly : operandOnlyUsesDerefOf c.r c.rIsMut opnd = true)
    (hLR :
      Nat.beq (match opnd with | .copy p | .move p => p.localId | _ => 0)
        c.r = true →
      Trusted.MirSemantics.getElem? localsS c.r =
        some (.live (some (.localPtr ⟨c.x, epX, tagR⟩ c.rTy))))
    (hOk : evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd =
      .ok (sTy, optS, src?, lS', nS')) :
    match opnd with
    | .constant _ => src? = none
    | .copy p | .move p =>
      (p.projection = [] → p.localId ≠ c.r ∧ src? = some p.localId) ∧
      (p.localId = c.r → src? = some c.x ∧ sTy = c.xTy) := by
  cases opnd with
  | constant cst =>
    dsimp [evalOperandToSlotRef] at hOk
    cases hC : evalConstLit cst.ty cst.lit with
    | error _ => rw [hC] at hOk; cases hOk
    | ok _ =>
      rw [hC] at hOk
      injection hOk with e; injection e with _ e2; injection e2 with _ e3
      injection e3 with eS _; exact eS.symm
  | copy p =>
    cases p with
    | mk pLoc pProj =>
      dsimp [evalOperandToSlotRef] at hOk
      dsimp at hLR
      dsimp
      refine ⟨?_, ?_⟩
      · intro hpNil
        have hNeR : pLoc ≠ c.r := by
          intro hEq
          dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnly
          rw [if_bool_true (nat_beq_of_eq hEq), hpNil] at hDerefOnly
          cases hDerefOnly
        rw [hpNil] at hOk; dsimp at hOk
        cases h1 : Trusted.MirSemantics.getElem? c.bodySrc.locals pLoc with
        | none => rw [h1] at hOk; cases hOk
        | some _ =>
          rw [h1] at hOk
          cases h2 : Trusted.MirSemantics.getElem? localsS pLoc with
          | none => rw [h2] at hOk; cases hOk
          | some sl =>
            rw [h2] at hOk
            cases sl with
            | dead => cases hOk
            | live _ =>
              injection hOk with e; injection e with _ e2
              injection e2 with _ e3; injection e3 with eS _
              exact ⟨hNeR, eS.symm⟩
      · intro hpR
        have hLR' := hLR (nat_beq_of_eq hpR)
        dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnly
        rw [if_bool_true (nat_beq_of_eq hpR)] at hDerefOnly
        subst hpR
        cases hp : pProj with
        | nil => rw [hp] at hDerefOnly; cases hDerefOnly
        | cons pe rest =>
          rw [hp] at hOk
          cases pe with
          | field _ _ | unsupported => cases hOk
          | deref =>
            cases rest with
            | cons _ _ => cases hOk
            | nil =>
              dsimp [resolveDerefPlaceRef] at hOk
              rw [c.hGetRSrc] at hOk; dsimp at hOk
              rw [c.hPtrInfo] at hOk; dsimp at hOk
              cases hL : !Nat.beq epochs.length localsS.length with
              | true => rw [if_bool_true hL] at hOk; cases hOk
              | false =>
                rw [if_bool_false hL, hLR'] at hOk
                dsimp only at hOk
                rw [mirTy_beq_refl c.rTy] at hOk
                dsimp at hOk
                cases hI : c.isSafeRef && !isOpsemInhabitedTy c.xTy with
                | true => rw [if_bool_true hI] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hI] at hOk
                  cases hD :
                      derefPointeeSlot c.bodySrc.locals localsS epochs c.xTy
                        ⟨c.x, epX, tagR⟩ with
                  | error _ => rw [hD] at hOk; cases hOk
                  | ok _ =>
                    rw [hD] at hOk; dsimp at hOk
                    cases hT : performTbAccess c.x epX c.xTy .read tagR _ with
                    | error _ => rw [hT] at hOk; cases hOk
                    | ok _ =>
                      rw [hT] at hOk
                      injection hOk with e; injection e with eTy e2
                      injection e2 with _ e3; injection e3 with eS _
                      exact ⟨eS.symm, eTy.symm⟩
  | move p =>
    cases p with
    | mk pLoc pProj =>
      dsimp [evalOperandToSlotRef] at hOk
      dsimp at hLR
      dsimp
      refine ⟨?_, ?_⟩
      · intro hpNil
        have hNeR : pLoc ≠ c.r := by
          intro hEq
          dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnly
          rw [if_bool_true (nat_beq_of_eq hEq), hpNil] at hDerefOnly
          cases hDerefOnly
        rw [hpNil] at hOk; dsimp at hOk
        cases h1 : Trusted.MirSemantics.getElem? c.bodySrc.locals pLoc with
        | none => rw [h1] at hOk; cases hOk
        | some ty =>
          rw [h1] at hOk
          cases h2 : Trusted.MirSemantics.getElem? localsS pLoc with
          | none => rw [h2] at hOk; cases hOk
          | some sl =>
            rw [h2] at hOk
            cases sl with
            | dead => cases hOk
            | live _ =>
              dsimp at hOk
              cases hS : setElem? localsS pLoc (liveUninitSlotRef ty) with
              | none => rw [hS] at hOk; cases hOk
              | some _ =>
                rw [hS] at hOk
                injection hOk with e; injection e with _ e2
                injection e2 with _ e3; injection e3 with eS _
                exact ⟨hNeR, eS.symm⟩
      · intro hpR
        have hLR' := hLR (nat_beq_of_eq hpR)
        dsimp [operandOnlyUsesDerefOf, placeOnlyUsesDerefOf] at hDerefOnly
        rw [if_bool_true (nat_beq_of_eq hpR)] at hDerefOnly
        subst hpR
        cases hp : pProj with
        | nil => rw [hp] at hDerefOnly; cases hDerefOnly
        | cons pe rest =>
          rw [hp] at hOk
          cases pe with
          | field _ _ | unsupported => cases hOk
          | deref =>
            cases rest with
            | cons _ _ => cases hOk
            | nil =>
              dsimp at hOk
              rw [c.hGetRSrc] at hOk; dsimp at hOk
              rw [c.hPtrInfo] at hOk; dsimp at hOk
              cases hSh1 : !c.isSafeRef && Mutability.beq c.rMut .shared with
              | true => rw [if_bool_true hSh1] at hOk; cases hOk
              | false =>
              rw [if_bool_false hSh1] at hOk
              dsimp [resolveDerefPlaceRef] at hOk
              rw [c.hGetRSrc] at hOk; dsimp at hOk
              rw [c.hPtrInfo] at hOk; dsimp at hOk
              cases hL : !Nat.beq epochs.length localsS.length with
              | true => rw [if_bool_true hL] at hOk; cases hOk
              | false =>
                rw [if_bool_false hL, hLR'] at hOk
                dsimp only at hOk
                rw [mirTy_beq_refl c.rTy] at hOk
                dsimp at hOk
                cases hI : c.isSafeRef && !isOpsemInhabitedTy c.xTy with
                | true => rw [if_bool_true hI] at hOk; cases hOk
                | false =>
                  rw [if_bool_false hI] at hOk
                  cases hD :
                      derefPointeeSlot c.bodySrc.locals localsS epochs c.xTy
                        ⟨c.x, epX, tagR⟩ with
                  | error _ => rw [hD] at hOk; cases hOk
                  | ok _ =>
                    rw [hD] at hOk; dsimp at hOk
                    cases hT1 : performTbAccess c.x epX c.xTy .read tagR _ with
                    | error _ => rw [hT1] at hOk; cases hOk
                    | ok n1 =>
                      rw [hT1] at hOk; dsimp at hOk
                      cases hSh2 : c.isSafeRef && Mutability.beq c.rMut .shared
                      with
                      | true => rw [if_bool_true hSh2] at hOk; cases hOk
                      | false =>
                        rw [if_bool_false hSh2] at hOk
                        cases hT2 :
                            performTbAccess c.x epX c.xTy .write tagR n1 with
                        | error _ => rw [hT2] at hOk; cases hOk
                        | ok _ =>
                          rw [hT2] at hOk; dsimp at hOk
                          cases hS :
                              setElem? localsS c.x (liveUninitSlotRef c.xTy)
                          with
                          | none => rw [hS] at hOk; cases hOk
                          | some _ =>
                            rw [hS] at hOk
                            injection hOk with e; injection e with eTy e2
                            injection e2 with _ e3; injection e3 with eS _
                            exact ⟨eS.symm, eTy.symm⟩

private theorem s3b_evalRvalue_rewritten {c : s3b_Ctx}
    {rL : Bool} {mode : BorrowLinkMode}
    {localsS localsT : List LocalSlotRef} {epochs : List Nat}
    {nextEpoch ntS ntT : Nat} {nodesS nodesT : List BorrowNode}
    {pm : LocalId → Nat → List (Nat × Nat)}
    {dst : Place} {dstLoc : LocalId}
    {dstIsDerefSrc dstIsDerefTgt : Bool} {dstTy : MirTy} {rv : Rvalue}
    (hCore : s3b_CoreInv c rL true mode localsS localsT epochs nextEpoch
      nodesS nodesT ntS ntT pm)
    (hDerefDst : placeOnlyUsesDerefOf c.r dst = true)
    (hDerefRv : rvalueOnlyUsesDerefOf c.r c.rIsMut c.isSafeRef rv = true)
    (hNoSelf :
      createsUnprojectedNonZstSelfUse c.xTy
        (rewriteDerefPlace c.r c.x dst)
        (rewriteDerefRvalue c.r c.x rv) = false)
    (hNoXIfTr : c.trackTb = true → rvalueMentionsLocal c.x rv = false)
    (hNoRebIfTr : c.trackTb = true → s3b_reborrowMutOpt c.r rv = none)
    (hDstShape :
      (dst.localId = c.r ∧ dstLoc = c.x ∧ dstTy = c.xTy ∧
        dstIsDerefSrc = true ∧ dstIsDerefTgt = false) ∨
      (dst.localId ≠ c.r ∧ dstIsDerefSrc = dstIsDerefTgt ∧
        (dstIsDerefTgt = false → dst.projection = [] ∧ dstLoc = dst.localId)))
    (hModeOk :
      (c.trackTb = false ∧ mode = .reserved) ∨
      (c.trackTb = true ∧
        ((rvalueMovesDerefOf c.r rv = false ∧
            (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
          (c.rIsMut = true ∧ mode = .unique)))) :
    match evalRvalueRef c.bodySrc.locals localsS epochs nodesS ntS dstLoc
        dstIsDerefSrc dstTy rv,
        evalRvalueRef c.bodyTgt.locals localsT epochs nodesT ntT dstLoc
        dstIsDerefTgt dstTy (rewriteDerefRvalue c.r c.x rv) with
    | .error k₁, .error k₂ => k₁ = k₂
    | .ok (vS, localsS', nodesS', ntS'),
      .ok (vT, localsT', nodesT', ntT') =>
      ∃ pm',
        ntS ≤ ntS' ∧ ntT ≤ ntT' ∧ s3b_PmMono pm pm' ∧
        s3b_ValRel c epochs nextEpoch ntS' ntT' pm' vS vT ∧
        s3b_CoreInv c rL true mode
          localsS' localsT' epochs nextEpoch nodesS' nodesT' ntS' ntT' pm'
    | _, _ => False := by
  have hXLtS : c.x < localsS.length := by rw [hCore.hLenLocS]; exact c.hXLt
  have hXLtT : c.x < localsT.length := by rw [hCore.hLenLocT]; exact c.hXLt
  have hXLtEp : c.x < epochs.length := by rw [hCore.hLenEp]; exact c.hXLt
  let ⟨slXS, hGXS⟩ := getElem?_some_of_lt localsS c.x hXLtS
  let ⟨slXT, hGXT⟩ := getElem?_some_of_lt localsT c.x hXLtT
  let ⟨epX, hEpX⟩ := getElem?_some_of_lt epochs c.x hXLtEp
  let ⟨optXS, hEqXS⟩ := s3b_liveSlot_of_sound (hCore.hXLiveSound rfl slXS hGXS)
  subst hEqXS
  have hSlX := hCore.hSlotsOther c.x _ slXT c.hRNeX.symm hGXS hGXT
  have hRdOk :
      (c.trackTb = false ∧ mode = .reserved) ∨
      (c.trackTb = true ∧ TbAccessKind.read = .read ∧
        (mode = .reserved ∨ mode = .unique ∨ mode = .frozen)) ∨
      (c.trackTb = true ∧ TbAccessKind.read = .write ∧
        c.rIsMut = true ∧ mode = .unique) := by
    cases hModeOk with
    | inl h1 => exact Or.inl h1
    | inr h2 =>
      cases h2.2 with
      | inl h3 => exact Or.inr (Or.inl ⟨h2.1, rfl, h3.2⟩)
      | inr h4 => exact Or.inr (Or.inl ⟨h2.1, rfl, Or.inr (Or.inl h4.2)⟩)
  let ⟨tagR0, _, hTR0Lt, hLR0, _, _⟩ :=
    s3b_tbDerefR .read hCore hEpX hGXS hRdOk
  cases rv with
  | aggregateTuple _ | unsupported => rfl
  | use opnd =>
    dsimp [rewriteDerefRvalue, evalRvalueRef]
    have hOp := s3b_evalOperand_rewritten hCore hDerefRv hNoXIfTr hModeOk
    cases h1 : evalOperandToSlotRef c.bodySrc.locals localsS epochs nodesS opnd
    with
    | error _ =>
      rw [h1] at hOp
      cases h2 :
          evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT
            (rewriteDerefOperand c.r c.x opnd) with
      | error _ => rw [h2] at hOp; exact hOp
      | ok _ => rw [h2] at hOp; exact False.elim hOp
    | ok r1 =>
      rw [h1] at hOp
      cases h2 :
          evalOperandToSlotRef c.bodyTgt.locals localsT epochs nodesT
            (rewriteDerefOperand c.r c.x opnd) with
      | error _ => rw [h2] at hOp; exact False.elim hOp
      | ok r2 =>
        rw [h2] at hOp
        cases r1 with
        | mk sTy1 a1 =>
          cases a1 with
          | mk oS a2 =>
            cases a2 with
            | mk src1? a3 =>
              cases a3 with
              | mk lS' nS' =>
                cases r2 with
                | mk sTy2 b1 =>
                  cases b1 with
                  | mk oT b2 =>
                    cases b2 with
                    | mk src2? b3 =>
                      cases b3 with
                      | mk lT' nT' =>
                        let ⟨hTy, hSrc, hOpt, hC'⟩ := hOp
                        subst hTy; subst hSrc
                        dsimp
                        cases hTM : !MirTy.beq sTy1 dstTy with
                        | true => rfl
                        | false =>
                          have hSTyEq := mirTy_beq_eq (bool_not_false hTM)
                          subst hSTyEq
                          dsimp
                          have hShRaw :=
                            s3b_evalOperand_srcShape hDerefRv
                              (fun _ => hLR0) h1
                          cases hSrc1 : src1? with
                          | none =>
                            dsimp
                            rw [Bool.and_false, Bool.and_false]
                            dsimp
                            cases oS with
                            | none =>
                              cases oT with
                              | none => rfl
                              | some _ => exact False.elim hOpt
                            | some vS =>
                              cases oT with
                              | none => exact False.elim hOpt
                              | some vT =>
                                exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                                  s3b_PmMono_refl pm, hOpt, hC'⟩
                          | some sL =>
                            dsimp
                            have hOvEq :=
                              s3b_overlaps_rewritten_eq hDerefDst hDerefRv
                                hNoSelf hDstShape
                                (by
                                  cases opnd with
                                  | constant _ =>
                                    dsimp at hShRaw
                                    rw [hSrc1] at hShRaw
                                    cases hShRaw
                                  | copy p =>
                                    dsimp at hShRaw
                                    rw [hSrc1] at hShRaw
                                    exact hShRaw
                                  | move p =>
                                    dsimp at hShRaw
                                    rw [hSrc1] at hShRaw
                                    exact hShRaw)
                            rw [hOvEq]
                            cases s3b_bool_cases
                                ((dstIsDerefTgt ||
                                    operandHasDerefProj
                                      (rewriteDerefOperand c.r c.x opnd)) &&
                                  !isZeroSizedTy sTy1 &&
                                  Nat.beq sL dstLoc) with
                            | inr hOv =>
                              rw [if_bool_true hOv, if_bool_true hOv]
                            | inl hOv =>
                              rw [if_bool_false hOv, if_bool_false hOv]
                              cases oS with
                              | none =>
                                cases oT with
                                | none => rfl
                                | some _ => exact False.elim hOpt
                              | some vS =>
                                cases oT with
                                | none => exact False.elim hOpt
                                | some vT =>
                                  exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                                    s3b_PmMono_refl pm, hOpt, hC'⟩
  | unaryOp op opnd =>
    dsimp [rewriteDerefRvalue, evalRvalueRef]
    have hOp := s3b_evalPrimOperand_rewritten hCore hDerefRv hNoXIfTr hModeOk
    cases h1 :
        evalPrimitiveOperandRef c.bodySrc.locals localsS epochs nodesS opnd with
    | error _ =>
      rw [h1] at hOp
      cases h2 :
          evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT
            (rewriteDerefOperand c.r c.x opnd) with
      | error _ => rw [h2] at hOp; exact hOp
      | ok _ => rw [h2] at hOp; exact False.elim hOp
    | ok r1 =>
      rw [h1] at hOp
      cases h2 :
          evalPrimitiveOperandRef c.bodyTgt.locals localsT epochs nodesT
            (rewriteDerefOperand c.r c.x opnd) with
      | error _ => rw [h2] at hOp; exact False.elim hOp
      | ok r2 =>
        rw [h2] at hOp
        cases r1 with
        | mk v1 a1 =>
          cases a1 with
          | mk lS' nS' =>
            cases r2 with
            | mk v2 b1 =>
              cases b1 with
              | mk lT' nT' =>
                let ⟨hv, hC'⟩ := hOp
                subst hv
                dsimp
                cases evalUnOp op v1 with
                | error _ => rfl
                | ok _ =>
                  exact ⟨pm, Nat.le_refl _, Nat.le_refl _,
                    s3b_PmMono_refl pm, rfl, hC'⟩
