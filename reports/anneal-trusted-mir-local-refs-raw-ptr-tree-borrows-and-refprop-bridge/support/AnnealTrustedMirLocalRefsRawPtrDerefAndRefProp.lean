            have hAbsUnp :
                st₁ = .reachable rL xL modeTarget ∧ stmt' = .assign dst rv := by
              dsimp [modeTarget]
              cases hTr : c.trackTb with
              | false =>
                have hT : (!c.trackTb) = true := by rw [hTr]; rfl
                rw [if_bool_true hT] at hAbs
                dsimp
                let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                exact ⟨e1.symm, e2.symm⟩
              | true =>
                have hT : (!c.trackTb) = false := by rw [hTr]; rfl
                rw [if_bool_false hT] at hAbs
                dsimp
                cases mode with
                | clean | delegated =>
                  let ⟨e1, e2⟩ := s3b_some_prod_eq hAbs
                  exact ⟨e1.symm, e2.symm⟩
                | reserved | unique | frozen =>
