  let p := entryProgForBody pWitnessFlat 0
  have hInit :
      initState p { args := [inVal] } =
        Except.ok {
          frames := [{
            defId := 0
            blockIdx := 0
            stmtIdx := 0
            locals := [
              .live none,
              .live (some inVal),
              .dead, .dead, .dead, .dead
