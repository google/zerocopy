theorem BorrowPrototype.fieldConsumerAccepted : expectedNativeSourceHash = actualNativeSourceHash ∧
  ∀ (p : Pair) (d : Byte) (entry : Authority),
    entry = Authority.root →
      runField (fieldCertificate d) { pair := p, authority := entry } =
        some { pair := capturedField p d, authority := Authority.root } :=
⟨rfl, field_correspondence⟩
theorem BorrowPrototype.sliceConsumerAccepted : expectedNativeSourceHash = actualNativeSourceHash ∧
  ∀ (xs : Slice2) (index : Nat) (d : Byte) (entry : Authority),
    entry = Authority.root →
      transformedSlice entry xs index d = Option.map (fun ys => (ys, Authority.root)) (capturedSlice xs index d) :=
⟨rfl, slice_correspondence⟩
