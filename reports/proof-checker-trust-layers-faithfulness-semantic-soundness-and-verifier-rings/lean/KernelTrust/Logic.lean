/-
  Toy.KernelTrust.Logic

  A toy propositional logic whose inference rules are *data* (`RuleSet`), and the
  derivability relation `Derivable R Γ φ` generated by a rule table `R`.

  Everything in this package is a toy model: propositional formulas, finite rule
  tables, list contexts.  Nothing here speaks about dependent type theory,
  binders, definitional equality, or any production proof checker.
-/

namespace Toy.KernelTrust

/-! ## Formulas, patterns, rule tables -/

/-- Object-language formulas: propositional variables, falsum, implication,
conjunction, disjunction.  There are no binders and no modalities. -/
inductive Form : Type where
  | var  : Nat → Form
  | bot  : Form
  | imp  : Form → Form → Form
  | conj : Form → Form → Form
  | disj : Form → Form → Form
  deriving DecidableEq, Repr, Inhabited

/-- Sequent contexts are lists of hypotheses (order and multiplicity are kept;
membership is all that derivability looks at). -/
abbrev Ctx := List Form

/-- The formula `⊥ → ⊥`, used as the canonical provable formula ("truth"). -/
def Form.top : Form := .imp .bot .bot

/-- Schematic formula patterns used in rule tables.  `pvar i` is the `i`-th
schematic metavariable of a rule; it is instantiated by a substitution. -/
inductive Pat : Type where
  | pvar : Nat → Pat
  | bot  : Pat
  | imp  : Pat → Pat → Pat
  | conj : Pat → Pat → Pat
  | disj : Pat → Pat → Pat
  deriving DecidableEq, Repr, Inhabited

/-- One premise of a natural-deduction rule: the hypotheses it adds to the
ambient context (discharged by the rule) and the goal to be derived there. -/
structure PremiseSpec where
  addedHyps : List Pat
  goal      : Pat
  deriving DecidableEq, Repr

/-- A rule schema as pure data: a display name, premises, and a conclusion.
The `name` is documentation only; no definition in this package inspects it. -/
structure RuleDesc where
  name       : String
  premises   : List PremiseSpec
  conclusion : Pat
  deriving DecidableEq, Repr

/-- A rule table ("rules as data"): the *specification* that a checker is
supposed to implement. -/
abbrev RuleSet := List RuleDesc

/-- A substitution assigns formulas to schematic metavariables by position. -/
abbrev Subst := List Form

/-- Look up metavariable `i` in `σ`.  Out-of-range metavariables are read as
`⊥` (a total-function convention: every `σ` instantiates every rule). -/
def substLookup (σ : Subst) (i : Nat) : Form :=
  match σ, i with
  | [], _ => .bot
  | f :: _, 0 => f
  | _ :: fs, n + 1 => substLookup fs n

/-- Instantiate a pattern under a substitution. -/
def instPat (σ : Subst) : Pat → Form
  | .pvar i   => substLookup σ i
  | .bot      => .bot
  | .imp a b  => .imp (instPat σ a) (instPat σ b)
  | .conj a b => .conj (instPat σ a) (instPat σ b)
  | .disj a b => .disj (instPat σ a) (instPat σ b)

/-- The standard rule table: natural deduction for intuitionistic propositional
logic (`→`, `∧`, `∨`, `⊥`).  Rule indices (used by certificates):
`0 impIntro, 1 impElim, 2 conjIntro, 3 conjElimL, 4 conjElimR, 5 disjIntroL,
6 disjIntroR, 7 disjElim, 8 botElim`. -/
def stdRules : RuleSet :=
  [ { name := "impIntro"
      premises := [{ addedHyps := [.pvar 0], goal := .pvar 1 }]
      conclusion := .imp (.pvar 0) (.pvar 1) }
  , { name := "impElim"
      premises := [{ addedHyps := [], goal := .imp (.pvar 0) (.pvar 1) },
                   { addedHyps := [], goal := .pvar 0 }]
      conclusion := .pvar 1 }
  , { name := "conjIntro"
      premises := [{ addedHyps := [], goal := .pvar 0 },
                   { addedHyps := [], goal := .pvar 1 }]
      conclusion := .conj (.pvar 0) (.pvar 1) }
  , { name := "conjElimL"
      premises := [{ addedHyps := [], goal := .conj (.pvar 0) (.pvar 1) }]
      conclusion := .pvar 0 }
  , { name := "conjElimR"
      premises := [{ addedHyps := [], goal := .conj (.pvar 0) (.pvar 1) }]
      conclusion := .pvar 1 }
  , { name := "disjIntroL"
      premises := [{ addedHyps := [], goal := .pvar 0 }]
      conclusion := .disj (.pvar 0) (.pvar 1) }
  , { name := "disjIntroR"
      premises := [{ addedHyps := [], goal := .pvar 1 }]
      conclusion := .disj (.pvar 0) (.pvar 1) }
  , { name := "disjElim"
      premises := [{ addedHyps := [], goal := .disj (.pvar 0) (.pvar 1) },
                   { addedHyps := [.pvar 0], goal := .pvar 2 },
                   { addedHyps := [.pvar 1], goal := .pvar 2 }]
      conclusion := .pvar 2 }
  , { name := "botElim"
      premises := [{ addedHyps := [], goal := .bot }]
      conclusion := .pvar 0 }
  ]

/-- A plausible-looking but unsound extra rule ("theory bug"): from `A → B`
conclude `B → A`. -/
def converseImpRule : RuleDesc :=
  { name := "converseImp"
    premises := [{ addedHyps := [], goal := .imp (.pvar 0) (.pvar 1) }]
    conclusion := .imp (.pvar 1) (.pvar 0) }

/-- The standard rules plus `converseImpRule` (index `9`).  This table is the
package's running example of *unsound rules*. -/
def badRules : RuleSet := stdRules ++ [converseImpRule]

/-! ## Derivability -/

/-- `Derivable R Γ φ`: the sequent `Γ ⊢ φ` has a derivation using hypotheses
from `Γ` and instances of the rules in the table `R`.

This is the *specification-level* notion of proof.  It mentions no checker and
no proof-object format. -/
inductive Derivable (R : RuleSet) : Ctx → Form → Prop where
  | hyp  : ∀ {Γ φ}, φ ∈ Γ → Derivable R Γ φ
  | step : ∀ {Γ} (r : RuleDesc) (σ : Subst),
      r ∈ R →
      (∀ p ∈ r.premises,
        Derivable R (p.addedHyps.map (instPat σ) ++ Γ) (instPat σ p.goal)) →
      Derivable R Γ (instPat σ r.conclusion)

/-- Weakening / context monotonicity for any rule table. -/
theorem Derivable.mono {R : RuleSet} {Γ Γ' : Ctx} {φ : Form}
    (h : Derivable R Γ φ) (hsub : ∀ x ∈ Γ, x ∈ Γ') : Derivable R Γ' φ := by
  induction h generalizing Γ' with
  | hyp hmem => exact .hyp (hsub _ hmem)
  | @step Γ₀ r σ hr _ ih =>
    apply Derivable.step r σ hr
    intro p hp
    apply ih p hp
    intro x hx
    rcases List.mem_append.mp hx with hx1 | hx2
    · exact List.mem_append_left _ hx1
    · exact List.mem_append_right _ (hsub x hx2)

/-- Enlarging the rule table preserves derivability. -/
theorem Derivable.mono_rules {R R' : RuleSet} {Γ : Ctx} {φ : Form}
    (h : Derivable R Γ φ) (hsub : ∀ r ∈ R, r ∈ R') : Derivable R' Γ φ := by
  induction h with
  | hyp hmem => exact .hyp hmem
  | step r σ hr _ ih => exact .step r σ (hsub r hr) ih

/-! ## Examples for the definitions above -/

/-- Positive example (`instPat`, `substLookup`): the conclusion pattern of
`impIntro` instantiates to `⊥ → ⊥` under `σ = [⊥, ⊥]`. -/
theorem ex_instPat_pos :
    instPat [.bot, .bot] (.imp (.pvar 0) (.pvar 1)) = Form.top := rfl

/-- Negative example (`substLookup`): an out-of-range metavariable is *not* left
schematic and is *not* read as a variable; it is read as `⊥`. -/
theorem ex_substLookup_neg : substLookup [] 3 ≠ Form.var 3 := by decide

/-- Negative example (`instPat`): instantiation is not the identity on
patterns that mention a metavariable; with `σ = [p₇]` the pattern `?0 → ?1`
becomes `p₇ → ⊥`, not `p₇ → p₇`. -/
theorem ex_instPat_neg :
    instPat [.var 7] (.imp (.pvar 0) (.pvar 1)) = .imp (.var 7) .bot ∧
    instPat [.var 7] (.imp (.pvar 0) (.pvar 1)) ≠ .imp (.var 7) (.var 7) := by
  constructor
  · rfl
  · decide

/-- Positive example (`Derivable`): `⊢ ⊥ → ⊥` under the standard rules. -/
theorem ex_derivable_top_pos : Derivable stdRules [] Form.top :=
  Derivable.step (R := stdRules) (Γ := [])
    { name := "impIntro"
      premises := [{ addedHyps := [.pvar 0], goal := .pvar 1 }]
      conclusion := .imp (.pvar 0) (.pvar 1) }
    [.bot, .bot] (by decide)
    (by
      intro p hp
      simp only [List.mem_singleton] at hp
      subst hp
      exact .hyp (by decide))

/-- Positive example (`Derivable.hyp`): a hypothesis is derivable under any
rule table, including the empty one. -/
theorem ex_derivable_hyp_pos (R : RuleSet) (φ : Form) : Derivable R [φ] φ :=
  .hyp (List.mem_singleton.mpr rfl)

/-- Negative example (`Derivable`): with the *empty* rule table and the empty
context nothing at all is derivable. -/
theorem ex_derivable_empty_neg (φ : Form) : ¬ Derivable [] [] φ := by
  intro h
  cases h with
  | hyp hmem => cases hmem
  | step r σ hr _ => cases hr

/-- Positive example (`badRules`): the standard rules are a sub-table. -/
theorem stdRules_sub_badRules : ∀ r ∈ stdRules, r ∈ badRules :=
  fun _ hr => List.mem_append_left _ hr

end Toy.KernelTrust
