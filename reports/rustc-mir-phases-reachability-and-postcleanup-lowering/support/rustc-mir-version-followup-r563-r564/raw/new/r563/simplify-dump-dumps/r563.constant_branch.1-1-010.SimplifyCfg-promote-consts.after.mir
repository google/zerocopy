// MIR for `constant_branch` after SimplifyCfg-promote-consts

fn constant_branch() -> () {
    let mut _0: ();
    let mut _1: bool;
    let _2: ();

    bb0: {
        StorageLive(_1);
        _1 = const false;
        switchInt(move _1) -> [0: bb3, otherwise: bb1];
    }

    bb1: {
        StorageLive(_2);
        _2 = marker() -> [return: bb2, unwind: bb5];
    }

    bb2: {
        StorageDead(_2);
        _0 = const ();
        goto -> bb4;
    }

    bb3: {
        _0 = const ();
        goto -> bb4;
    }

    bb4: {
        StorageDead(_1);
        return;
    }

    bb5 (cleanup): {
        resume;
    }
}
