loc_controlled_read_after_reborrow_creates
     : ∀ (cids : call_id_set) (l : block * Z) (sc : scalar) (tg_cld tg_par : nat) (tk : tag_kind) 
         (σ σ' : state) (pk : pointer_kind) (im : interior_mut) (rk : retag_kind) (trs1 : trees) 
         (cc : nat) (blk : block) (off1 : Z) (sz : nat),
         apply_within_trees (create_child cids tg_par tg_cld pk im rk cc) blk (strs σ) = Some trs1
         → apply_within_trees (memory_access AccessRead cids tg_cld (off1, sz)) blk trs1 = Some (strs σ')
           → state_wf σ
             → wf_trees trs1
               → l.1 = blk
                 → trees_contain tg_par (strs σ) blk
                   → ¬ trees_contain tg_cld (strs σ) blk
                     → shp σ' !! l = Some sc
                       → off1 ≤ l.2 < off1 + sz
                         → cc ∈ scs σ'
                           → pointer_kind_to_tag_maybe_protected pk im rk = Some tk → loc_controlled l tg_cld tk sc σ'
