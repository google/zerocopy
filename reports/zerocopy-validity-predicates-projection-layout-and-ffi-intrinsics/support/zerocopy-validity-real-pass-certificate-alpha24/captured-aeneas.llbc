          "source_text": "pub(crate) fn read_byte(bytes: &[u8], index: usize) -> u8 {\n    bytes[index]\n}",
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Reads an initialized raw byte, with the ordinary slice bounds check."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This narrow, source-bound interpretation avoids importing the whole generic"
              },
              {
                "DocComment": " indexing dictionary (including unsupported pointer operations) to read one"
              },
              {
                "DocComment": " byte. It does not create a bool, a reference, or a possibly invalid integer."
              },
              {
                "DocComment": " Aeneas checks its complete guarded interpretation independently in Check."
              },
