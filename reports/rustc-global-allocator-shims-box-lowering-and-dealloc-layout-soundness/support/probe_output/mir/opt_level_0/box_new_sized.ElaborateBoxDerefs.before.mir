// MIR for `box_new_sized` before ElaborateBoxDerefs

fn box_new_sized(_1: Pair) -> Box<Pair> {
    debug p => _1;
    let mut _0: std::boxed::Box<Pair>;
    let mut _2: Pair;

    bb0: {
        StorageLive(_2);
        _2 = move _1;
        _0 = Box::<Pair>::new(move _2) -> [return: bb1, unwind: bb3];
    }

    bb1: {
        StorageDead(_2);
        goto -> bb2;
    }

    bb2: {
        return;
    }

    bb3 (cleanup): {
        goto -> bb4;
    }

    bb4 (cleanup): {
        goto -> bb5;
    }

    bb5 (cleanup): {
        resume;
    }
}
